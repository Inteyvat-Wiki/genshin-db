{
	"name": "@inteyvat-wiki/genshin-db",
	"version": "0.1.0",
	"private": true,
	"engines": { "node": ">=22.13" },
	"description": "Genshin Impact v6.4 JSON data. Search and get results in all in-game languages! Sources from the fandom wiki and GenshinData repo.",
	"main": "./src/main.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": { "types": "./types/index.d.ts", "default": "./src/main.js" },
		"./resources": { "types": "./types/resources.d.ts", "default": "./src/resources.js" },
		"./package.json": "./package.json"
	},
	"scripts": {
		"test:unit": "node --test tests/*.test.js",
		"test:provider": "node --test tests/provider.test.js",
		"test:misc": "node --test tests/misc.test.js",
		"test:maps": "node --test tests/maps.test.js",
		"test:cosmetics": "node --test tests/cosmetics.test.js",
		"import": "cd scripts/import && node ./import.js",
		"examples": "cd scripts/generate && node ./examples.js",
		"makeIndex": "cd scripts/generate && node ./makeIndex.js",
		"combineData": "cd scripts/generate && node ./combineData.js",
		"imagelist": "cd scripts/imagelist && node ./images.js",
		"assemble": "npm run makeIndex && npm run combineData && npm run examples && npm run imagelist",
		"build": "node ./scripts/webpack/build.js",
		"buildAllDist": "node ./scripts/webpack/buildAllDist.js",
		"prepublishOnly": "node scripts/publish/disabled.cjs"
	},
	"keywords": [
		"genshin-impact",
		"genshinimpact",
		"genshin"
	],
	"author": "Inteyvat-Wiki",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Inteyvat-Wiki/genshin-db.git"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Inteyvat-Wiki/genshin-db/issues"
	},
	"homepage": "https://github.com/Inteyvat-Wiki/genshin-db#readme",
	"dependencies": {
		"@inteyvat-wiki/genshin-data-scripts": "0.1.0",
		"fuzzysort": "^1.1.4",
		"pako": "^2.0.4"
	},
	"devDependencies": {
		"arraybuffer-loader": "^1.0.8",
		"follow-redirects": "^1.14.9",
		"webpack": "^5.75.0",
		"webpack-cli": "^4.2.0",
		"yargs-parser": "^21.1.1"
	},
	"files": [
		"examples/EXAMPLES.md",
		"examples/index.ts",
		"LICENSE",
		"NOTICES.md",
		"docs/provider.md",
		"scripts/publish/disabled.cjs",
		"LICENSES/",
		"README.md",
		"types/*",
		"src/altnames.js",
		"src/language.js",
		"src/folder.js",
		"src/helper.js",
		"src/main.js",
		"src/getdata.js",
		"src/provider.js",
		"src/resources.js",
		"src/Options.js",
		"src/design.json",
		"src/v4prop.js"
	]
}
