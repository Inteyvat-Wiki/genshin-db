			"dialogs": [
				{
					"id": 750141001,
					"content": "#{M#Anh}{F#Chị} {NICKNAME}! May quá {F#hai chị}{M#anh chị} không sao, em lo lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141002
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141002,
					"content": "Đúng là rất nguy hiểm! Khụ, nhưng khó mà nói rõ lắm... Chuyện này để sau đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141003,
					"content": "Kể cho Taruka nghe những gì đã thấy ở doanh trại...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141004
					]
				},
				{
					"id": 750141004,
					"content": "#Sao lại thế được? {F#Hai chị}{M#Anh chị} không gặp Lamizana, mà lại gặp tiểu thư Quilla à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141005
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141005,
					"content": "Tuy nhiên họ có đề cập đến cuộc thi bay. Nghe có vẻ sẽ có một cuộc giao dịch gì đó, không biết là gì, nhưng hình như sẽ được sử dụng trong cuộc đua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141006,
					"content": "Tiểu thư Quilla là thương nhân lữ hành mới đến đây. Nghe Paran nói cô ấy mang theo rất nhiều hàng hóa. Nói không chừng Lamizana đã có được thứ gì đó nguy hiểm từ cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141007
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141007,
					"content": "Như vậy, anh ta sẽ thực hiện kế hoạch nguy hiểm của mình trong cuộc đua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141008,
						750141009
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141008,
					"content": "Vậy kế hoạch nguy hiểm đó là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				},
				{
					"id": 750141010,
					"content": "Không biết... Nhưng em biết chắc chắn anh ta đang âm mưu điều gì đó, và rất nguy hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141011
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141011,
					"content": "#Ra là ở đây. {F#Cô}{M#Cậu} là {NICKNAME} phải không? Tôi nghe Lamizana nói {F#cô}{M#cậu} đã trải nghiệm đường đua huấn luyện và thể hiện khá tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141012,
						750141013
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141012,
					"content": "Quá khen rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141015
					]
				},
				{
					"id": 750141015,
					"content": "Chuyện là thế này. Cuộc thi bay sắp diễn ra rồi, nhưng có một vận động viên đột ngột không thể tham gia, và lại chính là đối thủ của Lliwa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141016
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141016,
					"content": "Khụ, Taruka cũng biết đấy, cô ấy rất mạnh. Nếu để cô ấy thắng dễ như thế thì chắc chắn cô ấy sẽ không phục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141017
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141017,
					"content": "Vậy chị ấy không tham gia là được mà. Để em đi khuyên chị ấy lần nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141018
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141018,
					"content": "Vậy, vậy không ổn đâu! Cô ấy cũng đã chuẩn bị rất lâu cho cuộc thi này rồi. Hmm, tốt nhất là nên tìm được một người thay thế có năng lực tương đương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141019
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141019,
					"content": "#Vậy nên anh mới tìm đến {NICKNAME} à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141020,
					"content": "#Đúng thế. Chỉ cần tham gia, cho dù đạt được thứ hạng gì trong cuộc thi này thì chúng tôi cũng sẽ tặng {F#cô}{M#cậu} một phần thưởng riêng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141021,
						750141023
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141021,
					"content": "Đúng là bị coi thường thật rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141022
					]
				},
				{
					"id": 750141022,
					"content": "#Hả? À... Nếu {F#cô}{M#cậu} đạt được thứ hạng cao thì sẽ lấy được cả phần thưởng hạng và thưởng tham gia luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141025,
					"content": "Đồng ý tham gia là tốt rồi. Thư mời tham gia sẽ được gửi sau. Tôi còn việc khác phải chuẩn bị, lần sau gặp có lẽ là vào ngày diễn ra cuộc thi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141026
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141026,
					"content": "Paran dẫn theo Carrewoof rời đi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141027
					]
				},
				{
					"id": 750141027,
					"content": "#{NICKNAME} chấp nhận là vì để điều tra thêm phải không? Nếu có chuyện gì xảy ra trong cuộc thi bay thì một tuyển thủ chắc chắn sẽ biết nhanh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141028,
						750141029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141028,
					"content": "Tôi cảm thấy chuyện này không đơn giản như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141031
					]
				},
				{
					"id": 750141031,
					"content": "Nhưng kể ra thì giọng của Paran nghe quen quá. Hình như nghe thấy ở đâu rồi thì phải?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141032,
					"content": "Mọi việc ở đây đều cần anh ấy lo cả. Anh ấy và Carrewoof thường chạy đôn chạy đáo, muốn không nghe thấy giọng anh ấy cũng khó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141033
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141033,
					"content": "À! Nói mới nhớ, hình như vụ này đã từng đọc trong câu chuyện nào đó rồi thì phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141034
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141034,
					"content": "Nếu là kiểu người hòa nhập như vậy mà phạm tội, thì mọi người thường sẽ không nghĩ đến đầu tiên, vì đã quá quen thuộc với sự hiện diện của họ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141035,
					"content": "Hmm... Nhưng chuyện này tốt nhất đừng nhắc trước mặt anh ấy. Gia đình anh ấy trước đây có vài người đã làm việc xấu, bị bộ tộc trục xuất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141036
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141036,
					"content": "Sau này cũng có nhiều người lấy chuyện này làm cớ để gây phiền phức cho anh ấy... Có lẽ vì thế mà anh ấy luôn tự nghiêm khắc với bản thân, nhưng lại rất quan tâm đến mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141037
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141037,
					"content": "Thậm chí em cũng phải thừa nhận, mặc dù anh ấy rất thân với Lamizana, nhưng anh ấy cũng là người tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141038,
						750141040
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141038,
					"content": "Bộ Lamizana là loại sâu bọ có hại gì à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141039
					]
				},
				{
					"id": 750141039,
					"content": "Phải nói ngay cả sâu bọ cũng đáng yêu hơn anh ta gấp trăm lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141041
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141041,
					"content": "May mà giờ biết rồi! Nếu không, dù là vô tình nói ra thì cũng làm tổn thương người khác rồi. Còn chuyện thi bay thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141042,
					"content": "#Nếu đối thủ là chị của Taruka thì không cần lo lắng quá. Nếu có chuyện xảy ra thì {NICKNAME} chắc chắn sẽ bảo vệ chị em mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141043
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141043,
					"content": "Hmm... Đến lúc đó em sẽ đợi mọi người ở gần vạch đích. Lamizana và em chắc sẽ thi xong trước, em sẽ theo dõi anh ta thật kỹ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141044
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141044,
					"content": "Hrrooo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141045
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141045,
					"content": "#Lần này quả thật không phải là sân khấu phù hợp để {REALNAME[ID(2)|SHOWHOST(true)]} thể hiện rồi. Nhóc cứ ở yên mà xem thi đấu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141046,
					"content": "Wrrah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141040,
					"content": "Anh ấy trông cũng rất vất vả mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141041
					]
				},
				{
					"id": 750141029,
					"content": "Không, tôi chỉ muốn phần thưởng thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141030
					]
				},
				{
					"id": 750141030,
					"content": "Cho dù là để bản thân trông ngầu hơn một chút thì cũng nên tập trung vào vụ này đi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141023,
					"content": "Tuyệt vời, vậy là ít nhất cũng đã có thưởng tham gia rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141024
					]
				},
				{
					"id": 750141024,
					"content": "#Mục tiêu của {NICKNAME} thấp vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141013,
					"content": "Sao? Anh ta định xem thường tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141014
					]
				},
				{
					"id": 750141014,
					"content": "#Đâu có đâu có! Nếu là Temach thì sẽ nói thế nào trong tình huống này nhỉ... Đúng rồi, là đường đua huấn luyện không cung cấp đủ không gian cho {F#cô}{M#cậu} thể hiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141015
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141009,
					"content": "Nhưng động cơ của anh ta là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				}
			]
		},
