					"nextDialogs": [
						750141325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141325,
					"content": "Nhưng không ai lại đi buộc tội Iktomisaur cả... Với lại cũng đừng nói những lời đáng sợ thế chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141326,
					"content": "Tóm lại, đây là chiến thuật của tôi! Nếu không có tôi gây náo loạn bên ngoài thì mọi người cũng không thể thoát ra được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141327,
					"content": "Kể ra cũng trùng hợp, hóa ra trong hộp toàn là Bánh Quy Saurus. Khi đẩy đổ xuống thì lũ Iktomisaur kéo đến ngay, thật là hỗn loạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141328,
					"content": "Nhưng tôi ở bên ngoài cũng không thấy Lamizana. Tôi không nhìn rõ hai người bàn chuyện giao dịch trước đó lắm, nhưng chắc không phải Lamizana đâu, nghe giọng cũng không giống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141329,
					"content": "Hmm... Dù sao đi nữa, cứ báo lại mọi thứ đã chứng kiến cho Taruka đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
