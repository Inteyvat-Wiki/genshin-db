			"dialogs": [
				{
					"id": 750140801,
					"content": "(Hmm... Ở đây nhìn không rõ lắm, nhưng nếu tiến gần hơn thì có thể sẽ bị phát hiện. Thôi thì giữ khoảng cách này nghe lén xem họ nói gì đã.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750140802,
					"content": "Lô hàng lần trước chất lượng rất tốt, lần này cũng nhờ mọi người nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140803
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140803,
					"content": "Không dám không dám, vẫn quy tắc cũ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140804
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140804,
					"content": "Ừ, trước khi cuộc thi bay bắt đầu thì giao đến, sẽ có người cần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140805
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140805,
					"content": "Không thành vấn đề. Bên kia chắc cũng nói chuyện xong rồi, hay là rút lui thôi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140806
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140806,
					"content": "(Ể? Họ đi rồi à? Khác hẳn với những gì dự tính... Nhưng chúng ta cứ về trước đi, cẩn thận đừng để bị phát hiện nha.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
