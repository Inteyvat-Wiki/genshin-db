			"dialogs": [
				{
					"id": 750141201,
					"content": "Ơ? Cậu bé, bị lạc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141202
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141202,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141203,
					"content": "Rất giàu năng lượng, trông có vẻ khỏe mạnh. Sừng có hoa văn đặc biệt... rất đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141204
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141204,
					"content": "Nhưng tại sao mấy đứa lại ở đây cùng nhau? Do ta quản lý không tốt à? Không, điều đó không thể nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141205
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141205,
					"content": "Rooh? Rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141206,
					"content": "Hửm? Nó sao vậy? Chính nó đưa nhóc đến đây à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141207
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141207,
					"content": "(Không thể để cô ấy phát hiện ra...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141208,
						750141209
					]
				},
				{
					"id": 750141208,
					"content": "Hrroo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				},
				{
					"id": 750141210,
					"content": "Sao lại phát ra tiếng kêu kỳ lạ vậy? Chẳng lẽ ngươi bị bệnh à? Hành vi cũng khác thường, phải kiểm tra kỹ mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141211
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141211,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141212,
					"content": "Nhóc đừng vội, lát nữa đến lượt nhóc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141221
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141221,
					"content": "Đầu tiên là ngươi. Đi theo ta nào, hiểu mệnh lệnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141213,
						750141215,
						750141217
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141213,
					"content": "(Gật đầu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141214
					]
				},
				{
					"id": 750141214,
					"content": "Ngươi học trò này ở đâu thế? Hơn nữa, chẳng lẽ ngươi hiểu những gì ta nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141219,
					"content": "#Lúc này, bên ngoài vang lên một loạt tiếng ồn ào...\\n\"Ai mở cái hộp ra rồi... Này! Các người đừng giành giật nữa! Lát nữa Quilla sẽ nổi giận đấy!\"\\nKhông kịp xác nhận chuyện gì đã xảy ra, bạn cùng {REALNAME[ID(2)|SHOWHOST(true)]} nhân lúc hỗn loạn rời khỏi doanh trại trước...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750141215,
					"content": "(Lắc đầu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141216
					]
				},
				{
					"id": 750141216,
					"content": "Ngươi học trò này ở đâu thế? Hơn nữa, chẳng lẽ ngươi hiểu những gì ta nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141217,
					"content": "(Đi theo cô ấy.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141218
					]
				},
				{
					"id": 750141218,
					"content": "Kỳ lạ, ta chưa ra lệnh mà. Chẳng lẽ ngươi hiểu được lời ta nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
