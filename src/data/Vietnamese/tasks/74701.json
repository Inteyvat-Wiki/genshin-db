			"dialogs": [
				{
					"id": 747010101,
					"content": "Ủa? Sao cảm giác bên đây có thêm một cái bể nhỉ? Trên biển báo viết gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010102,
					"content": "\"Nguy hiểm, không được lại gần\"? Là sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010103,
					"content": "Thì theo nghĩa đen đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010104,
					"content": "Ối, Sandrone! Giật cả mình, biển báo này là cô dựng đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010105,
					"content": "Ừ, để tránh những người tò mò lại rơi xuống cái bể này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010106,
					"content": "Trong bể này có gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010107,
					"content": "Cá ăn thịt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010108,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010109,
					"content": "Haha, đùa đấy, vậy mà cũng tin à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010110,
					"content": "Dạo trước phát hiện vài con cá trong bể có ý thức lãnh thổ khá mạnh, tính tình cũng khá hung hăng, hay tấn công những con cá nhỏ khác. Nên đã chuyển chúng sang đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010111,
					"content": "Làm tôi hết hồn... Vậy nơi này giống như khu nghỉ dưỡng đặc biệt dành cho cá à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010112,
					"content": "Ừm, bể nước này khá sâu, không gian cũng rộng hơn nhiều. Có thể giúp những loài cá có ý thức lãnh thổ mạnh mẽ bình tĩnh lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010113,
					"content": "Tôi còn xin y tá Sigewinne ở Pháo Đài Meropide một ít thức ăn đặc chế để xoa dịu sự nóng nảy của chúng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010114,
					"content": "Ồ, ra là vậy. Cô cũng khá quan tâm đến mấy con cá này đấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010115,
					"content": "Không ai thấy thoải mái khi nhìn chúng đánh nhau trong bể đâu, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010116,
					"content": "Đúng vậy. Vậy thì cứ giao việc này cho chúng tôi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010117,
					"content": "Được thôi. Tóm lại, chỉ cần những con cá trong bể có hứng thú lên mặt nước hít thở, thì chứng tỏ chúng sắp khỏe lại rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010118,
					"content": "Khi tính tình chúng hồi phục lại là có thể đưa chúng về lại bể cá rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010119,
					"content": "Thả về đâu thì tùy hai người quyết. Tôi chỉ chịu trách nhiệm vớt những con không nghe lời sang bể này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747010120,
					"content": "Được thôi, nhưng biển báo của cô trông đáng sợ quá, hay là đổi cái khác đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010121,
					"content": "Ừm... cũng được. Cá do hai người bắt mà, tùy hai người thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
}