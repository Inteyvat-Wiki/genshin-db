			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "Không biết anh Aurele có tìm được ý tưởng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060402,
					"content": "#Ấy?! Chỗ này mà cũng bị tìm thấy sao? Rốt cuộc thì {M#anh}{F#chị} đã chơi trốn tìm bao nhiêu lần rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060403,
					"content": "Vậy em về điểm tập trung, lần sau chắc chắn sẽ trốn tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
			"id": 2400606,
