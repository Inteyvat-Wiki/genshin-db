				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "Lần này tới lượt mình đi bắt, chắc chắn sẽ bắt được Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060102,
					"content": "Chưa chắc. Có một số chỗ cậu không trèo lên nổi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060103,
					"content": "Đó là... Đó là vì giày của tớ không hợp để leo trèo, chỉ cần đổi đôi giày khác là sẽ bắt được cậu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060104,
					"content": "Vậy chúng ta tháo giày đi chân đất đi, như vậy mới công bằng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060105,
					"content": "Không được để chân trần chạy lung tung đâu đấy, xung quanh toàn là linh kiện phế thải, lỡ bị trầy xước thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060106,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060107,
					"content": "Vâng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060108,
					"content": "...Anh, khi nãy lúc bắt em, sao trông anh ngẩn ngơ vậy? Em chạy qua trước mặt cũng không phản ứng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060109,
					"content": "Hả? Vậy à? Lúc nãy anh không để ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060110,
					"content": "Đúng thế, lúc nãy em còn chạy quanh một vòng, nhưng trông anh cứ như kiểu không nhìn thấy em vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060111,
					"content": "#Nhưng... Ơ? {M#Anh trai}{F#Chị gái}, sao lại tới đây rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060112,
					"content": "Lovi sao lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Bố nói dạo này phải đi công tác, mẹ em cũng đang đi làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060114,
					"content": "Vừa hay anh Aurele tới trả sách, bố đã nhờ anh Aurele trông nom em, nên em đã tới đây chơi với mọi người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060118,
					"content": "Không nói chuyện này nữa, chơi tiếp thôi, lần này tới ai đi bắt nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060119,
					"content": "#{M#Anh}{F#Chị} tưởng em không thích chơi trốn tìm chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Cái này à, khụ... Là vì gần đây em đang viết bài bình luận đầu tiên, cần phải suy nghĩ một số vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060122,
					"content": "Em thấy... lúc vận động thì suy nghĩ của em sẽ vô cùng linh hoạt, cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060123,
					"content": "Nhưng mà dễ lơ đãng, đôi lúc còn đứng yên một chỗ lẩm bẩm một mình, gọi thế nào cũng không phản ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060124,
					"content": "#{M#Anh trai}{F#Chị gái}, hay {M#anh}{F#chị} chơi cùng tụi em đi, {M#anh}{F#chị} chơi trốn tìm lợi hại hơn anh Aurele nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060125,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Hihi, cái này không chắc nha, em với Lovi đều là bậc thầy trốn tìm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060128,
					"content": "Vậy bắt đầu đi, nhanh lên Lovi, chúng ta mau đi trốn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060129,
					"content": "Lovi và Verut chạy nhanh đi, còn Aurele thì vừa đi vừa suy nghĩ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "#{M#Anh}{F#Chị} sẽ không nhường đâu đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "Sao đột nhiên lại thích chơi trốn tìm vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "Mấy đứa đang chơi trốn tìm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Đúng rồi. Chú Delerue phải đi công tác, dì Dumay thì phải đi làm, nên họ đã nhờ em chăm sóc cho Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060117,
					"content": "Cho nên em đã dẫn Lovi tới đây chơi, hy vọng em ấy sẽ không làm bẩn bộ váy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Aurele"
				}
			]
		},
		{
			"id": 2400602,
			"completionStepIds": [
				2400602
