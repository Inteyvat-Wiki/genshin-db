					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "Không được... đoạn này không suôn lắm, cần phải tiếp cận từ góc độ khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060302,
					"content": "Như này... không đúng, vẫn không đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060303,
					"content": "A? Bị tìm thấy rồi à, về điểm tập trung thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060304,
					"content": "Hừm... Quan điểm này đúng không nhỉ? Không đúng, hừm... Đúng hay không đúng đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
		{
			"id": 2400604,
