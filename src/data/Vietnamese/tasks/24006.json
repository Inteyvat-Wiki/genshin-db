					"Verut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#Lại bị tìm thấy rồi, {M#anh}{F#chị} quả nhiên giỏi hơn tụi em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "Vậy em tới chỗ tập trung, hy vọng anh Aurele không bị bắt sớm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "Sao em lại muốn như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "Anh ấy từng nói mà, sau mỗi lần chơi trốn tìm là anh Aurele sẽ có được rất nhiều ý tưởng mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "Ý tưởng quá nhiều, mỗi lần anh ấy đều ngồi bần thần ghi nhớ rất lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lovi nói với em những thứ đó vô cùng quý giá, tuyệt đối không được làm phiền anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "Nên khi em và Lovi chơi trốn tìm với anh Aurele. Nếu đến lượt anh ấy đi trốn thì tụi em sẽ cố tình kéo dài thời gian, đợi anh Aurele ghi nhớ hết mọi thứ rồi mới đi tìm anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "Nếu tới lượt anh ấy đi bắt là tụi em sẽ phải đợi rất lâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
			],
