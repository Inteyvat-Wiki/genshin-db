			"dialogs": [
				{
					"id": 401360101,
					"content": "Một thời gian sau nữa...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "Xavier! Lâu rồi không gặp anh đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360104,
					"content": "Chào hai vị! Sau khi làm xong phần hậu kỳ, tôi lại bắt tay vào xử lý công việc quảng bá và công chiếu bộ phim rồi. Thực sự bận quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360105,
					"content": "Hôm nay là ngày trao giải rồi nhỉ? Cũng không biết bộ phim của chúng ta có được Giải Thưởng Furina không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360106,
					"content": "Cái này thì tôi chắc chắn đến chín phần đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360107,
					"content": "Furina! Hóa ra cô đã ở đây rồi à, đến sớm hơn hẳn mọi người đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360108,
					"content": "Chắc mọi người cũng sắp đến rồi. À, Xavier, nói đến giải thưởng, anh cũng nên đặt tên cho đoàn làm phim của chúng ta chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360109,
					"content": "Hả? Nhưng tôi còn chưa biết có được giải không... Tôi... tôi không dám nghĩ trước vậy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360110,
					"content": "Mở to mắt ra, nhìn phản ứng của dòng người khi rời rạp đi! Không một ai chê cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360111,
					"content": "Chắc anh cũng biết chứ nhỉ? Nhân viên rạp chắc đã tìm anh để đòi tăng suất chiếu của bộ phim rồi mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360112,
					"content": "Doanh thu phòng vé lần này chắc đủ để anh thành lập một hãng phim đàng hoàng rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360113,
					"content": "Nhưng đây đâu phải công lao của mình tôi! Còn có cả tâm huyết của các vị nữa, không thể để mình tôi quyết định cái tên này được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360114,
					"content": "Tóm lại, anh cứ nghĩ đi, tôi tin là mọi người sẽ đồng ý thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360115,
					"content": "#Thôi được... Nhưng trước lúc đó, {NICKNAME} và Paimon, có thể phiền hai vị đến Pháo Đài Meropide một chuyến không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360116,
					"content": "Ủa? Không phải còn lễ trao giải nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360117,
					"content": "Tôi muốn hai vị đi tìm và mời một trong những nhân vật chính của bộ phim đến đây, tiểu thư Chevreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360118,
					"content": "Dạo này tôi không gặp được cô ấy, cũng không có cơ hội thông báo cho cô ấy tới tham dự lễ trao giải hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360119,
					"content": "Nhưng trên báo có nói, hôm nay, thủ phạm của vụ án súng hỏa mai sẽ được đích thân đội trưởng Đội Tuần Tra Đặc Biệt áp giải đến Pháo Đài Meropide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360120,
					"content": "Ồ, ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360121,
					"content": "Chuyện nhỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "Ừm! Anh Xavier đợi ở đây là được, tranh thủ nghĩ ra cái tên thật hay đi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360123,
					"content": "Được, xin phiền hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
