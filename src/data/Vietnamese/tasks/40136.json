			"dialogs": [
				{
					"id": 401360301,
					"content": "Tôi xin công bố, bộ phim nhận được Giải Thưởng Furina của Liên Hoan Phim Fontinalia lần thứ nhất là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360302
					],
					"speakerTitle": "Người Dẫn Chương Trình"
				},
				{
					"id": 401360302,
					"content": "\"Hai Người Lính Ngự Lâm\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360303
					],
					"speakerTitle": "Người Dẫn Chương Trình"
				},
				{
					"id": 401360303,
					"content": "Là chúng ta kìa! Thực sự là chúng ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360304,
					"content": "Chúc mừng anh, Xavier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360305,
					"content": "Trời ơi, tôi... tôi... thực sự vô cùng cảm ơn các vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360306,
					"content": "Suy đoán của tôi về giới giải trí Fontaine chưa bao giờ là sai cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360307,
					"content": "Ngay bây giờ, xin mời nhà sản xuất của bộ phim \"Hai Người Lính Ngự Lâm\", anh Xavier, bước lên sân khấu nhận giải thưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "Người Dẫn Chương Trình"
				},
				{
					"id": 401360308,
					"content": "Cảm ơn... Vô cùng cảm ơn sự công nhận của quý vị dành cho bộ phim. Tại đây, tôi cũng gửi lời cảm ơn tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360309,
					"content": "Thời gian trôi nhanh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360310,
					"content": "Ừm, cảm giác khoảnh khắc Chevreuse dạy tôi cầm súng mới chỉ vài hôm trước thôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360311,
					"content": "Cô sẽ đến Fontaine nữa chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360312,
					"content": "Đương nhiên rồi! Tôi thích thành phố này, có nhiều thứ mới mẻ tôi còn chưa xem hết nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360313,
					"content": "Chevreuse có định đến Inazuma không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360314,
					"content": "...Lúc trước tôi chưa từng có dự định này. Nhưng hiện tại có thể cân nhắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360315,
					"content": "Tôi rất mong chờ chuyến thăm này đó. Đến lúc đó, tôi muốn mời cô về nhà làm khách, nếm thử các món ăn nhẹ trong tiệc trà của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360316,
					"content": "Ừm, vậy chúng ta giữ liên lạc nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360317,
					"content": "Mọi chuyện có như anh mong đợi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360318,
					"content": "Cô cũng nên về Inazuma một chuyến đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360319,
					"content": "Tiệm Vải Ogura thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360320,
					"content": "Tất cả đều ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360321,
					"content": "Thay tôi gửi lời hỏi thăm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360322,
					"content": "Được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360323,
					"content": "Nghe nói sấm chớp ở quê nhà đã ngừng rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360324,
					"content": "Cũng không còn chiến tranh nữa, quê hương đã có lại hòa bình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360325,
					"content": "Nghe có vẻ ổn, thời tiết đó sẽ thích hợp để phơi vải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360326,
					"content": "...Một lần nữa cảm ơn tất cả những người mà tôi nhắc đến. Nhờ các vị mà tôi mới được đứng trên sân khấu trao giải, chính các vị là người đã hoàn thành bộ phim này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360327,
					"content": "Ngoài ra, được sự đồng ý của cả đoàn, tôi xin chính thức đặt tên cho đoàn làm phim Xavier là... \"Hãng Phim Ngự Lâm\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360328,
					"content": "Hihi, nghe ngầu thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360329,
					"content": "Vậy... Sau đây xin được mời tất cả thành viên của Hãng Phim Ngự Lâm bước lên sân khấu để chụp ảnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "Người Dẫn Chương Trình"
				},
				{
					"id": 401360330,
					"content": "Ồ! Có cả tiết mục chụp ảnh nữa à?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360331,
					"content": "Đạo diễn Furina, tôi nghĩ, cô mới là người xứng đáng để nâng cao giải thưởng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360332,
					"content": "Hả? Thôi, không cần đâu... xấu hổ chết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360333,
					"content": "Không ai thích hợp hơn đạo diễn cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360334,
					"content": "Rất xứng đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360335,
					"content": "Tôi không thể nghĩ ra ai tốt hơn cho danh dự này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "Cô nghe theo mọi người nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360337,
					"content": "Sẵn sàng chưa? Ba, hai, một...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "Người Dẫn Chương Trình"
				},
				{
					"id": 401360338,
					"content": "Hãng Phim Ngự Lâm!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
