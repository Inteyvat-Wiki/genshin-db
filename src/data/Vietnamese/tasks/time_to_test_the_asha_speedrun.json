					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480804,
					"content": "Đặc biệt là phần phối hợp cuối cùng, sự ăn ý của cả hai đã phát huy tác dụng rất lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480805,
					"content": "Hợp tác phá vỡ mọi sự xui xẻo.",
