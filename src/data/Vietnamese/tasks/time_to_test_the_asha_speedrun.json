					"nextDialogs": [
						150480305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480305,
					"content": "Đúng! Tôi đã khởi động làm nóng người, vận động gân cốt và cơ bắp toàn thân rồi. Cứ để tôi.",
					"roleType": "TALK_ROLE_NPC",
