			"dialogs": [
				{
					"id": 150480101,
					"content": "...Chúng tôi không thể để quý khách đối mặt với mối nguy này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480102,
					"content": "Nhưng vừa rồi anh có nói là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480103,
					"content": "Thật sự xin lỗi. Tuy thời gian gấp gáp, nhưng chúng tôi phải quan tâm đến sự an toàn của du khách hơn, hy vọng hiểu cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480104,
					"content": "#{NICKNAME} đến thật đúng lúc, hãy giúp tôi thuyết phục anh ấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480105,
					"content": "Họ cần người thử nghiệm. Tôi khó khăn lắm mới chứng minh được kinh nghiệm của mình, cũng sẵn sàng gánh vác hậu quả. Mọi chuyện vốn rất thuận lợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480106,
					"content": "Nhưng vừa nghe tới \"những trải nghiệm nguy hiểm trong quá khứ\" của tôi, thì anh ấy không đồng ý nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480107,
					"content": "Tôi rất hiểu sự nhiệt tình của quý khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480108,
					"content": "Nhưng nếu khi qua cầu mà cứ trượt chân xuống nước thì tốt nhất là nên tham gia hạng mục khác nhẹ nhàng hơn... Hay là chơi ở chiếc ghế nằm bên bờ biển đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480109,
					"content": "Haiz, nhưng tôi thực sự là nhà mạo hiểm phù hợp với điều kiện thử nghiệm mà! Chỉ là do... tôi xui xẻo thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480110,
					"content": "Tôi thật sự muốn giúp đỡ mà, hãy tin tưởng vào thực lực của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480111,
					"content": "Tôi có thể chứng minh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "Nếu đại anh hùng giải cứu Natlan đã nói như vậy thì... Thế này đi, có thể để Asha hoàn thành vòng thử nghiệm đầu tiên trước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480114,
					"content": "Quý khách cứ đứng bên cạnh xem thử và làm quen với cả tuyến đường. Nếu mọi thứ thuận lợi thì có thể tham gia vòng thử nghiệm thứ hai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480115,
					"content": "Asha có đồng ý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480117,
					"content": "Được! Vậy thì giao cho cậu đó, bạn đồng hành tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480112,
					"content": "Tôi đảm bảo cho cậu ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
