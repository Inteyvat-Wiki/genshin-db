					"nextDialogs": [
						150480806
					]
				},
				{
					"id": 150480806,
					"content": "Ừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480807
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480807,
					"content": "#Tôi còn muốn cảm ơn {NICKNAME} nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480808,
					"content": "#Nếu không phải {F#cô}{M#cậu} tin tưởng, giúp tôi thuyết phục nhân viên, thì tôi cũng không có cơ hội hoàn thành thử thách và vượt qua khó khăn cùng Asha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480809
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480809,
					"content": "Chào anh Bennett, thử nghiệm an toàn đã được hoàn thành rồi. Asha Tốc Độ sẽ chính thức được đưa vào vận hành. Cảm ơn đã giúp đỡ nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480810
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480810,
					"content": "Asha, nghe thấy không? Chúng ta thành công rồi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480811
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480811,
					"content": "Tôi sẽ ghi nhớ tên của anh, nhà mạo hiểm Bennett nhiệt tình và dũng cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480812,
					"content": "Tuy chuyến mạo hiểm vẫn đang tiếp tục, nhưng tôi cứ cảm thấy mình ngày càng không nỡ rời xa Asha rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480813
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480813,
					"content": "Tôi sẽ nhớ Asha lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480814
					],
					"speakerTitle": "Bennett"
