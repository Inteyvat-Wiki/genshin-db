			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090201,
					"content": "Rất ngọt và mịn, hoàn toàn không đắng. Đây là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090202
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090202,
					"content": "Đó là \"Nụ Hôn Tuyết Phủ\"! Cách làm là đánh sữa cho đến khi nổi bọt, sau đó đổ nhẹ nhàng lên nước trái cây để trông như một lớp tuyết phủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090203,
					"content": "Còn tại sao có tên là nụ hôn thì... Paimon không hiểu... chắc là chiêu trò kinh doanh thôi ấy mà, để bán chạy hơn thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090204,
					"content": "Bán chạy hơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090205
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090205,
					"content": "Hả? Không phải sao? Tôi, tôi đoán bừa thôi... vậy chắc kiểu đặt cho lãng mạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090206,
					"content": "Lãng mạn...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090207,
					"content": "Chậc... khó diễn giải lắm! Đừng ép Paimon giải thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090208,
						705090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090208,
					"content": "Bọt sữa không có quá nhiều vị...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				},
				{
					"id": 705090210,
					"content": "Đúng vậy đúng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090211,
						705090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090211,
					"content": "Cảm giác đầu tiên khi uống nước ép sẽ thấy rất ngọt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090213,
					"content": "...Ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090214
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090214,
					"content": "Vậy sao... tôi... có lẽ đã hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090215,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090216,
					"content": "Đợi đã! Sao giờ chỉ còn Paimon là chưa hiểu vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090217,
					"content": "Khi tôi đi trên núi, đôi lúc dừng lại ăn tiên thảo, cũng từng thấy những mầm non chớm nở từ dưới đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090218
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090218,
					"content": "Trong lòng tôi có chút lay động... đúng là giống như bây giờ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090219
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090219,
					"content": "#{NICKNAME}, cảm ơn bạn đã giải thích cho tôi... những cái tên khó hiểu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090220
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090220,
					"content": "Sau này có lẽ phải phiền bạn thêm nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090212,
					"content": "Giống như mầm non xuyên qua băng giá, gửi tặng Shenhe nụ hôn vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090209,
					"content": "Giống như tuyết trên núi vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				}
			]
		}
	]
}