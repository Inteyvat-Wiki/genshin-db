				"points": []
			},
			"dialogs": [
				{
					"id": 705090101,
					"content": "#Xin chào, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090102
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090102,
					"content": "Ồ xin chào! Haiz, nếu không phải gặp được nhiều người từ phương xa tới thì tôi nhất định sẽ rất ngạc nhiên đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090103,
					"content": "Không... không đúng, đây là Shenhe mà! Đúng là vẫn ngạc nhiên thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090104,
					"content": "Ừm... nơi này thật khó tìm. \"Quà Tặng Của Thiên Sứ\"... khó đọc quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090105
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090105,
					"content": "May mà có Zhongli tiên sinh tốt bụng chỉ đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090106
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090106,
					"content": "Còn tìm cả người chỉ đường sao... để tôi đoán xem, cô đến để thử đồ uống sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090107,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090108
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090108,
					"content": "Bởi vì chúng ta là... bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090109
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090109,
					"content": "Cô muốn uống gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090110
					]
				},
				{
					"id": 705090110,
					"content": "Đây là thực đơn nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090111,
					"content": "Ánh Nhìn Gió Bắc... gió bắc, lạnh lắm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090112
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090112,
					"content": "Ừm, gió bắc của cái tên này chắc là chỉ Sói Bắc Phong đúng không? Hừm... đúng là khá lạnh đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090113,
					"content": "Quả Thông Ngào Đường... cái này có thể uống được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090114
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090114,
					"content": "À, cái này tôi có thử qua rồi, là cà phê có vị kẹo đường, còn quả thông thì... chắc là nói tới màu sắc đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090115,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090116
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090116,
					"content": "Nhìn tên thì đúng là khó hiểu thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090117
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090117,
					"content": "Các bạn chọn giúp tôi nhé. Mùi vị giống như Thanh Tâm hay Túi Lưu Ly là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090118
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090118,
					"content": "Thổ nhưỡng ở đây không thích hợp để trồng những loại thảo dược đó đâu, nếu cô muốn uống đắng thì thử cà phê nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090119,
					"content": "Cô muốn nếm thử vị ngọt không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090120
					]
				},
				{
					"id": 705090120,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090121
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090121,
					"content": "Vậy nhé, lâu lâu đổi khẩu vị chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090122,
					"content": "Vậy chúng ta tặng cho Shenhe một ly Nụ Hôn Tuyết Phủ nhé, rất hợp với Shenhe đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7050902,
			"completionStepIds": [
				7050903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
