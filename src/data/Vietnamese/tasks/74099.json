			"dialogs": [
				{
					"id": 740990101,
					"content": "Về kinh nghiệm câu được ma vật trước đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "À! Nghĩ kỹ thì... Là vì mồi câu đã thu hút ma vật tới, quả thật là một trải nghiệm rất đặc biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Mặc dù bản thân tôi không sợ ma vật lắm, trước đây tự mình đi lại giữa Viện Khoa Học và Đại Sảnh Fontaine, cũng từng giao chiến với đạo tặc vài lần, chưa lần nào thua kém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "Nhưng hiện tại tôi đang đứng đây với tư cách là Quản Lý Hội Câu Cá rồi, cũng phải làm tròn bổn phận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "Dù có dọa cho những con cá khác dưới nước chạy hết, hay phiền nhiễu những người câu cá xung quanh, đều không xứng với sự công nhận của mọi người với một quản lý như tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "Vì vậy, tôi phải tuân thủ, phải thận trọng một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
		}
