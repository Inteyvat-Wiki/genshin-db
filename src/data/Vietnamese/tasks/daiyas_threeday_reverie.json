			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440101,
					"content": "Cảm ơn vận mệnh dẫn lối. Hỡi lữ khách lang thang, các bạn cuối cùng cũng đã tới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440102
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440102,
					"content": "Các bạn đang tìm kiếm một cuộc gặp gỡ đầy bất ngờ hay một chuyến hành trình ngoài sức tưởng tượng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440103
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440103,
					"content": "Giờ đây, cơ hội để hiện thực hóa nó đang được bày ra trước mắt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440104
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440104,
					"content": "Hãy nhập vai vào tập mới nhất \"Ba Ngày Mơ Mộng Của Daiya\", đắm chìm vào vở kịch trên sân khấu, để có được trải nghiệm mới lạ chưa từng có!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440105
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440105,
					"content": "Thỏa sức vẫy vùng trong bể bơi Mora... xua tan u hồn trong lâu đài... thoát khỏi sự trói buộc của trọng lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440106
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440106,
					"content": "Khẽ đọc khẩu hiệu: \"Đưa chúng tôi đến thế giới mơ mộng\", thể hiện sự hiếu kỳ và lòng nhiệt tình của các bạn, bắt đầu lên đường nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440107
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440107,
					"content": "Ồ, người phát loa có vẻ phấn khích nhỉ, tuy không biết cô ấy đang nói gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440108,
					"content": "Hành trình? Phim truyện? Sân khấu? Còn có... bể bơi Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440109,
						790440110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440109,
					"content": "Có thể là một dự án trò chơi mới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				},
				{
					"id": 790440111,
					"content": "Ồ! Paimon có vẻ như hiểu rồi, trước đó đã từng nghe về hoạt động này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440112,
					"content": "Vậy người đang phát loa chính là Daiya sao? Cô ấy chắc là đạo diễn của vở kịch nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440113,
					"content": "Nếu chúng ta đăng ký thì sẽ được nhập vai vào vở kịch này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440114,
						790440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440114,
					"content": "Paimon có hứng thú không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440116,
					"content": "Nghe thú vị đó! Tôi cũng muốn trông thấy bể bơi Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440117,
					"content": "À không! Tôi chỉ muốn xem thử một dự án trò chơi trong Ảo Cảnh Veluriyam sẽ là nơi như thế nào thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440118,
					"content": "Vậy chúng ta cùng đọc khẩu hiệu đăng ký nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440119,
					"content": "Hãy đưa chúng tôi đến thế giới mơ mộng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440120
					]
				},
				{
					"id": 790440120,
					"content": "Hãy đưa chúng tôi đến thế giới mơ mộng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440121,
					"content": "Dứt khoát vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440122
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440122,
					"content": "E-hèm, hoàn hảo! Tín hiệu đăng ký đã được xác nhận, \"Ba Ngày Mơ Mộng Của Daiya\" chuẩn bị bắt đầu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440123
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440123,
					"content": "\"Truyền thuyết cổ xưa lại xuất hiện, kho báu vô giá đã có thêm manh mối. Một toán cướp biển hào hiệp lau chùi vũ khí, căng buồm ra khơi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440124
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440124,
					"content": "\"Thị trấn nhỏ trôi nổi trên bầu trời gặp phải mối nguy chưa từng có. Kiến trúc sư tạo ra kỳ quan này đã phải tức tốc cứu vãn thị trấn đang sụp đổ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440125
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440125,
					"content": "\"Để giải cứu người bạn không may gặp nạn, Eidolon Thủy Lạc Lõng đã xâm nhập vào lâu đài nơi u hồn trú ngụ, tìm kiếm hy vọng xóa bỏ lời nguyền...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440126
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440126,
					"content": "Ba chủ đề khác nhau, mời các vị tự do lựa chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440127
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440127,
					"content": "Cứ đi tìm loa thông báo và đi theo lời dẫn truyện, là sẽ đến với vùng đất mơ mộng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440128
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440128,
					"content": "#Hiểu rồi! {NICKNAME}, giờ chúng ta đi tìm chiếc loa như mô tả thử xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440115,
					"content": "Chúng ta cùng nhau làm diễn viên nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440110,
					"content": "Ví dụ như du khách sẽ tham gia diễn kịch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				}
			]
		},
		{
			"id": 7904406,
			"completionStepIds": [
				7904405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904405",
							"2"
						],
						"stepId": 7904405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440601,
					"content": "Woa! Nhiều Giọt Nước Nhỏ quá... Chúng đang vây lấy thiết bị to lớn này để làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440602,
					"content": "Không hiểu gì cả, thiết bị này để làm gì vậy? Daiya đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440603,
					"content": "Chào mừng đến với hậu trường của \"Ba Ngày Mơ Mộng\"! Các bạn chắc hẳn đang rất thắc mắc... cảnh vật trước mắt đang nói lên điều gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440604
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440604,
					"content": "Chúng tôi sẽ cho các bạn xem chi tiết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440605
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440605,
					"content": "\"Lười Biếng\", đừng ngủ gật nữa, mau tới vị trí số một, tiếp tục thao tác số hai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440606
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440606,
					"content": "\"Cảm ơn vận mệnh dẫn lối. Hỡi lữ khách lang thang, các bạn cuối cùng cũng đã tới!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440607
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440607,
					"content": "Giọt Nước Nhỏ đó hình như đang điều khiển loa, là bản... ghi âm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440608,
					"content": "Nghe quen quá... hình như nghe qua ở đâu đó rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440609,
						790440610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440609,
					"content": "Loa thông báo khi bắt đầu sự kiện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				},
				{
					"id": 790440611,
					"content": "\"Chuyên Cần\", hãy thao tác số bảy ở vị trí số ba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440612
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440612,
					"content": "\"Thuyền phó xuất hiện trước mặt với quần áo tả tơi, băng bó đầy mình, rõ ràng là vừa trải qua một trận chiến vô cùng khốc liệt...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440613
					],
					"speakerTitle": "Lời Dẫn Truyện Từ Loa"
				},
				{
					"id": 790440613,
					"content": "Nhớ ra rồi! Đây chính là lời dẫn truyện \"Pha Lê Đen Và Thủy Quái Nuốt Vàng\", cảnh tượng lúc chúng ta gặp thuyền phó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440614,
					"content": "Đoạn ghi âm chúng ta nghe khi đó hóa ra là được phát đi như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440615,
					"content": "\"Liều Lĩnh\", \"Pha Lê Đen\" sắp đến cửa ải phía trước kho báu rồi, mau nâng toàn bộ bối cảnh và thiết bị lên cao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440616
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440616,
					"content": "Giọt Nước Nhỏ hình như đang sử dụng cách thức nào đó để... điều khiển máy móc trước mặt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440617,
						790440618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440617,
					"content": "Giám sát, phát thanh và điều khiển thiết bị...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440619,
					"content": "Đúng vậy, thiết bị lớn này là để điều khiển tất cả tính năng của vở kịch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440620
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440620,
					"content": "Những Eidolon Thủy chăm chỉ đang liên tục quan sát tiến độ của màn biểu diễn. Khi khách đến vị trí cụ thể sẽ phát lời dẫn theo kịch bản, khởi động thiết bị tương ứng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440621
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440621,
					"content": "Chỉ cần khách đi theo đúng lộ trình, là sẽ có thể thưởng thức trọn vẹn màn biểu diễn \"Ba Ngày Mơ Mộng\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440622
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440622,
					"content": "Tất nhiên, nếu khách nhảy ra giữa chừng, hoặc có những hành động nằm ngoài dự tính thì sẽ không thể trải nghiệm trọn vẹn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440623
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440623,
					"content": "Nhân công của chúng tôi không đủ để đối phó với những tình huống như vậy... Nhưng chúng tôi tin là quý khách sẽ không làm bậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440624
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440624,
					"content": "Lợi hại quá! Không ngờ đằng sau sân khấu lại có nhiều thứ như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440625,
					"content": "Nghĩ lại thì trên đường có vô số máy móc cần được khởi động, điều khiển màn biểu diễn phức tạp thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440626,
						790440627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440626,
					"content": "Thiết kế rất khéo léo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440628,
					"content": "Vậy thì... giọng nói đang trò chuyện với chúng ta chính là Daiya sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440629,
					"content": "Cô đang dùng Eidolon Thủy để điều khiển màn biểu diễn \"Ba Ngày Mơ Mộng\" hả? Sao không đích thân nói với chúng tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440630,
					"content": "Tôi có rất nhiều điều muốn hỏi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440631,
					"content": "Đoán đúng đó, nhưng lại không đúng hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440632
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440632,
					"content": "Như các bạn đã thấy, mọi thứ trong phòng phát thanh này... Máy điều khiển, \"Đạo Diễn Chính\", \"Biên Kịch Giả\", \"Lười Biếng\", \"Chuyên Cần\" và \"Liều Lĩnh\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440633
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440633,
					"content": "Tất nhiên còn có các Eidolon Thủy đang vận hành vở kịch này vẫn chưa lộ diện hoặc chưa lên tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440634
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440634,
					"content": "Âm thanh này được kết hợp từ tất cả mọi thứ... Daiya là hệ thống điều khiển, chứ không phải một người cụ thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440635
					],
					"speakerTitle": "Loa Thông Báo"
				},
				{
					"id": 790440635,
					"content": "Daiya không phải một người... mà là một hệ thống sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440636,
					"content": "Chờ đã, hơi khó hiểu rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440637,
					"content": "Tuy Giọt Nước Nhỏ rất thông minh, nhưng chỉ dựa vào Giọt Nước Nhỏ mà có thể thiết kế ra cả hệ thống phức tạp như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440638,
						790440639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440638,
					"content": "Trong hậu trường chắc có một chuyên gia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440640,
					"content": "Ban đầu thì đúng là như vậy, sự kinh ngạc của các bạn cũng nằm trong dự tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440641
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440641,
					"content": "Chuyện dài lắm, \"Ba Ngày Mơ Mộng Của Daiya\" bắt nguồn từ đạo diễn Zosimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440642
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440642,
					"content": "Trong thời gian ở \"Ảo Cảnh Veluriyam\", anh ấy đã dành phần lớn sức lực cho vở kịch đặc sắc nhất, không có thời gian để chuẩn bị vở diễn khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440643
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440643,
					"content": "Sau khi tiếp xúc với Eidolon Thủy, anh ấy đã phát hiện ra trí tuệ và cảm xúc phong phú của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440644
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440644,
					"content": "Eidolon Thủy rất thích vở kịch của anh ấy, muốn được chứng kiến thêm và lan tỏa niềm vui này cho những vị khách khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440645
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440645,
					"content": "Một ý nghĩ đã nảy sinh trong tâm trí của Zosimos: Liệu có thể để Eidolon Thủy tự mình đạo diễn và thiết kế màn kịch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440646
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440646,
					"content": "Thật liều lĩnh! Nghe giống như... dạy đám trẻ làm đạo diễn vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440647,
					"content": "Quả thật rất khó, cũng may mọi người cùng nhau cố gắng, khắc phục mọi khó khăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440648
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440648,
					"content": "Zosimos đã nỗ lực chỉ dạy cho một số Eidolon Thủy yêu thích kịch nói, giúp chúng nắm được những quy trình quan trọng khi tổ chức biểu diễn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440649
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440649,
					"content": "Trải qua nhiều thử nghiệm và sai sót, anh ấy đã sử dụng ngôn ngữ mà Eidolon Thủy có thể hiểu để viết nhiều vở kịch mẫu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440650
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440650,
					"content": "Dưới sự giúp đỡ của Idyia, anh ấy chế tạo ra thiết bị điều khiển này, và xây dựng hệ thống kết nối với nó ở khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440651
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440651,
					"content": "Ngoại trừ lời thoại trong kịch bản, Zosimos còn ghi âm phần lớn từ ngữ thường gặp, giúp chúng tôi dễ dàng kết hợp thành một câu để trò chuyện với khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440652
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440652,
					"content": "Sau một thời gian phối hợp, chúng tôi cuối cùng đã vận hành ba vở kịch mẫu một cách suôn sẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440653
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440653,
					"content": "Đó chính là \"Pha Lê Đen Và Thủy Quái Nuốt Vàng\", \"Ánh Nhìn Hóa Đá\", \"Chuyến Giải Cứu Thị Trấn Trên Không\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440654
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440654,
					"content": "Có thể nói... Zosimos đã để lại cho \"Ba Ngày Mơ Mộng Của Daiya\" điều kiện cơ bản, kịch bản phù hợp và sách hướng dẫn chi tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440655,
					"content": "Chúng ta không hề nhận ra tất cả chuyện này đều do những Giọt Nước Nhỏ điều khiển đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440656,
					"content": "Cảm ơn lời khen! Sự vui thích của các bạn đã khẳng định nỗ lực của chúng tôi, là kiểm chứng cho rất nhiều ý tưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440657
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440657,
					"content": "Vì vậy, chúng tôi muốn gửi một món quà cảm ơn, và chia sẻ với các bạn tất cả mọi thứ trên con đường sáng tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440658,
						790440659
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440658,
					"content": "Khách sáo quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440660,
					"content": "Đúng đó, chúng tôi đã được trải nghiệm một tiết mục độc đáo, cảm ơn Daiya nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440661,
					"content": "Haha! Bây giờ chúng tôi sẽ tiến đến mục tiêu tiếp theo, đó là kịch bản sáng tác độc lập!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440662
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440662,
					"content": "Chúng tôi đã không ngừng thu thập tư liệu, củng cố hiểu biết của mình về \"vở kịch\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440663
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440663,
					"content": "Trong số chúng tôi có \"Biên Kịch Giả\" sẽ lắng nghe câu chuyện đến từ nhiều vị khách để bổ sung ý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440664
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440664,
					"content": "Cho dù không gặp được vị khách nào thích hợp, \"Biên Kịch Giả\" cũng sẽ hỏi thăm Eidolon Thủy về trải nghiệm của họ với khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440665
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440665,
					"content": "Ra là vậy, vậy thì chúng tôi kể chuyện cho \"Biên Kịch Giả\" cũng là đang giúp các bạn soạn thảo vở kịch mới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440666,
					"content": "Đúng vậy! Nếu các bạn có thời gian thì hãy trò chuyện với \"Biên Kịch Giả\" nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440667
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440667,
					"content": "Ngoài ra, các bạn hãy tiếp tục dạo chơi trong \"Ảo Cảnh Veluriyam\", thỏa sức khám phá và tương tác với Eidolon Thủy nhiều hơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440668
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440668,
					"content": "#Đừng lo, tôi và {NICKNAME} rất thích nơi này, nhất định sẽ cung cấp thêm tư liệu cho các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440669
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440669,
					"content": "Ừm... Tôi còn thắc mắc một chuyện nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440670,
					"content": "\"Ba ngày\" trong \"Ba Ngày Mơ Mộng\" rốt cuộc là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440671
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440671,
					"content": "Không lẽ mỗi lần Zosimos viết kịch bản tốn ba ngày sao? Hay là tổng cộng mất ba ngày?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440672,
						790440673
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440672,
					"content": "Cái này thì tôi biết!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440674,
					"content": "\"Hôm Qua\", \"Hôm Nay\" và \"Ngày Mai\"? Có vẻ rất hợp lý nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440675
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440675,
					"content": "Điều này chứng tỏ đạo diễn Zosimos... à không, là tất cả thành viên \"Daiya\" đều rất nỗ lực sáng tác mỗi ngày!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440676,
					"content": "Hay đó! Nhưng hơi đề cao chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440677
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440677,
					"content": "Ý nghĩa thực sự của \"ba ngày\" là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440678
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440678,
					"content": "\"Ngày mai vẫn còn sớm\", \"Ngày mai sẽ tốt hơn\" và \"Ngày mai chưa xong là tiêu\".",
					"roleType": "TALK_ROLE_NPC",
