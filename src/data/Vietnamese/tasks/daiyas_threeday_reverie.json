	"talks": [
		{
			"id": 7904401,
			"completionStepIds": [
				7904401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
