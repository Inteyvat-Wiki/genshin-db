			"trigger": {
				"objectNames": [
					"Zhaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Các người bắt nhầm người rồi... Nhìn đi này, sư phụ của tôi tên Kanei, tôi tên Zhaka... Các người phải bắt anh ta mới đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640402,
					"content": "Tôi căn bản là không làm ra được loại đồ chơi đẳng cấp như của sư phụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640403,
					"content": "Anh bị người ta bắt đến đây sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "Hả? Hai người không phải đồng bọn với họ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640405,
					"content": "Đương nhiên không phải rồi! Anh không thấy sao? Chúng tôi đã đánh cho họ chạy mất đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640406,
					"content": "Thì ra là thế sao? Tốt quá, cuối cùng tôi cũng được tự do rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640407,
					"content": "Đương nhiên, anh có thể về nhà rồi. Nhưng mà... rốt cuộc ở đây đã xảy ra chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640408,
					"content": "Đám người này không biết từ đâu tới làm giả đồ chơi của khu nghỉ dưỡng. Nhưng trình độ của họ rất kém, nên âm mưu bắt sư phụ của tôi là Kanei đi làm cố vấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640409,
					"content": "Nhưng không biết đã xảy ra chuyện gì mà lại bắt tôi ra đây... Trời ơi, tôi vừa mới học nghề này được ba ngày... Làm sao mà đạt yêu cầu cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640410,
					"content": "Dù sao thì cũng cảm ơn hai người rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640411,
					"content": "Azhka, chúng ta đi về nhà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640412,
					"content": "~~~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azhka"
				}
			]
		}
