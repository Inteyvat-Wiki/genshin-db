		{
			"id": 7403703,
			"completionStepIds": [
				7403703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403703",
							"2"
						],
						"stepId": 7403703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Đường ống ở đây cần phải thay... van nước... còn cả vấn đề vệ sinh... đúng là cả đống vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "Ối? Hai người tìm tôi có việc gì sao? Nhìn có vẻ... không giống người do Estelle phái đến sửa đài phun nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "Về chuyện của Remaudiere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "À là cậu ta à. Ha... ảo thuật của cậu ta quá lợi hại đã làm cho một cái van bên dưới đài phun nước bị hư mất, còn tiện thể làm hư luôn đầu phun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Hahaha, đùa thôi. Thực ra là van nước bị biến dạng làm tắc nghẽn hệ thống, vì an toàn, nên chúng tôi đành phải tạm tắt cái đài phun nước này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "Nhưng đầu phun sao lại hỏng thì quả thật tôi không rõ... kỳ lạ thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudiere nói nếu đài phun nước không sửa xong, thì cậu ta sẽ bị mắng... Nhưng trước đó tôi thật sự không có thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "Hôm nay mới rảnh chút, tìm Estelle đặt một cái van và đầu phun mới, đang chuẩn bị vào thành để mang tới đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "Nếu bạn đồng ý thì đi cùng tôi nhé, đồ đạc nhiều lắm, tôi đang lo một mình không cầm hết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
