			"dialogs": [
				{
					"id": 740370101,
					"content": "Ơ, sao Edel vẫn chưa sửa xong đài phun nước này vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370102
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370102,
					"content": "Nếu còn không sửa xong, Keratry chắc chắn sẽ khiến cho cả thế giới biết chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370103
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370103,
					"content": "Đài phun nước này hư rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370104
					]
				},
				{
					"id": 740370104,
					"content": "Haiz, rõ ràng dạo trước nó vẫn còn bình thường mà, nhưng rồi đột nhiên không phun nước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370105
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370105,
					"content": "Hơn nữa... nó hình như bị hư ngay đúng lúc tôi làm ảo thuật cho Keratry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370106
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370106,
					"content": "Lúc đó cha mẹ vừa hay đi xem biểu diễn ở Viện Ca Kịch, dặn tôi ở nhà trông chừng em gái đọc sách, chơi trò chơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370107
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370107,
					"content": "Nhưng Keratry cứ nằng nặc đòi ra ngoài chơi. Tôi không giữ được Keratry, chỉ có thể cùng em ấy ra ngoài dạo chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370108
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370108,
					"content": "Đợi đến khi chúng tôi đi đến chỗ đài phun nước này, Keratry đột nhiên nói muốn đứng đây đón cha mẹ sau khi họ xem xong biểu diễn, rồi cùng cha mẹ về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370109
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370109,
					"content": "Hình như cũng hợp lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370110
					]
				},
				{
					"id": 740370110,
					"content": "Đúng vậy, dù gì cũng đã đi đến đây rồi. Đợi cha mẹ ra không chừng còn có thể dẫn anh em đi ăn một bữa ngon lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370111,
					"content": "Lúc đó đã khuya rồi... nếu cha mẹ mà biết tôi lén dẫn em gái ra ngoài, còn la cà đến cái giờ này, thì chắc chắn sẽ mắng tôi một trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370112
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370112,
					"content": "Cho nên tôi đã lừa Keratry rằng, tôi biết một trò ảo thuật, có thể khiến cho đài phun nước ngừng lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370113
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370113,
					"content": "Thật ra tôi chỉ tính toán thời gian giữa hai lần phun nước, muốn làm Keratry vui rồi dỗ em ấy về nhà mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370114
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370114,
					"content": "Đài phun nước quả thật đã dừng lại theo thời gian tôi tính toán, Keratry cũng bị màn ảo thuật của tôi lừa, liền đòi tôi về nhà dạy em ấy cách làm ảo thuật này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370115
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370115,
					"content": "Nên tôi đã dẫn em ấy về nhà và chỉ vài câu đã dỗ em ấy đi ngủ. Sau đó tôi cũng quay về phòng, một lúc sau cha mẹ trở về, mọi thứ đều có vẻ rất bình thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370116
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370116,
					"content": "Nhưng ngày hôm sau, khi tôi ra đường giúp cha mua báo, thì phát hiện đài phun nước này vẫn không hoạt động... nó hư mất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370117,
						740370118
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370117,
					"content": "Ảo thuật của anh mạnh quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370119
					]
				},
				{
					"id": 740370119,
					"content": "Làm ơn, đừng trêu tôi nữa! Nếu như Keratry nói với cha mẹ chuyện này thì tôi coi như xong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370120
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370120,
					"content": "\"Ôi? Đài phun nước ở quảng trường sao lại bị hư mất rồi, chồng ơi, sao thế nhỉ?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370121
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370121,
					"content": "\"Thật kỳ lạ, tối hôm đó khi chúng ta đi xem biểu diễn, đài phun nước vẫn hoạt động bình thường mà.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370122
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370122,
					"content": "\"Con biết! Là anh trai đã dùng ảo thuật để đài phun nước dừng lại đấy! Phải không anh!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370123,
						740370124
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370123,
					"content": "Diễn hay lắm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370125,
					"content": "Sau đó việc tôi dẫn em gái đi la cà trong đêm sẽ bị lộ, cha mẹ chắc chắn sẽ mắng tôi một trận, hai tháng sau đó tôi cũng đừng mong được sống thoải mái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370126
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370126,
					"content": "Nhưng mà, đài phun nước này chắc sẽ có nhân viên quản lý chứ. Nếu nó hư rồi thì gọi người đến sửa không phải là được rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370127,
					"content": "Tôi đã từng nói chuyện với Edel, quản lý của đài phun nước này, anh ấy cũng hứa sẽ nhanh chóng sửa xong, nhưng... đến hôm nay vẫn chưa đến sửa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370128
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370128,
					"content": "Sắp không giấu được nữa rồi, tôi sắp tiêu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370129,
						740370130
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370129,
					"content": "Để tôi giúp anh hỏi thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370131,
					"content": "Thật vậy sao? Bạn đồng ý giúp tôi ư? Vậy thì tôi nguyện mang... toàn bộ tiền tiêu vặt của mình cho bạn hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370132
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370132,
					"content": "Edel ở bên đó, nhờ bạn hãy giúp tôi hỏi thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370130,
					"content": "Ôi, chuyện nhỏ thôi, để tôi giúp anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370124,
					"content": "Sống động lắm, tôi đã hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370118,
					"content": "Quả đúng là một vị ảo thuật gia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370133
					]
				},
				{
					"id": 740370133,
					"content": "Khi quan sát đài phun nước, hình như có ai đó đến bên cạnh ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
