			"dialogs": [
				{
					"id": 740370501,
					"content": "Xin chào, có thể giúp gì... Ấy, Edel à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370502,
					"content": "Tôi đến lấy van và đầu phun đây, nếu vẫn không sửa được cái đài phun nước, chắc cậu Remaudiere đó lại rối rít lên mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370503,
					"content": "Van... van à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370504,
					"content": "Sao... sao thế? Estelle... đừng nói là cô chưa làm đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370505,
					"content": "Không phải! Tôi làm xong rồi, chỉ là... trước đó có một vị khách cần sửa gấp một số thứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370506,
					"content": "Tôi đành... đành đưa cho cô ấy một số phần phụ kiện thường dùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370507,
					"content": "Đừng vội! Tôi đang làm cái mới rồi, một lát là xong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370508,
					"content": "Cô Estelle, tôi đã đặt trước lâu như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370509,
					"content": "Tôi biết mà! Nhưng vị khách đó thực sự rất gấp, nói là phải sửa van nước bẩn gì đó, tôi không nỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370510,
					"content": "Không sao, đợi... đợi mảnh sắt tôi mua được mang đến là có thể làm xong! Chắc là có ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370511,
					"content": "Đặt từ lúc nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370512,
					"content": "Sáng... Sáng hôm nay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370513,
					"content": "Chuyện mảnh sắt cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "Thật sao? Tốt quá! Vậy tôi trông cậy vào bạn nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370516,
					"content": "Xin lỗi, xin lỗi! Thật sự rất ngại, chỉ cần 3 mảnh sắt là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370517,
					"content": "Haiz, chỉ có thể nhờ bạn rồi, Nhà Lữ Hành. Yên tâm, tôi sẽ gửi bạn thù lao, không thể để bạn đi không công đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370514,
					"content": "Để tôi đi lấy mảnh sắt cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
