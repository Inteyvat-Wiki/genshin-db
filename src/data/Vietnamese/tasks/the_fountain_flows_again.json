				},
				{
					"id": 740370802,
					"content": "Hai người bắt đầu làm việc hết công suất...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "Van nước đã lắp xong rồi. Tôi cũng vừa kiểm tra toàn bộ một lượt rồi, không có vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370804,
					"content": "Được, vậy chúng ta đứng ra xa một chút, đợi chút tôi mở khóa nước là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370805,
					"content": "Để tôi xem... khóa tổng ở bên đó, khóa phụ cũng phải thao tác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370806,
					"content": "Mọi người đợi lát, tôi sẽ đi mở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370807,
					"content": "Rốt cuộc ai thiết kế hệ thống này vậy, tại sao khóa tổng lại đặt xa như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370808,
					"content": "Edel nhanh chóng chạy đi, một lúc sau mới quay trở lại...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Ai da, mở mấy cái này tốn sức thật, tôi mệt quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370810,
					"content": "Chúng ta đợi một lúc nhé, nước sẽ được dẫn đến ngay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370811,
					"content": "Qua một loạt tiếng động trầm thấp, đài phun nước hoạt động bình thường trở lại...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Thật tốt quá, đài phun nước cuối cùng cũng bình thường trở lại rồi... Cho dù Keratry nhắc đến chuyện tối hôm đó đi nữa, thì tôi cũng có thể giả vờ như không biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370813,
					"content": "Sau này đừng tùy tiện làm ảo thuật nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "Đó đâu phải vấn đề của ảo thuật... Tóm lại, cảm ơn bạn, đây là tấm lòng thành của tôi, hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370816,
					"content": "Thù lao đã hứa trước đó, cũng để ở trong đó rồi, cảm ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370817,
					"content": "Và cũng cảm ơn anh Edel và cô Estelle nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370818,
					"content": "Đây là việc thuộc chức trách của tôi, không cần cảm ơn đâu. Lần sau cậu cũng đừng dẫn em gái ra ngoài vào đêm khuya nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370819,
					"content": "Anh trai, sao anh lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370820,
					"content": "Keratry?! Sao em lại ở đây, không phải... em đang cùng cha mẹ đi dạo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370821,
					"content": "Hìhì... nhân lúc cha mẹ không để ý nên em chạy ra đây, muốn xem xem đài phun nước này thế nào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370822,
					"content": "Không phải trước đây anh dùng ảo thuật làm cho đài phun nước dừng lại rồi sao? Em còn tưởng hôm nay nó vẫn dừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370823,
					"content": "Haha... chuyện đó... haha... ảo thuật cũng có giới hạn, em biết chứ? Chỉ có tác dụng trong một thời điểm nhất định...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370824,
					"content": "Ồ... Vậy em muốn xem thêm lần nữa! Anh có thể biến cho đài phun nước dừng lại nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370825,
					"content": "Ờ... Khụ, Keratry, bây giờ xung quanh đang có rất nhiều người qua lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370826,
					"content": "Nếu anh làm đài phun này dừng lại thì mấy người muốn xem nó sẽ mất vui đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370827,
					"content": "Vậy... Đợi tối chút chúng ta ra ngoài đi! Đưa cả cha mẹ đi nữa, chắc chắn họ rất muốn xem anh biểu diễn ảo thuật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370828,
					"content": "Hả?! Không, chuyện đó... Em gái thân yêu, ảo thuật đài phun nước này anh vẫn chưa... nắm bắt hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370829,
					"content": "Anh tin rằng cha mẹ sẽ không muốn xem một màn ảo thuật vụng về nửa vời đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370830,
					"content": "Vì vậy, Keratry, em tuyệt đối đừng có nói cho cha mẹ về màn \"ảo thuật đài phun nước\" này của anh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370831,
					"content": "Anh chuẩn bị nghiên cứu xong xuôi màn ảo thuật này rồi, sẽ mang đến sự bất ngờ cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370832
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370832,
					"content": "Được thôi! Cha mẹ nhất định sẽ rất thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370833
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370833,
					"content": "Đúng vậy, cha mẹ nhất định sẽ rất thích. Giờ chúng ta về nhà thôi, anh... anh có thể cho em xem một màn ảo thuật mới...",
