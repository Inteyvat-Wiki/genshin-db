			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haypasia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000101,
					"content": "Nếu chúng ta đã đến Sumeru rồi thì mục tiêu tiếp theo của chúng ta là đến Thành Sumeru để gặp Tiểu Vương Kusanali nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000102,
					"content": "#Nói đến \"Tiểu Vương Kusanali\", tuy thông tin mà chúng ta nghe ngóng được không nhiều, nhưng hình như cô ấy không giống với vị thần đã dẫn {M#em gái}{F#anh trai} của bạn đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000103,
					"content": "Nhưng mà, Sumeru là một đất nước của trí tuệ, nếu như chúng ta gặp được vị thần trí tuệ đó thì nói không chừng sẽ thu thập được thông tin hữu ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000104,
					"content": "Tôi cũng thấy vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000105
					]
				},
				{
					"id": 30000105,
					"content": "Không biết Thành Sumeru ở hướng nào nhỉ, hay là chúng ta trèo lên mỏm đá phía Thất Thiên Thần Tượng đó xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000106,
					"content": "Dù không thấy được Thành Sumeru thì ít ra cũng tìm thấy làng mạc nào đó ở xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000107,
					"content": "Đợi đã, nhìn kìa, phía trước có người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000108,
					"content": "Tốt quá, đỡ phải đi tìm đường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000109,
					"content": "Xin chào, chúng tôi là nhà lữ hành từ bên ngoài đến, tôi muốn hỏi đường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000110,
					"content": "Không lẽ không nghe thấy sao... Này! Người ở phía trước kia, cho chúng tôi hỏi đường chút được không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000112
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30000112,
					"content": "Sao thế nhỉ? Cô ấy nghe thấy chúng ta gọi mà lại lơ đẹp luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000113,
						30000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000113,
					"content": "Đừng nóng, chắc là cô ấy đang bận thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				},
				{
					"id": 30000115,
					"content": "Hứ! Nhưng mà... nếu cô ấy lơ chúng ta, vậy thì chúng ta lén lén đi theo sau đi, nói không chừng sẽ tìm được nơi có người thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000116,
					"content": "Đến lúc đó chúng ta sẽ đi hỏi thăm người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000114,
					"content": "Hoặc là có nguyên nhân gì khác chăng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				}
			]
		},
		{
			"id": 300003,
			"completionStepIds": [
				300003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300003",
							"2"
						],
						"stepId": 300003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haypasia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000301,
					"content": "Ấy, cô ấy đi đến chỗ thác nước là mất tiêu rồi, chúng ta cũng qua đó xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000302,
					"content": "Còn nghĩ rằng hang núi này là nơi thông đến làng mạc gì đó chứ, xem ra chúng ta đã đoán sai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000303,
					"content": "Nhìn kìa, cô ấy ngồi xuống rồi, không lẽ cô ấy sống ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000304,
					"content": "Vậy giờ chúng ta phải làm sao đây, đi hỏi đường lại nữa hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000305,
						30000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000305,
					"content": "Thử nói chuyện với cô ấy lần nữa vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000306
					]
				},
				{
					"id": 30000306,
					"content": "Ừm, được rồi. Khó khăn lắm mới gặp được người đi đường. Đành phải thuyết phục cô ấy chỉ đường cho chúng ta vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000309,
					"content": "Ừm... mùi thơm quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000310,
					"content": "Hình như phát ra từ lư hương kia đúng không. Tuy là sống ở nơi đơn sơ như vậy, nhưng có thể đắm mình trong làn khói thơm này nghe chừng cũng không tệ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000311,
					"content": "!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000312
					]
				},
				{
					"id": 30000312,
					"content": "Sao rồi? Sao trông sắc mặt của bạn khó coi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000313,
						30000314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000313,
					"content": "Mùi thơm này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000315,
					"content": "Sao, mùi thơm này khiến bạn thấy không thoải mái sao? Sao tôi không cảm thấy gì hết vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000316,
					"content": "(Mình phải rời khỏi đây ngay!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000317
					]
				},
				{
					"id": 30000317,
					"content": "(Không ổn, ý thức của mình...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000318
					]
				},
				{
					"id": 30000318,
					"content": "#{NICKNAME}, bạn sao rồi? Tỉnh lại đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000314,
					"content": "Tôi thấy có chút kỳ lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000307,
					"content": "Hay là đừng làm phiền cô ấy nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000308
					]
				},
				{
					"id": 30000308,
					"content": "Ừm, trạng thái này của cô ấy gọi là \"thiền định\" đúng không. Nếu giờ chúng ta đi làm phiền nữa thì chắc không đơn giản chỉ là bị liếc như ban nãy nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 300010,
			"completionStepIds": [
				300010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300010",
							"2"
						],
						"stepId": 300010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30001001,
					"content": "...Thật sự vẫn ổn chứ? Đã qua một khoảng thời gian lâu như vậy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001002,
					"content": "Đừng gấp... kiến thức của thầy uyên bác lắm, nếu thầy nói không sao thì chắc chắn sẽ không sao mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001003
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001003,
					"content": "A, bạn tỉnh rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001004
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001004,
					"content": "#{NICKNAME}, tốt quá, bạn cuối cùng cũng tỉnh lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001005,
					"content": "Đây là nơi nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001006
					]
				},
				{
					"id": 30001006,
					"content": "Đây là... à đúng rồi, ban nãy bạn ngất xỉu đột ngột quá nên tôi cũng quên mất hỏi đây là đâu luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001007,
					"content": "Đây là \"Làng Gandharva\", ban đầu là nơi nghỉ ngơi tạm thời của các học giả Sumeru lập nên, giờ đây nơi này chủ yếu được nhân viên kiểm lâm đồn trú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001008
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001008,
					"content": "Xin chào, tôi là Collei, là kiểm lâm tập sự. Hôm nay tôi cùng thầy đi tuần tra thấy bạn ngất xỉu nên đã dẫn bạn về đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001009
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001009,
					"content": "Cảm ơn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001010
					]
				},
				{
					"id": 30001010,
					"content": "Không cần cảm ơn đâu, thực ra tôi cũng đâu có làm gì. À đúng rồi, bạn có cảm thấy không khỏe ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001011,
						30001012
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001011,
					"content": "Chưa thấy chỗ nào không khỏe cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				},
				{
					"id": 30001013,
					"content": "Haha... đó là thuốc của thầy bào chế đó, vừa rồi khi thấy bạn ngất, thầy đã cho bạn uống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001014
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001014,
					"content": "À đúng rồi, thầy có nói là nếu bạn tỉnh dậy thì phải cho bạn uống lần nữa. Để tôi đưa bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001015
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001015,
					"content": "Ối...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001016
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001016,
					"content": "Collei, sao thế? Muốn lấy thuốc sao? Đã nói là đừng đụng đến những thứ này mà... để đó thầy xử lý cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001017
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001017,
					"content": "Xin lỗi thầy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001018
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001018,
					"content": "Haiz, \"sơ đồ các loại nấm ăn được của Rừng Avidya\" ở trên bảng thông báo, nếu Farbod còn không nhớ được thì chỉ có thể đổi một nơi khác, đó là dán lên trán anh ta và để người khác nhắc nhở thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001019
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001019,
					"content": "Đúng vậy, tháng này anh ta đã ăn phải nấm độc hai lần rồi, tôi phải nói chuyện với anh ta thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001020
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30001020,
					"content": "Nhưng nếu anh ta chỉ thích những loại nấm sặc sỡ trước mặt thì những lời vừa nãy xem như tôi chưa nói. Nhưng nếu lần sau bốc thuốc cho anh ta thì tôi sẽ tính tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001021
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001021,
					"content": "#Thế nào rồi, {F#cô}{M#cậu} thấy ổn hơn chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001022
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001022,
					"content": "Vị này là thầy của tôi, Đội Trưởng Kiểm Lâm Tighnari, cũng là cấp trên của tất cả nhân viên kiểm lâm trong Làng Gandharva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001023
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001023,
					"content": "#Trước đó tôi đã giải thích với Paimon việc {F#cô}{M#cậu} bị mất ý thức rồi, nếu giờ {F#cô}{M#cậu} đã tỉnh lại thì để tôi nói lại lần nữa vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001024
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001024,
					"content": "Học giả của một số học phái Sumeru cần phải tu hành trong rừng, họ dùng một loại trầm hương tên là \"Linh Phân Hương\" để tịnh tâm trầm tư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001025
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001025,
					"content": "Hai người vì hỏi đường mà đã vô tình tiếp cận hang núi ẩn cư của học giả Haypasia, lúc đó trong hang cũng có đốt trầm hương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001026
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001026,
					"content": "#Trầm hương sẽ không gây ảnh hưởng đến đại đa số, nhưng sẽ kích thích tinh thần của một cơ số rất ít người, {F#cô}{M#cậu} chính là một trong số đó. Tôi giải thích như vậy đã rõ rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001027
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001027,
					"content": "Đã rõ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001028
					]
				},
				{
					"id": 30001028,
					"content": "#Ừm, vậy thì tốt. Vậy hãy trả lời câu hỏi sau: Sau khi ngất xỉu thì {F#cô}{M#cậu} có cảm giác gì khác không? Ví dụ như có ý thức được bản thân hay thấy được thứ gì khác không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001029
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001029,
					"content": "Thuật lại cảnh tượng đã thấy trong bóng tối...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30001030
					]
				},
				{
					"id": 30001030,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001031
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001031,
					"content": "Collei, em đi thông báo cho mọi người để họ khoan mang nhật ký tuần tra đến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001032
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001032,
					"content": "Hả, sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001033
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001033,
					"content": "Bởi vì hai người này sẽ tạm thời ở lại đây, thầy sẽ đi đến nhà Amir một lát. Làm theo lời thầy đi, nhanh lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001034
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001034,
					"content": "Dạ dạ, em hiểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001035
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001035,
					"content": "Khoan đã, có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001036,
					"content": "#Tình hình là vầy: Tôi vốn nghĩ {F#cô}{M#cậu} sau khi tỉnh thì uống thêm một lần thuốc là có thể đi được rồi, nhưng giờ đây tôi cảm thấy, {F#cô}{M#cậu} cần phải ở lại đây để theo dõi sức khỏe một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001037
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001037,
					"content": "\"Theo dõi sức khỏe\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001038
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001038,
					"content": "Nhưng tôi muốn đến Thành Sumeru...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001039
					]
				},
				{
					"id": 30001039,
					"content": "#Đừng vội, chỉ cần {F#cô}{M#cậu} là người hiểu rõ lý lẽ thì sẽ biết được tính nghiêm trọng của vấn đề sau khi nghe tôi nói thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001040
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001040,
					"content": "#Từ những miêu tả của {F#cô}{M#cậu} ban nãy thì loại trầm hương này gây cho {F#cô}{M#cậu} một loại \"ảo giác\" cực mạnh, khiến cho tình trạng tinh thần của {F#cô}{M#cậu} đang không mấy lạc quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001041
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001041,
					"content": "#Nếu {F#cô}{M#cậu} không tin được lời tôi nói thì có thể ngửi thử cái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001042
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001042,
					"content": "Hử!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001043
					]
				},
				{
					"id": 30001043,
					"content": "Woa, bạn không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001044
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001044,
					"content": "#Có giống với cảm giác lúc {F#cô}{M#cậu} gục ngã không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001045
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001045,
					"content": "#Tuy tinh thần của {F#cô}{M#cậu} hiện tại vẫn khá tỉnh táo, nhưng nếu một mực rời khỏi đây thì rất có thể sẽ bị đột ngột mất đi ý thức ở đâu đó nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001046
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001046,
					"content": "#Trong rừng mưa có rất nhiều mãnh thú, cũng là một khu vực nguy hiểm, lúc đó {F#cô}{M#cậu} sẽ không may mắn như bây giờ nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001047
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001047,
					"content": "#Những ngày này {F#cô}{M#cậu} cần phải ở lại đây để uống thuốc và hạn chế hành động một mình, cho đến khi {F#cô}{M#cậu} ngửi mùi này và không thấy bị gì nữa thì mới có thể đi, được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001048
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001048,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001049
					]
				},
				{
					"id": 30001049,
					"content": "#Cứ nghỉ ngơi đi nhé, tôi đi nấu thêm một chén thuốc cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001050
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001050,
					"content": "Haiz, sao lại thế được nhỉ... chúng ta vừa đến Sumeru là đã gặp phải chuyện này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001051
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001051,
					"content": "#{NICKNAME}, tôi biết bạn rất muốn gặp Tiểu Vương Kusanali, nhưng tình hình của bạn hiện giờ khá nghiêm trọng, nên chú ý sức khỏe vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001052
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001052,
					"content": "Này, có nghe thấy lời tôi nói không đấy? Tôi đang lo cho bạn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001053
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001053,
					"content": "Tôi cảm thấy có gì đó kỳ lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001054
					]
				},
				{
					"id": 30001054,
					"content": "Kỳ lạ sao? Ý là tình trạng hiện giờ của bạn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001055,
						30001056
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001055,
					"content": "Cơ thể đúng là không ổn cho lắm, nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001057,
					"content": "Bạn nói là bạn thấy những bộ rễ cây và bầu trời màu đỏ sao? Nếu đó không phải là ảo giác thì rốt cuộc là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001058
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001058,
					"content": "Tôi không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001059
					]
				},
				{
					"id": 30001059,
					"content": "(Lúc đó mình cảm nhận được mình đang đứng ở một nơi rất sâu. Bầu trời màu đỏ đó, không lẽ là Khaenri'ah sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001060
					]
				},
				{
					"id": 30001060,
					"content": "Ừm... thôi được rồi, do thể trạng của bạn đặc biệt nên tôi tin vào phán đoán của bạn. Nhưng sao ban nãy bạn không nói chuyện này cho Tighnari chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001061
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001061,
					"content": "Lỡ như anh ta khám sai bệnh thì tình trạng của bạn sẽ ngày càng tệ hơn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001062,
						30001063
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001062,
					"content": "Tôi cảm thấy anh ta đã khám đúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001064,
					"content": "Chậc, ý của bạn là... Tighnari biết thứ mà bạn gặp phải không phải là ảo giác nên đã cố ý giữ chân chúng ta lại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001065
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001065,
					"content": "Đúng vậy. Cho nên tôi muốn làm rõ chân tướng việc này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001066
					]
				},
				{
					"id": 30001066,
					"content": "Được rồi, tôi hiểu tại sao ban nãy bạn lại không nói gì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001067
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001067,
					"content": "Trong thời gian này chúng ta cứ tạm ở lại đây vậy, vừa để khôi phục sức khỏe, vừa để tìm hiểu xem thứ mà bạn gặp phải rốt cuộc là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001068
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001068,
					"content": "Nhưng mà, nếu hỏi trực tiếp Tighnari thì có vẻ không ổn cho lắm. Bạn có cách gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001069
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001069,
					"content": "Đi nói chuyện với Collei thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001070
					]
				},
				{
					"id": 30001070,
					"content": "Có lý, Collei có vẻ thân thiết với chúng ta hơn, ngày mai chúng ta đi hỏi thăm Collei về tình hình của Sumeru và Thảo Thần nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001071
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001071,
					"content": "Nghỉ một đêm trong căn phòng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30001063,
					"content": "Chỉ là không có nói sự thật thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001056,
					"content": "Những thứ đó có lẽ không phải là \"ảo giác\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
