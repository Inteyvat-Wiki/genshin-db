			"dialogs": [
				{
					"id": 762080101,
					"content": "Hửm? Xung quanh hình như có một tấm màn trong suốt đang được nâng lên... Là do cây đó làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080102,
					"content": "Cảm giác như nó đang tiết nhựa cây, biến nơi này thành một khối hổ phách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080103,
					"content": "Vậy thì chúng ta sẽ trở thành những con côn trùng bị kẹt trong hổ phách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080104
					]
				},
				{
					"id": 762080104,
					"content": "#Khối hổ phách chứa cả {NICKNAME} lẫn tôi, chắc hẳn sẽ trở thành món bảo vật đắt giá nhất trong buổi đấu giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080105,
					"content": "Thế còn bảo vật đặc sắc nhất được mang ra cuối cùng của buổi đấu giá thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080106
					]
				},
				{
					"id": 762080106,
					"content": "Đương nhiên là cái cây này rồi, dù sao cũng là nó tạo ra hổ phách mà, tiếc là trông có vẻ không mang đi được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080107
					],
					"speakerTitle": "Paimon"
				},
				{
