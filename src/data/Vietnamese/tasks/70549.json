				]
			},
			"dialogs": [
				{
					"id": 705490101,
					"content": "Ừm, quyết định rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490102
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490102,
					"content": "#Lúc đi dạo quanh đây, tôi đã cảm nhận được hơi thở quen thuộc, tới gần thì quả nhiên là {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490103,
						705490104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490103,
					"content": "Xin chào, Clorinde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				},
				{
					"id": 705490105,
					"content": "#Nếu để tiểu thư Charlotte thấy cảnh này, chắc chắn cô ấy sẽ chụp cho {F#cô}{M#cậu} hàng trăm tấm ảnh rồi viết ra bài báo thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490106,
					"content": "#\"Cuộc Sống Làm Thêm Của Kiếm Sĩ Huy Hoàng {NICKNAME}, Mỗi Ly Đồ Uống Đều Quý Giá Vô Vàn\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490107,
					"content": "#Rồi hôm sau, {F#cô}{M#cậu} sẽ lên trang nhất các tờ báo lớn, có thể còn có hàng loạt du khách Fontaine kéo đến thưởng thức, khiến nơi này đông nghẹt người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490108,
						705490109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490108,
					"content": "Tưởng tượng chút thôi, cảnh tượng đó hơi khoa trương nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490110,
					"content": "May mà lần này tôi đã từ chối yêu cầu đi cùng của tiểu thư Charlotte, nên tình huống trên sẽ không xảy ra đâu. Chúng ta hãy âm thầm ăn mừng khoảnh khắc nhàn rỗi này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490111
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490111,
					"content": "Quay lại chuyện chính, cho tôi một ly Trường Ca Caramel Rực Lửa nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490112,
					"content": "#...Nhìn biểu cảm của {F#cô}{M#cậu}, hình như có nhiều điều muốn hỏi tôi hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490113,
						705490114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490113,
					"content": "Để tôi pha đồ uống cho cô trước đã nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490115,
					"content": "#Từ tốn, tự tin, thì ra {F#cô}{M#cậu} cũng có kinh nghiệm trong việc này rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490114,
					"content": "Cô vừa uống, chúng ta vừa trò chuyện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490109,
					"content": "Nếu mà thế thật thì tôi không chống đỡ nổi đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490104,
					"content": "Mời quý khách ngồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				}
			]
		},
		{
			"id": 7054902,
