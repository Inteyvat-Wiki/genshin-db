			"dialogs": [
				{
					"id": 705490301,
					"content": "Ly mới này... gọi là \"Ánh Chớp Nhàn Nhã\" đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490302
					]
				},
				{
					"id": 705490302,
					"content": "Đồ uống đặc biệt dành riêng cho Đấu Sĩ Đại Diện, xin mời!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490303
					]
				},
				{
					"id": 705490303,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490304
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490304,
					"content": "Hừm? Dùng rượu nhẹ vị trái cây sao? Hương vị này rất tuyệt, rất vừa vặn với tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490305,
					"content": "Vị mặn nhẹ của muối cùng vị chua của trái cây khi nhấp môi, hòa quyện cùng vị ngọt của Caramel, mỗi loại đều đạt đến ngưỡng hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490306,
					"content": "Cái tên rất hợp với màu sắc của rượu, ý nghĩa của từ \"ánh chớp\" cũng khớp với yếu tố lửa của Trường Ca Caramel Rực Lửa nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490307
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490307,
					"content": "Nhưng mà, sao lại là \"nhàn nhã\" chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490308,
						705490309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490308,
					"content": "Cô không thấy Mondstadt rất nhàn nhã sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				},
				{
					"id": 705490310,
					"content": "Ra là thế... Đúng là rất hợp với cảm giác ly rượu này mang lại cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490311,
					"content": "Mùi thơm và hương vị độc đáo của nó sẽ chiếm vị trí quan trọng nhất trong ký ức của tôi về Mondstadt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490312,
						705490313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490312,
					"content": "Clorinde thích là được rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490314,
					"content": "#Nếu có cơ hội, {F#cô}{M#cậu} có hứng thú làm nhân viên pha chế tại quán cà phê hay Khách Sạn Debord không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490315
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490315,
					"content": "Ồ, sao lại hỏi vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490316
					]
				},
				{
					"id": 705490316,
					"content": "#Cá nhân tôi cũng muốn thưởng thức tác phẩm của {F#cô}{M#cậu}, nhưng tôi hỏi chủ yếu là vì Navia và tiểu thư Furina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490317,
						705490318
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490317,
					"content": "Dĩ nhiên là không thành vấn đề rồi, để mọi người cùng nếm thử xem sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490319
					]
				},
				{
					"id": 705490319,
					"content": "Tôi hiểu mà, tôi sẽ không ép buộc đâu... Tóm lại, cảm ơn đã tiếp đãi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490320
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490320,
					"content": "Giờ thì dù là đối mặt với đội trưởng Tiểu Đội Du Kích mạnh mẽ đó, hay trao đổi chiến thuật có hệ thống với các kỵ sĩ, tôi đều ở trạng thái tốt nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490321
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490321,
					"content": "Giờ thì dù là tổng kết trọng điểm trong trận so tài với tiểu thư Eula, hay trao đổi chiến thuật có hệ thống với các kỵ sĩ, tôi đều ở trạng thái tốt nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490318,
					"content": "Cũng không dám chắc, tới lúc đó thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490319
					]
				},
				{
					"id": 705490313,
					"content": "Cô hài lòng thì tôi cũng có động lực hơn mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490309,
					"content": "Du lịch thì phải nhàn nhã thư thái chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				}
			]
		}
	]
}