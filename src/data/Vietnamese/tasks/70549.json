						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490201,
					"content": "Trường Ca Caramel Rực Lửa mà cô gọi xong rồi đây, mời dùng thử...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490202
					]
				},
				{
					"id": 705490202,
					"content": "Đúng như cái tên, màu sắc rực rỡ như lửa... hương thơm cũng rất mạnh mẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490203
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490203,
					"content": "Khụ... Hình như hơi mạnh quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490204,
						705490205
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490204,
					"content": "Không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				},
				{
					"id": 705490206,
					"content": "Không sao, chỉ là cần chút thời gian để làm quen thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490207
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490207,
					"content": "Tôi nhớ lần cuối cùng uống rượu là năm ngoái, Navia mời tôi đến một buổi thưởng thức rượu. Tôi đã nếm thử một ngụm nhỏ rượu vang Sassica, độ mạnh còn kém xa ly này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490208,
						705490209
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490208,
					"content": "Vậy thì chẳng khác gì không uống rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490210,
					"content": "Nói một cách lý trí thì rượu dễ gây chóng mặt, sẽ ảnh hưởng đến công việc, đương nhiên là không động đến sẽ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490211
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490211,
					"content": "Nhưng khi đưa tôi đến cảng, tiểu thư Furina có nói rằng Mondstadt là vùng đất của rượu ngon và thơ ca. Đã đến rồi, tất nhiên phải thử đặc sản ở đây chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490212,
						705490213
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490212,
					"content": "Đúng nhỉ, không thử thì hơi phí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490214,
					"content": "Hơn nữa, theo tình báo mà tôi thu thập được, đội trưởng Tiểu Đội Du Kích sắp so tài với tôi... rất giỏi thưởng thức rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490215,
					"content": "Những báo cáo chiến đấu mà đội trưởng đó cho phép công khai, thực sự rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490216
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490216,
					"content": "Hơn nữa, đội trưởng Eula từng so tài với tôi trước đây... rất giỏi thưởng thức rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490217,
					"content": "Cô ấy còn tặng tôi một chai Chiết Xuất Quả Romaritime mà Fontaine đã ngừng sản xuất, chỉ còn tồn kho ở nước ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490218
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490218,
					"content": "Để tỏ lòng tôn trọng với cô ấy, tôi cũng phải tìm hiểu sâu hơn về rượu ngon của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490219,
						705490220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490219,
					"content": "Vậy để tôi nghĩ thêm rồi pha một ly khác cho cô nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490221,
					"content": "#Phiền {F#cô}{M#cậu} rồi, cảm ơn nhiều nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490222
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490222,
					"content": "Clorinde đã đi chơi trong Thành Mondstadt chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490223
					]
				},
				{
					"id": 705490223,
					"content": "Ừm, buổi sáng ngày đầu tiên đến Mondstadt tôi đã đi dạo một vòng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490224
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490224,
					"content": "Navia từng nghiên cứu rất kỹ... Không ít khung cảnh và hình minh họa trong Đoàn Kịch Trên Bàn đều tham khảo từ cảnh quan của Thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490225,
					"content": "Nhưng không khí của thị trấn trong kịch bản và tổng thể Mondstadt vẫn có sự khác biệt khá lớn. Ấn tượng sâu sắc nhất của tôi về Thành Mondstadt chính là hơi thở của kiếm và khiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490226,
						705490227
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490226,
					"content": "Kiếm và khiên?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490228,
					"content": "Chắc là vì tôi chủ yếu đi tham quan lò rèn và sân huấn luyện chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490229
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490229,
					"content": "Gần đây, vũ khí và giáp mới sản xuất ở Mondstadt áp dụng công nghệ xử lý nhiệt hoàn toàn khác với Fontaine, hàm lượng thẩm thấu carbon trên bề mặt cao hơn hẳn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490230
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490230,
					"content": "Tuy độ bền hơi kém, nhưng khả năng chống lực xung kích được cải thiện đáng kể, lại toả ra mùi... cà phê pha quá kỹ. Ừm, còn thêm ba muỗng muối đầy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490231,
						705490232
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490231,
					"content": "Thật sự chưa từng để ý bao giờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490233,
					"content": "Ấn tượng ban đầu của tôi về nó khá tốt. Vì hợp kim thủ công đặc biệt của Fontaine thường được bảo dưỡng bằng loại thuốc bảo vệ có thành phần Marcotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490234
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490234,
					"content": "Lâu dần, mùi hương nhàn nhạt ấy lại trở nên quá ngọt, đến mức khiến người ta cảm thấy... đau răng. Còn hơi thở của kiếm và khiên tại Mondstadt lại không gây phiền toái cho tôi như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490235,
						705490236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490235,
					"content": "Học được kiến thức trong lĩnh vực mới rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490237,
					"content": "Tất nhiên, vấn đề này cũng có cách giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490238
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490238,
					"content": "#Lần sau gặp lại ở Fontaine, tôi sẽ giới thiệu cho {F#cô}{M#cậu} loại thuốc bảo vệ khác. Kết cấu nhẹ nhàng như nước, không có mùi dư thừa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490239
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490239,
					"content": "#Nếu {F#cô}{M#cậu} cũng không quen với mùi ngọt dai dẳng, loại thuốc này chắc chắn sẽ khiến {F#cô}{M#cậu} hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490240
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490240,
					"content": "Bình thường Clorinde hay uống loại đồ uống gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490241
					]
				},
				{
					"id": 705490241,
					"content": "Bình thường à? Nếu là trong giờ làm việc, tôi thường uống cà phê. Còn khi ăn thì tôi thích nước ép Trái Bulle nhạt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490242
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490242,
					"content": "Vì tôi hay ăn các món thịt nên nước ép trái cây có vị chua sẽ đỡ ngán hơn. Lâu dần thì đã quen với vị chua của nước ép rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490243
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490243,
					"content": "Sau khi buổi giao lưu hôm nay kết thúc, các kỵ sĩ nhiệt tình đã mời tôi thưởng thức những món ăn đặc sắc của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490244
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490244,
					"content": "Tám món thịt mà tôi nếm thử đều khá ngon, khẩu phần ăn thật sự rất lớn. Chất lượng thịt cũng tốt, mà độ chín cũng tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490245
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490245,
					"content": "Tất nhiên vẫn còn chỗ có thể cải thiện. Ví dụ như Thịt Nướng Mật Ong và Pile 'Em Up... Đối với phiên bản dành cho khách du lịch từ nơi khác tới, nước sốt có thể cho dịu hơn một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490246,
						705490247
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490246,
					"content": "Nghe có vẻ đã ăn khá nhiều đấy nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490248,
					"content": "Nếu là món thịt đỏ thì đúng thế. Bữa ăn đó cung cấp đủ năng lượng cho ba ngày làm việc, nên những lời mời đi ăn sau đó tôi đều lịch sự từ chối hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490249
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490249,
					"content": "Việc cấp bách nhất là phải giải ngấy... Chắc sẽ có cách thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490250,
					"content": "Đây là món quà các kỵ sĩ đã tặng cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490251
					]
				},
				{
					"id": 705490251,
					"content": "Đúng vậy, các kỵ kĩ có biệt hiệu \"Hạt Phỉ 3\" và \"Hạt Phỉ 5\" đã tặng tôi huy hiệu này. Tôi thấy nó được thiết kế khá tinh xảo đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490252,
					"content": "#Họ nói, loại huy hiệu kỷ niệm này vừa mới được hoàn thiện, dành tặng riêng cho những vị khách quan trọng. Huy hiệu dành riêng cho {F#cô}{M#cậu} cũng đang được thiết kế rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490253,
						705490254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490253,
					"content": "Lần đầu tiên tôi nghe tới hai kỵ sĩ này đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490255,
					"content": "...Nói cũng có lý, tôi cũng không thể nhớ hết tên từng nhân viên ở Palais Mermonia được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490256,
					"content": "#Nhưng mà, chắc sau này {F#cô}{M#cậu} sẽ còn gặp lại họ thôi. Nhìn là biết họ là những lão làng dày dạn kinh nghiệm rồi, tuy làm văn phòng mà vẫn mặc nguyên cả bộ giáp đi làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490257
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490257,
					"content": "Sau khi sắp xếp xong việc của tôi, họ liền đến quán rượu tụ tập. Nói là để tiếp tục ván đấu đêm qua, phân chia tửu lượng cao thấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490258,
					"content": "Tối hôm trước vừa uống cả thùng bia, hôm sau lại có thể tỉnh táo đi làm bình thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490259,
						705490260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490259,
					"content": "Phong cách của Mondstadt thoải mái như vậy đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490261,
					"content": "Nói cách khác, thói quen uống rượu tưởng chừng tùy hứng nhưng thực ra lại nắm rõ \"chừng mực\" của người Mondstadt, thật đáng nể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490262
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490262,
					"content": "Kể ra thì, tiểu thư Emilie cũng tới rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490263
					]
				},
				{
					"id": 705490263,
					"content": "Ồ? Có vẻ cô ấy đã hoàn thành ủy thác rồi, hiệu suất cao thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490264
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490264,
					"content": "Sau khi về Fontaine, chắc tôi có thể bảo Sigewinne chuẩn bị mua nước hoa mới của cô ấy rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490265
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490265,
					"content": "Ồ, hình như cô khá hiểu cô ấy đấy chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490266
					]
				},
				{
					"id": 705490266,
					"content": "Có lẽ cũng chưa đến mức hiểu hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490267
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490267,
					"content": "Trên đường đến Mondstadt, tình cờ tôi và tiểu thư Emilie đi cùng chuyến tàu, nên có trò chuyện vài câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490268
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490268,
					"content": "Trước giờ tôi thường nghe Sigewinne khen ngợi những tuyệt tác của cô ấy. Nhưng sau cuộc trò chuyện đó, tôi mới phát hiện... cô ấy là một người vô cùng đặc biệt và tao nhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490269,
						705490270
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490269,
					"content": "Tao nhã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490271,
					"content": "Dịu dàng, điềm đạm, nhưng không quá thân thiết với người khác... Chắc là do nghề nghiệp nhỉ? Tôi thấy cảm giác đó rất lý tưởng, có thể khiến nội tâm luôn được yên bình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490272,
						705490273
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490272,
					"content": "Vẫn chưa hiểu lắm... Sau này tôi sắp xếp mời các cô cùng họp mặt nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490274,
					"content": "#Cảm ơn {F#cô}{M#cậu}, nhưng cũng không cần đặc biệt tạo cơ hội để chúng tôi làm quen đâu. Công việc của chúng tôi không có nhiều dịp giao lưu, mối quan hệ xung quanh cũng không có nhiều người quen chung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490275
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490275,
					"content": "Cứ để mọi thứ tự nhiên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490276
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490276,
					"content": "Emilie thích trà, còn Clorinde thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490277
					]
				},
				{
					"id": 705490277,
					"content": "#Lẽ nào {F#cô}{M#cậu} đã bắt đầu nghĩ đến việc tiếp đãi chúng tôi rồi đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490278
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490278,
					"content": "Sau những lần thử trước đó, tôi đoán là nồng độ mà tôi chấp nhận được chắc sẽ tương tự như Emilie. Cùng lắm là rượu vị trái cây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490279
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490279,
					"content": "#Tới lúc đó, {F#cô}{M#cậu} cứ chuẩn bị đồ uống tương tự cho chúng tôi là ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490280
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490280,
					"content": "Tôi có hướng cải tiến công thức rồi, chờ chút nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490281
					]
				},
				{
					"id": 705490281,
					"content": "Được thôi, tôi sẵn sàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490282
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490282,
					"content": "Dù ly này vẫn hơi mạnh, nhưng tôi cũng sẽ cố gắng uống hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490273,
					"content": "Khi nào về Fontaine, tôi mời mọi người cùng đến chơi nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490270,
					"content": "Hình dung này có hơi sâu xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490260,
					"content": "Người Mondstadt đã quen với việc nhâm nhi vài ly sau giờ làm để thư giãn rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490254,
					"content": "Đội Kỵ Sĩ đúng là một tổ chức đông người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490247,
					"content": "Cô đã thử hết các món thịt đặc sản của Mondstadt rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490236,
					"content": "Hóa ra nguyên liệu làm kiếm còn có nhiều chi tiết phức tạp như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490232,
					"content": "Cách ví von của Clorinde hay thật đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490227,
					"content": "Sao lại thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490220,
					"content": "Tôi sẽ chỉnh lại công thức để làm cô hài lòng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490213,
					"content": "Kiểm soát lượng dùng thì sẽ ổn thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490209,
					"content": "Nếu không quen uống rượu thì đừng cố quá nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490205,
					"content": "Uống chút nước nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				}
			]
		},
