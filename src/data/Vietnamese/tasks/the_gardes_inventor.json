			"dialogs": [
				{
					"id": 745110101,
					"content": "Xin chào hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110102,
					"content": "Hình như là... hiến binh? Tìm chúng tôi có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110103,
					"content": "Hihi, đoán xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110104,
					"content": "Chẳng lẽ là do chúng tôi bay trong thành phố sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "Hai vị thực sự đã làm chuyện này sao? Nói chậm lại chút nhé, tôi sẽ ghi chép lại ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110107,
					"content": "Hai người đang lừa chúng tôi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110108,
					"content": "Chúng tôi đùa thôi. Xin giới thiệu, tôi tên là Chenee, còn đây là tiền bối của tôi, Frejus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110109,
					"content": "Tiền bối dạo gần đây có một phát minh mới, muốn tìm người thử, không biết hai vị có hứng thú không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110110,
					"content": "Phát minh mới gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110111,
					"content": "Một bệ pháo có thể điều khiển từ xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110112,
					"content": "Như hai vị đã biết, bệ pháo trước giờ đều cần có người đứng bên cạnh để điều khiển đúng không? Vậy kẻ địch chỉ cần nhắm vào bệ pháo là sẽ có thể hủy diệt chúng ta nhanh chóng. Nhưng nếu chúng ta điều khiển từ xa được thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110113,
					"content": "Thì sẽ giảm bớt thương vong nhiều nhất có thể rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110114,
					"content": "Chính là như vậy đó! Không hổ danh là tiền bối Frejus, người đã từng \"ba lần từ chối lời mời của Viện Khoa Học Fontaine\" không ngờ lại có thể tạo ra một phát minh kỳ diệu như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110115,
					"content": "Ba lần từ chối lời mời của Viện Khoa Học Fontaine sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110117,
					"content": "Đúng vậy! Viện Khoa Học Fontaine từng rất ngưỡng mộ tài năng của tiền bối Frejus, đã ba lần trả rất nhiều tiền để mời anh ấy đến làm nghiên cứu viên cấp cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110118,
					"content": "Nhưng tiền bối vì yêu thích công việc của hiến binh nên cứ luôn ở lại đây, thật là cảm động!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110119,
					"content": "Mặc dù vậy, tiền bối vẫn không muốn tài năng của mình bị lãng phí, nên thỉnh thoảng sẽ tạo ra một số phát minh mới để giải quyết rắc rối cho chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110120,
					"content": "Nghe có vẻ rất lợi hại nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110121,
					"content": "Khụ, quá khen rồi. Chenee, cô còn nhớ lời tôi hướng dẫn không? Người càng thông minh thì càng phải hiểu giá trị của sự khiêm tốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110122,
					"content": "Vâng, thưa tiền bối Frejus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110123,
					"content": "Tóm lại, chúng tôi muốn nhờ hai vị kiểm nghiệm giùm tính khả thi của bệ pháo điều khiển từ xa này. Chúng tôi đã chuẩn bị sẵn địa điểm và mục tiêu rồi, còn về thù lao thì chúng tôi cũng sẽ không keo kiệt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110124,
					"content": "Hihi, vậy là tìm đúng người rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110125,
					"content": "#Tôi và {NICKNAME} đã thấy qua rất nhiều phát minh mới mẻ kỳ lạ rồi, để chúng tôi thử nghiệm thiết bị này cho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110126,
					"content": "Cố lên nhé hai vị. Cố lên nhé tiền bối Frejus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110127,
					"content": "Tóm lại... Mời đi lối này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110105,
					"content": "Chẳng lẽ là do chúng tôi dùng vũ khí trong thành phố sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}