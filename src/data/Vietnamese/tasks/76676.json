			"dialogs": [
				{
					"id": 766760101,
					"content": "Vỗ tay, vỗ tay! Sự kiện này tiến hành đến giờ có thể nói là đã đạt đến cảnh giới hoàn hảo rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760102
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760102,
					"content": "Rất nhiều người bạn Sumeru đã học được vũ đạo mang phong cách Natlan, tôi nhìn thấy tiềm năng vũ đạo của chúng tôi lan khắp Teyvat rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760103
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760103,
					"content": "Thật mong sau này giao lưu nghệ thuật nhảy múa của chúng ta sẽ thành hoạt động thường xuyên, chúng ta sẽ thường xuyên đến thăm nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760104
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760104,
					"content": "Vậy thì Saurian ở Natlan cũng có thể vung đao múa kiếm như Eremite sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760105,
						766760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760105,
					"content": "Còn cả vũ điệu chiến đấu trong truyền thuyết nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				},
				{
					"id": 766760107,
					"content": "Hả? Chẳng lẽ là... động tác thị uy mà Chú Loan Đao dùng để dọa Kền Kền Đỏ Thánh Hóa lúc nhóm của Nusta mới gặp Chú Loan Đao sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760108
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760108,
					"content": "Chú đó không nói với mọi người về nguồn gốc các động tác đó à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760109
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760109,
					"content": "Có mà, điệu nhảy đó hình như tên là... \"Bản Song Ca Của Sư Tử Lửa Và Bảo Vệ Vạc Trời\" phải không nhỉ? Đúng là một cái tên vừa thanh lịch vừa mạnh mẽ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760110
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760110,
					"content": "Hai cái tên nghe quen quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760111,
						766760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760111,
					"content": "Làm tôi nhớ tới hai người bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760113,
					"content": "#Chắc {NICKNAME} và Paimon đã đoán ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760114
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760114,
					"content": "Nơi gặp phải Kền Kền Đỏ Thánh Hóa vừa hay ở gần con đường mà đội xe Thú Thồ Hàng của Thú Săn Mồi Rực Lửa hay đi qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760115
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760115,
					"content": "Mấy ngày trước, đội xe chở chị Dehya và chị Candace về Làng Aaru đã gặp phải đám Kền Kền Đỏ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760116
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760116,
					"content": "Kết quả là hai vị đại tỷ cảm thấy trước đó ra ngoài không vận động gân cốt hẳn hoi, nên đã dồn hết sức vào chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760117
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760117,
					"content": "Từ đó về sau, chỉ cần các thành viên của Thú Săn Mồi Rực Lửa bắt chước động tác ra đòn của hai người họ là đám Kền Kền Đỏ sẽ biết điều mà bỏ chạy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760118
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760118,
					"content": "Quả nhiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760119,
					"content": "Phải nói là đám Kền Kền Đỏ Thánh Hóa đó cũng xui nhỉ? Lại bị Dehya và Candace bắt tay cho ăn đòn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760120,
						766760121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760120,
					"content": "Là bọn chúng tự chuốc khổ vào thân thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760122,
					"content": "Đỉnh thật! Thế mà lần trước lại bỏ lỡ cơ hội giao lưu với hai cao thủ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760123
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760123,
					"content": "Lần sau đến Sumeru thì phải giới thiệu tôi với họ đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760124
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760124,
					"content": "Tôi rất muốn học hỏi họ về quyền pháp, nhất là tiết tấu từ chân đến đùi, từ đùi đến thắt lưng, rồi dồn sức vào cánh tay và đấm ra đòn nhanh và mạnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760125
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760125,
					"content": "Ha, đến lúc đó, mọi người chắc cũng sẽ uống cho thật đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760126
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760126,
					"content": "Tôi phải chuẩn bị canh giải rượu trước cho mọi người thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760121,
					"content": "Dehya và Candace làm tốt lắm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760112,
					"content": "Có vẻ đã đoán được đầu đuôi rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760106,
					"content": "Thứ có thể dọa Kền Kền Đỏ bỏ chạy đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				}
			]
		}
	]
