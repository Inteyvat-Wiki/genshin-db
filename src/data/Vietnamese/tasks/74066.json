			},
			"dialogs": [
				{
					"id": 740660301,
					"content": "Quầy lễ tân... Chúng ta đi thử vận may xem nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660302,
					"content": "Chào tiểu thư Monglane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660304,
					"content": "(Ối! Cảm thấy khá khó gần đấy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660305,
					"content": "(Hay là thử dùng \"Nghệ Thuật Giao Thiệp\" xem?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(Đúng nhỉ! Không ngờ quyển sách đó còn có thể phát huy công dụng vào lúc này.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660307,
					"content": "Để xem nào... Tìm được rồi! \"Nếu như lớn tiếng thì có thể áp đảo đối thủ về mặt khí thế...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660308,
					"content": "Áp đảo đối thủ về mặt khí thế! Tôi hiểu rồi! Nói tóm lại là phải lớn giọng một chút chứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660309,
					"content": "Ê, chào tiểu thư Monglane...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660310,
					"content": "...Tôi nghe rồi, các vị cần gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660311,
					"content": "Hả? Dùng được thật này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660312,
					"content": "Hihi, tiểu thư Monglane, chúng tôi đến tham gia nghiên cứu độ hài lòng! À, tôi đi cùng với người này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660313,
					"content": "#(Đừng lo, tôi sẽ lén đọc sách để nhắc nhở {NICKNAME}! Tóm lại... Ừm! Tóm lại thì cứ nghe theo tôi là được.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660314,
					"content": "Lại thêm một người tới vì đọc thông báo trong sách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660315,
					"content": "Ừm! Đúng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660316,
					"content": "Rốt cuộc có bao nhiêu tờ giấy đây...? Thật ra... Ôi, bỏ đi, không có gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660317,
					"content": "Khụ, đợi một lúc nhé... Tôi giải thích quy tắc trước. Tổng cộng có năm câu hỏi, cứ trả lời nhanh nhất có thể. Chú ý là phải trả lời thật nhanh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660318,
					"content": "Hiểu rồi chứ? Chuẩn bị xong thì chúng ta bắt đầu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monglane"
				}
			]
		},
