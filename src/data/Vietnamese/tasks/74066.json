			"dialogs": [
				{
					"id": 740660201,
					"content": "\"Nghệ Thuật Giao Thiệp\"...? Hừm, tên sách nhìn thôi đã thấy chán rồi! Không có hứng... Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "Ơ? Trong này có kẹp một tờ giấy? Ừm... \"Đến trước quầy lễ tân tham gia nghiên cứu độ hài lòng của Nhà Ăn Đặc Cách, có cơ hội nhận được phần thưởng là Phiếu Đặc Cách...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "Phiếu Đặc Cách... Chà! Có Phiếu Đặc Cách để lãnh kìa! Không ngờ còn có vụ này, chúng ta nhanh lên nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
