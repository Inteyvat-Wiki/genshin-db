			"dialogs": [
				{
					"id": 740660901,
					"content": "(Tôi chuẩn bị xong rồi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660902,
					"content": "Câu thứ nhất, giá thức ăn trong Nhà Ăn Đặc Cách hiện tại có hợp lý hay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660903,
					"content": "(Ừm... Phải trả lời thế nào nhỉ? Để xem... Tìm được rồi! Hãy thử công thức vạn năng này đi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660904,
					"content": "(Trên sách nói \"Tôi đồng ý với quan điểm này, nhưng...\" tình huống nào cũng dùng được. Dù là Pháp Sư Vực Sâu cũng có thể trao đổi như thường. Nghe có vẻ ghê gớm đấy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660905,
					"content": "Hợp lý, Paimon thích lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "Hả...? Thứ khó nuốt như thế, có cho tôi cũng chẳng thèm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660907,
					"content": "Nhưng lỡ như không có tiền mua nguyên liệu thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "Hừm... Nói thế cũng đúng... Không, không đúng! Tôi thà nhịn đói còn hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660918,
					"content": "Khụ, xin cắt ngang một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660919,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660920,
					"content": "Dựa theo quy định, hạng mục này cần đáp thật nhanh. Chúng ta qua câu hỏi tiếp theo nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660921,
					"content": "Được rồi... Nếu quy định là thế thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660922,
					"content": "Câu hỏi thứ hai. Trong thời gian ăn cơm, Nhà Ăn Đặc Cách có cung cấp đủ thức ăn hay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660923,
					"content": "Đủ thì có đủ... Nhưng thật sự rất khó ăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660924,
					"content": "Đúng đó, còn đầy đủ hơn cả Bạc Hà Teyvat nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "Tôi thà ăn Bạc Hà còn hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660926,
					"content": "Thật à? Vậy hôm nay ăn Salad Bạc Hà nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "Đừng mà! Hai thứ tôi đều không muốn ăn! Hic, tôi muốn ăn Gà Nấu Hoa Ngọt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660928,
					"content": "Tóm lại... Tôi điền câu trả lời là \"có\" nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660935,
					"content": "Mệt thật. Chúng ta bắt đầu câu hỏi tiếp theo nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660936,
					"content": "Trước khi hỏi câu thứ ba, tôi xin nhắc lại một lần nữa. Hạng mục này cần trả lời thật nhanh, vậy nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660937,
					"content": "Câu hỏi thứ ba. Hệ thống suất ăn ngẫu nhiên có thú vị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660938,
					"content": "Làm ơn chú ý tới hương vị hơn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660939,
					"content": "Tôi đồng ý với quan điểm này, nhưng... Nếu là suất ăn ngẫu nhiên thì sẽ bất ngờ hơn khi không biết món tiếp theo là gì, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660940,
					"content": "Đúng nhỉ... Nghe cô nói xong thì tôi lại cảm thấy nó rất thú vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660941,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "Sao thế? Tiểu thư Monglane nói có lý thật mà, cảm thấy khó mà phản bác được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660943,
					"content": "Khụ, xin các vị hãy trả lời thật nhanh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660944,
					"content": "Thú vị, cả Quẻ May Mắn cũng rất thú vị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "Đúng vậy! Cứ như rút thăm ấy, không tệ chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660946,
					"content": "\"Cố gắng làm việc thì sẽ giành được thành công!\" Thú vị lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660947,
					"content": "Việc tuyên truyền đúng là vất vả mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "Hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660957,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660958,
					"content": "Câu hỏi thứ tư. Nếu Nhà Ăn Đặc Cách bán các suất ăn theo sở thích thì có hợp lý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660959,
					"content": "(Hả? Sao tự nhiên lại nói nhanh thế?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660960,
					"content": "(\"Áp đảo tinh thần\"? \"Dẫn dắt chủ đề\"? Hình như không đúng. Hay là... dùng công thức vạn năng vậy...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660961,
					"content": "(Không đúng lắm... Những vấn đề này...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "Khụ, đừng suy nghĩ quá nhiều, cũng đừng nói chuyện phiếm. Như tôi đã nói lúc trước, cứ dựa vào trực giác để trả lời thật nhanh là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660964,
					"content": "Rất hợp lý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "Được rồi, cảm ơn đã trả lời. Sau đây là câu hỏi cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660968,
					"content": "Bị ngó lơ à? Câu trả lời của chúng tôi vốn không quan trọng sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660969,
					"content": "Dựa theo những câu trả lời trên, các vị có hài lòng với hiện trạng của Nhà Ăn Đặc Cách không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660970,
					"content": "Khi nãy cô hỏi cái gì ấy nhỉ? Hình như tôi quên hết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660971,
					"content": "Không sao, cứ xem như hài lòng hết là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660972,
					"content": "Cũng được... Nhưng sao tôi cứ thấy sai sai ở chỗ nào ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660973,
					"content": "Cũng xin nhắc nhở, nếu trả lời là \"không\" thì sẽ không có Phiếu Đặc Cách đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660974,
					"content": "Quá đáng lắm luôn á!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660975,
					"content": "#Vậy {F#cô}{M#cậu} thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660976,
					"content": "Đừng có lơ tôi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660977,
					"content": "Tôi rất hài lòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "Được rồi. Cảm ơn đã phối hợp, sự ủng hộ của các vị chính là động lực để chúng tôi tiến bộ hơn. Xin ký tên ở đây và nhận Phiếu Đặc Cách. Robot dây cót thông minh biết bay cũng có thể ký tên nhận quà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660983,
					"content": "Hả? Tôi cũng có phần à?! tôi còn không tham gia mà? Mà khoan, tôi là Paimon, không phải robot dây cót biết bay nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660984,
					"content": "Được rồi. Chúng tôi tôn trọng tất cả đề nghị, cho nên mọi người... và cả robot cũng đều có phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660985,
					"content": "Đã nói tôi không phải robot dây cót biết bay mà, là Paimon đó! Đừng có lơ tôi như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660986,
					"content": "Hiểu rồi... Tóm lại, vì để các vị tiết kiệm thời gian, tôi đã điền câu trả lời thay rồi. Đừng lo, số lượng Phiếu Đặc Cách được phát đều như nhau, không có khác biệt gì hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660987,
					"content": "Tôi đoán tất cả đáp án đều là \"hài lòng\" hết, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660988,
					"content": "Ừm! Vì Phiếu Đặc Cách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660989,
					"content": "Nếu vậy thì ký tên vào đây là được, phần còn lại cứ giao cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660990,
					"content": "Được thôi! Vừa được nhận Phiếu Đặc Cách vừa đỡ phiền phức. Làm phiền cô nhé Monglane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660991,
					"content": "Cảm ơn đã ủng hộ, xin hãy nhận Phiếu Đặc Cách. Hẹn gặp lại vào lần nghiên cứu sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660992,
					"content": "Sau khi nhận Phiếu Đặc Cách, bạn và Paimon chào tạm biệt Monglane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "Nghĩ lại thì hình như Monglane không thèm quan tâm đến câu trả lời của chúng ta luôn nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660994,
					"content": "Chắc là do vấn đề về đặt câu hỏi chăng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "Ừm. Câu khảo sát rất kỳ lạ. Với tôi cũng cảm thấy tiểu thư Monglane có vẻ mệt mỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660996,
					"content": "\"Nghệ Thuật Giao Thiệp\" thất bại rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "\"Nghệ Thuật Giao Thiệp\" cái gì chứ! Loại sách này đúng là vô dụng mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660998,
					"content": "Đúng vậy, là quyển sách đó có vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "Đúng không? Nhưng nể mặt Phiếu Đặc Cách, lần này xem như bỏ qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661000,
					"content": "Là Paimon có vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "Hả? Tôi chỉ làm theo trong sách chỉ thôi mà. Nhìn đi, \"chúng ta phải lớn tiếng...\" gì gì đó. Quả nhiên là do sách có vấn đề!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661002,
					"content": "Tôi đồng ý với quan điểm này, nhưng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "Này! Đừng có mà lừa tôi! Gì mà \"Nghệ Thuật Giao Thiệp\" chứ! Chẳng có tác dụng gì hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660978,
					"content": "Hoàn toàn không hài lòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "Không, xem như là hài lòng đi, vì Phiếu Đặc Cách thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660980,
					"content": "Hài lòng đúng không? Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660981,
					"content": "Tuy rất hài lòng, nhưng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "Không hợp lý, bởi vì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "Tôi đồng ý với quan điểm này, nhưng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(Đây là đang... dẫn dắt chủ đề sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "Không thú vị, vì không ăn được món mà tôi muốn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "...Lần nào cũng toàn mấy món kỳ lạ! Làm gì có cảm giác bất ngờ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660951,
					"content": "Tôi đồng ý với quan điểm này, nhưng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "Nếu mỗi người ăn đủ mười tám lần sẽ được tặng một món ngon thì tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660953,
					"content": "Tại sao lại là mười tám lần?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "Tôi nghe người khác nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660955,
					"content": "Hình như là... À, bởi vì mỗi ngày là ba suất cơm, đến chủ nhật thì vừa đúng sáu ngày. Sáu ngày là mười tám suất cơm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660956,
					"content": "Đợi đến ngày kế tiếp thì sẽ được ăn món ngon! Mỗi tuần đều vui vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660929,
					"content": "Không đủ, Wolsey còn không có để ăn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "Rõ ràng là anh ta không muốn ăn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660931,
					"content": "Hiểu rồi, tóm lại là không đủ đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660932,
					"content": "Tôi đồng ý với quan điểm này, nhưng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "Dù sao chúng tôi cũng không ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660934,
					"content": "Haiz... Tôi biết là các vị đã đọc qua quyển sách kia... Tóm lại thì tôi điền là \"có\" nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660909,
					"content": "Không hợp lý, tôi muốn tăng giá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660910
					]
				},
				{
					"id": 740660910,
					"content": "Hả?! Tại sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660911,
					"content": "Không cần tốt nhất, tôi cần đắt nhất!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "Suy nghĩ kỳ lạ gì thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660913,
					"content": "Có ổn không đấy...? Trông không bình thường chút nào cả, có ăn nhầm thứ gì bậy bạ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660914,
					"content": "Tôi đồng ý với quan điểm này, nhưng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660915
					]
				},
				{
					"id": 740660915,
					"content": "Nhưng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660916
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660916,
					"content": "#Nhưng vẫn có thể làm tốt hơn thế nữa! Nếu như ngon hơn chút nữa thì tốt rồi, {NICKNAME} thấy có đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660917,
					"content": "Hoặc là... Nếu như có Gà Nấu Hoa Ngọt thì tốt rồi. Như thế thì tôi sẽ đến đây ăn mỗi ngày luôn!",
					"roleType": "TALK_ROLE_NPC",
