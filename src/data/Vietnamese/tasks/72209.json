			"dialogs": [
				{
					"id": 722090301,
					"content": "Meo meo meo, giá đỡ bằng gỗ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090302,
					"content": "Đã sửa xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "Quả thật không tệ, đền thần đã đẹp đẽ hơn rồi, meo meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090304,
					"content": "Ngươi hãy đi nói với hai tên loài người màu xanh đó rằng giá đỡ đã sửa xong, họ có thể treo bảng gỗ nhỏ rồi. Sau đó thì những người khác cũng có thể đến đền thần và bỏ tiền vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090305,
					"content": "Tại sao ngươi không tự đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "Loài người màu xanh và cao cao đó rất đáng sợ, hắn hiểu rõ về suy nghĩ của mèo... có thể dễ dàng nhìn thấu ta, meo meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090307,
					"content": "Hơn nữa mỗi lần ta nói chuyện với hắn, hắn đều rất kích động... meo meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
