						722090603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090603,
					"content": "Meo meo meo... ngoại trừ chiếc hòm đó và \"quét dọn\"... thì giá đỡ này quả thật cũng rất quan trọng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090604,
					"content": "Không tệ, không tệ, meo meo meo, cứ như vậy thì đền thần nhất định sẽ trở nên náo nhiệt trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090605,
					"content": "Tại sao ngươi phải tu sửa đền thần?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "Tại sao ư... Vì ta là Guuji Đại Diện của ngôi đền thần này, nhất định phải chăm sóc tốt đền thần, để nhiều người đến tham quan đền thần, khiến đền thần trở nên náo nhiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090607,
					"content": "Với lại, nếu khi Hibiki quay về nhìn thấy đền thần cũ nát, cô ấy chắc chắn sẽ đau lòng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090608,
					"content": "Meo meo, nhưng bây giờ có ngươi giúp đỡ, đền thần nhất định sẽ sớm ngày khôi phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090609,
					"content": "Khoảng thời gian tới, không chừng ta còn phải nhờ mọi người giúp đỡ, mong mọi người đừng khước từ, meo meo.",
