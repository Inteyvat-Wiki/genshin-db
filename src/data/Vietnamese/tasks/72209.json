					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090502,
					"content": "Cám ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "Nhưng bên trên thẻ cầu nguyện này... đã hoàn toàn không nhìn rõ được nữa, rốt cuộc đã trải qua bao lâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090505,
					"content": "Tiểu thư Etsuko! Mau xem, tôi tìm được vài bảng gỗ ở bên cạnh, đã gọt thành vài... thẻ cầu nguyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090506,
					"content": "Giá thẻ cầu nguyện đã sửa xong rồi, đương nhiên phải treo thẻ cầu nguyện lên đó rồi, hi hi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090507,
					"content": "Tiểu thư Etsuko có tâm nguyện gì? Để tôi giúp cô vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090508,
					"content": "Treo thẻ cầu nguyện trong đền thần này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090509,
					"content": "Ha ha cảm thấy thật kỳ diệu... hãy đưa thẻ cầu nguyện cho tôi, để tôi vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090510,
					"content": "Bọn họ dường như đang chuẩn bị treo thẻ cầu nguyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090511,
					"content": "Chúng ta quay về báo cáo với Neko thôi, nó nhất định sẽ rất vui mừng.",
