			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Hôm nay lại là một ngày yên lành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090102,
					"content": "Meo méo, ngươi đến rồi à, hôm qua sau khi dọn nhà xong, ta ngủ rất thoải mái đó...mèo méo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090103,
					"content": "Hai tên xanh xanh đó hôm qua cũng đi dạo trong đền thần đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090104,
					"content": "Nhưng ngoài hai người đó ra thì không còn người nào đến nữa...kỳ lạ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090105,
					"content": "Nhưng lúc hai tên xanh xanh đó đi dạo, có vẻ rất thích thú với chiếc giá gỗ bên đó, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090106,
					"content": "Ta nhớ Hibiki có nói...mấy mảnh gỗ đó là \"thẻ cầu nguyện\", còn chiếc giá thì gọi là \"giá thẻ cầu nguyện\", rất nhiều người đến ngôi đền này là vì nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090107,
					"content": "Ừm...con người thích gỗ lắm à? Ai đến đền thần cũng bỏ tiền vào hòm rồi đến giá gỗ đó treo những tấm thẻ gỗ lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090108,
					"content": "Chắc không phải là thích gỗ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "Như vậy sao? Vậy là do loài người thích giá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090110,
					"content": "Tại sao lại là giá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "Dù thế nào đi nữa, giá đỡ bằng gỗ đã bị hỏng rồi, mảnh gỗ cũng còn rất là ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090113,
					"content": "Tuy rằng không biết loài người có quan hệ gì với giá và gỗ, nói chung là đền thần cần có thứ này mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090114,
					"content": "Cho nên nhất định là do giá đỡ có vấn đề, nên mới không ai đến đền thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090115,
					"content": "Cho nên ta muốn nhờ ngươi đến sửa lại giá đỡ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090116,
					"content": "Cứ giao cho chúng tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Nguyên liệu dùng để sửa \"Hòm Công Đức\" lần trước, chắc còn dư đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090118,
					"content": "Việc này ta không rõ... sao loài người các người lại yêu thích gỗ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090119,
					"content": "Ừm... thôi vậy... hình như những nguyên liệu đó vẫn còn sót lại, chúng ta đi xung quanh tìm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090120,
					"content": "Vậy việc sửa giá đỡ thì nhờ vả mọi người nhé, ta sẽ tiếp tục ở lại đây quét dọn đền thần, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090129,
					"content": "Sau khi sửa lại hòm công đức và giá đỡ, chắc là sẽ có càng nhiều người đến đền thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090121,
					"content": "Giá thẻ cầu nguyện này đã bao lâu chưa được tu sửa rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Đã hỏng từ rất lâu rồi, nó hỏng trước hơn cả hòm. Hòm đã hỏng từ rất lâu rất lâu về trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090123,
					"content": "Thật không biết hỏng từ khi nào sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090124,
					"content": "Dù sao thì ta cũng không đặc biệt đi đếm mặt trời đã mọc lên và lặn xuống bao nhiêu lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090125,
					"content": "Nguyên liệu dùng để sửa \"Hòm Công Đức\" lần trước, chắc còn dư đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
