				{
					"id": 722090201,
					"content": "Xem ra giá thẻ cầu nguyện này đã hỏng lâu lắm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "Bạn đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "À Nhà Lữ Hành. Ta và tiểu thư Etsuko đang điều tra xung quanh đền thần này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Tuy các thiết bị trong đền thần này đã cũ nát đến mức không nhìn ra hình dáng gì rồi... Nhưng những thiết bị này thật đầy đủ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "Người trong thôn gần đây đều đến tham quan chứ. Xem ra việc ngôi đền bỏ hoang hoặc có thể là liên quan đến Làng Koseki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
