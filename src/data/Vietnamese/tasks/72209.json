					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090503,
					"content": "Chỉ là chút việc nhỏ ấy mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
