				},
				{
					"id": 722090128,
					"content": "Vậy việc sửa giá đỡ thì nhờ vả mọi người nhé, ta sẽ tiếp tục ở lại đây quét dọn đền thần, meo meo.",
					"roleType": "TALK_ROLE_NPC",
