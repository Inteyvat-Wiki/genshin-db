			"dialogs": [
				{
					"id": 741531201,
					"content": "Về tờ biên lai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741531202
					]
				},
				{
					"id": 741531202,
					"content": "Dạo gần đây có bán kìm, cưa và nến nữa sao? Haiz, đúng là câu hỏi kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531203
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531203,
					"content": "Nếu cháu muốn mua gia vị làm đồ ngọt thì ta có rất nhiều, nhưng mấy thứ này thì hơi khó, ta không có nhiều hàng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531204
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531204,
					"content": "Chúng cháu không muốn mua những thứ đó, chúng cháu chỉ muốn hỏi xem dạo gần đây có ai hỏi mua những thứ này không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741531205,
					"content": "Để nhớ xem... À, đúng là có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531206
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531206,
					"content": "Mấy ngày trước có hai người trẻ tuổi đến đây, một nam một nữ, đến chỗ bà mua mấy thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531207
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531207,
					"content": "Họ nói trong nhà làm nghề mộc nên thiếu công cụ, sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531208
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531208,
					"content": "Không có gì. Chúng cháu... chỉ đang nghiên cứu tình hình kinh tế xã hội thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741531209,
					"content": "Nghiên cứu tình hình kinh tế xã hội? Haha, các cháu đến đây dò la tin tức đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531210
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531210,
					"content": "Chuyện này ta thấy nhiều rồi, hai đứa không cần mượn cớ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531211
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531211,
					"content": "Nếu các cháu muốn biết chuyện này thì... hai người họ về nhà cũ của Benoit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531212
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531212,
					"content": "Về Benoit Leroy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741531213
					]
				},
				{
					"id": 741531213,
					"content": "Hóa ra các cháu đến đây vì Benoit, ta không ngạc nhiên cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531214
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531214,
					"content": "Đến một độ tuổi nhất định thì quá khứ sẽ tìm đến nhà. Dù có dọn tới đâu đi nữa thì cũng thế thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531215
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531215,
					"content": "Bà có thông tin gì không ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741531216,
					"content": "Ta? Ta không thân với Benoit lắm, nếu muốn tìm hiểu chuyện của nhà Benoit thì nên đi tìm Snodgrass để hỏi chuyện nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741531217
					],
					"speakerTitle": "Bracari"
				},
				{
					"id": 741531217,
					"content": "Đi đi, Snodgrass ngày nào cũng lêu lổng, chắc bây giờ đang ở quanh đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bracari"
				}
			]
		}
