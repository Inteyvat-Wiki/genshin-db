			"dialogs": [
				{
					"id": 741530701,
					"content": "Haiz, chán quá... Không muốn đi làm tí nào... Biết bao giờ mình mới phất lên nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530702
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530702,
					"content": "Về Benoit Leroy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530703
					]
				},
				{
					"id": 741530703,
					"content": "Leroy? Hình như tôi từng nghe qua cái tên này ở đâu rồi thì phải, để tôi nhớ lại xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530704
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530704,
					"content": "À, tôi nhớ ra rồi. Benoit Leroy, chủ tiệm tạp hóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530705
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530705,
					"content": "Sao vậy? Mà các người là ai? Hỏi thăm mấy chuyện này làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530706
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530706,
					"content": "Thật ra chúng tôi chỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530707,
						741530708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530707,
					"content": "Tình trạng của ông ấy khá phức tạp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				},
				{
					"id": 741530709,
					"content": "Ơ, cái đó... chẳng lẽ... có phải ông ta đã phạm tội gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530710
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530711
					]
				},
				{
					"id": 741530711,
					"content": "À ừm, hiểu rồi... Nhưng tôi vẫn muốn hỏi thêm một câu, các vị là người của Spina di Rosula hay Sảnh Chấp Pháp vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530712
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530712,
					"content": "Anh có quyền giữ im lặng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530713
					]
				},
				{
					"id": 741530713,
					"content": "Nhưng mỗi câu anh nói đều sẽ là bằng chứng chống lại anh trước tòa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530714
					]
				},
				{
					"id": 741530714,
					"content": "#({NICKNAME} biết diễn thật, quả không hổ danh.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530715,
					"content": "Được rồi, tôi không hỏi nữa. Cách ông ta giàu lên cũng chẳng vẻ vang gì. Fontaine lại có nhiều điều luật như thế, chắc là ông ta đã phạm phải một trong số đó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530716
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530716,
					"content": "Mà các vị tìm đúng người rồi đó. Để tôi nói cho các vị biết, tôi hiểu rõ nhà đó lắm, cái tên Benoit tồi tệ này đã làm không ít chuyện xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530717
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530717,
					"content": "À, tôi đã trưởng thành như thế thì chắc ông ta cũng già rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530718
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530718,
					"content": "Tôi nhớ là Autumn, con gái của ông ta rất xinh. Haha, tiếc là ông ta chưa bao giờ cho chúng tôi nói chuyện với Autumn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530719
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530719,
					"content": "Autumn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530720
					]
				},
				{
					"id": 741530720,
					"content": "Đúng vậy. Autumn Leroy, con nuôi của Benoit Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530721
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530721,
					"content": "Nghĩ thử xem, ông ta vốn chỉ là một người bán tạp hóa, kiếm được mấy đồng mà thôi, tại sao lại đột nhiên giàu có vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530722
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530722,
					"content": "Đều dựa vào Autumn cả thôi! Cô ấy xinh đẹp trẻ trung như thế lại bị ông ta bắt gả cho một lão già lắm tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530723
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530723,
					"content": "Lão già đó sống được vài năm là đi đời rồi, gia sản của lão đó hiển nhiên về tay Autumn. Mà Autumn là con của ông Leroy, thành ra ông ta mới có thể dọn lên trên kia đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530724
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530724,
					"content": "Chậc, sao ông ta lại có thể giàu có sau một đêm vậy chứ? À không, ý tôi là sao lại lợi dụng con gái mình thế chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530725
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530725,
					"content": "(Sao lại có chuyện như vậy nhỉ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530726,
					"content": "(Chúng ta hỏi tiếp xem.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530727
					]
				},
				{
					"id": 741530727,
					"content": "Hai vị đến là để tìm hiểu những chuyện này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530728
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530728,
					"content": "Ý tôi là, nếu mấy chuyện này có ích, vậy thì tôi cũng đã tham gia vào quá trình bảo vệ an ninh cho Fontaine rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530729
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530729,
					"content": "Là một công dân có đóng góp cho xã hội, liệu Sảnh Chấp Pháp có định tuyên dương tôi không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530730,
						741530732
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530730,
					"content": "Chuyện này tôi không rõ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530731
					]
				},
				{
					"id": 741530731,
					"content": "Đừng vội, tôi còn thông tin khác có thể cung cấp mà. Dù sao thì ở Fleuve Cendre này, nếu không có một hai bí mật gì đó của người khác thì sẽ ngủ không ngon đâu, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530734,
					"content": "Người chồng thứ hai của Autumn, đúng, cô ấy tái giá rất nhanh. Lần này cô ấy gả đi khá xa, chúng tôi chưa từng gặp lại cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530735
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530735,
					"content": "Khi chúng tôi nghe được tin tức của Autumn... thì cô ấy đã dính líu vào chuyện đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530736
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530736,
					"content": "Là chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530737,
					"content": "Hai vị không biết sao? Autumn đã giết chết người chồng thứ hai của mình, nên bị đưa vào Pháo Đài Meropide. Hai vị điều tra Benoit mà lại không biết chuyện này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530738,
						741530739
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530738,
					"content": "Đây là hồ sơ những người có liên quan đấy, hiến binh Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530740,
					"content": "#Ơ... Xin lỗi đội trưởng {NICKNAME}, lần sau tôi sẽ không như thế nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530741,
						741530742
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530741,
					"content": "Nói tiếp đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530743,
					"content": "À đúng, tôi đang định nói đây. Tôi cũng chỉ nghe từ người khác thôi. Nghe nói khi xét xử Autumn, cô ấy đã mời Benoit ra tòa, nhưng ông ta từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530744
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530744,
					"content": "Benoit không kết hôn, chỉ có một người con gái là Autumn. À đúng rồi, tôi nhớ cô ấy là con nuôi, nhưng dù sao cũng có mối quan hệ với Benoit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530745
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530745,
					"content": "Người cha duy nhất này lại không ra tòa làm chứng, nên việc Autumn bị đày đến Pháo Đài Meropide cũng là chuyện đương nhiên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530746
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530746,
					"content": "Tên xấu xa đó muốn độc chiếm nhà cửa của con gái mình, hay vì khúc mắc nào đó mà không ra tòa... Chuyện này tôi sẽ không đoán bừa đâu, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530747
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530747,
					"content": "Ngày thường ông ấy khá thân thiện mà nhỉ? Tôi nhớ ông ấy còn cho tôi đồ ngọt nữa... Ai mà biết đằng sau ông ấy lại tàn nhẫn như thế chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530748
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530748,
					"content": "Hai vị bình tĩnh thật, nghe đến đây mà vẫn không nhíu mày... Hai vị không cảm thấy ông ta máu lạnh sao? Tôi thì cảm thấy ông ta máu lạnh quá, hai vị giỏi hơn tôi rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530749
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530749,
					"content": "Chúng tôi công tư phân minh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530750
					]
				},
				{
					"id": 741530750,
					"content": "Quá chuyên nghiệp, thật kính nể. Vì vậy, tội của ông Benoit có nặng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530751
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530751,
					"content": "Không thể nói trước được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530752
					]
				},
				{
					"id": 741530752,
					"content": "Ồ, nghiêm trọng đến vậy ư? Vậy nhà của ông ta có bị tịch thu không?",
					"roleType": "TALK_ROLE_NPC",
