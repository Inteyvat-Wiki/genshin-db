			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741530301,
					"content": "(Chiếc rương từng thấy qua ở gần nhà ông Benoit, trông vết tích thì hình như mới bị mở ra gần đây.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530302
					],
					"speakerTitle": "Rương Kỳ Lạ"
				},
				{
					"id": 741530302,
					"content": "(Sau khi đến gần, bạn còn ngửi thấy mùi tanh của cá và nước, thế nhưng những ngày gần đây đi ngang thì lại không thấy chiếc rương bị ai động vào. Vậy mùi này đến từ đâu?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530303
					],
					"speakerTitle": "Rương Kỳ Lạ"
				},
				{
					"id": 741530303,
					"content": "Mùi này hôi như nước cống vậy... Ọe... Rõ ràng mấy hôm trước đến đây không hề có mùi này mà. Chẳng phải ông Benoit nói trong đây chỉ có đồ gia dụng cũ thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530304,
					"content": "Sao lại có mùi khó ngửi thế nhỉ? Có gì đó mới bỏ vào bên trong sao? ...Ơ, có mảnh giấy này, để xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530305,
					"content": "Tờ biên lai này rách mất rồi, chỉ còn một nửa. Ồ, Tiệm Tạp Hóa Bracari... Hình như chúng ta từng nhìn thấy cái tên này ở đâu rồi, cảm giác rất quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
