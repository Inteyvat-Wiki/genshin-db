			},
			"dialogs": [
				{
					"id": 741530101,
					"content": "Xin chào, có ai không? Không nhận báo nữa sao? Trả lời nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530102
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530102,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530103
					]
				},
				{
					"id": 741530103,
					"content": "Ông Benoit không có ở nhà sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530104
					]
				},
				{
					"id": 741530104,
					"content": "Sao tôi biết chứ? Kỳ lạ thật, báo mình đặt mà cũng không ra ngoài lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530105
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530105,
					"content": "Trước đây khi tôi đưa báo đến cửa, ít nhất thì ông Leroy cũng sẽ ừ một tiếng. Nhưng dạo gần đây thì không còn thấy ông ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530106
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530106,
					"content": "Ở chỗ tôi còn giữ mấy tờ báo Chim Hơi Nước của ông ấy đây, hai vị quen ông ấy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530107
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530107,
					"content": "Đúng vậy, chúng tôi là bạn thân của ông Benoit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530108,
					"content": "Bạn thân sao? ...Hay là tôi đưa báo của ông ấy cho hai vị nhé, khi nào nhìn thấy ông ấy thì đưa giúp tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530109,
						741530110
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530109,
					"content": "Được, cứ đưa cho chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				},
				{
					"id": 741530111,
					"content": "Tôi cũng đã làm hết sức mình rồi. Đừng trách tôi chưa đưa báo đến nhé, tôi vẫn còn việc khác cần làm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530112
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530112,
					"content": "Nhưng dạo này chúng tôi cũng không nhìn thấy ông ấy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530113,
					"content": "Hai vị cũng không tìm thấy ông ấy sao? Rốt cuộc ông Leroy đang bận gì nhỉ? Chẳng lẽ lại quay về nhà cũ để ở ư? Tôi có nghe ai nói thế đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530114
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530114,
					"content": "Nhà cũ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530115
					]
				},
				{
					"id": 741530115,
					"content": "Ừm, nhà cũ của ông ấy ở Fleuve Cendre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530116
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530116,
					"content": "Trước đây ông Benoit ở Fleuve Cendre sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530117,
					"content": "Ông ấy dọn từ Fleuve Cendre đến đây mà hai vị cũng không biết sao? Có thật là bạn thân không đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530118
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530118,
					"content": "À ừm... Chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530119,
					"content": "Được rồi, không cần giải thích nữa. Tôi không quan tâm giữa hai vị với ông ấy có vấn đề gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530120
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530120,
					"content": "Chỉ cần hai vị đưa báo cho ông ấy là được rồi. Thôi, nhận lấy nhé, tôi đi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530121
					],
					"speakerTitle": "Pip"
				},
				{
					"id": 741530121,
					"content": "Tôi cảm thấy ông Benoit vẫn còn rất nhiều chuyện mà chúng ta không biết. Liệu có liên quan đến việc chúng ta đang điều tra không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530122,
						741530123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530122,
					"content": "Chắc là có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530124,
					"content": "Được, vậy tiếp theo chúng ta điều tra xung quanh nhà ông Benoit đi. Biết đâu lại tìm thêm được thông tin gì đó thì sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530125,
					"content": "Có điều chúng ta phải bí mật một chút, đề phòng cặp vợ chồng kia cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530123,
					"content": "Thông tin càng nhiều sẽ càng tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530110,
					"content": "Paimon nhận lấy đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				}
			]
		},
