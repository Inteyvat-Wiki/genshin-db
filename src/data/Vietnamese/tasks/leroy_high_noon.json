						741530754
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530753,
					"content": "Có lẽ là có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530755,
					"content": "Tôi biết ngay mà! Chuột vẫn chỉ là chuột thôi, có bò lên trên kia thì vẫn là chuột.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530756
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530756,
					"content": "Cảm ơn hai vị đã cho tôi một ngày tốt lành. Mong là lần sau vẫn sẽ gặp được hai vị ở Fleuve Cendre, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530757
					],
					"speakerTitle": "Snodgrass"
				},
				{
					"id": 741530757,
					"content": "Nói thế nào nhỉ... bây giờ tâm trạng của tôi phức tạp thật. Vốn dĩ ấn tượng của tôi đối với ông Benoit đang khá tốt mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530758,
						741530760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530758,
					"content": "Không thể nhìn mặt mà bắt hình dong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530759
					]
				},
				{
					"id": 741530759,
					"content": "Haiz, chắc là do tôi không đủ khả năng để nhìn thấu mặt tối của ông ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530763,
					"content": "Những chuyện phức tạp này đủ cho chúng ta suy ngẫm trong một khoảng thời gian rồi. Tôi thấy trong lòng ngột ngạt quá, chúng ta rời khỏi Fleuve Cendre thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530764,
					"content": "Đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530765
					]
				},
				{
					"id": 741530765,
					"content": "Ừm, đi tắm nắng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530760,
					"content": "Đừng tin thông tin từ một phía của người qua đường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530761
					]
				},
				{
					"id": 741530761,
					"content": "Nói đúng lắm, nhưng bây giờ tôi cũng không hoàn toàn tin ông Benoit nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530762
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530762,
					"content": "#Tôi ghét cảm giác này, may mà tôi vẫn có thể tin tưởng {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741530754,
					"content": "Chắc là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530742,
					"content": "Thông tin quan trọng trong đó là gì?",
