			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#Ồ? Là {NICKNAME} và Paimon. Không ngờ lại gặp được hai vị ở một nơi hẻo lánh như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030102,
					"content": "Hai vị đang lần theo manh mối nào đó hay là vô tình bị lạc đến đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030103,
					"content": "Chúng tôi đang tham quan xung quanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "Ra là vậy. Từ boong của con tàu bỏ hoang này nhìn ra, hình bóng đồ sộ của Cục Thiết Kế Thí Nghiệm Kuuvahki quả thực có một vẻ... hùng vĩ khác thường. Như một con thú khổng lồ đang ẩn mình vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030106,
					"content": "Đúng vậy, chỉ cần nhìn từ xa thế này thôi cũng đã rất áp lực rồi. Không biết bên trong rốt cuộc cất giấu bao nhiêu bí mật nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030107,
					"content": "Ừm, đối với hai vị đang tìm kiếm tư liệu độc đáo mà nói, nó có thể cung cấp không ít cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030108,
					"content": "Dù sao thì ranh giới giữa ánh sáng và bóng tối thường là nơi sản sinh ra những câu chuyện hấp dẫn nhất mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030109,
					"content": "Hihi, cứ nhìn Flins đứng đó với ngọn đèn xanh huyền bí kè kè bên cạnh là biết ngay có nhiều tâm sự rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030110,
					"content": "Nói mới nhớ, hôm nay anh không cần phải canh gác ở... chỗ đó sao? Đang nghỉ phép à? Hay là đang đi tuần tra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030111,
					"content": "Coi như là cả hai đi. Canh chừng những tai ương có thể sản sinh từ trong bóng tối chính là trách nhiệm của Ratnik chúng tôi. Dù ở bất cứ đâu cũng đều phải cảnh giác, không thể lơ là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030112,
					"content": "Tuy nhiên, cho đến hiện tại thì không khí ở nơi này vẫn khá yên bình. Hai vị không cần quá căng thẳng, cứ yên tâm sáng tác đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030113,
					"content": "Cơ hội hiếm có...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "Chụp ảnh cho tôi sao? Điều này nằm ngoài dự liệu của tôi. Thú thật, tôi không quen đứng trước ống kính và trở thành đối tượng bị soi xét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030116,
					"content": "Chắc hai vị cũng hiểu được. Tôi đã quen làm bạn với những nấm mồ câm lặng, với những lời thì thầm của người đã khuất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030117,
					"content": "Tuy nhiên, nếu nỡ lòng từ chối thì vừa phụ đi nhã ý của người ta, lại vừa không làm tròn đạo lý tiếp khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030118,
					"content": "Nên là cứ tự nhiên ghi lại khoảnh khắc đó nhé. Tôi rất sẵn lòng tô điểm thêm vào tác phẩm nghệ thuật của hai vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030114,
					"content": "Tôi có thể chụp ảnh cho anh không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "Nhân tiện tìm kiếm tư liệu chụp ảnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
