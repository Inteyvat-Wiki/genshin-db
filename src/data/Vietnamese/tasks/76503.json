			"dialogs": [
				{
					"id": 765030801,
					"content": "Nhìn dáng vẻ của hai vị chắc vẫn đang tìm kiếm tư liệu chụp ảnh phù hợp nhỉ? Thời gian vẫn còn dư dả, những tác phẩm thực sự xuất sắc thường sẽ ra đời từ nguồn cảm hứng bất chợt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030803,
