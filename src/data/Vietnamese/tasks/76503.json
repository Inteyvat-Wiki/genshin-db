					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030803,
					"content": "Không vấn đề gì, chúng ta bắt đầu chụp ảnh thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030804
					]
				},
				{
					"id": 765030804,
					"content": "#Xem ra {F#cô}{M#cậu} đã có thu hoạch rồi. Tuy nhiên, tôi không thấy bóng dáng chiếc máy ảnh đâu cả. Có phải đã để quên ở đâu đó rồi không?",
