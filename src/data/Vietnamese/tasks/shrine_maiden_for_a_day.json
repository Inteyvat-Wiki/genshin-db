			"dialogs": [
				{
					"id": 191451601,
					"content": "Hy vọng Lôi Thần đại nhân có thể phù hộ bà lão và cháu gái bà ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451602,
					"content": "Về mắt của bà ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "Bạn cũng để ý rồi à? Đúng vậy, bà lão không thể nhìn rõ mọi thứ, chúng tôi hơi lo lắng mỗi khi thấy bà lên núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "Nhưng bà ấy luôn không muốn nhờ vả chúng tôi, nói bản thân đã đi nhiều năm như vậy rồi, một mình cũng có thể lên núi xuống núi được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "May mắn thay, trên đường núi cũng có pháp sư của đền thần, ít nhiều cũng có thể nhờ họ chăm sóc cho bà ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "Lôi Thần bảo hộ, chúc bà lão và cháu bà ấy có thể thuận buồm xuôi gió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
