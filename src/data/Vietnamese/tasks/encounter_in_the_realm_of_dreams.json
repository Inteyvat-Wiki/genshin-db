			"dialogs": [
				{
					"id": 120440301,
					"content": "Sao lại có một cô gái ở đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440302,
					"content": "Trông cô ấy không ổn lắm... Chúng ta mau qua đó xem đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440801
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440801,
					"content": "Lúc nãy là sao vậy? Rõ ràng chỉ nhìn nhau một cái thôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440802,
					"content": "Đợi đã, ở đây đông người như vậy từ khi nào vậy? Họ đến đây làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440803,
					"content": "Những người này hình như đang xếp hàng thì phải?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "Đúng nhỉ... Cô gái đó vẫn còn ở đây! Hmm... Tôi cảm thấy có thể cô ấy sẽ biết chuyện gì đang xảy ra đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440805,
					"content": "Nếu bây giờ xuất phát, thời gian còn lại của mình liệu có đủ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 120440806,
					"content": "Mình phải giải thích bao nhiêu lần nữa đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 120440807,
					"content": "Tố cáo thì chắc sẽ mất việc, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 120440808,
					"content": "Hmm... Nỗi lo sinh ra do thiếu cảm hứng... Cảm hứng thường sẽ không xuất hiện khi não bộ quá lo lắng. Hy vọng lần điều trị này có thể giúp cô thư giãn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440809,
					"content": "...Cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 120440810,
					"content": "Nỗi hối hận về những tội ác trong quá khứ, và nỗi buồn vì những rắc rối của hiện trạng... Tôi có thể giúp anh vui vẻ đối mặt với tất cả, nhưng hãy cố gắng một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440811,
					"content": "...Cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "Nishiguchi"
				},
				{
					"id": 120440812,
					"content": "Người tiếp theo... Khụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440813,
					"content": "Cô ấy bị sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440814,
					"content": "Cô không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "Tôi vẫn ổn, người tiếp theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440816,
					"content": "Đó là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440817,
					"content": "Mmm! Ngon quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440818,
					"content": "Woa, thật bất ngờ đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440819,
					"content": "Hửm? Sao mà... Khụ! Thật xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440820,
					"content": "Xin lỗi à? Nói thật thì hai chúng tôi đều không rõ vừa nãy đã xảy ra chuyện gì. Cô có thể giải thích một chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440821,
					"content": "Hai vị chắc là đi nhầm vào giấc mơ của tôi rồi. Cho phép tôi làm hai vị tỉnh dậy trước rồi mới giải thích nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440822,
					"content": "Giấc mơ à? Từ khi nào mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440901,
					"content": "Woa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440902,
					"content": "#Này, có phải có cảm giác \"như vừa tỉnh mộng\" không? Thật không ngờ {NICKNAME} lại xuất hiện trong giấc mơ của tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440903,
					"content": "Cô biết chúng tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "#Có người thường xuyên nhắc đến {F#cô}{M#cậu} cho tôi nghe mà... Tôi khá giỏi trong việc đoán người thông qua lời đồn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440905,
					"content": "Vậy cô là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440906,
					"content": "Kể ra thì đây là lần đầu tiên chúng ta gặp nhau nhỉ, vậy thì để tôi giới thiệu chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440907,
					"content": "Tôi là Yumemizuki Mizuki, cứ gọi tôi Mizuki là được. Tôi là yumekui-baku, một trong những youkai ở Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440908,
					"content": "Yumekui-baku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440909,
					"content": "Chíu chíp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "Baku Nhỏ"
				},
				{
					"id": 120440910,
					"content": "Này, là sinh vật nhỏ ban nãy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440911,
					"content": "Đây chính là dáng vẻ vốn có của tộc chúng tôi. Hai vị vừa rồi chắc là bị nó thu hút nên mới đi nhầm vào giấc mơ của tôi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440912,
					"content": "Yumekui-baku có khả năng nuốt ác mộng của con người, nhưng chúng tôi cần phải ở trong giấc mơ của riêng mình để tiêu hóa chúng. Cảnh tượng hai vị vừa nhìn thấy chính là cảnh tôi tiêu hóa ác mộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440913,
					"content": "Tôi đã ăn quá nhiều cơn ác mộng cùng một lúc, chúng tụ lại với nhau khiến tôi có chút khó tiêu... May mà nó đã dẫn hai vị vào đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440914,
					"content": "Chuyện này cũng xem như may mắn. Cảm ơn đã giúp tôi nhé, giờ tôi có thể tiêu hóa những cơn ác mộng này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440915,
					"content": "Chúng tôi thấy cô hơi khó chịu nên mới tới gần thôi. Tuy không biết cụ thể đã xảy ra chuyện gì, nhưng giúp được cô là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440916,
					"content": "Tôi ghét nhất là ác mộng đó. Gặp youkai ăn được ác mộng thì đúng là phải giúp một tay rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440917,
					"content": "Nhưng mà, rất xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440918,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "#Khi {F#cô}{M#cậu} tiến lại gần trong giấc mơ của tôi... Thứ tôi tách ra khỏi {F#cô}{M#cậu} không phải là ác mộng, mà là một giấc mơ đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440920,
					"content": "Trước đó do ăn nhiều ác mộng quá nên không để ý mà ăn mất tiêu luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440921,
					"content": "Thì ra yumekui-baku cũng có thể ăn được giấc mơ đẹp à... Nhưng đây là chuyện quá đáng lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440922,
					"content": "Đương nhiên rồi. Giấc mơ đẹp đối với con người là rất quý giá, sao tôi có thể coi nó như ác mộng mà ăn chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440923,
					"content": "Tộc yumekui-baku chúng tôi có luật bất thành văn là không được ăn giấc mơ của người khác khi chưa được cho phép. Tôi thật sự quá bất cẩn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440924,
					"content": "Đừng tự trách mình như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "#Lẽ nào {F#cô}{M#cậu} không cảm thấy rất buồn, hay là đột nhiên nhớ lại rất nhiều chuyện đau lòng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440927,
					"content": "Không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "Sau khi một phần giấc mơ của mình bị nuốt chửng mà vẫn duy trì trạng thái tâm lý ổn định như vậy... Đúng là hiếm gặp đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440929,
					"content": "#Hmm... Chắc là do {NICKNAME} có quá nhiều giấc mơ đẹp, nên bị ăn mất một chút cũng không sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440930,
					"content": "Nhưng tôi vẫn nên bồi thường mới phải... Thế này đi, xin hãy nhận lấy thứ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440931,
					"content": "Vé VIP của Phòng Tắm Hơi Aisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440932,
					"content": "Tiệm của chúng tôi có rất nhiều nhà trị liệu tâm lý, còn có cả dịch vụ suối nước nóng và ẩm thực nữa. Chúng tôi sẽ lấy đi phiền não và trao cho quý khách niềm vui mới mẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440933,
					"content": "Trên đó còn có ghi địa chỉ nữa, tôi đang làm việc ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440934,
					"content": "Dùng tấm vé này, các vị sẽ có thể tận hưởng dịch vụ cao cấp miễn phí ở đó... À, tôi cũng phải quay về đó rồi, công việc trong tiệm không thể trì hoãn quá lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440935,
					"content": "Hy vọng hai vị sẽ sớm ghé thăm tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440936,
					"content": "Vậy ra cô yumekui-baku đó là một nhà trị liệu tâm lý sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440937,
					"content": "Cũng không bất ngờ lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "Dịch vụ trị liệu tâm lý... Ngoài việc suy nghĩ xem bữa tiếp theo nên ăn gì thì hình như có rất ít thứ khiến tôi phải lo lắng thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440940,
					"content": "Đúng rồi, chỗ đó hình như cũng có phục vụ ẩm thực đó. Nếu có vé mời rồi thì chúng ta đến đó ăn một bữa thịnh soạn nhé! Không thể để lãng phí cơ hội này được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440938,
					"content": "Thú vị đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "Tôi vẫn thấy ổn mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
		},
