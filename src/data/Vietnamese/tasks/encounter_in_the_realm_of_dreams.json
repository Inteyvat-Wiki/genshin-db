			"dialogs": [
				{
					"id": 120440201,
					"content": "Ôi, tôi nhớ những ngày tháng đuổi theo tanuki ở đây quá! Thật hoài niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440202,
					"content": "Hửm? Đó là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440203,
					"content": "Là tanuki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "Nhìn thế nào cũng không giống nhỉ? Chẳng lẽ Inazuma lại có youkai mới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440206,
					"content": "Hmm... Không lẽ nó muốn chúng ta đi theo nó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440204,
					"content": "Là heo con?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
		{
