			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810201,
					"content": "#{NICKNAME}, Paimon, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810202,
					"content": "Woa, là Kokomi và Gorou, không ngờ Thánh Pháp Sư và đại tướng của Đảo Watatsumi cũng đến tham gia Lễ Hội Irodori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810203,
					"content": "Đúng vậy, nhưng chúng tôi không phải đến đây với tư cách là quản lý của Đảo Watatsumi, mà là với tư cách cá nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810204,
					"content": "Dạo gần đây hiếm khi Đảo Watatsumi ít việc, tôi thì muốn mua một vài quyển sách nên quyết định đến đây một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810205
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810205,
					"content": "Thật ra Gorou không có hứng thú với Lễ Hội Irodori cho lắm, nhưng nghe nói tôi muốn đến Đảo Ritou nên cũng đi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810206,
					"content": "Dù sao thì đại nhân Sangonomiya phải đi xa mà, hôm nay còn phải đến gặp \"bạn qua thư\" nữa, tôi là đại tướng, đương nhiên phải đảm bảo an toàn của đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810207
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810207,
					"content": "\"Bạn qua thư\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810208,
					"content": "Đúng, chúng tôi mới quen biết gần đây, sau đó bắt đầu liên lạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810209
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810209,
					"content": "Tôi và bạn qua thư có sở thích về tiểu thuyết rất giống nhau, và chúng tôi thường có thể trò chuyện về rất nhiều ý tưởng thú vị. Tất nhiên, cũng có lúc đối chọi gay gắt, không ai nhường ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810210,
					"content": "Bởi vì lần này chúng tôi đều đến Lễ Hội Irodori, nên quyết định nhân cơ hội này mở một \"buổi đánh giá tiểu thuyết\", thảo luận về suy nghĩ của nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810211
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810211,
					"content": "Nghe có vẻ rất chuyên nghiệp! Đúng rồi, nếu hai người đã thích tiểu thuyết, hay là thử cùng nhau sáng tác đi? Nói không chừng sẽ có thể thay đổi trào lưu văn học của Inazuma đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810212,
					"content": "Haha, ý tưởng thú vị đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810213,
					"content": "#Sắp đến giờ rồi, {NICKNAME}, tôi và Gorou phải đến chỗ hẹn đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810214
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810214,
					"content": "Kokomi, thật ra tôi có hơi tò mò về người bạn qua thư của cô, tôi có thể đi cùng không? Cô yên tâm, tôi chỉ đứng nhìn từ xa thôi, sẽ không quấy rầy buổi gặp mặt của hai người đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810215,
					"content": "Để tôi suy nghĩ... Hai vị thì chắc không thành vấn đề, vậy thì chúng ta cùng đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 7228104,
			"completionStepIds": [
				7228104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228104",
