				"points": []
			},
			"dialogs": [
				{
					"id": 722811101,
					"content": "Anh rút thưởng ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811102
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 722811102,
					"content": "Anh chỉ cần xoay tay cầm là được, một lúc sau sẽ có một quả cầu rơi ra, nói không chừng anh sẽ là người may mắn của hôm nay đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811103
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811103,
					"content": "Gorou, thử vận may đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811104,
					"content": "Để tôi xem xem... quả cầu màu vàng! Thật lợi hại, vị khách này đã trúng giải đặc biệt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811105
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811105,
					"content": "Gorou, tôi thấy hôm nay bạn rất may mắn đó, mà nói chứ, giải đặc biệt thì được gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811106,
					"content": "Giải đặc biệt sẽ nhận được một bộ tiểu thuyết của Nhà Xuất Bản Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811107
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811107,
					"content": "Phần thưởng không chỉ do chính Yae Miko đại nhân phát, mà còn có cơ hội được cùng Yae đại nhân bắt tay chụp hình nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811108
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811108,
					"content": "Cái gì? Không những phải gặp cô ta, mà còn... còn phải bắt tay chụp hình nữa á?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811109
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811109,
					"content": "Gorou, mạnh mẽ lên nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811110
					]
				},
				{
					"id": 722811110,
					"content": "Cái gì, anh này rút được giải đặc biệt của Nhà Xuất Bản Yae rồi sao? May mắn quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811111
					],
					"speakerTitle": "Youta"
				},
				{
					"id": 722811111,
					"content": "Một bộ tiểu thuyết, trị giá bao nhiêu đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811112
					],
					"speakerTitle": "Akito"
				},
				{
					"id": 722811112,
					"content": "Ừm... chuyện này, cô biên tập ơi, tôi muốn bàn với cô một chuyện, thật ra tôi không muốn lấy tiểu thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811113
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811113,
					"content": "Ơ, có nghĩa là bỏ giải thưởng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811114
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811114,
					"content": "Gorou, đừng bỏ giải thưởng, nếu bạn không muốn gặp Miko, chúng tôi sẽ nghĩ cách giúp bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811115,
					"content": "Không, mọi người hiểu lầm rồi, ý tôi không phải là bỏ giải, chuyện nhận thưởng và chụp hình tôi cũng có thể chấp nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811116
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811116,
					"content": "Nhưng tôi có một yêu cầu, tôi muốn nhờ Nhà Xuất Bản Yae đổi giải thưởng này thành sách khoa học nông nghiệp có giá trị tương đương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811117
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811117,
					"content": "Sách khoa học nông nghiệp?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811118,
					"content": "Đúng. Đất đai trên đảo Watatsumi của chúng tôi rất cằn cỗi, lương thực thu hoạch kém, vì vậy tôi muốn tìm cách thức mới, giúp người dân có một cuộc sống tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811119
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811119,
					"content": "San... E hèm, tiểu thư \"Cá Bơn Biển Tung Tăng\" đến Lễ Hội Irodori lần này chủ yếu để mua sách trồng trọt và nuôi trồng thủy sản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811120
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811120,
					"content": "Nếu có thể đổi loại sách này làm giải thưởng, vậy thì chúng tôi sẽ có thể tiết kiệm chút tiền, tiểu thư \"Cá Bơn Biển Tung Tăng\" cũng có thể chọn những thứ khác có ích hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811121
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811121,
					"content": "Thì ra là vậy... tôi hiểu rồi. Nhưng mà chuyện này tôi không thể tự quyết định được, chuyện này phải hỏi ý kiến của Yae đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811122
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811122,
					"content": "Bây giờ tôi sẽ đi liên hệ với Yae đại nhân, quý khách hãy đến quảng trường Ngũ Ca Tiên chờ một chút. Tùy thuộc vào tình hình, có thể Yae đại nhân sẽ đích thân bàn bạc chuyện này với mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811123
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811123,
					"content": "Ừm, được, tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
