						722810710
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810710,
					"content": "Quý khách sao thế? Hình như lông đuôi dựng hết lên rồi kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810711
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 722810711,
					"content": "Không, tôi không sao, cảm ơn món quà của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810712
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810712,
					"content": "#{NICKNAME}, còn con hồ... ừm, con búp bê này, nếu có thể, bạn nhận giùm tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810713
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810713,
					"content": "Có thật là được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810714
					]
				},
				{
					"id": 722810714,
					"content": "Ừm, xem như quà cảm ơn các bạn đã cùng tôi đi mua sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810715
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810715,
					"content": "Ôi, có vẻ như Gorou vẫn chưa thoát được nỗi ám ảnh tâm lý về Miko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810716,
					"content": "Tiếp theo... mặc dù đây không phải là trọng tâm của chuyến đi này, nhưng chúng ta đi mua tiểu thuyết trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810717
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810717,
					"content": "Trong danh sách có nói tập mới nhất của \"Trầm Thu Thập Kiếm Lục\" đã nhờ một biên tập viên tên là Onodera giữ hàng trước, đừng để họ chờ chúng ta quá lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810718
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810718,
					"content": "Người này chúng tôi biết, chúng tôi đưa bạn đi tìm anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
