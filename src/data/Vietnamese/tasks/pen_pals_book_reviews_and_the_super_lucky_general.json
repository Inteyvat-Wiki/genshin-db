					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810502,
					"content": "Ồ! Là hai người à... Haiz, không ngờ cô gái đó lại đột nhiên xuất hiện, thật sự tôi không biết phải nói gì với cô ấy. Đến khi tôi định thần lại thì tôi đã trốn ở đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810503
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810503,
					"content": "Rõ ràng tôi đến là để bảo vệ sự an toàn cho đại nhân Sangonomiya, nhưng cuối cùng lại chẳng làm được gì cả, ngược lại còn trở thành gánh nặng cho cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810504
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810504,
					"content": "Gorou, đừng tự trách mình nữa, thật ra Kokomi cũng nhờ chúng tôi đến giao một nhiệm vụ quan trọng cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810505,
					"content": "Đưa danh sách của Kokomi cho Gorou.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722810506
					]
				},
				{
					"id": 722810506,
					"content": "Đây là danh sách cần mua của đại nhân Sangonomiya, tôi hiểu rồi, đại nhân muốn tôi lấy công chuộc tội! Được rồi, cứ giao cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810507
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810507,
					"content": "Gorou, chúng tôi cũng sẽ đi cùng bạn, chúng tôi có thể đóng vai trò người hướng dẫn và đồng hành cùng bạn trong Lễ Hội Irodori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810508,
					"content": "Cảm ơn rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
