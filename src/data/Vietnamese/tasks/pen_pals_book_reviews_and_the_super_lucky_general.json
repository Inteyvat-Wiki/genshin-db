					"nextDialogs": [
						722810707
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 722810707,
					"content": "Woa, còn có phần thưởng nữa sao, hay lắm Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810708,
					"content": "Đây là một con búp bê hồ ly, hãy nhận lấy!",
