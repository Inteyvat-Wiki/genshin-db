			"dialogs": [
				{
					"id": 722811601,
					"content": "#{NICKNAME}, Paimon, cảm ơn các bạn đã đến tiễn chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811602
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811602,
					"content": "Chuyến đi đến Đảo Ritou thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811603
					]
				},
				{
					"id": 722811603,
					"content": "Rất đáng giá. \"Buổi đánh giá tiểu thuyết\" rất thành công, nó cũng cho tôi hy vọng về những cuộc nói chuyện chính thức trong tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811604,
					"content": "Hơn nữa, Gorou cũng lập được đại công, trong một thời gian ngắn đã tìm được rất nhiều sách có ích cho Đảo Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811605
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811605,
					"content": "Mặc dù là tôi giành được giải thưởng lớn, nhưng số sách này suy cho cùng cũng là do Yae Miko tặng. Tôi thấy nếu sau này có cơ hội, tôi phải cảm ơn cô ấy đàng hoàng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811606
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811606,
					"content": "Đúng rồi, hình như hôm qua Yae Miko có gửi một bức thư đúng không? Cô ấy nói gì vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811607
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811607,
					"content": "À, suýt nữa thì tôi quên chuyện này! Để tôi lấy ra xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811608,
					"content": "Gorou, chị đoán lúc vừa nghe nói đến chuyện nhận thưởng và chụp hình, chắc trong lòng cưng rất bất an đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811609
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811609,
					"content": "Không ngờ cưng không chỉ chấp nhận điều kiện đó, mà còn đưa ra yêu cầu với chị nữa, chị đây rất trân trọng lòng can đảm của cưng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811610
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811610,
					"content": "Những quyển sách này là chút tấm lòng của chị gửi đến Đảo Watatsumi, cũng là quà mà chị tặng cưng, mong cưng sẽ thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811611
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811611,
					"content": "À đúng rồi, đọc đến đây, chắc chắn cưng sẽ rất cảm kích chị đúng không, và muốn tìm cơ hội để cảm ơn chị đúng chứ, cơ hội của cưng đến rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811612
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811612,
					"content": "Tháng sau Nhà Xuất Bản Yae sẽ tổ chức một sự kiện, chị muốn tìm người đóng vai nhân vật trong tiểu thuyết để tương tác với độc giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811613
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811613,
					"content": "Cưng không chỉ kiên nhẫn, mà còn rất đẹp trai nữa, hay là đến đây giúp chị nhé, chị hứa sẽ tạo hình cho cưng xinh lung linh luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811614
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811614,
					"content": "Tiện thể nói luôn, là vai nữ nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811615
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811615,
					"content": "Áaaaaa, cái đồ đáng ghét!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		}
	]
}