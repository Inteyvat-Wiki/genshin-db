			"dialogs": [
				{
					"id": 722811301,
					"content": "Gorou, lúc nãy bạn thật dũng cảm, rõ ràng bạn không giỏi đối phó với Miko, nhưng không chỉ đồng ý tham gia nhận thưởng, mà còn đưa ra yêu cầu của mình nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811302,
					"content": "Thật sao? Lúc đó tôi chỉ nghĩ đến ủy thác của đại nhân Sangonomiya và người dân Đảo Watatsumi thôi, thế là có can đảm ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811303
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811303,
					"content": "Tôi là đại tướng Đảo Watatsumi, sao lại có thể thua được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811304
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811304,
					"content": "Bây giờ tôi đã tìm được cảm giác dẫn binh tác chiến, lát nữa, cho dù là Yae Miko đích thân đàm phán, tôi cũng sẽ không bị sức ép của cô ta lấn át đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811305
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811306
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811306,
					"content": "Gorou, trông bạn vẫn còn hơi căng thẳng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811307,
					"content": "Haha, chắc là vì đang nghĩ đến chuyện cô ta sẽ đưa ra yêu cầu gì đó để châm chọc tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811308
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811308,
					"content": "Xin lỗi đã để mọi người đợi lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811309
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811309,
					"content": "Tình hình thế nào, Guuji Yae nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811310
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811310,
					"content": "Yae đại nhân nói, có thể đồng ý yêu cầu của anh, đổi giải thưởng tiểu thuyết thành sách khoa học nông nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811311
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811311,
					"content": "Tuyệt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811312,
					"content": "Yae đại nhân còn nói, xem xét mục đích của khách hàng, sẽ còn có thể tặng thêm một ít nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811313
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811313,
					"content": "Bây giờ anh có thể đến kho của Nhà Xuất Bản Yae để chọn sách. Quý khách đi thuyền vào tối mai, sách đã chọn chúng tôi sẽ đóng gói và đưa thẳng lên thuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811314
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811314,
					"content": "Đóng gói trực tiếp? Vậy thì buổi lễ nhận thưởng phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811315
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811315,
					"content": "Yae đại nhân nói, chọn sách sẽ tốn rất nhiều thời gian và công sức, để anh có được những hồi ức thật đẹp về Lễ Hội Irodori, nghi thức nhận thưởng sẽ được hủy bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811316
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811316,
					"content": "Nhưng mà, đại nhân đã để lại cho anh một bức thư, anh có thể đọc nó khi có thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811317
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811317,
					"content": "Không ngờ Yae Miko lại hủy bỏ nghi thức nhận thưởng... Haiz, lúc trước tôi cứ luôn nghĩ là sẽ bị cô ấy châm chọc, xem ra tôi đã quá hẹp hòi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811318
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811318,
					"content": "Vậy tôi đi theo cô biên tập đi chọn sách nhé, không làm phiền các bạn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811319,
						722811320
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811319,
					"content": "Gorou, tối mai gặp lại nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				},
				{
					"id": 722811321,
					"content": "Được, tối mai gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811320,
					"content": "Chúng tôi sẽ đến bến tàu tiễn các bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				}
			]
		},
