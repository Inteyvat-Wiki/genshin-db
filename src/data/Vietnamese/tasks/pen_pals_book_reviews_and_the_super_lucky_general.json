						],
						"stepId": 7228104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Gorou",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810401,
					"content": "Chỗ hẹn là ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810402
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810402,
					"content": "Xung quanh không có ai khác, có vẻ như chúng ta đến hơi sớm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810403
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810403,
					"content": "Ôi ôi, xem ai đến rồi đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810404,
					"content": "Miko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810405,
					"content": "(Tiêu rồi, không ngờ lại gặp Miko! Miko và Kokomi không những khác phe, mà những vị thần họ tín ngưỡng cũng khác nhau nữa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810406,
					"content": "(Giữa hai người họ... sẽ không xảy ra xung đột gì chứ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810407,
					"content": "Không hổ danh là đại nhân Guuji của Đền Narukami, rất có khí chất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810408,
					"content": "Haha, không hổ danh là thủ lĩnh của Đảo Watatsumi, mặc dù trông có vẻ yếu đuối như một con sứa, nhưng lời nói lại rất sâu sắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810409,
					"content": "Á... Phải, phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810410,
					"content": "Xin chào, lần đầu gặp mặt, tiểu thư \"Đậu Phụ Rán Lung Linh\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810411,
					"content": "Chiếu cố thêm nhé, tiểu thư \"Cá Bơn Biển Tung Tăng\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810412,
					"content": "Hahahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810413,
					"content": "Hả... rốt cuộc chuyện này là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810414,
					"content": "Thì ra bạn qua thư của Kokomi là Miko sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810415,
					"content": "Không, không, trông có vẻ như hai người đã sớm biết thân phận của nhau rồi! Nói như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810416,
						722810417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810416,
					"content": "Cái gọi là gặp mặt bạn qua thư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				},
				{
					"id": 722810418,
					"content": "Hở? Cưng đang nói gì vậy, sao tôi nghe không hiểu gì hết thế? Rõ ràng tôi chỉ đến đây gặp tiểu thư \"Cá Bơn Biển Tung Tăng\" để mở \"buổi đánh giá tiểu thuyết\" thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810419,
					"content": "Chúng ta đi thôi, địa điểm tổ chức buổi đánh giá nằm trong phủ Hiệp Hội Kanjou bên trên, ở đó phong cảnh rất đẹp, rất thích hợp để uống trà và bàn chuyện sáng tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810420
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810420,
					"content": "\"Buổi đánh giá tiểu thuyết\" gì mà mở ở phủ Hiệp Hội Kanjou chứ, tin mới lạ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810421,
					"content": "Tôi thấy lần nói chuyện này của hai người không những thay đổi phong trào văn học, mà con thay đổi luôn chiến sự của cả Inazuma luôn quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810422,
					"content": "Haha, Đảo Watatsumi sẽ sớm có các cuộc đàm phán chính thức với Shogunate về sự phát triển trong tương lai của Inazuma, và các cuộc gặp không chính thức như vậy cũng cần thiết trước khi hội đàm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810423,
					"content": "Đúng, đặc biệt là những người không thuộc Shogunate như tôi sẽ thuận tiện hơn khi giúp mọi người tìm ra điểm mấu chốt của nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810424,
					"content": "Có điều đây là lần đầu chúng tôi gặp mặt, đối với công chúng, công bố thông tin vẫn còn hơi sớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810425,
					"content": "Ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810426,
					"content": "Nói chứ, sao không thấy đại tướng của cô vậy? Chẳng phải cô nói bé cún cưng ấy cũng sẽ đến sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810427,
					"content": "Í, đúng rồi, sao Gorou đột nhiên biến đâu mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810428,
					"content": "Gorou giúp tôi đi mua sách, nên lần này không đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810429
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810429,
					"content": "Ui, thật đáng tiếc, tôi còn tưởng sẽ lại được nhìn thấy đôi tai mịn màng của bé cưng đó nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810430
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810430,
					"content": "#{NICKNAME}, đến đây chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810431
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810431,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810432
					]
				},
				{
					"id": 722810432,
					"content": "Tôi có cảm giác Gorou không giỏi đối phó với Guuji Yae, nên ngay từ đầu tôi mới không muốn để cậu ta cùng tôi đến Đảo Ritou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810433
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810433,
					"content": "Lúc nãy cậu ta đã trốn ngay khi vừa nhìn thấy Guuji Yae, chắc là do bản năng mách bảo, nhưng Gorou rất có tinh thần trách nhiệm, cậu ta chắc chắn sẽ cảm thấy xấu hổ khi gặp tôi sau này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810434
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810434,
					"content": "Cho nên tôi mới giao nhiệm vụ mua sách cho cậu ta, để cậu ta cảm thấy dễ chịu hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810435
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810435,
					"content": "Nhưng trước giờ Gorou rất ít khi mua đồ, nên tôi muốn nhờ các bạn đi cùng cậu ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810436
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810436,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810437
					]
				},
				{
					"id": 722810437,
					"content": "Kokomi, cô cứ yên tâm nói chuyện với Miko đi, chuyện mua sách cứ giao cho chúng tôi và Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810438,
					"content": "Vậy thì nhờ mọi người nhé. Tôi đã liêt kê những cuốn sách cần mua trên tờ giấy này, bạn đưa nó cho Gorou nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810417,
					"content": "Chỉ là để che mắt thôi phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				}
			]
		},
