			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "Haiz...người qua đường tốt bụng...xin hãy thương hại tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "Cảm ơn cháu đã lắng nghe lão đây kể khổ...haiz...đến đây, đến đây, nghe ta nói thêm vài câu nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010105,
					"content": "Cả đời này...ta chưa có một ngày nào được đổi vận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010106,
					"content": "Ngay từ khi ta vừa được sinh ra, vị tư tế đại nhân chủ trì lễ chào đời đã vô tình làm đổ ngọn đèn dầu và làm cháy mất mái tóc dài của dì ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010107,
					"content": "Ôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "Sau đó, ta mắc một căn bệnh lạ, chân tay mất thăng bằng; Rồi một ngày nọ, ta bị văng ra khỏi nôi, gãy mất sáu cái xương sườn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010109,
					"content": "Đến khi ta lớn hơn một chút, có một hôm, chú của ta ăn nấm bị ngạt thở suýt chết, cha của ta khi dùng xẻng để cứu chú ấy đã đập trúng đầu ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010110,
					"content": "Rồi có một lần, con chim sẻ nhỏ ta yêu quý bị Wen Kamuy nhà nuôi ăn mất, Wen Kamuy bị lợn rừng mù húc văng khỏi vách núi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010111,
					"content": "Sau đó, cô gái ta thích không cẩn thận bị tư tế đại nhân hiến tế cho Lôi Điểu đại nhân, bị trục xuất khỏi đảo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010112,
					"content": "Đến khi ta lớn, bà của ta mất bởi đau buồn vì sự xấu xí và ủ rũ của ta, sau đó ông của ta cũng đi theo bà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010113,
					"content": "Sau đó thì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010114,
					"content": "Dù sao thì gia đình cũng là niềm an ủi đối với ông đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "À, nói đến gia đình...trong buổi lễ trưởng thành, thầy tế đại nhân đã nói có thể ta sẽ không có con được, bởi vì ta có...chờ chút, để ta cho cháu xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010116,
					"content": "Không cần!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "Haiz...nghe ta nói thêm một câu cuối cùng đi...đó cũng là điều cuối cùng ta muốn nhờ cháu làm cho ông già tội nghiệp này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010119,
					"content": "Ông cứ nói thẳng ra đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Cách đây một thời gian, khi chôn cất vợ ta, ta đã không cẩn thận làm rơi chiếc nhẫn xuống mộ và chôn chung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010122,
					"content": "Đó là tài sản cuối cùng của ta...nhưng ta không dám đào lên lại...bởi vì như vậy sẽ xúc phạm đến linh hồn của bà ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010123,
					"content": "Vậy nên, ông muốn cháu đi trộm mộ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "Cháu là người ngoài...người ngoài làm sẽ không kỳ cục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010125,
					"content": "À không phải, không phải...ý của ông là, nếu là người ngoài sẽ tránh được chuyện chọc giận linh hồn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010126,
					"content": "Hãy đến Đền Chirai...mộ của bà ấy ở bên cạnh đền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010120,
					"content": "Đừng đề cập đến những chủ đề kỳ cục kia nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "Chủ đề này như vậy là quá đủ rồi!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "Có cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
