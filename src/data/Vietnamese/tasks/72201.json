			"dialogs": [
				{
					"id": 722010201,
					"content": "Ôi hahahahahaha...haha...hahahahaha!! Ôi ôi ôi...hết hơi rồi hết hơi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010202,
					"content": "Hahahaha cười chảy cả nước mắt rồi đây!! Chikapu à, giá như bà còn ở đây thì hay biết mấy!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010203,
					"content": "Cháu hơi bực rồi đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "Hahahaha xin lỗi, xin lỗi...đừng giận mà, chuyện là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010206,
					"content": "Vợ chồng ta luôn thích trêu chọc người khác, những trò đùa chưa bao giờ lặp lại, và ai cũng thích thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010207,
					"content": "Sau đó bà ấy bệnh nặng và ra đi sớm...khi đó bà ấy có dặn dò ta, nhất định phải là một người đàng hoàng ở trước mộ bà ấy, nếu không linh hồn của bà ấy sẽ không thể rời đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010208,
					"content": "Để hoàn thành nguyện vọng của Chikapu...thế nào, ta làm không tệ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010209,
					"content": "Trò đùa này thật nhàm chán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "Chậc chậc, người ngoài đảo chẳng thú vị chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010213,
					"content": "Ngay cả thủ thuật phun nước của ta cũng không muốn xem...thật nhàm chán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010214,
					"content": "Tạm biệt, ta đi đây, ta đi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010210,
					"content": "Sẽ xảy ra án mạng đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "Cháu sẽ không tin những lời ông nói nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "Nói cho cháu biết rốt cuộc là chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
