			"dialogs": [
				{
					"id": 730310101,
					"content": "Araja, Arama, chúng tôi đã về rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310102,
					"content": "#Lại gặp Nara {NICKNAME} và Paimon rồi! Vui quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310103,
					"content": "#Ây da, các bạn về rồi. Mọi người đều đang bàn tán về một Nara {NICKNAME} rất cao to, rất mạnh mẽ, đã giúp họ rất nhiều rất nhiều. Tất cả mọi người đều rất vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310104,
					"content": "#Có người giúp làm việc quả thật rất vui! Đúng không, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310105,
					"content": "Vui quá đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "Không phải. Họ vui vẻ là vì quen được bạn mới. Tuy Aranakin, Aranaga và Aragaru đều không nhớ được, nhưng rừng sâu sẽ nhớ tất cả, câu chuyện sẽ không biến mất hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310108,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310109,
					"content": "Việc chuẩn bị cho Lễ Hội Utsava cũng đã kha khá rồi. Chỉ cần thêm một ít thời gian nữa thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310110,
					"content": "#Ừm, may mà có Nara {NICKNAME} và Paimon giúp đỡ. Lễ Hội Utsava cuối cùng cũng sắp bắt đầu rồi. Thật mong chờ làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310106,
					"content": "Ồ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
		},
