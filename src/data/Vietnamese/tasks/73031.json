					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310309,
					"content": "Việc chuẩn bị cho Lễ Hội Utsava cũng đã kha khá rồi. Tôi mong chờ quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310310,
						730310311
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310310,
					"content": "Không biết tình hình bên Rana ra sao rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#Ừm, vậy chúng ta tới gặp Rana đi, {NICKNAME}. Biết đâu chừng đã có chuyển biến tốt rồi! Ôi chao, thế thì chúng ta có thể dẫn cô ấy đến đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310316,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "Ừm. Lát nữa tôi cũng sẽ đi tìm Arana. Các bạn cứ đi trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310321,
					"content": "#Nara {NICKNAME}, Paimon, lát gặp nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310317,
					"content": "Mong là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "Đừng kỳ vọng quá nhiều...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310311,
					"content": "Tôi cũng rất mong chờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "Ừm! Không biết so với lễ hội ở những chỗ khác thì sẽ có cảm giác như thế nào nhỉ? Thật hào hứng khi có thể tham gia lễ hội cùng với bạn bè đó！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310314,
					"content": "... Nếu như Rana cũng ở đây thì tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310315
					],
					"speakerTitle": "Paimon"
