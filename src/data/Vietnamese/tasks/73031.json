			"dialogs": [
				{
					"id": 730310601,
					"content": "Trông Rana có vẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310602,
					"content": "Thật ra tôi muốn nói \"ngủ ngon ghê\", nhưng hình như nói thế không tốt lắm thì phải...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310603,
					"content": "(Giữa \"bong bóng\" bao vây Rana dường như có cảnh tượng gì đó xuất hiện...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730310604,
					"content": "(Đắm chìm vào trong cảnh tượng...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "Bạn ở giữa rừng cây, tất cả đều vô cùng khổng lồ, lại vô cùng tĩnh lặng. Nhưng bạn lại vô cùng tự tại.\\nÁnh sáng thỉnh thoảng xuyên qua tán lá lấp lánh như ánh vàng, tiếng cười vui từ những ngọn cỏ dại cao ngang ngửa bạn, lúc bạn đi ngang qua còn nhẹ nhàng mơn trớn bàn tay bạn.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "Lắng nghe bản hòa tấu ngân nga của cây cối xào xạc xen lẫn tiếng nước róc rách, bạn bỗng nghe thấy một tiếng khóc. Lần theo âm thanh, bạn tìm được một bóng hình nhỏ bé.\\nDường như khóc đến mệt lả, cô ấy nằm rạp ngủ trên bãi cỏ. Bạn đi tới bên cạnh cô ấy, nhẹ nhàng hát vang khúc ca có thể khiến sinh linh cảm thấy yên bình...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#...Này! {NICKNAME}, bạn sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310608,
					"content": "Bạn không sao thì tốt rồi... Thấy bạn thế này, tôi còn tưởng bạn sắp xỉu đến nơi... lo chết được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310609,
					"content": "#Nara {NICKNAME}! Các bạn đã tới rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310610,
					"content": "Ôi! Giật cả mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310611,
					"content": "Ôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310612,
					"content": "Ôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "Thật là, sao Aranara các bạn lại cứ xuất hiện bất thình lình như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310615,
					"content": "Là Bông Trắng mới đúng, sao bạn tự dưng lại la \"ối\" lên thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310616,
					"content": "Tôi là Paimon, chứ không phải là Bông Trắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310617,
					"content": "Arana ở trong lòng đất, duy trì sức mạnh của Ararakalari. Thế thì Narana mới không bị héo. Nhưng để trở nên mạnh mẽ hơn thì vẫn cần có Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310618,
					"content": "#Thì ra là thế. Nhưng nói vậy, trước đây {NICKNAME} làm sao thế...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310619,
					"content": "(Miêu tả cảnh tượng cảm nhận được...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "Đây hẳn là ký ức của Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310621,
					"content": "Kí ức...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310622,
					"content": "Paimon không biết thôi. Ký ức và giấc mơ là sức mạnh của Aranara, thứ quý giá nhất. Có giấc mơ và ký ức thì Arana mới có thể sử dụng Ararakalari, giúp đỡ cho các Aranara và Nara cần giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310623,
					"content": "#Một số Nara, có thể cảm nhận được ký ức trong Ararakalari. Xem ra Nara {NICKNAME} có thể cảm nhận được điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310624,
					"content": "Nghe bạn nói như thế, tôi có cảm giác Ararakalari là một thứ rất trang trọng! Trước đây, trong hang động đó, người sử dụng Ararakalari bảo vệ Iotham cũng chính là Arana nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310625,
					"content": "Đúng là Arana. Nara Iotham, Nara Kavus, Nara Sudabeh là bạn của Arana. Cho nên Arana sẽ bảo vệ họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310626,
					"content": "Bọn họ thường vào trong rừng sâu, chơi với Arana. Arana thì dạy kiến thức về rừng sâu, ngôn ngữ của hoa cỏ cho bọn họ. Họ là những người bạn rất quan trọng, giống như Narana vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310627,
					"content": "Về chuyện bọn trẻ mất tích...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "Đúng! Nói tới chuyện này, Kavus và Sudabeh cũng từng mất tích trước Iotham... Nhưng sau đó đã được đưa về Làng Vimara. Đây cũng là chuyện do Arana làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310629,
					"content": "Ừm. Arana phát hiện, Nara xấu xa và Nara Valuka đã bắt họ đi, Cho nên Arana đã thừa lúc Nara không để ý, giúp Nara Kavus và Nara Sudabeh rồi dẫn họ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310630,
					"content": "Quả nhiên là như thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "Ừm... Nhưng tại sao họ lại chẳng nhớ gì về mấy chuyện này thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310633,
					"content": "Arana để Nara nhỏ bước vào giấc mơ, sau đó xóa bỏ những điều không tốt ở trong mơ. Làm thế, bọn họ sẽ không trở thành kẻ xấu khi trưởng thành, cũng giống như mầm non phát triển thành cây lớn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310634,
					"content": "Bằng không, Nara nhỏ sẽ luôn sợ hãi, lâu dần sẽ tin tưởng sức mạnh của \"nỗi sợ\". Sau đó, khi họ lớn lên sẽ biến thành những Nara xấu xa khiến người khác sợ hãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310635,
					"content": "Bọn họ là bạn của Arana, cho nên Arana không muốn bọn họ trở thành Nara xấu xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310636,
					"content": "Có lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "Bọn họ nhất định sẽ trở thành những người tuyệt vời! Nói vậy, Arana có manh mối gì về bọn Nara xấu xa muốn bắt họ đi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310641,
					"content": "Arana sẽ không tha thứ cho họ. Những Nara xấu xa không phải con của rừng sâu, bọn họ sẽ dẫn Nara Valuka tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310642,
					"content": "Trong Làng Vimara, có một Nara kỳ lạ. Nara đó cũng không phải là con của rừng sâu, mà là con của tuyết. Hình như là một Nara tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310643,
					"content": "Bởi vì anh ấy thường ở bên cạnh Nara nhỏ, Nara nhỏ cũng hay kể chuyện của anh ấy. Nhưng Arana đã nhìn thấy anh ấy nói chuyện với Nara xấu xa, còn nói về chuyện của Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310644,
					"content": "Ở trong Làng Vimara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310645,
					"content": "Đồng bọn của Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "Sao có thể như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310648,
					"content": "Ôi... Tôi không muốn nghĩ tới mấy chuyện thế này, người trong Làng Vimara đáng ra phải giống như một gia đình mới đúng... Hơn nữa, tên đó đã hại Rana biến thành thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310649,
					"content": "Phải bắt tên đó mới được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "Ừm, bất luận thế nào chúng ta phải bắt được tên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310652,
					"content": "#Nara {NICKNAME}, Paimon, các bạn hứa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310653,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310654,
					"content": "Các bạn sẽ trừng phạt Nara xấu xa. Thế thì Nara Iotham, Nara Kavus, Nara Sudabeh sẽ không sợ hãi nữa. Họ có thể trở thành một Nara lớn một cách khỏe mạnh, giống như cây nhỏ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310655,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "Narana đã lớn lên mạnh khỏe. Cho nên cô ấy đã không nhìn thấy Arana được nữa. Không nhìn thấy Arana cũng không sao, Arana biết cô ấy khỏe mạnh thì rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310658,
					"content": "Lâu lắm rồi không được chơi cùng với Narana. Rất nhiều mặt trời mọc rồi lặn, sau đó thì mặt trăng xuất hiện trên bầu trời. Rất nhiều trái cây mọc lại trở về trong đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310659,
					"content": "Narana càng lớn càng cao, ban đầu chỉ cao bằng Arana. Nhưng về sau lại cao cỡ một cái cây nhỏ. Sau đó cô ấy không đến chơi với Arana nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310660,
					"content": "Arana đã kể rất nhiều chuyện về rừng sâu cho cô ấy nghe. Nấm Sao là hình ảnh phản chiếu của các vì sao trên trời xuống mặt đất. Nếu nhìn thấy Sen Nilotpala nở thì bạn sẽ gặp may mắn cho đến lần trăng mọc tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310661,
					"content": "Những việc này, Arana sẽ dạy cho Nara Iotham. Mong rằng bọn họ sẽ khỏe mạnh lớn lên như Narana. À, nhưng không thể chạy đến Marana như Narana được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310662,
					"content": "Liệu bọn họ có quên chuyện trong rừng sâu khi trưởng thành không? Giống như Rana vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310663,
					"content": "Nara Iotham, Nara Kavus, Nara Sudabeh cũng sẽ lớn lên. Cho dù lớn lên có quên đi cũng chẳng sao... Sau cùng thì rừng sâu sẽ nhớ hết mọi chuyện thôi. Chúng sẽ không mất đi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310664,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310665,
					"content": "Chúng sẽ không mất đi đâu. Mọi chuyện tốt đẹp sẽ không mất đi. Mọi nỗi đau sẽ vun đắp cho những chuyện tốt đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310666,
					"content": "#Arana! Nara {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310667,
					"content": "Arama! Arana đã lâu không gặp Arama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310668,
					"content": "Sao Paimon không \"ôi\" nữa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "Thật đó, tôi không dễ gì bị hù dọa như thế đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310670,
					"content": "Arama muốn bảo chúng tôi cùng về Vanarana tham gia Lễ Hội Utsava sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310672,
					"content": "#Ừm! Lễ Hội Utsava đã sẵn sàng rồi, mọi người đang chờ Nara {NICKNAME} và Paimon đấy. Tham gia cùng nhau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310673,
					"content": "Được đó! Lễ Hội Utsava! Nhưng Arana không đi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310674,
					"content": "Ừm, Arana không đi đâu. Nếu như Arana đi lâu quá thì Ararakalari sẽ sụp mất, Narana sẽ gặp nguy hiểm. Cho nên tôi không thể đi Lễ Hội Utsava được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310675,
					"content": "Sao lại thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310676,
					"content": "#Không sao đâu. Nếu Nara {NICKNAME} và Paimon chơi vui vẻ thì Arana, Arama, và mọi người ở Vanarana sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310677,
					"content": "Ừm. Arana, Bija cần sức mạnh của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310678,
					"content": "Đến lúc đó Arana sẽ chuẩn bị tốt.",
