						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh",
					"Xudong",
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "Cái, cái tên này...Nếu làm hỏng cái chảo thì chúng ta làm sao nấu ăn đây!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160302,
					"content": "Đừng xem thường chảo của Liyue thế chứ, cái chảo này là dùng chất liệu đặc biệt để làm ra đó, sao lại có thể dễ hỏng thế được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160303,
					"content": "Với lại, chỉ có vài con ma vật thôi mà. Đến ma vật cũng đánh không ngất thì còn gì là chảo xịn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160304,
					"content": "Anh kỳ vọng vào cái chảo này cao quá rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160305,
					"content": "Xudong trông thật có khí thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "Đương nhiên rồi, đây là kết quả tập luyện của một đầu bếp mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160307,
					"content": "Chưa hề nghe qua đấy?! Làm gì có đầu bếp nào đi học cách dùng chảo để đánh ma vật thế chứ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160315,
					"content": "Được rồi, Julie, giờ chúng ta phải mau chóng rời khỏi đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160316,
					"content": "Đợi đã, chúng ta phải giúp ông chú kia, chú ấy đang phải một mình chống lại đám Kairagi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160317,
					"content": "Kairagi? Sao chúng lại xuất hiện ở đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160318,
					"content": "Cái này để sau này mới nói đi...giờ mọi người hãy mau đi giúp ông chú đó có được không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160319,
					"content": "Hiểu rồi. Nhà lữ hành, đi với chúng tôi thêm một chuyến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160320,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "Chúng ta mau xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160321,
					"content": "Bạn muốn chiến đấu với Kairagi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "Đương nhiên rồi, cái chảo này của tôi đang thèm khát cái mặt của chúng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160323,
					"content": "Với lại, thân là đầu bếp cũng đâu thể rút lui sớm vậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160324,
					"content": "Đã nói rồi, đừng kỳ vọng vào cái chảo đó nhiều quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160308,
					"content": "Vậy cái chảo này mua ở đâu vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "Ha ha, hỏi hay lắm, tôi đặt làm từ chỗ ông chú của tiệm \"Hàn Phong Thiết Khí\" đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160310,
					"content": "Nghe ông chú đó nói cái chảo này còn được pha thêm một chút nguyên liệu lấy từ Vực Đá Sâu nữa, nếu muốn mua thì bạn có thể đến đó tìm ông ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160311,
					"content": "Nhưng tôi nghe nói Vực Đá Sâu đã bị phong tỏa lâu rồi, nên chắc là giờ không thể làm ra được cái chảo giống vậy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160312,
					"content": "Parvaneh cũng thật có khí thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "Ấy? À...ha ha, tôi chỉ ném vài quyển sách vào đầu đám ma vật đó thôi mà, nhờ bạn nên mới đánh lui được đám ma vật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160314,
					"content": "Đợi đã, trang thứ sáu của quyển \"Đồng Hành Với Thần\" của tôi đâu rồi? Không phải đã rớt mất rồi chứ...tôi vẫn chưa xem xong mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
			"id": 2201604,
