			"dialogs": [
				{
					"id": 220160701,
					"content": "Hai người đó thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160702,
					"content": "Bạn có vẻ vẫn không tin tưởng chú ấy lắm nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "Bạn đang nói Kamei Munehisa đúng không? Chuyện đó đương nhiên rồi...chúng tôi chưa gặp nhau bao lâu thì sao có thể dễ dàng tin tưởng người khác như vậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160704,
					"content": "...Nhưng mà, tuy tôi không tin ông ấy lắm, nhưng tôi tin vào quyết định của Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160705,
					"content": "Bạn đến từ Giáo Viện đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "...Có thể coi là vậy, tôi từ Giáo Viện đi ra ngoài du học, sau đó gặp Xudong ở Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160707,
					"content": "Anh ta dự định đi khắp nơi để nghiên cứu công thức nấu ăn, đồ án nghiên cứu của tôi cũng là về lĩnh vực ẩm thực. Cho nên sau khi thảo luận vài lần thì chúng tôi đã đồng hành với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160708,
					"content": "Đầu tiên chúng tôi đến Mondstadt, bị một nhóm ma vật tấn công, may mà có Julie giúp đỡ kịp thời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160709,
					"content": "Cô ấy nói cũng muốn chu du khắp nơi tìm kiếm thức ăn ngon, vì vậy nên đã gia nhập hội của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160710,
					"content": "Tuy cô ấy luôn miệng nói là muốn đi mạo hiểm khắp nơi, nhưng thực tế cho thấy cô ấy chỉ quan tâm đến ăn uống mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160711,
					"content": "Điểm đến tiếp theo của chúng tôi là Sumeru, đồ án nghiên cứu của tôi cũng đã hoàn thành kha khá rồi, cũng là lúc phải về Giáo Viện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160712,
					"content": "Hừ, sau khi đến Sumeru, tôi nhất định sẽ khiến họ phải ngạc nhiên về mỹ thực của quê hương tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160713,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
				{
					"id": 220160714,
					"content": "Ừm, tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
