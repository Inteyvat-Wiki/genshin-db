					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "Khụ khụ...Không ngờ lại để đám ác đồ đó chèn ép đến vậy, thật ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160402,
					"content": "Chú có sao không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160403,
					"content": "Chỉ là thua vài chiêu thôi, không có vấn đề gì lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160404,
					"content": "Julie, giờ cô đã có thể nói hết mọi chuyện ra chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160405,
					"content": "Phải khai ra hết đấy nhé, nếu không tôi sẽ bắt cô đền lại quyển sách cho tôi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160406,
					"content": "Mọi chuyện rất đơn giản thôi mà, chỉ là tôi muốn giao chút thức ăn cho chú ấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160407,
					"content": "Hừ...chỉ mới gặp mặt có một lần thôi mà, sao cô lại tin tưởng...ông ta như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160408,
					"content": "Chú ấy chắc chắn là người tốt! Lúc trước rõ ràng chú ấy đã rất đói rồi, nhưng vẫn đồng ý chia thức ăn cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160409,
					"content": "Chia thức ăn cho người khác trong lúc đói thì nhất định là người tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160410,
					"content": "Cô thật ngây thơ quá đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160411,
					"content": "Còn cô chắc không phải sống ở lục địa Teyvat này, mà là sống ở trong truyện cổ tích nào đó đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160412,
					"content": "Ha ha ha, nhưng tôi cảm thấy Julie nói cũng đúng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160413,
					"content": "Tôi cảm thấy trong lúc đói bụng mà vẫn giữ được liêm sỉ thì nhất định không phải là kẻ xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160414,
					"content": "Logic này trông có vẻ đơn giản quá nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "Nói chung thì Julie cứ kể tiếp đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160416,
					"content": "Tôi đã làm món Xiên Thịt Gà Nấm, sau đó đến chỗ gặp chú ấy lần đầu xem có gặp lại không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160417,
					"content": "Sau đó tôi liền chạy qua kia rồi gặp chú ấy ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160418,
					"content": "Nhưng khi tôi định chào chú ấy thì đột nhiên phát hiện chú ấy đang đối mặt với Kairagi, hình như còn nói gì đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160419,
					"content": "Tôi vừa định chạy xa chút thì đã bị Kairagi phát hiện rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160420,
					"content": "Tiếp theo đó thì để tôi kể vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160421,
					"content": "Đám...người đó, có một vài người trong số đó là bạn cũ của tôi, trước đây từng cùng dốc sức phục vụ cho Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160422,
					"content": "Nhưng sau khi Inazuma xảy ra biến cố, chúng tôi đã rời khỏi Shogunate để mưu sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160423,
					"content": "Việc mà ban nãy họ làm là để mưu sinh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "...Đúng vậy, chúng tôi ngoài việc vung kiếm ra thì không còn cách mưu sinh nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160432,
					"content": "Từ đó về sau, họ đã trở thành \"Kairagi\", trộm cướp để mưu sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160433,
					"content": "Còn tôi thì không muốn trở thành bọn họ, nên đã lang thang khắp nơi, tìm một việc để làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160434,
					"content": "Nhưng mọi người biết tôi là một samurai của Shogunate thì không ai muốn thuê tôi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160435,
					"content": "Sau đó, như các hạ đã thấy, tôi chỉ còn cách lang thang ngoài đây tìm thức ăn, sống cuộc sống màn trời chiếu đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160436,
					"content": "Vài ngày gần đây, những đồng đội cũ của tôi thiếu nhân lực, nên mỗi ngày đều đến khuyên tôi gia nhập, nhưng tôi đều từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160437,
					"content": "Hôm nay...sau khi chúng phát hiện ra Julie, chúng nghĩ rằng tôi đã tìm được chỗ để nương thân, bèn đố kỵ vung kiếm tấn công tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160438,
					"content": "Hoàn toàn vô lý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "Bọn chúng thì có lý lẽ gì để nói chứ. Nhưng nếu ở trong hoàn cảnh của chúng...thực ra cũng không còn gì để mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160444,
					"content": "Sau đó, chú ấy đi đối phó với bọn chúng, còn tôi ở lại đây thì đột nhiên có đám ma vật kéo đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160445,
					"content": "Bạn hình như đủ sức đối phó với chúng mà đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "Bình thường thì có thể. Nhưng hôm nay quên chưa ăn gì, bụng đói quá nên không có sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160447,
					"content": "Với lại sau khi bị Kairagi phát hiện, tôi cũng lỡ làm rớt mất Xiên Thịt Gà Nấm rồi...may mà có chú ấy bảo vệ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160448,
					"content": "Đây là ví dụ điển hình cho tầm quan trọng của bữa ăn sáng đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "Nhưng mà, ở Inazuma vẫn còn rất nhiều Kairagi không nói đạo lý như vậy, chúng ta ở lại đây có thể sẽ gặp nguy hiểm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160451,
					"content": "Với sức của chúng ta, đối phó với vài tên ma vật thì được, nhưng nếu như phải đối phó với đám người biết võ nghệ thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160452,
					"content": "À, chú ơi, ban nãy hình như chú có nói muốn tìm một công việc đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160453,
					"content": "Nếu được thì chú có thể đi cùng chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160454,
					"content": "Hay quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160455,
					"content": "Nhưng mà, ông ta là samurai của Shogunate mà, dẫn theo ông ta đi sẽ gặp phiền phức đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160456,
					"content": "...Đúng vậy, thân phận của tại hạ đặc biệt, cho nên nếu đồng hành với các vị thì chỉ gây thêm phiền phức mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160457,
					"content": "Ha ha, cái này không thành vấn đề, thực ra chúng tôi cũng chỉ là đi xung quanh đây tìm nguyên liệu nấu ăn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160458,
					"content": "Với thân phận của chú, làm những việc không liên quan đến Shogunate và samurai là thích hợp nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160459,
					"content": "Nếu như chú định làm bảo vệ hay là vệ sĩ thì mới gây sự chú ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160460,
					"content": "Vả lại, người tốt như chú mà lại luôn phải đói bụng thì tôi cảm thấy thật không cam tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160461,
					"content": "Thân là đầu bếp, tôi sẽ không làm ngơ, tuy rằng không thể giúp được gì nhiều, nhưng ít ra có thể đảm bảo được bữa ăn cho chú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160462,
					"content": "Các hạ, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160463,
					"content": "Chú thấy thế nào, đồng hành với chúng tôi chứ? Tiền công có thể không cao, nhưng mà bữa ăn thì sẽ luôn có đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160464,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160465,
					"content": "Tại hạ, tuân lệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160466,
					"content": "Hay quá hay quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160467,
					"content": "Hừ, cũng xem như là một cái kết đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160468,
					"content": "Tốt quá! Mọi người vất vả lâu như vậy chắc cũng đói bụng rồi, tuy là ở đây không tiện nấu ăn cho lắm...Nhưng tôi sẽ nghĩ cách để làm món gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160469,
					"content": "Nhà lữ hành, bạn cũng mệt rồi, ngồi nghỉ ở đây đợi cơm ăn đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160470,
					"content": "Bắt đầu công việc thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160471,
					"content": "Xong rồi...Ha ha, món \"Cơm Nắm\" này tuy làm hơi gấp...nhưng mà cũng đủ để no bụng, mọi người dùng thoải mái nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160472,
					"content": "Đúng rồi, nhà lữ hành, cảm ơn bạn đã luôn giúp tôi. Đây là công thức của chú Munehisa cho tôi, tôi viết ra riêng một bản cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160473,
					"content": "Chú ấy nói đây là công thức mà chú ấy ghi lại được khi còn làm việc cho Shogunate, nghe nói đặc sắc lắm. Nếu có hứng thú thì bạn cũng thử làm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160474,
					"content": "Được rồi, không nói thêm nữa, dùng cơm thôi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160449,
					"content": "Sau này phải nhớ ăn sáng trước nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160440,
					"content": "Bọn chúng nhạy cảm quá rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160441
					]
				},
				{
					"id": 220160441,
					"content": "Ở trong tình cảnh của chúng, nhạy cảm cũng là chuyện bình thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160442
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160442,
					"content": "Nhưng theo tôi đoán, thực ra bọn chúng chỉ muốn vịn vào lý do này để hạ sát tên \"khó bảo\" như tôi, như vậy sẽ có thể thị uy với mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160443
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160443,
					"content": "Dẫu sao thì tôi cũng năm lần bảy lượt từ chối chúng, điều này cũng khiến chúng khá mất mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160425,
					"content": "Không lẽ, đám Kairagi đó đều là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160426
					]
				},
				{
					"id": 220160426,
					"content": "Cũng không hoàn toàn là vậy. Nhưng chung quy thì đều là một lũ khốn chĩa kiếm vào kẻ yếu mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160427,
					"content": "Còn chú sao lại rời khỏi Shogunate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160428
					]
				},
				{
					"id": 220160428,
					"content": "Chỉ là...không tán thành cách làm hiện giờ của Shogunate lên Inazuma mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160429
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160429,
					"content": "Tôi chỉ là một võ phu, cũng không biết rằng liệu cuối cùng phương pháp này có mang lại lợi ích cho quốc gia không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160430
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160430,
					"content": "Tôi chỉ biết rằng tư tưởng này đi ngược lại với tư tưởng của tôi. Cho nên tôi đã chọn cách rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160431
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160431,
					"content": "Ha ha, có thể tôi đã quá cố chấp, không biết thời thế...Thật mất mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
