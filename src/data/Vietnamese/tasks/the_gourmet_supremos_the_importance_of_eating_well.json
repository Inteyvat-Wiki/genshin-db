			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "Parvaneh...còn có nhà lữ hành nữa??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160202,
					"content": "Tôi đến để giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "Thật sao, cảm ơn nhé, Julie có vẻ như đã đi vào sâu bên trong kia rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160204,
					"content": "Trong đó có nhiều ma vật, chỉ với hai chúng tôi thì e rằng rất khó đối phó, nếu như có bạn giúp đỡ thì tốt biết mấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160210,
					"content": "Vậy chúng ta xuất phát nhé, Julie chắc đang ở trong rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160205,
					"content": "Bạn mời tôi một bữa no say là được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "Không thành vấn đề, nhưng nếu chỉ với một mình tôi thì e rằng không làm nổi một bữa no say mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160207,
					"content": "Nhà lữ hành, bạn giúp tôi trước nhé, giúp chúng tôi tìm lại Julie về được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160208,
					"content": "Julie chắc đã chạy vào sâu bên trong rồi, trong đó nhiều ma vật, chỉ với sức của hai chúng tôi e rằng đối phó không nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160209,
					"content": "Sau khi tìm được Julie, tôi sẽ chiêu đãi bạn một bữa no say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
