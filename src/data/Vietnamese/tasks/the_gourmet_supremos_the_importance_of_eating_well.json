			"dialogs": [
				{
					"id": 220160601,
					"content": "Hì hì, vẫn rất ngon mà, tôi còn muốn ăn thêm nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160602,
					"content": "Sao bạn lại đưa thức ăn cho ông ấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "Ừm...tôi chỉ không muốn thấy chú ấy đói bụng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160604,
					"content": "Vả lại, lần trước khi gặp chú ấy, chú ấy có vẻ rất buồn, tôi thấy không chừng là do chú ấy đang rất đói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160605,
					"content": "Cho nên tôi đã đưa đồ ăn cho chú ấy, chỉ cần ăn no thì có thể chú ấy sẽ không còn buồn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160606,
					"content": "Sao bạn lại tin tưởng chú ấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "Đó là...trực giác của nhà mạo hiểm thôi. Tôi có thể phân biệt người tốt với kẻ xấu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160608,
					"content": "Chỉ có người tốt mới nhường thức ăn cho người khác khi đói bụng thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160609,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "Tạm biệt, sau này tôi nhất định sẽ nhớ ăn sáng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
