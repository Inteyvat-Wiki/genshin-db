			"dialogs": [
				{
					"id": 220160501,
					"content": "Ợ...ăn xong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160502,
						220160513
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160502,
					"content": "Sao bạn lại giúp ông ấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160503
					]
				},
				{
					"id": 220160503,
					"content": "Bạn nói chú Munehisa sao? Đương nhiên là xuất phát từ đạo đức của một đầu bếp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160504
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160504,
					"content": "Nói đùa thôi. Nhưng tôi thực sự không đành lòng nhìn chú ấy bị đói bụng mãi như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160505
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160505,
					"content": "Hoặc có thể nói là...tôi không muốn thấy ai phải đói bụng cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160506
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160506,
					"content": "Đói bụng là một chuyện rất đáng sợ, tôi...đã phải chịu đựng cảm giác này qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160507
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160507,
					"content": "Khi đói bụng đến cực độ...con người sẽ làm ra những chuyện rất đáng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160508
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160508,
					"content": "Tôi nghĩ, nếu như trên thế gian này ai ai cũng được ăn no, thì có thể sẽ bớt đi được rất nhiều kẻ xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160509
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160509,
					"content": "Tuy một mình tôi không thể làm được chuyện này, nhưng ít ra tôi có thể làm đầu bếp, để cố gắng khiến những người bên cạnh tôi có thể ăn no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160510
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160510,
					"content": "Ha ha, nói thẳng ra thì tôi chỉ muốn mọi người có thể ăn no thôi, lý tưởng của tôi có vẻ nhỏ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160511
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160511,
					"content": "Đây là một lý tưởng rất vĩ đại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160512
					]
				},
				{
					"id": 220160512,
					"content": "Ha ha, cảm ơn nhé. Bạn cũng ăn thêm đi, ăn dư là một tội lớn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160513,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160514
					]
				},
				{
					"id": 220160514,
					"content": "Bạn phải đi rồi sao? Không ăn thêm nữa à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
