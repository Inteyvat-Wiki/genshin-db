			},
			"dialogs": [
				{
					"id": 220160801,
					"content": "Các hạ, cho hỏi có chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160802,
					"content": "Sao chú lại chịu đồng hành với Xudong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "Như Xudong đã nói, trước mắt...nếu như tôi muốn ăn no thì làm việc cho anh ta là thích hợp nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160804,
					"content": "Với lại, tôi cảm thấy Julie và Xudong đều là những người rất cao thượng, đồng hành cùng với họ cũng là một vinh dự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160805,
					"content": "Còn Parvaneh...thì vẫn rất cẩn trọng, thực ra đây cũng là một chuyện rất bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160806,
					"content": "Hơn nữa cô ấy chỉ là đề phòng tôi, không phải bài xích tôi, thế là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160807,
					"content": "Chú đó giờ luôn lang thang bên ngoài sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "Tôi không nói dối, sau khi rời khỏi Shogunate, tôi luôn lang thang bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160809,
					"content": "Thông thường mà nói, tôi chỉ có thể lượm trái cây mà ăn, bữa nào may mắn thì có thể săn được chút thịt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160810,
					"content": "Tôi đôi khi cũng hay đánh đuổi ma vật hoặc Kairagi cho một số người, và nhận thù lao từ chỗ họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160811,
					"content": "Ha ha, đối với người chỉ biết vung kiếm như tôi mà nói, cơ hội để có được công việc thực sự không nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160812,
					"content": "Không nói đến chuyện \"rời khỏi Shogunate\", mọi người vẫn luôn đánh đồng tôi với Kairagi, vì vậy...tôi luôn bị xa lánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160813,
					"content": "Tôi không có nhà ở Inazuma, cũng không có người thân để nương tựa, ngoài việc lang thang bên ngoài thì còn có chỗ nào để đi chứ.",
