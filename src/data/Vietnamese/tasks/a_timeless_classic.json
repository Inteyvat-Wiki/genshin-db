			},
			"dialogs": [
				{
					"id": 706590101,
					"content": "Xin chào, có muốn thử \"Cơn Gió Lạc Lối\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590102
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590102,
					"content": "\"Cơn Gió Lạc Lối\" là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590103
					]
				},
				{
					"id": 706590103,
					"content": "À há, hỏi hay lắm, \"Cơn Gió Lạc Lối\" là một trò chơi mang tính lịch sử của Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590104,
					"content": "Chắc bạn cũng biết ở Thành Mondstadt xưa kia có một nhóm \"Quý Tộc\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590105
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590105,
					"content": "Bọn họ ở Thành Mondstadt ngang ngược hung bạo, khiến cho không ít người khổ đến mức không thể nào diễn tả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590106,
					"content": "Để chống lại những thủ đoạn tàn bạo của các quý tộc, có một nhóm người Mondstadt dũng cảm đã cùng xây dựng một tổ chức kháng chiến bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590107
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590107,
					"content": "Nhóm hiệp sĩ này liên tục triển khai hành động ở khắp nơi trong thành Mondstadt, để bọn quý tộc nếm mùi đau khổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590108
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590108,
					"content": "Nhưng những quý tộc đó cũng nhanh chóng huấn luyện một bọn tay sai chuyên đi trấn áp hiệp sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590109,
					"content": "Thế là, các hiệp sĩ và bọn tay sai của quý tộc liên tục triển khai hết trận chiến này đến trận chiến khác ở khắp Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590110,
					"content": "\"Cơn Gió Lạc Lối\" chính là lấy đề tài từ sự kiện lịch sử chân thực như sử thi này! Đã từng được mọi người yêu thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590111,
					"content": "Đã từng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590112
					]
				},
				{
					"id": 706590112,
					"content": "Phải, bây giờ những thanh niên trong thành đã không còn hứng thú với \"Cơn Gió Lạc Lối\" nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590113,
					"content": "Nhưng tôi không muốn \"Cơn Gió Lạc Lối\" thất truyền như vậy, cho nên đã điều chỉnh lại quy tắc ban đầu của nó cho dễ hiểu hơn, thú vị hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590114
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590114,
					"content": "Ngoài ra, tôi còn thêm vào tận mấy bản đồ mới. Có lẽ lần này sẽ có nhiều người đến chơi hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
