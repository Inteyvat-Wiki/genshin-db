					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590302,
					"content": "Tham gia \"Cơn Gió Lạc Lối\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "Rời khỏi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "Được rồi, nếu có hứng thú chơi thử \"Cơn Gió Lạc Lối\" thì hãy đến tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
