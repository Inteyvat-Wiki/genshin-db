						],
						"stepId": 7333007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Markozov",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "Này, loài người có ý đồ xấu xa kia, khuyên các ngươi nên rời khỏi nơi đây ngay. Sự kế thừa và bí mật của Pari không phải là thứ các ngươi có thể dễ dàng chạm tới đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300702,
					"content": "Pari? Pari! Thật là một trải nghiệm mới mẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300703,
					"content": "#À! Còn có cả {M#chàng trai lanh lợi}{F#cô gái nhỏ bé} cùng... thú cưng ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300704,
					"content": "#Này! Bất lịch sự quá rồi đấy! Tôi là bạn tốt nhất của {NICKNAME} đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300705,
					"content": "Bạn... Đúng, đúng rồi! Bạn tốt nhất, một từ đẹp đẽ biết bao! Từ nhỏ ta đã luôn mong chờ có được \"người bạn tốt nhất\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300706,
					"content": "#{M#Chàng trai lanh lợi}{F#Cô gái nhỏ bé}, chắc {M#cậu}{F#cô} không cần đến hai \"người bạn tốt nhất\" đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300707,
					"content": "Ý gì đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "#Ý của ta là... quá xa xỉ rồi! Dù là với {M#cậu}{F#cô} đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300711,
					"content": "#Ta không thể nào chấp nhận sự bất công như vậy... Nên mời {M#cậu}{F#cô} giao Pari cho ta. Về việc đối xử như thế nào với Pari thì {M#cậu}{F#cô} cứ yên tâm, ta sẽ tận dụng tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300712,
					"content": "Tên vô lễ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300713,
					"content": "Vậy thì vô lý quá rồi đó, đúng là chẳng nói nổi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300714,
					"content": "Trên đời có một cách còn dễ dàng hơn là dùng ngôn từ... Yasnapati thông minh của ta, chắc đã hiểu ý của ta rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300715,
					"content": "Tôi đoán ý của Sorush là cho hắn ta một bài học đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300716,
					"content": "Hừ, không cần Bóng Trắng Bay Bay nhiều lời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300708,
					"content": "Tôi không ngại có nhiều bạn đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "Vậy không được! Không được đâu, bạn \"tốt nhất\" chỉ có thể là Paimon thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
