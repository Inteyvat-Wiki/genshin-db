						761700303
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700303,
					"content": "Để chị Linnea kể hết chuyện trước nào, hai chị em đó cuối cùng chắc chắn đã làm hòa rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700304
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700304,
					"content": "Nếu không thì sao người ta lại dùng Hoa Ảnh Đêm với hai bông hoa dính liền vào nhau để nói về hai chị em đó chứ, đúng không? Hy vọng cuối cùng hai người họ đã làm hòa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maisie"
