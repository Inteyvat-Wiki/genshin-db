			"dialogs": [
				{
					"id": 761700101,
					"content": "Không ngờ không chỉ Đom Đóm Ánh Trăng, mà ngay cả mèo con cũng bị ăn mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700102
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700102,
					"content": "Hu... Anh Jurva, lần sau dắt Pavlov đi dạo nhớ phải bảo vệ nó thật tốt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700174
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700174,
					"content": "Đừng lo, Pavlov lớn hơn mèo bình thường nhiều, hơn nữa cũng chỉ là một loài thực vật mà thôi, sẽ không sao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700103
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761700103,
					"content": "Nhớ là có nhà mạo hiểm mới vào nghề nào đó cũng nói câu tương tự trước khi gặp Hexadecatonic Mandragora đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700104,
					"content": "Ơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700105
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761700105,
					"content": "Hexadecatonic Mandragora... Ngầu quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700106
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700106,
					"content": "Ya-ho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700107
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761700107,
					"content": "Từ xa đã thấy bên này náo nhiệt rồi! Mọi người đang nói chuyện gì vui vậy... Hả? Đang trong giờ học à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700108,
					"content": "Ừm, chị Linnea đang kể cho chúng em nghe về những phát hiện điều tra gần đây của chị ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700109,
					"content": "Nghe có vẻ thú vị đấy, chúng tôi cũng tham gia được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700110
					]
				},
				{
					"id": 761700110,
					"content": "Đương nhiên là được rồi, ngồi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700111,
					"content": "Đã nói đến Hexadecatonic Mandragora thì ở Trạm Gác Biển Hư Không còn có một loại thực vật đặc trưng khác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700112,
					"content": "Là Cỏ Đông Lăng phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700113
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761700113,
					"content": "Ừm! Đúng rồi, chính là Cỏ Đông Lăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700114
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700114,
					"content": "Ơ... Anh Jurva gian lận rồi! Chị Linnea còn chưa hỏi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700115
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700115,
					"content": "À, xin lỗi nhé, không kìm được nên giành trả lời mất rồi. Đừng vội, phía sau vẫn còn cơ hội trả lời mà, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700116
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761700116,
					"content": "Nhiều câu hỏi lắm, ai cũng có phần cả! Chỉ cần trả lời tích cực là có cơ hội nhận được phần thưởng điêu khắc đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700117,
					"content": "#Hóa ra còn có phần thưởng nữa! {NICKNAME}, vậy thì chúng ta cũng phải cố gắng thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700118,
						761700119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700118,
					"content": "Dù đối thủ là trẻ con tôi cũng sẽ không nương tay đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700122
					]
				},
				{
					"id": 761700122,
					"content": "Quay lại chủ đề chính, về Cỏ Đông Lăng, thực ra có một câu chuyện rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700123,
					"content": "Truyền thuyết kể rằng, Cỏ Đông Lăng có liên quan đến Vua Đông Lăng, mà vị Vua Đông Lăng này có một người anh em, loại thực vật tượng trưng cho người này là thứ mà mọi người đều rất quen thuộc... Đó là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700124,
						761700127,
						761700130
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700124,
					"content": "...Hoa Ngọt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700125
					]
				},
				{
					"id": 761700125,
					"content": "Nói là quen thì đúng là rất quen! Nhưng chắc không phải là đáp án đúng đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700126,
					"content": "Trả lời sai rồi! Đáp án đúng là Quả Sồi Hè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700132,
					"content": "Quả Sồi Hè! Em chỉ biết là Bánh Torte Sồi Hè của cô Katya và Aino làm đều rất ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700133
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700133,
					"content": "Quả Sồi Hè chính là biểu tượng của Vua Sồi Hè, anh em với Vua Đông Lăng, truyền thuyết kể rằng cặp anh em song sinh này đã tranh đấu không ngừng ngay từ khi sinh ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700134
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700134,
					"content": "Họ luân phiên hạ gục đối phương, rồi lại luân phiên hồi sinh, cai trị mùa thuộc về riêng mình, cứ thế tuần hoàn không ngừng cho đến khi thế giới chấm dứt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700135
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700135,
					"content": "Đáng thương quá... Rõ ràng là anh em ruột thịt mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700136
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700136,
					"content": "Cái này thì em biết, cô Katya có nói qua, quan hệ tốt hay không chẳng liên quan gì đến việc có cùng huyết thống hay không, mà đôi khi chính vì có quan hệ huyết thống mới dẫn đến tranh đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700137
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700137,
					"content": "Câu chuyện này thực ra nói về sự thay đổi của các mùa phải không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700138
					]
				},
				{
					"id": 761700138,
					"content": "#{F#Cô}{M#Cậu} thật nhạy bén! Đúng vậy, các học giả Snezhnaya cũng nghĩ như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700139
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700139,
					"content": "Tuy nhiên, vì đặc tính chịu lạnh của Cỏ Đông Lăng, ngoài câu chuyện này ra, nó còn thường được coi là biểu tượng của Người Giữ Đèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700140
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700140,
					"content": "\"Cho dù hoa tàn...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700141
					]
				},
				{
					"id": 761700141,
					"content": "\"Lá cũng sẽ giữ đúng lời hứa!\" Tôi có nghe qua câu ngạn ngữ về Cỏ Đông Lăng này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700142,
					"content": "Đây là một câu ngạn ngữ rất cổ xưa, giờ hiếm ai nhắc đến nữa, không ngờ hai người cũng biết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700143
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700143,
					"content": "Hì hì, chúng tôi là những nhà mạo hiểm giàu kinh nghiệm, người ta hay gọi là... \"hiểu sâu biết rộng\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700144,
					"content": "Người Giữ Đèn là những người mặc đồ đen đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700145
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700145,
					"content": "Họ cũng chịu lạnh giỏi à? Nhưng nhìn quần áo của họ ấm áp thế kia, không phải mặc càng ít mới càng chứng tỏ được khả năng chịu lạnh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700146
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700146,
					"content": "Không phải đâu, ý chị Linnea là Người Giữ Đèn giống như Cỏ Đông Lăng, đối mặt với khó khăn như gió lạnh mà vẫn không khuất phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700147
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700147,
					"content": "Ồ! Đúng vậy đấy, nhưng sao Maisie lại nghĩ ra được điều này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700148
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700148,
					"content": "Hì hì, vì trước đây em đã nhận được sách ảnh của Helka gửi về từ Fontaine, trong đó nói rằng hoa ở Fontaine đều có ý nghĩa riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700149
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700149,
					"content": "Em nghĩ, nếu Cỏ Đông Lăng cũng có ngôn ngữ hoa thì \"bất khuất\" và \"dũng khí kiên trì đến cùng\" sẽ rất phù hợp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700150
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700150,
					"content": "Maisie đã biết suy luận và áp dụng linh hoạt rồi, giỏi quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700151
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700151,
					"content": "Còn cách nghĩ của Mikko tuy hơi khác so với nhận định thông thường, nhưng cũng rất thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700152
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700152,
					"content": "Cô giáo ơi, vậy còn tôi và Paimon thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700153
					]
				},
				{
					"id": 761700153,
					"content": "Ừm, nếu hai người có thể trả lời được câu hỏi khó tiếp theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700154
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700154,
					"content": "#Dù là câu hỏi khó gì thì cứ hỏi thoải mái đi, chắc chắn không thể làm khó được {NICKNAME} đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700155,
					"content": "Tự tin thế à, vậy tôi sẽ đưa ra câu hỏi khó nhất nhé: Tại sao hoa của Hoa Ảnh Đêm lại có một đỏ một xanh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700156,
						761700158
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700156,
					"content": "Vì \"hoa hồng màu đỏ, hoa tím ánh xanh\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700157
					]
				},
				{
					"id": 761700157,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700160,
					"content": "Ừm... Rốt cuộc thì tại sao nhỉ? Không chỉ Hoa Ảnh Đêm, chúng ta còn thấy nhiều thứ màu đỏ và xanh khác ở Nod-Krai nữa phải không? Ôi, nghĩ kỹ lại thì cũng khá nhiều đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700161,
					"content": "Nếu nói Nod-Krai khác gì so với những nơi khác thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700162,
					"content": "Thì ra là Kuuvahki thần kỳ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700163
					]
				},
				{
					"id": 761700163,
					"content": "Mà này, đừng cứ lấy Kuuvahki ra để giải thích mọi thứ. Đã là câu hỏi khó nhất thì chắc chắn phải có lý do phức tạp hơn chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700164,
					"content": "Trả lời chính xác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700165
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700165,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700166
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761700166,
					"content": "Hửm, thì ra là vậy thật à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700167,
					"content": "Đối với những người sống ở Nod-Krai thì đây là kiến thức thông thường, nhưng với các nhà mạo hiểm đến từ phương xa thì không phải vậy, nên cũng có thể coi đây là câu hỏi khó nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700168
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700168,
					"content": "#Nhưng {NICKNAME} hoàn toàn không bị bề ngoài của câu hỏi đánh lừa, thực sự rất thích hợp để trở thành nhà mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700169
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700169,
					"content": "Được rồi, hôm nay đến đây thôi nhé. Những người vừa rồi có trả lời câu hỏi đều nhận được điêu khắc đường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700170
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700170,
					"content": "Hả? Khoan đã, chẳng lẽ chỉ có tôi là không có điêu khắc đường sao! Sớm biết vậy cho dù trả lời sai cũng nên thử nhiều hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700171
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700171,
					"content": "#Không sao đâu, Paimon cũng có phần! Paimon và {NICKNAME} là một đội mà, giống như tôi với Lumi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700172
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700172,
					"content": "Thật tuyệt vời nhỉ, bạn học Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700173
					]
				},
				{
					"id": 761700173,
					"content": "Wow, cô giáo Linnea tốt nhất luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700158,
					"content": "Chẳng lẽ là giống được nuôi trồng nhân tạo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700159
					]
				},
				{
					"id": 761700159,
					"content": "Một góc nhìn hay đấy! Nhưng tiếc quá, đó không phải đáp án chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700160
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700127,
					"content": "Chắc chắn là Bạc Hà rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700128
					]
				},
				{
					"id": 761700128,
					"content": "Dù sao Bạc Hà và Cỏ Đông Lăng đều có màu xanh... Vậy thì Bắp Cải Cuộn cũng có thể là họ hàng của Cỏ Đông Lăng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700129,
					"content": "Trả lời sai rồi! Đáp án đúng là Quả Sồi Hè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700130,
					"content": "Chẳng lẽ là Quả Sồi Hè.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700131
					]
				},
				{
					"id": 761700131,
					"content": "Trả lời đúng rồi! Chính là Quả Sồi Hè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700119,
					"content": "Tranh kẹo với lũ trẻ à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700120
					]
				},
				{
					"id": 761700120,
					"content": "Không sao đâu, thầm tiết lộ với các vị, Katya đã chuẩn bị điêu khắc đường cho mỗi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700121,
					"content": "Ồ! Nếu vậy thì chúng ta phải thể hiện bản lĩnh thật thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700122
					],
					"speakerTitle": "Paimon"
				}
			]
		},
