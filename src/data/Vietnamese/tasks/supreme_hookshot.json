				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "Ồ, nhìn dáng vẻ của bạn... Là Nhà Lữ Hành đúng không? Không ngờ lại đi dạo ở chỗ này, rảnh rỗi thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310102,
					"content": "Hay là, bạn cũng là khách câu cá đã để mắt đến vùng nước này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310103,
					"content": "Có mắt nhìn đấy! Đây là nơi câu cá tốt nhất quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310104,
					"content": "Nhưng quanh đây làm gì có ai câu cá? Sao anh chắc chắn như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310105,
					"content": "Tất nhiên là vì tôi có cách nhìn độc đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310106,
					"content": "Thân là thợ câu cá lợi hại nhất vùng này, tất nhiên chọn nơi câu cá cũng cần phải chú ý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310107,
					"content": "Thật... thật vậy ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "Hình như anh không thu hoạch được gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310109,
					"content": "Đã nói đến nước này, để tôi cho các người thấy cái gì gọi là \"Tuyệt Cảnh Trên Lưỡi Câu\" nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310110,
					"content": "Tuyệt cảnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "Từ chỗ nguyên liệu đặc biệt bạn đã đưa, tôi sẽ chế ra mồi câu đặc biệt, câu được con \"cá\" mà bạn chưa từng gặp bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310113,
					"content": "Sao tôi thấy khả nghi thế nhỉ? Mồi câu thủ công thì có đáng tin không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310114,
					"content": "Thử chút cũng không sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "Được, tôi thích giao tiếp với người như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310116,
					"content": "Mồi câu do tôi làm ngoài Quả Nhật Lạc và Tiểu Mạch ra, thì còn cần một nguyên liệu đặc biệt khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310111,
					"content": "Trên lưỡi câu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
