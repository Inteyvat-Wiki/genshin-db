				},
				{
					"id": 230310613,
					"content": "Quả nhiên vẫn như thế, không bất ngờ chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310614,
					"content": "E hèm, người ngoại quốc, thả lỏng chút đi, đừng so đo về mặt tiểu tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310615,
					"content": "Bất cứ thứ gì được lưỡi câu kéo lên đều có thể xem là \"cá\" bị câu lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310616,
					"content": "Không giấu gì bạn, thợ câu cá giỏi nhất tôi đây cũng không phải hạng tự phong đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310617,
					"content": "Dù sao mỗi khi câu được thứ không cắn câu, không phải là vật sống thì cũng xem như một dạng bản lĩnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310618,
					"content": "Những thợ câu cá khác cũng khen tôi, rằng tôi có tài năng độc nhất vô nhị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310619,
					"content": "Có thể bọn họ đang an ủi anh thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "Nói đơn giản là anh có thể câu được mọi thứ trừ cá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310622,
					"content": "Khụ! Bọn họ nghĩ gì cũng không quan trọng! Ít, ít nhất thì tôi cũng không uổng công khi câu cá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310623,
					"content": "Hôm nay không được thì mai lại tới, rồi sẽ có một ngày tôi nhất định sẽ câu được cá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310624,
					"content": "Cảm ơn các bạn đã tìm nguyên liệu giúp tôi, những phần thưởng này là của bạn, tôi muốn đi chỗ khác để tiếp tục câu cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310625,
					"content": "Lần sau... lần sau tôi nhất định có thể câu được một con cá lớn! Nhất định!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310620,
					"content": "Có thể bọn họ đang cười nhạo anh đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "Paimon chân không chạm đất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				}
			]
		},
