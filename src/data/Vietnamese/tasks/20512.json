			"dialogs": [
				{
					"id": 205120101,
					"content": "Đơn thuốc càng lúc càng kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120102,
					"content": "Anna thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "Là bạn sao, ừm, tuy nói ra có thể bạn không tin, nhưng Anna nói thật sự cảm thấy đỡ hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120104,
					"content": "Lẽ nào đơn thuốc của vị thần y đó thật sự phát huy tác dụng rồi sao? Bản thân tôi cũng không tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120105,
					"content": "Nhưng dù thật hay không, cứ uống thuốc trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120106,
					"content": "Đơn thuốc lần này là... Để tôi xem, bạn có thể giúp tôi tìm dịch cô đặc của Slime Thủy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120107,
					"content": "Lần này xem ra là bình thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "...Ơ, bình thường sao? Tôi lại cảm thấy lần này không hề bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120109,
					"content": "Nhưng mà lần này cũng dễ tìm, tôi cũng hỏi qua rồi, chỉ cần tiêu diệt Slime Lớn là lấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120110,
					"content": "Tôi còn nghe Jack nói, nếu muốn dụ được Slime Lớn ra, thì phải không ngừng tiêu diệt Slime Nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120111,
					"content": "Tôi không có khả năng đó, vậy nên nhờ cả vào bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120112,
					"content": "Có lẽ được, yên tâm đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "Sao bạn biết, lẽ nào bạn từng thử rồi sao? Ơ, sao đột nhiên bạn lại không nói gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120114,
					"content": "Thôi không nói nữa, có lẽ Slime Thủy rất dễ tìm. Dịch cô đặc tôi hỏi rồi, chỉ cần diệt Slime Thủy Lớn là lấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120115,
					"content": "Tôi còn nghe Jack nói, nếu muốn dụ được Slime Lớn ra, thì phải không ngừng tiêu diệt Slime Nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120116,
					"content": "Tôi không có khả năng đó, vậy nên nhờ cả vào bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120117,
					"content": "Được rồi, tôi biết ở đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "Ồ... được đó, xem ra bạn biết rất rõ cách đối phó với Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120119,
					"content": "Vậy thì phiền bạn rồi. Chỉ cần diệt được Slime lớn sẽ lấy được dịch cô đặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120120,
					"content": "Tôi còn nghe Jack nói, nếu muốn dụ được Slime Lớn ra, thì phải không ngừng tiêu diệt Slime Nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120121,
					"content": "Vậy thì mọi việc nhờ vào bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
