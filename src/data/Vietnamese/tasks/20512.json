				},
				{
					"id": 205120302,
					"content": "Tìm được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120303
					]
				},
				{
					"id": 205120303,
					"content": "À... Xem ra thật sự... rất đậm đặc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120304,
					"content": "Thứ này thật sự có thể dùng làm thuốc sao, làm xong tôi phải thử mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120305,
					"content": "Nếu tôi có xảy ra chuyện gì, nhờ giao Anna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120306,
					"content": "...cho tu nữ Grace chăm sóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120307,
					"content": "Nói với bà ấy, tôi đi làm ở một nơi rất xa, nhờ bạn đấy, đây là nguyện vọng cuối cùng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120308
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120308,
					"content": "Không sao đâu, bạn đừng tự hù dọa mình...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120309
					]
				},
				{
					"id": 205120309,
					"content": "Vì loại thuốc này trông rất đáng sợ! Tóm lại, bạn nhận trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120310
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120310,
					"content": "Nhất định phải nhớ lời tôi nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
