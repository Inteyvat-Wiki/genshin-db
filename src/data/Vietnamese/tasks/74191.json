			"dialogs": [
				{
					"id": 741910201,
					"content": "Bệ hạ, bệ hạ, người vẫn ổn chứ? Chẳng lẽ lại nằm mơ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910202
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910202,
					"content": "Ồn ào quá, đã xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910203
					]
				},
				{
					"id": 741910203,
					"content": "Dân chúng đang tụ tập ngoài đại sảnh, dường như có việc muốn hỏi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910204
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910204,
					"content": "Vì gần đây giai điệu của Phobos nhiều lần bị gián đoạn, mọi người đều có nhiều thắc mắc về việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910205
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910205,
					"content": "Đây là điều buộc phải làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910206
					]
				},
				{
					"id": 741910206,
					"content": "Đương nhiên tôi tin vào phán đoán của người, tôi cũng có nghe kể về chuyện xảy ra gần đây... Là Phobos đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910207
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910207,
					"content": "Để hướng đến hạnh phúc chung của loài người, Phobos đã vạch sẵn đường cho mỗi người. Dựa vào khả năng tính toán dường như vô hạn của Sybilla, chắc phải không có vấn đề mới đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910208
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910208,
					"content": "Nhưng ta lại nghe thấy có tiếng khóc than trong tiếng nhạc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910209
					]
				},
				{
					"id": 741910209,
					"content": "Chẳng lẽ có người đã lén sửa nhạc phổ của Phobos sao? Không, ngoại trừ người chỉnh âm như người và tôi ra thì chắc không ai có thể làm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910210
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910210,
					"content": "Lẽ nào vị tiên tri đó đã che giấu gì đó với chúng ta sao? Không thể nào, vị tiên tri đó đã hy sinh cả mạng sống của mình, lời tiên tri cũng đã được chủ nhân của nước kiểm chứng, tuyệt đối không mang ý đồ riêng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910211
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910211,
					"content": "Có lẽ cũng vì \"cô ấy\" không có ý đồ riêng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910212
					]
				},
				{
					"id": 741910212,
					"content": "Giờ đây tất cả mọi người đều dựa vào Phobos để thay họ phán đoán và quyết định, nếu như Phobos xảy ra vấn đề gì, e là dân chúng sẽ lâm vào khủng hoảng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910213,
						741910214
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910213,
					"content": "Hiện ta cần ngươi đến chỗ của những người tin tưởng mù quáng đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				},
				{
					"id": 741910215,
					"content": "Ý của người là tách giai điệu của tôi ra khỏi bản nhạc để đề phòng bất trắc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910216
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910216,
					"content": "Không, như vậy vẫn còn quá sớm. Tôi lo là linh hồn của mình vẫn chưa thể gánh vác vận mệnh vĩ đại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910217,
						741910218
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910217,
					"content": "Ta tin tưởng ở ngươi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910219,
					"content": "...Tôi đã hiểu, tôi cũng đã có sự giác ngộ. Nếu đây là nguyện vọng của người, tất nhiên tôi bằng lòng thực hiện thay người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910220,
						741910221
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910220,
					"content": "Ouranopolis, thành phố của tương lai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910222,
					"content": "Sau khi ████ rời đi, vượt qua hành lang màu vàng, tiếng tranh luận của mọi người ngày một gần hơn.\\nCho đến khi bước lên bục trung tâm đại điện, xung quanh mới yên tĩnh một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910223
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910223,
					"content": "Sebastos vĩ đại, xin người hãy chỉ dẫn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910224
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910224,
					"content": "Gần đây, vì không thể nghe thấy giai điệu của Phobos, nên dân chúng đều cảm thấy sợ hãi và bối rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910225
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910225,
					"content": "Rõ ràng kế hoạch vĩ đại vẫn đang tiến hành như thường. Man tộc ẩn nấp trong bóng tối cũng đã bị chúng ta tiêu diệt từng kẻ một, vùng nước ô uế cũng đã được chúng ta dùng Linh Lộ thanh tẩy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910226
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910226,
					"content": "Nhưng người lại muốn chấm dứt cuộc chiến cao quý này mà không có lý do, rốt cuộc là vì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910227
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910227,
					"content": "Ta đương nhiên có phán đoán của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910228
					]
				},
				{
					"id": 741910228,
					"content": "Sebastos vĩ đại, tôi không có ý thách thức quyền uy của người, nhưng tôi cho rằng người đã đủ nhân từ với lũ man tộc đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910229
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910229,
					"content": "Chúng ta mang đến trật tự vĩ đại, cánh cổng của Remuria luôn mở ra với những người sẵn sàng hòa nhập vào trật tự hoàng kim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910230
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910230,
					"content": "Nhưng lũ man tộc đó đã làm những gì? Bọn chúng phá hủy tháp cao, tàn sát nhạc sĩ của chúng ta. Với phẩm chất linh hồn đó, họ vốn không nên được cứu rỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910231
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910231,
					"content": "Chúng ta dùng máu tươi để thanh tẩy đất đai, còn trật tự và văn minh được sinh ra sau sự hủy diệt. Điều này có thể nói đã là ân điển vô thượng đối với chủng tộc ngu muội đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910232
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910232,
					"content": "Đây không phải thứ mà ta muốn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910233
					]
				},
				{
					"id": 741910233,
					"content": "Khi mặt trời chiếu rọi, vốn không nên có bóng tối, đây không phải là lý tưởng vĩ đại của người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910234
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910234,
					"content": "Tôi nghĩ đây cũng là nguyện vọng của tất cả người dân Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910235
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910235,
					"content": "Sebastos, xin hãy ra lệnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910221,
					"content": "Hãy tự xưng bằng cái tên mới này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910218,
					"content": "Nhưng từ bây giờ ngươi đã không còn là \"chúng ta\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910214,
					"content": "Vậy nên ta sẽ cho ngươi ý chí tự do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				}
			]
		}
	]
}