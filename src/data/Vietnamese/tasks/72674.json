					"content": "Lông vàng là chỉ tôi đúng không...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "Ê! Nói ai là lông trắng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740205,
					"content": "Ồ, hai người đó nghe hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740206,
					"content": "#Tôi là {NICKNAME}, còn đây là Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "Nhớ cho kỹ đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740208,
					"content": "Kacha kacha dưa tím.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740209,
					"content": "Hả, dưa tím? Với kacha kacha là gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740210,
					"content": "Dù sao thì cũng coi như nghe hiểu được lời của Kichiboushi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740211,
					"content": "Đúng là miễn cưỡng cũng nghe được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#{NICKNAME}, chúng ta đi cáo biệt Ioroi đi, dù sao thì cũng sắp dẫn Kichiboushi đi xa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740213,
					"content": "Ioroi! Mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740214,
					"content": "Yey!",
					"roleType": "TALK_ROLE_NPC",
