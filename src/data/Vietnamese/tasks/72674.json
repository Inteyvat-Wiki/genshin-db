			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "Mm! Sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740302,
					"content": "Mm! Gặp được lông trắng lông vàng rồi, vui lắm. Dưa tím bum bum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740303,
					"content": "Dưa tím bum bum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "Mm? Không ngờ ngươi học cũng nhanh đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740305,
					"content": "Bum bum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740306,
					"content": "Ủa mà dưa tím bum bum là ý gì vậy...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "Bum bum là bum bum, dưa tím là dưa tím.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740308,
					"content": "Xem ra các ngươi giao lưu cũng tốt nhỉ, kỹ thuật \"nấu nướng\" của ta vẫn đỉnh như ngày nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740309,
					"content": "...Vậy mà xem như không có vấn đề gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "Ừ! Vấn đề lớn lắm! Mình có nghe hiểu lời của Kichiboushi nói đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740312,
					"content": "Đúng thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740313,
					"content": "Truyền đạt kết quả giao lưu cho Ioroi nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "Ừm ừm, thì ra là vậy. Không cần lo lắng, là do các ngươi vẫn chưa thích ứng với mùi của Kichiboushi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740315,
					"content": "Cứ từ từ thích nghi nhé! Càng thích nghi với mùi của Kichiboushi thì sẽ càng nghe hiểu lời của Kichiboushi nói thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740316,
					"content": "\"Từ từ\" là đến khi nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740317,
					"content": "Để nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740318,
					"content": "Mm! Mà chỉ cần không vội vàng là được rồi, gấp gáp gì chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740319,
					"content": "Gấp gáp là không tốt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740320,
					"content": "Có vẻ như Ioroi cũng không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "Hứ! Ta là Đại Vương Bake-Danuki Ioroi sống rất lâu rất lâu rồi, có phải thứ câu nệ thời gian như loài người các ngươi đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740322,
					"content": "(Ừ thì phần lớn thời gian là bị phong ấn rồi mà.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740323,
					"content": "Nhưng mà tại sao Ioroi lại có thể nói chuyện với con người nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "Mm, thật vô lễ. Phải nói là tại sao loài người các ngươi lại nói chuyện được với ta mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740325,
					"content": "Ta sống lâu như vậy rồi, ít nhiều gì cũng có nói chuyện qua với con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740326,
					"content": "Ngày xưa ta hay tán dóc với Tengu, hồ ly, Oni, Youkai và con người. Câu chuyện của con người tuy luôn nói về con người, nhưng thực ra một nửa trong đó là lịch sử của Bake-Danuki giả dạng thành con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740327,
					"content": "Một nửa của một nửa còn lại là câu chuyện của con người, còn nửa kia là chuyện của Tengu, hồ ly, Oni và Youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740328,
					"content": "Nhưng mà, một nửa trong số đó cũng vẫn là câu chuyện của Bake-Danuki giả dạng thành chúng. Sau đó, trong tất cả câu chuyện của Bake-Danuki thì có một nửa là câu chuyện của Ioroi ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740329,
					"content": "Cho nên, ta mới là kẻ lợi hại nhất, nên nói chuyện được với tiểu bối các ngươi là chuyện đương nhiên mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740330,
					"content": "Tôi hiểu rồi, năm phần mười sáu đều là của ngươi hết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "Mm? \"Năm phần mười sáu\" là gì, có ăn được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740332,
					"content": "Nghe có vẻ ngon, muốn ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740333,
					"content": "#Ý của {NICKNAME} là Ioroi xuất hiện nhiều trong các câu chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740334,
					"content": "Ioroi. Lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740335,
					"content": "Hứ, còn phải nói. Ta lợi hại lắm đó, ngươi liệu mà học hỏi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740336,
					"content": "Ủa? Hình như tôi dần dần nghe hiểu được lời của Kichiboushi nói rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740337,
					"content": "Lông trắng thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740338,
					"content": "Woa, được Kichiboushi khen kìa, mà cảm giác cứ thấy lạ lạ sao sao ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740339,
					"content": "Vậy tốt rồi, đứa nhóc này ta trông cậy vào các ngươi nhé, dẫn đó ra ngoài tu luyện giùm ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740340,
					"content": "Khi ta còn là một con tanuki nhỏ, ta cũng đã từng đi qua 18 danh tích ở Inazuma, lại còn viếng thăm cả danh tích của bake-danuki \"Tsukumo\" nữa, cho nên mới có được thành quả như hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740341,
					"content": "Haiz! Thành quả là quậy quá bị phong ấn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740342,
					"content": "Mmhaha, tảng đá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740343,
					"content": "Mm?! Kichiboushi, đến ngươi cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740344,
					"content": "Quay lại vấn đề chính! Vậy chúng ta nên đi đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740345,
					"content": "Ban nãy Ioroi có nhắc đến kìa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "Ừm ừm! Vậy đi Long Tích Tuyết Sơn nhé!",
					"roleType": "TALK_ROLE_NPC",
