			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "Xin chào Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740102,
					"content": "Ối! Bị phát hiện rồi! Các ngươi... mùi vị này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740103,
					"content": "Thì ra là đám tiểu bối các ngươi. Không gặp lâu như vậy làm ta cũng không nhận ra mùi của các ngươi luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740104,
					"content": "Ioroi vẫn không có thay đổi gì nhỉ, vẫn sợ hãi khi thấy người, và vẫn bị nhốt trong tảng đá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740105,
					"content": "Mm?! Đám tiểu bối các ngươi nói thế là có ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740106,
					"content": "Hy vọng phong ấn này có thể sớm được giải trừ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "Chỉ là phong ấn của con người thôi mà! Chỉ cần ta cố gắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740109,
					"content": "Khụ khụ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740111,
					"content": "#Hừ. Nói gì thì nói, ngươi chăm sóc đám nhỏ cũng khá tốt đấy. Tụi nó thường nói có một {F#dì}{M#chú} lông vàng rất thơm hay chơi với chúng, chúng rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740112,
					"content": "#{F#Dì}{M#Chú} lông vàng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "Ta còn nghĩ con người đều là những kẻ xấu đáng sợ, dám phong ấn tanuki. Nhưng giờ xem ra vẫn còn một số người tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740116,
					"content": "Đa phần loài người đều là người tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#Đúng vậy, những người mà Paimon và {NICKNAME} gặp phải đa số là người tốt. Ioroi bị phong ấn không phải là do trộm mất chiếc lược của người khác sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740119,
					"content": "Hứ, giờ cây lược cũng đã đưa cho các ngươi rồi mà. Nếu như các ngươi gặp được cái tên học pháp thuật của Reizenbou đó thì kêu hắn thả ta ra coi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740120,
					"content": "Tất cả là tại con hồ ly thúi đó, làm ta bị nhốt ở đây lâu như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740121,
					"content": "(Ioroi khi than phiền trông như ông già thật.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740122,
					"content": "(Mà độ tuổi của Ioroi đúng là có hơi lớn.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "Tên tiểu bối, ngươi không bị hóa đá, nên có lẽ đã đi qua nhiều nơi rồi đúng không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740124,
					"content": "#Hì hì, tôi và {NICKNAME} đều là đến từ bên kia bờ biển đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740125,
					"content": "Kể một số chuyện tại Mondstadt và Liyue cho Ioroi nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "...Thì ra là ở ngoài kia vẫn còn có nhiều nơi như vậy, thật là không ngờ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740127,
					"content": "Từ đó tới giờ chỉ có những con tanuki nhỏ báo cáo với ta, cho nên ta hoàn toàn không biết thế giới bên ngoài ra sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740128,
					"content": "Trước kia khi còn ở trên Núi Yougou, ta thấy được phía bên kia của biển bắc, có một ngọn núi rất rất cao, có vẻ còn cao hơn cả Núi Yougou. Ta luôn muốn biết được xem đó là một nơi như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740129,
					"content": "Bên đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "Chiếu theo vị trí địa lý thì đó có lẽ là Long Tích Tuyết Sơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740132,
					"content": "Mm, núi tuyết sao... nghe thôi đã thấy lạnh rồi, không biết sao nó lại muốn đi tới một nơi như vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740134,
					"content": "Khụ khụ, ta cũng nói rồi, các ngươi là người tốt, cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740135,
					"content": "Có vẻ như sắp tới màn nhờ vả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740136,
					"content": "Mm! Ta nhận lệnh từ đại nhân Ogosho, nhậm chức Kẻ Canh Giữ của Rừng Chinju, nếu như không bị phong ấn trong tảng đá thì ta nhất định sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740137,
					"content": "Có chuyện gì cần giúp đỡ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "Tuy ta không thể hành động tự do, nhưng đám nhỏ thì không có vấn đề gì. Ta muốn phiền ngươi dẫn chúng ra ngoài kia \"tu luyện\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740144,
					"content": "Dẫn theo \"Kichiboushi\" đi nhé. Lần trước khi chơi với các ngươi, nó vẫn luôn hy vọng có thể gặp lại các ngươi lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740145,
					"content": "Đúng là có thể...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "Ừm, dù sao thì chúng tôi cũng không thể nói chuyện được với Kichiboushi, cho nên đi chung với nhau sẽ gặp không ít khó khăn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740148,
					"content": "Sao có thể chứ. Tộc Bake-Danuki ta đương nhiên là hiểu tiếng người rồi. Chỉ là tại các ngươi không hiểu tiếng Bake-Danuki thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740149,
					"content": "Sao! Có chuyện này thật sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740150,
					"content": "Nhưng để trở thành bạn đồng hành thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "Vẫn mong là có thể vừa đồng hành vừa nói chuyện với nhau vẫn hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#Như Paimon và {NICKNAME} vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740153,
					"content": "Mm, thật hết cách, trước đó có người dùng pháp thuật của Bake-Danuki để làm cơm cho các ngươi ăn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740154,
					"content": "Giờ cho dù ta đã trở thành như vậy, nhưng để làm món \"cơm\" nghe hiểu lời Kichiboushi thì vẫn không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740155,
					"content": "Tốt quá, nhưng phải ngon đấy nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740156,
					"content": "Cũng không ngon lắm đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "Hừ, đừng coi thường tài nghệ của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740158,
					"content": "Tuy rất khó hình dung ra được là Ioroi đã biến ra từ đâu...\\nNhưng nói chung vẫn cứ cùng Paimon ăn \"món trông có vẻ ngon\" từ trên bụng Ioroi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "Ngon quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740160,
					"content": "Đương nhiên rồi, ta là Ioroi, kẻ đã làm ra sashimi từ nắm bùn với lông tanuki để đánh lừa bốn tên Oni trong Ogata đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740161,
					"content": "Ioroi lợi hại quá! Nhưng mà, món mà chúng tôi vừa ăn là được biến ra từ thứ gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740162,
					"content": "Chuyện này tốt nhất đừng nên hỏi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740164,
					"content": "Thôi vậy, chúng ta đi nói chuyện thử với Kichiboushi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740146,
					"content": "Nhưng có một vấn đề...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#Ừm ừm, tôi hiểu ý của {NICKNAME}! Có kho báu gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740140,
					"content": "Kho báu? Vậy thì đương nhiên rồi, ta là thống lĩnh của Bake-Danuki, có kho báu gì ở Inazuma mà ta chưa thấy qua chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740141,
					"content": "Vậy thì, có gì cần giúp đỡ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "Đúng đúng, chúng tôi sẽ giúp đỡ nhiệt tình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740131,
					"content": "Chiếu theo vị trí địa lý thì đó có lẽ là Long Tích Tuyết Sơn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
