			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu...mimi tomo...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250202,
					"content": "Xin chào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika!! A... là mọi người à... làm em giật cả mình... xin đừng làm phiền em nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250204,
					"content": "Ể, không phải em gọi chúng tôi đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250212,
					"content": "Ơ? À à... là mọi người à! Cảm ơn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250205,
					"content": "Nhưng mà nội dung trong sổ tay có chính xác không? Có thể dùng để trao đổi hòa bình với Hilichurl không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250206,
					"content": "Chuyện nhỏ thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "Hihi, việc biên soạn từ điển của em lại có một bước tiến lớn! Lại có thêm luận cứ cho thấy loài người và Hilichurl có thể chung sống hòa bình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250209,
					"content": "Chỉ tiếc là không thể bắt chuyện được với Hilichurl kỳ lạ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250210,
					"content": "Theo tài liệu ngôn ngữ mà em thu thập được, có lẽ nó cũng rất muốn làm quen bạn mới trên mảnh đất lạ lẫm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250213,
					"content": "Thật tiếc khi không thể giao tiếp tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250214,
					"content": "A, tiện thể, đây là quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250215,
					"content": "Trước đây làm phiền mọi người hơi nhiều, thật ngại quá. Nếu có cơ hội, mong rằng chúng ta lại tiếp tục hợp tác với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250211,
					"content": "Cái gì, thì ra tên này biết nói chuyện đàng hoàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250207,
					"content": "Tôi vẫn thích cách của mình hơn.",
					"roleType": "TALK_ROLE_PLAYER",
