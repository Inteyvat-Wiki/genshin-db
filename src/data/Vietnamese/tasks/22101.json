			"dialogs": [
				{
					"id": 221010101,
					"content": "Thật là hết cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "Haiz, mở một nhà trọ ở đây không dễ gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010104,
					"content": "Không biết có phải tôi nghĩ nhiều không... Luôn cảm thấy đám quái vật quanh đây xuất hiện ngày càng nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010105,
					"content": "Tuy là không dám tiến đến gần nhà trọ, nhưng khách ra vào liên tục, Thiên Nham Quân cũng không phải lúc nào cũng đứng đây bảo vệ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010106,
					"content": "Nếu có thời gian, thì bạn đi quanh quanh nhà trọ dọn dẹp đám quái vật đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010107,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "Haha, bạn thật thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010113,
					"content": "Khiến bạn liên lụy rồi, thật là ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010114,
					"content": "Sau khi kết thúc, sẽ hậu tạ cho bạn, yên tâm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010115,
					"content": "Vậy thì mọi việc nhờ vào bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010108,
					"content": "Cái nhà trọ này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "Mở nhà trọ ở đây cũng khó tránh những chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010111,
					"content": "Có điều, nếu không có nhà trọ của chúng tôi thì những người ngoại địa đến đây sẽ ở đâu đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010112,
					"content": "Tuy là mệt, thế nhưng có vẫn hơn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				}
			]
