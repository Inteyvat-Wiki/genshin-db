					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "Cũng không gấp gì, đám quái vật đó cùng lắm là làm phiền khách khứa qua lại, chứ không dám lại gần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010204,
					"content": "Cho có con quái vật nào to gan tiến lại gần, ừm... thì tôi cũng đuổi chúng ra, quý khách yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010205,
					"content": "Haha, mở nhà trọ nơi ngoại ô xa xôi này, biết chút võ nghệ phòng thân, cũng là thường thôi.",
