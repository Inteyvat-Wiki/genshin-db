			"dialogs": [
				{
					"id": 750280101,
					"content": "Chậc... Gặp phải đối thủ khó xơi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Chuột"
				},
				{
					"id": 750280102,
					"content": "Hôm nay là ngày gì thế nhỉ? Không biết đã chọc phải ai mà bị đánh cho ra nông nỗi này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Cú Đêm"
				},
				{
					"id": 750280103,
					"content": "Thôi nào, phải nói rõ cho tôi biết là tôi đã làm gì phật lòng mấy người chứ? Để tôi lần sau không tái phạm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Cú Đêm"
				},
				{
					"id": 750280104,
					"content": "Này! Ăn nói khép nép và cúi đầu với tên hung thần này thì còn tiền đồ gì nữa chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Chuột"
				},
				{
					"id": 750280105,
					"content": "Tiền đồ? Tiền đồ có thể mài ra cơm ăn không? Tôi vất vả đi theo cái nhóm này rồi chỉ được làm mấy chuyện trộm gà bắt chó thôi. Gì mà buôn lậu Saurian chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Cú Đêm"
				},
				{
					"id": 750280106,
					"content": "Dù sao cũng bị họ cướp, vậy thì tại sao tôi lại không đi theo họ cho khỏe chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Cú Đêm"
				},
				{
					"id": 750280107,
					"content": "#Nào, {F#cô}{M#cậu} à, không phải tôi khoe khoang đâu, nhưng tôi chắc chắn lợi hại hơn hai cục nợ bên cạnh {F#cô}{M#cậu} đấy. Có chuyện gì thì cứ gọi nhé, đảm bảo sắp xếp ổn thỏa ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Cú Đêm"
				},
				{
					"id": 750280108,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Đúng lúc tôi đang thiếu một đàn em.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "Này! Nói thật đấy à? Tôi không đồng ý đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "Hơn nữa các người vốn dĩ là kẻ xấu mà! Chúng tôi sẽ không làm bạn với mấy kẻ buôn Saurian đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "Sẽ không có ai chính trực hơn tôi đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Khụ, tóm lại thì các người đừng có giở trò với Saurian nữa... {NICKNAME} sẽ cho các người biết tay đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "Hai tên buôn Saurian hậm hực bỏ đi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Không biết tình hình của con Qucusaur kia sao rồi, đi xem thử đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Cũng không hẳn, có thể châm chước được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#Nói thế sẽ dạy hư {REALNAME[ID(2)|SHOWHOST(true)]} đấy! Nhóc à, yên tâm nhé, bọn chúng sẽ không làm hại đến nhóc đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "Rrrah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Cảm ơn, nhưng tôi không cần đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
