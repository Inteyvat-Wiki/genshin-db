			"dialogs": [
				{
					"id": 200490101,
					"content": "Thật muốn uống một ly rượu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490102,
					"content": "Nhưng nếu để Eury phát hiện tôi uống rượu, vậy thì tiêu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490103,
					"content": "Bạn sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "Hử? Ồ... ồ, tôi chỉ muốn uống chút rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490105,
					"content": "Bà vợ Eury của tôi rất ghét tôi uống rượu, thường ngày ở nhà, tôi hầu như không được đụng đến giọt rượu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490106,
					"content": "Tôi chỉ có thể nhân lúc cô ấy lên phố mua đồ, mới có thể lén đến uống vài ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490107,
					"content": "Bạn cũng thích uống rượu quá nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "Bạn nói gì vậy! Người Mondstadt làm sao có thể không uống rượu chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490109,
					"content": "Năn nỉ bạn, hãy đi giúp tôi giữ chân Eury một chút, để tôi uống một hai ly là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490110,
					"content": "Khi mua đồ, chỉ cần có nhiều lựa chọn, Eury sẽ do dự, không thể quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490111,
					"content": "Nếu có thể khiến cô ấy có nhiều lựa chọn, cô ấy sẽ do dự mãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490112,
					"content": "Tôi biết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "Hahaha, vậy thì nhờ bạn rồi, chúc bạn tửu vận sáng ngời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490114,
					"content": "Bạn muốn uống bao nhiêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "Hahaha, vậy thì xem bạn có thể giữ chân bao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490116,
					"content": "Không, không phải, tôi chỉ cần có thể yên tĩnh uống một ly là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490117,
					"content": "Đây là lời hứa của một khách uống rượu Mondstadt, nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
