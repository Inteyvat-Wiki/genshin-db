				"points": []
			},
			"dialogs": [
				{
					"id": 716730101,
					"content": "Ừm... Cứ cảm thấy bức tranh này thiếu thiếu cái gì đó, có phải nên tìm thêm chút cảm hứng không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730102
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730102,
					"content": "Anh đang...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730103
					]
				},
				{
					"id": 716730103,
					"content": "#Ái chà, đây chẳng phải là {NICKNAME} sao? Nghe danh đã lâu, thật vinh hạnh được gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730104
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730104,
					"content": "#Như {F#cô}{M#cậu} thấy đấy, tôi đang bố trí nơi vui chơi ngày lễ ở đây theo sự sắp xếp của Tổng Vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730105
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730105,
					"content": "Hmm... Anh định dạy người ta vẽ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730106
					]
				},
				{
					"id": 716730106,
					"content": "Ấy, không phải không phải, không phải là \"dạy người ta vẽ\", mà là \"vẽ thay người ta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730107
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730107,
					"content": "Tết Hải Đăng năm nào cũng hoành tráng hơn năm trước, khách khứa qua lại cũng ngày càng nhiều, trong đó không thiếu những du khách từ nơi xa xôi ngoài Liyue tìm đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730108
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730108,
					"content": "Tuy Tổng Vụ cũng đã sắp xếp \"chụp hình kỷ niệm\" miễn phí cho họ, nhưng chụp hình thì dù sao vẫn thiếu chút phong vị Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730109
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730109,
					"content": "Thế nên, Tổng Vụ lệnh cho tôi đến bến cảng, vẽ tranh lưu niệm cho du khách qua lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730110
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730110,
					"content": "Tôi thấy gần đây ở Cảng Liyue có truyền thuyết \"Bạch Mã Tiên Nhân\" là nổi tiếng nhất, nên tôi quyết định lấy nó làm chủ đề vẽ tranh luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730111
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730111,
					"content": "Người ta nói, rồng bay hổ nhảy, khí thế như rồng như ngựa, lấy hình ảnh ngựa trắng phi nước đại làm chủ đề mà vẽ một bức \"tranh phi vọt\" cho khách, thì đúng là đại cát đại lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730112
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730112,
					"content": "#Thế nào, {NICKNAME}, trong lòng {F#cô}{M#cậu} có ý tưởng nào thích hợp để vẽ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730113
					],
					"speakerTitle": "Wenji"
				},
				{
					"id": 716730113,
					"content": "Cũng có khá nhiều đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730114
					]
				},
				{
					"id": 716730114,
					"content": "Ồ? Hahaha, được! Nếu có cảm hứng thì cứ nói ra, để tôi phác họa một phen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wenji"
				}
			]
		}
	]
}