			},
			"dialogs": [
				{
					"id": 735340101,
					"content": "#Xin chào! {F#Cô}{M#Cậu} là người sẽ hỗ trợ tôi về liệu pháp giấc mơ sao? Nói thật, tôi cũng không biết mình sẽ mơ thấy gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "Tôi là người Mondstadt, bình thường không có sở thích gì... ngoài uống rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "#Đôi khi uống quá chén sẽ dễ làm hỏng việc, lần này nhờ cả vào {F#cô}{M#cậu} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
