			"dialogs": [
				{
					"id": 735340501,
					"content": "Hân hạnh làm quen, tôi là Higuchi Tetsuya, tác giả tiểu thuyết về youkai đến từ Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "Dạo này áp lực viết bản thảo khá lớn, nên chỉ cần điều chỉnh được cho trạng thái tốt hơn là tôi đều sẽ sẵn lòng thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "#Dù sao cũng là giấc mơ tạo ra từ vấn đề của tôi, có thể sẽ chứa những yếu tố mang phong cách của tôi. Nếu lát nữa {F#cô}{M#cậu} bắt gặp thứ gì kỳ quái trong giấc mơ thì tôi cũng xin phép xin lỗi trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
