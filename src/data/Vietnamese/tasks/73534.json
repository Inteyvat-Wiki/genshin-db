			"dialogs": [
				{
					"id": 735340301,
					"content": "Rất hân hạnh, chúng ta sắp được cùng nhau bước vào giấc mơ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "#Tôi là Youguang, Tiêu Sư đến từ Liyue. Lần này vì quá trình hộ tống bắt gặp những thứ không được sạch sẽ, nên dạo gần đây ngủ không ngon giấc, phiền {F#cô}{M#cậu} giúp đỡ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "Nếu lần này có thể loại bỏ những cơn ác mộng của tôi bằng liệu pháp giấc mơ thì tốt quá, thật vô cùng cảm kích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
