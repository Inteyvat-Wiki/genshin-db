				"points": []
			},
			"dialogs": [
				{
					"id": 735340901,
					"content": "#Người bạn lợi hại mà Dharmakirti giới thiệu hóa ra là {F#cô}{M#cậu} à? Tôi là Piyush, làm việc trong ngành kiến trúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340902,
					"content": "#Lúc trước có nghe anh Kaveh nhắc đến {F#cô}{M#cậu}, nhưng chưa có cơ hội gặp mặt chào hỏi, lần này đúng là trùng hợp quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340903,
					"content": "Tôi đoán lát nữa chắc tôi sẽ mơ thấy dự án mà tôi mới nộp, đúng là ác mộng mà... Không ngờ lần đầu gặp mặt lại là trong tình cảnh này, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piyush"
				}
			]
		},
