			"dialogs": [
				{
					"id": 735340201,
					"content": "Quán rượu này càng nhìn càng thấy không đúng... Chậc, cứ cảm thấy có món đồ gì đó khác với bình thường, hình như đặt lệch rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
