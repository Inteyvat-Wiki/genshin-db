			"dialogs": [
				{
					"id": 735340701,
					"content": "Ồ, tình nguyện viên đạt chuẩn của thử nghiệm giấc mơ lại trẻ vậy sao? Đúng là hậu sinh khả úy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Cứ gọi tôi Nitesh là được. Tôi là Học Giả Thực Địa của Học Phái Spantamad, hiện tại đang làm việc dài hạn ở Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "#Người có tuổi là sẽ gặp đủ thứ vấn đề. Người trẻ tuổi à, lát nữa trong giấc mơ nhờ cả vào {F#cô}{M#cậu} giúp tôi xem xét nguồn gốc vấn đề nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
				}
			]
		},
