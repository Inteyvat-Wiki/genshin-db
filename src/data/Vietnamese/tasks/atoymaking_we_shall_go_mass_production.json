			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#Hihi, {NICKNAME}, Paimon, các bạn đến rồi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970102,
					"content": "Thành phố đồ chơi của tôi sắp được mở ra rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970103,
					"content": "Thành phố đồ chơi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970104,
					"content": "E hèm, đương nhiên rồi, nói là thành phố đồ chơi thì có hơi quá, thật ra cũng chỉ là tôi và \"Cỗ Máy Khổng Lồ\" của tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970105,
					"content": "Tôi đã cải thiện quy trình một chút và bây giờ không cần phải đợi quá lâu để hoàn tất quá trình sản xuất nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970106,
					"content": "Mặc dù không thể gọi là \"hoàn thành trong nháy mắt\", nhưng cũng có thể nói là \"có ngay\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970107,
					"content": "Woa, nghe có vẻ rất ghê gớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970108,
					"content": "Còn cái này nữa, tôi đã cải thiện \"Máy Thu Thập Nguyên Liệu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970109,
					"content": "Lúc trước chẳng phải hoàn thành xong một công đoạn thì cần phải quay về sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970110,
					"content": "Sau đó tôi thấy hiệu quả hơi thấp, nên tôi đã điều chỉnh, bây giờ nó sẽ cập nhật nội dung quy trình hiện tại dựa trên tình trạng thu thập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970111,
					"content": "Dựa trên tình trạng thu thập...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970112,
					"content": "Điều chỉnh nội dung quy trình?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970113,
					"content": "Không hiểu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "Ôi, phải giải thích thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970115,
					"content": "Ví dụ công đoạn đầu tiên tôi cần 10 Quả Nhật Lạc, giai đoạn thứ hai cần Nguyên Tố Thủy, giai đoạn thứ 3 cần đánh bại 2 Slime Thủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970116,
					"content": "Bây giờ bạn đem \"Máy Thu Thập Nguyên Liệu\" thu thập 10 Quả Nhật Lạc, vậy thì nó sẽ xác định tất cả các nguyên liệu cần thiết cho công đoạn đầu tiên đã được thu thập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970117,
					"content": "Sau đó nó sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970118,
					"content": "Tôi hiểu rồi, sau đó nó sẽ tự động chuyển sang chế độ thu thập của công đoạn thứ 2!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970119,
					"content": "Đúng, nó sẽ vào chế độ \"Nạp Nguyên Tố\", bổ sung Nguyên Tố Thủy. Đến khi nạp xong Nguyên Tố Thủy, sẽ lại cập nhật tiếp một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970120,
					"content": "Sau đó sẽ bước sang công đoạn thứ 3...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "Đúng vậy, đến lúc đó bạn chỉ cần đánh bại Slime Thủy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970123,
					"content": "Nghe có vẻ tiện hơn nhiều thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970124,
					"content": "Vậy sao, tôi phải mất cả buổi tối để cải tiến máy thu thập nguyên liệu này đó, tôi sẽ gọi nó là cỗ máy siêu cấp 3 trong 1...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970125,
					"content": "\"Máy Thu Thập Nguyên Liệu\" đúng là lợi hại thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970126,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "Hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970128,
					"content": "Nhưng mà tại sao lại đưa \"Máy Thu Thập Nguyên Liệu\" cho chúng tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970129,
					"content": "Hihi, tôi tạm thời bị cấm túc, chỉ có thể ở trên Đảo Ritou... nên không thể thu thập nguyên liệu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970130,
					"content": "Giúp người giúp cho trót, doanh thu từ việc bán đồ chơi cũng sẽ chia cho các bạn một ít mà, hơn nữa những món đồ chơi chế tạo ra, bạn có thể lấy miễn phí một cái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970141,
					"content": "Còn nhớ tấm phiếu lần trước tôi đưa cho các bạn không, hihi, dùng tấm phiếu đó sẽ có thể đổi đồ chơi miễn phí đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970142,
					"content": "Chỉ cần là đồ chơi mà bạn đã chế tạo qua thì bạn đều có thể đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970131,
					"content": "Hay quá ha, chúng tôi chạy tới chạy lui, nguyên liệu là chúng tôi bỏ ra, Mora bán được thì thuộc về anh, đồ chơi cũng chỉ được lấy một cái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970132,
					"content": "#Làm gì có chuyện như vậy, chúng ta đi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970133,
					"content": "Vậy... chia cho các bạn nhiều một chút, đồ chơi có thể lấy 2 cái... hay là... 3 cái?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970134,
					"content": "Chúng ta đi, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "4 cái! 4 cái! Hết mức rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970136,
					"content": "Haiz, nếu tôi không nợ tiền thì số đồ chơi này đưa hết cho các bạn cũng được, nhưng tôi còn nợ tiền của Thương Hội Vạn Quốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970137,
					"content": "Hừm, tội nghiệp chưa kìa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "...Haiz, được rồi, chúng tôi thấy anh đáng thương nên mới giúp đó, chứ không phải vì Mora và mấy món đồ chơi kia đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970139,
					"content": "Hihi, cảm ơn hai vị đã giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970140,
					"content": "Lần này xem như có thể thở phào nhẹ nhõm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970121,
					"content": "Sau đó sẽ bước sang công đoạn \"kích hoạt hạt nhân\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}