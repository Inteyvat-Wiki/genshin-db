			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269701",
							"2"
						],
						"stepId": 7269701,
						"stateName": "QUEST_STATE_UNFINISHED"
