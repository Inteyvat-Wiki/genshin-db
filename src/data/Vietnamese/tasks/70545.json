			"dialogs": [
				{
					"id": 705450101,
					"content": "Meo, meo meo... meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "Meo! Meo meo meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "Thỏ"
				},
				{
					"id": 705450103,
					"content": "Hmm... \"Thỏ\" và Amber nói chuyện rất ăn ý nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "Ồ, thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "Thực sự nói rất đúng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "Thật ra tôi cũng không hiểu lắm, nhưng tôi cảm nhận được là Amber và \"Thỏ\" đã có được tiếng nói chung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME} và Paimon đến rồi à, tôi đang định đi tìm các bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "Việc các bạn hỗ trợ vận hành Pháo Đài Mèo này, tôi đã nghe Valerina nói rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#Không hổ danh là {NICKNAME}, vừa về Mondstadt là đã giúp được một việc lớn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "Dù gì thì tôi cũng là Kỵ Sĩ Danh Dự mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "Mà này, lúc nãy Amber và \"Thỏ\" nói chuyện gì vậy? Nhìn có vẻ rất vui đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Meo, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "Thỏ"
				},
				{
					"id": 705450115,
					"content": "À... Tôi hỏi \"Thỏ\" hôm nay thời tiết thế nào, sẽ có mưa không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "Hửm? Mèo cũng biết chuyện này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Hihi, tôi cũng chỉ nghe qua Lisa nói thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "Trong một cuốn sách mà Lisa từng đọc, có ghi là mèo rất nhạy cảm với độ ẩm và không thích cảm giác bị ướt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "Vậy nên, nếu cảm thấy độ ẩm trong không khí tăng đột ngột thì chúng sẽ không ngừng xoa mặt và liếm lông một cách bồn chồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Khi mèo có hành động này thì cho thấy có thể trời sẽ mưa to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "Thì ra là có chuyện này sao... Vô tình lại học được kiến thức đặc biệt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}, lần sau ra ngoài thì chúng ta hãy quan sát thêm về mèo nhé. Như vậy sẽ không đến nỗi... bị mắc mưa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "Vậy sau này phải chú ý hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "Thật ra hôm nay tôi đến để hỏi thăm Valerina một chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "Tôi đang trò chuyện với cô ấy thì bé mèo này nằm xuống cạnh tôi rồi ngáp một cái rõ to, thật đáng yêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Bé mèo thân với tôi như vậy nên... nên tôi phải tỏ ra thân thiện một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "Sau đó, tôi nhớ đến chuyện Lisa nói với tôi, nên sẵn tiện hỏi \"Thỏ\" về thời tiết luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "Nhưng \"Thỏ\" lúc thì xoa mặt, lúc thì vẫy đuôi, lúc lại nằm dưới đất cọ vào tay tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "Ôi, liệu trong mấy ngày tới sẽ có mưa không nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "Thật ra tôi rất quan tâm đến những con mèo ven đường!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "Bảo vệ mèo của Mondstadt cũng là một nhiệm vụ của tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "Khoan đã, tôi chưa hiểu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}