			"dialogs": [
				{
					"id": 708240101,
					"content": "Quét dọn phải để tâm một chút! Đây là ấn tượng đầu tiên của khách khứa với tửu trang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "Xin lỗi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240103,
					"content": "Chúng tôi sẽ cẩn thận hơn nữa!",
