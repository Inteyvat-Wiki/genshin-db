						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "Là bạn à, chào mừng bạn đến Tửu Trang Dawn, tuy cơn bão đã trôi qua, nhưng vẫn cần thu dọn tửu trang bị bão lốc làm loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "Tôi đang bố trí việc quét dọn, nhưng Moco và Hillie, thực sự là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "Xin lỗi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240108,
					"content": "Chúng tôi sẽ cẩn thận hơn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Các bạn đã từng nói một lần rồi! Có thời gian xin lỗi, chi bằng cẩn thận quét dọn một lượt, còn không mau đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "Haiz, hai đứa bé này, chẳng để ý gì cả, với hiệu quả công việc kiểu này, bao giờ mới thu dọn xong đây, phòng ốc cũng cần quét dọn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
