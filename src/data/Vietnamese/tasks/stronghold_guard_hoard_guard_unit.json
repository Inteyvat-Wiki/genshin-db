			"trigger": {
				"objectNames": [
					"Sấm Xanh",
					"Đuôi Hành Tây"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766800101,
					"content": "#Ồ, {NICKNAME} và Paimon, xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800102
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800102,
					"content": "Đúng lúc quá, hay là tới xem chú chồn của tôi đi? Tên nó là Đuôi Hành Tây, đáng yêu lắm luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800103
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800103,
					"content": "...Meo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800104
					],
					"speakerTitle": "Đuôi Hành Tây"
				},
				{
					"id": 766800104,
					"content": "Này này, Đuôi Hành Tây, không phải kêu như thế đâu! Hai người này chắc không hiểu được ngôn ngữ của giáo viên Ashru đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800105
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800105,
					"content": "...Guu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800106
					],
					"speakerTitle": "Đuôi Hành Tây"
				},
				{
					"id": 766800106,
					"content": "Cũng không thể dùng tiếng chim sẻ được, tiểu thư Basima đã về Sumeru nghỉ ngơi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800107
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800107,
					"content": "Xin lỗi nhé, Đuôi Hành Tây nhà tôi giao tiếp với nhiều động vật quá nên tạm thời bị rối loạn, chưa tìm lại được \"kênh\" của mình, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800108
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800108,
					"content": "Để nó nghỉ ngơi đã nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800109,
						766800110
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800109,
					"content": "Cô cũng là chuyên gia về động vật à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				},
				{
					"id": 766800111,
					"content": "Hmm... Sao cứ cảm thấy cô rất thân với chúng tôi nhỉ, nói chuyện rất tự nhiên... Hay là trước đây cô đã điều tra về chúng tôi rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766800112,
					"content": "Thư giãn đi, tôi cùng phe với hai người mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800113
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800113,
					"content": "Tôi làm việc cho cô chủ Yelan, còn hai người là vị khách quan trọng nhất của cô ấy. Quan hệ giữa chúng ta thân thiết thế nào thì không cần phải nói nhiều nữa đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800114,
						766800115
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800114,
					"content": "Đúng là người cùng phe rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800116,
					"content": "Chậc, nói sớm đi chứ! Làm tôi thấy căng thẳng luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766800117,
					"content": "Mà nói chứ, cô và Đuôi Hành Tây đứng ngẩn ngơ ở nơi hoang vu thế này làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766800118,
					"content": "Chúng tôi đang bận gác cổng... Nói đúng hơn thì là kiểm tra xem \"Quân Đoàn Gác Cổng\" của tôi có làm việc hẳn hoi không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800119,
						766800120
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800119,
					"content": "\"Quân Đoàn\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800121,
					"content": "Đều là người quen cả, tôi sẽ tiết lộ cho hai người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800122
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800122,
					"content": "Dưới lòng đất ở quanh đây có cất giấu kho vật tư dự trữ của tôi, nhưng gần đây liên tục bị các ma vật xông vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800123
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800123,
					"content": "Nên tôi đã chi một khoản lớn để nhờ thiên tài cơ khí từ Xưởng Krumkake Clink-Clank chế tạo cho một quân đoàn cơ quan gác cổng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800124
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800124,
					"content": "Khụ khụ, mô tả chính xác thì là hệ thống an ninh. Có thể tự chọn địa điểm bố trí, kết hợp nhiều chức năng khác nhau để tạo thành hệ thống phòng thủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800125
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800125,
					"content": "Tôi khá may mắn! Không lâu nữa thiên tài đó sẽ mang tác phẩm đi tham gia triển lãm, bộ bán cho tôi sẽ được coi là phiên bản thử nghiệm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800126
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800126,
					"content": "Nên tôi đã xây dựng một phòng tuyến tổng hợp ngay trước căn cứ, để mời... à không, là dụ ma vật vào bẫy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800127
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800127,
					"content": "Như vậy, không những có thể thử nghiệm nhiều phương án bảo vệ cứ điểm, mà còn cung cấp cho thiên tài nhiều dữ liệu hơn, một công đôi việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800128,
						766800129
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800128,
					"content": "Hóa ra cô đã mua kiệt tác của Aino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800130,
					"content": "Có muốn thử không? Tôi đã dùng chúng để xử lý rất nhiều ma vật rồi, cảm giác cực kỳ giải tỏa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800131
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800131,
					"content": "Hai người cũng thử đi, tiện thể cho tôi tham khảo ý tưởng luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800132
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800132,
					"content": "Tất nhiên, thù lao dễ bàn thôi. Người cùng phe mà, phải trả gấp đôi cố vấn bình thường mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800133,
						766800134
					],
					"speakerTitle": "Sấm Xanh"
				},
				{
					"id": 766800133,
					"content": "Đúng rồi, cùng phe cả, cho nhiều một chút!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800135,
					"content": "Ừm... ừm! Nghĩ kỹ thì, giúp cô cũng là gián tiếp giúp Yelan, chuyện này mọi người đều có lợi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766800136,
					"content": "Thế thì để người giàu kinh nghiệm như chúng tôi ra tay vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766800134,
					"content": "Ôi, thế sao được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800129,
					"content": "Nghe rất thú vị đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800120,
					"content": "\"Gác Cổng\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800115,
					"content": "Bạn của Yelan cũng là bạn của chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800110,
					"content": "Cô cũng là bạn của động vật à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				}
			]
		}
	]
}