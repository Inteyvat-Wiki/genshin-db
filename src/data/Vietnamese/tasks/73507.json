			"dialogs": [
				{
					"id": 735070301,
					"content": "Thế nào, Sao Băng Vàng? Cảm giác lần đầu chơi thử Kỳ Trận Nấm Linh thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070302,
					"content": "Trông bạn có vẻ như chưa thể đưa ra kết luận nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070303,
					"content": "Tôi mới chỉ chơi một ải thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Ừm, nội dung chơi thử quá ít, thật sự rất khó để khảo sát được ưu khuyết điểm của Kỳ Trận Nấm Linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070306,
					"content": "Đừng lo lắng, trong thời gian tới thì tôi và Haniyyah sẽ ở đây, mỗi ngày chuẩn bị một ải mới, tổng cộng có bảy ải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070307,
					"content": "Nếu bạn rảnh, có thể đến đây chơi thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070308,
					"content": "Mặc dù bạn là người ra quyết định cuối cùng của ban tổ chức, nhưng dù sao thì trò chơi này là do tôi và Haniyyah tự chuẩn bị, nó không nằm trong kế hoạch nên sẽ làm mất thời gian của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070309,
					"content": "Vì vậy, tôi cũng sẽ trả cho bạn một khoản phí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070310,
					"content": "Haha, vậy thì tôi không khách sáo nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "Tốt quá! Sự hào sảng của bạn thật đáng khâm phục!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070313,
					"content": "Tôi đã đăng ký đủ thời gian lưu trú cho hai đồng đội Nấm Quỷ rồi. Trong thời gian thử nghiệm Kỳ Trận Nấm Linh, chúng có thể ở lại Cảng Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070314,
					"content": "Vậy là Ngôi Sao Bạc cũng có thể chơi cùng Nón Trống Tròn lâu thêm một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070315,
					"content": "Mừng cho Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Haha, bạn cũng mau đi thăm Nón Trống Tròn đi, nó nhớ bạn lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070318,
					"content": "Mang theo cái này đi, khi chơi với Nón Trống Tròn thì có thể cho nó và Ngọn Lửa Hân Hoan ăn, đây là thứ mà chúng thích nhất đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070316,
					"content": "Tôi háo hức quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "Tôi sẽ bù cho anh bằng tiền lương của giải đấu tiếp theo!",
					"roleType": "TALK_ROLE_PLAYER",
