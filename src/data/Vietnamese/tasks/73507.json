			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Balfour"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#\"Sao Băng Vàng\" {NICKNAME} và \"Ngôi Sao Bạc\" Paimon, đã lâu không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070102,
					"content": "Trông các bạn vẫn tràn đầy sức sống nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070103,
					"content": "Lâu ngày không gặp, vẫn khỏe chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "Hihihi, Haniyyah! Và cả Balfour... siêu trách nhiệm nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070105,
					"content": "Thật không ngờ lại gặp mọi người ở Cảng Ormos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070114,
					"content": "Nói chứ, Haniyyah và Balfour đang làm gì ở đây vậy? Tôi nhớ nơi này lúc trước là sạp hàng Rau Câu Hoa Hoa mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070115,
					"content": "Hai vị anh hùng, nghe giọng nói của hai vị thì tôi lại càng có thêm lòng tin rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070116,
					"content": "Bây giờ tôi sẽ báo cáo thành quả công việc với hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070117,
					"content": "Lúc trước hai vị là quán quân của Giải Đấu Luyện Thú Cúp Nilotpala, quyết định tạm thời dừng giải đấu để Giáo Viện cải tiến \"Ngọc Trí Tuệ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070118,
					"content": "Hai vị vẫn đang chờ thông báo đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070119,
					"content": "Đúng vậy! Đợi đến khi có tiến triển thì Layla, Cyno hoặc học giả phụ trách sẽ tìm cách nói với chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070120,
					"content": "Paimon không rành và không hiểu công nghệ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "Đúng là như vậy, chúng tôi chủ động đi hỏi cũng không giúp được gì, nói không chừng còn làm phiền họ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070123,
					"content": "Các bạn đúng là bình tĩnh và thận trọng! Tôi thì thường nhớ lại bầu không khí rầm rộ của giải đấu lần trước và không thể kìm lòng được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070124,
					"content": "Vì vậy, tôi đã cố gắng hỏi những người có liên quan trong Giáo Viện, và nhận được câu trả lời chi tiết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070125,
					"content": "Hiện tại, việc cải tiến \"Ngọc Trí Tuệ\" vẫn đang trong giai đoạn nghiên cứu lý thuyết, và sẽ mất rất nhiều thời gian trước khi đưa vào sản xuất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070126,
					"content": "Nhưng những bình luận về giải đấu đầu tiên đang giảm dần, thậm chí dần dần bị mọi người lãng quên. Sức ảnh hưởng của cuộc thi không thể bị lãng phí như thế được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070127,
					"content": "Vì vậy, tôi đã tìm tiểu thư Haniyyah để cùng chuẩn bị cho sự kiện chủ đề mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070128,
					"content": "Sự kiện chủ đề?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "Lẽ nào là đang nói đến những quân cờ bày trên bàn giống như... Nấm Quỷ này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070130,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070131,
					"content": "Balfour đã chuẩn bị phương án mới cho giải đấu tiếp theo rồi, và còn gây quỹ ở khắp mọi nơi và đến Liyue để tìm hiểu con đường kinh doanh mới nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070132,
					"content": "Khi đang học quản trị kinh doanh ở Liyue, anh ấy đã biết đến một trò chơi có tên Cờ Cơ Quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070133,
					"content": "Balfour đã mua bản quyền Cờ Cơ Quan ở Sumeru, mời tôi đến làm cố vấn, cùng nhau cải tiến trò chơi hoàn toàn mới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070134,
					"content": "Tên của nó là Kỳ Trận Nấm Linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070135,
					"content": "Kỳ Trận Nấm Linh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070136,
					"content": "Để tôi đoán xem... Lẽ nào lần này là muốn chúng tôi chỉ huy Nấm Quỷ đi so tài với các loại cơ quan sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070137,
					"content": "Không hổ danh là \"Ngôi Sao Bạc\", đoán một cái là ra ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070138,
					"content": "Tôi nghĩ loại trò chơi này dễ hiểu, dễ quảng bá và có nhiều tiềm năng để khám phá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070139,
					"content": "Nếu nó trở nên phổ biến dưới dạng một trò chơi phụ với danh nghĩa \"Giải Đấu Luyện Thú\", vậy thì sẽ khiến cho mọi người nhớ đến giải đấu trong một thời gian dài và mong chờ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070140,
					"content": "Bằng cách này, khi giải đấu tiếp theo được tổ chức, sẽ có nhiều tuyển thủ tham gia hơn và nhiều khán giả sẽ đến xem hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070141,
					"content": "Đương nhiên, mọi thứ vẫn phải được hai vị gật đầu đồng ý. Dù sao thì mọi thứ về giải đấu cũng đều do các vị quyết định mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070142,
					"content": "Tôi thấy rất đáng để thử!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#Đúng vậy, {NICKNAME} và tôi không biết nhiều về kinh doanh, nghe anh Balfour nói như vậy, tôi thấy rất có lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070145,
					"content": "Đây là kết quả của Haniyyah và Balfour cùng cố gắng, tôi tin vào tài năng của các bạn, hãy cứ làm đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070146,
					"content": "Mặc dù chưa bắt đầu chơi, nhưng tôi có thể khẳng định là chắc chắn sẽ có rất nhiều người thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070147,
					"content": "Tuyệt quá, được sự cho phép của hai vị, tôi có thể mạnh tay quảng bá Kỳ Trận Nấm Linh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070148,
					"content": "Hiện giờ Kỳ Trận Nấm Linh vẫn còn ở trong giai đoạn thử nghiệm, cần mời người chơi thử để thu thập ý kiến và cải thiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070149,
					"content": "Sau khi Sao Băng Vàng tinh thông hàng chục trò chơi thịnh hành của Teyvat chơi thử, chắc chắn sẽ có thể đưa ra ý kiến chuẩn xác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070150,
					"content": "#Vậy thì chơi thôi, {NICKNAME}! Đây là một trong những lĩnh vực bạn giỏi nhất mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070151,
					"content": "Sao có cảm giác như bị Paimon sai khiến nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Nhưng mà, tôi còn một chuyện muốn hỏi Haniyyah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070154,
					"content": "Muốn hỏi về \"Nón Trống Tròn\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070155,
					"content": "Đúng đúng! Tôi nhớ Nấm Quỷ quá, bây giờ chúng thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070156,
					"content": "Yên tâm đi, chúng vẫn khỏe mạnh, mỗi ngày đều vô tư vui sống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070157,
					"content": "\"Quái Thú Xoay Tròn\" và \"Lưới Sấm\" đang trú trong nơi ở tạm thời của tôi tại <color=#00E1FFFF>phía bắc Cảng Ormos</color>, tạm thời do một tuyển thủ đợt trước chăm sóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070158,
					"content": "\"Nón Trống Tròn\" và \"Ngọn Lửa Hân Hoan\" ở ngay gần đây. Ngôi Sao Bạc có thể đến đó chơi với chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070159,
					"content": "#Ở gần đây! Vậy thì {NICKNAME}, lát nữa khi bạn chơi thử trò chơi mới, tôi sẽ đi tìm \"Nón Trống Tròn\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070160,
					"content": "Đi thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "Việc không thể chậm trễ, mời Sao Băng Vàng trải nghiệm phiên bản thử nghiệm đầu tiên của Kỳ Trận Nấm Linh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070161,
					"content": "Lát nữa tôi sẽ đến!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "Thôi được, Sao Băng Vàng xuất kích!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "Vất vả cho anh rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "Tôi không hiểu về công nghệ, nên không dám đưa ý kiến bừa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "Mọi người là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#{NICKNAME}, bạn đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070108,
					"content": "Lúc trước chúng ta tham gia Giải Đấu Luyện Thú Cúp Nilotpala và đã chơi rất vui với Nấm Quỷ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070109,
					"content": "Haniyyah là người bạn mà chúng ta quen biết lúc đó, Balfour thì là nhân viên có trách nhiệm nhất giải đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070110,
					"content": "Lẽ nào ngay cả Nón Trống Tròn và Quái Thú Xoay Tròn bạn đều không nhớ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070111,
					"content": "À à! Tôi nhớ ra rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "Thật là, đừng có dọa tôi chứ, nếu không tôi sẽ phải tìm bác sĩ cho bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070112,
					"content": "Hihi, tôi đùa đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
