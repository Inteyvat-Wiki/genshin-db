			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "Bạn học rất nhanh, hương vị cũng rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020302,
					"content": "Ừm ừm, tôi cũng thấy ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020303,
					"content": "Lúc nãy chỉ là mô phỏng tình huống thôi. Trên thực tế thì khách hàng thường sẽ có những yêu cầu đặc biệt đối với đồ uống của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020304,
					"content": "Đậm hơn một chút, chua hơn một chút chẳng hạn. Bạn chỉ cần tăng giảm nguyên liệu tương ứng với khẩu vị là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020305,
					"content": "Tôi muốn một ly Quả Thông Ngào Đường, ngọt một chút, ly to nhất nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020306,
					"content": "Gần giống như vậy đó. Nhưng đối với một thợ pha chế xuất sắc, ngoài kỹ năng pha chế ra, còn phải nắm bắt được kỹ năng trò chuyện với khách hàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020307,
					"content": "Cứ giao cho tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "Vậy được, vị trí quầy này giao cho các bạn, có vấn đề hoặc có yêu cầu gì thì cứ tìm tôi bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020310,
					"content": "Phù... cuối cùng cũng học xong! À mà khoan... Quả Thông Ngào Đường của tôi đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020311,
					"content": "Gọi món thiệt hả Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "Tôi rất biết cách nói chuyện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
