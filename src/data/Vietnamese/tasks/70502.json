				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "Không ngờ lại là người quen, hôm nay muốn uống gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020202,
					"content": "Xin chào, Charles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "Charles, chúng tôi đến để pha chế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020204,
					"content": "Pha chế... À, vậy là Luka đã lôi kéo hai người phải không, cậu ấy thật may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}, tôi rất tin tưởng vào năng lực xử lý vấn đề của bạn, nhưng mà, pha chế rượu là một việc hoàn toàn khác, nó đòi hỏi sự khéo léo nhất định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020206,
					"content": "Tỷ lệ nguyên liệu, phương pháp pha trộn... đều ảnh hưởng đến chất lượng của thành phẩm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020207,
					"content": "Không sao, nhà lữ hành nấu ăn rất ngon, nguyên lý trong giới ẩm thực đều như nhau cả mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020208,
					"content": "Được, còn một chuyện nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020209,
					"content": "Trong sự kiện trước đó có một thực tập sinh đã pha trộn ba loại rượu dựa trên sự hiểu biết của bản thân, và cuối cùng, chỉ một ly thôi cũng đã khiến khách bất tỉnh trên sàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020210,
					"content": "Từ đó chúng tôi không còn dám cung cấp nguyên liệu chứa cồn cho người mới nữa, xin thứ lỗi cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020211,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "Được, tôi dặn dò xong hết rồi. Các kỹ thuật và kỹ năng tôi sẽ dạy bạn trong quá trình pha chế thực tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
