			},
			"dialogs": [
				{
					"id": 765070101,
					"content": "#Woa, {NICKNAME} xem nè! Không ngờ cuốn album ảnh này đã được chúng ta chụp đầy rồi đấy! Tấm nào cũng đẹp hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070102,
					"content": "Đúng vậy, thời gian trôi nhanh thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "Hihi, không ngờ lần này lại tìm được nhiều nơi đẹp như vậy, còn chụp ảnh cho nhiều người bạn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070105,
					"content": "Xem tấm này đi, lúc đó để tìm được góc chụp tuyệt vời này mà tôi đã phải tốn không ít công sức đấy. Nhưng hiệu quả chụp ra thật tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070106,
					"content": "Nhờ vào tài năng tìm đường của Paimon đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "Hihi, đương nhiên rồi. Tôi là người dẫn đường tận tâm và chuyên nghiệp nhất mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070109,
					"content": "Đổi lại được nhiều kỷ niệm vui vẻ như vậy, cũng coi như là đáng giá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME} dùng chiếc máy ảnh này chụp cảm thấy thế nào? Có cảm thấy kỹ thuật chụp ảnh của mình tiến bộ vượt bậc, hay sắp đuổi kịp ngài Leblanc chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070111,
					"content": "Kỹ thuật à... Tôi còn phải học hỏi nhiều lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "#Ừm, nói đúng lắm, quan trọng nhất là vui vẻ! Hơn nữa, tôi thấy những bức ảnh {NICKNAME} chụp chẳng kém gì những vị nhiếp ảnh gia đại tài đó cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070114,
					"content": "Bởi vì trong mỗi tấm ảnh đều có những câu chuyện chúng ta cùng nhau trải qua, đối với tôi mà nói, đó chính là những tác phẩm không thể thay thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070115,
					"content": "Sau này khi chúng ta... ừm, đi phiêu lưu ở những nơi khác, nếu nhớ lại những khoảng thời gian tốt đẹp này chắc chắn sẽ rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070116,
					"content": "Sau này chúng ta cùng nhau chụp thêm nhiều ảnh nữa nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "Được! Vậy chúng ta hẹn trước nhé, cuốn album tiếp theo phải còn đặc sắc hơn cuốn này! Cùng nhau tạo ra nhiều kỷ niệm độc nhất vô nhị hơn nữa nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070112,
					"content": "Quan trọng là tận hưởng quá trình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "Cũng nhờ vào quỹ dự phòng khẩn cấp của Paimon cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "Mỗi bức ảnh đều là một kỷ niệm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
}