			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "Bây giờ không phải là lúc nghiên cứu, chúng ta phải mau đi lánh nạn mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200302,
					"content": "Tôi đã nói rất nhiều lần rằng, tôi tuyệt đối sẽ không bỏ qua cơ hội nghiên cứu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 411200303,
					"content": "Hãy vào thành Mondstadt lánh nạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "Sao lại đến nữa? Bây giờ không phải lúc đi lánh nạn, những mảnh thiên thạch từ trên trời rơi xuống rất có thể là cơ hội tốt để chúng tôi tiến sâu vào Thiên Phong Thần Điện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 411200305,
					"content": "Tiến sâu vào Thiên Phong Thần Điện?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "Patchi nói rằng, có thể thiên thạch sẽ rơi vào Thiên Phong Thần Điện, nếu có mật thất bên dưới... hoặc thứ gì khác, chúng tôi có thể theo lối mà thiên thạch mở ra tiến sâu vào bên trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200307,
					"content": "Nhưng đây cũng thật là suy nghĩ viển vông, nếu thiên thạch rơi xuống thì chúng tôi cũng không thể chạy thoát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200308,
					"content": "Chúng ta mau đi lánh nạn đi, nếu thiên thạch thực sự rơi xuống Thiên Phong Thần Điện, còn tạo ra một con đường thì sau này chúng ta đến khám phá cũng không muộn mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200309,
					"content": "Nếu như bị người khác đến trước thì phải làm sao? Muốn thì tự mình về đi, tôi sẽ đợi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 411200310,
					"content": "Này... thôi được rồi, Nhà Lữ Hành, thật xin lỗi, cả hai chúng tôi sẽ ở lại đây một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200311,
					"content": "Đừng lo nếu thực sự có nguy hiểm... tôi sẽ xử lý được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200312,
					"content": "Phải rồi, trước đó có một người tên Schuster đi qua đây, bộ dạng vô cùng sợ hãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200313,
					"content": "Anh ấy hỏi xin tôi một chút nước uống, rồi nói rằng phải trở về thành Mondstadt, rất nhanh liền chạy mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200314,
					"content": "Nhưng hướng mà anh ấy đi không phải là đường về Mondstadt, mà là hướng đi Đỉnh Vọng Phong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200315,
					"content": "Tôi nghĩ... có khi nào anh chàng đó vì quá sợ hãi, nên đã nhớ nhầm đường không nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200316,
					"content": "Nhà Lữ Hành, bạn hãy đến gần Đỉnh Vọng Phong tìm anh ấy đi, nếu anh ấy gặp phải ma vật thì nguy to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200317,
					"content": "Tôi sẽ ở lại đây cùng Patchi, nếu thực sự xảy ra chuyện gì... tôi sẽ xử lý được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
