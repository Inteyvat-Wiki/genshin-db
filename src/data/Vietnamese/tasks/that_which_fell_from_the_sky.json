			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "Trong tình hình này tiến hành \"sinh tồn bên ngoài\"... có vẻ rất có tính thử thách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200202,
					"content": "Hãy vào thành Mondstadt lánh nạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "Lánh nạn? Ôi dào, đừng lo lắng, tôi vẫn để ý xung quanh đây, không có gì nguy hiểm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200204,
					"content": "Có điều, sao bạn vẫn loanh quanh bên ngoài, mau trở lại thành Mondstadt đi, nếu bị thiên thạch va vào thì không hay rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200205,
					"content": "Về những người vẫn đang ở bên ngoài...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "Những người vẫn đang ở bên ngoài? Có rất nhiều, bạn hỏi chuyện này làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200207,
					"content": "Để nhắc bọn họ lánh nạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "Là vậy à... Nhắc lại thì hình như hiệp hội cũng đã phát uỷ thác liên quan đến việc này, tôi cũng đã thông báo cho rất nhiều người quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200209,
					"content": "Những người ở gần thành Mondstadt, có lẽ đã vào thành lánh nạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200210,
					"content": "Nhưng vì thiếu nhân lực, tạm thời cũng không triệu tập được bao nhiêu nhà mạo hiểm, bên ngoài chắc vẫn còn rất nhiều người chưa nhận được thông báo, thật tốt vì có bạn giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200215,
					"content": "Tôi nghĩ xem nào, những người vẫn còn ở bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200216,
					"content": "À! Đúng rồi, tiểu thư Patchi và ngài Duran vẫn đang ở Thiên Phong Thần Điện, tôi đã nói với họ, nhưng họ vẫn khăng khăng ở lại đó nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200217,
					"content": "Còn có tu nữ Finder, trước đó cô ấy vẫn luôn ở gần Đỉnh Vọng Phong, hiệp hội cũng đã nhờ tôi tìm cô ấy nhiều lần, nhưng tôi vẫn chưa tìm thấy cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200218,
					"content": "Tôi chỉ còn nhớ những người này, bạn mau đi nói cho họ biết việc vào thành Mondstadt lánh nạn trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200219,
					"content": "Còn tôi sẽ chuẩn bị thêm một chút thực phẩm và những thứ cần thiết, sau đó tôi cũng sẽ đi xung quanh, gắng sức thông báo đến thật nhiều người vào thành lánh nạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200220,
					"content": "Mong là họ không đến những nơi quá xa xôi, nếu không cho dù có tìm được họ thì cũng sẽ gặp nhiều trở ngại khi quay về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200211,
					"content": "Tu nữ Grace rất lo lắng cho họ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "Tu nữ Grace? Là cô ấy à... hình như hiệp hội cũng đã phát uỷ thác liên quan đến việc này, tôi cũng đã thông báo cho rất nhiều người quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200213,
					"content": "Những người ở gần thành Mondstadt, có lẽ đã vào thành lánh nạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200214,
					"content": "Nhưng vì thiếu nhân lực, tạm thời cũng không triệu tập được bao nhiêu nhà mạo hiểm, bên ngoài chắc vẫn còn rất nhiều người chưa nhận được thông báo, thật tốt vì có bạn giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				}
			]
		},
