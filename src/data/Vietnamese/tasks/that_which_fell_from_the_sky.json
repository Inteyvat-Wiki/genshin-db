						411200402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200402,
					"content": "Rốt cuộc bạn đã đi đâu vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200403
					]
				},
				{
					"id": 411200403,
					"content": "Thật ngại quá, tôi vẫn luôn di chuyển quanh đây quan sát mặt biển, thực sự là khó tìm... bạn tìm tôi có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200404,
					"content": "Mời đến thành Mondstadt lánh nạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "Lánh nạn? À, ý của bạn là những thiên thạch kia à, tôi biết nhưng...",
