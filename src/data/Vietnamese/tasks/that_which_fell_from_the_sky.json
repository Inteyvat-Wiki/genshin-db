				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "Mong rằng tất cả mọi người đều bình an vô sự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200102,
					"content": "Bạn đang lo lắng chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "Là Nhà Lữ Hành à? Bạn để ý đến những thiên thạch từ trên trời rơi xuống chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200104,
					"content": "Mặc dù rất may là thiên thạch không rơi trúng thành Mondstadt, nhưng ở bên ngoài đã trở nên hỗn loạn. Tôi rất lo lắng cho những người vẫn đang ở bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200105,
					"content": "Nhà Lữ Hành, có thể nhờ bạn đi cảnh báo cho những người vẫn đang ở bên ngoài không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200106,
					"content": "Nếu họ đồng ý thì hãy mời họ đến thành Mondstadt lánh nạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200107,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "Vậy thì nhờ bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200112,
					"content": "Bạn có thể đến gặp tiểu thư Lynn trước, hỏi cô ấy có biết còn ai khác vẫn đang ở bên ngoài không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200113,
					"content": "Sau đó, hãy thử thuyết phục cô ấy vào trong thành Mondstadt lánh nạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200114,
					"content": "Hiện giờ không phải lúc cô ấy nhận thử thách \"sinh tồn bên ngoài\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200109,
					"content": "Tại sao thiên thạch không rơi trúng thành Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "Có lẽ đó chỉ là may mắn. Nhưng dù thế nào, trước mắt thành Mondstadt vẫn là nơi an toàn nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200111,
					"content": "Ít nhất... thì so với ở bên ngoài an toàn hơn, bạn nói xem có phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
