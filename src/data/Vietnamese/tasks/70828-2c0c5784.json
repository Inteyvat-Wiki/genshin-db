	"talks": [
		{
			"id": 7082801,
			"completionStepIds": [
				7082801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082801",
							"2"
						],
						"stepId": 7082801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "A! Nhà mạo hiểm tóc vàng bên kia, xin hãy đợi một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "Có cần tôi giúp đỡ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "#Không phải không phải, tôi chỉ muốn hỏi {F#cô}{M#cậu} có tập thơ nào về tình yêu không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "#{F#Cô}{M#Cậu} xem, tôi đây là nhà thơ siêu lợi hại, có lẽ là nhà thơ lợi hại nhất trong lịch sử Mondstadt ngoại trừ đại nhân Barbatos... Tóm lại là đặc biệt lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "Nhưng nhà thơ tên Linus kia có vẻ không phục, cả ngày đến tìm tôi đọc thơ! Nhìn sao cũng giống như đang cố tình khiêu khích, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "Đáng giận hơn là, anh ta đọc toàn mấy thứ như tình yêu, người yêu... đều là chủ đề mà tôi chưa từng viết bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "Vì vậy, tôi quyết định đích thân ra tay, viết một bài thơ tình vĩ đại chấn động cả Mondstadt, để anh ta thấy được đâu mới là tài năng thực sự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Nhưng mà... tiểu thư đây đã cống hiến toàn bộ thời gian cho nghệ thuật vĩ đại, tạm thời chưa có thời gian để trải nghiệm tình yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "Vậy nên, nếu có tập thơ nào về tình yêu thì có thể bán cho tôi! Chỉ cần xem qua vài trang, với thiên phú của tiểu thư đây thì chắc chắn ý thơ sẽ tuôn trào ngay lập tức!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "Không giúp được, tôi còn có việc, đi trước đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "#Không phải nhờ {F#cô}{M#cậu} giúp đâu! Mà nói chứ, nếu ai gặp chuyện cũng túm một người lạ bên đường để giải quyết thì e là chẳng ai dám ra đường nữa đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "#E hèm, chỉ muốn hỏi xem {F#cô}{M#cậu} có tập thơ nào về tình yêu không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
