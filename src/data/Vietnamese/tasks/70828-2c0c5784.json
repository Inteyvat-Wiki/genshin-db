						"rawParams": [
							"121562",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "(Đưa \"Khúc Ca Ay-Khanoum\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "Woa, cuốn sách đẹp quá! Để tôi xem bên trong viết gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "\"...Chẳng có ngai vàng nào vắng bóng rắn độc, chẳng có đóa hồng nào không mang gai nhọn. Hãy uống cạn nỗi đau đi, Ferigees ơi, rồi dùng đôi mắt ngọt ngào của nàng, cùng ta hứa... hứa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "...Khụ, chữ phía sau đọc là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "#Không được, uyên thâm quá! Lưỡi sắp xoắn lại rồi! Tóm lại tôi mua về đọc dần vậy... Cảm ơn {F#cô}{M#cậu} nhé, nhà mạo hiểm tóc vàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082803",
							"2"
						],
						"stepId": 7082803,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_GREATER",
						"rawParams": [
							"121563",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "(Đưa \"Điển Luật Về Tình Yêu, Khải Huyền Và Đức Hạnh\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "À, tôi từng nghe qua cuốn này! Là tập thơ của Giáo Hội Tây Phong, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "Để tôi xem... \"Linh hồn nàng như cánh đồng rực cháy, hướng về gió cất tiếng ca nồng nàn. Giữa muôn vì sao, ánh trăng và mặt trời, đã làm lu mờ ánh sáng của ta...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "Viết cái gì vậy, thật đáng sợ. Hơn nữa người của Giáo Hội Tây Phong nhìn là biết không biết làm thơ, sao lại có chuyện sao, trăng và mặt trời cùng xuất hiện được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "#Tốt, có tự tin rồi! Tiểu thư đây thế nào cũng viết hay hơn tác giả của tập thơ này! Cuốn sách này tôi sẽ mua, cảm ơn {F#cô}{M#cậu} nhé, nhà mạo hiểm tóc vàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082804,
			"completionStepIds": [
				7082804
			],
