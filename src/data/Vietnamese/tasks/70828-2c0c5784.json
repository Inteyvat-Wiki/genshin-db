				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "(Đưa \"Giấc Mơ Của Rhonabouillet\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "Ồ, tập thơ của Fontaine đây mà! Để tôi xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280403,
					"content": "...Quay về quá khứ... Vương triều của Kỵ Sĩ Nước Trong... Và yêu ngay từ cái nhìn đầu tiên với thị nữ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280404,
					"content": "Cười chết mất, sao lại có người ngốc thế này chứ! Rõ ràng có cơ hội quay về quá khứ, thế mà trong đầu chỉ nghĩ đến chuyện tìm người cùng tuổi với tổ tiên mình để yêu đương!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280405,
					"content": "Đây chẳng phải thơ tình sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280406,
					"content": "#Haiz, tôi hiểu rồi, tình yêu đúng là làm người ta mụ mị. Tóm lại tôi mua về đọc dần vậy... Cảm ơn {F#cô}{M#cậu} nhé, nhà mạo hiểm tóc vàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082805",
							"2"
						],
						"stepId": 7082805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "#Haha, cảm ơn nhé, nhà mạo hiểm tóc vàng! {F#Cô}{M#Cậu} đúng là đại đại đại anh hùng của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280502,
					"content": "Bây giờ tôi thấy cảm hứng trong đầu giống như cuồng phong của Phế Tích Phong Long, chướng khí ở Trầm Ngọc Cốc, sấm sét ở Đảo Seirai, đang gào thét tuôn trào vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280503,
					"content": "Nghe nguy hiểm thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "#Hừm, {F#cô}{M#cậu} cứ đợi đi! Tôi sẽ viết chúng ra ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280505,
					"content": "Mấy bài thơ cổ lỗ sĩ của Linus chẳng thấm vào đâu, đợi khi kiệt tác vĩ đại của tôi hoàn thành, tất cả quán rượu ở Teyvat đều sẽ sôi sục vì tiểu thư đây cho mà xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
