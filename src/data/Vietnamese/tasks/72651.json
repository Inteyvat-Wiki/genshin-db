					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510203
					]
				},
				{
					"id": 726510203,
					"content": "Bạn là...Nhà Lữ Hành? Ôi, bạn đến thật đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510204
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510204,
					"content": "Tôi có một mối làm ăn lớn! Có thể kiếm được rất nhiều Mora, không biết bạn có hứng thú không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510205,
						726510206
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510205,
					"content": "Vậy sao bạn không tự làm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510207
					]
				},
				{
					"id": 726510207,
					"content": "Bạn đừng cảnh giác như vậy, bạn thấy đó, tôi chỉ là một người bình thường muốn đến Inazuma kiếm chác chút đỉnh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510208
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510208,
					"content": "Không phải Inazuma phong tỏa rồi sao, tôi tìm một vài người bạn tốt cùng nghĩ cách, làm một chiếc thuyền, chuẩn bị vượt biển đến Inazuma...",
					"roleType": "TALK_ROLE_NPC",
