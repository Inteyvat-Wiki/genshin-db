					"Ulman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726510101,
					"content": "Ơ, lẽ nào tôi là \"thể chất hấp dẫn Tiên Linh\" gì đó thật sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510102,
					"content": "Bạn...Nhà Lữ Hành? Sao bạn cũng ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510103,
						726510106
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510103,
					"content": "Bạn là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510104
					]
				},
				{
					"id": 726510104,
					"content": "Tôi à! Ulman, không phải hai chúng ta từng hợp tác đi tìm kho báu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510105
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510105,
					"content": "Ôi, \"Tiên Linh Tầm Bảo\"! Nhớ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510108,
					"content": "Sao bạn lại đến Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510109
					]
				},
				{
					"id": 726510109,
					"content": "Ừm...Lần trước khi hai chúng ta hợp tác, không phải bạn đã giúp tôi tìm được rất nhiều Tiền Xu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510110
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510110,
					"content": "Tôi dùng số Tiền Xu đó kiếm được không ít Mora, hihi, vẫn phải cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510111
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510111,
					"content": "Nhưng bạn cũng biết đó, những thứ phải chi tiêu cũng nhiều, chút Mora cũng không đủ dùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510112
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510112,
					"content": "Nhưng tôi không có \"Tiên Linh Tầm Bảo\", cũng không có bạn giúp, nên không thể tìm được Tiền Xu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510113
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510113,
					"content": "Cho nên, tôi muốn tìm cách khác để kiếm tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510114
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510114,
					"content": "Tôi nghe một người...ừm...đồng nghiệp trước nói, Inazuma có kho báu ở khắp nơi, nên muốn đến thử vận may.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510115
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510115,
					"content": "Bạn có biết Inazuma phong tỏa rồi không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510116
					]
				},
				{
					"id": 726510116,
					"content": "Đương nhiên là biết, nhưng mà...hihi, tôi có con đường riêng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510117
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510117,
					"content": "Tôi có nói chuyện với những người \"bạn tốt\" của tôi, và chi một chút tiền để làm một chiếc thuyền, chuẩn bị đi thuyền đến Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510118
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510118,
					"content": "Nhưng mà, ừm...nhưng càng đến gần Inazuma, thời tiết càng kỳ lạ, vừa gió bão vừa sấm sét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510119
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510119,
					"content": "Sau đó, đột nhiên một luồng sét đánh ngay vào thuyền của tôi, thuyền bị vỡ, tôi cũng rơi xuống biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510120
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510120,
					"content": "Một vài con sóng ập đến, tôi uống vài ngụm nước rồi ngất đi, khi tỉnh dậy thì đã nằm trên bãi biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510121
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510121,
					"content": "Bạn thật may mắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510122
					]
				},
				{
					"id": 726510122,
					"content": "Hahaha, chứ sao, vận may của tôi trước nay vẫn không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510123
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510123,
					"content": "Hơn nữa...ừm...nói sao nhỉ, sau khi lên bờ, tôi đi tìm khắp nơi, kết quả là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510124
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510124,
					"content": "Kết quả là lại gặp tên nhóc này, nó còn dẫn tôi đi tìm mấy kho báu, tôi nghĩ có lẽ nó cũng là \"Tiên Linh Tầm Bảo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510125
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510125,
					"content": "Nó cũng giống tên nhóc trước đây, tìm được mấy kho báu thì nghỉ ngơi, chỉ loanh quanh bên cạnh tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510126
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510126,
					"content": "Lại là tiên linh này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510127
					]
				},
				{
					"id": 726510127,
					"content": "Tôi cũng không biết tại sao, lẽ nào tôi là \"tố chất hấp dẫn Tiên Linh\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510128
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510128,
					"content": "Hoặc là trên người tôi có thứ gì đó đặc biệt hấp dẫn nó? Tôi cũng không rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510129
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510129,
					"content": "Nhưng tóm lại, đã đến Inazuma thì không thể công cốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510130,
					"content": "Theo như tôi thăm dò, xung quanh có khá nhiều kho báu, tôi ghi lại hết trong sổ tay rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510131
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510131,
					"content": "Nhưng tên nhóc này hình như không chịu nổi nữa, một mình tôi tìm hết số kho báu này cũng khá tốn sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510132
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510132,
					"content": "Nhà Lữ Hành, nếu bạn có hứng thú thì hợp tác với tôi nữa đi, \"Tiên Linh Tầm Bảo\" của bạn chắc vẫn chịu làm chứ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510133
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510133,
					"content": "Vẫn quy tắc cũ, tôi đánh dấu những nơi có kho báu cho bạn, bạn tìm giúp tôi, báu vật tìm được thuộc về bạn, tôi không lấy gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510134
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510134,
					"content": "Nhưng nếu tìm được Tiền Xu thì đưa cho tôi, hihi, tôi sẽ ra một cái giá thật tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510135
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510135,
					"content": "Hy vọng thật sự là giá tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510136
					]
				},
				{
					"id": 726510136,
					"content": "Đương nhiên rồi, bạn và tôi từng hợp tác rồi mà, yên tâm tin ở tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510137
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510137,
					"content": "Sổ tay đây, chúc bạn tầm bảo vui vẻ, và chúc chúng ta hợp tác vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510106,
					"content": "Bạn là \"Tiên Linh Tầm Bảo\" kia sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510107
					]
				},
				{
					"id": 726510107,
					"content": "Đúng vậy, là tôi, Ulman. Không phải hai chúng ta từng hợp tác đi tìm kho báu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510108
					],
					"speakerTitle": "Ulman"
				}
			]
		},
