					"nextDialogs": [
						726510215
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510215,
					"content": "Lại gặp ngay tên nhóc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510216
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510216,
					"content": "Tiên, Tiên Linh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510217
					]
				},
				{
					"id": 726510217,
					"content": "Nói chính xác thì nó là \"Tiên Linh Tầm Bảo\". Theo như tên gọi thì nó là đồng đội dẫn dắt mọi người đi tìm kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510218
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510218,
					"content": "Nhưng không biết tại sao, sau khi đưa tôi đi tìm vài nơi thì đột nhiên bỏ việc, chỉ quanh quẩn ở bên cạnh tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510219
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510219,
					"content": "Tôi nghĩ có lẽ nó thấy tốc độ đào của tôi quá chậm nên muốn đổi người hợp tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510220
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510220,
					"content": "Nhà Lữ Hành, nếu bạn có hứng thú, bạn có muốn trở thành đồng đội hợp tác tầm bảo không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510221
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510221,
					"content": "Tôi không có sở trường giao tiếp với tiên linh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510222
					]
				},
				{
					"id": 726510222,
					"content": "Hahaha, không sao không sao, hình như tên nhóc này rất thích bạn, bạn xem nó nhảy nhót vui vẻ chưa kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510223
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510223,
					"content": "Ừm! Không nói chuyện này nữa, tóm lại bạn muốn thử hợp tác với nó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510224,
						726510225
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510224,
					"content": "Để tôi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510226
					]
				},
				{
					"id": 726510226,
					"content": "Vậy thì quá tốt rồi, hai chúng ta...à không, ba chúng ta bắt đầu mối quan hệ hợp tác từ bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510227
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510227,
					"content": "Quyển sổ này bạn cầm lấy, những nơi đánh dấu trên đó đều là nơi có thể có kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510228
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510228,
					"content": "Không có \"Tiên Linh Tầm Bảo\" giúp đỡ, chắc chắn tôi không thể tìm được kho báu...cho nên, giao cho bạn đấy, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510229,
						726510231
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510229,
					"content": "Kho báu tìm được sẽ thuộc về ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510230
					]
				},
				{
					"id": 726510230,
					"content": "Chuyện này à...Báu vật tìm được sẽ thuộc về bạn, tôi không lấy gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510233
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510233,
					"content": "Nhưng trong lúc đào kho báu, đôi lúc sẽ xuất hiện \"Tiền Xu\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510234
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510234,
					"content": "Nếu thấy \"Tiền Xu\" thì đưa cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510235
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510235,
					"content": "Mặc dù thương nhân bình thường sẽ không thu thứ này, nhưng tôi sẽ trả giá tốt để mua chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510236
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510236,
					"content": "Vậy thì bạn cầm quyển sổ này đi, đem theo tên nhóc này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510237
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510237,
					"content": "Chúc bạn đào kho báu vui vẻ, và...chúc chúng ta hợp tác vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510231,
					"content": "Kho báu tôi và bạn chia đôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510232
					]
				},
				{
					"id": 726510232,
					"content": "Ồ, không ngờ bạn cũng hiểu quy tắc nhỉ...ừm, nhưng số kho báu đó tôi sẽ không lấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726510233
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 726510225,
					"content": "Hy vọng nó sẽ thích tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510226
					]
				},
				{
					"id": 726510206,
					"content": "Nghe có vẻ rất đáng ngờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726510207
					]
				}
			]
		}
	]
}