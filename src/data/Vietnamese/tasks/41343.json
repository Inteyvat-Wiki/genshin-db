			"dialogs": [
				{
					"id": 413430301,
					"content": "Cảm ơn bạn, tiếp theo chúng tôi cần ghi điều ước lên Đèn Tiêu đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430302,
					"content": "Ừm... Ra là vậy, nên viết gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430303,
					"content": "Vậy có lẽ là được rồi, hãy để Đèn Tiêu mang điều ước bay lên cao nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430304,
					"content": "Khi chúng tôi ở Mondstadt, chúng tôi sẽ nói điều ước của mình cho bồ công anh nghe, sau đó bồ công anh sẽ bay theo gió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430305,
					"content": "Đột nhiên em thấy nhớ Mondstadt quá, với cũng lâu rồi chưa được nhìn thấy bồ công anh nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430306,
					"content": "Nhà Lữ Hành, có thể giúp tôi tìm một ít hạt bồ công anh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430307,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "Thật tốt quá, cảm ơn bạn đã giúp đỡ. Tìm được hạt giống Bồ Công Anh thì đưa đến chỗ chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
