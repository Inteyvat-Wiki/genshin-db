			"dialogs": [
				{
					"id": 413430101,
					"content": "Nhưng mà Đèn Tiêu phải làm như thế nào... Chị, chị có biết không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430102,
					"content": "Chị không biết, cái này có thể nhờ người ta làm giúp mình được không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430103,
					"content": "Các bạn cũng muốn thả Đèn Tiêu sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "Đúng vậy... Tôi cũng rất tò mò về lễ hội này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430105,
					"content": "Chúng tôi vốn dĩ muốn đến đây thưởng thức ẩm thực trong Tết Hải Đăng trước, nhưng Geri nói muốn thả Đèn Tiêu để cảm nhận trọn vẹn không khí lễ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430106,
					"content": "Là... là như vầy! Em muốn cảm nhận không khí ngày lễ trước, rồi mới ăn thức ăn lễ hội, như vậy mới có trải nghiệm tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430107,
					"content": "Với lại tôi nghe nói thả Đèn Tiêu còn có thể cầu nguyện nữa... Nhưng hai người chúng tôi lại không biết làm Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430108,
					"content": "Nhà Lữ Hành, có thể giúp chúng tôi làm Đèn Tiêu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430109,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "Vậy phiền bạn nhé, chúng tôi sẽ đợi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
