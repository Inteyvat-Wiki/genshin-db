					"speakerTitle": "Geri"
				},
				{
					"id": 413430502,
					"content": "Cũng không biết người nhà hiện giờ thế nào rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430503,
					"content": "Ừm, vậy chúng ta tranh thủ cơ hội này... chị ơi, chị có ước nguyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430504,
					"content": "Chị à? Để chị suy nghĩ thử ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430505,
					"content": "Vậy có lẽ là được rồi, Nhà Lữ Hành, tôi còn có việc cần nhờ bạn chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430506,
					"content": "Hạt bồ công anh phải rải ở chỗ cao, nhưng địa hình của Liyue khác biệt với Mondstadt quá, tôi và Geri không thể leo lên chỗ cao như vậy được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430507,
					"content": "Bạn có thể giúp tôi đến chỗ cao rải bồ công anh được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "Freki"
				},
				{
