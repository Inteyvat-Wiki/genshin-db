				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "Vòng tay đẹp quá! Bình hoa đẹp quá! Hàng hóa ở Liyue trông đẹp thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460102,
					"content": "...Không được! Thân là tiểu thuyết gia mà dùng những từ ngữ đơn điệu thế này thì hơi không ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460103,
					"content": "Mua chiếc bình sứ tay nghề tinh xảo này làm tài liệu tham khảo cho tiểu thuyết thì tốt biết mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460104,
					"content": "Ừm... ghi lại tình tiết này vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460105,
					"content": "\"Chìa khóa để giải quyết vấn đề, không ngờ lại là Vision nằm trong bình hoa...!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460106,
					"content": "Nghe hay thật! Anh thấy thế nào hả Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460107,
					"content": "Tôi thấy bình thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460109,
					"content": "...Tôi thấy nếu viết chi tiết về bình hoa quá thì sẽ dễ bị phát hiện sớm, còn nếu viết qua loa quá thì khi giải quyết vấn đề sẽ lại hơi đột ngột.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460110,
					"content": "Ừm ừm, anh nói đúng lắm! Để tôi ghi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460111,
					"content": "À! Chúng ta qua chỗ khác xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460112,
					"content": "Còn nữa, tôi đã nói bao nhiêu lần rồi, đừng gọi tôi là đại nhân nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460113,
					"content": "À ừm? Nghĩ lại thì, hai vị lữ hành bình thường, nhưng một người trong đó lại gọi người còn lại là \"đại nhân\", tình tiết này cũng hơi thường thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "Phù... thật thú vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460202,
					"content": "Không hổ danh là thư viện lớn nhất của Bắc Lục! Không ngờ lại có cơ hội đọc một mạch hết quyển \"Vera Sầu Muộn\"! Quá xá đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460203,
					"content": "Đại nhân Sumida xin hãy nhỏ tiếng lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460204,
					"content": "Ối, xin lỗi, tại tôi hưng phấn quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460205,
					"content": "Không, tôi sợ đại nhân bị thương thôi. Thủ thư đó có sức áp bức ghê lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460206,
					"content": "Ủa vậy hả? Tôi lại thấy đó chỉ là một ma nữ điển hình, hơi lười nhác thôi à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460207,
					"content": "...Ừ nghĩ kỹ lại thì, những nhân vật trông bình thường mới là người mạnh nhất thì phải. Không được, không thể chọc giận cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460208,
					"content": "A đúng rồi, có lý, lần sau cứ lấy nhân vật như vậy làm trung tâm, viết một tác phẩm mới được. \"Cô Phù Thủy Trong Thư Viện\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460209,
					"content": "Cuộc hành trình của các bạn thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "Lâu rồi không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460211,
					"content": "#Í, là {NICKNAME} trong truyền thuyết sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460212,
					"content": "Hành trình sao...trước đây tôi cũng thường hay ra ngoài du lịch để tìm đề tài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460213,
					"content": "\"Để viết về tai họa sấm sét nên đã đến Hẻm Núi Musoujin\", \"để viết về yêu xà nên đã đến Đầu Thần Rắn\", \"để viết về cuộc sống của kẻ phóng điện nên đã mời Kama nhập ngũ\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460214,
					"content": "Kama...đúng là cuộc sống không dễ dàng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "Cũng không có gì to tát hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460216,
					"content": "Nhưng, lần này là hành trình thực sự, là một cuộc đi xa chưa có đích đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460217,
					"content": "Nó khiến tôi phát hiện thật sự có rất nhiều chuyện thú vị đáng để viết thành tác phẩm, giống với quyển \"Hành Trình Của Kino\" vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460218,
					"content": "Tôi và Kama cùng nhau thăm thú những thắng cảnh và cửa hàng mà người địa phương giới thiệu. Sau đó thì cắm trại ngoài trời, cùng chia sẻ nhiều câu chuyện bên lửa trại với những lữ khách xa lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460219,
					"content": "Khi thức dậy thì phát hiện vật dụng mang theo đều đã bị trộm sạch rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460220,
					"content": "...Không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "Không sao. Lúc tìm thấy bọn trộm đó mới biết chúng có tận mười mấy người, tôi còn tưởng sẽ không thể lấy lại được cơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460222,
					"content": "Nhưng không ngờ Kama tìm được cách thuyết phục chúng, lấy lại được toàn bộ tiền, còn được tặng kèm rất nhiều đồng xu kỷ niệm có hình con quạ nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460223,
					"content": "Rõ ràng có thể viết thành nhiều tình tiết thú vị, nhưng Kama không chịu kể lại quá trình cho tôi nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460224,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "Là chuyện nên làm thôi. Sumida đại nhân không cần bận tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460227,
					"content": "Không, Kama rất đáng tin cậy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460228,
					"content": "Có anh đi cùng, thì cho dù có đi đến tận cùng thế giới cũng không có vấn đề gì đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460229,
					"content": "Với lại, tôi cảm thấy, anh đã thay đổi rất nhiều từ khi ở Đảo Tsurumi đấy. Anh đã có chuyện mà mình muốn làm, cũng như đã biết nghi ngờ và nêu quan điểm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460230,
					"content": "Nếu Sumida đại nhân cảm thấy không ổn thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460231,
					"content": "Tôi thấy như vậy rất tốt! Suy nghĩ của anh rất đáng để tham khảo đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460232,
					"content": "Vậy thì, tôi không làm phiền nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#Ừm, tạm biệt {NICKNAME}. Hãy để chúng ta gặp lại nhau khi kết thúc tất cả, như trong \"Cổ Tích Về Công Chúa Fischl\" đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460235,
					"content": "#{NICKNAME}, cám ơn. Hãy cẩn thận nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460233,
					"content": "Có lẽ chúng ta sẽ gặp lại nhau ở một nơi khác!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "Kama có bản lĩnh thật sự!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
