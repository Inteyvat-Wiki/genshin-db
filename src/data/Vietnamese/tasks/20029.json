			"dialogs": [
				{
					"id": 200290201,
					"content": "Xin chào, có việc gì thế? Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290202,
					"content": "Về món quà thích hợp tặng cho các bạn nhỏ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "Món quà tặng cho các bạn nhỏ... để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290204,
					"content": "Ừm... thật ra, dạo gần đây tôi đang thử làm một vài món đồ chơi nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290205,
					"content": "Nhưng làm những món đồ chơi đó, cần phải dùng rất nhiều Quả Móc Câu để nhuộm màu, nhưng tôi đã dùng hết Quả Móc Câu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290206,
					"content": "Mặc dù tôi đã nhờ Schuster đi ra bên ngoài tìm một ít Quả Móc Câu, nhưng đến bây giờ anh ta vẫn chưa trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290207,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi đi ra bên ngoài tìm Schuster không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290208,
					"content": "Có đủ Quả Móc Câu, chắc chắn tôi sẽ làm được những món đồ chơi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290209,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "Schuster nói sẽ đến <color=#00E1FFFF>gần Lang Lãnh</color> để hái Quả Móc Câu, bạn có thể đến đó tìm Schuster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290212,
					"content": "Vậy thì nhờ bạn nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290210,
					"content": "Schuster đi đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
		{
