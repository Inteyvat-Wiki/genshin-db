					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290401,
					"content": "Bạn đã lấy được quà chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290402,
					"content": "Anh sẽ làm gì khi trở về?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "Làm gì? Thì...chắc chắn là nghe theo lệnh của cấp trên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290404,
					"content": "Haiz, nếu không may, nói không chừng lại bị vứt đến một nơi khỉ ho cò gáy nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290405,
					"content": "Dù thế nào đi nữa, đừng vứt tôi đến Inazuma là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290406,
					"content": "Sao đột nhiên anh lại bị điều đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "Còn có thể là gì nữa, đương nhiên là vì... chuyện... Signora đại nhân... hi sinh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290408,
					"content": "Ôi, một người ở cấp bậc như tôi, cứ nghe theo lệnh của cấp trên là được, nghĩ nhiều như vậy làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290409,
					"content": "Lily đi đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "Tôi nghe Rudolf nói với Lily là muốn đưa Lily đến quảng trường chơi hay gì đó...",
