			"dialogs": [
				{
					"id": 200290101,
					"content": "Phù...cuối cùng cũng có thể về rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290102,
					"content": "Anh sắp về nước sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "Hả? Là bạn à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290104,
					"content": "Đúng vậy, gần đây tôi mới nhận được lệnh của cấp trên, kêu tôi trở về Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290105,
					"content": "Nói cái gì mà... tôi bị điều đến dưới trướng một Quan Chấp Hành đại nhân khác, tạm thời không cần ở Mondstadt chờ lệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290106,
					"content": "Cũng không biết rốt cuộc tôi sẽ bị điều đến đâu, nhưng tuyệt đối đừng là \"Scaramouche\" nha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290107,
					"content": "Khi nào anh đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "Cấp trên chưa nói, chỉ nói tôi dọn dẹp đồ đạc trước, đến khi có lệnh là xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290109,
					"content": "Ôi, cuối cùng cũng có thể rời khỏi nơi tồi tàn này, sẽ không cần phải chịu đựng ánh mắt dò xét của những tu nữ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290110,
					"content": "À đúng rồi, Nhà Lữ Hành, chúng ta hợp tác cũng lâu rồi, bạn giúp tôi thêm một việc cuối cùng được không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290111,
					"content": "Vẫn như cũ, bạn giúp tôi, tôi trả thù lao, tuyệt đối không để bạn làm không công đâu, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290112,
					"content": "Anh lại muốn kể chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Hahaha, những câu chuyện về Fatui có thể kể tôi đều đã kể hết cho bạn nghe rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290115,
					"content": "Lần này bạn giúp tôi, tôi sẽ trả thù lao bằng vàng bạc cho bạn, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290116,
					"content": "Trừ khi, bạn muốn nghe những câu chuyện cổ tích mà tôi hay kể cho Lily nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290117,
					"content": "Anh cần tôi giúp gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "Ừm... thật ra chuyện lần này tôi muốn nhờ bạn giúp cũng có liên quan tới Lily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290121,
					"content": "Ngoài bạn ra, cả Mondstadt này, người chịu nghe \"Chú Fatui Xấu Xa\" tôi đây nói chuyện chắc chỉ có Lily thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290122,
					"content": "Tôi sắp đi rồi, chắc là sau này sẽ không còn cơ hội trở lại Thành Mondstadt nữa... tôi muốn tặng một món quà cho Lily làm kỷ niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290123,
					"content": "Nhưng bạn cũng biết đó, nếu tôi một mình lên phố mua đồ, không biết phải tốn bao nhiêu bạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290124,
					"content": "Vì vậy, vụ này nhờ bạn nhé, nhà lữ hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290125,
					"content": "Bạn đến chỗ Marjorie, xem giúp tôi có món quà nào thích hợp để tặng cho trẻ con không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290118,
					"content": "Anh vẫn còn chơi với Lily sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Tôi chỉ thỉnh thoảng... thỉnh thoảng chơi cùng Lily thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290113,
					"content": "Ở chỗ anh có rất nhiều những câu chuyện về Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
		{
