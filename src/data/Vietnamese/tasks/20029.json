					"speakerTitle": "Viktor"
				},
				{
					"id": 200290904,
					"content": "Hừm, bạn không nói tôi cũng biết. Trong Thành Mondstadt có ai tin tưởng một Fatui như tôi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290905
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290905,
					"content": "Khi nào anh xuất phát?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290906
					]
				},
				{
					"id": 200290906,
					"content": "Vẫn chưa có lệnh chính thức, tôi chỉ dọn dẹp đồ đạc trước thôi, một thời gian nữa tôi sẽ đến khách sạn Goth ở, sẵn sàng lên đường bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290907
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290907,
					"content": "Vẻ mặt nghiêm túc thế này, không phải bạn muốn nói lời tạm biệt với tôi thật chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290908,
					"content": "Không đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290909
					]
				},
				{
					"id": 200290909,
					"content": "Hừm, cũng đúng thôi, chúng ta cũng không phải bạn bè gì, chẳng qua chỉ là đồng đội hợp tác tạm thời thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290910
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290910,
					"content": "Sau này bạn đến Snezhnaya, có thể đến tìm tôi, chúng ta có thể tiếp tục hợp tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290911
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290911,
					"content": "Được rồi, không nói nhiều nữa, đây là thù lao của bạn, nhận lấy đi. Đây là \"trao đổi bình đẳng\" cuối cùng của chúng ta ở Thành Mondstadt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290912
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290912,
					"content": "Haiz, hy vọng sau khi quay về, sẽ không phải nhận những nhiệm vụ rắc rối nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
