			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "Huhu... Không thể nào viết luận văn được, phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100102,
					"content": "Bạn sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "Tôi... Í? Là bạn à! Bạn còn nhớ tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100104,
					"content": "Là người đó, người... bị Đạo Bảo Đoàn nhốt trong lồng ở Thần Luật Quan... Haha... Dù sao thì cũng cảm ơn bạn đã cứu tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100105,
					"content": "Sao bạn lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "Ai da, sau lần được bạn cứu, tôi đã đến Nhà Trọ Vọng Thư tìm tiểu thư Soraya, tôi đã may mắn tìm thấy cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100107,
					"content": "Tiểu thư đúng là người tốt, không chỉ mời tôi ăn, mà còn giúp tôi sắp xếp tư liệu thu thập được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100108,
					"content": "Nhưng mà... Sắp xếp gần xong cô ấy mới nói với tôi, đề tài mà tôi chọn, trong Giáo Viện đã có rất nhiều người từng viết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100109,
					"content": "Trừ khi tôi viết thật xuất sắc, nếu không chắc chắn sẽ không qua được... Cô ấy đề nghị tôi viết từ một góc độ khác, như là lực nguyên tố chẳng hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100110,
					"content": "Nhưng tôi lại không có \"Vision\", không thể sử dụng lực nguyên tố, không biết làm thể nào để viết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100111,
					"content": "Nên tôi đành phải vào thành để thử vận may trước, xem có thể tìm được thêm chút tư liệu hay gì đó không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100112,
					"content": "Khoan đã... Trước đây, lúc bạn cứu tôi, hình như cách đánh rất đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100113,
					"content": "Bạn có Vision sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100114,
					"content": "Tôi không có Vision...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "Ơ? Không có Vision cũng có thể dùng cách đánh này sao? Rốt cuộc đây là nguyên lý gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100116,
					"content": "Không, bất kể là nguyên lý gì, hẳn là một nguyên lý rất phức tạp... Tóm lại, tôi có chuyện muốn nhờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100117,
					"content": "Bạn có thể cho tôi xem lại cách đánh của bạn được không? Nói không chừng tôi có thể tìm thấy một số chi tiết hữu ích để hoàn thiện bài luận văn của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100118,
					"content": "Làm ơn, làm ơn, nếu tôi không hoàn thành luận văn, trở về Giáo Viện tôi sẽ tiêu đời mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100119,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "Cảm ơn bạn! Vậy chúng ta đến dã ngoại đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100121,
					"content": "Trước đây tôi có để ý một chỗ ở của Hilichurl, bạn có thể lấy bọn chúng làm mục tiêu để thể hiện cách đánh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100122,
					"content": "Giáo Viện... đáng sợ vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "Vô cùng vô cùng đáng sợ... Nếu mơ thấy, chắc chắn tôi sẽ tỉnh dậy trong nước mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100124,
					"content": "Tôi thà bị Đạo Bảo Đoàn nhốt trong lồng, còn hơn phải bảo vệ và sửa luận văn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100125,
					"content": "Được rồi được rồi, đừng nhắc đến Giáo Viện nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100126,
					"content": "Trước đây tôi có để ý một chỗ ở của Hilichurl, bạn có thể lấy bọn chúng làm mục tiêu để thể hiện cách đánh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
