			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "Woa... Cách đánh của bạn đặc biệt thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100202,
					"content": "Đúng rồi, tôi nghe nói người có Vision còn có thể cảm nhận được dấu vết của nguyên tố, gọi là Góc Nhìn Nguyên Tố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100203,
					"content": "Tuy bạn không có Vision, nhưng lần trước tôi thấy bạn sử dụng sức mạnh nguyên tố, chắc bạn cũng có năng lực đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100204,
					"content": "Hihi, lúc nãy tôi phát hiện quanh đây có Slime, làm ơn... hãy dùng góc nhìn nguyên tố để tìm bọn chúng cho tôi xem với.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "Hahaha... Với người không có Vision như tôi, khi bạn mở góc nhìn nguyên tố cũng không khác gì bình thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100302,
					"content": "Ừm, có lẽ chỉ những người có Vision mới có thể thấy được sự khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100303,
					"content": "Nhưng vẫn cảm ơn bạn đã cho tôi xem nhiều thứ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100304,
					"content": "Ôi, tôi muốn có Vision quá... Tốt nhất là thuộc tính \"Lôi\", vừa ngầu vừa có thể phòng thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100305,
					"content": "Không đúng, Vision thuộc tính lôi là bất khả thi nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100306,
					"content": "Chỉ cần cố gắng sẽ có thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "Không thể nào, Vision thuộc tính lôi dù có cố gắng cũng không thể có được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100308,
					"content": "Ơ? Bạn, bạn không biết sao? Khoảng một năm trước, hình như không ai có được Vision thuộc tính lôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100309,
					"content": "Nghe nói Giáo Viện đã nghiên cứu vấn đề này rất lâu, cuối cùng kết luận là... chuyện không ban Vision cho ai nữa, là ý chí của \"Lôi Thần\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100310,
					"content": "Tôi còn nghe nói rằng \"Lôi Thần\" cai quản Inazuma, còn ban lệnh \"Truy Lùng Vision\". Nói rằng muốn thu lại của tất cả những người có Vision trong Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100311,
					"content": "Nếu người có Vision nào không giao nộp, hình như còn bị phạt nặng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100312,
					"content": "Tuy tôi từng muốn đến Inazuma lấy đề tài này để viết luận văn. Nhưng, nhưng mà... Nghe nói Inazuma rất nguy hiểm, nên tôi chưa dám đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100313,
					"content": "Bạn không có Vision, không sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "Đừng nói tôi như vậy! Vả lại bạn nghĩ xem, người có Vision mà thảm như vậy, thì người không có chẳng phải còn thảm hơn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100315,
