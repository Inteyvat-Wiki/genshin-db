			"dialogs": [
				{
					"id": 705540101,
					"content": "Xin chào Kỵ Sĩ Danh Dự và trợ thủ nhỏ màu trắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540102
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 705540102,
					"content": "Lần đầu gặp mặt, Kỵ Sĩ Danh Dự và đội trưởng Paimon! Tôi là Glenfidia, sẵn sàng nhận lệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540103
					],
					"speakerTitle": "Glenfidia"
				},
				{
					"id": 705540103,
					"content": "Tâm trạng tốt đấy nhỉ, Hertha! Và cả tiểu thư kỵ sĩ này nữa, rất vui được làm quen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705540104,
					"content": "Nhìn mọi người đây, là đang chuẩn bị khai trương rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705540105,
					"content": "Ừ! Nhờ có sự hỗ trợ từ Quà Tặng Của Thiên Sứ và Quán Rượu Đuôi Mèo, mọi thứ ở quầy đồ uống đã sẵn sàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540106
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 705540106,
					"content": "Ngoài đồ uống kinh điển, chúng tôi cũng cung cấp đồ uống pha chế và dịch vụ giao đồ uống hạn giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540107
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 705540107,
					"content": "Đồ uống pha chế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705540108,
					"content": "#Rất lâu trước đây, chúng ta từng làm pha chế tại Quà Tặng Của Thiên Sứ nhỉ? Gần đây {NICKNAME} cũng thể hiện tay nghề vài lần tại Soái Hạm ở Nod-Krai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540109,
						705540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705540109,
					"content": "Đúng vậy, đã lâu lắm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540111
					]
				},
				{
					"id": 705540111,
					"content": "Tuy nhiên, hiện các loại đồ uống đều khá truyền thống, mọi người đã rất quen với chúng từ trước khi chuyến viễn chinh bắt đầu rồi. Để mang đến lựa chọn mới mẻ hơn, chúng tôi dự định cải tiến thực đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540112
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 705540112,
					"content": "Nhưng tôi còn phải quay về xử lý những yêu cầu của cư dân, Glenfidia thì không đủ kinh nghiệm trong việc pha chế đồ uống, còn có những đơn giao hàng cần xử lý nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540113
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 705540113,
					"content": "Nếu Kỵ Sĩ Danh Dự rảnh, liệu có thể tạm thời hỗ trợ chúng tôi không? Sau một thời gian nữa, một nhóm cấp dưới khác của tôi sẽ từ Núi Vọng Phong về thay ca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540114
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 705540114,
					"content": "Đương nhiên là sẽ có thù lao, còn được gấp đôi tiền tăng ca hiệu suất nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540115,
						705540116
					],
					"speakerTitle": "Glenfidia"
				},
				{
					"id": 705540115,
					"content": "Đúng là tôi có kinh nghiệm trong việc pha chế đồ uống.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540117
					]
				},
				{
					"id": 705540117,
					"content": "Tuy không hiểu \"tăng ca hiệu suất\" là như thế nào, nhưng tôi có thể giúp xử lý việc giao hàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705540118,
					"content": "Với tư cách người dẫn đường giỏi nhất Teyvat, tôi cũng phải kịp thời cập nhật, dạo quanh thành phố để tìm hiểu những thay đổi gần đây ở Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705540119,
					"content": "Ôi, hợp tác với hai vị đúng là thuận lợi như việc hít thở vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540120
					],
					"speakerTitle": "Hertha"
				},
				{
					"id": 705540120,
					"content": "Tôi sẽ hết lòng hỗ trợ đội trưởng Paimon. Tôi rất thành thạo các công việc như phân loại và đóng gói đồ uống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705540121
					],
					"speakerTitle": "Glenfidia"
				},
				{
					"id": 705540121,
					"content": "Vậy thì không chậm trễ nữa, bắt tay vào làm thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705540116,
					"content": "Cả quầy đồ uống cứ giao hết cho tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540117
					]
				},
				{
					"id": 705540110,
					"content": "Không nhớ rõ lắm, nhưng không sao cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705540111
					]
				}
			]
		}
	]
}