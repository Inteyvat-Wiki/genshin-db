			"dialogs": [
				{
					"id": 221090301,
					"content": "Sao rồi, tiêu diệt chúng xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090302,
					"content": "Đã tiêu diệt toàn bộ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "Không tệ, đám Hilichurl không đem đến nhiều phiền phức cho bạn chứ? Không sao, tôi chỉ hỏi vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090304,
					"content": "Vẫn không tìm thấy thứ liên quan đến \"kiếm\" sao? Hứ, đúng như dự đoán không có thu hoạch gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090305,
					"content": "Vất vả rồi, đây là phần thưởng, cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090306,
					"content": "Sao lại để ý đến \"kiếm\" như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "...Nói cho bạn cũng không sao. Thanh kiếm gọi là \"Tàng Phong\", cũng là bội kiếm của anh trai tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090308,
					"content": "Thế nhưng khi qua đời, thanh kiếm lại không ở bên cạnh anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090309,
					"content": "Rốt cuộc xảy ra chuyện gì lại khiến thanh kiếm thân thiết với anh ấy như vậy biến mất, tôi cũng không rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090310,
					"content": "Thế nhưng, giờ tôi cũng không biết bắt đầu từ đâu, kiếm không tìm ra, càng không biết anh trai đã gặp phải chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090311,
					"content": "Nói đến đây thôi, mau cầm lấy phần thưởng rồi đi giải quyết việc của bạn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
