			"dialogs": [
				{
					"id": 221090101,
					"content": "Vẫn không có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "Lại là các bạn, xem ra nhiệm vụ của hiệp hội ngày càng nhẹ nhàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090104,
					"content": "Có hứng thú thì tiếp nhận ủy thác cá nhân tôi đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090105,
					"content": "Có rất nhiều Hilichurl cầm theo cung tên tập kết tại Quy Li Nguyên, uy hiếp người qua đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090106,
					"content": "Tuy chỉ là Hilichurl, nhưng số lượng của chúng nhiều kinh khủng, lại đóng chiếm nơi cao, các nhà mạo hiểm khác cũng không làm gì được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090107,
					"content": "Nếu bạn xử lý gọn nhẹ, tiêu diệt bọn chúng. Tôi sẽ cho bạn số tiền thưởng tương ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090108,
					"content": "Còn nữa, nếu tìm thấy món đồ gì có liên quan đến \"kiếm\" thì mang về cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090109,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "Nên nói về bạn hay nói về lòng dũng cảm của bạn đây, nhận nhiệm vụ dứt khoát như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090112,
					"content": "Có điều, nói cách khác, rất giống với một nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090115,
					"content": "Được rồi, không nói chuyện phiếm nữa. Chuẩn bị xong thì đi tiêu diệt đám ma vật đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090110,
					"content": "Hilichurl và kiếm có quan hệ gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "Không sao. Chỉ cần lưu ý một chút. Nếu có thì mang về đây, nếu không có cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090114,
					"content": "Ủy thác lần này nhắm đến việc tiêu diệt Hilichurl, làm xong rồi tôi sẽ trả công cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				}
			]
		},
