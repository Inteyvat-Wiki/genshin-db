			"dialogs": [
				{
					"id": 221090201,
					"content": "Sao rồi, tiêu diệt chúng xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090202,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "Bạn đang chuẩn bị kỹ càng hay là lười nhác vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090204,
					"content": "Hay là cả hai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
