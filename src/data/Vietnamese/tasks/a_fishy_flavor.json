			"dialogs": [
				{
					"id": 220420401,
					"content": "Các ngươi về rồi à. Thật kỳ lạ, đám nhóc đó đột nhiên chạy về với vẻ mặt sợ hãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420402,
					"content": "Không lẽ đã gặp tên lông xù nào đó ở bên ngoài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420403,
					"content": "Nhưng đám nhóc này trở về cũng tốt... ngươi sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420404,
					"content": "Thực ra là tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "...Con người thật khó hiểu! Tại sao lại muốn làm việc này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420406,
					"content": "Muốn chơi với đám nhóc đó thì dùng cách bình thường là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420407,
					"content": "Meo! Chẳng trách đám nhóc đó bị dọa sợ đến vậy... để ta đi an ủi bọn chúng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420408,
					"content": "Thật là, quả nhiên không thể kỳ vọng tất cả mọi người đều giống như Hibiki vậy...",
