			"dialogs": [
				{
					"id": 220420101,
					"content": "Đúng là một đám nhóc không biết nghe lời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "Là các ngươi à, đám nhóc đó lại chạy ra ngoài chơi rồi, càng ngày càng không nên thân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420104,
					"content": "Cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "Ta treo mấy trái banh sắt bên ngoài đền rồi, tụi nó sẽ chạy về nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420107,
					"content": "Đám nhóc đó chơi ở bên ngoài cũng tốt, mắc công chúng lại chơi trước mặt mọi người trong đền thần, làm mất mỹ quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420108,
					"content": "Nhưng nếu chúng cứ chơi từ sáng đến tối, đói meo cả ngày thì cũng không tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420109,
					"content": "Các ngươi hãy giúp ta đem những con cá này cho đám nhóc đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420110,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "Tiếp theo thì hãy đưa bản đồ cho Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220420112,
					"content": "Ừm, ngươi xem ra cũng có chút ngộ tính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420115,
					"content": "Được rồi, các ngươi mau đi đi, ta còn phải ở đây dọn dẹp đền thần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420113,
					"content": "Đây là bản đồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "Ừm, ngươi xem ra cũng có chút ngộ tính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420105,
					"content": "Tôi sẽ phải đi tìm bọn chúng sao?",
					"roleType": "TALK_ROLE_PLAYER",
