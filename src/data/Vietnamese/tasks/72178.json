			"dialogs": [
				{
					"id": 721780101,
					"content": "(Trông có vẻ là miếu thờ rất bình thường, không hề có dấu vết nguyên tố đặc biệt nào.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780102,
					"content": "Điều tra",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(Miếu thờ này trông vẫn rất tốt, có lẽ vừa được chăm sóc kỹ lưỡng không lâu trước. Người dọn dẹp ở đây, chắc là người rất tỉ mỉ.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780104,
					"content": "(Nhưng ngoài ra thì, không thấy dấu vết của ai đã từng đến)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780105,
					"content": "Thật kỳ lạ...Hình như có ai đã từng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
