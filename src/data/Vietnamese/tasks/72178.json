				},
				{
					"id": 721780402,
					"content": "(Trông có vẻ là miếu thờ rất bình thường, không hề có dấu vết nguyên tố đặc biệt nào.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780403,
					"content": "Điều tra",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(Ngôi miếu này giản dị nhưng tao nhã, bàn thờ làm bằng gỗ loáng bóng sáng nhè nhẹ, đón tiếp khách đến tế lễ bằng vẻ trang nghiêm.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780405,
					"content": "(Bên cạnh miếu thờ có rất nhiều cánh hoa Anh Đào Thần, trông không giống như tự nhiên rơi ở đó, mà giống như có người cố tình rắc Tú Cầu Anh Đào ở đây.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780406,
					"content": "Hừm...ở đây cũng không có dấu vết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780407,
					"content": "Nhìn kìa, Tú Cầu Anh Đào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Đúng vậy, Chouji từng nhắc mẹ cậu ấy sẽ cúng thứ này ở miếu thờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780410,
					"content": "Bao nhiêu cánh hoa như vậy xuất hiện ở đây...Lẽ nào không phải ngẫu nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
					"content": "Chúng ta mau về nói với cậu ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780408,
					"content": "Là cống phẩm của mẹ Chouji...",
