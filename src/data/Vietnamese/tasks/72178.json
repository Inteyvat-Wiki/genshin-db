			"dialogs": [
				{
					"id": 721780201,
					"content": "Ở đây cũng có một ngôi miếu, chúng ta đi xem thử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780202,
					"content": "(Trông có vẻ là miếu thờ rất bình thường, không hề có dấu vết nguyên tố đặc biệt nào.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780203,
					"content": "Điều tra",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Ngôi miếu này trông có vẻ rất sạch sẽ gọn gàng, phảng phất hương hoa anh đào. Có lẽ vừa có người cầu nguyện ở đây.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780205,
					"content": "(Nhưng ngoài ra, thì không có thêm dấu vết gì mới hơn nữa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780206,
					"content": "Là hương thơm của cánh hoa đào...Có lẽ là mẹ của Chouji đã từng đến đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780207,
					"content": "Mà còn là không lâu trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
