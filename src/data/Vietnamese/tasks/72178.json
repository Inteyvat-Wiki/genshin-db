					"nextDialogs": [
						721780304
					]
				},
				{
					"id": 721780304,
					"content": "(Ngôi miếu này tuy vật liệu có hơi cũ, nhưng được bảo dưỡng kỹ càng làm cho màu sắc cũng không quá nhạt nhòa, ngược lại càng thêm phần ý vị.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780305
					],
					"speakerTitle": "Miếu Thờ"
				},
				{
					"id": 721780305,
					"content": "Dường như có người thường xuyên đến đây...thường xuyên chăm sóc ngôi miếu này.",
