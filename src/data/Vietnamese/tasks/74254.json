			"dialogs": [
				{
					"id": 742540501,
					"content": "Seymour! Lâu lắm không gặp! Cả Mamere nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540502,
					"content": "Haha, dọc đường Seymour cũng hay nói với tôi là rất nhớ mọi người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540503,
					"content": "Khẳng định. Lúc nào cũng nhớ đến tiểu thư Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "Cũng phải cảm ơn tiểu thư Sandrone đã sẵn lòng tổ chức tiệc trà như thế này, chúng ta mới có cơ hội ngồi lại với nhau và nói về những trải nghiệm trong hành trình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540505,
					"content": "Không có gì. Tôi chỉ nghĩ, dù sao thì mọi người cũng được xem là một gia đình có lịch sử sâu xa. Ừm, chắc là có thể coi như vậy. Nên rảnh rỗi thì tụ tập một chút cũng không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540506,
					"content": "Một gia đình ư? Không biết sao nữa, nhưng tôi rất vui khi nghe cô nói vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540507,
					"content": "Vậy thì Sandrone là... em gái trong nhà nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540508,
					"content": "À... Dù nói là một gia đình, nhưng thôi hãy bỏ qua chuyện vai vế đi nhé...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540509,
					"content": "Khẳng định. Với tư cách là nguyên mẫu do ngài Alain chế tạo, tiểu thư Sandrone nên gọi tôi là \"anh trai\" mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "Chậc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540511,
					"content": "Tuyệt thật đấy. Tôi cũng có thể được coi là thành viên trong gia đình mọi người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540512,
					"content": "Dĩ nhiên rồi, gia đình này xem ra vô cùng đa dạng, thêm một Melusine nữa cũng chẳng có gì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742540513,
					"content": "Khẳng định. Cô Mamere chính là gia đình của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Hihi, vui quá! Vậy thì, để tôi vẽ một bức tranh cho gia đình này nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540515,
					"content": "Tranh gia đình à? Đúng là đã lâu lắm rồi chưa làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540516,
					"content": "Nhớ vẽ tôi trông thật oách nhé! Giống như chị gái trong nhà vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540517,
					"content": "Ừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540518,
					"content": "Hah... Tùy mọi người vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
