			"dialogs": [
				{
					"id": 741850301,
					"content": "Hihi, Osse, sau này đây sẽ là nhà của mi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850302,
					"content": "Meeeow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850303,
					"content": "Nhưng vẫn cảm thấy hơi kỳ lạ. Cassiodor chắc đã rời khỏi đây rồi nhỉ, vậy thì Osse của hiện tại là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850304,
					"content": "Là con mèo lúc chưa bị Cassiodor cư trú, hay là Ngài Os, người cùng chúng ta thám hiểm tất cả...? Chậc, đau đầu quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850305,
					"content": "Paimon không thích hợp để suy nghĩ những vấn đề này đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "Tôi hoàn toàn không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850309,
					"content": "Tóm lại thì chúng ta đã tìm được ngôi nhà mới cho Osse rồi. Sau này nếu có thời gian thì chúng ta sẽ thường xuyên đến chơi với Osse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850310,
					"content": "Meo meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850307,
					"content": "\"Osse\" chính là \"Osse\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "Tuy không hiểu, nhưng cũng thấy rất có lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				}
			]
		}
