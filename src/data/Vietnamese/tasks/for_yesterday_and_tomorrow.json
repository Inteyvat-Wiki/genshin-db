			"dialogs": [
				{
					"id": 741850101,
					"content": "Este, chúng tôi về rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Ồ, thì ra là... Mà đợi đã, hai vị là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850103,
					"content": "#Ơ? Không lẽ anh không nhận ra chúng tôi sao? Chúng tôi là {NICKNAME} và Paimon đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} và Paimon... Đúng là tôi từng nghe qua hai cái tên này, nhưng chắc là trong mơ mới đúng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850105,
					"content": "Ừm... Nhưng lúc đó anh Este rõ ràng rất tỉnh táo mà? Hơn nữa không phải lúc ở bên dưới chúng ta còn gặp được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "Tôi mơ thấy mọi người trong thị trấn đều biến thành tượng đá, chỉ còn một mình tôi không biết làm gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850107,
					"content": "Cho đến khi hai dũng sĩ đến thị trấn mới có thể gánh vác trọng trách giải cứu mọi người... Chẳng lẽ, đó không phải là mơ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850108,
					"content": "Có thể phải cũng có thể không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Ừm, dù sao thì bây giờ mọi người đều đã trở lại bình thường rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "Nhưng hình như mọi người đều mơ thấy những giấc mơ kỳ lạ. Rốt cuộc đã xảy ra chuyện gì, chẳng lẽ chúng tôi bị thôi miên tập thể sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850112,
					"content": "Muốn nói rõ thì e là nói một ngày một đêm cũng không hết mất... Thôi đừng nhắc đến chuyện thôi miên nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Ồ, nói đến thôi miên thì hình như hai vị còn dẫn theo một con mèo nhỉ. Trông nó rất thông minh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850114,
					"content": "Đúng là rất thông minh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "Nó là bạn đồng hành của chúng tôi, nhưng chúng tôi cũng không thể dẫn theo nó đi cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Vậy thì thật trùng hợp, đúng lúc câu lạc bộ chúng tôi còn một căn nhà cho mèo. Từ khi nhà nghiên cứu thuật thôi miên đó dẫn theo mèo của mình đi du lịch thì nơi đó bị để trống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850119,
					"content": "Nếu các vị không chê thì chúng tôi sẽ chăm sóc cho nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850120,
					"content": "Tuy không biết tại sao, nhưng có vẻ như chúng ta có mối duyên phận đặc biệt. Tôi sẽ giúp các vị chăm sóc nó thật tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850121,
					"content": "Nhà mèo ở phía bên kia của căn nhà. Chỉ cần đi qua kia là sẽ thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741850116,
					"content": "Nó là bạn đồng hành của chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "Tuy là vậy, nhưng chúng tôi không thể dẫn theo nó đi cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "Chuyện này không quan trọng nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
