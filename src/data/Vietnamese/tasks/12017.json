			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170501,
					"content": "Chụp xong rồi, bạn xem, đây là những tấm hình vừa chụp cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170502,
					"content": "Ồ... kỳ diệu thật. Đây là một loại phép thuật sao? Bên trong đó... là một phiên bản khác của tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170503
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170503,
					"content": "Nhưng mà cô ấy hình như không thể cử động với nói chuyện được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170504,
						120170505
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170504,
					"content": "Đây là một loại lưu trữ mà thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				},
				{
					"id": 120170506,
					"content": "Ban nãy cứ nghĩ tư thế vẫn còn hơi cứng quá, nhưng mà giờ nhìn lại thì trông cũng rất tự nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170507
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170507,
					"content": "Động tác giống y chang, phong cảnh cũng giống y chang... Làm sao để làm được vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170508
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170508,
					"content": "Đây chính là điểm lợi hại của chiếc máy này đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170509,
					"content": "Đợi đã, tôi vẫn chưa hiểu nguyên lý bên trong lắm, có thể giải thích thêm cho tôi không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170510
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170510,
					"content": "Vậy có nghĩa là, thứ bên trong không phải tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170511,
					"content": "Nếu không phải tôi thì sao lại giống với tôi vậy nhỉ. Nếu như là tôi thì bây giờ tôi là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170512
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170512,
					"content": "#Cái này... vượt quá khả năng giải thích của tôi rồi, giao cho bạn đó {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170513,
					"content": "Có lẽ cũng giống như bạn với Shogun đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170514
					]
				},
				{
					"id": 120170514,
					"content": "Đúng vậy, bạn cảm thấy Shogun có phải là bạn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170515,
					"content": "Đương nhiên rồi, tôi trước giờ chưa từng có ý định giao Inazuma cho người khác quản lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170516,
					"content": "Vậy bạn hiện giờ là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170517,
					"content": "Nói vậy có nghĩa là tôi vẫn là tôi, đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170518
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170518,
					"content": "\"Bạn\" không nhất định phải là sự tồn tại duy nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170519
					]
				},
				{
					"id": 120170519,
					"content": "Sự tồn tại của \"tôi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170520
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170520,
					"content": "Có vẻ tôi đã hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170521
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170521,
					"content": "Tôi chính là tôi, chỉ có một, nhưng có thể sẽ có vô số hình thức tồn tại, và tôi tồn tại trong hình thức nào cũng đều không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170522
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170522,
					"content": "Như Shogun là một sự tồn tại khác của tôi, cô ấy rốt cuộc có phải là tôi hay không sẽ không quyết định bởi bản chất của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170523
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170523,
					"content": "Chiếu theo lý này thì người trong bức ảnh đó là một sự tồn tại khác của bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170524,
					"content": "Ừm, đến một người truy cầu sự vĩnh hằng như tôi thì ngay cả sự tồn tại cũng không ngừng thay đổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170525,
					"content": "Vậy thì sao tôi lại có thể yêu cầu Inazuma và người dân trong đó phải ngừng thay đổi được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170526,
						120170527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170526,
					"content": "Bản chất của Inazuma không dễ thay đổi như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170528,
					"content": "Đi theo các bạn, kiến thức mà tôi học được thực sự rất mới mẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170529,
					"content": "Haiz, để các bạn phải trông thấy mặt ngu dốt của tôi rồi, nhưng tôi rất cảm kích các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170530
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170530,
					"content": "Những sự vật bây giờ của Inazuma, đã khác quá xa so với ấn tượng thuở ban đầu của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170531,
					"content": "Nhưng mà như vậy tuyệt đối không có nghĩa Inazuma hiện giờ đã không còn là Inazuma nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170532,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170533
					]
				},
				{
					"id": 120170533,
					"content": "Lệnh Truy Lùng Vision, tượng trăm mắt nghìn tay, đó đều là yếu tố thôi thúc cho \"vĩnh hằng\", nhưng nếu tôi càng tiếp cận đến \"vĩnh hằng\" thì mọi thứ đều sẽ không xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170534,
					"content": "À ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170535,
					"content": "Có phải... tôi đã nghiêm khắc quá không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170536
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170536,
					"content": "Xem ra Ei đã thông suốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170537,
					"content": "Tôi cảm thấy chuyến đi này của chúng ta càng ngày càng có giá trị rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170538,
					"content": "Nhị thiếu gia, nhị thiếu gia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170539
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170539,
					"content": "Ấy, ở dưới kia có gì ồn ào vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170540,
					"content": "Hình như là Ippei, anh ta bị gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170541,
					"content": "Đó là người của Hiệp Hội Tenryou sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170542
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170542,
					"content": "Đúng vậy, chúng ta đi hỏi thăm thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170527,
					"content": "Bản chất của con người không dễ thay đổi như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170505,
					"content": "Đây không phải là phiên bản khác của bạn đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				}
			]
		},
		{
			"id": 1201707,
			"completionStepIds": [
				1201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201707",
							"2"
						],
						"stepId": 1201707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ippei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170701,
					"content": "Ippei, có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170702,
					"content": "A, là các bạn sao, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170703
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170703,
					"content": "Úi! Đại, đại nhân Shogun?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170704
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170704,
					"content": "Đại nhân đến đây tìm thiếu gia Kujou Kamaji sao? Xin đại nhân thứ lỗi, thiếu gia hiện giờ không có ở đây, nếu được thì tiểu nhân xin phép được truyền đạt lại lời nói của đại nhân cho thiếu gia ạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170705
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170705,
					"content": "Không cần đa lễ, tôi chỉ đi ngang qua đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170706
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170706,
					"content": "Anh đang tìm nhị thiếu gia nhà anh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170707
					]
				},
				{
					"id": 120170707,
					"content": "Đúng vậy, thật không giấu gì, nhị thiếu gia đi đàm phán đến giờ vẫn chưa về, tôi rất lo cho thiếu gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170708
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170708,
					"content": "Thiếu gia trước giờ cũng có thói quen la cà đây đó, có thể giờ đây cũng đang say sưa ở đâu đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170709
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170709,
					"content": "Nhưng mà không hiểu sao hôm nay tôi bất an lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170710
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170710,
					"content": "Kujou Kamaji, nghe có vẻ như là hậu duệ của nhà Kujou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170711
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170711,
					"content": "Đúng vậy, thành thật xin lỗi. Do bệnh tình của gia chủ đang trở nặng, đại thiếu gia lại thường xuyên ở bên ngoài, giờ đây nhà Kujou đang do nhị thiếu gia Kujou Kamaji làm đại diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170712
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170712,
					"content": "Chuyện Hiệp Hội Tenryou rơi vào hỗn loạn tôi cũng có nghe, chuyện này có liên quan đến Kujou Kamaji sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170713
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170713,
					"content": "Xin đại nhân Shogun thứ lỗi, đây là lỗi lầm của nhà Kujou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170714
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170714,
					"content": "Do danh dự của nhà Kujou bị tổn hại, thế lực suy yếu, còn đại nhân Shogun... À ừm, công việc sau này của Hiệp Hội Tenryou vẫn chưa nhận được quyết sách của đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170715
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170715,
					"content": "Cho nên nhị thiếu gia mới đi thương lượng, xem xem có thể nhờ nhà Takatsukasa chủ trì đại cục không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170716
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170716,
					"content": "Vậy thì phải thương lượng ở hiệp hội mới phải chứ, tại sao lại đến đây để tìm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170717,
					"content": "À, là do lần gặp mặt này có hơi đặc biệt. Thực ra tôi cũng có chút nghi ngờ, nhưng các đại nhân làm việc, tiểu nhân như tôi không dám hỏi han.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170718
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170718,
					"content": "Địa điểm chính là ngọn núi ở gần Đền Narukami, ở đó hình như có doanh trại của nhà Takatsukasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170719
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170719,
					"content": "\"Takatsukasa\"... cũng là một cái tên quen thuộc, đã nhiều năm rồi, họ hẳn vẫn đang trung thành phò trợ cho nhà Kujou chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170720
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170720,
					"content": "Đúng vậy đúng vậy, cũng chính vì thế nên nhị thiếu gia mới phải đi đàm phán, nhưng cho dù bàn chuyện gì đi nữa thì cũng sẽ không lâu đến vậy mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170721
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170721,
					"content": "Tiểu nhân đã tìm khắp thành rồi, nếu thiếu gia vẫn chưa trở về thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170722,
						120170723
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170722,
					"content": "Có lẽ vẫn chưa bàn xong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				},
				{
					"id": 120170724,
					"content": "Đúng vậy, tôi cũng nghĩ đến khả năng này... nhưng với thân phận của tôi thì lại không dám một mình đến \"Nhà Takatsukasa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170725
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170725,
					"content": "Để chúng tôi giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170726
					]
				},
				{
					"id": 120170726,
					"content": "À không cần đâu, có lẽ do tôi lo lắng quá thôi. Nếu như chen ngang vào giữa cuộc thương lượng thì tôi sẽ phải chịu trừng phạt mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170727
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170727,
					"content": "Tuy tôi chỉ là người hầu của nhị thiếu gia, nhưng tôi đã đi theo thiếu gia từ thuở nhỏ, nên tôi rất sợ là... thiếu gia sẽ gặp chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170728
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170728,
					"content": "Tôi không thông minh như thiếu gia nên không thể chia sẻ gánh nặng với thiếu gia được, nhưng tôi không muốn vì sự tắc trách của tôi mà khiến cho nhị thiếu gia gặp nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170729
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170729,
					"content": "Ừm, đại nhân Shogun thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170730,
					"content": "Để tôi đích thân đi xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170731
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170731,
					"content": "Với thân phận của tôi thì cho dù cản trở việc đàm phán cũng sẽ không ảnh hưởng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170732
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170732,
					"content": "Vả lại, căn nguyên vấn đề cũng là do tôi chưa duyệt quyết sách kịp thời, vì vậy nên tôi sẽ ra mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170733,
						120170734
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170733,
					"content": "Rất có trách nhiệm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170735,
					"content": "Tiểu nhân thành thật cảm kích, đa tạ đại nhân tương trợ! Tiểu nhân cũng sẽ đi những nơi khác để tìm thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170736
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170736,
					"content": "Vậy để tôi ký hiệu vị trí doanh trại cho mọi người, hy vọng sẽ nhận được tin tốt của các vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170734,
					"content": "Ngầu quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170723,
					"content": "Có lẽ gặp phải chuyện ngoài ý muốn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				}
			]
		},
