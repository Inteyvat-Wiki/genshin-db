			"dialogs": [
				{
					"id": 120170401,
					"content": "Việc này chính là \"chụp ảnh\" sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170402
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170402,
					"content": "Ừm, không tệ, lại học thêm một thứ mới mẻ rồi. Mau bắt đầu đi.",
					"roleType": "TALK_ROLE_NPC",
