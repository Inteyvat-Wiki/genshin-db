			"dialogs": [
				{
					"id": 120170201,
					"content": "Bây giờ chúng ta cần phải làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170202,
					"content": "Chụp ảnh lưu niệm cho bạn, chuyện thao tác thì để chúng tôi, bạn chỉ cần đứng bên đó tạo dáng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170203,
					"content": "Đơn giản mà nói thì hình ảnh này sẽ lưu lại thời khắc của bạn, dùng để làm kỷ niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170204,
					"content": "Vậy còn tạo dáng là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170205,
					"content": "Là để ghi lại khoảnh khắc đó ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "Ra là vậy, vậy có nghĩa là làm động tác đẹp nhất trước mặt các bạn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170207,
					"content": "Để suy nghĩ thử, ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170208,
					"content": "Phải làm sao nhỉ? Gợi ý cho tôi đi, phải đẹp một chút, nhưng đừng khoa trương quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170209,
					"content": "Vậy tạo dáng đoan trang đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "Vậy... như thế nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170215,
					"content": "Tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "Vậy thì bắt đầu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170219,
					"content": "Chúng ta canh chuẩn góc độ để chụp lại cho cô ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170216,
					"content": "Hoặc là có thể thử kiểu khác cũng được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "Được thôi, chuyện này giao cho bạn quyết định đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170211,
					"content": "Vậy tạo dáng nghiêm túc đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "Không quen lắm, như vậy được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170213,
					"content": "Vậy tạo dáng ngẫu hứng đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "Ngẫu hứng thì như vậy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				}
			]
		},
