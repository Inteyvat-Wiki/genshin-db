					}
				]
			},
			"dialogs": [
				{
					"id": 740820101,
					"content": "(Phần lớn nét chữ đã bị mờ, chỉ có thể mơ hồ đoán ra \"...sương trong... lời ca trên Đường Sương Rừng Rậm...\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "Bia Đá Khắc Chữ"
				},
				{
					"id": 740820102,
					"content": "Chà! Nhiều chữ bị xóa đi quá! Cái này chắc là giới thiệu cảnh quan gì đó nhỉ? Nhiều du khách vô ý thức thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820103,
					"content": "Du khách thì chỉ viết chứ đâu có xóa chữ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#Cũng phải, viết những thứ kiểu như \"{NICKNAME} và Paimon đã từng đến đây\"... À không, chúng ta sẽ không bao giờ viết bậy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820105,
					"content": "Vậy thì kỳ lạ quá, sao chữ lại bị xóa mất chứ? Chỉ còn lại câu này thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820106,
					"content": "Ngay cả câu đằng trước cũng có nhiều vết gạch đi, chắc là chưa xóa sạch. Nhưng còn cụm từ Đường Sương Rừng Rậm sót lại nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820107,
					"content": "Đường Sương Rừng Rậm là nơi nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "Hmm... Là con đường có rất nhiều sương mù ở trong rừng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820109,
					"content": "Cứ cảm thấy nó ẩn chứa bí mật nào đó, chắc sẽ có kho báu quý giá đấy! Trong sách đều viết như vậy mà, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820110,
					"content": "Sách đọc ở quầy báo nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "Tôi không phải người chỉ biết ăn đâu nhé! Tôi có dự cảm là Đường Sương Rừng Rậm này sẽ có kho báu, vậy nên mới bị người ta che giấu đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820113,
					"content": "#{NICKNAME}, khi nào bắt đầu tìm kho báu đây? Hãy dẫn theo người bạn đồng hành tốt nhất, có khứu giác đánh hơi kho báu nhạy bén nhất là tôi đi cùng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820111,
					"content": "Sách đọc ở thư viện nào thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
