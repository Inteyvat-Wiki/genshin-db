			"dialogs": [
				{
					"id": 740820401,
					"content": "(Phần lớn nét chữ đã bị mờ, chỉ có thể mơ hồ đoán ra \"...sương trong... ba...\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Tế Đàn Thần Bí"
				},
				{
					"id": 740820402,
					"content": "Đáng ghét! Chữ viết trên này cũng bị xóa mất rồi. Chắc chắn là có bí mật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "\"Sương trong\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "\"Sương trong\" nghĩa là sao? Là màn sương trong trẻo à? Nhưng quanh đây toàn là nước mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "Về chữ \"ba\" này, là chỉ ba giọt nước sao? Nhức đầu thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Khứu giác kho báu của Paimon đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Khứu giác đã kích hoạt rồi! Tóm... Tóm lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "Tóm lại thì \"ba\" và \"nước\" liên quan đến nhau, chúng ta tìm kiếm ở xung quanh xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "Ba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "Hình như là chỉ ba món đồ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "Về \"sương trong\", lẽ nào là màn sương trong trẻo à? Nhưng quanh đây toàn là nước mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
		},
