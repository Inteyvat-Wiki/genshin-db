			"dialogs": [
				{
					"id": 740821001,
					"content": "Tốt rồi, lại lấy được một chiếc chìa khóa. Tiếp theo chỉ cần tìm chiếc chìa khóa cuối cùng nữa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821002,
					"content": "Chìa khóa, chìa khóa, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821003,
					"content": "Chà, Pahsiv, sao đột nhiên lại xuất hiện thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821004,
					"content": "Không dấu vết, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821005,
					"content": "Được rồi... Cô là Melusine đặc biệt nhất tôi từng gặp đấy... À, tôi nhớ là đa số Melusine đều sống ở Đại Sảnh Fontaine hoặc Làng Merusea... Sao cô lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821006,
					"content": "Đại Sảnh Fontaine? Làng Merusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821007,
					"content": "Trông cô bối rối như vậy... Không lẽ là chưa từng nghe qua hai cái tên này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821008,
					"content": "Đại Sảnh Fontaine, Melusine... Làng Merusea, Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821009,
					"content": "A... Erinnyes, Pahsiv, quê hương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821010,
					"content": "Erinnyes, Pahsiv, bảo vệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821011,
					"content": "Đợi đã, cô nói nơi này là quê hương của mình sao? Và cô đang bảo vệ quê hương à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821013,
					"content": "Nhưng quê hương của Melusine là ở Làng Merusea mà nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821014
					]
				},
				{
					"id": 740821014,
					"content": "Đúng vậy, kỳ lạ thật. Có Melusine sinh ra ở nơi khác sao? Nhưng hình như ở đây không có Melusine nào khác cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821015,
					"content": "Pahsiv sống một mình ở đây đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821016,
					"content": "Một mình? Melusine. Vị khách đó! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821017,
					"content": "Vị... vị khách đó? Còn vị khách nào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821018,
					"content": "#Vị khách đó! Paimon, Paimon, {NICKNAME}, {NICKNAME}, vị khách đó, vị khách đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821019,
					"content": "Vậy thì vị khách đó là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821020
					]
				},
				{
					"id": 740821020,
					"content": "Hình như ý của Pahsiv là vị khách đó tên là \"vị khách đó\", giống như Paimon là Paimon, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821022,
					"content": "Quả nhiên là vậy, tôi đúng là thông minh mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821023,
						740821024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821023,
					"content": "Cái tên này kỳ lạ quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821024,
					"content": "Cái tên này ngầu thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821025,
					"content": "Vị khách đó, Pahsiv, tri thức, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821026,
					"content": "Ừm... Ý là vị khách đó đã giúp cô học hỏi kiến thức đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821027,
					"content": "Pahsiv! Rất nhiều. Ngôn ngữ, trí tuệ... rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821028,
					"content": "Ừm, tôi thấy thực ra cũng không nhiều mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821029,
					"content": "Pahsiv, vị khách đó, bảo vệ, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821030,
					"content": "Vị khách đó cũng đang giúp cô bảo vệ nơi này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821031,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821032,
					"content": "Là cô giúp vị khách đó bảo vệ nơi này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821033
					]
				},
				{
					"id": 740821033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821034,
					"content": "Ra là vậy... Thế vị khách đó rốt cuộc là ai? Tại sao lại cần cô bảo vệ nơi này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821035,
					"content": "Hơn nữa, ở đây đúng là đã xảy ra chuyện không hay. Chúng tôi nhìn thấy chữ trên bia đá bị phá hủy, còn thấy không ít thứ ô uế... Là kẻ địch sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821036,
					"content": "Paimon tò mò, Pahsiv! Nhưng thời gian, còn lại rất ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821037,
					"content": "Chìa khóa, chìa khóa, chìa khóa, quảng trường, tây, ka-pow, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821038,
					"content": "Chúng tôi sẽ tranh thủ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821039
					]
				},
				{
					"id": 740821039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv vui vẻ nhảy tung tăng, sau đó vội vã rời đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740821041,
					"content": "Xem ra không còn nhiều thời gian nữa. Cũng may chúng ta đã có được hai chìa khóa, mau tìm chìa khóa thứ ba thôi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
