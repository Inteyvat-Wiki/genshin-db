			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "Này, em nên sửa cái tính nóng nảy của mình đi. Anh nói vậy cũng là vì muốn tốt cho em thôi. Em cũng đã qua cái tuổi trẻ con rồi, không nghĩ cho chị của mình thì ít ra cũng phải nghĩ cho bản thân chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791702,
					"content": "Rooo, Aroowr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750791703,
					"content": "Em thấy không, nó cũng đồng tình với anh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791704,
					"content": "Trong số chúng ta, nếu có ai đó không hiểu chuyện thì chắc chắn không phải là em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750791705,
					"content": "Ê! Cái thằng nhóc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
