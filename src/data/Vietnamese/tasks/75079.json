			},
			"dialogs": [
				{
					"id": 750791801,
					"content": "Xin lỗi, Quilla, vừa rồi Carrewoof không làm cô bị thương chứ? Nó hiếm khi tỏ ra nhiệt tình với người lạ như vậy, quả là khác thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791802
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750791802,
					"content": "Haha, không sao đâu. Tôi quen với việc tiếp xúc với động vật, nó thân thiện với tôi khiến tôi cảm thấy rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791803
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791803,
					"content": "Nói mới nhớ, Hawka đang rất lo cho cô đấy. Nghe nói tôi sắp đến đây liền nhờ tôi hỏi thăm tình hình của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791804
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791804,
					"content": "Chú Hawka? Sao chú ấy lại quan tâm đến tôi chứ? À, xin lỗi, chúng tôi có chút mâu thuẫn, không phải chuyện gì đáng để nhắc đến cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paran"
				}
			]
		},
