			"dialogs": [
				{
					"id": 750875101,
					"content": "Ở đây chúng tôi còn vài thử thách bay lượn nữa, nội dung cụ thể đều được viết trên bảng thông báo. Nếu có hứng thú thì cứ thử xem, đương nhiên cũng sẽ có phần thưởng tương ứng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875102,
						750875103,
						750875104
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875102,
					"content": "Về Học Viện Bay Pakpaka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875105
					]
				},
				{
					"id": 750875105,
					"content": "#Thực ra tôi cũng không biết tại sao lại có cái tên này. Nhắc đến Pakpaka... {F#Cô}{M#Cậu} đã từng nghe câu chuyện về Kuntur và phù thủy Rumi chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875106
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875106,
					"content": "Chiến binh bộ tộc đã thua phù thủy Rumi, bị biến thành Pakpaka... Nghe không giống chuyện tốt đẹp gì nhỉ? Nhưng Pakpaka thực sự bay rất nhanh, ai mà biết được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875103,
					"content": "Về Lamizana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875107
					]
				},
				{
					"id": 750875107,
					"content": "Haha... Anh ta là một cao thủ, nhưng không giỏi dạy người khác. Làm đối thủ thi bay thì... cũng ổn chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875108
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875108,
					"content": "Nếu không phải do bay lượn kém thì ai lại mò đến đây chứ? Lúc này nếu quá nghiêm khắc thì... Haiz, lúc trước cũng không phải chưa từng xảy ra chuyện như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875109
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875109,
					"content": "Vì thế, phương châm hiện nay đã đổi sang khích lệ là chính, tin tưởng rằng khen ngợi nhiều hơn cũng sẽ tiến bộ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875104,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875110
					]
				},
				{
					"id": 750875110,
					"content": "#Tạm biệt, cũng hoan nghênh {F#cô}{M#cậu} quay lại bất cứ lúc nào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
			]
		},
