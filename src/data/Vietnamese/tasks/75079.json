			},
			"dialogs": [
				{
					"id": 750790901,
					"content": "Không ngờ lại dễ dàng nhận được phần thưởng như vậy... Ước gì những ủy thác của Hiệp Hội Nhà Mạo Hiểm cũng dễ thế này thì tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790902,
					"content": "#{M#Anh}{F#Chị} {NICKNAME} là nhà mạo hiểm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790903
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790903,
					"content": "#{M#Anh}{F#Chị} có Bằng Chứng Mạo Hiểm, còn Paimon thì không có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790904
					]
				},
				{
					"id": 750790904,
					"content": "#Hihi, dù không có giấy tờ, nhưng vẫn có trái tim của một nhà mạo hiểm mà. Giống như tôi không có giấy phép bay, nhưng tôi bay không thua gì {NICKNAME} đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790905,
					"content": "Mà em hỏi như vậy là có ủy thác nào muốn giao à? Đợi đã, để chị đoán xem, chỉ có một đáp án thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790906,
					"content": "#Em thấy {F#hai chị}{M#anh chị} và {REALNAME[ID(2)|SHOWHOST(true)]} thân thiết như vậy, nên muốn hỏi về bí quyết hòa hợp với Saurian nhỏ phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790907,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790908
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790908,
					"content": "Haiz, sai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790909
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790909,
					"content": "Hả? Nhưng vừa nãy Lamizana rõ ràng đã nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790910,
					"content": "Vấn đề là ở chỗ anh ta. Đó là một kẻ rất giỏi lấy lòng người khác, ngay cả Oberon cũng vì ăn Bánh Quy Saurus của anh ta mà nghe lời răm rắp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790911
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790911,
					"content": "Aroowr, Rrrooow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790912
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790912,
					"content": "Giả vờ đáng thương cũng không có tác dụng đâu. Một Qucusaur hàng đầu thì phải biết kiểm soát chế độ ăn uống nghiêm ngặt, hơn nữa ngươi vốn đã dễ bị béo phì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790913
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790913,
					"content": "Anh ta còn thường xuyên nịnh nọt chị Lliwa, chắc chắn có ý đồ không tốt... Còn chị Lliwa thì chẳng có chút cảnh giác nào cả, thậm chí còn nói chuyện cười đùa với anh ta nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790914
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790914,
					"content": "Hửm? Nghe có vẻ anh ta là người tốt mà? Chẳng lẽ vì em không thích anh ta nên có thành kiến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790915,
					"content": "Không phải, không chỉ có thế đâu. Dạo này anh ta có vẻ lén lút, không biết đang làm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790916
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790916,
					"content": "Người lớn luôn có rất nhiều việc phải làm mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790917
					]
				},
				{
					"id": 750790917,
					"content": "Đúng vậy, chẳng phải anh ta đã nói sẽ tổ chức một cuộc thi bay sao? Có lẽ đang bận rộn chuẩn bị cho việc đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790918,
					"content": "Ban nãy anh ta có nhắc đến việc tổ chức cuộc thi bay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790919
					]
				},
				{
					"id": 750790919,
					"content": "Nhưng anh ta không mất nhiều công sức đâu, việc chuẩn bị đều do Paran xử lý cả. Em toàn thấy Paran bôn ba khắp nơi cùng Carrewoof, nên người vất vả phải là Paran mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790920
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790920,
					"content": "Hơn nữa, hôm qua em đã nghe lén được! Anh ta đang bàn bạc chuyện gì đó rất nguy hiểm với người ngoài. Em không dám lại quá gần nên không nghe rõ toàn bộ, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790921
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790921,
					"content": "\"Vào ngày cuộc thi bay diễn ra đúng giờ\", \"ra tay... có chừng mực\", \"tính mạng\", \"sau khi thành công sẽ trả nốt một nửa\", \"thỏa thuận cụ thể sẽ nói chi tiết vào tối mai ở doanh trại phía bắc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790922
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790922,
					"content": "Sao chỉ có nửa sau là nghe rõ ràng thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790923
					]
				},
				{
					"id": 750790923,
					"content": "Tất cả là nhờ Oberon đó. Lúc đó không hiểu sao nó lại bất an, cứ muốn chạy về phía Lamizana. Cuối cùng thì em không ngăn nổi nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790924
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790924,
					"content": "Ahrooowr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790925
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790925,
					"content": "Đồ ngốc, ta đâu có khen ngươi đâu. Tóm lại, khi thấy em đuổi theo Oberon thì người kia liền nhanh chóng rời đi, còn Lamizana thì lại trông rất lúng túng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790926
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790926,
					"content": "Chắc chắn anh ta lo sợ kế hoạch bị bại lộ, nên hôm nay mới đến tìm em gây chuyện, viện lý do này nọ, thực chất là để giám sát em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790927
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790927,
					"content": "Woa, em vẫn còn nhỏ mà đã suy nghĩ phức tạp như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790928,
					"content": "Em biết, chị cũng nghĩ rằng lời trẻ con không đáng tin phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790929
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790929,
					"content": "#Vì vậy, em muốn nhờ {M#anh}{F#chị} {NICKNAME} tối nay cùng em đến doanh trại phía bắc điều tra thử. Nếu anh ta thật sự đang âm thầm thực hiện kế hoạch nguy hiểm nào đó thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790930
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790930,
					"content": "#Chúng ta nhất định phải tìm cách ngăn cản! Có {M#anh}{F#chị} {NICKNAME} làm chứng, chị Lliwa chắc chắn sẽ tin em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790931
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790931,
					"content": "#Nếu {M#anh}{F#chị} {NICKNAME} nghĩ rằng những gì em nói chỉ là suy nghĩ của một đứa trẻ và không đáng để bận tâm, thì ít nhất hãy giúp em gửi một bức thư nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790932
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790932,
					"content": "Em đã viết sẵn một bức thư giải thích tình hình. Nếu ngày mai em vẫn chưa trở về thì xin hãy chuyển lá thư này cho chị Lliwa, nhờ chị ấy chăm sóc Oberon giúp em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790933
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790933,
					"content": "Khoan đã! Sao em càng nói càng đáng sợ vậy? Chuyện này chắc sẽ không xảy ra thật đâu nhỉ... Nhưng nếu là thật thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790934,
					"content": "#{NICKNAME}, hay là chúng ta điều tra thử xem? Nếu bây giờ phớt lờ, lỡ thật sự có chuyện xảy ra thì sau này chúng ta sẽ gặp ác mộng mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790935,
					"content": "#{F#Hai chị}{M#Anh chị} đồng ý giúp em sao? Tuyệt quá! Vậy thì {M#anh}{F#chị} {NICKNAME}, tối nay chúng ta cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790936
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790936,
					"content": "#Giao lại cho {F#hai chị}{M#anh chị} đi, còn em sẽ ở lại đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790937
					]
				},
				{
					"id": 750790937,
					"content": "Ừm, với những ủy thác điều tra kiểu này, quá đông người sẽ dễ làm hỏng việc. Em cứ ở lại đây và chờ tin tức nhé. Em thấy đấy, chị cũng có tinh thần của một nhà mạo hiểm phải không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790938,
					"content": "Chị nói cũng đúng... Vậy em sẽ ở lại đây chăm sóc Oberon, còn phải khuyên chị Lliwa tránh xa Lamizana nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790939
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790939,
					"content": "#Vậy thì nhờ {F#hai chị}{M#anh chị} nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taruka"
				}
			]
		},
