			"dialogs": [
				{
					"id": 750791901,
					"content": "Đau đầu quá đi mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791902,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "Là thế này, tôi có một em trai kém tôi khá nhiều tuổi. Có lẽ đang ở tuổi nổi loạn nên không hợp với ai cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791904,
					"content": "#Haiz, nói cho {F#cô}{M#cậu} nghe cũng chỉ thêm phiền lòng. Chắc là thằng bé lớn hơn chút nữa thì sẽ ổn thôi, ừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791905,
					"content": "Làm phiền rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791906
					]
				},
				{
					"id": 750791906,
					"content": "Không có gì, tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				}
			]
