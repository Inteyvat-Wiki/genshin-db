					}
				]
			},
			"dialogs": [
				{
					"id": 750790301,
					"content": "#Chào mừng... Hmm, có vẻ như một trong số các vị đã thành thạo kỹ năng bay rồi. Vậy {F#cô}{M#cậu} có muốn học kỹ thuật bay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790302,
					"content": "Tôi đã có giấy phép bay rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "Giấy phép bay? Đây đúng là một từ mới lạ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790305,
					"content": "#Ở đây chúng tôi chủ trương sự tiến bộ đồng thời giữa con người và Saurian. Đồng đội của {F#cô}{M#cậu} là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790306,
					"content": "Rrah, rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "...Hmm, có vẻ như Học Viện Bay Pakpaka không phải là nơi để nhóc thể hiện tài năng rồi. Đừng bận tâm, đây tất nhiên không phải là lỗi của nhóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790308,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} còn nhỏ, vẫn còn nhiều tiềm năng lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "Dù thế nào đi nữa thì tiềm năng của Tepetlisaurus cũng không phải là để thi bay với Qucusaurus hay Iktomisaurus đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790311,
					"content": "#Nếu {F#cô}{M#cậu} có hứng thú với khóa huấn luyện bay ở đây thì hãy thử sức trên đường đua mở rộng của chúng tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790313,
					"content": "Dù là né tránh chướng ngại vật hay linh hoạt điều hướng, cũng đều là những kỹ năng cần thiết để điều khiển Qucusaur. Hãy thử sức trên đường đua và xem khả năng của mình đến đâu nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790312,
					"content": "#Thật lòng thì chúng tôi đã phải nỗ lực rất nhiều để quảng bá. Vừa chuẩn bị phần thưởng vừa tổ chức các cuộc thi. Nếu {F#cô}{M#cậu} có thể thuận lợi vượt qua thì hãy đến gặp Lamizana để nhận thưởng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790304,
					"content": "Anh có thể dạy tôi gì đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
