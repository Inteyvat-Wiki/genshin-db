			"dialogs": [
				{
					"id": 750790701,
					"content": "Với tư cách là một tiền bối, cũng như là anh trai của em, anh sẽ dạy cho em cách hòa nhập vào tập thể và trở thành một người được yêu quý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790702,
					"content": "Cảm ơn lòng tốt của anh, nhưng em không cần. Hơn nữa, anh cũng không phải anh trai của em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790703,
					"content": "Còn nữa, liệu anh có thể ngừng cho Oberon ăn bánh quy được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790704,
					"content": "Wrooo, Wroowr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790705,
					"content": "Đúng là đứa trẻ không hiểu chuyện mà. Nếu không phải nể mặt chị của em thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790706,
					"content": "Xin lỗi, tôi đến để nhận thưởng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "#Ồ, đúng là một vị khách hiếm gặp. Chúng tôi không thường thấy Tepetlisaur ở đây. Với lại... Bạn đồng hành của {F#cô}{M#cậu} đa dạng chủng loại nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790709,
					"content": "#Chủng loại...!? Tôi không giống như {REALNAME[ID(2)|SHOWHOST(true)]} đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790710,
					"content": "Hroowr? Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#Hả? À không phải, chúng ta đều là đồng đội của {NICKNAME}, nhưng cũng không hoàn toàn giống nhau. Ý là không phải đang nói ai tốt hơn ai đâu, đừng buồn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790712,
					"content": "Những lời nói thật lòng mới là sát thương chí mạng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#{NICKNAME} biết rõ là tôi không có ý đó mà, đừng làm cho tình hình phức tạp hơn chứ. {REALNAME[ID(2)|SHOWHOST(true)]} cũng là đồng đội tốt của chúng ta mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790714,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} cũng là một đồng đội tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "Hroo? Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#Hihi, {REALNAME[ID(2)|SHOWHOST(true)]} là một Saurian thông minh, chắc chắn sẽ không hiểu sai ý đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790717,
					"content": "Đúng là sự ăn ý đáng ngưỡng mộ. Nhìn cách ăn mặc của các vị chắc không phải người địa phương, nhưng lại có được sự tin tưởng và tình bạn sâu sắc với Tepetlisaur như vậy... Có bí quyết gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790718,
					"content": "Thật lòng mà nói, Taruka và con Qucusaur nhỏ của em ấy dù là đồng đội nhưng lại không hòa hợp với nhau lắm. Nếu có bí quyết gì thì tôi thật sự muốn em ấy học hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790719,
					"content": "Thay vì nói về em... thì phần thưởng của họ đâu rồi? Chắc không phải là anh chưa chuẩn bị xong đấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790720,
					"content": "Tất nhiên là đã xong rồi! Em thật biết cách chuyển chủ đề mà. Thôi bỏ qua chuyện này đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790721,
					"content": "Sắp tới chúng tôi sẽ tổ chức một cuộc thi bay, nếu các vị quan tâm thì đừng bỏ lỡ cơ hội xem cuộc thi, và đừng bỏ lỡ màn trình diễn tuyệt vời của tôi nhé! Tôi còn có việc, giờ tôi phải đi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
