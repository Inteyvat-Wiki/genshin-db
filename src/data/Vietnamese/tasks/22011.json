			"dialogs": [
				{
					"id": 220110201,
					"content": "Bạn đã thu thập hết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110202,
					"content": "Đã thu thập hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "Cảm ơn nhé, những chiếc thẻ này cứ giao cho tôi, tôi sẽ treo nó ở nơi thích hợp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110204,
					"content": "Cái này bạn cầm lấy, cảm ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110205,
					"content": "Mọi người muốn hóa giải ách vận và cầu được may mắn, cái này tôi có thể lý giải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110206,
					"content": "Nhưng tôi nghĩ...muốn giải quyết vấn đề của mình, thay vì đi cầu phúc thì hãy tự mình thực hiện điều đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110207,
					"content": "Nếu như bản thân không chủ động làm thì cho dù thần có giúp đi nữa cũng không có cách để giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				}
			]
		},
