			"trigger": {
				"objectNames": [
					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "Thật là...không biết tin đồn này do ai bày ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110102,
					"content": "Tin đồn gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "Là chuyện liên quan đến việc rút quẻ trong đền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110104,
					"content": "Bạn biết \"rút quẻ\" chứ? Đơn giản mà nói thì là một phương thức xem bói bằng cách rút quẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110105,
					"content": "Dựa vào nội dung trên đó, người ta sẽ dự đoán được tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110106,
					"content": "Rút được quẻ tốt thì không sao, nhưng nếu ra quẻ không tốt thì mọi người thường sẽ để lại trong đền, cầu mong có thể hóa giải được tai họa sắp đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110107,
					"content": "Nhưng mà...không biết ai đồn rằng khi rút được quẻ không tốt thì hãy ném lên ngọn cây, thần linh sẽ ưu tiên hóa giải ách vận của người đó trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110108,
					"content": "Lại còn nói ném càng cao thì ách vận sẽ càng được hóa giải nhanh. Đúng là vô căn cứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110109,
					"content": "Sau đó, lời đồn càng lúc càng xa, giờ đây mọi người không những ném thẻ xăm, mà còn ném cả Mora nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110110,
					"content": "Họ còn nói rằng chỉ cần ném được đồng Mora vào trên tán cây, thì có nghĩa là thần đã chấp nhận lời cầu nguyện đó. Không những có thể nhanh chóng thực hiện nguyện vọng, mà còn mang lại may mắn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110111,
					"content": "Có chuyện này thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "Làm sao có thể chứ! Chưa nói đến việc thần có nghe được lời cầu nguyện hay không...việc ném Mora này thật sự rất quá đáng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110113,
					"content": "Không lẽ họ nghĩ thần sẽ nhặt từng đồng Mora như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110116,
					"content": "Tuy biết mọi người đều là vì cầu phúc, nhưng...cứ ném đồ vật như vậy thì trông không giống như cầu phúc chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110117,
					"content": "Hơn nữa, những thẻ xăm đó bị gió thổi là sẽ rớt đầy sân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110118,
					"content": "Tôi cũng muốn dọn dẹp lắm, nhưng tôi lao động không giỏi, không những không dọn sạch mà càng làm càng bừa bộn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110119,
					"content": "Nhưng bỏ mặc không quản thì cũng không được...Nhà lữ hành, bạn có thể giúp tôi dọn dẹp trên nóc nhà chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110120,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "Vậy thì trông cậy vào bạn nhé, nếu như nhặt được thẻ xăm nào đó thì hãy mang đến chỗ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110122,
					"content": "Số thẻ này phải giải quyết thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "Những chiếc thẻ này...theo lời Hotomi nói thì dù sao chúng cũng là \"vận mệnh\" mà mọi người đã xin được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110124,
					"content": "Nếu như vứt bừa bãi thì trông không phải cho lắm, vậy nên tôi sẽ sắp xếp chúng lại rồi để ở nơi thích hợp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110125,
					"content": "Haiz, nếu như ngay từ đầu mọi người làm theo quy định thì đâu có phiền phức như vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110126,
					"content": "Vậy thì trông cậy vào bạn nhé, nếu như nhặt được thẻ xăm nào đó thì hãy mang đến chỗ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110114,
					"content": "Vậy thì chỉ cần nói rõ với họ là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "Những người làm như vậy thật sự quá nhiều, tôi giải thích không xuể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				}
			]
		},
