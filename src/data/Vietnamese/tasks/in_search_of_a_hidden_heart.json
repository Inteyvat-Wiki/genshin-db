			"dialogs": [
				{
					"id": 751500401,
					"content": "Làm sao để vào Trái Tim Của Núi Thánh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "Lối vào Trái Tim Của Núi Thánh nằm ở trung tâm thành phố tái tạo Tollan. Để có được môi trường thí nghiệm ổn định, ngài Xiuhcoatl đã đào xuống bên dưới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500403,
					"content": "Và đã tạo ra vũ khí cuối cùng để chống lại Vực Sâu tại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500404,
					"content": "Nhưng mà, cũng vì lý do phong tỏa, nên đã bị Vực Sâu ăn mòn ở mức độ sâu nhất, đến nỗi thành phố cũng bị xâm chiếm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500405,
					"content": "Lối vào Trái Tim Của Núi Thánh nằm ngay dưới khe nứt của Thánh Thành... Cũng chính là nơi mà tình trạng ăn mòn của kẻ địch bóng tối diễn ra nghiêm trọng nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hầu Cận Rồng"
				}
			]
		},
