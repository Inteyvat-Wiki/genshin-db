				},
				{
					"id": 751501302,
					"content": "Làm sao để vào Trái Tim Của Núi Thánh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "Lối vào Trái Tim Của Núi Thánh ở ngay lối đi vừa được khai quật... Sâu trong khe nứt dưới đáy núi lửa và được bức tượng rồng canh giữ.",
