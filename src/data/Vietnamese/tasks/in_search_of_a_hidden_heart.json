					"nextDialogs": [
						751501304
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501304,
					"content": "Ngoài ra, bất cứ ai muốn vào Trái Tim Của Núi Thánh đều cần có giấy phép...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501305,
					"content": "Có như vậy mới nhận được sự công nhận của bức tượng rồng canh giữ... Trái Tim Của Núi Thánh, cũng chính là Huitzilopochtli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501306,
					"content": "Làm sao để có được giấy phép...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "Theo hiệp định và mệnh lệnh của ngài Xiuhcoatl, nếu muốn vào... Trái Tim Của Núi Thánh, cũng chính là \"Huitzilopochtli\"... dòng tộc của...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501308,
					"content": "Hãy đến Sảnh Thương Nghị để đăng ký và chờ được cho phép.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501309,
					"content": "Năng lượng cần cho tượng rồng cổ xưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "Đang tìm kiếm... Không có loại dữ liệu có thể phản hồi... Có lẽ do sự ăn mòn của Vực Sâu đối với thành phố, nên dữ liệu đã bị mất đi rất nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501311,
					"content": "#Nếu loại bỏ ảnh hưởng của Vực Sâu và thu hồi dữ liệu, có lẽ sẽ tìm được mục dữ liệu mà {F#cô}{M#cậu} cần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501312,
					"content": "#Đã đánh dấu giúp {F#cô}{M#cậu} địa điểm có thể lưu trữ dữ liệu, hãy loại bỏ sự ăn mòn của Vực Sâu ở nơi đó để khôi phục khu vực chứa dữ liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501313,
					"content": "Có việc gì cần hỏi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
