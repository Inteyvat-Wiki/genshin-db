			},
			"dialogs": [
				{
					"id": 751500901,
					"content": "Xin chào, đã phát hiện mục thu hồi dữ liệu mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500902,
					"content": "...Về lõi năng lượng của Thiết Bị Nguồn, đã cập nhật mục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500903,
					"content": "Lõi năng lượng điều khiển Thiết Bị Nguồn chính là Phlogiston, nhưng chẳng qua là Phlogiston được cô đặc và gần với trạng thái ánh sáng hơn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500904,
					"content": "Một lượng đơn vị Phlogiston có thể được sản sinh ra trong phản ứng có thể kiểm soát mang tên \"Dữ Liệu Thất Thoát\", cho phép kiểm soát chính xác hơn quá trình giải phóng năng lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500905,
					"content": "Năng lượng cần cho Thiết Bị Nguồn sẽ tùy thuộc vào sự phức tạp của thuật toán vận hành và kích thước của thiết bị. Lượng đơn vị Phlogiston mà Hầu Cận Rồng cần là \"Dữ Liệu Thất Thoát\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500906,
					"content": "Nhưng số đơn vị Phlogiston mà tượng rồng lớn hơn cần đến so ra lại ít hơn, số lượng cần là ba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500907,
					"content": "\"Thông tin là năng lượng, năng lượng cũng là thông tin\". Vật chứa dữ liệu được thu hồi cũng chính là đơn vị Phlogiston.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500908,
					"content": "Cho nên đơn vị Phlogiston chính là quả cầu lửa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "Đúng, có thể hiểu như vậy. Đơn vị Phlogiston vốn bị Vực Sâu ăn mòn đã được mọi người khôi phục, nên mới có thể được tôi trích xuất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751500910,
					"content": "Cũng có thể trở thành nguồn năng lượng thay thế cho Thiết Bị Nguồn đã bị Vực Sâu ăn mòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hầu Cận Rồng"
				}
			]
		},
