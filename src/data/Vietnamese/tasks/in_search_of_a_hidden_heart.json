					"nextDialogs": [
						751501505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501505,
					"content": "...Xin lỗi, thông tin của các vị chưa từng được nhập vào kho dữ liệu của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501506
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501506,
					"content": "Không ngờ lại có con người đi sâu vào nơi này... Ít nhất cũng đã 500 năm rồi chưa xảy ra chuyện như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501507
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501507,
					"content": "Khoan đã, ngươi không phải Amaru... Hmm, cũng không phải là Ehecatl sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501508,
					"content": "...Đúng là có cá thể mang tên này, nhưng tôi không phải bất kỳ một cá thể nào trong số đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501509
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501509,
					"content": "Chắc là đã có một số hiểu lầm ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501510
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501510,
					"content": "Tôi là nguyên mẫu được chế tạo ra để ngài Xiuhcoatl ghi lại thông tin, nên tôi không có tên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501511
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501511,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "Không, không phải tôi không có tên, tôi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501513,
					"content": "Tôi là Hầu Cận Rồng duy nhất đủ tư cách sở hữu trí thông minh mà không có chủ nhân. Sau khi ngài Xiuhcoatl ngã xuống, tôi vẫn phụ trách những công việc cơ bản nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501514,
					"content": "Đó là bảo trì và ghi chép thông tin cơ bản nhất của thành phố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501515,
					"content": "...Nhưng vì sự ăn mòn của kẻ địch bóng tối mà một số ghi chép đã bị thất lạc, nên hiện chưa có dữ liệu về tên của chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501516,
					"content": "Chậc, xem ra chúng tôi nhận nhầm người, à không, nhận nhầm rồng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501517,
					"content": "Không sao cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751501518,
					"content": "Hmm, con robot này tuy to lớn, nhưng trông có vẻ ngơ ngơ thế nào ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501519,
					"content": "#{NICKNAME}, xem ra đây không phải cái người thông qua máy móc để nói chuyện với chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501520,
					"content": "Nhưng nó có nói mình phụ trách ghi chép... ừm, ghi chép thông tin sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501521,
					"content": "Hay là hỏi thử xem nó biết những gì đi? Hoặc là... ừm, làm sao để đến được Trái Tim Của Núi Thánh đó!",
