			"dialogs": [
				{
					"id": 100080301,
					"content": "May quá! May mà có bầy sói giúp đỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080302,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080303,
					"content": "Chúng cũng đã cầm chân được nhiều Chó Săn Ma Vật... thậm chí là đang giúp chúng ta đẩy lùi kẻ địch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080304,
					"content": "Nhưng đây không phải việc của sói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080305,
					"content": "Hì hì, giống như Razor muốn giúp đỡ Lupical, thì Lupical cũng sẽ không để Razor gặp nguy hiểm đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080306,
