			"dialogs": [
				{
					"id": 100080101,
					"content": "Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080102,
					"content": "Ngửi thấy rồi, mùi quen thuộc, thì ra là hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080103,
					"content": "Dạo này, khỏe không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080104,
					"content": "Hì hì, mọi thứ vẫn ổn. Đúng rồi, Razor, sao Vua Sói vừa thấy chúng tôi là biến mất vậy? Mọi người đang bàn bí mật gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080105,
					"content": "Bắt đầu đi săn, tôi đang thuyết phục... lãnh chúa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080106,
					"content": "Đi săn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080107,
					"content": "#(À {NICKNAME}, lẽ nào đây chính là \"bài tập\" của Razor sao?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080108,
					"content": "Razor, chẳng lẽ bầy sói lại thiếu đồ ăn nên mọi người phải đi săn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080109,
					"content": "Hãy đưa tôi bẫy thú...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "Không, không phải... Lần đi săn này, không phải để no bụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080112,
					"content": "Mà là để giết chết kẻ thù. Bầy sói đen đúa, chiếm đóng lãnh thổ... Mùi hôi thối kỳ lạ, ngày càng nồng nặc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080113,
					"content": "Phải thanh tẩy khu rừng... Săn lùng kẻ thù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080114,
					"content": "Vậy Vua Sói đã đồng ý chưa? Tôi nhớ là lúc đó Vua Sói còn nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080115,
					"content": "Xem nào, lúc đó nói thế nào nhỉ... Khụ khụ, \"Razor, ngươi không được tham gia thảo phạt. Bởi vì đây là chuyện của sói.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080117,
					"content": "À, tôi không cố ý đâu... Xin lỗi nhé, Razor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080118,
					"content": "Không sao, vì tôi có Lupical bên cạnh. Hơn nữa, sư phụ đã dạy tôi, cách nói chuyện với lãnh chúa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080119,
					"content": "Lisa dạy... cách nói chuyện với lãnh chúa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080120,
					"content": "À, tôi hiểu rồi, là cách thuyết phục Vua Sói phải không? Vậy là Razor đã thuyết phục được Vua Sói rồi à?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080121,
					"content": "Ừm, nói chuyện khá mệt, nhưng mà, thành công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080122,
					"content": "Thật không ngờ lại thuyết phục được tên to xác cứng đầu ấy, giỏi quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080123,
					"content": "Sói đen, là kẻ thù của thế giới. Sư phụ nói, đây không phải vấn đề của sói, mà là vấn đề của thế giới... Sư phụ đúng, lãnh chúa cũng đã thừa nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080124,
					"content": "Tuy nhiên, vì vậy, bầy sói sẽ không tham gia, đây là cuộc chiến giữa \"tôi\" và \"sói đen\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080125,
					"content": "Hì hì, vậy để chúng tôi cùng giúp một tay nhé! Đám Chó Săn Ma Vật kỳ quái đó, chúng tôi cũng thấy ngứa mắt với chúng từ lâu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080126,
					"content": "Cảm, cảm ơn... Có hai người giúp đỡ, chắc chắn sẽ suôn sẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080127,
					"content": "Nhưng mà, phải bắt đầu đi săn thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080128,
					"content": "Chúng ta, dồn chúng như dồn con mồi vào bẫy, đưa bầy sói đen đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080129,
					"content": "Lãnh chúa sẽ nhốt chúng lại, chúng ta sẽ... kết liễu chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080130,
					"content": "...Chuẩn bị đi. Khi nào xong, nói cho tôi biết, rồi sẽ bắt đầu, đi săn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080401,
					"content": "Xuất phát luôn thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "Lợn rừng đủ lớn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
