			"dialogs": [
				{
					"id": 705100401,
					"content": "Ái chà... lượng khách mấy hôm nay của quán rượu tăng lên rõ rệt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100402,
					"content": "Có người đến đây vì rượu, cũng có người đến đấy vì bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100403,
					"content": "Câu này... nghe có hơi lạ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100404,
					"content": "Tôi chưa từng thấy qua \"Tuần Trải Nghiệm Pha Chế\" nào thành công như vậy, kỳ này quán rượu lên hương rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100405,
					"content": "Nói chung thì... làm tốt lắm đồng nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100406,
					"content": "Mới mấy ngày mà cũng tính là đồng nghiệp sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100407,
					"content": "Dưới góc độ nào đó thì cũng đúng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "Hay là ở lại đây làm việc luôn nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100410,
					"content": "#Không được, tuy là thức uống ngon lắm, nhưng Paimon hứa là sẽ cùng {NICKNAME} đi thám hiểm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100411,
					"content": "Được rồi, tôi cũng không ép, dù sao thì Charles cũng có nói qua chuyện này cho tôi nghe rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100412,
					"content": "Nói chung thì nếu có cơ hội, hãy đến quán \"Quà Tặng Của Thiên Sứ\" chơi nhé, nhớ dẫn theo bạn bè luôn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100413,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "Tạm biệt, chúc bạn thuận buồm xuôi gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100408,
					"content": "Anh ta nói đúng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
