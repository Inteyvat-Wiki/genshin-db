			"dialogs": [
				{
					"id": 752500101,
					"content": "Các du khách mua được đồ chơi lần lượt rời đi. Lúc này, có vài vị khách không mời đã đến Vườn Alpaca...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "Fatui hôm qua? Là các người! Các người... các người còn muốn làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500104,
					"content": "Có tôi ở đây, đừng lo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "Không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "Fatui đứng đầu vội vàng giơ tay lên, rồi đưa cho bạn một mảnh giấy. Bạn mở ra xem, trên đó viết vài câu xiêu vẹo...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "Thì ra hôm qua khi đưa tay ra, thực ra là đang trả tiền à...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500113,
					"content": "Xin, xin lỗi... Là tôi trách nhầm mấy người rồi... Thật sự xin lỗi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500114,
					"content": "Những món đồ chơi này... hãy cầm lấy hết nhé! Đây chính là lời cảm ơn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500115,
					"content": "Fatui lắc đầu, sau đó lại ra hiệu bằng ba ngón tay.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Các vị giống như anh hùng của Natlan vậy, đều là những chiến sĩ đáng kính!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500117,
					"content": "Vậy để tôi đi chuẩn bị một vài món đồ chơi có màu sắc phù hợp với các vị. Cảm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
