			"dialogs": [
				{
					"id": 401450101,
					"content": "Sau một thời gian kinh doanh, Tiệm Giả Kim dần buôn bán sôi nổi lên...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "Phù, dạo gần đây khách hàng ngày một nhiều, tôi bận muốn xỉu luôn rồi đây này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450103,
					"content": "Buôn bán bắt đầu tốt lên rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "Với lượng đơn hàng bây giờ, chỉ dựa vào hai chúng ta thì sẽ có chút khó khăn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450106,
					"content": "Chắc phải đi tìm trợ thủ mới thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450107,
					"content": "Các cưng đang nghỉ ngơi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450108,
					"content": "Chị vừa xem số liệu doanh thu gần đây. Hai cưng đúng là có tài kinh doanh mà, dạo này đã bán được không ít thuốc đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450109,
					"content": "Lisa đến rồi! Chúng tôi đang bàn chuyện tìm trợ thủ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450110,
					"content": "Hửm? Là do gần đây lượng đơn hàng tăng lên, nên hai cưng xử lý không xuể sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450111,
					"content": "Đúng vậy, lúc bắt đầu không ngờ là lại đông khách như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450112,
					"content": "Haha, chị thì sớm đã dự đoán được từ trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450113,
					"content": "Thật ra từ lúc hai cưng bận rộn việc mở tiệm, chị và Freda đã thảo luận về việc tăng hiệu suất kinh doanh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450114,
					"content": "Chị đã quan sát tình hình kinh doanh, phát hiện dù là kỹ thuật giả kim, nuôi trồng dược liệu hay buôn bán, cũng đều có nhiều chỗ để cải thiện đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450115,
					"content": "Woa, Lisa âm thầm để ý tới những việc này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450116,
					"content": "Tôi còn tưởng cô luôn lười biếng đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450117,
					"content": "Nói vậy mà được sao, những lúc quan trọng thì chị đây cũng rất đáng tin cậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450118,
					"content": "Vậy thì tăng hiệu suất mà cô nói tới, cụ thể là phải làm như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450119,
					"content": "Chuyện này sao, phương án nâng cấp cụ thể thì chị đã thảo luận qua với Freda rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450120,
					"content": "Tình hình chi tiết thì hai cưng đến tìm cô ấy thảo luận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450104,
					"content": "Danh tiếng bắt đầu vang xa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
