			"dialogs": [
				{
					"id": 401450201,
					"content": "#Xin chào {NICKNAME} và Paimon, tôi có thể giúp gì được cho hai vị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450202,
					"content": "Ừm, dạo này chúng tôi có hơi thiếu nhân lực, nên Lisa khuyên chúng tôi nên tìm một số cách để tăng hiệu quả kinh doanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450203,
					"content": "À, chuyện này sao, Lisa đã thảo luận chi tiết với tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450204,
					"content": "Hiện có thể nâng cấp kỹ thuật giả kim, nuôi trồng và quy mô kinh doanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450205,
					"content": "Sau khi tăng hiệu suất, việc kinh doanh cũng sẽ nhẹ nhàng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450206,
					"content": "Woa, nghe có vẻ rất lợi hại nhỉ... Vậy chúng ta mau thử xem đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450207,
					"content": "Tăng hiệu suất kinh doanh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "Công tác nâng cấp đã chuẩn bị sẵn sàng rồi, hãy thử xem nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450209,
					"content": "Mua sắm vật tư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "Gần đây có một lô vật tư vừa đưa tới, hãy xem thử xem có cần gì không nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450211,
