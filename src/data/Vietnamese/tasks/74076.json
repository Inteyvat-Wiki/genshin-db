					"nextDialogs": [
						740760305
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760305,
					"content": "Có điều, rốt cuộc là ai đang cạnh tranh với chúng ta nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760306,
					"content": "Giả sử Hội Narzissenkreuz mất mấy trăm năm vẫn không phục hưng mà chìm vào trong im lặng, và những tri thức tôi biết vẫn có ý nghĩa, đồng thời kết hợp với tình hình trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760307
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760307,
					"content": "Thì e rằng đó là Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760308
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760308,
					"content": "Là người xấu bắt nạt Seymour sao? Hắn ta muốn mấy thứ này để làm gì...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760309
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760309,
					"content": "Mục đích có lẽ cũng giống với chúng ta: Tìm nguyên liệu để rèn lại Thánh Kiếm Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760310
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760310,
					"content": "Hội Narzissenkreuz đã dựa vào triết học thần bí của vương quốc dưới lòng đất và Fontaine cổ đại, tái tạo ra bốn phi vật chất trong thế giới vật chất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760311
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760311,
					"content": "Không thể hiểu nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760312,
					"content": "Bản thân những thứ thần bí thì chỉ dùng để trải nghiệm. Có thể nói, nó còn khó đoán hơn cả sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760313
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760313,
					"content": "Nhiều thập kỷ trước, tôi đã sao chép dữ liệu từ nhập môn đến trung cấp của Học Phái Spantamad từ Giáo Viện rồi, sức mạnh nguyên tố cũng không thần kỳ đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760314,
					"content": "Phải không đấy? Dù sao thì trên kết luận mà nói, đây là sự giao thoa giữa kỹ thuật Fontaine cổ đại và vương quốc cổ dưới lòng đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760315
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760315,
					"content": "Trên thế giới xuất hiện bốn loại vật chất là \"Ký Ức\", \"Nguyện Vọng\", \"Linh Hồn\" và \"Nhân Cách\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760316
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760316,
					"content": "Để tránh bị lệch nghĩa, hãy gọi nó là mảnh \"Ký Ức\", mảnh \"Nguyện Vọng\", mảnh \"Linh Hồn\" và mảnh \"Nhân Cách\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760317
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760317,
					"content": "Tại sao lại dùng những thứ này để tạo ra Thánh Kiếm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760318,
					"content": "Theo triết học Hội Narzissenkreuz thần bí, điện thờ là hình ảnh thu nhỏ của vũ trụ, thành viên của hội đại diện cho các vị thần, còn dầu thánh là ý chí đã được tôi luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760319
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760319,
					"content": "Thánh Kiếm là thứ phá vỡ tất cả \"Lý Tính\", nó cần được tạo ra từ ý chí hoàn chỉnh của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760320
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760320,
					"content": "Thật khó hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760321
					]
				},
				{
					"id": 740760321,
					"content": "Triết học thần bí là vậy đó. Trông tương tự nhau là được, đến khi nó trở thành phép thuật thì giả sẽ biến thành thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760322
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760322,
					"content": "Dù sao thì đối thủ của chúng ta cũng không giải được câu đố; Hoặc có thể anh ta giải ra được, nhưng không thể trình ra đáp án. Nếu đối thủ là Jakob thì tôi nghĩ chắc là vế sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760323
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760323,
					"content": "Bia đá ở đây có viết: \"Mãi không xa rời\"... \"Sinh ra trong khoảnh khắc, thường hay mâu thuẫn, cùng nhau yên giấc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760324
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760324,
					"content": "Câu cuối cùng viết là... \"Giọt ban đầu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760325,
					"content": "Mấy chỗ lúc trước cũng có câu đố như vậy. Mọi người còn nhớ những đáp án đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760326
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760326,
					"content": "Cái bóng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760327
					]
				},
				{
					"id": 740760327,
					"content": "Sinh mạng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760328
					]
				},
				{
					"id": 740760328,
					"content": "Tình yêu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760329
					]
				},
				{
					"id": 740760329,
					"content": "Chậc, đáp án đang dần trừu tượng hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760330,
					"content": "Caterpillar và Seymour có biết đáp án của câu đố này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7407604,
