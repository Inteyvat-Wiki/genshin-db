							2409.902,
							313.167,
							3521.11
						],
						"pointId": 7020
					}
				]
			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "Tôi có ý tưởng về \"Giọt ban đầu\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760402,
					"content": "Nghe như là trận mưa đầu tiên sau khi sáng tạo thế giới. Người Fontaine cổ và Hội Narzissenkreuz chắc hẳn rất thích ý tưởng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760403,
					"content": "Vậy làm sao có thể tìm được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760404,
					"content": "Vậy nên, một giọt nước này đã bao hàm tất cả mọi loại nước trong nó. Mỗi một giọt nước đều là giọt ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760405,
					"content": "Cũng giống như vị thần ban đầu đã rải thần lực vĩ đại đi khắp muôn nơi. Trong mỗi chúng ta đều có một phần của thần thánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760406,
					"content": "Nhưng nếu đơn giản như thế thì tên kia hẳn phải dễ dàng tìm được đáp án chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760407,
					"content": "Đúng thế thật, vậy có lẽ tôi nhầm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760408,
					"content": "Tuy nó không phải là đáp án chính xác, nhưng nó vẫn là một đáp án hay. Tôi chỉ cảm thấy người ra câu đố không hiểu lãng mạn là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760409,
					"content": "Rồi giờ người ra câu đố đang cười anh vì giải không ra đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760410,
					"content": "Tôi không thể trả lời, có đến 1200 đáp án về \"giọt ban đầu\" lận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760411,
					"content": "\"Giọt rượu đầu tiên trên thế giới nghe nói là từ Phong Thần...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760412,
					"content": "Được rồi, đừng nói nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760416,
					"content": "À, hình như tôi có chuyện này có thể chia sẻ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760417,
					"content": "Có truyền thuyết kể rằng, Tinh Linh Nước Trong là giọt nước mắt đầu tiên của Thủy Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760418,
					"content": "Giọt nước mắt đầu tiên rơi xuống đất, cũng là khi Tinh Linh Nước Trong đầu tiên thấu hiểu con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760419,
					"content": "Giọt nước mắt đầu tiên trên thế giới chẳng phải là do đứa trẻ đầu tiên khóc ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760420,
					"content": "Khi động vật khóc, thật ra chúng chỉ đang bài tiết muối ra khỏi cơ thể, còn trong năm tháng ấy, loài người lúc mới sinh đã cười vui vẻ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760421,
					"content": "...Truyền thuyết nói vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760422,
					"content": "Thật ra tôi thấy trẻ con khóc và động vật bài tiết muối chỉ là hành vi phi cảm tính mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760423,
					"content": "Trẻ con khóc vì kích thích bên ngoài để làm đầy phổi càng nhanh càng tốt. Tài liệu của Học Phái Amurta bên Sumeru ghi vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760424,
					"content": "Vậy đáp án là Tinh Linh Nước Trong ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760425,
					"content": "Vậy thì đúng là tên kia chưa chắc đã trình ra được đáp án thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760426,
					"content": "Thôi thì coi như thử cố giải đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "Tôi cảm thấy hướng này vẫn khá đáng tin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760430,
					"content": "Theo cách hiểu của tôi về Hội Narzissenkreuz thì thấy cũng khá hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760431,
					"content": "Nữ Hoàng Đỏ không biết nằm mơ ở đâu, người trong mơ luôn trong ngoài bất nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760432,
					"content": "Sao mấy câu đố này khó hiểu thế nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760433,
					"content": "Có sao đâu, đã đến giây phút cuối cùng rồi. Dù thế nào thì đáp án đều sẽ được mang ra ánh sáng vào lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760434,
					"content": "Vậy làm phiền Ann rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "Ừm, để tôi thử xem. Nếu như thất bại thì mọi người mau nghĩ đáp án khác nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760436,
					"content": "Mở được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760437,
					"content": "Nhất định phải lấy được mảnh cuối cùng, nếu không Thánh Kiếm sẽ rơi vào tay Hội Narzissenkreuz mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760428,
					"content": "Tôi cảm thấy hướng này vẫn khá đáng tin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "So với việc đi tìm rượu của Phong Thần thì đáng tin hơn nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760414,
					"content": "Thử đi, chúng ta tới Mondstadt nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "Dù muốn chày cối để giải thì cũng phải tìm ra cách đáng tin hơn chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
