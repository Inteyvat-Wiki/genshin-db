			"dialogs": [
				{
					"id": 740760501,
					"content": "Đó chính là mảnh \"Nhân Cách\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760502,
					"content": "Không thể phân tích vật chất trước mắt. Hình như trọng lượng là... không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760503,
					"content": "Xem ra chúng ta đã lấy được mảnh cuối cùng rồi. Ít ra như vậy cũng xem như hòa với anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760504,
					"content": "Nghĩ theo hướng tốt thì ít ra chúng ta đã ngăn được Hội Narzissenkreuz rèn Thánh Kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760505,
					"content": "Không phải đâu Paimon. Mục tiêu cuối cùng của chúng ta là rèn ra Thánh Kiếm, và dùng nó để ngăn kế hoạch của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760506,
					"content": "Và Ann, đương nhiên tôi sẽ không quên ý nghĩa của thanh kiếm này đối với cô đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760507,
					"content": "Thánh Kiếm cắt được ý chí, là chìa khóa để giải câu đố về cô. Thật ra nó cũng rất quan trọng đối với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760508,
					"content": "Chẳng qua chúng ta có chuyện quan trọng hơn thôi. Sau khi xong việc, chúng ta đi tìm đáp án cho thân thế của bản thân nhé, có được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760509,
					"content": "Tôi không có vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "Ann"
