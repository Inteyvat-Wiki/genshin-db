					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760205
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760205,
					"content": "Bia đá ở đây có viết: \"Mãi không xa rời\"... \"Sinh ra trong khoảnh khắc, thường hay mâu thuẫn, cùng nhau yên giấc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760206
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760206,
					"content": "Câu cuối cùng viết là... \"Giọt ban đầu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760207,
					"content": "Mấy chỗ lúc trước cũng có câu đố như vậy. Mọi người còn nhớ những đáp án đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760208
					],
					"speakerTitle": "Caterpillar"
				},
				{
