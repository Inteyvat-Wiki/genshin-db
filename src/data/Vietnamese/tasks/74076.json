				},
				{
					"id": 740760102,
					"content": "Cũng may cửa vào vẫn đang trong trạng thái bị đóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760103,
					"content": "Xem ra Jakob vẫn chưa giải được câu đố ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760104,
					"content": "Hoặc có thể anh ta \"giải được\" đáp án, nhưng không thể \"trình ra\" đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760105,
					"content": "Để nhớ xem, các đáp án trước đây lần lượt là \"Cái Bóng\", \"Sinh Mạng\" và \"Tình Yêu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760106,
					"content": "Căn cứ theo quy luật lúc trước, mô đun logic của tôi phỏng đoán tấm bia kia như sau:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760107,
					"content": "\"Mãi không xa rời\"... \"Sinh ra trong khoảnh khắc, thường hay mâu thuẫn, cùng nhau yên giấc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760108,
					"content": "Câu cuối cùng viết là... \"Giọt ban đầu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760109,
					"content": "Caterpillar, Seymour, hai người có biết đáp án không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
