			"dialogs": [
				{
					"id": 761380201,
					"content": "Cô chủ Nefer? Còn có... anh Zompaynco, cho hỏi có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380202,
					"content": "Vị khách Natlan này của chúng tôi hình như muốn ghé thăm Dòng Dõi Sương Nguyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380203,
					"content": "Nhưng vì suy nghĩ đến một số... lễ nghi, nên anh ấy vẫn muốn tìm một người để giới thiệu giúp anh ấy. Zompaynco, đến lượt anh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380204,
					"content": "Xin chào, cô Lyylikki! Rất vui được gặp cô, ừm... đây là... tiêu bản hóa thạch mà tôi mang từ Natlan đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380205,
					"content": "Cảm ơn anh, nhưng mà... anh Zompaynco, tôi đã biết anh từ lâu rồi, anh không cần khách sáo như vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380206,
					"content": "Hả? Sao cô lại phát hiện ra tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380207,
					"content": "Lúc trước khi tôi phát thức ăn, không phải anh cũng có đứng cạnh xem sao? Cứ lượn lờ qua lại, nhưng chẳng bao giờ đứng vào trong hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380208,
					"content": "Tôi còn tưởng anh muốn nhận thức ăn, nhưng lại ngại không đến lấy, nên cố tình để lại một phần cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380209,
					"content": "Nhưng mà... anh cũng chưa từng lấy thức ăn. Nếu hôm nay anh không tới thì tôi cũng sẽ nhờ người đi hỏi xem có việc gì cần giúp không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380210,
					"content": "Ah... Xin lỗi, tôi đang do dự, không biết phải chào hỏi thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380211,
					"content": "Vì vậy, cô Lyylikki, tôi có thể đến Dòng Dõi Sương Nguyệt xem thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380212,
					"content": "Được chứ. Trong Dòng Dõi Sương Nguyệt cũng có vài vị khách từ nơi khác đến. Nhưng anh muốn đến đó để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380213,
					"content": "Chụp hình lưu niệm và tìm kiếm tư liệu. Nếu được thì... tìm người hỏi thăm những câu chuyện truyền thuyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380214,
					"content": "Tôi là thành viên của Hiệp Hội Nghiên Cứu Di Vật Saurian ở Natlan, nếu tôi có thể thu thập một số tư liệu liên quan đến hướng nghiên cứu của mình thì tốt quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380215,
					"content": "Ồ... Vậy là anh muốn đến để đọc sách à? Để tôi suy nghĩ thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380216,
					"content": "Được rồi, hai người đã giới thiệu xong, vậy ủy thác lần này coi như hoàn thành. Tôi cũng nên đi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380217,
					"content": "Cảm ơn nhé cô chủ Nefer! Phần chi phí tôi vẫn sẽ chi trả cho cô. Sao có thể để cô phải đi một chuyến không công được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380218,
					"content": "Vậy thì tùy theo ý anh Zompaynco nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380219,
					"content": "Vậy tôi đi trước đây, chúc hai vị trò chuyện vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		}
	]
}