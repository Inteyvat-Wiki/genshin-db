			},
			"dialogs": [
				{
					"id": 761380101,
					"content": "A... Cô chủ Nefer! Trời ơi, cô đến đúng lúc quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380102,
					"content": "Đã hạ quyết tâm rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380103,
					"content": "Hả? Hạ quyết tâm?... Ý, ý cô là sao, chẳng lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380104,
					"content": "Tôi biết, anh luôn muốn tới thăm Dòng Dõi Sương Nguyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380105,
					"content": "Anh hy vọng có thể làm quen với Lyylikki trước, muốn dùng tình bạn này để làm cái cớ ghé thăm Dòng Dõi Sương Nguyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380106,
					"content": "Cô... cô biết hết rồi sao? Rõ ràng tôi đã giấu kín những chuyện này trong lòng, không có nói với ai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380107,
					"content": "Anh Zompaynco, khi người ta giữ bí mật, cũng cần phải học cách che giấu việc \"đang giữ bí mật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380108,
					"content": "Nếu không, lớp phòng vệ trong lòng anh sớm muộn cũng sẽ xuất hiện lỗ hổng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380109,
					"content": "Haiz, từ ngày ở quê nhà, tôi đã không giỏi che giấu suy nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380110,
					"content": "Thôi được rồi, nếu đã biết thì cô có thể giới thiệu giúp tôi không? Tôi là người bên ngoài đến, nếu tùy tiện đi làm phiền cô Lyylikki thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380111,
					"content": "Dòng Dõi Sương Nguyệt đều rất tốt bụng, đừng nói là khách từ nơi khác tới, cho dù không phải người thì cũng sẽ được chào đón rất dịu dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380112,
					"content": "Hả? Thật hay giả vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380113,
					"content": "Nhưng dù thế nào, tùy tiện làm phiền vẫn không được lịch sự, vẫn mong cô chủ Nefer giới thiệu giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380114,
					"content": "Được, bây giờ chắc họ cũng vừa hay phát xong thức ăn, là thời cơ tốt để trò chuyện, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380115,
					"content": "À... Lần này không cần thu phí đâu, tôi chỉ vô tình đi ngang qua thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380116,
					"content": "Cảm ơn cô chủ Nefer! Tôi đi thu dọn đồ đạc đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		},
