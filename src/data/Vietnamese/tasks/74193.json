					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930504,
					"content": "Không có cũng không sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930505
					]
				},
				{
					"id": 741930505,
					"content": "Đúng vậy, chúng tôi có thể cho cô Tidalga mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930506,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930507
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930507,
					"content": "#Paimon, bạn... thật lòng! {NICKNAME}, bạn... thật lòng! Vậy nên... đổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930508
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930508,
					"content": "Vậy... thôi được, Pahsiv phải ra ngoài bao lâu? Chúng ta còn gặp lại nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930509,
					"content": "Gặp... lại?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930510
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930510,
					"content": "Gặp lại, có nghĩa là hy vọng gặp nhau lần nữa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930511,
					"content": "\"Hẹn gặp lại\" là lời dùng để tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930512
					]
				},
				{
					"id": 741930512,
					"content": "Đúng vậy! Lần trước đã nói rồi, chúng tôi phải dạy cô cách tạm biệt. Vì vậy, Pahsiv, thử nói một câu đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930513,
					"content": "Tạm... biệt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930514
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930514,
					"content": "Hmm... Cô không hiểu tạm biệt là gì, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930515,
					"content": "Để tôi nghĩ xem... Cái đó cũng gần giống như trao đổi, dùng ngày mai để đổi lấy ngày mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930516,
					"content": "Lấy một chút ngày mai của cô đưa cho chúng tôi, chúng tôi cũng đưa cho cô một ít của chúng tôi, như vậy là chúng ta có thể gặp lại rồi! Sao nào? Nói vậy cô hiểu được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930517,
					"content": "Ngày mai... đổi lấy... ngày mai...! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930518
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930518,
					"content": "Woa, xem ra cô hiểu rồi! Vậy chúng ta tạm biệt nhau nhé, hẹn gặp lại đàng hoàng là nhất định sẽ gặp lại thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930519,
					"content": "Hẹn gặp lại! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930520,
					"content": "Hẹn gặp lại!",
					"roleType": "TALK_ROLE_PLAYER",
