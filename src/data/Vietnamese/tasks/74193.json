			"dialogs": [
				{
					"id": 741930101,
					"content": "#Paimon! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930102,
					"content": "Woa! Không ngờ lại là Pahsiv! Lại gặp nhau rồi, vui quá! Cô làm gì ở đây thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930103,
					"content": "Pahsiv... làm việc! Pahsiv... mệt! Pahsiv... nằm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930104,
					"content": "Hmm...? Cô đang làm việc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930105,
					"content": "Cành Cây Rừng Rậm... Cành Cây Rừng Rậm... ném!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930106,
					"content": "Cành Cây Rừng Rậm? Là thứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930107,
					"content": "Cành Cây Rừng Rậm... thông tin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930108,
					"content": "Liễu rũ, thu thập. Đường sương, xử lý. Nước suối, gửi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930109,
					"content": "Cành Cây Rừng Rậm... thông tin Đường Sương!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930110,
					"content": "Là thông tin về Đường Sương Rừng Rậm à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930112,
					"content": "Cành Cây Rừng Rậm... ném! Rất nhiều nơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930113,
					"content": "Pahsiv... tìm! Pahsiv... mệt! Pahsiv... nằm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930114,
					"content": "Cành Cây Rừng Rậm... rất ít! Nhưng rương, rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930115,
					"content": "#Ah... Cảm ơn Paimon, cảm ơn {NICKNAME}, đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930116,
					"content": "Cô lại tìm được rương cho chúng tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "Pahsiv! Rương, kho báu, hoa, lấp lánh, ngọt, rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930118,
					"content": "Woa, còn có thứ khác sao? Pahsiv thật tốt bụng, nhưng nếu cứ lấy đồ của cô như vậy thì ngại lắm, hay là chúng ta trao đổi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930119,
					"content": "Trao... đổi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930120,
					"content": "Vì chúng ta là bạn bè, bạn bè thì phải dùng tấm lòng để trao đổi sự chân thành, kiểu vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930121,
					"content": "Vì thế, chúng tôi sẽ giúp cô tìm lại Cành Cây Rừng Rậm kia, sau đó trao đổi đồ với cô. Vậy được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930122,
					"content": "Còn có thể kiếm chút đồ ăn cho cô nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "Đúng rồi, Pahsiv một mình ở ngoài như vậy rất vất vả, chúng ta có thể giúp cô ấy kiếm gì ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930124,
					"content": "Đồ ăn! Tidalga! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930125,
					"content": "Cô thích ăn Tidalga à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "Tidalga! Tidalga! Tidalga Tidalga Tidalga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930127,
					"content": "Một ngày ăn năm bữa? Hay là một bữa ăn năm cái? Chà... Cảm thấy còn ăn khỏe hơn tôi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930128,
					"content": "Vậy Cành Cây Rừng Rậm là gì? Pahsiv, hình như cứ đến Đường Sương Rừng Rậm là tìm thấy phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930129,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930130,
					"content": "Cành Cây Rừng Rậm... ném! Rất nhiều nơi! Rất Erinnyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930131,
					"content": "Cành Cây Rừng Rậm nằm ở khắp Erinnyes sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#{NICKNAME} thông minh! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930133,
					"content": "Đường Sương, có hoa, Cành Cây Rừng Rậm, cũng hoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930134,
					"content": "Cành cây... Cành cây... Cành cây... Cành cây... Cành cây... Cành cây... Số lượng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930135,
					"content": "À... Lần này tôi hiểu rồi! Nơi tìm Cành Cây Rừng Rậm có mọc loài hoa giống ở Đường Sương Rừng Rậm, tổng cộng có sáu nơi, phải vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930136,
					"content": "Paimon thông minh! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930137,
					"content": "Hihi, vậy là chúng tôi hiểu rồi. Pahsiv nghỉ ngơi đi nhé, chuyện này cứ giao cho chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930138,
					"content": "#Paimon, {NICKNAME}, tốt bụng! Vì thế, chậm... chậm chậm! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
