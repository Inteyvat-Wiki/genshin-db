			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590101,
					"content": "Chỉ thiếu một chút thôi... tranh thủ trong 9 giờ chế tạo ra \"Đơn Dược Tuyết Sương\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590102,
					"content": "Timaeus? Anh đang làm gì vậy, nhìn có vẻ nghiêm túc quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590103,
					"content": "Là các bạn sao! Lâu rồi không gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590104,
					"content": "Thực ra tôi đang nghiên cứu để chế tạo \"Đơn Dược Tuyết Sương\", cho nên cần phải trưng dụng đài ghép một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590105,
					"content": "\"Đơn Dược Tuyết Sương\"? Chưa nghe qua thứ này bao giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590106,
					"content": "Đây là loại thuốc thần bí mới xuất hiện gần đây, tôi cũng chỉ mới đọc được tư liệu từ một số quyển sách cũ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590107
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590107,
					"content": "Theo tác giả nói, \"Đơn Dược Tuyết Sương\" bắt nguồn từ Liyue, có thể khiến người dùng tăng cường sức mạnh, đây nhất định là phát minh tuyệt vời của thuật giả kim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590108
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590108,
					"content": "\"Đơn Dược Tuyết Sương\" đã được đông đảo người dân Liyue công nhận, được miêu tả như là \"Hương thơm ngào ngạt tỉnh nghi chất\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590109,
					"content": "Theo tôi dự đoán, nếu như chế tạo thành công \"Đơn Dược Tuyết Sương\", nhất định sẽ khiến kiến thức giả kim của tôi tiến bộ mười năm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590110
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590110,
					"content": "Tiến bộ mười năm sao? Hình như hơi quá đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590111,
						716590112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590111,
					"content": "Tiền đề là quyển sách đó phải viết đúng đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				},
				{
					"id": 716590113,
					"content": "Yên tâm! Tác giả của quyển sách này là người học cao hiểu rộng, đã viết qua rất nhiều luận văn nổi tiếng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590114
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590114,
					"content": "Thuật giả kim là một bộ môn kỳ diệu, có thể tái hiện lại những kỹ thuật cổ đại, tham khảo thành quả nghiên cứu của người đời trước đó, rồi không ngừng cải tiến cho sau này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590115
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590115,
					"content": "Cho nên tôi mới tìm các loại tư liệu để chọn ra kiến thức có ích cho thuật giả kim, từ đó thúc tiến cho chủ đề nghiên cứu của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590116
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590116,
					"content": "Timaeus đúng là luôn có suy nghĩ tích cực nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590117,
					"content": "Nếu như hai vị có thể giúp tôi thì tôi nhất định sẽ hoàn thành nghiên cứu nhanh hơn, từ đó lấy được sự công nhận từ ngài Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590118,
					"content": "Cũng có thể tôi sẽ nhân cơ hội này để được trở thành trợ thủ của ngài Albedo, túc trực trong doanh trại của ngài ấy, nghiên cứu những đề tài cao siêu hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590119
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590119,
					"content": "#Thế nào {NICKNAME}? Chúng ta có nên giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590120,
						716590121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590120,
					"content": "Vì cái đài ghép của mình...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590122,
					"content": "Chúng ta cứ giúp đỡ thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590123,
					"content": "Cảm ơn hai vị! Tôi nhất định sẽ toàn tâm báo đáp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590124
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590124,
					"content": "Đợi khi \"Đơn Dược Tuyết Sương\" của tôi chế tạo xong thì tôi sẽ để các bạn thử nghiệm ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590125,
						716590126
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590125,
					"content": "Không cần khách sáo vậy đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590127,
					"content": "Thay vì thứ đó thì tôi muốn có thứ gì đó ăn được sẽ hay hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590128,
					"content": "Không thành vấn đề! Sau khi xong vụ này tôi sẽ trả thù lao tương ứng cho các bạn, sau đó mời hai bạn đi ăn một bữa no nê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590129
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590129,
					"content": "Thật sao! Hứa rồi đó nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590130,
					"content": "Giúp đỡ Timaeus thử chế tạo \"Đơn Dược Tuyết Sương\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590131
					]
				},
				{
					"id": 716590131,
					"content": "Haiz! Chỉ với tay nghề của tôi thì đúng là không thể chế tạo ra \"Đơn Dược Tuyết Sương\" thật, đành phải đi nhờ chuyên gia thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590132
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590132,
					"content": "Đi nhờ Albedo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590133,
					"content": "Không! Tuyệt đối không, như vậy khác gì hỏi đáp án từ thầy giáo chứ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590134
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590134,
					"content": "Nếu để ngài Albedo biết được đến cả một lọ thuốc tôi cũng làm không xong thì sau này sao mà công nhận tôi được chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590135
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590135,
					"content": "Cũng có lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590136,
					"content": "Vậy hay là đi hỏi Sucrose nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590137
					]
				},
				{
					"id": 716590137,
					"content": "Tuy thuật giả kim của Sucrose đúng là vượt trội hơn tôi, nhưng lĩnh vực của cô ấy không giúp ích gì được cho \"Đơn Dược Tuyết Sương\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590138
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590138,
					"content": "Vả lại thường ngày cô ấy cũng rất bận, không tiện làm phiền cô ấy lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590139
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590139,
					"content": "Hay là đi thỉnh giáo Lisa nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590140
					]
				},
				{
					"id": 716590140,
					"content": "Tiểu thư Lisa dạo này đang sắp xếp lại thư viện, nghe nói nhiều việc lắm... nếu như có người quấy rầy thì tiểu thư Lisa sẽ không vui đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590141
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590141,
					"content": "Nói chung thì, chúng ta đừng nên quấy rầy cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590142
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590142,
					"content": "Vậy phải làm sao đây? Vậy là xem như hết cách rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590143,
					"content": "Cũng còn... nhưng mà không phải ở Mondstadt, mà là ở Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590144
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590144,
					"content": "Trong quyển sách có ghi: \"Tông sư ẩn cư nơi bến cảng, huân phong thơm nồng mùi đất nham\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590145
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590145,
					"content": "Nghe nói \"huân phong\" trong tiếng Liyue là chỉ \"gió Nam\", cho nên tông sư có thể chế tạo ra \"Đơn Dược Tuyết Sương\" có thể đang ở phía Nam cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590146
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590146,
					"content": "Nếu như đi thỉnh giáo trực tiếp vị tông sư đó, nói không chừng sẽ có cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590147
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590147,
					"content": "Cho nên, có thể làm phiền hai vị cùng tôi đến Liyue một chuyến không? Tôi không rành đường lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590148,
						716590149
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590148,
					"content": "Ý nghĩa của câu thơ đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590150,
					"content": "Đương nhiên rồi, bạn phải tin tưởng vào năng lực của tôi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590151
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590151,
					"content": "Còn phải đến Liyue nữa... xa quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590152,
					"content": "Đúng rồi, nghe nói đồ ăn của Liyue ngon lắm. Sau khi hoàn thành chúng ta có thể dùng bữa ở Liyue luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590153
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590153,
					"content": "Câu này nghe lọt tai đó! Tôi tán thành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590154,
					"content": "Vậy tôi sẽ ăn hết mấy món nổi tiếng ở \"Vạn Dân Đường\" nhé, mấy món ở đó đúng là ăn bao nhiêu lần cũng không đủ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590155,
						716590156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590155,
					"content": "Có hơi đắt đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590157,
					"content": "Đừng lo, nếu so với thành quả nghiên cứu... không đúng, phải là so với công sức của hai vị thì chút tiền này có đáng là gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590158
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590158,
					"content": "Vậy chúng ta xuất phát ngay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590156,
					"content": "Tiền của Timaeus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590149,
					"content": "Anh chắc chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590126,
					"content": "Tôi cũng không cần thứ này cho lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590121,
					"content": "Vì sự nghiệp của Timaeus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590112,
					"content": "Tiền đề là suy đoán của anh phải đúng đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				}
			]
		},
		{
			"id": 7165902,
			"completionStepIds": [
				7165902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165902",
							"2"
						],
						"stepId": 7165902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590201,
					"content": "Để xem bản đồ thử... Phía nam cảng Liyue hình như có tên là \"Ngật Hổ Nham\" đúng không? Vậy là \"Đan Dược Tông Sư\" có lẽ đang ở đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590202
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590202,
					"content": "Chúng ta đến rồi, đây chính là \"Ngật Hổ Nham\"! Chúng ta đi xung quanh hỏi thăm thử thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7165903,
			"completionStepIds": [
				7165903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165903",
							"2"
						],
						"stepId": 7165903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590301,
					"content": "Mọi người giờ mới nhớ đến tôi sao, lại còn dẫn theo một vị bằng hữu... đến đây để chơi với tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590302
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590302,
					"content": "À, cũng không phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590303,
					"content": "Thực ra... tiểu thư Ying'er, chúng tôi tới để tìm \"Đan Dược Tông Sư\", cô có biết vị đại sư đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590304,
					"content": "À à, thì ra là có ý đồ khác sao? Tôi có chút thất vọng đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590305
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590305,
					"content": "Nhưng mà, nếu như mọi người đang thám thính bí mật của tôi thì tôi cũng khá bất ngờ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590306,
						716590307
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590306,
					"content": "Bí mật?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				},
				{
					"id": 716590308,
					"content": "Đợi đã, không lẽ tiểu thư Ying'er chính là \"Đan Dược Tông Sư\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590309,
					"content": "Càng ngày càng thông minh rồi đó, dễ cưng thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590310
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590310,
					"content": "Hoàn toàn không ngờ tới luôn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590311,
					"content": "\"Đan Dược Tông Sư\" trẻ tuổi thế sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590312
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590312,
					"content": "Có cảm giác hơi khác với ngài Albedo, nhưng cũng tỏa ra cái gì đó thần bí khó lường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590313
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590313,
					"content": "Trông các bạn có vẻ như đang gặp phải chuyện khó gì đúng không, nói nghe thử nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590314
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590314,
					"content": "Có cảm giác như chuyện này đang bẻ lái sang một hướng không thể ngờ tới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590315,
					"content": "Giải thích đề tài nghiên cứu \"Đơn Dược Tuyết Sương\" của Timaeus cho Ying'er nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590316
					]
				},
				{
					"id": 716590316,
					"content": "Thì ra là vậy, vị giả kim thuật sĩ này đang nghiên cứu \"Đơn Dược Tuyết Sương\" sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590317
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590317,
					"content": "Tiếc quá, để các bạn phải thất vọng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590318
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590318,
					"content": "\"Đơn Dược Tuyết Sương\" mà mọi người đang điều tra chẳng qua chỉ là một loại hương liệu thời xưa mà tôi đặc chế mà thôi, không có liên quan gì đến thuật giả kim cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590319
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590319,
					"content": "Hương liệu sao? Có phải là một loại sáp thơm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590320
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590320,
					"content": "\"Đơn Dược Tuyết Sương\" nghe có vẻ rất lợi hại! Trong sách còn nói là có thể khiến người ta trở nên khỏe mạnh hơn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590321,
					"content": "Haha, có thể là do loại sáp thơm này của tôi được nhiều người ưa chuộng quá thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590322
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590322,
					"content": "Người xưa từng nhấn mạnh chữ \"thấm nhuần\". Khi ở lâu trong môi trường hương thơm ngào ngạt thì khí chất và tâm tính của con người cũng sẽ chịu ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590323
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590323,
					"content": "Sau khi sử dụng sáp thơm cổ xưa của tôi, khí chất của con người sẽ thay đổi, sức hấp dẫn tăng mạnh, càng thêm tự tin khi giao tiếp, các mối quan hệ xã hội cũng không ngừng được cải thiện. Sự nghiệp sẽ từng bước lên cao, cuộc sống muốn gì được đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590324
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590324,
					"content": "Cũng giống như dùng đan dược của tiên nhân, vận số sẽ thay đổi một cách tích cực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590325
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590325,
					"content": "Do đó, mọi người đã đặt cho sáp thơm của tôi một danh hiệu tràn trề ý thơ, còn kèm theo câu thơ đơn giản dễ hiểu để tán thưởng công dụng của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590326
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590326,
					"content": "Hóa ra là vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590327,
					"content": "Không thể nào... Chẳng lẽ, luận văn mà tôi đã đọc trong quyển sách đó không hề đúng sao? Hay là do tôi đã hiểu sai về ý nghĩa của các câu thơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590328
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590328,
					"content": "Ví dụ như \"Hương thơm ngào ngạt tỉnh nghi chất\". Hàm ý của đoạn này phải là: \"Đơn Dược Tuyết Sương\" có thể kích hoạt uy nghi và phẩm chất tiềm tàng của con người... Không sai chứ, tiểu thư Ying'er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590329
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590329,
					"content": "Ây da, \"Nghi Chất\" ở đây thật ra là một từ hoàn chỉnh, có ý nghĩa là phong độ và khí chất của một người. Câu thơ này thực ra ý nói, sáp thơm cổ xưa có thể thay đổi hoàn toàn dáng vẻ và thái độ của một con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590330
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590330,
					"content": "Cũng không thể trách anh, thơ văn là một học vấn sâu rộng, không giống như phân tích dữ liệu, chỉ việc tách rời các chữ ra để phân tích, mà cần phải chú ý đến bối cảnh tổng thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590331
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590331,
					"content": "Cách tách từng chữ từng câu ra để phân tích lại không hữu hiệu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590332
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590332,
					"content": "Nhưng trong quyển sách đó đã nhắc đến rất nhiều ví dụ về công dụng thần kỳ của Đơn Dược Tuyết Sương, khiến tôi phải kinh ngạc vô cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590333
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590333,
					"content": "Những việc mang tính kích thích và bí ẩn luôn thu hút người ta mà, cũng giống như chúng ta nhìn xuyên qua khung cửa để ngắm hình bóng xinh đẹp. Các quyển sách ghi chép cũng phải thêm thắt một chút tính nghệ thuật chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590334
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590334,
					"content": "Rất cám ơn sự khen ngợi của vị tác giả đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590335
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590335,
					"content": "Sao lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590336
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590336,
					"content": "Cũng có nghĩa là, tài liệu mà Timaeus tham khảo đã phóng đại hiệu quả của sáp thơm, anh ấy cũng hiểu sai ý nghĩa câu thơ. Dẫn đến việc anh ấy hiểu nhầm và cho rằng \"Đơn Dược Tuyết Sương\" là một loại thuốc giả kim có công dụng thần kỳ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590337,
						716590338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590337,
					"content": "May mà đã chuẩn bị tâm lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590339,
					"content": "Đến cuối cùng, đề tài mà tôi nghiên cứu lại xây dựng trên một lý luận sai lầm sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590340
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590340,
					"content": "Lần này nghiên cứu thất bại, tôi lại tốn công vô ích nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590341
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590341,
					"content": "Ây da, cũng không cần nhụt chí như vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590342
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590342,
					"content": "Có câu \"Đường núi quanh co gặp suối nhỏ, cây khô nảy mầm thành tán râm\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590343
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590343,
					"content": "Có lẽ phương pháp chế tạo sáp thơm cổ xưa sẽ cho anh một số gợi ý, để anh có thể phá vỡ bế tắc, chế tạo ra một loại thuốc lý tưởng không chừng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590344
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590344,
					"content": "Đúng đó, tuy rằng điểm xuất phát có hơi toang, nhưng Timaeus dựa theo những gì mình hiểu, cũng sẽ có thể đạt được tiến triển nhất định đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590345,
					"content": "Tiểu thư Ying'er đã đề xuất như vậy rồi, chi bằng hãy thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590346,
					"content": "Có lẽ sẽ có thu hoạch bất ngờ đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590347
					]
				},
				{
					"id": 716590347,
					"content": "Nói cũng có lý lắm... Giả kim thuật là một học vấn thâm sâu, tôi cũng không phải thất bại lần đầu, nhất định phải phấn chấn lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590348
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590348,
					"content": "Phần lớn trường hợp tôi đều có thể đọc hiểu tư liệu một cách rất chính xác, lần này chỉ là sự cố mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590349
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590349,
					"content": "Cho dù không thể làm ra loại thuốc kỳ diệu như trong truyền thuyết, ít ra cải tiến thuốc giả kim hiện tại cũng là một thành tựu không tồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590350
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590350,
					"content": "Tiểu thư Ying'er, Nhà Lữ Hành, chúng ta hãy đến đài ghép đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590338,
					"content": "Cũng không bất ngờ lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590307,
					"content": "Bất ngờ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				}
			]
		},
		{
			"id": 7165904,
			"completionStepIds": [
				7165904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165904",
							"2"
						],
						"stepId": 7165904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus",
					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590401,
					"content": "Quy trình chế tạo sáp thơm cổ xưa à, cũng tương đối cầu kỳ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590402
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590402,
					"content": "Cũng giống như khi thoa lên da của người yêu, phải dùng lực cực kỳ nhẹ nhàng để tách và lấy các cánh hoa, xếp chúng thật tỉ mỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590403
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590403,
					"content": "Cánh hoa mỏng đặt bên trên, cánh hoa dày đặt bên dưới, phải chừa khoảng trống vừa đủ, rồi đem nghiền nát chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590404
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590404,
					"content": "Cầm chày không được nắm quá chặt, phải thả lỏng cổ tay, giã xuống và nhấc lên phải theo nhịp điệu nhất định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590405
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590405,
					"content": "Chờ đến khi có nước tiết ra, phía dưới cây chày đã ướt thì phải tăng tốc độ giã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590406
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590406,
					"content": "Việc này... e hèm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590407
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590407,
					"content": "Cách dùng từ của tiểu thư Ying'er thật... độc đáo! Tôi đã hiểu được đại khái rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590408
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590408,
					"content": "Phải xử lý nguyên liệu cẩn thận, chú ý thứ tự đặt vào vật chứa, khống chế thời gian ngấm nước để canh giữ độ lửa thật chuẩn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590409
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590409,
					"content": "Lúc làm các loại thuốc giả kim cao cấp, cũng cần phải tuân thủ những yêu cầu nghiêm ngặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590410
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590410,
					"content": "Ngộ tính của anh cũng khá đó chứ, nhưng những điểm chú ý khi chế tạo sáp thơm không chỉ như vậy thôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590411
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590411,
					"content": "Có một số sáp thơm cực kỳ chú trọng \"hiệu ứng thăng hoa\", cần phải cho phụ liệu thích hợp vào, ví dụ như bột Bạc Hà và Ốc Sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590412
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590412,
					"content": "Như thế mùi hương của sáp thơm sẽ nhanh chóng tỏa ra, thu hút sự chú ý của những người xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590413
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590413,
					"content": "Nhưng \"hiệu ứng thăng hoa\" cũng không được quá mạnh, nếu không sáp thơm sẽ nhanh chóng mất hết hương thơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590414
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590414,
					"content": "Thăng hoa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590415
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590415,
					"content": "Tôi hiểu rồi, đặc tính này của sáp thơm chính là điểm mấu chốt mà tôi tìm kiếm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590416
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590416,
					"content": "Thuốc phảng phất trong không khí có thể đồng thời tác động lên môi trường xung quanh của người sử dụng, so với tinh dầu thông thường thì hiệu quả này chắc sẽ rõ rệt hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590417
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590417,
					"content": "Hơn nữa, khi khống chế tốc độ thăng hoa một cách hợp lý, thời gian duy trì cũng sẽ lâu hơn so với tinh dầu thông thường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590418
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590418,
					"content": "Cố gắng theo hướng này, tuyệt đối sẽ không sai đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590419
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590419,
					"content": "Bước vào lĩnh vực thảo luận học thuật thì hoàn toàn không có cửa cho mình mở miệng luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590420,
					"content": "Thôi đừng làm phiền hai người họ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590421,
					"content": "Nhờ gợi ý của Ying'er, Timaeus đã thử cải tiến chế tạo thuốc giả kim.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590422
					]
				},
				{
					"id": 716590422,
					"content": "Thơm quá! Chỉ cần ngửi thôi đã cảm thấy sảng khoái và tràn trề năng lượng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590423,
						716590424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590423,
					"content": "Quả nhiên có thể làm cho người ta phấn chấn tinh thần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				},
				{
					"id": 716590425,
					"content": "Thành công rồi! Cuối cùng tôi cũng thành công rồi! Thuốc giả kim kết hợp với phương pháp chế tạo sáp thơm cổ xưa đã hoàn thành rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590426
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590426,
					"content": "Cũng nhờ có tiểu thư Ying'er chỉ dẫn mà tôi mới có thể tìm được điểm đột phá trong thời gian ngắn như vậy, lại còn thuận lợi chế tạo ra số thuốc này nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590427
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590427,
					"content": "Nếu quá khiêm tốn sẽ trở nên giả tạo và khách sáo đó. Học thức và ngộ tính của anh mới là điểm mấu chốt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590428
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590428,
					"content": "Bây giờ... chi bằng hãy tự đặt tên cho sản phẩm tâm huyết này của anh đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590429
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590429,
					"content": "Hãy gọi chúng là \"Ma Dược Tuyết Sương\" đi! Chúng được kết hợp giữa đặc tính sáp thơm của tiểu thư Ying'er và thuốc giả kim, vô cùng ý nghĩa, nhất định sẽ được ghi chép trong sử sách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590430
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590430,
					"content": "Ây da, vậy thì vinh hạnh cho tôi quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590431
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590431,
					"content": "Nhưng mà cái tên này với tên \"Đơn Dược Tuyết Sương\" lúc trước không có khác biệt mấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590432,
					"content": "Ha ha, xem như mượn lời người xưa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590433
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590433,
					"content": "Nhà Lữ Hành, bạn sẽ là người đầu tiên sử dụng Ma Dược Tuyết Sương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590434
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590434,
					"content": "Hiện tại Ma Dược Tuyết Sương vẫn cần hoàn thiện thêm, có thể phiền bạn thử nghiệm hiệu quả của số thuốc này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590435
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590435,
					"content": "Ở trong môi trường không khí chuyển động chậm rãi thì hiệu quả của Ma Dược Tuyết Sương này sẽ càng rõ rệt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590436
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590436,
					"content": "Nghe nói ở Liyue có một số bí cảnh không người, đó đúng là nơi thử nghiệm lý tưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590437,
						716590438
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590437,
					"content": "Giúp người giúp cho trót.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590439,
					"content": "Vậy xin phiền bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590440
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590440,
					"content": "Tôi sẽ ở đây thêm một thời gian nữa, tiếp tục giao lưu học thuật với tiểu thư Ying'er, chờ tin phản hồi từ bạn rồi sẽ tiến hành cải tiến Ma Dược Tuyết Sương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590441
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716590441,
					"content": "Chờ tin tốt của các bạn nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716590438,
					"content": "Tôi cũng thấy phấn chấn lên rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590424,
					"content": "Quả nhiên có công dụng thần kỳ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				}
			]
		},
