			"dialogs": [
				{
					"id": 716590601,
					"content": "Xin chào! Xin hỏi anh có quen với \"Đan Dược Tông Sư\" ở gần đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716590602,
					"content": "\"Đan Dược Tông Sư\"? Chưa từng nghe đến danh hiệu này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590603
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 716590603,
					"content": "Chỉ có nhân tài có công danh hiển hách mới xứng với hai chữ \"tông sư\" đúng chứ? Nhân vật nhỏ bé như tôi làm sao mà quen biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590604
					],
					"speakerTitle": "Qian"
