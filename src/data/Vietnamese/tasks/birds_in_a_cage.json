			},
			"dialogs": [
				{
					"id": 140250501,
					"content": "Arlecchino, vừa nãy cô và Neuvillette thảo luận chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250502,
					"content": "Gì mà vừa hồ nước vừa sông ngòi, lẽ nào... Hai người thảo luận chuyện liên quan đến công trình thủy lợi gì đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250503,
					"content": "Tò mò lắm sao? Hình như giờ không phải là lúc để quan tâm đến chuyện này nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250504
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250504,
					"content": "Cũng phải... Không biết phía Lyney thế nào rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250505,
					"content": "#{NICKNAME} đang nghĩ cách sao? Cố lên nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250506,
					"content": "(Arlecchino có vẻ rất ung dung, nhưng sát khí trên người cô ấy không có vẻ gì là diễn. Hình như cô ấy thực sự muốn lấy mạng những đứa trẻ bị nghi ngờ là \"phản bội\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250507
					]
				},
				{
					"id": 140250507,
					"content": "(Phải làm gì mới có thể ngăn cản cô ấy đây? Không, trước đó thì vẫn còn một vấn đề khác.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250508
					]
				},
				{
					"id": 140250508,
					"content": "(Lúc ở ngoài Palais Mermonia, cô ấy có nhắc đến cái tên Clervie. Chuyện này lẽ nào đang ám chỉ cô ấy sớm đã nắm rõ hành tung của Clervie? Hành động của nhóm Lyney đều nằm trong dự tính của Arlecchino sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250509
					]
				},
				{
					"id": 140250509,
					"content": "Á...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250510
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250510,
					"content": "Đau, đau... Đợi đã, không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250511
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250511,
					"content": "Đều tại tôi cả, mải lo bán báo mà không để ý phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250512,
						140250513
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250512,
					"content": "Xin lỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				},
				{
					"id": 140250514,
					"content": "À, để bồi thường, các vị hãy nhận lấy tờ báo này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250515
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250515,
					"content": "(Người này... trông hơi quen quen nhỉ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250516
					]
				},
				{
					"id": 140250516,
					"content": "Không cần đâu, như vậy ngại lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250517,
					"content": "Không sao không sao, dù gì tôi vẫn còn khá nhiều ở đây. Mấy thứ báo này nếu để đến mai thì tặng miễn phí cũng chẳng ai cần đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250518
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250518,
					"content": "Đều tại tôi cả, muốn kiếm thêm chút tiền chi tiêu cho gia đình mà nhất thời nhập quá nhiều hàng. Kết quả thì người đọc hôm nay ít quá, đến giờ vẫn chưa bán hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250519
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250519,
					"content": "Đang trò chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250520
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250520,
					"content": "Không có gì... Vừa nãy tôi tình cờ chạm mặt người bạn này, giờ tôi đi ngay đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250521
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250521,
					"content": "Đợi đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250522
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250522,
					"content": "Chuyện này... Nếu muốn bồi thường thì tôi không có sẵn tiền đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250523
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250523,
					"content": "Cho tôi ba tờ báo, Mora đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250524
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250524,
					"content": "Hả? Cảm ơn đã chiếu cố, thần linh sẽ phù hộ tài lộc cho quý vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250525
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250525,
					"content": "Nếu ngày nào cũng gặp được người hào phóng như vậy thì tốt biết mấy... Đùa thôi, ngày mai tôi sẽ nhập ít hàng lại, không thể vì sắp kết hôn mà sốt ruột quá được. Tạm biệt các vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250526
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250526,
					"content": "Xong việc rồi, ngồi tàu về Thị Trấn Poisson thôi. Trên đường chúng ta còn có thể đọc báo giết thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250527
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250527,
					"content": "Đợi... đợi đã... Đi dạo thêm lát nữa được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250528,
					"content": "À, tôi đói bụng rồi... Phải ăn no thì mới về được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250529,
					"content": "(Paimon đang cố gắng tìm lý do để khỏi quay về. Vẫn còn sớm, phía Lyney hẳn là chưa có tiến triển gì. Giờ phải làm sao đây...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250530
					]
				},
				{
					"id": 140250530,
					"content": "Xem ra hai người vẫn đang giữ lấy giấc mơ đẹp đẽ, cho rằng kéo dài thêm chút thời gian thì tình hình sẽ có chuyển biến à? Tôi thấy màn đấu tranh này thật là vô nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250531
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250531,
					"content": "Có điều, nếu hai người đáp ứng với tôi một điều kiện, thì tôi sẽ cho Lyney thêm chút thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250532
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250532,
					"content": "Ngoài ra, tôi cũng sẽ giải đáp thắc mắc của hai người. Ví dụ như Clervie rốt cuộc là ai, có quan hệ như thế nào với tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250533
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250533,
					"content": "Cô... sao đột nhiên hào phóng vậy? Định yêu cầu chúng tôi làm chuyện gì xấu xa à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250534,
					"content": "Đừng nên đánh giá bản thân quá cao, hai người không có năng khiếu làm chuyện xấu đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250535
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250535,
					"content": "Ồ, vậy tại sao cô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250536,
					"content": "Điều quan trọng nhất trong thương lượng chính là trao đổi lợi ích. Đơn phương đòi hỏi hoặc uy hiếp thì sẽ không đạt được kết quả như mong muốn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250537
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250537,
					"content": "Chúng tôi có thể nghe thử điều kiện của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250538
					]
				},
				{
					"id": 140250538,
					"content": "Tốt lắm. Đó là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250539
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250539,
					"content": "\"Đến thời điểm quan trọng, hãy đưa ra lựa chọn mà hai người coi là thích hợp nhất, giúp Căn Nhà Hơi Ấm một lần.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250540
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250540,
					"content": "Lạ thật, sao tôi thấy rất bình thường nhỉ... Nhưng mà \"thời điểm quan trọng\" là ám chỉ lúc nào chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250541,
					"content": "Chuyện này đành phải xem phán đoán của hai người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250542
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250542,
					"content": "Tôi có thể đáp ứng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250543
					]
				},
				{
					"id": 140250543,
					"content": "Thương lượng thành công! Hãy theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250513,
					"content": "Tôi cũng thiếu chú ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				}
			]
		},
