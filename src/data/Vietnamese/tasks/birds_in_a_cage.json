			"dialogs": [
				{
					"id": 140250102,
					"content": "Đông đủ rồi nhỉ, hôm nay cũng sẽ hành động theo kế hoạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250103,
						140250104
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250103,
					"content": "Đợi đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				},
				{
					"id": 140250105,
					"content": "Gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250106
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 140250106,
					"content": "Arlecchino từng hợp tác với Dottore bao giờ chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250107
					]
				},
				{
					"id": 140250107,
					"content": "Sao lại hỏi như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250108,
					"content": "Thực ra tối qua chúng tôi đã bắt gặp Clervie, chuyện này là do cô bé kể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250109,
					"content": "Chúng tôi cũng từng gặp Dottore ở Sumeru. Hắn ta không những nguy hiểm, mà còn làm qua rất nhiều chuyện xấu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250110,
					"content": "...Tôi không dám khẳng định Cha không qua lại với Dottore, nhưng tôi cho rằng Cha sẽ không hợp tác với người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250111
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250111,
					"content": "Chúng tôi không cùng một phe, cũng chẳng tin tưởng lẫn nhau, đương nhiên cũng sẽ không có cơ sở để hợp tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250112
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250112,
					"content": "Có điều, tôi nghe nói khi Cha mới lên làm Quan Chấp Hành thì Dottore quả thật có mở lời muốn hợp tác với Căn Nhà Hơi Ấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250113
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250113,
					"content": "Cha cũng đã từ chối hầu hết đề nghị, chỉ giữ lại duy nhất một thí nghiệm bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250114,
					"content": "Thí nghiệm bí mật? Lẽ nào chính là chuyện mà Clervie nhắc đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250115,
					"content": "Chắc là không phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250116
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140250116,
					"content": "Tôi không biết thí nghiệm bí mật đó là gì, nhưng nó được Căn Nhà Hơi Ấm hoàn thành một cách độc lập. Dottore chỉ cung cấp phương hướng nghiên cứu, nên không thể coi là hợp tác được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250117,
					"content": "Hơn nữa, chỉ có nội dung thí nghiệm được giữ bí mật, những người tham gia thí nghiệm đều có ghi chép đầy đủ, cũng khác với tình huống mà Clervie nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250118
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250118,
					"content": "Xin hãy tin tưởng chúng tôi. Căn Nhà Hơi Ấm trực thuộc Fatui, khó tránh khỏi việc sẽ làm một số chuyện mà hai vị khó lòng chấp nhận. Nhưng chúng tôi cũng có quy tắc và giới hạn của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250119,
					"content": "Phù... Vậy thì tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250120,
					"content": "Thú thật, nếu thực sự Arlecchino từng hợp tác với Dottore làm những chuyện quá đáng, thì tôi cũng không biết phải đối mặt với mấy người thế nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250121,
					"content": "Nhưng mà, lẽ nào Clervie đang nói dối sao? Cảm thấy không giống lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250122,
					"content": "Nếu có thể hỏi trực tiếp Arlecchino thì tốt rồi, nhưng chắc cô ấy sẽ không dễ dàng nói cho chúng ta đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250123,
					"content": "Hãy bắt đầu kế hoạch hôm nay trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250124
					]
				},
				{
					"id": 140250124,
					"content": "Hôm qua Cha không quay về, nên chắc vẫn đang ở gần bờ biển. Trông cậy vào hai người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250125,
					"content": "Lynette, em đi theo anh. Freminet cũng phải cẩn thận đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250126
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250126,
					"content": "Bắt đầu hành động!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250104,
					"content": "Tôi có một câu hỏi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				}
			]
		},
