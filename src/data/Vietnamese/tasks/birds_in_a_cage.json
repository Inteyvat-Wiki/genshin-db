			},
			"dialogs": [
				{
					"id": 140250301,
					"content": "Vẫn còn chút thời gian mới đến buổi đàm phán, chúng ta ở đây trò chuyện chút đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250302
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250302,
					"content": "Rất vui khi thấy hai người có thể kết thân với bọn trẻ nhà tôi. Trẻ con cần trưởng thành, và những mối quan hệ tốt là thứ không thể thiếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250303
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250303,
					"content": "Arlecchino... Cô sẽ xử lý họ thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250304,
					"content": "Lyney, Lynette, Freminet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250305
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250305,
					"content": "Và cả Filliol, Nanteuil nữa... Quả là không ít người nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250306
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250306,
					"content": "Tôi luôn đối xử bình đẳng với những kẻ phản bội, không có ngoại lệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250307
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250307,
					"content": "Cô... cô sẽ \"trừ khử\" họ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250308,
					"content": "Muốn xin tha cho chúng à? Rất tiếc, không ai có thể thay đổi quy tắc trong nhà. Ở nơi này, tất cả đều phải chịu trách nhiệm cho lời nói và hành vi của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250309
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250309,
					"content": "Cô... không có chút tình cảm nào với họ sao? Họ luôn gọi cô là Cha, và còn tôn trọng cô từ tận đáy lòng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250310,
					"content": "Trong bất kỳ một tổ chức nào, một khi tình cảm vượt lên khỏi quy tắc thì chắc chắn sẽ suy tàn nhanh chóng. Huống chi là một nơi nổi tiếng nghiêm khắc như Căn Nhà Hơi Ấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250311
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250311,
					"content": "Chỉ duy nhất một điều có thể an ủi hai người. Khi đã là khách, thì hai người sẽ không nằm trong phạm vi bị tính sổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250312
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250312,
					"content": "Không có cách giải quyết khác sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250313
					]
				},
				{
					"id": 140250313,
					"content": "Nhóm của Lyney chắc sẽ giữ được tính mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250314
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250314,
					"content": "Còn đám Filliol, Nanteuil, cả Clervie... Chúng muốn tạo phản, vậy thì không còn cơ hội nữa rồi. Không ai có thể mang theo bí mật mà sống sót rời khỏi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250315
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250315,
					"content": "Chuyện này... thật là tàn nhẫn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250316,
					"content": "Vậy đi. Nể mặt khách, tôi sẽ đợi thêm một thời gian nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250317
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250317,
					"content": "Nếu trong thời gian này mà nhóm Lyney có thể khiến Clervie biến mất, tức là chứng cứ sẽ bị tiêu hủy, thì tôi sẽ không truy cứu lỗi lầm của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250318
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250318,
					"content": "Còn không, tôi sẽ tóm gọn tất cả những kẻ đang làm chuyện sai trái, và chúng đều sẽ phải chịu hình phạt thảm khốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250319,
						140250320
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250319,
					"content": "Quyết định vậy đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				},
				{
					"id": 140250321,
					"content": "Yên tâm. Còn nữa, thứ này hai người giữ cho kỹ, đừng làm mất nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250322
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250322,
					"content": "Để huấn luyện một chú bồ câu ảo thuật sẽ phải mất rất nhiều thời gian, để chết thì cũng hơi đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250323
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250323,
					"content": "Cô... cô bắt được nó ở đâu vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250324,
					"content": "Được rồi. Trò chuyện đến đây thôi, đến lúc quay về việc chính rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250325
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250325,
					"content": "Tôi hẹn gặp hai người tại đây là vì tôi phải đến Palais Mermonia để bàn bạc một chuyện. Không liên quan gì đến hai người, nhưng hãy đi theo tôi, đừng nghĩ đến chuyện quay về báo tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250326
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250326,
					"content": "Đi thôi, cũng đến lúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250320,
					"content": "Không được nuốt lời nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				}
			]
		},
