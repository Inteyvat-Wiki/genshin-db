			"dialogs": [
				{
					"id": 140250201,
					"content": "Lại gặp rồi. Trông bộ dạng của hai người... đêm qua chắc là ngủ không ngon nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250202
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250202,
					"content": "Một chút thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250203,
					"content": "Bớt lo lắng thì biết đâu sẽ ngủ ngon hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250204
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250204,
					"content": "Tiếp theo muốn làm gì đây? Đi ngủ tiếp hay vắt óc suy nghĩ chủ đề thảo luận nào đó mới?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250205
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250205,
					"content": "Quả thật tôi hơi tò mò đấy. Hôm nay Childe không có mặt, hai người định tìm lý do gì để giữ chân tôi ở đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250206
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250206,
					"content": "(!!!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250207
					]
				},
				{
					"id": 140250207,
					"content": "Cô... cô đang nói gì vậy? À ừm, chúng tôi chỉ muốn trò chuyện chút thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250208,
					"content": "Nếu chưa nghĩ ra thì cùng tôi đến một nơi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250209
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250209,
					"content": "Đừng căng thẳng, chúng ta sẽ né tránh mấy đứa nhóc lén lén lút lút đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250210
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250210,
					"content": "A... Gió biển hôm nay dễ chịu thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250211,
					"content": "Cô biết hết rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250212
					]
				},
				{
					"id": 140250212,
					"content": "Trẻ con luôn tự cho rằng chúng có thể qua mặt người lớn, nhưng những chiêu trò đó tôi nhìn rõ mồn một. Để chúng vật lộn thêm một thời gian nữa đi, tôi có đủ sự kiên nhẫn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250213
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250213,
					"content": "Tôi đi trước đây, nghĩ kỹ đi rồi theo tôi. Chúng ta gặp nhau trước cửa Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250214
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250214,
					"content": "#Nếu {F#cô}{M#cậu} ngoan ngoãn nghe lời thì may ra chúng vẫn còn cơ hội giữ lấy cái mạng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250215
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250215,
					"content": "Làm sao bây giờ!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250216,
					"content": "Giọng điệu vừa nãy rõ ràng là đã biết hết những gì chúng ta làm. Hơn nữa cô ấy còn tỏ ý đe dọa chúng ta nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250217,
					"content": "Thả bồ câu ảo thuật mà Lyney đưa chúng ta trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250218
					]
				},
				{
					"id": 140250218,
					"content": "Ừm, hy vọng Lyney có thể nhận được cảnh báo kịp thời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250219,
					"content": "Tiếp theo chúng ta vẫn phải đến Palais Mermonia một chuyến. Cô ấy đã nói vậy rồi, tôi thấy nếu không đi thì hậu quả sẽ rất nghiêm trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250220,
						140250221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250220,
					"content": "Cũng không còn cách nào tốt hơn rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				},
				{
					"id": 140250222,
					"content": "Vậy chúng ta mau đuổi theo thôi. Nếu cô ấy sốt ruột quá mà trực tiếp đi tìm nhóm Lyney thì hỏng bét!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250221,
					"content": "Tới đâu tính tới đó vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				}
			]
		},
