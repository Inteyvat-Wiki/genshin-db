			},
			"dialogs": [
				{
					"id": 140250401,
					"content": "Lâu rồi không gặp, ngài Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250402
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250402,
					"content": "Không ngờ cuộc gặp của tôi lại được phê duyệt nhanh như vậy. Hiệu quả làm việc của Palais Mermonia thật đáng ngưỡng mộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250403
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250403,
					"content": "Với một nhà ngoại giao nổi tiếng thì đây cũng là sự tôn trọng cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250404
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250404,
					"content": "Nhưng khách quan mà nói, tôi vốn tưởng rằng buổi \"tặng Gnosis\" sẽ là lần gặp mặt cuối cùng của chúng ta chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250405
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250405,
					"content": "#...Lần này còn đi cùng {NICKNAME} và Paimon nữa, rốt cuộc là có chuyện gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250406
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250406,
					"content": "Tôi sắp phải rời Fontaine rồi, trước khi rời đi thì vẫn còn một việc chưa thể yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250407
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250407,
					"content": "Chỉ với vài câu nói thì không thể giải thích rõ. Tôi đã viết một bản đề xuất ở đây, mời ngài Neuvillette xem qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250408
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250408,
					"content": "Arlecchino đưa ra một phần tài liệu, sau đó nâng ly lên cao, thưởng thức thứ nước trong đó một cách tao nhã.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140250409
					]
				},
				{
					"id": 140250409,
					"content": "Tôi hiểu yêu cầu của cô rồi. Thứ lỗi cho tôi nói thẳng, tôi không lý giải nổi lý do cô làm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250410
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250410,
					"content": "Nghe nói ngài Neuvillette có sở thích thưởng thức các loại nước, để tôi lấy nước làm ví dụ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250411
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250411,
					"content": "Gia đình cũng giống như một hồ nước khổng lồ, có vô số dòng sông hội tụ tại đây, và cũng có vô số dòng sông khởi nguồn từ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250412
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250412,
					"content": "Là một người quan sát hồ nước mỗi ngày, tôi hy vọng mỗi dòng sông chảy ra đều có thể chạm đến đại dương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250413
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250413,
					"content": "Nhưng sự thật khách quan lại cho tôi thấy điều này là bất khả thi. Phần lớn dòng sông đều sẽ khô cạn dọc đường, thấm vào bùn đất, và rồi biến mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250414
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250414,
					"content": "Tôi muốn tìm ý nghĩa tồn tại cho những \"dòng sông không thấy mặt biển\" đó. Ví dụ như tưới tiêu ruộng vườn hai bên bờ, hay trở thành dòng suối ngọt trong lòng ai đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250415
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250415,
					"content": "#Này, {NICKNAME} nghe hiểu gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250416,
						140250417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250416,
					"content": "Không hiểu lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				},
				{
					"id": 140250418,
					"content": "Tôi phải nhắc nhở cô, dù cô có làm đẹp chúng bằng cách nào thì cũng không có ai muốn nếm thử \"nước đục\" đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250419
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250419,
					"content": "Là \"nước từng đục\". Đừng lo, tôi sẽ lọc sạch cặn bã trong nước, đưa chúng trở về với dáng vẻ tinh khiết nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250420
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250420,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250421
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250421,
					"content": "Cô đã đề cập đây là một vụ \"giao dịch\", vậy thì chúng ta nói chi tiết hơn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250422
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250422,
					"content": "Nếu ngài Neuvillette đồng ý với đề xuất của tôi, thì tôi sẽ rút dần thế lực của mình khỏi Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250423
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250423,
					"content": "Từ nay về sau, nếu không phải tình huống cần thiết, chúng tôi sẽ không thực hiện bất kỳ \"nhiệm vụ đặc biệt\" nào ở Fontaine nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250424
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250424,
					"content": "Ý của cô là, từ nay về sau sẽ không xảy ra những chuyện như \"Tartuffe bị ám sát\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250425
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250425,
					"content": "Ngài đang nói về tên đạo đức giả tham ô tiền từ thiện đó sao? Tôi bày tỏ lòng tiếc thương cho sự ra đi của hắn, nhưng trước mắt hình như không có chứng cứ nào chỉ ra là có sự hiện diện của Căn Nhà Hơi Ấm nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250426
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250426,
					"content": "Đương nhiên, nếu ngài Neuvillette đáp ứng đề xuất của tôi, thì tôi có thể giúp đỡ một số việc để giảm bớt những rắc rối kiểu đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250427
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250427,
					"content": "Những lời này quả không chút sơ hở. Thôi được, trên nguyên tắc, tôi đồng ý với đề xuất của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250428
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250428,
					"content": "Cảm ơn sự rộng lượng của ngài, ngài Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250429
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250429,
					"content": "Giao dịch thành công, chúng tôi cũng nên lui thôi. Tôi đã cử người mang hai bình nước suối từ Snezhnaya đến rồi, hy vọng lần tới sẽ có cơ hội được lắng nghe cảm nhận của ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250430
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250430,
					"content": "Gặp lại sau, hãy nhớ lời hứa của cô đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250431
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140250431,
					"content": "#Được rồi, {NICKNAME}, Paimon, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 140250417,
					"content": "Hiểu một nửa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250418
					]
				}
			]
		},
		{
