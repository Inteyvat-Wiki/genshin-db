			"dialogs": [
				{
					"id": 200070401,
					"content": "Thật cảm ơn quá, đám này cũng kiên trì quá, những vật săn này hấp dẫn đến vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070402,
					"content": "Cũng là do ngài Draff có thể săn được những con thú tốt như vậy, nếu tôi cũng có thể trở thành người thợ săn giống ngài ấy thì tốt quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070403,
					"content": "Trước lúc đó, tôi phải đem xe vào thành trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070404,
					"content": "Xin lỗi, Nhà Lữ Hành, vốn dĩ xe đã gần sửa xong, nhưng hồi nãy lại bị tấn công, lại bị hỏng thêm vài chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070405,
					"content": "Nhưng ở đây thì càng nguy hiểm, cần phải nhanh chóng sửa xe, tôi nhớ trên xe có dây buộc, nhất định là bị đám Hilichurl lúc nãy làm mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070406,
					"content": "Nhà Lữ Hành, có thể giúp tôi tìm <color=#00E1FFFF>dây thừng</color> không?",
					"roleType": "TALK_ROLE_NPC",
