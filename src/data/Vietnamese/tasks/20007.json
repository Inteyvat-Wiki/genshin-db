			"dialogs": [
				{
					"id": 200070101,
					"content": "#Cảm, cảm ơn bạn, {NICKNAME}, thật tốt quá, tôi còn tưởng lần này tiêu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070102,
					"content": "Trên xe là thành quả mà các thợ săn đã cực khổ săn được, ngài Draff kêu tôi đem tới thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070103,
					"content": "Tuy rằng tôi không... giỏi việc săn bắn lắm, nhưng công việc giao đồ đơn giản như vậy, chắc là vẫn làm được, lúc đầu tôi nghĩ vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070104,
					"content": "Nhưng suýt chút nữa là làm hỏng việc rồi. Đột nhiên bị tập kích, nhất định là những vật săn này tốt quá, nên đám đó cũng thèm muốn, may mà bạn đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070105,
					"content": "Khụ, tuy rằng rất ngại, nhưng... lúc nãy khi bị tập kích, xe hàng cũng bị làm hỏng rồi, muốn rời khỏi đây, tôi phải sửa lại xe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070106,
					"content": "Khu rừng xung quanh chắc là có nguyên liệu dùng được. Nhưng vật săn vẫn ở trên xe, nếu đi khỏi thì tôi cũng rất lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070107,
					"content": "Nếu có thể, bạn có thể tìm giúp tôi <color=#00E1FFFF>thanh gỗ chắc chắn</color> ở xung quanh được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
