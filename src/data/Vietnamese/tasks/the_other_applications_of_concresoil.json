					"nextDialogs": [
						230091403
					]
				},
				{
					"id": 230091403,
					"content": "A! Là, là bạn à, Nhà Lữ Hành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091404,
					"content": "Đừng nhắc nữa, \"Bê Tông\" của tôi đã xảy ra vấn đề rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091405,
					"content": "Không biết là do công thức của tôi có vấn đề, hay là do tôi chưa tính đến tình hình sử dụng thực tế nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091406,
					"content": "Nhiều người sử dụng \"Bê Tông\" để xây nhà bếp đều nói, sau khi sử dụng một thời gian, đất đã bị nứt nẻ ở nhiều mức độ khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091407,
					"content": "Có lẽ do nhiệt độ quá cao khiến cho các thành phần bên trong bùn đất mất tác dụng rồi chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091408,
					"content": "Haiz, dù sao đi nữa, tôi phải đi giúp họ sửa lại những phần bị hỏng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091409,
					"content": "Vì phải sửa cho quá nhiều người nên phần \"Bê Tông\" đó không thể mang đi kịp... họ đành phải để tạm trong chậu... cả một chậu lớn luôn ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091410,
					"content": "Nhà Lữ Hành, bạn hãy giúp tôi đến nhà này thu hồi \"Bê Tông\" đã vứt bỏ nhé, tôi sẽ tới nhà khác thu hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091411,
					"content": "Haiz, rốt cuộc đã xảy ra vấn đề ở đâu chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
