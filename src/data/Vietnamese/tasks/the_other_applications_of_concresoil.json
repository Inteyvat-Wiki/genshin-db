			"dialogs": [
				{
					"id": 230090201,
					"content": "Tôi phải mua thêm một số nguyên liệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090202,
					"content": "\"Bê Tông\" của anh sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "Rất tốt! Nói đúng hơn là phạm vi ứng dụng cho loại vật liệu này nằm ngoài sức tưởng tượng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090204,
					"content": "Có thể dùng nó để làm chai lọ, cũng có thể sửa chữa các lỗ hổng trong nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090205,
					"content": "Chỉ cần bạn điều chỉnh tỷ lệ trộn của các loại đất khác nhau thì sử dụng chúng để xây nhà cũng không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090206,
					"content": "Nhưng mà... Vì mọi người đều tới tìm tôi đặt mua loại đất này, nên nguyên liệu của tôi lại không đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090207,
					"content": "Hơn nữa Dịch Slime quan trọng nhất cũng dùng hết rồi, Nhà Lữ Hành, có thể nhờ bạn đi mang ba phần Dịch Slime về cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090208,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "Nhờ bạn đấy, Nhà Lữ Hành, xin hãy mang ba phần Dịch Slime về cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090209,
					"content": "Còn những nguyên liệu khác thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "Tôi đã đặt mua những nguyên liệu khác ở đủ chỗ, hoặc nhờ người đi tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090211,
					"content": "Nhưng Dịch Slime hết nhanh quá, nằm ngoài dự liệu của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "Akim"
				}
			]
		},
