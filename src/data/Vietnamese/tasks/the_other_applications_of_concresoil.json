					"nextDialogs": [
						230091703
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091703,
					"content": "Akim bắt đầu trộn bùn đất...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "Thế này là được rồi, Nhà Lữ Hành, bạn hãy đưa một phần vật liệu này cho Nima giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
