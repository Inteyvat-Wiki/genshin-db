					"nextDialogs": [
						230091803
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091803,
					"content": "Giờ thì em có thể làm \"Adri\" rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091804
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091804,
					"content": "\"Adri\" là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091805
					]
				},
				{
					"id": 230091805,
					"content": "#{M#Anh}{F#Chị} không nghe anh Akim nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091806
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091806,
					"content": "Em đang làm \"Chiến Sĩ Chậu Đất\", \"Adri\" chính là \"Chiến Sĩ Chậu Đất\" đầu tiên và mạnh nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091807
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091807,
					"content": "Nó tốt tính lắm, hiền lành nữa. Lúc \"Chiến Sĩ Chậu Đất\" vừa tỉnh lại, điều đầu tiên nó làm là xin lỗi bãi cỏ bị nó đè lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091808
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091808,
					"content": "Năng lực của nó là... năng lực là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091809
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091809,
					"content": "#Em... em vẫn chưa nghĩ ra... chờ em nghĩ ra rồi sẽ nói cho {M#anh}{F#chị} đầu tiên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091810
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091810,
					"content": "Sau khi làm xong \"Adri\", em còn phải làm sĩ quan phụ tá \"Ivar\" và học trò \"Lasson\" của nó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091811
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091811,
					"content": "Ba người họ... không đúng, là ba \"Chiến Sĩ Chậu Đất\" sẽ bắt đầu chuyến phiêu lưu rất dài...",
