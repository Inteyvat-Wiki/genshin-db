				{
					"id": 230091401,
					"content": "Lần này tiêu rồi, rốt cuộc xảy ra vấn đề ở đâu chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091402
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091402,
					"content": "Sao thế?",
