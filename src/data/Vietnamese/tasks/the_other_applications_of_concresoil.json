					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "Người này bảo bản thân hay trồng hoa, chuyện phiền toái nhất chính là tìm được loại đất trồng hoa phù hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "Vừa phải có tính thoáng khí, dinh dưỡng lại phải tốt, không thể hút nước quá nhiều, cũng không thể quá dễ thoát nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Anh ấy đã thấy \"Bê Tông\" có nhiều phương án cải tiến như vậy, nên muốn nhờ tôi thiết kế một loại \"Đất Ngưng Kết\" chuyên dùng để trồng hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "Tôi nghĩ đây là một hướng đi thú vị, vì vậy tôi đang tìm kiếm các vật liệu khác để cải thiện \"bê tông\" của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Lần này, tôi muốn nhờ bạn giúp tôi đào một ít đất sét màu mỡ về đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "Tôi sẽ chỉ cho bạn vị trí của chỗ có đất sét đó trên bản đồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091109,
					"content": "Sao lại xa thế chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
					"content": "Nơi này là do tôi nhờ người nghe ngóng, tuy có hơi xa, nhưng nghe nói đất sét ở đó vô cùng màu mỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091112,
					"content": "Nhưng... ờm... Ở đó hình như cũng có rất nhiều ma vật, một mình tôi cũng không dám đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091113
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091113,
					"content": "Cho nên tôi chỉ có thể nhờ bạn thôi đó! Nhà Lữ Hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091110,
					"content": "Anh tìm ra nơi này như thế nào vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				}
			]
		},
