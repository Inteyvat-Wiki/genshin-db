						230091705
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091705,
					"content": "Nima đã chờ bùn đất này rất lâu rồi, chắc đang sốt ruột lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091706,
					"content": "Đứa nhỏ này... ừm... có trí tưởng tượng không tầm thường chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091707,
					"content": "Nima nói với tôi, nó muốn tạo một đoàn \"Chiến Sĩ Chậu Đất\", đoàn chiến sĩ này đều là các chậu đất biết nói, có thể lăn lăn để đánh ngã kẻ địch, còn có các năng lực thần kỳ khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091708,
					"content": "Mà năng lực của đoàn \"Chiến Sĩ Chậu Đất\" sẽ khác nhau tùy theo vật liệu nhét vào \"chậu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091709,
					"content": "Nó còn đặt tên cho \"Chiến Sĩ Chậu Đất\" nữa, hình như tên là A cái gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091710,
					"content": "Hahaha, mặc dù không thực hiện được, nhưng ý tưởng của nó thật thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091711,
					"content": "Nên tôi nghĩ, nếu nó đã có cách thức mới lạ như thế, chi bằng tặng số vật liệu này cho nó làm đồ chơi cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091712,
					"content": "Như vậy, nó có thể tự tay tạo ra đám \"Chiến Sĩ Chậu Đất\" của mình, chính thức trở thành \"Tướng Quân Chậu Đất\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091713,
					"content": "Khụ khụ, tạm không nói nữa, tóm lại nhờ bạn đưa cho Nima nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091714,
					"content": "Đến khi \"Chiến Sĩ Chậu Đất\" của nó chính thức ra lò, biết đâu nó cũng sẽ phong cho tôi và bạn danh hiệu \"Đại Tướng Chậu Đất\" đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
