			"dialogs": [
				{
					"id": 4843101,
					"content": "May quá, người của Đội Kỵ Sĩ Tây Phong! Bọn Hilichurl chắc là không dám đuổi theo...",
					"roleType": "TALK_ROLE_NPC",
