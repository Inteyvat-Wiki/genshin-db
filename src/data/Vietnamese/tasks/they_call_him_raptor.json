					"nextDialogs": [
						4841104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841104,
					"content": "#{NICKNAME}, chúng ta đi theo dấu vết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841105,
					"content": "Í, hình như trước mặt có động tĩnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841106,
					"content": "Hình như là tiếng đánh nhau, chẳng lẽ là quái điểu?!",
