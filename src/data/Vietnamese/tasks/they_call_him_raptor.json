					"nextDialogs": [
						4840603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840603,
					"content": "Vậy cũng nhìn ra được là Phong Chi Dực à? Không hổ là Kỵ Sĩ Trinh Thám.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840604,
					"content": "Ừ, nếu quả thật là quái điểu, vậy thì Phong Chi Dực của nó đã bị hỏng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841101,
					"content": "Dấu vết của Nguyên Tố chỉ về hướng trước mặt.",
