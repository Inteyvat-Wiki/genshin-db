			},
			"dialogs": [
				{
					"id": 722500101,
					"content": "Á! Cứu, cứu mạng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500102
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500102,
					"content": "Tiểu nhân nghe nói các đại nhân đang phải vật lộn để đối phó với cuộc nổi loạn do Supada no Hiko lãnh đạo, Dainichi Mikoshi phòng vệ lỏng lẻo, nên mới nghĩ đến một suy nghĩ không nên nghĩ tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500103
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500103,
					"content": "Tiểu nhân có mẹ già bệnh tật cần phụng dưỡng và 12 đứa trẻ mồ côi cần phải nuôi nấng! Xin đại nhân giơ cao đánh khẽ, xem tiểu nhân như một cái rắm mà hãy tha cho tiểu nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500104
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500104,
					"content": "Khụ khụ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722500105
					]
				},
				{
					"id": 722500105,
					"content": "Ơ, ủa, cái gì chứ, thì ra không phải là thủ vệ của Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500106
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500106,
					"content": "Nhìn cách ăn mặc quái dị của ngươi...không phải người cùng nghề từ nơi kỳ lạ nào đó đến chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500107
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500107,
					"content": "Cái gì mà cùng nghề hay không cùng nghề chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500108,
					"content": "Đến đây rồi mà còn giả vờ gì chứ, haiz, đúng là xui xẻo mà, khó khăn lắm mới vào được Dainichi Mikoshi, vừa định lên kế hoạch kiếm tiền thì bị nhốt trong cơ quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500109
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500109,
					"content": "Hôm nay xem ra không phải là ngày thích hợp...thích hợp để cướp của người giàu chia cho người nghèo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500110
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500110,
					"content": "Hừm, kẻ trộm là kẻ trộm, cái gì mà cướp của người giàu chia cho người nghèo chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500111,
					"content": "Ngươi thì hiểu gì chứ, bọn đại nhân ngày ngày ăn chơi rượu chè, suy đồi thác loạn, những người thấp kém như bọn ta phải làm việc sống chết, đổ bô cho bọn chúng, làm ấm giày rơm cho bọn chúng, ở đâu ra cái kiểu như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500112
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500112,
					"content": "À đúng rồi, ta nói cho ngươi nghe một bí mật, xem như báo đáp ơn cứu mạng. Lúc trước ta đã mua chuộc một tên thợ sửa chữa Dainichi Mikoshi, còn hai căn phòng cất giấu kho báu giống như vậy nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500113
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500113,
					"content": "Còn hai phòng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500114,
					"content": "#{NICKNAME}, tôi thấy chúng ta cũng nên, nên cướp của người giàu chia cho người nghèo đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500115,
					"content": "Nhưng tôi cũng không biết rõ vị trí hai căn phòng đó, vì tên thợ đó cũng không dám nói thêm gì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500116
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500116,
					"content": "Tình báo này xem như một món quà vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500117
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500117,
					"content": "Dù sao bây giờ Enkanomiya cũng không có người, nói không chừng ở đó có rất nhiều đồ cổ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500118,
					"content": "#{NICKNAME}, lát nữa chúng ta thử tìm xung quanh xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}