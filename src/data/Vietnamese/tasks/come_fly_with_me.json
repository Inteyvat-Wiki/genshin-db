			"dialogs": [
				{
					"id": 750700901,
					"content": "Haha, hoàn hảo! Đây là bản sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700902,
					"content": "Woa! Trông tuyệt thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "Nào, thù lao của các vị đây. Đây là lần thứ hai... Không, lần thứ ba được các vị giúp đỡ rồi... Không biết nếu không được giúp đỡ thì hành trình chụp ảnh của tôi liệu có hoàn thành hay không đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700904,
					"content": "Địa điểm tiếp theo tôi muốn đến là nơi này... đã đánh dấu trên bản đồ cho các vị rồi đấy. Nếu có hứng thú, tôi luôn mong chờ được hợp tác với các vị một lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700905,
					"content": "A... Sắp đến lúc rồi, tôi phải đi đây! Cũng chúc các vị may mắn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700906,
					"content": "Magnifico thu dọn hành lý, vui vẻ nhảy lên khí cầu.\\nMagnifico nhỏ bé cười lớn, cùng khinh khí cầu chậm rãi bay xa, để lại âm thanh vang vọng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
