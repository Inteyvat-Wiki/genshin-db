			"dialogs": [
				{
					"id": 750700701,
					"content": "Haha! Tôi biết chúng ta sẽ gặp lại nhau mà! Đến thật đúng lúc! Các vị sắp được chứng kiến tôi chụp lại kiệt tác thứ hai trong đời mình rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700702
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700702,
					"content": "Hmm... Cũng không phải thứ hai, vì tôi cũng có nhiều tác phẩm hay lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700703
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700703,
					"content": "Tóm lại, các vị vô cùng may mắn đấy, tôi đang chuẩn bị chụp một bức ảnh với khung cảnh sống động tại đây. Haha, đây là lần đầu tiên tôi chụp ảnh kiểu này đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700704
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700704,
					"content": "Dù gì những bức ảnh trước đây chụp đều là ảnh của nạn nhân tại hiện trường vụ án... Hừm, nhưng những cái đó cũng không cần nói chi tiết làm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700705
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700705,
					"content": "Cho nên lần này vẫn cần chúng tôi giúp đỡ sao, ngài Magnifico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700706,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750700707,
					"content": "Không... Hmm, ừm, mà nếu các vị có thể giúp cũng tốt! Nào, để tôi nói sơ về tình hình hiện tại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700708
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700708,
					"content": "Tôi cần chụp một bức ảnh Qucusaur lao về phía mặt nước ở thác nước này. Chính là khoảnh khắc chấn động nhất khi nó lao xuống mặt nước dưới thung lũng ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700709
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700709,
					"content": "Để chuẩn bị, tôi đã giấu thức ăn có thể thu hút Qucusaur trong hồ nước dưới thác. Chẳng qua... Haiz, đến giờ tôi vẫn chưa đợi được chúng lao xuống từ góc độ phù hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700710
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700710,
					"content": "Ơ? Nhưng cái vòng lớn trên mặt nước... là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700711,
					"content": "Không cần để ý cái đó đâu, tôi cũng không rõ lắm... Chỉ là rác tôi nhặt từ bộ tộc gần đây dùng để làm bia ngắm mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700712
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700712,
					"content": "Haiz, đến bây giờ thì ảnh mà tôi chụp được đều rất tầm thường, thật tức quá đi. Tôi vẫn đợi tiếp được, nhưng nếu các vị đã đến thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700713
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700713,
					"content": "Có lẽ các vị... ừm, có thể dạy chúng cách để lao xuống không? Dù sao thì các vị cũng là bậc thầy thuần phục Saurian nổi danh khắp Natlan mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700714
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700714,
					"content": "Tốt lắm, tôi sẽ phát tín hiệu ở đây. Chỉ cần khi tôi đếm đến \"một\", các vị lao đến mặt nước chỗ bia ngắm là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700715,
						750700717
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700715,
					"content": "Để chúng tôi thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700716
					]
				},
				{
					"id": 750700716,
					"content": "Haha, thật tốt quá! Vậy thì mau thử xem nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700717,
					"content": "Chúng tôi không đảm bảo sẽ thành công...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700718
					]
				},
				{
					"id": 750700718,
					"content": "Không sao, thất bại thì chỉ phí thời gian mà thôi. Chúng ta là nhà lữ hành mà, thời gian dư dả nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700719,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
