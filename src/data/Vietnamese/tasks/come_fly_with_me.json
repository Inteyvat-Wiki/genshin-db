			"dialogs": [
				{
					"id": 750701401,
					"content": "Hừ, chúng ta phải làm lại lần nữa rồi! Hừm... Ý tôi là nếu các vị không ngại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701402,
					"content": "Haiz... Cũng đã đến đây rồi, không có gì phải ngại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701403,
					"content": "Chúng ta tiếp tục nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "Ừm, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701405,
					"content": "Để chúng tôi nghỉ ngơi một lúc đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "Nhảy xuống vách núi là việc tốn sức, cũng nên cho người ta nghỉ ngơi một chút chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701407,
					"content": "Ừm... Xin lỗi, là tôi không chu đáo. Đợi khi các vị chuẩn bị sẵn sàng thì bắt đầu nhé, tôi sẽ luôn đợi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
