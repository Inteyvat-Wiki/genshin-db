				},
				{
					"id": 721110306,
					"content": "Tóm lại, cháu cũng không có bằng chứng nào chứng minh hai thứ này có liên quan đến nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110307,
					"content": "Có liên quan đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110308,
					"content": "Nực cười, có liên quan gì đến nhau chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110309,
					"content": "Chẳng lẽ trên đồng Mora có ký hiệu nào đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110310,
					"content": "Đúng là trên Mora không có, nhưng ở những nơi khác thì có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110311,
					"content": "Đó là những gì chúng cháu tìm thấy gần mảnh vỡ của chiếc xe hàng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "Cháu tìm thấy nó trên ngọn cây ở lối vào làng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "Sao có thể...cháu thăm dò ông cũng vô ích.",
