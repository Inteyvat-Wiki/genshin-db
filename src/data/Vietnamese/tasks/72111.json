			"dialogs": [
				{
					"id": 721110101,
					"content": "Người trẻ tuổi, có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110102,
					"content": "Tụi cháu đã tìm được chứng cứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "Chứng cứ? Chứng cứ gì cơ, ông không hiểu gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110104,
					"content": "Về chuyện kỳ lạ ở trong làng, ông đừng ngụy biện nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110105,
					"content": "Buồn cười thật. Trong làng làm gì lại có chuyện kỳ lạ gì cơ chứ. Được rồi, có chứng cứ gì thì mau mang ra xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110106,
					"content": "#(Này, {NICKNAME}, hãy bắt đầu với những thứ chúng ta tìm thấy bên giếng. Giao cho bạn đó!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110107,
					"content": "Đây là thứ được nhặt lên từ giếng cạn ở sân sau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
