			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "Đây...đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110702,
					"content": "Ta thật là bất cẩn khi phá hủy chiếc xe hàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110703,
					"content": "Wa, ông ấy thừa nhận rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110704,
					"content": "Không còn cách nào khác, cháu đã điều tra đến mức này rồi, ông cũng không thể che giấu được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110705,
					"content": "Các cháu đã hiểu rõ đầu đuôi câu chuyện rồi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110706,
					"content": "Đã hiểu rõ rồi! Ông Densuke, nhìn ông vậy mà lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110707,
					"content": "Đi cướp xe hàng của Shogunate. Trong lúc ẩu đả, ông đã một đấm đấm vỡ xe hàng, khiến hàng hoá văng ra xa và rơi xuống kênh nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110708,
					"content": "Vì để bảo toàn tính mạng, người của Shogunate đã ném túi tiền xuống giếng để thu hút sự chú ý của ông! Để đề phòng tiền không bị người khác nhặt mất, nên ông đã khóa miệng giếng lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110709,
					"content": "Là như vậy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110710,
					"content": "Hả? Không, không phải như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110711,
					"content": "Nếu đã không phải! Cháu muốn lấy chìa khóa chỗ ông, để đem Mora dưới đáy giếng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110712,
					"content": "...Giao nộp lại cho đại nhân Shogunate! Đúng vậy! Mora nhất định phải được trả lại cho Shogunate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110713,
					"content": "Hầy, chuyện là như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110714,
					"content": "Có một nhóm thanh niên trong làng sau khi say rượu đã táo tợn đến mức cướp xe hàng của Shogunate. Những thứ này đều thuộc về Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110715,
					"content": "Ông nghĩ rằng cái xấu của làng không thể truyền ra ngoài...nên đã cố gắng hết sức để giúp chúng che giấu chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110716,
					"content": "Vậy chuyện ông tự thừa nhận mình muốn nuốt hết số tiền đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110717,
					"content": "Vì để che giấu sự thật này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "Đúng vậy, ông vốn nghĩ rằng, ông làm vậy thì các cháu sẽ không tiếp tục truy cứu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110719,
					"content": "Nếu như chỉ mình ông...chỉ cần không liên luỵ đến người khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110720,
					"content": "Xin các cháu, đừng báo cho Shogunate. Đây không phải là vấn đề danh dự của ông. Ông e rằng toàn bộ ngôi làng cũng sẽ bị liên lụy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110721,
					"content": "Cháu không có ý tố cáo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "Đúng vậy, tụi cháu đến không phải vì chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110723,
					"content": "Vậy thì tốt, vậy thì tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110727,
					"content": "Vì làm những chuyện như vậy khiến lương tâm của ông thực sự bất an, nên đã đem mọi việc ghi chép lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110728,
					"content": "Sổ ghi chép ông đã ném lên mái nhà. Nếu muốn đọc nó, các cháu hãy tự lên tìm đi. Nhưng đừng làm hư mái nhà mà ông mới sửa lại đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110729,
					"content": "Về cái giếng bị khoá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "Đúng vậy, là ông đã khoá miệng giếng lại. Nơi cất giấu chìa khoá, ông cũng đã viết trong đây, cháu hãy tự mình đi xem nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110731,
					"content": "Về \"kết giới\" ở làng Konda, ông Densuke có biết gì không ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110732,
					"content": "\"Kết giới\"? Hả, truyền thuyết lâu đời như vậy, mà bây giờ vẫn còn có người biết sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110733,
					"content": "Nghe nói vào thời xa xưa, dưới chân chúng ta có rễ cây Lôi Anh Đào, là một trong năm rễ cây bảo vệ cho sự an toàn của đảo Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110734,
					"content": "Và việc canh giữ nó và cả kết giới của nó là trách nhiệm mà \"Kitsune Saiguu\" đã giao cho tộc Konda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110735,
					"content": "Nhưng chuyện này đã quá lâu rồi và ông cũng không rõ chi tiết như thế nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110724,
					"content": "Cháu chỉ muốn điều tra sự thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "Đúng vậy, tụi cháu đến không phải vì chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110726,
					"content": "Điều tra sự thật? Haha...người trẻ tuổi bây giờ thật thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
