					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490703,
					"content": "Tôi từng nói đây là \"bài hát ru\" duy nhất mà tôi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490704,
					"content": "#Cho dù vẫn chưa tìm ra ý nghĩa trong đó, nhưng sau khi nghe {F#cô}{M#cậu} đàn, tôi bắt đầu cảm thấy đáp án đang đợi tôi trên mặt trăng. Ít nhất sẽ là điều gì đó tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490705,
					"content": "Nào, đưa tay cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490706,
					"content": "Lần này không cần báo đáp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Không, tôi chỉ muốn thêm ánh trăng tươi đẹp cho giai điệu này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490709,
					"content": "Giờ đây chúng ta xuyên qua mây mù, cùng tìm thấy đáp án trên mặt trăng... Vẻ đẹp của nó cũng như tiếng đàn lúc này vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
