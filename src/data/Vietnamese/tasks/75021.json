			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME} có cảm nhận được nguồn sức mạnh phi thường nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "Không có gì đặc biệt cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "Tảng đá này cũng đâu có thay đổi gì nhỉ. Không phát ra ánh sáng huyền bí, cũng không đột nhiên rung chuyển hay nứt ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "Hmm, không lẽ câu thần chú vừa rồi niệm sai sao? Dù sao cũng trông khá hay ho mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "Nhưng thỉnh thoảng chúng ta cũng gặp phải tình huống này đúng không... Chỉ cần nhớ sai mật khẩu hoặc ám hiệu là cơ quan sẽ không có phản hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Kỳ lạ... Những lời này là người khác nói với em, bảo là chỉ cần làm thế này thì sẽ giải phóng được sức mạnh tiềm ẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "Người kể cho em chuyện này lúc đó niệm xong không bao lâu thì bịt mắt lại và kêu lên đau đớn, nhưng sau đó đã nhận được \"mắt thần\" có thể phân biệt được giá trị của đá quý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "Nghe hay nhỉ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "Hả? Nghe rất khả nghi thì có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "Ôi trời! Tìm thấy rồi, sao em lại chạy đến nơi này thế? Cha của em không tìm thấy nên đang cuống lên ở nhà kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211312,
					"content": "Em đã nói với cha là đến giờ cơm em sẽ tự quay về rồi, đâu cần phải cho Mama Coco biết chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "Còn cãi nữa sao? Hai người bạn nhỏ bên cạnh cũng đừng nấn ná ở đó nữa! Ai mà biết được ở dưới đó lâu sẽ có nguy hiểm gì không chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211314,
					"content": "Đưa Orqo trở lại mặt đất và giải thích rõ tình hình...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "Haiz, mấy thứ đó đều là suy nghĩ của trẻ con thôi, vất vả cho cả hai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211316,
					"content": "Đứa trẻ này từ nhỏ đã không có mẹ ở bên, mắt của cha nó lại không nhìn rõ được, không ai quản nên nó nghịch ngợm lắm. Là hàng xóm, mặc dù tôi rất muốn giúp đỡ nhưng suy cho cùng sức lực cũng có hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211317,
					"content": "Thì ra là vậy. Biết ngay mà! Làm gì có chuyện tốt như vậy chứ... Chỉ thu thập mấy mảnh đá là nhận được sức mạnh thần bí gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "Em không nghịch ngợm, em làm thế này là vì cha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "Đồ ngốc, em chẳng bao giờ nghe lời khuyên của người hiểu biết hơn mình cả. Lần này thì không sao, nhưng nếu một ngày nào đó em gây họa thì chẳng phải là quá muộn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211320,
					"content": "Được rồi, ngoan ngoãn theo chị về nhà đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211321,
					"content": "#Vâng, nhưng trước đó... {F#Hai chị}{M#Anh chị}, chúng ta đã nói trước rồi, chỗ Mora này em sẽ cho {F#hai chị}{M#anh chị} hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Hai vị hãy nhận lấy đi, đừng để thằng bé trở thành người thất hứa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211323,
					"content": "Nếu đã vậy rồi thì... Chúng tôi sẽ không từ chối nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "#Biết đâu sau này còn phải làm phiền {F#hai chị}{M#anh chị} nữa đấy. Lần này thất bại không có nghĩa là lần sau sẽ không thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "Em thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211327,
					"content": "#Mama Coco, chúng ta đi thôi, đừng để cha phải lo lắng. Tạm biệt {F#hai chị}{M#anh chị} tốt bụng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Nghe có chút quen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
