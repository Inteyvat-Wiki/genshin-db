						],
						"pointId": 8299
					}
				]
			},
			"dialogs": [
				{
					"id": 750210701,
					"content": "#Woa! Thật lợi hại, {F#hai chị}{M#anh chị} đã tìm được hết các mảnh sao rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210702,
					"content": "#Thường ngày em giúp đỡ Mama Coco nên cũng tiết kiệm được không ít tiền tiêu vặt. Số Mora này cho {F#hai chị}{M#anh chị} đó, hãy bán mảnh sao cho em nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210703,
					"content": "Mảnh sao? Em biết chúng được dùng làm gì à? Mà tại sao một đứa trẻ như em lại ở nơi thế này một mình vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210704,
					"content": "#Mọi người gọi em là Orqo, {F#hai chị}{M#anh chị} cũng có thể gọi em như vậy. Mặc dù cái tên bây giờ chẳng qua chỉ là một biệt hiệu thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210705,
					"content": "#Em đến đây để thu thập các mảnh sao, {F#hai chị}{M#anh chị} nhìn thấy tảng đá lớn bên dưới rồi đúng không? Đó chính là ngôi sao từ trên trời rơi xuống đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210706,
					"content": "#Chỉ cần trả lại những mảnh thất lạc cho nó là sẽ lấy lại sức mạnh đã mất... {F#Hai chị}{M#Anh chị}, em thật sự rất cần những mảnh sao này đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210707,
					"content": "Nghe thật đáng sợ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "Hmm... Nhưng cũng coi như là manh mối đi, hay là chúng ta cùng thử xem nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210711,
					"content": "Nhưng mà mảnh sao, sức mạnh mất đi gì đó... nghe giống như tình tiết trong tiểu thuyết vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210712,
					"content": "#{F#Hai chị}{M#Anh chị} chưa từng nghe Câu Chuyện Của Qoyllor Và Ukuku sao? Vậy em tặng {F#hai chị}{M#anh chị} cái này. Cha đã kể cho em nghe rất nhiều lần nên em thuộc lòng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210713,
					"content": "Nhưng điều quan trọng bây giờ là chúng ta hãy cùng nhau đi xuống xem sao nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210714,
					"content": "Cùng Orqo đến trước \"ngôi sao rơi\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "#{M#Anh}{F#Chị} mau đặt những mảnh vỡ bị thất lạc trở lại chỗ cũ nhé. Chà... Em sẽ thức tỉnh được sức mạnh gì nhỉ? Có lẽ là sẽ bay được đấy... Hihi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210709,
					"content": "Có chuyện tốt vậy sao? Vậy thì càng không thể đưa em được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "Em ấy chỉ là trẻ con thôi, không cần phải nghiêm túc như vậy. Hơn nữa những lời trẻ con nói thì hơi phóng đại chút đấy. Mà hay là chúng ta cùng thử xem sao nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				}
			]
		},
