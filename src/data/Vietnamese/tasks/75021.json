							-2071.53,
							194.015,
							7587.84
						],
						"pointId": 8759
					}
				]
			},
			"dialogs": [
				{
					"id": 750210501,
					"content": "Chắc là những thứ này nhỉ? Ủy thác lần này đơn giản hơn nhiều so với tưởng tượng đó! Nhưng chúng thật sự kỳ diệu vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "Paimon cũng muốn đánh thức sức mạnh tiềm ẩn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#Tất nhiên rồi! Nếu có khả năng tìm kiếm rương siêu mạnh hoặc siêu sức mạnh để xử lý ma vật thì không phải sẽ rất tiện lợi sao? Không lẽ {NICKNAME} không muốn sở hữu à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "Tôi muốn có thêm sức mạnh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "Đúng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "#{M#Anh}{F#Chị} mau đặt những mảnh vỡ bị thất lạc trở lại chỗ cũ nhé. Chà... Em sẽ thức tỉnh được sức mạnh gì nhỉ? Có lẽ là sẽ bay được đấy... Hihi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "Tôi đã đủ mạnh rồi, không cần nữa đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "Hả? Không phải mọi người hay nói con đường theo đuổi sức mạnh là không có điểm dừng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502107,
