						],
						"pointId": 8296
					}
				]
			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "#Phù, một mình em thì chắc chắn không thể xuống được, cảm ơn {F#hai chị}{M#anh chị}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "Đây là ngôi sao từ trên trời rơi xuống à? Nhìn gần thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "Aaaah! Một luồng sức mạnh bí ẩn đang trào ra khỏi cơ thể!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "Hả?! Thật sao? Không đúng, vẫn còn chưa tìm thấy những mảnh bị mất mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "Mà nơi này thực sự có manh mối về những mảnh vỡ sao? Sao chẳng có chút đầu mối nào vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "Vậy chúng ta phải làm gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "Chỉ còn cách dùng vũ lực thôi. Chúng ta <color=#00E1FFFF>dùng sức mạnh của Tepetlisaur để vỗ vào nó</color>, nói không chừng sẽ biết được những mảnh vỡ đang lạc ở đâu đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "#Hầu hết các vấn đề đều có thể giải quyết bằng vũ lực, đó là những gì cha em đã nói. Nhưng em vẫn chưa đánh thức được sức mạnh của mình, cũng không có Saurian riêng... Vậy xin nhờ {F#hai chị}{M#anh chị} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "Quả là một tảng đá kỳ lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "Đúng là rất đặc biệt... Nhưng sao tôi không cảm nhận được sức mạnh bí ẩn nào cả nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
