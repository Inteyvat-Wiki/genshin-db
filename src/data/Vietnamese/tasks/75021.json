				]
			},
			"dialogs": [
				{
					"id": 750210101,
					"content": "Này, em đang làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "...Ối! Hết cả hồn! Nhỡ em ngã xuống thì phải làm sao đây? Sức mạnh tiềm ẩn của em còn chưa thức tỉnh, bây giờ em chỉ là một đứa trẻ non nớt mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "À, xin lỗi, chị không cố ý làm em sợ. Nhưng mà... Sức mạnh tiềm ẩn là gì vậy? Lợi hại lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "Vì là sức mạnh tiềm ẩn nên làm sao em biết được nó là cái gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "Có lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "#Tạm không nói chuyện này nữa. {F#Hai chị}{M#Anh chị} có thể giúp em tìm lại những mảnh sao không? Thường ngày em giúp đỡ Mama Coco nên tiết kiệm được không ít tiền tiêu vặt, số Mora này em sẽ đưa cho {F#hai chị}{M#anh chị}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Muốn nhờ người khác giúp đỡ thì ít nhất phải giới thiệu tên mình đã chứ. Chị là Paimon, còn đây là {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "#Tên gọi chẳng qua chỉ là biệt hiệu thôi... Người ta gọi em là Orqo, nên {F#hai chị}{M#anh chị} cũng có thể gọi em như vậy. Chuyện các mảnh sao thì {F#hai chị}{M#anh chị} có đồng ý giúp em không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "Rốt cuộc thì mảnh sao là thứ gì vậy? Nghe có vẻ không phải là thứ dễ dàng tìm thấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "Đó là những mảnh vỡ đã thất lạc khi ngôi sao từ trên trời rơi xuống. Chỉ cần tìm thấy chúng và đặt về chỗ cũ là có thể lấy lại sức mạnh từng đánh mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "#Nhìn xem, ngôi sao từ trên trời rơi xuống đang ở dưới đó, nên sẽ có thể tìm thấy mảnh sao. {F#Hai chị}{M#Anh chị} hãy giúp em với.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "Được rồi, vậy chị sẽ giúp em. Nhưng mà mảnh sao, sức mạnh mất đi gì đó... nghe giống như tình tiết trong tiểu thuyết vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "#{F#Hai chị}{M#Anh chị} chưa từng nghe Câu Chuyện Của Qoyllor Và Ukuku sao? Vậy em tặng {F#hai chị}{M#anh chị} cái này. Cha đã kể cho em nghe rất nhiều lần nên em thuộc lòng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "Nhưng điều quan trọng bây giờ là chúng ta hãy cùng nhau đi xuống xem sao nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "Tuổi nhỏ mà lắm lý lẽ ghê.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
