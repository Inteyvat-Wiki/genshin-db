			"dialogs": [
				{
					"id": 402270101,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270102,
					"content": "Xin chào, Aino, Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270103,
					"content": "#Xin chào, {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270104,
					"content": "Chúng tôi nhận ủy thác từ Nefer, chịu trách nhiệm trao đổi với các bên tham gia triển lãm, Xưởng Krumkake Clink-Clank cũng tham gia triển lãm lần này đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270105,
					"content": "Đúng vậy, Aino đang thực hiện lần điều chỉnh cuối cùng cho Đội Bảo Vệ Clink-Clank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270106,
					"content": "Đội Bảo Vệ ... Ồ, đây chính là hàng hóa triển lãm mà xưởng chuẩn bị phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270107,
					"content": "Luôn có động vật như chuột chũi đến xưởng trộm đồ, nên Aino đã mô phỏng hình dáng của chúng để chế tạo một bộ máy phòng vệ nhằm bảo vệ tài sản của xưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270108,
					"content": "Trước đây Aino đã thử nghiệm một lần, kết quả là rất tốt, vì vậy nên đã nâng cấp toàn diện, chuẩn bị mang đi triển lãm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270109,
					"content": "Aino định đem tác phẩm của mình ra giao dịch à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270110,
					"content": "Ngoài những đơn hàng trực tiếp từ xưởng, Aino rất hiếm khi trực tiếp bán các tác phẩm của mình, thứ cô ấy chuẩn bị giao dịch tại triển lãm là bản thiết kế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270111,
					"content": "Ra là thế... À đúng rồi, mọi người sẵn sàng đến chỗ triển lãm chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270112,
					"content": "#Jahoda đã nhờ tôi và {NICKNAME} đến hối thúc đây, cô ấy đã để dành cho hai người một gian hàng rất tốt, để trống mãi sẽ không ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270113,
					"content": "Không phải đã nói với cô ấy rồi sao? Phải điều chỉnh xong hết mới có thể chuyển qua được! Nóng vội cũng vô ích thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270114,
					"content": "Woa, hiếm khi thấy Aino nghiêm túc như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270115,
					"content": "Gần đây xưởng thực sự đang thiếu hụt ngân sách nghiêm trọng, Aino hy vọng có thể cải thiện tình hình thông qua triển lãm lần này, thận trọng như vậy cũng hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270116,
					"content": "Thiếu ngân sách? Chẳng lẽ Aino đang nghiên cứu thứ gì tốn kém lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270117,
					"content": "Không phải là ngân sách nghiên cứu, mà là ngân sách mua đồ ngọt. Trong ghi nhận trước đây, đã có 47 lần tình trạng ngân sách nghiên cứu bị thâm hụt do mua quá nhiều đồ ngọt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270118,
					"content": "Sau đó, xét từ góc độ vận hành xưởng, tôi đã tách riêng ngân sách nghiên cứu và ngân sách đồ ngọt, đồng thời cấm Aino tùy ý sử dụng sai mục đích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270119,
					"content": "Và mới đây thôi, Aino đã dùng hết sạch toàn bộ ngân sách bánh ngọt của cả tháng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270120,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "Xong rồi! Đội Bảo Vệ Clink-Clank, thể hiện thật tốt nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270123,
					"content": "Hãy dẫn chúng tôi đến hội trường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270121,
					"content": "Cũng không bất ngờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
