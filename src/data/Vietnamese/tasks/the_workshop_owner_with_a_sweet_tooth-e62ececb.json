			"dialogs": [
				{
					"id": 402270201,
					"content": "Aino và Ineffa đã đến hội trường triển lãm dưới sự dẫn dắt của các bạn.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "Ừm... đặt bục giới thiệu ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270203,
					"content": "Cơ quan phòng vệ mới do Aino thiết kế... Nói thật, tôi khá tò mò đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270204,
					"content": "#{NICKNAME} và Paimon có thể ghé chơi bất cứ lúc nào, tác phẩm của tôi chắc chắn sẽ không làm mọi người thất vọng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270205,
					"content": "Vất vả cho các vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270206,
					"content": "Không có gì đâu! À đúng rồi, người tham gia của bên phía xưởng thì đăng ký tên Aino và Ineffa phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270207,
					"content": "Ừm... Aino không thể xem là thành viên tham gia triển lãm đâu, cô ấy không thích không khí quá náo nhiệt, khi triển lãm chính thức bắt đầu cô ấy sẽ quay về xưởng, tôi sẽ ở đây giúp cô ấy trông gian hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270208,
					"content": "Nghĩ lại thì cũng đúng nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
