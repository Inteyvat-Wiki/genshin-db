			},
			"dialogs": [
				{
					"id": 710540501,
					"content": "Tiêu diệt <color=#00E1FFFF>doanh trại binh khí</color> trước sẽ thuận tiện hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540502
					]
				},
				{
					"id": 710540502,
					"content": "Được thôi, chúng sẽ nhanh chóng phát hiện mình không còn vũ khí để dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105406,
