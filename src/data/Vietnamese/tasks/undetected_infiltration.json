					"Yanbo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540601,
					"content": "Đã chuẩn bị xong chưa? Chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105407,
			"completionStepIds": [
				7105413
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105413",
							"2"
						],
						"stepId": 7105413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "Thật tuyệt vời! Cảm ơn bạn đã giúp đỡ, đúng rồi, đây là phần thưởng như đã nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540702,
					"content": "Wa! Nhiều Mora quá! Í... Anh thay quần áo từ khi nào thế...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540723,
					"content": "Lúc các bạn ra tay ấy... Khụ, ý tôi nói là, cái đó không quan trọng... Để đề phòng các bạn đánh hăng quá, lại vô tình làm chúng tôi bị thương hết lại mệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540703,
					"content": "Thiên Nham Quân sẽ luôn cảm tạ sự giúp đỡ của các bạn. À, như thỏa thuận giữa chúng ta, các bạn hãy xem xung quanh có thứ gì mình cần không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540704,
					"content": "À... Ý tôi là ngoại trừ những tang vật mà chúng tôi đã niêm phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540705,
					"content": "Chúc mừng anh nhé, nhiệm vụ đã hoàn thành rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "Haha, đương nhiên, cũng nhờ có các bạn giúp đỡ mà chúng tôi mới thuận lợi như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540709,
					"content": "Ừm, ý của tôi là... Chỉ cần đừng giống như đám đạo tặc này, việc gì cũng muốn đi đường tắt, thì chúng tôi sẽ không gây phiền phức gì cho bạn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540710,
					"content": "Hứ, chúng tôi tuyệt đối không phải những kẻ như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540711,
					"content": "Haha, nói cũng đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540712,
					"content": "À, mà nói chứ, người biết sử dụng nguyên tố như bạn, bất luận là thiện hay ác, thì đều không thể xem thường được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540713,
					"content": "Nhiệm vụ mà chúng tôi mất mấy tuần hoặc mấy tháng mới hoàn thành, đối với bạn chỉ là việc nhẹ nhàng mà thôi... Nếu như dùng sức mạnh nguyên tố để đi làm việc ác thì hậu quả sẽ rất khôn lường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540714,
					"content": "Cho nên, tôi cũng không hề cảm thấy không có Vision là một chuyện xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540715,
					"content": "Tôi đã từng thấy có những người vì muốn có được sức mạnh phi thường mà đã không tiếc hy sinh sinh mạng của bản thân, cuối cùng chỉ có thể làm công cụ, con rối cho người khác, bạn nói xem, như vậy có đáng không chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "Trên đời này số người không có Vision vẫn chiếm đa số, mà những người có thể hiểu cho họ, bảo vệ họ cũng đa số là người bình thường giống như họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540718,
					"content": "Thân là một người bình thường, có thể thực hiện chức trách bảo vệ mọi người, không thể không nói rằng đây là vinh dự của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540719,
					"content": "Nếu như một ngày nào đó, không còn ai nhận được Vision nữa, thậm chí các tiên nhân bảo vệ cảng Liyue cũng đã mất đi... Tôi nghĩ tôi cũng sẽ không vứt bỏ chức trách này của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540720,
					"content": "A, xin lỗi... tôi nói lan man quá, làm mất thời gian của bạn quá rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540721,
					"content": "Được rồi, chúng tôi còn phải kiểm tra và đăng ký tang vật, không trò chuyện với bạn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540722,
					"content": "Tôi xin đại diện các đồng liêu, một lần nữa cảm ơn sự giúp đỡ của bạn, hy vọng bạn luôn thuận lợi trên hành trình phía trước. Thiên Nham vững chắc, núi vững khó dời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540707,
					"content": "Lần sau chúng tôi sẽ không bị vướng vào vòng lao lý nữa rồi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540708
					]
				},
				{
					"id": 710540708,
					"content": "Đương nhiên, các bạn đã trợ giúp Thiên Nham Quân... Ừm, với sự trợ giúp của Thiên Nham Quân, các bạn đã là anh hùng có công đầu trong việc phá giải vụ án buôn lậu, chúng tôi làm sao dám bắt bạn vào nhà giam chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				}
			]
		},
