			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "Dừng tay, dừng tay! Xin hãy nghe chúng tôi giải thích!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540102,
					"content": "Các người không phải Đạo Bảo Đoàn sao? Ngoan ngoãn tự thú là được rồi, có gì để giải thích đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540103,
					"content": "#Thiên Nham Quân, khu Vực Đá Sâu, trung đội trưởng Yanbo. Rất vui được gặp các bạn, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540104,
					"content": "Chẹp... và... hiệp sĩ biết bay rất nổi tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540105,
					"content": "Này, sao tới lượt tôi thì quên tên vậy! Tôi là Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540106,
					"content": "Haha... Thất lễ, thất lễ. Quả thật ngại quá... nhưng chúng ta chắc có chút hiểu lầm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540107,
					"content": "Chờ đã... các anh không phải Đạo Bảo Đoàn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "Tất nhiên không phải rồi, mà hoàn toàn ngược lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540112,
					"content": "Haha, nói thế này đi. Công xưởng này trước đây quả thật là căn cứ của Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540113,
					"content": "Sau khi công nhân sơ tán, những kẻ hám lợi đã lẻn vào... Ban đầu chỉ là trộm cắp khoáng thạch và Tinh Thể Lưu Ly để buôn lậu, chơi trò trốn tìm với đội tuần tra của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540114,
					"content": "Sau đó lá gan của chúng càng lúc càng lớn, dám chiếm cứ nhà kho cũ của thợ mỏ để lại, tự mình chế tạo ra các trang sức giá rẻ đem bán! Haiz, thật là... khiến người ta phải đau lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540115,
					"content": "Khiến người ta đau lòng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "Những trang sức thô kệch như thế chỉ có thể lừa gạt du khách lần đầu đến Liyue, hoặc những kẻ đọc sách mà thiếu hiểu biết thôi... Muốn dùng giá rẻ để đánh vào thị trường Liyue sao? Hừm, e rằng phải tự đập bảng hiệu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540117,
					"content": "Chúng vốn dĩ cũng đâu có bảng hiệu đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540118,
					"content": "Haha, bạn nói đúng. Kiếm lời từ mấy thứ này, đúng là thấp kém quá mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540119,
					"content": "Cho nên chúng tôi đã đến đây, giả dạng làm bọn chúng để mai phục... Ừm, đây đã là chuyện của một thời gian trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540120,
					"content": "Hiện tại chúng tôi đã biết được thủ lĩnh của chúng có liên lạc với một chi đội của Fatui, nghi ngờ có giao dịch vật tư nguy hiểm gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540121,
					"content": "Về liên lạc giữa Fatui và Đạo Bảo Đoàn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "Cho dù trước đây chúng tôi đã phá hủy mưu đồ của Fatui, nhưng chúng vẫn còn một số dư đảng ở ngoại ô Liyue... Những tên này vừa chuyên nghiệp lại có năng lực chiến đấu, rất nguy hiểm đối với chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540123,
					"content": "Giả sử Đạo Bảo Đoàn cấu kết với chúng để đối phó chúng tôi... thì sẽ là một vấn đề an ninh cực kỳ đau đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540126,
					"content": "Tóm lại, chúng tôi đã chuẩn bị sẵn sàng, chỉ chờ tổng tấn công. Chỉ cần hốt gọn chúng, thì sẽ biết được chúng đang âm mưu gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540127,
					"content": "Kết quả là không ngờ chúng tôi đã đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540128,
					"content": "Haiz... Chúng tôi biết bạn rất lợi hại, nhưng không ngờ lại có thể giỏi đánh đấm đến thế... Bây giờ thì hay rồi, quá nửa đội quân của tôi đều bị các bạn hạ gục hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540129,
					"content": "Đương nhiên, chúng tôi trú đóng ở đây cũng còn một nguyên nhân khác là... nơi này còn có \"Thạch Ấn\" của \"Thất Tinh Trận Pháp\". Chúng tôi không thể để nó rơi vào tay của đám Đạo Bảo Đoàn mưu mô đó được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540130,
					"content": "Ôi... xin lỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "Hahaha, không sao! Chúng tôi không nhận ra các bạn là lỗi của chúng tôi... Trước đó đã có lệnh là chúng tôi phải nhường đường cho các bạn, kết quả là không ngờ các bạn lại đến nhanh như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540134,
					"content": "Wa... Thiên Nham Quân thật là biết cách nói chuyện đó! Vậy chúng tôi đã có thể đi rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540135,
					"content": "Tôi không trách các bạn, không có nghĩa là luật pháp Liyue sẽ bỏ qua cho các bạn. Hehe, thật xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540136,
					"content": "Hở...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540137,
					"content": "Lần sau nhớ nói hết câu nha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "Ừm... Để tôi xem nào: Gây rối sinh sự, cản trở Thiên Nham Quân thi hành công vụ, cố ý phá hoại Thất Tinh Trận Pháp, còn cả... phá hoại hiện trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540140,
					"content": "Trừ đi sự thông cảm của đương sự Thiên Nham Quân... Nếu như mọi thứ thuận lợi thì, chúc mừng hai vị, có thể đến cảng Liyue sống từ 5 đến 10 năm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540141,
					"content": "Gì chứ??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540142,
					"content": "Tôi được mời luật sư không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "Ừm... Xin hãy cho chúng tôi danh sách luật sư!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540146,
					"content": "Haha... nhưng mà...! Xin hãy nghe tôi nói hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540147,
					"content": "Công dân hợp pháp hay du khách nước ngoài nếu giúp đỡ Thiên Nham Quân phá án, sẽ được nhận phần thưởng hoặc đền bù tương ứng... Đây cũng là quy định trong luật pháp của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540148,
					"content": "Cho nên hai vị anh hùng, trận đánh lúc nãy không phải uổng công đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540149,
					"content": "Nếu giúp các anh thì chúng tôi nhận được gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "Các tang vật đã bị niêm phong thì không được tùy ý đụng vào đâu, nhưng nếu hai vị đây tình nguyện giúp đỡ, thì trong quá trình truy bắt nếu có vô tình gặp được tài sản gì đó... ừm, chẳng hạn như \"kho báu bí mật của Đạo Bảo Đoàn!\", thì hai vị cứ tự xử lý là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540151,
					"content": "Ngoài ra, tôi và các đồng nghiệp cũng góp được một ít Mora, hy vọng hai vị không chê... Haiz, dù sao thì sự \"giúp đỡ\" này cũng không có trong dự tính mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540152,
					"content": "Ồ... Vậy có nghĩa là, chúng tôi không cần ngồi tù, mà còn được nhận thêm báu vật! Đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540153,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540154,
					"content": "Được! Vậy chúng tôi sẽ miễn cưỡng chấp nhận! Hãy dẫn đường đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540155,
					"content": "Chờ đã...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "Được rồi, hai vị anh hùng đừng khách sáo nữa... Tôi sẽ đến điểm tập kết trước để chờ lệnh, hy vọng các bạn có thể đến sớm, nếu không chúng tôi sẽ hành động trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540158,
					"content": "Đúng đó, chúng ta mau đi theo đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540159,
					"content": "Ê...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "Nhanh lên, chúng ta đang giúp Thiên Nham Quân phá án mà! Hơn nữa không phải còn có rất nhiều Mora hay sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540156,
					"content": "Tôi chưa mà...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "Biết vậy ra tay mạnh hơn xíu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "Hừ, chúng tôi chỉ là đánh vài cái thôi mà! Ai bảo mấy người mặc đồ của Đạo Bảo Đoàn cơ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540138,
					"content": "Rõ ràng là cố ý mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "Nói như vậy, chúng tôi thật sự đã đánh nhầm người rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "Ừm, nhưng không thể trách các bạn. Là do chúng tôi có lỗi trước mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540124,
					"content": "Về vật tư nguy hiểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "Người cung cấp tình báo của tôi nói rằng, đám Fatui đó dùng lượng lớn Mora và vật tư quân dụng để mua thứ gì đó từ Đạo Bảo Đoàn... Nhưng anh ta chỉ phát hiện ra thực phẩm và đồ dùng sinh hoạt, có lẽ là chiêu trò che mắt thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540109,
					"content": "Các anh là... Thiên Nham Quân?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "Haha, xin lỗi vì không giải thích trước... chúng tôi còn tưởng rằng bạn đến để phá hoại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540111,
					"content": "Ừm... ở một mặt nào đó thì đúng là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
