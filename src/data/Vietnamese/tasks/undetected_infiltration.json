				"points": []
			},
			"dialogs": [
				{
					"id": 710540401,
					"content": "Tiêu diệt <color=#00E1FFFF>doanh trại luyện kim</color> trước có thể khiến chúng suy yếu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540402
					]
				},
				{
					"id": 710540402,
					"content": "Tốt lắm, chúng tôi sẽ đi niêm phong tất cả thiết bị luyện kim của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
