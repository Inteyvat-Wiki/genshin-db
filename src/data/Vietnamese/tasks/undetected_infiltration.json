					"Yanbo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540201,
					"content": "Bạn đến rồi à, tôi biết bạn sẽ giúp đỡ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540202
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540202,
					"content": "Bọn buôn lậu của Đạo Bảo Đoàn chắc sẽ ở đại bản doanh phía đông để tiến hành giao dịch với Fatui, hơn nữa trên đường đến đại bản doanh, chúng còn bố trí ba doanh trại nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540203
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540203,
					"content": "Dựa theo tin tình báo, chúng chia thành <color=#00E1FFFF>doanh trại nấu ăn</color> phía đông nam, <color=#00E1FFFF>doanh trại binh khí</color> xa hơn về phía đông, và <color=#00E1FFFF>doanh trại luyện kim</color> phía đông bắc. Nếu như chúng ta tập kích ba doanh trại này trước, là có thể chặt đứt nguồn tiếp tế của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540204
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540204,
					"content": "Vì dạo trước xảy ra chuyện ở Quần Ngọc Các, nên không đủ nhân lực Thiên Nham Quân tuần tra ở đây, để cho bọn này tác oai tác quái một thời gian rồi, bây giờ chúng cũng lơ là phòng bị, rất thích hợp để đột kích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540205
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540205,
					"content": "Chỉ có điều... Vì hiểu lầm lúc trước mà bây giờ nhân lực của tôi chỉ đủ để tấn công một doanh trại, nhưng nếu bạn cần thì chúng tôi có thể thêm chi viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
