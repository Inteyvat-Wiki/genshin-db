			"dialogs": [
				{
					"id": 710540301,
					"content": "Tôi đề nghị xử lý <color=#00E1FFFF>doanh trại nấu ăn</color> trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540302
					]
				},
				{
					"id": 710540302,
					"content": "Đã rõ, chúng tôi sẽ gấp rút vận chuyển lương thực của chúng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
