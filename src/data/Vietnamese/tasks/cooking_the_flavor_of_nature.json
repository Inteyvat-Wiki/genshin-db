			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "Ôi ôi? Ôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200102,
					"content": "A. Là Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200103,
					"content": "E hèm. Thật xấu hổ khi để Nara nhìn thấy tôi nhếch nhác thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200104,
					"content": "Nara tốt bụng, tôi là Arachatora. Hai người là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200105,
					"content": "#Tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "Tôi là Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200107,
					"content": "#Nara {NICKNAME} và Paimon, tôi hiểu rồi. Cảm ơn các bạn rất nhiều. Nếu không có duyên gặp hai bạn ở đây, e rằng phải mất thêm một chút thời gian nữa mới hồi phục được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200108,
					"content": "Một chút thời gian là bao lâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200109,
					"content": "Xấu hổ quá, trước kia cũng từng gặp phải tình huống tương tự vì nấm xấu. Sau đó, Sen Nilotpala trong nước nở rộ rồi khép lại, lặp lại hai lần thì tôi mới hồi phục lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200110,
					"content": "Nở rộ rồi khép lại... Vậy chẳng phải sẽ mất hai ngày sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200111,
					"content": "A, hai ngày. Thì ra là thế, hóa ra đây là ý nghĩa của \"ngày\". Nara các bạn thật thú vị. Hai ngày dài hay ngắn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200112,
					"content": "#Ừm... {NICKNAME}, bạn nghĩ sao? Hai ngày dài hay ngắn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200113,
					"content": "Chắc là dài.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "Ừm. Vậy là Arachatora sẽ phải \"Ôi huhuhu\" suốt hai ngày rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200115,
					"content": "Thế sao? Hóa ra như vậy được tính là thời gian dài sao, thật không thể tin được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200126,
					"content": "Nhưng mà nếu bạn là Arachatora... vậy chắc là người thân của Arapacati nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200127,
					"content": "Không phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200128,
					"content": "Ơ? Nhưng bạn là... anh của Arapacati đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200129,
					"content": "Ơ, sao các bạn biết? Arapacati là \"em gái\" của tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200130,
					"content": "Chuyện gì đang diễn ra vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200131,
					"content": "Có lẽ khái niệm của Aranara khác với chúng ta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "Tóm lại chuyện là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200133,
					"content": "Nói với Arachatora về chuyện đã xảy ra.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "Lễ Hội Utsava lại sắp tổ chức rồi sao... Phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200135,
					"content": "Tôi vẫn chưa chuẩn bị xong những \"nguyên liệu\" quan trọng để chứng minh với Arasaka, Arapas và Araphala trong Lễ Hội Utsava rằng món ăn từ nấm mới là món ngon nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200136,
					"content": "Nói vậy thì, Arasa... pas... Ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200137,
					"content": "Arasaka, Arapas, Araphala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "Chậc! Tên của Aranara khó nhớ quá! Arachatora, anh em của bạn đã đi đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200139,
					"content": "Chúng tôi đang có hướng đi riêng trên con đường tu hành của mình, giống như sông biến thành dòng suối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200140,
					"content": "Tức là tách ra rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200141,
					"content": "Chúng tôi \"Luyện Nấu Ăn\" để làm ra \"Món Ăn Quý Nhất\". Thế nhưng họ lại không thừa nhận món ăn từ nấm. Rõ ràng \"Nấm Một Đầu\" ngon tuyệt trần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200142,
					"content": "Tóm lại, chúng tôi quyết định tự hoàn thành món ăn của mình rồi mới so sánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200143,
					"content": "Hóa ra là thế. Nếu vì theo đuổi món ngon thì hoàn toàn có thể hiểu được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200144,
					"content": "Vậy, \"Nấm Một Đầu\" của bạn đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200145,
					"content": "Gần đây sự phát triển của \"Marana\" lan rộng quá mức, nơi \"Nấm Một Đầu\" sinh trưởng cũng đã bị chiếm mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200146,
					"content": "À, cũng tức là Tử Vực... Hy vọng Rana không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200147,
					"content": "E rằng nấm quý cũng bị nanh vuốt của sự khô héo quét sạch rồi. Chắc hai bạn cũng biết vùng đất \"Marana\" rất nguy hiểm, cực kỳ nguy hiểm đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200148,
					"content": "Không có \"Nấm Một Đầu\", vì vậy tôi đã thử những loại nấm lạ mà Aranara chưa từng ăn qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200149,
					"content": "Kết quả ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200150,
					"content": "Kết quả thì như những gì chúng ta nhìn thấy đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "Ngại thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200153,
					"content": "Nếu nói như thế, Tử Vực... cũng tức là \"Marana\", lúc trước chúng ta cũng từng xử lý nó qua đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200154,
					"content": "Dễ như trở bàn tay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "Ồ, không thể tin được. Các bạn thật sự có sức mạnh chống lại \"Marana\" sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200157,
					"content": "#Nhưng nói thế cũng đúng thôi. Nếu Nara {NICKNAME} có thể sử dụng sức mạnh của Thảo Thần để chữa bệnh cho tôi, vậy việc xóa bỏ ảnh hưởng của \"Marana\" cũng không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200158,
					"content": "#Vậy tôi muốn nhờ Nara {NICKNAME} đi cùng tôi đến nơi sinh trưởng của \"Nấm Một Đầu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200159,
					"content": "#Đây là cơ hội để thưởng thức một món ăn ngon từ nấm đấy! {NICKNAME}, chúng ta giúp đỡ đi, để anh em họ mau đoàn tụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200160,
					"content": "Được. Dù sao thì tôi cũng đã hứa với Arapacati rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "Được rồi, nó đang ở trong hang động phía trước. Cùng tôi đi xem thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200161,
					"content": "Paimon chỉ muốn ăn thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "Một công đôi việc mà, có gì sai đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200155,
					"content": "Miễn cưỡng cũng đánh được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "\"Ôi huhuhu!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "Chắc là ngắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "À... Đúng vậy, nghĩ lại thì chúng ta quen biết đã lâu như thế. Nhưng cảm giác như mới hôm qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200118,
					"content": "Thế sao? Vậy tôi yên tâm rồi. Hóa ra hai ngày mất kiểm soát trong rừng cũng không hẳn quá dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200119,
					"content": "Ý của tôi không phải vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200120,
					"content": "Phải xem khoảng thời gian đó dùng để làm gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "Ừm, cũng đúng. Nếu như phải \"Ôi huhuhu\" suốt hai ngày thì là một khoảng thời gian rất dài. Còn nếu như là quá trình lợn rừng lớn lên thì đó sẽ là một khoảng thời gian rất ngắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200122,
					"content": "Thế sao? Hóa ra như vậy được tính là thời gian dài sao, thật không thể tin được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200123,
					"content": "Thời gian là một khái niệm chủ quan, không có ý nghĩa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#Ừm. Nara {NICKNAME}, bạn biết rất rõ về đạo lý trong rừng. Đối với rừng sâu, sự sống sinh ra, lớn lên và trở về đất mẹ không cần đến \"ngày\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200125,
					"content": "Sao nghe khó hiểu quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302005",
							"2"
						],
						"stepId": 7302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "Ôi, \"Nấm Một Đầu\" thân yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200202,
					"content": "\"Nấm Một Đầu\" ơi, nếu như bạn mất đi hương thơm của mình thì bạn vẫn là \"Nấm Một Đầu\" chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200203,
					"content": "Hì hì, nấm đúng là thơm thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200204,
					"content": "Thôi bây giờ chúng ta ra ngoài đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "May mắn làm sao khi gặp được các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200302,
					"content": "Đây là mùi thơm của \"Nấm Một Đầu\" đã chín muồi, hương thơm nồng nàn hơn lần trước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200303,
					"content": "Xem ra cho dù sinh trưởng ở nơi bị \"Marana\" chiếm cứ, nhưng bạn vẫn phát triển rất tốt, thật không ngờ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200304,
					"content": "Ừm, có thể cho chúng tôi nếm thử... \"Nấm Một Đầu\" đó được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200305,
					"content": "Cứ tự nhiên. Không bàn tới việc hai bạn có ơn với tôi, có thể phục vụ những món nấm ngon nhất cho Nara thêm lần nữa là mục tiêu \"Luyện Nấu Ăn\" của tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200306,
					"content": "Được đó! Nấm Một Đầu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200307,
					"content": "Arachatora lập tức bắt tay nấu nướng...\\nMùi thơm của nấm tươi từ trong nồi tỏa ra.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "Sau đó, Arachatora đưa thành phẩm cho bạn và Paimon.\\n... Nên nói thật thất vọng hay không được như mong đợi nhỉ, tóm lại là rất nhạt nhẽo.\\nNgoài ra, nấm còn có sức sống bền bỉ nên kết cấu quá dai và khó nuốt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "...Xong rồi. \"Luyện Nấu Ăn\" của tôi đã đến giai đoạn hoàn thiện. Sao nào? Đối với Nara thì đây chắc hẳn là hương vị tuyệt nhất nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200310,
					"content": "Nhoằm nhoằm... Ực ực... Ừm... nói sao nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200311,
					"content": "(Nhai kỹ)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "(Ráng nuốt)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "Có thể ăn được nếu như đủ sức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "Ừm... Quả thực là một loại nấm rất thơm, nhưng mùi vị không phù hợp với chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200317,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200318,
					"content": "#Sao lại thế được, lúc trước khi tôi nấu món này cho Nara, {F#anh ấy}{M#cô ấy} đã khen ngon mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200319,
					"content": "Lúc trước?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200320,
					"content": "#Lúc trước tôi cũng nấu món nấm cho Nara ăn. Hơn nữa vì nó rất ngon, lúc {F#anh ấy}{M#cô ấy} nuốt xuống còn rất gắng sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200321,
					"content": "Chắc là không có vấn đề gì mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200323,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "Ôi. Giống như Aranara khác nhau sẽ mọc ra các phiến lá khác nhau. Có lẽ vị nấm cũng chưa chắc hợp khẩu vị của tất cả Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200325,
					"content": "Đúng thế, nhưng nói về lá... chẳng lẽ Aranara các bạn không sợ lửa sao? Rõ ràng bản thân nhìn cũng có nhiều phần giống với lá mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200326,
					"content": "Tất nhiên lửa rất đáng sợ, đôi khi ngọn lửa bùng lên trong rừng sâu sẽ có thể biến cả một ngọn núi thành bãi đất hoang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200327,
					"content": "Tuy nhiên, xét cho cùng cũng là vì \"Luyện Nấu Ăn\", tôi đã kìm nén nỗi sợ lửa, kiểm soát độ lửa cũng là một khâu trong luyện tập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200328,
					"content": "Hóa ra là thế... Cũng đến lúc phải về rồi, Arapacati đang chờ các bạn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200329,
					"content": "Ừm. Tôi sẽ về Vanarana ngay. Nếu không, khiến \"em gái\" quan trọng lo lắng thì không hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200330,
					"content": "Về mấy tên đó... Arasaka, Arapas, Araphala lần lượt ở <color=#00E1FFFF>gần Làng Gandharva</color>, <color=#00E1FFFF>Rừng Apam</color> và <color=#00E1FFFF>Núi Devantaka</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200331,
					"content": "#Cám ơn các bạn. Nara {NICKNAME} vàng chói như ánh mặt trời. Paimon cũng khá tuyệt. Ủy thác của em gái tôi phải nhờ các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200332,
					"content": "Tại sao nói tới tôi thì biến thành cũng \"khá\" tuyệt thôi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200333,
					"content": "Ôi, đừng bận tâm... Dù sao các bạn cũng đã giúp tôi rất nhiều, tôi không biết phải trả ơn như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200334,
					"content": "Ừm, tôi quyết định dạy cách làm \"Món Ăn Quý Nhất\" cho hai bạn. Có lẽ sau này khi lớn lên, các bạn sẽ hiểu được mùi vị trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200335,
					"content": "#({NICKNAME}, để tôi sửa lại công thức này đã... hẳn có cách biến nó thành một món ngon nguyên bản đẹp mắt!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200314,
					"content": "Ít ra không có độc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "Tôi thấy giờ còn quá sớm để tôi nếm hương vị này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
		{
			"id": 7302004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"3"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "Hái được \"Nấm Một Đầu\", hoàn thành Luyện Nấu Ăn, quen biết một Nara cao lớn đáng tin cậy. Thật vui quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200402,
					"content": "#Arapacati, Arasaka, Arapas, và Araphala nhất định sẽ biết ơn bạn. Nara {NICKNAME}, bạn là một Nara tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200403,
					"content": "Biết ơn tôi? Tại sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
