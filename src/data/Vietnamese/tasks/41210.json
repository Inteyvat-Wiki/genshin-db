			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "Đào Bảo Đoàn dám gọi chúng ta là trộm, rõ ràng chúng mới là kẻ trộm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100502,
					"content": "Bọn người này đến nhanh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100503,
					"content": "Albedo, bạn là trộm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "Sao lại thế được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100506,
					"content": "Thứ mà chúng nói, hình như chính là thanh kiếm này, rốt cuộc là như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100507,
					"content": "Thái độ của bạn là sao? Đương nhiên là tôi không có trộm thanh kiếm này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100508,
					"content": "Trước đó không lâu, đội kỵ sĩ đã bắt được một nhóm Đạo Bảo Đoàn ở ngoài thành Mondstadt, số tang vật phi pháp mà chúng vận chuyển cũng bị tịch thu toàn bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100509,
					"content": "Thanh kiếm này là một trong số đó. Dù nói là tang vật, nhưng không ai đến nhận cả, cũng chẳng biết nó từ đâu ra, nên luôn được cất giấu trong kho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100510,
					"content": "Khi tôi đến kho lấy đồ thì vô tình chú ý đến nó. Nói thật nhé, thanh kiếm cũ nát như thế, ngoài việc dùng làm nguyên liệu giả kim, thì e là chẳng còn tác dụng gì khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100511,
					"content": "Í, sao nói một lát thì tang vật lại biến thành đồ của mình rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100512,
					"content": "Sau đó thì sao? Bạn lấy nó luôn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100513,
					"content": "Ừ, tôi muốn lấy nó để làm thí nghiệm, nhưng không ngờ, trong quá trình điều tra thì phát hiện được lai lịch thật sự của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100514,
					"content": "Thanh vũ khí trông có vẻ cũ nát này là của một thợ rèn đã qua đời, là ma kiếm trong truyền thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100515,
					"content": "Ma kiếm?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100516,
					"content": "Nghe nói sau khi rèn xong kiếm chẳng được bao lâu, thì người thợ mất tích, thanh kiếm cũng mất tăm không dấu vết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100517,
					"content": "Nếu dựa vào tang vật để truy lại ngọn nguồn, có lẽ nó bị Đạo Bảo Đoàn trộm mất, rồi thất truyền đến ngày nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100518,
					"content": "Hả! Người rèn kiếm mất tích sao?! Đáng sợ quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100519,
					"content": "Chả trách đây là ma kiếm bị nguyền rủa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100520,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100521,
					"content": "Không ngờ loài người có thể chế tạo ra ma kiếm như thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "Bạn có biết chuyện về <color=#00E1FFFF>Durin</color> và ngọn núi tuyết này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>Durin</color> là rồng đen đã uy hiếp Mondstadt và bị <color=#00E1FFFF>Phong Thần Barbatos</color> cùng <color=#00E1FFFF>Dvalin</color> liên thủ đánh bại vào mấy trăm năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100524,
					"content": "Kết thúc trận chiến khốc liệt, Durin bại trận rơi từ không trung xuống, ngã xuống tuyết trắng mênh mông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100525,
					"content": "Tuyết trên núi tuyết quanh năm không tan chảy, là một chuyện kỳ diệu vô cùng. Rốt cuộc Durin rơi xuống nơi này là sự ngẫu nhiên hay việc tất yếu đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100526,
					"content": "Còn có thể là việc tất yếu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100527,
					"content": "Chọn núi tuyết làm mộ phần không chừng là muốn dùng sức mạnh đóng băng tất cả này để khống chế chất độc mục rữa trên người Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100528,
					"content": "Thần Barbatos chắc phải nghĩ đến cách này mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100529,
					"content": "Wow... Barbatos lợi hại vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100530,
					"content": "Đây chỉ là suy đoán của tôi, không có chứng cứ. Nhưng có thể khẳng định ngọn núi tuyết này và Durin có dây mơ rễ má mật thiết với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100531,
					"content": "Còn nguyên liệu của thanh kiếm trong tay bạn có lẽ là xương cốt của Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100532,
					"content": "Xương cốt của rồng?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100533,
					"content": "Ừ, dùng mắt, móng, vảy rồng đã chết mài thành bột rồi bôi lên thân kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100534,
					"content": "Bằng cách này, sự ô uế và chất độc của Durin sẽ dung hòa vào kiếm, trở thành nguồn sức mạnh của kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100535,
					"content": "Đây là công nghệ vô cùng cao siêu, sau khi người thợ rèn rèn kiếm thành công, chắc chắn sẽ đích thân thử kiếm vì quá vui mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100536,
					"content": "Chỉ cần anh ta dùng thanh kiếm này chiến đấu, sức mạnh ô uế trên thanh kiếm sẽ đi theo chuôi kiếm, truyền vào cơ thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100537,
					"content": "Người bình thường không thể chống đỡ được loại sức mạnh này, người thợ rèn bị nguyền rủa đến nỗi tinh thần bấn loạn, điên cuồng tháo chạy khắp nơi, nói không chừng đã gặp bất trắc gì không hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100538,
					"content": "A...oa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100539,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "Bạn đã thanh tẩy nước mắt của Dvalin, có sức mạnh vô cùng hiếm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100541,
					"content": "Sức mạnh này bảo đảm bạn sẽ không bị sự ô uế và độc tính xâm nhập, mà còn triệt tiêu hoàn toàn sự nguy hiểm của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100542,
					"content": "Cho nên chỉ có bạn mới sử dụng được thanh kiếm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100543,
					"content": "Tuy nói vậy nhưng thanh kiếm này quả nhiên là quá...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100544,
					"content": "Hình như nó, nó đang phát sáng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100545,
					"content": "Đây chính là tín hiệu cuộc thử nghiệm bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100546,
					"content": "Thanh kiếm này bây giờ vẫn còn rất yếu, nhưng nó có thể hấp thu sức mạnh và không ngừng tăng cường cho bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100547,
					"content": "Ở một ý nghĩa nào đó, cũng có thể xem nó là \"đứa trẻ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100548,
					"content": "Nhà Lữ Hành, hãy mang theo nó đi mạo hiểm, tôi muốn bạn giúp nó không ngừng trưởng thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100549
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100549,
					"content": "Tôi tin rằng một ngày không xa, tất cả suy luận sẽ được kiểm chứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100504,
					"content": "Chắc không phải là bạn trộm đồ của chúng đâu ha?",
