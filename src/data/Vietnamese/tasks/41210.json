			"dialogs": [
				{
					"id": 412100301,
					"content": "Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100302,
					"content": "Hi, lại là chúng tôi đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "Ơ? Sao các bạn quay lại rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100304,
					"content": "Lạc đường sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100305,
					"content": "Không phải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100306,
					"content": "Tôi đã nhận lời nhờ vả của Sucrose đến đây điều tra bí mật của bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "Hả? Bí mật?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100309,
					"content": "A a a, bạn đang làm gì vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100310,
					"content": "Những lúc thế này không phải nên âm thầm điều tra sao? Sao lại nói hết ra vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100311,
					"content": "Dù sao cũng chẳng giấu nổi Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "Huhu... dù cho bạn nói thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100313,
					"content": "Đến đúng lúc đó, tôi cũng đang có việc muốn tìm bạn, Nhà Lữ Hành ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100314,
					"content": "Cầm lấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100315,
					"content": "Í, cái gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100316,
					"content": "Như bạn thấy đấy, một thanh kiếm đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100317,
					"content": "Thì ra bạn biết rèn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "Kiếm này không phải do tôi rèn, nhưng vừa nãy tôi đã dùng thuật giả kim lên nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100320,
					"content": "Muốn thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100321,
					"content": "Hả? Đưa nó cho tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "Theo nghiên cứu của tôi, thanh kiếm này rất đặc biệt, chỉ có bạn mới có thể sử dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100323,
					"content": "Nhưng bây giờ tôi đang cần gấp dữ liệu của nó, phiền bạn mang nó đi chiến đấu nhiều một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100324,
					"content": "Này này, chờ đã, sao lại có thanh kiếm chỉ cho một người sử dụng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100325,
					"content": "Chắc là không có tác dụng phụ phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "Nhạy bén ghê. Thanh kiếm này đích thực khác thường, nó đã bị dính lời nguyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100327,
					"content": "Người bình thường không thể dùng thanh kiếm đơn này, nhưng bạn thì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100328,
					"content": "Hả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100329,
					"content": "Có thể nói, thanh kiếm bị nguyền rủa này chỉ không gây hại cho bạn mà thôi. Nếu đã thế thì ngoại trừ bạn ra tôi đâu còn tìm ai giúp được nữa phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100330,
					"content": "Nói nhiều nói dở, đi tìm vài con quái gần đây đi nào. Có một số chuyện phải thử mới biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100318,
					"content": "Thuật sĩ giả kim cũng kiêm luôn thợ rèn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "Sucrose nói bạn có một số bí mật nhỏ không muốn người khác biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
