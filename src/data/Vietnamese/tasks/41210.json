			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "A, là Sucrose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100202,
					"content": "Bạn cũng lên Núi Tuyết thám hiểm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100203,
					"content": "Á! Giật cả mình... Đừng đột ngột hù tôi khi tôi đang suy nghĩ về báo cáo nghiên cứu nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100204,
					"content": "Nhưng mà trông bạn như chỉ đang đứng trơ trơ thôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100205,
					"content": "Làm, làm gì có, rõ ràng là tôi đang đặt tên cho hạt giống Hoa Ngọt to gấp bốn lần vừa được nghiên cứu và phát triển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100206,
					"content": "Hoa Ngọt với hạt giống to gấp bốn lần chắc chắn ăn rất ngon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "Ồ Ồ, bạn thích sao! Tốt quá, lần sau hãy cho tôi cơ hội thể hiện thành quả mới cho bạn nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100209,
					"content": "Tiếc ghê, nếu không phải đến Núi Tuyết thì tôi đã mang thành phẩm theo bên người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100210,
					"content": "Đúng rồi, không phải bạn làm nghiên cứu trong thành sao? Sao lại chạy đến đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100211,
					"content": "Tôi và Timaeus đang giúp ngài Albedo tổng hợp dữ liệu thực nghiệm. Timaeus vừa đi thôi, các bạn không gặp anh ấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100212,
					"content": "Không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100213,
					"content": "Anh ấy nói bản thân không đủ nhạy với dữ liệu, kém ngài Albedo quá xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100214,
					"content": "Có một số thứ ngài Albedo vừa nhìn một cái là có thể nhìn ra ngay, chúng tôi thì phải suy nghĩ khá lâu. Có lẽ đây chính là khoảng cách giữa học thức và kinh nghiệm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100215,
					"content": "Anh ấy chán nản nên nói muốn đến chỗ nào đó tản bộ, một mình tôi làm trước phần việc còn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100216,
					"content": "(Sao cứ cảm thấy Timaeus cố ý...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "Vốn dự định làm xong việc thì đi loanh quanh xung quanh, không ngờ lại tìm được một số dữ liệu hay ho trong báo cáo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100218,
					"content": "Haiz... hành trình khám phá bí mật của tôi lại phải hoãn lại rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100219,
					"content": "Khám phá bí mật? Bí mật gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100220,
					"content": "A... vậy ra bây giờ hai bạn đang rảnh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100221,
					"content": "Rảnh chứ! Chúng tôi đang dạo quanh khắp nơi nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100222,
					"content": "Có thể nhờ hai bạn giúp tôi một chút không? Kỳ thực tôi cứ thấy... ngài Albedo đang giấu tôi và Timaeus chuyện gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100223,
					"content": "Không phải Albedo là thầy của hai bạn sao? Thầy thì có chuyện gì phải giấu học sinh đâu chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100224,
					"content": "Đúng rồi, nhưng ngài ấy cứ hay che giấu thứ gì đó... chắc chắn là một thứ gì đó lợi hại có liên quan đến thuật giả kim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100225,
					"content": "Rõ ràng chưa hiểu hết sự việc thì sao có thể khẳng định như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100226,
					"content": "Vì tôi và Timaeus đều là nhà nghiên cứu điên cuồng về thuật giả kim, nếu là thứ khác thì ngài Albedo không cần thiết phải giấu chúng tôi mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100227,
					"content": "Ừm... nói vậy cũng có lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100228,
					"content": "Có thể giúp tôi điều tra xem ngài Albedo đang giấu gì không? Tôi tò mò lắm rồi! Xin bạn đó xin bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100229,
					"content": "Ưm... bạn thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100230,
					"content": "Nếu Sucrose muốn biết, tôi có thể tìm thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "Ôi, tốt quá rồi, cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100233,
					"content": "Được rồi được rồi, để chúng tôi đi một chuyến đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100231,
					"content": "Tôi cũng muốn biết bí mật mà Albedo đang muốn che giấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "Cái này có ăn được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
