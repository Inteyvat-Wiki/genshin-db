			"dialogs": [
				{
					"id": 412100401,
					"content": "Tìm thấy rồi! Là tên nhãi đó lấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "Thanh Niên Ác Độc"
				},
				{
					"id": 412100402,
					"content": "Mau giao đồ ra đây, tên trộm cắp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "Thanh Niên Ác Độc"
				},
				{
					"id": 412100403,
					"content": "Đào Bảo Đoàn? Nơi lạnh như vậy cũng có Đào Bảo Đoàn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100404,
					"content": "Đừng lảm nhảm nữa! Để ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "Thanh Niên Ác Độc"
				},
				{
					"id": 412100405,
					"content": "Cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
