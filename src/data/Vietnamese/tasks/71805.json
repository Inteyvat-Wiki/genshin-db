				},
				{
					"id": 718050402,
					"content": "Đây là sách Jifang gửi",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Đây là \"Đế Quân Vi Hành IV\"? Ông nhớ ông đặt từ lâu lắm rồi, sao lại giao trễ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Đức An Công"
				},
				{
					"id": 718050404,
					"content": "Để ông xem... Ơ? Là bản đầu tiên, chẳng trách bây giờ mới giao tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Đức An Công"
				},
				{
					"id": 718050405,
					"content": "Ông còn tưởng vì đông khách quá, nên Jifang quên luôn quyển sách này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Đức An Công"
				},
				{
					"id": 718050406,
					"content": "Ông sẽ nhận quyển sách này, cảm ơn cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đức An Công"
				}
			]
		},
