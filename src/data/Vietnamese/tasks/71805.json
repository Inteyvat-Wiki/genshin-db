					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Chú nhớ ra rồi, lúc trước chú có đặt một quyển \"Hoành Nghi Kinh\" ở \"Vạn Văn Tập\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Chú Tian"
				},
				{
					"id": 718050504,
					"content": "Đúng vậy đúng vậy, đúng là quyển sách chú cần, cuối cùng cũng giao đến. Haha, chú còn tưởng đông khách quá nên Jifang quên luôn quyển sách này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Chú Tian"
				},
				{
					"id": 718050505,
					"content": "Giao đến là tốt rồi, giao đến là tốt rồi... Ồ, đóng gói cũng không tệ, Jifang thật có tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Chú Tian"
				},
				{
					"id": 718050506,
					"content": "Cảm ơn cháu, quyển sách này chú xin nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chú Tian"
				}
			]
