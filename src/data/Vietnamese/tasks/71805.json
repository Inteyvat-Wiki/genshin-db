					"nextDialogs": [
						718050603
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050603,
					"content": "Giao hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "Cảm ơn bạn. \"Vạn Văn Tập\" có thể tồn tại đến bây giờ, đều may nhờ có khách quen ủng hộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050605,
					"content": "Vả lại, những người đó cũng là người yêu sách chân chính, mua được một quyển sách hay, họ cũng sẽ rất vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050606,
					"content": "Nhà lữ hành, cảm ơn bạn đã giúp tôi, hãy nhận lấy số thù lao này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050607,
					"content": "Nếu sau này bạn muốn mua sách, cứ đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
