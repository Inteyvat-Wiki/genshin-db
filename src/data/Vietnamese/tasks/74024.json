				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "Ấy, cô một mình ở đây làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240102,
					"content": "Á! Đừng có tự nhiên đứng sau lưng người ta chứ, suýt chút văng hết bột mài rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240103,
					"content": "Bột? Ồ, thứ này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240104,
					"content": "Là đá quý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240105,
					"content": "Đá... đá quý? Sao ở đây lại có đá quý vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240106,
					"content": "Không có đá quý mới là kỳ đó. Dù sao đây cũng là xưởng nơi tôi xử lý đá quý mà, tuy là vẫn chưa có tên chính thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240107,
					"content": "Trước đây tôi nghĩ nên đặt thẳng là \"Xưởng Sluasi\", nhưng thấy lấy tên mình ra để đặt quả nhiên không thích hợp cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240108,
					"content": "Xử lý đá quý là sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "Chính là biến đá quý thành đồ trang sức đẹp mắt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240110,
					"content": "Tuy nhiên, dạo gần đây tôi cũng không thể nhận thêm công việc rồi, do tôi đang muốn chế tác phẩm màu... mặc dù vẫn là dùng đá quý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240111,
					"content": "Dùng đá quý để chế tạo màu sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240112,
					"content": "Vậy thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240113,
					"content": "Cảm thấy thật lãng phí... Đá quý nếu không muốn dùng nữa thì có thể đưa cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240114,
					"content": "Nhưng tại sao lại phải chế tạo phẩm màu thế? Quá trình dùng đá quý để chế tác trang sức đúng ra đâu cần bước này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240115,
					"content": "Trước đây, có một đứa bé thích vẽ chạy tới hỏi tôi là có thể làm ra thứ màu vẽ lấp lánh như đá quý, sáng như mặt trời không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240116,
					"content": "Dạo trước, khi trong làng có chấn động, cô bé đã cứu em gái tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240117,
					"content": "Vậy nên tôi muốn thực hiện nguyện vọng của cô bé, làm ra thứ màu vẽ rực rỡ như ánh mặt trời để làm quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240118,
					"content": "Có lẽ nào là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "...Này, đứa trẻ thích vẽ mà cô nói có phải tên là Mamere không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240120,
					"content": "Ơ? Đúng rồi... Hai vị quen em ấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240121,
					"content": "Kể cho Sluasi chuyện đã cùng với Mamere trải qua trước đó...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#Lẽ nào... hai vị chính là {NICKNAME} và Paimon tôn kính đã cùng Mamere cứu Puca sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240123,
					"content": "Tôn... tôn kính...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240124,
					"content": "Là tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "Thực sự rất cảm ơn hai vị...! Nếu không có hai vị thì Puca có lẽ đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240127,
					"content": "Nếu hai vị không chê thì hãy nhận lấy thứ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240128,
					"content": "(Đá quý thật đẹp...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#Có nên nhận không, {NICKNAME}? Nhìn qua có vẻ đắt đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240131,
					"content": "Nhưng không ngờ Mamere lại chủ động nhờ vả người khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240132,
					"content": "Sao có thể coi là nhờ vả được? Dù sao em ấy chỉ hỏi tôi là có làm được hay không thôi. Tôi còn chưa kịp trả lời là em ấy đã chạy mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240133,
					"content": "Đúng là rất giống chuyện mà Mamere sẽ làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240134,
					"content": "#Nói đến đây, {NICKNAME} và Paimon kính mến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240135,
					"content": "Trong mắt hai vị, thứ gì \"tiệm cận nhất với màu sắc của mặt trời\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240136,
					"content": "Tuy tôi vẫn đang thử quan sát diện mạo của mặt trời, nhưng tôi cũng không rõ, rốt cuộc là phải dùng nguyên liệu thế nào mới có thể tái hiện được màu sắc đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240137,
					"content": "\"Gần với màu sắc của mặt trời\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240138,
					"content": "...Vàng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "Ừm, Canotila cũng từng nói vậy, \"vàng là nước mắt rơi xuống từ mặt trời\" gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240140,
					"content": "Nhưng mà, lấy vàng ra làm phẩm màu thì hơi xa xỉ nhỉ? Chắc sẽ có thứ rẻ hơn để thay thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240148,
					"content": "Tóm lại, nhắc đến \"thứ gần với màu sắc của mặt trời\" thì chúng ta đã từng thấy, hơn nữa lại là thứ thường xuyên bắt gặp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240141,
					"content": "...Mặt trời?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "...Ra là vậy. Thật không hổ danh. Thứ tiệm cận nhất với màu sắc của mặt trời, quả nhiên chính là mặt trời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240143,
					"content": "Nhưng làm thế nào để đem mặt trời mài thành bột đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240144,
					"content": "Đừng có nói mấy chuyện ngốc nghếch này một cách nghiêm túc thế chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240145,
					"content": "Hay là dùng tóc của tôi nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "...Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240147,
					"content": "Không, tóc thì sao dùng làm phẩm màu được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240130,
					"content": "Cảm ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "Chắc không đến mức \"tôn kính\" đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
