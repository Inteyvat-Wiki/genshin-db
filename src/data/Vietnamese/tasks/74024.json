			"dialogs": [
				{
					"id": 740240315,
					"content": "Sluasi quan sát nguyên liệu một cách tỉ mỉ, sau đó đưa lại cho bạn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240301
					]
				},
				{
					"id": 740240301,
					"content": "Tóm lại, vô cùng cảm ơn hai vị giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240302,
					"content": "#Tuy nhiên, {NICKNAME} kính mến, tôi không thể tùy tiện lấy đồ được. Vì vậy, chỉ cần biết tên nguyên liệu là được, tôi sẽ tự nghĩ cách tìm ra nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240303,
					"content": "Chỉ là, màu sắc như này có hơi đậm quá không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240304,
					"content": "\"Màu sắc của mặt trời\", chắc là sẽ nhạt hơn một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240305,
					"content": "Nhạt hơn một chút, là trắng hơn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240306,
					"content": "Kể ra so với \"màu vàng\" thì \"mặt trời\" có vẻ gần với \"màu trắng\" hơn nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240307,
					"content": "\"Màu trắng\"? Chỉ là tôi cũng không rõ rốt cuộc phải dùng nguyên liệu gì mới làm ra được màu sắc nhạt hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240308,
					"content": "Không thể pha loãng trực tiếp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "Pha loãng thì... trước đây cũng từng thử, nhưng hiệu quả không tốt. Phẩm màu làm theo cách này lúc nào cũng xám xịt, không có cảm giác tươi sáng như mặt trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240310,
					"content": "Vậy nên, nếu được thì vẫn hy vọng sẽ dùng nguyên liệu khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240314,
					"content": "Có điều, thứ có màu trắng, tươi sáng hơn mà chúng ta thường thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240311,
					"content": "Vậy thì dùng tóc của Paimon nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "Tóc là thứ không thể dùng làm phẩm màu được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240313,
					"content": "Với cũng không thể tùy tiện bứt tóc Paimon được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
