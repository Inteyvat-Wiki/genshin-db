					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "Nhưng Sluasi trông có vẻ rất vui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "Dù sao đi nữa, vô cùng cảm ơn hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Thay cho lời cảm ơn, xin hãy nhận lấy những thứ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "Là... là đá quý sáng bóng! Và linh kiện nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Hai vị thích là được rồi. Sau này nếu muốn sở hữu trang sức gì thì có thể đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "Cũng không hẳn là không thể...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "Ừm, dù sao thì màu vẽ Mamere dùng cũng là thứ rất kỳ lạ mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
