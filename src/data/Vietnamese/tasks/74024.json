			"dialogs": [
				{
					"id": 740240516,
					"content": "Sluasi quan sát nguyên liệu một cách tỉ mỉ, sau đó đưa lại cho bạn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240501
					]
				},
				{
					"id": 740240501,
					"content": "Ra là vậy, màu sắc này là thứ \"màu trắng\" mà các vị nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240502
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240502,
					"content": "Vẫn thấy hoàn toàn tương phản với \"màu sắc của mặt trời\"... Hay là dùng \"màu sắc tương phản với nó\" sẽ phù hợp hơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240503
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240503,
					"content": "\"Màu sắc tương phản\"... là đang nói màu đen à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240504,
					"content": "\"Màu đen\"... đúng vậy, có lẽ là màu đen. Không hổ danh là Paimon. Màu của mặt trời, đúng ra phải là \"màu đen\" mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240505,
						740240506
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240505,
					"content": "Cảm thấy có gì đó không đúng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240508
					]
				},
				{
					"id": 740240508,
					"content": "Tóm lại là tại sao lại nghĩ đến màu đen thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240509,
						740240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240509,
					"content": "Mặt trời có màu vàng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240512
					]
				},
				{
					"id": 740240512,
					"content": "Có thể nhờ hai vị một việc cuối được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240513
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240513,
					"content": "Hy vọng hai vị có thể đem đến cho tôi một vật \"màu đen\". Có như vậy thì tôi mới biết mình nên dùng nguyên liệu gì để làm ra \"màu vẽ rực rỡ như mặt trời\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240514
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240514,
					"content": "Thực sự phải tìm sao? Tôi thấy thứ này không còn liên quan gì tới mặt trời nữa rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240515,
					"content": "#Nhưng cô ấy đã nhờ thì... {NICKNAME}, hay là tìm một vật \"màu đen\" cho cô ấy xem nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240510,
					"content": "Nếu là mặt trời vào buổi tối thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240511
					]
				},
				{
					"id": 740240511,
					"content": "Dù có vào buổi tối thì cũng đâu thể biến thành màu đen được! Đúng hơn là, buổi tối thì mặt trời ở đâu ra chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240506,
					"content": "Đúng là Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "Đừng có mà hùa theo chọc ghẹo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
