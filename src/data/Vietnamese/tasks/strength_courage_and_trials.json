			"dialogs": [
				{
					"id": 706940101,
					"content": "Tiểu thư \"Đá Lăn Táo Bạo\", lưng cô còn đau không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940102,
					"content": "Hiện tại không sao rồi... Chườm nóng hiệu quả nhanh thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940103
					],
					"speakerTitle": "Đá Lăn Táo Bạo"
				},
				{
					"id": 706940103,
					"content": "Hì hì, khi dùng thuốc súng cháy chậm để làm nóng băng gạc ướt, thì phải canh thời gian cho thật chuẩn, không là băng gạc sẽ bốc cháy mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940104,
					"content": "Cách làm nóng băng gạc này, chắc chỉ có Yoimiya mới nghĩ ra được thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940105,
					"content": "#Khoan đã... xem ai đến này! Là đại anh hùng danh bất hư truyền và đồng đội màu trắng của {M#cậu}{F#cô} ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940106
					],
					"speakerTitle": "Đá Lăn Táo Bạo"
				},
				{
					"id": 706940106,
					"content": "Những cảnh tượng trong truyện tranh sẽ diễn ra ngay trước mắt tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940107,
						706940108
					],
					"speakerTitle": "Đá Lăn Táo Bạo"
				},
				{
					"id": 706940107,
					"content": "Mọi người đang chữa trị vết thương à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				},
				{
					"id": 706940109,
					"content": "Không sao đâu! Chỉ là đi dạo bên ngoài và tìm vài đối thủ mạnh chưa từng gặp để luyện tập thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940110
					],
					"speakerTitle": "Đá Lăn Táo Bạo"
				},
				{
					"id": 706940110,
					"content": "Tiểu thư Yoimiya mới là người giúp tôi nhiều. Tôi không cẩn thận nên bị trẹo lưng, rồi lăn lông lốc như quả bóng tuyết xuống dưới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940111
					],
					"speakerTitle": "Đá Lăn Táo Bạo"
				},
				{
					"id": 706940111,
					"content": "Ui... Nghe thôi đã thấy đau rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940112,
					"content": "Haha, theo như trong \"Chiến Ký Đấu Sĩ Lửa\" thì \"tôi chỉ là một chiến binh đi ngang qua mà thôi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940113,
					"content": "Và tôi còn là một chiến binh tự do! Đội Kỵ Sĩ đã cho phép tôi hành động, tôi có thể tự mình đánh đuổi ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940114,
						706940115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940114,
					"content": "Nghe như thể vẫn còn ma vật đang lảng vảng nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940116,
					"content": "Tình hình có vẻ không ổn, hay là thông báo cho Đội Kỵ Sĩ cử thêm người tới hỗ trợ nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940117,
					"content": "Đúng là không thể chủ quan, nhưng tình hình cũng không quá cấp bách đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940118,
					"content": "Các chuyên gia của Đội Kỵ Sĩ đã dọn sạch đám ma vật xung quanh khu vực Giải Đua Việt Dã Quốc Tế, chỉ còn lại vài con lang thang đâu đó mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940119,
					"content": "Nói thật, trong số các tuyển thủ tham gia giải việt dã, cũng có không ít nhà mạo hiểm với khả năng chiến đấu đáng nể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940120,
					"content": "Họ có thể chất, có lòng can đảm, nếu bắt họ phải cẩn thận với ma vật như người thường thì ngược lại sẽ khiến họ cảm thấy bị coi thường mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940121,
					"content": "Vì thế, theo truyền thống làm việc của Hiệp Hội Nhà Mạo Hiểm, chúng tôi đã tập hợp thành đội ngay tại chỗ và coi việc xử lý đám ma vật này như một thử thách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940122
					],
					"speakerTitle": "Đá Lăn Táo Bạo"
				},
				{
					"id": 706940122,
					"content": "Chính xác, Thí Luyện Đấu Hồn, trên cơ sở tiêu diệt ma vật, chúng ta sẽ cố gắng bắt chước phong cách chiến đấu của các anh hùng để vượt qua giới hạn bản thân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940123
					],
					"speakerTitle": "Đá Lăn Táo Bạo"
				},
				{
					"id": 706940123,
					"content": "Cách nghĩ này quả thật rất phù hợp với phong cách của Cộng Đồng Trù Phú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940124,
						706940125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940124,
					"content": "Vậy tôi sẽ tham gia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940126,
					"content": "#Tuyệt vời! Lâu rồi không được thấy {NICKNAME} ra tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940127
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940127,
					"content": "#Rất mong chờ đấy. Hiện giờ kỹ năng của {F#cô}{M#cậu}... sẽ đẹp như loại pháo hoa nào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940125,
					"content": "Không thể thiếu tôi được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940115,
					"content": "Phải thận trọng, xung quanh còn có thường dân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940108,
					"content": "Vừa phải chiến đấu sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				}
			]
		}
	]
}