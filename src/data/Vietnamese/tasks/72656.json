			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "Nào, đến đây thử \"Cờ Cơ Quan\" đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560102,
					"content": "Đây là cái gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "Ô...ô! Hoan nghênh hoan nghênh! Đây là trò chơi mới mà tôi vừa được Liyue ủy quyền đại lý, tên là \"Cờ Cơ Quan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560104,
					"content": "Nói đơn giản chính là loại hình trò chơi có thể chơi trên bàn. Ban đầu được phát minh bởi tiểu thư Ruijin ở Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560105,
					"content": "Tôi...nói thế nào nhỉ, theo lời của tiểu thư Ruijin thì tôi là một trong những \"đại lý nước ngoài\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560111,
					"content": "Sau khi nhận được...ừm...quyền làm đại lý, tiểu thư Ruijin đã gửi cả bộ \"Cờ Cơ Quan\" và những góp ý kinh doanh qua đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560112,
					"content": "Tuy nhiên khi gửi đến lại bị Cục Giám Sát Ngoại Quốc giam hàng...tôi phải trầy trật lắm mới mang bộ \"Cờ Cơ Quan\" này về được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560113,
					"content": "Cục Giám Sát Ngoại Quốc giam cái này lại để làm gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "Chỉ cần là đồ từ nước ngoài chuyển đến thì cái gì mà họ không giam chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560115,
					"content": "Thôi không nói chuyện này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560116,
					"content": "Bạn có thấy những món đồ bày trên bàn không? Đây đều là những đạo cụ được sử dụng trong \"Cờ Cơ Quan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560117,
					"content": "Có phải rất có cảm giác Liyue không? Ha ha ha, đây đều là những thứ tôi đã cho người làm riêng đúng theo những gì mà tiểu thư Ruijin mô tả trong thư đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560118,
					"content": "Ngay cả chiếc bàn cũng nhờ người ta làm gần như là giống hệt...tốn bộn tiền đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560119,
					"content": "Hơn nữa trong bộ \"Cờ Cơ Quan\" này, tôi còn thêm vào một cách chơi mới theo lời góp ý của tiểu thư Ruijin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560120,
					"content": "Ừm...nói vậy chắc bạn cũng không hiểu đâu, bạn cứ thử một ván là hiểu ngay ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560121,
					"content": "Thử chơi \"Cờ Cơ Quan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "Không thành vấn đề, cứ chơi đi, đây là \"Cờ Cơ Quan\" kiểu mới, chắc chắn sẽ không làm bạn thất vọng đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560123,
					"content": "Tôi còn chuyện khác phải làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "Ừm, khi nào rảnh cứ đến chơi thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560106,
					"content": "Sao nơi này cũng có \"Cờ Cơ Quan\" vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "Hoan nghênh...Ơ? Bạn biết \"Cờ Cơ Quan\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560108,
					"content": "A...tôi biết rồi, chắc bạn đã từng chơi ở Liyue đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560109,
					"content": "Tiểu thư Ruijin nói cô ấy đã chạy quảng cáo vào dịp Tết Hải Đăng...xem ra đúng là có hiệu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560110,
					"content": "Tôi...nói thế nào nhỉ, theo lời của tiểu thư Ruijin thì tôi là \"đại lý nước ngoài\" ở khu vực Inazuma của trò \"Cờ Cơ Quan\" này đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				}
			]
		}
	]
}