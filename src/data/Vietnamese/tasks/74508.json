			"dialogs": [
				{
					"id": 745080101,
					"content": "Một thời gian sau, bạn và Paimon tới trước gian hàng \"Đấu Nấm Chiến Thuật\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "Hmm! Nấm Quỷ trơn bóng, đàn hồi, mềm mại, non nớt quá tuyệt vời! Muốn chơi tiếp quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080103,
					"content": "Cô là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "Tôi là Enghiene, người đã huấn luyện cho Turenna khi gia nhập Đội Tuần Tra Đặc Biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080105,
					"content": "Tôi khác với Turenna, khác hẳn luôn đấy! Sẽ không vì hai người thuộc hạng \"Chiến Lực Siêu Cấp Vô Địch\" mà cảm thấy sợ hãi đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080106,
					"content": "Melusine này kiêu ngạo thật... Là người đã huấn luyện cho Turenna sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080107,
					"content": "Đừng căng thẳng, Sao Băng Vàng và Ngôi Sao Bạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080108,
					"content": "Turenna nhận được nhiệm vụ khác, nên đã quay về trụ sở của Đội Tuần Tra Đặc Biệt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080109,
					"content": "Enghiene là một chuyên gia do Turenna mời đến, chịu trách nhiệm về an ninh cho nơi tổ chức sự kiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080110,
					"content": "Cô ấy cũng rất thích chơi Đấu Nấm Chiến Thuật, chúng tôi đã chơi rất vui đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080111,
					"content": "Đúng thế, dù là trò chơi hay là chơi với Nấm Quỷ cũng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080112,
					"content": "Trơn bóng, đàn hồi, mềm mại, non nớt, hệt như Tidalga vậy... Hihhi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080113,
					"content": "Sao cô lại chảy nước miếng thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "Không đâu! Tôi chỉ muốn ôm chúng thôi. Haniyyah cũng cho phép tôi nựng Ngọn Lửa Hân Hoan mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080116,
					"content": "#Vậy cô chỉ được nựng Ngọn Lửa Hân Hoan thôi đấy! Chỉ có tôi và {NICKNAME} mới được ôm Nón Trống Tròn thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080117,
					"content": "Sao lại nhỏ mọn thế chứ! Tôi muốn hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080118,
					"content": "Haniyyah nói hai người là chuyên gia chơi trò này đúng không? So tài với tôi một trận nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080119,
					"content": "Nếu tôi thắng thì tôi sẽ ôm Nón Trống Tròn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080120,
					"content": "Tức quá, bị cô ta xem thường rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080121,
					"content": "#{NICKNAME}, chúng ta cho cô ấy biết ai mới là chuyên gia của Đấu Nấm Chiến Thuật đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080122,
					"content": "Và là quán quân của Cúp Nilotpala nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "Đúng đó! Chúng ta có nhiều biệt danh như vậy đâu phải là ngẫu nhiên đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080123,
					"content": "Và là \"Trí Dũng Song Tinh\" nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "Không được ăn Nấm Quỷ nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}