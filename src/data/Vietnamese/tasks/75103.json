				]
			},
			"dialogs": [
				{
					"id": 751030101,
					"content": "Woa, nhiều cá quá! Mọi người đang làm gì ở đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "#Hmm? Xin chào {F#chị}{M#anh} tóc vàng, và cả chị tóc trắng nữa... Tóc trắng... hình như phải là em gái tóc trắng mới đúng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Em và Iwai đang đợi những chú Chim Nước Xanh này lên bờ. Dù sao cũng chẳng còn việc gì để làm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "Đợi Chim Nước Xanh lên bờ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "Hrroo, Roooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030106,
					"content": "Được rồi. Iwai ngoan mà, đúng không nào? Phải kiên nhẫn nhé, đừng vội vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030108,
					"content": "Tóm lại thì ban đầu tụi em định đến đây chơi. Ngoài chú Rongo ra thì thường không ai đến đây cả, cho nên nơi này chính là căn cứ bí mật của tụi em! Đại khái là như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "Nhưng không ngờ là hôm nay nơi này đã bị Chim Nước Xanh chiếm mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "Cho nên em định dùng số thịt cá này để dụ Chim Nước Xanh qua đây. Đám Chim Nước Xanh đó thích ăn cá lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Nhưng hình như chúng không bị dụ nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "Đúng vậy, có thể là vì khoảng cách hơi xa, nên chúng không ngửi thấy mùi cá nhỉ? Nếu có cách dụ chúng vào bờ thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "Nếu là chú Rongo thì chắc chú ấy sẽ nói <color=#00E1FFFF>\"Chỉ cần đụng cho chúng vào bờ là xong!\"</color> Đáng tiếc, em và Iwai quá yếu, nên chắc sẽ bị chúng đụng ngược lại mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Hmm... {NICKNAME}, hay là chúng ta thử xem sao? Nếu dụ được Chim Nước Xanh vào bờ thì biết đâu chúng sẽ bị thịt cá thu hút đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "Hóa ra Paimon cũng là Chim Nước Xanh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Tròn vo, thích ăn cá... Hóa ra là vậy, đúng là loài Chim Nước Xanh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "Mmm! Mmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030115,
					"content": "Không phải vậy nhé! Mà quay lại chủ đề chính đi, chẳng phải đám Chim Nước Xanh này hoàn toàn không bị dụ sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
