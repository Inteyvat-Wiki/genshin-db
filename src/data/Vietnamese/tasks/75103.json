					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030406
					]
				},
				{
					"id": 751030406,
					"content": "#Vậy thì tạm biệt {F#chị}{M#anh} nhé! Nếu lần sau rảnh rỗi thì cứ đến đây chơi chung với em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030404,
					"content": "Hình như Paimon cũng bị thịt cá hấp dẫn rồi kìa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030405
					]
				},
				{
					"id": 751030405,
					"content": "Không có chuyện đó nhé! Tôi sẽ không bị thu hút bởi những nguyên liệu chưa được nấu thành món ăn đâu... Hmm, tuyệt đối không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
