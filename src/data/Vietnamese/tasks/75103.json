			"dialogs": [
				{
					"id": 751030801,
					"content": "Woa, nhiều cá quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030802,
					"content": "#Ối, {F#chị}{M#anh} tóc vàng, không được nghịch lung tung! Những cái đó là để dụ Chim Nước Xanh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030803,
					"content": "Hả, dụ Chim Nước Xanh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030804,
					"content": "Đúng vậy, em và Iwai đang đợi những chú Chim Nước Xanh này bơi vào bờ. Dù sao thì em cũng chẳng còn việc gì khác để làm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030805,
					"content": "Hrroo, Roooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030806,
					"content": "Được rồi. Iwai ngoan mà, đúng không nào? Phải kiên nhẫn nhé, đừng vội vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030807,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030808,
					"content": "Tóm lại thì ban đầu tụi em định đến đây chơi. Ngoài chú Rongo ra thì thường không ai đến đây cả, cho nên nơi này chính là căn cứ bí mật của tụi em... Đại khái là như vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030809,
					"content": "Nhưng không ngờ là hôm nay nơi này đã bị Chim Nước Xanh chiếm mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030810,
					"content": "Cho nên em định dùng số thịt cá này để dụ Chim Nước Xanh qua đây. Đám Chim Nước Xanh đó thích ăn cá lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030811,
					"content": "Nhưng hình như chúng không bị dụ nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "Đúng vậy, có thể là vì khoảng cách hơi xa, nên chúng không ngửi thấy mùi cá nhỉ? Nếu có cách dụ chúng vào bờ thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030817,
					"content": "Nếu là chú Rongo thì chắc chú ấy sẽ nói <color=#00E1FFFF>\"Chỉ cần đụng cho chúng vào bờ là xong!\"</color> Đáng tiếc, em và Iwai quá yếu, nên chắc sẽ bị chúng đụng ngược lại mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030818,
					"content": "#Hmm... {NICKNAME}, hay là chúng ta thử xem sao? Nếu dụ được Chim Nước Xanh vào bờ thì biết đâu chúng sẽ bị thịt cá thu hút đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030812,
					"content": "Hóa ra Paimon cũng là Chim Nước Xanh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "Tròn vo, thích ăn cá... Hóa ra là vậy, đúng là loài Chim Nước Xanh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030814,
					"content": "Mmm! Mmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030815,
					"content": "Không phải vậy nhé! Mà quay lại chủ đề chính đi, chẳng phải đám Chim Nước Xanh này hoàn toàn không bị dụ sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Paimon"
				}
			]
		},
