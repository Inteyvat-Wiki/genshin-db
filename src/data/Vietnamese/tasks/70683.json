			"dialogs": [
				{
					"id": 706830701,
					"content": "Cảm ơn Kỵ Sĩ Danh Dự và trợ thủ màu trắng nhé. Không hổ danh là dũng sĩ quốc dân của Mondstadt. Một lần diễn tập khiến người ta có ấn tượng sâu sắc và phân tích nhiều lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830702,
						706830704
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830702,
					"content": "Haha, không hổ danh là chúng tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830703
					]
				},
				{
					"id": 706830703,
					"content": "#Hihi, dù sao {NICKNAME} cũng đã chiến đấu với vô số ma vật trong hiện thực mà! Tóm lại, như vậy xem như đã giúp được Đội Kỵ Sĩ rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830705,
					"content": "Ừm, quá trình diễn tập rất thuận lợi. Dù là tiểu đội 7 hay toàn bộ Đội Kỵ Sĩ Tây Phong thì cũng đều học được một số bài học hữu ích từ việc phân tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830706
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830706,
					"content": "Như vậy thì việc cải thiện tình hình trị an xung quanh Mondstadt cũng sẽ thuận lợi hơn. Ví dụ như Slime đột nhiên xuất hiện tấn công người già, Hilichurl cướp bóc thương đội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830707
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830707,
					"content": "Không biết tại sao nữa, cứ cảm thấy như đã gặp nhiều lần rồi... Hmm, cũng có nghĩa là những chuyện này sau này sẽ không xảy ra nữa, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830708,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830709
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830709,
					"content": "Đúng... đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830710,
					"content": "Chuyện này cần có thời gian, nhưng chúng tôi sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830711
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830711,
					"content": "Phonia! Phonia! Nghe tôi nói này... A, là Kỵ Sĩ Danh Dự và trợ thủ màu trắng! Xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830712
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830712,
					"content": "...Lại có chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830713
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830713,
					"content": "Này, đừng bày ra vẻ mặt đó chứ! Rõ ràng điều tôi muốn báo cáo cũng là chuyện liên quan đến diễn tập mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830714
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830714,
					"content": "Tóm lại, vừa rồi khi tôi \"diễn tập trong lặng lẽ\" theo yêu cầu của cô, tôi đã phát hiện được một chuyện rất lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830715
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830715,
					"content": "Chuyện rất lợi hại?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830716,
					"content": "Đúng vậy! Nhìn xem, tuy chỉ là diễn tập, nhưng khi tính toán số liệu, nếu tăng uy lực nổ lên gấp mười lần thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830717
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830717,
					"content": "Thì mũi tên nổ cỡ nhỏ của chúng ta sẽ có thể hạ gục một con Thủ Vệ Di Tích trong nháy mắt đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830718
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830718,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830719,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830720
					]
				},
				{
					"id": 706830720,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830721
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830721,
					"content": "Tôi hỏi trước một câu đã... Tại sao phải gấp mười lần?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830722
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830722,
					"content": "Điều đó sẽ làm cho kết quả đẹp hơn! Ý tôi là, cho dù không khả thi trong hiện thực, nhưng dữ liệu như vậy vẫn sẽ luôn thú vị mà, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830723
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830723,
					"content": "Nếu cố gắng hơn nữa, nói không chừng một ngày nào đó sẽ đạt được thành quả như vậy đấy! Thế là sẽ tái hiện được một phần mười sức mạnh của Bom Nảy... Ahhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830724
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830724,
					"content": "Vậy thì cô nên tăng uy lực nổ lên gấp trăm lần mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830725
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830725,
					"content": "Ừm? Đúng nhỉ! Không hổ danh là Phonia! Nếu nhân lên trăm lần thì chắc chắn sẽ đánh bại bất kỳ loại ma vật nào rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830726
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830726,
					"content": "Đặc biệt là loại được trang bị \"Lõi Chiến Thuật Vua Cá Sừng\", một phát là có thể tiêu diệt một đám Cần Cẩu Di Tích luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830727
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830727,
					"content": "Vậy sao không tăng lên hàng triệu lần luôn đi? Nói không chừng một phát là có thể làm nổ tung Giáo Đường Tây Phong đấy, rồi lúc đó sẽ nhìn thấy cả Viện Khoa Học Fontaine ở bên kia biển luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830728
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830728,
					"content": "Sau đó cô sẽ bị Giáo Hội treo lên để thị chúng, và tôi sẽ thoát khỏi cô để đi tìm một người thuê nhà bình thường hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830729
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830729,
					"content": "Hic... Tôi chỉ nói đùa thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830730
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830730,
					"content": "Không sao, tôi cũng chỉ đùa thôi. Dù sao thì giờ tôi cũng là chỉ huy của cô, nếu cô bị treo lên thì tôi cũng sẽ bị liên đới. Như vậy thì nhà đâu thể cho thuê được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830731
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830731,
					"content": "Vậy câu đùa ở đây chính là chuyện cho thuê nhà sao... Đúng là kỳ lạ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830732,
					"content": "Tóm lại, Kỵ Sĩ Danh Dự và trợ thủ màu trắng, một lần nữa cảm ơn sự giúp đỡ của các vị. Ngoài ra thì Ematol, sau khi trở về thì hãy đóng cửa kiểm điểm lại việc thay đổi tham số nhé. Không được phản bác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830704,
					"content": "Giúp được là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830705
					]
				}
			]
		}
	]
}