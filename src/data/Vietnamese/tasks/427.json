			"dialogs": [
				{
					"id": 4270201,
					"content": "Này... Tôi ở đây, tôi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270202,
					"content": "Tôi đã bố trí xong rồi, chúng ta tiếp tục thi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270203,
					"content": "Vẫn giống với hình thức thi trước đây, vượt qua những vòng tròn, bay một mạch đến đích nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270204,
					"content": "Tôi chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42704,
			"completionStepIds": [
				42704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
