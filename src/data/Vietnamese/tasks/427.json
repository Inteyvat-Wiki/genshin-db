			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "Chào bạn, tôi là kỵ sĩ của Đội Kỵ Sĩ Tây Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270802,
					"content": "Á, có chuyện gì vậy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270803,
					"content": "Xin chào, vui lòng xuất trình bằng bay lượn của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270804,
					"content": "Bằng, bằng bay lượn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "Bay lượn phi pháp không có bằng, chiếu theo điều luật thứ 12 khoản 7 luật quản lý trị an Mondstadt, vui lòng đi theo tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270807,
					"content": "Bạn có quyền giữ im lặng, nhưng gió sẽ ghi nhớ từng câu nói của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270808,
					"content": "Đợi chút! Chúng tôi đang tiến hành thi bằng bay lượn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270809,
					"content": "A, là vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270810,
					"content": "Nhưng thi bằng bay lượn ngay lúc này, thật là trùng hợp mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270811,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270812,
					"content": "Đội Kỵ Sĩ vừa nhận được báo án của tu nữ giáo đường, \"Quái Điểu\" lại dùng Phong Chi Dực trốn mất rồi, cho nên lúc nãy tôi mới nghĩ học trò của cô là đồng bọn nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270813,
					"content": "Quái Điểu? Đó là thứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270814,
					"content": "Là một tên tội phạm của thành Mondstadt. Nó thường dùng Phong Chi Dực để gây án, cho nên có biệt danh là \"quái điểu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270815,
					"content": "Ồ, tên đó bay nhanh lắm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270816,
					"content": "Hiện tại... Chúng tôi chưa đuổi kịp lần nào, lần này muốn dùng văn vật trong giáo đường để làm mồi nhử, để bắt tên trộm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270817,
					"content": "Nhưng lại để nó đem theo văn vật trốn mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270818,
					"content": "Nhưng mà, lần này các tu nữ đã dùng ma pháp Nguyên Tố để đánh dấu lên văn vật rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270819,
					"content": "Nhưng tên đó bay nhanh quá, đi theo dấu vết Nguyên Tố cũng không đuổi theo kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270820,
					"content": "Hóa ra là một cao thủ bay lượn, vậy thì ngoài Amber tôi ra không ai đuổi kịp, tên đó bay theo hướng nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270821,
					"content": "Theo tôi biết, lần cuối hắn xuất hiện là ở Thanh Tuyền Trấn, nhưng cũng đã cách đây rất lâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270822,
					"content": "#Cứ giao cho tôi, {NICKNAME} cũng đang ở đây, chúng tôi cùng đuổi theo, bắt tên quái điểu ấy về quy án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270823,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "Đừng lo lắng, đợi bắt được tên quái điểu đó, tôi sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270826,
					"content": "...Đi nói tình hình với đội trưởng Jean, à hừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270824,
					"content": "Vậy thì cuộc thi bằng bay lượn có phải là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "Bị... bị con thỏ bá tước ăn mất rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
