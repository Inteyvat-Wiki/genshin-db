			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270401,
					"content": "Xem ra bạn đã nắm được kỹ thuật dùng Phong Chi Dực rồi, vậy thì chúng ta hãy bắt đầu vòng cuối nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270402,
					"content": "Con đường này đã bay qua một lần rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270403,
					"content": "Vậy thì, đây là lần thử cuối cùng, sau khi xong thì có thể đợi cấp bằng bay lượn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270404,
					"content": "Vì bằng bay lượn, chuẩn bị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270405,
					"content": "...Bắt đầu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42708,
			"completionStepIds": [
				42708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
