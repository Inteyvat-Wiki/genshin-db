					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "Ha ha, khoa trương vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610707,
					"content": "Đợi bạn đuổi hết bọn chúng đi rồi hãy nói với tôi câu này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610708,
					"content": "Nhất ngôn cửu đỉnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610709
					]
