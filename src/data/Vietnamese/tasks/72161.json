				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "Hừ, thật là đáng xấu hổ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610102,
					"content": "Rõ ràng đã cứu mạng bạn mà bạn lại chê chúng tôi đáng xấu hổ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610103,
					"content": "Anh ấy đang nói bản thân mình...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "Không ngờ tôi lại rơi vào cảnh được người ngoại quốc cứu thoát, lại còn để họ mặc sức phán xét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610106,
					"content": "Ưm...có điều, samurai tiên sinh, bạn vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610108,
					"content": "Xem ra vẫn đầy sức sống...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "Tôi nợ ân tình của các bạn, người ngoại quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610111,
					"content": "Còn nữa, ban nãy đánh hay lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610112,
					"content": "#{NICKNAME}, may mắn khi được quen biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "Đừng tự đắc, người ngoại quốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610114,
					"content": "...Inaba Tousaburou Kyuuzou, gọi tôi Kyuuzou là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610115,
					"content": "Những kẻ đó là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "Là hải tặc, dọc bờ Nazuchi có khá nhiều cứ điểm của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610118,
					"content": "Kẻ cướp lẩn trốn, thợ mỏ thất nghiệp, ngư dân, đào phạm bị truy nã, hoặc binh lính bỏ trốn từ hai phe trong chiến tranh, đôi khi sẽ tập hợp lại, sa ngã trở thành kẻ cướp...hòng thoát khỏi sự kiểm soát của Ogosho đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610119,
					"content": "Kẻ Lang Thang cũng được, Kairagi cũng xong, một đám coi trời bằng vung...Thời gian trước chúng tôi ráo riết truy đuổi chúng, cho đến khi phản quân phá huỷ Vật Trấn Giữ trên đảo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610120,
					"content": "Tatarasuna và nạn dân của mỏ khoáng chạy loạn khắp nơi, trong đó có một số kẻ tiểu nhân trục lợi, làm giàu cho đám hải tặc, chúng thậm chí còn vô lương tâm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610121,
					"content": "Đám hải tặc ban nãy đến từ doanh trại phía nam, chúng đã để ý tới hàng hoá trên chiếc thuyền này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610122,
					"content": "Đáng tiếc là tôi đã ngáng đường chúng, ha ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610123,
					"content": "Đây không phải thuyền của bạn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "Con thuyền này? Vốn dĩ là thuyền của phản quân Sangonomiya. Tôi cũng không rõ...tóm lại khi tôi đến đây, trên thuyền đã chẳng có bóng người nào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610125,
					"content": "Thế là tôi liền ở lại đây, sống như ốc mượn hồn đến tận bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610126,
					"content": "Đây là lần đầu tiên tôi nói nhiều như vậy trong một thời gian dài. Thật là mệt mỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610127,
					"content": "Nhân tiện, nếu bạn không phiền, hãy làm ơn giúp tôi một việc nhé...Khi tôi bình phục vết thương, nhất định sẽ trả lại ân tình mà tôi nợ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610128,
					"content": "Doanh trại hải tặc ở xung quanh mà tôi vừa nhắc đến, bạn giúp tôi tiêu diệt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610129,
					"content": "Chỉ có vậy đám hải tặc như chó hoang mới không tiếp tục quấy nhiễu tôi. Có lẽ còn có thể răn đe các doanh trại hải tặc khác, để chúng không dám tuỳ tiện tấn công con tàu nát này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610130,
					"content": "Vậy để tôi xem thử bản lĩnh của bạn, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610131,
					"content": "Chuyện nhỏ như con thỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "Hừ, khoa trương vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610134,
					"content": "Phải rồi, người ngoại quốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610135,
					"content": "Đừng sơ ý, cẩn thận trượt chân đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610132,
					"content": "Đi chút rồi quay lại ngay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "Sao bạn lại bị bao vây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "Rõ ràng là lòng tự trọng bị tổn thương...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "Là kiểu cách khoa trương của riêng samurai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
