				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610601,
					"content": "Người ngoại quốc, dạo này thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610602,
					"content": "Xin lỗi, nơi này không phải nơi để tiếp khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610603,
					"content": "Nhưng...tôi rất vui vì bạn đã đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610604,
					"content": "Bạn trông khá hơn nhiều rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "Ừm, lại nợ bạn một món nợ ân tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610606,
					"content": "Ha ha, đáng tiếc là tôi vẫn sống sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610607,
					"content": "Đây không phải chuyện tốt sao. Có gì đáng tiếc chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610608,
					"content": "Tiếp theo có dự định gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "Tôi vẫn chưa nghĩ xong tiếp theo sẽ làm gì, nhưng tôi nghĩ mình sẽ không trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610611,
					"content": "Mặc dù công tử Kujou Masahito là người tốt, nhưng ông bố của nhà đó đang kêu gọi bắt binh lính đào ngũ để nâng cao thanh thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610612,
					"content": "Tôi không thể tự dâng mình đến lưỡi đao của hắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610613,
					"content": "Có lẽ tôi sẽ cởi bỏ bộ giáp này, sống một mình thế này cũng không tệ lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610614,
					"content": "Những ngày bình yên không thể khiến tôi lừa mình dối người, ký ức cho tôi biết rằng mình vẫn là người thương binh nhiệt huyết kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610615,
					"content": "Haiz...tóm lại, chuyện sau này ai biết được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610616,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "Kể ra thì, tôi chưa từng nghi ngờ quyết định nào của Ogosho đại nhân, nên tôi nghĩ, dù rời đi tôi cũng sẽ không có gì hối tiếc nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610619,
					"content": "Ừm...bầu không khí đột nhiên trở nên nặng nề hơn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610620,
					"content": "À, nhắc tới đây...Tôi cũng nên đi thăm những chiến hữu cũ của mình rồi, họ vẫn luôn ở cùng tôi trên hòn đảo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610621,
					"content": "Truyền thống của Inazuma là dâng \"Hoa Lan Máu\", một loài hoa mong manh đầy mê hoặc...là tượng trưng cho số phận của võ nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610622,
					"content": "Nhân tiện, nếu bạn gặp những chiến hữu cũ của tôi trong chuyến hành trình của mình, phiền bạn dừng chân và làm quen với họ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610617,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "Có nghĩ đến việc trở về không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
