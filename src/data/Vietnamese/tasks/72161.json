					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610305,
					"content": "Nhờ vả người ngoài cuộc như bạn làm những chuyện bẩn tay này, thật lòng xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610306,
					"content": "Bạn không giống một người khách sáo như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610309,
					"content": "Thảo mộc đã dùng hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610310,
					"content": "Thuốc bôi trước đó đã hết, nhưng vết thương vẫn còn sưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610311,
					"content": "Có điều...không cần lo cho tôi, tôi vẫn trụ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610312,
					"content": "Đi làm việc của bạn đi, đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610313,
					"content": "Hệt như đứa trẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610315,
					"content": "Bạn nói gì...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610316,
					"content": "Tôi nói bạn đó, giống hệt một đứa trẻ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610317,
					"content": "Rõ ràng là hoàn cảnh rất éo le, suýt khóc lóc kêu cứu nhưng vẫn phải gồng mình giả làm một người cứng rắn...không thẳng thắn chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610318,
					"content": "Chỉ có trẻ con mới làm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610319,
					"content": "Hơn nữa Kyuuzou, bạn đừng quên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610320,
					"content": "Bạn còn nợ chúng tôi món nợ ân tình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "Hừ...Đúng là hết cách với bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610323,
					"content": "Vậy thì hãy giúp tôi kiếm một ít Cỏ Naku, có thể nhìn thấy ở khắp mọi nơi trên hòn đảo này. Tốt nhất là phiến lá đầy đặn, dùng để ép lấy nước, dùng đắp ngoài để giảm viêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610324,
					"content": "Cứ vậy đi. Để tôi chợp mắt một lát, đừng làm phiền tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610321,
					"content": "Chúng tôi đến để giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "Vết thương đỡ hơn chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "Đủ đề sống yên ổn một thời gian rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
