			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "Sẽ mất nhiều thời gian để nghiền các loại thảo mộc thành thuốc bôi, bạn có thể đi được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610506,
					"content": "...Không, không phải là tôi đang đuổi bạn đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610507,
					"content": "Một thời gian nữa hẵng quay lại, có người trò chuyện...cũng không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610508,
					"content": "Tôi hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				},
				{
					"id": 721610510,
					"content": "Bảo trọng, người ngoại quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610509,
					"content": "Dưỡng thương cho tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				}
