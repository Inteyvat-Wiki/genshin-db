				},
				{
					"id": 721611302,
					"content": "Nếu là du khách thì bạn đến sai chỗ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611303
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611303,
					"content": "Bạn đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611304
					]
				},
				{
					"id": 721611304,
					"content": "Sao, bạn là người của Shogunate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611305
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611305,
					"content": "Không phải.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611306
					]
				},
				{
					"id": 721611306,
					"content": "Vậy thì lo tốt việc của mình đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611307,
					"content": "Tên này sao lại đáng ghét như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611308,
					"content": "Tôi được Shogunate phái đến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611309
					]
				},
				{
					"id": 721611309,
					"content": "Ừm, người ngoại quốc như các bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611310,
					"content": "Trước mặt đại nhân của hiệp hội thì nịnh hót lấy lòng, kiếm được chút cơm thừa canh cặn thì lại vênh váo hống hách trước mặt samurai Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611311,
					"content": "Thăm dò hết chỗ này đến chỗ khác, lăn lộn khắp nơi chưa nói...bây giờ còn chạy đến tận chiếc thuyền nát này, không biết là có việc gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611312,
					"content": "Đáng tiếc quá, tôi chỉ là một thương binh, chẳng có gì để tiếp đón bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611313,
					"content": "Vì vậy phiền đại nhân đây tự đi ra ngoài nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611314
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611314,
					"content": "Tên này hoàn toàn không biết nói chuyện tử tế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611315,
					"content": "Được rồi, các bạn ồn quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611316,
					"content": "Trước khi đi, tôi cho bạn một lời khuyên: Đừng ở trên đảo Yashiori quá lâu, hòn đảo này đã bị nguyền rủa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611317
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611317,
					"content": "Nguyền rủa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611318
					]
				},
				{
					"id": 721611318,
					"content": "Không hiểu à? Hòn đảo này bị nguyền rủa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611319
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611319,
					"content": "Những cuộc chiến tranh đình trệ, những dục vọng của các đại nhân, nỗi tuyệt vọng của những con người nhỏ bé, lòng căm thù của những nạn nhân vô tội, mùi thuốc tràn ngập căn nhà khi người già qua đời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611320
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611320,
					"content": "Tóm lại, chính là bị nguyền rủa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611321
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611321,
					"content": "Nhân lúc chưa bị dính dáng, hãy mau rời khỏi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611322
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611322,
					"content": "Ưm...hoàn toàn không hiểu, đúng là người kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7216114,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721611401,
					"content": "Sao lại là bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611402,
					"content": "Chẳng phải tôi từng nói với bạn rồi à. Haiz, thôi bỏ đi. Bạn vui là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611403,
					"content": "Đừng làm loạn đồ của tôi, đồ tiếp tế trên thuyền còn đủ để chia cho bạn một ít. Vừa lòng rồi thì mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611404,
					"content": "Có cần giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "Không cần. Bạn không thấy tôi đang sống rất tốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611406,
					"content": "Nhưng vết thương của bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "Đó là vết thương của tôi, không phải của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611408,
					"content": "Này, chúng tôi có ý tốt mới hỏi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611409,
					"content": "Vậy tôi cũng có ý tốt mới trả lời các bạn: Đừng làm phiền tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611410,
					"content": "Tôi có thể giúp bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "Giúp tôi như thế nào, giao tôi cho quân Shogunate à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611412,
					"content": "Ha ha, tôi khuyên bạn đừng ngốc nữa...tôi sẽ bị coi là lính đào ngũ. Kujou đại nhân chưa bao giờ thương xót lính đào ngũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611413,
					"content": "Nếu bạn thật sự muốn giúp tôi, thì hãy để tôi yên tĩnh một mình đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611414,
					"content": "Wa, cái tên cố chấp này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
