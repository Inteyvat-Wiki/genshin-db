						730141208
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141208,
					"content": "#À, dù sao Aranara cũng nhỏ quá mà, chút việc nhỏ đó cứ giao cho Nara {NICKNAME} đi.",
