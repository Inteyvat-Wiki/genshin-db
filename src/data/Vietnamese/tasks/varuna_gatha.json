					"content": "Không biết mặt trời mọc rồi lại lặn bao nhiêu lần, Nara Varuna đã đến, Nara Vàng, nói ngôn ngữ màu vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140310,
					"content": "#{F#Anh ấy}{M#Cô ấy} cùng Aranara đưa mặt trăng và mặt trời quay về. Cỗ Máy Varuna rửa sạch đau đớn của Vanarana, không còn cơn mưa màu đen, mùi sắt và muối nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140311,
					"content": "Người ở Vanarana đều biết ơn Nara Varuna, đều thích Nara Varuna, giống như thích mặt trời, bùn đất, mưa mù vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140312,
					"content": "#Wow, nghe có vẻ lợi hại ghê! {F#Anh ấy}{M#Cô ấy} nhất định là một Nara tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140313,
					"content": "#Có điều, hì hì, Nara {NICKNAME} cũng giúp qua rất nhiều người, cũng nhận được rất nhiều lời cảm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140314,
					"content": "#Arapandu nhất định cũng sẽ yêu mến Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140315,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "#Sau khi {F#anh ấy}{M#cô ấy} rời khỏi Vanarana, rất nhiều thứ sinh ra từ bùn đất, cũng có nhiều thứ quay lại với bùn đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140317,
					"content": "Cành lá của Cỗ Máy Varuna cũng không còn sức nữa, Bảo Vật Varuna như một chú chim sợ hãi, vỗ cánh loạn xạ, mưa ngày càng nhiều, rất kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140318,
					"content": "Nấm biết chạy ở lại Vana, xung quanh đều là hạt giống chưa từng thấy bao giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140319,
					"content": "...Chẳng lẽ là Nấm Quỷ và Bào Tử sao? Nhưng rốt cuộc Cỗ Máy Varuna và Bảo Vật Varuna là cái gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140320,
					"content": "Là vũ khí rất lợi hại nào đó ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140321,
					"content": "Là thanh đao có thể chia Valuka làm hai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "Nói thế nào đi nữa thì cái này cũng quá sức lợi hại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140327,
					"content": "#Ừm... Không đúng, không đúng. Nara {NICKNAME} và Paimon đều không đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140328,
					"content": "Chúng ta tới chỗ cao hơn đi, để Arapandu nói cho các bạn biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140323,
					"content": "Có thể không phải vũ khí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "Vậy sẽ là cái gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140325,
					"content": "Có thể là một Aranara có cánh làm từ nước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "Đó chẳng phải là ảo ảnh của Tinh Linh Nước Trong sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
