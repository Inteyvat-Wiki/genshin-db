						730141504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141504,
					"content": "Trước kia từng thành công, nhưng lần này có thể thành công mà cũng có thể thất bại. Giống như lần trước và lần trước nữa mặt trời đều mọc lên, nhưng lần tiếp theo mặt trời có mọc lên hay không thì không ai biết cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141505,
					"content": "Chỉ sau khi mặt trời mọc, Paimon mới có thể nói, \"A, mặt trời lại mọc rồi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141506,
					"content": "Hic... Đáng sợ quá... Lỡ như mặt trời thật sự không thể mọc lên nữa thì phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141507,
					"content": "#Paimon đừng sợ, Nara {NICKNAME} cũng giống như Nara Varuna, cũng có màu vàng như mặt trời, hơn nữa còn là một Nara dũng cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141508,
					"content": "#Nara Varuna mang lại mặt trăng và mặt trời cho chúng tôi, Nara {NICKNAME} cũng có thể làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141509,
					"content": "#...Ừm! Tôi cũng tin {NICKNAME}, dù có khó khăn cách mấy đi nữa cũng không thể làm khó được đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141510,
					"content": "Cứ yên tâm giao cho tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "Nhưng bây giờ cứ giao cho Arapandu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141512,
					"content": "Ấy, hình như... thành công rồi kìa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141513,
					"content": "Đúng, cành và lá ở đây đã sửa xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141514,
					"content": "Tốt quá! Nhưng vũ đạo của Aranara thật sự rất đặc biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141515,
					"content": "Có lẽ Paimon cũng nên theo Aranara học hỏi một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "Nghe cũng được đấy nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141517,
					"content": "Với sức ăn của Paimon, đúng là nên vận động nhiều một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "#Hứ! Tôi theo {NICKNAME} chạy tới chạy lui cũng là đang vận động mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141519,
					"content": "Có điều, nếu chỉ như vậy thì Cỗ Máy Varuna vẫn chưa sửa xong hết đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141520,
					"content": "Còn ba điểm phân tán ở Vana. Arabalika rất mạnh, có lẽ sẽ được... Nhưng Aranakula và Arakunti, thì lại đáng lo. Bởi vì mưa không bình thường, Vana lại càng nguy hiểm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141521,
					"content": "#Hay là tôi cùng {NICKNAME} đi xem tình hình của họ thử, dù sao thì nếu không sửa Cỗ Máy Varuna xong thì cũng chẳng thể yên tâm chuẩn bị mở Lễ Hội Utsava được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141522,
					"content": "#Có Paimon và Nara {NICKNAME} giúp đỡ, Cỗ Máy Varuna nhất định sẽ được sửa xong, Vana chắc chắn cũng sẽ khôi phục lại sức sống, giống như trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141523,
					"content": "Aranakula đã đến <color=#00E1FFFF>Ảo Cảnh Yasna</color>, sâu trong Vana, nơi đó có quá nhiều kỷ niệm của Aranara dành cho Nara Varuna, nhưng vì \"Nấm Quỷ\" và \"Bào Tử\", nên lâu lắm rồi không đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141524,
					"content": "Aranakula đã quen sống cùng bùn đất và hạt giống, sinh trưởng trong bùn đất chính là sở trường của Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141525,
					"content": "Tìm Aranakula, và nói là đã biết tên của Arapandu, vậy thì Aranakula sẽ không sợ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141526,
					"content": "Ừm, nghe có vẻ như là một Aranara hơi nhát gan nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141527,
					"content": "#Ararakalari của Arabalika rất mạnh! Nhưng... nhưng vẫn xin Paimon và Nara {NICKNAME} đi gặp Arabalika thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141528,
					"content": "#Arabalika đang ở <color=#00E1FFFF>Phế Tích Dahri</color>, chỗ đó có nhiều mùi sắt... Paimon và Nara {NICKNAME} phải cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141529,
					"content": "Ừm, chúng tôi sẽ cẩn thận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "Arakunti đang ở <color=#00E1FFFF>Khoảnh Rừng Mơ</color>, chỗ đó có lối vào giấc mơ. Arakunti không quen Nara, nếu như Arakunti ẩn nấp thì cứ hát khúc nhạc của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141531,
					"content": "Kể ra thì trước đây chúng ta có lấy được bản nhạc của Aranara đấy. Nếu như không tìm thấy Arakunti thì thử biểu diễn âm nhạc cũng được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141532,
					"content": "Arapandu sẽ tới \"nơi dừng chân\" chờ trước để quan sát tình hình của Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141533,
					"content": "Aranakula, Arabalika và Arakunti đều biết, sau khi sửa cành lá xong xuôi sẽ trở lại \"nơi dừng chân\" để tập hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141534,
					"content": "#Nara Vàng, Nara dũng cảm, Aramuhukunda sẽ dõi theo Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141535,
					"content": "Ừm! Cứ giao cho chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "Ồ! Bên đó là cái gì thế?! Hoành tráng ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141702,
					"content": "#Bây giờ Nara {NICKNAME} và Paimon đã biết rồi đấy, đó chính là Bảo Vật Varuna, Cỗ Máy Varuna nằm ở nơi sâu hơn, sâu như rễ cây ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141703,
					"content": "Xem ra chúng ta đã quá xem thường Nara Varuna rồi, không ngờ nó lại lớn như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141704,
					"content": "Sức mạnh như vậy không thể nào xem thường...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "Trước khi mưa đen trút xuống, Nara Varuna còn chưa tới Vana, Aramuhukunda và vị vua cây cỏ đã sáng tạo ra Cỗ Máy Varuna, cơn mưa mang đến rất nhiều sinh mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141706,
					"content": "Mưa đen và bùn đen, và rất nhiều thứ không tốt khác đã khiến Vana trở nên hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141707,
					"content": "#Trước khi gặp {F#anh ấy}{M#cô ấy}, tôi chưa từng gặp Nara nào dũng cảm như thế, xua tan mây mù như ánh ban mai, cùng Aranara sửa chữa Cỗ Máy Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141708,
					"content": "Hiện tại Nara Varuna không còn ở Vanarana nữa, Aramuhukunda cũng không ở Vanarana... Nhưng Aranara phải sửa lại Cỗ Máy Varuna. Vì Lễ Hội Utsava, vì Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141709,
					"content": "Lúc trước chúng tôi đã hứa với Araja và Arama là sẽ chuẩn bị cho Lễ Hội Utsava. Tục ngữ nói, nhiều Nara mới nhặt được nhiều củi đốt hơn, đúng không nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141710,
					"content": "Á...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141711,
					"content": "À! Không, không đúng, ý của tôi là: Càng nhiều Nara thì càng dễ hoàn thành mọi chuyện hơn! Đừng sợ mà, không liên quan gì tới lửa đâu! Không có tí nào luôn á!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141712,
					"content": "Paimon lại hơi hoạt ngôn quá rồi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "Hức... Lần đầu tới Sumeru, người ta muốn chứng tỏ mình cũng học rộng hiểu nhiều mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141714,
					"content": "#Arapandu không sợ, Paimon rất tốt bụng, giống như Nara {NICKNAME}, Nara Varuna vậy, là đồng đội của Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141715,
					"content": "Aranakula, Arabalika, Arakunti, cùng Arapandu, muốn sửa chữa Cỗ Máy Varuna, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141716,
					"content": "\"Bào Tử\" và \"Nấm Quỷ\" quá nhiều, không còn cách nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141717,
					"content": "Arapandu không có Ararakalari lợi hại như Arabalika, \"Nấm Quỷ\" vì cơn mưa bất thường nên càng hung tợn hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141718,
					"content": "Đợi đã, \"Ararakalari\"... lúc trước có nghe Arana nói từng dùng nó để chống lại Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141719,
					"content": "Ararakalari rất mạnh, có thể đuổi \"Nấm Quỷ\". Ararakalari của Arapandu rất yếu, không làm gì được \"Nấm Quỷ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141720,
					"content": "Cái gì? Ararakalari còn có tác dụng này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141721,
					"content": "Chắc là tên gọi chung của một loại năng lực nào đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#Nara {NICKNAME} thông minh hơn Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141723,
					"content": "Hứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141724,
					"content": "Aranara khác nhau, có thể sở hữu Ararakalari khác nhau. Nhưng tất cả Aranara đều có thể sử dụng năng lực đó từ cỏ cây ở Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141725,
					"content": "Ararakalari của Arabalika rất mạnh, không sợ \"Nấm Quỷ\" và Nara sắt to lớn tí nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141726,
					"content": "Nara sắt to lớn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141727,
					"content": "#Nara sắt lớn rất to lớn, giống như Nara {NICKNAME} vậy, có hai cánh tay, hai cái chân, nhưng chỉ có một con mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141728,
					"content": "À, ra là nói Thủ Vệ Di Tích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141729,
					"content": "Paimon thông minh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "Hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141731,
					"content": "A! Trên cái cây bên kia cũng có \"Nấm Quỷ\"... Arabalika nhất định có thể đánh bại chúng, nhưng Arapandu không làm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141732,
					"content": "#Nara {NICKNAME} cũng không sợ \"Nấm Quỷ\", tuy không dùng Ararakalari, nhưng cũng rất mạnh. Giống như gió mạnh cuốn bay lá thu cái vèo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141733,
					"content": "#Nếu cứ mặc kệ thì \"Bào Tử\" và \"Nấm Quỷ\" sẽ ngày càng nhiều hơn... Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
