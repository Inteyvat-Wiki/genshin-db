			"dialogs": [
				{
					"id": 730141001,
					"content": "Nơi này chính là \"nơi dừng chân\", nhìn ra được dấu vết có Aranara từng ở lại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141002,
					"content": "Nhìn Cỗ Máy Varuna từ đây, cảm giác lại càng đồ sộ hơn... trông áp lực thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141003,
					"content": "Paimon phải cẩn thận, đừng để bị cuốn vào nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141004
					]
				},
				{
					"id": 730141004,
					"content": "Không có chuyện đó đâu!... Chắc là... không đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141005,
					"content": "Chúng tôi hẹn trước, sau khi sửa chữa cành và lá của Cỗ Máy Varuna, sẽ tới \"nơi dừng chân\" họp mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141006
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141006,
					"content": "Sau đó cùng đuổi đám sâu mọt đang gặm nhấm Cỗ Máy Varuna, sửa chữa Cỗ Máy Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141007
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141007,
					"content": "Quay lại vấn đề nhé, \"cành\" và \"lá\" của Cỗ Máy Varuna là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141008,
					"content": "Cành và lá của Cỗ Máy Varuna phân tán khắp nơi ở Vana, có chúng, Cỗ Máy Varuna mới có sức mạnh biến mưa màu đen thành mưa tốt, cơn mưa có thể mang lại sự sinh sôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141009
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141009,
					"content": "Cũng như mưa tích thành suối, suối chảy ra hồ, cành và lá tập trung tất cả về Cỗ Máy Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141010
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141010,
					"content": "Hiện tại Cỗ Máy Varuna không giống lúc trước, cũng như cành gãy đã chặn mất dòng nước mưa, mưa không thể tụ thành suối. Không có suối, hồ nước cũng khô cạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141011
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141011,
					"content": "Ừm... Vẫn không hiểu lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141012,
						730141017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141012,
					"content": "Giống như Paimon không được ăn cơm vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141013
					]
				},
				{
					"id": 730141013,
					"content": "À, không ăn cơm sẽ không có sức làm việc! Nên hiện tại Cỗ Máy Varuna cũng vì đói bụng nên mới tức giận à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141014,
						730141016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141014,
					"content": "Tôi nghĩ chắc không phải vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141015
					]
				},
				{
					"id": 730141015,
					"content": "Nói cũng đúng, lúc đói bụng thì làm gì còn sức mà giận dỗi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141021,
					"content": "Tóm lại, bây giờ phải sửa xong \"cành\" và \"lá\" trước đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141022,
					"content": "#Đúng, Arapandu đưa Paimon và Nara {NICKNAME} đi cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141016,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				},
				{
					"id": 730141017,
					"content": "Cũng giống như trên đường vận chuyển có chướng ngại vật ngăn cản ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141018
					]
				},
				{
					"id": 730141018,
					"content": "Cần phải giải quyết tất cả chướng ngại vật thì mới có thể tiếp tục tiến bước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141019,
					"content": "Rõ ràng chỉ cần đổi sang đường khác là được rồi mà! Rốt cuộc là ai quy định tuyến đường này thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141020,
					"content": "Đúng đó, rốt cuộc là ai quy định tuyến đường này thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				}
