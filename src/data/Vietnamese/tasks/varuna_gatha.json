					"nextDialogs": [
						730141207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141207,
					"content": "Ừm... Phải để ba chiếc lá chuyển hướng về phía cành, nhưng sức lực của Arapandu lại không đủ, nguy rồi.",
					"roleType": "TALK_ROLE_NPC",
