			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Xin chào, tìm tôi có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780402,
					"content": "Anh có quen biết Alkami không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "Alkami? Là người giàu có đang nổi gần đây đúng không? Trước đây anh ấy đã tìm tôi để đặt nội thất, ra tay rất hào phóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780405,
					"content": "Nghe nói trước đây anh ấy là kiến trúc sư nổi tiếng, đã tích góp được khối tài sản hùng hậu. Bây giờ mở cơ sở giáo dục, chia sẻ con đường thành công của bản thân cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780406,
					"content": "Nếu không phải vì học phí quá mắc thì có lẽ tôi cũng báo danh cho con mình rồi. Làm kiến trúc sư kiếm nhiều tiền vậy cơ mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780403,
					"content": "Tôi muốn hỏi thăm về Alkami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
