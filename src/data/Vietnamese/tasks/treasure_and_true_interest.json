			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aabid",
					"Adil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "Nghe tin gì chưa? Alkami mời được Kaveh làm giảng viên cho cơ sở giáo dục đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780802,
					"content": "Ôi, lần này mối làm ăn của anh ta nhất định càng ngày càng tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780803,
					"content": "Ganh tị thật. Tên Alkami đó, hồi còn làm kiến trúc sư chỉ tạm được mà thôi, làm gì có năng lực làm giảng viên chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780804,
					"content": "Do anh ta giỏi quảng cáo thôi... Cộng thêm việc từng thi vào Giáo Viện, dù sao thì người có thể vào học kiến trúc ở Giáo Viện cũng ít mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780805,
					"content": "Những người không vào được Giáo Viện, và những người muốn học nghề \"nhanh\" thì đương nhiên đều đổ về cơ sở giáo dục của anh ấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780806,
					"content": "Đúng là biết cách làm ăn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aabid"
				}
			]
		},
