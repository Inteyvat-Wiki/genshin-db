			"dialogs": [
				{
					"id": 190785001,
					"content": "Thầy Kaveh nhìn có vẻ rất giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "Kệ thầy ấy đi. Không chừng là lo sau này chúng ta sẽ cướp mất miếng cơm manh áo của thầy ấy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "Đâu... đâu đến mức vậy nhỉ? Thầy Kaveh nổi tiếng như thế mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "Ai mà biết chứ? Cha mình nói người càng nổi tiếng càng thích làm mình làm mẩy, người giống thầy Alkami mới hiếm gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
