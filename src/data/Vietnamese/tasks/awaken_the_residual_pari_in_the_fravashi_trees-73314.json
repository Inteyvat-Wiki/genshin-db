			"dialogs": [
				{
					"id": 733140201,
					"content": "Không ngờ lại trở thành bộ dạng thế này... Thật đáng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140202
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140202,
					"content": "Ơ, Sorush đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140203,
					"content": "Không có gì, chẳng qua là nhìn thấy bộ dạng xấu xí của một số kẻ cùng tộc mà thôi, đừng quan tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140204,
					"content": "Hừm, nói như vậy lại càng đáng quan ngại hơn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140205,
					"content": "Để tôi xem... Ừm, bên đó có một cái cây kỳ lạ, co thành một vòng, cảm giác giống như là một cánh cửa vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140206,
						733140207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140206,
					"content": "Nếu như đi xuyên qua thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733140208
					]
				},
				{
					"id": 733140208,
					"content": "Nói như vậy thì tôi càng muốn thử đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140209,
					"content": "...Những cái Cây Fravashi này không phải là cánh cổng gì đâu. Nếu như mạo muội đi xuyên qua thì sẽ làm phiền các tàn dư Pari đang tá túc trong đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140210
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140210,
					"content": "Ồ, hóa ra đây gọi là Cây Fravashi sao? Nhưng cô nói tàn dư Pari là sao... rõ ràng là không thấy gì cả mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140211,
					"content": "Bóng Trắng Bay Bay thì đương nhiên là không nhìn thấy rồi. Dù gì những tàn dư Pari này vẫn đang ở trong chấp niệm của quá khứ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140212
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140212,
					"content": "Tuy nói rằng chưa chắc là điều mà bản thân mình muốn, nhưng bộ dạng cố chấp thế này, thật sự không nỡ nhìn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140213
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140213,
					"content": "Rõ ràng là nhìn rất sum suê mà, cảm thấy cũng rất thân thiện nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140214,
					"content": "Hừ, Bóng Trắng Bay Bay thì biết gì chứ. Những Cây Fravashi này là các Pari đã chiến đấu đến giờ phút cuối cùng với ô uế xâm nhập mặt đất, và dùng toàn bộ sức lực cuối cùng để hóa thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140215
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140215,
					"content": "Vì cạn kiệt sức lực mà không thể duy trì hình thái, và lại vì đã nhiễm phải ô uế nên bị Ốc Đảo Vourukasha cự tuyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140216
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140216,
					"content": "Tương truyền vào thời xưa, Hội Nghi Hoặc sẽ cử hành nghi thức rửa tội cho họ, để họ có thể trở về Ốc Đảo Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140217
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140217,
					"content": "Nhưng giờ đây Hội Nghi Hoặc đã không còn ai có thể chủ trì nghi thức như vậy nữa, cùng lắm thì chỉ có thể duy trì những Cây Fravashi này để không đến nỗi khô héo mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140218
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140218,
					"content": "Nhưng đây chẳng qua là kéo dài nỗi đau của họ thôi. Nhìn bộ dạng của họ giờ đây, chắc là ngoài việc phải một mình gánh chịu ký ức đau khổ ra, thì đã không còn lại gì nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140219,
						733140220
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140219,
					"content": "Xem ra nên giúp đỡ họ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733140221
					]
				},
				{
					"id": 733140221,
					"content": "Đúng đó, cái gì mà một mình chịu khổ chứ, nghe thấy tội quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140222,
					"content": "Tuy nói là vậy, nhưng đây cũng là vận mệnh của Pari, nói không chừng dùng cách này để bảo vệ mặt đất chính là nguyện vọng của họ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140223
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140223,
					"content": "Ừm, tuy đây là suy nghĩ của Sorush, nhưng không chừng họ nghĩ khác thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140224,
					"content": "Dù sao nếu là tôi, so với việc ở lại nơi như thế này thì tôi vẫn muốn được quay về với Ốc Đảo Vourukasha cùng mọi người hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140225,
					"content": "Bóng Trắng Bay Bay coi thường Pari bọn ta thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140226
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140226,
					"content": "Hừ, kệ vậy, ta sẽ dùng sức mạnh của mình thức tỉnh họ, để các người nghe thử tiếng nói của họ xem thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140220,
					"content": "Nói vậy là có cách giải cứu sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733140221
					]
				},
				{
					"id": 733140207,
					"content": "Không chừng sẽ đến được nơi nào đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733140208
					]
				}
			]
		},
