						733140313
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140313,
					"content": "Tuy nhìn có chút kỳ lạ, nhưng nói xấu xí thì hơi quá đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140314,
					"content": "Ở nơi đây có thể nhìn thấy thực vật um tùm như thế, nên cảm thấy rất thân quen mới đúng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140315,
					"content": "Hừ, ta chỉ cảm thấy thân quen với chiến trường kịch liệt thôi, cuộc chiến cho đến khi tận cùng của thời gian mới là vĩnh hằng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140316
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140316,
					"content": "Bóng Trắng Bay Bay nếu đã đi theo con đường của ta, thì cũng nên sớm hiểu ra đạo lý này mới phải chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140317
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140317,
					"content": "Những Cây Fravashi này là các Pari đã chiến đấu đến giờ phút cuối cùng với ô uế xâm nhập mặt đất, dùng toàn bộ sức lực cuối cùng để hóa thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140318
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140318,
					"content": "Vì cạn kiệt sức lực mà không thể duy trì hình thái, và lại vì đã nhiễm phải ô uế nên bị Ốc Đảo Vourukasha cự tuyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140319
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140319,
					"content": "Tương truyền vào thời xưa, Hội Nghi Hoặc sẽ cử hành nghi thức rửa tội cho họ, để họ có thể trở về Ốc Đảo Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140320
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140320,
					"content": "Nhưng giờ đây Hội Nghi Hoặc đã không còn ai có thể chủ trì nghi thức như vậy nữa, cùng lắm thì chỉ có thể duy trì những Cây Fravashi này để không đến nỗi khô héo mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140321
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140321,
					"content": "Nhưng đây chẳng qua là kéo dài nỗi đau của họ thôi. Nhìn bộ dạng của họ giờ đây, chắc là ngoài việc phải một mình gánh chịu ký ức đau khổ ra, thì đã không còn lại gì nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140322
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140322,
					"content": "Tuy rằng cũng xem như đã hoàn thành sứ mệnh của Pari, nhưng so với sự hy sinh chân chính thì chỉ có thể nói là một hành động vô nghĩa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140323,
						733140324
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140323,
					"content": "Xem ra nên giúp đỡ họ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733140325
					]
				},
				{
					"id": 733140325,
					"content": "Đúng đó, cái gì mà một mình chịu khổ chứ, nghe thấy tội quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140326,
					"content": "Tội? Bóng Trắng Bay Bay quả thật yếu đuối. Tuy nói rằng từ bi là đức hạnh cao quý mà đại nhân Simurgh cũng có, nhưng chỉ dựa vào nhân từ thì cũng không thể sinh tồn ở nơi này được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140327
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140327,
					"content": "Huống hồ gì đối với Pari mà nói, dùng hết sức lực để chiến đấu đến cùng vốn đã là nơi trở về tốt nhất rồi, đâu cần phải bày nhiều trò như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140328
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140328,
					"content": "Ừm, tuy đây là suy nghĩ của Sorush, nhưng không chừng họ nghĩ khác thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140329,
					"content": "Dù sao nếu là tôi, so với việc ở lại nơi như thế này thì tôi vẫn muốn được quay về với Ốc Đảo Vourukasha cùng mọi người hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733140330,
					"content": "Pari không bao giờ yếu đuối như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733140331
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140331,
					"content": "Hừ, nếu ngay cả Yasnapati của ta cũng đã nói thế, vậy thì ta sẽ dùng sức mạnh của mình thức tỉnh họ, để các người nghe thử tiếng nói của họ xem thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733140324,
					"content": "Nói vậy là có cách giải cứu sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733140325
					]
				},
				{
					"id": 733140307,
					"content": "Không chừng sẽ đến được nơi nào đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733140308
					]
				}
			]
		},
