			"dialogs": [
				{
					"id": 740640401,
					"content": "Đã tìm được Clynes rồi sao. Nhưng thủ phạm vẽ bậy... đã tìm được chưa? Hoặc nên nói là đã có manh mối gì chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640402
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640402,
					"content": "Chuyện này ấy à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640403,
						740640413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640403,
					"content": "Là do Clynes làm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640404
					]
				},
				{
					"id": 740640404,
					"content": "Tôi cũng đoán là thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640405
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640405,
					"content": "Haiz, những lý do để tôi lấp liếm cũng công cốc rồi. Giờ mấy người muốn làm gì tôi thì làm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640406
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640406,
					"content": "Luật là luật mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640407,
					"content": "So với việc trừng phạt anh, thì tôi muốn xóa dấu vết này hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640408
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640408,
					"content": "Anh có hứng thú với mật thư à? Để kể cái này thì hơi tốn thời gian chút, cứ ngồi xuống rồi tôi sẽ kể cho nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640409
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640409,
					"content": "Không, tôi không có hứng thú. Anh chỉ cần nói cho tôi biết cách xóa nó đi là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640410
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640410,
					"content": "Cái đó cũng dài dòng lắm, dù sao cũng cần dùng đến màu sơn và kỹ thuật đặc biệt mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640411,
					"content": "Tôi còn nhiều việc phải làm lắm, kể ngắn gọn chút thôi, năn nỉ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640412
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640412,
					"content": "#Cứ kệ bọn họ đi. {NICKNAME}, Paimon, đây là thù lao như đã hứa, cảm ơn đã giúp đỡ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640413,
					"content": "Cái này chuyên nghiệp quá rồi, mời Clynes đến xem vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640414
					]
				},
				{
					"id": 740640414,
					"content": "Clynes, đây là ký hiệu đặc biệt mà anh từng nhắc tới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640415
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640415,
					"content": "Để tôi xem nào... Hừm, cô có thấy nó giống bánh răng không? Bánh răng lớn như thế thì sẽ đến từ Viện Khoa Học Fontaine đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640416
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640416,
					"content": "Nó đến từ Viện Khoa Học Fontaine, anh cũng từ đó mà ra. Mối liên hệ rất rõ ràng. Anh khai thật đi, có phải do anh làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640417
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640417,
					"content": "Không thể nói như thế được! Nếu như ngày nào đó tôi may mắn được ăn cơm ở Khách Sạn Debord cùng với Galvana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640418
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640418,
					"content": "Nếu anh chưa tỉnh ngủ thì để tôi giúp. Còn nếu thấy nắm đấm của tôi quá nhẹ thì Roussimoff rất sẵn lòng giúp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640419
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640419,
					"content": "Đừng kích động, tôi chỉ nêu ví dụ thôi mà! Chỉ là nêu ví dụ thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640420
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640420,
					"content": "Nói đến đâu rồi nhỉ... Khụ, tóm lại, nếu tôi và Galvana cùng nhau ra ngoài, cùng xuất thân từ Pháo Đài Meropide, nhưng chưa chắc chúng tôi đã có liên quan với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640421
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640421,
					"content": "Đấy, thế thì đâu có liên quan gì đúng không? Tôi không liên quan với ký hiệu kia, giống như tôi và Galvana cũng không có liên quan gì với nhau vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640422
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640422,
					"content": "Được rồi, anh chỉ thuyết phục được tôi ở chỗ anh và chị tôi không có liên quan gì thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640423
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640423,
					"content": "Thế có khác gì chưa thuyết phục đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640424
					]
				},
				{
					"id": 740640424,
					"content": "Chúng tôi không còn gì để nói nữa, anh tùy cơ ứng biến nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640425,
					"content": "Dù sao đi nữa cũng rất cảm ơn. Thù lao mà tôi đã nói trước đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640426
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640426,
					"content": "#Đúng rồi! {NICKNAME}, Paimon, suýt nữa quên trả thù lao cho các vị. Dù tiếc là không tìm được thủ phạm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640427
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640427,
					"content": "Nhưng tôi tin Clynes sẽ có cách xóa đi ký hiệu này! Chuyện sau này giao cho Galvaryet và Clynes nhé, tôi còn phải làm việc khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
