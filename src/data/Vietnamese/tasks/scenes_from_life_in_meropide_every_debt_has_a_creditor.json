			"dialogs": [
				{
					"id": 740640101,
					"content": "Một là anh nghĩ cách xóa bỏ nó, hai là tìm xem rốt cuộc do ai làm ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640102
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640102,
					"content": "Cô nói nghe dễ quá nhỉ... Tôi đã thử hết các loại nước tẩy rửa rồi, không thể xóa được. Mạnh hơn nữa... thì chỉ có thể thử Khắc Tinh Ảo Linh Nước Đục thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640103
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640103,
					"content": "Khắc Tinh Ảo Linh Nước Đục? Anh muốn đục thủng tường để mọi người ngủ chung với cá à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640104,
					"content": "Vậy thì chỉ có thể tìm thủ phạm thôi. Nhưng bây giờ chúng ta không có chút manh mối nào hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640105
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640105,
					"content": "Sao thế? Chúng tôi có thể giúp được gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640106,
					"content": "Là thế này, nhìn hình trên tường đi. Pháo Đài Meropide có lệnh cấm vẽ bậy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640107
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640107,
					"content": "Chúng tôi đã thử hết mọi cách nhưng vẫn không thể xóa nó đi được. Nếu có thể tìm ra thủ phạm thì tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640108
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640108,
					"content": "Cũng không phải không có manh mối. Tôi có nghe Clynes nói là trong Viện Khoa Học Fontaine có một loại ký hiệu, cần dùng phương pháp đặc thù để giải mã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640109,
					"content": "Ý là ký hiệu này có thể là loại mà anh ta nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640110
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640110,
					"content": "Lúc đó tôi không có hứng thú nên cũng không hỏi thêm gì. Nếu anh ta ở đây thì chắc sẽ giải được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640111,
						740640113
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640111,
					"content": "Không chừng là do chính anh ta làm đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640112
					]
				},
				{
					"id": 740640112,
					"content": "Đúng là không loại trừ khả năng này. Nhưng nếu thật sự như vậy thì... haha, anh ta nên hiểu luật lệ ra sao mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640115,
					"content": "#{NICKNAME} và Paimon, hai người là nhà mạo hiểm giàu kinh nghiệm, liệu có cách gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640116
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640116,
					"content": "Giúp chúng tôi tìm thủ phạm, hoặc tìm Clynes để anh ta tới xem thử. Ừm... Cứ xem đây là ủy thác chính thức đi, chúng tôi sẽ trả Phiếu Đặc Cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640117
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640117,
					"content": "Được rồi. Nếu là ủy thác chính thức thì chúng tôi sẽ nghĩ cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640118,
					"content": "Cảm ơn. Chúng tôi cũng sẽ tiếp tục thử xem có thể tìm ra cách xóa ký hiệu đó không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640113,
					"content": "Thế thì đi tìm anh ta thử xem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640114
					]
				},
				{
					"id": 740640114,
					"content": "Không biết anh ta đang ở đâu... Hôm nay tôi còn chưa gặp anh ta nữa. Thật sự phải tìm anh ta sao? Mỗi lần nhờ là lòng tự ái của tôi lại chết đi một ít đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "Maupoil"
				}
			]
		},
