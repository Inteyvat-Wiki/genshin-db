					"Clynes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640301,
					"content": "Hả? Không phải Clynes đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640302,
						740640304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640302,
					"content": "Xin chào, Clynes, lại gặp mặt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640303
					]
				},
				{
					"id": 740640303,
					"content": "...Hửm? Clynes ở nơi này, vậy là ký hiệu kia thật sự là do anh để lại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640306,
					"content": "Hửm? Sao lại là hai người chứ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640307
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640307,
					"content": "Hai người nói gì thế? Tôi không hiểu gì cả, hay là đi hỏi người khác xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640308,
						740640310
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640308,
					"content": "Paimon, xem ra chúng ta tìm sai người rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640309
					]
				},
				{
					"id": 740640309,
					"content": "#Tìm sai người... Không đúng! {NICKNAME}, đừng để bị lừa. Trong này ngoài anh ta ra thì không còn ai khác cả. Nhất định là anh ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640312,
					"content": "Được rồi, hai người thắng, là tôi làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640313
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640313,
					"content": "Haiz, tôi còn tưởng có thể dựa vào cái này để tìm người quen ôn chuyện xưa... Không ngờ lại là hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640314
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640314,
					"content": "Dựa vào cái này để tìm người quen sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640315,
					"content": "Đúng vậy. Mật thư này là do ngài Butor tạo ra, và người biết cách giải mã trong Viện Khoa Học Fontaine cũng không nhiều lắm. Tôi cũng vì từng được chiếu cố nhiều nên mới biết được thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640316
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640316,
					"content": "Tiếc là ngài ấy mất sớm, loại mật thư cũng không được các quản lý xem trọng. Nên tôi nghĩ, nếu như vẫn còn người có thể giải được mật mã thì chúng tôi có thể tâm sự về chuyện quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640317
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640317,
					"content": "À, không phải là tôi không muốn nói chuyện với hai người, chỉ là giữa chúng ta thiếu một ít chủ đề chung thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640318,
						740640321
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640318,
					"content": "Đừng miễn cưỡng, đúng là không có gì để nói hết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640319
					]
				},
				{
					"id": 740640319,
					"content": "#{F#Cô}{M#Cậu} đúng là thật thà. Tôi từng có một người bạn, nói chuyện cũng thẳng thắng như vậy, cũng từng vì vậy mà gây ra không ít phiền toái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640320
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640320,
					"content": "Bây giờ nhớ lại, đó đúng là thời gian vui vẻ đáng nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640325,
					"content": "Quay về vấn đề chính, tìm tôi làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640326
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640326,
					"content": "Suýt nữa thì quên mất! Galvaryet và Maupoil nhờ chúng tôi điều tra thủ phạm vẽ bậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640327,
					"content": "Anh tự thú đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640328
					]
				},
				{
					"id": 740640328,
					"content": "Tự thú đi! Nếu chống cự lại lệnh bắt giữ thì chúng tôi sẽ không nương tay đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640329,
					"content": "Haiz... Không thể thương lượng à? Maupoil tạm thời không nhắc tới, nhưng tôi không muốn rơi vào tay Galvaryet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640330
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640330,
					"content": "Liệu hai người có thể bỏ qua chuyện này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640331
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640331,
					"content": "Nhưng Maupoil đã nói Pháo Đài Meropide cấm vẽ bậy rồi. Phạm luật là không tốt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640332,
					"content": "Nếu nhìn thoáng một chút, mật thư cũng không khác gì mấy chữ viết trên tường mà, đều là thứ để trang trí tô điểm thêm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640333
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640333,
					"content": "#Thế này đi, tôi sẽ quay về đó, nhưng có tố giác tôi hay không thì để {NICKNAME} quyết định vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640334
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640334,
					"content": "Đương nhiên, nếu giúp tôi thoát khỏi cảnh rơi vào tay Galvaryet, thì tôi sẽ báo đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640335
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640335,
					"content": "Tôi giao vận mệnh của mình cho hai người đấy, đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640321,
					"content": "Tôi xin lỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640322
					]
				},
				{
					"id": 740640322,
					"content": "#Hah! {F#Cô}{M#Cậu} nói thế thì tôi không biết phải trả lời thế nào luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640323
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640323,
					"content": "Tôi biết bây giờ nên nói mấy câu khách sáo như \"nghe hai người kể về trải nghiệm khi thám hiểm cũng không tệ\". Có điều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640324
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640324,
					"content": "Chuyện này thì tôi quyết định thành thật với bản thân mình. Tôi không muốn nghe những câu chuyện mới lạ ở bên ngoài, tôi chỉ muốn tìm người ôn lại chuyện xưa thôi. Nên người phải nói xin lỗi là tôi mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640310,
					"content": "Anh xem, ngoài anh ra thì còn ai không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640311
					]
				},
				{
					"id": 740640311,
					"content": "Đúng đó! Đừng có lừa chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640304,
					"content": "Khai thật đi, có phải anh làm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640305
					]
				},
				{
					"id": 740640305,
					"content": "Khai thật đi! Ký hiệu kia là do anh làm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "Paimon"
				}
			]
		},
