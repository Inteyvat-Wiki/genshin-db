			"dialogs": [
				{
					"id": 740640201,
					"content": "Bắt một con Hải Thú Bồng Bềnh tới để nó nhổ nước bọt lên thì có khả thi không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640202,
					"content": "Nghiêm túc đấy à? Dạo này áp lực của anh lớn quá sao? Tinh thần còn ổn không đấy? Công việc có phải quá tải rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640203,
					"content": "Tôi rất bình thường. Tôi chỉ muốn thấy Hải Thú Bồng Bềnh nhổ nước bọt thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640204,
					"content": "Anh... cứ nghỉ phép đi đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				}
			]
		},
		{
