			},
			"dialogs": [
				{
					"id": 747080101,
					"content": "#Xin chào, {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "Nghe cô Guillotin nói, gần đây hai người đang quản lý thủy cung. Tôi được cô ấy mời đến làm cố vấn về cá cho thủy cung đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "Hoan nghênh, hoan nghênh",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Tuyệt quá, có y tá trưởng Sigewinne ở đây thì không phải lo chúng bị bệnh nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Hihi, may nhờ hai người từng mời tôi chăm sóc trang viên động vật ở Phim Trường Vui Vẻ Chevalmarin, nên tôi cũng rút ra được vài bí quyết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "Chăm sóc bệnh nhân và những vị khách động vật ngoan ngoãn có rất nhiều nguyên tắc tương đồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "#Nhưng lần này, ngoài việc trưng bày những loài cá thông thường, tôi còn có vài kế hoạch \"trị liệu tĩnh dưỡng\", muốn bàn bạc với {NICKNAME} xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Cứ nói nhé, tôi rất sẵn lòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "Nghe sĩ quan Ceasth nói, gần đây có một số cá trở nên cực kỳ hung hăng, điên cuồng tấn công các sinh vật xung quanh, thậm chí cả thợ lặn và thuyền nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "Tôi đang nghĩ, liệu có thể đưa chúng đến thủy cung để chúng tĩnh dưỡng rồi bình tĩnh lại chút, ít nhất là tránh gây ra tổn thất lớn hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Sau đó, tôi sẽ tìm cách điều trị tính khí hung hăng đột nhiên xuất hiện của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "Như vậy, không chỉ giúp cá và vùng nước trở lại bình thường, mà còn có thể xem như thêm những diễn viên độc đáo cho thủy cung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "Nghe ra cũng là một cách hay đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "Tôi cũng ủng hộ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Vậy thì tôi sẽ cung cấp một số thông tin về khu vực xuất hiện của những con cá hung hăng ấy, rồi sau đó thì nhờ hai người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "Việc này giúp đỡ cho chúng tôi rất nhiều đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}