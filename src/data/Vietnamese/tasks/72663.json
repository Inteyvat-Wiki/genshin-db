			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "Mọi người đến rồi, xin lỗi lại gây thêm phiền phức cho mọi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630102,
					"content": "Sắc mặt của bạn có vẻ khá tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "Ha ha cảm ơn, tôi đã nghĩ thông rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630104,
					"content": "Có những thứ có lẽ không thể cưỡng cầu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630105,
					"content": "Tối nay có thể cùng tôi đi đến bờ biển không? Tôi có thứ muốn tặng mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630106,
					"content": "Ồ là kho báu gì đó của biển cả sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630107,
					"content": "Cứ đi là biết thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "Chính là nơi đây, năm xưa lần cuối cùng cha tôi ra biển chính là nơi này, cũng là buổi tối như vậy, sau đó tôi đã không còn gặp lại được ông ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630202,
					"content": "Rất nhớ ông ấy đúng không, nguyện vọng của tiểu thư Kujirai có phải là một lần gặp lại cha mình không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630203,
					"content": "Ha ha, quả thật tôi rất nhớ ông ấy, nhưng con dân của biển cả rồi cũng sẽ có ngày quay lại với biển cả thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630204,
					"content": "Nhưng nguyện vọng của tôi thực ra là muốn trở thành thợ câu xuất sắc hơn cha mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630205,
					"content": "Khi còn nhỏ, tôi luôn muốn ra biển cùng cha, nhưng ông ấy luôn bảo mẹ tôi dẫn tôi trở về, có lúc đưa anh trai nhà hàng xóm theo, cũng không chịu đưa tôi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630206,
					"content": "Ông ấy luôn nói \"Momiji à, đừng quanh quẩn bên bờ biển, hãy đi làm những thứ con gái nên làm\", \"Cầm tiền mua váy đầm đi, đừng cứ chạy lên thuyền.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630207,
					"content": "Tôi rất không phục, tại sao? Cái gì là thứ con gái nên làm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630208,
					"content": "Tôi có thể đi mua kẹo, đi hái hoa, trở thành công chúa nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630209,
					"content": "Nhưng tôi không thể đi mạo hiểm, đi ngao du ngoài biển lớn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630210,
					"content": "Tôi nhất định phải làm. Sau khi cha tôi mất, tôi đã làm nghề thợ câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630211,
					"content": "Vùng biển mà ông ấy không khám phá được, để tôi khám phá. Cá mà ông ấy không bắt được, để tôi bắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630212,
					"content": "Tôi kế thừa cách câu cá của Kujirai. Danh hiệu thợ câu của nhà Kujirai để tôi gầy dựng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630213,
					"content": "Cho dù \"Ánh Trăng Biển\" chỉ là truyền thuyết, tôi cũng sẽ không chùn bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630214,
					"content": "Ừm, cô sẽ thành công.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "Cảm ơn mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630216,
					"content": "Nếu như cá thần không có ở đây, vậy tôi sẽ cầu nguyện với biển cả. Tôi nghĩ, ông ấy sẽ nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630217,
					"content": "Mọi người có nguyện vọng gì không? Cùng viết tâm nguyện rồi bỏ vào Bình Trôi, sau đó dùng sức ném ra ngoài. Sẽ có ngày trở thành hiện thực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630218,
					"content": "Wow, có thể như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630219,
					"content": "Nhưng tôi có rất nhiều nguyện vọng, phải ghi cái nào đây... Thật đắn đo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630220,
					"content": "Khoảng thời gian này vất vả cho mọi người rồi. Tôi không biết phải cảm ơn mọi người như thế nào, đây là chút quà mọn, mong mọi người nhận lấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630221,
					"content": "Mọi người xem đó là cái gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630222,
					"content": "Một đàn cá thật lớn! Còn phát sáng nữa, bọn chúng có vẻ rất thích Bình Trôi của chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630223,
					"content": "Bọn chúng tập trung lại, có vẻ giống như ánh trăng lớn ở giữa biển vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630224,
					"content": "Cá... cá này là \"Cá Ánh Trăng\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630225,
					"content": "A! Tôi biết rồi... Tôi biết rồi! Thì ra là vậy, thì ra đây chính là Ánh Trăng Biển!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630226,
					"content": "Hả? Đây là Ánh Trăng Biển sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630227,
					"content": "Không sai, tôi không quên hình dáng của nó, ánh trăng lấp lánh này... \"Ánh Trăng Biển\" năm xưa, cũng là xuất hiện sau khi Jiawei thả Bình Trôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630228,
					"content": "Thảo nào nhiều năm như vậy, cũng không có ai bắt được \"Ánh Trăng Biển\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630229,
					"content": "Thì ra là do một đàn \"Cá Ánh Trăng\" tụ họp tạo nên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630230,
					"content": "Đàn \"Cá Ánh Trăng\" này... lại thích loại Bình Trôi bình thường như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630231,
					"content": "Ha ha, nói không chừng bọn chúng thích tâm nguyện mà con người bỏ vào trong bình trôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630232,
					"content": "Ha ha! Nếu đã vậy thì hãy xem Kujirai Momiji tôi câu hết bọn chúng lên đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630233,
					"content": "Chúng tôi nữa! Chúng tôi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630234,
					"content": "Nếu đã như vậy, xin cho phép tôi tặng các bạn chiếc cần câu này, đây là cần câu do nhà Kujirai thiết kế chuyên dùng để bắt Ánh Trăng Biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630235,
					"content": "Tuy không thể bày tỏ hết lòng cảm tạ của tôi với các bạn, nhưng cũng là chút tâm ý của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630236,
					"content": "Hãy dùng nó để câu hết tất cả Cá Ánh Trăng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		}
	]
}