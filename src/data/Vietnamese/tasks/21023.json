				{
					"id": 210230201,
					"content": "Cầu thang phải nhanh chóng sửa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230202,
					"content": "Bạn là chưởng quỹ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "Đúng vậy, bạn có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230204,
					"content": "Có một món đồ cho bạn, là người dưới lầu bảo tôi mang lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210230205,
					"content": "Ồ... Chắc là món đồ mà khách hàng đưa cho tôi... Zhen Qiang sao không tự mình mang lên chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230206,
					"content": "Anh ta nói còn phải nhận hàng? Haizz anh ta bảo lên lên xuống xuống mất thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230207,
					"content": "Bạn là khách phải không, quả là có lỗi khi để cầu thang bị hỏng đúng lúc này. Tôi đang nghĩ cách để sửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230208,
					"content": "Thật là phiền phức quá, còn bắt bạn mang đồ cho tôi. Đây là tiền thưởng cho bạn, hãy mau nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230209,
					"content": "Việc này vốn là của Zhen Qiang, anh ta dám sai bạn mang lên sao. Đây là tiền thưởng cho bạn, hãy mau nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230210,
					"content": "Tôi giờ phải nghĩ việc sửa cầu thang, bạn cứ đi lại thoải mái nhé, có chuyện gì thì đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
