				"points": []
			},
			"dialogs": [
				{
					"id": 742460101,
					"content": "Được rồi, linh kiện đèn tiêu mà quý khách đặt tôi làm xong cả rồi, đều được làm chống nước cẩn thận hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460102
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460102,
					"content": "Mỗi cái đều được bọc năm sáu lớp giấy dầu, có ngâm dưới nước bảy tám ngày cũng không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460103
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460103,
					"content": "Ông chủ vất vả rồi, tiền công tôi sẽ thanh toán đủ. Bây giờ không phải Tết Hải Đăng, mua những thứ này chắc là rất phiền phức nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460104,
					"content": "Ôi dào... Chuyện nhỏ thôi, đừng khách sáo thế. Làm ăn mà, cốt là phải giải quyết nhu cầu cấp thiết của khách hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460105
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460105,
					"content": "À phải rồi, chỗ trà mua lần trước uống được chứ? Hay xem thử Trà Tiên Trầm Ngọc vừa về đi? Mới sao xong đấy, toàn là hàng thượng hạng cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460106
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460106,
					"content": "Ừm, nếu giảm giá thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
