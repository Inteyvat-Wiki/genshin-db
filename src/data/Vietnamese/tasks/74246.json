				},
				{
					"id": 742460203,
					"content": "Ông chủ vất vả rồi, tiền công tôi sẽ thanh toán đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460204
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460204,
					"content": "Ôi dào... Quý khách đừng khách sáo thế. Làm ăn mà, cốt là phải giải quyết nhu cầu cấp thiết của khách hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460205
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460205,
					"content": "À phải rồi, chỗ trà mua lần trước uống được chứ? Hay xem thử Trà Tiên Trầm Ngọc vừa về đi? Mới sao xong đấy, toàn là hàng thượng hạng cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460206
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460206,
					"content": "Ừm, nếu giảm giá thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460207
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460207,
					"content": "Khoan đã! Neuvillette... Có giảm giá thì cũng phải suy nghĩ kỹ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742460208,
					"content": "Lần trước mua anh còn chưa uống hết đâu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742460209
					]
				},
				{
					"id": 742460209,
					"content": "#{NICKNAME}, Paimon? Thật trùng hợp, tôi đang nghĩ liệu hai người có đến Cảng Liyue đón Tết Hải Đăng không đấy. Chúc hai người Tết Hải Đăng vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460210
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460210,
					"content": "Neuvillette vừa mua linh kiện đèn tiêu sao? Còn đặc biệt nhờ chủ tiệm làm chống nước nữa, chẳng lẽ những chiếc đèn này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742460211,
					"content": "Đúng vậy. Tôi định tặng số đèn này cho các Melusine. Họ chưa từng thấy loại đèn này bao giờ, chắc sẽ thích lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460212
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460212,
					"content": "Tôi còn muốn mua thêm một ít đèn tiêu nữa để treo bên ngoài Palais Mermonia. Nhưng tôi đang phân vân, nếu chỉ mỗi Palais Mermonia treo đèn thì liệu có hơi thiếu công bằng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460213
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460213,
					"content": "Chắc tôi nên quay về Palais Mermonia nhờ các kiểm sát viên thực hiện một đợt mua sắm toàn diện, như vậy thì khắp Đại Sảnh Fontaine và Pháo Đài Meropide đều có thể treo đèn tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460214
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460214,
					"content": "Nếu để các kiểm sát viên xử lý việc mua sắm, thì chắc Tết Hải Đăng năm sau Đại Sảnh Fontaine mới treo được treo đèn tiêu của năm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460215
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460215,
					"content": "Hơn nữa, tốt nhất là đừng treo đèn tiêu trong Pháo Đài Meropide, thưa ngài thẩm phán tối cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460216
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460216,
					"content": "Trong Pháo Đài Meropide thì đèn tiêu không thể bay cao được, hơn nữa ước nguyện của tù nhân đa phần cũng không thể thực hiện được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460217
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460217,
					"content": "Anh biết mà, họ chẳng ước điều gì tốt đẹp cho đất nước hay người dân đâu. Chúng ta vẫn nên cố gắng giữ gìn hình tượng tốt đẹp của đèn tiêu thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460218
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460218,
					"content": "Còn những \"ước nguyện tốt đẹp\" có thể ước, thì tôi đã giúp người ước thả bay đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460219
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 742460219,
					"content": "Chà, Tết Hải Đăng thật náo nhiệt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742460220
					]
				},
				{
					"id": 742460220,
					"content": "À phải rồi, chúc mọi người Tết Hải Đăng vui vẻ nhé. Tôi không chúc riêng từng người nữa, mọi người nhận tấm chân tình này là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460221,
						742460222,
						742460223,
						742460224,
						742460225
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460221,
					"content": "Vẫn phải chúc từng người mới được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742460226
					]
				},
				{
					"id": 742460226,
					"content": "Này! Sao đến tôi lại phải thêm chữ \"cũng\" vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742460227,
					"content": "#Haha, anh Wriothesley, tiểu thư Sigewinne, {NICKNAME}, Paimon, tôi cũng chúc các vị đón Tết Hải Đăng vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460228
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460228,
					"content": "Xem ra lễ hội tuyệt vời này đã thu hút tất cả chúng ta đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460229
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460229,
					"content": "#Ồ, không khí thật náo nhiệt, tiếc là tôi không mua bao lì xì Tiền May Mắn, nếu không thì theo phong tục Liyue phải phát cho {NICKNAME} và Paimon mỗi người một cái mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460230
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460230,
					"content": "Đưa Mora trực tiếp cho tôi cũng được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742460231
					]
				},
				{
					"id": 742460231,
					"content": "Hahaha, được thôi! Lát nữa chúng ta cùng đi ăn một bữa thật ngon, để Paimon dẫn đường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460232
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460232,
					"content": "Thật hả? Hì hì, thế thì tôi phải chọn món thật kỹ mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742460233,
					"content": "Ngài Neuvillette cùng đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460234
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 742460234,
					"content": "Được, tôi rất sẵn lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460235
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460235,
					"content": "Ồ, tôi chợt nhận ra... Bộ trang phục đẹp đấy, mới may sao? Rất hợp với không khí lễ hội ở đây, cả vẻ mặt thư thái của anh nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460236
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460236,
					"content": "Họa tiết trang trí và cách may này... Ngài Neuvillette, tôi đoán không nhầm thì đây là tác phẩm của các Melusine phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460237
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 742460237,
					"content": "Hmm? Sigewinne nhìn ra được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742460238,
					"content": "Ừm, nhìn kiểu dáng bộ trang phục này, chắc là do Flo thiết kế, Laume cũng đóng góp không ít ý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460239
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 742460239,
					"content": "Tóm lại, đây là một bộ trang phục rất ngầu, rất hợp với ngài Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460240
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 742460240,
					"content": "Đúng vậy. Đây là món quà quý giá mà các Melusine đã tặng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460241
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460241,
					"content": "Neuvillette kể lại quá trình các Melusine tặng quà...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						742460242
					]
				},
				{
					"id": 742460242,
					"content": "Vậy là anh định dùng đèn tiêu để đáp lễ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460243
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460243,
					"content": "Đúng vậy. Đây là phép lịch sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460244
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460244,
					"content": "Thế thì chắc chắn các Melusine sẽ lại đáp lễ cho anh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460245
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 742460245,
					"content": "Đúng vậy. Tôi nghĩ họ cũng sẽ làm thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460246
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460246,
					"content": "Được thôi, quà cáp vốn là thứ tốt đẹp, nếu văn phòng của anh hết chỗ chứa thì có thể để ở chỗ tôi.",
					"roleType": "TALK_ROLE_NPC",
