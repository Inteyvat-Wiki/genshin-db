			"dialogs": [
				{
					"id": 751270101,
					"content": "#Ồ, {F#cô}{M#cậu} cũng đến đây để chụp ảnh phải không? Lúc trước cũng có khách du lịch nước ngoài đến và muốn chụp ảnh tại đây. Dù sao thì đảo nổi cũng là một khung cảnh rất đẹp mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270102,
					"content": "Tiếc là lúc trước không có máy ảnh, nên tôi đã nhờ thương nhân nước ngoài mua giúp một chiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270103,
					"content": "Thế nào, quý khách có muốn thử chụp một tấm không? Nhưng phải tự tay chụp đấy, tôi chụp không giỏi lắm đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270104,
					"content": "Kỳ lạ, sương mù trên biển...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "Sương mù trên biển? Quý khách nói gì vậy, nơi này gió rất lớn, làm gì có sương mù chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270106,
					"content": "Từ lúc sinh ra đến giờ, tôi chưa từng thấy sương mù trên biển bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270107,
					"content": "Quý khách không nhầm nơi này với địa điểm tràn ngập sương mù phía dưới Dãy Tezcatepetonco đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270108,
					"content": "Chắc vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "Hihi, theo tôi thấy thì... quý khách hơi căng thẳng quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270110,
					"content": "Đến Natlan du lịch thì phải thư giãn một chút mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				}
			]
		}
	]
