			"dialogs": [
				{
					"id": 706990101,
					"content": "Thật may mắn khi được mời tiền bối Kỵ Sĩ Danh Dự đến thử các trò chơi giải trí, cảm thấy yên tâm hơn nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990102,
					"content": "Nói thật, đây là lần đầu tiên tôi tham gia vào công việc phát triển kiểu này, hơi căng thẳng chút, cảm giác đầu óc thường xuyên quá tải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990103,
					"content": "Rõ ràng chỉ là lắp thêm vỏ ngoài cho một cỗ máy đã hoàn thiện thôi, vậy mà phải quan tâm đến thiết kế đủ thứ, điều chỉnh hàng đống tham số...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990104,
					"content": "Nếu phải giống như đội trưởng Albedo, chế tạo trang bị chuyên dụng từ con số không... thì không biết sẽ khó khăn đến mức nào đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990105,
					"content": "Thành phẩm hiện tại khá ổn định rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "Ối... cảm ơn... cảm ơn tiền bối Kỵ Sĩ Danh Dự đã khích lệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990108,
					"content": "Tôi, tôi sẽ cố gắng hết sức... phấn đấu để sau này có thể tự mình phát triển thêm nhiều thứ hữu ích cho tiểu đội du kích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990109,
					"content": "#Trước đó tôi đã thắng được vài con búp bê, tặng cho {F#cô}{M#cậu} này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990110,
					"content": "#Tôi cũng có một con giống vậy. Sau này, chỉ cần nhìn thấy búp bê này là tôi sẽ nhớ đến những lời động viên {F#cô}{M#cậu}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990106,
					"content": "Hãy tin vào bản thân, Mika sẽ không ngừng tiến bộ thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
