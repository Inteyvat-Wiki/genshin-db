			"dialogs": [
				{
					"id": 401720401,
					"content": "Hình ảnh mới xuất hiện rồi kìa! Đây là... một tấm bản đồ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720402,
					"content": "Bản đồ ư? Là của nơi nào thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720403
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720403,
					"content": "Chẳng lẽ là vị trí của Vùng Biển Lặng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720404,
					"content": "Vùng Biển Lặng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720405,
					"content": "Theo những gì tôi biết thì sau trận đại chiến năm đó, Vùng Biển Lặng đã trở thành vùng đất hoang vu. Hoặc có thể nói là chính vì trận đại chiến đó mà nơi đấy mới trở thành Vùng Biển Lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720406,
					"content": "Ma thú và những chiến binh hóa thành tro bụi bao trùm khắp chiến trường. Đôi khi có tiếng gào thét kinh hoàng phát ra từ nơi sâu thẳm, đôi khi những ngọn lửa quái dị bùng lên và át đi những tiếng gào thét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720407
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720407,
					"content": "Nơi đó ẩn chứa những mối nguy hiểm và bí mật chưa được biết đến. Trong hàng trăm năm, đây là nơi mà những nhà thám hiểm hàng đầu chứng tỏ bản thân. Thật không may, hầu hết họ đều đã bị chôn vùi ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720408,
					"content": "Cho đến khoảng hai ba mươi năm trước, có biến động kỳ lạ xuất hiện ở Vùng Biển Lặng. Một số người nói rằng họ nhìn thấy sinh vật khổng lồ giống như ngọn núi đen đang di chuyển trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720409
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720409,
					"content": "Nhưng không lâu sau, toàn bộ khu vực đều biến mất. Không ai biết chuyện gì đã xảy ra cả. Vùng đất xui xẻo trong truyền thuyết cứ thế mà biến mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720410,
					"content": "Toàn bộ khu vực đều biến mất á?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720411,
					"content": "Ừm, nếu tôi nhớ không nhầm thì nơi Vùng Biển Lặng biến mất, chính là nơi mà bản đồ này chỉ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720412,
					"content": "Vậy nơi đó ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720413
					]
				},
				{
					"id": 401720413,
					"content": "Phần cực tây của Natlan. Đó là vùng đất cách xa các bộ tộc. Trước đây, nó không phải là nơi tụ tập của dân thường. Phải đến khi Vùng Biển Lặng biến mất thì con người mới bắt đầu xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720414,
					"content": "Nhưng suy cho cùng thì bà Citlali đây cũng chưa từng đến đó. Những điều trên đều là do nghe được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720415
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720415,
					"content": "Con người là vậy đấy, càng lớn tuổi thì càng không muốn phiêu lưu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720416
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720416,
					"content": "Thật ra thì bà chỉ ngại đi xa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720417
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720417,
					"content": "Đợi đã, có phần tinh thần đang tập trung vào mảnh vỡ và tấm vải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720418
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720418,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720419
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720419,
					"content": "Ồ! Cơ thể của Leyla lại có động tĩnh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720420,
					"content": "Phản ứng lần này rất mạnh mẽ. Chẳng lẽ mục tiêu của Leyla là vị trí của Vùng Biển Lặng à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720421
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720421,
					"content": "Cháu cũng có cảm giác là ở gần đây có một linh hồn gần như hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720422,
					"content": "Ể, nghe hơi rợn người đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720423,
					"content": "Xem ra là cách này có hiệu quả đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720424
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720424,
					"content": "Vậy có phải là đã có thể đánh thức Leyla rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720425,
					"content": "Hôm nay thì chưa. Việc đưa tinh thần về lại cơ thể không đơn giản như đổ nước từ bình này sang bình khác đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720426
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720426,
					"content": "Tôi phải đi mượn một thanh kiếm dùng trong nghi lễ và chuẩn bị thêm một vài thứ khác. Chắc phải mất khoảng hai ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720427
					],
					"speakerTitle": "Citlali"
