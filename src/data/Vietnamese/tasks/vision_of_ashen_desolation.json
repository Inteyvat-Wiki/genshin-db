			"dialogs": [
				{
					"id": 401720101,
					"content": "Chào mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720102,
					"content": "Bà đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720103
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720103,
					"content": "Không có tin gì tốt đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720104,
					"content": "#Bà vừa liếc mắt là đã nhận ra ngay rồi. {NICKNAME} đã tập hợp rất nhiều phần tinh thần lang thang rồi. Cháu đã chọn lọc, nhưng đều không có đặc điểm của Leyla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720105,
					"content": "Nhìn bộ dạng của cháu là đủ biết rồi. Không sao, mò kim đáy bể vốn là chuyện rất khó mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720106,
					"content": "Tuy tình trạng của Leyla vẫn còn khá ổn, nhưng cứ tiếp tục như vậy cũng không phải là cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720107
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720107,
					"content": "Ngược lại thì phía bà có chút tiến triển. Cha mẹ của Leyla cho biết, dạo trước cậu ta có quen một người bạn, mỗi lần cùng nhau ra ngoài là tận vài ngày mới trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720108,
					"content": "Có lần họ lén đi theo, phát hiện Leyla và người bạn đó loay hoay làm gì đó trong doanh trại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720109,
					"content": "Họ có gặp được người đó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720110
					]
				},
				{
					"id": 401720110,
					"content": "Ừm, là một người đàn ông, tên Kokuchuu. Nhìn cách ăn mặc có vẻ như đến từ Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720111,
					"content": "Ngài Kokuchuu, dùng cái này là được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720112
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720112,
					"content": "Theo kiến thức học được trong sách cổ, thì phần lớn tình trạng dị ứng sẽ sử dụng cách miễn dịch giống vậy. Tôi nghĩ có thể áp dụng ngược lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720113
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720113,
					"content": "Anh là người đáng thương, hoàn toàn miễn dịch với tâm linh, nên chỉ có thể đắm mình vào trong món vật chất đầy linh tính này. Tôi gọi đây là liệu pháp dị ứng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720114
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720114,
					"content": "...Liệu có vấn đề gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720115
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720115,
					"content": "Anh là tên ngốc về mặt tinh thần, nên hậu quả của việc cưỡng chế dùng phép thuật chắc cũng tự mình hiểu rõ hơn tôi. Quyết định như thế nào là tùy thuộc vào anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720116
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720116,
					"content": "Được rồi... Nhưng tôi còn một câu hỏi, tại sao ngài lại muốn giúp tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720117
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720117,
					"content": "Dù sao thì kẻ như tôi vốn không có tiếng nói trong bộ tộc, nên cũng không có gì để báo đáp cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720118
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720118,
					"content": "Báo đáp? Hãy nhìn kỹ mặt tôi xem trên đó viết gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720119
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720119,
					"content": "Hả, viết gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720120
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720120,
					"content": "\"Tốt bụng thích giúp đỡ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720121
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720121,
					"content": "Chà! Không ngờ là một người Inazuma, mà còn vì muốn trị bệnh cho Leyla sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720122,
					"content": "Liệu pháp dị ứng à... Đúng là một ý tưởng lạ lùng. Có tác dụng thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720123
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720123,
					"content": "Nhìn bộ dạng bây giờ của Leyla thì chắc câu trả lời là không rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720124,
					"content": "Hmm, rất lâu trước đây, trong tộc đúng là từng có cách này. Nhưng tỷ lệ thành công rất thấp, lại quá mạo hiểm, nên dần dà đã bị cấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720125
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720125,
					"content": "Còn mục đích của tên Kokuchuu đó chắc cũng không đơn giản thế đâu. Sau khi Leyla xảy ra chuyện thì người này cũng biến mất luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720126
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720126,
					"content": "Tôi tới căn cứ theo địa chỉ mà cha mẹ Leyla đưa cho, ở đó sót lại phần tinh thần rõ ràng. Ngoài ra, tôi còn phát hiện thứ này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720127
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720127,
					"content": "Cái này là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720128
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720128,
					"content": "Là một mảnh vỡ... Có vẻ như là thuộc về vũ khí hay dụng cụ nghi lễ nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720129
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720129,
					"content": "Cháu cũng cảm nhận được đúng không? Tuy trông có vẻ khá cũ, nhưng trên đó vẫn còn sót lại phần linh tính rất mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720130
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720130,
					"content": "Chắc Leyla đã dùng thứ này làm vật trung gian. Như vậy có thể giải thích được là một người không nhạy cảm về tâm linh lại có thể thấu thị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720131
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720131,
					"content": "Chờ đã, tôi còn có một cảm giác rất quen thuộc... Nó dường như có liên quan đến Tên Cổ của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720132,
					"content": "Tên Cổ của Ororon sao? Chẳng lẽ là mảnh Tên Cổ à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720133,
					"content": "Không... Tôi cảm thấy nó có thể là do chủ nhân trước kia của Tên Cổ để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720134,
					"content": "Chẳng lẽ là di vật của Sanhaj sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720135
					]
				},
				{
					"id": 401720135,
					"content": "Lại thấy ngứa tay rồi đấy. Lần này dùng cái này để làm vật trung gian đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720136
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720136,
					"content": "#Vậy thì vẫn giống như lần trước nhỉ? {NICKNAME} dùng máy dệt tinh thần để dệt lại những hình ảnh mà Citlali nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720137,
					"content": "Không, lần này để Ororon đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720138
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720138,
					"content": "Tại sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720139
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720139,
					"content": "Đây là biện pháp an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720140
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720140,
					"content": "#Kiến thức tâm linh của cháu vững hơn {NICKNAME}. Nếu như đây là di vật của Sanhaj, nhỡ có chuyện gì ngoài ý muốn thì cháu cũng có thể đối phó tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720141
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720141,
					"content": "#Ồ... Thấy chưa Paimon, tôi đã bảo là bà rất quan tâm đến {NICKNAME} mà. Không đành để {M#cậu ấy}{F#cô ấy} đi mạo hiểm kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720142
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720142,
					"content": "Còn cháu trai như tôi đây thì có ra sao cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720143
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720143,
					"content": "Này! Cháu nói cái gì thế hả!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720144
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720144,
					"content": "Dạ xin lỗi bà. Cháu sẵn sàng rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720145
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720145,
					"content": "Vậy chúng ta bắt đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720149
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720146,
					"content": "Theo kế hoạch, Citlali dùng mảnh vỡ bí ẩn làm trung gian, bắt đầu lần thấu thị thứ hai.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401720147
					]
				},
				{
					"id": 401720149,
					"content": "Đây rồi! Hình ảnh lần này... có vẻ như là một cây cung bị gãy, và đang cháy trong lửa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720150,
					"content": "Mọi người nhìn xem, mảnh vỡ trong đó có phải trông hơi giống với mảnh này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720151
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720151,
					"content": "Đúng nhỉ! Hình như là từ vị trí thân cung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720152,
					"content": "Tôi có nhìn thấy chiếc cung giống thế này trong những cuộn vải dệt ở nhà bà Citlali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720153
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720153,
					"content": "...Đúng vậy, nó là vũ khí mà Sanhaj đã dùng khi chinh chiến ở Vùng Biển Lặng. Xem ra mảnh vỡ này thực sự là di vật của Sanhaj.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720154
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720154,
					"content": "#Không hổ danh là tiền bối Sanhaj... Mặc dù dao động tinh thần của di vật rất mạnh, nhưng vừa rồi không có nguy hiểm gì cả. Nếu như là {NICKNAME} thì chắc cũng sẽ ổn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720155
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720155,
					"content": "Quả nhiên là anh hùng! Những thứ còn lại vẫn có thể dùng để chữa trị cho hậu thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720156,
					"content": "Chỉ là chữa trị thôi sao? Tôi cứ cảm thấy tên Kokuchuu đó còn có mục đích khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720157
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720157,
					"content": "Để nghĩ xem, ban nãy chúng ta đã nhìn thấy hình dáng của cây cung hoàn chỉnh rồi... Chẳng lẽ Kokuchuu muốn tìm kiếm tung tích của những mảnh vỡ khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720158,
					"content": "Tuy là đồ của tiền bối Sanhaj, nhưng nó đã vỡ rồi. Cho dù tìm được đủ hết cũng không có tác dụng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720159
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720159,
					"content": "Hơn nữa, tại sao lại tìm một tên thiếu nhạy cảm tâm linh để làm việc này chứ? Như vậy thì có thể đạt được gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720160
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720160,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720161
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720161,
					"content": "Ấy? Cơ thể của Leyla hình như có phản ứng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720162,
					"content": "Để xem nào. Tôi cảm thấy có những phần tinh thần đang bám lấy mảnh vỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720163
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720163,
					"content": "Vậy có nghĩa hướng đi của bà là chính xác. Phần tinh thần phân tán của Leyla đang bị hút đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720164
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720164,
					"content": "Đã vậy thì phải thử lại lần nữa, dùng cơ thể của Leyla và mảnh vỡ này làm trung gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720165
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720165,
					"content": "Bà cố lên nhé. Cháu cũng sẽ cố gắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720166
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720166,
					"content": "Lần này để tôi điều khiển máy dệt tinh thần cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720167
					]
				},
				{
					"id": 401720167,
					"content": "#{F#Cô}{M#Cậu} cũng ngứa tay rồi hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720168
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720168,
					"content": "Mỗi người một lần, như vậy sẽ công bằng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720169,
					"content": "Tính an toàn cũng được kiểm tra rồi, chắc sẽ không có nguy hiểm gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720170
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720170,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720171
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720171,
					"content": "#Được rồi, nếu {NICKNAME} đã có ý này thì cứ làm vậy đi. Chuẩn bị sẵn sàng rồi thì nói với tôi một tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
