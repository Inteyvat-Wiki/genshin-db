						230041118
					]
				},
				{
					"id": 230041118,
					"content": "Không, không có đâu, những doanh trại tôi chọn đã cố tình tránh nơi có rắn tụ tập, để không gặp phải bất kỳ rắc rối nào...",
					"roleType": "TALK_ROLE_NPC",
