					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "Của Jori là màu đỏ, của Amum là màu xanh lá, của Gana là màu vàng, của Drak là màu xanh lam...",
					"roleType": "TALK_ROLE_NPC",
