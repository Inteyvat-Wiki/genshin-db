					"content": "Vậy cứ giao cho tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041115
					]
				},
				{
					"id": 230041115,
					"content": "Cảm ơn bạn nhiều nhé, nếu tôi phải tự quay lại tìm với đám nhóc này thì không biết chuyện gì sẽ xảy ra nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041116
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041116,
					"content": "Nếu chúng nó nổi hứng chui vào rừng chơi vài ngày, vậy thì tôi thê thảm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
