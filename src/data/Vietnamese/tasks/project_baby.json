					"nextDialogs": [
						230041214
					]
				},
				{
					"id": 230041214,
					"content": "Chắc chắn là trước khi tôi ra ngoài hái thảo dược đã bỏ quên đồ ăn ở doanh trại nào đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041215
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041215,
					"content": "Nhưng tôi cũng không tiện tự mình đi tìm, phải ở lại đây canh chừng mấy nhóc này, đề phòng chúng đói quá lẻn ra ngoài hù dọa người khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041216
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041216,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi đi một chuyến, mang đồ ăn từ doanh trại về đây được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041217,
						230041220,
						230041222
