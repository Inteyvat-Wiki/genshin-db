						230040805
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040805,
					"content": "Ờm... Xem ra tôi thật sự phải tính đến kế hoạch bán đồ ăn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
