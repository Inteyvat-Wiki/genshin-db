					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041202,
					"content": "Changsheng có lẽ không phải là \"thú cưng\" đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				},
				{
					"id": 230041204,
					"content": "Rắn cưng cũng có đồ ăn chuyên dụng sao? Không phải chúng thường hay ăn mấy loại như chuột sao...",
					"roleType": "TALK_ROLE_NPC",
