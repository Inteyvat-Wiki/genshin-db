				},
				{
					"id": 230042204,
					"content": "Nghe có vẻ rất dễ thương, hiệu quả trình diễn nhất định rất tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "Lúc mới bắt đầu đúng là rất tuyệt, nhưng chỉ cần đám rắn nhỏ há miệng, đám trẻ nhất định sẽ khóc thét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
