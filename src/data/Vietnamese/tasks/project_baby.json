				{
					"id": 230040601,
					"content": "Không sai! Chính là những thứ này! Cảm ơn các bạn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040602
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040602,
					"content": "Sao mấy thứ này lại không ở trong doanh trại, mà ở trên cái cây lớn bên cạnh chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040603,
					"content": "Ồ... Có lẽ đã bị chim nhỏ nhặt lên để làm thức ăn dự trữ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040604
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040604,
					"content": "Đồ ăn này thật sự được những động vật nhỏ yêu thích đến vậy sao? Tôi có nên đem bán không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040605
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040605,
					"content": "Khụ! Khoan nói những chuyện này đã, xin hãy nhận lấy thù lao này, cảm ơn các bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
