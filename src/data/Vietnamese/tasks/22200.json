						222000505
					]
				},
				{
					"id": 222000505,
					"content": "Hình như Thầy Mao của Vạn Dân Đường biết làm Cá Chép Đen Hấp, bạn có thể đi hỏi ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000506
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000506,
					"content": "Còn món Canh Trứng Hạt Sen, hình như Gui biết làm, anh ấy thường làm việc tại Nhà Thuốc Bubu ở Ngọc Kinh Đài, bạn có thể đến hỏi anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000507
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000507,
					"content": "Tôi nghe những thương nhân đến từ Mondstadt nói rằng, quán ăn Người Săn Hươu thành Mondstadt có món Bánh Xốp rất ngon, mà nghe có vẻ rất dễ no bụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000508
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000508,
