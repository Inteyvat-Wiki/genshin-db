				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "Xin chào, có gì ọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "Ối, bụng lại kêu rồi. Ý của tôi là, tôi có thể giúp gì cho bạn ọc ọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "Hả, bạn nói gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "Haiz, mỗi khi tôi bị đói bụng đều như vậy, âm thanh lớn đến nỗi ngay cả giọng nói của tôi cũng bị lấn át.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "Mặc dù... ọc ọc... đã đi đến nhà thuốc Bubu khám rồi, nhưng thầy thuốc nói rằng tôi chỉ là bị đói bụng thôi, không phải bệnh, cho nên không có cách chữa trị ọc ọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "Thầy thuốc nói chỉ cần tôi ăn no là ổn thôi, nhưng mà tôi... sức ăn của tôi lớn hơn những người khác ọc ọc, nếu tôi cứ ăn cho đến khi no bụng thì túi tiền cũng cạn mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi nói với tôi rằng, nếu bữa chính ăn chưa no, thì sau bữa ăn hãy ăn thêm chút gì lót dạ, ít nhất cũng không được để ảnh hưởng đến công việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "Nhưng việc lót dạ này... có rất nhiều món tôi muốn ăn, mà tôi lại không biết món gì có thể dễ dàng lấp đầy dạ dày của mình nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "Nhà Lữ Hành, bạn thường đi lại bên ngoài, chắc chắn sẽ biết được ăn gì dễ dàng lấp đầy dạ dày nhất, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "Hay là bạn giúp tôi chọn ra món nào ăn vừa ngon lại vừa có thể lấp đầy dạ dày trong số những món ăn mà tôi thích đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "Lần này bạn muốn ăn gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Tôi muốn ăn nhiều thứ lắm... tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
