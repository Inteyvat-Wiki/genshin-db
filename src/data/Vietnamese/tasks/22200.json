				{
					"id": 222000301,
					"content": "Bạn tìm thấy món ăn nào dễ dàng lấp đầy dạ dày rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000302,
						222000304
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000302,
					"content": "Làm xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000303
					]
				},
				{
					"id": 222000303,
					"content": "Tốt quá, để tôi thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000304,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000305
					]
				},
				{
					"id": 222000305,
					"content": "Phải rồi, nếu là Bánh Người Cá thì có bán ở Vạn Dân Đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000307
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000307,
					"content": "Ừm, tôi nghe những thương nhân đến từ Mondstadt nói rằng, quán ăn Người Săn Hươu có một món Súp Hải Sản Hoa Calla Lily, hương vị chắc là rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000308
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000308,
					"content": "Còn có Cá Nướng Mondstadt và Gà Nấu Hoa Ngọt, cách làm hai món này có lẽ rất đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000309
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000309,
					"content": "Ọc ọc... ôi, chỉ đọc tên món ăn lại thêm đói ọc ọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
