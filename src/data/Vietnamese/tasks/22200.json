			"dialogs": [
				{
					"id": 222000201,
					"content": "Ừm, tôi nghe nói, một số món ăn của Mondstadt có hương vị rất tuyệt, ví dụ như Gà Nấu Hoa Ngọt, Cá Nướng Mondstadt, Bánh Người Cá, còn có Súp Hải Sản Hoa Calla Lily ọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000202,
					"content": "Làm ơn hãy mang cho tôi món ăn mà bạn cho rằng dễ dàng lấp đầy dạ dày nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000203,
					"content": "Ăn xong thì ít nhất hôm nay bụng sẽ không kêu nữa ọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
