			"dialogs": [
				{
					"id": 3600101,
					"content": "Hừ, chuyện nhỏ như con thỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600102,
					"content": "Nhưng mà không ngờ, hóa ra bạn cũng không phải người không có chút khả năng chiến đấu nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600103,
					"content": "Cám ơn sự trợ giúp lúc nãy của bạn, cảm thấy trận chiến này thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600104,
						3600105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600104,
					"content": "Nhẹ nhàng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				},
				{
					"id": 3600106,
					"content": "Nhưng mà, Hilichurl tại sao lại xuất hiện ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600107,
					"content": "Loại sinh vật này, thường sẽ không lập doanh trại ở gần thành phố như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600108,
					"content": "Đúng vậy. Chúng nó vốn dĩ chỉ đi lang thang ngoài thành mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600109,
					"content": "Nhưng gần đây Phong Ma Long thường xuất hiện, hoa màu bị hủy hoại, việc buôn bán cũng bị ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600110,
					"content": "Khi xuất hiện bão lại thường có người bị thương... cho nên Đội Kỵ Sĩ phải chia ra phòng vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600111,
					"content": "Cho nên phạm vi hoạt động của những sinh vật phiền phức này cũng càng lúc càng gần?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3600112,
					"content": "Đúng vậy. Nhưng hôm nay thanh lý được một doanh trại, cũng có thu hoạch rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600113,
					"content": "Hãy đi theo tôi! Người Kỵ Sĩ chăm chỉ có trách nhiệm sẽ hộ tống bạn vào thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3600105,
					"content": "Miễn cưỡng.",
