			"dialogs": [
				{
					"id": 701120101,
					"content": "Đúng rồi, Dexter, hiện tại khác với quá khứ, cũng nên kết thúc tuổi thơ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
