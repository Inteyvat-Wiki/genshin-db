			"dialogs": [
				{
					"id": 413320301,
					"content": "Sao món ăn của \"Vạn Dân Đường\" chưa đưa tới vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320302,
					"content": "Thức ăn của bạn đến rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "À! Cảm ơn bạn, tôi còn tưởng lát nữa mới giao đến chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320304,
					"content": "Không khí của Tết Hải Đăng ở Liyue làm tôi cũng nhớ nhà, nhưng...tạm thời tôi không thể về Inazuma được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320305,
					"content": "Không biết bây giờ tình hình ở Inazuma như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atsuko"
				}
			]
		},
