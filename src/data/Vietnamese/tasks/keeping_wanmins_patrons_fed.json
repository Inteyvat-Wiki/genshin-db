					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320323
					]
				},
				{
					"id": 413320323,
					"content": "Cuối cùng cũng đến, tôi đợi lâu lắm rồi... Có điều lễ tết bận rộn vẫn giao thức ăn cho tôi, thật phiền cho bạn quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320324
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320324,
					"content": "Không khí của Tết Hải Đăng ở Liyue làm tôi cũng nhớ nhà, nhưng...tạm thời tôi không thể về Inazuma được.",
					"roleType": "TALK_ROLE_NPC",
