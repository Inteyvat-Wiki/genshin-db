			"dialogs": [
				{
					"id": 413321401,
					"content": "Thức ăn giao đến rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413321402,
					"content": "Giao đến rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "Tốt rồi, nhờ bạn đúng là không sai, hỏi được món Wang Banzi, Guanhai và Zhihua muốn ăn chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413321404,
					"content": "Wang Banzi và Li Cầm Búa muốn ăn Măng Chua Tươi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "Ồ? Khẩu vị giống nhau à, nhưng làm món măng chua tươi mất rất nhiều thời gian, tôi phải chuẩn bị sớm một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413321407,
					"content": "Guanhai muốn ăn Cá Đuôi Sóc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "Không thành vấn đề, món tủ của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413321409,
