			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thầy Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "Còn vài phần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320202,
					"content": "Đang bận gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "Haha, tôi còn có gì để bận chứ, đương nhiên là chuyện làm ăn của Vạn Dân Đường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320204,
					"content": "Dạo gần đây đúng dịp Tết Hải Đăng, rất nhiều người đến ăn uống, còn có cả khách nước ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320205,
					"content": "Tuy con gái tôi Xiangling cũng về phụ giúp, nhưng con bé cũng rất bận, nhìn xem, lại mới ra ngoài giao thức ăn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320206,
					"content": "Người khác đã treo đèn tiêu đón tết từ lâu rồi, vậy mà Vạn Dân Đường chúng tôi bận đến nỗi không có cả thời gian làm đèn tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320207,
					"content": "Đúng rồi Nhà Lữ Hành, bạn có thể giúp tôi một việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320208,
					"content": "Bạn có biết Atsuko không? Là cô gái ở bến tàu, đến từ Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320209,
					"content": "Cô ấy đặt thức ăn chỗ chúng tôi, hãy giúp tôi giao đến đó, ngày tết nên tôi đặc biệt làm cho cô ấy một phần to hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320210,
					"content": "Còn một vài người bận việc ở bến tàu, <color=#00E1FFFF>Wang Banzi, Li Cầm Búa, Guanhai, Zhihua... </color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320211,
					"content": "Những người này thường ngày luôn đến ủng hộ công việc kinh doanh của cửa hàng chúng tôi, ngày tết họ vẫn trực ở bến tàu, chắc là vì công việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320212,
					"content": "Tôi cũng muốn làm cho họ chút đồ ăn, xem như ăn tết. Nhưng việc trong tiệm bận quá, tôi thật sự không đi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320213,
					"content": "Nhà Lữ Hành, tiện thể hãy giúp tôi hỏi họ muốn ăn gì, như vậy tôi sẽ dễ chuẩn bị thức ăn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 413320214,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "Vậy phiền bạn rồi, sau khi hỏi được thì quay về báo cho tôi biết nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thầy Mao"
				}
			]
		},
