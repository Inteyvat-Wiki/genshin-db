			"dialogs": [
				{
					"id": 191431001,
					"content": "Làm sao đây? Chẳng lẽ hôm nay không thể chơi \"Thất Thánh Triệu Hồi\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431002,
					"content": "Hay là đổi chỗ? Nhưng ngoài gầm cầu ra, còn chỗ nào mà đại nhân không dễ phát hiện đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431003,
					"content": "A a... Chúng ta cứ nhờ chị Yoimiya đốt pháo hoa, xua mọi người ra khỏi chỗ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431004,
					"content": "Làm thế không tốt lắm đâu? Mặc dù đúng là anh ta đã đuổi chúng ta ra ngoài trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431005,
					"content": "Cho nên tất cả là lỗi của anh ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431006,
					"content": "Tôi thấy... Có phải chúng ta, nên về nhà làm bài tập rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "Yuma"
				},
				{
					"id": 191431007,
					"content": "Nếu cứ đánh bài bỏ bê việc học, liệu tương lai có trở thành <color=#00E1FFFF>vị đại nhân ở dưới gầm cầu nào đó</color> không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuma"
