			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "Hoan nghênh ghé thăm, hai vị muốn uống gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220102,
					"content": "Ừm... Nhìn trang phục của các bạn, hình như không phải là người địa phương thì phải? Không biết trà chỗ tôi có vừa miệng hai vị không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220103,
					"content": "Tôi sẽ pha một bình Vân Lai Bạch Hào cho bạn nhé, nếu các bạn không quen thì lần sau cứ ghé lại, tới lúc đó tôi sẽ mời các bạn nếm thử những thức uống đặc sắc tôi mua được ở Lễ Hội Rượu tại Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220104,
					"content": "Cảm ơn nhé, nhưng chúng tôi không phải khách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "Đúng thế, chúng tôi là những nhân viên đáng tin cậy! Nghe nói cô đăng bài ủy thác ở Lễ Hội Rượu, muốn mời người thạo nghề đặt mua đồ uống giúp cô, nên chúng tôi tìm đến rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220107,
					"content": "Cô muốn đặt mua đồ uống gì thì cứ nói với chúng tôi nhé. Chúng tôi sẽ đặt giúp cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220108,
					"content": "Vì đặt hàng giúp khách... mà chạy tới tận Liyue sao? Các bạn đúng là nhiệt tình mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220109,
					"content": "Tôi còn sợ không ai chịu nhận ủy thác phiền phức như thế... vậy thì làm phiền các bạn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220110,
					"content": "Tôi nghe các thủy thủ từng tới Mondstadt nói, <color=#00E1FFFF>Quán Rượu Đuôi Mèo</color> có món \"Mâm Xôi Bạc Hà\" vừa đã khát lại còn có tác dụng an thần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220111,
					"content": "Nên tôi muốn đặt mua <color=#00E1FFFF>65 thùng \"Mâm Xôi Bạc Hà\"</color>, để bán xen kẽ với những loại thức uống khác cho các thủy thủ. Vậy thì họ sẽ có thể giữ tâm trạng tốt và bảo đảm hiệu suất làm việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220112,
					"content": "Trước kia thương nhân Mondstadt cũng sẽ dựa vào nhu cầu của tôi để chỉ định những thứ ngang giá. Lần này tôi sẽ làm theo quy định của Lễ Hội Rượu, gom sẵn một ít \"Pha Lê Fairbrew\", giao hết cho các bạn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220113,
					"content": "Tiền mua đồ của tôi ước chừng nhiêu đây, phần còn lại là tiền phí gửi cho các bạn, tuy bấy nhiêu không đủ để bày tỏ lòng biết ơn của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220114,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#Yên tâm đi, 65 thùng \"Mâm Xôi Bạc Hà\" đúng không! Chuyện đặt hàng cứ giao cho tôi và {NICKNAME} là được rồi, chúng tôi là chuyên gia mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220117,
					"content": "Chúng tôi đi một vòng rồi quay lại sau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220115,
					"content": "Chuyện nhỏ ấy mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "Chúng tôi là người chạy việc hỗ trợ mua thức uống.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
