			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "Chào mừng đến \"Quán Rượu Đuôi Mèo\"! Hai vị muốn mua gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220202,
					"content": "Xin chào, tiểu thư Diane, chúng tôi mang một mối làm ăn tới cho cô đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220203,
					"content": "Nói nhu cầu mua sắm của Quqing cho Diane nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "Ồ? Quán nhỏ mới mở ở phía bắc bến cảng Liyue ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220205,
					"content": "Thủy thủ cảng Dornman có nhắc tới người chủ quán kia, hình như bà chủ Margaret cũng từng mua nguyên vật liệu ở chỗ cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220206,
					"content": "Gần đây tiểu thư Quqing đang bán thức uống giải khát cho các thủy thủ, cũng nhờ các thủy thủ tuyên truyền về nước suối ở Khinh Sách Trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220207,
					"content": "Cô ấy lấy nước Khinh Sách Trang với giá cao, bán lại cho nơi có nhu cầu, chỉ kiếm chút tiền công thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220208,
					"content": "Nhờ cô ấy ở giữa làm cầu nối mà người bên ngoài có thể dùng nước suối của Khinh Sách Trang ủ ra loại rượu có hương vị đặc biệt, người già ở Khinh Sách Trang cũng có nguồn thu nhập ổn định, có thể nói là nhất cử lưỡng tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220209,
					"content": "Hóa ra còn có chuyện này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "Hóa ra tiểu thư Quqing là người tốt như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220211,
					"content": "Ừm, có lẽ sau này Quán Rượu Đuôi Mèo sẽ hợp tác lâu dài với cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220212,
					"content": "Được rồi, quay lại chuyện chính nào, các bạn muốn bỏ ra bao nhiêu tiền để mua nhiều \"Mâm Xôi Bạc Hà\" như thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052203,
			"completionStepIds": [
				7052203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
