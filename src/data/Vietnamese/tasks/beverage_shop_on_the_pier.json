					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "Tiểu thư Quqing, chúng tôi trở về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220302,
					"content": "Thức uống cô cần đã mua được rồi, ngày mai sẽ có thuyền đưa tới bến cảng này! Cô nhận lấy tờ biên lai này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220303,
					"content": "Bàn xong rồi sao? Hiệu suất làm việc của các bạn cao thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220304,
					"content": "Tôi, tôi sẽ dùng nước suối ngon nhất để pha một bình trà cho các bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220305,
					"content": "Đừng khách sáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "Đúng vậy, chúng tôi phải đi đặt hàng giúp những người khác nữa, cô không cần tốn công chiêu đãi chúng tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220308,
					"content": "Chúc cô mua may bán đắt! Lần sau chúng tôi sẽ tới chỗ cô thử loại thức uống mới nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220309,
					"content": "Vậy lần sau tôi nhất định sẽ chuẩn bị thức uống mà các bạn thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220310,
					"content": "Nhất định phải ghé đây chơi thường xuyên nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220306,
					"content": "Chúng tôi cũng nhận thù lao rồi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052202",
							"2"
						],
						"stepId": 7052202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "Chuyện đặt hàng xin làm phiền các bạn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220402,
					"content": "Với số nước uống đặc biệt này, nhóm thủy thủ có thể thay đổi khẩu vị lại giải khát giảm bớt mệt mỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220403,
					"content": "Khẩu vị?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "Sở thích của các thủy thủ khác nhau, có người thích trà nhạt, có người lại ưa nước trái cây chua chua ngọt ngọt... Nếu cứ uống một loại đồ uống, qua thời gian dài cũng sẽ ngán thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220405,
