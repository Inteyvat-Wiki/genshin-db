			"dialogs": [
				{
					"id": 102030101,
					"content": "Phù... đứa trẻ Klee này, thực ra là \"Kỵ Sĩ Tia Lửa\" của Đội Kỵ Sĩ Tây Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030102,
					"content": "Cái gì? Cả Klee cũng là kỵ sĩ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030103,
					"content": "Vậy, có thể cho Paimon cũng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "Đúng vậy! Paimon không cam tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030106,
					"content": "Lại nói, danh hiệu là Kỵ Sĩ Tia Lửa, chẳng trách bảo vật của Klee đều là mấy thứ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030107,
					"content": "Ừm, mặc dù thường ngày đem đến không ít rắc rối cho đội kỵ sĩ, nhưng các kỵ sĩ vẫn rất quan tâm cô bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030108,
					"content": "Nói về lai lịch của cô bé, thật sự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030109,
					"content": "Tóm lại, sau này bạn sẽ hiểu cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030110,
					"content": "#Về sau hãy chăm sóc cô ấy nhé, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030104,
					"content": "Mà so với \"Kỵ Sĩ Danh Dự\" nghe có vẻ ngầu hơn?",
					"roleType": "TALK_ROLE_PLAYER",
