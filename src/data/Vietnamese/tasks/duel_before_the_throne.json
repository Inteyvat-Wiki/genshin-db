				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "Một tên lại một tên, chạy vào đây như lũ chuột mất nhà thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190102,
					"content": "Nếu không nói ta biết đây là Thiên Thủ Các thì ta còn nghĩ đây là cái chợ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190103,
					"content": "Lần này biết thân biết phận rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190104,
					"content": "Ối, Kujou Sara đã bị \"Signora\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190105,
					"content": "Lỗi lầm của con dân Inazuma sẽ do chính tay ta trừng trị, ngươi không đủ tư cách đâu Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20190106,
					"content": "...Vậy thì xin thứ lỗi, đại nhân Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190107,
					"content": "Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "Được rồi được rồi, có nhớ ta quá thì cũng đừng luôn miệng gọi tên ta thế chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190109,
					"content": "Ta biết các ngươi ghi thù ta mà... lũ thiêu thân lảng vảng. Ta không hề thấy bất ngờ khi gặp các ngươi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190110,
					"content": "Ngươi lén lút sản xuất Delusion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "Gấp gáp vạch tội của ta trước mặt Shogun vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190113,
					"content": "Hahaha, ta chẳng qua chỉ là một sứ giả của Snezhnaya, việc mà các ngươi nói, ta hoàn toàn không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190114,
					"content": "Ả ta không coi chúng ta ra gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190115,
					"content": "Những người dân mất đi Vision...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "Đừng kể chuyện của những người mà ta không quan tâm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190118,
					"content": "Ta còn chẳng biết họ là ai, có thể chỉ là những viên gạch lót đường cho lý tưởng \"vĩnh hằng\" chăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190119,
					"content": "Đối với những sinh mạng nhỏ bé đó mà nói, đây chẳng phải là một vinh dự to lớn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190120,
					"content": "Đại nhân Shogun, tôi nói đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20190122,
					"content": "Còn có Gnosis của Venti nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "Lại nhắc chuyện cũ nữa rồi, thù dai thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190125,
					"content": "Lý tưởng của nữ hoàng Snezhnaya, chính là thứ thanh cao thuần khiết nhất trên thế gian này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190126,
					"content": "Hơn nữa, những thứ mà ngươi nói... chẳng qua chỉ là vật hy sinh cần thiết mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190127,
					"content": "Đến lúc tính sổ món nợ này rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "Hở, tính sổ? Hahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190129,
					"content": "Ta cũng cảm thấy chán bản mặt của ngươi rồi. Nhưng ta không ngờ rằng ngươi cũng là loại người hữu dũng vô mưu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190130,
					"content": "Ngươi có ý thức được ngươi vẫn đang là tội phạm của Inazuma không? Lo cho hoàn cảnh của ngươi trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190131,
					"content": "Xông vào Thiên Thủ Các, làm loạn trước ngự tiền, còn không phải tự mình sa lưới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190132,
					"content": "Hy vọng ngươi hiểu được khoảng cách giữa ta với ngươi, xét cả về mặt địa vị... lẫn thực lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190133,
					"content": "Ta phải...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "Phát động \"Ngự tiền quyết đấu\" với ngươi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190136,
					"content": "Hừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20190137,
					"content": "Quả nhiên, còn có trò này sao... ngươi cũng khéo lợi dụng \"quy tắc\" của quốc gia này đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190138,
					"content": "Có thể miễn cưỡng kéo được ta đến đối mặt với ngươi, ta khá bất ngờ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190139,
					"content": "Kẻ thất bại... sẽ phải chết! Ngươi nghĩ kỹ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190141,
					"content": "Hahaha... vậy thì để ta cùng nhảy một điệu với ngươi, cho đến khi... ta hoặc là ngươi sẽ phải chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190123,
					"content": "Còn dám đẩy người dân Liyue vào hiểm cảnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "Những chiến hữu đã ngã xuống vì Delusion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "Âm mưu một tay khống chế Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
