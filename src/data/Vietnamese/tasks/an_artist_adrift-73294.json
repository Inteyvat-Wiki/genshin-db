				"points": []
			},
			"dialogs": [
				{
					"id": 732941001,
					"content": "Kỳ lạ thật, nơi này sao lại có chó nhỉ? Hơn nữa còn giống như đang canh giữ thứ gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941002,
					"content": "(Cảnh giác nhìn bạn.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "Chó"
				},
				{
					"id": 732941003,
					"content": "Nhìn có vẻ thông minh đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "(Sủa một tiếng.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Chó"
				},
				{
					"id": 732941007,
					"content": "Đúng rồi, ban nãy có thấy đĩa thức ăn ở lều của Julien nhỉ? Có khi nào là của nó không! Lạ thật, tại sao Julien lại nói mình không có thú cưng đồng hành nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941008,
					"content": "Gâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "Chó"
				},
				{
					"id": 732941009,
					"content": "Chú chó chạy về hướng lều trại...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "Nó chạy mất rồi... lát nữa chúng ta hỏi Julien thử. Nhưng bây giờ... không biết dưới đống cát này đã chôn thứ gì đây. Chúng ta kiểm tra thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941005,
					"content": "Chó hoang từ đâu đến vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "(Khẽ gầm gừ.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Chó"
				}
			]
		},
		{
			"id": 7329412,
			"completionStepIds": [
				7329412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329412",
							"2"
						],
						"stepId": 7329412,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
