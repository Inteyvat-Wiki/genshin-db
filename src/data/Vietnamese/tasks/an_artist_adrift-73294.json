				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940102,
					"content": "#Anh ấy nhìn có vẻ không ổn lắm... chắc chắn là đói quá rồi! {NICKNAME}, có nên chia cho anh ấy chút thức ăn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940103,
					"content": "Hy vọng thức ăn có thể giúp anh ấy lấy lại năng lượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "#Không phải tôi thiên vị đâu nhé, mấy món do {NICKNAME} làm thực sự ngon lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940107,
					"content": "Cho người lạ mặt ăn Trứng Chiên Teyvat.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "Có lại sự sống rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940109,
					"content": "Woa... Xem ra đúng là anh ấy đã đói lắm rồi, chỉ là một quả trứng chiên thôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940110,
					"content": "Đúng là hương vị như được sống lại đó, nếu sớm biết trứng chiên ngon vậy thì tôi đã mua quả trứng chim thần kỳ của tên đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940111,
					"content": "Trứng chim thần kỳ gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940112,
					"content": "Nghe nói là ăn nó sẽ tránh được vận xui cho cả ngày, nếu khi đó tôi mua quả trứng chim thần kỳ đó... không, nếu mua 12 quả thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940113,
					"content": "Hừm... Nghe có vẻ khả nghi quá, như buôn bán lừa đảo vậy. Nhưng mà sao anh lại một mình đến nơi này thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940114,
					"content": "Tôi là... ừm... tôi là họa sĩ nổi tiếng của Fontaine, đến Sumeru để tìm cảm hứng. Hãy gọi tôi là Julien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940115,
					"content": "Đến cái nơi như này để lấy cảm hứng ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "Chắc là có nơi khác thích hợp hơn cho việc lấy cảm hứng chứ nhỉ? Ví dụ như nơi có phong cảnh đẹp hơn và an toàn hơn chẳng hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940119,
					"content": "Hơn nữa, nếu là họa sĩ đến từ Fontaine, sao lại chẳng cầm theo gì vậy? A... Chẳng lẽ anh là Fatui nằm vùng à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940120,
					"content": "Suy luận nhanh quá! Khó mà tưởng tượng được cô đã trải qua chuyện gì mà đưa ra được suy luận nhanh như vậy. Nhưng tôi đúng thật là họa sĩ, chỉ là một họa sĩ chứ không phải gì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940121,
					"content": "Chẳng qua tôi... thật ra tôi đã có đủ cảm hứng ở đây rồi, đang chuẩn bị kết thúc chuyến đi này và trở về Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940122,
					"content": "Nhưng không ngờ khí hậu Sumeru lại khô khốc như vậy. Lúc đến đi ngang qua Trầm Ngọc Cốc còn ẩm được chút, lúc đi vào khu vực Sumeru thì gió cát ngày càng nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940123,
					"content": "Phải nói thật rằng tôi vẫn quen với khí hậu ẩm hơn, cho nên muốn đi đường thủy để trải nghiệm phong cảnh mới. Kết quả là bè bị cuốn tan, hơn nữa tôi lại không biết bơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940124,
					"content": "Vậy cuộc sống của anh ở Fontaine chắc cũng không dễ dàng nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Đúng là vậy thật, không chỉ mỗi việc không biết bơi đâu. Haiz, thôi bỏ đi. Rồi tôi tìm được một nơi có thể nghỉ ngơi bên cạnh dòng nước, chắc là tôi vẫn còn chút lá trà chưa hư. Để thể hiện sự biết ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940126,
					"content": "Anh muốn mời chúng tôi uống trà sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940127,
					"content": "Ừm, đương nhiên... đương nhiên rồi! Để báo đáp ân tình của quả trứng chiên, mời hai vị... không biết hai vị tên là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940128,
					"content": "Đúng nhỉ, suýt chút quên tự giới thiệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940129,
					"content": "#{NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Ừm, tên danh giá quá. Tóm lại thì tôi muốn mời hai vị uống trà. Lều ở gần đây, chúng ta mau đến đó nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940130,
					"content": "Sứ giả của chính nghĩa và tùy tùng đi theo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#Là {NICKNAME} và người bạn đồng hành tốt nhất, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940132,
					"content": "Vàng Lấp Lánh và Bạc Lung Linh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#Là {NICKNAME} vàng lấp lánh và Paimon bạc lung linh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940117,
					"content": "Sao lại có người tự nói mình \"nổi tiếng\" nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "Đúng đó, đúng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940105,
					"content": "Haha, anh ấy đâu phải Paimon đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "Sao chứ! Dù là ai thì cũng từng có lúc đói đến ngất xỉu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
