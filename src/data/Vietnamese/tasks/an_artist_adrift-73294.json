					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "Lều trại đơn sơ quá! Cái này cũng được tính là trại sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940502,
					"content": "Nhưng phong cảnh ở đây không tồi, từ đây đi dạo ra chỗ bờ biển sẽ cảm thấy rất thoải mái, dễ chịu hơn nhiều so với lúc ở Fontaine rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940503,
					"content": "Cuộc sống của anh ở Fontaine rốt cuộc như thế nào vậy... rất khác với cuộc sống của họa sĩ nổi tiếng trong tưởng tượng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940504,
					"content": "Thật ra chỗ ở của tôi ở Fontaine rất nhỏ, vì tôi không phải người đam mê hư danh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940505,
					"content": "Lều trại của nhà mạo hiểm còn tốt hơn của anh đó. Ơ? Thú cưng của anh đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940506,
					"content": "Ừm... Tôi không có thú cưng, đây chắc là của nhà mạo hiểm từng đến đây để lại. Kể ra thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940507,
					"content": "Tôi rất muốn lấy gì đó tốt hơn để tiếp đãi và cám ơn hai vị, nhưng tiếc là phần lớn hành lý đã rơi xuống nước khi bè bị cuốn tan rồi, mà tôi thì lại không biết bơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940508,
					"content": "Nếu hai vị có thể giúp tôi tìm lại hành lý bị rơi xuống nước thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940509,
					"content": "Hành lý bị rơi xuống nước rồi còn dùng được sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "Tất cả đều được tôi đóng gói kỹ càng cả, nhưng trong đó có một số thứ... Haiz, mất rồi cũng đành, không sao đâu, tôi vẫn vẽ lại được... vẫn vẽ... lại được mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940511,
					"content": "#Hừm... Cảm thấy hơi đáng thương... {NICKNAME}, chúng ta giúp anh ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940512,
					"content": "Ở nơi này tôi không có ai để nương tựa cả... chỉ đành nhờ hai vị, tôi sẽ ở đây pha sẵn trà đợi hai vị về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
			"id": 7329410,
			"completionStepIds": [
				7329410
