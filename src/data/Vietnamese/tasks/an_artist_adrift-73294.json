			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "Chúng tôi quay về rồi đây... Ôi! Quả nhiên là thú cưng đồng hành của Julien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941202,
					"content": "(Phát ra âm thanh đe dọa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "Chó"
				},
				{
					"id": 732941203,
					"content": "Được rồi, \"Hạt Tiêu\"... còn gầm gừ với ta nữa chứ, ngươi quên mất là ai kiếm ăn nuôi cái nhà này sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941204,
					"content": "(Thì ra nó có tên! Nhưng cái người này ổn không vậy? Sao lại tranh cãi với chó vậy...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941205,
					"content": "(Xem ra tình cảm rất tốt)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "(Tình cảm vậy mà còn tốt sao?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941244,
					"content": "Này... Julien! Chúng tôi đã tìm được thứ anh đánh rơi rồi đây, mà Hạt Tiêu chắc là thú cưng đồng hành của anh nhỉ? Tại sao lúc nãy lại nói dối chúng tôi là không phải?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941209,
					"content": "Với loại lấy oán trả ơn này ư? Ta thà làm bạn với Chó Săn Ma Vật còn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941210,
					"content": "Vậy thì chắc hai người không đi với nhau lâu được đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "Đúng vậy, người bình thường đói bụng mà còn ngất được như Julien, lỡ mà gặp phải Chó Săn Ma Vật thì không thể giải quyết bằng một cái Trứng Chiên Teyvat được nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941212,
					"content": "Kể ra thì lúc nãy ở bên bờ biển, nó hình như đang canh chừng cái kệ vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941213,
					"content": "Cũng có thể là muốn giấu cái kệ vẽ đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "Woa, chú chó xấu xa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941217,
					"content": "(Phát ra tiếng sủa phản đối)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "Chó"
				},
				{
					"id": 732941218,
					"content": "Ngươi còn dám ồn ào nữa sao? Nếu không phải theo ngươi đến con đường cụt này thì ít ra ta còn về Fontaine theo con đường ban đầu được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941219,
					"content": "Hửm? Trước đây chẳng phải anh nói vì muốn ngắm phong cảnh đường thủy nên mới chọn quay về bằng đường thủy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941221,
					"content": "Được rồi, thực ra tôi chẳng kịp ngắm phong cảnh gì ở Sumeru thì đã bị nó dẫn đến đây rồi. Đường ở đây đều quanh co, muốn không lạc cũng khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941222,
					"content": "Thì ra là vậy. Nếu vậy thì ngay từ đầu nên nói thật với chúng tôi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941223,
					"content": "Ưm... Tại... tại vì danh dự của họa sĩ nổi tiếng chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941224,
					"content": "Sao tôi cảm thấy mỗi lần anh lắp bắp đều như đang nói dối lừa chúng tôi vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941225,
					"content": "#Nhưng nói đến phong cảnh của Sumeru thì tôi và {NICKNAME} có biết một số nơi không tồi, chúng tôi có thể dẫn anh tới đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941226,
					"content": "Không, không cần đâu, ý tôi là tôi biết ơn ý tốt của hai người. Nhưng mà... nói sao thì tôi cũng là họa sĩ nổi tiếng mà, tôi nghĩ phong cảnh đáng để vẽ lại là do chính mình tìm ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941227,
					"content": "Đúng rồi, trà đã pha xong rồi, mời các vị uống thử. Tiện thể đây nếu có trứng chiên thì có thể cho tôi xin thêm một chút được không? Xem như tráng miệng dùng chung với trà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941228,
					"content": "Tại sao trứng chiên lại đi với trà chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#Đúng đó, {NICKNAME} có nhiều món ăn sở trường lắm! Chúng ta có thể ăn cái khác mà, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941232,
					"content": "Uống trà cùng với món tráng miệng.\\nHương vị khó mà miêu tả...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "Trà này... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941234,
					"content": "Là của bạn bè bán cho tôi đấy, nghe nói có tác dụng phát huy trí tuệ tiềm ẩn. Tôi thấy cũng khá ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941235,
					"content": "Cũng may tôi không có người bạn như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "Tại sao lại nói thế? Có bạn là chuyện tốt mà, lần này tôi đến Sumeru cũng là do được bạn bè chỉ cho đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941240,
					"content": "Chuyện hôm nay thật cám ơn hai vị, tuy không biết chút báo đáp này của tôi có khiến cho hai vị vừa ý không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941241,
					"content": "Không sao đâu, nhưng chuyện địa điểm lấy cảm hứng... thật sự không cần chúng tôi giúp sao? Cứ có cảm giác như anh sẽ bị lạc nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941242,
					"content": "Ý nghĩa của con đường hành hương... khụ, ý tôi là con đường du ngoạn chính là phải tự mình đi qua... Chuyện này không phiền hai vị nữa, tôi tự ứng phó được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941243,
					"content": "Nếu anh đã nói vậy rồi... Được thôi. Nhớ đừng để bị đói đến ngất xỉu trên đường nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941237,
