			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "Không đúng, như vậy không đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "Xin chào, tôi đang ở đây để lấy ý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350104,
					"content": "Giờ đang là Tết Hải Đăng, tôi đang nghĩ xem làm thế nào để vẽ một bức tranh về Liyue và Tết Hải Đăng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350105,
					"content": "...Không biết do cách vẽ của tôi không đúng hay thế nào... bức tranh trông cứ kỳ lạ sao ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350106,
					"content": "Tôi nghĩ hay là đổi sang địa điểm khác chắc sẽ có ý tưởng hơn, nhưng đến giờ tôi cũng không tìm được nơi thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350107,
					"content": "Nhà Lữ Hành, bạn có biết ở đâu có phong cảnh thích hợp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350108,
					"content": "Chúng ta đi tìm xung quanh thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "Ừm... cũng được, vậy chúng ta đi xung quanh tìm thử, nói không chừng sẽ tìm được cảnh đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
