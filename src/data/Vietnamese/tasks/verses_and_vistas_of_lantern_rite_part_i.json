				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "Phong cảnh ở đây thật tuyệt. Ấy, vị này là ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350302,
					"content": "Xin chào, tôi Qingzhou, là nhà thơ, còn bạn là ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350303,
					"content": "Ha ha, bạn là nhà thơ sao? Còn tôi là họa sĩ, đang tìm đề tài quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350304,
					"content": "Tìm đề tài sao? Trùng hợp quá, tôi cũng vậy, cho hỏi bạn lấy đề tài gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350305,
					"content": "À, tôi muốn vẽ một bức tranh về Tết Hải Đăng và Liyue, nên cùng nhà lữ hành này đi tìm phong cảnh thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350306,
					"content": "Vậy còn bạn thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350307,
					"content": "Lại trùng hợp nữa rồi, tôi cũng muốn viết một bài thơ về Tết Hải Đăng và Liyue nên đến đây tìm đề tài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350308,
					"content": "Ừm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350309,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350310,
					"content": "Một bài thơ... có vẻ đơn giản quá nhỉ, làm sao mà chỉ có thể dùng mấy dòng chữ là có thể miêu tả được hết Tết Hải Đăng và Liyue chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350311,
					"content": "Theo ý kiến của tôi, vẽ một bức tranh, ký họa toàn bộ sự kiện trong đó lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350312,
					"content": "Một bức tranh? Ha ha, tôi lại cảm thấy quá tốn mực đấy, lại còn làm mất đi vẻ đẹp của Tết Hải Đăng và Liyue nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350313,
					"content": "Hơn nữa, Liyue rộng lớn như vậy, làm sao vẽ được hết trong một bức tranh chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350314,
					"content": "Ha ha, theo tôi, vẽ vẫn hay hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350315,
					"content": "Ha ha, theo tôi, làm thơ vẫn tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350316,
					"content": "Các bạn bình tĩnh chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "Tranh luận như vậy không có kết quả đâu, hay là mỗi người tự làm một tác phẩm của riêng mình đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350318,
					"content": "Sau khi sáng tác xong thì tìm một người đến đánh giá, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350319,
					"content": "Vậy cũng được, vậy khi bạn vẽ xong rồi thì đến Nhà Trọ Vọng Thư tìm tôi nhé. Sau đó chúng ta tìm người đến đánh giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350320,
					"content": "Được, cứ vậy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350321,
					"content": "Vậy tôi xin cáo từ trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350322,
					"content": "Tên nhà thơ này thật khoác lác, chỉ với vài chữ là muốn miêu tả hết Tết Hải Đăng và Liyue sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350323,
					"content": "Hừ, đợi sau khi tôi vẽ xong rồi phải bắt tên nhà thơ ấy nhận thua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350324,
					"content": "Bức tranh này tôi phải vẽ cho thật tốt mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350325,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi tìm một chút nguyên liệu đặc biệt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350326,
					"content": "Tôi biết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "Vậy nhờ bạn nhé, để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350329,
					"content": "Hừm... bạn hãy giúp tôi tìm một chút Mật Hoa Lừa Dối từ Hoa Lừa Dối Rực Lửa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350330,
					"content": "Có được nó thì tôi sẽ tạo ra được màu vẽ đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350328,
					"content": "Cần nguyên liệu gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
