			"dialogs": [
				{
					"id": 413350701,
					"content": "Sao rồi, bạn tìm được Mật Hoa Lừa Dối chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350702,
					"content": "Lấy được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "Để tôi xem, đúng là cái này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350704,
					"content": "Đợi tôi pha màu xong tôi sẽ tìm nơi thích hợp để bắt đầu vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350705,
					"content": "Hứ, tên nhà thơ đó sau khi xem xong bức tranh của tôi nhất định sẽ tâm phục khẩu phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350706,
					"content": "À... đúng rồi! Tôi nhớ Tết Hải Đăng của Liyue có thả \"Đèn Tiêu\", còn có thể viết điều ước trên đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
