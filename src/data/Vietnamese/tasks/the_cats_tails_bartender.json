				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Ngon thật...rượu ở \"Quán Rượu Đuôi Mèo\" thật sự rất ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010102,
					"content": "Quán rượu gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "Ơ? À...là Nhà Lữ Hành à, bạn, bạn không biết \"Quán Rượu Đuôi Mèo\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010104,
					"content": "Xem ra bạn chưa từng nghe thật, chắc cũng chưa đến qua bao giờ...haiz, vậy thì thiệt thòi quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010105,
					"content": "\"Quán Rượu Đuôi Mèo\" có rất nhiều món được pha chế kỳ diệu, chắc chắn bạn chưa từng nếm qua những mùi vị đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010106,
					"content": "Hơn nữa, Quán Rượu Đuôi Mèo giống hệt với tên của nó, trong đó có rất nhiều rất nhiều mèo con dễ thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010107,
					"content": "Được nhiều bé mèo vây quanh như thế, uống chút rượu ngon...sẽ khiến người ta bất tri bất giác mà quên đi thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010108,
					"content": "Bây giờ Quán Rượu Đuôi Mèo có đang mở cửa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "Ơ...trông bạn hình như chưa đủ tuổi được uống rượu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010111,
					"content": "Nhưng không sao, không sao! Bậc thầy pha chế Diona là người pha chế giỏi nhất ở Mondstadt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010112,
					"content": "Pha cho bạn một ly đặc biệt không cồn, đối với cô ấy chắc chỉ là chuyện nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010113,
					"content": "Hơn nữa, bậc thầy pha chế Diona đó cũng rất dễ thương, trông như một con mèo con...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010114,
					"content": "Khụ...khụ! Lỡ nói ra rồi, không được không được, bạn đừng nói với Diona là tôi nói như vậy nha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010115,
					"content": "Không nói luyên thuyên nữa, nếu bạn muốn đến Quán Rượu Đuôi Mèo thì cửa quán rượu ở ngay phía sau đó, cứ qua thẳng đó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010116,
					"content": "Tôi...ợ! Tôi qua bên cạnh để tỉnh rượu đã, vừa nãy uống hơi nhiều, xem ra không uống nổi đợt thứ năm nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010109,
					"content": "Tôi muốn đi thử...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}