				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2155.005,
							109.349,
							11195.66
						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520202,
					"content": "Thế nào thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520203,
					"content": "Nó khiến tôi nhớ lại quá khứ rất xa xôi. Khi ấy, tôi vẫn còn chung sống với Dòng Dõi Sương Nguyệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520204,
					"content": "Họ có thói quen pha lá bạc hà tươi, hương liệu và quả khô với nhau, tạo thành thức uống có hương vị hỗn hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520205,
					"content": "Mỗi lần đi ngang qua cửa sổ, tôi đều ngửi thấy mùi thơm cây cỏ bay ra từ căn nhà nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520206,
					"content": "Sau đó thì sao? Cô đã nếm thử chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520207,
					"content": "Tôi thử rồi, nhưng không uống được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520208,
					"content": "Hả? Tại sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520209,
					"content": "\"Thần linh\" đột nhiên nói là \"Có thể nếm thử trà của nhà bạn không?\"... Rồi chẳng ai dám dâng \"trà thô\" trong nhà lên cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520210,
					"content": "À, cũng đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520211,
					"content": "Cuối cùng, thứ đưa đến tay tôi lại là món \"cống phẩm\" để \"dâng tặng thần linh\" được đóng gói đẹp mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520212,
					"content": "Không phải nó khó uống. Mà là... nó thiếu đi mùi vị ấm áp mà tôi ngửi thấy khi đi ngang qua cửa sổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520213,
					"content": "Giờ thì đã có thể uống thỏa thích rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520215,
					"content": "Rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520216,
					"content": "...Nhưng mà, đúng là hiếm thấy ai cho thêm sữa vào để pha đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520217,
					"content": "Dù sao cũng là công thức đến từ Mondstadt mà. Họ rất thích thêm sữa, kem và đường khi uống trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520218,
					"content": "Rất mới lạ, cảm giác cũng không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520219,
					"content": "Cô thích là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520220,
					"content": "Ừm, cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520221,
					"content": "Thì ra không chỉ ánh trăng mới có thể chiếu rọi quá khứ, mà hương thơm của đồ uống cũng có thể đánh thức phong cảnh ẩn giấu khi xưa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
