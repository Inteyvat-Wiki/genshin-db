				{
					"id": 760520501,
					"content": "Ực ực... Ực ực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520502,
					"content": "Một hơi uống hết luôn sao! Tốt quá, xem ra cô ấy rất thích đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520503,
					"content": "Chẳng có vị gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520504,
					"content": "Không... không có vị gì cả sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520505,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520506,
					"content": "Có phải là do uống nhanh quá không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "À, không cần đâu, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520509,
					"content": "Tôi từng không hiểu được niềm vui thu hoạch mà mọi người nói, cho đến khi chính tay tôi chạm vào quả chín trên cành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520510,
					"content": "Tôi có thể cảm nhận được sức sống từ đường vân trên vỏ. Nó đã chuyển hóa chất dinh dưỡng từ ánh mặt trời, thổ nhưỡng và không khí thành hình thái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520511,
					"content": "Cùng với âm thanh giòn tan khi nhai, hương vị tươi mát ngọt ngào dâng trào như những con sóng trắng mát lạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520512,
					"content": "Thế là tôi hiểu ra, mùi thơm là một loại hấp dẫn không ai thoát khỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520513,
					"content": "Ồ! Đúng là cảm tưởng rất thú vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520514,
					"content": "Chúng ta hoàn thành sự chuyển hóa tự nhiên bằng cách đoạt lấy sức sống này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520515,
					"content": "Sao tự nhiên lại trở nên tàn khốc thế?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520516,
					"content": "Cho nên tôi thích trái cây tươi hơn. Nó giúp tôi biết mình đã lấy đi những gì từ thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520517,
					"content": "Đây cũng là điều mà tôi cần báo đáp lại thế giới này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520507,
					"content": "Hay tôi pha thêm một ly nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
