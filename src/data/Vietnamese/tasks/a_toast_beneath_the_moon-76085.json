					"nextDialogs": [
						760850603
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850603,
					"content": "Đây là ly đồ uống tôi thích nhất từ trước đến giờ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850604,
					"content": "Woa! Cuối cùng cũng tìm ra được hương vị mà Columbina thích rồi! Xúc động quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Hmm... Xin lỗi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850606,
					"content": "Tóm lại là không nên có vị đắng rõ rệt, không dùng trực tiếp nước ép trái cây, và có vẻ không cho sữa sẽ ngon hơn là có cho sữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850608,
					"content": "Đây chính là công thức \"không quá nặng nề\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Tìm ra được quy luật cũng là điều tốt, thế là sau này biết cách pha chế rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "...Sau này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850611,
					"content": "Tất nhiên rồi, chúng ta là bạn bè mà! Khi nào cô muốn uống thì cứ nói với chúng tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Cô không phải đang nghĩ là uống hết ly này là sẽ không còn nữa, nên mới không nỡ uống hết đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760850614,
					"content": "Yên tâm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
