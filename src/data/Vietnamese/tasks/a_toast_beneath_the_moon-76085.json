			"dialogs": [
				{
					"id": 760520401,
					"content": "Tôi đã từng ngửi thấy mùi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520402,
					"content": "Ồ!? Ở đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "Phòng của Sandrone. Cô ấy thấy tôi có vẻ rất hứng thú với món đồ uống tỏa mùi thơm này, nên cố tình cầm trên tay nửa ngày mà vẫn chưa uống hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520404,
					"content": "Giống như là... đang đợi tôi đặt câu hỏi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520405,
					"content": "Vậy cô đã hỏi chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520407,
					"content": "Cô đã hỏi gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "\"Không phải cô nên uống dầu máy sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520409,
					"content": "Cô ấy... trả lời thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520411,
					"content": "Những lời rất khó nghe. Đừng học theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520413,
					"content": "Mới uống một ngụm đã không hứng thú nữa rồi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
					"content": "Xin lỗi, hơi đắng, không ngon lắm. Chẳng trách sắc mặt của Sandrone lại xấu thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760520415,
					"content": "Tôi cảm thấy là vì nguyên do khác đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
