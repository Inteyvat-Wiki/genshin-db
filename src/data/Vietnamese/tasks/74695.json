			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "Xin chào, quý cô Trismegistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950102,
					"content": "Ồ? Có thể đọc chính xác cái tên này, xem ra chúng ta có bạn bè chung rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950103,
					"content": "Một tiểu thư tên Columbina giới thiệu cho tôi chỗ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950104,
					"content": "Tiểu thư đó quả thật là một người khó đoán, cuộc gặp gỡ của hai người hẳn là đầy bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950105,
					"content": "Nói rất đúng, tôi hoàn toàn đồng ý với cách nói \"khó đoán\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950106,
					"content": "Lần đầu gặp mặt, tôi là Wriothesley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950107,
					"content": "Vị công tước ở dưới nước, rất vui được gặp anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950108,
					"content": "Không ngờ một trong những ma nữ vĩ đại lại biết đến tôi, thật vô cùng vinh hạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950109,
					"content": "Hay là, nhà chiêm tinh Trismegistus đã đoán trước được sự xuất hiện của tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950110,
					"content": "Haha... Nếu chúng ta đều biết rõ thân phận của nhau rồi, vậy thì bỏ qua những nghi thức rườm rà kia đi, cứ gọi tôi Barbeloth là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950111,
					"content": "Vậy thì cứ gọi tôi là Wriothesley nhé, giờ không phải lúc làm việc, tôi cũng chỉ là một người dân Fontaine nhàn rỗi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950112,
					"content": "Lúc nãy trên đường thấy Bánh Ốc Pha Lê mới ra lò, nghe nói các ma nữ đều thích quây quần bên bàn trà tán gẫu, nếu không chê thì hãy nhận một phần nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950113,
					"content": "Ồ, đây đúng là món tráng miệng rất được yêu thích trong các buổi tiệc trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950114,
					"content": "Ở đây lâu như vậy, tôi đã tặng lời tiên tri cho không ít người, nhưng đây là lần đầu tiên tôi nhận được quà trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950115,
					"content": "Cảm ơn anh, Wriothesley, tôi sẽ chia sẻ với Alice và những người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950116,
					"content": "...Tôi nghe thấy rồi đấy, Barbie, nhất định phải để phần cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950117,
					"content": "Đừng có như lần trước, vì tôi đến muộn mà để Nicole chẳng nói chẳng rằng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950118,
					"content": "Khụ khụ! Biết rồi biết rồi, lần này chắc chắn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950119,
					"content": "Thật là, sao đến đúng lúc vậy chứ, còn đang muốn giữ thể diện của Hội Ma Nữ trước mặt người bạn mới nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950120,
					"content": "Không sao, có gì đâu, làm gì có quy định nào nói người có năng lực mạnh mẽ thì không được có tính cách hoạt bát chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950121,
					"content": "Chính xác! Lạc quan vui vẻ chính là một trong những tiêu chuẩn để gia nhập Hội Ma Nữ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950122,
					"content": "Lần đầu tiên nghe nói có loại tiêu chuẩn này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950123,
					"content": "Tôi vừa mới nghĩ ra đấy! Hội Ma Nữ là tổ chức mang lại niềm vui cho thế giới, đương nhiên bản thân chúng ta phải lạc quan vui vẻ trước đã chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950124,
					"content": "Cá nhân tôi ủng hộ các vị tận hưởng cuộc sống theo cách mình muốn... tất nhiên tiền đề là trong khuôn khổ pháp luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950125,
					"content": "Tiền đề này của anh chẳng là gì trước mặt Alice cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950126,
					"content": "Ồ, thế thì thật đáng lo ngại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950127,
					"content": "Này, tôi vẫn còn ở đây mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950128,
					"content": "Yên tâm đi, tôi chưa đến mức gây rối trước mặt người quản lý Pháo Đài Meropide đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950129,
					"content": "Hơn nữa... kể mà nói, chỗ của anh chắc cũng rộng rãi hơn phòng giam của Đội Kỵ Sĩ Tây Phong nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950130,
					"content": "Haha, chẳng lẽ một phòng giam có thể nhốt được ma nữ trong truyền thuyết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950131,
					"content": "Quý cô Alice sẵn sàng chịu phạt, chắc chắn là vì cô ấy vừa khiêm tốn vừa giữ lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950132,
					"content": "Lời này... thật sự quá đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950133,
					"content": "Dừng, dừng lại, Wriothesley, đừng tiếp tay cho cô ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950134,
					"content": "Một Alice đang vui vẻ thì chẳng biết sẽ làm ra chuyện gì nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950135,
					"content": "Một trải nghiệm sâu sắc đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#Đúng nhỉ, nói mới nhớ {NICKNAME} là Kỵ Sĩ Danh Dự của Đội Kỵ Sĩ, thế thì nhất định phải bảo vệ uy nghiêm của phòng giam mới đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950138,
					"content": "Kỵ Sĩ Danh Dự ngăn cản ma nữ trốn thoát sao? Nghe có vẻ là một vở kịch hay, nhất định phải gọi tôi đến xem đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950139,
					"content": "Anh cũng thích xem kịch hay đấy ha?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950140,
					"content": "Nhưng không ngờ công tước đã đến trước rồi, đỡ cho chúng ta phải xuống dưới nước một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950141,
					"content": "Đây chính là sức mạnh của bói toán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "À, nói đến đây thì cũng nên làm việc chính thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950143,
					"content": "Wriothesley, dù là nể mặt Columbina hay coi như đáp lễ lại những chiếc bánh trong buổi tiệc trà, xin hãy rút một lá Thánh Bài Ánh Trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950144,
					"content": "Có lẽ món quà của số phận đang được ẩn chứa trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950145,
					"content": "Đây có được xem là một lời tiên tri không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950146,
					"content": "Cũng có thể nói là như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950147,
					"content": "Vậy thì không có người Fontaine nào lại không coi trọng điều đó cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950148,
					"content": "Sau khi nói xong, Wriothesley liền cầm ngay lá bài trên cùng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "Tôi không rành về loại bài này lắm, hình như đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950150,
					"content": "Là lá Hoàng Đế đặt xuôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950151,
					"content": "Cô ngập ngừng như vậy, chẳng lẽ là tin xấu sao? Đừng bận tâm, nói thẳng ra là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950152,
					"content": "Không, hoàn toàn ngược lại. Lá bài này tượng trưng cho sự thống trị vĩnh hằng và quyền lực không thể lay chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950153,
					"content": "Nếu lá bài này đại diện cho con đường tương lai, thì thực ra anh đã đến đích từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950154,
					"content": "Tuy nhiên... hahaha, \"vận mệnh\" của anh rõ ràng vẫn đang không ngừng tiến về phía trước, thay đổi không ngừng, vậy có nghĩa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950155,
					"content": "Có lẽ thứ thay đổi không phải là con người, mà là môi trường?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950156,
					"content": "Ừm... Xét theo tình hình hiện tại thì đúng là có khuynh hướng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950157,
					"content": "Vậy xem ra tôi có thể tự tin hơn về trực giác của mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950158,
					"content": "Trước đây vì công vụ nên tôi từng đến Nod-Krai, học được không ít kiến thức, sau đó cũng hay để ý đến một số tin tức địa phương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950159,
					"content": "Và rồi có một đêm nọ, tôi nhìn mặt trăng sáng lạ thường, tôi chợt nghĩ, thế giới này đang thay đổi, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950160,
					"content": "Đáp án chính xác là, vạn vật trên đời đều luôn không ngừng thay đổi. Mà sau khi có sự can thiệp của những biến số lớn, chúng ta đều phải chuẩn bị tinh thần để đón nhận những điều chưa biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950161,
					"content": "Nhưng nhìn vào kết quả của lá bài này, anh không cần quá lo lắng. Dù môi trường có thay đổi thế nào, anh vẫn sẽ có khả năng thích nghi hoặc chống lại nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950162,
					"content": "Vậy thì đúng là mọi người đều vui. Xem ra \"cú đấm\" đó không uổng công nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950163,
					"content": "Là một cú đấm mang theo lời chúc tốt đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "Nhưng vì tò mò, tôi có một câu hỏi khá mạo muội, không biết có thể nói thẳng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950166,
					"content": "Xảo quyệt quá đấy, Wriothesley. Anh nói thế chẳng qua là cố tình khơi gợi trí tò mò của chúng tôi! Bây giờ dù anh không nói thì tôi cũng nhất định phải hỏi bằng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950167,
					"content": "Vậy thứ lỗi cho tôi nói thẳng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950168,
					"content": "Tôi vẫn luôn rất muốn biết, một lời tiên tri thực sự rốt cuộc phải làm thế nào để đảm bảo nó sẽ thành hiện thực?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950169,
					"content": "Ví dụ như trường hợp của tôi, quẻ bói hiện tại cho rằng tôi sẽ ở trạng thái ổn định trong thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950170,
					"content": "Nhưng nếu sau khi nghe được lời tiên tri này, tôi nổi hứng làm phản và lập tức đi làm những việc vượt quá giới hạn thì kết quả sẽ ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950171,
					"content": "Ví dụ như...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950172,
					"content": "Ví dụ như cho nổ tung Pháo Đài Meropide chẳng hạn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "Đúng, chính là chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950174,
					"content": "Vẫn còn nhớ tới chuyện này sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950175,
					"content": "Ồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950176,
					"content": "Không, đợi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950177,
					"content": "Haha! Thật trùng hợp! Đúng lúc chỗ tôi có một chuyên gia về bom thực lực mạnh mẽ có thể giới thiệu cho anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950178,
					"content": "Còn Kỵ Sĩ Danh Dự sẽ đóng vai trò người giám hộ đi cùng chuyên gia đó, ngăn chặn mọi chuyện tồi tệ xảy ra vào thời khắc then chốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950179,
					"content": "...Anh xem, lời tiên tri đã ứng nghiệm như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950180,
					"content": "Xem ra là một chuyên gia rất có sức phá hoại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950181,
					"content": "Hơn nữa còn rất đáng yêu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "À, là Klee! Chắc công tước không biết thôi, Klee là con gái của Alice đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950183,
					"content": "Không, nói chính xác thì phải là \"Nhà mạo hiểm các thế giới\", \"Đại ma vương xấu xa\", \"Người bảo vệ Mondstadt cổ xưa\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950184,
					"content": "Dài quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950185,
					"content": "...Tóm lại là đứa trẻ đáng yêu nhất của Đại Ma Vương Alice - Kỵ Sĩ Tia Lửa Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950186,
					"content": "Haiz, đáng lẽ nên theo kế hoạch ban đầu, tất cả cùng tổ chức một bữa tiệc thật vui, còn có thể giới thiệu mọi người cho nhau nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950187,
					"content": "Như vậy khi Klee đến Fontaine chơi, sẽ có thêm bạn mới để cùng tổ chức tiệc trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950188,
					"content": "Nghe có vẻ là một kế hoạch không tệ, tôi bắt đầu mong chờ rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950189,
					"content": "Dù sao tôi cũng sẽ không từ chối một ấm trà ngon đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950164,
					"content": "Thoát được đại nạn, ắt sẽ có phúc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "Xin hãy giữ thái độ kính trọng với phòng giam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
