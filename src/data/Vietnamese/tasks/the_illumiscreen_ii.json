			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "Hoan nghênh đến tham gia \"Linh Lung Tiêu Đăng Đồ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580102,
					"content": "Ấy? Những ngọn đèn này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "Là bạn sao, đến đúng lúc quá, lần trước sau khi bạn mở đèn xong, tôi đã đổi lại một vài cái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580104,
					"content": "Thế nào, bạn có muốn chơi lại không, lần này sẽ không dễ như lần trước đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580105,
					"content": "Những bức hình lần này sẽ phức tạp hơn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "Không, vẫn rất dễ hiểu thôi, cũng là chia thành ba phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580107,
					"content": "Độ khó lần này, chính là nằm ở phần xoay đèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580112,
					"content": "Ồ! Phải rồi, tranh cần ghép lần này là <color=#00E1FFFF>Mora</color>, nhớ kỹ nhé, sau khi ghép được tranh chính xác, mới có thể đi tìm kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580108,
					"content": "Là xoay đèn sẽ khó hơn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "Hi hi, ba chiếc đèn lần này là <color=#00E1FFFF>\"liền trục\"</color> đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580110,
					"content": "Đơn giản mà nói thì khi bạn xoay, sẽ có thể có một ngọn đèn khác xoay theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580111,
					"content": "Được rồi, tự bạn trải nghiệm thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				}
			]
		},
