				{
					"id": 413580201,
					"content": "Sao rồi, hành trình tìm kho báu thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580202,
					"content": "Đã tìm được tất cả kho báu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "Tìm được tất cả rồi sao? Khả năng tìm kho báu của bạn rất xuất sắc đấy, có nhiều người xoay đèn vài cái là bỏ đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580204,
					"content": "Nếu bạn đã tìm được tất cả kho báu rồi thì phần thưởng này xin tặng bạn, chúc bạn ngày lễ vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
