			"dialogs": [
				{
					"id": 790750401,
					"content": "Chauvigne! Anh... anh đến rồi. Hãy nghe tôi, tôi chưa bao giờ giận anh cả, cũng không muốn rời xa anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "Chẳng qua tôi chỉ lo rằng anh không muốn tiếp tục làm bạn với tôi... Có một số nhà thám hiểm sẽ thay đổi, tôi cứ lo anh cũng sẽ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "Tôi từng cầu nguyện ở chỗ nữ thần, nhưng... nhưng tôi không tìm được món quà tốt, nên người đã không đoái hoài đến tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "Không! Panuelle, việc này sẽ không bao giờ xảy ra. Tôi sẽ mãi là bạn của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750405,
					"content": "Tôi phải xin lỗi anh. Là tôi mãi chìm đắm trong suy nghĩ của mình, mà quên mất lắng nghe lời anh nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750406,
					"content": "Tôi còn tưởng... tôi còn tưởng anh không muốn nhìn thấy bộ dạng này của tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750407,
					"content": "Vậy thì giờ hiểu lầm cuối cùng cũng được giải quyết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "Đúng vậy. Tôi còn tưởng các anh có khúc mắc lớn, cực kỳ tức giận, hoàn toàn không muốn đoái hoài đến đối phương đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "Tuy nói khúc mắc như vậy cũng không nhỏ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "Cảm ơn hai vị khách quý. Nếu không có các vị thì tôi chắc vẫn còn ru rú không chịu ra ngoài đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750412,
					"content": "Bây giờ tôi đã có thể nói cho Panuelle biết suy nghĩ trong lòng mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750413,
					"content": "Tôi luôn sẵn lòng nghe anh nói, Chauvigne. Dù là đi xa hay chậu hoa... đều được cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "Đúng rồi hai vị khách quý. Xin hãy nhận lấy những thứ này, tôi đặc biệt thu thập được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "Mong nữ thần phù hộ hai vị, không bao giờ cãi cọ với bạn của mình, sẽ luôn có người nguyện lắng nghe lời trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750410,
					"content": "Nhưng có thể giải quyết được là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
