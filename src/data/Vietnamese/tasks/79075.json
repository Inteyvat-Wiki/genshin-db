					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "Phù... gió cuối cùng cũng dừng lại rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750302,
					"content": "Xin hãy nghe chúng tôi nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "Được rồi. Tôi sẽ nghe các vị nói. Nhưng trước hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750305,
					"content": "Nhìn dáng vẻ ngạc nhiên của hai vị. Tin chắc cũng muốn hỏi tôi rằng \"Tại sao một chậu hoa lại biết nói chuyện\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750306,
					"content": "Hoặc là \"Tại sao anh lại biến thành một chậu hoa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750307,
					"content": "Từng có nhiều người hỏi anh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "Lúc ở bên ngoài, có nhiều người hỏi tôi như vậy. Sau khi về nhà... thì không ai hỏi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750309,
					"content": "\"Bên ngoài\" mà anh nói là chỉ thế giới bên ngoài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750310,
					"content": "Tôi nghe nói, anh trở nên như vậy sau khi đi xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "Thông tin đầy đủ lắm đấy. Chắc là nghe Panuelle kể đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750312,
					"content": "Đúng vậy. Trong hành trình đi xa, tôi đã trở nên như vậy. Haha, theo cách nói của Rozel... thì đây là \"sự thay đổi\" mà tôi tự nguyện thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750313,
					"content": "Thay đổi có thể hiểu được. Nhưng tại sao anh lại biến thành chậu hoa vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750314,
					"content": "Chắc không phải vì thích thực vật quá đấy chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "Không phải. Chẳng qua tôi chỉ... chỉ muốn tìm được \"vị trí\" của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750317,
					"content": "Khi ở bên ngoài thế giới này, tôi từng gặp rất nhiều người. Có người là đầu bếp, có người là thợ trồng hoa, là giáo viên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750318,
					"content": "Dường như mỗi người đều tìm thấy một \"vị trí\" khiến bản thân yên tâm. Như vậy, mới có thể đứng vững trong cuộc sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750319,
					"content": "Còn tôi thì sao? Tôi chỉ giỏi đi xa, nhưng chưa từng nghĩ đến việc tìm cho mình một \"vị trí\" ổn định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750320,
					"content": "\"Chậu hoa\" này là \"vị trí\" của anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "Đúng vậy, hiểu nhanh lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750322,
					"content": "Làm một bông hoa trong chậu, sẽ giúp tôi luôn có được \"vị trí\" khiến mình yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750323,
					"content": "Nhưng mà... haiz, nếu tôi đã có một cái chậu, cũng đã có được \"vị trí\" thuộc về mình, vậy tại sao tôi phải đi xa nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750324,
					"content": "Nhưng tôi lại là một nhà thám hiểm, nếu không đi xa thì tôi còn làm được việc gì có giá trị đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750325,
					"content": "Tôi không hiểu. Càng biết về sự vật của thế giới bên ngoài, tôi càng không hiểu... \"Vị trí\" và \"đi xa\", rốt cuộc điều gì quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750326,
					"content": "Tôi càng suy nghĩ, càng cảm thấy đau đầu... Khi nói chuyện cùng Panuelle, tôi cũng luôn đối đáp lan man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750327,
					"content": "Tôi sợ ảnh hưởng đến anh ấy. Nếu anh ấy vốn thích đi xa, sau khi nhìn thấy bộ dạng này của tôi thì liệu có ghét bỏ việc đi xa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750328,
					"content": "Panuelle là bạn của tôi, điều này sẽ không bao giờ thay đổi. Tôi phải thành thật với anh ấy, tôi vẫn luôn trả lời tất cả câu hỏi của anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750329,
					"content": "Bao gồm cả... việc tôi muốn trở thành bông hoa là vì muốn có được một \"vị trí\" khiến mình yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750330,
					"content": "Có lẽ vì câu trả lời của tôi đã khiến Panuelle buồn... Hoặc cũng có thể là anh ấy không thích bộ dạng này của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750331,
					"content": "Chúng tôi dần tách ra, và một chậu hoa như tôi thì không có cách để tự lên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750332,
					"content": "Nhưng như vậy cũng tốt, có lẽ Panuelle cũng không muốn gặp tôi, anh ấy chắc chắn đang giận tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750333,
					"content": "Ồ... thì ra là vậy. Hai người đều cho rằng \"đối phương đang giận mình\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750334,
					"content": "Cho nên mới không chịu gặp đối phương.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "Sao cơ? Ý, ý là Panuelle không có giận tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750336,
					"content": "Suy nghĩ của hai người giống hệt nhau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "Nói cho Chauvigne biết suy nghĩ của Panuelle...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "Trời ạ, sao tôi lại nghĩ như vậy, tôi không bao giờ muốn thấy anh ấy buồn, dù là khóe miệng anh ấy có hơi hướng xuống là trái tim tôi đã muốn tan nát rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750340,
					"content": "Hai vị khách quý! Nhờ hai vị đưa tôi lên đó, xin hai người đấy, tôi muốn mau chóng gặp được Panuelle! Không thể đợi thêm một phút giây nào nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750341,
					"content": "Chỉ đợi câu này của anh thôi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#Hi hi, chỉ đợi câu này thôi đấy. Chúng ta xuất phát nào {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750337,
					"content": "Anh ấy cứ tưởng anh đang giận anh ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
					"content": "Ước mơ của anh là trở thành nhà thực vật học sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750303,
					"content": "Panuelle có chuyện muốn nói với anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				}
