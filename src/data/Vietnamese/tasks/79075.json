			"dialogs": [
				{
					"id": 790750101,
					"content": "Rốt cuộc Chauvigne đang nghĩ gì nhỉ? Haiz, anh ấy không chịu nói chuyện với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750102,
					"content": "Về Chauvigne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "Xin chào. Thật xin lỗi... Chauvigne còn đang giận tôi, không chịu ra nói chuyện với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750104,
					"content": "Haiz, nhưng ở bên đó không chỉ thiếu gió mà còn thiếu ánh nắng, nếu anh ấy héo mất thì phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750105,
					"content": "Ừm... nếu là một chậu hoa thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750106,
					"content": "Chúng ta có thể trực tiếp bê anh ấy ra mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "Tôi đã thử qua rồi. Nhưng Chauvigne cứ giận dỗi, tôi không thể đến gần anh ấy được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750108,
					"content": "Tâm trạng anh ấy như giông bão, tôi suýt bị thổi bay luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750109,
					"content": "Đợi đã, sao nổi giận lại có thể thổi bay người khác được vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750110,
					"content": "Vậy thì giông bão thật đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "Có lẽ là do trước đây tôi đã từ chối đi xa cùng Chauvigne, khiến anh ấy không vui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750113,
					"content": "Có thể nhờ hai vị khách quý đến thăm Chauvigne không? Không chừng có thể khuyên được anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750114,
					"content": "Không thành vấn đề, chúng tôi đi thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "Ừm, chúng tôi từng đi đến nhiều nơi, cũng từng gặp nhiều người, biết đâu... có thể khuyên được anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750116,
					"content": "Vậy thì tốt quá rồi! Chauvigne đang ở trong hang động dưới hòn đảo này, hãy đến đó tìm anh ấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750117,
					"content": "Tôi... tôi phải dọn dẹp nơi này, tìm một chỗ phơi nắng thích hợp nhất cho Chauvigne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750111,
					"content": "Quả thực không muốn người khác đến gần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
