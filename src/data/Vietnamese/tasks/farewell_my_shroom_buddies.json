					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860101,
					"content": "#{NICKNAME}, Paimon và cả \"Nón Trống Tròn\" nữa, chúng tôi ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860102
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400860102,
					"content": "Layla! Mấy ngày vừa rồi cô và \"Quái Thú Xoay Tròn\" đi chơi có vui không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860103,
					"content": "Đương nhiên rồi! Có \"Quái Thú Xoay Tròn\" giúp tôi kéo hành lý, còn đi khắp nơi cắm trại, ngắm nhiều phong cảnh và trời sao khác nhau, tôi còn viết cả vào luận văn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860104
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400860104,
					"content": "Nhưng mà, danh sách món ăn tôi đã làm gần hết rồi, mỗi lần tiếp xúc với bột mì là lại khiến tôi buổi tối không ngừng ho... Mà giờ tôi vẫn chưa tìm ra món ăn mà \"Quái Thú Xoay Tròn\" ưa thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860105
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400860105,
					"content": "Nếu \"Ngọc Trí Tuệ\" sau khi cải tạo có thể giúp chúng ta nói chuyện với Nấm Quỷ thì tuyệt quá... Tôi sẽ viết vào trong thư nhờ người hỏi thăm học giả thâm niên của Học Phái Amurta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860106
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400860106,
					"content": "Layla hình như đã lấy hết sức mình ra rồi vậy! Nói nhiều như vậy mà vẫn còn tinh thần... Đúng là đối xử rất tốt với người bạn đồng hành của mình đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860107,
					"content": "Phù, đúng là dùng sức hơi nhiều rồi, chúng ta đi tìm tiểu thư Yae đi... Không thôi tôi sẽ không chịu nổi nữa đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				}
			]
		},
		{
			"id": 4008602,
			"completionStepIds": [
				4008602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008602",
							"2"
						],
						"stepId": 4008602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860201,
					"content": "Hử? Đến sớm vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860202
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400860202,
					"content": "Miko, cô chuẩn bị rời đi rồi sao? Cảm giác như cô vẫn chưa du lịch nhiều ở Sumeru mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860203,
					"content": "Tôi đã chơi thỏa thích rồi. Nhờ mấy cưng mà lần này tôi có được rất nhiều cảm hứng, không chỉ trải nghiệm thi đấu quý giá, còn phá bỏ được âm mưu của kẻ xấu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860204
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400860204,
					"content": "Thôi thì bảo Souka từ bỏ nhân vật mà cô ấy tạo ra, lấy mấy cưng làm nhân vật chính cho bộ tiểu thuyết tiếp theo nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860205,
						400860206
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400860205,
					"content": "Thực ra cô cũng âm thầm hành động mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				},
				{
					"id": 400860207,
					"content": "Đúng đó! Giờ tôi hiểu rồi, trước đây cô đã nhiều lần ra ám hiệu cho chúng tôi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860208,
					"content": "Rõ ràng là có thể sớm vạch mặt Elchingen mà, sao lại phải lòng vòng vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860209,
					"content": "Vạch mặt từ đầu thì chẳng phải chả còn gì thú vị sao? Tôi muốn xem mấy cưng sẽ đối phó với hoàn cảnh đó như thế nào. Kết quả là mấy cưng cũng cho tôi niềm vui không nhỏ đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860210
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400860210,
					"content": "Tôi cứ nghĩ rằng câu chuyện giữa mấy cưng và Nấm Quỷ là \"chủ nhân\" và \"người hầu\" thôi, nhưng mấy cưng lại có đáp án riêng của mình... Đó là người bạn đồng hành bình đẳng ăn ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400860211,
					"content": "Suy từ góc độ khác, Elchingen, kẻ luôn nhớ về \"chủ nhân\" của mình thì lại rơi vào tay mấy cưng, quá hợp lý rồi. Đương nhiên là với thủ đoạn của hắn thì chắc sẽ còn ồn ào thêm một chút đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400860212,
					"content": "Tôi lại bắt đầu thấy khó hiểu rồi... Lần sau vẫn phải viết lại lời của Miko nói rồi ngâm cứu thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860213,
					"content": "Tám chuyện đến đây thôi, \"Lưới Sấm\" giao cho mấy cưng đó. Nhớ chăm sóc nó cho cẩn thận nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860214
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400860214,
					"content": "Mấy cưng và Haniyyah phải cố lên, như vậy thì cuộc thi thú vị này mới có thể tiếp tục tổ chức được. Tất cả là nhờ mấy cưng đấy, tôi vẫn có chút mong chờ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400860206,
					"content": "Cô biết Elchingen không ổn đúng không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				}
			]
		},
		{
			"id": 4008603,
			"completionStepIds": [
				4008603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
