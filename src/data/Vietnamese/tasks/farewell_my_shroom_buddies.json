			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860301,
					"content": "Các bạn đến thật đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860302
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400860302,
					"content": "Tôi đã thu thập xong \"Ngọc Trí Tuệ\" từ các tuyển thủ khác rồi, cũng chọn được địa điểm phù hợp để tập kết Nấm Quỷ, nhất định sẽ không gây ảnh hưởng xấu đến hệ sinh thái xung quanh đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860303
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400860303,
					"content": "Chào mọi người đi \"Ngọn Lửa Hân Hoan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400860304,
					"content": "\"Ngọn Lửa Hân Hoan\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860305
					]
				},
				{
					"id": 400860305,
					"content": "Đây là tên mới của \"Hỏa-1\". Lần đầu gặp nó, tôi thấy nó rất ngoan, nên cũng có chút hân hoan trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860306
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400860306,
					"content": "Nếu có thể sớm phá bỏ lòng cố chấp, không căm hận Nấm Quỷ thì... có lẽ thứ cảm xúc này sẽ được giữ mãi đến giờ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860307
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400860307,
					"content": "Haniyyah cuối cùng cũng mở lòng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860308
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400860308,
					"content": "Như vậy mới đúng chứ! Tuy là tôi vẫn nghe quen tai cái tên \"Hỏa-1\" hơn, nhưng mà tên mới rất có ý nghĩa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860309,
						400860310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860309,
					"content": "Chúc mừng Haniyyah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				},
				{
					"id": 400860311,
					"content": "Tôi quyết định lấy tiêu chuẩn nghiêm khắc nhất để yêu cầu bản thân chăm sóc thật tốt cho những con Nấm Quỷ ôn hòa này. Xin hãy yên tâm giao chúng cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860312
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400860312,
					"content": "Như vậy là đến lúc chia tay rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860313
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400860313,
					"content": "Đi nào \"Quái Thú Xoay Tròn\", phải nghe lời Haniyyah đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860314
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400860314,
					"content": "\"Lưới Sấm\" à, trong lần tổ chức giải đấu luyện thú tiếp theo, Miko sẽ đến thăm bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860315,
					"content": "\"Nón Trống Tròn\"... Khoảng thời gian này tôi rất vui, bạn cũng phải sống thật vui vẻ nhé, hẹn ngày sau gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400860316,
					"content": "Nhất định sẽ gặp lại!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860317
					]
				},
				{
					"id": 400860317,
					"content": "Hy vọng ngày mà con người và Nấm Quỷ có thể cùng chung sống với nhau sẽ mau đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400860318,
					"content": "Tôi tin các bạn! Tôi sẽ đợi tin vui từ mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400860310,
					"content": "Cũng chúc mừng \"Ngọn Lửa Hân Hoan\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				}
			]
		}
	]
}