					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110805,
					"content": "Dùng kết quả mà bất kỳ ai trong chúng ta đều không thể đoán trước để chỉ trích một thiên tài như cô sao? Thật là thất lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110806,
					"content": "Nếu thật sự có người làm vậy, tôi dám chắc thế giới này sẽ chẳng còn đột phá kỹ thuật nào mới nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110807,
					"content": "Hừm, lời này của anh nghe cũng lọt tai đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110808,
					"content": "Giúp được tâm trạng của cô thoải mái hơn, đó là niềm vinh hạnh của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110809,
					"content": "Vậy rốt cuộc là có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110810,
					"content": "Cô có bằng lòng dành thời gian giúp tôi sửa ngọn đèn này không? Lần trước tôi đem tới Thị Trấn Nasha sửa một lần, nhưng không may lại bị hỏng trong trận chiến vừa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110811,
					"content": "Sửa một ngọn đèn sao? Chút chuyện nhỏ này lại cần đến thiên tài Aino tôi đây à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110812,
					"content": "Ồ, thất lễ rồi, vậy chắc tôi phải đi nhờ tiểu thư Ineffa. Vậy món ăn vặt này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110813,
					"content": "Ơ, tôi... Ý tôi là chút chuyện nhỏ này không mất công sức lắm đâu. Ngồi đợi chút nhé, sẽ xong ngay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "Aino"
				},
