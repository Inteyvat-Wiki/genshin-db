			"dialogs": [
				{
					"id": 60110101,
					"content": "Mọi người tụ họp lại, chia sẻ những chuyện đã xảy ra ở hai bên và thông tin tình báo thu được...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "May mắn là tổn thất từ chuyện này đã được khống chế ở mức nhỏ nhất. Chỉ có một vài dân thường bị thương thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110103,
					"content": "Nhưng giờ đây Rerir đã có được hình hài hoàn chỉnh, còn chúng ta vẫn chẳng biết gì về mục đích của hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110104,
					"content": "Nghe giống như thả con Qucusaur hung ác về với tự nhiên vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110105,
					"content": "...Mọi người đều không biết về loài Qucusaur sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110106,
					"content": "Tôi biết, nhưng phép ẩn dụ của cô vẫn nhẹ nhàng quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110107,
					"content": "Hắn nói thế giới này không quan trọng với hắn, nên có thể tạm thời chưa có lý do để xung đột với chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110108,
					"content": "Nếu chỉ là đến để báo thù, vậy thì bây giờ chúng ta cũng không còn cách nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110109,
					"content": "Bây giờ... Em từ chức có còn kịp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110110,
					"content": "Em đùa đấy, đùa thôi mà sếp! Chuyện đến nước này rồi, em cũng sẽ không thể trốn được nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110111,
					"content": "Ôi... Khẩu pháo mà tôi tự hào nhất lại làm hỏng việc rồi... Hừm! Tôi sẽ dỡ bỏ nó ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110112,
					"content": "Chuyện này không phải lỗi của Aino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "Đúng vậy. Đối phó với Cuộc Săn Hoang Dã thông thường thì vẫn dùng được mà, đừng nản lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110115,
					"content": "Flins, sau này chắc cần anh tới chỗ Người Giữ Đèn để làm một số quy trình. Tôi đã giải thích qua rồi, họ sẽ không gây khó dễ cho anh đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110116,
					"content": "#Cảm ơn. Tôi nghe nói cô đã giúp {NICKNAME} rất nhiều, nếu không chúng ta cũng không dễ dàng tiếp cận sự thật như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110117,
					"content": "Nếu anh chịu hướng ngoại nhiều hơn thì cũng không đến mức rơi vào cảnh cô độc một mình như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110118,
					"content": "Haha, xin ghi nhận những lời tốt đẹp này. Tôi sẽ suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110119,
					"content": "Nếu có thể thay thế vị trí của binh trưởng Sousi, có lẽ tôi sẽ học hỏi được nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110120,
					"content": "Hả, anh sắp lên chức sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110121,
					"content": "Người ta đùa thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "Vậy sao? Hừm, sao chỉ có mình tôi là không nhận ra nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110123,
					"content": "#{NICKNAME}. Nếu rảnh, {F#cô}{M#cậu} đi cùng tôi một chuyến được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110124,
					"content": "Tôi muốn tiễn quý ngài đó một chặng đường cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110113,
					"content": "Cũng không phải lỗi của khẩu pháo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
