					"nextDialogs": [
						60110912
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110912,
					"content": "Nhưng nếu phải nói thì vị đồng hương Nefer này cũng từng giúp đỡ khi tôi vừa đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110913,
					"content": "Muốn trách thì trách lâu như vậy rồi mà tôi cũng không tìm được cơ hội để trả món nợ ân tình này!",
