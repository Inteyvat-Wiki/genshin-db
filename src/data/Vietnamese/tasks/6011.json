					"nextDialogs": [
						60110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110602,
					"content": "Hmm? Không phải hai người đề nghị tôi ra ngoài đi dạo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110603,
					"content": "Cũng đúng. Nhưng cô không sợ bị Fatui phát hiện sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110604,
					"content": "Sandrone không có hứng thú bắt tôi, những Fatui khác cũng không mạo hiểm đến tìm tôi. Họ đang có vấn đề khó hơn cần giải quyết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110605,
					"content": "(Ý là Rerir sao... Bây giờ hắn đang đe dọa đến tất cả mọi người ở Nod-Krai.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "Thôi được, ra ngoài đi dạo cũng là chuyện tốt. Thế nào, cô thích Thị Trấn Nasha này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110607,
					"content": "Hm... Dòng chảy Kuuvahki hơi rối loạn, trong lòng mọi người đang rất bất an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110608,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110609,
					"content": "Nhưng mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110610,
					"content": "Món ăn lần trước hai người mời tôi là mua ở đây đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110611,
					"content": "(Để tâm tới chuyện đó sao? Chắc không phải cô ấy đến để ăn Thịt Chiên Quả Mọng đấy chứ?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110612,
					"content": "À! Nếu cô thích thì lần sau chúng tôi dẫn cô đi ăn. Vẫn còn rất nhiều món ngon mà khi ở nhà thì sẽ không có đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110613,
					"content": "#...Hmm? Nãy giờ {F#cô}{M#cậu} im lặng, trong lòng có khúc mắc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110614,
					"content": "Về Rerir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "Ừm... Lúc đó tôi không thể hiểu được kế hoạch của hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110616,
					"content": "Nay hắn đã lấy được hình thể, sức mạnh không thể xem thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110617,
					"content": "Nhưng có một chấp niệm trong sức mạnh đó, một chấp niệm gần như điên cuồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110618,
					"content": "Tôi không rõ chấp niệm đó đến từ mặt trăng, hay là đến từ thứ gì khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60110619,
					"content": "Có lẽ việc hiểu rõ chấp niệm này là gì sẽ là mấu chốt để đối phó với hắn ta sau này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Columbina"
				},
				{
