						60110403
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110403,
					"content": "Hiểu rồi. Nhưng hạn sử dụng của Krumkake rất ngắn, có lẽ chỉ một tuần là sẽ hỏng.",
					"roleType": "TALK_ROLE_NPC",
