			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "Anh ấy... giống như một ngọn hải đăng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110202,
					"content": "Tất nhiên, anh ấy đã sống ở đây, chiếu sáng và ban phước lành cho những người xung quanh. Nhưng khi mọi người quen với ánh sáng, thì sẽ bỏ qua sự tồn tại của ngọn đèn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110203,
					"content": "Dần dần, bản thân anh ấy cũng nghĩ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110204,
					"content": "\"Những chuyện mình làm chẳng là gì cả. Mình vẫn làm chưa đủ tốt, vẫn cần phải kiên nhẫn, tiếp tục chờ đợi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110205,
					"content": "Có lẽ đây là một kết thúc đau buồn, nhưng tôi vẫn tự hào vì anh ấy đã từng soi sáng con đường phía trước cho người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110206,
					"content": "Mỗi chiếc bóng sinh ra từ ánh sáng đều sẽ ghi nhớ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110207,
					"content": "Thật đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110208,
					"content": "Tôi từng nghe câu chuyện về \"Fae Của Ngọn Đèn\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "Ồ, chuyện đó tôi cũng có nghe qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110210,
					"content": "Tôi cũng muốn nói với anh ấy những lời tương tự.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "Vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110213,
					"content": "#{F#Cô}{M#Cậu} nói đúng. Cho dù lần này những nỗ lực của chúng ta có vẻ như vô ích, và Rerir vẫn đã đạt được mục đích của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110214,
					"content": "Nhưng chúng ta vẫn sẽ truy đuổi hắn tới cùng, dù cho kết quả vẫn không như mong muốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110215,
					"content": "Đây giống như công việc của người gác mộ vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110216,
					"content": "Không phải là để hồi sinh người đã khuất, mà chỉ để mang lại sự yên bình cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110217,
					"content": "Anh nghĩ được như vậy là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110219,
					"content": "Hai... hai người đang nói gì vậy? Giải thích cho tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110220,
					"content": "Không phải lúc này, Paimon. Khi nào về tôi sẽ nói cho nghe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110222,
					"content": "Dù sao đi nữa, Fae Của Ngọn Đèn gì đó cũng không đóng vai trò chủ đạo trong nghi lễ cuối cùng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110223,
					"content": "\"Người giữ ánh sáng, dùng máu tươi thực thi vinh quang và chính nghĩa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110224,
					"content": "\"Hành tung vội vàng, chúng ta dù mang đầy vết thương, cũng xin dừng bước giây lát, nhìn lại yêu thương và thù hận.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110225,
					"content": "\"Cho đến khi màn đêm buông xuống, đến khi chẳng còn ai thấy, ánh đèn dần sáng lên chỉ vì một mình ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110226,
					"content": "Cảm ơn vì tất cả, binh trưởng Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110211,
					"content": "Không nên quá chấp niệm với kết quả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
