						60110506
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110506,
					"content": "Ý sếp là không góp sức à?! Vậy chẳng phải hữu danh vô thực sao? Thế thì thà giải tán còn hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110507,
					"content": "Haiz... Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110508,
					"content": "Ý chị là không có giới hạn trên hay dưới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110509,
					"content": "Ồ! Không hổ danh là sếp, suy nghĩ thật là sâu xa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110510,
					"content": "Mà khoan, vậy chẳng phải nói cũng như không sao? Thế rốt cuộc là bao nhiêu đây sếp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
