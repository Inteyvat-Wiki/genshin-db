						4850803,
						4850804
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850803,
					"content": "Ừm, rất thuận lợi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "Phải rồi, lần thi đấu bay lượn thành Mondstadt sắp tới, tôi sẽ giúp bạn báo danh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850806,
					"content": "Tôi bay nhanh quá, không ai theo kịp, cho nên cứ bay qua bay lại một mình, cũng chán lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850807,
					"content": "Được, tôi sẽ thắng cuộc thi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "Ồ? Thật là một tuyên bố to gan. Khà khà khà... xem ra bạn vẫn chưa biết chỗ khủng khiếp của cuộc thi bay lượn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850810,
					"content": "Vậy thì, trước khi bị tôi đánh bại, hãy bay hợp pháp, tự do và vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850811,
					"content": "Nhất định phải tuân thủ quy tắc bay lượn của thành Mondstadt, không được để bị thu hồi bằng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850812,
					"content": "Câu này do Amber nói ra, thật là không có một chút sức thuyết phục nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850808,
					"content": "Amber sẽ không dành được quán quân kỳ sau rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850804,
					"content": "Kỳ thực không dễ dàng gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				}
			]
		},
