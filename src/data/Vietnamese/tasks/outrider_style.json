			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "Phía trước xem ra không có đường đi... tên đó có thể trốn ở đâu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber, nhìn phía bên kia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "Ngươi quả nhiên đuổi đến đây, thật hết cách... Í? Tại sao lại là một cô bé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "[Quái Điểu]"
				},
				{
					"id": 4850304,
					"content": "Ngươi là Quái Điểu à! Đừng hòng trốn thoát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "Hahaha, ta không cần trốn, vì ngươi chắc chắn không thể qua đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "[Quái Điểu]"
				},
				{
					"id": 4850306,
					"content": "Ồ... Vách đá này quả thực rất cao... cũng rất xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "Cô bé, chi bằng cô quay về, gọi đội trưởng cô đến đây, không chừng ta sẽ đầu hàng ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "[Quái Điểu]"
				},
				{
					"id": 4850308,
					"content": "Ngươi đang thách thức Kỵ Sĩ Trinh Thám của Đội Kỵ Sĩ Tây Phong à? Xem ta bay qua bắt ngươi ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "Bình tĩnh chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "Ồ... bạn nói đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "Đáng ghét, rõ ràng là ở trước mặt, nếu có thể bay thẳng qua thì tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "Nhưng tên quái điểu này làm sao qua đó được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "Không lẽ có cơ quan có thể đi qua lại?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "Tôi cũng không nhìn ra có dấu vết của cơ quan như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "Mà xung quanh cũng không có vách đá có thể đặt cơ quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "Tạm biệt, cô bé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "[Quái Điểu]"
				},
				{
					"id": 4850323,
					"content": "Haizz, tên đó trốn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "Không thể do dự nữa, ngoài cách bay ra, không còn cách nào để vượt qua vách núi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "Đừng lo, tôi là Quán Quân Bay Lượn của Thành Mondstadt, nếu tên quái điểu đó có thể bay qua, tôi cũng sẽ nhất định làm được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "Này, Kỵ Sĩ Trinh Thám, nếu muốn chết, thì không đeo Phong Chi Dực nhảy từ tượng Phong Thần trong thành Mondstadt xuống sẽ thích hợp với ngươi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "[Quái Điểu]"
				},
				{
					"id": 4850328,
					"content": "Tôi hiểu ý Amber rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#Nói cũng phải... ngoài đáp án là bay, thì {NICKNAME} cũng phủ nhận hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, còn nhớ quyển sách tôi lấy nhầm... quyển hướng dẫn không phải hướng dẫn đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "\"Con chim nhỏ ban đầu không biết bay, bay lượn chính là phần thưởng cho lòng dũng cảm khi nó vượt qua vách núi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "Tiếp theo, bạn hãy làm chứng cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "Cố Lên! Kỵ Sĩ Trinh Thám",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "Được! Vậy thì để tên nhóc này thấy dũng khí của Kỵ Sĩ Trinh Thám nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "Đừng, đừng có giỡn, bên này không bay qua được! Mau ngoan ngoãn đi về đi, cô bé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "[Quái Điểu]"
				},
				{
					"id": 4850337,
					"content": "Quái Điểu, ngươi thấy vậy sao? Nhưng ngươi nghe cho kỹ đi, âm thanh ở xung quanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "Gió nói - Có thể bay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "Tuy là cần dũng khí, nhưng cũng không phải là đi tự sát.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "Hay là dùng ma pháp Nguyên Tố nào đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#Góc nhìn Nguyên Tố của {NICKNAME} có phát hiện dấu vết gì không?... Ồ, quả nhiên cũng không có?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "Hay là dùng móc câu hoặc đinh nhọn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "Bay cũng không bay qua được, mấy thứ đó cũng không thể ném qua được nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "Trên mặt đất cũng không có dấu vết bị đóng đinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "Quan sát xung quanh chút... Bạn đã dạy tôi như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "Bắt được quái điểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850602,
					"content": "Thật ra, chỉ có ở trong không trung mới phát hiện được, đó là ngọn gió duy nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850603,
					"content": "Hướng quái điểu nói muốn chạy, thật ra là đường cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850604,
					"content": "Nói cách khác, nếu quái điểu muốn chạy trốn, thì bắt buộc phải đi qua chỗ chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850605,
					"content": "Ồ, cho nên hắn làm bộ làm tịch, hóa ra muốn lừa chúng ta bỏ cuộc, sau đó bay ngược lại chạy trốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850606,
					"content": "Nhưng mà, chúng ta cũng không dễ bị lừa như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850607,
					"content": "#May là có {NICKNAME} phân tích, đây chính là \"sau khi loại trừ tất cả những đáp án sai, đáp án còn lại cho dù bất thường đến đâu cũng là đáp án đúng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850608,
					"content": "Tóm lại, muốn nắm vững việc bay lượn, 7 phần là kỹ thuật, 3 phần là trực giác, 90 phần còn lại phải dựa vào dũng khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850609,
					"content": "Tôi thấy lúc nãy cô 99 phần đều là dũng khí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850610,
					"content": "Haizz, giống với lần đầu tôi thi bằng bay lượn... Tuy là rất căng thẳng, nhưng cũng thi đậu lấy bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850611,
					"content": "Tiếc rằng những lần thi sau đó tôi lại không có cảm giác căng thẳng nữa, cứ thấy thiếu đi gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850612,
					"content": "Này... đợi một chút, bằng bay lượn đã thi được rồi, những lần thi sau là thi cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850613,
					"content": "Cái này... Vì trong thành Mondstadt chỗ này không cho bay chỗ kia không cho bay, chỗ này không được đáp chỗ kia không được đáp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850614,
					"content": "Bằng bay lượn của tôi cứ bị thu hồi, đã phải thi lại 15 lần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850615,
					"content": "Nhưng mỗi lần thi lại tôi đều thi một lần là được, quả nhiên quyển hướng dẫn của tôi mới là tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850616,
					"content": "#...{NICKNAME}, nếu sau này rảnh, chúng ta đến chỗ đội trưởng Jean lấy một quyển hướng dẫn bay lượn đàng hoàng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850617,
					"content": "Được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "Tóm lại, tôi phải áp giải Quái Điểu về Mondstadt, tôi đi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850620,
					"content": "Sau khi bạn về Mondstadt, nhớ đến Đại Giáo Đường tìm tôi, bằng bay lượn phải đến đó cấp cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850618,
					"content": "Đội trưởng Jean vất vả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				}
			]
		},
