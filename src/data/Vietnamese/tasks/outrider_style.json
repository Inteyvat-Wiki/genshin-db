			"dialogs": [
				{
					"id": 4850801,
					"content": "Chúc mừng! Đây là bằng bay lượn, bạn có thể bay lượn hợp pháp trong Thành Mondstadt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850802
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850802,
					"content": "Nhưng kỹ thuật bay của bạn đã tốt như vậy, thuận lợi vượt qua cũng là việc dễ hiểu.",
					"roleType": "TALK_ROLE_NPC",
