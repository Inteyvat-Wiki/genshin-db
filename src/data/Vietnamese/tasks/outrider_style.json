			"dialogs": [
				{
					"id": 4851101,
					"content": "Bên này có một con đường, xem ra quái điểu đang ở phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851102,
					"content": "Xem tình hình phía trước, muốn đuổi theo chỉ có cách bay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851103,
					"content": "Nhưng phía dưới có nhiều kẻ địch như vậy, khi bay lên sẽ bị tấn công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851104,
					"content": "Nếu muốn qua đó, cần phải <color=#00E1FFFF>vừa bay vừa tiêu diệt kẻ địch</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851105,
					"content": "#Phải rồi, {NICKNAME} còn thiếu một môn chưa thi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851106,
					"content": "Đúng vậy, sao đột nhiên lại hỏi cái này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851107,
					"content": "#Vậy thì đề thi thứ ba của {NICKNAME}, lấy chủ đề là cái này được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851108,
					"content": "Hóa ra nội dung thi là vậy sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851109,
					"content": "#Là bản thi hiện trường tôi đặc biệt thiết kế cho {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851110,
					"content": "Dù gì cũng là anh hùng giải cứu thành Mondstadt, đề thi bình thường làm sao sánh được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851112,
					"content": "Nhất định sẽ vượt qua cuộc thi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851113,
					"content": "Nhất định sẽ bắt được quái điểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851111,
					"content": "#{NICKNAME}, bạn nghĩ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851114,
					"content": "Hihi, câu trả lời rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851115,
					"content": "#Vậy thì, bay lên đi {NICKNAME}. <color=#00E1FFFF>Tiêu diệt tất cả kẻ địch</color>, quái điểu và bằng bay lượn đều đang đợi bạn ở phía trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
