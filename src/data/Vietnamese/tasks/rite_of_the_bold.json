			"dialogs": [
				{
					"id": 750190301,
					"content": "...Chuyện này không thể thương lượng được nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190302,
					"content": "Tôi nói này, người anh em Manqu. Anh không nghe Titu nói sao? Chuyện này đã hơn năm trăm năm rồi chưa ai làm qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190303,
					"content": "Cho dù anh nói tìm thấy lối có thể đi vào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190304,
					"content": "Thế thì sao? Xét về lịch sử, những người cùng Saurian bước lên con đường đó đều không ai quay trở lại. Nghe kỹ nhé, không một ai quay trở lại cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190305,
					"content": "Hừm, thứ lỗi tôi nói thẳng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190306,
					"content": "Người của Hiệp Hội Nghiên Cứu Di Vật Saurian ở bên kia kìa, còn người bên cạnh hình như là thủ lĩnh bộ tộc Con Của Tiếng Vang nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190307,
					"content": "Này... Người của Hiệp Hội Nghiên Cứu Di Vật Saurian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190308,
					"content": "#Là {NICKNAME}... Paimon, và cả {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190309,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "Ồ, Tepetlisaur nhỏ trên đuôi buộc khăn lụa đỏ! Nhóc hoạt bát quá, nhìn vào là thấy khác biệt rồi! Nào, đến đây xem nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190311,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#Thật tuyệt! Ra ngươi chính là {REALNAME[ID(2)|SHOWHOST(true)]}, vậy hai vị là dũng sĩ mà nó đã chọn đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190313,
					"content": "#{NICKNAME} và Paimon, tên của hai vị gần đây xuất hiện khá nhiều đấy... Không chỉ người anh em Manqu, mà cả Titu khi trở về cũng từng nhắc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190314,
					"content": "Những sự tích này cũng có thể xem là truyền thuyết rồi. Hơn nữa, cư dân trong Con Của Tiếng Vang cũng đã được hai vị chăm sóc nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190315,
					"content": "Không cần cảm kích tôi quá đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "Haha, người trẻ tuổi thật lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190318,
					"content": "Người anh em Manqu, nếu vì để kiểm chứng suy nghĩ của anh mà đẩy họ vào hố lửa, thì đây không phải là cách mà Con Của Tiếng Vang tiếp đón khách đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190319,
					"content": "Chí ít thì đây không phải là cách tiếp đón khách của tôi, tôi không thể làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190320,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190321,
					"content": "Hai anh đang nói gì thế? Chuyện nguy hiểm và hố lửa gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190322,
					"content": "Xin lỗi, để tôi giải thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190323,
					"content": "Mọi người còn nhớ chuyện đã nói trước đó chứ? Để xóa bỏ Chúc Phúc Của Chúa Tể Lửa thì cần phải mang hai tín vật đến núi lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190324,
					"content": "Một trong số tín vật đó nằm trong di tích bên ngoài Con Của Tiếng Vang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190325,
					"content": "Nhưng nếu muốn vào thì phải có điều kiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190326,
					"content": "Theo tiền lệ trước đó... Đương nhiên tiền lệ này là do tôi vừa tìm thấy trong những cuộn vải dệt. Dù sao cũng đã rất lâu rồi không ai muốn làm việc này mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190328,
					"content": "Nếu muốn dẫn Saurian của mình đến núi lửa để tiến hành nghi lễ xóa bỏ Chúc Phúc Của Chúa Tể Lửa, thì phải được thủ lĩnh bộ tộc của các bên công nhận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190332,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} là một Tepetlisaurus, nên phải có được sự công nhận của thủ lĩnh Con Của Tiếng Vang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190334,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "Vậy chẳng phải là sự công nhận của Pacal sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190336,
					"content": "#Đúng vậy. Nhưng nói thật thì quy tắc này liệu có hiệu lực với người bên ngoài không thì tôi cũng không rõ. Nhưng mà, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190337,
					"content": "Trong hàng trăm năm nay, có rất nhiều dũng sĩ muốn giúp Saurian của mình thoát khỏi thứ giống lời nguyền hơn là chúc phúc này trong dòng máu của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190338,
					"content": "Nhưng không một ai thành công... Đây cũng là lý do về sau trong bộ tộc dần từ bỏ truyền thống này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190339,
					"content": "Ồ, không một ai thành công sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190340,
					"content": "Đúng, đây là một việc rất nguy hiểm. Hơn nữa nghe nói trước khi lấy được tín vật, không chỉ dũng sĩ, mà ngay cả Saurian của họ cũng nhận được thử thách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190341,
					"content": "Tuy các vị không phải người của bộ tộc, nhưng tôi không muốn các vị hy sinh vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190342,
					"content": "#Cho nên, {NICKNAME}, tôi vẫn đề nghị nên để {REALNAME[ID(2)|SHOWHOST(true)]} ở lại Con Của Tiếng Vang thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190343,
					"content": "Chí ít thì tôi có thể bảo đảm tôi sẽ chăm sóc tốt cho nó trước khi nó tiến vào Vương Quốc Dạ Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190344,
					"content": "Nhưng, nhưng nếu như vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190345,
					"content": "#...Giống như tôi đã nói trước đây, {REALNAME[ID(2)|SHOWHOST(true)]} sẽ không thể trưởng thành được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190346,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "Xem ra nó không muốn như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "Tôi muốn thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "Dù rất nguy hiểm nhưng vẫn muốn thử sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190350,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "Còn nhóc thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190352,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "Hahaha, tốt lắm! Ánh mắt vô cùng kiên định và mạnh mẽ, lại có thể cảm nhận ngọn lửa ấm áp trong lòng. Đúng là tuyệt vời như Phlogiston mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190354,
					"content": "Được rồi, vậy tôi sẽ công nhận mọi người có tư cách đến núi lửa hành hương vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190355,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "Được đó, vậy bây giờ chúng tôi đã có thể đi tìm tín vật đầu tiên rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190357,
					"content": "Không, vẫn chưa được. Nếu đã có được tư cách, vậy thì phải tiến hành thí luyện của người chứng kiến đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190358,
					"content": "Theo truyền thống cổ xưa, dũng sĩ và Saurian phải cùng nhau lấy được lông vũ của chim đuôi seo ở sâu trong cánh rừng, và dâng lên một chồng da thú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190359,
					"content": "Phải cùng nhau giành năm mươi trận đấu thắng lợi cho bộ tộc, dâng lên chín mươi sáu viên đá quý thượng hạng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190360,
					"content": "Tôi không có tư cách đó rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "Thôi bỏ đi, người anh em Manqu, mấy cái anh nói đã là sử sách từ đời nào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190363,
					"content": "Những quy tắc rườm rà vốn là để bồi dưỡng sự ăn ý giữa người và Saurian, nhằm tăng cường thực lực của họ... Tôi chịu đủ những điều đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190364,
					"content": "#Hơn nữa, {NICKNAME} và {REALNAME[ID(2)|SHOWHOST(true)]} nhìn có vẻ không cần những thứ đó để chứng minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190365,
					"content": "#Đổi sang cách đơn giản hơn đi. {NICKNAME}, ở Natlan khi gặp phải những tình huống như vậy thì có một cách nhanh gọn nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190366,
					"content": "Hãy đấu với tôi một trận để chứng minh thực lực của cả hai nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190367,
					"content": "Đúng ý tôi đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "Ối, đánh nhau ở đây sao? A, chẳng lẽ phải lên sân khấu đánh à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190370,
					"content": "Đương nhiên là không rồi. Haha, sân khấu không thể đào qua đào lại được... Quyết đấu tại Con Của Tiếng Vang phải diễn ra trên ngọn núi phía sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190371,
					"content": "Nào, chúng ta cùng đến ngọn núi phía sau để đấu một trận sảng khoái nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190361,
					"content": "Có thể quy đổi ra Mora không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
