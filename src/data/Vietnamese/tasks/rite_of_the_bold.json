			"dialogs": [
				{
					"id": 750190701,
					"content": "Thắng rồi, hay quá! Giỏi lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "#Hah... Dù là chiến sĩ mạnh nhất trong bộ tộc bây giờ, e là cũng không thắng nổi {F#cô}{M#cậu} rồi... Lần này tôi thua tâm phục khẩu phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "Cảm giác bị một đứa nhóc đánh bại như thế nào? Người anh em, xem ra chúng ta phải luyện tập nhiều hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "Mmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190706,
					"content": "Đúng là một màn quyết đấu đặc sắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190707,
					"content": "Người anh em Manqu, anh cứ hay ở bên cạnh nói mấy câu như vậy, thật vô vị. Sao nào, anh cũng đấu một trận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "Không, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190709,
					"content": "#Hời, vô vị. Quả là một trận đấu sảng khoái, thực lực của {NICKNAME} đúng là không nói quá chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "Tôi còn chưa khởi động đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "Haha, quả là kiêu ngạo mà, nhưng tôi rất thích thái độ này. Người mạnh vốn nên thể hiện một chút, nếu không thì mạnh còn ý nghĩa gì chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Haha, {REALNAME[ID(2)|SHOWHOST(true)]}, có thể thấy ngươi đã được họ chăm sóc rất tốt đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#Đương nhiên rồi, {REALNAME[ID(2)|SHOWHOST(true)]} là bạn đồng hành tuyệt vời của chúng tôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "Thế thì tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "Được rồi, như đã hứa, hãy cầm lấy chứng minh của thủ lĩnh bộ tộc nào. Chính là cái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "Tên khoa học là gì nhỉ? Người anh em Manqu, đến lúc anh phát ngôn rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "Bùa Hộ Mệnh Của Waxaklahun Ubah Kan... Là bùa hộ mệnh của Hiền Giả Trộm Lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190721,
					"content": "Ừm, cái tên này tôi mãi không nhớ nổi. Nhưng tôi nhớ là sau khi Hỏa Long Vương mất, và sau khi Hỏa Thần đầu tiên sinh ra từ trong ngọn lửa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "Hiền Giả Trộm Lửa cùng Hỏa Thần đời đầu, mỗi người đã mang đi một tín vật từ trong núi lửa. Người lấy được hai tín vật sẽ có thể vào tịnh hỏa trong núi lửa, xóa bỏ tất cả nguyền rủa và tai ương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Nhưng Hiền Giả Trộm Lửa này rốt cuộc đã sống bao lâu vậy, người anh em Manqu? Cảm thấy như từ thời đại bộ lạc đến lúc Ochkanatlan nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "Ngay cả chỗ Mũi Kim Bóng Tối cũng có truyền thuyết của người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Dù sao cũng là loài người đầu tiên biết sử dụng Phlogiston mà... Nhân vật xuất hiện trong truyền thuyết, dù biến thành dạng gì thì cũng có khả năng cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190726,
					"content": "Có người nói người đó đã Phlogiston hóa cả cơ thể và linh hồn, hòa làm một với gió, mặt đất và hoa ở Natlan, có thể lắng nghe âm thanh cầu xin của người trong bộ tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190727,
					"content": "Cũng có người nói, thật ra mỗi thời đại đều có người khác nhau kế thừa danh hiệu Hiền Giả Trộm Lửa, thậm chí đồn rằng đến nay vẫn còn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190728,
					"content": "Nhưng thứ lỗi tôi nói thẳng... Phần lớn trong đó đều chỉ là suy đoán của người kể chuyện mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190729,
					"content": "Haha, nghe anh nói vậy thì chắc Titu lại phải nổi giận rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Được rồi, tôi đã làm xong việc mình nên làm rồi... À không đúng, theo truyền thống và tiền lệ thì vẫn còn một việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "Đó chính là chúc phúc cho dũng sĩ cùng bạn đồng hành bước lên chuyến hành trình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Ồ, còn có cả nghi thức như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Thật ra chỉ là một số câu cổ vũ lấy lệ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Vậy thì, {NICKNAME} và {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Ừm, có tôi đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "Chúc cả hai có thể bay qua mọi đỉnh núi như những chú chim với đôi cánh cứng cáp nhất;\\nChúc cả hai có thể chống lại dòng chảy dữ tợn tựa như những tảng đá kiên cố nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "Chúc cả hai không chùn bước trước hiểm nguy, vì thế giới này vốn định sẵn ngập tràn gian nan.\\nChúc cả hai không quên nhau, vì vận mệnh rồi cũng sẽ có lúc biệt ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "Chúc cả hai có thể đến được nơi mình muốn, thỏa được nguyện vọng... Và điều quan trọng nhất, cũng là điều tôi mong muốn nhất, chúc cả hai có thể bình an trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "Nhất định rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Hửm? Vậy còn tôi thì sao, không có chúc phúc nào cho tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Đúng nhỉ, còn Paimon nhỏ... Vậy thì chúc Paimon ăn no ngủ khỏe, mau chóng trưởng thành nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
					"content": "Cũng được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "Hừm, thế thì tôi miễn cưỡng nhận phần chúc phúc này vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190749,
					"content": "Được, vậy nghi thức của người chứng kiến đã kết thúc rồi. Trước khi xuất phát thì tôi vẫn muốn nói: Phải cẩn thận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190750,
					"content": "Ừm, chúng tôi biết rồi. Tạm biệt Pacal... và cả Uchu nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190751,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190753,
					"content": "Tạm biệt, chúc mọi việc thuận lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190746,
					"content": "Paimon còn lớn thêm được nữa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "Đương nhiên rồi. Sau này tôi nhất định sẽ lớn thành Paimon \"cao như ba ngọn núi\" cho mà xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190712,
					"content": "Anh cũng rất giỏi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "#Mấy câu an ủi này thì miễn đi, nhưng nếu mà tôi trẻ lại một chút thì còn chưa biết ai thắng ai thua đâu. Thật đáng tiếc, nếu khi đó có thể đấu với {F#cô}{M#cậu} một trận thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				}
			]
		},
