			"dialogs": [
				{
					"id": 750190601,
					"content": "#Thứ lỗi tôi nói thẳng... Tuy tôi biết rõ thực lực của {NICKNAME}, nhưng vẫn nên chú ý nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190602,
					"content": "Tuy không nhận được Tên Cổ, nhưng thực lực của Pacal cũng không thể xem nhẹ được... Nếu mấy năm nay anh ấy không bỏ bê việc rèn luyện thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190603,
					"content": "Nếu đã sẵn sàng để chiến đấu, vậy thì bắt đầu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
