					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "Ừm, mùi vị này...hình như không phải là món Liyue, cũng không phải là món Inazuma, nhưng mùi vị khá ngon đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330402,
					"content": "Tuy không thể ăn được món tôi muốn, nhưng chung quy no bụng thì cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330403,
					"content": "Cảm ơn bạn nhé nhà lữ hành, đây là thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203305,
			"completionStepIds": [
				2203305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
