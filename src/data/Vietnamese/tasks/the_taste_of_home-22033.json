			},
			"dialogs": [
				{
					"id": 220330301,
					"content": "Ôi! Tuyệt quá! Đây đúng là mùi vị của quê hương...Hu hu...thật là cảm động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330302,
					"content": "Cảm ơn nhé! Tôi lại phấn chấn trở lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330303,
					"content": "Cái này tặng bạn, chúc bạn thượng lộ bình an nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203304,
			"completionStepIds": [
				2203304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
