					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330101,
					"content": "Ôi...nếu như có thể ăn được món Liyue thì tốt biết mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330102,
					"content": "Bạn sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330103
					]
				},
				{
					"id": 220330103,
					"content": "Bạn là? Nhìn cách bạn ăn mặc có vẻ như là nhà lữ hành đúng không. Xin lỗi, tôi có chút nhớ nhà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330104,
						220330105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330104,
					"content": "Ban nãy bạn có nói là muốn ăn món Liyue sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330118
					]
				},
				{
					"id": 220330118,
					"content": "Ấy? không lẽ...bạn có thể làm món Liyue sao? Tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330119,
					"content": "Vậy hãy mau mau giúp tôi làm món Liyue chính thống nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330120,
					"content": "Để tôi xem...thứ mà tôi muốn ăn nhất là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330121,
					"content": "Tôi muốn ăn điểm tâm của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330122,
					"content": "Gần đây hễ tôi nhắm mắt lại là mơ thấy một hoàng tử điểm tâm oai phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330123,
					"content": "Chân mang giày Guoba, đầu đội nón đậu hũ, thân khoác áo choàng bánh gạo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330124,
						220330125
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330124,
					"content": "Nghe thấy toàn là món khoái khẩu của chuột...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330126
					]
				},
				{
					"id": 220330126,
					"content": "Anh ta đứng bên đường, tỏa ra hương thơm phảng phất khó quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330127
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330127,
					"content": "Bạn hãy giúp tôi mang hoàng tử điểm tâm về nhé, năn nỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330125,
					"content": "Nghe thấy đều là làm từ bột gạo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330126
					]
				},
				{
					"id": 220330105,
					"content": "Bạn gặp phải khó khăn gì à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330106
					]
				},
				{
					"id": 220330106,
					"content": "Để tôi tự giới thiệu, tôi tên là Tang Wen, là một nhà lịch sử học đến từ Liyue, dạo trước tôi có đến Inazuma để nghiên cứu về phong tục và lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330107,
					"content": "Sau khi thu thập kha khá tài liệu, đang chuẩn bị về Liyue thì Inazuma lại ban hành lệnh bế quan tỏa cảng, thành ra tôi bị kẹt lại đây đã một thời gian rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330108,
					"content": "Thực ra, tôi cảm thấy đây cũng không phải là chuyện xấu. Hiện giờ Inazuma đang ở trong thời khắc của lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330109,
					"content": "Tôi tin rằng sau khi trải qua giai đoạn này, bộ sử sách của Teyvat sẽ tốn rất nhiều mực để viết về nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330110,
					"content": "Được tận mắt chứng kiến lịch sử một cách chân thật và hoàn chỉnh, được đích thân ghi chép lại để lưu truyền cho hậu thế, đây là một việc mà nhà sử học phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330111,
					"content": "Tuy những việc này khiến tôi phấn chấn, nhưng nó lại không khiến cho bụng tôi no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330112,
					"content": "Bạn đói bụng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330113
					]
				},
				{
					"id": 220330113,
					"content": "Cũng không thể nói là đói...Ha ha, thực ra ở Inazuma cũng có rất nhiều món ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330114,
					"content": "Tôi thích nhất là món Tempura, rất thơm giòn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330115,
					"content": "Nhưng ăn món Inazuma lâu ngày rồi, tôi muốn ăn lại món của Liyue hơn. Nhưng mà tôi không tìm được cửa hàng bán món Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330116,
					"content": "Mấy ngày trước tôi có đến Hiệp Hội Nhà Mạo Hiểm để treo \"ủy thác nấu ăn\", nhưng cũng không nhận được hồi âm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330117,
					"content": "Tôi có thể thử không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330118
					]
				}
			]
		},
