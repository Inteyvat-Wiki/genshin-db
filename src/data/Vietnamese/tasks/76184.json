			"dialogs": [
				{
					"id": 761840301,
					"content": "Tiệc trà tuyệt lắm. Biết thế này thì tôi đã tham gia nhiều hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840302,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "Được, hẹn gặp lại sau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
