			"dialogs": [
				{
					"id": 761840101,
					"content": "Ồ, mới lạ đấy. Không ngờ có ngày tôi được mời tham dự tiệc trà của cô Sandrone đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840102,
					"content": "Nếu lễ nghi trong tiệc trà của anh lịch sự hơn một chút thì chắc trước đây tôi đã cân nhắc mời anh thêm vài lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840103,
					"content": "Đồng ý. Hơn nữa tốt nhất là đừng có lần nào cũng đòi thách đấu với ai đó trong số chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761840104,
					"content": "Sao hai người lại giống anh chị trong nhà tôi thế, toàn nói tôi như vậy. Chắc do hồi trước được sư phụ huấn luyện ở nơi hoang dã, nên không mấy để ý tới mấy chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840105,
					"content": "Thôi kệ, cơ hội được tụ tập cùng nhau như thế này cũng không nhiều. Cứ tận hưởng khoảnh khắc hiện tại đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840106,
					"content": "Ồ? Đây là cỗ máy mới nhất của cô đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840107,
					"content": "Cô ấy tên là Fagio, một \"cỗ máy tự động đa năng thông dụng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840108,
					"content": "Vậy nghĩa là Pulonia to lớn thực sự không thể sửa được à... Thật đáng tiếc, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840109,
					"content": "Không sao đâu, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840110,
					"content": "...Thật đáng tiếc là tôi không được đấu với anh ta một trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840111,
					"content": "Tôi biết ngay mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840112,
					"content": "Pulonia trông rất mạnh, còn Fagio thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840113,
					"content": "...Anh định nói là cô ấy trông có vẻ yếu ớt à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840114,
					"content": "Uhm... haha, không đâu. Chỉ là trông không mạnh mẽ bằng Pulonia to lớn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840115,
					"content": "Chà, Pulonia là cỗ máy tính toán, khả năng chiến đấu là do tôi bổ sung thêm trên cơ sở không ảnh hưởng đến khả năng tính toán đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840116,
					"content": "Nhưng Fagio không cần xử lý các thuật thức phức tạp, nói cách khác, toàn bộ khả năng tính toán của cô ấy đều dùng để xử lý mô đun chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840117,
					"content": "Tức là... mạnh hơn cả Pulonia à? Thật không đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840118,
					"content": "Trông anh có vẻ thực sự muốn mở mang tầm mắt đấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840119,
					"content": "Nói trước nhé, nhỡ làm hỏng thì tôi không trả tiền sửa chữa đâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840120,
					"content": "Còn tôi không trả tiền viện phí đâu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761840121,
					"content": "(Haiz.. Quả nhiên cuối cùng vẫn thành ra thế này.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761840122,
					"content": "(Măm măm...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
