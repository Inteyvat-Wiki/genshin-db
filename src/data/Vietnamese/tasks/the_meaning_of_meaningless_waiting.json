					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040702,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "Nói không chừng chuyện này có liên quan đến lệnh Truy Lùng Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040704,
					"content": "Rõ ràng Tejima chẳng làm sai điều gì mà lại bị tịch thu Vision. Sau đó, con người anh ấy...cứ như bị thay đổi hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040705,
					"content": "Tôi không biết phải nói thế nào, nhưng có thể cảm thấy được dường như anh ấy đã mất đi thứ gì đó rất quan trọng, sau khi một mình đi khắp thôn mấy vòng thì đột nhiên nói muốn ngao du bốn bể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040706,
					"content": "Thực ra chúng tôi không biết có nên giữ anh ấy lại hay không, nhưng thật sự...không thể để anh ấy rời khỏi đây trong trạng thái hồn bay phách lạc như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040707,
					"content": "Xem ra người dân xung quanh đây rất kính trọng ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
