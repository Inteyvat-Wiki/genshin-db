			"dialogs": [
				{
					"id": 20040601,
					"content": "Cháu...cháu đến để giữ Tejima lại phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040602,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "Tejima đấy, 30 năm trước khi đến đây, anh ấy đã luôn canh giữ nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040604,
					"content": "Đánh đuổi Đạo Bảo Đoàn, xua đuổi ma vật, hòa giải những cuộc cãi vã trong thôn...anh ấy đã bỏ biết bao tâm huyết vào nơi này, chúng tôi cũng xem anh ấy là người đáng kính nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040605,
					"content": "Nhưng đột nhiên anh ấy muốn rời khỏi, chẳng lẽ...chúng tôi đã làm sai gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040606,
					"content": "Nếu được, chúng tôi bằng lòng xin lỗi Tejima, chỉ mong anh ấy tiếp tục ở lại nơi này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
