			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tejima",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "Đúng, chữ viết trên quyển nhật ký này là của ta, bùa hộ mệnh và lá thư...cũng là của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040502,
					"content": "Tuy những gì viết trong đó, ta đã quên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040503,
					"content": "Nhưng quả thực ta đã ở đây chờ một người, chờ suốt 30 năm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040504,
					"content": "Trong khoảng thời gian đó, ta đã viết lại những chuyện thú vị, để sau này gặp lại, sẽ kể cho cô ấy nghe những câu chuyện trong 30 năm ròng rã này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040505,
					"content": "Thời gian đó đã xảy ra rất nhiều chuyện...thời gian trôi qua nhanh thật, chớp mắt đã lâu như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040506,
					"content": "Vì sao ta lại quên chuyện quan trọng như vậy ư? Nghĩ kỹ lại, thì từ sau khi Vision bị cướp đi, ta cảm thấy bản thân mình thật trống rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040507,
					"content": "Yêu cũng được, tiếc nuối cũng được, tất thảy những gì liên quan đến cô ấy, đều đã tan biến hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040508,
					"content": "Ông có buồn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "Hình như cũng không quá buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040510,
					"content": "Dù sao ta cũng đã quên cô ấy là ai. Dáng vẻ, tiếng nói của cô ấy, những chuyện mà ta và cô ấy đã trải qua, ta cũng đã không nhớ được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040511,
					"content": "Cứ như cô ấy chưa từng xuất hiện bên cạnh ta...cứ như những năm vừa qua chỉ là một giấc mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040513,
					"content": "Vậy ông còn muốn rời khỏi đây không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "Chắc là không...cũng đã chờ hơn nửa đời người rồi, thôi thì cứ chờ tiếp vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040516,
					"content": "Nhưng mà, nếu chờ được cô ấy, lại không thể nhớ được tên, thì có làm cô ấy buồn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040517,
					"content": "Chỉ nghĩ đến chuyện này thôi cũng đủ khiến ta vô cùng buồn lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040518,
					"content": "Kỳ lạ thật, rõ ràng ta đã quên cô ấy, nhưng vì sao vẫn có suy nghĩ như vậy? Trước kia cũng thế, cứ cảm thấy trong lòng trống rỗng, cứ như thiếu vắng thứ gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040519,
					"content": "Nói thế nào thì cũng cám ơn các cháu đã giúp ta tìm lại được lý do để tiếp tục ở lại nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040520,
					"content": "Ta sẽ vẫn ở lại đây chờ cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040522,
					"content": "Tuy Tejima nói ông ấy không buồn, nhưng sao tôi lại thấy buồn thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040523,
					"content": "Tôi cũng vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "Quả nhiên đúng như lời Ayaka và Thoma nói...nếu mất đi Vision, thì tất cả những gì liên quan đến tâm nguyện cũng sẽ mất theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040526,
					"content": "Có lẽ đây chính là nguyên nhân cho trạng thái đó của ông Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040527,
					"content": "Chí ít thì, cũng xem như chúng ta đã giúp được ông ấy...phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040528,
					"content": "Haiz...chúng ta đi tìm người tiếp theo đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040524,
					"content": "Mất đi nguyên nhân của nỗi buồn mới là chuyện đáng buồn hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
