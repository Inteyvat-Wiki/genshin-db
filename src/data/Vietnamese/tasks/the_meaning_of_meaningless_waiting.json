			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Để tôi xem thử người mà Ayaka nói đang ở đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040102,
					"content": "Ngài đang làm gì thế, đã nhiều năm như vậy rồi, vì sao lại đột nhiên rời khỏi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040103,
					"content": "Đúng thế đúng thế. Chúng tôi còn chưa kịp chuẩn bị tâm lý thì đã nghe được tin này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040104,
					"content": "Bọn trẻ còn đang chờ ngài đưa chúng ra ngoài chơi kìa...xin ngài hãy suy nghĩ lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040105,
					"content": "Người đó chắc hẳn là người mà Ayaka đã nói, chúng ta mau qua đó xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
