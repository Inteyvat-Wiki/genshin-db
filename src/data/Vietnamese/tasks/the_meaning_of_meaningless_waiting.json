			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "Hình như đây là nhật ký của ông Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040202,
					"content": "Để tôi xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040203,
					"content": "\"Hôm nay đã cùng mọi người trong thôn làm cá nướng, tay chân tôi hơi vụng về, làm khét mất cái nồi, đành phải giả vờ rằng mình đang làm cá thui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040204,
					"content": "\"Hôm nay cứu được một đứa trẻ rơi xuống nước, cậu bé nói bạn thân của mình - Banbu vẫn còn đang ở dưới nước. Tôi ngụp lặn cả một buổi chiều mới biết thì ra Banbu là con cua mà cậu ấy nuôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040205,
					"content": "\"Hôm nay đi thả diều thì dây diều đột nhiên bị đứt. Tôi bèn đuổi theo, đuổi mãi thì phát hiện là không thể nào theo kịp, bèn tìm một chỗ ngồi xuống, nhìn nó càng bay càng xa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040206,
					"content": "Ừm...hình như đều là những chuyện lặt vặt thường ngày thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040207,
					"content": "Ơ? Khoan, mau xem cái này đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040208,
					"content": "\"Hôm nay lại đến miếu thờ để cầu nguyện và ngồi ở đó khá lâu. Bùa hộ mệnh được tặng đã phai màu, nhưng vẫn là thứ mà tôi trân trọng nhất...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040209,
					"content": "Có vẻ đây là thông tin hữu ích đấy, chúng ta đến miếu thờ xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
