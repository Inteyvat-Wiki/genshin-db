				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "Ông chính là Tejima phải không, vì sao lại đột ngột muốn rời khỏi nơi này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040802,
					"content": "Ta sao? Thay vì nói tại sao muốn rời khỏi...chi bằng nói rằng, ta không biết vì sao mình lại phải ở lại nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040803,
					"content": "Ông đã sống ở đây rất lâu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "Mọi người đều nương tựa vào ông.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "Đúng vậy, nhưng đây không phải là lý do mà tôi ở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040806,
					"content": "Vì sao 30 năm trước ta lại đến đây? 30 năm nay vì sao ta lại không muốn rời khỏi nơi này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040807,
					"content": "Ta không còn nhớ được gì nữa. Kể từ khi Vision bị cướp đi, hình như ta đã quên đi rất nhiều chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040808,
					"content": "Trước đây ta muốn ở lại đây, bây giờ chấp niệm này đã không còn nữa, ta chỉ cảm thấy ra ngoài đi đây đi đó cũng tốt, tuy trong lòng cứ thấy trống trải thế nào ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040809,
					"content": "Thì ra là vậy...cũng có thể nói là, chỉ cần chúng cháu giúp ông tìm được lý do ở lại, thì ông sẽ không đi nữa phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040810,
					"content": "Ừm...nhưng mà, ngay cả ông cũng quên mất thì phải làm sao đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040811,
					"content": "Hay là ông thử cố nhớ lại, xem có thể nhớ được \"chút xíu\" nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040812,
					"content": "Lần trước, lúc gửi trái cây cho Tejima, hình như có nhìn thấy ông ấy đang viết nhật ký!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040813,
					"content": "Tôi có thói quen như vậy sao? Nói thật là...tôi đã quên mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040814,
					"content": "Có đấy có đấy! Lúc đó anh còn nói phải ghi lại những chuyện thú vị, để sau này sẽ dùng cho việc quan trọng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040815,
					"content": "Vậy thì tốt quá rồi! Có vẻ như chỉ cần tìm được nhật ký là có thể giữ ông Tejima lại rồi. Chúng ta xem thử xung quanh đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040816,
					"content": "Vậy nhờ vào các cháu nhé...chúng tôi về thôn trước, nói tình hình của Tejima cho mọi người biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
