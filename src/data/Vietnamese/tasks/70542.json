				]
			},
			"dialogs": [
				{
					"id": 705420101,
					"content": "Meo... meo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420102,
					"content": "Đây là cách mà mèo chào nhau sao? Hay phát âm của mình chưa đủ chuẩn nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420103,
					"content": "Meo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420104
					],
					"speakerTitle": "Kem Tuyết"
				},
				{
					"id": 705420104,
					"content": "\"Kem Tuyết\" hình như nghe không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420105,
					"content": "Mona đang thử nói tiếng mèo sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420106,
						705420107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420106,
					"content": "Mona, không phải phát âm như thế đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				},
				{
					"id": 705420108,
					"content": "Này! \"Grừ grừ\" nghe giống cọp với sư tử quá, là cách phát âm để hù dọa mèo thì đúng hơn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420109,
					"content": "#{NICKNAME} và Paimon! Thì ra lời đồn là thật, hai người làm thuê tại Pháo Đài Mèo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420110,
					"content": "Cũng không hẳn là làm thuê, chúng tôi chỉ đang giúp Valerina và Rosaria thôi. Giống như... cố vấn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420111,
					"content": "Đúng vậy! Chính là cố vấn, nghe rất oai đúng không, hihi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420112,
					"content": "Mà này, Nhà Chiêm Tinh Vĩ Đại Mona có muốn nhận nuôi một chú mèo để giúp quan sát tinh tượng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420113,
					"content": "Với hiểu biết về chiêm tinh học của tôi thì việc dạy mèo xem tinh tượng cũng không phải chuyện khó. Chắc thậm chí có thể... nhờ mèo viết bài cho mình luôn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420114
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420114,
					"content": "(Lén nhìn sang Kem Tuyết)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420115,
					"content": "(Nhìn thẳng về phía Kem Tuyết)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420116,
					"content": "Meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420117
					],
					"speakerTitle": "Kem Tuyết"
				},
				{
					"id": 705420117,
					"content": "Khụ, mà thôi. Nếu chỉ biết xem tinh tượng mà không biết chọn lọc từ ngữ, thì bản thảo viết ra cũng sẽ không truyền đạt được hết ý của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420118,
					"content": "Nếu cần trợ lý viết bản thảo thì đến Fontaine lần nữa để thuyết phục nhân viên của tờ báo Chim Hơi Nước, hoặc mời một Melusine biết dùng máy đánh chữ đến Mondstadt vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420119,
					"content": "Nếu tôi thật sự nhận nuôi mèo thì cùng lắm chỉ là chơi với chúng cho thư giãn đầu óc sau khi nghiên cứu học thuật thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420120
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420120,
					"content": "Không nên làm một người chủ tệ, vừa mệt bản thân mà còn làm cho mèo mệt theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420121
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420121,
					"content": "Trước khi bước vào căn phòng này, tôi thật không ngờ là chơi với mèo lại vui như vậy... Cuộc sống sẽ tuyệt vời biết bao nếu chúng ta luôn hạnh phúc như thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420122,
					"content": "Hihi, xem ra Mona sắp trở thành một người chủ có tâm đấy, giao mèo cho Mona thì đúng là rất yên tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420123,
					"content": "Nhưng tôi cũng nghe nói, có những con mèo rất tinh nghịch, hay chạy nhảy khắp nhà, lại còn thích cào và cắn đồ đạc nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420124,
					"content": "Lỡ như cắn phải bản thảo, hoặc là tài liệu liên quan đến chiêm tinh thì phiền to đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420125,
					"content": "Nếu cắn hư sách quý thì... Chuyện đáng sợ như vậy tôi không dám nghĩ tới luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420126,
					"content": "\"Kem Tuyết\" có vẻ rất ngoan, nhưng hình như không hiểu ý tôi cho lắm... Có lẽ chúng tôi không hợp ý nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420127,
					"content": "Nên tôi vẫn muốn quan sát thêm, để xem có bé mèo nào ngoan ngoãn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420128,
					"content": "Rồi sau đó tính đến chuyện làm nhà và mua thức ăn cho mèo. Không thể quá xa xỉ, cũng không được để mèo chịu thiệt thòi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420129,
						705420130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 705420129,
					"content": "Không sao, cứ từ từ suy nghĩ nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420131,
					"content": "Đúng đó, Valerina nói là sau này sẽ còn nhận nuôi thêm nhiều mèo nữa, nên dù bây giờ chưa tìm được mèo ưng ý thì sau này cũng có thể thường xuyên đến chơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705420132,
					"content": "Meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kem Tuyết"
				},
				{
					"id": 705420130,
					"content": "Trong pháo đài vẫn còn rất nhiều mèo mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420107,
					"content": "Thử kêu grừ grừ với nó xem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				}
			]
		}
	]
}