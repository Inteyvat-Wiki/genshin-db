			"dialogs": [
				{
					"id": 102010401,
					"content": "Hừ, đuổi đến nơi rồi hả. Xem ra các người cũng có bản lĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010402,
					"content": "Nhưng các ngươi cũng chỉ đến thế mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010403,
					"content": "Ngươi muốn làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "Hahahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010405,
					"content": "Bọn ta đã thu thập thông tin tình báo chiến đấu chi tiết trong những tin đồn của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010406,
					"content": "Cô bé áo đỏ này sở hữu bảo vật lợi hại nhất Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010407,
					"content": "Hiện nay báu vật trong tay ta, các người có gấp cũng không có tác dụng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010408,
					"content": "Được! Vậy dùng báu vật này đối phó với các ngươi vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010409,
					"content": "Không được! Đừng... đụng vào nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "Hừm hừm, xem ngươi có vẻ hoảng loạn, cuối cùng đã biết sợ hãi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010411,
					"content": "Để ta xem xem, ồ... Dấu hiệu ngọn lửa à, hừ hừ hừ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010412,
					"content": "Bang",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Pháp Sư Vực Sâu"
				},
				{
					"id": 102010501,
					"content": "A!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010502,
					"content": "Quy tắc sống còn - \"Bom gây thương tích, Jean tìm đến cửa\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010503,
					"content": "Xong rồi xong rồi... Lần này xong thật rồi huhuhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010505,
					"content": "\"Báu vật\" của Klee hóa ra là quả bom à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010506,
					"content": "Thật lợi hại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "Ồ, khó trách lại có tin đồn Klee có lực chiến mạnh nhất Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Paimon"
				},
