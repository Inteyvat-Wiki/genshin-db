			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "Để tôi suy nghĩ thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Bạn... cũng được, bạn nghĩ thêm đi, nếu nói về giá tiền, có lẽ tôi không phải người ra giá cao nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050503,
					"content": "Nhưng nếu nói về làm ăn, bạn bán chiếc nhẫn cho tôi, tôi tuyệt đối sẽ không để bạn thiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050504,
					"content": "Bạn nghĩ xem, chiếc nhẫn quý giá này chỉ là một vụ mua bán. Bạn bán chiếc nhẫn cho tôi, nếu sau này có vụ làm ăn gì đó, tôi nhất định sẽ nói cho bạn trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050505,
					"content": "Hơn nữa, tôi còn tặng bạn thêm chút đồ mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050506,
					"content": "Bạn nghĩ cho kỹ nhé, nếu đồng ý bán nhẫn cho tôi thì cứ đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
