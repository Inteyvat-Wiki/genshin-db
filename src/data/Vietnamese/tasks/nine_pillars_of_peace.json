				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "Muốn mời bạn xem một món đồ cổ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "Đồ cổ? Bạn tìm đúng người rồi, ở cảng Liyue này, tôi đánh giá đồ cổ là công bằng nhất, lấy ra xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050903,
					"content": "Hừm, ngọc và thân nhẫn đều là chất liệu tốt. Có vẻ như đã rất lâu đời... chiếc nhẫn được bảo quản rất tốt, thật sự hiếm có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050904,
					"content": "Có điều, dòng chữ \"Thế gian phân nạn, chúng sinh giai khổ\" này, tôi chưa từng nghe qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050905,
					"content": "Thôi bỏ đi, bạn lấy được chiếc nhẫn này từ đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050906,
					"content": "Di tích cạnh Dốc Phỉ Thúy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "Di tích cạnh Dốc Phỉ Thúy... lại dám vào đó tìm báu vật, vậy thì bạn có thân thủ khá giỏi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050908,
					"content": "Có chín cây cột xung quanh khu di tích đó, ở giữa có một bia đá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050909,
					"content": "Đừng kinh ngạc như vậy, tôi thường nghe những người kinh doanh ở đây nhắc về khu di tích đó, nói rằng trong đó rộng lớn như vậy chắc chắn cất giấu bảo bối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050910,
					"content": "Có người cho rằng, những cây cột này và di tích bên trong, đều là do tổ tiên người Liyue xây dựng lên để trấn áp chiến loạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050911,
					"content": "Có điều, có lẽ đây cũng chỉ là truyền thuyết mà thôi, nếu như chín cột đá đó có thể trấn áp chiến loạn thì thế giới đã hoà bình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050912,
					"content": "Nhưng bất kể những truyền thuyết kia là thật hay giả, chiếc nhẫn này đã nằm trong khu di tích đó thì đương nhiên có liên quan đến những truyền thuyết này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050913,
					"content": "Không chỉ có danh tiếng, còn có nguồn gốc, chất lượng tốt, đương nhiên có thể bán được giá tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050914,
					"content": "...Yên tâm đi, tôi sẽ không gặng hỏi bạn làm thế nào để mở được khu di tích đâu. Tôi chỉ làm ăn mà thôi, những việc còn lại không liên quan đến tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050915,
					"content": "Tóm lại, chiếc nhẫn này, tôi trả <color=#00E1FFFF>200.000 Mora</color>, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
