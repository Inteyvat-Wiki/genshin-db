				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "\"Tham lam, luyến tiếc, thị phi, đố kỵ, tức giận, tham muốn, kiêu căng, tranh đua, hỗn loạn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Hoa Văn"
				},
				{
					"id": 710051202,
					"content": "\"Chín loại tâm tư của người phàm, vừa có thể cứu giúp thế giới, lại có thể hủy hoại thế giới, không tăng không giảm, vẫn mãi trường tồn... Lập chín trụ cứu thế, trấn giữ sự tranh chấp của thế gian từ đây.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Hoa Văn"
				},
				{
					"id": 710051203,
					"content": "\"Nếu hậu thế phá huỷ chín trụ cứu thế, thế gian tất nổi binh đao.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Hoa Văn"
				},
				{
					"id": 710051204,
					"content": "\"Người đang đọc bia đá, có thể lấy bảo vật trong phòng, trấn thủ Liyue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoa Văn"
				}
			]
		},
