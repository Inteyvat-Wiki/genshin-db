				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "Muốn mời bạn xem một món đồ cổ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "Đồ cổ à, tôi cũng không biết nhiều... nhưng cứ lấy ra xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050303,
					"content": "Chiếc nhẫn này... tôi xem nào, ừm, chất ngọc thô này không tệ, chỉ riêng viên ngọc này cũng rất đáng tiền rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050304,
					"content": "Phía trong chiếc nhẫn... còn khắc dòng chữ \"Thế gian phân nạn, chúng sinh giai khổ\"... bạn lấy được chiếc nhẫn này từ đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050305,
					"content": "Di tích cạnh Dốc Phỉ Thúy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "Dốc Phỉ Thúy, Dốc Phỉ Thúy... chậc chậc, đáng tiếc, bên cạnh chính là Tuyệt Vân Gián...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050307,
					"content": "Nếu như chiếc nhẫn này đem ra từ di tích trong Tuyệt Vân Gián, thì chắc chắn sẽ bán được giá tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050308,
					"content": "Đáng tiếc, không có lai lịch thì giá thấp hơn rất nhiều. Nhưng chiếc nhẫn này có chất lượng rất tốt, bán ra chắc chắn sẽ có người mua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050309,
					"content": "Vậy đi, tôi trả <color=#00E1FFFF>180.000 Mora</color>, bạn có đồng ý bán chiếc nhẫn cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
