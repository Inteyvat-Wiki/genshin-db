				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "Bầu không khí trong khu di tích này luôn khiến người ta cảm thấy khó chịu, nhưng đây có lẽ đã là tận cùng của di tích này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050202,
					"content": "Chuyến đi này cũng xem như có thu hoạch, hehe, còn lấy được chiếc nhẫn kia nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050203,
					"content": "Chúng ta mau rời khỏi đây, tìm vài <color=#00E1FFFF>người biết về đồ cổ</color> đến xem bảo vật này có thể bán được bao nhiêu tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7100503,
