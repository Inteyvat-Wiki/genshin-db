				},
				{
					"id": 710050403,
					"content": "Chà, chiếc nhẫn này rất quý giá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050404,
					"content": "Phía trong di tích đó, chắc chắn vẫn còn những bảo bối khác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
