		{
			"id": 7350304,
			"completionStepIds": [
				7350304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350304",
							"2"
						],
						"stepId": 7350304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "Đây là rương báu cuối cùng rồi, lần này không cần viết câu đố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "Nhưng phải để cái gì vào rương mới được đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "Thứ có giá trị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "Cũng có lý, giá trị của thứ nằm trong rương ít nhất cũng phải xứng với công sức của người giải đố chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "Nói đến giá trị, thứ đơn giản nhất đương nhiên chính là Mora rồi, ừm... tôi để nhiều Mora một chút vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "Được rồi, mấy \"câu đố\" này xem như bố trí xong rồi, cảm ơn bạn đã giúp đỡ nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "Những thứ này cho bạn, xem như thù lao vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "Haiz, tôi vốn còn muốn đi sâu vào thảo thuận thêm về câu đố với bạn, nhưng tôi còn phải quay lại Giáo Viện xử lý vài chuyện nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "Nếu như sau này bạn phát hiện thêm câu đố mới lạ nào, hoặc là bị câu đố nào làm khó thì nhất định phải tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "Chúng ta có thể cùng nhau thảo luận về nó, sau đó... sẽ tiếp tục bố trí chúng cho các nhà mạo hiểm, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "Vậy tôi đi trước nhé, Nhà Lữ Hành, chúc bạn thuận buồm xuôi gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "Hy vọng Đạo Bảo Đoàn Narzam kia đừng gây nên phiền toái gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "Phải là thứ có giá trị thiết thực.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "Có giá trị thiết thực? Ừm... Thứ gì mới có giá trị thiết thực đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "Đúng rồi! Mấy hôm trước tôi lấy được một phần công thức nấu ăn từ chỗ người khác, để vào rương này xem như phần thưởng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "Quá trình suy luận chính là báu vật tốt nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "Hahaha, bạn nói đúng, rất đúng đó! Quá trình suy luận này đúng là kinh nghiệm vô giá! So với nó, những thứ khác gần như không có giá trị gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "Hoàn toàn không đúng! Đặt một ít Mora hay công thức nấu ăn vào đi! Không thì cho chút rau củ hoa quả gì cũng được, đừng có bỏ trống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "Đùa thôi mà, đùa thôi đùa thôi, tôi nhất định sẽ để một ít đồ vào làm phần thưởng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
