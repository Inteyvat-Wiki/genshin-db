			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "Ồ, chỗ này cũng được đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030102,
					"content": "Anh lại đang nghiên cứu câu đố sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "Nhà Lữ Hành! Bạn tới đúng lúc lắm, tôi đang chuẩn bị lên kế hoạch cho loạt câu đố liên hoàn mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030104,
					"content": "Địa hình nơi này hơi phức tạp. Bạn nhìn đi, ở một phía của bến cảng có một đoạn rễ khổng lồ của \"Cây Thánh\" bị ngập nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030105,
					"content": "Phía còn lại là một lá sen khổng lồ cùng với một đội thuyền chờ xuất cảng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030106,
					"content": "Nhà Lữ Hành, bạn thấy câu đố này nên dùng bên nào làm chủ đề thì sẽ tốt hơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030107,
					"content": "Hay là dùng bộ rễ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "Vậy sao? Bộ rễ của \"Cây Thánh\" đúng là khá bắt mắt, làm \"điểm bắt đầu\" của câu đố cũng sẽ dễ dàng đoán ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030109,
					"content": "Được! Vậy tôi sẽ lấy bộ rễ làm chủ đề để viết một câu đố mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030115,
					"content": "Hề hề hề, để tôi viết một đoạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "Hề hề hề, cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "Này, sao lại cười vui thế chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030118,
					"content": "Viết xong rồi, anh xem thử đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "\"Nơi trí tuệ trở về với biển cả, kho báu nằm dọc theo cánh buồm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030120,
					"content": "Đọc cũng được đấy! Hơn nữa câu đố này cũng rất dễ khiến người ta liên tưởng tới \"bến cảng\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030121,
					"content": "Phối hợp cùng \"Nơi trí tuệ trở về với biển cả\", cũng không khó giải ra địa điểm này có liên quan tới Giáo Viện hoặc Thành Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030122,
					"content": "Không ngờ bạn lại có tài năng ở phương diện này như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030123,
					"content": "Xin chờ một chút, tôi sẽ dán câu đố này ở chỗ nào dễ thấy mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030124,
					"content": "Hả? Dán ở gần đây ư? Nhưng nơi mà câu đố nhắc đến không xa nơi đây? Nói không chừng sẽ bị phát hiện ra ngay đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030125,
					"content": "Hahaha, tôi đang cung cấp cho người giải đố một phạm vi để giải các câu đố đó mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030126,
					"content": "Nếu không làm vậy thì phạm vi tìm ra lời giải sẽ quá lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030127,
					"content": "Drusus bắt đầu bố trí câu đố...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "Được rồi, câu đố ở đây cứ để thế đi, chúng ta tới chỗ tiếp theo nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030129,
					"content": "Hả? Còn có chỗ tiếp theo à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030110,
					"content": "Lá sen và con thuyền rất thú vị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "Đúng vậy... Có lẽ sẽ có thêm điều thú vị nếu liên kết hai thứ này lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030112,
					"content": "Không thành vấn đề, tôi sẽ dùng chủ đề này để viết ra một câu đố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030113,
					"content": "Mấy cái này đều đơn giản quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "Đơn giản? Vậy bạn có sáng kiến gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				}
			]
		},
		{
			"id": 7350302,
			"completionStepIds": [
				7350302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350302",
							"2"
						],
						"stepId": 7350302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "Được! Bố trí câu đố thứ hai ở đây, chỉ cần giải được câu đố này thì có thể lấy được rương báu cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030202,
					"content": "Tôi đã bố trí kho báu cuối cùng ở... chỗ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030203,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030204,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "Đây chẳng phải chỉ là một sườn núi bình thường, bên cạnh có một cái thác nước nhỏ bình thường thôi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030206,
					"content": "Đúng vậy! Nhưng bởi vì câu đố của chúng ta, nó sắp trở nên không còn bình thường nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030207,
					"content": "Được rồi, Nhà Lữ Hành, bạn có sáng kiến gì với câu đố này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030208,
					"content": "Đừng làm khó nữa, nên nói thẳng thì hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "Hả? Là vậy sao? Ừm... Người tìm ra lời giải trèo đèo lội suối tới đây, đúng là sẽ thấy mệt mỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030210,
					"content": "Vậy thì đơn giản một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030219,
					"content": "Không thể nói là có học thêm được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "Phải nói là quen tay hay việc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "Hóa ra là thế, không hổ là Nhà Lữ Hành, đúng là thông minh uyên bác... Được rồi, tôi sẽ bố trí câu đố mà bạn viết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030222,
					"content": "Drusus bắt đầu bố trí câu đố...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "Được rồi! Tấm bảng thông báo nhỏ này chắc là đủ bắt mắt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030224,
					"content": "Bây giờ chúng ta đi bố trí kho báu cuối cùng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030211,
					"content": "Lấy thác nước làm chủ đề đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "Ừm... Thác nước đúng là một chủ đề rất rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030213,
					"content": "Không sao hết, cứ lấy nó làm chủ đề đi. Hơn nữa độ khó của câu đố cuối cùng này... giảm bớt độ khó một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030214,
					"content": "Hề hề hề, để tôi viết một đoạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "Này! Sao bạn cười càng lúc càng gian thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030216,
					"content": "Viết xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "\"Ô xanh ôm ngọc nhìn rèm châu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030218,
					"content": "Ừm... Câu đố này đúng là đặc biệt... Bạn đã học thêm về kiến thức này ở đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				}
			]
		},
		{
