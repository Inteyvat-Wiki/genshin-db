			"dialogs": [
				{
					"id": 706900301,
					"content": "Hả? Không ngờ nhanh như vậy mà đã sắp xếp xong hết rồi. Vượt xa mong đợi của chị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900302,
					"content": "Cưng muốn phần thưởng gì nào? Nhờ cưng mà chị có cả một buổi chiều rảnh rỗi thế này đấy. Bầu bạn bên cạnh cưng cũng không tệ đâu nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900303,
					"content": "Về thù lao của tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "Chỉ cần thế thôi à? Đừng vội, chị sẽ không quên thù lao của cưng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900306,
					"content": "Hai cưng cũng phát hiện ra rồi hả? Những cuốn sách này, từ tên gọi cho đến nội dung đều rất kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900307,
					"content": "Hơn nữa, với tư cách là thư viện lớn nhất phía bắc, không thể nào nhận được nhiều sách mới chưa từng nghe tên như thế này được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900308,
					"content": "Trừ khi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900309,
					"content": "Thực ra lúc nãy chúng tôi đã gặp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706900310,
					"content": "Haha, có vẻ như là những rắc rối mà chị không muốn dây vào lắm nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900311,
					"content": "Dù sao thì đã là sách trên thế gian này, được lưu trữ trong thư viện cũng là điều cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900312,
					"content": "Để chúng ở đây vẫn tốt hơn là lưu truyền bên ngoài rồi rơi vào tay những người kỳ quặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900313,
					"content": "Đây là thù lao, lần này hai cưng vất vả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900305,
					"content": "Về những cuốn sách này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
