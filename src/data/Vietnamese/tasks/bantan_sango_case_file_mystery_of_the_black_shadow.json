					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310503,
					"content": "Vậy thì, chuyển sang mục tiêu tiếp theo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310504,
					"content": "Ơ? Còn nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310505,
					"content": "Đương nhiên rồi. Theo số lượng ủy thác nhận từ hội trưởng Sango thì đây là trường hợp động vật mất tích lớn nhất trong lịch sử Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310506,
					"content": "...Nói thì nói vậy, nhưng bình thường cũng sẽ không có nhiều thú nhỏ mất tích cùng lúc như vậy. Chuyện này dù có nói thế nào thì cũng rất không bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310507,
					"content": "Trước đó, tôi đã lần theo dấu vết ở nơi khác và phát hiện bọn thú nhỏ bị nhốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310508,
					"content": "Có cần \"lẻn vào\" không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310509
					]
				},
				{
					"id": 400310509,
					"content": "Lần này không cần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310510,
					"content": "Yên tâm, với thân pháp của bạn thì có lẽ đây cũng không phải nhiệm vụ khó nhằn gì, đến đó sẽ biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
