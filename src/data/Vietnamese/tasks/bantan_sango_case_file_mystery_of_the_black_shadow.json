			},
			"dialogs": [
				{
					"id": 400310301,
					"content": "Theo điều tra hiện tại thì chính là ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310302,
					"content": "Ồ, đúng là có rất nhiều thú nhỏ ở đây! Chúng đều bị mất tích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310303,
					"content": "Nhưng mà đây là...chó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310304,
					"content": "Chó canh gác ở đây ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310305,
					"content": "Thì ra là vậy. Thật xấu hổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310306,
					"content": "Ơ? Ryuuji sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310307,
					"content": "...Lúc đó, bóng đen giải quyết tôi trong nháy mắt, chính là nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310308,
					"content": "Đối phương quá mạnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "Không không không, không cần an ủi tôi... Là Ryuuji tôi quá yếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310312,
					"content": "Dù sao thì nhìn dáng dấp ngay thẳng, ngạo nghễ bất chấp kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310313,
					"content": "Ừm...dáng vẻ này, làm cho người ta liên tưởng đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310314,
					"content": "Phòng Trà Komore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "Chính xác! Tôi cũng nghĩ đến nó, lúc đầu tôi còn tưởng nó thật sự biết nói chuyện! Nghĩ lại nó không biết nói chuyện cũng tiếc quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310317,
					"content": "Là chủ Phòng Trà Komore sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310318,
					"content": "Í, Ryuuji biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310319,
					"content": "Cũng chỉ nghe nói thôi. Đúng là có hơi giống, nhưng cũng không thể lơ là cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310320,
					"content": "Dù sao Taroumaru cũng tiếp xúc nhiều với xã hội loài người, nó cũng rất thân thiện. Còn con chó này, chúng ta không biết gì về nó, vì vậy cẩn thận vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310321,
					"content": "Ồ, Ryuuji nói có lý đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310322,
					"content": "Chẳng qua là điều tra nhiều nên có kinh nghiệm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310323,
					"content": "Nhưng thật sự không thể hiểu được...tại sao con chó kia lại bắt bọn thú nhỏ, còn canh chừng ở đây chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310324,
					"content": "Chúng ta cần nhiều manh mối hơn. Việc quan trọng bây giờ là phải cứu bọn thú nhỏ kia trước, chắc là chủ nhân của bọn chúng đang lo lắng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310325,
					"content": "#{NICKNAME}, việc tiếp theo nhờ bạn đó. Còn chuyện sau khi tìm được bọn thú nhỏ thì để cho tôi. Tôi sẽ nhanh chóng đưa chúng về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310326,
					"content": "Anh không tham gia với tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "Đó không phải là đối thủ mà cùng xông lên là có thể đối phó được. Thực lực của đối phương khó mà dự đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310328,
					"content": "Ủa mà, bạn có kinh nghiệm trong việc \"hành động lén lút\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310329,
					"content": "Tôi từng trộm \"Đàn Thiên Không\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "...Chuyên nghiệp thật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310333,
					"content": "Bất luận thế nào đi nữa, nếu như có thể tránh được nó thì sẽ dễ dàng cứu được bọn thú hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310334,
					"content": "Tôi đã sắp xếp trước một số thứ có thể thu hút sự chú ý của nó. Hy vọng có thể giúp được bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310335,
					"content": "Vậy thì giao cho bạn đó. Tôi sẽ ở đây canh chừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310330,
					"content": "Tôi từng trốn thoát khỏi sự truy bắt trong Điển Lễ Thỉnh Tiên...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "Tôi từng lén theo dõi quan chức sai phạm ở Đảo Ritou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "Taroumaru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "Ryuuji quá yếu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "Này! Có lẽ là vì đối phương quá mạnh thôi. Chắc chắn Paimon cũng đánh không lại nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "Paimon"
				}
			]
		},
