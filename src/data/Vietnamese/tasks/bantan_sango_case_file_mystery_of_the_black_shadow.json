					"nextDialogs": [
						400315103
					]
				},
				{
					"id": 400315103,
					"content": "Cái này à...vốn dĩ định cho Ryuuji dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315104,
					"content": "Dù sao thì công việc của chúng tôi cũng không phải hoàn toàn không có nguy hiểm. Ryuuji bị thương mấy lần, cho nên muốn nhờ người làm một món đồ \"có thể chế ngự tội phạm từ xa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315105,
					"content": "Lúc đó, tôi còn xem rất nhiều sách cổ để thiết kế tấm lưới này rồi nhờ người làm. Nhưng cuối cùng, thành phẩm cũng chỉ đủ sức khống chế bọn thú nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315106,
					"content": "Dù thế nào đi nữa, nếu nó giúp được cho bạn thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315107,
					"content": "Về vụ \"Sanbongatana Kinpachi\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315108
					]
				},
				{
					"id": 400315108,
					"content": "Có hứng thú với vụ đó sao? Là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315109,
					"content": "...Nghĩ đi nghĩ lại, Ryuuji dường như không muốn thảo luận về những gì đã xảy ra vào thời điểm đó. Hay là thôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400315110,
					"content": "Tôi đi trước.",
