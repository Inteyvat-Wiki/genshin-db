			},
			"dialogs": [
				{
					"id": 400310801,
					"content": "Thật sự giúp ích rất nhiều, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310802
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310802,
					"content": "#Tôi đã nói rồi! {NICKNAME} lợi hại lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310803,
					"content": "Bạn mau xem bây giờ đã đủ số lượng thú nhỏ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310804,
					"content": "Được...vẫn còn thiếu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310805
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310805,
					"content": "Sao lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310806,
					"content": "Vẫn xem như có thu hoạch, ít nhất lần này chúng ta không bị \"bóng đen\" giải quyết, ngược lại còn cứu được không ít thú nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310807
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310807,
					"content": "Cứ như vậy, việc điều tra cũng sẽ không bị trì trệ nữa. Chỉ tiếc là bây giờ cũng không có manh mối nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310808
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310808,
					"content": "Như vậy đi, tôi sẽ tiếp tục điều tra. Các bạn có thể đi làm việc khác trước, đến lúc đó chúng ta sẽ gặp nhau tại trụ sở thám tử Bantan Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310809
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310809,
					"content": "Được, cũng đành như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
