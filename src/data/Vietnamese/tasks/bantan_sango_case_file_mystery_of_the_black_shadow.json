			"dialogs": [
				{
					"id": 400310501,
					"content": "Đúng là đáng tin cậy! Thân pháp của bạn, tôi đã thấy hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310502,
					"content": "#Hì hì, {NICKNAME} lợi hại lắm, chuyện nhỏ thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
