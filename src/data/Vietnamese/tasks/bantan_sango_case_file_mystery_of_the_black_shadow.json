	"talks": [
		{
			"id": 4003101,
			"completionStepIds": [
				4003101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003101",
							"2"
						],
						"stepId": 4003101,
						"stateName": "QUEST_STATE_UNFINISHED"
