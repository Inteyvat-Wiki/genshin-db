			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "Nhà Lữ Hành, bạn đến thật đúng lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310102,
					"content": "Một khởi đầu quen thuộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310103,
					"content": "Câu tiếp theo nhất định là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "Không hổ danh là nhà mạo hiểm chuyên nghiệp. Đúng như bạn nói, có ủy thác mới thích hợp với bạn đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310106,
					"content": "Trụ Sở Thám Tử Bantan Sango đang thiếu người, hy vọng bạn có thể giúp đỡ điều tra \"kỳ án nhiều động vật nhỏ mất tích\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310107,
					"content": "Hở? Chỉ là đi tìm các động vật nhỏ thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310108,
					"content": "#Hừm, chuyện đơn giản như vậy mà cũng cần đến {NICKNAME} ra tay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310109,
					"content": "Không sao, tôi đã từng phải chạy vặt giao đồ ăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "Hơn nữa, Bantan Sango không phải là trụ sở thám tử chuyên giải quyết các vụ án sao? Sao lại ủy thác nhà mạo hiểm vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310114,
					"content": "Là thế này, tiểu thư Sango cần một nhà mạo hiểm có nhiều kinh nghiệm để phối hợp hành động cùng với Ryuuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310115,
					"content": "Ngoài ra, để tôi xem... Tiểu thư Sango đã nhờ tôi nói thế này:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310116,
					"content": "\"Có rất nhiều thú cưng bị mất tích trong vụ án này, cho nên trụ sở trong cùng lúc đã nhận được rất nhiều ủy thác. Nếu có thể giải quyết, nhất định sẽ nhận được mức thù lao \"khủng\".\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310117,
					"content": "#Thù lao khủng...! Ừm ừm, vậy sao, {NICKNAME}, tôi thấy... những động vật nhỏ không được quay về bên cạnh chủ nhân trông thật là đáng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310118,
					"content": "Hơn nữa, bất luận là ủy thác gì cũng đều có thể giúp người ta trưởng thành hơn mà, đúng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310119,
					"content": "Paimon có tâm ghê ha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "Tóm lại, chúng ta đi tìm Sango đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310110,
					"content": "Không sao, tôi đã từng phải đi sửa chữa đồ đạc nhỏ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "Không sao, tôi cũng từng đánh bại Phong Ma Long...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "Đánh bại Phong Ma Long cũng tính là \"chuyện đơn giản\" sao...? Không hổ danh là bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 400310104,
					"content": "Có ủy thác mới đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "Khá lắm, các bạn đến còn nhanh hơn tôi tưởng tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310203,
					"content": "Còn phải nói! Chúng tôi vừa nghe nói đến thù lao khủng...À bậy, nghe nói vụ án động vật nhỏ mất tích, liền lập tức đến ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310204,
					"content": "#Bạn nói đi, là chuyện gì? Chỉ cần có tôi và {NICKNAME}, bất luận là vụ gì cũng sẽ giải quyết được hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310205,
					"content": "Nhưng người làm việc là tôi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "Paimon cũng có dốc sức động viên bạn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310207,
					"content": "Thật xông xáo. Vậy thì, chuyện là thế này. Gần đây đột nhiên xuất hiện rất nhiều ủy thác, nhờ chúng tôi tìm kiếm các động vật nhỏ bị mất tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310208,
					"content": "Những con vật này phần lớn là thú cưng nuôi trong nhà, vốn dĩ sẽ không tự ý chạy đi lung tung đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310209,
					"content": "Tuy rằng ở Inazuma quả thực có những câu chuyện kỳ lạ, nhưng vạn vật đều có nhân quả, không có chuyện gì phản logic cả. Mấy hôm nay công việc điều tra hiện trường của chúng tôi cũng đã chứng minh quan điểm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310210,
					"content": "Nhưng người làm việc là tôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310211,
					"content": "Paimon cũng sẽ cố gắng động viên anh nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "Ơ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310213,
					"content": "...Cảm ơn, không cần đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310214,
					"content": "Mấy ngày nay, lần theo dấu vết của bọn thú nhỏ mất tích, tôi tìm thấy một vài doanh trại ở ngoại thành. Có một số là của ma vật, nhưng không có vấn đề gì lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310215,
					"content": "Nhưng khi tôi muốn thả bọn thú nhỏ bị nhốt ở một trong số doanh trại đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310216,
					"content": "...thì lại \"bị một nhóm bóng đen đột nhiên xuất hiện giải quyết\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310217,
					"content": "Đến khi tôi tỉnh lại thì doanh trại không còn gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310218,
					"content": "Khó coi quá đi, Ryuuji. Trong vụ \"Sanbongatana Kinpachi\", anh giống như ác quỷ Torachiyo trong truyền thuyết vậy, khí thế khi anh gầm lên và hạ gục tên tội phạm đó đâu mất rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310219,
					"content": "Lại còn ôm lấy tôi đang giả chết, hét lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310220,
					"content": "Hội trưởng, dừng lại! Dừng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310221,
					"content": "Sau, sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310222,
					"content": "Giải quyết công việc trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "Tóm lại, \"Bantan Sango\" chúng tôi cần những nhà mạo hiểm giàu kinh nghiệm như các bạn để cùng đi cứu bọn thú nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310228,
					"content": "Nếu có các bạn, thì dù Ryuuji có bị đánh bất tỉnh, ít nhiều gì cũng sẽ có người tiếp ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310229,
					"content": "Vậy sao Sango không tự đi thử xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310230,
					"content": "Tôi sao? Tôi là người chơi hệ não, quan trọng nhất là làm việc bằng đầu óc. Đối với tôi, cơ thể chỉ là phụ kiện thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310231,
					"content": "(Woa, cô ấy lười biếng một cách hiên ngang luôn.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310232,
					"content": "Đương nhiên cũng sẽ không để các bạn làm không công rồi, nói trước là thù lao sẽ không ít đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310233,
					"content": "Thù lao!! Vậy bây giờ chúng tôi xuất phát ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310234,
					"content": "Paimon này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "Đợi đã. Trước khi đi, hãy mang theo cái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310237,
					"content": "Í? Đây là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310238,
					"content": "<color=#00E1FFFF>\"Lưới Bắt Thú\"</color>, đây là vật dụng tiện lợi mà tôi đã nhờ một người bạn làm theo \"Kamuna Onmyoudou\" ghi chép trong sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310239,
					"content": "Mặc dù nó không đủ mạnh để bắt bọn tội phạm, nhưng chỉ cần nhắm chính xác mục tiêu, thì bắt bọn thú nhỏ sẽ không thành vấn đề, có lẽ là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310240,
					"content": "Có thứ này, chắc sẽ dễ dàng tìm lại được bọn thú nhỏ mất tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310241,
					"content": "Chà, có thứ này thì mọi chuyện sẽ dễ dàng hơn rất nhiều! Hội trưởng Sango thật tốt bụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400310242,
					"content": "Đừng khen tôi như vậy, chỉ là tôi không muốn nhìn thấy các bạn làm rối tung lên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310243,
					"content": "Ryuuji nữa, anh cũng đi theo họ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310244,
					"content": "Vâng, hội trưởng Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310245,
					"content": "Mấy hôm nay tôi lại phát hiện dấu vết của bọn thú nhỏ mất tích. Đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310246,
					"content": "Vậy thì xuất phát thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "Ừm. Đi thong thả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310247,
					"content": "Cảm ơn hội trưởng Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "Vừa nghe tới thù lao là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "Sau đó thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "Úi, có hứng thú với chuyện chúng tôi đang giải quyết sao? Lúc đó, sự việc là vậy. Người lính Kinpachi tốt bụng, anh ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400310225,
					"content": "Giải quyết, giải quyết công việc trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400310226,
					"content": "Cũng đúng. Thật ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 4003103,
