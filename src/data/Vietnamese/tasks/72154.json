				{
					"id": 721540401,
					"content": "\"Phim Kiếm Trận\"...Cách đặt tên của Xavier thật là độc đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "Bạn cảm thấy bộ Phim này như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "Các đại nhân cho rằng, bộ Phim này sẽ giúp ích cho việc đánh bóng tên tuổi cho samurai Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Có lẽ tôi hơi ngốc về phương diện này...Tôi thật sự không tìm được cảm giác về mặt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "Hơn nữa, trong kịch bản các samurai toàn nói những câu rất nhụt chí, hoàn toàn không có uy nghiêm của samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "Không hiểu sao các đại nhân lại phê chuẩn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "Lò Luyện Mikage vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Từ sau khi Hanbei thăng chức, thì người phụ trách ở đó cũng đổi thành Yousuke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "Anh ta xuất thân là một người thợ thủ công, rất đáng tin, cũng rất giỏi trong việc xử lý công việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "Lò Luyện Mikage do anh ấy phụ trách, chắc sẽ không xảy ra vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
