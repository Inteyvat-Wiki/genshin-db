					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540201,
					"content": "Ây da, Phim quay như vậy thì không đúng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540202
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540202,
					"content": "Bạn hãy chuẩn bị nhé, chúng ta làm lại một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215403,
			"completionStepIds": [
				7215403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215403",
							"2"
						],
						"stepId": 7215403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "Hoàn hảo! Không hổ danh là người đặc biệt trong lòng tôi! Tấm gương thật hoàn hảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540302,
					"content": "Cái...cái gì số 1?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "Diễn viên số 1, chính là diễn viên quan trọng nhất trong Phim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540306,
					"content": "Anh sĩ binh, vừa này Nhà Lữ Hành làm mẫu, anh đã xem rõ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540307,
					"content": "Đại khái đã hiểu rồi. Lúc vung kiếm, cái tôi cần nhấn mạnh không phải là \"động tác\" vung kiếm mà là \"tư thế\" vung kiếm, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540308,
					"content": "Nếu chỉ là tư thế...thì tôi có một số ý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540309,
					"content": "Ồ? Vậy thì hay quá rồi, phiền anh nói với những vị sĩ binh kia, lát nữa chúng ta làm lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540310,
					"content": "Nhà Lữ Hành, thật cảm ơn bạn nhiều, xin bạn nhận lấy những món này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540311,
					"content": "Chủ đề của bộ Phim tiếp theo là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "Chủ đề của bộ Phim tiếp theo à...Ừm...Thật ra tôi đang do dự, có nhiều chủ đề tôi muốn thử lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540313,
					"content": "Ví dụ như truyền thống của Đền Narukami, truyền thuyết về Tanuki và hồ ly ở Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540314,
					"content": "Inazuma có nhiều đảo như vậy, sẽ có rất nhiều câu chuyện để chế tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540315,
					"content": "Nhưng bất luận thế nào, tôi cũng phải làm xong bộ \"Vị Samurai Thứ 7\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540316,
					"content": "Nếu có thể làm hài lòng các vị đại nhân, thì sau này khi tôi làm Phim ở Inazuma, chắc sẽ tiện hơn nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540304,
					"content": "Lần sau tôi muốn đổi nhân vật mới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "Không thành vấn đề! Chờ quay xong Phim này, tôi sẽ lên kế hoạch cho bộ Phim mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				}
			]
		},
