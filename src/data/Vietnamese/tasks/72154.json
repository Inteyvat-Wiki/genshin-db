	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "Chờ đã! Vị sĩ binh đây, tâm trạng lúc anh đọc lời thoại có vẻ chưa đúng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540102,
					"content": "\"Samurai, giống như làn gió mát cuốn qua mặt đất.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540103,
					"content": "Có nhớ về vở kịch trước đây tôi kể với anh không, phải có cảm giác thoải mái, bao dung, thoải mái, thoải mái có hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540104,
					"content": "Đây là yếu tố then chốt của cả vở kịch, anh phải biểu đạt một cách thật hoàn chỉnh, đầy đủ, hoàn mỹ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540105,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540106,
					"content": "Còn lúc vung kiếm, đừng nhanh như vậy, nhất định phải đảm bảo mình ở trong ống kính, nếu không thì Máy Quay sẽ không ghi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540107,
					"content": "Tạo tư thế trước đi, rồi giữ nguyên ở đó, hiểu không? Ngừng lại một chút, rồi chém mạnh xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540108,
					"content": "Nhưng mà khi đang quyết đấu, thì không thể vung kiếm như vậy được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540109,
					"content": "Đây là yêu cầu của cốt truyện và chế tác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540110,
					"content": "Bạn hãy chuẩn bị nhé, chúng ta làm lại một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540111,
					"content": "Các bạn đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "Ây da, là bạn sao! Nhà Lữ Hành thân mến, ngọn gió nào đã đưa bạn đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540115,
					"content": "Như bạn thấy, tôi đang cùng vị sĩ binh đây quay một bộ phim, có tên là \"Vị Samurai Thứ 7\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540116,
					"content": "À, Phim Kiếm Trận là tên gọi chung do tôi đặt cho loại Phim này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540117,
					"content": "Là bộ phim ghi lại cảnh va chạm của đao kiếm, để người xem có cảm giác như mình đang tham gia vào trận đấu vậy... Đại khái là ý như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540118,
					"content": "Toranosuke lại có thời gian rảnh vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "Đây là việc đã được các đại nhân ở trên phê chuẩn, theo đại nhân nói, như vậy cũng sẽ giúp ích cho việc đánh bóng tên tuổi của samurai Shogunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540120,
					"content": "Tuy rằng tôi không biết Xavier làm sao thuyết phục được các đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540123,
					"content": "Nhưng nói thật, vị Mikoshi Genjirou đại nhân này quả thật là...vô cùng nghiêm khắc, nhưng đồng thời cũng rất thấu tình đạt lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540124,
					"content": "Sau khi tôi giải bày một cách vô cùng thành khẩn, ông ấy rất vui vẻ chấp nhận thỉnh cầu của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540125,
					"content": "Nhưng mà...đổi lại, thì tôi phải làm trước một bộ Phim về Shogunate, tốt nhất là lấy samurai làm nhân vật chính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540126,
					"content": "Tôi vốn cũng hứng thú với đề tài này, đương nhiên là nhận lời ngay, vị Mikoshi đại nhân đó cũng rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540127,
					"content": "Ngoài việc đích thân ủy thác sĩ binh đồng hành cùng tôi, thì còn phái thêm mấy vị binh sĩ có thân thủ tốt cho tôi, ông ấy nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540128,
					"content": "\"Dùng cảnh tượng đao kiếm va vào nhau để thể hiện sự uy nghiêm của samurai và Shogunate.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540129,
					"content": "Không thể không nói, vị Mikoshi đại nhân này quả thật có mắt nhìn xa, có thể nghĩ đến việc dùng Phim để tuyên truyền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540130,
					"content": "Nhưng đối với tôi, mọi chuyện giúp ích cho việc chế tác Phim của tôi, thì tôi đều không từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540131,
					"content": "Bạn chế tác có thuận lợi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "Nói thật thì...Không mấy thuận lợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540133,
					"content": "Tuy rằng vị sĩ binh đây võ nghệ cao cường, nhưng lại không quen với cách chiến đấu \"kiểu nghệ thuật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540134,
					"content": "Không những vung đao nhanh đến mức Máy Quay không thể quay được, mà còn có lúc diễn một hồi là chạy khỏi ống kính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540140,
					"content": "Nhà Lữ Hành, nếu có thời gian, bạn có thể làm theo kịch bản của tôi, vào diễn một lần cho vị sĩ binh đó xem thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540141,
					"content": "Tôi tin rằng, với thực lực và khả năng am hiểu của bạn, diễn xuất trước ống kính sẽ rất tự nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540142,
					"content": "Xem diễn xuất từ góc độ khán giả xong, có lẽ họ sẽ hiểu rõ cốt truyện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540143,
					"content": "Đây đây đây, bạn xem kịch bản này, lời thoại chỉ xem qua loa là được, đoạn này chủ yếu là hành động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540144,
					"content": "\"Trận chiến này, cũng xem như đã thua rồi.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "A...Đây là lời thoại của đoạn khác...Đoạn này chủ yếu là đánh nhau, không có lời thoại gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540148,
					"content": "Để tôi xem kịch bản...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "À đúng rồi, vai mà bạn diễn có tên là Juusaburou, anh ta và mấy người bạn được dân làng thuê để bảo vệ làng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540150,
					"content": "Ây, đoạn này còn có một người bạn tên Kyuuzou có lời thoại...Lời thoại này để tôi nói là được, chúng ta làm thử một lần trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540151,
					"content": "Bạn nhất định phải hòa nhập vào nhân vật này, thấu hiểu nhân vật này! Xem mình là Juusaburou, bạn hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540152,
					"content": "Hiểu, hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "Tốt, rất tốt, tốt cực kỳ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540155,
					"content": "Chuẩn bị sẵn sàng thì nói với tôi, tôi điều chỉnh vị trí Máy Quay một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540153,
					"content": "Tôi chính là Juusaburou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "\"Cho dù gặp nạn, samurai vẫn là samurai.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "\"Các ngươi đều là người rơm đúng nghĩa.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "\"Nhưng kẻ địch không phải là chim sẻ.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "Tôi có thể diễn một vai không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "Đương nhiên! Đương nhiên! Bạn mãi là người đặc biệt trong lòng tôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540137,
					"content": "Bộ \"Câu Chuyện Tatara\" đó tôi vẫn luôn ghi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540138,
					"content": "Huống hồ...Tuy rằng vị sĩ binh đây võ nghệ cao cường, nhưng lại không quen lắm với cách chiến đấu \"kiểu nghệ thuật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540139,
					"content": "Không những vung đao nhanh đến mức Máy Quay không thể quay được, mà còn có lúc diễn một hồi là chạy khỏi ống kính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540121,
					"content": "Bạn làm cách nào thuyết phục họ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "Anh sĩ binh đã sớm hiểu cho tôi, công việc chính của tôi, chủ yếu là thuyết phục Mikoshi Genjirou đại nhân, xin ông ấy cho phép tôi làm phim ở Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540112,
					"content": "\"Samurai, giống như làn gió mát cuốn qua mặt đất.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "Câu này của anh ngữ điệu quá cao ngạo rồi, nên là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
