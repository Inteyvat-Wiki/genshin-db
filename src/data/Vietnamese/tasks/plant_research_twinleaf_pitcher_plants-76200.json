			"dialogs": [
				{
					"id": 762000801,
					"content": "Mèo ngốc... rốt cuộc đi đâu rồi... Ơ? Em tìm thấy nó rồi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000802,
					"content": "Nó bị mắc kẹt trong đám Cây Nắp Ấm Lá Đôi ở bên kia. Tuy là thực vật, nhưng đó là loài săn mồi ăn thịt, tiêu hóa Đom Đóm Ánh Trăng cũng chỉ mất có vài ngày thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000803,
					"content": "May mà phát hiện sớm. Hiện tại nó chỉ hơi yếu thôi, nếu muộn hơn nữa thì khó nói lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000804,
					"content": "Ng-nguy hiểm đến vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000805,
					"content": "Cũng đều tại nó tự chui đầu vào thôi, đúng là một con mèo ngu ngốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000806,
					"content": "Cũng không thể đổ lỗi cho nó được, vì Cây Nắp Ấm Lá Đôi tỏa ra một mùi hương đặc biệt, tuy không ảnh hưởng gì đến con người nhưng lại hấp dẫn côn trùng các loại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000807,
					"content": "Đó là cách Cây Nắp Ấm Lá Đôi bắt mồi. Số lượng Cây Nắp Ấm Lá Đôi trong khu vực này nhiều bất thường, nên ngay cả các động vật nhỏ cũng bị ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000808,
					"content": "Hmm... ừm, nói chung loại thực vật này mọc nhiều vậy, chắc chắn không phải chuyện tốt lành gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000809,
					"content": "Ừm, nếu cứ để mặc thế này thì có thể sẽ gây hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000810,
					"content": "Được rồi, việc nhổ bỏ cứ để chúng tôi lo. Jukka, cùng đến giúp một tay nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000811,
					"content": "Chúng đã khiến mèo ngốc chịu khổ lâu vậy, chúng ta cũng phải trả đũa mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000812,
					"content": "Cùng hai thợ săn kho báu dọn sạch Cây Nắp Ấm Lá Đôi sinh trưởng bất thường trong khu vực này...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "Phù! Cuối cùng cũng xong. Chúng ta cũng nên quay về Thị Trấn Nasha thôi... Em gái trẻ, cảm ơn nhiều vì đã giúp chúng tôi tìm thấy con mèo ngốc này nhé. Nếu không nhờ em giúp đỡ, không biết nó còn phải mắc kẹt bao lâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000814,
					"content": "Nhưng mà nói thật, nếu không phải lúc nãy Marja hét to như vậy thì có khi chúng ta đã sớm tìm thấy nó rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000815
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000815,
					"content": "Đ-đừng có nói nhiều! Dù sao thì giờ nó đã quay về an toàn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000816
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000816,
					"content": "(Tuy luôn miệng gọi là mèo ngốc, nhưng thực ra vẫn rất quan tâm đến người bạn này mà.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000817
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000817,
					"content": "Đúng vậy, hiện giờ nó bình an vô sự mới là quan trọng nhất. Dã ngoại vẫn rất nguy hiểm, mọi người cũng phải cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000818
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000818,
					"content": "Cảm ơn nhé, hai chúng tôi sẽ cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000819
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000819,
					"content": "Chúc em điều tra thuận lợi nhé, hẹn gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marja"
				}
			]
		},
