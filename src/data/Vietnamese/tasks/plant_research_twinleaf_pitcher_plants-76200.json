			"dialogs": [
				{
					"id": 762000201,
					"content": "Em gái ơi, làm phiền một chút, em có thấy con \"mèo vằn hổ\" nào ở gần đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000202,
					"content": "Mèo vằn hổ à? Hình như là không có. Lumi có thấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000203,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000204,
					"content": "Có vẻ Lumi cũng không rõ... Mọi người bị mất mèo à? Em có thể giúp mọi người tìm! Khu vực này em khá quen thuộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000205,
					"content": "Này, Jukka! Mình đâu có dư tiền để thuê nhà mạo hiểm, hơn nữa chỉ là một con mèo ngốc thôi, cùng lắm thì không cần nó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000206,
					"content": "Marja, đừng nói vậy, nó nghe thấy sẽ buồn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000207,
					"content": "Nó chẳng nghe thấy đâu! Nếu nghe được thì đâu đến mức chúng ta gọi mãi mà cũng chẳng thấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000208,
					"content": "Chuyện nhỏ này không lấy phí đâu, hơn nữa em cũng đang phải điều tra gần đây, coi như tiện đường vậy. Đi thôi, Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000209,
					"content": "(Mấy hôm trước còn chẳng có gì, giờ lại mọc đầy Cây Nắp Ấm Lá Đôi thế này...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000210,
					"content": "(Có thể là một con vật nào đó đã mang theo hạt giống Cây Nắp Ấm Lá Đôi đến đây, nhưng cứ để chúng phát triển như vậy thì không ổn...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
