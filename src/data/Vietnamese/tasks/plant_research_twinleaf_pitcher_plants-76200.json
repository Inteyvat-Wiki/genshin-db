			"dialogs": [
				{
					"id": 762000501,
					"content": "Lumi cũng cảm thấy nó ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000502,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000503,
					"content": "Giải cứu \"mèo vằn hổ\" bị mắc kẹt...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "Ngươi là con mèo mà họ đang tìm nhỉ? Trông không có vết thương ngoài da, nhưng nếu muộn hơn nữa thì khó nói lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000505,
					"content": "Dù sao đi nữa, quay về tìm bạn bè của ngươi trước nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
