				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530902,
					"content": "Phân tích cho tôi nghe xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "Ừm, đầu tiên là căn cứ theo thông tin Katayoun cung cấp, cơ bản có thể đoán ra thân phận thật sự của Tiên Linh là sinh viên của Học Viện Rtawahist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530904,
					"content": "Dù sao cũng đã loại trừ khả năng người ngoài vào, không có cách nào qua mặt quản lý mà lấy đi hai cuốn sách đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530905,
					"content": "Tiếp theo, ngoại trừ siêu năng lực đáng kinh ngạc, tất cả các địa điểm nhìn thấy đều là địa điểm quan sát tinh tượng do học viện của chúng tôi đề xuất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530906,
					"content": "Nói cách khác... có thể nó chỉ đang nghiên cứu, và nội dung nghiên cứu rất giống với của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530907,
					"content": "Những câu hỏi tôi đưa ra không đơn giản, nhưng nó có thể trả lời hết trong một ngày, chứng tỏ nó cũng có kiến thức tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530908,
					"content": "Vậy thì chỉ cần dựa theo suy đoán này, đến địa điểm quan sát tinh tượng tiếp theo chờ nó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530909,
					"content": "Lý luận rất rõ ràng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "Quá, quá khen... Thật ra còn một số lý do khác đã được suy đoán từ lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530912,
					"content": "Nhưng mà điều này không quan trọng, chúng ta đi trước đi, cho dù đã có manh mối, nhưng có kết luận hay không vẫn rất khó nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530913,
					"content": "Còn về việc tại sao tôi nghĩ như vậy... Nếu nó thật sự không đến, tôi sẽ nói cho bạn biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530910,
					"content": "Có khả năng suy đoán như vậy, việc hoàn thành luận văn chắc chắn không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}