			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "Mọi người đã cung cấp rất nhiều thông tin giá trị, chúng ta sắp xếp nó lại đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530802,
					"content": "Mặc dù có một số nghe rất dễ hiểu, nhưng một số khác lại rất khó hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530803,
					"content": "Chắc là có thể nắm bắt được thân phận và hành tung của nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "Ừm, tôi thử xem, để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530805,
					"content": "(Layla ơi là Layla, bình tĩnh, mặc dù manh mối rất lộn xộn, nhưng mình nhất định làm được.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530806,
					"content": "(Đầu tiên, dựa trên manh mối hiện có, liên tưởng đến thân phận của Tiên Linh.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530807,
					"content": "(Tiếp theo là phân tích quỹ đạo hành động và động cơ hành vi của nó, và cuối cùng kết hợp các suy luận trước đó...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530808,
					"content": "(Như vậy đại khái sẽ có được chiến lược hành động, ừm, thử theo cách này xem.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
