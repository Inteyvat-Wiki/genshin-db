			"dialogs": [
				{
					"id": 761410101,
					"content": "Chào mừng hai vị trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410102,
					"content": "Nhưng vẫn chưa tới lúc chúng ta phải lưu luyến không nỡ từ biệt nhau đâu, mọi người vẫn chưa tham quan xong căn nhà nhỏ này mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410103,
					"content": "Không phải đã vào xem hết các phòng rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410104,
					"content": "Tôi đâu có nói là không có căn phòng bí mật. Ma nữ mà, ai mà chẳng có vài suy nghĩ riêng, các vị nên bắt đầu quen dần đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410105,
					"content": "Mời đi bên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
