			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "Là một trong những điểm quan trắc bất động của thế giới biến động, tôi cần có điều kiện tầm nhìn tốt. Giống như nhà điêu khắc không thể thiếu cái đục, nhà văn không thể thiếu bút mực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410202,
					"content": "Những thành tựu mà tôi đạt được trong hai lĩnh vực đó thì bàn sau vậy, nhưng đối với công việc của mình, tôi rất nghiêm túc đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410203,
					"content": "#{NICKNAME}, {F#cô}{M#cậu} hẳn cũng cảm nhận được, gần đây tình trạng \"vận mệnh\" của Teyvat bị lay động đang ngày càng trở nên thường xuyên hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410204,
					"content": "Đôi khi tôi cũng không khỏi nghĩ, nếu tôi vẫn còn giữ được hình thái, sức mạnh và năng lực của thời kỳ đỉnh cao năm xưa, việc tôi có thể làm chắc chắn còn nhiều hơn bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410205,
					"content": "Nhưng rồi tôi lại nhanh chóng phủ định chính mình, bởi nếu thế, những hạn chế mà tôi phải nhận từ trời cao cũng sẽ ngày càng nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410206,
					"content": "Cứ nghĩ đến việc có thêm nhiều chủ đề không được chạm tới lại cảm thấy không đáng, vậy tôi phải kể chuyện như thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410207,
					"content": "Bởi vậy, tôi không hề hối hận về cái giá mình phải trả, cũng không hối hận về bất kỳ lựa chọn nào trên con đường này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410208,
					"content": "Tôi muốn trở thành con người, sống như một người bình thường... Nhưng dù sao cuộc sống kiểu đó cũng quá xa xỉ, tôi sẽ không quên mình là một thiên sứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410209,
					"content": "Dù chỉ là thiên sứ lặng im, tôi vẫn sẽ hoàn thành chức trách của mình. Bảo vệ nền văn minh, bảo vệ sinh linh trên mặt đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410210,
					"content": "Ôi, hình như không cẩn thận làm chủ đề trở nên nghiêm túc rồi thì phải! Chắc tại chỗ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410211,
					"content": "Thật ra tôi khá hài lòng với phần Thiên Sứ trong con người mình, thậm chí có thể nói là tự hào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410212,
					"content": "Đúng, đúng vậy, Nicole rất lợi hại! Tuy không thường xuyên ra tay, nhưng mỗi lần ra tay đều khiến mọi người rất yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410213,
					"content": "Đúng là nên tự hào mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "Thật sao? Haha, nếu những gì mọi người ghi nhớ là hình ảnh đáng tin cậy của tôi thì tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410215,
					"content": "Không còn sớm nữa. Đi đi, mang theo lời chúc phúc của tôi, tiếp tục hành trình mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410216,
					"content": "Đừng sợ lạc đường, đừng quên có một thiên sứ ở đây lặng lẽ dõi theo hành trình của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
