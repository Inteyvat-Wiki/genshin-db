			"dialogs": [
				{
					"id": 790550101,
					"content": "Đây là một cảnh bị bỏ đi trong phim ngắn Giấc Mơ Đắm Tàu",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790550102,
					"content": "Ban đầu nó là câu chuyện về hai Eidolon Thủy yêu nhau trên một con tàu bị hỏng đang trôi nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790550103,
					"content": "Sau khi chúng bày tỏ tình cảm, khung cảnh mũi tàu trong ánh chiều tà hẳn là khá lãng mạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790550104,
					"content": "Tuy nhiên, lý do phim trường bị bỏ dở là vì... hai diễn viên Eidolon Thủy đó quá hoạt bát, và không thể ngừng di chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790550105,
					"content": "Ừm, nếu có thể chụp được cảnh <color=#00E1FFFF>cả hai cùng xuất hiện ở mũi tàu</color> thì quá tuyệt...",
