			"dialogs": [
				{
					"id": 1903102101,
					"content": "Đi ở đây một mình nguy hiểm lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102102,
					"content": "Vì bạn không biết được sẽ gặp phải người gì, hoặc là, có phải người hay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102103,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "Hừ hừ, không ngờ bạn khá bình tĩnh đó. Tục ngữ có câu, đi lại bên hồ thì làm gì không ướt giày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102106,
					"content": "Đi lại ở nơi âm u quỷ dị này không chừng sẽ nhìn thấy những thứ không nên thấy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102107,
					"content": "Chỉ cần nhìn thấy, nó sẽ biến thành ác mộng, đeo bám theo bạn suốt đời suốt kiếp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102108,
					"content": "Hả, vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "Không đúng, sao bạn bình tĩnh thế, người bình thường nghe tôi nói được một nửa là bị dọa cho chạy mất dép rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102111,
					"content": "Vì trông bạn chỉ là một người thường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "Tuy nói vậy, nhưng thủ thuật hóa trang thành ma quỷ điêu luyện, chính là lợi dụng tâm lý sợ hãi của đối phương để tạo ra bầu không khí khủng khiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102113,
					"content": "Còn về tôi là người thế nào, thì không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102117,
					"content": "Cho nên với những người không tin vào ma quỷ như bạn, thì tôi có dùng cách gì để hù dọa cũng vô ích thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102118,
					"content": "Tôi thấy bạn chỉ đang tìm lý do để lười biếng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "Đừng nói vậy mà, được rồi, tôi phải đi tìm những kẻ nhát gan khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102120,
					"content": "Bạn cũng nhanh trở về tìm bạn đồng hành của mình đi, coi chừng đã bị dọa chết khiếp rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102114,
					"content": "Các bạn không có đồ hóa trang sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "Có thì có, nhưng mặc vào nóng quá...thủ thuật hóa trang thành ma quỷ điêu luyện, chính là lợi dụng tâm lý sợ hãi của đối phương để tạo ra bầu không khí khủng khiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102116,
					"content": "Còn về tôi là người thế nào, thì không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102109,
					"content": "Không hiểu lắm, cho hỏi bạn có việc gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
