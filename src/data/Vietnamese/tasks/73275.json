				{
					"id": 732750102,
					"content": "Trồng ra hoa Tường Vi Vàng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "Hả... Ái chà, những hạt giống hoa này tìm được ở đâu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "Nhặt được ở nơi rất xa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Hạt giống mà chú Shafaqat rải quả đúng là đi đến mọi ngóc ngách của sa mạc, thế nhưng cuối cùng rồi cũng quay về đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "Hãy chăm sóc cẩn thận cho những bông hoa non này nhé, ta muốn để lại cho Sabbah. Đợi khi ta không có ở đây, những bông hoa này sẽ giao lại cho nó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "Cảm ơn cháu nhé, ta không có gì cho cháu, hãy cầm tạm những bông hoa và trái cây này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
