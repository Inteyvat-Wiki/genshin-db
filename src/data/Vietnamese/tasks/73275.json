					"nextDialogs": [
						732750308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750308,
					"content": "Cháu đã giúp ta rất nhiều, tuy cháu nói không cần thù lao, nhưng ta cũng thấy áy náy lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750309,
					"content": "Những nhánh hoa này mới nảy mầm, Sabbah đề nghị tặng nó cho cháu, còn trang trí nó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750310,
					"content": "Hy vọng nó có thể kiên định giống cháu, mãi mãi không mất đi sự tự tin.",
