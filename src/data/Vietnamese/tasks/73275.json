			"dialogs": [
				{
					"id": 732750501,
					"content": "Về những bài ca dao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "Cháu vẫn nhớ bài ca dao này sao... Lại có một người trẻ tuổi nhớ được nó rồi. Haha, đúng là chuyện tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "\"Tường vi ơi tường vi, hãy thực hiện nguyện vọng của ta. Hoa nở từ đá, Tường Vi Vàng ca hát cho ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "\"Ta chẳng tồn tại trong đất cát, chỉ ẩn chứa trong thơ ca. Ca dao đánh tan số phận, viết lại kết cục của ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "\"Đánh bại ta, đánh bại thời gian, đánh bại sự tan biến luôn trường tồn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
