			},
			"dialogs": [
				{
					"id": 760034015,
					"content": "Tay nghề của Katya thật tuyệt... Thôi để từ từ rồi về Novokitezhgrad vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034016,
						760034002,
						760034011
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034016,
					"content": "Netochka, lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034017
					]
				},
				{
					"id": 760034017,
					"content": "Ôi trời, định so tài ngay bây giờ sao? Thế này là đánh lén đó! Nếu nhất định phải so tài thì hẹn lúc khác được không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034018
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034018,
					"content": "Tôi còn muốn thảnh thơi chơi một thời gian nữa, trước giờ tôi còn chưa đi dạo Thị Trấn Nasha một cách đàng hoàng. Hay là chuyện thi đấu để sau nói nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034002,
					"content": "Về Novokitezhgrad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034003
					]
				},
				{
					"id": 760034003,
					"content": "Khi sống ở đó, tôi thường cảm thấy ngột ngạt, nhưng một khi rời đi lại có chút nhớ nhung... đây là lần đầu tiên tôi đi xa nhà như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034004
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034004,
					"content": "Tôi vốn tưởng những nơi khác cũng giống như Novokitezhgrad, sẽ có rất nhiều fae sinh sống, ngay cả Snezhnograd cũng có không ít fae mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034005
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034005,
					"content": "Kết quả đến Nod-Krai, chẳng thấy một ai cả, Paimon cũng nói mình không phải. Chắc không phải vì họ không thích khí hậu ở đây đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034013
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034013,
					"content": "Dù sao ở đây cũng không có bão tuyết, ở ngoài trời cũng không đến nỗi phải bó tay vì không có lò sưởi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034014
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034014,
					"content": "Đúng rồi, tôi thấy ở Nod-Krai có người uống loại rượu sản xuất ở Novokitezhgrad đó. Tuy biết ngành rượu cũng nổi tiếng không kém gì khoáng sản, nhưng nhìn thấy nó ở đây vẫn thấy... xúc động?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034011,
					"content": "Hẹn gặp lại sau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034012
					]
				},
				{
					"id": 760034012,
					"content": "Ừm! Trước lúc đó, chúc cho chúng ta đều gặp may mắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				}
			]
		},
