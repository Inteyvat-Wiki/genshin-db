			"dialogs": [
				{
					"id": 740920101,
					"content": "Tại sao... Tại sao lại như vậy chứ... Chết tiệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920102,
					"content": "Tiểu thư Chronie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}! {F#Cô}{M#Cậu} tới rồi, tốt quá... Ít nhất thì {F#cô}{M#cậu} cũng biết chân tướng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920105,
					"content": "Cô Chronie, cô bình tĩnh lại chút đi, cô... sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920106,
					"content": "Chỉ là... bài viết của tôi không được lên báo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920107,
					"content": "Bài viết của cô sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "Ừm, chúng tôi còn đang thấy lạ, không biết khi nào mới được đọc bài báo cô viết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920109,
					"content": "Không thấy... Không thể đọc... Đúng, đúng vậy... Hẳn là hai người chưa đọc được đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920110,
					"content": "Sao trông cô... hoảng hốt vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "Chuyện là thế này... Sau khi quay về từ Viện Khoa Học Fontaine, tôi lập tức bắt tay vào việc soạn bài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920112,
					"content": "Tôi đã viết ra tất cả những gì mình đích thân nghe, nhìn và cảm nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920113,
					"content": "Ví dụ, Viện Khoa Học Fontaine vẫn chưa loại bỏ hết Arkhium. Lại còn khởi động hạng mục khác có liên quan tới Arkhium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920114,
					"content": "Một cấp dưới cũ của Edwin được cử đi thăm dò phế tích Viện Khoa Học Fontaine, nhưng lại bỏ mạng trong vụ nổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920115,
					"content": "Cán bộ kỹ thuật cấp cao của Viện Khoa Học Fontaine là Raimondo từ chối thừa nhận cái chết của người đó, còn kiên quyết cho rằng vụ nổ vốn đã nằm trong kế hoạch của viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920116,
					"content": "Cả chuyện về những cỗ máy khổng lồ mất kiểm soát, nước bị ô nhiễm trong phế tích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920117,
					"content": "Tất cả những chuyện mà Viện Khoa Học Fontaine muốn che giấu, tôi đều viết ra hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920118,
					"content": "Nhưng sau khi tôi nộp bài báo này lên, lại nhận được thông báo đã bị Viện Khoa Học Fontaine gửi đơn kiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920119,
					"content": "Theo quy định của tòa soạn, tất cả nội dung liên quan đến Viện Khoa Học Fontaine trong bài viết đều phải tiếp nhận \"kiểm tra độ tin cậy\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920120,
					"content": "Một vài bài báo có liên quan tới Viện Khoa Học Fontaine cũng bị gỡ xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920121,
					"content": "\"Kiểm tra độ tin cậy\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "Không, kiểm tra này không nhắm vào bài báo, mà nhắm vào con người tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920124,
					"content": "Nói đơn giản, Viện Khoa Học Fontaine kiện tôi vì xung đột lợi ích, đưa ý kiến chủ quan vào bài báo, đưa ra thông tin sai lệch cho công chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920125,
					"content": "Nhưng cô có xung đột lợi ích với Viện Khoa Học Fontaine sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "Cô Chronie chỉ chụp vài bức ảnh, trong đó toàn là đất đá với máy móc không hoạt động... Vậy thì \"xung đột lợi ích\" gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920127,
					"content": "Chà, hay cô đã tiết lộ đạo đức nghề nghiệp của họ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "Bọn họ... cáo buộc tôi tiết lộ mẫu Fonta mới nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920129,
					"content": "Người của Viện Khoa Học Fontaine nhất quyết cho rằng bức ảnh mà tôi chụp ở phế tích có một phần liên quan tới đề án thiết kế Fonta mẫu mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920130,
					"content": "Bọn họ phải kiểm tra từng bức ảnh. Hiện tại, Viện Khoa Học Fontaine sẽ không rút đơn kiện, tôi cũng tiếp tục bị kiểm tra độ tin cậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920131,
					"content": "Chắc chắn, đây chính là thủ đoạn Viện Khoa Học Fontaine dùng để ngăn cản tôi đưa tin... Nhưng tôi sẽ không từ bỏ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920132,
					"content": "Đây, cầm lấy! Bài báo này là tôi lén đem ra ngoài in, lát nữa tôi sẽ ra ngoài và phân phát chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920133,
					"content": "Tôi nhất định sẽ cho tất cả mọi người biết rõ chân tướng và bộ mặt thật của Viện Khoa Học Fontaine, còn có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920134,
					"content": "Tiểu thư Chronie! Sao cô còn ở đây, tôi đang tìm cô đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920135,
					"content": "Ôi trời! Có người tới, tôi không thể ở đây nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920136,
					"content": "Hãy cầm lấy tờ báo này, nhất định phải cất thật kỹ, toàn bộ chân tướng đều được tôi viết trên đó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920137,
					"content": "Theo quy định, giờ cô phải tới Sảnh Phúc Luật để tiếp nhận kiểm tra định kỳ mỗi ngày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920138,
					"content": "Ấy! Cô đừng chạy chứ, tiểu thư Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920139,
					"content": "Cũng chỉ là Fonta thôi mà, biết đâu là hiểu lầm thôi! Chỉ cần giải thích rõ ràng thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920140,
					"content": "Đợi đã! Xin đợi đã, tiểu thư Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920122,
					"content": "Tòa soạn cho rằng bài báo của cô không đáng tin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "Cô làm gì ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}