			"dialogs": [
				{
					"id": 80160301,
					"content": "Mavuika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160302
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160302,
					"content": "#Ồ? Mọi người đến rồi sao, tôi đang định phái người đi tìm cô đấy, Iansan. Giờ {NICKNAME} cũng ở đây rồi thì càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160303
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160303,
					"content": "Tình hình hiện tại thế nào? Có tin tức gì gửi về không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160304
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160304,
					"content": "Hiện tại ở khắp Natlan đều đang xuất hiện thành viên của Giáo Đoàn Vực Sâu, đây rõ ràng là hành động có tổ chức và kế hoạch từ trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160305
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160305,
					"content": "Số lượng kẻ địch khá đông. Nếu không phải chuyện lần này thì đúng là không ngờ được thế lực của Giáo Đoàn Vực Sâu đã âm thầm phát triển đến mức này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160306
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160306,
					"content": "Cũng có nghĩa chúng đang toàn lực tấn công chúng ta à? Nhưng mục đích của chúng là gì...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160307
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160307,
					"content": "Đây cũng là điều mà tôi thắc mắc. Trước đây Giáo Đoàn Vực Sâu không có nhiều hoạt động tại Natlan, cũng chưa từng có xung đột gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160308
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160308,
					"content": "Chắc chúng không phải làm vậy vì để... trả thù cho việc Vực Sâu bị Natlan đánh bại đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160309
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160309,
					"content": "Tuy lý do này nghe có hơi quá, nhưng nếu là chúng thì cũng không có gì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160310,
					"content": "Hiện vẫn chưa thể đưa ra kết luận. Chúng ta vẫn phải lưu ý thêm mục đích thực sự của chúng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160311
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160311,
					"content": "Vậy tình hình trận chiến như thế nào rồi? Mức độ thương vong không đáng lo ngại chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160312,
					"content": "Tuy nói là chúng dốc toàn lực xuất binh, nhưng đối thủ mà Giáo Đoàn Vực Sâu hiện đang phải đối mặt, là các dũng sĩ Natlan vừa mới đối đầu và chiến thắng Vực Sâu thực sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160313
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160313,
					"content": "Không sai. Hơn nữa lực lượng phe ta cũng vô cùng đông đảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160314
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160314,
					"content": "Sức mạnh của Giáo Đoàn Vực Sâu vẫn còn thua xa so với Vực Sâu thực sự, chúng không thể liên tục bổ sung lực lượng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160315
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160315,
					"content": "Nhưng dù sao cũng là chiến tranh, chúng ta nhất định phải cẩn trọng, cố gắng giảm thiểu thương vong nhất có thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160316
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160316,
					"content": "#Hiện tại các bộ tộc đã tích cực phối hợp phòng ngự rồi. {NICKNAME}, đây là chuyện nội bộ của Natlan, nên {F#cô}{M#cậu} có thể chọn ở lại Đấu Trường Lửa Thánh cùng với tôi và...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160317
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160317,
					"content": "Không, chuyện này có liên quan đến tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160318
					]
				},
				{
					"id": 80160318,
					"content": "#Ồ? Ý {F#cô}{M#cậu} là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160319,
						80160320
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160319,
					"content": "Lãnh đạo hiện tại của Giáo Đoàn Vực Sâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				},
				{
					"id": 80160321,
					"content": "Đúng, chuyện là vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160322,
					"content": "Không ngờ lại có chuyện như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160323
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160323,
					"content": "#Nếu vậy, {F#cô}{M#cậu} có biết mục đích của {M#cô}{F#cậu} ấy là gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160324
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160324,
					"content": "Đây cũng là điều mà tôi luôn muốn tìm hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160325
					]
				},
				{
					"id": 80160325,
					"content": "Ít nhất thì bây giờ mối quan hệ giữa hai người họ không được tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160326,
					"content": "#{NICKNAME} luôn muốn tìm {M#cô}{F#cậu} ấy để làm rõ xem rốt cuộc là đã xảy ra chuyện gì... Nhưng {M#cô}{F#cậu} ấy lại luôn lảng tránh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160327,
					"content": "Thì ra là vậy. Chuyện anh em mâu thuẫn, hmm... cũng rất thường thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160328
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160328,
					"content": "Thì đúng là vậy... Nhưng sự việc này vẫn rất nghiêm trọng đối với những người bị cuốn vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160329,
					"content": "Cũng không hổ danh đấy. Chuyện anh em mâu thuẫn thôi mà cũng đã có thể xoay chuyển vận mệnh của cả thế giới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160330
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160330,
					"content": "#Theo như tôi hiểu thì lập trường của {F#cô}{M#cậu} hiện tại vẫn là đứng về phía chúng tôi, hơn nữa cũng không rõ chuyện gì đang xảy ra đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160331,
						80160332
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160331,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160333,
					"content": "#Hahaha, vậy tôi yên tâm rồi. Lúc mới nghe {F#cô}{M#cậu} nói, tôi còn lo là chúng ta sẽ rơi vào tình thế khó xử đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160334
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160334,
					"content": "Theo tin tình báo thì có vẻ như Giáo Đoàn Vực Sâu sẽ dồn lực tấn công vào bộ tộc Chủ Nhân Gió Đêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160335
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160335,
					"content": "#Nếu {F#cô}{M#cậu} không muốn ở lại đây với tôi, thì tôi nghĩ nên đi chi viện cho Chủ Nhân Gió Đêm là hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160336
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160336,
					"content": "Đúng ý tôi lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160337
					]
				},
				{
					"id": 80160337,
					"content": "#Vậy tôi cũng đi cùng {F#cô}{M#cậu}. Áp lực hiện tại của Cộng Đồng Trù Phú không lớn, quân lực nên được phân bổ đến những nơi cần thiết hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160338
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160338,
					"content": "Ừm, nhờ vào mọi người rồi. Nếu cần chi viện thì hãy liên hệ với tôi bất cứ lúc nào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160332,
					"content": "Tôi thậm chí còn muốn đấm Giáo Đoàn Vực Sâu hơn các vị đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160320,
					"content": "#Là {M#em gái}{F#anh trai} của tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				}
			]
		},
