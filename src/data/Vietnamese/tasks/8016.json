			"trigger": {
				"objectNames": [
					"Hilichurl"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "Ơ, có Hilichurl kìa! Nó đang nghỉ ngơi sao? Có vẻ như nó không có ý định tấn công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160202,
					"content": "Nhưng sao nó lại trốn ở đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160203,
					"content": "Ối, nó thức giấc mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160204,
					"content": "Hửm? Nó chạy mất rồi... Danh tiếng của chúng ta ở Natlan đã có sức uy hiếp đến vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160205,
					"content": "Hình như có thứ gì đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "Ý là thứ lấp lánh đó sao? Chắc là nó đã đánh rơi trong lúc chạy trốn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160207,
					"content": "Hmm... Tôi đoán là nó tưởng đã nhặt được bảo bối gì đó nên muốn giấu ở đây, nhưng không ngờ lại bị chúng ta phát hiện ra nhanh thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160208,
					"content": "Để xem nào, mặc dù cảm thấy với trí thông minh của Hilichurl thì chắc cũng không phải là thứ đáng giá gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160209,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#Hả? Sao vậy? {NICKNAME}, sao trông vẻ mặt nghiêm trọng thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160211,
					"content": "Đây chẳng phải chỉ là một chiếc chìa khóa bình thường thôi sao? Nhưng mẫu này đúng là hiếm thấy thật, không giống phong cách của Natlan... Hmm... Là của quốc gia nào làm ra nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160212,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "Khoang ngủ đông trong phi thuyền...? Phi thuyền gì, khoang ngủ đông gì cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160215,
					"content": "#Đợi đã... Phi thuyền? Chẳng lẽ là phi thuyền đã đưa {NICKNAME} đến Teyvat sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160216,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "Sao tự nhiên nó lại xuất hiện ở đây? Có khi nào do tự bản thân làm rớt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160218,
					"content": "Không, chìa khóa của tôi ở đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "Ồ! Giống hệt nhau này... Vậy không lẽ chiếc chìa khóa kia là của...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160221,
					"content": "Tổng cộng chỉ có hai chiếc chìa khóa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "#Quả nhiên là vậy... Ôi, giờ tôi mới cảm nhận rõ {NICKNAME} là người ngoài hành tinh... À không, là Kẻ Đổ Bộ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160224,
					"content": "Để tôi suy luận xem nào, tình huống này chắc là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160225,
					"content": "#Sở dĩ Hilichurl có thể nhặt được chiếc chìa khóa này và giấu nó đi, là do {M#em gái}{F#anh trai} của {NICKNAME} làm rơi nó ở gần đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160226,
					"content": "#Vậy có nghĩa là {M#cô}{F#cậu} ấy đã từng đến qua khu vực này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160227,
					"content": "Và cũng có nghĩa là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#Đúng thế... Không ngờ tiện thể nhận lời giúp Iansan mà lại có được phát hiện quan trọng này, thậm chí còn tìm được manh mối về {M#cô}{F#cậu} ấy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160230,
					"content": "Bây giờ chúng ta nên tiếp tục tìm kiếm manh mối ở quanh đây, hay là đến Cộng Đồng Trù Phú tìm Iansan nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160231,
					"content": "Hai vị ở đây à. Vất vả rồi, xem ra hai vị đã tuần tra rất chăm chỉ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160232,
					"content": "Iansan! Sao cô lại đến đây? Không phải chúng ta đã hẹn là tập hợp ở Cộng Đồng Trù Phú sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160233,
					"content": "Chúng tôi vừa phát hiện ra một chuyện quan trọng, còn đang nghĩ xem có nên đi tìm cô không đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160234,
					"content": "Tôi đến để báo với các vị là không cần tuần tra nữa, bởi vì cuộc thi thể hình vừa mới bị hủy bỏ rồi. Một lát nữa sẽ có đội tuần tra đến tiếp quản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160235,
					"content": "Khoan đã, có chuyện gì vậy? Sao đột ngột thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160236,
					"content": "Giáo Đoàn Vực Sâu đã đánh tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160237,
					"content": "...Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160238,
					"content": "Không ngờ phỏng đoán trước đó lại được xác thực nhanh như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#(Xem ra {M#Lumine}{F#anh trai} lại hành động rồi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "#(Lần này nhất định phải nắm lấy cơ hội để gặp {M#em}{F#anh} ấy.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "Tôi trước đây từng nghe qua về Giáo Đoàn Vực Sâu rồi, nhưng đây là lần đầu tiên tôi thấy chúng hành động với quy mô lớn như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160242,
					"content": "Giống hệt như... đang chuẩn bị khai chiến với cả Natlan vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160243,
					"content": "Chỉ một giáo đoàn thôi mà lại muốn khai chiến với quốc gia của chiến tranh à? Thật là khó tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160244,
					"content": "Giáo Đoàn Vực Sâu thường hoạt động trong bóng tối, đây là lần đầu tiên chúng tôi thấy chúng như vậy đó... Rốt cuộc chúng đang muốn làm gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160245,
					"content": "Chỉ với góc nhìn từ phía Cộng Đồng Trù Phú thì vẫn chưa thể nắm rõ tình hình chiến sự lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160246,
					"content": "Hiện tại thì tuyến phòng ngự của chúng tôi chắc không thành vấn đề, tôi đang định đến Đấu Trường Lửa Thánh để tìm Mavuika nói chuyện thử, dù sao thì nơi đó mới là khu trung tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160247,
					"content": "#Có muốn đi cùng tôi không, {NICKNAME}? Đại anh hùng của Natlan có mặt ở đó thì sẽ khiến người ta yên tâm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160248,
					"content": "Tôi cũng cần phải tìm hiểu tình hình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "Tuyệt, vậy thì chúng ta qua đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160249,
					"content": "Tôi có biết một vài điều về Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "Giáo Đoàn Vực Sâu rất có thể cũng đã từng đến đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#Một chiếc ở chỗ tôi, chiếc còn lại thuộc về {M#em gái}{F#anh trai} tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "...Tôi luôn cẩn thận mang theo bên mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "...Chìa khóa của khoang ngủ đông trong phi thuyền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
