			},
			"dialogs": [
				{
					"id": 80160501,
					"content": "Nhìn kìa, là Citlali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160502,
					"content": "Sao mấy người lại ở đây? Đến để chi viện à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160503,
					"content": "#Tình hình sao rồi? Mavuika đã bảo cháu và {NICKNAME} đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160504
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160504,
					"content": "Thấy cô xuất hiện ở đây thay vì ở nhà, thì đã có thể đoán được Chủ Nhân Gió Đêm đã thực sự gặp phải chuyện phiền phức rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160505,
					"content": "Chuyện phiền phức à... Cũng không đến mức đó, chỉ là hơi khó chịu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160506,
					"content": "Nghe nói trong số các bộ tộc thì Chủ Nhân Gió Đêm là nơi bị ảnh hưởng nặng nhất. Thật đúng là... Không hiểu sao lại thấy có cảm giác bị xem như điểm yếu đấy, hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160507,
					"content": "...Càng nghĩ càng tức mà, có ở nhà thì cũng không thể chuyên tâm đọc sách được, hứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160508
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160508,
					"content": "Thì ra đây là lý do đã khiến Bà Itztli tức giận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160509,
					"content": "Giáo Đoàn Vực Sâu đúng không? Chỉ cần nghe thôi là đã thấy chán rồi. Giống hệt mấy cái tên rẻ tiền để cho độc giả vừa nhìn là biết ngay phe phản diện trong mấy bộ tiểu thuyết ba xu vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160510,
					"content": "#Xem cách cô ấy nói về tổ chức của {M#em gái}{F#anh trai} {F#cô}{M#cậu} kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160511,
						80160512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160511,
					"content": "Tôi đã sớm thấy như vậy rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				},
				{
					"id": 80160513,
					"content": "#Ơ? Hả? Ý là {M#em gái}{F#anh trai} của {NICKNAME} thuộc Giáo Đoàn Vực Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160514,
					"content": "(Tuy lúc nãy rất tức giận, nhưng có phải mình đã đánh giá hơi quá đáng không nhỉ...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160515
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160515,
					"content": "Này, chúng ta để sau rồi nói nhé, có kẻ địch kéo đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160516
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160516,
					"content": "Tuyệt vời! Cơ hội xả giận tự dâng đến tận cửa. Vừa hay có thể phá tan bầu không khí gượng gạo ban nãy, không cần phải nghĩ cách chuyển chủ đề nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160517
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160517,
					"content": "Nửa câu sau không nói ra sẽ tốt hơn đấy, Citlali... Tóm lại thì, chúng ta cùng xông lên nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160512,
					"content": "Nếu là tôi thì tôi đã sớm đổi tên rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				}
			]
		},
