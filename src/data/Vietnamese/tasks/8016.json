				},
				{
					"id": 80160702,
					"content": "Đám Giáo Đoàn Vực Sâu cũng chỉ đến thế mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160703,
					"content": "Kết quả không mấy thỏa mãn cho lắm. Tôi vốn dĩ còn muốn nghe bọn chúng đích thân xin lỗi, sau đó công nhận thực lực của Chủ Nhân Gió Đêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160704
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160704,
					"content": "Thôi bỏ đi, dùng tiệc rượu ăn mừng để bù đắp cho sự hụt hẫng này vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160705
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160705,
					"content": "Giờ đã xử lý xong cứ điểm này, Giáo Đoàn Vực Sâu quanh đây chắc sẽ tạm thời không dám manh động, nhưng mà... chúng ta vẫn không nên lơ là cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160706
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160706,
					"content": "Mọi người để ý thấy không? Thông thường khi tấn công vào cứ điểm thì càng về sau lớp phòng thủ phải càng mạnh mẽ mới đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160707
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160707,
					"content": "Nhưng vừa nãy cứ cảm thấy ngoài vài tên chịu đánh đến cùng ra, những tên khác hình như cảm nhận được điều gì đó rồi lựa chọn rút lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160708
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160708,
					"content": "Hửm? Vậy thì có làm sao? Đây là chiến lược từ bỏ cứ điểm thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160709,
					"content": "Không giống lắm. Đây là Giáo Đoàn Vực Sâu đã tùy tiện khiêu chiến một quốc gia, chiến lược luôn rất cực đoan, kế sách vừa rồi không giống với phong cách của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160710
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160710,
					"content": "Vậy có nghĩa là bọn chúng đang có âm mưu gì ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160711
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160711,
					"content": "Dù sao thì hiện tại chúng ta vẫn chưa nắm được thông tin gì, nên cứ nghi ngờ và đề phòng trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160712
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160712,
