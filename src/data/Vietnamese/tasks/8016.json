			"dialogs": [
				{
					"id": 80160401,
					"content": "Phù... Sảng khoái hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160402,
					"content": "Không hổ danh là Bà Itztli. Sớm biết có bà ở đây thì cháu đã xem xét lại mức độ cấp thiết khi chi viện cho Chủ Nhân Gió Đêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160403,
					"content": "Hừm, là Giáo Đoàn Vực Sâu nên xem xét lại mục tiêu tấn công mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160404,
					"content": "Theo kinh nghiệm chiến đấu thì hướng mà lúc nãy chúng xông đến chắc là cứ điểm của Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160405,
					"content": "Hay là thừa thắng xông lên, phá hủy cứ điểm để chúng không thể tiếp tục tấn công nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160406,
					"content": "Ở đây vừa xảy ra xung đột sao? Có cần giúp đỡ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "Sutura"
				},
				{
					"id": 80160407,
					"content": "Các chiến binh của Chủ Nhân Gió Đêm cũng đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160408,
					"content": "Vừa trải qua trận đại chiến với Vực Sâu, nên khả năng phối hợp của mọi người đang rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160409,
					"content": "Khí thế tăng cao như vậy rồi, hãy cùng dồn lực tấn công luôn nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		},
