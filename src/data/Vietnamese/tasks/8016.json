			"trigger": {
				"objectNames": [
					"Iansan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2649.083,
							279.082,
							10084.27
						],
						"pointId": 351500003
					}
				]
			},
			"dialogs": [
				{
					"id": 80160101,
					"content": "Thật trùng hợp! Không ngờ lại gặp được đại anh hùng \"Tumaini\" và Paimon ở đây đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160102
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160102,
					"content": "Ồ, là huấn luyện viên Iansan! Sao cô lại ở đây một mình thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160103,
					"content": "N-Nói trước nhé, không phải tôi cố ý tới tìm cô đâu! Tôi tạm thời vẫn chưa cần đến những khóa huấn luyện tăng cơ giảm mỡ đâu đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160104,
					"content": "Hahaha... Tôi hiểu. Tôi cũng không phải huấn luyện viên ma quỷ gì đâu, trước giờ tôi luôn tôn trọng ý nguyện của học viên mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160105,
					"content": "Nhưng mà... Việc tập luyện sức bền một cách vừa phải sẽ mang đến nhiều lợi ích, ví dụ như thay tôi tuần tra quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160106,
						80160107
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160106,
					"content": "Thay vì tập luyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				},
				{
					"id": 80160108,
					"content": "#Đùa chút thôi. {F#Cô}{M#Cậu} nói đúng rồi đấy, tôi đang muốn tìm một người giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160109,
					"content": "Dạo này Cộng Đồng Trù Phú chúng tôi đang chuẩn bị tổ chức một cuộc thi thể hình. Nhiều người tới giờ mới đi tập luyện, vì vậy mà đang thiếu người đi tuần tra trong khu vực lân cận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160110
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160110,
					"content": "Vậy nên cô đang tuần tra thay họ à? Cô không cần chuẩn bị gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160111,
					"content": "Tôi không cần. Một mặt là vì tôi luôn cho rằng chỉ có kỷ luật trong thời gian dài thì mới thể hiện được trạng thái tốt nhất, còn nước tới chân mới nhảy thì không có ý nghĩa gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160112
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160112,
					"content": "Mặt khác... Như mọi người thấy đó, thể hình của tôi không thể tham gia những hạng cân đại chúng, còn trong hạng cân của tôi thì lại không có đối thủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160113
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160113,
					"content": "Đúng là vậy thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160114,
					"content": "Ơ? Sao cô lại nhìn tôi? Tôi không muốn tham gia cuộc thi thể hình nào đâu đấy! Hơn nữa chúng ta cũng khác hạng cân mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160115,
					"content": "#{NICKNAME}, chúng ta đi tuần tra giúp cô ấy nhé? Tôi sợ Iansan bắt tôi tham gia cuộc thi quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160116,
					"content": "Hahaha... Tốt lắm, chỉ với một ánh mắt thôi là đã ủy thác xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160117,
						80160118
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160117,
					"content": "Được thôi, coi như nể mặt Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160119,
					"content": "Vậy thì nhờ hai vị nhé. Chỉ là tuần tra cơ bản thôi, đảm bảo khu vực này không có gì bất thường là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160120
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160120,
					"content": "Tôi sẽ qua bên kia tuần tra, chút nữa chúng ta quay về Cộng Đồng Trù Phú tập hợp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160121
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160121,
					"content": "Không thành vấn đề! Cô cứ bận việc của mình đi nhé, chuyện tuần tra khắp nơi là sở trường của chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160118,
					"content": "Được thôi, coi như nể mặt Iansan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160107,
					"content": "Thì trông có vẻ như đang giúp cô hơn đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				}
			]
		},
		{
