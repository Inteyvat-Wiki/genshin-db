			"dialogs": [
				{
					"id": 102020401,
					"content": "Đoán xem tôi là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "Á, là tiếng của Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Phòng Giam"
				},
				{
					"id": 102020403,
					"content": "Có muốn chúng tôi thả em ra không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Được vậy thì. Không, không đúng, Klee đang thật tâm hối cải, không được mê hoặc em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Phòng Giam"
				},
				{
					"id": 102020406,
					"content": "Trong thời gian giam giữ, em sẽ ở đây, làm \"bảo vật\" đặc biệt dành riêng cho lễ đánh cầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Phòng Giam"
				},
				{
					"id": 102020407,
					"content": "\"Bảo vật\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "He he... Em đặc biệt làm thành hình dạng của cầu lông rất đáng yêu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Phòng Giam"
				},
				{
					"id": 102020409,
					"content": "Hình dáng cầu lông...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Đợi đến lễ đánh cầu, ừm! Mọi người nhất định sẽ thích đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Phòng Giam"
				},
				{
					"id": 102020412,
					"content": "Hừm, nếu để đội trưởng Jean nghe thấy điều này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "Thời gian bị nhốt của em ấy, chắc lại phải kéo dài rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "Thực ra vẫn là bom phải không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "Có muốn đem cho em chút đồ ăn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
