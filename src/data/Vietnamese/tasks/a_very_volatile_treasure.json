			"dialogs": [
				{
					"id": 102020101,
					"content": "A, Klee cũng ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020102,
					"content": "Em... Hu hu hu, em tự thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020103,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020104,
					"content": "Em... Bom của em... làm... làm người khác bị thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020105,
					"content": "Hu hu... vi phạm quy luật sinh tồn, em chắc chắn không thể nhìn thấy mặt trời vào ngày mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020107,
					"content": "Đợi đã, có sự hiểu nhầm ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "Klee, trả lời chị trước. Người bị thương đâu, người bị thương ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020109,
					"content": "Klee nổ bay pháp sư Vực Sâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020110,
					"content": "Nhưng... Nhưng lông xù chỉ là trộm đồ mà thôi, bom của em lại làm hắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020111,
					"content": "À... Trước đây tôi nói pháp sư Vực Sâu là \"người\" xấu, chỉ là ví dụ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020112,
					"content": "Pháp sư Vực Sâu không phải là con người. Nó chính là... ừm, thứ xấu xa đối địch với con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020113,
					"content": "Lông xù xù... đối địch với con người? Là thứ xấu xa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020114,
					"content": "Hả, Hả? Não... não không theo kịp rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020115,
					"content": "Ừ, là do chị sơ ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020116,
					"content": "Bởi vì em còn quá nhỏ, trước giờ chị chưa từng nói với em chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020118,
					"content": "Lẽ nào là bởi \"bảo vật lợi hại nhất\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "Trên thực tế. Quái vật trong Giáo Đoàn Vực Sâu là mối đe dọa xâm chiếm Mondstadt, dạo này vô cùng manh động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020119,
					"content": "Đúng vậy, tôi hiểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020120,
					"content": "Do bọn chúng nghe thấy tin đồn về bảo vật mới để ý đến Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020121,
					"content": "Giống như, giống như lúc đầu tôi cũng nghĩ tới... À không, cũng muốn biết bảo vật này vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020122,
					"content": "Cho nên... Cho nên nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020123,
					"content": "Xét trên công lao lần này của em, lễ đánh cầu tới, sẽ cho phép em cùng tham gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020125,
					"content": "Thật là đánh bừa mà trúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "Thật lòng vui mừng cho em.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "Lễ đánh cầu!! Oa!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020127,
					"content": "#{NICKNAME}, đến lúc đấy nhất định phải đến nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020128,
					"content": "À ừm, kết cục viên mãn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020129,
					"content": "Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020130,
					"content": "Nhưng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020131,
					"content": "Klee, \"bảo vật\" trước kia, em đã giấu ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020132,
					"content": "Huhu",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020133,
					"content": "Có phải lại muốn đi nổ cá trong Hồ Sao Rơi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020134,
					"content": "Em, không có!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020136,
					"content": "(Nhưng đội trưởng Jean cũng nhìn thấy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "(Cô bé đang ra sức nháy mắt với chúng ta...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020137,
					"content": "K...lee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020138,
					"content": "Á! Klee sẽ đến <color=#00E1FFFF>phòng giam</color> báo cáo... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020139,
					"content": "Không biết khi Klee bị giam giữ, liệu có cảm thấy buồn chán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
