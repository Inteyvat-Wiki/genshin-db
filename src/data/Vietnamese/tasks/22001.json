			"dialogs": [
				{
					"id": 220010101,
					"content": "A Meng, hôm nay đến lượt mình làm thuyền trưởng rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010102,
					"content": "Lulu, tôi mấy ngày này đều làm thuyền trưởng rồi, cũng đến lúc để Fei diễn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220010103,
					"content": "Nhưng mình cảm thấy A Meng đóng vai thuyền trưởng rất hay, mình nghĩ bạn hãy tiếp tục làm thuyền trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010104,
					"content": "Các em đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "Ồ, chúng em đang chơi trò chơi. Vốn nói rõ là lần này em làm thuyền trưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010106,
					"content": "Nhưng Lulu luôn nói, khi A Meng đóng vai thuyền trưởng chơi vui hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010107,
					"content": "Í, Lulu luôn như vậy...Có điều bạn thấy như thế thì cứ vậy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010108,
					"content": "#{F#Chị}{M#Anh} có thể diễn cướp biển một lần nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010109,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "Kết quả là tôi vấn chỉ là nhân viên phục vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010113,
					"content": "#Giống như lần trước, khi {F#chị}{M#anh} đã sẵn sàng, hãy đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010111,
					"content": "Tôi muốn làm người tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "Ai da, tôi muốn làm thuyền trưởng cơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Fei"
				}
			]
		},
