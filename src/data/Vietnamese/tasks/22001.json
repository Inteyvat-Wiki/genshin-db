			"dialogs": [
				{
					"id": 220010301,
					"content": "Thuyền trưởng đang ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010302,
					"content": "Bạn sao lại đưa hải tặc đến đây! Bạn phải lừa chúng đi nơi khác, sau đó tôi cùng Lulu bỏ trốn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220010303,
					"content": "Bạn dựa vào điều gì mà bỏ trốn cùng Lulu, còn tôi phải ở đây giữ chân bọn hải tặc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010304,
					"content": "Vậy tôi sẽ giao bạn cho đám hải tặc, như vậy tôi vẫn có thể chạy trốn cùng Lulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010305,
					"content": "Bạn... Chị Beidou nói rồi, không được bán đứng bạn bè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220010306,
					"content": "Vậy chị Beidou có nói là thuyền trưởng nên là đưa người khác đi trốn không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010307,
					"content": "Bạn...Tôi sẽ không chia Đài Sen cho bạn ăn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220010308,
					"content": "Không cho ăn thì thôi! Ai thèm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010309,
					"content": "Sao mọi người lại cãi nhau rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "#{F#Chị}{M#Anh} chớ lo lắng, em có cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010311,
					"content": "Bọn trẻ thích ăn nhất là Đài Sen, có đồ ăn ngon chắc chắn thế giới này lại yên bình trở lại thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010312,
					"content": "#{F#Chị}{M#Anh} có thể giúp em đi tìm Đài Sen được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010313,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Cám ơn, đi nhanh về nhanh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010315,
					"content": "Thứ chúng thích ăn chưa chắc là Đài Sen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "#Ồ... {F#chị}{M#anh} đang nói về cái gì vậy? Chúng thích gì nhất?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010317,
					"content": "Cứ tìm một ít Đài Sen về đây, không thể để bọn chúng cãi nhau suốt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				}
			]
		},
