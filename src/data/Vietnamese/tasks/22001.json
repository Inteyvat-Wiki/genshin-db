				},
				{
					"id": 220010404,
					"content": "#{F#Chị}{M#Anh}...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220010405,
					"content": "Các em đừng cãi nhau, không mỏi mồm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010406,
					"content": "Chỉ là chơi một trò chơi thôi mà, làm gì mà tức giận như vậy, chẳng phải là bạn tốt với nhau sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010407,
					"content": "Nè, Đài Sen vừa mới hái được đó, mau ăn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010408,
					"content": "Ăn xong, chúng ta cùng bàn bạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010409,
					"content": "Nghĩ kỹ xem ai làm thuyền trưởng, ai làm người phục vụ là được mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010410,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220010411,
					"content": "Ừm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010412,
					"content": "Đúng là hòa bình thế giới đã quay lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010413,
					"content": "Thế nào, em nói đúng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010414,
					"content": "Sao em biết được vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "Chúng em chơi với nhau lâu như vậy, ắt sẽ hiểu ý nhau thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010416,
					"content": "Lulu thật lợi hại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "#Cám ơn {F#chị}{M#anh}, chị Beidou mới lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220010418,
					"content": "Sau khi lớn lên, em cũng có thể giống chị ấy không...",
					"roleType": "TALK_ROLE_NPC",
