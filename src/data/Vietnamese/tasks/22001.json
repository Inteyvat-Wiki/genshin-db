					"nextDialogs": [
						220010606
					]
				},
				{
					"id": 220010606,
					"content": "Là hải tặc sao? Xin lỗi, kẻ phục vụ nghèo hèn này không có gì cho người cướp cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010607
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010607,
					"content": "Hừm, nếu muốn cướp thì đã tìm đến kẻ nhiều tiền rồi... Đợi chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010608
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010608,
					"content": "Ê! Các người đến ăn cướp sao, thuyền trưởng có nhiều tiền lắm, các ngươi có thể cướp của anh ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010609
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010609,
					"content": "Í, í?! Bạn chẳng phải là người phục vụ trên thuyền sao?",
