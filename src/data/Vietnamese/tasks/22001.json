					"nextDialogs": [
						220010610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010610,
					"content": "Đúng vậy, vì thế tôi biết rõ thuyền trưởng đang ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010611
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220010611,
					"content": "Hừm, chỉ là một vị thuyền trưởng thôi mà? Có gì ghê gớm đâu cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010612
