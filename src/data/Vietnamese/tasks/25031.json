			"dialogs": [
				{
					"id": 250310401,
					"content": "Cảm ơn, cảm ơn đã giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310402,
					"content": "Nếu mà sớm vứt được cái túi rách đó đi, một mình tôi cũng có thể giải quyết được chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310403,
					"content": "Thế thì uổng công chúng ta tới Natlan à! Không được đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310404,
					"content": "Chờ đã, cô Là Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#Ơ? Là... Là {NICKNAME}! Đúng là {F#cô}{M#cậu} rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310406,
					"content": "Cô gái bên cạnh này, chẳng lẽ là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "Narzam, Đạo Bảo Đoàn. Hình như chúng ta từng gặp nhau rồi đó, quên mất rồi hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310408,
					"content": "#Phù... {F#Cô}{M#Cậu} đúng là đại ân nhân của tôi đó. Đã từng cứu tôi bao nhiêu lần rồi nhỉ? Một lần, hai lần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310409,
					"content": "Đừng tính lần có tôi đó nhé. Lần đó là tự cô không muốn đi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310410,
					"content": "Tôi có tính lần đấy đâu. Hơn nữa, tự tôi không muốn đi là sao hả, tôi trả tiền cho cô rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310411,
					"content": "Vài đồng lẻ của cô, ăn uống một tí là hết sạch rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310412,
					"content": "Không phải là cô lại đến vì luận văn đấy chứ hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "Hì hì... Đã nỗ lực lâu như thế rồi, cũng không thể phí công được mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310414,
					"content": "Lần này tôi đã xin kinh phí đặc biệt từ Giáo Viện, đề tài cũng đã được xác nhận xong rồi, không xung đột với ai cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310415,
					"content": "Hơn nữa, tôi còn có Narzam làm vệ sĩ nữa. Kẻ xấu đều bị cô ấy đuổi đi hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310416,
					"content": "Là vì chúng ta chẳng có gì để lấy được, họ cũng chẳng muốn rước phiền vào người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310417,
					"content": "Vậy vừa rồi mấy người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "...Cái người này ôm chặt túi đựng tài liệu của mình, đi một mạch thẳng từ Con Của Tiếng Vang đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310420,
					"content": "Nói thật, cho dù là từ góc độ của tôi, cô ấy trông như một kẻ ngốc đang ôm khư khư bảo bối vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310421,
					"content": "Một người ôm bảo bối đi lại trong nơi hoang vu không bóng người như này, bên cạnh lại chỉ có một vệ sĩ... Là ai thì cũng muốn thử một phen thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310422,
					"content": "Đúng đó! Trong túi của tôi chính là bảo bối đấy. Đây đều là ghi chép phỏng vấn thực địa của tôi, còn có cả bản sao các loại tài liệu khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310423,
					"content": "Có chúng rồi, luận văn của tôi nhất định sẽ được hoàn thành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310424,
					"content": "Đề tài luận văn này là \"Nghi Lễ Hành Hương Về Lửa Thánh\". Vô cùng nặng đô, nhất định sẽ có thể giúp tôi tốt nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310425,
					"content": "Ôi, may mà có Tahmures góp ý cho tôi. Không hổ là bạn tốt của tôi, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310426,
					"content": "#Cảm ơn {NICKNAME} lần nữa nhé. Nếu không có {F#cô}{M#cậu}, đám xấu xa đó sẽ không chỉ làm hỏng sách của tôi, mà còn cướp tiền của tôi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310427,
					"content": "Thời gian trước tôi giúp người ta sắp xếp sách và tài liệu, khó khăn lắm mới kiếm được một ít tiền. Nếu mà bị cướp thì hết tiền mua tài liệu mới mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310428,
					"content": "Ừm, nhưng cuối cùng thì cô vẫn lấy hết tiền đi mua sách. Nếu không phải là tôi lấy ví tiền của cô đi thì e là chúng ta sắp phải nhịn đói cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310429,
					"content": "Cũng, cũng không mua nhiều như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310430,
