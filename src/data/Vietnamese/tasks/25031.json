				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "Thôi xong rồi... Lần này là xong thật rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310102,
					"content": "Việc luyện tập của Alem có vấn đề gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#Ơn trời! {NICKNAME} đây rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310104,
					"content": "Không có thời gian giải thích đâu, hãy mau giúp tôi đi cứu người nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310105,
					"content": "Là bạn của cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "Coi... Coi là thế đi. Hai chúng tôi đều từng vì luận văn mà thất bại mấy vòng, còn ôm đầu khóc trong thư viện nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310108,
					"content": "Ahh, giờ không phải lúc nói những cái này đâu! Cô ấy không nghe lời khuyên của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310109,
					"content": "Cái gì mà bất chấp tất cả vì luận văn, sau đó dẫn theo vệ sĩ đó của cô ấy, lang thang khắp nơi cả ngày!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310110,
					"content": "Kết quả là đến giờ vẫn chưa thấy cô ấy quay lại! Bên bộ tộc cũng không còn ai đi cứu người được cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310111,
					"content": "#{NICKNAME}, xin hãy mau đi cứu cô ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310112,
					"content": "Cứ giao cho tôi. Chuyện này tôi quá quen rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#Chuyện này chỉ có thể nhờ {F#cô}{M#cậu} được thôi! Tất cả trông cậy vào {F#cô}{M#cậu} đó, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310113,
					"content": "Mấy người bên Giáo Viện các cô đúng thật là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "Cô ấy... Haiz, chỉ có thể nói là cô ấy xui không tả được thôi. Lần này tới Natlan, cô ấy còn nói gì mà phải nỗ lực lần cuối cho luận văn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310106,
					"content": "Là người quen của cô à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
