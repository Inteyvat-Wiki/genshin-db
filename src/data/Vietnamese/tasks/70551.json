					}
				]
			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#Chào buổi chiều, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510102,
					"content": "#...Không ngờ tôi lại có vinh hạnh được chứng kiến tài năng pha chế của {F#cô}{M#cậu} tại Mondstadt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510103,
					"content": "Emilie tới đây du lịch sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "Cả hai luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510106,
					"content": "Một vị tiểu thư tự xưng là ma nữ đã mời tôi đến quản lý quầy hoa nhỏ của cô ấy. Ngoài ra, tôi còn nhận ủy thác điều chế hương thơm mới cho Quán Rượu Đuôi Mèo nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510107,
					"content": "#Kết thúc một ngày bận rộn bằng ly đồ uống do chính tay {NICKNAME} pha chế, đúng là thu hoạch tuyệt vời mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510108,
					"content": "Vậy thì tôi phải tung tuyệt chiêu ra thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "#Tôi tin vào sự lựa chọn của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510111,
					"content": "(Emilie có khứu giác nhạy bén hơn người thường, nếu tạo ra hương thơm phức tạp mà không kiểm soát tốt thì chắc cô ấy sẽ thấy không ổn...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "(Tóm lại, cứ dùng nguyên liệu có khả năng hòa quyện hương thơm tốt, thêm chút hương vị Fontaine vào vậy.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "(Vậy thì trước tiên hãy thử một ly \"Lumidouce Bảy Giờ\" phiên bản cải tiến của Mondstadt nhé.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "Tôi sẽ pha cho cô một ly đồ uống đầy bất ngờ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "Emilie tới đây công tác à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
