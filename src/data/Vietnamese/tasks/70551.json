					}
				]
			},
			"dialogs": [
				{
					"id": 705510301,
					"content": "Lumidouce Bảy Giờ cải tiến riêng cho Emilie, xin mời thưởng thức. Nhưng tạm thời tôi vẫn chưa nghĩ ra tên cho nó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510302
					]
				},
				{
					"id": 705510302,
					"content": "Màu sắc tươi mát hơn, hương thơm cũng rất thanh tao, đúng như ấn tượng về màu xanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510303
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510303,
					"content": "Lớp bột mịn rực rỡ trên bề mặt làm từ cánh hoa và lá của Cúc Cánh Quạt đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510304,
						705510305
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510304,
					"content": "Đúng vậy, vừa nhìn đã nhận ra rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				},
				{
					"id": 705510306,
					"content": "Hương vị chắc chắn sẽ rất tuyệt... Để tôi thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510307
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510307,
					"content": "Ừm... Ý nghĩa của Cúc Cánh Quạt là \"ngọn gió nhìn thấy được\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510308
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510308,
					"content": "#{F#Cô}{M#Cậu} không chỉ nắm bắt được hình dáng của chúng, mà còn hòa quyện cả hương thơm mà chúng mang đến vào ly đồ uống đặc biệt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510309
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510309,
					"content": "Tôi đề nghị, ly này hãy đặt tên là \"Dư Hương Mây Gió\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510310
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510310,
					"content": "Mây và gió của Mondstadt xoay vần trong ly, để lại dư hương thơm ngát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510311,
						705510312
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510311,
					"content": "Đúng là chuyên gia về nước hoa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510313,
					"content": "#Vậy sao? Chắc là do thói quen nghề nghiệp, {F#cô}{M#cậu} thích là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510314
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510314,
					"content": "Tiếp theo, hãy để tôi chậm rãi thưởng thức ly đồ uống đặc biệt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510315
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510315,
					"content": "#Cảm ơn nhiều nhé, {NICKNAME}. Chuyến đi Mondstadt lần này đúng là bội thu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510316
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510316,
					"content": "Đây là ly đồ uống đặc biệt khiến tôi ấn tượng nhất đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510317
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510317,
					"content": "#Khi nào về Fontaine, tôi sẽ thử tái hiện lại kiệt tác của {F#cô}{M#cậu} dưới dạng nước hoa và hương thơm theo ấn tượng lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510318,
						705510319
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510318,
					"content": "Tôi rất vinh hạnh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510320,
					"content": "#Sau khi điều chế xong, mong {F#cô}{M#cậu} có thể trở thành vị khách đầu tiên đến thử hai sản phẩm mới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510321
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510321,
					"content": "Đến khi đó, hẹn gặp tại Đại Sảnh Fontaine nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510319,
					"content": "Tuyệt quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510312,
					"content": "Cái tên này phong cách quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510305,
					"content": "Chính là loài hoa đặc trưng của Mondstadt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				}
			]
		}
	]
