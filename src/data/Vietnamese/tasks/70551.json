						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "Thử xem sao nhé, tiểu thư Emilie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "#Động tác của {F#cô}{M#cậu} thật đẹp mắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510203,
					"content": "Ừm... đây là Lumidouce Bảy Giờ phiên bản địa phương hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510204,
					"content": "Chuẩn không cần chỉnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "Dịu nhẹ tao nhã, tầng hương vị rõ ràng, kết hợp với mùi thơm đặc trưng của Mondstadt. Hương vị khá thân thuộc, cũng tránh được thành phần có thể khiến tôi cảm thấy không hài hòa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510207,
					"content": "Thực ra cũng không cần thận trọng đến vậy. Với những hương vị vượt ra khỏi tiêu chuẩn thông thường, tôi cũng có khả năng đón nhận khá tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510208,
					"content": "Xem ra ly này hơi truyền thống quá nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "#Ly này rất tuyệt. Nhưng tất nhiên, nếu có một ly sâu sắc hơn, được pha chế từ những hiểu biết độc đáo của {F#cô}{M#cậu}, lại có thể giúp tôi hiểu thêm về Mondstadt thì còn gì bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510211,
					"content": "Chúng ta có thể chậm lại, tìm cảm hứng từ cuộc trò chuyện nhẹ nhàng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510212,
					"content": "Đây là hoa cô vừa mua à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "Một trong số những thù lao khi quản lý cửa hàng hoa thôi, là nguyên liệu nước hoa quan trọng đã giúp tôi hoàn thành ủy thác từ Quán Rượu Đuôi Mèo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510214,
					"content": "Nhiều năm trước, tôi đã nghiên cứu về Hoa Cecilia của Mondstadt. Trong một số lĩnh vực, hương thơm của nó đã trực tiếp đại diện cho Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510215,
					"content": "Nhưng lần này tình huống hơi đặc biệt. Có vài chú mèo không quen với mùi Hoa Cecilia lắm, cần đặc biệt lưu ý đến cảm nhận của chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510216,
					"content": "Lần này đổi sang dùng hương thơm từ loài thực vật gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "Là Cúc Cánh Quạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510219,
					"content": "Nghiền nhỏ và chiết xuất từng bộ phận của Cúc Cánh Quạt, sau đó pha trộn mùi hương từ đài hoa và lá theo tỷ lệ phù hợp. Hương thơm ngọt ngào say đắm như rượu mật, nhưng cũng làm nổi bật sự tươi mát từ lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510220,
					"content": "Vừa rồi tôi đã thử nghiệm ở Quán Rượu Đuôi Mèo rồi, lũ mèo phản ứng khá tốt. Khách hàng cũng thấy hương thơm mới vừa ấm áp, vừa khiến tinh thần sảng khoái hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510221,
					"content": "Chiết xuất được hương thơm đỉnh cao từ những nguyên liệu bình thường ít được chú ý tới... Đúng là một điều đáng mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510222,
					"content": "Thời tiết hôm nay thật tuyệt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "(Hóa ra trò chuyện quanh những chủ đề kinh điển sẽ có cảm giác như này...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "Đúng vậy. Lúc sớm, trên trời còn lơ lửng những đám mây mỏng như tơ lụa... độ ẩm vừa phải, gió cũng ôn hòa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510225,
					"content": "Trong điều kiện này, khứu giác của con người sẽ ở trạng thái nhạy bén, nhưng không quá nhạy cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510226,
					"content": "Những thành phần hương thơm được pha trộn hợp lý sẽ hòa quyện tự nhiên vào môi trường xung quanh, thấm sâu vào ký ức của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510227,
					"content": "Không ngờ còn có lý thuyết này nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "Pha chế đồ uống chắc cũng có những điểm tương đồng... Lựa chọn rượu nền có độ mạnh vừa phải, để các thành phần hương vị hòa quyện vào rượu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510230,
					"content": "Nếu xử lý khéo, tất cả thành phần đều có thể phát huy tác dụng, tạo nên bản giao hưởng tuyệt mỹ cho vị giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510231,
					"content": "Tôi hiểu rồi, hương vị hòa quyện là rất quan trọng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "Ừm... nói đúng đó. Nghĩ kỹ lại thì hương vị phân tầng rõ ràng quả thật không hợp với thói quen của tôi lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510234,
					"content": "Emilie thường uống gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "Bình thường à...? Sau giờ làm, bạn bè ở Sảnh Chấp Pháp thỉnh thoảng sẽ mời tôi uống vài ly. Thường thì tôi sẽ chọn trà trái cây, để sau bữa tiệc có thể nhanh chóng trở lại trạng thái làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510236,
					"content": "Nếu hôm sau là ngày nghỉ, các sĩ quan thường sẽ rất phấn khởi, lúc đó tôi cũng sẽ gọi một ly nhỏ rượu trái cây có ga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510237,
					"content": "Có một sĩ quan tên là Turenna thường mời tôi cùng nhâm nhi rượu Corte ủ trong thùng gỗ lâu năm. Nhưng sau khi cô ấy chuyển sang Đội Tuần Tra Đặc Biệt thì tôi cũng không uống nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510238,
					"content": "Hóa ra cô cũng uống được rượu sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "Xét về mặt khoa học, cồn là loại dung môi được sử dụng rộng rãi. Tôi đã quen với mùi cồn tinh khiết từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510241,
					"content": "Nhưng trong trạng thái say nhẹ, tâm trạng của tôi sẽ hơi khác, từ đó ảnh hưởng đến tư duy điều chế nước hoa... Dù kết quả tốt hay xấu thì cũng đều là những thử nghiệm mới mẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510242,
					"content": "Nên tôi không bài xích việc uống rượu có nồng độ thấp, chỉ cần thêm một chút rượu vào đồ uống là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510243,
					"content": "Công việc điều chế nước hoa gần đây vẫn suôn sẻ chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "Ừm, cảm ơn đã quan tâm. Mọi thứ đều ổn, chỉ có điều, chuyến đi Mondstadt lần này gặp phải thử thách bất ngờ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510245,
					"content": "Lúc đầu, tôi đã dựa theo cuốn sách kinh điển \"Tổng Quan Về Chất Thơm Và Giác Quan Con Người\" để chọn một số hương liệu truyền thống nhất của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510246,
					"content": "Không ngờ mùi hương chủ đạo từ Quả Dâu Đỏ lại quá ngọt ngào khi ở trong quán rượu, khiến mọi người buồn ngủ... Cô nàng pha chế có đôi tai xinh đẹp đã gục xuống thiếp đi ngay lập tức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510247,
					"content": "Hóa ra Quả Dâu Đỏ có công dụng này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "Chỉ có thể nói rằng, độ ngọt không phải càng cao là càng tốt. Đối với những chất có vị ngọt được hấp thụ vào cơ thể, việc kiểm soát tổng lượng hợp lý luôn tốt cho thể trạng và tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510250,
					"content": "Trong cuộc sống hàng ngày tôi khá ít ăn đồ ngọt, cũng hạn chế ăn các loại trái cây nhiều đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510251,
					"content": "Cuối cùng, tôi đã loại bỏ hoàn toàn các thành phần liên quan đến Quả Dâu Đỏ khỏi việc điều chế. Thay vào đó đã khám phá ra vài thành quả từ Cúc Cánh Quạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510252,
					"content": "Tôi có ý tưởng rồi, chờ một chút nhé. Tôi sẽ điều chỉnh công thức ngay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "#Hửm? Mới nói chuyện vài câu thôi mà {F#cô}{M#cậu} đã tìm ra ý tưởng rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510254,
					"content": "#Có lẽ vốn dĩ {F#cô}{M#cậu} đã có thiên phú nghiên cứu rất mạnh mẽ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510248,
					"content": "Nghe có vẻ hương thơm của Quả Dâu Đỏ không ổn lắm nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510239,
					"content": "Tôi còn tưởng cô sẽ thấy rượu hơi gắt chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510232,
					"content": "Cô thích hương vị hòa quyện hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510228,
					"content": "Lần đầu tôi nghe đến, được mở mang kiến thức rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510217,
					"content": "Dùng loài hoa nào để thay cho Cecilia thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510209,
					"content": "Emilie muốn một loại đồ uống đặc biệt hơn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510205,
					"content": "Mới đó mà cô đã nếm ra được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				}
			]
		},
