			"dialogs": [
				{
					"id": 747040101,
					"content": "Chào! Columbina! Đang ngắm cá trong bể à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040102,
					"content": "Ừm, mọi người trang trí nơi này đẹp lắm. Có nhiều loài cá mà tôi chưa từng thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747040103,
					"content": "Columbina đã đi thủy cung bao giờ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040104,
					"content": "Chưa, bể thủy sinh thì tôi từng thấy mấy cái ở Snezhnaya. Nhưng trước đây tôi không mở mắt, nên chắc cũng không tính là thực sự \"thưởng thức\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747040105,
					"content": "Vậy bây giờ cảm giác thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747040106
					]
				},
				{
					"id": 747040106,
					"content": "Rất đẹp. Hóa ra phong cảnh dưới nước lại rực rỡ sắc màu đến thế, giống như được sống mãi trong mùa xuân với muôn hoa đua nở vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747040107,
					"content": "A, nhìn con cá kia đi. Lần trước tôi đã thấy nó giống Sandrone rồi. Cả hai con kia nữa, cứ luôn hành động theo đối phương, giống y như hai người vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747040108,
					"content": "Thật này! Cô nói tôi mới để ý đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040109,
					"content": "Nhóc kia thì luôn bận rộn giống Lauma. Còn con luôn cảnh giác giữa đám san hô kia, lại giống như Nefer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747040110,
					"content": "Ồ... Chẳng lẽ khi ngắm cá, Columbina thích tìm xem chúng giống với người bạn nào của mình à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040111,
					"content": "Không hẳn là như vậy. Đúng hơn là tôi yêu quý bạn bè, nên trong cuộc sống cũng bất giác nghĩ đến mọi người. Khi ngắm cá cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747040112,
					"content": "Woa! Tôi rất vui khi nghe cô nói thế. Vậy còn con cá nào giống với mọi người nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040113,
					"content": "Ừm... Gần đây tôi kết bạn với nhiều người lắm. Không phải ai cũng tìm được con cá tương ứng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747040114,
					"content": "Cũng đúng. Nhưng chúng tôi cũng sẽ tiếp tục làm phong phú thêm các bể cá này, Columbina có thời gian hãy thường xuyên đến xem nhé. Biết đâu lại tìm thêm được những người bạn khác?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040115,
					"content": "Bạn bè sẽ vào trong bể cá à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747040116,
					"content": "Ý là những con cá giống với bạn bè đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}