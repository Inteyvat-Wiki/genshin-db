			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rosaria",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040202,
					"content": "Sao rồi, không hợp với khẩu vị của Rosaria sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040203,
					"content": "Tôi sẽ đi làm ly khác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "Không phải thế, chỉ là tôi rất ít khi uống trà, cho nên mùi vị này khiến tôi nghĩ đến một số chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040205,
					"content": "Có liên quan đến Giáo Hội sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040206,
					"content": "Ừm. Có lần Giáo Hội tổ chức sự kiện, tôi không có đi, không ngờ Barbara lại để dành cho tôi một phần trà và điểm tâm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040207,
					"content": "Điểm tâm để lâu quá nên không còn ngon nữa, cô ấy lén lén lấy đi. Nhưng còn ly trà đó thì giống như là mùi vị này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040208,
					"content": "Thần thái bây giờ của Rosaria đúng là hiếm thấy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040209,
					"content": "Xem ra Mondstadt lại có thêm một người biết thưởng thức hồng trà rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040210,
					"content": "Rượu vẫn ngon hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040211,
					"content": "Kaeya thì sao, hài lòng chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "Nếu tôi khiếu nại thì bạn sẽ làm ly khác cho tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040213,
					"content": "Hahaha, đùa thôi, sao tôi lại làm ra những chuyện khiến bạn phải ghét chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040214,
					"content": "Chậc, Kaeya lươn lẹo thật! Không hiểu sao Rosaria lại có thể uống rượu chung với anh ta nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040215,
					"content": "Vậy sao? Tôi không quan tâm đến suy nghĩ của anh ta. Uống rượu thì chỉ nói chuyện về rượu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040216,
					"content": "Huống chi, dù là bạn hay là chủ quán ở đây cũng thế... Kaeya cũng chỉ muốn tìm những người hoặc chuyện mà bản thân thấy hứng thú thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040217,
					"content": "Này! Chúng ta suy cho cùng cũng là bạn nhậu với nhau mà, sao lại bán đứng tôi thế chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040218,
					"content": "Vậy đã xem như bán đứng rồi sao? Thật không ra làm sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040219,
					"content": "Thường ngày tiếp xúc với nhiều người nghiêm túc quá rồi, đúng là không khí trong quán rượu thích hợp với tôi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040220,
					"content": "Ồ? Đến lúc nói về chuyện người nghiêm túc rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040221,
					"content": "Nói đến người nghiêm túc thì tôi cũng biết một ai đó, có thể vào được bảng xếp hạng những người nghiêm túc nhất Mondstadt luôn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040222,
					"content": "Nói đến mức độ thì... phải hình dung thế này, dù cho có bình luận như thế ngay trước mặt thì anh ta cũng đơ như khúc gỗ luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040223,
					"content": "Có cả bảng xếp hạng này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040224,
					"content": "Đương nhiên rồi. Để tôi nghĩ xem... còn có bảng xếp hạng số ngày uống rượu liên tục, bảng xếp hạng thời gian làm việc dài nhất, bảng xếp hạng sát thủ nhà bếp, còn có bảng xếp hạng kiến thức dự trữ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040225,
					"content": "Người Mondstadt rảnh thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040226,
					"content": "Những người không cần đi làm nhiều vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040227,
					"content": "Không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "Hic, không thể xếp tôi và nhà lữ hành cùng nhau vào bảng xếp hạng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040230,
					"content": "Có chứ, ví dụ như \"Người Pha Chế Tuyệt Nhất\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040231,
					"content": "Thật, thật sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040232,
					"content": "#Hay quá, {NICKNAME}, tên tuổi của chúng ta đã được lưu lại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040233,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040234,
					"content": "Hừm, bầu không khí này không tệ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040235,
					"content": "Còn phải nói sao, có mặt hai người họ là thấy vui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040236,
					"content": "Một bầu không khí ấm cúng và hấp dẫn như vậy là một điểm nhấn quan trọng trong quán rượu. Xem ra danh hiệu \"Người Pha Chế Tuyệt Nhất\" tặng đúng người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040237,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040238,
					"content": "Không có gì, cảm ơn vì lòng hiếu khách của hai người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040239,
					"content": "Ừm, tôi cũng sắp phải về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040240,
					"content": "Ngoài ra thì, mùi vị của hồng trà rất ngon đấy, sau này tôi sẽ thử tự pha xem sao... à ừm, trong trường hợp tôi dậy sớm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
