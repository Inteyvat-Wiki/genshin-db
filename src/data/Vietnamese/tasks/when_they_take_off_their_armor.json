			"dialogs": [
				{
					"id": 705040101,
					"content": "Yo, hôm nay bạn làm người pha chế sao, hiếm thấy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040102,
					"content": "Vậy cho tôi một ly Cái Chết Chiều nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040103,
					"content": "Mới tới mà đã chọc người ta, thiệt tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040104,
					"content": "#Haha, tôi chỉ muốn thử xem {NICKNAME} sẽ phản ứng thế nào thôi mà, không ngờ hôm nay tiểu thư Rosaria cũng có hứng đến đây đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040105,
					"content": "#Trong quán rượu đông khách lắm, {NICKNAME} mà không chịu tích lũy kinh nghiệm sớm là sẽ thiệt thòi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040106,
					"content": "Tên Kaeya lại mồm mép rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040107,
					"content": "Oan ức quá, tôi có lòng tốt mà! Phải cảm ơn tôi mới đúng chứ, ví dụ như là tặng tôi ly Bến Cảng Đêm Trăng gì gì đó nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040108,
					"content": "Làm luôn ly lớn giùm tôi nhé, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040109,
					"content": "Tôi uống gì cũng được, đồ uống có vị trà cũng ổn, cỡ vừa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040110,
					"content": "Hiểu rồi, đợi chút nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "Không cần vội đâu, thời gian ngồi đợi thức uống cũng rất thú vị mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
