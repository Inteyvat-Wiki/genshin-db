					"nextDialogs": [
						205160303
					]
				},
				{
					"id": 205160303,
					"content": "Trên tay tượng... tượng Phong Thần?! Rốt cuộc con bé bò lên đó bằng cách nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160304,
					"content": "Tôi phải đến đó ngay, gọi con bé xuống và dạy dỗ một trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160305,
					"content": "Bạn thật vất vả quá, những thứ này bạn nhận lấy đi.",
					"roleType": "TALK_ROLE_NPC",
