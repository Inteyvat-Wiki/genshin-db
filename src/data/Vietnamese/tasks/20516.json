						205160203
					]
				},
				{
					"id": 205160203,
					"content": "Á! Giật cả mình, bạn chui từ đâu ra vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160204,
					"content": "Anh trai lại đang tìm tôi đúng không, hừm, đúng là chỗ này anh ấy không tìm thấy thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160205,
					"content": "Được rồi, được rồi, tôi biết rồi, lát nữa tôi sẽ về. Sẽ không để anh ấy lo lắng đâu.",
					"roleType": "TALK_ROLE_NPC",
