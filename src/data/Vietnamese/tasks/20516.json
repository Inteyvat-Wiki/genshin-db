					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160505,
					"content": "À, đúng rồi, chắc chắn là tu nữ Grace nói cho bạn biết, cô ấy lúc nào cũng ở quanh đây.",
					"roleType": "TALK_ROLE_NPC",
