					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160506,
					"content": "Thuốc trước đây tôi uống, cũng có rất nhiều là của cô ấy đưa tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160507,
					"content": "Tu nữ Grace đúng là người tốt, nhưng tôi không muốn ở mãi trong Thành Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
