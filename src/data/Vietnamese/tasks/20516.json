						205160402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160402,
					"content": "Xin hỏi bạn có từng thấy một cô bé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "Hú... Bạn đang tìm Anna đúng không, bạn nhìn lên trên đi, con bé đang ở trên tay của tượng Phong Thần đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160404,
					"content": "Lúc con bé chạy đến đây tôi còn thắc mắc, không phải con bé đang bệnh sao? Sao bồng dưng lại mạnh khỏe như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160405,
					"content": "Tôi vừa lơ là một chút, con bé đã bò lên tay của tượng Phong Thần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160406,
					"content": "Bạn... sao bạn không nổi giận?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "Nổi giận? À... đương nhiên là có một chút, nhưng mà trước nay con bé luôn bị bệnh tật giày vò...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160408,
					"content": "Bây giờ thấy con bé mạnh khỏe, nói thế nào nhỉ, tôi không thể nổi giận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160409,
					"content": "Nhưng mà ở trên đó gió rất lớn, hy vọng con bé không bị cảm lạnh...",
					"roleType": "TALK_ROLE_NPC",
