			"dialogs": [
				{
					"id": 205160101,
					"content": "Con bé này, lại chạy đi đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160102,
					"content": "Anna lại trốn đi chơi rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "Tôi nói này, sao bạn chỉ có mỗi một biểu cảm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160104,
					"content": "Anna ngày càng không nghe lời, tôi lơ là một chút là con bé lẻn đi ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160105,
					"content": "Bệnh của con bé chưa khỏi hoàn toàn, bạn mau giúp tôi tìm Anna đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160106,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "Vậy thì nhờ bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160115,
					"content": "Đúng rồi, trước đây Anna thường hay nói với tôi là muốn đi xem Tượng Phong Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160116,
					"content": "Tôi nhớ, tu nữ Grace thường hay ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160117,
					"content": "Bạn có thể đi hỏi cô ấy trước, nói không chừng cô ấy biết gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160108,
					"content": "Bạn đã tìm chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "Đương nhiên là tìm rồi, cả ngoại ô thành phố cũng tìm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160110,
					"content": "Nhưng vẫn không thấy, nên mới phải nhờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160111,
					"content": "Anna thích ăn gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "Ừm, con bé thích ăn... Này! Đã nói đừng xem em gái tôi như mèo mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160113,
					"content": "Hơn nữa, thứ con bé thích ăn rất nhiều thứ, làm sao tôi đếm được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160114,
					"content": "Được rồi, bạn mau tìm giúp tôi đi, tôi ở đây chờ bạn. Tìm khắp nơi, tôi mệt sắp chết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				}
			]
		},
