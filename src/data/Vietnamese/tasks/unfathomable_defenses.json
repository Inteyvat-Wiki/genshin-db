			"dialogs": [
				{
					"id": 400841201,
					"content": "Sao các người tìm đến được nơi này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841202,
					"content": "Chúng tôi lần theo dấu vết của Hỏa-1 đến đây. Nhìn thấy điệu bộ vừa rồi của cô khiến chúng tôi không an tâm!",
