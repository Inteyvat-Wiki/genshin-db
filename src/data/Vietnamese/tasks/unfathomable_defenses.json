		{
			"id": 4008415,
			"completionStepIds": [
				4008415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008415",
							"2"
						],
						"stepId": 4008415,
						"stateName": "QUEST_STATE_UNFINISHED"
