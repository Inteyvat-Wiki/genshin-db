			},
			"dialogs": [
				{
					"id": 400841401,
					"content": "Không! Điều này tuyệt đối không thể xảy ra... Lẽ nào tôi vẫn chưa đủ nghiêm khắc với Nấm Quỷ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841402
					],
					"speakerTitle": "Thiết Cốt Song Đao"
				},
				{
					"id": 400841402,
					"content": "Hừm... Tuy là đã đánh bại được anh ta rồi, nhưng tôi vẫn cảm thấy không vui.",
					"roleType": "TALK_ROLE_NPC",
