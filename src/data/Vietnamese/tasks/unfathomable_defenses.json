			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thiết Cốt Song Đao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840401,
					"content": "Là các người sao, những con chuột ngu dốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840402
					],
					"speakerTitle": "Thiết Cốt Song Đao"
				},
				{
					"id": 400840402,
					"content": "Khẩu khí lớn thật! Dựa vào đâu mà nói như vậy đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840403,
					"content": "Thật yếu đuối và nực cười biết bao khi đặt quá nhiều tình cảm vào những con Nấm Quỷ! Điều này đi ngược lại với lý tưởng của người luyện thú mạnh nhất, đại nhân Haniyyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840404
					],
					"speakerTitle": "Thiết Cốt Song Đao"
				},
				{
					"id": 400840404,
					"content": "Người luyện thú mạnh nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840405,
					"content": "Chúng tôi sẽ thay đổi triết lý của Haniyyah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840406
					]
				},
				{
					"id": 400840406,
					"content": "Đừng ảo tưởng nữa! Những kẻ yếu đuối không đủ tư cách để đấu với đại nhân Haniyyah, các người sẽ phải dừng bước ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thiết Cốt Song Đao"
				}
			]
		},
		{
			"id": 4008406,
			"completionStepIds": [
				4008406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
