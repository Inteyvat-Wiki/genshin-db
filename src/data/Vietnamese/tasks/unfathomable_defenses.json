			"dialogs": [
				{
					"id": 400841301,
					"content": "Thua rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841302
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841302,
					"content": "Các bạn đã phát huy rất tốt, Quái Thú Xoay Tròn! Tôi rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841303
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841303,
					"content": "Cảm ơn các bạn! Tôi và Quái Thú Xoay Tròn đã kết thúc hành trình thi đấu của mình rồi, nếu bị người khác đánh bại thì có lẽ hai chúng tôi sẽ không phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841304
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841304,
					"content": "Layla và Quái Thú Xoay Tròn mạnh quá, chúng tôi suýt chút nữa bị áp đảo rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841305,
					"content": "Đừng coi trọng kết quả thắng thua, chỉ cần Nấm Quỷ phát huy hết sức mình thì cảm giác cũng sẽ rất thoải mái mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841306,
					"content": "Có lẽ đây mới là điều cuộc thi cần có...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841307
					]
				},
				{
					"id": 400841307,
					"content": "Nếu trận đấu nào cũng như thế này thì tốt biết mấy. Nhưng mà hiện giờ Miko với Haniyyah vẫn đang quyết chiến! Tôi cảm thấy không yên tâm, chúng ta mau qua đó coi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4008414,
			"completionStepIds": [
				4008414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
