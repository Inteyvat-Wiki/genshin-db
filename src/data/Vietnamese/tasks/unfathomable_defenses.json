						400841003
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841003,
					"content": "Hihi, nói như vậy thì Miko cũng đã giành chiến thắng dễ dàng rồi phải không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841004,
					"content": "Haha, trận đấu của chúng tôi không có gì đặc biệt cả. Tôi với \"Lưới Sấm\" mới dùng vài chiêu thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841005
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841005,
					"content": "Bị Haniyyah đánh bại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841006
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841006,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841007,
					"content": "Thái độ của cô... là đang chế giễu tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841008
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841008,
					"content": "Haha, nào dám xem thường tiểu thư Haniyyah chứ! Ý chí ngoan cường của cô, thậm chí còn muốn hủy diệt cả một loài vật thì tôi sao dám tùy ý bông đùa cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841009
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841009,
					"content": "Cơ mà nếu như cô vẫn tiếp tục đi theo hướng này thì sẽ có một ngày nhận ra rằng thực tế và tưởng tượng là hai thứ khác biệt đó. Khi đấy sự ngoan cố sẽ trở thành thứ như thế nào nhỉ? Tôi cũng đang mong chờ đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841010
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841010,
					"content": "Cô không cần bận tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841011
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841011,
					"content": "Bỏ đi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841012
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841012,
					"content": "Người thua cuộc rõ ràng là Miko, vậy sao Haniyyah lại kích động mạnh như vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841013
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841013,
					"content": "Sự việc ngày càng thú vị rồi. Tôi cảm thấy Haniyyah lo lắng rõ rệt khi \"Lưới Sấm\" gây sát thương lên \"Hỏa-1\" ngay đầu trận chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841014
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841014,
					"content": "Đơn giản là tôi nhìn thấu sự thật tự lừa dối bản thân của cô ta mà thôi, coi như tuyến phòng thủ sắp sụp đổ rồi. Cô ta yếu đuối hơn tôi tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841015,
						400841016
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841015,
					"content": "Tự lừa dối bản thân sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841017
					]
				},
				{
					"id": 400841017,
					"content": "Chẳng lẽ, Haniyyah không tuyệt tình như cách cô ta nói sao? Cô ấy thực sự quan tâm đến \"Hỏa-1\", chỉ là không thể hiện ra bên ngoài mà thôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841018,
					"content": "Đoán đúng rồi, giờ là thời cơ tốt để hiểu rõ thế giới nội tâm của cô ta. Có thể thay đổi con người cô ta thì chỉ có thể nhờ các cưng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841019
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841019,
					"content": "Nhưng giờ Haniyyah đã đi mất rồi, chúng ta phải đi đâu để tìm cô ấy đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841020,
					"content": "Lúc này cô ta chắc đang hoài nghi là thứ gì đã biến bản thân không còn tuyệt tình như trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841021
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841021,
					"content": "Đáp án ở ngay trên người ba cưng đó. Mấy cưng chắc biết rõ cô ta sẽ đi đến nơi nào mà đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841022,
						400841023
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841022,
					"content": "Tôi, Paimon và Layla sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841024,
					"content": "#Nơi mà tôi đã gặp {NICKNAME} và Paimon sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841025
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841025,
					"content": "Ngẫm kỹ lại thì hôm đó khi Layla nói sẽ đưa Nấm Quỷ về cuộc sống thường ngày và trở thành người đồng hành quan trọng, sắc mặt của Haniyyah đột nhiên thay đổi... Vậy cảm giác của Layla là đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841026,
					"content": "Chúng ta mau đuổi theo nói chuyện rõ ràng với Haniyyah thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841027,
					"content": "Layla, hãy ở lại đây đi! Tôi có thể hiểu được tấm lòng muốn giúp đỡ Haniyyah, nhưng cô ta không phải là người mà cô dễ đối phó. Lần này hãy giao cho họ xử lý đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841028
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841028,
					"content": "Ừm, cũng đúng... Chẳng may nói sai điều gì thì lại khiến Haniyyah phản ứng gay gắt. Hơn nữa mọi người đi nhanh quá, e rằng tôi đi được nửa đường thì lại ngất xỉu mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841029
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400841029,
					"content": "Sao cưng vẫn đứng đó vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841030,
						400841031
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841030,
					"content": "Đây là món đồ trước kia đã tìm thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841032
					]
				},
				{
					"id": 400841032,
					"content": "Ồ, thu hoạch nhiều hơn tôi nghĩ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841033
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841033,
					"content": "Vậy thì tôi sẽ chúc cưng \"may mắn\". Lần sau gặp lại tôi sẽ nói suy nghĩ của tôi cho mà nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400841031,
					"content": "Miko hãy xem qua và nghiên cứu nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841032
					]
				},
				{
					"id": 400841023,
					"content": "Chẳng lẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841016,
					"content": "Tuyến phòng thủ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841017
