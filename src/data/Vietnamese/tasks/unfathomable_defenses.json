						400841203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841203,
					"content": "Đợi đã... Cô đến đây để an ủi Hỏa-1 sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841204,
					"content": "Thật nực cười... Nếu Hỏa-1 không phải Nấm Quỷ mà chỉ là một loài động vật bình thường thì tôi sẽ vui mừng vì điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841205
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841205,
					"content": "Lần gặp mặt tiếp theo sẽ là trận chung kết rồi, có muốn nói gì thì hãy đợi cho đến khi đánh bại được tôi rồi nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841206,
						400841207
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841206,
					"content": "Chúng tôi muốn tìm hiểu xem cô đang nghĩ gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				},
				{
					"id": 400841208,
					"content": "Cách nói chuyện của các người giống hệt điều mà ả hồ ly kia dự đoán... Các người quá thật thà khi suy nghĩ một số chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841209
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841209,
					"content": "Các người sẽ không bao giờ hiểu được nếu tôi chỉ kể bằng vài câu. Hãy xem thứ này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841210
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841210,
					"content": "Đây là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841212,
					"content": "Đây là sổ ghi chép do tổ tiên tôi để lại, họ bị Nấm Quỷ tấn công khi ở trong rừng mưa, nhiều người trong số họ đã bị trọng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841213,
					"content": "Vào thời điểm đó, sự việc này không đáng nhắc đến, thậm chí còn không được ghi chép lại. Thế nhưng từ nhỏ đến lớn, người trong dòng họ luôn kể lại cho tôi câu chuyện đó, dạy bảo tôi về sự nguy hiểm của Nấm Quỷ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841214,
					"content": "Thì ra từng xảy ra chuyện như vậy, chả trách sao cô lại thù hận Nấm Quỷ như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841215,
						400841216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841215,
					"content": "Chúng tôi không hiểu rõ thân thế của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841217,
					"content": "Đúng vậy, nếu cô có một quá khứ như vậy thì càng nên hiểu rõ ý nghĩa của cuộc thi, xét cho cùng thì \"Ngọc Trí Tuệ\" có thể giúp con người và Nấm Quỷ sống hòa thuận với nhau mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841218,
					"content": "Sự tình không đơn giản như vậy, nếu các người nghĩ \"Ngọc Trí Tuệ\" có thể khiến Nấm Quỷ ôn hòa thì trước đây cũng từng có học giả đến thôn làng sử dụng đạo cụ tương tự vậy để làm thí nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841219
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841219,
					"content": "Nhưng họ đều sợ chạy mất dép rồi. Nay \"Ngọc Trí Tuệ\" cũng chỉ có thể tạm thời trấn áp bản tính hung ác của Nấm Quỷ. Nếu không có chúng, Nấm Quỷ vẫn rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841220
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841220,
					"content": "Hơn nữa, biên độ tăng trưởng trí tuệ của viên ngọc sẽ khiến sức mạnh nguyên tố của Nấm Quỷ trở nên bất thường và ảnh hưởng đến môi trường xung quanh. Người sức khỏe yếu sau khi sử dụng sẽ có tác dụng phụ ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841221
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841221,
					"content": "Sự bất thường của sức mạnh nguyên tố...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841222
					]
				},
				{
					"id": 400841222,
					"content": "Layla dạo này thường xuyên ho khan, lẽ nào là do Ngọc Trí Tuệ gây ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841223,
					"content": "Không cần tôi nói nhiều các người chắc cũng hiểu, thực chất Kautilya là một kẻ điên. Hắn ta chỉ muốn tăng sức ảnh hưởng của bản thân và đẩy mạnh sự kiện huấn luyện thú thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841224
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841224,
					"content": "Elchingen là kẻ gió chiều nào theo chiều nấy, vừa nhìn thấy thành quả nghiên cứu của Kautilya là đã dùng giải thưởng lớn để tuyên truyền cho cuộc thi này. Từ đó xóa bỏ cảnh giác của con người với Nấm Quỷ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841225
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841225,
					"content": "Dù thế nào thì tôi cũng sẽ không tin họ, cũng không tin Nấm Quỷ có thể chung sống cùng với con người. Nhưng với thân phận là một lính đánh thuê thì tiếng nói của tôi không được mọi người xem trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841226
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841226,
					"content": "Tôi đành phải thắng trong luật chơi của họ, giành lấy cái kết mà mình mong muốn, tránh để họ đạt được ý đồ xấu xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841227,
					"content": "Ban đầu tôi còn có chút hy vọng là các người sẽ giúp đỡ tôi, nhưng hóa ra là do tôi quá khờ dại mà. Dù thế nào thì tôi cũng sẽ đánh bại các người, không gì có thể cản được tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841228,
					"content": "Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841229
					]
				},
				{
					"id": 400841229,
					"content": "Cuốn sổ này giống như quá khứ của tôi, các người muốn làm thế nào cũng được. Dù sao thì sau khi đấu xong trận chung kết tôi cũng sẽ tuyên bố xóa sổ tất cả Nấm Quỷ... bao gồm cả Hỏa-1.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841230
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841230,
					"content": "Vĩnh biệt quá khứ của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 400841216,
					"content": "Nhưng nay đã khác xưa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841207,
					"content": "Chúng tôi muốn xóa bỏ thành kiến của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				}
			]
		},
