			"dialogs": [
				{
					"id": 400840801,
					"content": "Tôi hơi căng thẳng một chút, nhưng cũng rất mong chờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840802
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840802,
					"content": "Các bạn cũng đừng nhường tôi nhé, đội hình Quái Thú Xoay Tròn đã trải qua không ít trận chiến, thực lực không tệ đâu! Hãy để đồng đội của bạn dốc hết sức đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840803
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840803,
					"content": "Layla và Quái Thú Xoay Tròn, hãy tiếp chiêu đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
