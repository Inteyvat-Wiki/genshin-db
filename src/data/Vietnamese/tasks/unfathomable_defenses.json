			},
			"dialogs": [
				{
					"id": 400841001,
					"content": "Ủa gì vậy... Chẳng lẽ cuộc đấu đã kết thúc rồi sao? Không khí nặng nề như vậy... Lẽ nào Miko đã thắng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841002,
					"content": "Cuộc đấu của các cưng đã kết thúc rồi sao? Mất nhiều thời gian như vậy, chắc hẳn là kỳ phùng địch thủ rồi...",
					"roleType": "TALK_ROLE_NPC",
