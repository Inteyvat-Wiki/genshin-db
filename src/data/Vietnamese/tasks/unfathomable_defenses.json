					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841501,
					"content": "Vẫn không ổn, chỉ có lựa chọn duy nhất là đánh bại Haniyyah trên sân đấu thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841502,
						400841503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841502,
					"content": "Ít ra cũng nghe được suy nghĩ thực sự của cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				},
				{
					"id": 400841504,
					"content": "Haniyyah nói là các học giả trước kia từng thử kiềm chế tai họa do Nấm Quỷ tạo ra sao? Cuốn sổ này hình như còn khá nhiều nội dung, chúng ta đọc tiếp đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841506,
					"content": "Đây là ghi chép nghiên cứu của các học giả... được tổ tiên Haniyyah thu thập lại ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841507,
					"content": "Ồ, phần nội dung này thật phức tạp, chữ viết thì nguệch ngoạc, còn có nhiều thuật ngữ nữa chứ, xem thế nào cũng không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841508,
					"content": "Có điều xuất hiện nhiều từ ngữ quen thuộc rồi... hình như từng thấy qua trên món đồ mà Dori đưa cho chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841509,
						400841510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841509,
					"content": "Sổ ghi chép và món đồ đó có liên quan với nhau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841511,
					"content": "Chúng ta thử suy nghĩ và kết hợp những văn bản còn sót lại để đọc hiểu nội dung sổ ghi chép nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841512,
					"content": "Trang Bị Săn Bắt? Thuốc Khô Héo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841513,
						400841514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841513,
					"content": "Trang Bị Săn Bắt khiến Nấm Quỷ trở nên ôn hòa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841515,
					"content": "Thì ra là vậy... Những con Nấm Quỷ tấn công tổ tiên Haniyyah trước kia là do ảnh hưởng của thuốc dẫn đến mất kiểm soát... Còn học giả tạo ra Trang Bị Săn Bắt là để tóm những con Nắm Quỷ hóa điên lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841516,
					"content": "Hơn nữa \"Rau Câu Hoa Hoa\" của hiện tại là phiên bản nâng cấp của \"Thuốc Khô Héo\", hơn nữa \"Ngọc Trí Tuệ\" cũng không phải là do Kautilya phát minh sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841517,
					"content": "Kautilya cơ bản là chỉ dựa trên nguyên lý của Trang Bị Săn Bắt để làm ra hai mẫu mới mà thôi, đúng là kẻ lừa đảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841518,
						400841519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841518,
					"content": "Đồ lừa lọc!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841520,
					"content": "Nhưng mà Kautilya muốn quảng bá \"Ngọc Trí Tuệ\" với mục đích gì cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841521,
						400841522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841521,
					"content": "Có lẽ muốn hoàn thành thử nghiệm của người tiền nhiệm chăng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841523,
					"content": "Vậy thì chúng ta phải mau cảnh báo Elchingen để không tài trợ tiền cho Kautilya nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841524,
					"content": "Còn về Haniyyah thì... những con Nấm Quỷ tấn công tổ tiên cô ấy đều do bị kích động. Do không rõ sự tình, chả trách cô ấy không thể tha thứ cho Nấm Quỷ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841525,
					"content": "\"Nón Trống Tròn\" đừng lo lắng nhé. Tôi tin rằng bạn sẽ không bị \"Rau Câu Hoa Hoa\" ảnh hưởng mà trở nên điên loạn đâu! Xét cho cùng thì sau khi tắt \"Ngọc Trí Tuệ\", bạn vẫn là đứa trẻ ngoan mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841526,
					"content": "Woa, nghe hiểu những gì tôi nói sao? Ngày càng thông minh rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841527,
						400841528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841527,
					"content": "Đợi chút Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841529,
					"content": "Hả? Từ lúc nào vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841530,
					"content": "Vậy có thể nói là \"Nón Trống Tròn\" hiện tại đã nhờ vào tính cách bản năng để sống chung với chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841531,
						400841532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841531,
					"content": "Trải nghiệm sống chung đã ảnh hưởng đến nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841533,
					"content": "Vậy mới nói tôi không đồng tình với suy đoán của Haniyyah rằng Nấm Quỷ sẽ mất kiểm soát! Nấm Quỷ cũng có Nấm Quỷ tốt mà, giống như \"Nón Trống Tròn\" vậy, hiểu được tính người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841534,
					"content": "Có một điểm mà Haniyyah nói có lý là... \"Ngọc Trí Tuệ\" không phải thứ vạn năng. Nếu khuyết điểm đó vẫn tồn tại thì Nấm Quỷ không thể ở mãi bên người bình thường được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841535,
					"content": "Tôi còn định cùng \"Nón Trống Tròn\" tiếp tục chuyến hành trình nữa mà... Không còn cách nào khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841536,
						400841537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841536,
					"content": "Hiện tại phải giữ khoảng cách với chúng trước đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841538,
					"content": "Tuy có chút đáng tiếc, nhưng mà hiện tại chỉ có thể như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400841539,
					"content": "Giờ cách chung kết vẫn còn một khoảng thời gian, chúng ta có nên báo cáo với Giáo Viện về sự việc của Kautilya không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841540,
						400841541
					],
					"speakerTitle": "Paimon"
				},
				{
