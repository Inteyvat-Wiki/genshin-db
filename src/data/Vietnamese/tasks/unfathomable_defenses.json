						"stepId": 4008406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840601,
					"content": "#{NICKNAME}, Paimon, tôi lọt được vào vòng trong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840602
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840602,
					"content": "Tuyệt quá, Layla! Cô đã hoàn thành được mục tiêu tham gia giải đấu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840603,
					"content": "Thật đáng mừng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840604
					]
				},
				{
					"id": 400840604,
					"content": "Tôi nghe nói các bạn đã đánh bại được Thiết Cốt Song Đao đúng không... Nhưng sao tôi thấy các bạn hình như không được vui nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840605
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840605,
					"content": "Nói thế nào nhỉ... Đối thủ này không thân thiện lắm và nói rất nhiều điều kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840606,
					"content": "Kể cho Layla biết chi tiết của trận đấu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400840607
					]
				},
				{
					"id": 400840607,
					"content": "Thì ra là vậy... Tôi cứ cảm thấy người luyện thú kiểu này hơi... bi ai nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840608
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840608,
					"content": "Bi ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840609
					]
				},
				{
					"id": 400840609,
					"content": "Ừm, người đó rõ ràng không hiểu Haniyyah, vì vậy anh ta chỉ suy đoán về cô ấy dựa trên những ấn tượng mơ hồ, và thậm chí bắt chước cô ấy. Nếu Haniyyah biết chuyện này thì có lẽ cũng sẽ cảm thấy khó chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840610
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840610,
					"content": "Hơn nữa, người luyện thú đó quá nghiêm khắc với đồng đội nấm mà lẽ ra có thể trở thành bạn tốt, không chỉ khiến anh ta bị tổn thất, mà còn ảnh hưởng đến tâm trạng của những tuyển thủ khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840611
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840611,
					"content": "Đúng vậy, tôi thấy tâm trạng của Layla rất tốt! Nếu tất cả mọi người đều giống như cô thì bầu không khí của giải đấu này sẽ hài hòa và vui vẻ hơn nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840612,
					"content": "Chỉ là vì mục tiêu của tôi không cao thôi... Chỉ cần có thể mang Quái Thú Xoay Tròn về sống cùng là tôi đã rất mãn nguyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840613
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840613,
					"content": "Vòng sau là đến lượt chúng ta đối đầu rồi. Chúng ta phải so tài một trận thật vui vẻ nhé, thắng thua không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840614
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840614,
					"content": "Nhất định rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840615
					]
				},
				{
					"id": 400840615,
					"content": "Chơi luôn! Để tôi xem thử \"Quái Thú Xoay Tròn\" với \"Nón Trống Tròn\" ai mạnh hơn! Bên thua phải mời bên thắng ăn cơm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840616,
					"content": "Mấy cưng thỏa thuận vui vẻ như vậy, lẽ nào tôi đã bỏ lỡ thứ gì đó rồi chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840617
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840617,
					"content": "Miko, cuối cùng cô cũng xuất hiện! Lúc trước không nói lời nào là đã bỏ đi rồi. Chúng tôi có một vài manh mối... Ấy nhầm, một vài chuyện muốn bàn bạc với cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840618,
					"content": "Tôi cũng đang buồn rầu đây, ban đầu nghĩ là thi đấu cho vui, ai ngờ vào hẳn bán kết. Bây giờ không thể dành thời gian cùng Souka đi tìm nguồn cảm hứng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840619
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840619,
					"content": "Đừng lo lắng, hai cưng chắc chắn sẽ có cuộc chiến vui vẻ với nhau. Còn tôi thì phải nghiêm túc một chút, dù gì đối thủ cũng là một kẻ cứng đầu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840620
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400840620,
					"content": "Đúng vậy, không ngờ lại thành ra thế này, Yae đối đầu với Haniyyah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840621
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400840621,
					"content": "Lạc quan lên nào, không chừng Miko lại giúp chúng ta đánh bại Haniyyah đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400840622,
					"content": "Cơ mà nếu là như vậy thì chúng ta lại không thể tự mình thuyết phục được Haniyyah rồi... Nhưng Paimon vẫn mong Miko thắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4008408,
			"completionStepIds": [
				4008408
			],
