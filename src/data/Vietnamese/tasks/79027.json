			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Miitoboru\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "Nguy hiểm thật, cảm giác vừa rồi suýt chút nữa đã bị đánh chìm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270602,
					"content": "\"Kosekimaru\", giỏi lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270603,
					"content": "#Ha ha, thuyền biết nói thì cũng là thuyền thôi, có thể xuyên qua dông bão như thế, không thể không kể đến kỹ thuật điều khiển điêu luyện của {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270604,
					"content": "Muốn làm lại lần nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "Ha ha, đừng làm thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270607,
					"content": "Haiz, cơn bão vừa rồi e là bị ảnh hưởng từ tôi, như vậy xem ra, vùng biển này đã không còn ổn định nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270608,
					"content": "#Nhưng cũng đúng lúc...{NICKNAME}, Paimon, kho báu ở trên đó đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270609,
					"content": "Đây chẳng phải chỗ đầu tiên chúng ta tới tìm kho báu ư, trên đó chỉ có đoạn thuyền vỡ của \"Kosekimaru\" bạn thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270610,
					"content": "Lần này trên đó chắc chắn có kho báu, đây chính là... Nói sao đây nhỉ, đây chính là \"trực giác của thuyền hải tặc\" đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270611,
					"content": "Thật sao... đúng rồi, lúc trước \"Kosekimaru\" nói có hai chuyện muốn nói với chúng tôi, một chuyện là bạn đã nhớ lại tên của mình, chuyện còn lại là gì thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270612,
					"content": "Ha ha ha, tôi còn tưởng là bạn đã quên rồi chứ, chuyện còn lại, chờ các bạn trở về tôi sẽ nói cho các bạn biết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270605,
					"content": "Cảm ơn đã khen ngợi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
		{
			"id": 7902710,
			"completionStepIds": [
				7902708,
				7902710
			],
