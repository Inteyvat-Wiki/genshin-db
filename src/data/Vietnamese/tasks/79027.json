				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Miitoboru\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "Úi chà, các bạn tới rồi, tôi còn tưởng ngày nào các bạn cũng dùng đôi cánh kia bay tới bay lui giữa các đảo chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270102,
					"content": "Quên mất ông bạn già \"Miitoboru\" ngâm mình trong nước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270103,
					"content": "Chẳng phải chúng tôi đã nhớ tới bạn rồi đây sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270104,
					"content": "Đúng rồi, chuyện bạn nói cần giúp đỡ lúc trước là gì thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270105,
					"content": "Thật ra cũng không phải chuyện gì quan trọng... Chẳng phải lần trước các bạn giúp tôi tìm lại mảnh vỡ thân thể sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270106,
					"content": "Nên nói sao nhỉ, không biết là vì đạt được tâm nguyện... Hay là vì sức mạnh giúp tôi có thể nói chuyện ở bãi biển này dần biến mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270107,
					"content": "Gần đây tôi ít khi tỉnh táo, thời gian ngủ càng lúc càng dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270108,
					"content": "Chẳng lẽ có liên quan đến thiết bị đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "#Hóa ra là vậy, vì có thiết bị gì đó, mà tôi mới có thể biến thành thuyền gió của {NICKNAME}, cũng có thể nói chuyện trao đổi với bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270111,
					"content": "A... vậy sau khi thiết bị không còn ảnh hưởng nữa, thì chẳng phải Miitoboru sẽ không thể nói chuyện nữa hay sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270112,
					"content": "#{NICKNAME}, hay là chúng ta nghĩ cách gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270113,
					"content": "Ha ha, không cần đâu, Paimon... có thể nói chuyện với các bạn như bây giờ, tôi đã thỏa mãn lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270114,
					"content": "Ừm... Ngẫm lại, một chiếc thuyền như tôi lại có thể thoải mái giao lưu với các bạn mấy ngày qua, đã giống một giấc mơ đẹp lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270115,
					"content": "Nhưng bây giờ tôi còn một chuyện muốn nhờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270116,
					"content": "Cứ nói đừng ngại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "Chẳng phải lúc trước luôn nói, đợi tới khi tìm được thân thể của tôi thì sẽ đưa các bạn căng buồm ra khơi sao, có điều thân thể của tôi đã thành như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270125,
					"content": "Phần lớn kho báu cũng bị mang đi, không còn lại thứ gì tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270118,
					"content": "Nhưng lần này tôi lấy danh dự của một chiếc thuyền hải tặc ra thề, nhất định sẽ có một kho báu cực đỉnh! Cứ xem như bị tôi lừa thêm lần nữa, đi cùng tôi được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270119,
					"content": "#{NICKNAME}, nói không chừng \"Miitoboru\" sắp sửa không thể nói chuyện được nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270120,
					"content": "#Hơn nữa... đây chính là kho báu đó! Chúng ta đi cùng nhé, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270121,
					"content": "Thật hết cách với bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "Vậy chúng ta xuất phát đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270124,
					"content": "Hay lắm, vậy thì mời hai vị lên thuyền nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Miitoboru\""
				},
				{
					"id": 790270122,
					"content": "Đã nói tới nước này rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "Thiết bị đã đóng nên gây ảnh hưởng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
