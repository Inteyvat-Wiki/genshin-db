			"dialogs": [
				{
					"id": 761220101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "Ủa? Lạ thật, tôi vừa nghe thấy giọng của Columbina thì phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "...Hây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220104,
					"content": "Ốiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220106,
					"content": "Lại bị cô làm giật mình rồi! Cô ở đây rồi mà sao không nói sớm chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "Tôi nghĩ hai người đã quen với trò này rồi, nên lần này tôi đã tăng độ khó một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220108,
					"content": "Đáng ghét, lần sau tôi cũng phải tìm cơ hội hù cô mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "Được thôi, tôi sẽ chờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220110,
					"content": "Columbina, màng che mắt của cô đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Ồ, hình như lúc nãy chơi đùa với các Kuuhenki, bị chúng làm rơi mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220112,
					"content": "Bình thường tôi cũng không cần mở mắt, nên cũng chẳng có gì khác biệt cả. Chúng thích thì cứ để chúng lấy đi chơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220113,
					"content": "Mà Columbina không định ra ngoài đi dạo thêm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "Cô không cần phải trốn tránh ai nữa rồi nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Ừm... Giờ có nhiều thời gian, tôi muốn đi lúc nào cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220116,
					"content": "Nhưng nghĩ tới việc hai người có thể sẽ tìm tôi, nếu đột ngột rời đi mà không nói gì thì có lẽ sẽ khiến hai người lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220117,
					"content": "Vào trường hợp này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "Đúng rồi, chỉ cần chúng tôi biết cô không sao là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "Được rồi, tôi sẽ cân nhắc chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220121,
					"content": "Chỉ cân nhắc thôi à...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "Nhỡ Columbina lại thích nơi này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Những chuyện xảy ra ở đây, đối với tôi đều là những kỷ niệm đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220124,
					"content": "Nhưng tôi chờ hai người ở đây là còn có lý do khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220125,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "Tôi muốn cho hai người một bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220118,
					"content": "Để lại một mảnh giấy là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
