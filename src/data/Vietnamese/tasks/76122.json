						761220202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220202,
					"content": "Luonnotar! Là Luonnotar trong trẻo thật này! Tôi cứ tưởng sẽ không bao giờ gặp lại cô nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220203,
					"content": "Bức tranh vừa rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "Chúng ta đã dùng ánh trăng để phác họa hình hài cho đứa nhóc này, tôi đã truyền vào đó sức mạnh và chúc phúc mới, để nó được tái sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220205,
					"content": "Giờ nó không cần phải chứa đựng linh hồn của tôi nữa, nó đã có ý chí riêng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220206,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220207,
					"content": "Ah, nó bay tới kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220208,
					"content": "Ừm, tôi đã đánh thức tất cả những ký ức về khoảng thời gian nó ở bên hai người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220210,
					"content": "...! ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220211,
					"content": "Híc, tốt quá rồi, Luonnotar à, sau này tôi nhất định sẽ tốt với cô hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220212,
					"content": "Không ngờ lại là bất ngờ này... Tôi thích lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220213,
					"content": "Cảm ơn cô, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "Không có gì đâu. Có thể gặp lại Luonnotar, tôi cũng rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220216,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220217,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220218,
					"content": "(Cô ấy vẫn rất yêu quý Luonnotar, nhưng biểu cảm của cô ấy lúc này đã khác xưa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "(Có vẻ như đối với cô ấy, nó không chỉ là sinh vật được tạo ra, mà còn là một người bạn thân thiết.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "Đi đi, nhớ họ lắm rồi phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761220221,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220222,
					"content": "Hoan nghênh hai người quay lại bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
