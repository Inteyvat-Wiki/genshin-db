			"dialogs": [
				{
					"id": 120480101,
					"content": "Xin chào! Vui lòng đến đăng ký ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120480102,
					"content": "Ngày gì thế không biết, sao lại nhiều người đến thế này? Sớm biết thì đã giới hạn số lượng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120480103,
					"content": "Woa, sau khi giải quyết vấn đề của Emura Ichigensai, có vẻ như việc kinh doanh đã tốt hơn nhiều rồi! Murasaki và Shion cũng đã hồi phục rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480104,
					"content": "#Chào buổi sáng, {NICKNAME} và Paimon, đến đây để đặt lịch à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480105,
					"content": "Đúng vậy, ngay hôm nay luôn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480106,
					"content": "Vậy tôi phải chuẩn bị vé VIP cho hai vị rồi, dù sao cả hai cũng là khách quý của tiệm chúng tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480107,
					"content": "Tuyệt vời! Lần này tôi muốn trải nghiệm dịch vụ ẩm thực trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480108,
					"content": "Ây da, hôm trước tôi đưa ra đề nghị thoái vốn, suýt nữa khiến cô mất đi mối làm ăn tốt như vậy rồi. Cô không oán trách tôi chứ, bạn cũ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480109,
					"content": "Tôi hoàn toàn không có cân nhắc đến đề nghị của cô mà, nên sao có thể trách cô chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480110,
					"content": "Chính là giọng điệu này đó, thật là thân thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480111,
					"content": "Lại chơi trò bất thình lình xuất hiện à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480112,
					"content": "Chào buổi sáng nhé mấy đứa! Cảnh sắc đêm qua đẹp chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480113,
					"content": "Cô nhìn lén chúng tôi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "Nhìn lén? Cái cây đó ở ngay dưới Đền Narukami mà, lẽ nào bắt tôi chuyển đền đi chỗ khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480115,
					"content": "Đại nhân Guuji đến đây có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480116,
					"content": "À... Xem như đi dạo thôi, tiện thể mang tin tức từ Hiệp Hội Tenryou đến ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480117,
					"content": "Cái tên được đồng loại của cô vớt lên từ dưới nước tối qua đã may mắn sống sót, nhưng tâm trí đã bị suy giảm về trình độ trẻ con rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480118,
					"content": "Giữ được mạng là tốt rồi... Ngoài ra, tôi phải cảm ơn đại nhân Guuji đấy. Chuyện tối qua được giải quyết suôn sẻ như vậy cũng là nhờ có cô giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480119,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480120,
					"content": "Không phải tôi nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "Miko... Giữa hai chúng ta thì xưa nay tôi luôn là người che giấu bí mật giỏi hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480122,
					"content": "Để mà nói thì tôi vẫn luôn có sự tự ti và hiếu thắng khi đối diện với cô. Hoặc có thể nói chính nhờ hai cảm xúc này mà tôi mới có động lực để phát triển công việc kinh doanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480123,
					"content": "Tự ti khiến tôi giữ vững tỉnh táo, hiếu thắng giúp tôi kiên trì đi tiếp. Đây là vấn đề tâm lý đã được giải quyết thỏa đáng, không cần cô phải lo lắng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480124,
					"content": "Haiz... Biết thế nói rõ từ sớm thì đã không cần hai cưng đây phải vất vả chạy đôn chạy đáo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480125,
					"content": "#Hành động của {NICKNAME} vẫn có ý nghĩa riêng, dù sao tôi cũng hiểu nỗi bận tâm của đại nhân Guuji mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480126,
					"content": "Emura Ichigensai đã tập trung được rất nhiều tín đồ. Trước khi bí mật bị bại lộ, nếu như Guuji của Đền Narukami tùy tiện gây sức ép thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480127,
					"content": "Một đám tín đồ giận dữ sẽ ảnh hưởng thế nào đến danh tiếng của Đền Narukami đây? Thật khó lường, vậy nên cô tốt nhất không nên trực tiếp ra mặt trong chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480128,
					"content": "Điểm này đương nhiên tôi biết. Nhưng tâm trạng của người bạn cũ vẫn khiến tôi lo lắng hơn đấy, nếu không thì tôi đâu cần phải đi đường vòng như thế chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480129,
					"content": "Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480130,
					"content": "Cô quả nhiên vẫn là một người thú vị nhưng chẳng đáng yêu lắm... Xem ra nỗi lo về phiền não mà cô gặp phải là lo bò trắng răng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480131,
					"content": "...Tôi vẫn có những muộn phiền riêng. Nhưng mỗi sự phiền não đều có thuốc giải của riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480132,
					"content": "Đây là vé VIP mới, hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
