			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dẫn Truyện",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "\"Người dân hiện tại không thể nhớ được, nhưng học giả biết rằng trong thời gian hỗn loạn chừng 600 năm trước thời đại thánh đồ, công chúa điện hạ đã đến với thế gian.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "Dẫn Truyện"
				},
				{
					"id": 400710302,
					"content": "Không thể nào? Dẫn truyện sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710303,
					"content": "Không hổ danh là thế giới trong sách, có cả dẫn truyện cho chúng ta nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710304,
					"content": "Nhưng hết đường rồi, không qua kia được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710305,
					"content": "Bên đó có một thiết bị, giống như đang đợi chúng ta đến gần vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710306,
					"content": "Tôi cứ cảm thấy... mọi thứ ở đây như đang hơi lố đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710307,
					"content": "Là Thánh Quốc mà. Thông cảm chút đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710308,
					"content": "Cũng đúng, như đang hy vọng được người ta phát hiện ra vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710309,
					"content": "Không hổ danh là Fischl, nơi này lạ thường đến đáng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
