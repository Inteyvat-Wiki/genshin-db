				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "Tỉnh rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710202,
					"content": "Ưm... trời lại sáng rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "Sao rồi? Có cái gì xuất hiện sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "#Nói ra có thể {NICKNAME} không tin, nhưng không có chuyện gì xảy ra hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710205,
					"content": "Bạn tỉnh rồi sao? Chúng tôi đã đi thám thính xung quanh rồi, không có gì khả nghi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710206,
					"content": "Theo quy luật của hai ảo cảnh trước đó thì chắc phải có vật phẩm đại diện cho \"lối vào\" mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710207,
					"content": "Thế thì lạ thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "Hay là chưa tới lúc nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710209,
					"content": "Ý là phải chờ thêm một thời gian nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710210,
					"content": "Ừm, huống chi Fischl cũng không có ở đây. Theo tôi nghĩ thì rất có thể Fischl còn nóng lòng muốn tìm ra cửa vào hơn cả chúng ta ấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710211,
					"content": "Chúng ta chờ thêm chút nữa nhé. Cho ảo cảnh... à không, cho Fischl thêm chút thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710212,
					"content": "Mọi người đều đồng ý với Mona nên đã cùng thư giãn nghỉ ngơi, sau đó lại chia làm hai đội tìm kiếm xung quanh.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "Sau khi đi qua đi lại, trên bãi biển đột nhiên xuất hiện một vài thứ.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "Có cái gì đó rơi trên cát kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710215,
					"content": "Là một quyển sách? Bên cạnh còn có một... ồ... là bức tượng quạ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710216,
					"content": "Bức tượng này nhìn giống Oz quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710217,
					"content": "Chúng xuất hiện cạnh nhau là sao? Quyển sách này cũng do nó đưa tới ư??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710218,
					"content": "Mà đây là gì? Trông có vẻ như là nhật ký nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710219,
					"content": "Để tôi xem... \"Bài Ca Thánh Quốc\"? Tôi chưa từng thấy quyển sách có tựa này qua bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710220,
					"content": "Nhìn bìa sách, chẳng lẽ là do... Fischl tự viết ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710221,
					"content": "Nói mới nhớ, đúng là phong cách của cô ấy. \"Bài Ca Thánh Quốc\", tên cũng hay đấy, tôi thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400710222,
					"content": "Tên quyển sách này nghe có cảm giác thiêng liêng thần thánh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400710223,
					"content": "Vậy giờ chúng ta phải chạm vào nó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400710224,
					"content": "...Fischl vẫn chưa về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710225,
					"content": "Thôi, chúng ta cứ đi trước đi. Nếu Fischl thấy quyển sách này thì chắc sẽ tìm đến chúng ta thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400710226,
					"content": "Tôi đồng ý! Giống như bị người ta đọc lén nhật ký ấy, chắc chắn phải tới ngay để ngăn cản chúng ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007103,
			"completionStepIds": [
				4007103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
