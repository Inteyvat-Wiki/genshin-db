				},
				{
					"id": 400711411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711412,
					"content": "Ừm... mọi người có gì muốn nói không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "Tôi hỏi thẳng nhé, Amy... có phải là tên thật của Fischl không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711415,
					"content": "Chắc là vậy. Hai giọng nói khi nãy hình như là cha và mẹ cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711416,
					"content": "...Nhìn tôi làm gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711417,
					"content": "Có thể hơi mạo muội, nhưng... cô thật sự mang họ Megistus à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711418,
					"content": "Hừ, có phải anh đang xem thường tôi không? Tên đầy đủ của thiên tài tôi đây là Nhà Chiêm Tinh Mona Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711419,
					"content": "...Xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711420,
					"content": "Dài quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711421,
					"content": "Chỉ có thiên tài mới có cái tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711422,
					"content": "Cứ thấy vô lý thế nào ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711423,
					"content": "Qua những chuyện vừa rồi, mọi người cảm thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711424,
					"content": "Tôi chắc chắn được một chuyện, \"đóng sách lại\" cũng là một cách khiến ảo cảnh thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711425,
					"content": "Người nhà của Fischl còn phối hợp để diễn với cô ấy cơ, giỏi quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711426,
					"content": "Nhưng không thể như thế mãi được. Nghe giọng nói này, có vẻ đây là hồi ức khi còn nhỏ của cô ấy nhỉ? Lúc lớn thì không còn như vậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711427,
					"content": "Mona biết nhiều thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711428,
					"content": "Thân là bạn bè thì biết những điều đó là chuyện bình thường mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711429,
					"content": "...Bây giờ Fischl đang ở đâu nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711430,
					"content": "Giọng nói vừa rồi bảo rằng cô ấy sắp đi ra ngoài, hay là chúng ta cũng ra ngoài xem sao, có lẽ sẽ có manh mối đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
