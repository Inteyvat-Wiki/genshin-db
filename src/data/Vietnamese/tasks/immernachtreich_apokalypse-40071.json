			"dialogs": [
				{
					"id": 400711001,
					"content": "Trời ơi, xin hãy cứu tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711002,
					"content": "Này, đó không phải là một bức tượng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711003,
					"content": "Xin đừng nói như vậy! Tôi là kỵ sĩ của Vương Đô U Ám, Leon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711004,
					"content": "Kỵ sĩ? Trông không giống chút nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711005,
					"content": "Không giống sao? Không sao cả, nhưng xin các bạn đừng chê trách đại nhân Ozvaldo, người đã thiết kế áo giáp cho các Kỵ Sĩ Quạ Đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711006,
					"content": "Đại Nhân Ozvaldo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME} chắc đã từng nghe qua rồi đúng không? Tên đầy đủ của Oz là Ozvaldo Hrafnavins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711008,
					"content": "Tôi có nghe qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "Vẫn dễ đọc hơn Megistus một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711011,
					"content": "Ừm, tôi cũng nghĩ như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711012,
					"content": "Ahaha, ai cũng nói vậy cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711013,
					"content": "Các bạn, tôi không muốn làm phiền thời gian trò chuyện vui vẻ của mọi người, nhưng có lẽ các bạn vẫn chưa biết cánh cửa phía trước đã bị khóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711014,
					"content": "Đúng là không biết thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711015,
					"content": "Mong các bạn có thể cứu giúp tôi, để báo đáp, tôi vô cùng sẵn lòng nói cách mở cửa cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400711016,
					"content": "Anh đã nói đến vậy rồi... Được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711009,
					"content": "Bây giờ thì tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
