					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711502,
					"content": "Không đúng không đúng, sao lại quay về rồi! Câu chuyện vẫn chưa kết thúc mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711503,
					"content": "Cảm giác này tệ quá, cảm giác lưng chừng như mua trúng quyển sách chiêm tinh lậu hay là đang ăn thì phát hiện quên mang tiền vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711504,
					"content": "Argh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711505,
					"content": "Argh...! Thật khó chịu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711506,
					"content": "Trông cả hai như đang bị kích động vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711507,
					"content": "Thành thật mà nói, tôi cũng không thích đọc những quyển sách lưng chừng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711508,
					"content": "Haha, ai mà thích chứ. Mọi người, vậy chúng ta vào lại ảo cảnh lần nữa nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711509,
					"content": "Ý hay đó! Vậy chúng ta đi ngay thôi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711510,
					"content": "...Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711511,
					"content": "Không có phản ứng, địa điểm cũng không thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711512,
					"content": "Lạ thật, vừa rồi còn có thể đi vào, nhưng bây giờ lại chặn chúng ta ngoài cửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711513,
					"content": "Tại sao chứ! Định không cho người ta đọc xong cuốn sách sao! Ác thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711514,
					"content": "Ừm... hay là bởi vì, cuốn sách này đã được \"đọc hết rồi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711515,
					"content": "Trước khi rời khỏi ảo cảnh, cuốn sách chúng ta đọc đã được lật đến trang cuối cùng, tôi nghĩ \"Bài Ca Thánh Quốc\" không chỉ có một quyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711516,
					"content": "Vậy là giống như các thể loại tiểu thuyết dài tập... muốn xem tiếp thì phải mua quyển tiếp theo đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711517,
					"content": "Đáng ghét, tôi nhất định phải xem được kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711518,
					"content": "Ồ, vâng, là kết thúc, ai cũng muốn đọc đoạn kết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711519,
					"content": "Hửm? Ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711520,
					"content": "Ôi, ôi trời, cô ấy nhìn thấy mình rồi, đứng im đứng im.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711521,
					"content": "Anh là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711522,
					"content": "Tôi là \"Arnold Mong Muốn Được Hỏi Đường\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711523,
					"content": "Cái tên thật là có mục đích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711524,
					"content": "Arnold này, tôi muốn hỏi anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711525,
					"content": "Là \"Arnold Mong Muốn Được Hỏi Đường\", không phải Arnold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711526,
					"content": "Arnold Mong Muốn Được Hỏi Đường, tôi muốn hỏi anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711527,
					"content": "Vâng thưa quý cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711528,
					"content": "Có phần tiếp theo của \"Bài Ca Thánh Quốc\" không? Nó ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711529,
					"content": "Ôi, cô hỏi đúng người rồi. \"Bài Ca Thánh Quốc\" là sách thánh của Vương Đô U Ám, tổng cộng có ba quyển, hai quyển còn lại được cất ở hai nơi cao trong thành trì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711530,
					"content": "Nếu muốn tìm tập hai thì phải leo lên đỉnh tháp cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711531,
					"content": "Tháp cao, là tòa tháp ở đằng kia phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711532,
					"content": "Đúng vậy, đó là ngọn tháp nơi cất giữ sách thánh. Có một lối đi bí mật để đưa mọi người đến đó nhanh chóng, chỉ cần mọi người tìm kỹ trong hang động đằng kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711533,
					"content": "Được rồi, cảm ơn Arnold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711534,
					"content": "Là \"Arnold Mong Muốn Được Hỏi Đường\", không phải Arnold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711535,
					"content": "Quý cô xinh đẹp ơi, cô còn chuyện gì khác muốn hỏi tôi nữa không? Ví dụ như có bạn gái chưa, thu nhập hằng tháng thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400711536,
					"content": "Không, tạm biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711537,
					"content": "Đừng để ý đến con quạ đêm đó. Trong hang động trước mặt có một lối đi bí mật, có thể dẫn đến đỉnh tháp, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711538,
					"content": "Ôi, ôi quý cô! Cô thật sự không có hứng thú với tôi sao? Tôi thấy cô xinh đẹp như thế nên mới kể cho cô nghe bí mật của Vương Đô U Ám kia mà! Này quý cô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		}
	]
}