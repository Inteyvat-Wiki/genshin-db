			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "Hình như phía trước hết đường rồi, chỉ có một cuốn sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711302,
					"content": "Những gì chúng ta vừa nghe được là câu chuyện trong sách đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400711303,
					"content": "Vì thế, Thánh Quốc trong sách chính là Vương Đô U Ám. Cuốn sách này đang dùng giọng điệu ca tụng công chúa điện hạ của người dân ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400711304,
					"content": "Cũng có thể xem như là một cuốn tự truyện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "Đã lật đến trang cuối cùng rồi, nhưng câu chuyện của họ dường như vẫn chưa kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400711306,
					"content": "Còn phần tiếp theo thì sao? Tôi muốn nghe phần tiếp theo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400711307,
					"content": "Vậy thì chúng ta phải tiếp tục khám phá rồi. Với lại khi đọc xong sách thì chúng ta... nên đóng nó lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
