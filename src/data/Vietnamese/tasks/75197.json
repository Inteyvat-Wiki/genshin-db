					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751970505,
					"content": "Orban bắt đầu chế tạo vũ khí...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751970501
					]
				},
				{
					"id": 751970501,
					"content": "Làm xong rồi! Hahaha, nào, cầm lên xem, có phải rất đã tay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970502
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970502,
					"content": "Cháu phải trả bao nhiêu tiền?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970503
					]
				},
				{
					"id": 751970503,
					"content": "Tiền? Không cần đâu, cháu mang những vật liệu này cho chú chế tạo vũ khí khiến chú rất vui rồi, không cần trả tiền nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970504
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970504,
					"content": "Được rồi, hãy mang vũ khí này đi mạo hiểm đi, hãy trân trọng nó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
		},
		{
			"id": 7519706,
