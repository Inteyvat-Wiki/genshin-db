			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751970102,
					"content": "Cháu về rồi sao, số \"răng\" đó... Ồ, cháu đã tìm đủ rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970103
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970103,
					"content": "Khi hai đứa đi thám hiểm thì bên chú có chút vấn đề... Cho dù chú dùng cách gì thì cũng không thể đập vỡ được mảnh nào của chiếc răng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970104
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970104,
					"content": "Chú chưa từng gặp phải chuyện kỳ lạ như vậy, thế nên đã nhờ người đi hỏi Albedo xem phải làm sao để xử lý nguyên liệu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970105
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970105,
					"content": "Thế là... Nhìn xem, Albedo đã nhờ Sucrose đưa một viên đá phép đến đây, đang đặt ở đài giả kim đằng kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970106
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970106,
					"content": "Hả, đá phép? Việc này và răng rồng có liên quan gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970107,
					"content": "À, theo như tiểu thư Sucrose chuyển lời từ Albedo, muốn dùng nguyên liệu này rèn vũ khí thì cần phải thực hiện một số thao tác đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970108
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970108,
					"content": "Một trong những cách xử lý đó là để một chiếc răng rồng hấp thu sinh mệnh nào đó có liên quan đến rồng, sau đó sử dụng nó để xử lý những chiếc răng rồng khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970109
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970109,
					"content": "Viên đá phép này... Để chú nghĩ xem tiểu thư Sucrose nói như thế nào... À đúng rồi, nghe nói đây là \"di vật mà gánh hát rong từ một ngàn năm trước từng giúp Mondstadt chống lại giới quý tộc cũ đã để lại cho Đội Kỵ Sĩ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970110
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970110,
					"content": "Người thổi sáo trong gánh hát đó từng giao chiến với quái thú đáng sợ tên là \"Bakunawa\" ở Vùng Biển Lặng, và lấy được viên đá này từ trên người của nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970111
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970111,
					"content": "Ủa? Chờ đã, nếu nhớ không lầm thì hình như Citlali đã từng nói, Vùng Biển Lặng được tạo ra sau trận chiến của Sanhaj vào năm trăm năm trước mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970112,
					"content": "Vậy gánh hát đó là người từ một ngàn năm trước thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970113
					]
				},
				{
					"id": 751970113,
					"content": "Haha, sao có thể sai được chứ? Gánh hát rong đó là những vị anh hùng sống ở thời đại của quý tộc cũ, trong \"Lịch Sử Vua Chúa và Tông Thất\" cũng có ghi lại đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970114
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970114,
					"content": "Tóm lại thì Albedo nói rằng, trong viên đá phép này có chứa \"sức mạnh sinh mệnh vô hạn\" tương đương với sức mạnh của rồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970115
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970115,
					"content": "Chỉ cần dùng Đài Giả Kim cho răng rồng hấp thụ sức mạnh của rồng, là sẽ có thể dùng nó để rèn vũ khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970116
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970116,
					"content": "Nghe có vẻ lợi hại thật... Phải nói, không hổ danh là Albedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970117,
						751970119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970117,
					"content": "Sau này phải cảm ơn Albedo mới được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970118
					]
				},
				{
					"id": 751970118,
					"content": "#Đúng đúng! Nếu không thì thật sự không biết phải làm thế nào... Tóm lại, {NICKNAME}, bước tiếp theo chúng ta hãy thử hấp thụ sức mạnh của đá phép đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970120,
					"content": "Haha, vậy thì quá tốt rồi... Nào, cầm lấy chiếc răng rồng này đi, chuyện này trông cậy vào cháu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970121
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970121,
					"content": "Sức mạnh của thuật giả kim thật kỳ diệu, có thể lấy được sức mạnh sinh mệnh từ viên đá ngàn năm trước... Rốt cuộc là làm thế nào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970119,
					"content": "Được, không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970120
					]
				}
			]
		},
