			},
			"dialogs": [
				{
					"id": 751970401,
					"content": "Sao rồi, Nhà Lữ Hành? Liệu răng rồng có hấp thu được sức mạnh từ <color=#00E1FFFF>Đài Giả Kim bên kia</color> không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970402
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970402,
					"content": "Đúng rồi, đúng rồi! Ánh sáng này, cảm giác này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970403
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970403,
					"content": "Hahaha, không ngờ thuật giả kim còn có thể làm ra những chuyện thần kỳ như vậy, không hổ danh là Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970404
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970404,
					"content": "Vất vả cho hai cháu rồi, chú không biết gì về thuật giả kim cả. Được rồi, vậy là nguyên liệu đã đủ cả, chờ ở đây một chút nhé, chú sẽ rèn xong vũ khí ngay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
		},
