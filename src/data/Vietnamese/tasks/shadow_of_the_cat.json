					"nextDialogs": [
						220450302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450302,
					"content": "Chụp hình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "...Đó là gì vậy? Các ngươi thật kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450304,
					"content": "Bỏ đi, các ngươi muốn làm gì cũng được, chỉ cần đừng làm loạn đền thần là được.",
					"roleType": "TALK_ROLE_NPC",
