					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "Ừm... cảm thấy không đúng lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "Nhà Lữ Hành! Bạn đến thật đúng lúc, tôi đang tìm bạn đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450104,
					"content": "Gần đây khi tôi chạm khắc, cứ cảm thấy... tượng gỗ không có sinh động lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450105,
					"content": "Dù sao cũng chỉ là tượng gỗ thôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "Ây da, không thể nói như vậy được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450108,
					"content": "Hừm... Hình dung như thế nào đây? Đơn giản mà nói, cái tôi muốn là một loại... sức sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450109,
					"content": "Bạn thấy ngài Guuji Đại Diện tuy ngày thường đều ngủ, nhưng đôi khi cũng sẽ đứng dậy đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450110,
					"content": "Khi đi dạo, ngài Guuji Đại Diện đôi khi sẽ nhảy, chụp lá cây, hoặc là vươn vai gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450111,
					"content": "Những động tác này chính là sức sống mà tôi cần. Tôi muốn lấy những động tác này làm hình mẫu để điêu khắc, có lẽ sẽ có được thứ sức sống mà tôi cần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450112,
					"content": "Vậy bạn đi quan sát trực tiếp đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "Ây da, tôi... ngại đi đến đó lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450115,
					"content": "Dù sao ngài Guuji Đại Diện cũng là chủ cả, cứ đứng ở bên cạnh quan sát như vậy, cảm thấy sẽ chọc giận ngài Guuji Đại Diện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450116,
					"content": "Bạn có vẻ thân với ngài Guuji Đại Diện, hay là bạn đi chụp vài tấm hình cho tôi tham khảo nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450117,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "Vậy phiền bạn rồi, sau khi chụp hình, hãy mang đến cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450118,
					"content": "Nếu như không chụp được những động tác đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "Không sao, không nhất thiết phải chụp động tác cao siêu gì, tài nghệ hiện tại của tôi, cũng không khắc được những động tác đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450120,
					"content": "Chỉ cần chụp một số tư thế nhẹ nhàng của ngài Guuji Đại Diện là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450113,
					"content": "Neko chẳng phải đang ở bên đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "Bạn muốn sinh động như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
