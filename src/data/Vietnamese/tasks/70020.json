					"nextDialogs": [
						700200104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200104,
					"content": "Mimi tomo, Odomu nye! Muhe mani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200105,
					"content": "Mani? Mani! Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200106,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200107,
					"content": "Dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200108,
						700200109
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200108,
					"content": "Hình như rất thuận lợi thì phải.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "Em đang hỏi nó có cần giúp đỡ không, xem ra nó đang thật sự cần đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200112,
					"content": "Ừm...ý của nó là muốn chúng ta giúp nó tiêu diệt...kẻ thù lớn mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200114,
					"content": "Mi! Mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200115,
					"content": "Được rồi, vị trí của tên đó đã được đánh dấu trên bản đồ, làm phiền nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200109,
					"content": "Đang nói chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				}
			]
		},
