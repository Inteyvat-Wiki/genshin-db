			"dialogs": [
				{
					"id": 240160301,
					"content": "Phù... Cảm ơn đã giúp đỡ. Nếu không có bạn thì không biết tôi sẽ phải xử lý đến lúc nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "Thật không hổ danh là Nhà Nghiên Cứu Danh Dự Cấp Cao, việc gì cũng xử lý rất nhanh gọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "Tôi nhanh nhẹn lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "Một lần nữa cảm ơn bạn, Nhà Nghiên Cứu Danh Dự Cấp Cao, xin hãy nhận lấy món đồ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "Tôi có kinh nghiệm quét dọn mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "Hả? Đa tài thật đấy, không hổ danh là Nhà Nghiên Cứu Danh Dự Cấp Cao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
		},
