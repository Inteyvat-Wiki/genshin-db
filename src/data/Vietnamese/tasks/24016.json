				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "Vậy là ổn rồi... hy vọng chỗ tài liệu này thực sự có ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "Cô vẫn đang sắp xếp tài liệu à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "Ối! Rất vui được gặp lại Nhà Nghiên Cứu Danh Dự Cấp Cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "Đúng vậy! Theo chỉ thị của ngài Raimondo, tôi vẫn đang sắp xếp hồ sơ giấy tờ ở đây... Chậc, hình như tôi đã nói qua rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "Nơi này lớn như vậy, một mình cô làm hết thì vất vả thật. Raimondo không cử ai đến giúp à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "Viện Khoa Học hiện vô cùng bận rộn, không thể cử người tới giúp cũng là chuyện dễ hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "Cô còn là một \"chủ nhiệm\" nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Bạn đang nói về chức vụ \"Chủ Nhiệm Tổ Thu Hồi Văn Kiện Viện Khoa Học Fontaine\" à? Haiz, xin đừng chê cười...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "Tôi đâu dám làm chủ nhiệm gì chứ. Ngay từ đầu, tôi chỉ là một viên chức phụ trách sắp xếp tài liệu bình thường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "Sau khi được ngài Raimondo cử đến đây làm việc thì đột nhiên nhận được thông báo nhậm chức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Có người nói với tôi rằng đây là ý kiến của anh Choiseul. Anh ấy thấy tôi làm việc vất vả, nên làm vậy chủ yếu là để gửi thêm cho tôi chút trợ cấp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "Ây da! Đừng kể với ai nhé. Tôi... Sao tôi lại lỡ nói ra chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "Tôi không kể cho ai đâu, yên tâm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "Nghe có vẻ là chuyện tốt. Vất vả làm việc, được nhận thêm chút thù lao cũng tốt chứ sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "Có điều, sao phải đi đường vòng như thế nhỉ? Trực tiếp đưa thêm thù lao không phải xong rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "Chuyện bình thường ở Viện Khoa Học.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "Haiz, tôi cũng không hiểu Raimondo và Choiseul đang nghĩ gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "Nhưng dù sao thì tôi cũng phải tiếp tục làm việc, còn rất nhiều việc cần phải xử lý mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "Nhà Nghiên Cứu Danh Dự Cấp Cao, nếu bạn đồng ý, có thể giúp tôi chuyện này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "Vậy, phiền bạn giúp tôi dọn dẹp những vết bẩn xung quanh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Khi dọn dẹp, hãy cố gắng <color=#00E1FFFF>đừng đụng chạm vào hồ sơ bên cạnh</color> nhé. Nếu chúng bị làm bẩn thì sẽ rất tệ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "Vậy nhờ cả vào bạn rồi, tôi tiếp tục sắp xếp tài liệu đây. Haiz, sao bình thường đâu thấy nhiều giấy tờ thế này nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "Để hai chữ \"Danh Dự\" này được tỏa sáng hơn nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Haha, không thành vấn đề, tôi sẽ làm chứng cho tấm lòng cao cả của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "Nói chung, số tiền đó đến tay mình là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
