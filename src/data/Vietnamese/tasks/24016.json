						240160402
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160402,
					"content": "Nhưng nếu bạn dùng ít sức hơn trong lúc dọn dẹp thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160403,
					"content": "Xin lỗi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "Xin đừng hiểu nhầm! Tôi không có ý chê trách, riêng chuyện này là bạn đã giúp tôi rất nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160406,
					"content": "Thứ này gửi bạn, cảm ơn vì đã giúp đỡ, Nhà Nghiên Cứu Danh Dự Cấp Cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160404,
					"content": "Lần sau tôi sẽ nhẹ tay hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
