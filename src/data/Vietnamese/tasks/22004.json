			"dialogs": [
				{
					"id": 220040301,
					"content": "Đánh, đánh bại rồi, hoàn toàn không nghe thấy tiếng động gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040302,
					"content": "Anh là ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040303,
					"content": "Là một người câu cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040304,
					"content": "Đáng nghi ngờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "Không sai, tôi rất đáng ngờ, có điều trên thế giới này nhiều điều đáng ngờ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040306,
					"content": "Ví dụ như đầu bếp trong nhà trọ đó, trước kia rất thích múa kiếm, giờ lại muốn làm đầu bếp, mặt lạnh nhưng trái tim nhân hậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040307,
					"content": "Cũng như chủ của nhà trọ, cô ấy là người Mondstadt nhưng lại không ai ở Mondstadt biết đến cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040308,
					"content": "Còn có... ví dụ như bạn có thể dùng sức mạnh Nguyên Tố, nhưng lại không có Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040309,
					"content": "Thế cho nên có nhiều thứ \"khả nghi\" nhưng nhìn không \"đáng sợ\", vậy đừng lo lắng nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040310,
					"content": "Đây là quà cảm ơn cho bạn, hay lấy đi tôi cần phải tiếp tục câu cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
