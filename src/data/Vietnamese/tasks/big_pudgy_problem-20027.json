			"dialogs": [
				{
					"id": 200270101,
					"content": "#Cảm ơn, cảm ơn {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270102,
					"content": "Vốn dĩ ông định đi xem tình hình dây nho, kết quả là lại gặp chuyện xui xẻo này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270103,
					"content": "Ừm, đừng nói cho con trai ông biết, nó là kỵ sĩ Tây Phong trong thành. Bình thường công việc của nó chắc là rất vất vả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270104,
					"content": "Rắc rối nhỏ này của lão già, thì đừng làm phiền nó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270105,
					"content": "Nhưng mà gần đây, gần tửu trang thường xuất hiện Slime, mỗi ngày ông đều lo lắng dây nho có bị Slime phá hoại không, ngủ cũng không yên được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270106,
					"content": "Nếu bạn trẻ có thời gian, hãy giúp lão già này một việc, đi xung quanh xem, đuổi Slime đi, đừng để bọn chúng đến phá hoại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270107,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "Tốt quá, ông có thể nghỉ ngơi một chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270108,
					"content": "Còn có việc khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "Hức, vốn dĩ muốn nói tự ông làm cũng được... Nhưng ông thực sự không nhấc chân lên được, người trẻ tuổi, cháu hãy giúp ông đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		}
	]
