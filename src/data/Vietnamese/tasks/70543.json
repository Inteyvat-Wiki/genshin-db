			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430102,
					"content": "...Meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "Bông Xám"
				},
				{
					"id": 705430103,
					"content": "...Là các bạn sao. Tôi đang, trò chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430104,
					"content": "Trò chuyện... Razor đang trò chuyện với \"Bông Xám\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430105,
					"content": "Meo, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "Bông Xám"
				},
				{
					"id": 705430106,
					"content": "Bông Xám hình như định nói là... \"đúng rồi\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430107,
					"content": "Ngửi thấy mùi quen thuộc, là đang tìm bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430108,
					"content": "Nó rất khỏe và vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430109,
					"content": "Meo, meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "Bông Xám"
				},
				{
					"id": 705430110,
					"content": "Mùi hương thu hút bạn bè. Bạn cũng đến rồi, mừng quá. Mùi gió mưa trên người bạn, rất quen thuộc... Mùi mèo, cũng quen thuộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430111,
					"content": "Paimon, vị ngọt, rất thơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430112,
					"content": "Ủa?! Ngọt... Chẳng lẽ là vị bánh xốp mà Valerina đã cho sao? Tôi, tôi ăn nhiều vậy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430113,
					"content": "Tôi chia cho Paimon một nửa lận đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "Tôi không để ý luôn... Hic, cũng tại món bánh xốp ngon quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430116,
					"content": "Hihi, tôi còn muốn ăn Gà Nấu Hoa Ngọt, Sườn Nướng và Bánh Khoai Tây... À, cả Nước Táo Lên Men nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430117,
					"content": "#Vậy thực đơn thì quyết định vậy nhé. {NICKNAME}, chúng ta mau đi tìm Valerina để đặt món đi, Razor cũng đi cùng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430118,
					"content": "Cảm... Cảm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430119,
					"content": "Bông Xám có mang đến cho tôi rất nhiều... quả hạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430120,
					"content": "Còn nữa, thịt trong hộp... Tôi, ăn no lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430121,
					"content": "Nghe có vẻ như là đơn hàng của Valerina đặt nhỉ? Lẽ nào Bông Xám đã mang thức ăn cho Razor sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430122,
					"content": "Meo meo. Meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "Bông Xám"
				},
				{
					"id": 705430123,
					"content": "Không ngờ trong Pháo Đài Mèo còn có cả chuyện mèo tiếp khách đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430124,
					"content": "Xem ra Razor rất được mèo yêu thích nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430114,
					"content": "Không đâu, Paimon vẫn có thể ăn thêm gấp ba lần nữa mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}