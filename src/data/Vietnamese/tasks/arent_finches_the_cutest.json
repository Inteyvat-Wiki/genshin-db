			"dialogs": [
				{
					"id": 735280101,
					"content": "Tôi, học giả Basima của Amurta xin các bạn đừng vội rời đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280102,
					"content": "Xin hãy thả lỏng tâm trí và lắng nghe tôi nói một điều quan trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280103,
					"content": "Chim sẻ đáng yêu nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280104,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280105,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "Thì đúng là rất đáng yêu, nhưng cô Basima là học giả nhỉ? Một câu nói không rào trước như vậy dễ xảy ra tranh luận lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280107,
					"content": "Tôi nhớ là các học giả ăn nói thận trọng lắm. Nếu tôi là học giả thì sẽ không nói \"Tôm Viên Tơ Vàng là ngon nhất\" đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280108,
					"content": "Phải nói rào trước kiểu \"trong các món Liyue thì tôi thích ăn món này nhất\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280109,
					"content": "Nhưng tôi dám nói đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "#Úi! {NICKNAME}, sao đột ngột thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280113,
					"content": "Dù không phải giỡn thì cũng đừng nói to vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280114,
					"content": "Haha! Chính là như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280115,
					"content": "Càng vì là học giả, nên tôi mới không muốn cuộc đời tôi toàn là tranh luận, cảm giác như không được nói sai câu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280116,
					"content": "Dù sao thì tôi cũng không phải bị giám sát, với có nói sai cũng không mất gì, nên không cần phải sống trong sợ hãi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280117,
					"content": "Nhưng suy nghĩ quan trọng nhất phải hét to lên, mạnh dạn bày tỏ tấm lòng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280118,
					"content": "Nếu bạn chơi thử trò \"Chim Sẻ Bing-Bang\" thì cũng sẽ đồng ý với nhận định ban nãy của tôi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280119,
					"content": "Chim Sẻ... Bing-Bang? Là thứ trên bàn phía sau cô à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280120,
					"content": "Đúng vậy, sau khi chơi thì bạn sẽ hiểu được độ dễ thương của chim sẻ thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280121,
					"content": "Hơn nữa, do là trò chơi chính thức trong \"Ảo Cảnh Veluriyam\", nên nếu bạn đạt điểm cao thì sẽ nhận được thưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280122,
					"content": "Nói vậy làm tôi cũng hơi tò mò đó, chơi tốt còn được thưởng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280123,
					"content": "#{NICKNAME} thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280124,
					"content": "Vậy chúng ta thử xem sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "Haha, rất thẳng thắn! Vậy mời các bạn trải nghiệm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280125,
					"content": "Để xem chim sẻ đáng yêu đến mức nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "Paimon đáng yêu nhất!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "Tôi không quan tâm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}