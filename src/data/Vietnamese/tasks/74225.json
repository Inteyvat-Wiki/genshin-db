			"dialogs": [
				{
					"id": 742250201,
					"content": "Cảm ơn ân nhân. Thần Vương trên cao, cuối cùng tôi cũng được cứu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "#{F#Cô}{M#Cậu} là binh sĩ quân đoàn canh giữ thành phố này, hay là một người chính nghĩa đi ngang qua đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "Tóm lại, để tôi tự giới thiệu. Tôi là Faustus, thương nhân biên giới được Thần Vương giao phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "Lần này tôi đến đây để vận chuyển hương liệu từ đất nước phía nam. Không ngờ vừa lên bờ đã bị những con rồng đất đáng ghét bao vây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "Rồng đất? Rồng đất ở đâu cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "#Hửm? Không để mắt đến kẻ địch vừa đánh bại sao, {F#cô}{M#cậu} quả nhiên là một dũng sĩ tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "Hãy nhận lấy cái này nhé. Không nói lời cảm ơn nhiều nữa, tôi còn phải nhanh chóng vận chuyển hàng hóa vào trong thành. Nói không chừng chúng ta sẽ còn gặp lại nhau trong thành đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
