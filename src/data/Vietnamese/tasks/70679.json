			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "Xin chào, xin chào! Ôi, trùng hợp quá, chúng ta lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Xin lỗi, anh là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Tôi là Gygax! Còn nhớ Cơn Gió Lạc Lối không, có ấn tượng gì chưa nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "Thì ra là anh à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "Tôi nhớ ra rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "Biểu cảm này, rõ ràng là không có nhớ ra mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "#Dù thế nào đi nữa thì hãy xem bên đây đi nào. Chắc chắn {F#cô}{M#cậu} còn nhớ \"Cơn Gió Lạc Lối\" này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "#Lần trước, sau khi {F#cô}{M#cậu} giúp tôi chơi thử, không phải đã góp ý rất nhiều cho tôi đó sao? Đều là những ý tưởng hay, phần lớn đều đã được tôi áp dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "Tôi đã cải tiến quy tắc và cách chơi một lần nữa... À, nói đúng ra là rất nhiều lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "Chắc sẽ không quá khó hiểu đấy chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "#Hãy yên tâm, {F#cô}{M#cậu} chắc chắn sẽ thích cách chơi mới này. Để tôi giới thiệu sơ qua một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "Trước tiên, trong Cơn Gió Lạc Lối mới này, tôi đã thêm vào một thứ tên là \"Máy Phát Tín Hiệu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "Hiệp Sĩ chỉ cần khởi động thành công bốn Máy Phát Tín Hiệu là sẽ đánh bại được Thợ Săn để giành chiến thắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "Còn việc mà Thợ Săn cần làm... vẫn không đổi, chỉ cần bắt được tất cả Hiệp Sĩ thì xem như giành chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "Nhưng trong Cơn Gió Lạc Lối lần này, sau khi Hiệp Sĩ bị Thợ Săn bắt được thì sẽ không trực tiếp bị loại khỏi ván đấu, mà sẽ được đưa vào Khu Giám Sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "Chỉ cần qua một khoảng thời gian, hoặc có Hiệp Sĩ khác giúp đỡ, người bị bắt sẽ có thể thoát khỏi Khu Giám Sát mà tiếp tục đối phó với Thợ Săn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "Nhưng nếu bị bắt thêm lần nữa... Vậy thì sẽ chính thức bị loại khỏi ván đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Nghe có vẻ hơi phức tạp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Yên tâm, nghe có vẻ phức tạp thôi, chỉ cần chơi vài ván là sẽ hiểu hết ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "Vậy để tôi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Được! Mời sang bên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "Còn có việc khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "Không sao, khi nào rảnh rỗi ghé đến là được. Tôi sẽ còn ở lại đây một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "Nhiều quy tắc mới quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "Chắc anh sẽ không thêm cách chơi kỳ lạ nào vào đâu đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Anh là... Cơn Gió Lạc Lối!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "Tôi là Gygax! Được rồi, nói vậy cũng không sai, Cơn Gió Lạc Lối có nổi tiếng hơn tôi cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}