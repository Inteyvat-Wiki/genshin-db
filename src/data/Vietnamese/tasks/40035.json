				},
				{
					"id": 400350602,
					"content": "Xin chào hai vị. Cho hỏi có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350603
					],
					"speakerTitle": "Người Đưa Đò"
				},
				{
					"id": 400350603,
					"content": "Tôi muốn tìm Zhongli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350604
					]
				},
				{
					"id": 400350604,
					"content": "Vị khách đó cùng đường chủ đi ra ngoài rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350605
					],
					"speakerTitle": "Người Đưa Đò"
				},
				{
					"id": 400350605,
					"content": "Hai người đều đi sao? Lẽ, lẽ nào họ đi làm việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350606,
					"content": "Đường chủ nói là đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350607
					],
					"speakerTitle": "Người Đưa Đò"
				},
				{
					"id": 400350607,
					"content": "Nếu hai vị tìm họ, có thể đến Ba Cốc Say Mèm xem xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350608
					],
					"speakerTitle": "Người Đưa Đò"
				},
				{
					"id": 400350608,
					"content": "Nghe nói đường chủ hay đến đó...để quảng bá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Người Đưa Đò"
				}
			]
		},
		{
