			},
			"dialogs": [
				{
					"id": 400350701,
					"content": "Phù, no rồi no rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350787
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350787,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350702
					],
					"speakerTitle": "Guoba"
				},
				{
					"id": 400350702,
					"content": "Xiangling này, cũng nhờ có bạn nghĩ ra cách ăn món cá nướng rưới sốt mới mẻ đó, đặc biệt là bát nước chấm này, mùi vị thật tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350703
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350703,
					"content": "Hì hì, đó là nước chấm đặc biệt của tôi, tất nhiên là rất ngon rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350704
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 400350704,
					"content": "Ớt Tuyệt Vân phơi khô rồi xay thành bột, cho tỏi và hành lá vào trộn đều, sau đó cho muối, giấm, xì dầu, cuối cùng là cho dầu nóng đun sôi vào cho thơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350705
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350705,
					"content": "Đằng sau kỹ thuật có vẻ thô sơ này, là sự hiểu biết chính xác của người đầu bếp về tỷ lệ hương vị và gia vị. Nhiều một chút sẽ dư, ít một chút sẽ thiếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350706,
					"content": "Đây được gọi là \"tinh đạo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350780
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350780,
					"content": "Ừm ừm đúng đúng. Thế nào Xiangling, những lời khen này đánh trúng tim của bạn rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350781
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350781,
					"content": "Hì hì...thật ngại quá...cảm ơn Zhongli tiên sinh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350782
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 400350782,
					"content": "Tôi cảm thấy, tôi vốn đã rất giỏi ăn nói rồi, không ngờ so với anh thì tôi vẫn chưa là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350783
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350783,
					"content": "Đường chủ đâu cần phải khách sáo với tôi như vậy. Tài ăn nói của đường chủ, cả cảng Liyue này ai ai cũng biết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350784
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350784,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350785
					],
					"speakerTitle": "Guoba"
				},
				{
					"id": 400350785,
					"content": "Guoba muốn ăn gì không? Không cần khách sáo, bổn đường chủ sẽ mời! Ghi sổ cho Xiangling là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350786
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350786,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350707
					],
					"speakerTitle": "Guoba"
				},
				{
					"id": 400350707,
					"content": "Mọi người đang nói về món ngon gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350708,
					"content": "Ồ! Là Nhà Lữ Hành và Paimon à, ngọn gió nào thổi hai người đến đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350709
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350709,
					"content": "Đợi đã! Khoan hãy nói, để bổn đường chủ đoán xem...ừm, đến đây đón Tết Hải Đăng đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350710
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350710,
					"content": "Vừa nhìn là biết rồi, còn phải đoán sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350711,
					"content": "Ây da, chẳng phải quen biết nên mới vậy sao, đùa chút cho vui thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350712
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350712,
					"content": "Các bạn đến đúng lúc lắm, tôi đang mời mọi người thử món mới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350779
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 400350779,
					"content": "Ông chủ của Ba Cốc Say Mèm đã đánh giá tốt, Zhongli tiên sinh và Hu Tao cũng hài lòng, nhưng tôi cứ cảm thấy vẫn phải hỏi thêm vài người mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350713
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 400350713,
					"content": "Thế nào, các bạn có muốn ăn thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350714
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 400350714,
					"content": "Có có!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350715,
					"content": "Chúng tôi đến để tìm Zhongli tiên sinh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350716
					]
				},
				{
					"id": 400350716,
					"content": "Hả? Không, không ăn sao? Được rồi...vậy thì làm việc chính trước vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350717,
					"content": "Lâu rồi không gặp, hành trình dạo này vẫn suôn sẻ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350718,
					"content": "Cũng không tệ, biết thêm được khá nhiều kiến thức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350719
					]
				},
				{
					"id": 400350719,
					"content": "Vậy thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350720
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350720,
					"content": "Vậy thì vậy thì? Tìm môn khách của tôi có việc gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350721
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350721,
					"content": "Nói trước nha, hôm nay chúng tôi ra ngoài là có việc cần làm! Thử các món ăn chỉ là nhân tiện thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350722
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350722,
					"content": "Làm, làm việc, không phải việc của Vãng Sinh Đường chứ? Rõ ràng là đang đón tết mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350723,
					"content": "Đón tết cũng có người đi chầu ông bà mà đúng không? Đừng ngạc nhiên. Được rồi, dọa các bạn thôi, tôi thấy hôm nay thời tiết không tệ, nên ra ngoài dạo phố, tiện thể quảng bá kinh doanh một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350724
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350724,
					"content": "Các bạn ngồi chơi đi, tôi và Xiangling đến chỗ ông chủ uống chén trà. Zhongli xong việc nhớ tìm tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350725
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 400350725,
					"content": "Được. Đường chủ đi thong thả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350726
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350726,
					"content": "Nhà Lữ Hành, đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350727,
					"content": "Chuyện là như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350728
					]
				},
				{
					"id": 400350728,
					"content": "Nói với Zhongli tình hình của Keqing...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350729
					]
				},
				{
					"id": 400350729,
					"content": "Ngọc Hành Tinh là một người ngay thẳng, thông minh, siêng năng và có tài. Nhưng mà, mọi việc đều có chừng mực, sức khỏe vẫn quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350730
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350730,
					"content": "Có cách nào để thuyết phục cô ấy không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350731
					]
				},
				{
					"id": 400350731,
					"content": "Đúng đúng, anh nói chuyện rất có lý lẽ, có lẽ cô ấy sẽ nghe anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350732,
					"content": "Nếu tôi là Nham Vương Đế Quân, thì còn có thể thuyết phục cô ấy một chút. Nhưng giờ đây tôi chỉ là một môn khách, cũng phải biết thân phận của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350733
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350733,
					"content": "Huống hồ Ngọc Hành Tinh và tôi cũng không thân thiết, nên việc mạo muội thuyết giáo sẽ chỉ gây phản cảm mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350734
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350734,
					"content": "Ơ? Vậy phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350735,
					"content": "Nói gần nói xa, hoặc có thể thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350736
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350736,
					"content": "Nếu có một câu chuyện có thể khiến cô ấy cảm động, bạn có thể lồng ghép lý lẽ bạn muốn nói vào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350737
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350737,
					"content": "Những điều rút ra từ cuộc sống sẽ dễ đồng cảm hơn. Đề cập đến những người và những việc gần gũi, sẽ có được kết quả tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350738
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350738,
					"content": "Hở...vậy là ý gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350739,
					"content": "Chúng ta đi tìm người quen của Keqing để hỏi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350740
					]
				},
				{
					"id": 400350740,
					"content": "Nhà Lữ Hành đúng là thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350741
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350741,
					"content": "Tìm một số tài liệu đi. Nếu bạn đồng ý, tôi có thể đưa ra một vài gợi ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350742,
					"content": "Sau khi có ý tưởng, hãy kể câu chuyện với Ngọc Hành Tinh là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350743
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350743,
					"content": "Tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350744
					]
				},
				{
					"id": 400350744,
					"content": "Bạn có quen biết với Ngọc Hành Tinh. Nếu phải lựa chọn thì bạn là người thích hợp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350745
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350745,
					"content": "Thì ra là vậy! Ý là tìm người quen của Keqing để hỏi thăm đúng không? Bắt đầu từ ai trước đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350746
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350746,
					"content": "Hóa ra mọi người ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350747
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350747,
					"content": "Ơ? Keqing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350748,
					"content": "Không ngờ Zhongli tiên sinh cũng ở đây. Điển Lễ Tiễn Tiên lần trước may nhờ có tiên sinh giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350749
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350749,
					"content": "Chút chuyện nhỏ thôi mà, Ngọc Hành Tinh không cần khách sáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350750
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350750,
					"content": "Bạn, sao bạn lại đến đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350751
					]
				},
				{
					"id": 400350751,
					"content": "Sao vậy? Sao biểu cảm của các bạn kỳ lạ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350752
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350752,
					"content": "Lẽ nào tôi đến đột ngột quá, làm phiền bạn và Zhongli tiên sinh nói chuyện sao? Xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350753
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350753,
					"content": "Không không, không phiền không phiền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350754
					]
				},
				{
					"id": 400350754,
					"content": "Sao đột nhiên Keqing lại đến tìm chúng tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350755
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350755,
					"content": "Tôi đến để nhờ các bạn dẫn tôi đến gặp tiên gia. Mùa lễ hội đang tới, tôi phải đại diện Thất Tinh Liyue tặng quà cho tiên gia các nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350756
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350756,
					"content": "Lần trước khi cùng các vị tiên nhân kề vai tác chiến, không phải họ đều đã gặp bạn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350757
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350757,
					"content": "Nếu đã quen biết thì cứ đến thẳng Tuyệt Vân Gián là được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350758
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350758,
					"content": "Mới chỉ gặp một lần thôi, có lẽ các vị tiên nhân không nhớ được tôi đâu. Mạo muội ghé thăm, sợ là sẽ khiến họ khó chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350759
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350759,
					"content": "Nên tôi nghĩ nhờ các bạn dẫn đến gặp là cách làm lịch sự nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350760,
						400350761
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350760,
					"content": "Đương nhiên không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350764
					]
				},
				{
					"id": 400350764,
					"content": "Thì ra còn phải phụ trách tặng quà tận nơi, làm Thất Tinh thật vất vả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350765
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350765,
					"content": "Chúng tôi sẽ giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350766
					]
				},
				{
					"id": 400350766,
					"content": "Được, vậy quyết định thế nhé. Tôi quay về chuẩn bị quà trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350767
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350767,
					"content": "Lễ tết lớn mà lại phiền bạn cùng tôi chạy ngược chạy xuôi, thật sự xin lỗi...Chúng ta đánh nhanh rút gọn, tuyệt đối không để trễ giờ xem pháo hoa của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350768
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350768,
					"content": "Vậy thì cùng đi xem pháo hoa đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350769
					]
				},
				{
					"id": 400350769,
					"content": "Hả? Cùng, cùng đi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350770
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350770,
					"content": "Cũng được, đợi tôi xong việc sẽ đi cùng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350771
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350771,
					"content": "Zhongli tiên sinh cũng vậy. Lễ hội pháo hoa năm nay không tệ, đừng bỏ lỡ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350772
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350772,
					"content": "Đương nhiên. Cảm ơn đã nhắc nhở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350773
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 400350773,
					"content": "Tôi đi làm chút việc trước. Nhà Lữ Hành, chuẩn bị xong thì cứ đến Quần Ngọc Các tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350774
					],
