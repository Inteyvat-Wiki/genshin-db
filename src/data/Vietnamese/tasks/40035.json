	"talks": [
		{
			"id": 4003502,
			"completionStepIds": [
				4003502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003502",
							"2"
						],
						"stepId": 4003502,
						"stateName": "QUEST_STATE_UNFINISHED"
