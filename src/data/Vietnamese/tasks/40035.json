				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350201,
					"content": "...Gửi thông báo này đến Tổng Vụ, để họ sắp xếp những công việc được liệt kê ở trên cho từng bộ phận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350202,
					"content": "Nói với họ rằng Tết Hải Đăng công việc rất nhiều, nhưng dù việc lớn hay nhỏ cũng phải hoàn thành cho tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350203,
					"content": "Tiểu thư Ningguang! Hì hì, chúng tôi lại đến chơi rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350204,
					"content": "Không làm phiền cô chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350205
					]
				},
				{
					"id": 400350205,
					"content": "Khách quý đến thăm, sao có thể gọi là làm phiền chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350206
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350206,
					"content": "Có vẻ như các bạn đến Liyue để đón Tết Hải Đăng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350207,
					"content": "Đúng vậy! Tết Hải Đăng năm nay mọi người bận rộn gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350208,
					"content": "Vẫn như cũ, đủ thứ việc vặt. Đúng rồi, năm nay Tổng Vụ dự định tổ chức \"lễ hội pháo hoa\", đáng để xem lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350221
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350221,
					"content": "Điểm nhấn của Tết Hải Đăng từ trước đến giờ vẫn là thả Đèn Minh Tiêu, nhưng gần đây Liyue xảy ra nhiều chuyện. Tôi nghĩ, mọi người càng cần cảm giác ấm áp và đoàn kết hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350222
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350222,
					"content": "Vì vậy, tôi nghĩ rằng ít nhất năm nay chúng ta phải tổ chức một buổi lễ đặc biệt và gần gũi hơn với mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350223
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350223,
					"content": "Đưa pháo hoa đến các nơi ở Liyue, chọn thời gian thích hợp rồi đốt tất cả cùng một lúc. Để sức nóng và ánh sáng rực rỡ có thể thắt chặt thêm tình cảm giữa mọi người, đây là quyết định của Tổng Vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350209
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350209,
					"content": "Pháo hoa? Hình như chúng tôi cũng từng thấy pháo hoa ở những nơi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350210,
					"content": "Pháo hoa của Liyue có gì đặc biệt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350211,
					"content": "Pháo hoa ban đầu được phát triển từ một số phát minh của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350212,
					"content": "Khi tổ tiên của Liyue tạo ra pháo hoa, họ đặt tên cho nó là \"Pháo Trúc\". Nó có thể phát ra ánh sáng mạnh cùng tiếng động lớn, có thể được sử dụng để xua đuổi rắn độc và thú dữ hoặc cảnh báo những người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350213,
					"content": "Ngày xưa mọi người làm nông bên ngoài, liên lạc bất tiện. Vì \"Pháo Trúc\" có thể phát ra tiếng động lớn nên được dùng để truyền tín hiệu khi cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350214
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350214,
					"content": "Sau khi cảng Liyue chính thức được thành lập, cuộc sống của người dân được cải thiện và họ không còn đổ xô đi canh tác đất đai cách xa hàng trăm dặm. Dần dần, họ không còn dùng \"Pháo Trúc\" để phòng thân nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350215
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350215,
					"content": "Tuy nhiên, tinh thần mang theo \"Pháo Trúc\" trong công cuộc khai hoang gian khổ của tổ tiên vẫn được duy trì và lan truyền trong dân gian như một phong tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350216
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350216,
					"content": "\"Pháo Trúc\" là tiền thân của pháo hoa. Chúng tôi đã cải tiến \"Pháo Trúc\", và đưa chúng vào Tết Hải Đăng, để tưởng nhớ tinh thần đấu tranh của các bậc tiền nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350217
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350217,
					"content": "Không hổ danh là Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350218
					]
				},
				{
					"id": 400350218,
					"content": "Thật lợi hại...những thứ của Liyue đều rất có bề dày lịch sử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350219,
					"content": "Tôi tin rằng các bạn cũng đã quen với nó. Lịch sử càng lâu đời, thì mọi thứ trên mảnh đất đó sẽ càng mang nhiều giá trị. Đó chính là Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350220
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350220,
					"content": "Những việc liên quan đến pháo hoa tôi đã giao cho Keqing phụ trách. Nếu các bạn có hứng thú với pháo hoa thì cùng tôi đi gặp cô ấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4003503,
			"completionStepIds": [
				4003503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003503",
							"2"
						],
						"stepId": 4003503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Keqing",
					"Pengyi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350301,
					"content": "Ừm...phải thêm một vài vị trí nữa để bố trí pháo hoa. Tầm nhìn phải toàn diện, không thể chỉ bó hẹp trong thành, lẽ nào người dân Khinh Sách Trang không đón Tết Hải Đăng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350302
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350302,
					"content": "Nhưng, nhưng mà đại nhân, nếu như vậy, ngân sách sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350303
					],
					"speakerTitle": "Pengyi"
				},
				{
					"id": 400350303,
					"content": "Ngân sách là gì? Là \"số tiền thích hợp nhất để làm tốt việc gì đó\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350304
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350304,
					"content": "Nếu anh cho rằng kinh phí hiện tại không đủ để làm tốt việc này, thì có thể gửi yêu cầu lên Tổng Vụ để được tính toán lại và phê duyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350305
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350305,
					"content": "Mục đích của chúng ta là tổ chức cho tốt Tết Hải Đăng lần này, dự trù ngân sách là để lập kế hoạch tốt hơn, không thể lẫn lộn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350306
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350306,
					"content": "Vâng, tôi hiểu rồi, Keqing đại nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350307
					],
					"speakerTitle": "Pengyi"
				},
				{
					"id": 400350307,
					"content": "Ừm. An toàn là trên hết, nhất định phải đảm bảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350308
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350308,
					"content": "Ningguang, Nhà Lữ Hành. Hiếm lắm mới thấy hai người đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350309
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350309,
					"content": "Nhà Lữ Hành đến đây tham gia Tết Hải Đăng sao? Vừa hay không bao lâu nữa là chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350310
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350310,
					"content": "Keqing đang làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350311
					]
				},
				{
					"id": 400350311,
					"content": "Xem xét cách bố trí pháo hoa và kiểm tra các cơ sở vật chất liên quan. Xem như công việc nhỏ hàng ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350312
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350312,
					"content": "Thứ cho tôi nói thẳng, những công việc thế này giao cho cấp dưới xử lý là được. Cô đã quay cuồng suốt mấy ngày rồi, cũng nên nghỉ ngơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350313
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350313,
					"content": "Chuyện nhỏ thôi mà, không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350314
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350314,
					"content": "Pengyi, phiền anh lập lại kế hoạch, tổng hợp thành văn bản báo cáo gửi cho Tổng Vụ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350315
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350315,
					"content": "Tôi vào trong thành kiểm tra tình hình bố trí pháo hoa, lát nữa sẽ quay lại sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350316
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350316,
					"content": "Nhà Lữ Hành, bạn là khách quý, đang mùa lễ hội, hãy ở lại trong thành để tận hưởng bầu không khí lễ hội này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350317
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350317,
					"content": "Pengyi, những việc tôi giao cho anh, anh đều đã nhớ rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350318
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350318,
					"content": "Vâng, tôi nhớ kỹ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350319
					],
					"speakerTitle": "Pengyi"
				},
				{
					"id": 400350319,
					"content": "Được. Ningguang, Nhà Lữ Hành, tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350320
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 400350320,
					"content": "Ningguang đại nhân, và cả...Nhà Lữ Hành, tôi không làm phiền hai vị nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350321
					],
					"speakerTitle": "Pengyi"
				},
				{
					"id": 400350321,
					"content": "Keqing đại nhân đã nói với tôi rất nhiều kế hoạch, tôi phải viết lại một bản kế hoạch mới...tranh thủ thời gian, tranh thủ thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350355
					],
					"speakerTitle": "Pengyi"
				},
				{
					"id": 400350355,
					"content": "À đúng rồi! Suýt nữa thì quên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350356
					],
					"speakerTitle": "Pengyi"
				},
				{
					"id": 400350356,
					"content": "Nhà Lữ Hành, ở đây có một ống pháo hoa, lúc trước Keqing đại nhân từng nói có thể bạn sẽ có hứng thú, nên kêu tôi giữ lại nó, đợi gặp được bạn thì đưa cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350357
					],
					"speakerTitle": "Pengyi"
				},
				{
					"id": 400350357,
					"content": "Người có năng khiếu thực hành, có thứ này sẽ có thể tự chế tạo pháo hoa. Nếu bạn có thời gian thì hãy thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350322
					],
					"speakerTitle": "Pengyi"
				},
				{
					"id": 400350322,
					"content": "Lúc nãy tôi không kịp nói câu nào luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350323,
					"content": "Không đúng, phải nói là \"không dám xen vào\" luôn á!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350324,
					"content": "Keqing, khí thế thật hùng hồn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350325
					]
				},
				{
					"id": 400350325,
					"content": "Bạn cũng thấy vậy đúng không? Khí thế của Keqing còn hùng hồn hơn trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350326,
					"content": "Và cũng bận rộn hơn trước...tại sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350327,
					"content": "Các vị tiên nhân giao toàn quyền cai quản cảng Liyue cho người phàm, và Thất Tinh chúng tôi đảm nhận trách nhiệm hướng dẫn mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350328
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350328,
					"content": "Chúng tôi đảm nhận những công việc quan trọng trong các lĩnh vực khác nhau và sắp xếp mọi việc một cách tỉ mỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350329
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350329,
					"content": "Mặc dù nói vậy, nhưng vẫn rất phiền phức khi tự mình làm mọi thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350330
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350330,
					"content": "Mấy năm trước, những việc liên quan đến Tết Hải Đăng đều do Jiangzhou phụ trách. Nhưng bố cô ấy đã lớn tuổi, nên năm nay đã được điều sang bộ phận khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350331
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350331,
					"content": "Công việc của Tết Hải Đăng đổ lên vai tôi và Keqing. Tôi là tổng phụ trách, còn về \"lễ hội pháo hoa\" được nhiều người mong đợi thì giao cho Keqing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350332
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350332,
					"content": "Việc này là việc lớn, tôi nghĩ nên giao cho người đáng tin cậy nhất. Mà Keqing lại rất nghiêm khắc với bản thân, và tràn đầy nhiệt huyết với công việc, vì vậy cô ấy là ứng cử viên sáng giá nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350333
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350333,
					"content": "Quả thực là một người rất nghiêm khắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350334,
					"content": "Đúng vậy. Nghiêm khắc với người khác và cả bản thân, đến nỗi đầu tư quá mức và làm việc miệt mài trong suốt mấy ngày trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350335
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350335,
					"content": "Theo tôi, đây không phải là giải pháp lâu dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350336
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350336,
					"content": "Hăng quá hóa dở, là đạo lý mà người Liyue nên hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350337
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350337,
					"content": "Không phải tôi chưa từng khuyên cô ấy, nhưng tính cách của cô ấy thì các bạn cũng biết rồi. Một người khéo ăn khéo nói mà gặp phải Keqing thì cũng chịu thua thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350338
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350338,
					"content": "Nhà Lữ Hành, bạn cũng khá thân với Keqing, lại hiểu biết rộng, hay là bạn giúp tôi khuyên cô ấy được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350339,
						400350340
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350339,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				},
				{
					"id": 400350341,
					"content": "Không hổ danh là Nhà Lữ Hành. Thuyết phục Keqing không phải chuyện dễ, có bạn giúp tôi cũng yên tâm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350342
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350342,
					"content": "Tôi còn phải quay về Quần Ngọc Các xử lý chút việc, xin phép đi trước. Chuyện của Keqing phiền bạn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350343
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400350343,
					"content": "Ningguang rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350344
					]
				},
				{
					"id": 400350344,
					"content": "Bạn thật sự có cách thuyết phục Keqing sao? Ngay cả tiểu thư Ningguang còn không làm được điều đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350345,
					"content": "Hơn nữa, muốn thuyết phục một người thì ít nhất phải hiểu được cảm nhận của người đó bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350346,
					"content": "Có lẽ bây giờ Keqing đang làm việc liên tục, ngay cả ngày nghỉ cũng không có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350347,
					"content": "Cảm nhận là...rất mệt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350348
					]
				},
				{
					"id": 400350348,
					"content": "Cách hiểu đơn giản như vậy vốn dĩ không có tác dụng gì cả! Hãy nghĩ lại xem, cảm nhận quan trọng hơn, sâu sắc hơn là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350349,
					"content": "Hay là chúng ta đi tìm một người bạn có tâm và đáng tin cậy để hỏi đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350350,
					"content": "Vậy thì tìm Zhongli đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350351
					]
				},
				{
					"id": 400350351,
					"content": "Hả? Zhongli...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350352
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350352,
					"content": "Zhongli cũng khá hiểu về người Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350353
					]
				},
				{
					"id": 400350353,
					"content": "Ừm, đúng là rất đáng tin cậy! Vậy thì đi hỏi Zhongli đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350354,
					"content": "Zhongli bây giờ là khách của Vãng Sinh Đường, vậy chúng ta đến Vãng Sinh Đường tìm anh ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400350340,
					"content": "Tôi sẽ nghĩ cách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				}
			]
		},
