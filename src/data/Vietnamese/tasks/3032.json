			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sawada",
					"Aqaba",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "Tôi nghĩ ra rồi! Kết thúc của quyển tiểu thuyết có thể dừng tại đoạn Mikoshi Nagamasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320302,
					"content": "Ý là tất cả những người khác trong câu chuyện đều sẽ không còn nữa ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "Aqaba"
				},
				{
					"id": 30320303,
					"content": "Đúng vậy, nghe nói Mikoshi sống lâu nhất, rất thích hợp để làm người kể chuyện ở hồi kết của quyển tiểu thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320304,
					"content": "\"Bầu không khí kỳ quái đã tan biến, nhưng trong vài thập kỷ tới, việc này vẫn như áng mây đen đeo bám trong tâm trí của Mikoshi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320305,
					"content": "\"Khi tuổi đã cao, ông ấy đã mơ thấy một giấc mơ. Đêm rèn nên bảo đao Daitatara Nagamasa, mọi người đều nhảy nhót hò reo, vẽ tranh, nhảy múa và uống rượu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320306,
					"content": "\"...Bao niềm hân hoan đều hòa vào lò lửa, hóa thành vầng mây đỏ, vây quanh ánh bình minh cuối cùng mà Mikoshi nhìn thấy trong cuộc đời.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320307,
					"content": "\"Đường đời dài đằng đẵng, muốn hành động nhưng không biết cách diễn đạt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320308,
					"content": "...Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
			"completionStepIds": [
				303204
