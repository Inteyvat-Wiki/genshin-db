			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amane",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "Phù! Cuối cùng cũng có thời gian nghỉ ngơi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320502,
					"content": "Một khi thả lỏng là thấy vừa mệt vừa đói ngay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320503,
					"content": "Paimon cứ nghỉ ngơi cho khỏe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "Woa! Tuyệt quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320506,
					"content": "Ủa? Cái bình đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320507,
					"content": "...Hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "Là ai đã làm vỡ nó trong khi dọn dẹp sao? Nhưng đâu có nghe nói có người đến dọn dẹp phòng đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320509,
					"content": "(Tối đó ở chỗ nghỉ ngơi, Paimon đã bị giật mình bởi chuyện về Scaramouche, rồi vô tình va vào bàn và làm vỡ cái bình này.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(Nhưng sau đó Scaramouche đã xóa đi ký ức bản thân từng tồn tại, anh ta đã thay đổi thế giới... Nhưng cái bình này... sao vẫn vỡ vậy chứ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "#Nghe có vẻ như {F#cô}{M#cậu} đang rất hoang mang đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320512,
					"content": "...Là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "#Tôi hiểu nỗi buồn phiền của {F#cô}{M#cậu}. Bất cứ ai biết được điều này thì cũng cảm thấy đau đầu chóng mặt thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320514,
					"content": "Úi? Có ai đang nói chuyện ở bên tai của chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320515,
					"content": "Chỉ tiếc rằng số phận của Teyvat không dễ dàng bị lung lay. Thần linh thì còn chút cơ may, còn lại thì... khó nói đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320516,
					"content": "Một con vật nhỏ va vào thân cây có thể khiến nó lắc lư, nghiêng ngả nhưng sẽ không thể chuyển dời nó được, số phận cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320517,
					"content": "Cũng giống như cái bình khi rơi xuống đất, do con mèo làm vỡ hay là do con chim làm vỡ đi nữa. Cuối cùng thì nó cũng sẽ vỡ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320518,
					"content": "Ai, ai đó! Tại sao lại nói những lời này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320519,
					"content": "#Lịch sử không dễ dàng thay đổi, nhưng lòng người thì có đấy. Hãy tin vào đôi mắt của mình, những gì {F#cô}{M#cậu} thấy chính là sự thật, còn không thấy thì là ảo ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320520,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "Âm thanh biến mất rồi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320522,
					"content": "Người vừa nãy rốt cuộc là ai vậy! Đột nhiên xuất hiện rồi nói ra những lời đáng sợ như vậy là có ý gì cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320523,
					"content": "(Tin vào mắt mình sao? Ý của cô ấy là... muốn mình bảo vệ ký ức của bản thân sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "Còn cái bình đó vẫn vỡ vụn rồi, tôi đi tìm người đến dọn dẹp vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320525,
					"content": "...Cảm thấy cứ để vậy thì trong lòng cứ kỳ lạ sao sao ấy. Tôi sẽ quay lại ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320526,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320527
					]
				},
				{
					"id": 30320527,
					"content": "(Điều gì đang chờ đợi mình trong tương lai đây?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 30320504,
					"content": "Tôi mua vài món ngon để thưởng cho Paimon nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				}
			]
		},
