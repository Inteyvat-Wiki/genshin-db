				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320401,
					"content": "Như vậy thì anh cũng đã có tên rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320402
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320402,
					"content": "Còn biệt danh nữa, nghĩ ra chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320403
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320403,
					"content": "À... ừm, còn đang nghĩ, đừng có hối mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320404,
					"content": "Từ từ nghĩ đi. Trước khi nghĩ ra thì chúng ta tạm thời đừng gặp nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320405
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320405,
					"content": "Anh định làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320406
					]
				},
				{
					"id": 30320406,
					"content": "Những người hãm hại tôi khiến tôi rơi vào cảnh khốn cùng này, sớm muộn gì cũng sẽ phải trả giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320407
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320407,
					"content": "Anh đang nói Fatui sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320408,
					"content": "Chí ít thì là \"Dottore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320409
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320409,
					"content": "Lập trường đã thay đổi và tôi tin rằng con đường sau này của anh cũng sẽ thay đổi. Nhưng không phải bây giờ... anh vẫn cần một thời gian để chỉnh đốn lại bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320411
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320411,
					"content": "Còn một việc nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320412
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320412,
					"content": "Hiện vẫn còn một số hậu duệ của Raiden Gokaden ở Inazuma. Một số người trong họ biết... hoặc lẽ ra phải biết mối quan hệ của tôi và Raiden Gokaden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320413
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320413,
					"content": "#Tôi chưa định rời khỏi Sumeru đâu, nếu {F#cô}{M#cậu} có gặp họ ở Inazuma thì hãy nói với họ rằng tôi chính là người đã khiến Raiden Gokaden lụi tàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320414
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320414,
					"content": "...Cho dù sự việc này đã bị xóa khỏi thế giới này, thì họ cũng nên biết được chân tướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320415
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320415,
					"content": "Ra là vậy... Đây là lựa chọn của anh sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320416
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320416,
					"content": "Hả? Nhưng nếu như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320417,
					"content": "Không có gì cả, họ có thể dùng dao đâm vào ngực tôi nếu họ muốn... Có lẽ vốn dĩ họ nên làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320418,
						30320422
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320418,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320419
					]
				},
				{
					"id": 30320419,
					"content": "Ánh mắt này là ý gì? Không cần bày ra vẻ mặt này đâu, tôi biết bản thân đang làm gì mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320420
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320420,
					"content": "...Rồi ngày đó sẽ đến thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320421
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320421,
					"content": "Được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320425,
					"content": "Tạm biệt vị thần sáng suốt, tạm biệt mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320426
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320426,
					"content": "Đi mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320427,
					"content": "Những gì xảy ra gần đây đối với anh ấy giống như trải qua cả một đời người vậy. Dù là ai đi nữa thì cũng cần có thời gian để bình tĩnh lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320428,
					"content": "Ừm, cũng đúng. Tuy anh ấy vẫn như thế, nhưng giọng điệu đã không còn gay gắt như xưa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320429,
					"content": "Cho dù thế nào đi nữa thì cũng đã kết thúc rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320430
					]
				},
				{
					"id": 30320430,
					"content": "Chúng ta cuối cùng cũng có thể đi ăn rồi đúng không? Tôi sắp đói chết rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320431,
					"content": "Vất vả cho các bạn rồi, hãy tìm một nơi để nghỉ ngơi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320422,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320423
					]
				},
				{
					"id": 30320423,
					"content": "Rất thẳng thắn, tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320424
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320424,
					"content": "...Được rồi, chúng ta nói đến đây thôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
