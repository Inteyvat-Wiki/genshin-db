				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#Chào mừng đã trở về, {NICKNAME}, Paimon, Scaramouche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320102,
					"content": "Phù! Cảm giác như đã trải qua một hành trình rất dài vậy... mệt chết đi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "Lẽ nào anh cảm thấy bất mãn với cái tên này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320105,
					"content": "Không có gì. Chỉ là tôi đang nghĩ tôi cũng nên đổi tên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "Anh không muốn dùng cái tên Scaramouche nữa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "Rõ ràng biết Dottore làm nhiều chuyện như vậy, sao tôi có thể tiếp tục dùng cái tên có liên quan đến hắn ta chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "Tôi không có ý định và cũng không thể trở về hội Fatui. Chắc chắn có rất nhiều người bị chuyện lần này ảnh hưởng, chưa chắc có thể nhớ được vị trí thứ sáu là ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "Ý là anh muốn rời khỏi tổ chức sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320110,
					"content": "Xem như là ngụy trang để bỏ trốn đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "Như những gì cô nói, Tiểu Vương Kusanali. Mọi thứ tưởng chừng như vô ích nhưng không hề vô nghĩa, ít nhất thì cũng có thể khiến nhiều người quên đi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "Nhưng điều đó không có nghĩa là quá khứ của anh không còn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320114,
					"content": "Đương nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "Ngoài ra, những gì anh đang nỗ lực hết mình để theo đuổi, mục đích cốt lõi của nó... vẫn chưa đạt được, hãy hiểu điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320116,
					"content": "Thay đổi thế giới, thay đổi quá khứ... thay đổi số phận của người khác không dễ dàng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320117,
					"content": "Câu trả lời mà anh khao khát là sự hủy diệt hoàn toàn... bản chất của nó là ảo tưởng. Ngay cả khi không còn \"Scaramouche\" nào trên đời thì thế giới cũng sẽ không vận hành theo ý muốn của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320118,
					"content": "...Đúng vậy. Haha, thật nực cười.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "Đi xa đến mức này để có kết quả như vậy... không hối hận chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320120,
					"content": "Ngay cả khi tôi vô giá trị thì trên đời này cũng không có gì để hối tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "Tiểu Vương Kusanali, thông tin bên trong Cây Thế Giới là do cô cố ý để ở đó đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "Tôi cũng đã dồn rất nhiều tâm trí để anh có thể thu thập được thông tin một cách tự nhiên nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320123,
					"content": "Tại sao lại phải làm đến bước này? Cô cũng muốn lôi kéo tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "Thành thật mà nói, những gì trải qua trong quá khứ khiến anh trở thành một người có ích cho tôi và Sumeru. Thật ra chiêu mộ anh cũng là một phần trong kế hoạch của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320125,
					"content": "Nhưng trước đó, tôi muốn nói cho anh biết về sự thật trước đây đã. Nếu chỉ là lợi dụng thôi, thì tôi và Dottore có khác gì nhau đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320126,
					"content": "...Cô rất thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "Đây có lẽ là đức tính tốt mà tôi nên có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320128,
					"content": "Có ích cho người khác là giá trị. Vì vậy ngay cả khi là tù binh, tôi cũng có lý do để bị lợi dụng một lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "Nahida không nghĩ như vậy đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "À đúng, suýt nữa thì quên... Các người là phe chính nghĩa, không giống tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "Xin lỗi, tôi nhìn mọi thứ ở góc độ hơi khác. Nhưng tôi sẽ không gọi đó là tính toán, sự khôn ngoan của cô định trước rằng cô sẽ có những trợ thủ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "Anh nghĩ được như vậy thì tốt quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}, sắp tới tôi sẽ tiếp tục nghiên cứu và khai thác bí mật ẩn giấu bên trong Cây Thế Giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320134,
					"content": "Kể cả chuyến hành trình của người thân bạn được ghi lại trong Cây Thế Giới nữa. Rốt cuộc còn những chuyện gì? Tôi cũng rất muốn biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320135,
					"content": "Vậy thì nhờ cô tìm giúp tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "Có chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "#Tại sao khi tôi nhảy vào dòng thông tin của Cây Thế Giới, {F#cô}{M#cậu} lại đến Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "Bởi vì tôi muốn biết anh đã thay đổi những gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "...Vậy nên mới thăm dò được vận mệnh của những người đó sau khi bị thay đổi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "#Dù sao thì {F#cô}{M#cậu} cũng đã giúp tôi, ân tình này tôi sẽ cố hết sức để đền đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "...Những việc này không cần phải đền đáp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "#Giữa các cá nhân với nhau chỉ có quan hệ \"mượn\" và \"trả\". Sớm muộn gì chúng ta cũng sẽ không ai nợ ai, {F#cô}{M#cậu} không cần bận tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "Không phải vậy. Mối quan hệ giữa con người với nhau hoàn toàn không phải là một tờ giấy trắng có thể dễ dàng khôi phục lại trạng thái ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320147,
					"content": "Chắc hẳn anh đã từng cảm nhận được. Người đã từng xuất hiện trên đời sẽ không biến mất như giọt nước bốc hơi, trên đời cũng không có chuyện \"không ai nợ ai\" thực sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320148,
					"content": "Chính vì một số thứ không thể vãn hồi hoặc thay đổi, nên trên đời mới có tình cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320149,
					"content": "Mọi thứ anh cảm nhận được đều là thật, và những gì anh nợ cũng sẽ không che giấu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320150,
					"content": "Gánh chịu rạn nứt mà sống tiếp là hành vi của con người. Anh có thể lựa chọn trở thành con người hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "Không có người nào là không có trái tim, không phải sao? Hơn nữa, tôi không muốn trở thành người từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "Không có trái tim như anh vẫn có thể hiểu được đau khổ. Chỉ là anh đang kìm nén cảm xúc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320154,
					"content": "Quá khứ sẽ không bị lung lay, nhưng anh có thể đi tiếp. Chỉ cần sợi dây tương lai đủ dài thì sẽ có một ngày \"quá khứ\" sẽ trở thành một đoạn rất ngắn trên thước đo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320155,
					"content": "Có vẻ như cô đã tìm ra con đường cho tôi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "Mong là anh có thể phối hợp tốt với Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "Rất nhiều chuyện trộn lẫn vào nhau, không thể nói rõ nữa, dù sao thì điều quan trọng nhất là anh nên đi theo Nahida, nếu không thì tại sao chúng ta lại làm nhiều chuyện như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320158,
					"content": "...Vậy thì để tôi làm trợ thủ đằng sau đồng hành cùng mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "Rất vui khi anh đã chấp nhận lời đề nghị của chúng tôi. Để chúc mừng, hay là anh tự đặt cho mình một cái tên mới đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320160,
					"content": "Nhanh nhanh nhanh, tôi cũng muốn đặt cho anh một cái biệt danh thật khó nghe đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320161,
					"content": "Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "Tại... tại vì tôi vẫn không ưa anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320163,
					"content": "Hừ. Vậy sau này chúng ta tốt nhất đừng gặp nhau thường xuyên nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "\"Tên là món quà đầu tiên trong cuộc đời\", tuy anh không có nói ra, nhưng tôi biết anh nghĩ như vậy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320165,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#Lần này {NICKNAME} và Paimon đã giúp đỡ anh rất nhiều, nếu anh chưa quyết định được tên gọi thì có thể hỏi ý kiến của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320167,
					"content": "Hả? Để chúng tôi quyết định sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "Không được, tôi chỉ biết đặt biệt danh thôi, còn đặt tên đàng hoàng thì... giao cho bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320144,
					"content": "Đừng nói như tôi đang bắt chẹt anh vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
