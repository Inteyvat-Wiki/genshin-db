			},
			"dialogs": [
				{
					"id": 710130101,
					"content": "Tôi và sư huynh luyện võ từ nhỏ, dốc lòng trừ ma bảo vệ công đạo. Nhưng muốn bảo vệ công đạo trên thế gian mà không có sự hỗ trợ của <color=#00E1FFFF>Vision</color> thì thật không dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130102
					],
					"speakerTitle": "Kho Báu Di Tích"
				},
				{
					"id": 710130102,
					"content": "Tôi và sư huynh tu luyện ở đây, với mong muốn có <color=#00E1FFFF>Vision</color>, dựng lên bia này làm chứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130103
					],
					"speakerTitle": "Kho Báu Di Tích"
				}
			]
		},
		{
			"id": 7101302,
			"completionStepIds": [
				7101302
			],
