				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "<color=#00E1FFFF>Vision</color>... thực sự là vật không tầm thường, thế nhân đều nói vật này là món quà trời ban, nhưng không ai có thể nói được, rốt cuộc người nào có thể lấy được thần vật này, và tại sao lại có được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Kho Báu Di Tích"
				},
				{
					"id": 710131502,
					"content": "Tôi đã xem trong sách cổ, có người nói rằng ông trời thương người, nên đã ban <color=#00E1FFFF>Vision</color> cho những phàm nhân nổi bật, để tiêu diệt yêu quái, bảo vệ thế giới. Nhưng tôi... đã không còn ý định tiêu diệt quái vật nữa, mà chỉ muốn giao tiếp và khám quá bản chất của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Kho Báu Di Tích"
				},
				{
					"id": 710131503,
					"content": "<color=#00E1FFFF>Vision</color> này... Không có thì thôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kho Báu Di Tích"
				}
