			"dialogs": [
				{
					"id": 745250401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250402,
					"content": "Trông anh có vẻ nghiêm túc quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "#Là {F#cô}{M#cậu} à? Không, nhiệm vụ điều tra hôm nay đã kết thúc rồi, tạm thời chưa phát hiện điều gì bất thường quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250405,
					"content": "Tôi chỉ đang nghĩ, đám người Eremite vừa đi ngang qua sao lại trông ủ rũ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250406,
					"content": "Chắc là do hành trình quá mệt mỏi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "Tôi đoán là do vấn đề tài chính. Dù sao thì, đám lính đánh thuê mà \"sắc\" nét quá, thì chắc hẳn là bị \"đánh thuế\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250409,
					"content": "...Vậy làm chút chuyện giúp \"sắc nét\" nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "Tôi hiểu rồi. Có điều, nếu chỉ đứng yên một chỗ thì bức ảnh có lẽ sẽ hơi đơn điệu, thiếu sức hút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250412,
					"content": "#Yên tâm, tôi sẽ điều động sức mạnh Nguyên Tố Lôi để bức hình của {F#cô}{M#cậu} thực sự \"sắc nét\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250413,
					"content": "...Ý tưởng không tồi, tôi sẽ cố bắt trọn khoảnh khắc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "#Ừm. Giao cho {F#cô}{M#cậu} đấy. Đừng bỏ lỡ \"khoảnh khắc quyết định\" nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250410,
					"content": "Để tôi chụp cho anh một tấm hình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "Lẽ nào là do nhiệm vụ thất bại?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "Đang truy bắt tội phạm à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
	]
