			"dialogs": [
				{
					"id": 722130601,
					"content": "Meo meo meo, có việc gì? Ta sẽ chuẩn bị đủ \"trù tao\" mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130602,
					"content": "Là \"thù lao\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "Tóm lại là công cụ của Ooshima đã hỏng rồi. Nhưng chúng tôi đã đưa nguyên liệu sửa chữa cho anh ấy, chắc sẽ không có vấn đề gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "Vấn đề? Có vấn đề gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
