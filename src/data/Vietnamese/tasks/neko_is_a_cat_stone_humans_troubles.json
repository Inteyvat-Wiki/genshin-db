			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "Haiz, ở đây không có búa, không có đục, sao làm đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130302,
					"content": "Đã gặp khó khăn gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "Là các bạn à. Ây da... thật là sơ ý, trước khi đến không kiểm tra công cụ, lúc làm việc quá nhập tâm, bất cẩn làm hỏng búa và đục rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130304,
					"content": "Tuy là tôi cũng muốn quay về Đảo Narukami mua công cụ, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130305,
					"content": "Nói sao đây... Tôi đã quen với việc tạc tượng trong một lần cho đến khi hoàn tất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130306,
					"content": "Tuy là búa và đục đã hỏng rồi, nhưng tôi vẫn có thể suy nghĩ đôi chút là phía sau nên điêu khắc như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130307,
					"content": "Nếu bây giờ rời khỏi để đến Đảo Narukami mua công cụ... thì khi quay về, tôi phải nhớ lại cảm hứng điêu khắc ban đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130308,
					"content": "Hơn nữa kết cấu của tảng đá này rất cứng, nếu dùng công cụ thông thường, công cụ nhất định sẽ rất mau hư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130309,
					"content": "Hết cách rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130310,
					"content": "Nhà Lữ Hành, có thể phiền các bạn mang 3 Mảnh Sắt về cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130311,
					"content": "Tôi phải nghĩ cách, tự tay làm vài món công cụ mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130312,
					"content": "Hãy giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "Ừm! Vậy thì nhờ các bạn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130314,
					"content": "Bạn... tự rèn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "Dù gì thì tôi cũng làm trong Tatarasuna, đương nhiên cũng biết đôi chút nghề rèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130316,
					"content": "Nhưng tôi không thể mở lò trong đền thần được, ngài Guuji Đại Diện chắn chắn sẽ nổi giận... hi hi dù sao thì nó là mèo mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130317,
					"content": "Tóm lại bạn hãy tìm 3 Mảnh Sắt giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
