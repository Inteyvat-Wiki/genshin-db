				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "\"Trù tao\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130102,
					"content": "Bức tượng như thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "Người đá đó quả thực rất lợi hại đó, meo meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130104,
					"content": "Đã làm xong rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "Không phải, chỉ là trong chốc lát đã tìm được một tảng đá thật lớn thật lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130106,
					"content": "Sau đó lẩm bẩm \"xiền nong\", \"trù tao\" gì gì đó, rồi đập đùng đùng vào tượng đá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130107,
					"content": "Ngươi hãy trả lời ta xem. Rốt cuộc \"xiền nong\", \"trù tao\" là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130108,
					"content": "Là \"tiền công\" và \"thù lao\" đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "Chính là những đồ tốt đẹp dùng để báo đáp công sức của anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130110,
					"content": "Là vậy sao? Thì ra loài người xem trọng thứ này à... Được rồi, ta cho phép hắn sờ tai của ta đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130111,
					"content": "Có vẻ không đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130112,
					"content": "Không đủ sao? Vậy ngươi...cho hắn đồ ăn ngon đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130113,
					"content": "Có lẽ thứ anh ấy cần là tiền...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "Tiền? Thứ dùng để bỏ vào Hòm Công Đức sao? Thật kỳ lạ, sao loài người lại thích thứ này nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130115,
					"content": "Tiền công rất là quan trọng đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "Ngươi cũng đã giúp đỡ ta không ít, ta tin tưởng ngươi. Lát nữa ta sẽ thương lượng với hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130117,
					"content": "Nhưng người đá bây giờ không còn đùng đùng đùng nữa. Thấy hắn cầm cây gậy gỗ rất ngắn, không biết đang làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130118,
					"content": "Gậy gỗ? Tạc tượng không phải dùng mấy thứ như búa và đục sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130119,
					"content": "Không lẽ công cụ hỏng rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#{NICKNAME}, chúng ta đi tìm Ooshima đi! Không chừng có thể giúp được gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
