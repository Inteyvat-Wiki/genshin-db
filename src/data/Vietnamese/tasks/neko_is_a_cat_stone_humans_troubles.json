			"dialogs": [
				{
					"id": 722130501,
					"content": "Tốt quá rồi, vậy là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130502,
					"content": "Chốc lát tôi sẽ ra ngoài tìm nơi thích hợp để dựng lò, sau đó chế tạo công cụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130503,
					"content": "Phiền các bạn hãy chuyển lời đến ngài Guuji Đại Diện, tôi dọn dẹp ở đây trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
