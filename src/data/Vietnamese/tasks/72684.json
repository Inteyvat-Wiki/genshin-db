					"nextDialogs": [
						726840502
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840502,
					"content": "Chúng tôi tìm Bang Arataki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840503
					]
				},
				{
					"id": 726840503,
					"content": "À à à, tôi biết rồi, các bạn cũng tới tham gia lễ hội Arataki gì gì đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840504
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840504,
					"content": "Cũng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840505
					]
				},
				{
					"id": 726840505,
					"content": "Đúng rồi, mới đây đại nhân Kujou Sara của Hiệp Hội Tenryou và tiểu thư Yoimiya của Tiệm Pháo Hoa Naganohara đều đã tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840506
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840506,
					"content": "Tiểu thư Yoimiya tới đưa pháo hoa, trùng hợp thấy họ đang dọn sân, có thể là thấy hứng thú nên cũng ghé qua xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840507
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840507,
					"content": "Còn tại sao đại nhân Kujou Sara lại tới thì tôi không rõ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840508
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840508,
					"content": "#{NICKNAME}, có người tới trước chúng ta luôn kìa! Hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840509,
					"content": "Vậy bây giờ Bang Arataki đang ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840510,
					"content": "Nói ra thật xấu hổ, vì gần đây trên đảo không còn sân trống nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840511
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840511,
					"content": "Nên chúng tôi đành phải sắp xếp cho họ ở bãi bồi phía tây bắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840512
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840512,
					"content": "Nếu họ xin sớm hơn một chút thì tôi đã có thể chuẩn bị chỗ tốt hơn cho họ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840513
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840513,
					"content": "Các bạn đi về phía tây bắc là sẽ thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirohiko"
				}
			]
		},
		{
