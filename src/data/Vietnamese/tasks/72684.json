					"nextDialogs": [
						726840661
					]
				},
				{
					"id": 726840661,
					"content": "Cô chủ của Tiệm Pháo Hoa Naganohara kia sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840662
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840662,
					"content": "Đúng là một quý cô nhiệt tình thích nói chuyện, cô ấy tới Đảo Amakane giao hàng, trùng hợp biết bọn ta đang tổ chức lễ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840663
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840663,
					"content": "Cô ấy rất thích lễ hội của bọn ta nên tới chúc mừng, còn nói lần sau sẽ chuẩn bị pháo hoa cho bọn ta nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840664
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840664,
					"content": "Xem ra sau này Bang Arataki phải giao lưu với Tiệm Pháo Hoa Naganohara nhiều hơn mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
