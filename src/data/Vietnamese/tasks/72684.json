					"nextDialogs": [
						726840652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840652,
					"content": "Cái tên thả bò này, bản thân không bỏ ra xu nào, chỉ giỏi vơ vét 80 ngàn Mora của đàn em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
