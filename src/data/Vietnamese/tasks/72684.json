					"content": "Nghe nói Kujou Sara cũng tới à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840655
					]
				},
				{
					"id": 726840655,
					"content": "À, ngươi nói ả Tengu thối kia sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840656
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840656,
					"content": "Ta đã miễn cưỡng cho cô ta một tấm thiệp mời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840657
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840657,
					"content": "Nhưng cô ta không những không cảm kích, lại còn tới tận đây để treo bảng thông báo, bỏ lại mấy câu nhảm nhí để cảnh báo du khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840658
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840658,
					"content": "Còn cảnh cáo bọn ta không được phép xóa hay sửa nữa, đúng là cố ý gây sự mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840659
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840659,
					"content": "Một ngày nào đó ta nhất định sẽ đường đường chính chính đánh bại ả Tengu thối đó! Phải trừng trị cô ta một trận mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "Mà nói chứ, bạn của ta, ngươi có thắc mắc gì về lễ hội này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
