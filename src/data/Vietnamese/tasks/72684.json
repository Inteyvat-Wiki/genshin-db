			"dialogs": [
				{
					"id": 726847101,
					"content": "Tôi là Akira, đại sứ chăm sóc khách hàng của Đại Hội Đánh Trống Arataki, bạn có gì muốn góp ý ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847102,
						726847103,
						726847104
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847102,
					"content": "Tôi cảm thấy cũng không tệ lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847105,
					"content": "Được rồi, phản hồi của bạn đã được ghi nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847106
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847106,
					"content": "Hửm? Bạn hỏi cái khác sao? Tôi không còn gì khác để nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847107
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847107,
					"content": "À... Ý của đại ca là, công việc của tôi là chỉ cần nói hai câu \"bạn có gì muốn góp ý ư?\" và \"phản hồi của bạn đã được ghi nhận\" thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847108,
					"content": "Nếu như khách hỏi thêm khi nào có kết quả thì nói thêm một câu \"xin bạn hãy kiên nhẫn chờ đợi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847109
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847109,
					"content": "Đại ca nói tham gia lễ hội ở mấy chỗ khác đều như vậy, nên chắc là đã tham khảo kinh nghiệm của người ta rồi chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847110
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847110,
					"content": "Nhưng sau đó chị Shinobu nói như vậy thì qua loa quá, nên lại bảo tôi chuẩn bị thêm một quyển sổ nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847111
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847111,
					"content": "Nhìn đi, ý kiến của bạn đã được tôi ghi lại, đợi chị Shinobu trở lại thì sẽ để chị ấy xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akira"
				},
				{
					"id": 726847103,
					"content": "Tôi cảm thấy chỉ thường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847104,
					"content": "Tôi cảm thấy không ổn lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				}
			]
