					"nextDialogs": [
						726840646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840646,
					"content": "Tên thả bò như anh mà chịu chi những 80 ngàn Mora, tính ra cũng khiến người khác phải ngạc nhiên rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840647,
					"content": "Chỉ có 80 ngàn Mora thôi mà, đừng có xem thường bổn đại gia nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "Arataki Itto"
				},
				{
