			"dialogs": [
				{
					"id": 726840301,
					"content": "Có việc gì cần giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840302
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840302,
					"content": "Về lễ hội sắp diễn ra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840303
					]
				},
				{
					"id": 726840303,
					"content": "Cái gì? Lễ hội? Gần đây không thấy nói sẽ tổ chức lễ gì mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840304
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840304,
					"content": "Hai vị có thể nói rõ hơn không? Ví dụ như tên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840305
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840305,
					"content": "Tên là Đại Hội Đánh Trống...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840306
					]
				},
				{
					"id": 726840306,
					"content": "Đại Hội Đánh Trống?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840307,
						726840308
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840307,
					"content": "Đại Hội Đánh Trống Arataki Long Trọng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				},
				{
					"id": 726840309,
					"content": "Là Đại Hội Đánh Trống Arataki Long Trọng Bậc Nhất do Bang Arataki tổ chức!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840310,
					"content": "A! Hóa ra người làm loạn trong Lễ Hội Irodori lần trước là Bang Arataki à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840311
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840311,
					"content": "Hóa ra các bạn đang nói đến những lễ hội trái phép đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840312
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840312,
					"content": "Sao lại là lễ hội trái phép chứ? Không đúng không đúng, anh nhầm rồi. Là Đại Hội Đánh Trống Arataki Long Trọng Bậc Nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840313,
					"content": "Được rồi, không cần nhắc lại cái tên đó, tôi biết đại khái rồi, tóm lại để tôi nói cho mọi người biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840314
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840314,
					"content": "Mấy hôm trước tôi đã gặp được thành viên Bang Arataki, bọn họ chất cả đống thứ linh tinh ở xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840315
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840315,
					"content": "Người cầm đầu còn tuyên bố muốn mở một lễ hội còn lớn hơn cả Lễ Hội Irodori, chắc là lễ hội mà các bạn vừa nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840316
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840316,
					"content": "Kết quả hỏi thử hai câu, phát hiện họ không có giấy phép tổ chức hoạt động, cũng không có giấy tờ thuê sân bãi, cũng không hề tới hiệp hội xin giấy phép phê chuẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840317
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840317,
					"content": "Cho nên theo quy định thì chúng tôi đành phải cưỡng chế bọn họ lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840318
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840318,
					"content": "Hở? Cưỡng chế sao! Chẳng lẽ họ đã bị bắt rồi hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840319,
					"content": "Vậy thì không, nể tình bọn họ không có kinh nghiệm, cũng có chuẩn bị phương án an toàn, nên chúng tôi cũng chỉ cảnh cáo một chút mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840320
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840320,
					"content": "Phương án an toàn, tên đó cũng có ý thức an toàn ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840321,
					"content": "Nếu các bạn tìm Bang Arataki thì có thể tới Đảo Amakane xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840322
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840322,
					"content": "Đảo Amakane là sân bãi mà Hiệp Hội Yashiro dùng cho các lễ hội lớn nhỏ, mục đích ban đầu là muốn tổ chức các hoạt động văn hóa dân gian, thủ tục và chi phí đều được giản lược.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840323
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840323,
					"content": "Chúng tôi đã nói tin này cho Bang Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840324
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840324,
					"content": "Nếu họ vẫn muốn tổ chức lễ hội thì đó là sự lựa chọn thích hợp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840325
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840325,
					"content": "#Ừm... {NICKNAME}, tuy cảm thấy không đáng tin lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840326,
					"content": "Nhưng đã tới đây rồi... Hay là chúng ta tới Đảo Amakane xem thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840308,
					"content": "Đại Hội Đánh Trống Arataki Long Trọng Bậc Nhất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				}
			]
