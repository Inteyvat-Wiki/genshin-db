					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "Hahahahahahaha! Bạn thân của ta ơi! Cuối cùng ngươi cũng tới rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840602,
					"content": "Vừa rồi ta còn đang nghĩ, lúc nào thì mới có thể gặp ngươi, quả nhiên ngươi đã đến, đúng là kiến bổn đại gia vui mừng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840603,
					"content": "Nhìn lễ hội của bổn đại gia đi, sao nào? Có phải tuyệt vời lắm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840604,
					"content": "Ba mặt giáp biển, không khí trong lành, rời xa thành phố ồn ào, ngắm nhìn cảnh quan tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840605,
					"content": "Đưa lưng về Đảo Amakane, hưởng trọn dịch vụ hàng đầu của trung tâm văn hóa tế lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840606,
					"content": "Giao thông đường thủy phát triển, dù là đi bộ hay ngồi thuyền cũng rất nhanh và tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840607,
					"content": "Địa điểm đúng là không tệ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "Lần trước vừa thấy nơi này là bổn đại gia đã quyết định ngay, chính là nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840610,
					"content": "Tại thời khắc đó, thế giới đã thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840611,
					"content": "Đại ca anh minh!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840612,
					"content": "Rõ ràng là bị người của Hiệp Hội Tenryou đuổi qua đây mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840613,
					"content": "Khụ khụ... Chúng ta nói chuyện chính trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840614,
					"content": "Lần này mời các ngươi tới là muốn mời các ngươi tham gia Đại Hội Đánh Trống Arataki Long Trọng Bậc Nhất! Buổi lễ này có ý nghĩa rất trọng đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840615,
					"content": "Đại ca nói, một là để tuyên truyền danh tiếng của Bang Arataki, thuận tiện cho việc sau này chiêu mộ người mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840616,
					"content": "Thứ hai là chúc mừng chị Shinobu tốt nghiệp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840617,
					"content": "Cuối cùng còn có thể tổ chức hoạt động bang phái để bù lại mấy lần trước đã trì hoãn vì thiếu kinh phí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840618,
					"content": "Đúng là một lễ hội đa mục đích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840619,
					"content": "Akira... cái cuối không cần nhắc lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840620,
					"content": "Sao không thấy Shinobu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "Lễ hội thế này phải tuyên truyền thì mới có đông người tới tham gia chứ, nên Shinobu đã đi phát tờ rơi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840622,
					"content": "Này! Rõ ràng Shinobu mới là nhân vật chính mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840623,
					"content": "Thế mà cô ấy phải ra ngoài làm việc, còn các người ở đây chơi bời sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840624,
					"content": "Thì bổn đại gia cũng đang nghiêm túc... nghiêm túc tiếp đãi các ngươi rồi còn gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840625,
					"content": "Thật ra đại ca cũng vừa mới về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840626,
					"content": "Nói là có thể hai người sắp đến nên mới về để nghênh đón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840627,
					"content": "Vốn dĩ anh ấy đi với chị Shinobu để cố gắng lôi kéo người tham gia lễ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840628,
					"content": "Không cần phải khen ta đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840629,
					"content": "Chà, nghiêm túc làm việc thế cơ à, hiếm thấy lắm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840630,
					"content": "Hừ, ta không chấp nhặt với đồ dưa tím lùn biết bay nhà ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "Mà nói chứ, bạn của ta, ngươi có thắc mắc gì về lễ hội này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840608,
					"content": "Các anh đúng là lạc quan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
