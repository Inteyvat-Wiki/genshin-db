					"nextDialogs": [
						726840702
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840702,
					"content": "À đúng rồi, về cái trống này, lúc nãy đại ca quên dặn vài điều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840703
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840703,
					"content": "Vì mọi người đều không rành về nhạc cụ, nên trước khi bạn bắt đầu thì có thể thử điều chỉnh đôi chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
