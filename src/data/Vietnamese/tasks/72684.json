				{
					"id": 726847201,
					"content": "Tôi là Mamoru, đại sứ bầu không khí của Đại Hội Đánh Trống Arataki, bạn có yêu cầu gì ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847202
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847202,
					"content": "Bạn hỏi công việc của tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847203
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847203,
					"content": "À, đại sứ bầu không khí đó, chủ yếu là tạo bầu không khí náo nhiệt, để mọi người tham gia lễ hội đều có cảm giác \"sống nhiệt tình, chơi hết mình\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847204
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847204,
					"content": "Bạn có cảm giác này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847205,
						726847206
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847205,
					"content": "Hoàn toàn không có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				},
				{
					"id": 726847207,
					"content": "Xin... xin đừng nói vậy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847208
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847208,
					"content": "Đừng lạnh lùng đả kích tinh thần tích cực của tôi như thế chứ! Như vậy chẳng phải công việc của tôi sẽ mất hết ý nghĩa rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847209
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847209,
					"content": "Bạn là bạn thân của đại ca, xin hãy thay đại ca ủng hộ tôi. Tôi năn nỉ đấy, nói câu kia với tôi đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847210
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847210,
					"content": "Câu nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847211
					]
				},
				{
					"id": 726847211,
					"content": "Câu \"sống nhiệt tình, chơi hết mình\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847212,
						726847215
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847212,
					"content": "Sống nhiệt tình, chơi hết mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847213
					]
				},
				{
					"id": 726847213,
					"content": "Tuyệt quá! Đỉnh ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847214
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847214,
					"content": "Đây là sự ủng hộ tốt nhất dành cho tôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847218,
					"content": "Tới đi, các bạn hiền! Tới đây hát hò! Tới đây nhảy múa đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847215,
					"content": "Sống... nhiệt tình... xin lỗi, tôi không nói được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847216
					]
				},
				{
					"id": 726847216,
					"content": "Ừm... được rồi. Dù bạn nói như vậy, nhưng thấy cả Bang Arataki cố gắng hoàn thành công việc của mình, nên tôi cũng không thể chểnh mảng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847217
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847217,
					"content": "Dù gặp đả kích gì cũng không thể từ bỏ, đại ca đã dạy như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847206,
					"content": "Căn bản là không có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				}
			]
		}
	]
