						726840635
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840635,
					"content": "Cả đống lửa trại này nữa, dư sức nướng Dưa Tím.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840636,
					"content": "Đống thùng chất đống này nữa, dù để chơi \"Thất Thánh Triệu Hồi\" hay đấu bọ cũng sẽ không thấy chật chội.",
