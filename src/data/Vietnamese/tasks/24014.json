			"dialogs": [
				{
					"id": 240140801,
					"content": "Lũ Cá Máy Móc này... thật là quái quỷ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140802,
						240140803
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140802,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "Sửa rồi, nhưng lại bị hỏng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140805
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140805,
					"content": "Lũ Cá Máy Móc ở khu vực này không biết vì lý do gì, cứ như lũ điên vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140806
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140806,
					"content": "Ngay khi tôi vừa thả cá, chúng liền lao tới ăn sạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140807
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140807,
					"content": "Có vài chú cá con bám lên đồ lặn nên Cá Máy Móc đã lao thẳng về phía tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140808
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140808,
					"content": "Tuy tôi biết chúng sẽ không tấn công mình, nhưng tôi... vẫn sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140809
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140809,
					"content": "Sau đó, tôi vùng vẫy dưới nước, tay chân quơ lung tung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140810
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140810,
					"content": "Nên bộ đồ lặn đã rách một lỗ lớn... Cũng may lúc đó cách bờ không xa, tôi cố gắng hết sức cũng lên được bờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140811
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140811,
					"content": "Nhưng với tình hình hiện tại, chắc tôi không thể tiếp tục xuống nước thả cá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140812
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140812,
					"content": "Nhà Lữ Hành, bạn có đồng ý giúp tôi tiếp tục thả cá không? Bất kể vùng nước sâu hay nước nông đều được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140803,
					"content": "Cô sửa xong đồ lặn chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				}
			]
		}
	]
}