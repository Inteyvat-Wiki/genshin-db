				{
					"id": 240140607,
					"content": "Lát nữa tôi sẽ thả thêm một vài đợt cá con, sau đó những nhà mạo hiểm mà chúng tôi thuê sẽ đến và dọn sạch Cá Máy Móc trong khu vực này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140608,
					"content": "Tôi tin lũ cá con này nhất định sẽ lớn lên khỏe mạnh, giúp khôi phục lại môi trường sinh thái ở vùng nước này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140609,
					"content": "Đợi khi sinh thái được phục hồi. Tôi sẽ viết một bài báo thật dài. Để người dân biết được Viện Khoa Học Fontaine rốt cuộc đã gây ra chuyện gì với môi trường tự nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140610,
					"content": "Cứ đợi đấy, Damestier. Lần này nhất định sẽ không còn cơ hội vòng vo với tôi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				}
			]
		},
		{
			"id": 2401407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401401",
							"2"
						],
						"stepId": 2401401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linorea"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240140701,
					"content": "Thứ \"Cá Máy Móc\" này là sinh vật cơ khí do Viện Khoa Học Fontaine chế tạo. Cũng là thủ phạm phá hoại môi trường sinh thái ở Đại Sảnh Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140702
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140702,
					"content": "Ở mỗi vùng nước thường sẽ có hệ sinh thái cân bằng, các loài cá và sinh vật sẽ sinh sống quy củ, sinh sôi và phát triển ở trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140703
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140703,
					"content": "Tuy đôi khi trật tự của vùng nước sẽ bị quấy nhiễu... Ví dụ như có người tới câu cá, hay những loài cá khác xâm nhập...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140704
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140704,
					"content": "Có thể là do thời tiết thay đổi, dẫn đến việc một số loài cá rời khỏi vùng nước này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140726
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140726,
					"content": "Nhưng nói chung, hệ sinh thái của vùng nước sẽ luôn duy trì một trạng thái cân bằng tinh tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140705
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140705,
					"content": "Tuy nhiên, từ khi đám ngu ngốc của Viện Khoa Học Fontaine chế tạo ra Cá Máy Móc, mọi thứ đều trở nên tệ hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140706
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140706,
					"content": "Họ công bố loại cá này có tác dụng dọn dẹp rác thải và tạp chất, giúp giữ sạch môi trường nước, ngoài việc đó thì chẳng còn tác dụng gì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140707
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140707,
					"content": "Ban đầu, lũ Cá Máy Móc quả thật là đang dọn sạch nước, tất cả chúng tôi đều tin tưởng mấy lời dối trá đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140708
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140708,
					"content": "Sau một thời gian, bất ngờ có người báo cáo, số lượng đàn cá trong khu vực đều đang suy giảm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140709
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140709,
					"content": "Tới lúc này chúng tôi mới phát hiện, sau khi dọn sạch rác, lũ Cá Máy Móc liền coi những loài cá khác như rác thải và dọn dẹp luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140710,
						240140711
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140710,
					"content": "Thì ra \"dọn sạch nước\" là như vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140712
					]
				},
				{
					"id": 240140712,
					"content": "Dưới sự phản đối quyết liệt của chúng tôi thì đám người đó mới chịu dừng tất cả Cá Máy Móc lại, chuẩn bị đem về nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140713
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140713,
					"content": "Nhưng khi họ chuẩn bị thu hồi thì Viện Khoa Học Fontaine đột nhiên xảy ra vụ nổ lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140714
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140714,
					"content": "Sau đó, đám Cá Máy Móc vốn đã ngừng chạy bỗng có một số hoạt động trở lại, bắt đầu tấn công mạnh hơn vào các loài cá trong vùng nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140715
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140715,
					"content": "Tôi và một số đồng nghiệp nhận thấy nếu tiếp tục như vậy thì hệ sinh thái của Đại Sảnh Fontaine sẽ bị hủy hoại hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140716
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140716,
					"content": "Sau đó, dưới sự giúp đỡ của một số chuyên gia, chúng tôi bắt đầu thả các loài cá con tương thích vào vùng nước để phát triển quần thể cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140717
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140717,
					"content": "Mặt khác, thuê nhà mạo hiểm liên tục phá hủy và thu hồi Cá Máy Móc, từ đó bảo vệ hệ sinh thái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140718,
						240140719
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140718,
					"content": "Nghe lợi hại thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140720
					]
				},
				{
					"id": 240140720,
					"content": "Cảm ơn. Nghe như không phải là công việc của một phóng viên đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140721
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140721,
					"content": "Nhưng tôi cho rằng, trước khi viết một bài báo thì cần dốc sức để làm những việc thiết thực đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140727
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140727,
					"content": "Từ những việc thiết thực đó mới có thể thu được thông tin chân thực và hiệu quả, từ đó viết ra những bài báo xuất sắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140722
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140722,
					"content": "Woa, nghe vĩ đại thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140723,
					"content": "Tôi có thể giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140724
					]
				},
				{
					"id": 240140724,
					"content": "Cảm ơn ý tốt của bạn. Bộ đồ lặn của tôi cũng mới hỏng rồi, không có cách nào xuống nước để thả cá con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140725
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140725,
					"content": "Phiền bạn giúp tôi đi thả cá con nhé... bất kể là vùng nước sâu hay nông đều được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140719,
					"content": "Sự nghiệp đáng khâm phục.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140720
					]
				},
				{
					"id": 240140711,
					"content": "Ngoài \"nước\" ra thì tất cả đều là \"rác\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140712
					]
				}
			]
		},
		{
			"id": 2401408,
