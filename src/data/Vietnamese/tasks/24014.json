			},
			"dialogs": [
				{
					"id": 240140101,
					"content": "...Đàn cá ở đây lại giảm rồi, lẽ nào Cá Máy Móc lại bắt đầu hoạt động rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140102,
					"content": "Phải đưa cá con vào vùng nước sâu hơn mới được, nhưng bộ đồ lặn sao lại hỏng vào lúc này chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140103,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "Xin chào, tôi là Linorea, phóng viên chuyên phụ trách đưa tin về vấn đề môi trường, đang ở đây để... thả cá con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140105,
					"content": "Phóng viên?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "Đúng vậy. Nhưng tôi không chỉ nhăm nhe tin tức giật gân của người nổi tiếng, hay những phóng viên lặp đi lặp lại những mẩu tin nhạt nhẽo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140107,
					"content": "Thứ mà tôi để tâm chính là sự kiện nghiêm trọng đang xảy ra ở Đại Sảnh Fontaine, uy hiếp tới đời sống an toàn của người dân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140108,
					"content": "Hơn nữa, sự kiện này cũng là lý do tôi tới đây để thả cá con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140110,
					"content": "...Bạn có biết chuyện về \"Cá Máy Móc\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140111,
					"content": "Chưa từng nghe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "Là một loại cá đặc biệt của Đại Sảnh Fontaine sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "Tại sao phải thả cá con?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
