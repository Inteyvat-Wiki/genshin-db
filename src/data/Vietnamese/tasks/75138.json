			"dialogs": [
				{
					"id": 751380101,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, nhóc không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380102,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380103,
					"content": "#Tốt quá, {NICKNAME} đã... À ừm, khó giải thích lắm. Tóm lại là {NICKNAME} đã thấy nhóc và người lạ ở cùng với nhau trong giấc mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380104,
					"content": "Nhóc có gặp người lạ kỳ quái nào trên Tonatiuh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380105,
					"content": "Rawr... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380106,
					"content": "Hả? Rốt cuộc là có hay không vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380107,
					"content": "Roooawrh... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380108,
					"content": "Chậc, thật sự không hiểu gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380109,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} không sao là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380110
					]
				},
				{
					"id": 751380110,
					"content": "Đúng vậy. Nhưng còn Bona thì sao? Cô ấy đi đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380111,
					"content": "Rooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380112,
					"content": "Chẳng lẽ lại lạc nhau rồi sao? Hay là Bona thật sự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380113,
					"content": "Có thể Bona chỉ là một nhân vật trong câu chuyện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380114
					]
				},
				{
					"id": 751380114,
					"content": "Hmm... Cũng đúng, người bình thường không thể sống hàng trăm năm như thế được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380115,
					"content": "Nhưng ít ra thì chúng ta đã hoàn thành cuộc phiêu lưu dở dang của cô ấy rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380116
					]
				},
				{
					"id": 751380116,
					"content": "Đúng vậy, chúng ta cũng đã hứa với cô ấy là sẽ truyền bá về cuộc phiêu lưu này. Khi mọi người biết chúng ta đã tìm thấy Tonatiuh thì Bona cũng sẽ trở thành một nhà mạo hiểm nổi tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380117,
					"content": "Tiếp theo sẽ là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380118
					]
				},
				{
					"id": 751380118,
					"content": "Tiếp theo chúng ta sẽ đến núi lửa để tìm \"kẻ đó\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380119
					]
				},
				{
					"id": 751380119,
					"content": "Chúng ta sẽ làm sáng tỏ mọi chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380120,
					"content": "Kể ra thì người đó không phải là \"Hiền Giả Trộm Lửa\" đấy chứ? Suốt dọc đường toàn là những thông điệp bí ẩn, tôi càng ngày càng tò mò rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380121,
					"content": "Hơn nữa còn nói là sẽ cải trang thành nhiều nhân vật khác nhau, dù có gặp thì chúng ta cũng chưa chắc nhận ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380122,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380123,
					"content": "#Quả nhiên {REALNAME[ID(2)|SHOWHOST(true)]} cũng tò mò nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380124,
					"content": "#Giờ đã có đủ tín vật, tiếp theo chúng ta sẽ cùng nhau đi đến núi lửa, giải mã tất cả bí ẩn rồi giúp {REALNAME[ID(2)|SHOWHOST(true)]} hóa giải lời nguyền nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380125,
					"content": "Xin lỗi nhé, Bona. Chúng tôi sẽ mang Đĩa Vàng Thông Điệp đi trước. Sau khi làm rõ mọi chuyện rồi chúng tôi sẽ nói với cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
