				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "Là các cháu à, Tường Vi và mọi người đều đang đợi các cháu đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090102,
					"content": "Sabbah cũng đến từ sớm rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090103,
					"content": "Gần đây tôi thường đến chỗ này, tôi đã xem hết sổ ghi chép của ông Shafaqat để lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090104,
					"content": "Trước đây tôi luôn cho rằng cuộc sống ở Làng Aaru rất cô độc, nhưng bây giờ tôi cảm thấy khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090105,
					"content": "Ít ra thì tôi không phải chỉ có một mình, còn có những đóa Tường Vi này, và ký ức cùng với các bạn, còn có ông Affan nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090106,
					"content": "Cuộc sống của tôi còn có những hồi ức tốt đẹp, nghĩ như thế thì không còn thấy bản thân cô độc nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090107,
					"content": "Tôi và ông Affan đã thương lượng rồi, sau này tôi sẽ giúp ông ấy chăm sóc Tường Vi Vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090108,
					"content": "Để chúng nở rộ khắp cả khu vườn. Còn bây giờ thì để mấy gốc cây này ra hoa trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090109,
					"content": "Bạn có nhớ bạn đã làm cho Tường Vi Sumeru của tôi nở hoa như thế nào không? Dùng cách đó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090110,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "Nào, nhờ bạn cả đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
