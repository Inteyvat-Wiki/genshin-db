			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "\"Tường vi ơi tường vi, hãy thực hiện nguyện vọng của ta.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "\"Hoa nở từ đá, Tường Vi Vàng ca hát cho ta.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "Hoa Tường Vi màu vàng quả thật rất xinh đẹp, nhìn chúng nở rộ, cảm giác tâm trạng cũng tươi sáng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090402,
					"content": "Không uổng phí công sức mấy hôm nay, vui quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090403,
					"content": "Tâm nguyện cuối cùng cũng thành hiện thực rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "Cuối cùng cũng có một điều là ta có thể làm tốt rồi. Ông Shafaqat, cháu đã giúp ông hoàn thành tâm nguyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090406,
					"content": "Tiếc rằng ông ấy không nhìn thấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090407,
					"content": "Sabbah, không thể nói như vậy. Cháu còn nhớ đoạn cuối của bài Ca Dao Tường Vi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090408,
					"content": "\"Ta chẳng tồn tại trong đất cát, chỉ ẩn chứa trong thơ ca.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090409,
					"content": "\"Ca dao đánh tan số phận, viết lại kết cục của ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090410,
					"content": "\"Đánh bại ta, đánh bại thời gian, đánh bại sự tan biến luôn trường tồn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090411,
					"content": "Ông Shafaqat, Tường Vi Vàng, và cả bài ca dao mà ông sáng tác đều sẽ còn mãi bên cạnh chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090412,
					"content": "Ừm, nói đúng lắm, ông ấy đã đánh bại sự lãng quên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090413,
					"content": "Cảm ơn mọi người đã cho tôi biết chuyện của ông Shafaqat, việc này đối với tôi rất quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090414,
					"content": "Ông ấy là kẻ lưu đày trước tôi, nhìn thấy những dấu vết của cuộc đời ông ấy khiến tôi cảm thấy mình dường như vượt qua thời gian và không gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090415,
					"content": "Cái tôi nhìn thấy không chỉ là ông Shafaqat, mà còn có chính tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090416,
					"content": "Mặc dù tôi không thể nói gì với ông ấy, nhưng tôi có thể mang theo những hối tiếc của ông ấy tiếp tục sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090417,
					"content": "Nếu như tôi nỗ lực sống tiếp cả phần của ông ấy, vậy thì tôi nhất định sẽ có thể cứu rỗi được chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090418,
					"content": "Hy vọng cô được hạnh phúc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "Tôi cảm thấy cuộc sống nơi đây không còn tồi tệ nữa, thật tốt khi gặp được các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090421,
					"content": "Hoa Tường Vi quả nhiên là loài hoa mang đến hạnh phúc. Ông Affan, sau này chúng ta phải cố gắng trồng thật nhiều hoa Tường Vi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090422,
					"content": "Hahaha, xem như chúng ta hứa rồi đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090423,
					"content": "Vâng, cháu sẽ cố gắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090419,
					"content": "Đừng bỏ cuộc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "Mọi thứ đều xứng đáng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
