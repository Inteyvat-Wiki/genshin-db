			"dialogs": [
				{
					"id": 191170106,
					"content": "Gâu! Gâu gâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170107,
					"content": "Dữ quá! Xém xíu bị cắn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170108,
					"content": "Mày đó, bụng đã đói meo rồi, cũng nên ăn chút gì đó đi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170109,
					"content": "Cho dù mày không muốn theo tao về thì cũng đâu nhất thiết phải nhịn ăn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170110,
					"content": "Chẳng lẽ mày sợ tao thuốc mày hả? Tao ăn thử cho coi nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170121,
					"content": "Xem đi, không có vấn đề gì hết đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170111,
					"content": "Thoma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "Nè, ăn chút gì đi. Chỉ cần ăn vài miếng thôi, hôm nay tao sẽ không đến làm phiền mày nữa, sao nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170114,
					"content": "Gâu! Gâu gâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170115,
					"content": "Hoàn toàn không chịu ăn...Tôi cứ thấy nó có vẻ gì đó nôn nóng bất an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170116,
					"content": "Dưới biển có thứ gì sao? Hay là xung quanh có thứ gì làm nó phải cảnh giác?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170117,
					"content": "Hay là đám quái vật đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "Ý bạn là nó bị đám quái vật xung quanh tấn công sao...Cũng có thể lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170119,
					"content": "Con người trong hoàn cảnh nguy khốn cũng không muốn ăn uống mà, vậy chúng ta hãy dẹp sạch xung quanh đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170120,
					"content": "#Thật vất vả cho bạn quá, {NICKNAME}. Chí ít thì xung quanh đây đã yên tĩnh hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170112,
					"content": "Liều ghê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
