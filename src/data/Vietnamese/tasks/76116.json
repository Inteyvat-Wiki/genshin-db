			"dialogs": [
				{
					"id": 761160101,
					"content": "Này, đây không phải là bạn của chúng ta và Bobik sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160102,
					"content": "Hai người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Chúng tôi sẽ ở lại đây một thời gian, dù sao cũng đã phá hỏng cửa lớn phòng thí nghiệm của Drzislav mà. Chúng tôi phải canh chừng ở gần đây để tránh những kẻ xấu đó thừa cơ lẻn vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160104,
					"content": "Đợi chúng tôi sửa xong cửa hoặc khi Desla về nhà, chắc sẽ giống như hai người, dắt Bobik cùng đi du lịch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160105,
					"content": "Về Drzislav...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "Hoàn toàn không có manh mối về anh ta... Nếu hai người có gặp trong chuyến du ngoạn thì hãy gửi lời hỏi thăm giúp chúng tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160107,
					"content": "Thật muốn cùng anh ta đến Soái Hạm uống rượu thâu đêm quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160108,
					"content": "Về Bobik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "#Nhớ Bobik rồi à? Chỉ cần {F#cô}{M#cậu} có thời gian thì có thể đến chơi với nó bất cứ lúc nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160110,
					"content": "Tạm biệt nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "Ừm, chúng ta nhất định sẽ gặp lại, dù sao chúng ta cũng là bạn bè vào sinh ra tử mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				}
			]
