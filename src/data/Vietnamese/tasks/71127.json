				"points": []
			},
			"dialogs": [
				{
					"id": 711271301,
					"content": "Chị Fujin! Chúc mừng chị đã hồi phục!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271302
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711271302,
					"content": "Em nghe A Lam nói là chị Fujin rất thích trà, nên em đã nhờ ông Lu làm cho chị Fujin bánh trà siêu ngon này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271303
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711271303,
					"content": "Ừm, chị đã biến lại thành như cũ rồi! Tiểu Mao, cảm ơn em đã chuẩn bị bánh trà cho chị, chị rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711271304,
					"content": "#{M#Anh}{F#Chị} {NICKNAME}, chị Paimon, em cũng có chuẩn bị phần cho {M#anh chị}{F#hai chị} này! Chúng ta cùng nhau ăn bánh chúc mừng chị Fujin đã bình phục nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271305,
						711271307
					],
					"speakerTitle": "Tiểu Mao"
				},
				{
					"id": 711271305,
					"content": "(Lấy một miếng bánh trà.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271306
					]
				},
				{
					"id": 711271306,
					"content": "Cảm ơn Tiểu Mao! Nếu vậy thì chị sẽ lấy hai cái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271307,
					"content": "(Lấy hai miếng bánh trà.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271308
					]
				},
				{
					"id": 711271308,
					"content": "Cảm ơn Tiểu Mao! Nếu vậy thì chị sẽ... Ối, chỉ còn lại một cái thôi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
