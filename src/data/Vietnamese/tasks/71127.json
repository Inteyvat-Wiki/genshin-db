	"talks": [
		{
			"id": 7112703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112708",
							"2"
						],
						"stepId": 7112708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270301,
					"content": "Kể ra thì, chỗ này là động tiên của Fujin phải không? Tôi cứ cảm thấy nó khác với những động tiên khác mà chúng tôi từng thấy. Nói thế nào nhỉ, nó có vẻ... có thật hơn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270302,
					"content": "Không có cơ quan kỳ lạ, cũng không có những cây cầu nổi trong suốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270303,
					"content": "Thật sự xin lỗi... Trước đây do cảm thấy rất xấu hổ, nên đã không giải thích rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270304,
					"content": "Tôi không thể tạo ra một không gian mới như các vị tiên nhân ở phương nam. Cẩm Lạc Đình không phải là động tiên gì, nó cùng lắm chỉ là một hang động thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270305
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270305,
					"content": "Dù là gì đi nữa thì đều là động phủ của tiên gia mà! Nhưng mà, không biết khi nào Fujin mới có thể trở lại thành dạng người nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270306,
					"content": "Toàn bộ sức mạnh cô ấy tích lũy đã bị phân tán trên vùng đất này, trong thời gian ngắn chắc sẽ không thể trở lại thành hình dạng con người đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270307,
					"content": "Khi tôi cạn kiệt sức lực cũng vậy. Sau khi chủ nhân qua đời, từ tuyết rơi đến tuyết tan, rồi từ tuyết tan đến tuyết rơi, lặp đi lặp lại không biết bao nhiêu lần, tôi mới có thể biến thành người lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270308
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270308,
					"content": "Thì ra là vậy... Ơ? Đợi một chút, thì ra Lingyuan cũng có thể biến thành người sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270309,
					"content": "Tất nhiên rồi! Hai vị không biết rồi, lúc còn ở Núi Dược Quân, dung mạo của Lingyuan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270310
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270310,
					"content": "Fujin, đừng nói nữa. Nó không liên quan tới chủ đề hiện tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270311,
					"content": "Hả? Vậy chuyện sau khi biến thành dạng người, vì ăn quá nhiều bánh trà nên đã khóc lóc chạy đi cầu xin Dược Quân điều chế cho một ly trà giảm béo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270312
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270312,
					"content": "Hoặc vô tình tưởng rượu là trà nên uống nhầm trong bữa tiệc, rồi tóm lấy lợn rừng trên núi hỏi \"Dược Quân và ta ai đẹp hơn\"... Những chuyện này đều không cần nói tiếp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270313
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270313,
					"content": "...Fujin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270314
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270314,
					"content": "Ôi, tôi bắt đầu thắc mắc hình dáng con người của Lingyuan sẽ như thế nào rồi đó! Liệu có xanh lam giống như bây giờ không? Hay sẽ... trắng hơn một chút nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270315,
						711270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270315,
					"content": "Tôi cũng rất tò mò đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270316
					]
				},
				{
					"id": 711270316,
					"content": "Tôi không hiểu tại sao lại tò mò đấy. Các người cũng là con người, nếu có hứng thú với hình dáng con người thì cứ đi nhìn vào bản thân đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270321,
					"content": "#Haha... Tóm lại, cảm ơn {NICKNAME} và Paimon. Tôi chưa bao giờ nghĩ rằng một ngày nào đó mình sẽ có thể giao tiếp với người khác như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270322
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270322,
					"content": "Khụ... Tâm trạng của tôi đang tốt, tôi có thể phù hộ hai vị, để chặng đường còn lại của hai vị sẽ thuận buồm xuôi gió, gặp nhiều may mắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270323
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270323,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270324,
					"content": "Xin lỗi, tôi hơi đắc ý. Do muốn bắt chước tiên nhân nên mới nói ra câu đó thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270325
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270325,
					"content": "Dù sao đi nữa, tôi sẽ ở đây cầu nguyện cho chuyến hành trình tiếp theo của hai vị thuận buồm xuôi gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270317,
					"content": "Lingyuan, có thể biến hình thử được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270318
					]
				},
				{
					"id": 711270318,
					"content": "Tôi từ chối. Cơ thể con người quá yếu. Không có răng nanh để xé con mồi thành từng mảnh, cũng không có móng vuốt sắc bén để săn lùng kẻ thù. Tôi sẽ không làm chuyện đó, trừ khi Fujin ra lệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270319,
					"content": "Ơ, cái này... Tôi nghĩ chúng ta nên tôn trọng ý kiến của Lingyuan nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270320
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270320,
					"content": "Tôi không có ý kiến gì. Nếu cô có suy nghĩ gì thì cứ nói với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
