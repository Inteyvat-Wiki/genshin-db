					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270907,
					"content": "Kết thúc mà chị nghĩ ra không có hậu, câu chuyện cũng không khiến ai vui vẻ. Vậy nên để em kể phần kết vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270908
					],
					"speakerTitle": "Lingyuan"
				},
