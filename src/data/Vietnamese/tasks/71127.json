					"content": "Tôi đã nói rồi, tôi chỉ cần nghỉ ngơi ở đây một thời gian là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME} và Paimon, cảm ơn các vị vì đã đến thăm tôi. Tôi thực sự rất vui. Đây là lần đầu tiên có người đến đây kể từ khi Dược Quân rời đi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "Fujin"
