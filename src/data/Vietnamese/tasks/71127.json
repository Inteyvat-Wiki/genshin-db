				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME} và Paimon, hai người đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270402,
					"content": "Ơ, Lingyuan? Sao cô lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270403,
					"content": "Vì tôi không vào được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270404,
					"content": "Không vào được? Là không vào được chỗ nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270405,
					"content": "Cẩm Lạc Đình. Nơi Fujin đang nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270406,
					"content": "Cẩm Lạc Đình... À, chính là nơi ban đầu Fujin kéo chúng ta vào trong phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270407,
					"content": "Đó là nơi ở mà cô ấy dùng tiên lực để phong tỏa. Tôi không có tiên lực của cô ấy, nên không thể vào đó được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270408,
					"content": "Ơ? Nhưng lúc trước khi cô ấy trở về nghỉ ngơi, đâu có nghe cô nói về chuyện này đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270409,
					"content": "Tôi không nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270410,
					"content": "Có cần giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "Các người có tiên lực của cô ấy, có thể mở cửa Cẩm Lạc Đình đúng không? Tôi hy vọng các người giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270416,
					"content": "Hả? Đợi một chút, vì vậy mà cô luôn ở đây đợi chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270417,
					"content": "Tôi không đợi các người. Tôi đang tìm cách để vào Cẩm Lạc Đình.",
