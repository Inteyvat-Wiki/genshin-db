					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "...Chỉ là nếu gặp được thì sẽ để ý thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "Cảm ơn. Nhưng tôi thực sự không muốn gây thêm rắc rối cho các vị vì chuyện của riêng tôi, các vị đã giúp tôi quá nhiều rồi.",
