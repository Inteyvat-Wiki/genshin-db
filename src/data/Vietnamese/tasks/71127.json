					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "Đúng vậy, chúng tôi đều lo lắng cho sức khỏe của cô nên đã đến mà không chào hỏi... Nhưng lúc đầu Fujin cũng kéo chúng tôi đến mà không chào hỏi mà. Xem như chúng ta hòa nhau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270509,
					"content": "Ơ? Xin lỗi! Khi tôi trở về Cẩm Lạc Đình nghỉ ngơi, hình như đã quên mở khóa cửa nhỉ...! Xin lỗi, rõ ràng mọi người đến thăm tôi, nhưng lại làm khó mọi người rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270510,
					"content": "Cũng không hẳn là gây phiền phức. Nhưng mà, tại sao cô lại trốn trong... à ừm, vũng nước này vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270511,
					"content": "Nói thế nào nhỉ... Vì hiện tại tôi không thể hồi phục lại hình dáng mà tôi thích, cứ để mọi người thấy hình dạng cá chép này, tôi thấy có chút... ngại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270512,
					"content": "Rõ ràng trước đó đã thấy qua nhiều lần rồi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "Ahaha... Bởi vì trước đây tôi có thể biến về hình dạng con người bất cứ lúc nào, nên tôi nghĩ di chuyển trong hình dạng cá chép sẽ thuận tiện hơn; Bây giờ tôi chỉ còn hình dạng trơn trượt này, nên tôi cảm thấy hơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270515,
					"content": "Ôi, đúng là cố chấp đến lạ lùng mà... Tóm lại, Fujin không sao là tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270516,
					"content": "Tuy nhiên, theo những gì Lingyuan nói trước đây, sức mạnh của Fujin thật ra không bị tiêu hao trực tiếp, mà chỉ phân tán đến rừng núi sông suối ở Trầm Ngọc Cốc, nên mới trở nên suy yếu như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270517,
					"content": "Vậy thì giống như lúc tìm cá chép vàng ở Dược Điệp Cốc, chúng tôi thu thập lại tiên lực phân tán thì Fujin sẽ có thể hồi phục, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270518,
					"content": "Ừm... Trên lý thuyết thì là như vậy, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270519,
					"content": "Đúng không? Vậy sau này nếu chúng tôi phát hiện cá chép tương tự thì sẽ mang nó về! Như vậy Fujin cũng sẽ sớm ngày hồi phục!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270520,
					"content": "Chuyện này phiền các vị quá rồi! Sức mạnh của tôi cũng chưa suy yếu đến mức đó, chỉ cần nghỉ ngơi ở đây một thời gian là sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270521,
					"content": "Cũng không phải chuyện phiền phức gì...",
