					"nextDialogs": [
						711270532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270532,
					"content": "#Cuối cùng... Hãy để tôi nói lời cảm ơn một lần nữa, {NICKNAME} và Paimon. Cảm ơn vì tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270513,
					"content": "Nên đâu cần phải trốn tránh nhỉ?",
