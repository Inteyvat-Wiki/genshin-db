					"nextDialogs": [
						711270418
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270418,
					"content": "Hình như cũng không có gì khác biệt nhỉ... Tóm lại, chúng tôi cũng có chút lo lắng cho tình trạng của Fujin. Vậy, Lingyuan, chúng ta cùng đi thăm cô ấy nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270419,
					"content": "Được. Cảm ơn các người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270420,
					"content": "Đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270412,
					"content": "A Lam, thật ngốc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "Đúng vậy! Chuyện quan trọng như vậy sao có thể quên được chứ! Thật là!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270414,
					"content": "Bởi vì tôi chỉ là một con thú ngu ngốc. Khi nhìn thấy cô ấy, tôi suy nghĩ rất nhiều thứ, nên cũng quên mất nhiều thứ. Đó là lỗi của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270415,
					"content": "Các người có tiên lực của cô ấy, có thể mở cửa Cẩm Lạc Đình. Đúng rồi, hy vọng các người giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				}
			]
