			},
			"dialogs": [
				{
					"id": 761590601,
					"content": "Lại đổi chỗ nữa rồi. Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590602,
						761590603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590602,
					"content": "Đợi đã, trong nhà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590604
					]
				},
				{
					"id": 761590604,
					"content": "Chẳng trách hôm đó Alice đột nhiên đến tìm tôi để lấy chìa khóa, nói là muốn trang trí một phòng trà đẹp mắt... Tôi đã nói với cô ấy là tôi có phòng trà rồi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590605,
						761590606
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590605,
					"content": "Đây là quà của Alice sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590607
					]
				},
				{
					"id": 761590607,
					"content": "Về mặt ý nghĩa, nó tượng trưng cho \"sự kết thúc của chỉ dẫn\", \"điểm cuối của hành trình\"... và cả \"lời tiên tri viên mãn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590608
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590608,
					"content": "Trước đây hẳn là hai người đã từng đi theo Tiên Linh đúng không? Chỉ khi các Tiên Linh quay về Đài Tiên Linh thì đoạn \"chỉ dẫn\" đó mới chính thức kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590609
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590609,
					"content": "Vì vậy, để cho đoạn \"bài tập\" bị tạo ra một cách gượng ép này của tôi có một điểm kết thúc rõ ràng, Barbie và Alice mới tạo một Đài Tiên Linh ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590610
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590610,
					"content": "Chỉ có như vậy, mới có thể ghi nhận câu chuyện của tôi vào câu chuyện của mọi người mà không làm ảnh hưởng đến những bài tập khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590611
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590611,
					"content": "Nhưng Nicole cũng không phải Tiên Linh mà nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590612
					]
				},
				{
					"id": 761590612,
					"content": "À... ừm, suýt nữa là phải rồi, mọi người trước đây cũng đều là thiên sứ mà... Ôi, không sao đâu, đại khái ý đó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590613
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590613,
					"content": "Cũng giống như viết tiểu thuyết vậy, chỉ cần dàn ý chính đúng, thì những chi tiết bên trong chịu khó suy nghĩ một chút là có thể hoàn thiện thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590614
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590614,
					"content": "Tóm lại, chỉ cần tôi ngồi lên đó thì bài tập này sẽ chính thức kết thúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590615,
					"content": "Nhưng nói đi cũng phải nói lại, câu chuyện viết tạm thì cũng chỉ có thể như vậy thôi... Nếu như Anya ở đây, có lẽ sẽ nghĩ ra được một câu chuyện đơn giản và tinh tế hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590616,
						761590617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590616,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590618
					]
				},
				{
					"id": 761590618,
					"content": "Hihi, đương nhiên không thể thiếu phần này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590619,
					"content": "Xuất hiện rồi! Rương báu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590620,
					"content": "Xuất hiện rồi! Rương báu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590621
					]
				},
				{
					"id": 761590621,
					"content": "Đột, đột nhiên cảm thấy, phần \"bài tập\" này đúng là rất hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590622,
						761590623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590622,
					"content": "Đây chính là cảm giác khi các chi tiết được hoàn thiện sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590624
					]
				},
				{
					"id": 761590624,
					"content": "Chính là cảm giác này! Xem ra công việc hướng dẫn bài tập của tôi cũng không uổng công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590625,
					"content": "Khụ... Có vẻ như câu chuyện của tôi đã chính thức được ghi vào cuốn từ điển đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590626
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590626,
					"content": "Vậy bài tập lần này tới đây thôi, bài tập sau này của mọi người cũng đã có một giáo viên hướng dẫn chính thức rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590627,
					"content": "Vậy... sau này còn có rương báu nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590628
					]
				},
				{
					"id": 761590628,
					"content": "Cái này thì phải xem sau này mọi người sẽ thiết kế ra bài tập như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590629,
					"content": "Nếu có thể, tôi cũng muốn chôn rương báu trên đường mọi người đi làm bài tập, bố trí các manh mối dọc đường, rồi nhìn mọi người tiến về phía trước đào được rương báu... Như vậy tôi sẽ rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590630
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590630,
					"content": "Nhưng Barbie theo dõi tôi sát sao lắm. Haiz, xem ra tôi không thể nắm bắt được cơ hội này rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590623,
					"content": "Quả nhiên dàn ý chính rất quan trọng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590624
					]
				},
				{
					"id": 761590617,
					"content": "Tôi còn tưởng rương báu xuất hiện mới tính là kết thúc chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590618
					]
				},
				{
					"id": 761590606,
					"content": "Đài Tiên Linh này là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590607
					]
				},
				{
					"id": 761590603,
					"content": "Có một Đài Tiên Linh thật lớn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590604
					]
				}
			]
		},
