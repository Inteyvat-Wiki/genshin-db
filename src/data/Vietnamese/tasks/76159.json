						761590306
					],
					"speakerTitle": "Đàn Sói"
				},
				{
					"id": 761590305,
					"content": "Bầy sói rời đi rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				},
				{
					"id": 761590307,
					"content": "Đứa trẻ đó vẫn chưa tới sao? Có lẽ thời cơ chưa đến. Nhưng chỉ cần sát cánh cùng Lupical, dù phải đối mặt với kẻ địch nào, đứa trẻ đó cũng sẽ chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590309
					],
					"speakerTitle": "Đàn Sói"
				},
				{
					"id": 761590309,
					"content": "Sao chúng lại quay về vậy? Chẳng lẽ nghe được lời chúng ta nói? Giá mà Razor ở đây thì tốt biết mấy, chắc chắn Razor sẽ hiểu được bầy sói muốn nói gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590310,
					"content": "Đúng vậy, nhưng ngoài ra, cậu ấy còn phải hiểu thêm nhiều thứ khác nữa mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590311,
						761590312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590311,
					"content": "Nơi này là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590313,
					"content": "Ừm, cậu bé tên Razor đã giành chiến thắng trong trận chiến khốc liệt mà cậu ấy nhất định phải đối mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590314
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590314,
					"content": "Tôi nghĩ, chỉ cần sát cánh cùng Lupical, dù phải đối mặt với kẻ địch nào, đứa trẻ đó cũng sẽ chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590316
					],
					"speakerTitle": "Đàn Sói"
				},
				{
					"id": 761590316,
					"content": "...Lupical của cậu ấy nhất định cũng nghĩ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590317,
					"content": "Được rồi! Nơi này cũng đã kiểm tra xong. Mệt chết đi được, đi thôi, về uống một tách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590318
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590318,
					"content": "Woa! Cánh cửa này xuất hiện từ lúc nào vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590319,
						761590320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590319,
					"content": "Sao trên đó còn có cả hình dán vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590321,
					"content": "Hình dán này trông giống như do Alice viết vậy, trên đó còn có chữ... Để tôi xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590322,
					"content": "\"Hướng dẫn bài tập vất vả rồi, mau về nhà uống một tách trà nóng đi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590323
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590323,
					"content": "\"Tái bút: Có bất ngờ bên trong!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590324,
					"content": "Về nhà? Khoan đã, hèn chi thấy cửa này quen thế, đằng sau này chẳng lẽ dẫn đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590325,
					"content": "Nicole đẩy cửa ra, dẫn các bạn sải bước vào trong. Ngay sau đó, các bạn phát hiện mình đang ở trong một căn nhà...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590320,
					"content": "Phong cách này sao trông quen thế nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590312,
					"content": "Tôi và Razor từng chiến đấu ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590306,
					"content": "Người phải làm bài tập ở đây, chẳng lẽ là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				}
			]
		},
		{
