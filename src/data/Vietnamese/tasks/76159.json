			"dialogs": [
				{
					"id": 761590101,
					"content": "Đi luôn rồi sao? Này, Barbie! Có phải còn rất nhiều thứ chưa giao cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590102,
					"content": "...Tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590103,
					"content": "Có vẻ chúng tôi đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "Không đâu, thời gian mọi người tới cũng khá phù hợp với \"lời tiên tri\" mà Barbie đã đưa ra cho tôi... Tôi còn tưởng sẽ muộn hơn nữa cơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590106,
					"content": "Nhưng mà, trước khi nói chuyện chính, mọi người có muốn... ăn gì đó trước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590107,
					"content": "Đ-Đây là lời tiên tri của quý cô Barbeloth sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "Không phải đâu. Chỉ là thính giác của tôi khá tốt, nghe thấy bụng của Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590110,
					"content": "(Ọc ọc ọc...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590111,
					"content": "#Ối! Bụng... bụng tôi kêu thay cho {NICKNAME} đấy, bụng của chúng tôi đều đang rất đói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590112,
					"content": "Ai ngờ sườn nướng bán hết mất rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "Yên tâm đi, ma nữ sẽ không để khách từ xa tới phải đói bụng đâu. Nào, bánh quy và bánh ngọt đã chuẩn bị xong cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590115,
					"content": "Bạn và Paimon vui vẻ ăn bánh, cũng uống rất nhiều trà, nhưng lạ thay, dù các bạn ăn uống thế nào thì ấm trà vẫn luôn còn một nửa, trong đĩa luôn có một miếng bánh quy và bánh ngọt mới...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "Tôi... tôi không ăn được nữa, sao ăn mãi mà không hết vậy, hức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590117,
					"content": "Đây chính là... Tiệc trà của ma nữ sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "Đúng vậy. Tiệc trà mà, trên bàn chắc chắn phải có đầy đủ bánh ngọt và trà rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590119,
					"content": "Đương nhiên, ăn quá nhiều không có lợi cho việc thể hiện khí chất tao nhã của ma nữ, trong đa số trường hợp, ấm trà chỉ có một nửa, trong đĩa chỉ có một miếng bánh quy hoặc một miếng bánh ngọt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590123,
					"content": "Tôi không ăn nữa đâu, thật sự no rồi... Chúng ta nói chuyện chính đi. Ợ... Ối, xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590124,
					"content": "Ừm, lần này hai người đến là để truyền đạt \"bài tập\" mà Barbie đã tiên đoán cho tôi, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590125,
					"content": "Vậy chẳng phải cô đã biết rồi sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "Không có, ban nãy tôi và Barbie đang nói về một chuyện khác. Cô ấy nói vì mặt trăng có sự biến động lớn, khiến Thủy Chiêm Thuật của cô ấy xuất hiện sai lệch, buộc phải trở về tĩnh tâm tu luyện một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590128,
					"content": "Trong thời gian cô ấy tĩnh tâm tu luyện, tôi sẽ thay cô ấy trông coi bài tập của mọi người, tiện thể giúp cô ấy ghi những bài tập mới vào từ điển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590129,
					"content": "Hả? Chuyện này còn có thể tạm thời đổi người phụ trách sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590130,
					"content": "Không hổ là Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "Tôi chẳng muốn làm chút nào! Nhưng trước khi Barbie và Alice nói cho tôi biết về chuyện này, đã ghi phần bài tập đặc biệt của tôi vào trong từ điển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590133,
					"content": "Mặc dù tôi rất muốn xóa bỏ nó rồi tiếp tục nhàn nhã quan sát thế giới... nhưng Alice còn phải đi bảo vệ biên giới của Teyvat, Barbie thì phải tĩnh tâm tu luyện Thủy Chiêm Thuật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590134,
					"content": "Octavia thì chẳng thấy về, chứ đừng nói đến Rhinedottir... Các ma nữ đều có công việc riêng của mình, nên tạm thời chỉ có thể do tôi phụ trách giám sát bài tập thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590135,
					"content": "Hoá ra Hội Ma Nữ bận rộn đến vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "Đúng vậy, tôi không biết đã bao lâu rồi chưa tổ chức một buổi tiệc trà tử tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590138,
					"content": "Nhưng nói chung, chỉ cần tôi hoàn thành phần bài tập đặc biệt đó, câu chuyện của tôi cũng sẽ chính thức được ghi vào từ điển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590139,
					"content": "#Sau đó, tôi mới có thể thực sự quan sát và chỉ dẫn mọi người... Cho nên, {NICKNAME}, Paimon, hãy cho tôi biết bài tập đó là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590140,
					"content": "À đúng rồi, vì đây không được coi là lời tiên tri, chỉ đơn thuần là câu chuyện do Barbie và Alice bịa ra mười phút trước, nên hai người chắc sẽ không tìm thấy thông tin hữu ích gì trong cuốn từ điển đó đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590141,
					"content": "Đúng vậy, những gì chúng tôi nhìn thấy trong cuốn từ điển đó, thực sự không phải bài tập phức tạp gì. Nói chính xác thì chỉ có hai câu thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590142,
					"content": "\"Nicole sẽ thực hiện trách nhiệm của mình.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "Được rồi. Câu trước chắc là do Barbie viết, nhưng câu sau nhất định do Alice thêm vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590146,
					"content": "Vậy chúng ta bắt đầu thực hiện bài tập lần này đi, để tôi nghĩ xem, đi đâu trước nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590147,
					"content": "Đợi đã, cô đã hiểu rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "Vừa rồi Barbie đã tiện thể nói cho tôi biết những việc cần làm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590150,
					"content": "...Cái gọi là \"thực hiện trách nhiệm\" này tức là tôi phải đến các địa điểm của bài tập để xem tình hình và tiến hành \"khảo sát thực địa\" là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590151,
					"content": "Đợi đã! Như vậy cũng được sao, hoàn toàn không có cảm giác \"tiên tri\" nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590152,
					"content": "Có mà, những gì Barbeloth nói với tôi tất nhiên cũng tương đương với \"lời tiên tri\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590153,
					"content": "Bài tập này của tôi do Barbie viết, cô ấy chỉ là lật trước đến trang cuối cùng của câu chuyện, rồi nói cho tôi biết cái kết mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590154,
					"content": "Nghe vào rõ ràng là đang tiết lộ kết cục mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "Chà, tiên tri hay tiết lộ vốn chẳng khác gì nhau cả, đi thôi, theo tôi nào, chúng ta đến... ừm, đến đây trước chắc cũng không sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590159,
					"content": "Hả? Đi ngay bây giờ à? Đợi đã, vậy chúng ta phải đi bằng cách nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590160,
					"content": "Chỉ trong chớp mắt, mọi người đã đến bên một vách núi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "Vậy chẳng phải tôi uổng công chạy một chuyến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "#Không uổng công đâu! Bài tập phải do {F#cô}{M#cậu} truyền đạt, loại \"hình thức\" này rất quan trọng, nếu thiếu khâu này thì có khi bài tập cũng không còn hiệu lực nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590158,
					"content": "Thôi không nói nữa, đi thôi, theo tôi nào, chúng ta đến... ừm, đến đây trước chắc cũng không sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590148,
					"content": "Tôi còn chưa hiểu hết câu này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "\"Chắc chắn sẽ không để ai phải làm việc không công đâu!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "Trong đó viết như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "Tính ra thì cũng khá nhiều người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "Ngay cả việc này cũng có thể làm được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "Lẽ nào lúc nãy quý cô Barbeloth cũng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "Lần sau nhất định phải đưa Varesa đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "Là cô gái ăn rất khỏe ở Cộng Đồng Trù Phú Natlan đó à? Alice cũng từng nhắc đến cô ấy với tôi, là một cô gái rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590122,
					"content": "Nếu cô ấy đến chơi thì phải bày ba... à không, bảy cái đĩa trước mặt cô ấy mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590113,
					"content": "Dù sao cũng không thể ăn mỗi salad được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "Không ngờ còn có thể tiên tri cả chuyện này nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "Không đúng lúc lắm nhỉ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
