			"dialogs": [
				{
					"id": 760550101,
					"content": "(<color=#FFCC33FF>Lauma</color> dường như đã nghe thấy điều gì đó...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "...Lạ thật. Vừa rồi tôi có nghe thấy tiếng động gì đó mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550103,
					"content": "(Lại có khách rồi! Xoay vòng quay, dừng vòng quay là có đồ ăn ngon!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550104,
					"content": "(Ủa? Sao quý khách không quay đi. Nhanh lên nào, muốn ăn món ngon!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550105,
					"content": "Nghe như là một chú chó con nhỉ...? Xoay vòng quay, có đồ ăn ngon... Thế là có ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550106,
					"content": "(Quý khách! Có thể nói chuyện với tôi. Quý khách, mau xoay vòng quay đi nào, nếu không tôi không được ăn đồ ngon mất.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550107,
					"content": "Đói rồi sao? Nào, chị có đem theo một ít bánh quy đây, ăn trước đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550108,
					"content": "(Hmm? Quý khách không xoay vòng quay, quý khách muốn cho tôi ăn... Ừm, ăn trước, ăn trước.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550109,
					"content": "(Cảm ơn quý khách, tôi là Pavlov. Cảm ơn bánh quy của quý khách, ngon quá đi. Nhưng mà vẫn chưa xoay vòng quay đó.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550110,
					"content": "Không cần khách sáo đâu. Nhưng mà... vòng quay vừa nói tới là sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550111,
					"content": "(Vòng đã quay rồi, dừng nó lại, đồ ăn ngon sẽ rơi ra, lần nào cũng thế.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550112,
					"content": "(Quý khách thật sự không quay à? Ai quay xong cũng đều rất vui vẻ đó.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550113,
					"content": "Chị thì không cần đâu. Xem ra... nhóc sống ở đây cũng được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550114,
					"content": "(Đúng đó! Có người chơi cùng, có vòng quay chơi cùng, còn có đồ ăn ngon nữa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550115,
					"content": "Vậy thì tốt rồi. Chị đi trước đây, thay chị gửi lời hỏi thăm đến chủ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550116,
					"content": "(Ồ... Tạm biệt quý khách, lần sau gặp lại nhé.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
			]
		},
