					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550313,
					"content": "Vậy sau khi xoay vòng quay, Pavlov có vui không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550314,
					"content": "(Vui chứ, rất là vui luôn, có người chơi cùng, có vòng quay chơi cùng, còn có đồ ăn ngon nữa... Quan trọng nhất là đồ ăn ngon!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550315
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550315,
					"content": "Ừm... Vậy hãy ăn thử số điểm tâm này nhé. Đồ ngon đúng là rất quan trọng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550316,
					"content": "Tôi còn phải đi mua thêm đồ ăn ngon nữa. Tạm biệt nhé, Pavlov.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760550317,
					"content": "(Ừm... Ngon quá ngon quá, tạm biệt quý khách, lần sau gặp lại nhé.)",
