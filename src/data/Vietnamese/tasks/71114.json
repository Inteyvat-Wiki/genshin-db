			"dialogs": [
				{
					"id": 711140901,
					"content": "Haiz, vẫn nên quay phong cảnh bên trong Làng Kiều Anh trước vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140902,
					"content": "Mọi thứ vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#{NICKNAME}, Paimon. Nhờ các vị mà chúng tôi đã không mất thiết bị nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140905,
					"content": "Nhưng mà, lần sau nếu chúng tôi qua bên đó quay phim thì phải thuê một vài nhà mạo hiểm đi cùng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140906,
					"content": "Thế bộ phim về trà đã quay đến đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "À... Bộ phim này đang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140908,
					"content": "Có một mở đầu tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "Đang rất tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "Thế là mới bắt đầu quay còn gì?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "Ừm, tài chính hiện tại của bọn tôi... có hơi eo hẹp. Ngài Geisert thu phí cũng cao như kiến thức của ngài ấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140912,
					"content": "Mặc dù chúng tôi đã quay vài bộ phim ngắn để kiếm lời, nhưng bộ phim ký sự lớn kiểu này đúng là rất tốn tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140913,
					"content": "Nhất là cô chủ còn từ chối vài vị thương nhân đến đây tài trợ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "Và từ chối cả đống lời mời hợp tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "Mấy người thì biết cái gì! Đó là để chúng ta có thể quay hoàn toàn dựa theo mắt thẩm mỹ của chúng ta đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140916,
					"content": "Nhưng cô chủ à, mục đích ban đầu của chúng ta khi quay phim chẳng phải là vì kiếm tiền sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "Tôi... Đừng quan tâm nhiều như vậy! Mau đi chuẩn bị thiết bị trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, chỗ thù lao này là của hai vị. Cảm ơn vì đã giúp tôi nhiều lần như thế nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140919,
					"content": "Đợi tôi quay phim xong, chắc chắn sẽ mời hai vị đến xem, sau đó mời hai vị một bữa trà ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng, Xingye, tìm hướng sáng đi! Lần này chúng ta phải quay một lần cho xong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140921,
					"content": "Cô chủ, chuyện này không dễ đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "Quay phim một lần có thông qua được hay không thì đều nhờ vào định mệnh cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "Nói... nói chung cứ dựng thiết bị lên đã! Cứ... cứ đợi ở đây trước nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140903,
					"content": "Xem ra mọi người không bị mất thiết bị nào nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
