			"dialogs": [
				{
					"id": 711149940,
					"content": "Sau khi đuổi Đạo Bảo Đoàn đi, mọi người dẫn nạn nhân đến ngôi đình bên cạnh...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 711140801,
					"content": "Cảm ơn, rất cảm ơn các vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140802
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140802,
					"content": "Cô là... Cô chủ Qiu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140803
					]
				},
				{
					"id": 711140803,
					"content": "#Vị này là {NICKNAME} sao! Gặp được các vị ở đây, đúng là... Tôi lại nợ các vị một ân tình rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140804
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140804,
					"content": "Mọi người chẳng phải đang học quay phim ở Fontaine sao? Sao lại quay về Liyue rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140805,
					"content": "Học xong rồi ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140806
					]
				},
				{
					"id": 711140806,
					"content": "Thay vì nói là học xong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140807
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140807,
					"content": "Có lẽ nên nói là phải kiếm tiền trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140808
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140808,
					"content": "Này, hai người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140809
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140809,
					"content": "Ngài Geisert đúng là vô cùng chuyên nghiệp, chỉ dẫn của ngài ấy cho chúng tôi cũng vô cùng hữu dụng, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140810
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140810,
					"content": "Những bộ phim mà ngài ấy chỉ dẫn chúng tôi quay đều quá tập trung thể hiện ý nghĩa và khái niệm, còn về những sự vật và tình tiết cụ thể thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140811
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140811,
					"content": "Theo như lời của ngài Geisert thì là \"cho lùi về hậu trường\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140812
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140812,
					"content": "Nhưng chúng tôi muốn quay một bộ phim dùng để quảng cáo cho lá trà của Làng Kiều Anh. Nếu cứ học kiểu này thì căn bản là hoàn toàn trái ngược, thế nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140813
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140813,
					"content": "Thế nên tôi đã quyết định tạm dừng học tập, trước tiên phải quay một bộ phim ký sự, dùng thực hành để kiểm tra thành quả học tập đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140814
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140814,
					"content": "...Cũng có một phần nguyên nhân là tài chính của chúng tôi sắp dùng hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140815
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140815,
					"content": "Cơ mà, tôi đã lên kế hoạch cho mọi việc cả rồi. Chỉ cần chúng tôi quay tốt bộ phim này thì vấn đề tài chính sẽ ổn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140816
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140816,
					"content": "#Sau đó, chúng tôi bị Đạo Bảo Đoàn vây ở hai bên cầu treo, may mà có {NICKNAME} cứu giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140817,
						711140818
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140817,
					"content": "Nơi này... Cách Làng Kiều Anh hơi xa thì phải?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140818,
					"content": "Mọi người quay Làng Kiều Anh thì đến đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140819,
					"content": "Haiz, cũng là do tôi muốn quay một ít phong cảnh hùng vĩ, để bộ phim hoành tráng hơn thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140820
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140820,
					"content": "Ai ngờ đang quay thì bị Đạo Bảo Đoàn rình rập. Chúng tôi chạy thẳng tới đây, nhưng cuối cùng vẫn bị chặn lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140821
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140821,
					"content": "Khoan đã, chẳng lẽ những thợ chụp ảnh chuyên nghiệp mà Woliu nhắc đến trước đó là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140822,
					"content": "Đúng vậy, là nhóm của cô chủ Qiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140823
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140823,
					"content": "Tiểu thư Woliu, sao cô lại xuất hiện thế? Ban nãy tôi có thấy cô đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140824
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140824,
					"content": "Là do tôi trốn khá tốt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140825
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140825,
					"content": "Hóa ra mọi người đều biết nhau sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140826
					]
				},
				{
					"id": 711140826,
					"content": "Tiểu thư Woliu là nhà thủy văn học chuyên nghiệp đó. Cô ấy nắm rõ địa hình quanh đây trong lòng bàn tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140827
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140827,
					"content": "Đối với vấn đề chọn phong cảnh, chúng tôi cũng có hỏi cô ấy rất nhiều lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140828
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140828,
					"content": "Chúng tôi cũng muốn mời tiểu thư Woliu gia nhập đoàn làm phim nữa! Nhưng cô ấy nói là phải đợi đến lúc rảnh mới xem xét được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140829
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140829,
					"content": "Cô chủ... Ban nãy trong lúc chạy, hình như chúng ta đã bỏ lại cái rương chứa ảnh chụp và thiết bị ở chỗ cũ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140830
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140830,
					"content": "Trong đó... hình như còn có một vài phần phim mà chúng ta đã quay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140831
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140832
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140832,
					"content": "#Tiểu thư Woliu! {NICKNAME}, Paimon, cảm ơn các vị rất nhiều! Khi... khi nào rảnh thì cứ đến Làng Kiều Anh tìm tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140833
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140833,
					"content": "Dù thế nào đi nữa... Ơn cứu mạng này, ít nhất tôi cũng phải trả thù lao cho các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140834
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140834,
					"content": "Chúng tôi đi trước đây! Nhanh nào! Cái rương đó để ở đâu! Đi nhanh thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140835
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 711140835,
					"content": "Nhóm của cô chủ Qiu vội vã rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711140836
					]
				},
				{
					"id": 711140836,
					"content": "Tính ra... Chiếc rương của cô chủ Qiu gặp nhiều tai họa nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140837,
					"content": "Tục ngữ có câu \"vạn sự khởi đầu nan\". Cô chủ Qiu chắc chắn sẽ quay được một bộ phim hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140838
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140838,
					"content": "Được rồi, tôi trả công cho các bạn trước nhé. Đợi chút nữa tôi đi bố trí bộ dụng cụ cuối cùng, sau đó... Tôi cũng sẽ tìm thời gian đến tâm sự với cô chủ Qiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140839
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140839,
					"content": "Nếu không thì không biết họ lại đi đâu để quay phim nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140840
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140840,
					"content": "Hmm, ban nãy họ có nói là đến Làng Kiều Anh tìm họ nhỉ... Đợi chút nữa tôi qua đó tìm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
