				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "...Điều chỉnh thế này chắc là ổn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140402,
					"content": "Nhà Lữ Hành đã bố trí thiết bị xong rồi hả? Cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140403,
					"content": "Đợi tôi bố trí xong bộ thiết bị này, sẽ trả công cho hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140404,
					"content": "Lúc nãy cứ để tôi bố trí một thể có phải nhanh không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "#Cảm ơn ý tốt của {F#cô}{M#cậu}. Nhưng mà bộ thiết bị này có chút đặc thù, có nhiều chỗ phải điều chỉnh, nếu để {F#cô}{M#cậu} vận hành thay luôn thì phiền cho {F#cô}{M#cậu} quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140406,
					"content": "Trước tiên chúng ta lên vách núi bên kia bố trí cho xong thiết bị này đã, sau đó tôi có thể trả công cho hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140407,
					"content": "Nghe qua phức tạp thật đấy... Cô vẫn luôn làm việc thế này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140408,
					"content": "Hiện tại tôi chỉ cần bố trí thiết bị ở mặt đất thôi... Có một lần khảo sát, tôi còn phải nghĩ cách đưa thiết bị xuống giữa dòng sông cơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140409,
					"content": "Không thể đi thuyền ra đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "Haiz, nếu chỉ cần thả thiết bị vào trong nước sông, đúng là tôi có thể đi thuyền qua đó thả nó xuống nước, rồi rời đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140411,
					"content": "Nhưng lần khảo sát đó tôi muốn đo cường độ dòng nước, thế nên cần cố định thiết bị đặc biệt đó ở trung tâm dòng nước, không được nổi lên cũng không được chìm xuống đáy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140412,
					"content": "Cũng may trên sông có một chiếc cầu treo, nếu không tôi chỉ còn cách nhờ người giăng một sợi dây giữa hai ngọn núi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140413,
					"content": "Rồi dùng dây thừng treo thiết bị đó lên, dùng một sợi dây khác kéo, đưa thẳng đến trung tâm dòng sông rồi hạ xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140414,
					"content": "Khụ... Không nói mấy chuyện này nữa, giờ không phải lúc quan tâm loại chuyện này... Tuy rằng chút nữa chúng ta cũng cần đi qua một cây cầu treo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140415,
					"content": "Đi bên này nhé, cây cầu treo đó cách chúng ta không xa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
