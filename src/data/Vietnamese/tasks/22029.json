			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "Phù...võ nghệ của các hạ đúng là cao cường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "Tại hạ...tại hạ xin lĩnh giáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "Bạn không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Không...không sao, chỉ là thở dốc một chút thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "Nhưng bạn mạnh như vậy, bạn nói bạn đã đánh bại con rồng tôi cũng sẽ tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "Thực ra tôi có đánh bại con rồng thiệt mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Ha ha ha...Tại hạ tin rồi. Cảm ơn đã luyện tập cùng tôi, tôi sẽ luôn ghi nhớ trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "Nếu các hạ đồng ý thì có thể thường xuyên đến đây để tập luyện với tôi, có một người mạnh mẽ như bạn luyện tập chung...tôi nhất định sẽ hoàn thành chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "Chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "Khụ...chỉ là một tâm nguyện nhỏ của tôi thôi. Cảm ơn bạn, đây là thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Tôi phải về nghỉ ngơi chút...ban nãy bạn ra đòn đúng là mạnh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "Xin lỗi, ban nãy hơi quá tay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
