				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "Mình nhất định! Nhất định phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290102,
					"content": "Ấy? Bạn là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290103,
					"content": "Tôi nhận được ủy thác của bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "À, bạn nói đến ủy thác tập luyện đúng không. Đúng là tôi đang cần tìm một người để luyện võ chung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290105,
					"content": "Bạn đã nhận ủy thác của tôi sao? Nhưng hình như tôi chưa từng gặp bạn trong thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290106,
					"content": "Xin lỗi, không phải tôi chất vấn thực lực của bạn. Nhưng tôi thực sự không biết võ nghệ của bạn như thế nào thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290107,
					"content": "Tôi từng đánh bại con rồng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "Ha ha...Thật ư? Tôi thấy tò mò là bạn tìm con rồng đó ở đâu đó, trước giờ tôi chỉ nghe nói qua mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290112,
					"content": "Tôi chiến đấu rất giỏi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "Ha ha, dù sao thì chuyện võ nghệ không thể nói bằng mồm được, chúng ta cứ thử so tài với nhau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290114,
					"content": "Đúng ý tôi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "Khoan đã, sao bạn lại gửi ủy thác nặc danh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "Chuyện, chuyện này xuất phát từ một nguyên nhân hơi khó nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290117,
					"content": "Haiz, nhưng nếu bạn đã nhận ủy thác của tôi thì tôi nói cho bạn nghe vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290118,
					"content": "Dạo trước tôi cùng vài anh lính tuần tra đi chấp hành nhiệm vụ. Trên đường về thì phát hiện một nhóm Kairagi đang tập kích thương đội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290119,
					"content": "Tôi và mấy người lính tuần tra lập tức đi ứng cứu. Mới đầu thì chúng tôi chiếm được thế thượng phong, đẩy lùi được chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290120,
					"content": "Thế nhưng, trong lúc chúng tôi sơ ý, lại có một nhóm Kairagi khác đột kích bên hông, trong đó còn có một tên trông như thủ lĩnh nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290121,
					"content": "Chúng tôi phản ứng không kịp nên bị chúng đánh cho tan tác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290122,
					"content": "Mất cơ hội thắng, chúng tôi vừa phải chống đỡ đợt tấn công của đám Kairagi, vừa phải cố gắng hộ tống thương đội quay về thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290123,
					"content": "Trong lúc tôi giao chiến với tên thủ lĩnh đó, tôi còn bị tước đi vũ khí của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290124,
					"content": "Hắn còn giơ cao thanh vũ khí của tôi rồi cười lớn, đây đúng là một sự sỉ nhục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290125,
					"content": "Vậy những thương nhân đó có sao không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "Khi chúng tôi gần về đến thành thì bắt gặp một nhóm lính tuần tra khác. Đám Kairagi thấy chúng tôi có chi viện nên rút lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290127,
					"content": "Các thương nhân đã được hộ tống về thành an toàn, nhưng còn hàng hóa của họ thì...Haiz, cũng trách tôi võ nghệ chưa cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290128,
					"content": "Sau khi trở về, tôi được cấp lại vũ khí mới, nhưng tôi vẫn nuốt không trôi sự sỉ nhục đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290129,
					"content": "Cho nên tôi mới treo ủy thác để rèn luyện võ nghệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290130,
					"content": "Đợi đến khi tôi có đủ bản lĩnh, tôi nhất định sẽ đi đánh bại tên Kairagi đó, lấy lại vũ khí của mình, rửa sạch nỗi nhục này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290109,
					"content": "Tôi từng chứng kiến vị thần qua đời.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "Ể, xem bạn nói kìa, chắc chắn là bạn đã tham gia Điển Lễ Thỉnh Tiên ở Liyue đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290111,
					"content": "Ha ha, nếu như vậy thì rất nhiều người ở Liyue đều đã chứng kiến vị thần qua đời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				}
			]
		},
