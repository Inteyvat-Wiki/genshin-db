					"content": "Ban nãy bạn nương tay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290202,
					"content": "Không cần phải nể mặt tôi, bạn cứ dốc toàn bộ sức lực, tôi...cần phải mạnh mẽ hơn.",
					"roleType": "TALK_ROLE_NPC",
