			"dialogs": [
				{
					"id": 220130401,
					"content": "Xin chào, có chuyện gì cần tìm tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130402,
					"content": "Cho hỏi bạn có đọc qua bộ \"Quỷ Võ Đạo\" chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "Tôi có xem qua, đây là bộ tiểu thuyết rất thú vị, dù là nhân vật hay tình tiết đi nữa đều được xây dựng rất tinh tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130404,
					"content": "Nhưng dạo gần đây...có cảm giác tác giả đang lười biếng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130405,
					"content": "Hừm...hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130406,
					"content": "Có nhiều lần tác giả bẻ lái và thêm tình tiết đột ngột quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130407,
					"content": "Tuy nói là \"thức tỉnh\", nhưng mà thực sự khiên cưỡng quá, không đọng lại giá trị gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130408,
					"content": "Tôi cảm thấy những tình tiết rẻ tiền này đã khiến cho nhân vật trở nên phèn hơn rồi, hy vọng là tác giả có thể suy nghĩ thấu đáo hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130409,
					"content": "...Nhà lữ hành, chúng ta đi hỏi người tiếp theo đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
