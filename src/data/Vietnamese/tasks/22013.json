					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130608,
					"content": "Đó chính là những kinh nghiệm đúc kết được sau nhiều năm làm việc của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Shigeru"
				},
				{
