					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "Vài chương gần đây không phải nhân vật chính đã thức tỉnh rất nhiều kỹ năng mới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130507,
					"content": "Trong đó tác giả còn dành hẳn vài trang để giới thiệu kỹ năng thức tỉnh và công dụng của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130508,
					"content": "Vả lại tên của kỹ năng lại càng ngày càng khó đọc, mỗi lần như vậy tôi đều phải ráng nhớ hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130509,
					"content": "Nhưng mà nếu bỏ qua những đoạn này thì những năng lực khó hiểu đó lại khiến tôi không thể hiểu tiếp được kịch bản tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130510
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130510,
					"content": "Haiz, cho nên tôi đã tạm ngưng đọc quyển tiểu thuyết đó rồi, đổi sang quyển khác đơn giản hơn để đọc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130511
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130511,
					"content": "Tôi...tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130512
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130512,
					"content": "Chúng ta quay về thôi...",
