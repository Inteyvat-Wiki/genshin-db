			"dialogs": [
				{
					"id": 220130301,
					"content": "Xin chào, có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Cho hỏi bạn có đọc qua bộ \"Quỷ Võ Đạo\" chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "À, tôi có xem qua, ban đầu cũng thích lắm, nhưng mà...nói sao nhỉ, gần đây kịch bản cứ lạ lạ sao sao ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "Cho dù nhân vật chính đối mặt với kẻ địch nào thì cũng đột nhiên thức tỉnh ra năng lực khắc chế kẻ địch, rồi sau đó một đấm là giải quyết mọi vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "Lúc đầu tôi thích \"Quỷ Võ Đạo\" là do cách đánh bại kẻ địch của nhân vật chính rất tinh tế, còn bây giờ thì tôi có cảm giác...tác giả lười lười thế nào ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "Vả lại nhân vật chính thức tỉnh nhiều năng lực đến vậy nhưng quá nửa đều chỉ dùng một lần, nên có vẻ không thuyết phục cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "Không biết tác giả của bộ tiểu thuyết này đang có kế hoạch gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "Khụ khụ...à ừm, chúng ta đi hỏi thêm vài người nhé, đây có vẻ như là trường hợp ngoại lệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
