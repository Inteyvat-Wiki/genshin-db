			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "Anh đã đọc phản hồi của độc giả chưa, lượt đánh giá dạo này càng ngày càng đi xuống đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130102,
					"content": "Anh lo cái gì, chỉ là khoảng lặng trước cơn bão thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130103,
					"content": "Đợi tôi viết đến đoạn cao trào thì lượt đánh giá sẽ đổi chiều ngay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130104,
					"content": "Vậy trước khi có ngày đó thì bộ tiểu thuyết của anh cũng đã chết yểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130105,
					"content": "Có chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "Nhà lữ hành, bạn đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130107,
					"content": "Lần trước sau khi nảy sinh ra ý tưởng, tên Junkichi này đã liên tục gán thêm mấy năng lực bá đạo cho nhân vật chính của bộ \"Quỷ Võ Đạo\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130108,
					"content": "\"Nhà Xuất Bản Yae\" đã nhận được rất nhiều phản hồi tiêu cực, độc giả nói hoàn toàn không thể hiểu được những năng lực đó từ đâu mà có, nói rằng tác giả đã bí ý tưởng nên nghĩ gì viết đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130109,
					"content": "Đó chỉ là những nhận xét phiến diện mà thôi, chỉ cần tôi viết tiếp thì họ sẽ hiểu ra thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130110,
					"content": "Vậy trước khi độc giả hiểu được thì bộ tiểu thuyết của anh cũng chết yểu trước rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130111,
					"content": "Đủ rồi...tôi nhớ ở xung quanh đây cũng có nhiều độc giả của bộ \"Quỷ Võ Đạo\" lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130112,
					"content": "Nếu anh cảm thấy độc giả thích suy nghĩ của anh thì anh cứ trực tiếp đi hỏi họ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130113,
					"content": "Đi thì đi! Họ nhất định sẽ hiểu cho tôi, nhà lữ hành, bạn đi chung để làm chứng cho tôi được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130114,
					"content": "Vậy cũng tốt, có nhà lữ hành đi chung để tránh việc anh thua mà không nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130115,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "Được, vậy giờ tôi sẽ đi, tôi vẫn tin là độc giả sẽ hiểu cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130117,
					"content": "Vậy rốt cuộc bạn đã thêm bao nhiêu tình tiết mới vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Thì...chút đỉnh thôi, chút đỉnh thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130119,
					"content": "Chút đỉnh á? Anh mà thêm nữa thì nhân vật của anh còn bá đạo hơn tất cả nhân vật của các tiểu thuyết khác cộng lại đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130120,
					"content": "Khụ khụ! Chúng ta mau xuất phát thôi, tôi vẫn cứ tin là độc giả sẽ hiểu cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
