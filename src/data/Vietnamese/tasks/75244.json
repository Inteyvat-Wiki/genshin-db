			"dialogs": [
				{
					"id": 752440402,
					"content": "Còn để ý đến bọn cướp đó sao? Đừng lo lắng quá, lỡ như thật sự gặp phải chúng thì cứ báo tên tôi, sẽ không sao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440403
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440403,
					"content": "#Chúng ta xem như có duyên, {F#cô}{M#cậu} lại còn giúp tôi nhặt lại chiếc mũ nữa, nên cứ coi như là lời cảm ơn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
