			"dialogs": [
				{
					"id": 752440101,
					"content": "#Ồ, {F#cô}{M#cậu} cũng đến câu cá à? Phải đội mũ đủ chắc mới được đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440106,
					"content": "Tại sao phải đội mũ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "Đội mũ mới an toàn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440107,
					"content": "Nhưng anh cũng đâu có đội mũ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "#Đây là lý do tôi bắt chuyện với {F#cô}{M#cậu} đây... Thật ngại quá, mũ của tôi bị gió thổi bay mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440104,
					"content": "Nếu được thì có thể tìm giúp tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440108,
					"content": "Tại sao không tự mình đi tìm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "Nếu tôi đi tìm mũ thì phải đặt cần câu xuống, còn nếu cầm cần câu thì không thể tìm mũ được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440109,
					"content": "#Đi mà, nhờ {F#cô}{M#cậu} giúp tôi lần này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rantiy"
				}
			]
		},
