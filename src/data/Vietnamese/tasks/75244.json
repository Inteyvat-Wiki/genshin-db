			"dialogs": [
				{
					"id": 752440302,
					"content": "#Chính nó! Cảm ơn {F#cô}{M#cậu} rất nhiều, có chiếc mũ này thì tôi yên tâm hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440303,
					"content": "Đây là mũ bảo hộ đặc biệt mà tôi đặt làm, đỡ được cả đạn của súng hỏa mai đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440307,
					"content": "Anh nghĩ nhiều rồi, chỉ là câu cá thôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "#{F#Cô}{M#Cậu} không biết đâu, trước đây có một người đang câu cá thì bị người khác dùng cung hay súng bắn mù một mắt, thật là nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440305,
					"content": "Nghe nói đó là một nhóm cướp đến từ Nod-Krai đang tranh chấp nội bộ... Nhưng đâu biết trước được? Nếu đã có tiền lệ vậy rồi, vẫn nên cẩn thận thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Rantiy"
				}
			]
		},
