			"dialogs": [
				{
					"id": 761230101,
					"content": "Thơm quá! Lại đúng giờ ăn của Columbina sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Các Kuuhenki... đang xếp hàng, người đang múc súp là Columbina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Chờ chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "Woa, ngon quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Súp trái cây thơm ngọt và thanh mát này, là hương vị mà tôi chưa từng được nếm thử ở nơi nào khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "Thêm một bát nữa nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230108,
					"content": "Hai bát đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "Columbina dạo này đang học nấu nướng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Ừm, tôi đã xin Ineffa vài công thức nấu ăn cơ bản, cũng đã thử làm vài lần rồi. Kuuhenki và các động vật nhỏ đều khen ngon đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230112,
					"content": "Có gặp khó khăn gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Ừm, tay áo rộng quá, không cẩn thận là sẽ quệt vào cạnh nồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230114,
					"content": "(Thì ra không phải do nấu nướng khó.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "Nhưng mà khi làm điểm tâm thì tôi hơi lúng túng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230116,
					"content": "Chúng yêu cầu rất khắt khe về nhiệt độ và tỉ lệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230117,
					"content": "(Xem ra trước đây cô ấy rất ít khi tự nấu ăn.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(Và nếu tự mày mò làm điểm tâm thì đúng là không dễ chút nào...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Có cần tôi giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Được đó. Bắt đầu với Krumkake trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230121,
					"content": "Sau một thời gian...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Nếm thử xem nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230123,
					"content": "(Cắn một miếng nhỏ.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230126,
					"content": "(Miếng đầu tiên chua quá, cảm giác mặt mình nhăn nhúm hết cả...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Nhưng nuốt xuống thì lại xuất hiện vị ngọt... Có lẽ quen rồi sẽ đỡ hơn...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "Thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230129,
					"content": "Đạt yêu cầu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Tôi bỏ lỡ gì rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Paimon, lại đây nếm thử đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "Gaaaah, chua quá đi, hai người bắt nạt tôi đấy à!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230136,
					"content": "Dư vị cũng không tệ đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "Quan trọng là lúc đầu kìa! Chẳng ai nhắc tôi phải cắn miếng bé cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "#Không nói gì làm tôi cứ tưởng {NICKNAME} muốn chơi khăm, xem phản ứng của người ta ăn vào sẽ có phản ứng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "Được rồi, để tôi thử lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230140,
					"content": "Lại qua một lúc nữa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Đây, thử lần này xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230142,
					"content": "(Woa...! Lần này ngon hơn nhiều rồi!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "Lần này ngon thật đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Thật sao? Tôi cũng muốn, tôi cũng muốn! Ưm...! Cái này ngon, cái này ngon này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "Có thể đem tặng được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230147,
					"content": "Được chứ! Ồ, Columbina học nấu nướng, làm Krumkake, là muốn chuẩn bị quà cho ai sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Ừm... Tôi muốn tặng cho bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230149,
					"content": "Ý tưởng hay đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "Còn nhớ lần đầu hai người đến đây không? Hai người đã chuẩn bị cho tôi vài món ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230151,
					"content": "So với sức mạnh đã mất đi thì đồ ăn chẳng bổ sung được mấy, nhưng ăn xong, tâm trạng của tôi thoải mái hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230152,
					"content": "Mặc dù lúc đó không nghĩ kỹ lý do, nhưng giờ thì tôi hiểu ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230153,
					"content": "Tự tay chế biến, dốc hết tâm huyết... Thời gian bỏ ra chính là thứ đã thổi hồn vào món ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230154,
					"content": "Thứ tôi thưởng thức không phải là món ăn, mà là sự ấm áp và tấm lòng từ đôi tay đã làm ra nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230155,
					"content": "Càng không mong cầu đáp trả, nó càng quý giá. Chỉ có sự ấm áp và lòng tốt tương đương mới có thể sánh được với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230156,
					"content": "Chà, nghe mà ngại quá đi. Khi đó bọn tôi cũng muốn lấy lòng cô lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "Nhưng bây giờ mọi thứ đã khác rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "Ừm, nhưng sau khi hiểu được những điều này, tôi cũng muốn bỏ ra nhiều hơn... Cảm thấy rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230160,
					"content": "Có thể cùng tôi đi thăm bạn bè được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230161,
					"content": "Ngoài Krumkake, tôi còn chuẩn bị thêm vài món quà nhỏ nữa. À, nhưng mà, lén tặng thôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230162,
					"content": "Sao phải lén lút vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "Trước đây toàn là mọi người khiến tôi bất ngờ, giờ tôi cũng muốn xem phản ứng của mọi người khi nhận được bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230164,
					"content": "Phù, chạy nhiều nơi quá, cuối cùng cũng tặng xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "Phản ứng của mọi người đều là không ngờ tới. Dù có người dường như không hề nhận ra đây là quà của Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "Aino chỉ mải ăn thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Không sao đâu, tôi đã lường trước chuyện này rồi. Miễn là bạn bè thấy vui khi nhận quà là được, đó mới là điều quan trọng nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230168,
					"content": "Nói vậy thì có vẻ Lauma đã phát hiện ra Krumkake và vòng hoa trên bàn là do Columbina tặng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "Vòng hoa không nỡ đeo thì còn hiểu được, nhưng phần Krumkake đó... cô ấy đã nhìn cả mười phút mà vẫn không nỡ ăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "Sợ là cô ấy sẽ đem nó đi cúng mất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "Nhưng Jahoda có vẻ giật mình... Có phải là không nên lén đặt đồ sau lưng cô ấy không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230172,
					"content": "Thật sự là hết cả hồn đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Có lẽ cô ấy vốn dĩ đã khá cảnh giác rồi. Nhưng sau khi Ashru đến cào chiếc bàn cào móng mà cô tặng thì có vẻ đã bình tĩnh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "Còn những người bạn gần đây không ở Nod-Krai thì nhờ hai người đem tặng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230175,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "Cò Lông Dài"
				},
				{
					"id": 761230176,
					"content": "Columbina rất biết cách chuẩn bị quà đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "Đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230178,
					"content": "Ồ! Cuối cùng cũng đến lượt chúng tôi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230179,
					"content": "Ơ? Kẹo sao? Tôi tưởng sẽ là Krumkake giống mọi người chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230180,
					"content": "Món đó đã nếm thử rồi mà? Thử món khác không phải sẽ thú vị hơn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
						761230182
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230181,
					"content": "Ừm, đúng là rất ngon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "Vậy thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230184
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230184,
					"content": "#Còn có một thứ nữa. Cho {F#cô}{M#cậu} đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230185
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230185,
					"content": "Đây là... Phong Chi Dực sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230186
					]
				},
				{
					"id": 761230186,
					"content": "Nghe nói bầu trời thuộc về loài chim, mặt đất thuộc về thú rừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230187
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230187,
					"content": "Còn khoảng cách mênh mông giữa trời và đất là nơi dành cho những nhà mạo hiểm khoác lên Phong Chi Dực để bay lượn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230188
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230188,
					"content": "#Mong rằng những ngày có nó bên cạnh, con đường phía trước của {F#cô}{M#cậu} sẽ luôn rạng ngời như được ánh trăng chiếu rọi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230189
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230189,
					"content": "Tôi rất thích đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230190
					]
				},
				{
					"id": 761230190,
					"content": "Cảm ơn vì đã ở bên cạnh tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761230182,
					"content": "Ngon hơn cả kẹo ở Đêm Cầu Nguyệt nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230158,
					"content": "Cô muốn ăn gì thì cứ nói nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230144,
					"content": "Cô học nhanh thật đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230130,
					"content": "Nhưng cách nêm nếm vẫn cần cải thiện thêm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230124,
					"content": "(Cắn một miếng lớn.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				}
			]
		}
	]
}