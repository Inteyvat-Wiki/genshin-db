			"dialogs": [
				{
					"id": 206010601,
					"content": "Bạn đã tiêu diệt xong doanh trại đó rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "Bạn thật lợi hại, nếu tôi cũng giỏi giang như bạn thì tốt biết mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "Tôi cũng muốn lưu lại truyền thuyết giết ác long, giải cứu thế giới, nhưng cuối cùng ngay cả Hilichurl cũng không thể đánh bại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "À, cái đó... mặc dù rất ngại, nhưng tôi có chuyện muốn nhờ bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "Thực ra lần này tôi đến điều tra Thiên Phong Thần Điện là bởi vì tôi sắp phải \"Đánh giá Hạng Mạo Hiểm\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "Tôi cho rằng, vào lúc này nếu có thể thể hiện được sức mạnh thì việc đánh giá thứ hạng sẽ suôn sẻ hơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "Nhưng không ngờ rằng, sức mạnh không thể hiện mà ngược lại suýt nữa thì mất mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "Bạn, bạn có thể đừng nói chuyện mất mặt của tôi với ngài Cyrus không? Nếu nó thực sự ảnh hưởng đến \"Đánh giá Hạng mạo hiểm\", vậy thì tôi thực sự thảm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "Tôi biết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Rất cảm ơn bạn! Sau này tôi nhất định sẽ không lỗ mãng như vậy nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "Như vậy không tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Tôi biết như vậy là không tốt, ngài Cyrus đã nói \"Nhà Mạo Hiểm nên đối mặt với chính mình\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "Nhưng...haizz, thôi bỏ đi, hy vọng ngài Cyrus sẽ không giận tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
