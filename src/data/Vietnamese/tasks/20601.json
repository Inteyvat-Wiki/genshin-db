					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "Quả nhiên là như tôi nghĩ, ôi... những điều ngày thường tôi dặn dò cậu ấy đều quên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010705,
					"content": "Mặc dù tôi hiểu nguyện vọng muốn chứng minh bản thân của cậu ấy, nhưng....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010706,
					"content": "Thôi bỏ đi, chuyện này tôi biết rồi, tôi sẽ đi qua nói chuyện với cậu ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
