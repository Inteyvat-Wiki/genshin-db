			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "Ối, đau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010502,
					"content": "Cám ơn bạn, tôi còn tưởng không về được nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010503,
					"content": "Bạn sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "Ha, vết thương nhẹ... úi! Vết thương nhẹ thôi, tôi không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010505,
					"content": "Bởi vì tôi phát hiện ra một đám Hilichurl đang tập kết ở doanh trại phía trước, tôi cho rằng bọn chúng đang muốn làm gì đó, nên đã đi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010506,
					"content": "...Nhưng tôi đã đến quá gần khi theo dõi, không cẩn thận nên đã bị bọn chúng phát hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010507,
					"content": "Không nói nữa, đừng lo lắng cho tôi, bạn hãy mau tiêu diệt đám Hilichurl phía trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010508,
					"content": "Bọn chúng mỗi lúc một đông, đừng để chúng đạt được âm mưu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010509,
					"content": "Còn tôi... có thể tự chăm sóc cho bản thân mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2060106,
