			"dialogs": [
				{
					"id": 715100101,
					"content": "Sao rồi, \"Gai Pursina\" hoạt động chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100102,
						715100103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100102,
					"content": "Hoạt động rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "May quá, hoạt động thì tốt rồi, tuy \"Gai Pursina\" không thể bịt kín lỗ thông hơi đó trong một lần, nhưng chỉ cần hoạt động thì có thể vận hành liên tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100105,
					"content": "Vậy thì chuyện bịt kín lỗ thông hơi chỉ còn là vấn đề thời gian thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100106,
					"content": "Cuối cùng cũng giải quyết xong vấn đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100107,
					"content": "Tôi muốn viết hết những chuyện này lại, chờ nộp báo cáo nghiên cứu \"Gai Pursina\" lên, nói không chừng tôi... tôi có thể trở thành nhân vật nổi tiếng trong viện ấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100108,
					"content": "#Ừm, những chuyện này cũng có thể viết vào tự truyện trong tương lai của tôi, \"Tôi từng cùng {NICKNAME} thân thủ siêu phàm thực nghiệm ở Vực Đá Sâu...\" viết như thế cũng được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100109,
					"content": "Vậy tôi sẽ chờ tới ngày đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715100110
					]
				},
				{
					"id": 715100110,
					"content": "Haha, có điều tôi là chuyên gia viết báo cáo nghiên cứu, viết văn sợ là không hay lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715100111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100111,
					"content": "Hy vọng tới lúc đó bạn sẽ không chê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715100103,
					"content": "Phần lớn bùn đen đều đã được dọn sạch rồi.",
