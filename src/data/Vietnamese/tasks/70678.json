				{
					"id": 706785101,
					"content": "Công việc vẫn chưa chuẩn bị xong... Quý khách hãy đợi thêm một chút nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706785102
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706785102,
					"content": "Nếu sẵn lòng, quý khách có thể thử lên sân khấu biểu diễn, sau đó nhận Huy Chương Đồ Chơi trong rương để làm phần thưởng.",
