					}
				]
			},
			"dialogs": [
				{
					"id": 706780301,
					"content": "Ây chà, xem ra màn biểu diễn của quý khách diễn ra rất thuận lợi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780302
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780302,
					"content": "Nếu quý khách muốn học \"Bí Quyết Biểu Diễn\" mới... Tư thế ngầu hay tao nhã hơn! Coi là minh chứng cho tình bạn, hãy dùng Huy Chương Đồ Chơi nhận được từ trong rương để trao đổi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780303
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780303,
					"content": "Tình bạn là một thứ tốt đẹp, phải không? Chỉ cần nhắc đến từ này là tôi đã cảm thấy trái tim và trong bụng đều rất ấm áp rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780304,
						706780306
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780304,
					"content": "Tình bạn đúng là một thứ tốt đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780305
					]
				},
				{
					"id": 706780305,
					"content": "Tôi cũng thấy thế! Nhưng mà, trong bụng ấm áp... Nói thế này có hơi khiến người ta để ý đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706780308,
					"content": "Nhưng nói đi cũng phải nói lại, dùng Huy Chương Đồ Chơi để trao đổi... Nhưng chỉ là đồ chơi thôi mà, thật sự có giá trị như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706780309,
					"content": "Chỉ cần \"tin tưởng\" thì Huy Chương Đồ Chơi cũng sẽ có thể giá trị hơn cả vàng. Đây chính là bí quyết của phép thuật giả tưởng. Tiểu thư ma nữ từng nói như vậy đó, tuy là tôi không hiểu lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780310
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780310,
					"content": "Tuy nhiên, kiến thức về \"Bí Quyết Biểu Diễn\" cũng có thể có được bằng cách cầu nguyện với tiểu thư ma nữ. Chỉ cần tiểu thư ma nữ cho rằng đó là một giao dịch công bằng thì sẽ không có vấn đề gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780311
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780311,
					"content": "Hmm, không hiểu sao tôi cứ thấy hơi lo... Trong truyện không phải thường hay có tình tiết như vậy sao? Hấp tấp cầu nguyện với một phù thủy để rồi sau đó phải trả một cái giá quá đắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706780312,
					"content": "Quý khách hồ đồ quá, không có gì phải lo lắng cả. Trước hết, ma nữ và phù thủy không giống nhau chút nào. Thứ hai, giá phải trả không phải chỉ là Huy Chương Đồ Chơi thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780313
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780313,
					"content": "Thế, thế hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706780314,
					"content": "Đúng thế đó. Hơn nữa... Là tôi cầu nguyện với ma nữ, nên dù có phải trả giá thế nào thì cũng là tôi chịu mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780315,
						706780316
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780315,
					"content": "...Sao trông tự hào quá vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780317
					]
				},
				{
					"id": 706780317,
					"content": "Vì tôi cũng rất thích màn biểu diễn mà quý khách mang đến, nên tất cả đều xứng đáng. Không biết sách truyện còn bao nhiêu trang trống, còn đủ để viết mấy chương nữa đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780318
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780318,
					"content": "A, hai vị không cần lo lắng. Cho dù bây giờ có viết hết thì sau này cũng sẽ có thêm nhiều trang trống mới thôi ấy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780319
					],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780319,
					"content": "Thật mong chờ một ngày tất cả những trang sách trống đều được viết kín những câu chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sói Nhỏ"
				},
				{
					"id": 706780316,
					"content": "Cứ cảm thấy hơi ngại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780317
					]
				},
				{
					"id": 706780306,
					"content": "Trong bụng ấm áp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706780307
					]
				},
				{
					"id": 706780307,
					"content": "Này! Lại nghĩ tới \"thực phẩm dự trữ\" nữa sao? Tôi là \"đồng đội tốt nhất\" đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706780308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
