			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "Nhìn kìa, ừm... nói không chừng đây là bản đồ kho báu gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200102,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "Hừm, tôi đã đánh hơi được mùi của kho báu rồi, chắc chắn là như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200116,
					"content": "Nhìn nè, người để lại bản đồ là \"nhóm hải tặc Ako Domeki\", cứ cảm thấy hình như có nghe qua cái tên này ở đâu rồi thì phải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200104,
					"content": "Hơn nữa bạn xem, \"nơi cất giấu kho báu...\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200105,
					"content": "Ừm, tiếp theo là... \"bí mật trong đó... một chia làm bốn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200106,
					"content": "Một chia làm bốn, ý là chia thứ gì đó ra thành 4 phần sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200107,
					"content": "Có 4 rương báu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "Không biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200110,
					"content": "Nhưng mà ở đây nói \"nằm ở bãi đá ngầm chỗ 4 hòn đảo lớn\", chắc là đá ngầm ở 4 hòn đảo thuộc Quần Đảo Táo Vàng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200111,
					"content": "A, chỗ này không phải chính là đá ngầm sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200112,
					"content": "Xem ra 4 phần đó chính là manh mối kho báu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "Hơn nữa còn ở gần đá ngầm của 4 hòn đảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200114,
					"content": "Nhắc đến 4 hòn đảo của Quần Đảo Táo Vàng, vậy nhất định là 4 hòn đảo lớn nhất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200115,
					"content": "Chúng ta hãy đến gần chỗ đá ngầm của 3 hòn đảo còn lại tìm thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200108,
					"content": "Có 4 manh mối kho báu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				}
			]
		},
