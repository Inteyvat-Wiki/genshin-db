			"dialogs": [
				{
					"id": 110400201,
					"content": "Hình như hôm nay ngài Timaeus vắng mặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400202,
					"content": "(Là, là khách sao?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400203
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400203,
					"content": "Ừ thì... xin hỏi hai người tìm ngài ấy có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400204
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400204,
					"content": "Không có gì đâu, chẳng qua bình thường ngài ấy hay đứng ở đây, nên thấy có chút kỳ lạ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400205,
					"content": "À, vậy hả. Anh ấy vừa được ngài Albedo gọi đi rồi, nên tôi mới bị bảo đến trông coi Xưởng Giả Kim đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400206
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400206,
					"content": "Tôi tên là Sucrose, phụ tá của ngài Albedo. Nếu gặp vấn đề về thuật giả kim cũng có thể hỏi tôi, tôi... sẽ cố hết sức để giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400207,
						110400209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400207,
					"content": "Tự tin lên nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400208
					]
				},
				{
					"id": 110400208,
					"content": "Thực ra tôi... tôi không thạo việc này cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400211,
					"content": "Ngại quá, tôi ở trong phòng thí nghiệm suốt, không hề ra ngoài, cũng không thường nói chuyện với người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400212,
					"content": "Nếu cần tôi giúp thì cứ gọi tên tôi, nếu không cần, thì tôi... tôi qua kia đọc sách, ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400213
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400213,
					"content": "#Hi hi, cảm ơn lòng tốt của cô, nhưng đừng lo, chúng tôi đã thuần thục việc sử dụng Đài Giả Kim rồi, đúng không {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400214,
						110400215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400214,
					"content": "Ừ, sẽ không làm phiền cô đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400216,
					"content": "#Í? {NICKNAME}... Chẳng lẽ bạn chính là Nhà Lữ Hành đã đánh bại Phong Ma Long trong truyền thuyết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400217,
						110400218
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400217,
					"content": "\"Trong truyền thuyết\" hình như hơi lố rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400220
					]
				},
				{
					"id": 110400220,
					"content": "Tôi đã nghe rất nhiều chuyện về bạn, luôn mong chờ cơ hội được nghiên cứu bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400221,
					"content": "Nghiên, nghiên cứu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400222,
					"content": "Á, xin lỗi, đừng để bụng nha, không để ý nên mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400223
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400223,
					"content": "Nhưng, nếu là bạn thì chắc chắn sẽ giúp được ngài Albedo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400224
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400224,
					"content": "Nãy giờ cứ luôn nghe \"ngài Albedo\", ngài ấy cũng là thuật sĩ giả kim ở Thành Mondstadt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400225,
					"content": "Đúng là chưa từng nghe qua cái tên này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "Xin lỗi, tôi chưa giới thiệu, ngài Albedo là Giả Kim Thuật Sĩ đứng đầu Đội Kỵ Sĩ Tây Phong, cũng là thầy của tôi và ngài Timaeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400228,
					"content": "Bình thường chỉ thấy ngài Timaeus dạy người ta thuật giả kim. Nói vậy thì ngài ấy chính là thầy của thầy rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400229,
					"content": "Đúng thế, ngài ấy dốc sức tìm tòi nghiên cứu sự thật của thế giới và đã đạt được rất nhiều thành quả vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400230,
					"content": "Nhiều thuật sĩ giả kim từ phương xa cũng thường đến Mondstadt để nhờ ngài ấy giúp. Chỉ cần ngài Albedo hướng dẫn một chút là họ đã có thể giải quyết những vấn đề khó khăn phức tạp một cách hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400231,
					"content": "Woa, không ngờ là người lợi hại vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400232,
					"content": "Ừm. Nhưng gần đây hình như việc nghiên cứu của ngài ấy gặp phải khó khăn, lúc nào cũng thấy ngài ấy mặt ủ mày chau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400233,
					"content": "Tôi giúp được cho người lợi hại như thế sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "Một loạt trải nghiệm phi thường của bạn trong hành trình mạo hiểm chắc chắn sẽ khiến ngài Albedo vô cùng hứng thú, việc này có lẽ sẽ mang đến cho ngài ấy rất nhiều cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400236,
					"content": "Ngài Albedo là một người rất phong độ, nếu giúp đỡ ngài ấy, ngài ấy chắc chắn sẽ đền đáp xứng đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400237,
					"content": "Có thể giúp tôi trở nên mạnh hơn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "Tôi nghĩ là không thành vấn đề, khám phá giới hạn của cuộc sống vốn là một trong những nội dung nghiên cứu của ngài Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400241,
					"content": "Ngài Albedo chắc đang trên núi tuyết nghiên cứu cùng ngài Timaeus, tôi rất muốn đưa hai người đi, nhưng Xưởng Giả Kim không thể không có người trông coi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400242,
					"content": "Phiền hai người đến cổng vào của núi tuyết tìm thử vậy, đó là một người trẻ tuổi tri thức, nho nhã, lịch thiệp, và, ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400243,
					"content": "...Xin lỗi, tôi cũng không biết nói thế nào cho rõ hơn, thôi thì hai người cố phán đoán nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400244,
					"content": "Ừ, được thôi, yên tâm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400239,
					"content": "Có thể giúp Paimon trở nên mạnh hơn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "Tôi không có nhu cầu đâu. Nếu muốn đền đáp tôi, hi hi, cứ tính bằng Mora có được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400234,
					"content": "Sự hiểu biết của tôi về thuật giả kim chỉ ở mỗi cái Đài Giả Kim này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "Hình như có nghe qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400218,
					"content": "Tôi sẽ tặng chữ ký miễn phí cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400219
					]
				},
				{
					"id": 110400219,
					"content": "A, cảm ơn nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400220
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400215,
					"content": "Hình... hình như hơi quên quên rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400209,
					"content": "Đừng căng thẳng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400210
					]
				},
				{
					"id": 110400210,
					"content": "Ơ? Nhìn tôi... tôi căng thẳng lắm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "Sucrose"
				}
			]
		},
