			"dialogs": [
				{
					"id": 110400401,
					"content": "Thì ra chị ở đây, chị Rosaria, hoạt động của lớp hợp xướng sắp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400402
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400402,
					"content": "Đã nói là chị không tham gia những hoạt động này mà, chị còn việc quan trọng hơn phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400403,
					"content": "Nhưng lần này là hoạt động mang tính kỷ niệm, hy vọng tất cả nữ tu đều có mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400404
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400404,
					"content": "Hy vọng cũng chỉ là hy vọng, nội dung công việc của chị không có mục \"đáp ứng hy vọng của người khác\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400405
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400405,
					"content": "Ơ, đừng nói vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400406
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400406,
					"content": "Còn em đó, em là người tổ chức hoạt động lần này phải không, em không thấy rất kỳ lạ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400407
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400407,
					"content": "Kỳ lạ chỗ nào chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400408
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400408,
					"content": "Xét theo thời gian hiện giờ, cứ cho là em quay về Thành Mondstadt ngay, thì cũng không kịp thời gian bắt đầu hoạt động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400409
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400409,
					"content": "Chẳng lẽ không phải là có người đã tính hết, muốn em mất mặt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400410
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400410,
					"content": "Hả? Sao vậy được! Mọi người không phải là người như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400411
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400411,
					"content": "Có phải người như vậy hay không thì phải dùng chứng cứ, chứ không phải chỉ dựa vào cảm giác của em. Ừm, hoặc có thể nói rằng em dễ tin người quá nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400412
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400412,
					"content": "Yên tâm đi, ngay cả khi em cứ như vậy mà trở về, thì cũng không ai trách em đâu. Vì có lẽ cũng chẳng được mấy người cảm thấy rằng chị sẽ tham gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400413
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400413,
					"content": "Nhưng nếu cứ dây dưa tiếp thì em sẽ trễ thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400414
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400414,
					"content": "Đúng ha! Hoạt động kỷ niệm quan trọng mà đến trễ thì... vậy, vậy em về đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400415
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400415,
					"content": "Nghe giống như... cô nữ tu này đang xảo biện để lừa dối mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400416,
					"content": "Từ nãy đã chú ý đến hai người rồi. Hai người là ai, sao lại nghe lén?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400417
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400417,
					"content": "Cẩn thận nha! Tôi thấy cô ấy là một nhân vật nguy hiểm... ơ, chí ít thì cũng hơi xảo quyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400418,
					"content": "Ồ? So với thành viên thuộc Giáo Hội Tây Phong có lịch sử lâu đời, thì sinh vật trôi bồng bềnh không rõ lai lịch thế này mới nguy hiểm hơn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400419
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400419,
					"content": "Bị nghe thấy rồi ư?! Tôi cứ tưởng là nói đủ nhỏ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400420,
					"content": "#Ừm, người từ nơi khác mang theo sinh vật trôi bồng bềnh... thì ra là vậy, {F#cô}{M#cậu} chính là... ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400421
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400421,
					"content": "#Kỵ Sĩ Danh Dự đã đánh bại Phong Ma Long, dựa vào thân phận này, có thể không cần vội truy cứu việc nghe lén của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400422
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400422,
					"content": "Nếu không... tùy thuộc vào câu trả lời của hai người, trường hợp xấu nhất có thể vào tù đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400423
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400423,
					"content": "Ơ! Nữ tu Thành Mondstadt còn phụ trách việc bắt giữ người khả nghi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400424,
					"content": "Chí ít thì không thể nào ngoảnh mặt làm ngơ với hiểm họa rành rành trước mắt, nữ tu thì không được quyền có tinh thần chính nghĩa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400425
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400425,
					"content": "Hừm, nghe cứ kỳ kỳ sao đó, nhưng không thể phản bác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400426,
					"content": "Hay là nói chuyện của hai người đi, vì sao lại đến núi tuyết này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400427,
						110400428
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400427,
					"content": "Tìm ngài Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400431
					]
				},
				{
					"id": 110400431,
					"content": "Trước đó tôi đã đặc biệt lưu ý tung tích của anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400432
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400432,
					"content": "Sau khi tuyết ngừng rơi, rất nhiều người đã đến núi tuyết, hi vọng rằng vết tích trên đường đi chưa bị che lấp mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400433
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400433,
					"content": "Chẳng lẽ cô cũng đến tìm anh ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400434,
					"content": "Không có, cái này là bệnh nghề nghiệp thôi, tôi phát giác được sức mạnh nguyên tố để lại trên những dấu chân này, nên cảnh giác một chút cho chắc ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400435,
						110400436
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400435,
					"content": "Nói vậy, thì nữ tu thật sự quá bí ẩn rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400437,
					"content": "Muốn nghĩ sao cũng được, đi thôi, tiện đường tôi cũng muốn xem thử anh ta đang làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400436,
					"content": "Cứ y như trinh sát.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400428,
					"content": "Khám phá sự thật của thế giới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400429
					]
				},
				{
					"id": 110400429,
					"content": "#Nhưng {F#cô}{M#cậu} chỉ là một Nhà Lữ Hành, đâu phải thuật sĩ giả kim vĩ đại gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400430
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400430,
					"content": "#Không sao cả, tôi đã biết {F#cô}{M#cậu} muốn tìm ai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400431
					],
					"speakerTitle": "Rosaria"
				}
			]
		},
		{
			"id": 1104005,
