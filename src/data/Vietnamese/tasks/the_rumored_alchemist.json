					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400501,
					"content": "Hình như hôm nay anh Timaeus vắng mặt nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400502,
					"content": "(Ấy, hai vị này là...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400503
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400503,
					"content": "#A! À... là Paimon và {NICKNAME} à. Xin hỏi, hai người tìm anh Timaeus có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400504
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400504,
					"content": "Không có gì đâu, chẳng qua bình thường anh ấy hay đứng ở đây, nên thấy có chút kỳ lạ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400505,
					"content": "À, vậy hả. Anh ấy vừa được ngài Albedo gọi đi rồi, nên tôi mới bị bảo đến trông coi Xưởng Giả Kim đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400506
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400506,
					"content": "Nếu cần tôi giúp thì cứ gọi tôi. Còn nếu không cần thì tôi... tôi qua kia đọc sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400507
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400507,
					"content": "#Hihi, cảm ơn lòng tốt của cô, nhưng đừng lo, chúng tôi đã thuần thục việc sử dụng Đài Giả Kim rồi, đúng không {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400508,
					"content": "Ừm, sẽ không làm phiền cô đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400509
					]
				},
				{
					"id": 110400509,
					"content": "#{NICKNAME} thật không hổ danh là người đã đánh bại Phong Ma Long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400510
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400510,
					"content": "Đúng rồi, nếu là bạn thì chắc chắn sẽ giúp được ngài Albedo nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400511
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400511,
					"content": "Kể ra thì, lần trước cứ nghe cô và Timaeus nhắc đến \"ngài Albedo\" nào đó. Anh ấy cũng là thuật sĩ giả kim ở Thành Mondstadt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400225,
					"content": "Đúng là chưa từng nghe qua cái tên này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "Xin lỗi, tôi chưa giới thiệu, ngài Albedo là Giả Kim Thuật Sĩ đứng đầu Đội Kỵ Sĩ Tây Phong, cũng là thầy của tôi và ngài Timaeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400228,
					"content": "Bình thường chỉ thấy ngài Timaeus dạy người ta thuật giả kim. Nói vậy thì ngài ấy chính là thầy của thầy rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400229,
					"content": "Đúng thế, ngài ấy dốc sức tìm tòi nghiên cứu sự thật của thế giới và đã đạt được rất nhiều thành quả vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400230,
					"content": "Nhiều thuật sĩ giả kim từ phương xa cũng thường đến Mondstadt để nhờ ngài ấy giúp. Chỉ cần ngài Albedo hướng dẫn một chút là họ đã có thể giải quyết những vấn đề khó khăn phức tạp một cách hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400231,
					"content": "Woa, không ngờ là người lợi hại vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400232,
					"content": "Ừm. Nhưng gần đây hình như việc nghiên cứu của ngài ấy gặp phải khó khăn, lúc nào cũng thấy ngài ấy mặt ủ mày chau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400233,
					"content": "Tôi giúp được cho người lợi hại như thế sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "Một loạt trải nghiệm phi thường của bạn trong hành trình mạo hiểm chắc chắn sẽ khiến ngài Albedo vô cùng hứng thú, việc này có lẽ sẽ mang đến cho ngài ấy rất nhiều cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400236,
					"content": "Ngài Albedo là một người rất phong độ, nếu giúp đỡ ngài ấy, ngài ấy chắc chắn sẽ đền đáp xứng đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400237,
					"content": "Có thể giúp tôi trở nên mạnh hơn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
