					"nextDialogs": [
						722610429
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610429,
					"content": "Tuy không cam tâm lắm, nhưng Kichiboushi có vẻ đã chơi đủ rồi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610430
					]
				},
				{
					"id": 722610430,
					"content": "Phù, Kichiboushi đúng là giống một đứa trẻ thật.",
