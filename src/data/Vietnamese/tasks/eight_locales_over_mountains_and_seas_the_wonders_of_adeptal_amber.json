			},
			"dialogs": [
				{
					"id": 722610401,
					"content": "Tìm được rồi... Kichiboushi không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610402,
					"content": "Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610403
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610403,
					"content": "Không sao là tốt rồi, nhưng sau này đừng chạy lung tung nữa nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610404,
						722610408,
						722610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610404,
					"content": "Paimon trông giống chị của Kichiboushi thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610405
					]
				},
				{
					"id": 722610405,
					"content": "Paimon lớn hơn Kichiboushi mà, đương nhiên phải là chị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610406,
					"content": "Không nói cũng không biết luôn á...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610407
					]
				},
				{
					"id": 722610407,
					"content": "Ê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610412,
					"content": "#Mm-mm! Cảm ơn {NICKNAME}, cảm ơn Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610413,
					"content": "Còn ngỡ rằng Kichiboushi đã bị phong ấn rồi, sợ lắm. Nhưng mà, nghe thấy Paimon gọi Kichiboushi, cho nên không còn sợ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610414,
					"content": "À, nghe Ioroi nói hình như cũng có tanuki nhỏ bị phong ấn qua mà đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610415,
					"content": "Trong hổ phách rất đáng sợ. Tất cả đều là màu đen, không thấy gì cả, cũng không thể nói được, không thể \"bum bum\", cứ như biến thành tảng đá vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610416,
					"content": "Ioroi dù cho bị biến thành tảng đá, nhưng vẫn rất lợi hại, có thể nhìn và nói chuyện, chỉ là không thể nhúc nhích thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610417,
					"content": "Kichiboushi muốn giúp Ioroi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "Ừm. Sau đó, sẽ giúp những tanuki bị phong ấn khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610419,
					"content": "Nhưng mà, giờ có mọi người ở bên Kichiboushi, Kichiboushi sẽ không bị phong ấn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610422,
					"content": "Yey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610423,
					"content": "Nhưng mà Kichiboushi phải nghe lời, không được hư biết chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610424,
					"content": "Ừm, biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610425
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610425,
					"content": "Ngoan lắm, hôm nay đến đây là được rồi. Kichiboushi cũng mệt rồi đúng không, phải nghỉ ngơi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610426,
					"content": "Kichiboushi không mệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610427
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610427,
					"content": "Ây da, nếu như Kichiboushi không nghe lời thì Paimon sau này sẽ không suy nghĩ ra nơi nào đó để đi tu luyện nữa đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610428,
					"content": "Mm...",
