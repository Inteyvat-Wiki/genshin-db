					"\"Kichiboushi\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "Chụp đẹp lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610202,
					"content": "Mmhaha, Kichiboushi đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610203,
					"content": "Đứa nhóc này không biết khiêm tốn gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610204,
					"content": "Đúng rồi, Paimon. Tiên nhân có tiên thuật gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610205,
					"content": "Tiên nhân mạnh lắm! Nhưng mà nếu muốn ví dụ thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610206,
					"content": "Bắt đầu với hổ phách quanh đây đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "Hổ phách, đó là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610208,
					"content": "Ừm! Trước đó Paimon nghe nói Lí Thủy Điệp Sơn Chân Quân sở hữu bông hoa có thể tạo ra hổ phách, dùng để nhốt kẻ xâm phạm vào trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610209,
					"content": "Lí Lí Chân thật lợi hại. Bảo vệ Liyue, nên nhốt hết những thứ xấu xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610210,
					"content": "Rất lâu rất lâu trước đây, có đám Oni của Ogata vô cùng xấu xa đến xâm phạm khu rừng, ăn hiếp bake-danuki. Ioroi biến thành người chủ trì, cho chúng ăn cơm bake-danuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610211,
					"content": "Sau đó, cùng Vua Otogi phong ấn chúng vào trong tranh vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610212,
					"content": "Có chuyện này sao, thảo nào khi Ioroi thấy hình của Kichiboushi lại hoảng loạn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610213,
					"content": "Ioroi không phải tiên nhân, không bảo vệ Liyue, nhưng bảo vệ khu rừng, bảo vệ tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610214,
					"content": "Mỗi người đều sẽ có thứ cần phải bảo vệ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610216,
					"content": "Sau này Kichiboushi lớn lên thì sẽ hiểu được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "Cho nên, Kichiboushi phải cố gắng tu luyện để có thể biến thành bake-danuki mạnh mẽ nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610218,
					"content": "Mm! Đương nhiên rồi! Bake-danuki Kichiboushi danh chấn thiên hạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610219,
					"content": "Paimon tò mò về bộ dạng của Ioroi khi không bị phong ấn thật! Chắc là vui lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610220,
					"content": "À, Paimon đột nhiên nhớ ra, trước đây cũng có người của Đạo Bảo Đoàn bị hổ phách phong ấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610221,
					"content": "Chúng ta còn bị xem như \"tiên sứ\" nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "Có cảm giác chuyện này đã xảy ra từ rất lâu rồi... nhưng hình như, cũng không lâu lắm nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610223,
					"content": "Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610224,
					"content": "Khụ khụ, khi chúng tôi đến Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610225,
					"content": "#\"Là điển lễ thỉnh tiên mỗi năm một lần đó. Woa, {NICKNAME} tôi đây chắc sẽ ăn được rất nhiều món ngon. Paimon, chúng ta đi thôi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610226,
					"content": "\"Còn có rất nhiều cống phẩm nữa! Paimon tôi sẽ bay ngay tới đó!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610228,
					"content": "Đừng xuyên tạc nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "Được thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610230,
					"content": "Kể lại một số câu chuyện mạo hiểm ở Liyue,\\nKể đến đoạn chạy đến Mân Lâm để tìm chúng tiên.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#...Câu chuyện sau đó chính là tôi và {NICKNAME} cùng nhau đến \"Lưu Ly Đình\" ăn cơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610232,
					"content": "Lí Lí Chân lợi hại quá, Lưu Lưu Chân cũng rất lợi hại! Còn có thể tạo ra được một căn phòng di động nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610233,
					"content": "Lưu Lưu Chân... À ừm, Lưu Vân Tá Phong Chân Quân cũng rất thích ẩm thực! Lúc đó tôi phải làm rất nhiều món ngon mới có thể gặp được bà ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610234,
					"content": "Tham ăn quá, giống Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610235,
					"content": "Đúng là giống Paimon thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "Ê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610238,
					"content": "Paimon là tiên nhân? Paimon thật lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610239,
					"content": "Chậc, được khen nhưng có cảm giác không vui chút nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610240,
					"content": "Nhưng mà Paimon không phải là tiên nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610241,
					"content": "Muốn chơi với tiên nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610242,
					"content": "Tiên nhân thường sẽ không tùy ý hiện thân đâu... Nhưng mà chúng ta đi dạo xung quanh cũng vui lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610243,
					"content": "Kichiboushi xuất phát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610236,
					"content": "Lại còn biết bay nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				}
			]
		},
