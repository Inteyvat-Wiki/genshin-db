			},
			"dialogs": [
				{
					"id": 722610101,
					"content": "Hú! Lí Thủy Điệp Sơn Chân Quân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610102,
					"content": "Hú! Lí Lí Chân...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610104,
					"content": "Chậc, tiên nhân hình như không có ở đây",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610105,
					"content": "Không được vô lễ với tiên nhân",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "Paimon, tiên nhân là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610107,
					"content": "Ừm, có thể nói là người... hoặc là động vật đặc biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610108,
					"content": "Giống như Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610109,
					"content": "Không đúng! Phải nói là có sức mạnh thần kỳ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610110,
					"content": "Cũng có thể \"bum bum\" đúng không? Vậy, Kichiboushi cũng là tiên nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610111,
					"content": "À ừm... tiên nhân già hơn, với uy nghiêm hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610112,
					"content": "Hiểu rồi, Kichiboushi không phải tiên nhân, Ioroi là tiên nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610113,
					"content": "Chậc, phải giải thích thế nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610114,
					"content": "Tiên nhân là thực thể cổ xưa bảo vệ Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "Kichiboushi hiểu rồi. Ioroi bảo vệ Rừng Chinju, cho nên không phải là tiên nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610116,
					"content": "Suy nghĩ như vậy cũng không hợp lý lắm, nhưng mà không sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610117,
					"content": "Nhưng mà dù gì ở đây cũng có tiên phủ rồi, vậy chúng ta chụp hình cho Kichiboushi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610118,
					"content": "Mm! Kichiboushi sẽ ngoan ngoãn đứng chụp hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610119,
					"content": "Kichiboushi ngoan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7226102,
