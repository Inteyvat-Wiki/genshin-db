					"nextDialogs": [
						722610438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610438,
					"content": "Ừm, lần này chúng ta học được là... Bake-danuki và tiên nhân có vẻ không hợp nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610439,
					"content": "Tiếp theo đây, phải suy nghĩ địa điểm tiếp theo mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610435,
					"content": "Đúng là đã cùng nhau chơi với nhiều đứa trẻ thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "Ừm, chúng ta đã từng chơi đùa qua với nhiều trẻ con lắm, như là Bé Ming nè, Changchang nè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610420,
					"content": "Chúng tôi sẽ bảo vệ Kichiboushi.",
