				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "Không ngờ Ốc Biển có thể nổi lên từ trong giếng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330202,
					"content": "Dù sao cũng là ốc biển bị ảo cảnh ảnh hưởng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#Ừm, kỳ diệu thật đấy... Á, hồi ức xuất hiện rồi, {NICKNAME}, mau nhìn kìa, đằng kia có người đang khom lưng... Ối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME}, đừng cử động, sau lưng bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330206,
					"content": "Có, có thứ gì đó đáng sợ à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "À, nếu để ý kỹ sẽ thấy đó chỉ là hình ảnh do Ốc Biển tạo ra, đột ngột xuất hiện ở sau lưng, đúng là giật cả mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330209,
					"content": "Máy thử nghiệm tín hiệu... Hai nhóm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330210,
					"content": "Ôi, tôi còn tưởng anh ấy phải chịu hình phạt gì ghê gớm lắm, hóa ra chỉ là nhận một nhiệm vụ hơi rắc rối thôi, nhẹ nhõm thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330211,
					"content": "Anh ấy sợ bị anh mắng. Haha, trông giống như \"em trai\" sợ \"anh trai\" mắng vậy... Anh nói xem, có phải anh ấy sợ chúng ta thất vọng về anh ấy không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330212,
					"content": "Rõ ràng mọi người chỉ là thành viên trong nhóm thôi... nhưng đôi khi, cảm giác giống như là \"gia đình\" vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330213,
					"content": "Gia đình sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330214,
					"content": "Hmm... cảm giác như mình đã nghe thấy những lời đáng ra không nên nghe nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330215,
					"content": "Những tên Fatui trong hình ảnh này có vẻ không... \"tệ\" đến vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330207,
					"content": "Đừng có cố tình dọa người khác chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "Có lẽ trong vỏ có không khí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
