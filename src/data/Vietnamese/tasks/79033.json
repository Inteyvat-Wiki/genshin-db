			"dialogs": [
				{
					"id": 790330301,
					"content": "Ồ, trông như hai người đang nằm trên mặt đất... Họ đang ngắm sao ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330302,
					"content": "Tôi cứ cảm thấy đó là một hình ảnh khá kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330303,
					"content": "Yakov, trưởng quan đã nói gì mà trông anh chán nản vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330304,
					"content": "Vì sóng lớn nên lúc vận chuyển thiết bị đã bị ngã, may mà tôi nhanh tay nên thiết bị không sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330305,
					"content": "Nhưng mà vẫn bị trưởng quan trách tội, muốn đội của chúng ta lên các đảo để thử nghiệm việc nhận tín hiệu của thiết bị, đó là nhiệm vụ vất vả nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330306,
					"content": "Không sao đâu, đừng buồn quá, có việc cực nhọc nào mà chúng ta chưa từng làm qua chứ. Đừng buồn nữa, ăn gì đó trước nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330307,
					"content": "Bọn họ chỉ vào chỗ cao cao kia, là muốn ăn gì đó sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330308,
					"content": "Lẽ nào vỏ ốc này... đặt lệch rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
