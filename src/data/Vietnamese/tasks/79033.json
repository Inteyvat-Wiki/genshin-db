			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "Ồ, không ngờ hồi ức lại nằm giữa sân khấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330102,
					"content": "Hai người đó đang làm gì vậy... có vẻ như một người đang nói chuyện, người kia ngồi trên mặt đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330103,
					"content": "Tôi hiểu rồi, đây chắc hẳn là cảnh tượng kể chuyện! Họ sắp đi ngủ rồi, cho nên cô ta đang kể chuyện cho Fatui đang ngồi trên đất nghe trước khi ngủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330104,
					"content": "Fatui cũng muốn nghe kể chuyện trước khi ngủ à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "Biết đâu họ cũng có nhu cầu thì sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330106,
					"content": "Agafya, Persikov muốn chúng ta đi thử nghiệm tiếp nhận tín hiệu, là muốn bốn người chúng ta cùng đi... Chevka nếu như nghe thấy chuyện này chắc lại tức giận mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330107,
					"content": "Yakov, không thể nào, đây là mệnh lệnh của cấp trên, Chevka chắc chắn sẽ không trách anh đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330108,
					"content": "Haiz, nếu anh sợ thì để tôi nói chuyện với Chevka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330109,
					"content": "Gì vậy, không phải là đang kể chuyện à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330110,
					"content": "Nhưng cuộc nói chuyện này không đầu không đuôi, và căn bản là không thể nhìn ra gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7903302,
