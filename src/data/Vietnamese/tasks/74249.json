			"dialogs": [
				{
					"id": 742490201,
					"content": "Ừm! Thời gian trà chiều thư thái thế này thì làm sao có thể chán được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490204,
					"content": "Ừm, thời gian vui vẻ trôi qua nhanh thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
