			"dialogs": [
				{
					"id": 742490101,
					"content": "Lần này lại nhờ tiểu thư Guillotin chuẩn bị trà bánh, thật là ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490102,
					"content": "Không sao đâu, Liên Hoan Phim Fontinalia lần trước cũng nhờ có đạo diễn Furina giúp đỡ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490103,
					"content": "Đâu có, đâu có! Tôi thấy người giỏi phải là các diễn viên mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490104,
					"content": "Tiểu thư Furina sau này không định tham gia các hoạt động biểu diễn nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490105,
					"content": "Ừm... cũng không phải là không thể. Chỉ là bây giờ, tôi muốn lui về hậu trường hơn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490106,
					"content": "Thật ra thì, khi tôi còn sống ở Fontaine, tôi đã biết đến cô, đại minh tinh được mọi người yêu mến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490107,
					"content": "Ấy, dừng lại, dừng lại! Đừng nói mấy câu kiểu từ nhỏ đã xem tôi biểu diễn nhé, lần nào tôi nghe cũng thấy khó chịu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490108,
					"content": "Ồ, không phải đâu. Tôi chỉ muốn nói, khi rời Fontaine, tôi cũng may mắn được gặp tiểu thư Furina lúc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490109,
					"content": "Nhưng sau lần này tiếp xúc, tôi vẫn thích dáng vẻ bây giờ của tiểu thư Furina hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490110,
					"content": "Hửm...? Dáng vẻ bây giờ ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490111,
					"content": "Ừm, trên sân khấu hình như cô cứ luôn căng thẳng, giờ thì thoải mái hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490112,
					"content": "Ha... Cảm ơn cô đã nói vậy. Thực ra, tôi cũng thích cuộc sống hiện tại hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490113,
					"content": "Còn tiểu thư Guillotin thì sao? Có hài lòng với cuộc sống hiện tại không? So với lúc rời Fontaine ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490114,
					"content": "Tốt lắm, nhưng chủ yếu là thay đổi về tâm trạng thôi. Chứ thực ra tôi vẫn luôn khá thích quê nhà Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490115,
					"content": "Không phải là nơi đây tốt hơn các quốc gia khác, mà vì ở đây chứa đựng nhiều kỷ niệm. Cuộc sống tại đây đôi khi yên bình như dòng nước, có lúc lại đầy những biến đổi mới mẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490116,
					"content": "Gần đây tôi đã học cách nhìn vào mặt tích cực của cuộc sống. Tôi đoán là người ở nơi khác cũng ít nhiều nhìn nhận đất nước của mình như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742490117,
					"content": "Ồ, nói hay lắm, tiểu thư Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490118,
					"content": "Dù làm thế này không phù hợp với lễ nghi tiệc trà lắm, nhưng... vì Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490119,
					"content": "Haha... Vì quê nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
