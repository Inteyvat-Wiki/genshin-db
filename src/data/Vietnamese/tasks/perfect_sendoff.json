				{
					"id": 111131201,
					"content": "À, mấy bữa nay chú có gặp lão Zhang không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131202
					],
					"speakerTitle": "Shu'yang"
				},
				{
					"id": 111131202,
					"content": "Chú nhớ ông ấy nói rằng, đã đến lúc nên buông bỏ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131203
					],
					"speakerTitle": "Mo"
				},
				{
					"id": 111131203,
					"content": "Ồ ồ, vậy thì tốt, không biết tiếp đến ông ấy sẽ đi đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131204
					],
					"speakerTitle": "Shu'yang"
				},
				{
					"id": 111131204,
					"content": "Nếu cháu hiếu kỳ thì chúng ta cùng đi xem thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131205
					],
					"speakerTitle": "Mo"
				},
				{
					"id": 111131205,
					"content": "Ha ha, sau này đi, bây giờ cháu vẫn muốn chờ thêm một thời gian.",
