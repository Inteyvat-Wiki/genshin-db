			"dialogs": [
				{
					"id": 111130801,
					"content": "Woa, bên trên có tên của năm người chúng tôi thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130802
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130802,
					"content": "Hì hì, thích thật. Đúng rồi, vừa nãy bạn nói năm nào cũng thả đèn, vậy có phải tên trên chiếc đèn sẽ ngày càng nhiều không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130803
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130803,
					"content": "Ví dụ như con của Wu, vợ của Mumu chẳng hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130804
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130804,
					"content": "Đúng là có tin vui, Mumu sắp làm cha rồi, dạo gần đây cứ luôn miệng nhắc chuyện này, hình như vừa vui vừa căng thẳng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130805
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130805,
					"content": "Ha ha ha, bạn ấy ngốc như thế thì có thể làm một người cha tốt không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130806
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130806,
					"content": "À không đâu, bây giờ bạn ấy thông minh lanh lợi lắm, để tôi kể cho nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Meng"
				}
			]
		},
