			"dialogs": [
				{
					"id": 111130601,
					"content": "Cuối cùng đã đến rồi, tôi cứ tưởng chúng ta bị nhốt trong cái không gian quái quỷ đó luôn rồi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130602,
					"content": "Phải gây ra cảm giác này cho người khác thì mới dọa được những kẻ ngang ngược xông vào chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130603
					]
				},
				{
					"id": 111130603,
					"content": "Chắc sẽ không xuất hiện những thứ kỳ quặc nữa phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130604,
					"content": "Ừ, chỉ cần nhảy xuống phía dưới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130605
					]
				},
				{
					"id": 111130605,
					"content": "Hở hở?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
