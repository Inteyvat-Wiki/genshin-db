			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wu",
					"Mumu",
					"Congzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111122301,
					"content": "Nói ra thì, hai bạn đều tự tay làm, chỉ có tôi là mua về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111122302,
					"content": "Nhưng xét về giá trị, thì đồ của bạn đã gấp mấy lần chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 111122303,
					"content": "Quan trọng không phải giá tiền, mà tất cả những thứ này đều là một phần trong tuổi thơ của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111122304,
					"content": "Hơn nữa, nó cho thấy chúng ta sẽ mãi mãi không quên lời hứa năm nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congzi"
				}
			]
		},
		{
			"id": 1111304,
			"completionStepIds": [
				1111304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111304",
							"2"
						],
						"stepId": 1111304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Big G (Hồi ức)",
					"Wu (Hồi ức)",
					"Mumu (Hồi ức)",
					"Congzi (Hồi ức)",
					"Meng (Hồi ức)"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130401,
					"content": "Lại đến Tết Hải Đăng, nếu có một ngày có thể đi ngắm đèn thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130402
					],
					"speakerTitle": "Wu (Hồi ức)"
				},
				{
					"id": 111130402,
					"content": "Không có đèn cũng cầu nguyện được mà, mẹ tớ nói, chỉ cần la to lên, thì ước mơ sẽ được thực hiện ở tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130403
					],
					"speakerTitle": "Congzi (Hồi ức)"
				},
				{
					"id": 111130403,
					"content": "La lớn lên...có xấu hổ quá không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130404
					],
					"speakerTitle": "Big G (Hồi ức)"
				},
				{
					"id": 111130404,
					"content": "Nếu mọi người cùng la thì bạn sẽ không xấu hổ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130405
					],
					"speakerTitle": "Meng (Hồi ức)"
				},
				{
					"id": 111130405,
					"content": "Đúng đúng, vậy Wu trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130406
					],
					"speakerTitle": "Congzi (Hồi ức)"
				},
				{
					"id": 111130406,
					"content": "Vậy...vậy tớ muốn mở một quán ăn lớn thật lớn, vừa có đồ ăn ăn hoài không hết vừa có điểm tâm! Ngày nào cũng được ăn Gà Cay Thơm Mềm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130407
					],
					"speakerTitle": "Wu (Hồi ức)"
				},
				{
					"id": 111130407,
					"content": "Ha ha ha, thật là con nít mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130408
					],
					"speakerTitle": "Mumu (Hồi ức)"
				},
				{
					"id": 111130408,
					"content": "Bạn trêu tớ à, chứ bạn thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130409
					],
					"speakerTitle": "Wu (Hồi ức)"
				},
				{
					"id": 111130409,
					"content": "Đương nhiên là kiếm tiền rồi! Kinh doanh lớn kiếm thật nhiều tiền! Chờ có tiền rồi muốn làm gì cũng được, vui biết bao nhiêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130410
					],
					"speakerTitle": "Mumu (Hồi ức)"
				},
				{
					"id": 111130410,
					"content": "Đúng vậy, có tiền rồi thì mấy hộp đồ chơi siêu đắt đỏ đó, muốn mua lúc nào chẳng được, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130411
					],
					"speakerTitle": "Meng (Hồi ức)"
				},
				{
					"id": 111130411,
					"content": "Không những mua, mà còn mỗi người một cái, à không, một người mấy cái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130412
					],
					"speakerTitle": "Mumu (Hồi ức)"
				},
				{
					"id": 111130412,
					"content": "Nếu Mumu đã làm thương nhân thì tớ không cần kiếm tiền nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130413
					],
					"speakerTitle": "Congzi (Hồi ức)"
				},
				{
					"id": 111130413,
					"content": "Không được không được, kiếm tiền rất cực khổ, đừng chỉ trông chờ vào một mình tớ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130414
					],
					"speakerTitle": "Mumu (Hồi ức)"
				},
				{
					"id": 111130414,
					"content": "Sau này tớ muốn học làm đèn Minh Tiêu, loại kích cỡ to thật to ấy. Học cả đèn tiêu nữa, tớ sẽ là thợ thủ công giỏi nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130415
					],
					"speakerTitle": "Congzi (Hồi ức)"
				},
				{
					"id": 111130415,
					"content": "Đúng thế, vậy thì chúng ta không cần đến Liyue cũng có thể thả đèn chơi lễ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130416
					],
					"speakerTitle": "Big G (Hồi ức)"
				},
				{
					"id": 111130416,
					"content": "Còn Lão Meng, Big G thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130417
					],
					"speakerTitle": "Wu (Hồi ức)"
				},
				{
					"id": 111130417,
					"content": "Tôi hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130418
					],
					"speakerTitle": "Big G (Hồi ức)"
				},
				{
					"id": 111130418,
					"content": "Ủa, họ biến mất rồi, không nghe được thứ mấu chốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130419,
					"content": "Đây là tết hải đăng cuối cùng mà năm người chúng tôi ở cùng nhau, nhớ thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130420
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130420,
					"content": "Đã qua lâu lắm rồi, mọi người đều trưởng thành cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130421
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130421,
					"content": "Không biết nguyện vọng năm đó, có thật sự thành hiện thực hay chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130422,
						111130423
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130422,
					"content": "Thành hiện thực rồi đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				},
				{
					"id": 111130424,
					"content": "Chúng tôi đã đi tìm ba người bọn họ, mang tín vật về này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130425,
					"content": "Wu đã làm bếp trưởng, Mumu là thương nhân, Congzi cũng trở thành thợ thủ công đèn tiêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130426,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130427
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130427,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130428
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130428,
					"content": "Những lời nói ra lúc ấy, chúng tôi đều khắc ghi trong lòng, coi nó như là một lời hứa, cho dù vật đổi sao dời cũng phải cố gắng hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130429
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130429,
					"content": "Dù sao đi nữa, thả ngọn đèn này lên trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130430
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130430,
					"content": "#Này, {NICKNAME}, đừng có không hiểu chuyện vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130431
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130431,
					"content": "Chỗ họ đang ôn lại chuyện cũ, chúng ta cứ đứng xa xa nói chuyện thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130423,
					"content": "Tôi sẽ chứng minh cho bạn thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				}
			]
		},
		{
			"id": 1111305,
			"completionStepIds": [
				1111305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111305",
							"2"
						],
						"stepId": 1111305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130501,
					"content": "Nói bọn tôi không hiểu chuyện à, rõ ràng bạn mới là người không hiểu nhân tình thế thái nhất đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130502,
						111130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130502,
					"content": "Không phải cần duy trì \"ranh giới\" sinh tử sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130503
					]
				},
				{
					"id": 111130503,
					"content": "Lão Meng là người đã vượt qua \"ranh giới\", chỉ có thể đưa bạn ấy về như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130506,
					"content": "Tôi đã từng nói, Vãng Sinh Đường ban đầu không phải là nơi tổ chức tang lễ, mà phụ trách một công việc tương tự như bác sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130507
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130507,
					"content": "Trong thời kỳ chiến tranh Ma Thần, máu chảy thành sông, sinh linh đồ thán, dịch bệnh khắp nơi, \"cái chết\" điên cuồng gặm nhấm thế giới của loài người chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130508
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130508,
					"content": "Vào lúc đó, Vãng Sinh Đường được thành lập, lấy danh nghĩa của nhân loại nhỏ bé, dùng thời gian dài đằng đẵng để đuổi \"cái chết\" trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130509
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130509,
					"content": "Có lẽ họ đã phải trả cái giá rất đắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130510,
					"content": "Sau một thời gian dài, Liyue trở thành trung tâm phồn vinh thịnh vượng, mọi người ai cũng theo đuổi danh vọng và Mora. Và đến một ngày, một số kẻ mất trí đã khuấy động \"di sản\" của cái chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130511
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130511,
					"content": "Tàn dư Ma Thần tàn sát thế gian, cụ thể thế nào tôi cũng không nhắc nữa, nhưng chung quy, vào thời khắc đó, \"sự sống\" như bị treo trên bờ vực tuyệt chủng, còn \"cái chết\" là sự đáp trả chực chờ dưới đáy vực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130512
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130512,
					"content": "Lâu thật lâu sau đó, sự cân bằng được khôi phục, ranh giới phân chia rạch ròi, mới có Liyue như ngày hôm nay, mới có Vãng Sinh Đường mà các bạn nhìn thấy, và mới có...tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130513,
						111130515
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130513,
					"content": "Thì ra bạn cũng biết kể chuyện nghiêm túc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130514
					]
				},
				{
					"id": 111130514,
					"content": "Ha ha ha, đây là câu chuyện dài mà lão đường chủ thích nhất, tôi cảm thấy tôi kể còn hay hơn bọn họ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130517,
					"content": "Hiểu được bao nhiêu thì tùy, nhưng tôi mong là các bạn không hiểu gì cả, Vãng Sinh Đường kinh doanh việc tang lễ, chỉ thế thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130518,
						111130519
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130518,
					"content": "Có lẽ như vậy là tốt nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130520,
					"content": "Chúng ta may mắn vì sống trong thời đại sự sống và cái chết có thể cùng tồn tại hòa bình, nhưng chuyện gì cũng có cái giá của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130521
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130521,
					"content": "Phù, gần đến giờ rồi, chúng ta đi thôi! Đưa họ đến \"nơi bắt đầu và an nghỉ\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130522
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130522,
					"content": "Đó là nơi nào thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130523,
					"content": "Là nơi mà chúng ta thấy lúc đầu đấy. Tôi tự đặt tên bừa đó, đừng có cái gì cũng hỏi như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130519,
					"content": "Ừ, đã đến lúc trở về rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130515,
					"content": "Kể thêm nữa được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130516
					]
				},
				{
					"id": 111130516,
					"content": "Không! Bạn hiếu kỳ thật đấy, đừng quên lời tôi dặn, việc gì không cần biết thì tốt nhất đừng nên biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130504,
					"content": "Vãng Sinh Đường thật quá khác so với tưởng tượng của tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130505
					]
				},
				{
					"id": 111130505,
					"content": "Vậy sao? Chỉ cần đạt được mục tiêu thì làm gì và làm như thế nào cũng không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "Hu Tao"
				}
			]
		},
