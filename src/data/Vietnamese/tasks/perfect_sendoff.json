			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130101,
					"content": "A...! Về rồi à? Nhanh hơn tôi tưởng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130102,
					"content": "Paimon, bạn không lỡ miệng để lộ gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130103
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130103,
					"content": "Trông tôi không đáng tin thế sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130104,
					"content": "Hi hi, đùa thôi, thực ra chẳng sao cả, họ đồng ý đưa tín vật, chứng tỏ ít nhiều đã đoán được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130105,
					"content": "Tuy nhiên, cho dù xảy ra chuyện gì, thì những chuyện liên quan đến âm hồn và vong hồn đều kỳ lạ, đồng thời cũng không kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130106,
					"content": "Họ không muốn truy hỏi đến cùng chắc cũng vì nguyên nhân này. Nếu thật sự dám theo đến đây, có thể sẽ... chạm đến giới hạn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130107,
						111130108
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130107,
					"content": "Nghe ghê quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				},
				{
					"id": 111130109,
					"content": "\"Duy trì ranh giới sinh tử\", là công việc quan trọng của Vãng Sinh Đường, tôi cũng sẽ chăm chỉ hơn bình thường một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130110,
					"content": "Vậy ra chúng tôi là trường hợp đặc biệt sao? Vượt qua \"ranh giới\" này cũng không hề hấn gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130111,
					"content": "Đương nhiên, dù sao các bạn cũng đã bị cuốn vào rồi, cũng như Lão Meng, để các bạn nhìn thêm nhiều một chút cũng chẳng sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130112
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130112,
					"content": "Nơi phải đến tiếp theo, cho dù nhìn thấy gì, xảy ra những gì, cũng đừng kinh ngạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130113
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130113,
					"content": "Đó là một khu vực rất bình thường nằm ở ranh giới sinh tử. Có lẽ, nó đặc biệt ở chỗ không được để ai biết đến mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130114,
					"content": "Nhớ đừng hoảng sợ nhé. Nếu không trước khi trở ra, tôi sẽ phải xóa ký ức của hai bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130115
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130115,
					"content": "Đi thôi! Biết nghe lời sẽ tốt cho tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130116,
					"content": "Có...có chút sợ rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130117,
					"content": "Nhưng cũng như Hu Tao nói, chúng ta đã bị cuốn vào, thì cứ đi đến cùng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130108,
					"content": "Bạn đang nghiêm túc hay nói đùa đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				}
			]
		},
		{
			"id": 1111302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
