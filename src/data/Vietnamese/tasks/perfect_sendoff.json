			"dialogs": [
				{
					"id": 111131101,
					"content": "Bạn là người mới đến sao? Trùng hợp nhỉ, tôi cũng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131102
					],
					"speakerTitle": "Zhu Ming"
				},
				{
					"id": 111131102,
					"content": "Không ngờ phong cảnh ở đây lại đẹp đến thế! Tôi cứ tưởng là tối đen lạnh lẽo, không phân biệt được phương hướng cơ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131103
					],
					"speakerTitle": "Zhu Ming"
				},
				{
					"id": 111131103,
					"content": "Có thể ở đây cân bằng lại cảm xúc thì quá tuyệt vời. Ha ha, có lẽ vì tôi vốn không mong chờ gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhu Ming"
				}
			]
		},
