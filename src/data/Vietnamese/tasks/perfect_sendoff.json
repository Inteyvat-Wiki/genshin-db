			},
			"dialogs": [
				{
					"id": 111130701,
					"content": "Big G, bây giờ chắc bạn đã yên lòng rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130702
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130702,
					"content": "Nếu sau này bạn lại suy nghĩ lệch lạc, trở thành ác quỷ, tôi sẽ không niệm tình cũ mà tiêu diệt bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130703
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130703,
					"content": "Không đâu không đâu, mọi người đã vì tôi mà làm nhiều thứ như vậy, tôi đã mãn nguyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130704
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130704,
					"content": "Biết mọi người đang sống tốt là được, tôi cũng không muốn làm phiền họ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130705
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130705,
					"content": "Tôi cũng phải cám ơn các bạn, xem như ước mơ của tôi đã trọn vẹn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130706
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130706,
					"content": "Lời vừa nãy cũng gửi đến bạn đấy, Lão Meng, nếu sau này vẫn không chịu từ bỏ, tôi sẽ cho các bạn đoàn tụ sớm một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130707
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130707,
					"content": "Không đâu... đừng có vừa cười vừa nói những chuyện đáng sợ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130708
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130708,
					"content": "Ha ha ha, vậy thì, mỗi người hãy gửi lời từ biệt cho Big G đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130709
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130709,
					"content": "Hẹn gặp lại, Big G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130710,
					"content": "Không đúng không đúng, không được \"hẹn gặp lại\", phải là \"tạm biệt\" mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130711
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130711,
					"content": "Hahaha, không sao đâu, tôi âm thầm rời khỏi là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130712
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130712,
					"content": "Xin lỗi, chỉ có nguyện vọng mà chúng ta nói ra lúc đó là không thực hiện được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130713
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130713,
					"content": "Không sao đâu, cuộc sống lúc nào cũng có điều nuối tiếc mà, bạn hãy yên tâm lên đường đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130714
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130714,
					"content": "Ừm, tôi sẽ nhớ mọi người, tạm biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130715
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130715,
					"content": "Đi mất rồi, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130716
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130716,
					"content": "Cũng giống như đã kết thúc một chuyện lớn của đời người, cảm thấy trong lòng thật trống rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130717
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130717,
					"content": "Trước đây chưa từng nghe nguyện vọng của hai bạn là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130718,
					"content": "\"Sau khi thành gia lập thất, hai nhà sẽ cùng nhau dự Tết Hải Đăng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130719
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130719,
					"content": "Vì vậy tôi rất ngưỡng mộ bạn bè, Wu vẫn còn cơ hội để thực hiện ước mơ, còn ước mơ của tôi vẫn chỉ là ước mơ mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130720,
						111130721
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130720,
					"content": "Bạn nên nghĩ thoáng một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				},
				{
					"id": 111130722,
					"content": "Đúng rồi đó, vả lại, bạn cứ nghĩ thế này, ai rồi cũng sẽ về với cát bụi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130723
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130723,
					"content": "Vì vậy lúc còn sống hãy sống hết mình, khi đã làm xong trách nhiệm lúc sống mà vẫn còn có thể gặp được người muốn gặp, đó chẳng phải là một chuyện tốt đẹp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130724
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130724,
					"content": "Hic... cám, cám ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130725
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130725,
					"content": "Tóm lại sau này tôi sẽ không về Dốc Vô Vọng nữa, tôi cũng phải cân bằng lại cảm xúc của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130726
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130726,
					"content": "Vậy thì nhân cơ hội này đi chơi đi, tôi duyệt phép rồi. À, đương nhiên là sẽ không có tiền công, giống như bây giờ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130727
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130727,
					"content": "Nhưng hình như quên mất việc gì rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130728,
					"content": "Bạn đã hứa là sẽ \"tìm người\" giúp chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130729
					]
				},
				{
					"id": 111130729,
					"content": "Ể? Tôi đưa các bạn đến \"ranh giới\" là muốn để hai bạn tìm thử đó. Nhưng nhìn phản ứng này, chắc là không tìm được rồi, thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130730
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130730,
					"content": "Hứ, tiếc gì mà tiếc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130731,
					"content": "Ha ha ha, tôi cũng đã dùng một số biện pháp mà các bạn không cần biết, để giúp các bạn tìm thử rồi. Nhưng tiếc là cũng không tìm được manh mối gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130732
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130732,
					"content": "Sau này tôi cũng sẽ lưu ý đến vấn đề này, nếu có manh mối gì mới, tôi sẽ đến tìm bạn ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130733
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130733,
					"content": "Nghe như bạn chỉ nói suông thế thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130734,
					"content": "Hi hi, dù sao thì việc tìm người sống đâu phải sở trường của tôi, nếu bảo tôi tìm người ở bên kia \"ranh giới\" thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130735
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130735,
					"content": "Đừng nói những thứ đáng sợ như thế nữa...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130736,
					"content": "Yên tâm yên tâm, tôi sẽ giúp các bạn tìm người đó. Thiệt tình, đến lúc nào mọi người mới hiểu được những lời nói đùa của tôi vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130737,
						111130738
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130737,
					"content": "Bạn có vẻ rất yêu thích công việc này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130739,
					"content": "Ha ha...tôi cũng có lý do của riêng tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130740
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130740,
					"content": "Lý do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130741,
					"content": "Nơi mà chúng ta đã đến, những người mà chúng ta đã gặp hôm nay đều là người chết vẫn còn chấp niệm với thế giới người sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130742
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130742,
					"content": "Nhưng ở nơi này, tôi không hề nhìn thấy \"đường chủ\" của các đời trước... dù chỉ một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130743
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130743,
					"content": "Điều đó cho thấy, trở thành đường chủ của Vãng Sinh Đường là một việc vô cùng đúng đắn với họ và khiến họ không phải nuối tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130738,
					"content": "Cảm thấy bạn rất hợp làm đường chủ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130721,
					"content": "Đời còn dài.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				}
			]
		},
