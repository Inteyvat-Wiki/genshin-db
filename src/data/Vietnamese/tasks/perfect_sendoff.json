			"dialogs": [
				{
					"id": 111131001,
					"content": "Các bạn là... khách tham quan? Xin lỗi, tôi có hơi bất ngờ một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131002
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131002,
					"content": "Thấy Hu Tao đưa các bạn đến thì tôi cũng yên tâm rồi, nhưng nơi này không có gì hết, khó lòng tiếp đãi chu đáo được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131003
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131003,
					"content": "Bạn là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111131004
					]
				},
				{
					"id": 111131004,
					"content": "Tôi là Lanxi, tôi đã ở đây chờ một người từ rất lâu rồi, đến nỗi không còn nhớ chính xác là bao lâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131005
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131005,
					"content": "Ai cũng nói cảm giác chờ đợi rất khó chịu, nhưng nếu cứ tĩnh tâm đi dạo, nhìn ngắm, trò chuyện với người mới bạn cũ, thì cũng xem như có thể giết thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131006
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131006,
					"content": "Nếu cứ tiếp tục chờ đợi thì có kết quả gì không? Hay cũng chỉ là phí công vô ích?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131007
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131007,
					"content": "Sao cũng được, vì tôi chỉ có thể tiếp tục chờ đợi mà thôi. Nhưng nếu bạn đang tìm một người quan trọng với mình, thì tốt nhất đừng nên ngồi chờ mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanxi"
				}
			]
		},
