				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#Araminali nghe nói, Nara {NICKNAME} đã \"trổ tài\" ở Vana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000302,
					"content": "#\"Báu vật\" đã cho vào trong \"rương\", Nara {NICKNAME} có thể mở \"rương báu\", \"không cần khách sáo\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#Nara {NICKNAME} và cả Paimon nữa, chậm quá! \"Rương báu\" của Araminali đã chuẩn bị xong từ lâu rồi, đã cùng Araminali chờ lâu lắm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000402,
					"content": "Bạn tốt của Aranara, \"rương báu\" đã đầy rồi, có thể mở ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#Rất nhiều Aranara nói với Araminali, Nara {NICKNAME} và Paimon đã làm rất nhiều việc tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000502,
					"content": "Araminali đã biết từ lâu, những lời khen ngợi kia vượt qua nhánh cây vươn mình trong rừng, lội qua dòng nước chảy róc rách, theo những cơn gió nhẹ thổi vào \"mái ấm vui vẻ\" của Araminali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000503,
					"content": "#Vậy nên lần này, Araminali chất đầy \"rương\", chờ Nara {NICKNAME} đến mở ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000504,
					"content": "#Aranimba mang về một ít thứ lấp lánh, Araminali nhét hết cả vào \"rương\", có lẽ Nara {NICKNAME} sẽ thích?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000505,
					"content": "Aranimba vẫn chưa về sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "Ừ, Aranimba không giống cây to với bộ rễ đâm sâu, Aranimba là Aranara không thể dừng chân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000507,
					"content": "Ôi... Araminali ở đây một mình không thấy cô đơn ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000508,
					"content": "\"Cô đơn\" là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000509,
					"content": "Ừm... Thì là cảm giác khi chỉ có một mình, rất muốn có bạn bè ở bên đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000510,
					"content": "Vanarana có rất nhiều Aranara, thế nên Araminali không hề \"cô đơn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000511,
					"content": "Nhưng mà, Arayama và Aranimba đều không có ở Vanarana. Trước kia, ba Aranara ở cạnh nhau, dù làm gì cũng rất vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000512,
					"content": "Ararakalari của Arayama rất mạnh, Nara yếu quá sẽ không thể phá giải. Aranimba vẽ giỏi nên vẽ nhiều thứ đẹp lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000513,
					"content": "Nhưng giờ chỉ có Araminali và \"rương báu\" của Araminali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000514,
					"content": "Araminali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000515,
					"content": "Không sao, Araminali có rất nhiều \"rương báu\", dù không biết sao Nara lại thích mở rương như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000516,
					"content": "Nhưng Araminali là chủ nhân của \"rương báu\", Nara thích rương báu cũng sẽ thích Araminali, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000517,
					"content": "Nhưng Araminali không có nhiều \"báu vật\" nữa,... \"rương\" phải sống với cái bụng rỗng một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000518,
					"content": "#Mặc dù \"rương báu\" của Araminali sau này sẽ trống, Nara {NICKNAME} vẫn phải làm bạn tốt của Aranara đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
