			"dialogs": [
				{
					"id": 731000601,
					"content": "#Araminali vẫn chưa chuẩn bị xong! \"Rương báu\" cũng chưa ăn no. Nara {NICKNAME} và Paimon có thể \"lêu lổng ham chơi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000602,
					"content": "À, không đúng, là \"dạo chơi khắp nơi\". Như vậy, biết đâu sẽ gặp được Aranara cần giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
