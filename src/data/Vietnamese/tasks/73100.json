			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#Nara {NICKNAME} muốn mở \"rương báu\" sao? Nhưng mà... Vana còn có rất nhiều Aranara cần giúp đỡ. Nếu Nara Vàng có thể hỗ trợ những Aranara này thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000102,
					"content": "Araminali sẽ chuẩn bị xong \"rương báu\" đầy ắp! Kể cả \"báu vật\" Aranimba mang về, cho \"rương\" ăn no nê luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"2"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Nara Vàng, Araminali biết bạn là Nara tốt trợ giúp Aranara. Thế nên, \"rương báu\" của Araminali sẽ cho Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
