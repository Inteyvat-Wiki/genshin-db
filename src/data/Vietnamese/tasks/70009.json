			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "Chú ơi, người Fatui có đón Lễ Hội Hoa Gió không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090102,
					"content": "Ồ, chắc chú không qua được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090103,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "Í? Sao lại là bạn, ê này, bạn đang nghi ngờ gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090105,
					"content": "Tôi ở đây nói chuyện với đứa bé này, cũng không làm chuyện xấu gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090106,
					"content": "Xem ra Fatui thật sự không tham gia Lễ Hội Hoa Gió.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "#{F#Chị}{M#Anh} cũng không... đón Lễ Hội Hoa Gió à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090108,
					"content": "Haiz, đúng vậy, Kỵ Sĩ Danh Dự của Thành Mondstadt này sao có thể đón Lễ Hội Hoa Gió chứ, chắc chắn phải đi làm nhiệm vụ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090109,
					"content": "Sao bạn lại đắc ý vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "Khụ... Khụ, bỏ đi, không nói nhiều với bạn nữa, tôi thấy bạn cũng rảnh rỗi, hay là giúp tôi một việc đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090111,
					"content": "Bố mẹ của đứa bé này vì bận rộn cho lễ hội mà phải đi ra ngoài mua chút đồ, nên để nó ở đây, nhờ tu nữ chăm sóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090112,
					"content": "Nhưng bạn cũng biết đó, Lễ Hội Hoa Gió mà, trong thành ngoài thành đều bận rộn, các tu nữ cũng bận việc của họ, không có thời gian chơi với đứa bé này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090113,
					"content": "Cho nên cô bé cứ quấn lấy tôi và đòi tôi chơi cùng, nhưng bạn cũng biết đó, tôi không thể ra khỏi Giáo Đường được. Cho nên tôi cũng chỉ có thể ở đây nói chuyện với cô bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090114,
					"content": "Rất tiếc tôi là một Fatui, dù chỉ là nói chuyện thì tu nữ bên kia cũng đang nhìn chằm chằm vào tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090115,
					"content": "Tôi nghĩ chắc cô ấy nghĩ rằng Fatui tôi đây có ý đồ xấu và muốn làm chuyện xấu xa gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090116,
					"content": "Hừm, để không cho tu nữ đó đến làm phiền tôi, và cũng là vì \"sức khỏe thể chất và tinh thần\" của đứa trẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090117,
					"content": "Tôi muốn nhờ Kỵ Sĩ Danh Dự đáng kính như bạn chơi cùng cô bé, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090118,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "Ồ, dứt khoát vậy sao. Không hổ là Kỵ Sĩ Danh Dự mà, tôi còn tưởng bạn sẽ trả giá dây dưa, muốn chọn thù lao gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090120,
					"content": "Mau đưa đứa trẻ ra ngoài chơi đi, tôi sẽ ở lại đây để chịu đựng ánh mắt của những tu nữ kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090121,
					"content": "Haiz, rốt cuộc những ngày tháng này đến khi nào mới kết thúc đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090122,
					"content": "Bạn thật sự muốn Lily có thể ra bên ngoài chơi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "Bạn... Bỏ đi, tôi là Fatui, là người xấu, biết chưa? Sao có thể có lòng tốt như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090124,
					"content": "Ôi thôi được rồi được rồi, bạn mau đưa đứa trẻ này đi chơi đi, tôi thấy cô bé sắp chết ngạt trong Giáo Đường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090125,
					"content": "Còn tôi... Tôi sẽ tiếp tục ở lại đây và chịu đựng ánh mắt của những tu nữ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090126,
					"content": "Haiz, rốt cuộc những ngày tháng này đến khi nào mới kết thúc đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 7000902,
			"completionStepIds": [
				7000904
