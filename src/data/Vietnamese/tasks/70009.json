				"objectNames": [
					"Lily"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "#{F#Chị}{M#Anh}, tại sao chú người Fatui kia không đón Lễ Hội Hoa Gió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090202,
					"content": "Chú ấy có việc quan trọng phải làm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "Công việc quan trọng? Ồ...quan trọng hơn cả việc đón Lễ Hội Hoa Gió à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090207,
					"content": "Nhưng mà, chú Fatui đó cho dù có làm bao nhiêu việc xấu, chỉ cần sửa đổi, chú ấy cũng có thể trở nên rất tốt đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090208,
					"content": "Ừm! Em phải đi nói với chú ấy, chỉ cần trở nên tốt thì có thể chơi Lễ Hội Hoa Gió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090209,
					"content": "Chú ấy bây giờ đang bận, chúng ta ra ngoài chơi đi, được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "#Haiz... Thôi được. {F#Chị}{M#Anh} có thể đưa em ra ngoài chơi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090211,
					"content": "Không thành vấn đề, đừng đi quá xa là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "Vậy chúng ta mau đi chơi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090204,
					"content": "Có lẽ Fatui không thể tham gia Lễ Hội Hoa Gió.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "Tại sao vậy? Có phải là vì... Người Fatui rất xấu rất xấu? Bố nói họ đi ngủ không đánh răng, ăn cơm thì dùng tay bốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090206,
					"content": "Nhưng như vậy thì không tốt, chú Fatui sẽ giận đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Blanche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "Nhà Lữ Hành? Có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090303,
					"content": "Còn... Lily nữa? Sao em lại đến đây, ba và mẹ của em đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090304,
					"content": "#Ba và mẹ có chuyện rất quan trọng phải làm! Nên {F#chị}{M#anh} đang chơi cùng em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090305,
