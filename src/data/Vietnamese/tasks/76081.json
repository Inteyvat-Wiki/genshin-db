				]
			},
			"dialogs": [
				{
					"id": 760810101,
					"content": "Tôi nghe nói Starshyna huyền thoại Sigurd, người đã hy sinh trong trận chiến thường sử dụng trường kiếm, kỹ xảo áp chế ma vật cũng là độc nhất vô nhị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810102,
					"content": "Sau trận đại chiến, tổng bộ không thể tìm thấy di hài của anh ấy, thế nên đã lập cho anh ấy ngôi mộ trống này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810103,
					"content": "Ánh kiếm màu tím, mái tóc màu vàng... Chiến binh lang thang khắp nơi đối đầu với Cuộc Săn Hoang Dã đó chính là anh ấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810104,
					"content": "Xem ra linh hồn anh ấy không thể yên nghỉ trong quan tài, giống như vô số oan hồn ở Nghĩa Trang Đêm Cuối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810105,
					"content": "Vị anh hùng đã cầm kiếm xua đuổi Cuộc Săn Hoang Dã, dù đã chết nhưng chấp niệm vẫn không tắt, vẫn đang chiến đấu với chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810106,
					"content": "Anh xứng đáng nhận được sự kính trọng của tôi, anh Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810107,
					"content": "Nhưng với một chiến sĩ, nếu chỉ chiến đấu vì thù hận và trách nhiệm, thì sự cô đơn này thật quá tàn nhẫn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810108,
					"content": "Anh có nhớ những ngày tháng kề vai sát cánh với người khác không? Giờ đây ngoài việc giết địch, liệu anh còn có lý do khác để vung kiếm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810109,
					"content": "Nếu có thì hãy hiện thân trước mặt tôi, tại sao không cùng tôi so tài một trận? Giống như những cuộc so tài thường có giữa các Người Giữ Đèn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608102,
