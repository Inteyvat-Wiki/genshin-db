				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "Ngài Sigurd, ngài là ân nhân của tôi. Nếu năm đó không có ngài dẫn dắt Người Giữ Đèn đến phía Nam chống địch, có lẽ tôi đã sớm mất mạng mà chẳng biết vì sao, có khi chẳng biết xương cốt chôn vùi nơi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810302,
					"content": "Nhưng tại sao linh hồn của ngài vẫn chưa được yên nghỉ, vẫn cứ lang thang khắp nơi và chiến đấu không ngừng như thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810303,
					"content": "Bị uế khí từ Cuộc Săn Hoang Dã vấy bẩn, đến cả thân thể cũng chia năm xẻ bảy... Xem ra như ngài chưa từng rời khỏi chiến trường đó, phải không? Đối với ngài, cuộc chiến vẫn chưa kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810304,
					"content": "Về điểm này, có lẽ tôi cũng giống như ngài. Chỉ đến khi Cuộc Săn Hoang Dã hoàn toàn biến mất, chúng ta mới có thể tìm thấy sự bình yên thực sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810305,
					"content": "Thật vinh dự khi được gặp, ngài Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810306,
					"content": "Tôi hiểu rồi, đối với Người Giữ Đèn, cách giao tiếp tốt nhất chính là cùng đấu kiếm một phen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810307,
					"content": "Vậy hãy để tôi cho ngài thấy sức mạnh của thế hệ Người Giữ Đèn mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
