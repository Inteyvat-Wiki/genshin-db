			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "Trận đấu với anh thật sảng khoái, Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Kết cục của anh hùng lại là như vậy, quả thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "Cô độc lang thang trên vùng đất mà anh đã cống hiến và hy sinh mạng sống... Vào ngày hưởng ứng lời thề của Người Giữ Đèn, anh có dự đoán được hôm nay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Cho dù có thì chắc anh cũng sẽ không do dự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "Sau này tôi sẽ lại đến thăm anh. Tạm biệt, Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
