			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Cảm ơn đã nhường, ngài Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "Xin hãy yên tâm, sau khi các vị hi sinh, cha tôi Nikita đã trở thành tân Starshyna. Ông ấy đã dẫn dắt những người từng được các vị cứu giúp để tái thiết Người Giữ Đèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Giờ đây, sức mạnh của chúng tôi đã đủ lớn để bảo vệ vùng đất thanh bình này khỏi bóng tối của Cuộc Săn Hoang Dã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Sự cống hiến của các vị không hề vô nghĩa, những chiến tích và ý chí của các vị chưa từng và sẽ không bao giờ bị lãng quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Tạm biệt, ngài Sigurd. Tôi sẽ thường xuyên đến thăm viếng, mong ngài được an nghỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "Cách áp chế ma vật này... Không đúng, nhân vật huyền thoại đó đáng lẽ đã hy sinh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "Lẽ nào anh ấy đã tỉnh lại bằng một cách nào đó sao? Nếu có thời gian phải đến bãi biển phía đông bắc Đồng Hoang Xương Rêu một chuyến, mộ của anh ấy ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "Tôi đã từng nghe bố già kể về những chiến tích của Starshyna huyền thoại Sigurd, người từng sát cánh chiến đấu với ông ấy trong quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "Ánh kiếm màu tím, mái tóc vàng óng... Giống hệt như trong truyền thuyết, người mà mình gặp thời gian qua không lẽ chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "Bãi biển phía đông bắc của Đồng Hoang Xương Rêu là nơi chôn cất của ngài ấy, khi nào có thời gian mình sẽ đến đó thăm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}