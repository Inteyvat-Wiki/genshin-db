			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "Được rồi, tiếp theo là tay phải... tình hình có vẻ cũng ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010102,
					"content": "Nhưng vẫn phải cẩn thận nhé, được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010103,
					"content": "Em biết rồi. À đúng rồi, em vẫn chưa lấy được lộ trình tuần tra của ngày hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010104,
					"content": "Lộ trình hôm nay rất xa, em không cần phải đi chung với thầy đâu, có khả năng sẽ có một số thứ xuất hiện trên đường nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010105,
					"content": "Em cũng có Vision mà, nhưng lại không thể giúp được gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010106,
					"content": "Đừng nói chuyện này chứ, đây không phải là chuyện mà em cần phải suy nghĩ bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010107,
					"content": "Hai người đến rồi sao, sức khỏe vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010108,
					"content": "Có việc gì cần giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "Ừm, nếu như đã ở lại đây rồi thì chúng tôi cũng cần phải tìm việc gì đó để làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010110,
					"content": "Hai người không phải là người thích rảnh rỗi nhỉ? Được rồi, nếu vậy thì hôm nay Collei sẽ dẫn hai người đi tuần tra phía nam Làng Gandharva nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010111,
					"content": "Nếu còn đủ sức thì việc vệ sinh Thất Thiên Thần Tượng giao cho hai người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010112,
					"content": "Anh Tighnari, chúng tôi đã chuẩn bị xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Amir"
				},
				{
					"id": 30010113,
					"content": "Tôi đến ngay... Giờ tôi phải vào rừng rồi, chuyện còn lại giao cho Collei hướng dẫn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010114,
					"content": "Dạ, thầy cứ yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010115,
					"content": "Collei, hôm nay chúng tôi cần phải làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010116,
					"content": "Ban nãy Tighnari nói là cần phải vệ sinh Thất Thiên Thần Tượng, nhưng mà đây cũng là việc của một nhân viên kiểm lâm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010117,
					"content": "Ừm, thực ra nội dung công việc của nhân viên kiểm lâm rộng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010118,
					"content": "Kiểm tra tình trạng đường xá, bảo vệ công trình trong rừng, phòng ngừa hỏa hoạn, giúp đỡ cư dân và lữ khách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010119,
					"content": "Nếu như là thầy thì lại còn phải thường xuyên đi vào những khu vực nguy hiểm trong rừng nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010120,
					"content": "Trước khi chúng ta đến Thất Thiên Thần Tượng thì đi kiểm tra những ngọn đèn ven đường trước vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "Thất Thiên Thần Tượng ở phía trên tảng đá to kia, các bạn trước đó đi từ đường này đến chắc là đã thấy qua rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010502,
					"content": "Vị trí có hơi cao đúng không? Nếu như bạn leo không nổi thì đừng miễn cưỡng quá, thầy sẽ không trách đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010503,
					"content": "Không sao, tôi rất giỏi leo trèo mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "Vậy sao, vậy thì giao cho bạn đó. Đất xung quanh tượng thần khá hẹp, ở trên đó cần phải cẩn thận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}, chúng ta lên đó thôi, tôi sẽ giúp bạn quét dọn những chỗ cao đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010507,
					"content": "À đúng rồi, Collei, bạn biết Thảo Thần là một vị thần như thế nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010508,
					"content": "Bạn hỏi \"Đại Vương {RUBY#[S]Vua Cây Từ Bi}Rukkhadevata\" hay là \"Tiểu Vươn{RUBY#[S]Vua Cỏ May Mắn}g Kusanali\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010509,
					"content": "Hả! \"Đại Vương Rukkhadevata\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010510,
					"content": "Không lẽ đó là tên của Thảo Thần đời trước sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010511,
					"content": "Đúng vậy. \"Đại Vương Rukkhadevata\" là Thảo Thần đời đầu của Sumeru. Cô ấy đã tạo ra rừng mưa, tạo ra Bức Tường Samiel ở ranh giới sa mạc, nên mọi người mới có được cuộc sống yên ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010512,
					"content": "Trong mắt người Sumeru, cô ấy là biểu tượng của sự thông minh, nhân từ và toàn năng. Thế nhưng cô ấy lại biến mất trong tai họa xảy ra vài trăm năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010513,
					"content": "(Giống như Raiden Makoto sao...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "Nghe thầy nói là sau này các hiền giả đã tìm được Thảo Thần đại nhân vừa chào đời, nên đã đưa cô ấy về Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010516,
					"content": "Để đón mừng việc có lại được thần linh, các hiền giả đã dùng danh xưng \"Tiểu Vương Kusanali\" để gọi cô ấy, đồng thời để cô ấy sống ở trong Thánh Địa Surasthana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010517,
					"content": "Ừm ừm, vậy sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010518,
					"content": "Sau đó, à ừm... tôi không rõ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010519,
					"content": "Hả, Collei cũng không rõ sao? Không lẽ Collei không phải là người Sumeru sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010520,
					"content": "Không, tôi đúng là người Sumeru, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010521,
					"content": "Do chúng tôi là người lạ nên có những chuyện không tiện nói sao? Nếu đúng là vậy thì không sao đâu, chúng tôi hiểu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010522,
					"content": "À không, Paimon hiểu lầm rồi, tôi không phải là muốn giấu gì cả. Hơn nữa các bạn cũng không phải là người xa lạ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010523,
					"content": "Cái này... hai bạn cũng quen biết Amber mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010524,
					"content": "Đợi đã, không lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010525,
					"content": "Kỵ Sĩ Trinh Thám của Đội Kỵ Sĩ Tây Phong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "Đúng vậy, chính là cô ấy! Tôi trước đây từng đến Mondstadt một thời gian, lúc đó cô ấy giúp đỡ tôi rất nhiều. Cho nên có thể nói cô ấy đã một phần nào đó thay đổi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010528,
					"content": "Amber rất lợi hại! Cô ấy yêu đời và yêu chính nghĩa, không những nhiệt tình mà lại còn tử tế nữa, cứ như là một ngọn lửa soi sáng cho người khác vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010529,
					"content": "Theo tôi thấy thì cô ấy là người thích hợp nhất để đảm nhiệm chức vụ Kỵ Sĩ Trinh Thám. Bởi vì mỗi một người khi đến Mondstadt đều có thể gặp được cô ấy đầu tiên, sau đó cảm nhận được sự nhiệt tình của cô ấy mà quý mến vùng đất đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010530,
					"content": "Ối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010531,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "Hmm, mặc dù cứ cảm thấy mục đích công việc của Kỵ Sĩ Trinh Thám không phải như vậy, nhưng tôi có một cảm giác rất sâu sắc, rằng Collei thật sự rất thích Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010534,
					"content": "Khụ... xin lỗi, ban nãy hình như tôi vừa nói những chuyện hơi kỳ lạ chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010535,
					"content": "Hihi, không sao, biết được Collei là bạn của Amber thì tôi lại càng có cảm giác thân thiết hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010536,
					"content": "Nhưng sao Collei lại biết chúng tôi quen Amber thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010537,
					"content": "À, là thế này, khi tôi quay về Sumeru, tôi đã luôn viết thư qua lại với Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010538,
					"content": "Cô ấy có nói trong thư là Thành Mondstadt bị một con rồng tấn công, nhưng đã được một nhà lữ hành tóc vàng và đồng đội bay bay cứu giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010539,
					"content": "Cho nên hôm qua khi tôi nhìn thấy các bạn là tôi đã nhận ra ngay. Nhưng do Nhà Lữ Hành vừa mới tỉnh lại nên tôi cũng ngại mở lời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010540,
					"content": "Thì ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010541,
					"content": "Ừm! Cho nên các bạn yên tâm, tôi rất tin tưởng các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010542,
					"content": "Tôi cũng rất muốn kể cho các bạn nghe những chuyện của Thảo Thần đại nhân, nhưng tôi đã lâu rồi không về Sumeru sống, cũng chẳng có đọc sách gì cả... cho nên xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010543,
					"content": "Không sao đâu, thông tin của Collei ban nãy cũng có giá trị lắm. Dẫu sao thì trước đây chúng tôi cũng không biết \"Đại Vương Rukkhadevata\" và \"Thánh Địa Surasthana\" là gì mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010544,
					"content": "Có thể giúp được cho hai bạn là tốt rồi. Nhưng tại sao các bạn lại muốn nghe thông tin về Thảo Thần nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010545,
					"content": "Nói mục đích chuyến đi cho Collei nghe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "Thì ra là vậy, cảm ơn các bạn đã nói cho tôi nghe chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010547,
					"content": "Không cần khách sáo, chúng ta là bạn bè mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010548,
					"content": "Paimon nói đúng đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "Được rồi, vậy bây giờ chúng ta đi lau dọn tượng thần đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010550,
					"content": "Ừm, vất vả cho các bạn rồi. Tôi sẽ đi kiểm tra lại tình trạng của mái hiên, một lúc sau chúng ta tập trung lại ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010532,
					"content": "Thì ra Collei có khía cạnh như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "Người thích bay nhất của Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(Cũng là vào khoảng thời gian Khaenri'ah sao...)",
