					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30011001,
					"content": "Hay quá! Là món gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011002,
					"content": "Paimon, giữ ý tứ chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011003
					]
				},
				{
					"id": 30011003,
					"content": "Có vấn đề gì chứ, Collei có phải người ngoài đâu. Hơn nữa, có thực khách nhiệt tình là niềm vui của đầu bếp mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011004,
					"content": "Hôm nay tôi có mang theo loại thức ăn thường dùng của nhân viên kiểm lâm, có tên là \"Bánh Túi\", không biết có hợp khẩu vị của các bạn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011005
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011005,
					"content": "Ối ối...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011006
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011006,
					"content": "Chết rồi, rơi xuống đất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011007,
					"content": "Không sao, tôi đã gói vài lớp giấy dầu ở bên ngoài rồi, không bị bẩn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011008
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011008,
					"content": "Phù... hết cả hồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011009,
					"content": "Cùng ăn với Collei...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30011010
					]
				},
				{
					"id": 30011010,
					"content": "Thật là ngon quá đi! Collei, tài làm bếp của bạn thật giỏi quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011011,
					"content": "May mà mỗi cái bánh đều được bạn gói cẩn thận, chứ không thôi là tối nay tôi đau lòng tới ngủ không được mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011012,
					"content": "Haha, chắc không khoa trương đến vậy đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011013
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011013,
					"content": "Nếu như các bạn thích thì để tôi chép lại một bản công thức cho các bạn. Yên tâm, tôi sẽ viết ý chính ra, đọc một lần là hiểu ngay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011014
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011014,
					"content": "Cảm ơn nhé Collei! Hihi, thật không ngờ một người nghiêm túc như bạn mà cũng có lúc vụng về nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011015,
					"content": "Haha, cũng có chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011016
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011016,
					"content": "Nhưng mà có phải Tighnari quản lý bạn chặt quá không? Đến đồ đạc cũng không cho bạn đụng vào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011017,
					"content": "#Tôi trong lúc đang bay đôi khi cũng đụng trúng mấy thứ trên bàn, nhưng {NICKNAME} trước giờ đều không có trách tôi, dẫu sao thì ai cũng có lúc không cẩn thận mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011018,
					"content": "Không, không phải thế! Nếu các bạn tiếp xúc với thầy lâu hơn thì sẽ phát hiện thầy là một người rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011019
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011019,
					"content": "Tôi nghe các tiền bối nói, thầy xuất thân từ một bộ tộc rất cổ xưa thần bí. Bộ tộc đó rất thông minh, đa số họ đều hơi lầm lì, nhưng thầy lại là một người rất nhiệt tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011020
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011020,
					"content": "Đúng rồi, các bạn có biết Giáo Viện không, hình như tên là Am... Amu gì đó ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011021
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011021,
					"content": "Nói chung thì thầy rất am hiểu về thực vật, các hiền giả ở Giáo Viện thường hay gửi thư đến để mời thầy đi nhậm chức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011022
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011022,
					"content": "Nhưng mà, thầy lại luôn lấy lý do là \"Thành Sumeru quá ồn ào, không tốt cho đôi tai\" để từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011023,
						30011026
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011023,
					"content": "Đúng là rất giống với những gì mà Tighnari sẽ nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011024
					]
				},
				{
					"id": 30011024,
					"content": "Haha, đúng vậy. Nhưng mà các hiền giả đại nhân khi đọc được thư chắc sẽ nổi giận mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011025
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011025,
					"content": "Rõ ràng là có thể đến Giáo Viện, nhưng thầy lại chọn làm đội trưởng kiểm lâm, mỗi ngày đứng ra giúp đỡ cư dân trong rừng mưa, lại còn dạy cho mọi người nhiều loại kiến thức nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011029,
					"content": "Đến cách làm Bánh Túi cũng là do thầy chỉ tôi làm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011030
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011030,
					"content": "Thật sao? Đúng là không nghĩ đến thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011031,
					"content": "Ừm... nhưng nói ra thì, hôm qua khi Tighnari phát hiện bạn ngất xỉu, đã không nói không rằng mà chữa trị cho bạn, lại còn cõng bạn về Làng Gandharva nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011032,
					"content": "Nhưng mà tôi vẫn cảm thấy bực mình, bởi vì suốt chặng đường anh ta cứ luôn miệng quở trách tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011033,
					"content": "Paimon đã làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011034
					]
				},
				{
					"id": 30011034,
					"content": "À, xin lỗi nhé, việc này đúng là thầy không đúng lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011035
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011035,
					"content": "#Bởi vì Paimon cứ luôn miệng nói \"Sao rồi sao rồi, {M#cậu ấy}{F#cô ấy} sẽ không chết chứ?\", khuyên thế nào cũng không được nên đã chọc giận thầy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011036
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011036,
					"content": "Này! Đáng ghét, cấm cười nhé! Còn không phải là do tôi quan tâm cho bạn hay sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011037
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011037,
					"content": "Hahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011038
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011038,
					"content": "Chuyện gì đây, đến cả Collei cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011039,
					"content": "Hừ, tức chết được! Tôi phải báo thù! Tôi sẽ cho đầu của hai người thành tổ quạ hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011040
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011040,
					"content": "Đừng đụng vào tôi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011041,
						30011042
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011041,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011043,
					"content": "Collei, xin lỗi nhé, tôi không phải cố ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011044
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011044,
					"content": "Tôi... ban nãy... không phải vậy, không phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011045
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011045,
					"content": "Collei sao rồi, vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011046,
					"content": "À... ừm, tôi không sao, không sao... Ngại quá, ban nãy làm các bạn giật mình rồi phải không, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011047
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011047,
					"content": "Phải rồi, cũng không còn sớm nữa, chúng ta phải về Làng Gandharva thôi, chắc nhóm của thầy cũng đã về rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011048
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011048,
					"content": "Ban nãy có chuyện gì vậy? Collei chạy nhanh quá, giờ không thấy đâu luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011042,
					"content": "Collei, sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011026,
					"content": "Đôi tai đó... rờ chắc thích lắm nhỉ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011027
					]
				},
				{
					"id": 30011027,
					"content": "Đúng vậy! Tôi cũng cảm thấy vậy đó... À ừm, khụ khụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011028
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011028,
					"content": "Nói chung thì thầy rõ ràng là có thể đến Giáo Viện, nhưng thầy lại chọn làm đội trưởng kiểm lâm, mỗi ngày đứng ra giúp đỡ cư dân trong rừng mưa, lại còn dạy cho mọi người nhiều loại kiến thức nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "Collei"
				}
			]
		},
