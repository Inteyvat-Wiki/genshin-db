				},
				{
					"id": 30010805,
					"content": "Kể cho Collei nghe chuyện ban nãy...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010806
					]
				},
				{
					"id": 30010806,
					"content": "Ồ, kỳ diệu thật, nghe như là những sinh vật huyền thoại mà các bạn nhỏ hay nói đến vậy. Để lần sau tôi hỏi han giùm các bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010807
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010807,
					"content": "À, các bạn có đói không? Tôi có mang theo nước và thức ăn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
