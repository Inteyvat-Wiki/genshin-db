			"dialogs": [
				{
					"id": 30010901,
					"content": "Collei, chúng tôi về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010902,
					"content": "Vất vả rồi, trèo lên trèo xuống như vậy chắc là mệt lắm đúng không. Chúng ta nghỉ ngơi ở đây chút nhé. Tôi có mang theo nước và thức ăn này.",
					"roleType": "TALK_ROLE_NPC",
