			"dialogs": [
				{
					"id": 733430101,
					"content": "Wa, Sorush lợi hại thật, trong chốc lát đã khiến xung quanh tràn trề sức sống rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430102,
					"content": "Sức mạnh của Pari thật kỳ diệu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430103
					]
				},
				{
					"id": 733430103,
					"content": "Cứ làm quá lên! Với uy lực của ta thì cứu rỗi Hoa Sunyata chẳng qua chỉ là chuyện dễ như trở bàn tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430104
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430104,
					"content": "Sự xâm nhập đen tối vẫn còn đang lan rộng, Hoa Sunyata ở đây chỉ là một trong những nạn nhân của nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430105
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430105,
					"content": "Thật ra những hồ hoa khác cũng không may mắn thoát nạn đâu, chắc Sefana lúc này đang rất bận rộn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430106
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430106,
					"content": "Nghe có vẻ như Sefana mà cô nói chắc là một Pari tốt đang hết lòng chăm sóc hoa cỏ phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430107,
					"content": "#Chúng ta hãy giúp Pari đó đi nhé, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430108,
					"content": "Chút công trạng này, xem như một chút tô điểm cho sự nghiệp vĩ đại cũng hay. Yasnapati của ta, hãy chú ý những Hoa Sunyata thế này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430109
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430109,
					"content": "Lần sau có thấy sẽ báo cho cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430110
					]
				},
				{
					"id": 733430110,
					"content": "Ừm, chúng ta cùng nhau cứu giúp những bông hoa xinh đẹp này nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
