						733430203
					]
				},
				{
					"id": 733430203,
					"content": "Đương nhiên, rất nhiều Pari đều ghi nhớ cách làm cho Hoa Sunyata khôi phục sức sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430204,
					"content": "Chỉ có điều, cho dù Thiên Tượng Apaosha đã biến mất, thì sự ăn mòn mà số Hoa Sunyata này phải chịu cũng chưa được hồi phục, vô cùng suy yếu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430205
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430205,
					"content": "Những hồ hoa khác chắc cũng không may mắn thoát nạn đâu, Sefana nhất định rất khổ não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430206
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430206,
					"content": "Nghe có vẻ như Sefana mà cô nói nhất định là một Pari tốt đang hết lòng chăm sóc những đóa hoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430207,
					"content": "#Chúng ta hãy giúp Pari đó đi nhé, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430208,
					"content": "#Đối với ta mà nói, đây không phải chuyện gì khó, còn có thể giúp được Sefana. Yasnapati của ta, nhờ {F#cô}{M#cậu} hãy lưu ý đến những Hoa Sunyata thế này nhé.",
					"roleType": "TALK_ROLE_NPC",
