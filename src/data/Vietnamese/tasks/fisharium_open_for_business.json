			"dialogs": [
				{
					"id": 747020101,
					"content": "Ồ, dạo này mang về cũng nhiều cá mà. Bể cá cũng được trang trí ngày càng ra dáng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020102,
					"content": "Hihi, chúng tôi rất giỏi khoản này đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "Trông hai người có vẻ rất có thành tựu đấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020104,
					"content": "Tất nhiên rồi! Nhưng ngoài cảm giác thành tựu, trong lòng tôi vẫn thấy có chút... có chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "Tiếc nuối?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "Đúng rồi đúng rồi, chính xác là như thế đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "Sao lại thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020109,
					"content": "Tôi cũng không biết nữa... Cảm giác như ở đây còn thiếu gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "Thiếu một nhà hàng à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "Này! Chắc chắn là không rồi! Những con cá xinh xắn như vậy, sao mà nỡ lòng ăn chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "Thiếu khách đến tham quan thành quả của chúng ta đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "Ý là... muốn thủy cung này mở cửa đón khách à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020116,
					"content": "Cô có gì băn khoăn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "Sợ nơi này trở nên náo nhiệt quá à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "Nếu vậy thì cứ giao phần kinh doanh và quảng bá cho chúng tôi là được! Sandrone cứ yên tâm làm việc của mình, không cần lo lắng chuyện này đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "Nếu mọi người đã nói vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020121,
					"content": "Doanh thu chia 30% 70% nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "Ơ...? Chúng ta chỉ lấy 70% thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "70% là của người ta chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Ồ ồ... cũng đúng, dù sao thì đây cũng là thuyền do Sandrone thuê mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "Thôi được rồi, đừng nói như thể tôi là mấy địa chủ vô lý nữa. Công sức của hai người, thì hai người hưởng phần nhiều. Tôi không keo kiệt như Pantalone đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020126,
					"content": "Vậy tức là... cô đồng ý mở cửa thủy cung rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Ừm, tùy hai người thôi. Miễn đừng làm ảnh hưởng đến nghiên cứu của tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020128,
					"content": "Tuyệt! Thủy Cung Wingalet chính thức mở cửa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "Hóa ra đã nghĩ sẵn tên từ lâu rồi à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747020118,
					"content": "Sợ mọi chuyện trở nên rắc rối sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "Thiếu những vị khách à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "Ồ! Đúng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020106,
					"content": "Cô đơn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
