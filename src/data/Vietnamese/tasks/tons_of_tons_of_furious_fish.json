			"dialogs": [
				{
					"id": 747100101,
					"content": "Ừm... Trong bể cá đủ rộng rãi, được trang trí tỉ mỉ, những con cá ngoan ngoãn đang bơi lội qua lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100102,
					"content": "Cảnh tượng này quả thật rất đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100103,
					"content": "Đây cũng là một trong những điểm hấp dẫn của thủy cung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100104,
					"content": "Nếu chúng cũng hiền lành như vậy trong vùng nước tự nhiên thì tốt biết mấy, những người lặn xuống nước sẽ được đắm mình trong vẻ đẹp của sinh mệnh tự nhiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100105,
					"content": "Quay lại chuyện chính. Nhờ hai người giúp đỡ, tôi đã tìm ra nguyên nhân khiến những con cá này trở nên hung hăng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100106,
					"content": "Mấy năm qua, liên tục xảy ra tai nạn vận tải đường thủy, còn có kẻ xấu trái phép đổ chất thải bừa bãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100107,
					"content": "Rất nhiều đồ nhân tạo chìm xuống đáy biển, không ngừng tích tụ, phá hủy môi trường sống của nhiều loài cá, khiến chúng ngày càng hung hăng hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100108,
					"content": "Trước đây, đã có một nhóm thợ lặn nhận nhiệm vụ chuyên xử lý những rác thải này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100109,
					"content": "Xem ra phải nhắc nhở họ đẩy nhanh tiến độ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100110,
					"content": "Nghe có vẻ sẽ không thể giải quyết trong thời gian ngắn được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "Đúng vậy, trong thời gian này, chúng ta cứ tiếp tục công việc trước đó, cố gắng đưa càng nhiều cá hung hăng về đây điều dưỡng càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100113,
					"content": "Cách ly bệnh nhân khỏi môi trường gây bệnh là một bước rất quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100114,
					"content": "Rõ! Cứ yên tâm giao cho chúng tôi đi, chúng tôi sẽ tiếp tục tìm kiếm bệnh nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100111,
					"content": "Trong thời gian ngắn chắc không giải quyết xong được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
