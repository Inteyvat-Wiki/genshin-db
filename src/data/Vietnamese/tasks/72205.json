				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "Ơ? Ngộ ghê...rõ ràng ở trong túi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050102,
					"content": "Xin chào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "Không có thì không được đâu...phải đưa cho bà Una đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050105,
					"content": "Bà Una tuổi đã cao rồi, rất nhiều chuyện không còn nhớ rõ nữa...gần đây lại bắt đầu lẩm bẩm những chuyện hồi còn trẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050106,
					"content": "Bà ấy lúc nào cũng \"hoa\", \"hoa\", \"hoa\"...còn nói đó là hoa ở bên ngoài biển sương mù, những đóa hoa xinh đẹp nhiều màu sắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050107,
					"content": "Sau đó một ngày nọ, em nằm mơ... em mơ thấy sương mù trên đảo đột nhiên \"bụp\" một cái, tan biến hết, phía bên kia của biển là một ngôi nhà khổng lồ rất đẹp...không phải bằng gỗ, cũng không phải bằng vàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050108,
					"content": "Em cũng vậy, em cũng vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050109,
					"content": "Trong giấc mơ đó, em leo lên ngọn núi cao thật là cao, leo lên cái cây to thật là to, hái rất nhiều rất nhiều hoa đẹp... tuy chưa từng nhìn thấy, nhưng em biết đó là hoa mà bà Una muốn có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050110,
					"content": "Nhưng hoa vừa nhiều vừa nặng, làm em rơi xuống đất, cứ rơi mãi, rơi mãi...rồi giật mình tỉnh giấc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050111,
					"content": "Hừm, chứ không phải tại anh tham lam quá sao! Em đã nói rất nhiều lần là đủ rồi đủ rồi! Cuối cùng liên lụy cả em cũng bị rơi xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050112,
					"content": "Túi trống trơn...không còn gì nữa...như vậy thì sao trở về gặp bà Una đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050103,
					"content": "Có cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
