						722050707,
						722050708
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050707,
					"content": "Đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050709,
					"content": "Anh Kito, đừng nổi giận với người ngoài mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050710
