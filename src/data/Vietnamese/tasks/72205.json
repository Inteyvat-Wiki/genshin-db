			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "Lại gặp nhau rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050502,
					"content": "Lại gặp nhau rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050503,
					"content": "Xin chào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "#Hi hi, em vẫn ở đây nè! {F#Chị}{M#Anh} có biết những tảng đá này để làm gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050506,
					"content": "Hi hi, anh Kito cái gì cũng biết đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050507,
					"content": "#{F#Chị}{M#Anh} không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "Nghe ông Mata nói đây là bia mộ triệu tập vong linh đó...những linh hồn lạc lối và còn lưu lại nhân gian sau khi mất đi, sẽ bị những tảng đá này thu hút, rồi tỉnh giấc ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050510,
					"content": "Sau đó thì lang thang khắp nơi trên đảo...tìm kiếm người có thể đáp ứng tâm nguyện của họ. Một khi tìm thấy, họ sẽ quấn lấy người đó...cho đến lúc tâm nguyện của mình được hoàn thành và được người lái thuyền đưa đi mới thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050511,
					"content": "Có linh hồn là người tốt, có linh hồn là kẻ xấu...cho nên, những người đi đêm trong biển sương mù nhất định phải đến trước tảng đá này báo rõ tên họ của mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050512,
					"content": "Những người nhớ về tổ tiên bao giờ cũng có sức lực mạnh mẽ hơn những cô hồn dã quỷ. Khi những linh hồn đã chết đó biết được huyết mạch của người sống sẽ tự biết xấu hổ mà bỏ đi, không còn yêu cầu bất cứ điều gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050513,
					"content": "#Chỉ tiếc là {F#chị}{M#anh} là người từ nơi khác đến...không có tên họ thật oách để khai báo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050514,
					"content": "#Hmm...lỡ như linh hồn xấu xa đến thì {F#chị}{M#anh} phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050515,
					"content": "#Hi hi, không sao đâu, đừng sợ, em có thể bảo vệ {F#chị}{M#anh} mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050516,
					"content": "Kina cũng sẽ dọa cho bọn linh hồn xấu xa đó chạy mất dép!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050508,
					"content": "Để làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "Em vẫn ở trên đảo sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
