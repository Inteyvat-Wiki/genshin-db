			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#Chào {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050302,
					"content": "Xin chào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "#Cám ơn {F#chị}{M#anh} lần trước đã giúp em hái mấy đóa hoa đó! Nhưng...em cảm thấy bên người cứ là lạ sao ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050305,
					"content": "Em cũng thế, cứ thấy là lạ mãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050306,
					"content": "Đi đến đâu cũng chỉ gặp những người không vui...mọi người có vẻ cũng không nghe được người khác nói chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050307,
					"content": "Hơn nữa, mỗi lần nhìn thấy hoa đẹp, sau khi hái bỏ đầy túi rồi thì chớp mắt đã không thấy đâu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050308,
					"content": "Đó là vì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "Vậy sao...em không hiểu lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050311,
					"content": "Phải đi rồi sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050312,
					"content": "Chú màu vàng đó cũng nói những câu tương tự như vậy...nhưng bây giờ tụi em chưa đi theo chú được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050313,
					"content": "Tụi em còn phải mang những bông hoa xinh đẹp này cho bà Una nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050309,
					"content": "Đã đến lúc phải đi rồi đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "Trông vui nhỉ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
