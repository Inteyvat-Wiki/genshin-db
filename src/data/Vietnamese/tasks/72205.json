					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050711
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050711,
					"content": "#...Xin lỗi, em không nên nổi giận với {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050712,
						722050713
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050712,
					"content": "Không sao hết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050714,
					"content": "Chú màu vàng lại hối thúc bọn em lên chuyến thuyền ấy...còn nói phải đi đến ngôi nhà lấp lánh không có sương mù kia. Em không muốn đâu, em còn phải chăm sóc bà Una nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050715
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050715,
					"content": "Vừa không chơi với tụi em, vừa không biết kể chuyện hay, chỉ khăng khăng hối chúng em đi...bực bội quá đi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050716
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050716,
					"content": "Hơn nữa đâu phải chúng em sẽ không đi...chúng em chỉ sợ bà Una lo lắng thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050713,
					"content": "#Hãy nói cho {F#chị}{M#anh} biết đã xảy ra chuyện gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050708,
					"content": "#{F#Chị}{M#Anh} có thể giúp gì không?",
