					"nextDialogs": [
						722050706
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050706,
					"content": "#{F#Chị}{M#Anh} xem đi, anh ấy lại thế nữa rồi...cứ tự giận dỗi.",
					"roleType": "TALK_ROLE_NPC",
