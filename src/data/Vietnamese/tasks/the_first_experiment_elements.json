					"id": 110420702,
					"content": "Cứ như... đang cháy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "Không phải anh nói đã nếm rồi, có thể uống sao? Sao lại thành ra thế này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "Ơ? Đây là loại bình thường nhất trong tất cả, là kết quả đáng mừng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "Loại thuốc này sẽ đưa sức mạnh nguyên tố vào cơ thể, ở trạng thái bình thường sẽ sinh ra một số phản ứng đào thải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "Nhưng nếu nguyên tố bên trong lưu động thuận lợi, thì chỉ cần chịu đựng một chút, để sức mạnh nguyên tố lưu thông hoàn tất là xong, sẽ không gây ra ảnh hưởng gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "Tức là anh biết rõ uống vào sẽ rất khó chịu nhưng vẫn uống nó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "Ha ha, dù sao cũng là thuốc do tôi điều chế, đương nhiên tôi phải chịu trách nhiệm thử thuốc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "Việc này có được tính là... quan tâm đến đối tượng nghiên cứu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "#Đương nhiên rồi, {F#cô}{M#cậu} là trợ lý của tôi, về tình về lý tôi đều không thể để {F#cô}{M#cậu} chịu rủi ro giùm tôi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "#Tóm lại, tôi đọc kết luận nha. Trong bài kiểm tra sức mạnh nguyên tố, {F#cô}{M#cậu} giống hệt những người khác của thế giới này, không có điểm nào đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "Còn tưởng sẽ có gì đó đặc biệt hơn một chút chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "Tôi nghĩ bình thường một chút sẽ tốt hơn đặc biệt chứ. Thực ra \"đặc biệt\"... cũng chưa chắc hợp với lòng người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "Hình như đang có dụng ý gì đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "#Lợi ích của việc bình thường chính là đâu đâu cũng là vật tham chiếu của {F#cô}{M#cậu}, cũng là người có thể hiểu {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "Vì cùng là người như nhau, nên có thể hiểu và thông cảm lẫn nhau, cũng như khích lệ và hỗ trợ nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "Khi bệnh, bởi vì giống với những người khác, nên bác sĩ sẽ dễ chẩn đoán bệnh tình. Khi xảy ra chuyện, bởi vì giống với những người khác, nên có thể học hỏi kinh nghiệm từ người đã phạm phải lỗi tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "Còn người \"đặc biệt\" sẽ không được nhận những thứ đương nhiên này. Vì đã tồn tại sự khác biệt trong bản chất của sinh mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "#Chẳng hạn như... con người không thể hiểu được cuộc sống của Cây Nổ và Mắt Bão. Tôi nói như vậy, không biết {F#cô}{M#cậu} có hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "Hiểu đại khái.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "#Nói chung thì kết quả thí nghiệm là một chuyện tốt. Chí ít thì {F#cô}{M#cậu} có thể yên tâm sử dụng sức mạnh nguyên tố của mình trong tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus, kết quả thí nghiệm mới đã có rồi, nhờ anh tổng hợp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "Cứ để tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "Sau khi được thầy chỉ bảo, tôi cảm thấy suy nghĩ của mình có phần bị hạn chế, bây giờ thì đã suy nghĩ thấu đáo hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "#Có thể nhận định {F#cô}{M#cậu} là \"động vật\" thì có hơi thiếu chặt chẽ, nhưng giả sử bắt đầu bằng luận chứng {F#cô}{M#cậu} là \"sinh vật nguyên tố\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "Cũng được, đây là một hướng nghĩ thú vị, anh tự nghiên cứu xem tình hình cụ thể như thế nào chắc sẽ tốt hơn là tôi phán đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "Ừm, yên tâm, tôi sẽ có kết luận khiến mọi người đều hài lòng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "Hình như anh ấy không hề chán nản, ngược lại ý chí còn mạnh mẽ hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "Là do anh ấy có thái độ nghiêm túc, hay là Albedo biết nói chuyện nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "Vậy, trước khi tiến hành nghiên cứu kế tiếp, tôi cần phải chuẩn bị một món đồ, chờ tôi một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "Hai người cứ đi tham quan nơi này nếu thích, cứ xem như giết thời gian nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "Vẫn cảm thấy như... đang có ý đồ gì đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "Không sợ nguy hiểm đến bản thân sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "Có lẽ đây là sự tự tin của một học giả, tiết kiệm được rất nhiều rắc rối không cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "Vậy mà anh cũng uống tiếp được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
