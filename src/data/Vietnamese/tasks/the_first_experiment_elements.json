			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "Nơi này là nơi trú ẩn của tôi, tôi đã dùng nguyên liệu vừa thu thập được để điều chế thuốc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420502,
					"content": "Trong khi chờ điều chế, thì qua đây xem thử chút này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420503,
					"content": "Người này là phụ tá của tôi, Timaeus, đang hỗ trợ việc nghiên cứu. Chắc mọi người đều đã gặp nhau ở Thành Mondstadt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420504,
					"content": "Xin chào, tôi vừa nhận được dữ liệu thí nghiệm của hai người, đã tổng hợp thành bản báo cáo và dán lên bảng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420505,
					"content": "Woa, cái này, cái này nữa... chỉ đánh với Slime có một trận mà đã có nhiều kết luận thế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420506,
					"content": "Ha ha, cũng không hẳn là kết luận, đa phần đều là suy diễn và phỏng đoán táo bạo của tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420507,
					"content": "Tôi cảm thấy hướng hợp lý nhất, là chứng minh mối quan hệ mật thiết giữa Nhà Lữ Hành và Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420508,
					"content": "Vậy có hợp lý không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "#Xem này, {F#cô}{M#cậu} không có Vision, nhưng có thể dùng sức mạnh nguyên tố, Slime cũng không có Vision, cũng có thể dùng sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420511,
					"content": "Cứ tìm manh mối theo lối tư duy này, chắc chắn sẽ có được nhiều kết quả hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420512,
					"content": "Quan điểm này không có vấn đề gì, nhưng nói chính xác thì Slime là sinh vật nguyên tố hoặc cũng có thể nói nguyên tố là một loại thực thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420513,
					"content": "Nếu so sánh, có thể Cây Cấp Đông hoặc Hoa Lừa Dối sẽ thích hợp hơn, nhưng muốn truy tìm quan hệ thân thiết giữa các động thực vật, e là phải truy ngược về thuở ban sơ của thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420514,
					"content": "Nhìn từ góc độ này, có phải khó hơn rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420515,
					"content": "Ừ hình như là thế, thầy nói đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420516,
					"content": "Hơn nữa, thật ra phần đầu của dữ liệu đã viết, Nhà Lữ Hành đây là du khách đến từ thế giới khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420517,
					"content": "Nếu có quan hệ mật thiết với thế giới này thì sẽ càng đáng để nghiên cứu hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420518,
					"content": "A a, thật sao! Xin lỗi, tôi lấy được dữ liệu nên hơi kích động! Lần sau tôi sẽ chú ý hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420519,
					"content": "Đúng rồi, muốn hoàn thành việc nghiên cứu phải cần nhiều dữ liệu hơn, tạm thời tôi sẽ ở lại đây phân tích, nếu muốn tìm hiểu kết quả thí nghiệm thì cứ đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420520,
					"content": "Ừ, ở đây giao cho anh đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420521,
					"content": "Thuốc chắc đã xong rồi, tôi sẽ nếm trước, nếu không có vấn đề thì phải nhờ vào hai người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420509,
					"content": "Tôi cảm thấy Paimon mật thiết hơn đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
