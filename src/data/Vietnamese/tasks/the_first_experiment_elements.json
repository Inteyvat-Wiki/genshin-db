				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "Tôi đang thắc mắc, hạt giống đó sau khi nảy mầm sẽ mọc ra thứ gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420102,
					"content": "Không biết, nhưng tôi thấy, mấu chốt nằm ở quá trình chứ không phải kết quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420103,
					"content": "Nếu có thể ở Teyvat dùng thuật giả kim đánh thức sinh mệnh không thuộc về nơi này, thì sự lý giải về bản chất sinh mệnh của tôi sẽ có thêm một bước tiến mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420104,
					"content": "Sau khi thức tỉnh, coi đó là sự sáng lập, cũng không phải là chuyện không thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420105,
					"content": "Ừm...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420106,
					"content": "Ha ha, chắc khó hiểu quá phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420107,
					"content": "Không không, tôi hiểu hết đó, nhưng so với việc đó, thì tôi chỉ muốn biết hạt giống sẽ mọc ra thứ gì thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420108,
					"content": "Không hiểu gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "Nếu mọc ra trái ngon, thì chúng ta cùng chia sẻ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420111,
					"content": "Được! Nhớ giữ lời đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420112,
					"content": "Không ngờ dễ thuyết phục Paimon đến vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "À là do đôi lúc tôi phải chăm sóc trẻ con. Nếu giải thích thì phức tạp lắm, cứ xem như ngoài thuật giả kim, thì đây là kỹ năng nhỏ của tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420115,
					"content": "#Nói đến mục nghiên cứu thứ nhất, là về sức mạnh nguyên tố. Người ở thế giới này muốn dùng sức mạnh nguyên tố thì bắt buộc phải có Vision, nhưng tôi không thấy {F#cô}{M#cậu} có thứ gì tương tự như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420116,
					"content": "#Tôi muốn xác nhận xem tại sao {F#cô}{M#cậu} có thể sử dụng sức mạnh nguyên tố một cách tự nhiên, vì vậy cần hỏi {F#cô}{M#cậu} một vài vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420117,
					"content": "#Đầu tiên, {F#cô}{M#cậu} có cơ quan nào mà người khác không có không? Ví dụ như trái tim thứ hai hay là bao tử thứ tư dạng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420118,
					"content": "Không có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "#Ồ ra vậy, vậy người bạn nhỏ bay bên cạnh {F#cô}{M#cậu} có kết nối với cơ thể của {F#cô}{M#cậu} không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420121,
					"content": "Câu này kỳ cục quá! Nhìn bên ngoài là có thể loại trừ khả năng này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420122,
					"content": "Với lại, không phải \"người bạn nhỏ\", mà là Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420123,
					"content": "Tôi chỉ đang xem xét đến khả năng Paimon là \"cơ quan bên ngoài\", hoặc là một cách thức kết nối nào đó giữa hai người mà mắt thường không thể nhìn ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420124,
					"content": "Chúng tôi quen nhau trong chuyến hành trình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "#Ồ, vậy có thể loại bỏ khả năng này rồi. Vậy có phải Paimon truyền sức mạnh nguyên tố cho {F#cô}{M#cậu} không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420127,
					"content": "Nhưng điều kiện trước hết là sức mạnh nguyên tố của Paimon có thể xuyên qua núi đá dày 10 mét, còn không thì khiến thác nước phía Nam Thanh Tuyền Trấn chảy ngược lên trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420128,
					"content": "Ừm, đúng là không thể nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420129,
					"content": "Tôi chưa kịp nói gì luôn á!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420130,
					"content": "#Nói như vậy thì cấu tạo cơ thể của {F#cô}{M#cậu} cũng không có gì khác biệt rõ rệt với loài người ở thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420131,
					"content": "Vậy chỉ còn cách thử nghiệm thực tế để nghiên cứu điểm khác biệt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420132,
					"content": "Đầu tiên phải xem thử sức mạnh nguyên tố không rõ nguồn gốc này lưu động ra ngoài như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420133,
					"content": "#Tiếp theo tôi sẽ dụ một số Slime đến đây, nhờ {F#cô}{M#cậu} dùng cách thức quen thuộc nhất đánh bại chúng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420134,
					"content": "Hóa ra là dùng cách đơn giản vậy để quan sát à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420135,
					"content": "Một thực nghiệm tốt phải trực quan và rõ ràng, vả lại, đây chỉ là một nghiên cứu nhỏ đơn giản thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420136,
					"content": "Đương nhiên là nếu hai vị cảm thấy thiếu tính thử thách, chúng ta cũng có thể thử khiêu chiến cùng lúc 6 Tinh Linh Nước Trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420137,
					"content": "Slime! Slime là được rồi nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420138,
					"content": "Không hiểu lắm, nhưng có vẻ rất phức tạp thì phải.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Vậy chuẩn bị đi nào, Slime sắp đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420139,
					"content": "Tôi không muốn bị Thú Biến Hình đụng tới đụng lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "Tôi câu cô ấy lên.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "Theo tôi biết thì không có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "Không ngờ nhìn thấu được suy nghĩ của Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "Tôi cũng muốn biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
			"completionStepIds": [
				1104203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104203",
							"2"
						],
						"stepId": 1104203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "#Vất vả cho {F#cô}{M#cậu} rồi, chắc là không cảm thấy có gì bất thường phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420302,
					"content": "Nếu bị thương thì tôi có sẵn một số thuốc cấp cứu ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420303,
					"content": "Đừng lo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "Vậy thì tốt quá, theo tôi quan sát, sức mạnh nguyên tố lưu động thuận lợi ra bên ngoài, phản ứng nguyên tố hợp lý, không thấy có tình trạng nào đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420306,
					"content": "Sau khi xác nhận \"dòng lưu động bên ngoài\" không có vấn đề gì, chúng ta tiếp tục kiểm tra \"dòng lưu động bên trong\" nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420307,
					"content": "\"Dòng lưu động bên trong\"... muốn làm gì nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420308,
					"content": "Đơn giản lắm, tôi có thể dùng thuật giả kim chế tạo một loại thuốc chắt lọc sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420309,
					"content": "#Nếu sức mạnh nguyên tố được giữ hoặc tích lũy trong cơ thể {F#cô}{M#cậu} theo cách sinh lý, thì loại thuốc này sẽ sinh ra phản ứng nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420310,
					"content": "Sẽ phát tác trong bụng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "Nghe, nghe sợ quá à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420313,
					"content": "Không sao đâu, nếu mọi thứ đều ổn, thì chỉ thấy khó chịu một chút thôi, không gây hại cho sức khỏe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420314,
					"content": "Vậy nếu không ổn thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420315,
					"content": "Lỡ xảy ra chuyện ngoài ý muốn thì tôi cũng đã chuẩn bị đầy đủ, đừng quá lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420316,
					"content": "Lo chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "#Ừm, cũng không phải hoàn toàn không có rủi ro. Nhưng nếu thực sự dòng chảy nguyên tố trong cơ thể {F#cô}{M#cậu} có trở ngại, thì cũng có thể kiểm tra được bằng cách này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420318,
					"content": "Đây cũng là lời cảnh báo sớm về sức khỏe, nếu phản ứng nguyên tố bên trong được xúc tác do những yếu tố ngoài ý muốn thì mới gây nguy hiểm thật sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420319,
					"content": "Giống như kiểm tra sức khỏe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "Đúng, có thể hiểu như vậy. Nhưng loại thuốc dùng để thử nghiệm còn thiếu một chất xúc tác, chúng ta phải tìm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420321,
					"content": "Đó là một loại khoáng thạch tên là \"Tinh Ngân Khoáng\", nhưng không phải tất cả loại khoáng thạch này đều thích hợp để làm chất xúc tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420322,
					"content": "#Bây giờ tôi đưa {F#cô}{M#cậu} đến nơi trú ẩn, trên đường đi hãy thu thập \"Tinh Ngân Khoáng\" nhé. Nếu có loại thích hợp làm chất xúc tác thì tôi sẽ nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420323,
					"content": "Nếu thuận lợi, chờ khi chúng ta đến nơi trú ẩn sẽ có thể điều chế thuốc ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420324,
					"content": "Nghe có vẻ không an toàn lắm, nhưng hình như là việc có lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420325,
					"content": "Trên đường chúng ta chú ý vào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420311,
					"content": "Sẽ đọng lại trong bụng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "Chỉ hơi lạnh chút thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
