			},
			"dialogs": [
				{
					"id": 401970201,
					"content": "Tuyệt! Tôi muốn vẽ bằng <color=#C4D6EAFF>màu trắng</color>.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Râu vị kem sao... Vô cùng truyền thống, nhưng lại rất ngon. Ừm, tôi cho phép rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "#Được rồi, bản đồ kỷ niệm này đã là đồ của {NICKNAME}, {F#cô}{M#cậu} muốn vẽ bao nhiêu kiểu râu khác cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Hihi, nghe có vẻ như là một tấm bản đồ cực kỳ ngon lành đấy. Chúng tôi sẽ cất giữ cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "Mọi người thích là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Mọi thứ ở đây đều đã hoàn thiện, tiếp theo hãy quên đi mệt mỏi của công việc và thỏa sức vui chơi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
