			"dialogs": [
				{
					"id": 401970101,
					"content": "Tôi cho rằng, khi sự việc phát triển tới mức này, thì chúng ta nên thêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970102,
					"content": "Muối?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970103,
					"content": "Không, là tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970104,
					"content": "Ồ! Tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970105,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970106,
					"content": "Hai người đang nghiên cứu gì vậy? Món tráng miệng mới à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970107,
					"content": "Món tráng miệng không nên thêm tiêu đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "Không phải món tráng miệng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970109,
					"content": "Là kịch bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970110,
					"content": "Hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "Người bạn của tôi, kiêm người quay phim và đạo diễn thân mến! Trong tình yêu nồng cháy của những con người yêu thích điện ảnh, việc sáng tạo sẽ không bao giờ dừng lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970112,
					"content": "Sân khấu của tôi sẽ không có chỗ cho kịch bản tầm thường. Tình tiết bước ngoặt phải như những hạt tiêu rải xuống, khiến khán giả phải hắt hơi liên tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970113,
					"content": "Không chỉ phim ảnh, mà đĩa ăn cũng là sân khấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970114,
					"content": "Trước đây tôi từng nghe tiểu thư Emilie nói, tiêu có thể được dùng trong kỹ thuật điều chế nước hoa... Vậy thì, chắc cũng có thể dùng trong món tráng miệng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970115,
					"content": "Hmm... Sự kích thích của tiêu, liệu có làm nổi bật lên sự ngọt ngào của kem không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970116,
					"content": "Woa, tôi cảm thấy họ khá hợp nhau trong việc sáng tác đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970117,
					"content": "Mặc dù tôi không tưởng tượng được bánh kem mà bỏ tiêu vào sẽ có mùi vị thế nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970118,
					"content": "Hửm? Escoffier muốn làm bánh kem mới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970119,
					"content": "Bánh kem bỏ tiêu, cay nồng độc lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "Kích thích vậy sao! Đợi làm ra rồi nhất định phải cho tôi nếm thử nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970121,
					"content": "Là tôi tưởng tượng sao? Cứ cảm thấy sau khi hoàn thành công việc thì mọi người lại càng nhiệt tình hơn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970122,
					"content": "Tại sao lại không? Khi sự cố gắng mang lại thành quả thì đó mới là lúc nên vui mừng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970123,
					"content": "Cũng giống như Macaron mới ra lò vậy, đừng vì sợ ngọt mà không nỡ thêm nguyên liệu vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970124,
					"content": "Macaron chính là phải cho thật nhiều đường vào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970125,
					"content": "Cho thật nhiều đường vào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970126,
					"content": "Cho thật nhiều đường vào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970127,
					"content": "...À, cho đường vào gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970128,
					"content": "Lepine-Pauline, cô đến rồi! Đồ đã hoàn thành chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970129,
					"content": "Đương nhiên rồi, mọi thứ đều thuận lợi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970130,
					"content": "Ồ? Lepine-Pauline đi làm nhiệm vụ quan trọng gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970131,
					"content": "#Đúng vậy! Cái này cho {F#cô}{M#cậu}, xin hãy nhận lấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970132,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "Woa, thật lợi hại! Là ảnh toàn cảnh của sự kiện, trên đó còn có hình của mọi người nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970134,
					"content": "Hihi, xét thấy Phim Trường Vui Vẻ đạt được thành công rực rỡ, chúng tôi đã cùng bàn bạc, muốn làm ra một món quà lưu niệm độc đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970135,
					"content": "Phim Trường Vui Vẻ là do mọi người xây dựng từng chút một, cũng giống như tấm bản đồ mà mọi người từng nét một vẽ nên vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970136,
					"content": "Tuy chủ yếu vẫn được hoàn thành bởi người vẽ giỏi là tiểu thư Lepine-Pauline đây, nhưng mỗi người chúng tôi đều đã cố gắng để lại nét bút của mình trên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970137,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970138,
					"content": "#Hơn nữa không chỉ vậy, {NICKNAME}, tôi sẽ cho {F#cô}{M#cậu} một đặc quyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970139,
					"content": "#...{F#Cô}{M#Cậu} sẽ có quyền thêm râu lên hình đại diện của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				}
			]
		},
