						230165003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165003,
					"content": "Ví dụ như, thử chế tạo một vài loại máy móc không phức tạp tới mức đó, nhưng vẫn đủ tinh xảo ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165004,
					"content": "Tôi tin với tài năng của ngài, ngài sẽ có thể chế tạo ra loại máy như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165005,
					"content": "Lutong thân mến, lúc trước chúng ta đã bàn về vấn đề này rồi, anh cũng biết câu trả lời của tôi đấy... Và tôi cũng luôn tôn trọng sự lựa chọn của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165006,
					"content": "Hay chúng ta cùng bàn về địa điểm ăn tối của ngài và tiểu thư Kaia vào lần tới đi, thưa ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165007,
					"content": "Cảm ơn anh, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165008,
					"content": "Đừng khách sáo, thưa ngài, hợp đồng hai ta đã ký vẫn chưa kết thúc mà.",
					"roleType": "TALK_ROLE_NPC",
