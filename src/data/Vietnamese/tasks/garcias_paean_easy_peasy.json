					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165104,
					"content": "Nhưng anh ta như thế, thật sự không giống người muốn dựa vào nghề rèn sắt kiếm sống chút nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165105,
					"content": "Trừ tôi ra, còn ai tới tìm họ nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165106
					]
				},
				{
					"id": 230165106,
					"content": "Ừm... Có một cô gái thỉnh thoảng tới tìm anh ta, còn mang theo không ít đồ nữa.",
