					]
				},
				{
					"id": 230163902,
					"content": "Á há! Thành công rồi, cái bánh răng này khá lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163903,
					"content": "Khoảng cách giữa các răng... độ dày... kích thước... Tôi phải lấy thước đo mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163904,
					"content": "Để ngài Garcia đo đi, Nhà Lữ Hành, thù lao này là của bạn, xin bạn hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163905,
					"content": "Anh vẫn giữ thái độ dè dặt tới mức bi quan đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Đúng vậy, thái độ của tôi luôn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163907,
					"content": "Tôi và ngài Garcia chỉ đang xử lý một hòn đá nhỏ trước một ngọn núi lớn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163908,
					"content": "Nhưng thực tế là chúng tôi không thể tìm được đường vào núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163909,
					"content": "Hy vọng ngài Garcia có thể dẫn dắt tôi đi đúng đường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163910,
					"content": "Không thì tôi chỉ có thể mặc niệm câu \"xe tới trước núi ắt có đường\" thôi.",
