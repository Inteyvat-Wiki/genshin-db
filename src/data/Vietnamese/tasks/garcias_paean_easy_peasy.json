			},
			"dialogs": [
				{
					"id": 230160301,
					"content": "Lutong! Cái bánh răng này có thể lấy ra khỏi khuông rồi, mau tới giúp một tay đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160302,
					"content": "Nhà Lữ Hành, bạn cũng về rồi à, chắc bạn đã học được kinh nghiệm từ ngài Ahangar rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160303,
					"content": "Mau lên, mau lên, tôi nên xử lý bánh răng này thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
