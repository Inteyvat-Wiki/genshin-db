					"nextDialogs": [
						230165107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165107,
					"content": "Tôi nghe anh ta nói, cô gái đó tên là Kaia... hay gì đó ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165108,
					"content": "Những người trông không ăn nhập gì tới rèn sắt, tại sao lại tụ tập ở lò rèn của tôi chứ...",
