				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "Tay của tôi... Ui da! Tê hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160102,
					"content": "Thưa ngài, sắp tới ngài còn phải tính toán sổ sách cho tiểu thư Kaia nữa, đừng nên vất vả quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160103,
					"content": "Tôi, tôi biết rồi! Đừng nhắc tới chuyện này nữa, Lutong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160104,
					"content": "Đương nhiên, nếu như ngài không thể đi thì tôi có thể thay mặt ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160105,
					"content": "Không! Tôi sẽ tự đi, chỉ cần tôi... làm ra thêm vài cái bánh răng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160107,
					"content": "Được rồi, tôi làm không nổi, tôi thật sự không làm nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160108,
					"content": "Anh lại làm gì thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "Là bạn ư, Nhà Lữ Hành... Ui da... Tay của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160110,
					"content": "Là thế này, vì anh Ahangar còn bận việc riêng, không thể giúp tôi làm linh kiện tôi cần mãi được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160111,
					"content": "Hơn nữa linh kiện anh ấy làm ra luôn hơi khác với ý muốn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160112,
					"content": "Nên để đảm bảo độ chính xác của những linh kiện này, tôi đã bảo anh Ahangar hướng dẫn rồi tự mình chế tạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160113,
					"content": "May mà lúc ở Fontaine tôi từng làm việc tương tự rồi... Nhưng những thủ pháp mà anh Ahangar nói với tôi, có vài thứ tôi thật sự không tài nào nhớ nổi, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160114,
					"content": "Nhà Lữ Hành, xin bạn hãy thay tôi học thủ pháp của anh Ahangar với, tôi thật sự cần nghỉ ngơi một lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160115,
					"content": "Anh ngồi đây nghỉ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "Cảm ơn bạn đã chịu giúp đỡ, ui da... Tay của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160116,
					"content": "Kaia là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "Bạn làm ăn! Một người... ừm... bạn làm ăn cực kỳ tài năng và giàu có!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160118,
					"content": "Chúng tôi đã ký hợp đồng quản lý sổ sách dài hạn! Nên tôi mới phải thường xuyên đi tìm cô ấy, đúng không Lutong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160119,
					"content": "Ngài nói rất đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160120,
					"content": "Tóm, tóm lại là vậy... Nhà Lữ Hành, xin bạn mau đi tìm ngài Ahangar thỉnh giáo một chút đi, tôi trông cậy cả vào bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "Đã bảo chờ một lúc rồi mà... Hả? Sao lại là bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160202,
					"content": "Tôi thay mặt anh ta đến học hỏi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "Anh ta thật sự tự mình làm à... Đúng là người kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160205,
					"content": "Tôi đã rèn sắt bao nhiêu năm rồi, đến giờ chưa từng thấy qua người nào yêu cầu khắt khe như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160206,
					"content": "Anh ta lại còn cầm thước để đo độ dày mỏng của chỗ nối giữa các ống sắt, và cả khoảng cách giữa các con ốc nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160207,
					"content": "Tôi thật sự không nhịn được nữa, nên nói anh ta có giỏi thì tự đi mà làm... Kết quả là hôm sau anh ta thực sự đã tới học cách chế tạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160208,
					"content": "Tôi phục anh ta luôn rồi, bèn chiều ý anh ta, chỉ cần anh ta trả tiền nguyên vật liệu với dụng cụ thì muốn làm gì cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160209,
					"content": "Haiz, thật không biết người này muốn làm cái gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160210,
					"content": "Anh ta đang làm một cỗ máy vĩ đại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "Được rồi... Dù sao cũng toàn mấy thứ kỳ lạ. Các bạn tới học cách chế tạo đúng không? Chuyện làm bánh răng này tôi cũng không có gì hay để dạy cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160213,
					"content": "Có điều tôi thấy bánh răng mà anh ta muốn làm có mép rất sắc bén, ở giữa lại lõm vào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160214,
					"content": "Bánh răng kỳ lạ thế này khó mà trực tiếp làm ra bằng khuôn đúc được, anh ta bắt buộc phải gia công thêm lần thứ hai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160215,
					"content": "Thao tác cụ thể tôi đều dạy cho anh ta cả rồi, bạn cứ quay về nói với anh ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160216,
					"content": "Đầu tiên, lần thứ hai cho vào lò, <color=#00E1FFFF>nhớ thêm nhiều nhiên liệu</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160217,
					"content": "Sau đó, lúc lấy ra gia công, <color=#00E1FFFF>đập từ trong ra ngoài</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160218,
					"content": "Thế nào, đã nhớ chưa? Nhớ rồi thì quay lại nói với anh ta đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160219,
					"content": "Đúng là một người kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160211,
					"content": "Anh ta đang làm một cỗ máy kỳ lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "Anh ta gõ tới mức tê hết cả tay, nên đã ngồi nghỉ một lúc rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
		{
			"id": 2301603,
