			"dialogs": [
				{
					"id": 766740101,
					"content": "Ồ, không ngờ thành phẩm cuối cùng lại bất ngờ đến vậy. Nếu thực sự có ai lạc vào đây, chắc hẳn sẽ phải trầm trồ trước sức mạnh của ma nữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740102,
					"content": "Nếu thực sự có người lạc vào đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "Chuyện đó thì còn phải xem đối phương là người như thế nào đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740105,
					"content": "Dẫn dắt rất dễ sản sinh ra sự tham lam và lười biếng. Nếu là những người nỗ lực bằng sức mình như hai vị đây, thì tôi rất sẵn lòng giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740106,
					"content": "Nhưng nếu là những kẻ đặt hết hy vọng vào sức mạnh của ma nữ, chỉ muốn ngồi mát ăn bát vàng thì... Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740107,
					"content": "...Chẳng lẽ cô định biến họ thành tượng đá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766740108,
					"content": "Không đến mức đó đâu. Tôi sẽ chỉ dẫn họ rời khỏi đây, và đến Hội Đồng Bí Mật gần đó, cô gái tên Nefer đó chắc sẽ biết cách đối phó với họ hơn tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740109,
					"content": "Muốn ngồi không hưởng thành quả à, làm gì có chuyện đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740103,
					"content": "Cô sẽ dẫn dắt họ thực hiện ước nguyện chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
