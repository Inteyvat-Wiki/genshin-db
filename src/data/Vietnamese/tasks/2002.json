					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "Hừm, sao vẫn chưa đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020202,
					"content": "#Bỏ đi, hãy bắt đầu màn ra mắt hoành tráng của bạn đã, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020203,
					"content": "Nào mọi người, xin hãy im lặng và chú ý bên này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020204,
					"content": "\"Hội Đấu Võ Nam Thập Tự\" đầy căng thẳng và kịch tính, cuối cùng đã đi đến vòng chung kết cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020205,
					"content": "Sau khi trải qua vô số trận tỉ thí kinh thiên động địa, cuối cùng đã chọn được hai tuyển thủ bước lên võ đài ngày hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020206,
					"content": "#Đầu tiên, người mà tôi muốn giới thiệu, cho dù mọi người chưa từng gặp thì chắc chắn cũng đã nghe qua danh tiếng của {M#anh ấy}{F#cô ấy}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020207,
					"content": "#{M#Anh ấy}{F#Cô ấy} chính là người khiến Ma Thần Osial cũng phải run sợ, khiến Quan Chấp Hành Fatui vừa nghe đã biến sắc, là anh hùng của những người tha hương Liyue! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020208,
					"content": "Ồ ồ ồ ồ ồ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "Người Tham Chiến"
				},
				{
					"id": 20020209,
					"content": "Cuối cùng cũng xuất hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "Người Tham Chiến"
				},
				{
					"id": 20020210,
					"content": "#Chắc hẳn mọi người đều đã nhìn thấy biểu hiện xuất sắc của {M#anh ấy}{F#cô ấy} ở vòng bán kết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020211,
					"content": "Trận chung kết hôm nay chắc chắn sẽ còn đặc sắc hơn cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020212,
					"content": "Một tuyển thủ khác của chúng ta...ừm, hiện giờ vẫn chưa đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020213,
					"content": "Thật là, làm cái quỷ gì thế. Trận chung kết đâu thể quyết định bỏ quyền như những trận đấu trước được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020214,
					"content": "Xin lỗi xin lỗi, phiền mọi người chờ thêm chút nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020215,
					"content": "Có khi nào nhớ nhầm thời gian rồi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "Cho dù thế nào đi nữa, nếu không xuất hiện thì trận chung kết này chỉ còn cách phải hoãn lại thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020218,
					"content": "Chờ đã, tôi cảm thấy hơi kì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020219,
					"content": "Chị đại, chúng ta đi kiểm tra giải thưởng đi, chỗ chiếc hộp đựng Vision đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, bạn cũng đi với chúng tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020216,
					"content": "Có khi nào không dám đến không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
