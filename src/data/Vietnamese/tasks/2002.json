			"trigger": {
				"objectNames": [
					"Fei",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "Sao lại có người chạy nhanh hơn ta được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020902,
					"content": "Để có thể trốn thoát, ta còn chuẩn bị sẵn thuyền, không ngờ mới chớp mắt đã bị đuổi theo rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020903,
					"content": "Thuyền có nhanh hơn nữa thì cũng không so được với tốc độ của gió đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020904,
					"content": "Gió? Ngươi đang nói gì...A, ta hiểu rồi, là sức mạnh Vision của ngươi chứ gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020905,
					"content": "Đáng ghét, nếu ta cũng có Vision...hoặc nếu ta có thể khiến Vision này sáng lên, thì các ngươi làm sao đuổi kịp ta chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020906,
					"content": "Không liên quan đến Vision, có lẽ ngươi rất giỏi ẩn nấp trong đám đông, nhưng rõ ràng ngươi vẫn chưa biết làm thế nào để thoát được ánh mắt của \"tự nhiên\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020907,
					"content": "Ngoài ra, việc chọn đường thoát thân cũng có quá nhiều sơ hở, vả lại, trên đường cưỡi gió đến đây, ta còn nghe được tiếng cười dương dương tự đắc của ngươi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020908,
					"content": "Nói cách khác, ba yếu tố cần thiết để ăn trộm là \"tốc độ\", \"bí mật\", \"tao nhã\", ngươi chẳng làm được dù chỉ một điều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020909,
					"content": "Ngươi, ngươi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020910,
					"content": "Nhưng so ra, điều làm ta thất vọng hơn chính là trạng thái của Vision trong tay ngươi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020911,
					"content": "...Quả nhiên, nó sẽ không đáp ứng \"nguyện vọng\" của con người một cách bừa bãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020912,
					"content": "Được rồi được rồi! Xem như ta thừa nhận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020913,
					"content": "Ta đã nhắm Vision này từ lâu rồi, nghe nói những kẻ tham gia Hội Đấu Võ lần này đều là hạng thấp kém, nên ta đã báo danh, trót lọt vào đến trận chung kết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020914,
					"content": "Thì ra ngươi chính là đối thủ trận chung kết của bọn ta à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020915,
					"content": "Vốn dĩ ta cho rằng có thể dựa vào thực lực để đoạt lấy quán quân! Nhưng các ngươi lại đột nhiên xuất hiện làm xáo trộn kế hoạch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020916,
					"content": "Ta đã xem trận bán kết, ngay lúc đó ta đã biết mình không thể có cơ hội thắng cuộc, nhưng đã đến nước này, ta không cam tâm từ bỏ Vision!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020917,
					"content": "Nếu đã không có được một cách quang minh chính đại, thì...nhân lúc mọi người đều tập trung sự chú ý đến Beidou và ngươi, ta đã dùng một chút kỹ xảo trong nghề cũ của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020918,
					"content": "Rõ ràng ta đã chuẩn bị rất đầy đủ, nhưng kết quả vẫn bị các ngươi đuổi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020919,
					"content": "Đến đường cùng rồi thì hãy thức thời chút đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "Đáng ghét, ta vẫn không cam tâm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020923,
					"content": "Nếu còn chống cự thì phải trả giá đắt đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "Uy hiếp trắng trợn vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020928,
					"content": "Được, nhưng ngươi phải giữ lời đấy! Dù sao, tuy ta lấy được nó nhưng nó không bị đánh thức, thì cũng chỉ là một cái vỏ vô dụng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020929,
					"content": "Vậy sao được, chỉ tính riêng về tội trộm đồ, theo quy tắc trên biển cũng phải chặt một cánh tay để đền tội rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020930,
					"content": "Hả?! Không đến mức vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020931,
					"content": "Cộng thêm việc ngươi trộm giải thưởng, không tham gia chung kết, khiến thủ lĩnh của thuyền Nam Thập Tự Beidou mất mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020932,
					"content": "Xem ra còn phải dùng thanh sắt nóng đỏ in chữ \"trộm\" lên mặt ngươi thì mới hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020933,
					"content": "Ê ê, không cần ác vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020934,
					"content": "Đáng ghét, không ngờ ngươi lại ra tay độc ác như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020935,
					"content": "Nếu đã không đàm phán được thì đừng nói nhảm nữa, ta liều với các ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020921,
					"content": "Giao đồ ra đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "Nhưng, khó khăn lắm mới lấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020925,
					"content": "Ngoan ngoãn nghe lời thì không có chuyện gì hết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "Thật, thật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020927,
					"content": "Giao đồ ra ta sẽ tha cho ngươi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
			"completionStepIds": [
				200211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200211",
							"2"
						],
						"stepId": 200211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "Đáng, đáng ghét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021102,
					"content": "Đừng, đừng, làm gì cũng được nhưng đừng in chữ lên mặt, mặt ta còn dùng để kiếm ăn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021103,
					"content": "Hừm, kẻ cận kề cái chết, đã cố hết sức vẫn không thể khiến thần linh thương xót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021104,
					"content": "Để lại Vision rồi đi đi, ta đổi ý rồi, không trách phạt ngươi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021105,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021106,
					"content": "Chẳng lẽ ngươi muốn xin chịu phạt nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021107,
					"content": "Vậy tùy ngươi, sự giác ngộ mang tinh thần samurai này rất đáng được tán thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021108,
					"content": "Không không không, làm gì có, cám ơn đã tha mạng, cám ơn đại nhân độ lượng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021110,
					"content": "Không hiểu lắm, bạn cố ý dọa hắn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021111,
					"content": "Tôi không có thú vui kỳ lạ vậy đâu, chỉ là Vision vẫn nằm trong tay hắn, tôi chỉ muốn thử hết mọi khả năng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021112,
					"content": "Khi người ta bị ép vào đường cùng sẽ bộc phát sức mạnh mạnh mẽ, tôi tưởng đây là cơ hội khiến Vision phát sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021113,
					"content": "Đáng tiếc là chẳng có gì xảy ra cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021114,
					"content": "Từ đầu đến cuối đều vì chuyện này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "Đúng thế, tôi chỉ muốn biết Vision đã bị dập tắt thì còn có khả năng được đánh thức hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021116,
					"content": "Kể từ lúc phát giác hắn đang trộm Vision, tôi đã quyết định dùng hắn để \"thí nghiệm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021117,
					"content": "Hơn nữa trong quá khứ, tôi cũng đã thử rất nhiều cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021190,
					"content": "Mặc dù tôi chỉ nghe về chuyện \"Vision vô chủ vẫn còn có thể phát sáng trở lại\" trong một số ít truyền thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021191,
					"content": "Nhưng khi nhìn thấy bạn có thể điều khiển nhiều loại nguyên tố cùng lúc như vậy thì còn có chuyện gì là không thể xảy ra chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021192,
					"content": "Nào, bạn cũng đến đây thử xem, xem có thể cho tôi câu trả lời không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021118,
					"content": "Để tôi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "Xem ra không có phản ứng gì đặc biệt nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021121,
					"content": "Thì ra là vậy, cho dù là bạn cũng không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021122,
					"content": "Không sao, chuyện này cũng nằm trong dự đoán, vậy Vision này có thể tiếp tục đi theo tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021123,
					"content": "Vì sao lại cố chấp như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "Đúng thế, Vision này có lai lịch đặc biệt gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021126,
					"content": "Vậy thì không thể không nhắc đến một người bạn cũ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021127,
					"content": "Có thể tất cả những gì tôi làm bây giờ, đến cuối cùng rồi cũng sẽ trở nên vô nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021128,
					"content": "Nhưng đời samurai phiêu bạt, ngoài việc tìm kiếm \"ý nghĩa\" trong cuộc hành trình và cảnh sắc ven đường, thì tôi vẫn giữ vẹn nguyên chữ \"đạo\" trong trái tim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021129,
					"content": "Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021130,
					"content": "Ha ha, chỉ là một cách khác để nói rằng tôi làm theo ý mình mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021131,
					"content": "Được rồi, đến lúc trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021132,
					"content": "Ừm, đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "Vậy để tôi đưa bạn đi cưỡi gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021134,
					"content": "Ở lại tản bộ chút nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "...Không cần lo cho cảm nhận của tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021136,
					"content": "Nhưng, cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021124,
					"content": "Nhất định phải thắp sáng nó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
		{
			"id": 200212,
			"completionStepIds": [
				200212
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200212",
							"2"
						],
						"stepId": 200212,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Zhuhan",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021201,
					"content": "Ơ? Beidou không ở đây nữa sao? Bạn ấy trở về thuyền rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021202,
					"content": "Chị đại à, chị ấy bị Ningguang gọi đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021203,
					"content": "Hình như là vì quy mô của \"Hội Đấu Võ Nam Thập Tự\" lần này vượt quá báo cáo đến mấy lần, không thể giả vờ như không biết nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021204,
					"content": "Chị đại vừa mắng \"thật mất hứng\" vừa vội chạy đến cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021205,
					"content": "Ha ha, mâu thuẫn với Ningguang là chuyện như cơm bữa đó mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021206,
					"content": "Nhưng mà, điều tiếc nuối nhất của chị đại vẫn là không thể nhìn thấy quán quân xuất hiện, trước khi đi cứ nhắc đến chuyện này mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021207,
					"content": "Thực ra người trộm mất Vision chính là đối thủ ở vòng chung kết của vị anh hùng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021208,
					"content": "Do tự biết không có cơ hội thắng nên mới nảy sinh ý xấu, cướp giải thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021209,
					"content": "Thế thì kết quả của trận \"Hội Đấu Võ Nam Thập Tự\" này vốn đã ngã ngũ mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021210,
					"content": "Thì, thì ra là vậy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021211,
					"content": "Vậy theo quy định, người đó sẽ bị xem như mất tư cách thi đấu, quán quân chính là vị anh hùng này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021212,
					"content": "Giành quán quân theo kiểu này, có vẻ hơi bất ngờ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021213,
					"content": "Không sao không sao, tôi cảm thấy cái này gọi là \"thứ xứng đáng sẽ thuộc về người xứng đáng\". Bây giờ tôi sẽ trao huy chương quán quân đã chuẩn bị trước cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021214,
					"content": "Vậy là có thể đến Inazuma rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Đúng thế, tuy chị đại không có mặt, nhưng sau này tôi sẽ chuyển lời lại cho chị đại, với tính cách của chị đại, chắc chắn nói được làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021216,
					"content": "Nhưng con đường biển đi đến Inazuma rất khó đi, mưa gió không lúc nào ngừng gào thét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021217,
					"content": "Bão tố không ngừng, thực ra cũng là một cách thể hiện ý chí bế quan tỏa cảng của Raiden Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021218,
					"content": "Ý chí có thể thay đổi được cả thời tiết sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021219,
					"content": "Đó là \"bảy vị chấp chính trần thế\", cũng giống như Morax ở Liyue ném thương đá tạo lập Cô Vân Các, Raiden Shogun có thể kêu gọi bão tố vĩnh hằng cũng không phải là chuyện đáng kinh ngạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021220,
					"content": "Tóm lại, muốn đến Inazuma thì thuyền \"Ngôi Sao Chết Chóc\" vẫn cần một ít thời gian. Sau khi chuẩn bị xong xuôi, các bạn sẽ nhận được thông báo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021221,
					"content": "Khoảng thời gian này tôi cũng phải đi khắp nơi, xem thử mảnh đất Liyue rộng lớn này có thể có cơ hội nào đánh thức Vision hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021222,
					"content": "Chắc chắn sẽ được mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021223,
					"content": "Cám ơn, hi vọng chúng ta ai cũng sẽ tìm được ý nghĩa trên con đường của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021224,
					"content": "Tôi còn một lời cảnh báo - sấm sét vô tận phía trước có thể sẽ là con đường gian nan nhất của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
