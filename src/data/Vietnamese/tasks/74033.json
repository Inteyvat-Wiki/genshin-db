			"dialogs": [
				{
					"id": 740330101,
					"content": "Sau khi Đường Hầm Mỏ Tinh Thể bị chặn thì không mấy ai đến đây nữa, thiết bị ở đây cũng không còn phù hợp để sử dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330102,
					"content": "Nhưng lần này ai đó đã tự ý vặn van chuyển động và nhốt đồng bọn của mình lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330103,
					"content": "Tóm lại, trước tiên chúng ta cần thao tác van để mở lối đi thông với <color=#00E1FFFF>Kho Tiếp Tế 1</color>. Nếu lát nữa anh ấy mời uống gì đó thì nên khéo léo từ chối nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330104,
					"content": "Ai muốn mời nước cơ? Mà sao lại từ chối thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "Lát nữa hai vị sẽ biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
