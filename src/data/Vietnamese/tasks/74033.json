							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "Mitul, anh ổn chứ? Có bị nhốt lâu quá không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330402,
					"content": "Cứu tinh của tôi! Cuối cùng các vị cũng đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330403,
					"content": "Koblenz đâu? Anh ta không đi cùng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330404,
					"content": "Anh ấy đã cầu cứu, nói là anh bị nhốt ở đây. Nhưng nửa đường thì bị cai ngục xen vào nên đã về trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330405,
					"content": "Biết ngay anh ta không phải bạn làm ăn đáng tin cậy mà! Chắc do quá sợ hãi, cắn rứt lương tâm nên đã tháo chạy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330406,
					"content": "Đã làm ăn, không có gan thì làm sao có lợi nhuận chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330407,
					"content": "Anh ta không chỉ vụng về, mà còn sợ này sợ kia nữa... Đừng nói đến Nước Tinh Khiết, giờ Fonta cũng về hàng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330408,
					"content": "Fonta mà về hàng thì chúng ta làm gì còn đường sống chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330409,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330410,
					"content": "Sao vậy? Mấy người cũng thích Fonta à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330411,
					"content": "Sao, anh không thích à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "Đương nhiên là tôi thích! Tôi phải thừa nhận, đó là một đối thủ cạnh tranh đáng gờm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330415,
					"content": "Không nói nhiều nữa, tôi phải đi tính sổ với tên Koblenz đây. Đúng rồi, anh ta chưa trả thù lao phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330416,
					"content": "Chưa hề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330417,
					"content": "...Đôi lúc tôi thực sự muốn nhốt anh ta vào thùng cho tự kiểm điểm quá. Tóm lại, xin hãy nhận Phiếu Đặc Cách này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330418,
					"content": "#{NICKNAME} và Paimon nhận lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330419,
					"content": "Hả? Đưa hết cho chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330420,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330421,
					"content": "Hihi, vậy thì xin nhé. Để đến Tiệm Xương Mục xem có gì thú vị không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330422,
					"content": "Đúng rồi, đã gây rắc rối cho mọi người như vậy, tôi có mấy chai thức uống tươi mát tốt cho sức khỏe đây, mọi người muốn thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330423,
					"content": "Thức uống tươi mát... tốt cho sức khỏe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330424,
					"content": "Còn tốt hơn Nước Tinh Khiết đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330425,
					"content": "Cho tôi một ly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "(Này! Caterpillar đã nói rồi, đừng nên uống thì hơn...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330427,
					"content": "#Mặc kệ {NICKNAME} đi! Trước khi tới đây chúng tôi đã... hmm, uống nhiều nước ngọt lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330431,
					"content": "Tiếc quá, sau này có cơ hội chúng tôi nhất định sẽ thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330432,
					"content": "Vậy sao? Thôi được, sau này hãy đến tìm tôi, tôi sẽ chiêu đãi đàng hoàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330433,
					"content": "Vậy tôi đi trước đây, phải đi tìm Koblenz đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330434,
					"content": "Tôi có chuyện cần làm, tạm chia tay ở đây nhé. Chuyện Phiếu Đặc Cách cũng đừng quá lo lắng, <color=#00E1FFFF>nếu có manh mối thì tôi sẽ ghi trên bảng đen</color>. Lát gặp lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330435,
					"content": "Ừm, vậy chúng ta gặp nhau sau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330428,
					"content": "Cho tôi một ly Fonta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "Có thì có... Hửm? Đang coi thường thức uống lành mạnh của tôi đấy à? Để tôi nói cho mà nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330430,
					"content": "#Ý {NICKNAME} không phải vậy! Chỉ là... trước khi tới đây chúng tôi uống nhiều nước ngọt lắm rồi, bây giờ đang no lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330413,
					"content": "Cũng thường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "Hửm? Xem ra là một vị khách có gu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				}
			]
		}
	]
}