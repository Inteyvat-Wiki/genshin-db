						750090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090203,
					"content": "Rrrah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "Mặc dù không phải là thứ được khai quật ra, nhưng dù gì nó vẫn được tìm thấy ở đây... Nói không chừng nó cũng có giá trị lớn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090205,
					"content": "Khi rời khỏi đây thì đi hỏi thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
