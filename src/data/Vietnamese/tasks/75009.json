			"dialogs": [
				{
					"id": 750090601,
					"content": "Thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090602
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090602,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} tìm thấy cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090603,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090604
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090604,
					"content": "Để xem nào... Đây là một vật rất hiếm đấy. Nó được bảo quản tốt, các đường vân Phlogiston cũng rất rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090605
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090605,
					"content": "Ừm. Nếu tôi trả 10.000 Mora thì có thể giao nó cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090606
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090606,
					"content": "Hả?! Lẽ nào đã tìm thấy di vật Saurian vô giá thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090607,
					"content": "#Biết ngay {REALNAME[ID(2)|SHOWHOST(true)]} là một Saurian tuyệt vời có thể mang lại may mắn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090608,
					"content": "Không, thứ này không quý giá thế đâu. Nếu mang nó đến trụ sở Hiệp Hội Nghiên Cứu Di Vật Saurian để giám định, theo phán đoán của tôi thì cùng lắm chỉ đáng giá 5000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090609
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090609,
					"content": "Tôi không bị lừa đâu. Nếu nó chỉ đáng giá 5000 Mora thì sao cô lại trả 10.000 để mua lại nó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090610,
					"content": "Vì tôi rất thích đường vân độc đáo của nó. Mặc dù trong mắt người khác nó không có giá trị cao đến vậy, nhưng tôi sẵn sàng chi thêm tiền để có được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090611
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090611,
					"content": "Có thể nói đây là sự kỳ quặc của tôi, hoặc cũng có thể coi là bản chất của một nhà sưu tầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090612
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090612,
					"content": "Hmm... Nói vậy thì có vẻ tôi cũng hiểu được. Hơn nữa, so với 300 Mora phí vào cửa thì 10.000 Mora cũng khá nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090613,
					"content": "Vậy chúng ta có nên đổi nó lấy 10.000 Mora không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090614,
					"content": "Wrroh... Rrrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090615
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090615,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} có vẻ không muốn lắm... Muốn giữ lại cho riêng mình sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090616,
					"content": "Rrrah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090617,
						750090618
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090617,
					"content": "#Dù sao cũng là {REALNAME[ID(2)|SHOWHOST(true)]} tìm được mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				},
				{
					"id": 750090619,
					"content": "#Vì {REALNAME[ID(2)|SHOWHOST(true)]} không muốn nên chúng tôi sẽ giữ nó lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090620,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090621,
					"content": "#Xem ra mọi người coi trọng {REALNAME[ID(2)|SHOWHOST(true)]} hơn cả Mora nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090622
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090622,
					"content": "#Tất nhiên rồi. {REALNAME[ID(2)|SHOWHOST(true)]} cũng là đồng đội của chúng tôi mà. Tuy nhiên, nếu sau này chúng tôi tìm được thứ gì đó tương tự thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090623,
					"content": "Cảm ơn, nhưng hứng thú của nhà sưu tầm giống như thủy triều vậy, lên nhanh và xuống cũng nhanh. Có lẽ sau này tôi sẽ lại đam mê thứ khác, nhưng đó là gì thì tôi không nói trước được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090624
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090624,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090625
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090625,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} đồng tình sao? Hiểu rồi, đây chắc là sự đồng cảm giữa những nhà sưu tầm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090626,
					"content": "Thật vinh dự khi được một Tepetlisaur nhỏ thông minh như vậy công nhận. Giao dịch tuy không thành, nhưng tình nghĩa vẫn còn. Sau này nếu muốn trao đổi kinh nghiệm sưu tầm thì cứ đến trò chuyện với tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090627
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090627,
					"content": "Vậy tôi không làm phiền nữa, chúc may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090618,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} cũng muốn làm nhà sưu tầm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				}
			]
