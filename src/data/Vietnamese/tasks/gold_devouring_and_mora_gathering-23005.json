				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "Ừm... Xem ra vẫn ổn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050202,
					"content": "Xem ra ông cũng kiếm được kha khá nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "Ối, Nhà Lữ Hành! Nhờ cháu mà lần này ta đã kiếm được một khoản nhỏ, xem ra \"Món Ăn Vàng\" đúng là có chút hiệu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050204,
					"content": "Nhưng so với những gì ta thường kiếm được từ giao dịch thì cũng không kém hơn là bao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050205,
					"content": "Đây đáng lẽ không nên là hiệu quả mà \"Món Ăn Vàng\" nên có, chẳng lẽ đồ ăn mà ta dùng không đúng sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050206,
					"content": "Nhà Lữ Hành, vậy chúng ta hãy thử lại một lần nữa xem, cháu giúp ta chọn lại \"Món Ăn Vàng\" được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050207,
					"content": "Vẫn theo quy tắc cũ, chọn một trong các món <color=#00E1FFFF>Thịt Mora</color>, <color=#00E1FFFF>Gà Áp Chảo</color> và <color=#00E1FFFF>Pile 'Em Up</color> là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
