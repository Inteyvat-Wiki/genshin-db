					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "Ờm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050402,
					"content": "Chào ông Hatim, dạo này thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050403,
					"content": "Hửm... Là các cháu à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050404,
					"content": "Haiz, nhìn thấy vẻ mặt của ta thì chắc các cháu cũng đoán được rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050405,
					"content": "Thú thật thì đến giờ, hầu bao của ta đã vơi đi một nửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050406,
					"content": "Lạ thật... không nên như thế này mới phải chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050407,
					"content": "Nhưng nhìn lại thì... ta đoán rằng có lẽ đây là dấu hiệu cho thấy thị trường sẽ tăng trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050408,
					"content": "Giống như con người phải co chân lại thì mới có thể bật nhảy thật cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050409,
					"content": "Bây giờ toàn bộ thị trường đã xuống đáy. Đáy không mua thì đỉnh sao bán, lần này mà mua thì nhất định sẽ tăng vọt lên tận mặt trăng luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050410,
					"content": "Nói cách khác, bây giờ là thời điểm tốt nhất để bắt đáy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050411,
					"content": "Nói không chừng giá vẫn còn đang xuống đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "Không, ta rất chắc chắn, đây là cơ hội hiếm có, ta sẽ không bỏ qua bất kỳ cơ hội làm giàu nào đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050414,
					"content": "Như vậy mới xứng với danh tiếng phú ông Hatim siêu phàm của Kalimi ta chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050415,
					"content": "Giúp ta thêm lần nữa đi! Giúp ta chọn thêm một phần \"Món Ăn Vàng\" nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050416,
					"content": "Vẫn chọn trong ba món ban đầu đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050417,
					"content": "...Không! Vì ta đang bắt đáy, nên ta cần một phần nguyên liệu đặc biệt hơn thế, nó có thể giúp cho thị trường có chuyển biến tốt hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050418,
					"content": "Ta nghe nói ở Mondstadt cũng có một phú ông, việc kinh doanh rượu của người này cực kỳ phát đạt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050419,
					"content": "Ông đang nói đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "Lão gia Diluc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050421,
					"content": "Nhưng sao ông biết được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050422,
					"content": "Hahaha, ta thậm chí còn biết cả món \"Pile 'Em Up\" thì sao lại không biết cậu ta được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050423,
					"content": "Cậu ta có một quán rượu dưới danh nghĩa của mình, bán một thứ rượu ngon có tên là \"Nước Táo Lên Men\", nếu có thể uống được nó, ta tin rằng sẽ có thể mượn được vận may tốt lành từ cậu ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050424,
					"content": "Năn nỉ đó, xin hãy chuẩn bị cho ta một phần Nước Táo Lên Men đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050412,
					"content": "Co chân lại cũng có thể là do đau chân đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
