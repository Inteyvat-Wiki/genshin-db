				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "Lần trước lãi nhỏ, lần này chắc chắn lãi lớn, <color=#00E1FFFF>Thịt Mora </color>, <color=#00E1FFFF>Gà Áp Chảo</color> và <color=#00E1FFFF>Pile 'Em Up</color>! Thế nào, chọn được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
