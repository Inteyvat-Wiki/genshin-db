				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050601,
					"content": "Đây là Nước Táo Lên Men của cậu ta sao? Ừm, bên trong quả nhiên có một hương vị tuyệt vời, khiến cho đầu óc của ta tỉnh táo hẳn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "Được rồi! Đây chắc chắn là một món tốt để giúp tạo ra sự thay đổi trên thị trường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "Ta sẽ không quên sự giúp đỡ của các cháu đâu! Chúng ta gặp lại sau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300507,
