					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500204,
					"content": "Được rồi, đi thong thả nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
