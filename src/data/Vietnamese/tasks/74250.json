			"dialogs": [
				{
					"id": 742500101,
					"content": "Nghĩ lại thì lúc trước khi mọi người đến Snezhnaya, tôi cũng chưa từng tiếp đãi chu đáo thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500102,
					"content": "Đừng nói vậy, quý cô Sandrone. Dù trước đây chúng ta không có dịp ngồi lại trò chuyện thế này, nhưng mỗi lần cô đều chuẩn bị cho chúng tôi trà bánh ngon tuyệt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500103,
					"content": "Haiz, xin lỗi nhé. Trước đây bận quá, lần sau mọi người đến, tôi nhất định sẽ chăm sóc chu đáo hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500104,
					"content": "Trước đây cô chẳng bao giờ cho tôi chơi những cỗ máy mà cô phát minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500105,
					"content": "Có lý do cả đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500106,
					"content": "Hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500107,
					"content": "Thực ra, \"cha\" cũng từng nói với chúng tôi là hãy cố gắng đừng làm phiền quý cô Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500108,
					"content": "Không sao đâu, tôi không phiền. Lần sau đến chỗ tôi uống trà chiều nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500109,
					"content": "Thật sao? Thực ra tôi... luôn muốn nhờ cô xem giúp Pers... Tôi có vài hướng cải tiến muốn xin lời khuyên của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500110,
					"content": "Được thôi, chuyên môn của tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500111,
					"content": "...Cảm ơn quý cô Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500112,
					"content": "Làm Quan Chấp Hành có phải rất vất vả không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500113,
					"content": "Nếu hỏi vậy thì... cũng hơi hơi đấy. Có rất nhiều thứ phải cân nhắc. Dù phần lớn những bất mãn trong công việc đều đến từ đồng nghiệp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500114,
					"content": "Có nghĩa là... việc hòa hợp với người khác rất quan trọng, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500115,
					"content": "Có thể nói vậy. Tôi thấy Lyney chắc không có gì phải lo lắng về vấn đề này cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500116,
					"content": "Haha, không dám đâu, quý cô Sandrone quá lời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500117,
					"content": "Có muốn trở thành Quan Chấp Hành không? Mà thôi, chủ đề này không nên do tôi hỏi. Coi như tôi chưa nói gì đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742500118,
					"content": "Ừm... Chủ đề này vẫn còn hơi xa vời với tôi. Có lẽ để sau này suy nghĩ cũng chưa muộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500119,
					"content": "Trở thành Quan Chấp Hành, có phải sẽ không còn thời gian cùng hành động nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500120,
					"content": "Nếu vậy thì... có phải... em và Lynette cũng phải trở thành Quan Chấp Hành không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500121,
					"content": "Hai đứa này, anh đã nói rồi mà, chuyện đó sau này hãy tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500122,
					"content": "Hơn nữa, dù ở đâu, anh cũng sẽ không bỏ rơi hai đứa đâu, anh hứa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500123,
					"content": "Hah... Đôi khi tôi thật sự ngưỡng mộ gia đình của mọi người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
