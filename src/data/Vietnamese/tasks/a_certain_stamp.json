			"dialogs": [
				{
					"id": 740360301,
					"content": "Được rồi, đã đóng dấu công, đã đóng tài liệu, tiếp theo chỉ cần giao cho ngài Difor là xem như kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360302,
					"content": "Tối hôm nay tôi nhất định phải ngủ một giấc thật ngon, quên sạch những chuyện này, ngày mai xin nghỉ thêm một ngày, đi tìm Estelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360303,
					"content": "Anh Iaune, hiện anh có rảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360304
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360304,
					"content": "Tôi rảnh, cô có chuyện gì sao? Chẳng lẽ biên lai giải chi xong sớm vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360305,
					"content": "Không phải chuyện đó, nhưng... ngài Neuvillette có phái người đến báo tôi hỏi ngài, tại sao lại giải chi mỗi một nắp phím mà không phải cả cái máy đánh chữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360306
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360306,
					"content": "Vì... vì tôi chỉ rớt mất một cái nắp phím mà, tại sao lại phải giải chi cả một cái máy đánh chữ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360307
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360307,
					"content": "Hmm, theo lý thì đúng là như vậy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360308,
					"content": "Do danh sách giải chi của chúng tôi có máy đánh chữ nhưng lại không có nắp phím, cho nên nắp phím là một mục giải chi hoàn toàn mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360309
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360309,
					"content": "Ngài cần phải viết một văn bản nộp cho ngài Neuvillette, giải thích chi tiết lý do tại sao ngài chỉ giải chi một nắp phím...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360310
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360310,
					"content": "Cứ cảm thấy chúng ta không phải đang thảo luận một chuyện nghiêm túc, mà như đang kể chuyện cười nhạt nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360311,
						740360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360311,
					"content": "Có cần thiết phải làm vậy không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360313
					]
				},
				{
					"id": 740360313,
					"content": "Cho nên, cô muốn tôi... cô muốn tôi viết một báo cáo riêng cho ngài Neuvillette, giải thích việc tôi đã làm mất một cái nắp phím sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360314
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360314,
					"content": "Bên Sảnh Chính Luật nói, đây là yêu cầu của chính ngài Neuvillette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360315
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360315,
					"content": "Bảo sao! Sảnh Chính Luật dù làm gì thì cũng sẽ nói \"đây là yêu cầu của chính ngài Neuvillette\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360316
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360316,
					"content": "Nhưng không ai dám cược xem lời này có phải thật hay không. Được rồi Iaune, hãy bình tĩnh nghe tôi nói đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360317
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360317,
					"content": "Anh là một Kiểm Sát Viên, mệnh lệnh của thẩm phán tối cao đối với anh có ý nghĩa hành chính bắt buộc. Nói cách khác chính là anh bắt buộc phải viết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360318
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360318,
					"content": "Đây không phải là một chuyện xấu, vừa hay anh có thể mượn cơ hội này để ngài Neuvillette xem qua văn phong của anh. Không phải ai cũng có cơ hội báo cáo văn bản riêng cho ngài ấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360320
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360320,
					"content": "Nhưng mà, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360319
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360319,
					"content": "Ôi... tiêu rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360321
					]
				},
				{
					"id": 740360321,
					"content": "Chào mọi người, có tin tốt đây, chúng tôi vừa bắt tại trận một người vi phạm lỗi dùng máy ảnh làm rò rỉ bảo mật! Hoàn toàn có thể dùng làm ví dụ nên tránh trong thư kiến nghị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360322
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360322,
					"content": "Cái người biết luật lại phạm luật này, chính là ngài Carsix, người đã nhắc nhở chúng ta không được dùng máy ảnh làm rò rỉ thông tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360323
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360323,
					"content": "Người này... vì anh ta nên Iaune mới phải thức đêm viết bản thảo! Sao chính anh ta lại phạm lỗi trước vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360324,
					"content": "Anh ta đã dùng máy ảnh chụp kha khá hình phòng làm việc của chính mình, rồi gửi cho ký giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360325
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360325,
					"content": "Trong số những bức ảnh đó, anh ta đã chụp luôn cả biên bản cuộc họp của mình vào. Hiện dân chúng đã phát hiện, biên bản cuộc họp của anh ta hoàn toàn không giống với nội dung anh ta đã phát biểu trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360326
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360326,
					"content": "Hiện bên ngoài đang lan truyền rầm rộ, phòng làm việc của Carsix cũng sắp trở thành trò cười bậc nhất Fontaine rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360327
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360327,
					"content": "Đợi đã! Biên bản cuộc họp liên quan gì đến phát biểu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360328,
					"content": "Hầu như tất cả các bài phát biểu đều được tổng kết từ trong biên bản cuộc họp, nên đương nhiên là có liên quan đến nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360329
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360329,
					"content": "Vậy tại sao lại không giống nhau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360330
					]
				},
				{
					"id": 740360330,
					"content": "Ồ, chuyện này cũng thường thôi. Tác dụng lớn nhất của biên bản cuộc họp, là để cho chúng ta biết những điều gì không được xuất hiện trong bài phát biểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360331
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360331,
					"content": "Carsix không biết được mình phải nói gì đâu, cũng chẳng có cách nghĩ của riêng mình, toàn nhờ cấp dưới nhắc nhở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360332
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360332,
					"content": "Đợi đã, ngài Carsix hiện đang ở đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360333
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360333,
					"content": "Đang đợi điều tra trong phòng làm việc của chúng tôi, vì việc rò rỉ tài liệu bảo mật, còn khiến cho mọi chuyện rùm beng lên... Tin chắc anh ta sẽ phải ở lại đây một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360334
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360334,
					"content": "Vậy còn tài liệu tôi viết thì phải làm sao! Tôi đã viết xong hết rồi, dấu cũng đóng luôn rồi, tôi... khụ khụ khụ... khụ khụ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360335
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360335,
					"content": "Không, không sao đâu, cũng đã viết xong rồi, chắc chắn phải được gửi đi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360336,
						740360337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360336,
					"content": "Sẽ không bỏ công vô ích đâu, anh bình tĩnh đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360338
					]
				},
				{
					"id": 740360338,
					"content": "Iaune! Iaune, cậu có ở đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360339
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360339,
					"content": "Ngài Semaine, cuối cùng ngài cũng đến rồi, hãy cho tôi ý kiến nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360340
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360340,
					"content": "Khoan nói chuyện này đã, cái nắp phím đó, cậu đã xin giải chi chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360341
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360341,
					"content": "Còn phải hỏi sao? Thậm chí tôi còn phải vì cái nắp phím này mà viết một bản báo cáo cho ngài Neuvillette nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360342
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360342,
					"content": "Ôi... trời ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360343
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360343,
					"content": "Cậu xem, đây có phải cái nắp phím đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360344
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360344,
					"content": "Ngài... tìm ở đâu ra vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360345
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360345,
					"content": "Ngay dưới bàn làm việc của tôi, chắc là khi nhân viên vệ sinh quét nhà đã không cẩn thận quét sang đó, có người nhìn thấy nên đã đặt trên bàn tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360346
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360346,
					"content": "Tôi tưởng là của mình nên đã cất đi. Nhưng hôm nay nhìn lại... máy đánh chữ của tôi vẫn còn hoàn chỉnh, cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360347
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360347,
					"content": "Cơn ác mộng này, rốt cuộc khi nào mới kết thúc đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360348
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360348,
					"content": "#{NICKNAME}, rốt cuộc ý nghĩa công việc của tôi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360349
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360349,
					"content": "Iaune chóng mặt ngã xuống đất...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360350
					]
				},
				{
					"id": 740360350,
					"content": "Ối! Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360351
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360351,
					"content": "Iaune tức tốc được đưa đi gặp bác sĩ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360352
					]
				},
				{
					"id": 740360352,
					"content": "Haiz, đây là lỗi của tôi! Nếu tìm được nắp phím sớm hơn thì đã không thành ra thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360353
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360353,
					"content": "Đây vốn dĩ đâu phải là vấn đề về nắp phím?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360354
					]
				},
				{
					"id": 740360354,
					"content": "Đúng thế! Mọi thứ loạn hết cả lên, Iaune không biết phải làm sao nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360355,
					"content": "Gattineo và Difor cũng chạy mất tiêu... Mấy người này rốt cuộc là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360356,
						740360357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360356,
					"content": "Iaune rất quan tâm đến ý nghĩa công việc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360358
					]
				},
				{
					"id": 740360358,
					"content": "Haiz, cậu nhóc tốt bụng này lúc nào cũng nghĩ tới việc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360359
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360359,
					"content": "\"Ý nghĩa của công việc\", một chủ đề lớn như vậy, không thể vài ba câu là nói hết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360360
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360360,
					"content": "Lúc nào cũng suy nghĩ về chuyện này, chỉ khiến cho áp lực trong lòng ngày một nặng nề hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360361
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360361,
					"content": "Vậy các anh có biết đáp án của vấn đề không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360362
					]
				},
				{
					"id": 740360362,
					"content": "Không, trước giờ tôi không suy nghĩ về chuyện này, tôi chỉ làm việc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360363
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360363,
					"content": "Còn tôi thì... Tuy đôi lúc cũng nghĩ đến chuyện đó, nhưng tôi có cách để giải quyết áp lực của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360364
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360364,
					"content": "Nếu muốn tìm đáp án của vấn đề... có lẽ chúng ta nên dành thời gian để nói chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360365
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360365,
					"content": "Nhưng giờ tôi phải đi mua trái cây, bầu bạn với cậu nhóc Iaune này một lát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360366
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360366,
					"content": "Đây là chuyện quan trọng, tôi cũng đi giúp Iaune viết đơn xin nghỉ ốm, quả thực cậu ấy nên nghỉ ngơi cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360367
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360367,
					"content": "Được đấy, chúng ta đều có việc của mình, vậy cứ thế mà làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360368
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360368,
					"content": "#{NICKNAME}, gặp lại sau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360369
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360369,
					"content": "Hừm, kỳ lạ... Mẫu đơn xin nghỉ ốm tôi để đâu rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360357,
					"content": "Iaune không biết ý nghĩa công việc nằm ở đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360358
					]
				},
				{
					"id": 740360337,
					"content": "Cứ bình tĩnh đã, chắc chắn sẽ có cách mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360338
					]
				},
				{
					"id": 740360312,
					"content": "Chuyện này có phải hơi nực cười rồi không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360350
					]
				}
			]
		},
