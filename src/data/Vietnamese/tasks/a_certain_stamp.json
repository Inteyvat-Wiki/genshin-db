					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360102,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				},
				{
					"id": 740360104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360105,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360106
					]
				},
				{
					"id": 740360106,
					"content": "Hả?! Sao vậy! Tôi viết xong rồi, đã viết xong rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360107,
					"content": "Là tôi đây, anh viết xong rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360108
					]
				},
				{
					"id": 740360108,
					"content": "Là bạn à, tôi chắc là đã ngủ gật mất, thật xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360109,
					"content": "Ngài Roialte và ngài Semaine giúp tôi đến nửa đêm, dưới sự chỉ dẫn của họ, cuối cùng tôi cũng viết xong thư kiến nghị đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360110,
					"content": "Nhưng tôi mệt quá rồi, nên nhắm mắt nghỉ ngơi một lúc, không ngờ lại ngủ đến giờ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360111,
					"content": "Tôi phải đi tìm Thales để đóng dấu Sảnh Phúc Luật cho thư kiến nghị này, sau đó mang đến cho ngài Difor đóng dấu, cuối cùng mới chính thức in ấn phát hành... vậy là xong việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360112,
						740360113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360112,
					"content": "Nghe có vẻ đơn giản đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360114,
					"content": "Chứ sao. Hơn nữa tôi nghe nói bên Thales vừa mới nhập một máy đóng dấu mới, vừa hiện đại lại vừa bảo mật, dự tính sẽ được quảng bá trong cả Sảnh Phúc Luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360115,
					"content": "Xem này, ngài Roialte còn cho tôi một chiếc chìa khóa. Mỗi bộ phận đều phải dùng chìa khóa để khởi động máy đóng dấu... tóm lại nghe có vẻ chính quy lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360116,
					"content": "Chi bằng, anh ngủ thêm một lát đi? Tôi thấy anh đi đường như sắp ngã đến nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360117,
					"content": "Dù gì cũng chỉ là đi đóng dấu, hơn nữa còn có cái... máy đóng dấu đó, đâu cần gấp gáp đến thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360118,
					"content": "Không, không thể chậm trễ thêm nữa, chúng ta xuất phát ngay nào, chỉ là đóng dấu thôi, chắc cũng không tốn nhiều thời gian đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360113,
					"content": "Cuối cùng cũng không phức tạp như trước rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360103,
					"content": "Anh... đã viết xong chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				}
			]
		},
