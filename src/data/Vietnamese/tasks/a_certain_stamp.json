			},
			"dialogs": [
				{
					"id": 740360201,
					"content": "Thales, hiện có thể đóng dấu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360202,
					"content": "Được chứ, anh có mang theo chìa khóa không? Ký tên ở đây trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360203
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360203,
					"content": "Tôi còn tưởng sau khi các anh có cỗ máy này, thì không cần ký tên nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360204,
					"content": "Cái này... cỗ máy dù sao cũng phải do con người điều khiển mà, vậy thì vẫn phải ký tên bảo đảm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360205
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360205,
					"content": "Nhưng tính bảo mật của cỗ máy này thì tuyệt vời luôn, nếu không có chìa khóa thì cho dù tôi cũng không khởi động được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360206
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360206,
					"content": "Đặt tài liệu dưới chỗ này, nhất định phải canh chuẩn. Sau đó cắm chìa khóa vào đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360207
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360207,
					"content": "Đây chính là \"máy đóng dấu tự động\" đó sao? Nhìn cũng... bình thường quá nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360208,
					"content": "Như vậy đúng không, sau đó xoay một cái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360209
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360209,
					"content": "Đợi đã, hãy giữ nguyên tư thế này, tôi còn phải chụp ảnh cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360210,
						740360211
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360210,
					"content": "Không sợ rò rỉ thông tin mật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				},
				{
					"id": 740360212,
					"content": "Đây là quy định do ngài Carsix đặt ra, nhất định phải dùng máy ảnh để lưu hình ảnh khi người thao tác đóng dấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360253
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360253,
					"content": "Tôi phải đổi vị trí... không thể chụp văn bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360213
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360213,
					"content": "Gần đây, có người nói rằng sắp tới sẽ có một văn bản quy định về việc máy ảnh rò rỉ thông tin. Tôi không muốn làm người đầu tiên bị xử lý đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360214
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360214,
					"content": "#{NICKNAME}, chúng ta cũng đứng xa ra chút nào, nếu bị chụp trúng thì không chừng cũng bị cuốn vào \"sự kiện rò rỉ bảo mật\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360255,
					"content": "Thales vô cùng cẩn thận chụp ảnh...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360215
					]
				},
				{
					"id": 740360215,
					"content": "...Chụp xong rồi, anh mở máy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360216
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360216,
					"content": "Tôi xoay rồi đấy, sao không có động tĩnh gì hết vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360217,
					"content": "Không thể nào, tôi vừa sửa xong, sao hỏng được nữa chứ? Để tôi xem nào, đừng lo, sẽ xong nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360218
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360218,
					"content": "Thales cúi đầu kiểm tra cỗ máy...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360219
					]
				},
				{
					"id": 740360219,
					"content": "Kỳ lạ, đâu có bị gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360220
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360220,
					"content": "Thử rút rồi cắm lại chìa khóa lần nữa xem sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360221
					]
				},
				{
					"id": 740360221,
					"content": "Được rồi, để tôi thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360222
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360222,
					"content": "Iaune rút chìa khóa rồi lại cắm vào. Cỗ máy vẫn không có chút động tĩnh nào...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360223
					]
				},
				{
					"id": 740360223,
					"content": "Không có gì hết, Thales, thử nghĩ cách xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360224
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360224,
					"content": "Có lẽ do anh chưa đặt tài liệu vào đúng vị trí? Anh phải đặt chính giữa những chốt này mới được, bên trong có cơ chế kích hoạt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360225
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360225,
					"content": "Tài liệu và cỗ máy có liên quan đến nhau sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360226
					]
				},
				{
					"id": 740360226,
					"content": "Đương nhiên rồi, nếu không sao cỗ máy này biết bên dưới có tài liệu cần đóng dấu chứ, đây là một máy đóng dấu tự động, đâu phải do tôi tự tay điều khiển đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360227
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360227,
					"content": "Trời ơi... được rồi, được rồi! Để tôi đặt lại tài liệu, canh chuẩn tất cả chốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360228
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360228,
					"content": "Iaune lấy tài liệu ra, rồi đặt lại vào. Máy móc vẫn không thay đổi gì...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360229
					]
				},
				{
					"id": 740360229,
					"content": "Không có tác dụng, nó vẫn không chuyển động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360230
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360230,
					"content": "Không đúng, lần trước tôi chỉ vỗ một cái, rồi cỗ máy này liền tiếp tục hoạt động mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360231
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360231,
					"content": "Vậy để tôi đi vỗ nó thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360232
					]
				},
				{
					"id": 740360232,
					"content": "Chúng ta đã đến mức phải dùng cách... như cầu nguyện với thần linh để sửa chữa máy móc rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360233
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360233,
					"content": "Chí ít thì chúng ta còn có cơ hội cầu nguyện đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360234
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360234,
					"content": "(Vỗ nhẹ vào cỗ máy.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360235
					]
				},
				{
					"id": 740360235,
					"content": "(Cỗ máy này đáp lại bằng sự im lặng...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360236,
					"content": "(Dùng thêm lực để vỗ vào cỗ máy.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360237
					]
				},
				{
					"id": 740360237,
					"content": "(Cỗ máy này còn chẳng thèm phản kháng...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360238
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360238,
					"content": "(Vỗ thật mạnh vào cỗ máy!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360239
					]
				},
				{
					"id": 740360239,
					"content": "(Cỗ máy này im lặng một lúc, sau đó bực bội phát ra tiếng lạch cạch, như một người vừa thức dậy loạng choạng lăn xuống giường...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360240
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360240,
					"content": "Ối! Tiếng gì vậy, bên trong cỗ máy có phải đã hỏng hết rồi không vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360241,
					"content": "(...Sau đó, cỗ máy chệnh choạng tìm dép lê của nó, mò mẫm một lúc, cuối cùng cũng bật đèn lên, bắt đầu ù ù vận hành.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360242
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360242,
					"content": "Cuối, cuối cùng cũng chạy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360243,
					"content": "Máy đóng dấu tự động mệt mỏi nhưng vẫn kiên nhẫn bắt đầu làm việc. Dưới sự dõi theo gần như tuyệt vọng của con người, cỗ máy hạ con dấu xuống với tốc độ như rùa bò. Con dấu hạ xuống, loay hoay với tài liệu, sau khi quanh co một lúc chỉ có thể ngồi xuống nghỉ ngơi. Cuối cùng, cỗ máy run rẩy thu con dấu về...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360244
					]
				},
				{
					"id": 740360244,
					"content": "Tôi đã nói nó có thể hoạt động bình thường mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360245
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360245,
					"content": "Tôi thật không biết máy này có gì tốt, nói là tự động, nhưng tốc độ đóng dấu của nó còn chậm hơn thủ công đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360246
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360246,
					"content": "Nhưng tính bảo mật của nó rất tốt. Anh xem, cả ba người chúng ta cũng không có cách nào lấy được con dấu để tự tiện đóng dấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360247
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360247,
					"content": "Đừng có đắc ý, nếu ngày nào đó cỗ máy này hỏng hoàn toàn, và ngài Carsix cũng không ở đây, vậy thì phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360248
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360248,
					"content": "Ừm... Vậy cũng không còn cách nào khác, tôi còn một chiếc chìa khóa dự phòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360249
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360249,
					"content": "Nó dùng để mở cỗ máy này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360250
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360250,
					"content": "Không, nó dùng để mở một chiếc hộp trong phòng làm việc của ngài Carsix, bên trong có con dấu công dự phòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360251
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360251,
					"content": "...Nhà Lữ Hành, chúng ta mau quay về để đóng tài liệu này rồi giao cho ngài Difor nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360252
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360252,
					"content": "Tôi thực sự rất muốn mau chóng thoát khỏi cơn ác mộng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360211,
					"content": "Sao còn phải chụp ảnh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				}
			]
		},
