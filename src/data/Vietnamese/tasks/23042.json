			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "Tốt quá, nguyên liệu đợt trước vẫn còn thừa một ít, cộng với phần mà bạn đưa đến, tôi có thể làm thêm vài lần rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420502,
					"content": "Phù... Tôi phải xem kỹ ghi chép, lần này nhất định phải thành công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420503,
					"content": "Đúng rồi, tôi còn phải đi hái vài cánh hoa nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420504,
					"content": "Nermin bắt đầu khẩn trương chế tạo \"Nước Hoa\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "Hoàn thành rồi! Mùi hương cũng được... cũng không trở nên đặc sệt nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420506,
					"content": "Thế này hẳn xem như thành công rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420507,
					"content": "Chắc là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "Ừm! Tôi còn cố ý mua một chiếc bình để đổ nước hoa vào trong đó nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420510,
					"content": "Nhà Lữ Hành, chúng ta cùng nhau tặng nước hoa cho Raef nhé, hy vọng anh ấy sẽ thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420508,
					"content": "Ít nhất cũng không phải là thất bại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
		{
			"id": 2304206,
			"completionStepIds": [
				2304206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304206",
							"2"
						],
						"stepId": 2304206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef",
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "Nermin, còn có Nhà Lữ Hành nữa... sao hai người lại đến đây? Gặp phải chuyện phiền phức gì ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420602,
					"content": "Không phải là bồn hoa kia có vấn đề gì chứ? Tôi còn đang trong ca trực, đợi sau khi tôi hết ca trực sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420603,
					"content": "Nermin có đồ muốn tặng cho anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "Bình \"Nước Hoa\" này tặng cho anh! Là hương bạc hà đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420605,
					"content": "Em vốn định làm hương \"Đào Zaytun\", nhưng không biết vì sao, em cứ hễ thêm Đào Zaytun vào là nước hoa sẽ trở nên đặc sệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420606,
					"content": "Cảm... cảm ơn, nhưng \"Nước Hoa\" dùng để làm gì? Đuổi côn trùng hay là để đánh dấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420607,
					"content": "Là dùng để giúp anh tỉnh táo hơn, còn giúp che đi mùi mồ hôi, anh ngày nào cũng ngửi mùi mồ hôi không thấy chóng mặt ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420608,
					"content": "Cái này, ngửi quen rồi cũng thấy bình thường, đột nhiên không ngửi thấy lại thấy không quen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420609,
					"content": "Vậy em mang \"Nước Hoa\" đi vậy, anh đừng dùng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420610,
					"content": "Ối! Đừng mà, anh chỉ đùa thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420611,
					"content": "Mau, mau đưa \"Nước Hoa\" cho anh, giờ anh bắt đầu thấy chóng mặt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420612,
					"content": "Thoa lên cổ là được, bà Jawahir nói như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420613,
					"content": "Mùi hương này ngửi cũng không tệ, đúng là thấy tỉnh táo hẳn. Lúc bôi lên còn có cảm giác the mát, rất thoải mái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420614,
					"content": "Hì, đây là công thức bí mật của bà Jawahir đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420615,
					"content": "May mà có Nhà Lữ Hành giúp đỡ nên mới có thể làm ra nhiều \"Nước Hoa\" như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420616,
					"content": "Chỉ là giúp chút chuyện nhỏ mà thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "Ngại quá, làm phiền bạn nhiều như vậy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420618,
					"content": "Những thứ này tặng cho bạn, coi như tiền thưởng, thật sự cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420619,
					"content": "Nước hoa này đúng là dùng tốt thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420620
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420620,
					"content": "Nhưng mà... ừm... Nermin, sao chỗ bôi nước hoa, lại nổi nhiều mẩn đỏ như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
