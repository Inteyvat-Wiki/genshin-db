			"dialogs": [
				{
					"id": 230420301,
					"content": "Xin chào, quý khách cần mua thứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420302,
					"content": "Về \"hàng hóa\" của Nermin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "Cái mà bạn nói ấy à... đã chuẩn bị xong rồi. Chỗ này đều là hương liệu có chất lượng tốt, giá cả cũng không đắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420304,
					"content": "Nermin định dùng những hương liệu này để chế tạo \"Nước Hoa\" đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420305,
					"content": "Haiz, mặc dù có sức sống là chuyện tốt, nhưng Nermin cũng phải chú ý đến sức khỏe của mình chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304205",
							"2"
						],
						"stepId": 2304205,
						"stateName": "QUEST_STATE_UNFINISHED"
