					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "Như vậy nhất định có thể tạo bất ngờ cho Raef... hì hì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420102,
					"content": "Bất ngờ gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "Ối! Nhà Lữ Hành, làm tôi hết hồn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420104,
					"content": "Tôi đi từ phía trước mặt cô đến đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "Tôi đang suy nghĩ vài việc, hoàn toàn không để ý đến bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420106,
					"content": "Nhà Lữ Hành, tôi hỏi bạn... bạn đã nghe qua món đồ gọi là \"Nước Hoa\" chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420107,
					"content": "Bà Jawahir nói với tôi, lúc bà còn trẻ thường tự chế tạo \"Nước Hoa\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420108,
					"content": "Mùi \"nước hoa\" không những che được mùi mồ hôi trên người chủ nhân, một vài loại \"nước hoa\" đặc biệt còn có công dụng an thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420109,
					"content": "Raef vẫn luôn bảo vệ ở trước cổng làng, ngày nào cũng nóng đến mức ướt đẫm mồ hôi, lúc về luôn nói bản thân phơi nắng đến mức hoa mắt chóng mặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420110,
					"content": "Cho nên, tôi muốn làm một bình \"Nước Hoa Bạc Hà\" để tặng cho anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420111,
					"content": "Bà Jawahir đã viết cách chế tạo nước hoa cho tôi rồi, còn giúp tôi mua rất nhiều nguyên liệu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420112,
					"content": "Nhưng chế tạo nước hoa thật sự rất phiền phức... Chỉ riêng việc xử lý nguyên liệu thôi đã tốn rất nhiều thời gian, còn thất bại rất nhiều lần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420113,
					"content": "Nếu cứ tiếp tục như vậy, Raef sẽ phát hiện ra chuyện tôi làm nước hoa mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420114,
					"content": "Cho nên Nhà Lữ Hành, có thể nhờ bạn mua một ít nguyên liệu cho tôi không? Nhất định phải lén lút, không thể để Raef phát hiện ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420115,
					"content": "Nói cho anh ấy nghe cũng không sao cả mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "Không được không được, đây là bất ngờ mà tôi đã chuẩn bị từ lâu, tuyệt đối không thể tùy tiện nói cho anh ấy như vậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420119,
					"content": "Thật ra những nguyên liệu mà tôi muốn nhờ bạn chuẩn bị cũng không nhiều, đầu tiên bạn đến tìm anh Azalai để lấy đồ mà tôi đã đặt, sau đó giúp tôi xách một thùng nước nhỏ về là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420120,
					"content": "Nhớ kỹ, nhất định phải lặng lẽ làm, tuyệt đối không thể để Raef phát hiện ra nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420117,
					"content": "Ừm... cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "Vậy nhờ cả vào bạn nhé. Yên tâm, tôi nhất định sẽ chuẩn bị tiền thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				}
			]
		},
