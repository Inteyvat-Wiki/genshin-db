				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "Thật là xui xẻo! Đội Kỵ Sĩ Tây Phong thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "Hừ, Đội Kỵ Sĩ Tây Phong làm việc thực sự không hiệu quả, nói phía trước có ma vật, không để tôi đi qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000104,
					"content": "Đến giờ họ cũng vẫn chưa có thông báo rõ ràng, thật là không đáng tin cậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000105,
					"content": "Tôi còn rất nhiều việc phải làm, cứ thế này tôi còn phải thiệt hại bao nhiêu tiền đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000106,
					"content": "Có điều... nhìn bạn khá giống Nhà Mạo Hiểm. Thế này đi, tôi trả thù lao, bạn giúp tôi đi làm chút việc, bạn có đồng ý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000107,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Tốt, tôi rất thích những người thẳng thắn, sau khi xong việc, tôi tuyệt đối không để bạn thiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000111,
					"content": "Hilichurl ở Mondstadt ngày một nhiều hơn rồi, không biết có phải tôi bị ảo giác không. Hừ, không biết từ sáng đến tối Đội Kỵ Sĩ Tây Phong đang làm cái gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000112,
					"content": "Bạn đã hứa giúp tôi làm việc, vừa đúng lúc, hãy giúp tôi tiêu diệt Hilichurl. Nhưng bạn cũng chỉ có một mình, hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000113,
					"content": "Thôi bỏ đi, bạn tự chọn một địa điểm xử lý đi, đỉnh núi, lưng chừng núi hay chân núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000114,
					"content": "Dù sao cũng đều là đi tiêu diệt Hilichurl, không có gì khác biệt, đừng lãng phí thời gian của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000109,
					"content": "Có thể trả bao nhiêu tiền?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "Hừ, vậy phải xem bạn làm việc thế nào đã, chỉ cần xong việc, tôi tuyệt đối không để bạn thiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				}
			]
		},
