					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "Nhanh vậy đã trở lại rồi, còn chưa đến một phút đã giải quyết xong rồi à, thân thủ bất phàm, thân thủ bất phàm, hahaha",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000203,
					"content": "Tốt lắm, đây là 5000 mora, không thiếu một đồng, hãy cầm lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000204,
					"content": "Thân thủ bất phàm cũng chỉ 5000 mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000205,
					"content": "Đừng có chê ít, mức thù lao này tôi đã tính rất kỹ rồi, vừa vặn tương xứng với công việc của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000206,
					"content": "Nếu muốn kiếm được nhiều tiền, thì phải làm việc lớn, lần sau nếu có cơ hội, các bạn hãy cố gắng lên một chút.",
					"roleType": "TALK_ROLE_NPC",
