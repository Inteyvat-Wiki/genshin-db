			"trigger": {
				"objectNames": [
					"Mona",
					"Kaedehara Kazuha",
					"Fischl",
					"Oz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "Wow! Cái, cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760902,
					"content": "Lại là kiến trúc nhà cửa ở Mondstadt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760903,
					"content": "Sao lại tới nhà tôi chứ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760904,
					"content": "Nhà của Mona? Đây là nhà của cô sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760905,
					"content": "Ái chà, thật không thể ngờ được... tôi nghe nói là Megistus luôn sống trong cảnh nghèo khó và thiếu ăn, nhưng mà ngôi nhà này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760906,
					"content": "Trên đất còn có mấy quyển sách có dán nhãn này, \"Hàng độc nhất, chỉ bán với giá 990.000 Mora...\" Hả?! Mắc tới vậy sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760907,
					"content": "Trong này cũng có rất nhiều quyển sách trông đắt tiền... đây là phòng của thuật sĩ chiêm tinh sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760908,
					"content": "Trong phòng cũng được bố trí rất tinh tế... không hề tùy tiện chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760909,
					"content": "Mona, hóa ra cô giàu như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "Tôi chỉ tình cờ hết Mora thôi mà, chứ tôi có phải là đứa nghèo kiết xác đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760912,
					"content": "Không phải chứ? Tôi còn mời cô ăn cơm, thậm chí còn dẫn cô về nhà ăn cơm nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760913,
					"content": "Tiểu thư, hãy chọn từ, chọn từ mà nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760914,
					"content": "À khụ khụ! Ngươi được ban thánh ân, đi theo bổn công chúa tới Vương Đô U Ám để gặp mặt hoàng đế và hoàng hậu nữa. Chuyện lớn như vậy ngươi quên rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760915,
					"content": "À đúng, món thịt hầm và đồ nguội của mẹ cô làm rất ngon! Ừm, nhắc lại thấy muốn ăn nữa ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760916,
					"content": "Megistus, hiện giờ không phải là lúc nói chuyện này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760917,
					"content": "Là món ăn của Mondstadt sao? Tôi cũng muốn ăn thử! Nghe nói Mondstadt có rất nhiều món ngon, nhất là mấy món ăn chế biến từ thịt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760918,
					"content": "Hừm, vậy thì ta ban cho ngươi vinh quang, lần tới các ngươi có thể theo bổn công chúa đi gặp phụ hoàng và mẫu hậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760919,
					"content": "#Thật sao? Này {NICKNAME}, chúng ta cũng đi chung đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760920,
					"content": "Tính ra cũng lâu rồi tôi không có tới nhà bạn bè chơi, cho tôi đi theo nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760921,
					"content": "Ừm, có nên chuẩn bị quà gặp mặt không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760922,
					"content": "Hai vị đó thân thiện lắm nên không để ý chuyện này đâu. Mọi người cứ thoải mái nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760923,
					"content": "Nếu có đến thì ăn thử món thịt nguội ở nhà Fischl nhé, đó là món nổi tiếng của nhà cô ấy, ngon lắm luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760924,
					"content": "Hay là chúng ta giải quyết câu đố hiện tại trước nhé? Thật ra thì từ khi vào nhà tới giờ, tôi luôn chú ý tới món đồ trang trí kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760925,
					"content": "À, đúng nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760910,
					"content": "Xưa nay tôi đúng là có mắt như mù mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "Về tới đây rồi. Vậy có nghĩa là chúng ta đã thoát khỏi ảo cảnh hoàn toàn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761302,
					"content": "Lạ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761303,
					"content": "Trong ảo cảnh của tôi cũng không có manh mối gì về Fatui và cái thiết bị kia... Chẳng lẽ, những chuyện này không liên quan gì tới họ ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761304,
					"content": "Hoặc là, những ảo cảnh có liên quan tới chúng ta đây vốn không phải là \"quá trình\", mà là \"kết quả\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761305,
					"content": "Hả, là sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761306,
					"content": "Nghĩa là những ảo cảnh này không phải là manh mối dẫn dắt chúng ta đi giải mã bí ẩn, mà chỉ là kết quả đã có mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761307,
					"content": "Có người đã làm gì đó để tạo ra những ảo cảnh này. Nó chỉ là sản phẩm bị động, cho nên không thể có gợi ý gì cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761308,
					"content": "Có thể nói những ảo cảnh này chỉ có liên quan tới chúng ta mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761309,
					"content": "Là kết tinh thuần túy của bản thân chúng ta... hừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761310,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761311,
					"content": "Mọi người, có lẽ chúng ta nên quay về điểm xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761312,
					"content": "#Vào ngày vừa lên đảo, tôi và {NICKNAME} cùng điều tra doanh trại của Fatui. Chỗ đó có một thiết bị rất kỳ lạ, bên cạnh là một tên Fatui đầu óc được minh mẫn cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761313,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "Cái tên đứng ra thương lượng với chúng tôi cũng bảo đó chỉ là phát minh công nghiệp của Fatui, đồng thời cũng hứa là sẽ không làm phiền đến chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761315,
					"content": "Đúng vậy, tên mập đội mũ kia trông cứ như ngủ chưa tỉnh ấy, toàn nói mấy lời mê sảng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761316,
					"content": "Theo tôi nghĩ, có khi nào \"bị phát điên\" và \"sinh ra ảo cảnh\" là hai kết quả khác nhau mà thiết bị kia tạo ra không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761317,
					"content": "Mọi thứ đúng là có liên quan đến thiết bị bị hỏng đó. Nhưng sự khác biệt ở đây không nằm ở chỗ thiết bị, mà nằm ở nhóm người bị ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761318,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761319,
					"content": "Nói vậy thì đúng là khó phân biệt giữa giác mơ và ảo giác thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761320,
					"content": "Vậy ý của anh là do chúng ta khác với họ ở một điểm nào đó nên kết quả mới khác theo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761321,
					"content": "Đúng. Dựa theo quen sát nhiều ngày nay, tôi cho rằng... chúng ta khác bọn họ ở chỗ là chúng ta có ý chí kiên cường hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761322,
					"content": "...Ừm, có lý đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761323,
					"content": "Người có ý chí kiên định sẽ không phát điên, mà chỉ sinh ra ảo giác. Còn người có ý chí yếu đuối thì không được như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761324,
					"content": "Nói cách khác, chúng ta phải quay lại doanh trại Fatui ngay để phá hủy cái máy kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761325,
					"content": "Không đúng, so với việc \"phá hủy\" thì phải nói là \"sửa chữa\" mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761326,
					"content": "Ý tiểu thư là, nếu tùy tiện phá hủy cái máy đó, có khi sẽ gây ra hậu quả nghiêm trọng hơn, hay là chúng ta nghĩ cách sửa chữa nó trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761327,
					"content": "Ừm, cẩn thận vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761328,
					"content": "Nếu tôi đoán không lầm thì cái máy kia có thể gây ảnh hưởng đến não bộ của con người, chúng ta phải xử lý cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761329,
					"content": "Giờ chúng ta qua đó thôi! Tranh thủ thời gian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl",
					"Oz",
					"Mona",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "Cảnh sắc thật huy hoàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761502,
					"content": "Không hổ danh là nhà chiêm tinh thiên tài. Mona Megistus, cô đúng là pháp sư giỏi nhất từ trước tới nay của Vương Đô U Ám.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761503,
					"content": "Cảm ơn, nhưng Vương Đô U Ám mới tồn tại được có bao lâu đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761504,
					"content": "...Ngôi sao lấp lánh như kim cương, ánh trăng sáng ngời như ngọc bích, đó đúng là bầu trời sao đẹp nhất mà tôi từng thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761505,
					"content": "Đẹp thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761506,
					"content": "Có thể sở hữu ảo cảnh như thế này, có lẽ trong lòng Mona cũng là một đại dương ánh sao nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761508,
					"content": "Mona, sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "...Tôi đang nghĩ, đây chắc là thứ mà chúng ta khao khát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761510,
					"content": "Bầu trời sao này cực kỳ lộng lẫy, thậm chí có thể nói là đẹp hơn cả những gì tôi từng thấy khi chiêm tinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761511,
					"content": "Mỗi một ngôi sao đều nằm ở vị trí chính xác của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761512,
					"content": "...Đây chắc chắn là ảo cảnh của tôi, vì chỉ có ở đây mới có thể thấy được kỳ quan như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761513,
					"content": "Kỳ quan? Sao lại nói như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761514,
					"content": "Mọi người biết không? Bầu trời sao ở Teyvat kỳ diệu lắm, dường như nó chứa đựng tất cả đáp án trên thế gian này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761515,
					"content": "\"Bao giờ đứa con trai mất tích của tôi mới trở về?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761516,
					"content": "\"Người ấy rốt cuộc có yêu tôi không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761517,
					"content": "\"Tôi có thể bình phục không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761518,
					"content": "Dù thế nào đi nữa, mọi chuyện đều sẽ được ghi lại trong quỹ đạo của ánh sao. Tuy nhiên trên thế gian này nhiều người như vậy, sẽ có một số người đi lệch khỏi quỹ đạo vốn có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761519,
					"content": "Nếu ngôi sao của bạn đi trên đúng quỹ đạo, có nghĩa bạn sẽ khỏe mạnh, hạnh phúc và bình an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761520,
					"content": "Còn nếu ngôi sao của bạn đi lệch khỏi quỹ đạo, có nghĩa là mọi thứ đang dần bất ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761521,
					"content": "Vậy nên, bầu trời sao trong kết quả bói toán lại tuyệt đối không như vậy. Các ngôi sao trên đó hoặc sẽ lạc lối, hoặc sẽ rơi xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761522,
					"content": "...Tôi mong mọi người đều hạnh phúc, hy vọng rằng ai cũng đi đúng quỹ đạo của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761523,
					"content": "Vì vậy, tôi muốn nói ra sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761524,
					"content": "Đương nhiên tôi biết chuyện đó sẽ chẳng có tác dụng gì, vận mệnh của con người đều hiển hiện trên bầu trời đêm. Tôi cũng chỉ là một trong số đó thôi, không thể thay đổi được gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761525,
					"content": "Nhưng ngay cả như vậy... Trong chiêm tinh thuật, ngoài những điều rõ ràng như tôi đã nói thì tôi vẫn muốn mong đợi vào một điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761526,
					"content": "Con người phải sống trong thế giới thực, nhưng mà... cứ coi như tôi không biết tự lượng sức mình đi. Tôi vẫn chờ đợi và tin tưởng vào \"kỳ tích\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761527,
					"content": "Trong vùng biển sao rộng lớn này, có ngôi sao của bạn, của tôi, của họ, thậm chí là của tất cả mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761528,
					"content": "Những ngôi sao với nhau phải trùng hợp đến thế nào mới được gặp nhau? Mà gặp nhau liệu có phải là \"kỳ tích\" đẹp nhất của vận mệnh không? ...Tôi không rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761529,
					"content": "Nhưng trên bầu trời sao Teyvat vẫn sẽ luôn có vị trí của chúng ta. Dù cho thuật chiêm tinh có lý trí đến đâu thì vận mệnh cũng sẽ vô thường, tàn nhẫn và lãng mạn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761530,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761531,
					"content": "Mona, hình như lúc trước cô luôn suy tư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "Bây giờ cô đã tìm được đáp án chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "...Tôi nghĩ, chắc là tôi biết trong đó ẩn giấu gì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761534,
					"content": "\"Bây giờ đây, tôi sẽ nắm lấy vận mệnh của chính mình.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
