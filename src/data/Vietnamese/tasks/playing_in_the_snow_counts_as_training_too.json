			"dialogs": [
				{
					"id": 706910101,
					"content": "#{M#Anh}{F#Chị} Kỵ Sĩ Danh Dự ơi! Bên này bên này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910102,
					"content": "#Klee có bạn mới rồi! {M#Anh}{F#Chị} có muốn chơi cùng tụi em không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910103,
					"content": "Các anh chị đã dạy cho chúng em một trò chơi mới, gọi là \"Lạc Lối Trong Tuyết\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910104,
					"content": "Luật chơi cũng không khó đâu, chỉ là một trò chơi trốn tìm rất đặc biệt thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910105,
					"content": "Woa, Klee, Yaoyao và Sayu, mọi người đã kết bạn với nhau rồi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910106,
					"content": "Nghe tên trò chơi này, có phải là phiên bản cải tiến của Cơn Gió Lạc Lối không nhỉ? Chơi cùng mọi người chắc chắn sẽ rất thú vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910107,
					"content": "Được được, trốn tìm nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "Hắt xì... Tuy ở trong trại không lạnh lắm, nhưng vẫn thấy buồn ngủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910110,
					"content": "#Hả? Mình bị hoa mắt à, sao lại thấy {NICKNAME} và Paimon ở đây thế này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910111,
					"content": "#Chị không hoa mắt đâu, đúng là {NICKNAME} và Paimon đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910112,
					"content": "Xin chào Yaoyao và Sayu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "Vận động thôi nào! Chơi thật vui thì sẽ không buồn ngủ nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910115,
					"content": "Tiểu thư Sumire nghiêm túc kia cũng nói rồi đó! Nếu chị Sayu đi dạo nhiều trên núi tuyết thì cũng tốt cho kỹ năng của mình mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910116,
					"content": "Ơ, mọi người đều nhớ à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910117,
					"content": "Thôi được... Nếu để thua mấy đồng nghiệp đó hay thậm chí là siêu Ninken... thì sau này lười biếng chắc chắn sẽ bị bắt bẻ nghiêm khắc hơn mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910118,
					"content": "Xem ra lần đi xa tu luyện này thực sự phải nghiêm túc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910119,
					"content": "Không sao! Em đã chuẩn bị món thịt hầm rau củ theo công thức mới, có thêm bột Ớt Tuyệt Vân và bột tiêu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910120,
					"content": "Ăn vài miếng trước khi chơi nhé! Như vậy sẽ không bị lạnh trong thời gian trốn tìm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910121,
					"content": "Tuyệt vời! Lát nữa sẽ ăn hết cả bát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910122,
					"content": "Tôi cũng muốn, tôi cũng muốn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910123,
					"content": "Vậy thì, trốn tìm trên núi tuyết... chuẩn bị bắt đầu thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910124,
					"content": "#Haha! Núi tuyết trắng xóa thế này, nếu tôi trốn thì chắc chắn {NICKNAME} không dễ tìm ra đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910113,
					"content": "Muốn chơi trốn tìm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "#Để {F#chị}{M#anh} làm quen với bạn mới của Klee nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}