			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "Đáng ghét thật... Masseira biến mất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820602,
					"content": "Masseira đã để lại tờ giấy này... Hừm, đúng là xảo quyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732820603,
					"content": "Khi thấy mảnh giấy này, điều đó có nghĩa là tôi đã đến nơi lánh nạn trong hẻm núi.\\nNếu đầu vẫn còn ở trên vai thì đừng đau xót cho sự lựa chọn của Tadhla.\\n\\nChuyến đi săn này vẫn chưa kết thúc, mà chỉ là sự bắt đầu của giông bão.\\nLời nhắc nhở của trưởng lão Tanit, thợ săn Masseira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 732820604,
					"content": "Masseira nói gì vậy... Xem không hiểu gì hết cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820605,
					"content": "Xem ra tên này rời bộ lạc là do chịu áp lực nào đó... hơn nữa còn để lại lời cảnh báo. Hừm, Tanit... chắc chắn không đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(Tadhla đưa mắt nhìn chỗ khác và cúi đầu xuống đầy căng thẳng.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822802,
					"content": "Cô vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "Xin lỗi, chuyến đi săn đã kết thúc rồi. Tôi là \"chim ưng\" của bố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822804,
					"content": "Nhưng mà... tôi vẫn ổn, bạn không cần phải lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822808,
					"content": "Cực đoan như vậy sao...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "Cực đoan sao...? Tôi không biết nữa, ngay từ bé tôi đã sống như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822814,
					"content": "A... Nhưng mà... câu chuyện và chuyến hành trình của bạn với Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822815,
					"content": "Nếu có cơ hội tôi vẫn muốn được nghe bạn kể về nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822816,
					"content": "Ừm, chúng tôi có một đống câu chuyện có thể kể đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732822817,
					"content": "Ừm, đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "Hì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822820,
					"content": "E hèm, không có gì, tôi chỉ quá vui mừng thôi... Cảm ơn bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822818,
					"content": "Nếu thích, tôi luôn sẵn lòng kể cho cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "Cô chưa từng nghĩ là sẽ sống vì bản thân sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822812,
					"content": "...Không chưa từng nghĩ đến cũng chưa từng kỳ vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822813,
					"content": "Sa mạc rất tàn khốc, không có thời gian để suy nghĩ cho bản thân. Không có tôi, vẫn còn rất nhiều người có thể sống, nhưng nếu không có bộ lạc... Tôi không thể sống tiếp một mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822805,
					"content": "Về mối quan hệ giữa cô và Masseira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "Giống như tôi từng nói, ông ấy là bố tôi. Tôi là \"chim ưng\". Tôi nghe theo mệnh lệnh, săn bắt và hy sinh vì ông ấy... Bởi vì ông ấy là đại diện cho ý chí của Tanit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "Tadhla"
