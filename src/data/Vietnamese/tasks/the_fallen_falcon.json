			"dialogs": [
				{
					"id": 732820201,
					"content": "Di tích phía bắc, ở gần nơi mọi người lần đầu gặp mặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820202
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820202,
					"content": "#Đây là lựa chọn của con bé... Hy vọng {F#cô}{M#cậu} có thể tôn trọng điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				}
			]
		},
		{
			"id": 7328204,
			"completionStepIds": [
				7328204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328204",
							"2"
						],
						"stepId": 7328204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "Bạn quả nhiên đến rồi, tôi rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820402,
					"content": "Nghe nói cô tìm tôi đúng không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "Tôi luôn cảm thấy sa mạc lúc này rất đẹp, đây cũng là cảnh mà tôi rất thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820405,
					"content": "Nhưng đáng tiếc là... vẫn chưa có cơ hội ngắm hoàng hôn cùng với bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820406,
					"content": "Đúng đó, cả vùng sa mạc bị nhuộm thành màu đỏ... thật là đẹp và yên tĩnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820407,
					"content": "Nhưng mà Tadhla gọi chúng tôi đến là vì điều này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820409,
					"content": "Đối với Tanit, bạn là khách. Đối với \"chim ưng\" bạn là \"con mồi\" tiềm năng... Nhưng tôi hy vọng người có thể sống sót chính là bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820410,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "Vậy nên, tôi rất xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820403,
					"content": "Dạo này thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
			"completionStepIds": [
				7328206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
