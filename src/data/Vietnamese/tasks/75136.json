			"dialogs": [
				{
					"id": 751360201,
					"content": "Đây là thứ gì vậy? Mặc dù nhìn hình dáng cũng giống Hỏa Lân Thạch, nhưng lại phát sáng và không ngừng bùng cháy. Cảm thấy mạnh hơn nhiều so với Hỏa Lân Thạch của Bona đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360202,
					"content": "Chẳng lẽ đây mới chính là hình dạng thật sự của Hỏa Lân Thạch sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360203,
					"content": "Nóng quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#{NICKNAME}, đừng có thấy cái gì cũng giơ tay ra lấy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360205,
					"content": "Thói quen rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "Paimon cũng thế mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#Hả? {REALNAME[ID(2)|SHOWHOST(true)]} có manh mối gì về cái này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360209,
					"content": "#Woa, {REALNAME[ID(2)|SHOWHOST(true)]} thật xuất sắc! Xem ra đây là nơi để nhóc thể hiện tài năng rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360210,
					"content": "#Lát nữa nếu phát hiện ra bảo vật nóng bỏng nào nữa thì có thể nhờ {REALNAME[ID(2)|SHOWHOST(true)]} rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360211,
					"content": "Yee! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "Này! Ở đây này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360213,
					"content": "Woa, kia không phải là Bona sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360214,
					"content": "Nhưng sao Bona lại ở đó vậy? Chẳng lẽ là đáp thẳng xuống sao... Thôi vậy, chúng ta qua đó gặp cô ấy trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
