				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "Phù... Cuối cùng cũng sống sót rồi! Cảm giác đứng trên mặt đất thật tuyệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360102,
					"content": "Paimon rõ ràng là đang lơ lửng mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "Này, cho dù là vậy thì việc lơ lửng trên mặt đất và bị gió lớn thổi bay vẫn là hai chuyện khác nhau đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360104,
					"content": "Nhìn chỗ này cũng không chắc chắn lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#Ấy, đừng làm tôi sợ mà. Nếu rơi xuống thật thì tôi không kéo nổi {NICKNAME} và {REALNAME[ID(2)|SHOWHOST(true)]} đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360106,
					"content": "Cheep, ku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751360107,
					"content": "Đó có phải là Tonatiuh không? Chúng ta thành công rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360108,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "Nó giống quả bóng len hơn là thuyền đấy! Trông rối ren giống như con rắn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360110,
					"content": "Chúng ta nghĩ cách qua đó đi. Ít ra thì trông bên đó có vẻ an toàn hơn bên này... Hmm, không biết Bona đã đi đâu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360111,
					"content": "Dù cô ấy nói kinh nghiệm bay rất phong phú, nhưng tôi vẫn hơi lo lắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360112,
					"content": "Chỉ cần hướng gió không sai là được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "Ừm, cũng có lý. Nếu hướng gió không sai thì cô ấy chắc chắn cũng sẽ đáp xuống gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360114,
					"content": "Ở lại đây cũng không có câu trả lời đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "Ừm, cũng có lý. Ở đây lo lắng cũng chẳng có tác dụng gì, có khi cô ấy đã ở trên Tonatiuh đợi chúng ta rồi cũng nên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360116,
					"content": "Vậy thì chúng ta qua đó trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
