			"dialogs": [
				{
					"id": 751360401,
					"content": "Ôi, vất vả lắm mới tìm được Tonatiuh mà giờ vẫn phải đi tìm đá khắp nơi. Tôi cứ tưởng đây sẽ là một cuộc phiêu lưu hồi hộp hơn chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360402,
					"content": "Nói chung, việc tìm đá lửa nhờ các vị nhé, có gì cần thì cứ gọi tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
