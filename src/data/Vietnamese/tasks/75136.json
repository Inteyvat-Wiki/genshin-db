			"dialogs": [
				{
					"id": 751360501,
					"content": "Chúng ta đã thành công rồi! Nhưng sao còn thấy Chữ Khắc Lấp Lánh quen thuộc nhỉ? Mảnh Ngọc Quay Về trong truyền thuyết chính là thứ này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360502,
					"content": "Khoan đã, nhìn kỹ thì đây chẳng phải là Đĩa Vàng Thông Điệp sao? Giống hệt như cái mà chúng ta đã lấy được trước đó.",
