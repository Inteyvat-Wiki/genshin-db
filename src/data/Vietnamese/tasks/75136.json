					}
				]
			},
			"dialogs": [
				{
					"id": 751360301,
					"content": "#Cuối cùng cũng tìm thấy {NICKNAME}, Paimon và {REALNAME[ID(2)|SHOWHOST(true)]} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360302
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360302,
					"content": "Hihi, Bona, thật tốt khi thấy cô không sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360303,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360304
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360304,
					"content": "Paimon đang lo lắng cho tôi sao? Nhưng yên tâm đi, tôi là nhà mạo hiểm hàng đầu của Hội Hoa Vũ mà. Mạng tôi lớn lắm, làm sao dễ dàng bỏ mạng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360305
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360305,
					"content": "Cô không sao là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360306
					]
				},
				{
					"id": 751360306,
					"content": "#Hihi, chắc cũng nhờ {F#cô}{M#cậu} đó. Từ khi gặp {F#cô}{M#cậu} thì vận may của tôi tốt lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360307,
					"content": "Vừa rồi khi lạc nhau trong biển mây, tôi đã bị gió thổi rơi xuống một tảng đá nổi rồi ngất xỉu. Không biết bao lâu sau, khi tôi tỉnh dậy thì đã đến đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360308
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360308,
					"content": "Cô làm sao đến đây được?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360309
					]
				},
				{
					"id": 751360309,
					"content": "À, sau khi lạc nhau trong biển mây, tôi đã bị gió thổi rơi xuống một tảng đá nổi rồi ngất xỉu. Không biết bao lâu sau, khi tôi tỉnh dậy thì đã đến đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360310
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360310,
					"content": "Sau khi tỉnh dậy tôi đã chạy khắp nơi, nhưng vẫn không tìm thấy mọi người. Tôi còn tưởng là... Nhưng quả nhiên mạng của các vị cũng lớn thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360311
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360311,
					"content": "Woa, vừa rồi tôi còn muốn hỏi cô làm sao lên được đây đó. Rõ ràng đều là những hòn đảo nổi không nối liền với nhau mà, chẳng lẽ là bay lên sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360312,
					"content": "Hihi, cái này để sau hẵng nói. Tóm lại thì đây chính là Tonatiuh mà chúng ta tìm kiếm đó, có thể nói là thành công lớn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360313
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360313,
					"content": "Hmm, nhưng nhìn chỗ này có vẻ cũng không có kho báu khắp nơi giống như trong truyền thuyết. Chẳng lẽ có người đã đến và vơ vét hết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360314,
					"content": "Tôi nghĩ những kho báu được giấu trên Tonatiuh trong truyền thuyết có khả năng lớn là do người kể chuyện bịa ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360315
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360315,
					"content": "Hả? Không thể nào! Nếu vậy chẳng phải chúng ta đến đây vô ích sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360316,
					"content": "Nhưng dù chuyện kho báu là giả, thì Mảnh Ngọc Quay Về mà chúng ta tìm kiếm cũng không thể nói là không tồn tại. Chúng ta không thể từ bỏ hy vọng được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360317
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360317,
					"content": "Hơn nữa, mọi người nhìn trên kia kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360318
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360318,
					"content": "Bên trong có vẻ như có thứ gì đó đúng không? Mọi người lúc trước cũng vừa tìm được Hỏa Lân Thạch trong Lõi Chu'ulel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360319,
					"content": "Với kinh nghiệm của một nhà mạo hiểm thì tôi thấy có thể bên trong chính là Mảnh Ngọc Quay Về mà chúng ta đang tìm kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360320,
					"content": "Nếu vậy thì chúng ta nghĩ cách lên đó để đập vỡ nó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360321,
					"content": "Để tôi lo cho!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360322
					]
				},
				{
					"id": 751360322,
					"content": "Này, không dễ như thế đâu! Tôi vừa thử qua rồi, không phải chỉ dùng sức là có thể đập vỡ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360323
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360323,
					"content": "Tôi cảm thấy không đơn giản như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360324
					]
				},
				{
					"id": 751360324,
					"content": "Đúng vậy, có vẻ như không thể dùng sức mạnh để phá vỡ thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360325
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360325,
					"content": "Theo kinh nghiệm của tôi với tư cách là nhà mạo hiểm thì ở gần đây chắc phải có cơ quan gì đó, giống như khi chúng ta lấy Hỏa Lân Thạch trước đó vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360326
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360326,
					"content": "Mà nói đến cơ quan thì chính là cái trước mặt chúng ta đây. Giống hệt như Tế Đàn Lửa Nguồn mà chúng ta đã thấy trước đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360327
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360327,
					"content": "Thật là trùng hợp... Không, đây không phải trùng hợp, nhất định là manh mối gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360328
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360328,
					"content": "Hay là chúng ta thử dùng Hỏa Lân Thạch... À ừm, chúng ta cũng không còn Hỏa Lân Thạch để dùng nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360329,
					"content": "#Không phải {REALNAME[ID(2)|SHOWHOST(true)]} đang mang theo một mảnh sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360330
					]
				},
				{
					"id": 751360330,
					"content": "Ừ nhỉ, lúc nãy chúng ta vừa nhặt được thứ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360331,
					"content": "Đúng thế! Mọi người có biết nguyên tắc \"chìa khóa của nhà mạo hiểm\" không? Chính là vật phẩm quan trọng trong lúc then chốt lại nằm ở phần đầu của cuộc phiêu lưu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360332
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360332,
					"content": "Nghe rối thật! Với lại cũng có cách điểm khởi đầu bao xa đâu! Dù cái này đúng là giống Hỏa Lân Thạch thì cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360333,
					"content": "Nói đúng hơn, ngoài việc liên tục tỏa ra lửa thì chúng thật sự giống hệt nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360334,
					"content": "Đúng vậy, nếu Paimon không nói thì tôi hoàn toàn không phát hiện ra đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360335
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360335,
					"content": "Đó là vấn đề của cô đó! Theo lời cô nói thì chúng ta chỉ cần thu thập loại đá đó là được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360336,
					"content": "Ừm, nếu là loại đá lửa này thì trên Tonatiuh có tổng cộng bốn viên. Ví dụ như trên hòn đảo nổi đối diện chắc chắn có một viên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360337
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360337,
					"content": "Mà khoan đã... Bona, sao cô biết rõ vậy? Giống như cô đã từng đến đây trước đó ấy. Cho dù là với kinh nghiệm của nhà mạo hiểm thì cũng không thể giải thích được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360338,
					"content": "Phải nói thế nào nhỉ... Có thể coi là linh cảm của một nhà mạo hiểm không? Không biết tại sao khi vừa thấy cái tế đàn này là tôi đã biết phải sử dụng như thế nào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360339
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360339,
					"content": "Hơn nữa, trước khi gặp các vị thì tôi cũng đã điều tra xung quanh rồi. Thân là nhà mạo hiểm xuất sắc thì việc điều tra trước là rất cần thiết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360340
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360340,
					"content": "Hóa ra là vậy, kiến thức này đã được tiếp thu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360341
					]
				},
				{
					"id": 751360341,
					"content": "#{NICKNAME}, không lẽ lúc nào {F#cô}{M#cậu} cũng chỉ dùng sức để giải quyết sao...? Biết chiến đấu tốt thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360342
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360342,
					"content": "May mà tôi thường dùng sức mạnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360343
					]
				},
				{
					"id": 751360343,
					"content": "#{NICKNAME}, {F#cô}{M#cậu} thì khác biệt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360344
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360344,
					"content": "#Giờ chúng ta làm thế nào để qua đó đây? Cho dù là {NICKNAME} thì cũng có vẻ hơi khó khăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360345,
					"content": "Haha, vừa nãy chẳng phải Paimon hỏi tôi làm sao để lên được đây sao? Bây giờ chính là lúc để cho cô thấy phát hiện của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360346
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360346,
					"content": "Thế nào? Chỉ cần sử dụng cơ quan này là có thể tự do di chuyển giữa các hòn đảo nổi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360347
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360347,
					"content": "Việc tìm đá lửa nhờ các vị nhé. Nếu đi đến đảo khác mà không về được thì chỉ cần báo cho tôi một tiếng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360348
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360348,
					"content": "#Được rồi. Nếu vậy thì công việc giữ đá lửa giao cho {REALNAME[ID(2)|SHOWHOST(true)]} vậy. Chúng ta cùng xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360349,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
