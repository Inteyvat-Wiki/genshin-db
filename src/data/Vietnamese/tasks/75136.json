					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360503,
					"content": "Rooo... Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "Đúng là như vậy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "Báu vật có thể trấn áp ô uế của Vực Sâu và tín vật có thể xóa bỏ lời nguyền tai ương. Nghe đúng là có chút tương đồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360506,
					"content": "Giờ Paimon mới phát hiện sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "#Hả!? Nếu đã phát hiện ra từ sớm thì sao không nói với tôi chứ? Khoan đã, {NICKNAME} phát hiện bằng cách nào vậy, chẳng lẽ cũng là kinh nghiệm của một nhà mạo hiểm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360508,
					"content": "Báu vật có thể trấn áp ô uế của Vực Sâu và tín vật có thể xóa bỏ lời nguyền tai ương. Nghe đúng là có chút tương đồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360509,
					"content": "Nhưng cái này thật sự có thể trấn áp được Vực Sâu của Ochkanatlan sao? Trước đây chưa từng nghe thấy ai của Hiệp Hội Nghiên Cứu Di Vật Saurian nói đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360510,
					"content": "Hmm, nếu Mảnh Ngọc Quay Về thực chất chính là Đĩa Vàng Thông Điệp, vậy chẳng lẽ vì thế mà con rồng xấu xa đó đã nhắm vào chúng ta ngay từ đầu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360511,
					"content": "Ồ, hóa ra không phải vì nó nhắm vào món Thịt Hầm Hỏa Diệm mà tôi ăn lúc sáng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360512,
					"content": "Có vẻ như các manh mối đã nối lại với nhau rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360513
					]
				},
				{
					"id": 751360513,
					"content": "Hóa ra chuyện này đã được dự báo trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360514
					]
				},
				{
					"id": 751360514,
					"content": "Hmm, nhưng Bona có lẽ vẫn chưa biết về chuyện Đĩa Vàng Thông Điệp nhỉ... Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360515,
					"content": "Không đúng. Có gì đó không ổn... Tôi chắc chắn đã từng đến đây, Tonatiuh này, và Mảnh Ngọc Quay Về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360516
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360516,
					"content": "Đúng rồi! Nhất định phải phá hủy... Không thể để \"kẻ đó\" có được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360517
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360517,
					"content": "Này, Bona, cô sao vậy?",
