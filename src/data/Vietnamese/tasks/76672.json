			},
			"dialogs": [
				{
					"id": 766720202,
					"content": "Krumkake Lakka, Bít Tết Cá Xông Khói, Thịt Chiên Quả Mọng và Súp Ấm Gác Đêm... Nhiều món quá, tôi sắp ăn hết nổi rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720203,
					"content": "Hmm... Tôi nấu theo khẩu phần cơm tối cho các Ratnik, với ba người thì có lẽ hơi nhiều thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720204
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720204,
					"content": "Nhưng không sao đâu, cứ ăn từ từ. Lát nữa tôi còn phải đi gặp cha, các vị cứ ở lại đến tối cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720205,
						766720206
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720205,
					"content": "Không ngờ cậu giỏi nấu ăn đến vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720208
					]
				},
				{
					"id": 766720208,
					"content": "Thật ra trước khi làm đội trưởng, tôi thường nấu ăn cho mọi người đấy, chỉ là dạo gần đây không có thời gian rảnh như vậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720209
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720209,
					"content": "Người ở Piramida đến từ khắp nơi, khẩu vị cũng khác nhau, nên món ăn của các nơi khác nhau đều phải biết nấu chút ít để mọi người đều được ăn ngon miệng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720210
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720210,
					"content": "Nhưng tôi không rõ sở thích của hai người cho lắm, nên lần này mỗi loại tôi đều nấu một ít. Có món nào hợp khẩu vị không? Phải nói cho tôi biết nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720211,
						766720214
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720211,
					"content": "Món nào Paimon thích thì tôi cũng thích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720212
					]
				},
				{
					"id": 766720212,
					"content": "Ý gì vậy chứ! Tôi nói trước nhé, tôi đã nhắm đến đĩa Thịt Chiên Quả Mọng đó rồi, đừng có tranh với tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720213,
					"content": "Haha, không cần tranh nhau đâu, tôi làm thêm một ít nữa là được mà. Sao có thể để thành viên trong đội phải đói bụng được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720216,
					"content": "Dù ngoài miệng nói gì đi nữa thì khi được ăn món mình thích, biểu cảm hạnh phúc trên gương mặt cũng không thể nói dối được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720217
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720217,
					"content": "Đối với tôi, không có gì vui hơn việc được nhìn thấy nụ cười hạnh phúc của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720218
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720218,
					"content": "Chỉ cần khiến mọi người nở nụ cười, thì dù là thực hiện trách nhiệm của Người Giữ Đèn hay mang đến những món ăn ngon, tôi cũng đều sẵn lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720219
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720219,
					"content": "Có lẽ với mọi người đó chỉ là chuyện nhỏ nhặt không đáng kể, nhưng đó thực sự là mong ước chân thật nhất của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720220,
						766720221
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720220,
					"content": "Đừng xem nhẹ bản thân như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720222,
					"content": "Đúng rồi! Cậu đã làm nhiều việc như vậy vì mọi người, chắc chắn họ đều rất biết ơn cậu. Nếu thấy cậu cứ tự trách mình như vậy, không chừng sẽ tức giận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720223,
					"content": "#Ít nhất thì tôi và {NICKNAME} sẽ giận trước đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720224,
					"content": "Hihi, cảm ơn nhé. Thôi, không bàn chuyện linh tinh nữa, mời thưởng thức món ăn nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720221,
					"content": "Cậu làm được những việc này đã là giỏi lắm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720214,
					"content": "Chỉ cần là món cậu nấu thì tôi đều thích ăn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720215
					]
				},
				{
					"id": 766720215,
					"content": "#Không cần nói mấy lời khách sáo vậy đâu. Nói vậy càng khiến tôi muốn nấu những món hợp ý {F#cô}{M#cậu} hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720206,
					"content": "Paimon chắc chắn sẽ ăn hết mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720207
					]
				},
				{
					"id": 766720207,
					"content": "Đương nhiên rồi, phải trân trọng tấm lòng của người khác chứ! Nhưng tôi không ngờ là tay nghề nấu nướng của Illuga lại giỏi đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720208
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}