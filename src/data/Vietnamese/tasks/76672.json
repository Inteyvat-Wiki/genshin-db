			"dialogs": [
				{
					"id": 766720101,
					"content": "Vậy là hoàn thành rồi nhỉ, cả doanh trại trông mới toanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720102,
					"content": "Ừm, việc sửa chữa công trình xung quanh doanh trại cũng đã hoàn thành, dù là ma vật hay kẻ địch có ý đồ xấu muốn tấn công nơi này đều sẽ phải tốn không ít công sức đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720103
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720103,
					"content": "Ngọn hải đăng đã dự trữ đủ nhiên liệu cho nửa tháng, vậy nên dù cho Cuộc Săn Hoang Dã kéo đến thì chúng tôi cũng có thể chống đỡ cho đến khi viện binh tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720104,
					"content": "Đã tính đến cả chuyện đó rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720105
					]
				},
				{
					"id": 766720105,
					"content": "Haha, thì... phải luôn cân nhắc đến tình huống xấu nhất mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720106,
					"content": "Nhưng cuối cùng cũng đã xây xong doanh trại, ít nhất có thể nghỉ ngơi một chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720107,
					"content": "Ừm, nên tôi muốn về nhà một chuyến, cũng đã lâu không gặp cha rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720108,
					"content": "Về nhà à? Đúng nhỉ, ở đây lâu quá nên tôi suýt quên mất nhà của cậu là ở Piramida đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720109,
					"content": "Về cùng với tôi nhé, để cảm ơn, tôi muốn đãi hai người một bữa thật ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720110
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720110,
					"content": "Tuy ở đây cũng đã chuẩn bị xe thức ăn mà Paimon nói, nhưng nấu nướng ở nhà thì vẫn sẽ tiện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720111
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720111,
					"content": "Định nấu món ngon à? Hihi, vậy tôi không khách sáo đâu đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
