			"dialogs": [
				{
					"id": 401300801,
					"content": "Này! Freminet! Thelxie! Chúng tôi tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300802,
					"content": "#Xin chào, Paimon, và cả {NICKNAME} nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300803
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300803,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300804
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300804,
					"content": "Hôm nay làm xong vương miện rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300805,
					"content": "Ừm, giờ chỉ đợi cô Zuria nữa thôi, cô ấy vẫn chưa tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300806
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300806,
					"content": "Vậy chúng ta đợi thêm lát nữa, hoặc là trực tiếp đi tìm cô ấy xem? Dù sao cũng không xa lắm, nhà cô ấy ở ngay trên sườn núi kia phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300807,
					"content": "#Này! {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300808
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300808,
					"content": "Hihi, vừa nhắc là đến ngay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300809,
					"content": "Cuối cùng cũng tìm thấy rồi... Hai vị không sao là tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300810
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300810,
					"content": "Hả? Delaroche, sao lại là cô?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300811,
					"content": "Còn chuyện gì nữa? Đương nhiên là chuyện về Thelxie rồi! Tên thủy yêu đáng sợ đó! Sau khi giao cho hai vị nhiệm vụ đó, tôi không yên tâm nên đã đi hỏi thăm về đứa trẻ rơi xuống nước kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300812
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300812,
					"content": "Chuyện đó chúng tôi đã điều tra rõ rồi, thực ra đó chính là Freminet, đám cá cũng là do bị cậu ấy dọa chạy mất! Cô yên tâm, đợi chúng tôi hoàn thành công việc là có thể giúp cô tìm đàn cá trở lại ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300813,
					"content": "Xin lỗi, tôi là thợ lặn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300814
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300814,
					"content": "Hả? Freminet? Thợ lặn? Không không... chuyện này không đúng, tin tức của tôi không phải vậy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300815
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300815,
					"content": "Chuyện tôi nghe được là khoảng một tháng trước, có một đứa trẻ trên người buộc đầy vỏ sò nặng nề, lao xuống vùng nước phía sau lưng đây... rồi không trở lại nữa... Chắc chắn là bị thủy yêu mê hoặc rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300816
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300816,
					"content": "Gì cơ? Cô.. cô không nhầm đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300817,
					"content": "Vô cùng chắc chắn. Tôi đã xác nhận với một số thợ câu lâu năm mà. Đứa trẻ đó năm nay tám tuổi, tên là Lescot Destree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300818
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300818,
					"content": "Đợi đã... Lescot Destree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300819
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300819,
					"content": "Đúng, chính là cái tên này. Nghe nói tổ tiên của cậu bé đến từ một nơi có tên là Destree, mẹ cậu bé là một thương nhân hội họa có chút tiếng tăm, còn cha thì đã qua đời từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300820
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300820,
					"content": "Haiz... Xảy ra chuyện này, người mẹ đã bị kích động mạnh và phát bệnh. Nghe nói hiện giờ đã rời khỏi Đại Sảnh Fontaine, không biết đi đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300821
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300821,
					"content": "Không phải chứ? Lescot Destree... Zuria Destree... Không trùng hợp đến vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300822,
					"content": "Xem ra phải đến nhà cô Zuria một chuyến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300823
					]
				},
				{
					"id": 401300823,
					"content": "Vị tiểu thư này, xin lỗi! Chúng tôi có việc phải đi trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300824
					],
					"speakerTitle": "Freminet"
				},
				{
