					"speakerTitle": "Paimon"
				},
				{
					"id": 401300502,
					"content": "-.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300503
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300503,
					"content": "Mọi người, đừng buồn rầu như vậy... Cô Zuria đã nói, nếu chúng ta lo lắng thì người bệnh sẽ bị ảnh hưởng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300504
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300504,
					"content": "Nói đúng lắm, tôi phải cười lên! Nếu có thể lan truyền thứ gì đó cho cô ấy, thì đó chính là nụ cười! Chúng ta phải mang theo nụ cười để hoàn thành chuyến thám hiểm này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300505,
					"content": "Sau đó cô Zuria sẽ khỏe lên, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300506,
					"content": "Nhất định là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300507
					]
				},
				{
					"id": 401300507,
					"content": "Ừm, chắc chắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
		},
