			"dialogs": [
				{
					"id": 401300201,
					"content": "Xin hỏi? Có ai không? Đây là nhà cô Zuria phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300202,
					"content": "Ai vậy? Bệnh nhân trong phòng đang nghỉ ngơi, không có việc quan trọng thì mời về cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300203
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300203,
					"content": "Bệnh nhân là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300204
					]
				},
				{
					"id": 401300204,
					"content": "Sau một khoảng lặng, cánh cửa từ từ mở ra, một người đàn ông bước ra, ánh mắt đầy vẻ nghi hoặc.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300205
					]
				},
				{
					"id": 401300205,
					"content": "Đây là nhà của Zuria Destree, tôi là Jalacan, bác sĩ riêng của cô ấy. Lời mấy người vừa nói có ý gì? Còn ai là bệnh nhân ở đây nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300206
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300206,
					"content": "Chẳng phải là con trai của cô Zuria sao? Cô ấy đã nói với chúng tôi rằng con trai cô ấy mắc bệnh tự kỷ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300207,
					"content": "Chính xác, thiếu gia Lescot đã mắc chứng tự kỷ, nhưng cậu ấy... thôi bỏ đi. Tóm lại, thiếu gia không còn nữa, giờ căn bệnh đó đã lây sang phu nhân rồi. Mấy người... là bạn của cô ấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300208
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300208,
					"content": "Giữa khoảng lặng yên tĩnh, kể lại chuyện xảy ra trong những ngày qua...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300209
					]
				},
				{
					"id": 401300209,
					"content": "Mấy ngày nay, phu nhân yêu cầu có thời gian tản bộ thư giãn, hóa ra là ở cạnh các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300210
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300210,
					"content": "Vậy là... Người chìm vào tưởng tượng mất kiểm soát thực chất chính là cô Zuria sao? Cô ấy nghĩ rằng con trai mình vẫn còn sống à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300211
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300211,
					"content": "Đúng vậy. Vào ngày thiếu gia gặp chuyện, phu nhân đang bận chuẩn bị một buổi triển lãm dành riêng cho thiếu gia. Nhưng cuối cùng lại không thể gặp được con trai mình lần cuối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300212
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300212,
					"content": "Có lẽ chuyện này đã trở thành nút thắt trong lòng cô ấy, hoặc có lẽ hạt giống của căn bệnh sớm đã nảy mầm trong gia đình này từ khi ông chủ đột ngột qua đời rồi. Trước tiên là thiếu gia, rồi giờ là đến phu nhân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300213
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300213,
					"content": "Sao lại thế chứ... Nhưng rõ ràng trông cô Zuria rất ổn, cô ấy cười rất tươi, còn dặn chúng tôi phải lạc quan lên nữa. Cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300214,
					"content": "Đây chính là biểu hiện bệnh nhân lẫn lộn giữa thực và ảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300215
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300215,
					"content": "Vậy những gì cô ấy nói với chúng tôi, chuyện về con trai... lẽ nào đều là giả sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300216,
					"content": "Không, những chuyện đó là thật, nhưng đều là chuyện xảy ra trước khi thiếu gia qua đời, và thời gian của phu nhân đã dừng lại ở thời điểm đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300217
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300217,
					"content": "Sau đó, cô ấy đã tưởng tượng ra một thế giới mà trong đó con trai mình vẫn còn sống. Cô ấy đang nỗ lực muốn chữa khỏi cho cậu bé, và rồi tìm được chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300218
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300218,
					"content": "Vậy hiện giờ tình trạng của cô Zuria thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300219
					]
				},
				{
					"id": 401300219,
					"content": "Mấy ngày nay tâm trạng cô ấy khá tốt, mỗi lần đi dạo trở về lại thấy hát ngân nga, còn chủ động thảo luận với tôi về liệu pháp dẫn dắt tưởng tượng để giảm triệu chứng bệnh tự kỷ, cho đến tối qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300220
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300220,
					"content": "Phu nhân nhìn ngắm di vật của con trai suốt đêm, là một chiếc vỏ sò có khắc lời trăng trối... Sau đó thì lại suy sụp... Tôi đã kê một ít thuốc an thần, nên hiện giờ cô ấy vẫn đang nghỉ ngơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300221
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300221,
					"content": "Vậy... phải làm thế nào? Làm sao mới có thể giúp cô ấy đây? Chúng ta mau giúp cô Zuria đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300222,
					"content": "Đừng sốt ruột, Paimon... Tuy thông tin này thực sự đau lòng, nhưng chúng ta vẫn phải giữ bình tĩnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300223
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300223,
					"content": "(Sao bây giờ? Phải mau nghĩ cách... Nhớ lại Căn Nhà Hơi Ấm ngày trước... về những đứa trẻ... những lời của bác sĩ... A! Có rồi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300224
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300224,
					"content": "Bác sĩ Jalacan, anh đã từng thấy một cuốn sách vẽ chưa? Có lẽ cô Zuria từng mang nó về đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300225
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300225,
					"content": "Cậu... cậu tính dùng cách thức dẫn dắt tưởng tượng mà phu nhân nói phải không? Tôi hiểu rồi, để tôi đi lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300226
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300226,
					"content": "Bác sĩ rất nhanh đã lấy ra cuốn sách tranh và đưa nó cho Freminet.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300227
					]
				},
				{
					"id": 401300227,
					"content": "Đúng rồi... Chính là thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300228
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300228,
					"content": "Chúng ta phải tiếp tục thám hiểm và hoàn thành cuốn sách này phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300229
					]
				},
				{
					"id": 401300229,
					"content": "Ừm... Theo những gì bác sĩ Jalacan nói, những gì chúng ta trải qua trong những ngày vừa rồi chắc chắn có ích cho cô ấy. Vì vậy chúng ta phải tiếp tục hoàn thành nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300230
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300230,
					"content": "Chúng ta phải để cô Zuria thấy được kết cục tốt đẹp của con trai cô ấy trong thế giới đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300231
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300231,
					"content": "Nhưng mà... Chẳng phải sẽ khiến cô ấy càng khó chấp nhận thực tại hơn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300232,
					"content": "Điều kiện tiên quyết để chấp nhận thực tại là phải đối mặt với nó. Cô ấy đã bị suy sụp tinh thần, không dám đối mặt với sự thật lần nữa. Trước tiên chúng ta phải giúp cô ấy thoát khỏi tình trạng này đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300233
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300233,
					"content": "Ừm... Lúc trước tôi còn tưởng \"Chuyến Thám Hiểm Kỳ Ảo Của Thelxie\" là để cô Zuria cứu lấy con trai mình, nhưng giờ nghĩ lại, đó có lẽ cũng là cách cô ấy tự cứu mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300234
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300234,
					"content": "Nếu chúng ta hoàn thành nó, tôi nghĩ cô Zuria sẽ có được sự an ủi và khích lệ nhất định, từ đó có can đảm để đối mặt với thực tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300235
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300235,
					"content": "Đành phải thử rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300236
					]
				},
				{
					"id": 401300236,
