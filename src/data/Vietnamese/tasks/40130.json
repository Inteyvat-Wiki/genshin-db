			"dialogs": [
				{
					"id": 401300501,
					"content": "Lại tới đây rồi... Là đoạn cuối trong chuyến hành trình của Thelxie rồi nhỉ, nhưng lại thiếu đi một người quan trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
