			"dialogs": [
				{
					"id": 401300601,
					"content": "Xin lỗi... Tôi phải đi đây, tôi có hẹn với bạn, cũng đã muộn lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300602
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300602,
					"content": "Phu nhân, sức khỏe của cô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300603
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300603,
					"content": "Đừng cản tôi! Hôm nay là ngày quan trọng nhất để chữa trị cho Thelxie! Chúng tôi phải dùng liệu pháp dẫn dắt tưởng tượng. Anh cũng cảm thấy nó có tác dụng mà, không phải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300604
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300604,
					"content": "Không phải tôi ngăn cản cô, phu nhân. Chỉ là... Con trai cô tên là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300605
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300605,
					"content": "Bác sĩ Jalacan, sao anh có thể quên tên bệnh nhân của mình chứ? Thằng bé tên là Thelxie! Nó là hoàng tử của vương quốc thủy yêu! Hôm nay tôi phải đoạt lại vương miện và để nó lên ngôi vương!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300606
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300606,
					"content": "Phu nhân... Xin hãy yên tâm, mọi chuyện sẽ không chậm trễ đâu, bạn bè của cô đều đã xuất phát rồi... Đợi đã, nhìn xem! Họ về rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300607
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300607,
					"content": "Cô Zuria! Chúng tôi đem vương miện về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300608,
					"content": "Paimon... Mọi người... Chuyện này là thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300609
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300609,
					"content": "Đúng vậy. Nghi lễ đăng quang của hoàng tử vẫn chưa xong, chúng tôi thấy chuyện này phải do cô chủ trì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300610
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300610,
					"content": "Tốt quá! Thelxie... Con ơi... Con của mẹ... Nghe thấy không? Mọi thứ của con đều đã trở lại, giờ con sẽ không bao giờ cô độc nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300611
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300611,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300612
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300612,
					"content": "Còn trang cuối của cuốn sách. Cô Zuria, đó cũng là chuyện cô phải hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300613
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300613,
					"content": "Đúng, cuốn sách, còn cuốn sách tranh... Nhưng tôi không biết trang cuối phải vẽ gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300614
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300614,
					"content": "Thelxie và chúng tôi đều biết rồi, cô hãy mau chuẩn bị đi. Chúng tôi đọc, cô sẽ vẽ, cứ như vậy là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300615,
					"content": "Được... được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300616
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300616,
					"content": "E hèm... Cuối cùng, Thelxie và các dũng sĩ đồng tâm hiệp lực để truy đuổi tàn quân ma vật. Họ đã giành chiến thắng một cách huy hoàng và đoạt lại vương miện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300617,
					"content": "Thủy yêu đã giành lại quê hương, reo hò chào đón hoàng tử. Họ lại lần nữa lấy ra vỏ sò quý giá, dựng lại cây cầu bảy sắc trước đây. Hoàng tử nhìn ngắm mọi thứ, lòng thầm nghĩ: Ôi, đẹp thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300618
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300618,
					"content": "#Hoàng tử cảm động bước lên cầu, nhìn những người đồng hành đang bước tới, có {NICKNAME}, nữ thần Paimon, Freminet, và còn có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300619,
					"content": "Ồ? Còn một người nữa nhỉ? Hoàng tử nhìn xung quanh, nhưng lại không thấy cô ấy. Lúc này, người đó đột nhiên xuất hiện bên kia cầu, cô ấy mỉm cười bước tới, cởi bỏ mặt nạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300620,
					"content": "Trong một thoáng, nước mắt hoàng tử không ngừng tuôn rơi, vì cậu ấy nhận ra, người thần bí vẫn luôn bên cạnh chính là mẹ mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300621
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300621,
					"content": "Cô Zuria bước tới, đội vương miện lên đầu hoàng tử, mỉm cười và nói với cậu: Con của mẹ, quốc vương của mẹ, con sẽ không bao giờ phải cảm thấy cô đơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300622
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300622,
					"content": "Cô Zuria, đây chính là câu chuyện cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300623,
					"content": "Cảm ơn... cảm ơn mọi người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300624
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300624,
					"content": "Con trai... mẹ muốn xin lỗi con. Lẽ ra mẹ phải ở bên con nhiều hơn... Con nghe thấy không? Cuối cùng con cũng không còn cô đơn nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300625
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300625,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300626
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300626,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300627
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300627,
					"content": "Ừm! Mẹ cũng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300628
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300628,
					"content": "Gì... gì thế này? Cô Zuria giao tiếp với Thelxie sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300629,
					"content": "Thelxie đang nói gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300630
					]
				},
				{
					"id": 401300630,
					"content": "#{NICKNAME}, mau đội mũ lặn của tôi lên đi. Nó có mô đun dịch mã tín hiệu của Thelxie, như vậy là {F#cô}{M#cậu} sẽ hiểu được lời của cậu ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300631
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300699,
					"content": "Freminet ngước nhìn, lấy chiếc mũ lặn ra và đội nó lên đầu bạn.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401300631,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300632
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300632,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300633
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300633,
					"content": "Mẹ ơi, con yêu mẹ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300634
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300634,
					"content": "Hóa ra đây là lời của Thelxie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300635
					]
				},
				{
					"id": 401300635,
					"content": "Mẹ... mẹ cũng rất yêu con...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300636
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300636,
					"content": "Con yêu mẹ nhiều hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300637
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300637,
					"content": "Đợi đã, đây là...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300638
					]
				},
				{
					"id": 401300638,
					"content": "#Sao vậy? {F#Cô}{M#Cậu} đã thấy gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300639
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300639,
					"content": "Mẹ ơi, con hơi buồn ngủ... Đến giờ ngủ rồi, mẹ có thể hát ru một bài nữa được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300640
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300640,
					"content": "Con ngoan... Đương nhiên, chỉ cần con muốn, mẹ sẽ mãi hát ru cho con nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300641
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300641,
					"content": "♪♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300642
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300642,
					"content": "Cảm ơn mẹ. Con thích nhất là được mẹ hát ru, như vậy là con sẽ có thể yên tâm chìm vào giấc mơ, trở về vương quốc thủy yêu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300643
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300643,
					"content": "Đứa trẻ ngốc... Nhất định không được quên, mẹ sẽ luôn yêu con. Giống như... giống như từ đây đến vương quốc thủy yêu xa xôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300644
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300644,
					"content": "Con sẽ không quên đâu. Mẹ cũng phải nhớ, con yêu mẹ, cũng giống như từ vương quốc thủy yêu xa xôi trở về vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300645
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300645,
					"content": "Mẹ ngủ ngon nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lescot Destree"
				}
			]
		},
