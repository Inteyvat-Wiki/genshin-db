			"dialogs": [
				{
					"id": 401300646,
					"content": "Ba ngày sau, tại lều trại của Freminet...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300647
					]
				},
				{
					"id": 401300647,
					"content": "#{NICKNAME}, Paimon, hai vị đến rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300648
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300648,
					"content": "Freminet! Tìm chúng tôi gấp vậy? Có tin tức gì về cô Zuria rồi à? Tin không vui thì tôi không nghe đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300649,
					"content": "Yên tâm, là tin rất vui. Vừa nãy cô ấy và bác sĩ cùng tới đây. Trông cô ấy rất khỏe mạnh, rất có tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300650
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300650,
					"content": "Cô ấy nói sẽ trở lại thành phố và tiếp tục tổ chức cho xong buổi triển lãm, nhưng lần này sẽ hợp tác cùng bác sĩ để trưng bày một số sách tranh liên quan đến bệnh tự kỷ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300651
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300651,
					"content": "Đương nhiên là gồm cả \"Chuyến Thám Hiểm Kỳ Ảo Của Thelxie\" và liệu pháp dẫn dắt tưởng tượng nữa. Cô ấy muốn dùng trải nghiệm của mình để giúp đỡ nhiều người hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300652
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300652,
					"content": "Tốt quá, thật là một tin tức đáng mừng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300653,
					"content": "Ừm, còn cuốn sách tranh, xin hãy nhận lấy nhé. Cô ấy đã để lại cho hai vị đó, phòng trường hợp... sau này có ai gặp chuyện tương tự, cô ấy hy vọng nó sẽ giúp mọi người cùng vượt qua khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300654
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300654,
					"content": "Hả? Đây là câu chuyện của con trai cô ấy mà? Tặng chúng tôi không vấn đề gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300655,
					"content": "Là bản sao thôi. Bản gốc vẫn đang ở chỗ cô Zuria, nó rất có ý nghĩa với cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300656
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300656,
					"content": "Vậy thì tốt rồi. Hihi, cảm thấy chúng ta đã đóng góp được điều gì đó quan trọng rồi. Trước đây tôi còn lo dù gì cũng chỉ là tưởng tượng, không ngờ lần thám hiểm giả tưởng này lại có ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300657
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300657,
					"content": "Paimon biết cô ấy đã nói gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300658
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300658,
					"content": "Cô ấy nói... Khoảnh khắc cô ấy đội vương miện cho Thelxie, cô ấy dường như thực sự nhìn thấy một chuyện vô cùng tốt đẹp... Con trai cô ấy đã trở về, nói với cô rằng bản thân cũng yêu cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300659
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300659,
					"content": "Cô ấy còn nói, trong khoảnh khắc đó, cô ấy đã thực sự nói lời tạm biệt với con trai mình, và cũng khiến cô ấy cảm thấy bản thân được chữa lành, cơ thể bỗng tràn đầy dũng khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300660
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300660,
					"content": "Hả?! Thật sao? Nhưng chắc đó cũng là tưởng tượng của cô ấy thôi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300661,
					"content": "Tuy nhiên, nếu nói tưởng tượng chỉ là tưởng tượng, và thế giới đó là giả, vậy tại sao nó có thể mang đến cho người ta sức mạnh chân thực như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300662
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300662,
					"content": "Vì thế, tưởng tượng chưa chắc chỉ là tưởng tượng thôi đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300663
					]
				},
				{
					"id": 401300663,
					"content": "Vậy... vậy thì là gì mới được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300664,
					"content": "Là sự xuất hiện thực sự của thế giới cổ tích. Trong khoảnh khắc đó, câu chuyện cổ tích tươi đẹp đã trở thành hiện thực trong thoáng chốc và tác động lên thực tại. Hẳn là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300665
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300665,
					"content": "#{NICKNAME} cũng đã thấy, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300666
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300666,
					"content": "Sao có thể chứ? Câu trả lời này hoàn toàn không thực tế. Nếu vậy thì đó chẳng phải là phép màu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300667
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300667,
					"content": "Đúng thế... Đó chính là một phép màu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300668
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300668,
					"content": "Tôi hy vọng tất cả những người đang gặp khó khăn đều được nhìn thấy những thứ tốt đẹp, được nhìn thấy những phép màu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
		},
