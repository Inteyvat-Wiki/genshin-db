			"dialogs": [
				{
					"id": 790000401,
					"content": "Tìm được rồi! Kho báu, kho báu, bên trong sẽ có gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000402,
					"content": "Ấy? Sao lại có khóa, lại còn là khóa mật mã nữa...Cần phải có mật khẩu mới có thể mở được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000403,
					"content": "Khóa này hình như có thể phá được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "Đợi đã! Nếu phá trực tiếp lỡ đâu làm hỏng đồ vật trong đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000406,
					"content": "Chúng ta phải nghĩ cách mở khóa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000410,
					"content": "Nhưng nếu như đồ vật trong rương là báu vật gia truyền, ở bên ngoài lại có khóa mật mã nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000411,
					"content": "Điều đó có nghĩa là người đã khóa nó nghĩ rằng mật khẩu để lại là đủ dễ nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000412,
					"content": "Xem ra hy vọng duy nhất của chúng ta là những âm thanh được lưu lại từ ốc biển rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000413,
					"content": "Thử nghe lại âm thanh của ốc biển xem, hy vọng có thể tìm được manh mối nào đó chứa mật khẩu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000404,
					"content": "Phải nghĩ cách mở khóa thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "Nhưng mà, xung quanh không có bia đá, tranh vẽ, giấy hay bút tích gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000408,
					"content": "Cũng không có học giả, đạo bảo đoàn hay nhà mạo hiểm nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "Đúng vậy, đúng là một thử thách lớn chưa từng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
