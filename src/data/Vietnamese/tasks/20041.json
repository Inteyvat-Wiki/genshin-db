			"trigger": {
				"objectNames": [
					"Patchi Hiếu Kì"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "Không có phương án nào hoàn mỹ cho việc mạo hiểm! Cứ kéo dài như vậy, thì đến lúc nào mới có thể tiến triển?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200410102,
					"content": "Cho dù không có phương án hoàn mỹ, cũng phải có sự chuẩn bị hoàn hảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "Các bạn đang cãi gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Tôi là học giả nghiên cứu di tích cổ đại, muốn đến Thiên Phong Thần Điện khảo sát. Nhưng tôi lại không giỏi ứng phó với những trường hợp cần chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200410105,
					"content": "Ngài Doolan nói mình là một Nhà Mạo Hiểm, nên đã nhận hết nhiệm vụ kiểm tra thần điện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200410106,
					"content": "Tôi, không phải nói ngài Doolan, tôi cũng biết những thủ vệ di tích đó rất phiền phức, nhưng ngài ấy nói phải làm một phương án mạo hiểm hoàn mỹ, cứ kéo tôi đi họp nghiên cứu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200410107,
					"content": "Nghiên cứu... điều tra... điều chỉnh, sau đó lại điều tra... nghiên cứu... điều chỉnh... tôi không chịu nổi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200410108,
					"content": "Lúc nãy ngài ấy lại tìm thấy một manh mối, nói là bên cạnh thần điện có một doanh trại quái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200410109,
					"content": "Năn nỉ bạn, hãy đi thanh lý doanh trại ấy! Cho dù không thể vào thần điện, thì bịt miệng ngài ấy lại cũng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200410110,
					"content": "Tôi, tôi biết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Tôi đến họp với ngài Doolan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "Cám ơn ý tốt của bạn, nhưng hãy tin tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Patchi Hiếu Kì"
				},
				{
					"id": 200410113,
					"content": "So với việc đi họp, bạn sẽ thích đối phó với ma vật hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patchi Hiếu Kì"
				}
			]
		},
