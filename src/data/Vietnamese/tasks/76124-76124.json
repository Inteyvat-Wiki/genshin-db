				},
				{
					"id": 761240204,
					"content": "Trong số những hình nộm này, có một số mặc <color=#00E1FFFF>đồ màu lam</color>, có một số mặc <color=#FF5E41FF>đồ màu đỏ</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240205,
						761240206
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240205,
					"content": "Ồ, giống như ở Sảnh Vương Sơn hồi đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				},
				{
					"id": 761240207,
					"content": "Tôi cũng nhớ ra rồi! Là cần chúng tôi đánh trúng tất cả hình nộm mặc <color=#00E1FFFF>đồ màu lam</color>, nhưng không được đánh trúng hình nộm mặc <color=#FF5E41FF>đồ màu đỏ</color>, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240208,
					"content": "#Haha, hoàn toàn chính xác! Đã vậy thì tôi cũng không cần phải nói nhiều nữa. Nào, hãy cho tôi thấy kiếm thuật của {F#cô}{M#cậu} nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240206,
					"content": "Tôi biết quy tắc rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				}
			]
		},
