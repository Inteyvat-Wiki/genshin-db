			"dialogs": [
				{
					"id": 761240101,
					"content": "Ây dà, dù xem bao nhiêu lần vẫn thấy kỳ lạ... Chưa nghe nói có ai luyện kiếm bằng cách chặt tre bao giờ cả. Tên nhóc Cổ Hoa đó đúng là có những suy nghĩ kỳ quặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240102
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240102,
					"content": "Tre có thể làm giỏ, làm ván, làm sáo, làm que tính, làm làn. Chỉ không thấy làm cọc hay làm cột. Chắc không phải vì không mua nổi gỗ đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240103
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240103,
					"content": "Được rồi, hai vị! Tranh đã mở ra rồi, thì để tôi thay đám nhóc Phái Cổ Hoa nói về quy tắc nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240104
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240104,
					"content": "Trong số những hình nộm này, có một số mặc <color=#00E1FFFF>đồ màu lam</color>, có một số mặc <color=#FF5E41FF>đồ màu đỏ</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240105
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240105,
					"content": "Vòng đầu tiên của buổi diễn võ này là đánh vào hình nộm mặc đồ màu <color=#00E1FFFF>lam</color>, nhưng không được đánh trúng hình nộm mặc đồ màu <color=#FF5E41FF>đỏ</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240106
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240106,
					"content": "#Nếu đã chuẩn bị xong thì có thể bắt đầu bất cứ lúc nào. Nào, hãy cho tôi thấy kiếm thuật của {F#cô}{M#cậu} nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		},
