				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "Ủa? Bên đây hình như còn một bức tranh nữa này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240402,
					"content": "À ha, mắt tinh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240403,
					"content": "Đây là thứ mà đám nhóc tự xưng là truyền nhân Phái Cổ Hoa lúc trước nhờ Castiglione vẽ ra, nói rằng đây là \"võ đài\" mà chúng vô cùng tự hào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240404,
					"content": "Nhưng mà, chúng cao ngạo lắm. Nghĩ rằng bản thân đã là tuyệt đỉnh cao thủ, chẳng cần phải tu luyện những thứ cơ bản này nữa, nên đã tặng tranh cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240405,
					"content": "Ấy? Cô không phải người của Phái Cổ Hoa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240406,
					"content": "Haha, tôi cũng muốn nói mình là người của họ lắm. Nhưng đáng tiếc, tên nhóc Cổ Hoa kia e là không đủ can đảm thu nhận tôi vào phái đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240407,
					"content": "Hồi đó, khi chúng tôi cùng tiêu diệt đám trộm cướp ở Quy Li Nguyên, tên nhóc đó suýt nữa mất mạng vì võ nghệ chưa tinh thông, tôi buộc phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240408,
					"content": "Thôi được rồi, toàn những chuyện nhạt nhẽo cả, nhưng bức tranh này thì khá thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240409,
					"content": "#Nếu {F#cô}{M#cậu} thích thì cứ mở ra xem đi? Xé rách cũng chẳng sao, dù sao Castiglione cũng rảnh rỗi chẳng có gì làm, bảo anh ta vẽ lại bức khác là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		}
	]
}