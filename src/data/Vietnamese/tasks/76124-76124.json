				]
			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "Được rồi, kết thúc thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240302,
					"content": "Cảm ơn hai vị, tôi vui lắm. Nhất là nhóc tóc vàng này, võ công thật sự không tầm thường, e là còn mạnh hơn tên nhóc Cổ Hoa mà tôi quen nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240303,
					"content": "Không hổ danh là tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "Nhờ có hai vị, đã lâu rồi tôi mới có được vài cảm ngộ. Tương cá đúng là vẫn phải thêm chút thịt rừng tươi băm nhỏ để tăng hương vị. Nếu không, để lâu cũng vẫn không át được mùi tanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240307,
					"content": "Ồ ồ, ra là vậy... Hả? Sao chẳng liên quan gì đến nhau thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240308,
					"content": "Haha, đừng để tâm chuyện nhỏ nhặt đó! Lần sau tôi sẽ nhờ Castiglione vẽ thêm vài con cá nữa, rồi sẽ mời hai người ăn tương cá nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240304,
					"content": "Quá khen rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "#Ha, không cần khiêm tốn đâu. Kiếm thuật của {F#cô}{M#cậu} rất mạnh, điều này tôi vẫn nhìn ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Jinggui"
				}
			]
		},
