						715090102
					]
				},
				{
					"id": 715090102,
					"content": "Cuối cùng cũng đưa \"Gai Pursina\" tới chỗ lỗ thông hơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715090103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715090103,
					"content": "Khụ khụ... Theo tôi tính toán, nơi này đúng là lỗ thông hơi của Địa Mạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715090104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715090104,
					"content": "Nếu khởi động Gai ở đây, không ngừng tạo thành ảnh hưởng với Địa Mạch, cuối cùng bịt kín lỗ thông hơi bùn đen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715090105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715090105,
					"content": "Nhất định có thể giải quyết vấn đề bùn đen phun trào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715090106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715090106,
					"content": "Hay là bắt đầu luôn nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715090107
					]
				},
				{
					"id": 715090107,
					"content": "Không được, tôi phải điều chỉnh thử một lần nữa, lỡ như xảy ra sự cố như lúc thử vận hành ở doanh trại thì mất nhiều hơn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715090108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715090108,
					"content": "Đợi \"Gai Pursina\" chuẩn bị xong là có thể giải quyết đám bùn đen và quái vật đáng ghét này rồi... Khụ khụ...",
