			"dialogs": [
				{
					"id": 700190101,
					"content": "Yoyo dala si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190102
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700190102,
					"content": "Mimi tomo. Mimi mani ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700190103,
					"content": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700190104,
					"content": "Nó nói nó hy vọng không nhìn thấy mặt trời nữa, muốn ngủ mãi không tỉnh dậy, muốn chết. Chuyện gì đã khiến nó đau khổ vậy nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700190105,
					"content": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700190106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700190106,
					"content": "Ừm, chi bằng, chúng ta đưa nó thứ mà nó muốn, để an ủi tâm hồn bé bỏng của nó nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
