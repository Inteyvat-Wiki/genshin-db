					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "Cái này chả có tác dụng gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "...Xem ra bạn thực sự rất rảnh, không hiểu là do thực lực quá mạnh hay quá yếu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100104,
					"content": "Có điều tôi cho rằng thực lực của bạn cũng không đến nỗi, vì những ủy thác tôi nhờ bạn đều hoàn thành rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100105,
					"content": "Rảnh rỗi như vậy chi bằng nhận ủy thác tiếp theo đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100106,
					"content": "Lần này là tiêu diệt một mục tiêu nguy hiểm, đó là \"Thợ Săn Di Tích\", thế nào hả? Dám nhận không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100107,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "Quả thật là Nhà Mạo Hiểm đầy tự tin, giống như anh trai tôi vậy... Không biết chừng sau này lại làm nên được sự nghiệp vĩ đại gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100113,
					"content": "Được rồi, không nói chuyện phiếm nữa, địa điểm cụ thể ở Quy Li Nguyên. Chuẩn bị xong thì đi tiêu diệt Thợ Săn Di Tích đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100114,
					"content": "Sau khi tiêu diệt Thợ Săn Di Tích, nếu tìm thấy món đồ gì có liên quan đến \"kiếm\" thì mang về cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100115,
					"content": "...Nếu không thấy, thì quay về đây luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100116,
					"content": "Tóm lại là, ủy thác này nhờ bạn rồi, hy vọng lần này... có phát hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100108,
					"content": "Lần này cũng cần để ý đến \"kiếm\" phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Đúng rồi, sau khi tiêu diệt Thợ Săn Di Tích, nhớ để ý mấy món đồ liên quan đến \"kiếm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100111,
					"content": "Thế nhưng ủy thác là tiêu diệt Thợ Săn Di Tích không phải loại dễ ăn đâu. Tập trung vào mục tiêu là trên hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100112,
					"content": "Còn món đồ liên quan đến \"kiếm\" nếu tìm thấy thì tốt, không thấy cũng không sao, chỉ cần tiêu diệt Thợ Săn Di Tích là bạn có phần thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				}
			]
		},
