				"points": []
			},
			"dialogs": [
				{
					"id": 221100301,
					"content": "Sao rồi? Tiêu diệt chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100302,
					"content": "Đã tiêu diệt xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "Ngay cả Thợ Săn Di Tích cũng bị tiêu diệt... thì nhìn từ góc độ nào đi chăng nữa thực lực của bạn cũng rất mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100304,
					"content": "...Vẫn không tìm được thứ gì liên quan đến \"kiếm\" sao? Hừm... vẫn trong dự tính, câu này tôi nói đến phát chán rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100305,
					"content": "Không sao, bạn vất vả rồi, đã hoàn thành toàn bộ ủy thác của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100306,
					"content": "\"Tàng Phong\", rốt cuộc ngươi ở đâu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100307,
					"content": "Nhất định sẽ tìm thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "...Bạn đang an ủi tôi sao? Chuyện nhỏ như vậy không có trở ngại gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100310,
					"content": "Bất kể tìm đến bao giờ, ở đâu... Tôi cũng sẽ tìm được thanh kiếm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100311,
					"content": "Tôi sẽ mở rộng phạm vi tìm kiếm, về sau có lẽ phải nhờ bạn, yên tâm tôi sẽ trả lương hậu hĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100316,
					"content": "Vất vả rồi, đây là phần thưởng, cầm lấy đi. Tôi phải xem lại ủy thác một lượt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100317,
					"content": "...Tàng Phong, ta nhất định sẽ tìm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100308,
					"content": "Những ủy thác nghe có vẻ không liên quan đến \"kiếm\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "Là bởi vì, tất cả các ủy thác liên quan đến \"kiếm\", tôi đã nhận hết rồi... nhưng cuối cũng vẫn không có gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100313,
					"content": "Sau đó, tôi cho rằng.... để có thể lấy lại được thanh kiếm đã mất của anh trai, chỉ có thể ở những tình huống nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100314,
					"content": "Vì vậy tôi bắt đầu nhận các ủy thác khác, thử sức ở những tình huống nguy hiểm, tìm thanh \"Tàng Phong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100315,
					"content": "Có điều các ủy thác cấp độ nguy hiểm khá nhiều, tôi một mình làm không hết, chính vì vậy phải nhờ bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				}
			]
		}
	]
}