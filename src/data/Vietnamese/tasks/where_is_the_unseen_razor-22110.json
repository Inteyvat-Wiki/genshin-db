			"dialogs": [
				{
					"id": 221100201,
					"content": "Sao rồi? Tiêu diệt chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100202,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "Không sao, kẻ địch như \"Thợ Săn Di Tích\" cần phải cẩn thận",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
