					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "Ổ trục này có kích thước lớn quá, không thể tương thích với các ổ trục khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150102,
					"content": "Cái lần trước quá nhỏ, cái lần này lại quá lớn, sắt của tôi sắp bị anh dùng hết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150103,
					"content": "Trên thực tế, tiền của chúng ta cũng sắp không đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150104,
					"content": "Các anh đang cãi nhau về chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "Người này muốn tôi chế tạo nhiều ống sắt và bánh răng. Hơn nữa, mỗi ống sắt và bánh răng còn có yêu cầu khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150106,
					"content": "Tôi đã sắp dùng hết sắt trong tiệm để làm mấy thứ này cho anh ta rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150107,
					"content": "Nhưng anh ta nói vẫn chưa đủ dùng, cần nhiều bánh răng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150108,
					"content": "Xin hãy nghe tôi giải thích công việc của mình. Sau khi nghe xong, ngài sẽ hiểu thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150109,
					"content": "Anh đang làm cái gì đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "Hãy để ngài Garcia giải thích cho ngài Ahangar hiểu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150111,
					"content": "Nhà Lữ Hành, tôi... ừm, ngài Garcia muốn nhờ bạn đi thu thập vài mảnh sắt, không biết bạn có đồng ý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150112,
					"content": "Tôi có rảnh, nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "Trong lĩnh vực chế tạo máy móc, chúng tôi gặp phải trở ngại đã được dự đoán từ trước. Trước mắt ngài Garcia đang nghĩ cách vượt qua trở ngại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150115,
					"content": "Nếu sau này bạn thấy hứng thú thì hãy đến hỏi ngài Garcia nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150116,
					"content": "Tôi nghĩ... Ngoài ngài ấy ra, ít ai giải thích rõ ràng được nguyên lý của thiết bị đó lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150117,
					"content": "Nhưng trước đó, xin hãy lấy giúp chúng tôi ít mảnh sắt về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150113,
					"content": "Anh ấy cải tiến máy móc đến đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
