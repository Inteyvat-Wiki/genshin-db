				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "Được rồi được rồi! Không cần nói nữa, tôi làm bánh răng tiếp đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150302,
					"content": "Nhưng tôi vẫn chưa giải thích rõ ràng về thiết bị của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150303,
					"content": "Sắt cũng đã có rồi, tôi bắt đầu ngay đây, anh tránh xa ra một chút nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150304,
					"content": "Ahangar vung cây búa thép, Garcia đành phải né sang một bên...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "Cứ để Ahangar làm việc tiếp đi, đây là thù lao của bạn, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150306,
					"content": "Hy vọng các anh sẽ thành công.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "Tôi sẽ chúc phúc cho bạn, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150308,
					"content": "Về chuyện này tôi... vẫn giữ thái độ khá bi quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150309,
					"content": "Ngài Garcia là một thiên tài trong lĩnh vực máy móc, điều này không cần nghi ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150310,
					"content": "Nhưng tôi cho rằng, đối với chiếc máy mà ngài Garcia muốn hoàn thành kia... Dù ngài ấy là một \"thiên tài\" thì có lẽ vẫn chưa đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301550,
