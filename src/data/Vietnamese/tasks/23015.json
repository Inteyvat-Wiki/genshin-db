					"Ahangar",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "Anh cần nhiều bánh răng và ống như vậy làm gì? Muốn dựng một căn nhà bằng thép à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "Đúng vậy, thưa ngài! Tôi muốn dựng một căn nhà, một căn nhà chứa đầy bánh răng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155003,
					"content": "Tôi gọi nơi chứa một phần bánh răng là \"phòng chứa\", còn ổ trục và một phần bánh răng khác thì tạo thành \"kho tính\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155004,
					"content": "Bánh răng trong \"phòng chứa\" dùng để lưu trữ và ghi chép con số, còn bánh răng trong \"kho tính\" thì dùng để tính toán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155005,
					"content": "Tôi vẽ ra một bản vẽ là ngài sẽ hiểu ngay thôi, có giấy không? Không có à? Không sao hết, tôi vẽ trên quần áo cũng được, như thế sẽ dễ hình dung hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155006,
					"content": "Có thể cho tôi cục than đó không? Rất cảm ơn, anh nhìn đây nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		}
	]
