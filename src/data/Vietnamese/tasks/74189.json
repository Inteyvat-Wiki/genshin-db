			"dialogs": [
				{
					"id": 741890501,
					"content": "#Khoan đã, vị khách này. {F#Cô}{M#Cậu} có muốn biết bí mật liên quan đến kho báu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890502,
					"content": "Bí mật gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "Kho báu và chìa khóa để mở cửa vào... Thế nào? Vị khách đây liệu có hứng thú với nó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890504,
					"content": "Đừng nói là tôi phải đi đánh nhau với ma vật nữa nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "Không! Quán rượu của chúng tôi trước giờ chưa hề sai khiến khách làm điều gì. Ít nhất thì... chúng tôi sẽ không làm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890507,
					"content": "#{F#Cô}{M#Cậu} có nhìn thấy khẩu pháo chiến hạm kia không? Và cả đống đá vụn phía đối diện khẩu pháo nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890508,
					"content": "Chỉ cần kích hoạt khẩu pháo là có thể bắn vỡ đống đá, và nhận được kho báu trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890509,
					"content": "Ai đã đặt tên cho khẩu pháo này vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "Là Người Cầm Lái đặt đó. Khẩu pháo này cũng không biết anh ta đã nhặt từ đâu về nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890511,
					"content": "Cứ nói thẳng đi, khẩu pháo này còn thiếu bộ phận nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "Hiểu lầm rồi, tất cả bộ phận của khẩu pháo này đều còn nguyên vẹn, năng lượng cũng rất dồi dào. Tôi đã bảo trì nó hằng ngày đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890514,
					"content": "#Nhưng trước khi kích hoạt thì tôi muốn {F#cô}{M#cậu} trả lời một số \"câu hỏi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890515,
					"content": "Nói thật, đây là yêu cầu của Người Cầm Lái. Anh ấy nói như vậy sẽ mang lại cho khách việc gì đó để làm, từ đó khiến họ uống rượu chậm lại, cũng sẽ ở lại quán lâu hơn một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890516,
					"content": "Vậy thì cứ hỏi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "Câu hỏi đầu tiên: Bên trong quán rượu \"Bánh Lái Rỉ Sét\" có mấy cái bàn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890518,
					"content": "Câu hỏi thứ hai: Quán rượu \"Bánh Lái Rỉ Sét\" có bao nhiêu nhân viên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890519,
					"content": "Câu hỏi thứ ba: Món nào không được phục vụ trong \"Bánh Lái Rỉ Sét\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890520,
					"content": "Tóm lại, chỉ cần trả lời đúng ba câu hỏi này là sẽ có thể kích hoạt khẩu pháo để đoạt lấy kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890521,
					"content": "Sau khi tôi lấy được kho báu sẽ thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "Thì tôi sẽ tìm thời điểm thích hợp để đặt lại kho báu, sau đó dùng đá vụn để lấp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890523,
					"content": "Rồi lại đợi vị khách tiếp theo đến kích hoạt khẩu pháo để lấy kho báu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890524,
					"content": "Vất vả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "Được rồi. Hãy đi tìm câu trả lời đi nhé, tôi sẽ ở đây đợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890525,
					"content": "Chủ tiệm cũng chèn ép thật đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
