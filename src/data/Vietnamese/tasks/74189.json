					"content": "Thật đáng tiếc, trả lời sai rồi... Có muốn thử lại lần nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890426,
						741890427
					],
					"speakerTitle": "Permingeat"
				},
				{
