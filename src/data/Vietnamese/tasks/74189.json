					"nextDialogs": [
						741890409
					]
				},
				{
					"id": 741890409,
					"content": "Vậy chúng ta bắt đầu thôi. Câu hỏi đầu tiên. Quán rượu \"Bánh Lái Rỉ Sét\" có mấy cái bàn?",
					"roleType": "TALK_ROLE_NPC",
