				},
				{
					"id": 741890402,
					"content": "Câu hỏi đầu tiên: Bên trong quán rượu \"Bánh Lái Rỉ Sét\" có mấy cái bàn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890403
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890403,
					"content": "Câu hỏi thứ hai: Quán rượu \"Bánh Lái Rỉ Sét\" có bao nhiêu nhân viên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890404
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890404,
					"content": "Câu hỏi thứ ba: Món nào không được phục vụ trong \"Bánh Lái Rỉ Sét\"?",
					"roleType": "TALK_ROLE_NPC",
