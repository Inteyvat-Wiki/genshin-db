			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "\"Nếu bạn đọc được dòng chữ này, hy vọng bạn là người mà tôi muốn tìm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701270202,
					"content": "\"Chúng ta từng nghĩ chiến tranh chỉ là chuyện trong thần thoại hoặc truyền thuyết. Nhưng giờ đây, mỗi người chúng ta đều run sợ trước cơn thịnh nộ của đại nhân.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701270203,
					"content": "\"Bãi biển mà chúng ta thường đến đã bị phong tỏa, nhưng tôi vẫn nghĩ cách để chuyển bức thư này ra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701270204,
					"content": "\"Cũng đừng lo lắng quá. Đối với người cùng bạn mạo hiểm như tôi mà nói thì đây chỉ là chuyện nhỏ mà thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701270205,
					"content": "\"Tôi sẽ đợi thư hồi âm của bạn, dù là một câu thôi cũng được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Trôi"
				}
			]
		}
	]
