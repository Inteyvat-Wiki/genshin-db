			},
			"dialogs": [
				{
					"id": 701270101,
					"content": "\"Nếu bạn đọc được dòng chữ này, hy vọng bạn là người mà tôi muốn tìm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701270102,
					"content": "\"Đây là bức thư thứ mấy rồi nhỉ? Bức thư này đã đi bao xa, hay là lại kẹt ở đâu rồi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701270103,
					"content": "\"Đợi khi có cơ hội gặp lại, hãy kể tiếp cho tôi nghe về ngọn núi ở cảng đá, gió tuyết ở Bắc Quốc, hoặc bồ công anh và rượu, được chứ?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701270104,
					"content": "\"Tôi sẽ đợi thư hồi âm của bạn, như mọi khi vậy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Trôi"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
