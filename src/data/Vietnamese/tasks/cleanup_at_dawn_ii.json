			"dialogs": [
				{
					"id": 201040101,
					"content": "Phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040102,
					"content": "Lại bị hầu gái trưởng mắng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040103,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "Tiểu thư Adelinde vốn bảo chúng tôi dọn dẹp bên ngoài tửu trang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040105,
					"content": "Những nơi khác thì không sao, nhưng ở xung quanh có rất nhiều cỏ khô chất thành đống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040106,
					"content": "Ngài Connor để chúng ở đây, nói rằng sẽ có lúc cần đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040107,
					"content": "Bởi vì được bó rất chặt nên đống cỏ khô này không bị thổi bay, nhưng có rất nhiều lá rụng bị cuốn vào đống cỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040108,
					"content": "Chúng tôi đã bỏ ra rất nhiều công sức nhưng cũng không thể nào loại bỏ hết đám lá ra khỏi đống cỏ khô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040109,
					"content": "Cứ lề mề như thế này, chúng tôi lại bị hầu gái trưởng mắng mất thôi, phải làm sao bây giờ đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040110,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "Í? Có thể giao cho bạn chứ! Tốt quá rồi, trông cậy cả vào bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040112,
					"content": "Rất khó dọn sạch hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "Lá rụng và cỏ khô lẫn lộn với nhau, chúng tôi chỉ có thể dùng tay từ từ tách rời chúng, thực sự là rất chậm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040114,
					"content": "Nếu bạn có biện pháp gì tốt, xin hãy giúp chúng tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
