			"dialogs": [
				{
					"id": 201040301,
					"content": "Bạn, bạn làm gì vậy, sao lại đốt cháy hết cả đống cỏ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040302,
					"content": "Lần này không phải bị mắng là có thể xong chuyện, chắc chắn sẽ bị đuổi việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040303,
					"content": "Không cẩn thận đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "Sớm biết như vậy, chúng tôi cứ từ từ nhặt từng chiếc lá ra rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040305,
					"content": "Xong rồi... lần này xong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040306,
					"content": "Cái đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "Nhà Lữ Hành, xin hãy mau rời khỏi đây đi, chuyện này là trách nhiệm của chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040308,
					"content": "Chúng tôi không nên để người không biết dọn dẹp giúp đỡ, là lỗi của chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040309,
					"content": "Hầu gái trưởng sẽ xử lý chúng tôi thế nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "Moco"
				},
				{
