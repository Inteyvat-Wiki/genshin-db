			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181001,
					"content": "Ei khi xử lý công việc, quả nhiên vẫn có cảm giác giống Shogun, rất là uy nghiêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181002,
					"content": "Vậy sao? Tôi thấy tôi đã dễ tính hơn trước nhiều rồi. Nếu như để Shogun xử lý thì... Kujou Kamaji đã bỏ mạng lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181003,
						120181004
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181003,
					"content": "Anh ta cũng may mắn thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				},
				{
					"id": 120181005,
					"content": "Tôi cảm nhận được Kamaji lúc đó đã xác định số phận rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181006
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181006,
					"content": "Trong thời kỳ hưng thịnh đến suy tàn của nhà Kujou, quả thật đây là một biến cố rất lớn. Kujou Kamaji tuy không phải là người kế thừa ưu tú, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181007
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181007,
					"content": "Kamaji đã cho tôi thấy được một điều bất biến giữa dòng thời gian vạn biến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181008
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181008,
					"content": "Cũng nhờ có các bạn, chuyến đi dạo này với các bạn đã khiến tôi hiểu được điều này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181009
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181009,
					"content": "Vậy nhà Kujou sau này sẽ như thế nào? Có còn tiếp tục đảm nhận Hiệp Hội Tenryou không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181010,
					"content": "Chắc là không, cho dù người kế thừa có chí khí, nhưng cũng không thể xóa sạch hết lỗi lầm trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181011
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181011,
					"content": "Nhưng mà... cứ để như vậy thêm một thời gian nữa vậy, dù gì thì người phạm lỗi không chỉ có bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181012
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181012,
					"content": "Shogun không sai, hoặc có thể nói là không thể sai. Nhưng thân là \"Ei\", tôi cũng phải bày tỏ sự áy náy trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181013
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181013,
					"content": "Những điều cần phải suy nghĩ cho sau này còn rất nhiều, nhưng ít ra thì bây giờ tôi đã nhìn rõ con đường phía trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181014
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181014,
					"content": "Vậy bạn sẽ trực tiếp quản lý Inazuma sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181015
					]
				},
				{
					"id": 120181015,
					"content": "Tôi vẫn sẽ giao cho Shogun làm, sự uy hiếp lớn nhất của vĩnh hằng, chính là \"sự bào mòn\" của thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181016
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181016,
					"content": "Tôi từng nói là Shogun có cơ chế tự bảo vệ, chính là vì tôi đã đề phòng trước việc tôi sẽ thay đổi theo thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181017
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181017,
					"content": "Nhưng nếu bản thân đã nghĩ thông suốt rồi thì cho dù là việc khó khăn thế nào tôi cũng sẽ làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181018
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181018,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181019
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181019,
					"content": "Quả nhiên là một thời khắc đáng để kỷ niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181020
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181020,
					"content": "Đúng vậy, chuyện của Hiệp Hội Tenryou đã giải quyết xong, người dân trong thành đều đã thấy Shogun khỏe mạnh, những lời đồn đại cũng sẽ tự động biến mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181021,
					"content": "Nếu Ei thích thì sau này chúng tôi sẽ dẫn bạn đi chơi tiếp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181022,
						120181023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181022,
					"content": "Đi ăn thêm vài món đặc sản nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181024,
					"content": "Không cần đâu, đây không phải là một phần trong cuộc sống của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181025
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181025,
					"content": "Cho nên, đừng cho rằng tôi sẽ luôn cần có người ở bên cạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181026
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181026,
					"content": "Được rồi, chúng ta quay về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181027
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181027,
					"content": "Tôi sẽ tiếp tục bế quan tịnh dưỡng, nhưng sẽ không lâu đâu. Những chuyện nhỏ nhặt này tôi sẽ giao cho thuộc hạ xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181028
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181028,
					"content": "Vậy hẹn gặp lại sau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181029,
					"content": "Tuy là có chuyện xảy ra ngoài ý muốn, nhưng chuyến đi cuối cùng cũng đã thuận lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181030,
					"content": "Bây giờ, chúng ta mang giấy thông hành trả lại cho Yae Miko thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181023,
					"content": "Đi tìm hiểu thêm vài thứ mới mẻ nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181004,
					"content": "Có thể anh ta không ngờ đến việc này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				}
			]
		},
