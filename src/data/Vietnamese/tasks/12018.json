					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180701,
					"content": "Kujou Kamaji đã bị thương, hậu duệ của nhà Takatsukasa, các ngươi phải phụ trách chăm sóc y.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180702
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180702,
					"content": "Không có gan khiêu chiến thì lo mà làm những chuyện nhỏ này cho tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180703
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180703,
					"content": "Vâng vâng, xin đại nhân thứ lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180704
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180704,
					"content": "Lúc này nhà Kujou khó chủ trì đại cục, chuyện này ta đã nghe báo cáo qua, ta vỗn dĩ định tìm người tiếp quản Hiệp Hội Tenryou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180705
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180705,
					"content": "Nhưng sau cuộc quyết đấu này, ta cho rằng có thể tạm hoãn việc xử tội nhà Kujou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180706
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180706,
					"content": "Trong quãng thời gian này, nhà Takatsukasa vẫn sẽ như trước, dốc sức mà hỗ trợ cho nhà Kujou đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180707
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180707,
					"content": "Thuộc, thuộc hạ tuân lệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180708
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180708,
					"content": "Nếu như các người cho rằng sẽ còn có thể qua mặt ta, cấu kết với Fatui, khiến ta phán đoán sai lầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180709
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180709,
					"content": "Thì đừng trách thanh đao của ta không nể tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180710
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180710,
					"content": "Thuộc hạ xin ghi nhớ, đại nhân Shogun anh minh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180711
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180711,
					"content": "Được rồi, chuyện còn lại ta sẽ giao cho đội điều tra làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180712
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180712,
					"content": "Còn hai người đi theo tôi, tìm một chỗ vắng vẻ tôi có chuyện muốn nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201810,
			"completionStepIds": [
				1201810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201810",
							"2"
