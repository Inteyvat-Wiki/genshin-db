			"dialogs": [
				{
					"id": 120180301,
					"content": "Ối, có nơi bí ẩn như vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180302,
					"content": "Thông thường mà nói thì sẽ không có lý do gì để xây dựng một kiến trúc như vậy ở đây cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180303,
						120180304
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180303,
					"content": "Có thể là một nơi để lánh nạn chăng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				},
				{
					"id": 120180305,
					"content": "Tôi cảm nhận được mùi vị không thuộc về nơi này, là mùi vị của nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180306
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180306,
					"content": "Sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180307,
					"content": "Cẩn thận chút, hậu duệ của nhà Kujou có thể đã bị nhốt bên trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180304,
					"content": "Có thể là để tránh tai mắt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				}
			]
		},
		{
			"id": 1201805,
			"completionStepIds": [
				1201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
