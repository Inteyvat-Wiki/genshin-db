			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180506,
					"content": "Đại nhân Shogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180507
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180507,
					"content": "Sao đại nhân Shogun lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180508
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180508,
					"content": "Khai báo tình hình ở đây cho ta nghe đi, hậu duệ của nhà Takatsukasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180509
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180509,
					"content": "Chúng tôi chỉ đang thảo luận về những việc gần đây của Hiệp Hội Tenryou, việc này không cần đại nhân phải bận tâm đâu ạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180510
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180510,
					"content": "Vì chuyện này nên mới cố tình xây dựng một nơi bí mật như vậy, lại còn thuê cả nhóm ronin trấn thủ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180511,
					"content": "Tại vì gần đây có nhiều biến động quá nên cần phải chú ý an toàn thưa đại nhân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180512
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180512,
					"content": "Im miệng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180513
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180513,
					"content": "Hậu duệ của nhà Kujou, ngươi nói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180514
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180514,
					"content": "Được rồi, vốn dĩ tại hạ đến đây với mục đích đàm phán, nhưng cái mà họ muốn có chính là thư nhận tội của nhà Kujou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180515
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180515,
					"content": "Thư nhận tội?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180516,
					"content": "Đúng vậy, giải trình những sai phạm của nhà Kujou trong Lệnh Truy Lùng Vision, bao gồm cả các sai sót dạo gần đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180517
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180517,
					"content": "Đó đều là sự thật, không hề ngụy tạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180518
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180518,
					"content": "Không hề, trong thư còn nhiều lần kể công nhà Takatsukasa, luôn nhắc đến việc nhà Takatsukasa ra sức cứu vãn tình hình, không ngại khó khăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180519
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180519,
					"content": "Những chuyện này hoàn toàn dối trá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180520
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180520,
					"content": "Ai nói vậy? Ngươi... ngươi dám trở mặt sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180521
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180521,
					"content": "Tôi chỉ nói sự thật thôi, đại nhân Shogun tự sẽ có quyết định của mình. Mục đích của nhà Takatsukasa là muốn tạo hình tượng để thay thế nhà Kujou đúng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180522
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180522,
					"content": "Nếu không thì tại sao lại nhấn mạnh nhiều công lao không có thật trong thư nhận tội của nhà Kujou đến vậy, còn muốn giam lỏng tôi để ép ký tên nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180523
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180523,
					"content": "Ngươi nói gì? Ai giam lỏng nhà ngươi! Đây là đàm phán, chỉ là đàm phán có hiểu không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180524
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180524,
					"content": "Ta đã nắm được tình hình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180525,
					"content": "Đại nhân đừng nghe tên tiểu tử này nói, lỗi lầm của nhà Kujou hẳn đại nhân cũng đã biết rồi, lời nói của bọn họ tuyệt đối không đáng tin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180526
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180526,
					"content": "Hừ, ta không có hứng thú với màn tranh luận của các ngươi. Nhưng hậu duệ của nhà Takatsukasa, ngươi muốn nắm quyền Hiệp Hội Tenryou, đúng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180527,
					"content": "Cái, cái này... đúng vậy, cùng Shogun đại nhân vào sinh ra tử, chính là trách nhiệm mà mỗi vị thần quan hướng tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180528
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180528,
					"content": "Không cần nịnh nọt đến thế đâu, dẫu sao thì người bổ nhiệm Hiệp Hội Tenryou là ta. Chỉ cần có người thắng được ta trong trận quyết đấu thì người đó sẽ trở thành Hiệp Hội Tenryou tân nhiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180529,
					"content": "Quyết... quyết đấu với Shogun đại nhân sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180530
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180530,
					"content": "Hiệp Hội Tenryou đời đầu đã dùng thanh đao để chứng minh ý chí của họ, nên mới có nhà Kujou của ngày nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180531,
					"content": "Muốn ta công nhận một cái tên mới, thì phải đương đầu với thử thách của ta lại từ đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180532,
					"content": "Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180533
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180533,
					"content": "Không lẽ ngươi không biết kiếm thuật sao? Hay là do tuổi già sức yếu nên không dám?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180534,
					"content": "Phun ra câu vào sinh ra tử, nhưng lại không dám đối mặt với thanh đao của ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180535,
					"content": "Ối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180536
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180536,
					"content": "Còn các ngươi thì sao? Cho dù là Takatsukasa hay là ai đi nữa, chỉ cần thắng được ta, thì người đó sẽ là Hiệp Hội Tenryou tân nhiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180537
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180537,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180538
					],
					"speakerTitle": "Gia Thần Takatsukasa"
				},
				{
					"id": 120180538,
					"content": "Không ai đủ can đảm đứng ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180539
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180539,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180540
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180540,
					"content": "Có tại hạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180541
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180541,
					"content": "Tại hạ muốn khiêu chiến, thưa đại nhân Shogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180542
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180542,
					"content": "Úi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180543,
					"content": "Hậu duệ của nhà Kujou, thật đáng tiếc, dù cho ngươi thắng được ta thì lỗi lầm của nhà Kujou gây ra cũng sẽ không thể gột rửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180544
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180544,
					"content": "Không, tại hạ biết bản thân sẽ không có cơ hội thắng, tại hạ chỉ muốn bù đắp phần nào lỗi lầm của gia chủ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180545
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180545,
					"content": "Khi chấp hành Lệnh Truy Lùng Vision, tại hạ đã luôn nghi ngờ phụ thân, nên xét cho cùng thì tại hạ cũng có lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180546
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180546,
					"content": "Tại hạ luôn nghi ngờ, luôn suy nghĩ, rõ ràng đã thấu hiểu, nhưng lại không hành động, cũng không thể cứu được ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180547
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180547,
					"content": "Giờ đây nhà Kujou trở thành như vậy âu cũng là một sự trừng phạt, đều do tại hạ đã không làm gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180548
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180548,
					"content": "Tàn nhẫn mà nói, với sức lực của ngươi, cũng không thể làm được gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180549
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180549,
					"content": "Sức lực của bản thân có hạn, phụ thân nhất mực không nghe, huynh trưởng thì không thể giúp gì, đến cả Ippei nhiều lúc cũng giáo huấn được tại hạ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180550
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180550,
					"content": "Nhưng giờ đây, vào thời khắc vinh quang cuối cùng của nhà Kujou, tại hạ sẽ lấy danh nghĩa nhà Kujou để gánh vác trách nhiệm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180551
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180551,
					"content": "Như Shogun từng nói, tổ tiên của tại hạ đã dùng thanh đao để chứng minh ý chí của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180552
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180552,
					"content": "Vậy thì để tại hạ, Kujou Kamaji, sử dụng thanh đao này để kết thúc tất cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180553
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180553,
					"content": "Đây là cơ hội để cho tại hạ \"có thể làm được cái gì đó\" rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180554
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180554,
					"content": "Thật vô nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180555
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180555,
					"content": "Nhưng ta sẽ chấp thuận, bước lên đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201807,
			"completionStepIds": [
				1201807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
