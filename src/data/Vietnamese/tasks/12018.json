				"points": []
			},
			"dialogs": [
				{
					"id": 120181201,
					"content": "Miko, chúng tôi về rồi, mọi thứ đều rất thuận lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181202,
					"content": "Ồ, sao sao, đầu đuôi thế nào, kể khúc giữa tôi nghe với.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181203,
					"content": "Haha, thú vị thế, đường đường là Shogun đại nhân mà cũng có lúc trông như nhà quê lên tỉnh nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181204
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181204,
					"content": "Tiếc là tôi không hóng ngay tại trận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181205,
						120181206
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181205,
					"content": "Cô dám nói như vậy sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				},
				{
					"id": 120181207,
					"content": "Không sao đâu, cô ấy không để tâm chuyện này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181208,
					"content": "Nhưng mà, sự truy cầu \"vĩnh hằng\" của cô ấy có vẻ như có tiến triển rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181209,
					"content": "Đó là thu hoạch lớn nhất đó. Nói thật thì lúc tôi đưa giấy thông hành cho bạn, tôi cũng không ngờ là sẽ có kết quả này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181210
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181210,
					"content": "Ừm, có lẽ Ei sẽ không yêu cầu mọi thứ phải ngừng lại hoàn toàn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181211,
					"content": "Ừm, nói khó nghe chút thì ngay cả \"bảy vị chấp chính trần thế\" đôi khi cũng có những chuyện mà bản thân không thể vượt qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181212,
						120181213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181212,
					"content": "Ý bạn là nhân tâm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181214,
					"content": "Haha, đoán xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181215,
					"content": "Nghe các bạn kể cũng đủ biết chuyến đi này vui đến mức nào rồi, vậy chắc bạn cũng thấy được một phần nội tâm dễ tổn thương của Ei rồi đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181216,
					"content": "Sau này nếu muốn gặp cô ấy thì đến chỗ tôi lấy giấy thông hành nhé, tuy cô ấy không nói ra, nhưng Ei thực sự cô đơn lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181217,
					"content": "Hử? Nhưng Ei bảo không cần ai ở bên cạnh mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181218,
					"content": "Bởi vì cô ấy là thần, thần không phải không cần có người ở bên, chỉ là thứ đó quá xa xỉ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181219
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181219,
					"content": "Nhưng bạn không thuộc về thế giới này, nói không chừng sẽ là một lựa chọn tốt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181213,
					"content": "Ý bạn là Thiên Lý sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181206,
					"content": "Cô to gan thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				}
			]
		}
	]
}