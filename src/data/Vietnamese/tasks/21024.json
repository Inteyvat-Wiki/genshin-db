					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "Xem ra không có tác dụng gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240602,
					"content": "Xin hỏi bạn có thấy chiếc hộp nào không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "Hộp? Ồ tôi có nhặt được một chiếc hộp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240604,
					"content": "Tôi mở ra thì toàn là hóa đơn hàng, hơn nữa là một thương vụ làm ăn lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240605,
					"content": "Thật đáng tiếc khi không biết chủ nhân chiếc hộp là ai, có lẽ họ sẽ đồng ý bỏ ra số tiền lớn để chuộc lại món đồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240606,
					"content": "...Là sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "Bạn đừng có nóng, tôi chỉ đùa mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240608,
					"content": "Những món hàng trên hóa đơn không hề rẻ, không hiểu món đồ này thuộc về thương nhân nhiều tiền nào ở cảng Liyue đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240609,
					"content": "Tôi không phải là người không biết thời thế, tuy phải trả lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240610,
					"content": "Nhưng bạn cũng phải cho tôi chút tiền thù lao vì đã bảo quản những hóa đơn này. Chỉ nói một câu mà đòi lấy đi, thì e rằng không có dễ như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240611,
					"content": "Hay là như vậy đi, hai ta \"trao đổi bằng hiện vật\" vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240612,
					"content": "Tìm 3 viên \"Dạ Phách Thạch\" để đổi lấy đống hóa đơn này, thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240613,
					"content": "Xét cho cùng, giá trị thực của những hóa đơn này lớn hơn gấp nhiều lần... 3 viên \"Dạ Phách Thạch\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240614,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "Vậy thì bạn mau đi kiếm chúng đi. Rồi chúng ta tiến hành trao đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240616,
					"content": "...Phía trên ghi thương vụ mua bán gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "Bạn không biết sao? Bạn chỉ chạy việc cho người khác thôi sao... Hừm, vậy cũng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240619,
					"content": "Nghe tôi khuyên thật lòng, quy mô của thương vụ này tốt nhất đừng có tìm hiểu nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240620,
					"content": "Được rồi, bạn đi tìm \"Dạ Phách Thạch\" đi, tôi sẽ giao hóa đơn cho bạn, sau đó bạn mang cho người ủy thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240621,
					"content": "Giải quyết nhanh chóng không chút phiền hà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
