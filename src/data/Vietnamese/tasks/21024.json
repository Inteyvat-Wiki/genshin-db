			"dialogs": [
				{
					"id": 210240901,
					"content": "Bạn tìm thấy hóa đơn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240902,
					"content": "Tìm thấy hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "Cám ơn bạn, may mà không có vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240904,
					"content": "Nếu những đơn hàng này mà bị mất, ông chủ nhất định sẽ nổi cơn lôi đình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240905,
					"content": "Bạn muốn hỏi \"những hóa đơn này là thương vụ làm ăn\" gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240906,
					"content": "Xin lỗi, tôi không thể nói cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240907,
					"content": "Đây là tiền công, xin hãy nhận lấy... Nhưng mà chiếc hộp này từng bị mở ra rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240908,
					"content": "...Tôi từng gặp một người ở ngoài thành, cô ta nhặt chiếc hộp rồi mở ra xem rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240909,
					"content": "Xong rồi, thôi xong rồi! Không được... Phải mau nói cho ông chủ biết mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240910,
					"content": "Ồ, bạn yên tâm, tôi không nghi ngờ bạn đâu, sự tích về bạn tôi đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240911,
					"content": "Í! Tôi phải tìm cách liên hệ với ông chủ, bạn cứ bận việc khác đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Landa"
				}
			]
		},
