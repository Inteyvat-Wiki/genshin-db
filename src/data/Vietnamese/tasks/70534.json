			"dialogs": [
				{
					"id": 705340101,
					"content": "Thật sự không biết tại sao lại phải làm ra cả đống trò chơi nữa, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340102,
					"content": "Nhà Lữ Hành, làm tôi giật cả mình... Bạn cũng đến đây tham gia Giải Đấu Vua Triệu Hồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340103,
					"content": "Anh đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "À, đây là trò chơi nhỏ do một nhà mạo hiểm trong hiệp hội tự thiết kế, nói là biến thể mới của Thất Thánh Triệu Hồi kết hợp với chiến đấu, gọi là Chiến Thuật Đổ Xúc Xắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340106,
					"content": "Chúng tôi đang tổ chức Giải Đấu Vua Triệu Hồi, mà hiệp hội thì lại để mắt tới Chiến Thuật Đổ Xúc Xắc này, nên đã lấy để làm một sự kiện nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340107,
					"content": "Chơi bài và chiến đấu có thể kết hợp với nhau sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Hahaha, nói thật thì tôi cũng không hiểu lắm. Nhưng ở chỗ tôi có một cuốn sổ quy tắc... xem dày chưa này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340110,
					"content": "Nhưng theo hiểu biết của tôi, thì việc sử dụng \"xúc xắc\" chính là lối chơi cốt lõi của Chiến Thuật Đổ Xúc Xắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340111,
					"content": "Tóm lại, nếu bạn muốn chơi thì mời sang bên đây trải nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340108,
					"content": "Không thể tưởng tượng ra được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "Trò chơi gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
