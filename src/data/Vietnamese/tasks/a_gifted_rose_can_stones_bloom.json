			"dialogs": [
				{
					"id": 732060101,
					"content": "Các cháu đến rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060102,
					"content": "Hạt giống sao rồi ạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "Tất cả hạt giống đều chưa nảy mầm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060104,
					"content": "Ta đã kiểm tra bề mặt hạt giống, ngay cả một chút vết tích nảy mầm cũng không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060105,
					"content": "Vậy nguyên nhân rốt cuộc là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060106,
					"content": "Ta chắc chắn không lấy nhầm hạt giống, chúng đều được ta dựa theo nhật ký chép tay của quỷ già để lấy ra từ trong phòng dự trữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060107,
					"content": "Theo ghi chép của ông ấy, thời gian bảo quản hạt giống rất dài, chỉ cần đảm bảo khô ráo thì chúng sẽ không hỏng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060108,
					"content": "Cách vun trồng chắc cũng không có vấn đề gì, nước tưới và phân bón ta cũng không bỏ sót cái nào, rốt cuộc là vì sao lại vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060109,
					"content": "Đừng quá nóng ruột, ông Affan, chúng ta cứ chờ tiếp xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060110,
					"content": "#Mỗi lần cháu và {NICKNAME} đi hái hoa quả, sau khi hái xong cũng phải đợi mấy ngày chúng mới có thể mọc ra thêm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060111,
					"content": "Hãy kiên nhẫn thêm một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "Ôi, cũng chỉ có thể đợi xem sao thôi, hôm nay các cháu có rảnh không? Có thể giúp ta tưới cho chúng ít nước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060114,
					"content": "Ta vừa mới xới đất ở vườn ươm, làm lụng nửa ngày trời, giờ không còn sức lực chạy về lấy nước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060115,
					"content": "Cháu hiểu rồi ạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "Cảm ơn các cháu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060112,
					"content": "Tiếp tục tưới nước xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
