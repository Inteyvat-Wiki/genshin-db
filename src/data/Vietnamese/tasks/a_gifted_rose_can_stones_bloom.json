			"dialogs": [
				{
					"id": 732050501,
					"content": "♪Tường vi ơi tường vi, hãy thực hiện nguyện vọng của ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "Ối? Các cháu vẫn ở đây à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "Tại sao ông lại sống ở đây vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Haha, dù sao ta cũng là ông già kỳ quái, \"những việc của ông già kỳ quái làm thì đâu có lý do\", rất ít người giống cháu hỏi ta câu như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "Ta ấy à, cả đời này luôn muốn đi lang bạt, muốn nắm bắt cơ hội làm điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "Khi mới kết hôn không lâu, suýt nữa thì ta đã rời đi cùng Eremite, nhưng nghĩ đi nghĩ lại thì thấy không thể bỏ bà nhà để ra ngoài phiêu bạt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "Sau này gặp được dân buôn, ta lại muốn ra ngoài buôn bán, cuối cùng vì không đủ tiền vốn nên không đi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "Về sau bà nhà ta không còn nữa, ta không còn vướng bận gì, nhưng tuổi đã cao, không thể rời khỏi đây được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "Kéo dài dai dẳng mãi đến hôm nay, ta đã bỏ lỡ rất nhiều thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "Ngoảnh đi ngoảnh lại, nhận ra bản thân không thuộc về ngôi làng này, cũng không thuộc về bất cứ một nơi nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "Kết quả cuối cùng chính là, một mình ta chuyển ra ngoài rìa làng sinh sống mới thấy thoải mái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "Mấy chục năm trời cứ trôi qua như vậy, thôi cũng kệ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "Khi những hạt giống này nở hoa, ta sẽ gọi các cháu tới xem, ngày mai hoặc ngày kia, nói không chừng chúng sẽ nở, cháu có rảnh để ghé không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Được được, cháu biết rồi ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪Tường vi ơi tường vi, hãy thực hiện nguyện vọng của ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "Về quỷ già...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Cũng chỉ có người bên ngoài tới mới đi hỏi chuyện của quỷ già, trẻ con trong làng đều biết đến cái tên này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "Trẻ con nhà nào không nghe lời, cha mẹ của chúng sẽ hù dọa chúng: Quỷ già sắp đến bắt con đi rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "Những thanh niên ấy chẳng ai quen biết quỷ già, vậy mà rất biết cách lấy cái tên đó ra để dọa người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "Hồi còn nhỏ ta đã gặp quỷ già, ông ta đúng là ghét trẻ con, nhưng trông cũng không đáng sợ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "Không biết tại vì sao lại bị đồn thành quỷ già, ta thấy toàn là những người rảnh rỗi thích nói hươu nói vượn sau lưng người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "Hai người không phải là bạn của nhau sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "Khi ta còn nhỏ, thường hay đến gần vườn hoa nhỏ của ông ấy chơi, mỗi khi ông ấy phát hiện liền giơ cuốc lên đuổi ta đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "Ông ấy chắc chắn chỉ coi ta là một tên nhóc nghịch ngợm đi phá phách, chứ nào có nhớ ta là ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "Tuy không chắc ông ấy có biết ta không, nhưng ta vẫn luôn nhớ về ông ấy và vườn hoa nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "Ta nói ông ấy là bạn của ta, chắc cũng không tính là sai nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "Cứ coi như là để khôi phục lại vườn hoa nhỏ trong ký ức của ta, ta cũng sẽ trồng để cho những hạt giống hoa này nở rộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
