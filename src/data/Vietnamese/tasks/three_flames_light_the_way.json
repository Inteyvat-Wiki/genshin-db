			"dialogs": [
				{
					"id": 210080201,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080202
					]
				},
				{
					"id": 210080202,
					"content": "Vậy thì phiền bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080203
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080203,
					"content": "Có ba tháp canh trên con đường này và mỗi tháp có một lò lửa. Sau khi thắp sáng tất cả, trở lại đây và nói với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080204
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080204,
					"content": "Ở cuối con đường, có một Thất Thiên Thần Tượng. Bạn có thể hiến tế để nhận sự bảo vệ của Nham Vương Gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080205
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080205,
					"content": "Bất luận thế nào... việc này nhờ bạn rồi, khi tiện đường nhớ đi qua xem thử, đừng quên nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
