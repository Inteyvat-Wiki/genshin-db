				{
					"id": 210080401,
					"content": "Đường trên Quy Li Nguyên như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "Quy Li Nguyên là một đồng bằng đá, vì vậy ở một số con đường có núi đá gồ ghề, chẳng hạn như sườn dốc về phía tây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080403,
					"content": "Tuy nhiên, vị trí gần cửa biển ở phía đông rất bằng phẳng, có thời gian hãy đến bãi biển ở Dao Quang Đàm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
