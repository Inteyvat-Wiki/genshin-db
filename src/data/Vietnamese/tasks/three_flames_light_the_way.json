					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "Tại sao ngọn đuốc lại tắt rồi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080001,
					"content": "Ngọn đuốc sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "Ồ, thi ra là Nhà Lữ Hành... bạn tiến lên trước xem, có phải thấy ba đài quan sát không? Phía trên đó vốn đốt ngọn đuốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080003,
					"content": "Con đường ở Quy Li Nguyên rất khó đi, hơn nữa còn có nhiều quái vật ẩn náu. Ngọn đuốc một mặt là để chiếu sáng cho người qua lại. Mặt khác, cũng là dấu hiệu cho thấy không có mối đe dọa từ quái vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080004,
					"content": "Nhưng... tôi đang bận đi khắp nơi dọn sạch lũ quái vật, mà quên mất không thắp ngọn đuốc, đến khi phát hiện thì toàn bộ đã tắt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "Bạn tại sao không tự đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "Haiz, nếu có ai đó sẽ đến để kiểm tra tình trạng của những ngọn đuốc... Tôi vẫn có thể dành một chút thời gian ở đây để giữ chân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080103,
					"content": "Nếu bạn đứng ở đây, hoặc là ở đây vốn không có người, vậy thì thật tệ phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080104,
					"content": "Cho nên, năn nỉ bạn đó Nhà Lữ Hành! Mau đi đốt đuốc lên đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
			],
			"beginWay": "TALK_BEGIN_NONE",
