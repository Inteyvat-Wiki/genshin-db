			"dialogs": [
				{
					"id": 210080501,
					"content": "Bạn đồng hành của bạn ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "Sự việc là như vậy. Bạn đồng hành của tôi chịu trách nhiệm cung cấp nhiên liệu cho lò than và tôi chịu trách nhiệm đánh lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080503,
					"content": "Mặc dù nghe có vẻ nhỏ nhặt nhưng sự phân công lao động rõ ràng là điều rất quan trọng!",
