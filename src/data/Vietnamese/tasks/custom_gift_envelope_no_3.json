			"dialogs": [
				{
					"id": 715350401,
					"content": "#Ồ? Đúng là rất khéo léo đấy. Tấm thiệp chúc mừng này thực sự rất đẹp. Cảm ơn {F#cô}{M#cậu} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "#Tấm thiệp này coi như {F#cô}{M#cậu} tặng tôi. Giờ tôi không có gì quý giá cả, chờ khi nào về Sumeru tôi sẽ gửi quà đáp lễ sau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Tôi phải làm thêm một tấm khác. Khi Candace đến thì gửi cả chiếc vòng cổ và thiệp chúc mừng này, nhất định cô ấy sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Mà kể ra thì đã lâu lắm rồi, sao Candace còn chưa đến nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
