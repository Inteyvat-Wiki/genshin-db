			"dialogs": [
				{
					"id": 715350201,
					"content": "#{NICKNAME}, trùng hợp quá, cũng tới đón Tết Hải Đăng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350202,
					"content": "Cô đang làm thiệp chúc mừng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Đúng thế. Tôi muốn làm một tấm thiệp chúc mừng cho Candace, nhưng tôi vẫn chưa hài lòng, nên đang định làm một tấm mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350204,
					"content": "Candace không đến sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "Cô ấy muốn đến, nhưng mà... vẫn phải cần thêm một thời gian nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350206,
					"content": "Vốn dĩ cô ấy còn không đồng ý đến Liyue cùng tôi, nói là mình vẫn muốn canh giữ ngôi làng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350207,
					"content": "Tôi có nói với cô ấy là một năm đã qua, hãy để bản thân thư giãn một chút. Vừa hay tôi hộ tống một đoàn thương nhân đến Liyue, hay là đến Liyue cùng tôi để mừng Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350208,
					"content": "Nếu cô ấy lo lắng cho làng, tôi sẽ nhờ anh em trong đội giúp cô ấy canh giữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350209,
					"content": "Nhưng Candace không đồng ý. Cuối cùng người trong làng phải khuyên rất lâu, cô ấy mới đồng ý cho mình nghỉ phép.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350210,
					"content": "Nhưng cô ấy còn phải sắp xếp một số việc, đợi mọi thứ sắp xếp ổn thỏa thì mới đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350211,
					"content": "Cũng hết cách, đoàn thương nhân không đợi chúng tôi... Nên tôi đến Liyue trước và đợi cô ấy ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350212,
					"content": "Tôi muốn mua quà cho cô ấy trước, nhưng ở Liyue có quá nhiều thứ tốt, khiến tôi muốn hoa cả mắt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350213,
					"content": "Cuối cùng, tôi đã chọn một chiếc vòng cổ. Nghe nói trong Tết Hải Đăng, người dân ở Liyue luôn đính kèm một tấm thiệp chúc mừng với quà tặng của họ, nên tôi định tự thiết kế một tấm cho riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350214,
					"content": "Kết quả thì như đã nói đó, làm đi làm lại vẫn chưa hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350215,
					"content": "#Vừa hay {F#cô}{M#cậu} ở đây, hay là cho tôi vài gợi ý nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350216,
					"content": "Không thành vấn đề, để tôi nghiên cứu thử xem sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
