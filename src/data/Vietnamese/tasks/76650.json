			"dialogs": [
				{
					"id": 766500101,
					"content": "~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500102
					],
					"speakerTitle": "Cò Lông Dài"
				},
				{
					"id": 766500102,
					"content": "...Đây không phải là vấn đề bạn bè ít hay nhiều. Dù có gọi hết tất cả cò ở Đảo Hiisi đến, thì cũng không đủ để di dời Gương Mặt Trăng đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500103,
					"content": "Hơn nữa, dù có di dời nó đi, thì Tượng Ánh Trăng ở bên trong cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500104,
					"content": "!!!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500105
					],
					"speakerTitle": "Chồn Đạo Bảo"
				},
				{
					"id": 766500105,
					"content": "...Đào đi à? Chị e là nhóc cũng không thể dễ dàng dời tấm gương đó đi được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500106,
					"content": "♪♪♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500107
					],
					"speakerTitle": "Cò Lông Dài"
				},
				{
					"id": 766500107,
					"content": "Hả? Thực sự có thể gọi được tất cả cò ở Đảo Hiisi đến sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500108,
					"content": "Còn nhóc thì nghĩ dù cho cả gia tộc cùng ra tay thì cũng vô ích à...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500109,
					"content": "!!!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500110
					],
					"speakerTitle": "Chồn Đạo Bảo"
				},
				{
					"id": 766500110,
					"content": "Woa, náo nhiệt quá... Sao lại có một con Chồn Đạo Bảo và một con cò đang cãi nhau thế này...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500111,
						766500112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500111,
					"content": "Chẳng lẽ là hợp tác gây án?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				},
				{
					"id": 766500113,
					"content": "Nói đúng ra thì chúng tôi được coi là đang \"âm mưu gây án\" thôi, giờ đang thảo luận chi tiết kế hoạch đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500114,
					"content": "Chỉ có điều, cách mà đồng phạm của tôi nghĩ đến thì đều quá trực tiếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500115,
					"content": "♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500116
					],
					"speakerTitle": "Cò Lông Dài"
				},
				{
					"id": 766500116,
					"content": "Được rồi, chị biết bạn bè của nhóc đi khắp thiên hạ rồi. Rốt cuộc nhóc học được cách nói chuyện này ở đâu vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500118
					],
					"speakerTitle": "Cò Lông Dài"
				},
				{
					"id": 766500118,
					"content": "...Từ một cô gái thấp bé có cánh tay sắt và đội mũ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500119,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500120
					],
					"speakerTitle": "Cò Lông Dài"
				},
				{
					"id": 766500120,
					"content": "Nếu thích thì cứ nói như vậy cũng được, nhưng mà... khi nói chuyện với cô gái đó thì không cần học nhiều như vậy đâu, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500121
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500121,
					"content": "#Tiếp theo chị phải nói chuyện quan trọng với {NICKNAME} và Paimon, nên hãy yên lặng chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500122,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500123
					],
					"speakerTitle": "Cò Lông Dài"
				},
				{
					"id": 766500123,
					"content": "Chú chim yên lặng rồi kìa... Ôi, có thể nghe hiểu động vật tốt thật đấy, tôi cũng muốn có khả năng lợi hại này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500124,
					"content": "...Tin tôi đi, Paimon sẽ không thích loại năng lực này lắm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500125,
						766500126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500125,
					"content": "Giọng... Giọng điệu thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500127,
					"content": "Hiểu lầm rồi. Ý tôi không phải là loại năng lực này sẽ gây tai họa, hoặc khiến người ta bất an...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500128
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500128,
					"content": "Nhưng... thật ra cũng coi như khiến tôi cảm thấy bất an...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500129
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500129,
					"content": "Khi tôi phát hiện mình có thể nghe hiểu tiếng động vật, lúc đầu cũng rất vui, nhưng sau đó tôi đã phát hiện ra vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500130
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500130,
					"content": "Khả năng này có tác dụng mọi lúc mọi nơi, hơn nữa không nằm trong sự kiểm soát của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500131,
					"content": "Ừm... Đúng ha, tôi không để ý đến cái này đấy. Khả năng nghe hiểu tiếng động vật của Lauma không thể tự kiểm soát, vậy có nghĩa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500132,
						766500133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500132,
					"content": "Dù là trong rừng hay bên hồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500134,
					"content": "...Trước đây tôi từng nghe ai đó nói, trong rừng sâu nghe tiếng chim hót, sẽ cảm thấy rừng sâu vô cùng yên tĩnh, tâm trạng sẽ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500135
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500135,
					"content": "Nhưng, dù đi đến đâu, tôi cũng đều... không có cảm giác đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500136,
					"content": "Khi ở trong rừng, tôi vẫn nghe được tiếng trò chuyện của mèo hoang, thỏ, Hươu Sừng Lạnh, Lửng Áo Choàng, Cò Lông Dài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500137
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500137,
					"content": "Chúng đang lớn tiếng bàn luận xem ai đã phá hỏng tổ của ai, chất lượng cành cây ở đâu là tốt nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500138,
						766500139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500138,
					"content": "Đôi tai không lúc nào được rảnh rỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500140,
					"content": "Được, được thôi... Tôi không cần năng lực này nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500141,
					"content": "Cảm giác bị tiếng chim hót đánh thức vào buổi sáng cũng được thôi, nhưng... nếu bị đánh thức vì tiếng nói chuyện ồn ào, thì tâm trạng của tôi chắc chắn sẽ tệ lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500142,
						766500143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500142,
					"content": "Tiếng chim hót đâu có đánh thức nổi Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500144,
					"content": "Giờ thì... tôi đã quen rồi. Nếu sáng sớm mà không nghe thấy tiếng chim sẻ bàn luận về ly nước nhà ai thích hợp nhất để tắm, thì lại thấy không quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500145
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500145,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500146
					],
					"speakerTitle": "Chồn Đạo Bảo"
				},
				{
					"id": 766500146,
					"content": "#...Cảm ơn đã nhắc nhở, suýt nữa thì quên mất việc chính. Nhưng mà, nếu {NICKNAME} đã ở đây, có lẽ sẽ không cần dùng đến... cách thức trực tiếp như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500147,
						766500148
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500147,
					"content": "Bạn bè của tôi cũng ở khắp nơi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500149,
					"content": "#Không cần đâu, tôi chỉ cần mình {F#cô}{M#cậu} giúp là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500150
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500150,
					"content": "#Tôi tin là với sự thông minh của {F#cô}{M#cậu}, việc mở ra căn phòng bảo quản đóng kín do Vịnh Nguyệt Sứ đời trước tạo ra nhờ Gương Mặt Trăng... chắc chỉ là chuyện nhỏ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500151,
						766500152
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500151,
					"content": "Vịnh Nguyệt Sứ đời trước tạo ra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500153,
					"content": "#Yên tâm đi, chắc chắn không khó khăn gì với {F#cô}{M#cậu} đâu. Nào, chúng ta qua bên kia thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500152,
					"content": "Tôi yêu cầu được hướng dẫn tại chỗ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500148,
					"content": "Có lẽ sẽ mất chút thời gian để tập hợp lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
