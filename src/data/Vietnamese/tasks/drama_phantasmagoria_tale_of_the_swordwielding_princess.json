			"dialogs": [
				{
					"id": 790260101,
					"content": "Hoan nghênh! Hoan nghênh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260102,
					"content": "Hoan nghênh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260104,
					"content": "#Đây chính là {NICKNAME} tiếng tăm lẫy lừng sao! Còn có cả đồng đội tuyệt nhất là Paimon nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260105,
					"content": "Ồ! Sao anh biết tên của chúng tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260106,
					"content": "Khách quý trên đảo thì tôi đương nhiên phải biết rồi, bởi vì tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260107,
					"content": "Anh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260108,
					"content": "Tôi chính là Trưởng Đoàn Kịch Hoàng Hôn tiếng tăm lừng lẫy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260109,
					"content": "Hóa ra thật sự có người tự nhận là tiếng tăm lừng lẫy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "Tuy anh nói bản thân tiếng tăm lừng lẫy, nhưng chúng tôi chưa từng nghe qua tên anh nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260111,
					"content": "Không sao! Bây giờ hai bạn đã nghe rồi đấy thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260112,
					"content": "Sau khi trải qua khâu chuẩn bị kỹ lưỡng, vở kịch \"Chuyện Về Nữ Hoàng Mang Kiếm\" đã sắp biểu diễn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260113,
					"content": "Vở diễn tổng cộng có năm màn, mỗi màn chia làm hai phần trước sau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260114,
					"content": "Các vị khách quý tới đúng lúc lắm! Buổi diễn sắp bắt đầu rồi! Mời ngồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260115,
					"content": "Hậu trường còn chút việc phải làm, tôi xin phép rời đi trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				},
				{
					"id": 790260116,
					"content": "Vở diễn tâm huyết của Đoàn Kịch Hoàng Hôn sắp sửa khai mạc, xin mời thưởng thức!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Trưởng Đoàn Kịch Hoàng Hôn"
				}
			]
		}
	]
