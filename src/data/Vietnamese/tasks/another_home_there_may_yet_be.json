				},
				{
					"id": 130280102,
					"content": "Ngoài hai con Nấm Quỷ này ra thì tôi cũng có chút lo lắng cho doanh trại của Nấm Quỷ Phù Du Phong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
