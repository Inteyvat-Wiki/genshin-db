					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280103,
					"content": "Ừm, tôi cũng thấy vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280104,
					"content": "Tôi có cách này, hay là mang chúng về bên nhau, để cho chúng có thể sinh sống chung với nhau nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280105,
					"content": "Dù sao cả hai bên cũng từng có sinh vật nguyên tố hướng dẫn, nên việc hòa nhập sẽ dễ dàng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280106,
					"content": "Cũng đúng, dù sao cũng sẽ có thể giúp đỡ nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
