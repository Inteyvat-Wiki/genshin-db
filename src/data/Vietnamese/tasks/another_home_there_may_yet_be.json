			"dialogs": [
				{
					"id": 130280201,
					"content": "Sau khi đến doanh trại, hai con Nấm Quỷ đã được thu nhận.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130280202
					]
				},
				{
					"id": 130280202,
					"content": "Những con Nấm Quỷ ở đây hình như còn nhớ mặt chúng ta nên mới hiền hòa như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280203,
					"content": "Xem ra địa vị ở đây của sinh mệnh nguyên tố đó rất cao nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280204
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280204,
					"content": "Ấy, làm gì thế, muốn chơi với ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280205,
					"content": "♩~♩~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280206
					],
					"speakerTitle": "Nấm Quỷ Phù Du - Phong"
				},
				{
					"id": 130280206,
					"content": "#Được rồi, vậy {NICKNAME}, tôi đi chơi với chúng nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280207,
						130280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280207,
					"content": "Đi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				},
				{
					"id": 130280209,
					"content": "Có một chuyện tôi muốn xin lỗi, là lúc ở trong cơ thể của Apep, khi \"Mồi Lửa\" bị vỡ... Tôi còn muốn dùng hết sức mạnh của tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280210,
					"content": "Paimon đã nói cho bạn nghe chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280211,
						130280212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280211,
					"content": "Ừm, tôi rất lo lắng đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280213,
					"content": "Tôi vẫn chưa đủ bình tĩnh, lúc đó đáng lẽ tôi phải suy nghĩ thêm để đưa ra quyết định chu toàn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280214
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280214,
					"content": "Nhưng khi tôi nghĩ đến việc Thảo Long gặp nguy hiểm và sẽ khiến toàn bộ người dân ở Sumeru bị uy hiếp, thì tôi cảm thấy rất sợ hãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280215,
					"content": "Nếu việc làm được nhưng lại quyết định không làm, hoặc là nếu như làm không kịp thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280216
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280216,
					"content": "Sử dụng sức mạnh là chuyện đơn giản nhất, cũng là khó khăn nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280217
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280217,
					"content": "Nahida vẫn còn \"trưởng thành\" thêm mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280218
					]
				},
				{
					"id": 130280218,
					"content": "Ừm, tôi cảm thấy chúng đã dạy tôi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280219
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280219,
					"content": "Khi nghe câu ước muốn thành hiện thực, tôi có thể hiểu, nhưng vẫn không thể chấp nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280220
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280220,
					"content": "Đó rõ ràng là một chuyện khiến tôi cảm động, nhưng không hiểu sao âm thanh của nó lại nghe rất nhẹ nhàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280221
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280221,
					"content": "Tôi lại một lần nữa không thể thấu hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280222,
						130280223
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280222,
					"content": "Đây không phải là vấn đề của Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280224,
					"content": "Cảm ơn bạn đã an ủi tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280225
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280225,
					"content": "Chuyện cảm xúc thật sự phức tạp, xem ra tôi phải học tập thêm nữa mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280226
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280226,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280227
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280227,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280228
					],
					"speakerTitle": "Nấm Quỷ Phù Du - Thủy"
				},
				{
					"id": 130280228,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280229
					],
					"speakerTitle": "Nấm Quỷ Phù Du - Thủy"
				},
				{
					"id": 130280229,
					"content": "Không ngờ chúng lại biết cách chăm sóc ruộng vườn như vậy... Chắc là học theo con người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280230
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280230,
					"content": "Nếu như con Nấm Quỷ đó có thể mở miệng nói chuyện, nói không chừng đây là do ảnh hưởng của sức mạnh nguyên tố trong thời gian dài đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280231
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280231,
					"content": "Thời gian chính là sức mạnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280232
					]
				},
				{
					"id": 130280232,
					"content": "Đúng vậy, chúng ta không cần phải lo lắng cho hai sinh mệnh nguyên tố đó nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280233
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280233,
					"content": "Sau này doanh trại này cứ để cho tôi chăm nom, tôi sẽ thường xuyên đến đây theo dõi tình hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280234
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280234,
					"content": "Tôi hy vọng có thể lưu giữ lấy vết tích của chúng, để cho chúng có được cuộc gặp gỡ bất ngờ trong tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280235
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280235,
					"content": "Dẫu sao thì nó cũng đã nhớ ra được tên \"Nur\", chứng tỏ ký ức của nó đã quay trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280236,
						130280237
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280236,
					"content": "Tôi tin tưởng tình thân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280238,
					"content": "Ừm, vậy thì hãy xem nó như là một ước nguyện đẹp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280239
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280239,
					"content": "Nahida, Nấm Quỷ lại mang trái cây đến rồi, chúng ta cùng ăn nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280240,
					"content": "Được, tôi tới ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280237,
					"content": "Tôi tin tưởng kỳ tích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280223,
					"content": "Tôi cũng cảm thấy giống Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280212,
					"content": "Ừm, tôi rất giận đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280208,
