			"dialogs": [
				{
					"id": 751950201,
					"content": "Trời ơi, đây là... Đột nhiên xuất hiện người tốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "Tôi đang định mời một con Tatankasaur giúp đập vỡ những tảng đá trong mảnh đất hoang này và để sang một bên, nếu như có ma vật nào đó xuất hiện thì cũng tiện thể xử lý luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "Kết quả là còn chưa ra tay thì đã có người giúp tôi giải quyết hết rắc rối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "A, mỗi sáng thức dậy tôi đều phải bón phân cho cây ăn quả trước nhà, làm việc tốt như vậy cả đời, đây chính là phần thưởng mà thần linh dành cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "#Hỡi người tốt, hỡi sứ giả của thần linh! Dutta tôi xin cảm ơn sự hào phóng của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "#Tôi cũng chẳng có thứ gì tốt, chỉ có thể tặng {F#cô}{M#cậu} một ít Mora thôi. Còn một ít đồ không có tác dụng gì lắm, {F#cô}{M#cậu} cũng cầm lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
	]
}