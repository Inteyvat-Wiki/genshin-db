			},
			"dialogs": [
				{
					"id": 10293301,
					"content": "Ushi, ngươi nói xem có phải tên dưa tím lùn này đang ngủ không? Nó sẽ nằm mơ thấy gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293302,
					"content": "Moo? Moo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293303,
					"content": "Nhìn tên dưa tím này lúc nào cũng đòi ra oai, thế mà lại có lúc trông ủ rũ như vậy, hầy... tội nghiệp ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293304,
					"content": "Còn người bạn nhỏ kia nữa, trông có vẻ mệt mỏi lắm. Thật lo lắng quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293305,
					"content": "Moo moo moo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293306,
					"content": "Lúc ở phòng giam ta cũng ngủ như vậy mà? Ngươi chỉ giỏi nói linh tinh thôi. Tư thế ngủ của bổn đại gia chắc chắn là ngầu nhất thế giới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293307,
					"content": "#{NICKNAME}?! Ngươi tới từ khi nào thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
