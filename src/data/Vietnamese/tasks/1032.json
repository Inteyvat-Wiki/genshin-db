					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293202,
					"content": "Cô không sao chứ? Tự nhiên im lặng như thế, thật không giống cô lúc bình thường chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293203
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293203,
					"content": "Suỵt, lát nữa hãy nói, tôi đang sắp xếp lại tất cả manh mối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293204
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293204,
					"content": "Nói không chừng điểm đột phá nằm ở chi tiết nào đó mà chúng ta không để ý, phải kiểm tra lại một lần mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293205
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293205,
					"content": "Vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293206,
					"content": "À, yên tâm đi, những chuyện cô nói tôi sẽ không viết ra đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293207,
					"content": "Không phải. Ý tôi là muốn phân tích thì tính thêm cả tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
		{
