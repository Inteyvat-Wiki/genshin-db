			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "Xin chào! Tôi là thương nhân lữ hành Atefeh tới từ Sumeru, rất vui được làm quen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460102,
					"content": "Woa, tới từ nơi xa như vậy sao! Không ngờ danh tiếng cửa hàng của chúng ta đã vang xa như vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460103,
					"content": "May nhờ có Paimon đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "#Hihi, đang đứng trước mặt {NICKNAME} đây chính là Paimon, ngôi sao bán hàng mới nổi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460106,
					"content": "Haha, gần đây đúng là có không ít thương nhân tin tức nhanh nhạy đã nghe nói đến thuốc giả kim mà hai vị đang bán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460107,
					"content": "Loại hàng hóa hiếm thấy thế này, đa số mọi người đều không dám mạo hiểm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460108,
					"content": "Nhưng theo tôi thấy, muốn kiếm được nhiều thì phải biết đi trước đón đầu, nắm bắt cơ hội kinh doanh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460109,
					"content": "Mặc dù bây giờ mức độ hiểu biết của người bình thường về thuốc giả kim vẫn chưa cao lắm, nhưng chỉ cần kết hợp với phương pháp bán hàng, một khi phát triển được thị trường thì chắc chắn sẽ kiếm được rất nhiều Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460110,
					"content": "Nếu có thể xây dựng thương hiệu, nói không chừng giá bán còn có thể tăng gấp mười đó... Hihi, xong một vụ này là có thể nghỉ đến cuối năm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460111,
					"content": "Mười lần luôn sao! Cô nói thật chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460112,
					"content": "Haha, chỉ cần có người muốn mua thì dù giá bán có cao đến đâu cũng đều hợp lý cả. Người ta gọi là \"thuận mua vừa bán\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460113,
					"content": "Cách nói này làm tôi nhớ đến cái người trong đầu chỉ toàn nghĩ tới Mora đó đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460114,
					"content": "Mà này, nếu cô tới từ Sumeru, vậy chắc cũng có quen biết với Dori nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460115,
					"content": "Dori? Chẳng lẽ là đại nhân Sangemah Bay sao? Hai vị cũng quen biết với nhân vật lớn này ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460116,
					"content": "Cô ấy là bạn của tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "Thật lợi hại! Đại nhân Sangemah Bay là thần tượng của tôi đấy. Khả năng kinh doanh nhạy bén và tình yêu với Mora của cô ấy luôn khích lệ tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460119,
					"content": "Tôi từng may mắn ghé thăm Cung Điện Alcazarzaray, đó quả là một nơi hoành tráng và xinh đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460120,
					"content": "Rồi sẽ có một ngày tôi cũng giống như thế, có nhiều Mora đến mức đếm không xuể, hihi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460121,
					"content": "Ơ... Cô ấy đã hoàn toàn chìm đắm vào giấc mơ luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460122,
					"content": "Chúc cô thành công nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "#Cảm ơn lời chúc của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460126,
					"content": "Vậy chúng ta nói về cách cùng nhau kiếm được nhiều Mora đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460127,
					"content": "#Thật ra đơn giản lắm. Tôi sẽ định kỳ nhập hàng của {F#cô}{M#cậu}, còn {F#cô}{M#cậu} chỉ cần sản xuất ra loại thuốc cần thiết thôi. Rồi tôi sẽ đem bán cho những nơi khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460128,
					"content": "Nếu quyết định hợp tác thì chúng ta hãy nói cụ thể hơn về loại thuốc cần bán lần này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460129,
					"content": "Xem yêu cầu loại thuốc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "Theo giác quan thị trường nhạy bén của tôi thì lần này sẽ cần loại thuốc như vầy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460131,
					"content": "Để nói sau đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "Cơ hội kiếm Mora chỉ là vụt qua trong tích tắc thôi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460124,
					"content": "Chúng ta nói chuyện chính đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "À ừm, hơi lạc đề mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460117,
					"content": "Trước đây từng có giao thiệp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "Sự nỗ lực trong thời gian qua đã được đền đáp rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
