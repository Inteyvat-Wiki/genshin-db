			"dialogs": [
				{
					"id": 745140101,
					"content": "Lạnh... Lạnh quá, đúng là không nên tùy tiện ra ngoài gió mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140102,
					"content": "#Ủa? {NICKNAME}! Paimon! Là hai vị sao... Ách xì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140103,
					"content": "Asagiri? Sao cô lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "Cô có khỏe không? Sao lại đi một mình đến nơi xa như vậy thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745140105,
					"content": "Tôi... À.... Khỏe, khỏe nhiều rồi! Nhìn xem, tôi hết ho rồi nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140106,
					"content": "Haha... Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140107,
					"content": "Thật không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "Ối, đừng mà! Tôi thừa nhận, là tự tôi lẻn ra ngoài!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140110,
					"content": "Tôi... tôi cũng không còn cách nào khác. Suốt ngày ở trong Inazuma thì sao mà vẽ được tranh đẹp chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140111,
					"content": "Cứ cho là hai vị sẽ đi khắp nơi chụp hình giùm tôi đi, nhưng suy cho cùng thì cảnh trong hình sao mà chân thật được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140112,
					"content": "Cho nên, tôi đã nhờ một thầy đã từng hợp tác trước đây giúp tôi liên hệ với đoàn lữ hành để âm thầm đi du lịch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140113,
					"content": "Vậy là cô đã mang hết dụng cụ vẽ tranh theo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "Đương nhiên rồi! Bảng vẽ là linh hồn của tôi, sao tôi bỏ chúng lại được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140115,
					"content": "Hơn nữa, tranh của tôi bán rất chạy ở Fontaine, nhiều tác giả ở Fontaine đã nhờ tôi vẽ bìa cho tiểu thuyết của họ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140116,
					"content": "Nhưng mà... Họ lại không có thói quen chèn hình minh họa vào giữa tiểu thuyết. Thật không ngờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140117,
					"content": "#Phải rồi, đúng lúc gặp {NICKNAME} ở đây... {F#Cô}{M#Cậu} có sẵn lòng đi tìm kiếm thêm đề tài giùm tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140118,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "#Được! Có {F#cô}{M#cậu} phụ giúp là tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140123,
					"content": "Được rồi... Để tôi xem nào. Đúng lúc tôi nhận được bản thảo của vài tác giả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140120,
					"content": "Được thôi. Nhưng cô đừng chạy lung tung đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "Tôi biết rồi. Tôi không đối phó được với mấy cục sắt cơ khí kia đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140122,
					"content": "#Nói đến việc đối phó với chúng, thì tất nhiên chỉ có {F#cô}{M#cậu} là giỏi nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140108,
					"content": "Tôi phải viết thư về hỏi thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}