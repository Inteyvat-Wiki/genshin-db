			"dialogs": [
				{
					"id": 790510101,
					"content": "Ở đây có một cuốn nhật ký, có vẻ như được lưu giữ khá tốt nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510102,
					"content": "Phù... Thật là nhẹ nhõm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510103,
					"content": "Vướng mắc trong lòng vị họa sĩ đó đã được tháo gỡ, kỹ năng hội họa cũng được nâng cao, chắc chắn sẽ làm nên nghiệp lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510104,
					"content": "Có điều, sau cùng thì anh ấy vẫn rời đi, không còn ở bên những người bạn Giọt Nước Nhỏ này nữa, tôi thấy có chút tiếc nuối đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510105,
					"content": "Có lẽ người nghệ sĩ không thể chấp nhận tác phẩm mô phỏng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Ừm, âu cũng là chuyện dễ hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510108,
					"content": "Có một điểm chưa rõ, anh ấy đề cập đến bức bích họa mà mình để lại đã bị thay đổi hình dạng và vị trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510109,
					"content": "Nhưng dù có là sự cố nghiêm trọng như vừa rồi thì bức bích họa vẫn không lệch vị trí mấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510110,
					"content": "Vấn đề nằm ở những Giọt Nước Nhỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "Ra là vậy! Hèn chi Giọt Nước Nhỏ rất quen thuộc với Đèn Chiếu và sửa chữa bích họa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510113,
					"content": "Cảm động thật, Giọt Nước Nhỏ tuy trông không thông minh, nhưng lại rất ân cần và trung thành. Đúng là người bạn trung thành mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790510111,
					"content": "Chúng đã bảo vệ bức bích họa của người bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Giữ vững sự độc nhất của bản thân cũng hợp tình hợp lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
