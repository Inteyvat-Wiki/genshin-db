			"dialogs": [
				{
					"id": 111240101,
					"content": "Bia đá này được Lí Thủy Điệp Sơn Chân Quân lập ra. Trên bia khắc rằng Azhdaha là ác long, để nhắc nhở người đời sau hãy tránh xa nơi phong ấn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240102,
					"content": "Đáng tiếc...thiện và ác chỉ cách nhau trong gang tấc. Nếu sự thiện ác của hắn có thể dễ dàng nói rõ, thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240103,
					"content": "(Lặng nhìn Zhongli đang đứng dưới tán cây...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "(Trong bầu không khí yên tĩnh, chỉ có tiếng gió xào xạc. Thời gian dường như hóa thành dòng sông vô hình, lặng lẽ chảy bên mình...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240105,
					"content": "(Một khoảnh khắc thoáng qua, một nghìn năm nơi trần thế. Đá cũng có trái tim, đương nhiên đại địa và thần cũng thế.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
