			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "#...Meo. Kiếm thuật của {F#cô}{M#cậu}... cực kỳ ấn tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Tiểu Thư Mèo Cam"
				},
				{
					"id": 762140209,
					"content": "Cảm ơn kỵ sĩ phương xa đáng kính. Những kẻ hung ác ngạo mạn và hùng mạnh đó sẽ không còn quấy nhiễu quê hương của con dân tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Tiểu Thư Mèo Cam"
				},
				{
					"id": 762140210,
					"content": "Vậy thì, xin hãy nói đi. Vì sao lại đến vương triều của tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Tiểu Thư Mèo Cam"
				},
				{
					"id": 762140202,
					"content": "Vương triều?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Ừm... Đã là truyện cổ tích, đây chắc cũng là một phần của bối cảnh nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "Chuyển lời mời tiệc trà của ngài Mèo Xám đến tiểu thư Mèo Cam...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Tiểu Thư Mèo Cam"
				},
				{
					"id": 762140208,
					"content": "#...Tôi hiểu rồi. Cảm ơn kỵ sĩ phương xa đáng kính. Vậy thì, tôi sẽ nghe theo lời tâu chân thành của {F#cô}{M#cậu} mà lên đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu Thư Mèo Cam"
				},
				{
					"id": 762140204,
					"content": "Thưa vương thượng, cho phép thần báo cáo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "Nhập vai nhanh thật đấy! Khụ khụ, nếu đã là một phần của kịch bản...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
