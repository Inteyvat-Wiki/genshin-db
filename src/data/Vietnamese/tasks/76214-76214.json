			"dialogs": [
				{
					"id": 762140101,
					"content": "Meo... Đã đến giờ tiệc trà rồi, meo. Không biết họ có bị lạc đường không nhỉ, meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Ngài Mèo Xám"
				},
				{
					"id": 762140102,
					"content": "#Ồ, hỡi lữ khách tóc vàng, {F#cô}{M#cậu} chắc chắn là dũng sĩ được chọn, meo! Có thể giúp tôi tìm hai người bạn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Ngài Mèo Xám"
				},
				{
					"id": 762140103,
					"content": "Bạn của ngươi là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Còn hai vị tiểu thư chưa tới. Một là cô mèo biết nói như tôi, nhưng là mèo cam, meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Ngài Mèo Xám"
				},
				{
					"id": 762140107,
					"content": "Còn lại là một cô Chó Duyên Dáng cực kỳ lịch sự, tuy là chó nhưng rất dịu dàng, meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Ngài Mèo Xám"
				},
				{
					"id": 762140108,
					"content": "Dù một bên là mèo, một bên là chó, nhưng chỉ cần có thể ngồi lại cùng nhau uống trà, tất cả nhất định đều sẽ rất vui vẻ, meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Ngài Mèo Xám"
				},
				{
					"id": 762140109,
					"content": "Vì hòa bình của Meouranopolis, xin hãy giúp tôi, meo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ngài Mèo Xám"
				},
				{
					"id": 762140104,
					"content": "Tiêu chuẩn về dũng sĩ tùy tiện quá rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "Đừng để ý những thứ đó, meo. Dù không có thanh kiếm thần thánh trong truyền thuyết, hay không tìm được Ly Nước Trong trong truyền thuyết, dũng sĩ vẫn là dũng sĩ, meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Ngài Mèo Xám"
				}
			]
		},
