			"dialogs": [
				{
					"id": 762140301,
					"content": "Gâu gâu? Có chuyện gì thế, lữ khách tóc vàng? Có việc gì tôi giúp được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Tiểu Thư Chó Duyên Dáng"
				},
				{
					"id": 762140302,
					"content": "Chuyển lời mời tiệc trà của ngài Mèo Xám đến tiểu thư Chó Duyên Dáng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "Ơ? Đã đến giờ này rồi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Tiểu Thư Chó Duyên Dáng"
				},
				{
					"id": 762140304,
					"content": "#Cảm ơn {F#cô}{M#cậu}! Gâu gâu, nếu không phải vì quá bận, tôi đã tự đi mời tiểu thư Mèo Cam rồi... Như vậy thì chắc ngài Mèo Xám cũng sẽ không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Tiểu Thư Chó Duyên Dáng"
				},
				{
					"id": 762140305,
					"content": "#Dù là mèo hay chó đều có thể chung sống hòa bình... Nhất định là được mà. Nói chung, giờ tôi sẽ đi tham gia tiệc trà ngay, cảm ơn {F#cô}{M#cậu} đã nhắc nhở!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu Thư Chó Duyên Dáng"
				}
			]
