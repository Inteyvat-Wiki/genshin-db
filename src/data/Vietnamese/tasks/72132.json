					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "Cảm ơn sự cố gắng của bạn, mặc dù chiến tranh vẫn chưa kết thúc, trên đảo vẫn còn nhiều nguy hiểm, nhưng may nhờ có bạn, những người xa quê hương ít nhiều đã có chút hy vọng trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "Mặc dù mưa đã tạnh, hai bên giao chiến có thể sẽ tích cực tiến quân hơn để chiếm lợi thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "Nhưng tình hình trên đảo, nếu họ không thể thay đổi, tất cả những gì chúng ta làm ít nhất vẫn còn tốt hơn bỏ mặc tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Vậy thì, quà cảm ơn hôm trước nói với bạn đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "Đây là ngọn thương danh tiếng được dùng bởi vị đại nhân bảo vệ Yashiori vài trăm năm trước... tôi không rõ bức vẽ này có ích với bạn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "Nhưng nếu như mang nó cho thợ rèn lành nghề thì có thể sẽ tái hiện được tư thế hiên ngang của đại nhân Kitain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "Haiz, thời này đã không còn là thời đại của anh hùng nữa rồi, vị đại nhân Kitain cũng sẽ không quay về nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Nhưng cũng may nhờ có bạn giúp đỡ, chúng tôi mới có thể... tiến gần hơn tới sự nghiệp của đại nhân Kitain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "Bây giờ tôi sẽ đến chỗ một người bạn thuộc Quân Shogunate xem có giúp được gì không, hy vọng sẽ có cơ hội gặp lại bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
