			"dialogs": [
				{
					"id": 100040101,
					"content": "Mona! Chúng tôi đến tặng quà cho cô đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040102,
					"content": "#Ah, Paimon và {NICKNAME} đấy à? Trông cũng phấn chấn đấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040103,
					"content": "Định tặng tôi thứ gì vậy? Nếu là mấy công việc đơn giản mà kiếm tiền nhanh thì còn gì bằng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040104,
					"content": "Hình như là... \"bài tập\" mà giáo viên giao cho cô thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040105,
					"content": "Mấy thứ đó tôi chẳng thèm đâu! À không, có lẽ cũng không nên nói vậy. Con người thì vẫn nên giữ tinh thần cầu tiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040106,
					"content": "Nhưng tôi thấy, chắc chắn là thứ gì đó khiến người ta thêm phiền phức thôi. Tôi quá hiểu bà già đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040107,
					"content": "Hay là cô cứ xem thử trước đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040108,
					"content": "Cuốn sách này... hình như cũng chẳng có gì đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040109,
					"content": "Ồ, có vài lá thư rơi ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040110,
					"content": "Là thư hòa giải à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040111,
					"content": "Có ba lá thư được đánh số thứ tự. Ừm, mở lá thư đầu tiên trước vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040112,
					"content": "Nếu đây là một bài tập thì chắc cũng không có gì phải giấu. Cùng xem thử nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040113,
					"content": "\"Lâu rồi không gặp học trò, chân cẳng của ta ngày càng yếu đi rồi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040114,
					"content": "Hừm, chiêu bài tình cảm à. Ít nhất cũng nên thể hiện chân thành hơn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040115,
					"content": "\"Hồi trước ta đuổi theo đánh con, con vừa chạy vừa dùng ảo ảnh Thủy để đánh lạc hướng, cảnh tượng đó ta vẫn còn nhớ rõ mồn một.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040116,
					"content": "\"Giờ con không còn ở đây nữa, cả ngày ta chỉ nằm trên ghế xích đu. Đúng là thiếu vận động thật.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040117,
					"content": "Bà... già... khọm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040118,
					"content": "Hay là chúng ta đừng xem nữa nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100040119
					]
				},
				{
					"id": 100040119,
					"content": "\"Thôi không nói chuyện phiếm nữa. Con có muốn biết cách tính toán vận mệnh của vương quốc hay thậm chí là cả thế giới không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040120,
					"content": "\"Đến Sumeru đi, tìm kiếm cánh cổng dẫn đến vương quốc dưới lòng đất. Sau đó hãy mở bức thư thứ hai tại đó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040121
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040121,
					"content": "Có vẻ cách dụ dỗ của bà già lại hoàn thiện hơn rồi. Xem ra bà già sắp dạy cho tôi tuyệt chiêu bí truyền đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040122,
					"content": "Bà già đó đúng là đã già rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040123,
					"content": "Mối quan hệ thầy trò của hai người thật kỳ lạ. Nói đến chuyện tình cảm thì cãi nhau, nói đến học thuật thì lại thành ra thương cảm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040124,
					"content": "Nhưng mà cánh cổng dẫn đến vương quốc dưới lòng đất ở Sumeru... chẳng lẽ là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040125,
					"content": "Sao vậy, hai ngươi có manh mối gì à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040126,
					"content": "Có lẽ chúng tôi biết nơi mà sư phụ của cô nhắc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040127,
					"content": "Tuyệt vời, như vậy tôi sẽ tiết kiệm được thời gian điều tra rồi. Tương đương với việc gián tiếp tiết kiệm chi phí hướng dẫn viên, phí ăn ở, là một khoản tiền lớn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040128,
					"content": "Tôi không thể đợi thêm giây phút nào nữa. Chúng ta mau lên đường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040129,
					"content": "Lúc nãy cô không nhắc đến tiền đi lại, chẳng lẽ là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040130,
					"content": "Đúng vậy, vẫn dùng cách cũ thôi. Cùng đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
