							6035.06
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "Phù, dùng cách thức đầy hoài niệm về mùa hè để đến đây, cũng thấy người sảng khoái hẳn ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040202,
					"content": "Đây chính là cánh cổng dẫn đến vương quốc Khaenri'ah cổ đại dưới lòng đất sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040203,
					"content": "Chắc hẳn đằng sau nó ẩn chứa rất nhiều bí mật và nỗi buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040204,
					"content": "Xem thử lá thư thứ hai nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040205,
					"content": "Ừm, để xem nào. Phong thư có đánh dấu thứ hai... À, là cái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040206,
					"content": "\"Sumeru có câu cổ ngữ: Giải kinh tụng sách chẳng thấy đạo, sau cần thủy trí giải khô khan. Trên vùng đất này có một hiện tượng gọi là 'Thiên Tượng Apaosha'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040207,
					"content": "\"Tuy nhiên, Thiên Tượng Apaosha chỉ là kết quả của việc khao khát chân lý quá mức, cuối cùng đã bùng cháy thành ngọn lửa. Gọi nó là 'khát chân lý' có lẽ sẽ phù hợp với bản chất hơn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040208,
					"content": "\"Theo ghi chép của vương quốc ngầm cổ xưa, những hồ gương dưới lòng đất của Khaenri'ah đều phản chiếu biển sao của vũ trụ chân thực.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040209,
					"content": "\"Đó là bởi vì, nước đã khai mở 'Khát Chân Thiên Tượng' vượt qua cả bầu trời hư ảo, kết nối với vũ trụ bên ngoài.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040210,
					"content": "Thì ra là vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040211,
					"content": "\"Chỉ khi xuyên qua bầu trời hư ảo, lực hút và ảnh hưởng của các thiên thể vũ trụ mới có thể được quan sát. Chỉ khi có được những tham số từ bên ngoài, mới có thể tính toán được vận mệnh của thế giới.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040212,
					"content": "\"Hiện tại, nhiệm vụ ta giao cho con là: Khai mở 'Khát Chân Thiên Tượng' trước cổng Khaenri'ah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040213,
					"content": "Phía sau là nghi thức và phương pháp mà bà già đã tính toán ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040214,
					"content": "Đúng vậy. Mấy quỹ đạo hành tinh và họa tiết này tôi hoàn toàn không hiểu gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040215,
					"content": "Mona muốn thử ngay bây giờ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040216,
					"content": "Tuy không muốn thừa nhận, nhưng tôi đã tính nhanh trong đầu các tham số nghi thức mà bà lão đã phát triển, có vẻ thực sự khả thi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040217,
					"content": "Giờ tâm trạng tôi có hơi phấn khích, tinh thần rất hăng hái. Hơn nữa nếu quay về thì lại mất thêm một ngày tiền phòng. Không làm bây giờ thì còn đợi đến bao giờ nữa. Tôi bắt đầu đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040218,
					"content": "Hỡi những sứ giả của muôn vàn hằng tinh, những người ngao du giữa hoàng đạo xích đạo, và những anh em của ánh sáng trời cao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040219,
					"content": "Hố sâu hư không, cung đường quanh co. Ta, Astrologist Mona Megistus, tại nơi đây, dùng sức mạnh của nước để cân bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040220,
					"content": "Dùng trí tuệ và chân lý để xoa dịu cơn khát. Ta, Astrologist Mona Megistus, lệnh cho những chòm sao xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040221,
					"content": "Thành công rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040222,
					"content": "Ối, sao lại xuất hiện nhiều quái vật thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040223,
					"content": "Hình như chưa hoàn toàn thành công. Xét về kết quả thì nó chỉ mở ra trong thoáng chốc, rồi đám quái vật này đã vượt qua 'Khát Chân Thiên Tượng' mà đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040224,
					"content": "Aaaah, tức quá đi. Chưa kịp nhìn thấy bầu trời sao thực sự nữa, để ta trút giận lên các ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
