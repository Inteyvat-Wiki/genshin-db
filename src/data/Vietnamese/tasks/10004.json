			"dialogs": [
				{
					"id": 100040601,
					"content": "Phù, cuối cùng cũng giải quyết xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040602,
					"content": "Bà già có nhắc đến việc mở bức thư thứ ba sau khi kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040603,
					"content": "Nhưng tôi chưa thành công, vậy thì có nên mở ra không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040604,
					"content": "Tôi cảm thấy mình đã hiểu được lối suy nghĩ của thầy trò hai người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040605,
					"content": "Nhìn xem, sư phụ cô chỉ nói kết thúc thôi, chứ có nói là phải thành công đâu. Nên tôi nghĩ mở ra cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040606,
					"content": "Đúng vậy. Tôi cảm thấy chắc bà già cũng chẳng viết điều gì tốt đẹp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040607,
					"content": "\"Nếu con đọc được câu này, chứng tỏ là đã thực sự thử rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040608
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040608,
					"content": "\"Không đúng, con thực sự dám thử mở nó ra hả? Hahahaha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040609
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040609,
					"content": "Bà... già... khọm!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040610,
					"content": "\"Khaenri'ah từng tồn tại rất nhiều hồ biển sao, nên không gian khá thiếu ổn định. Vì vậy, việc xuyên qua màn chắn bầu trời bằng phương pháp phi vật lý sẽ dễ thành công hơn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040611
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040611,
					"content": "\"Hơn nữa, nơi đó khá kín đáo và nằm sâu dưới lòng đất, ít người lui tới. Nếu có thất bại thì những ảnh hưởng xấu cũng khó lan truyền.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040612
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040612,
					"content": "\"Là đệ tử của ta, ta tin rằng con sẽ xử lý được những sinh vật Vực Sâu đang lang thang trong thế giới bên ngoài bầu trời giả tạo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040613
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040613,
					"content": "\"Không đánh lại thì chắc con cũng sẽ chạy thoát được thôi. Khả năng chạy trốn của con cũng khá lắm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040614
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040614,
					"content": "\"Ôi, mình đúng là thiên tài mà. Bầu không khí Thủy Chiêm Tinh đã đối ứng với trí tuệ giải tỏa cơn 'Khát'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040615
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040615,
					"content": "\"Về mặt ứng dụng thực tế, bàn bói nước cũng làm giảm nhiễu loạn của bầu trời giả. Không biết Alice lấy gì ra để thắng ta đây...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040616
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040616,
					"content": "Mona nói không cần xem nữa, vài nghìn chữ sau đó toàn là mấy lời tự khen của bà già thôi.\\n\\nSau khi hoàn tất việc sắp xếp kết quả quan sát, mọi người đã quay về Mondstadt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}