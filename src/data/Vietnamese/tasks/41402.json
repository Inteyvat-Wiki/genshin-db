			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "Nhà Lữ Hành xin hãy dừng bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020202,
					"content": "Có chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "Tuy có chút đường đột... nhưng cho hỏi bạn có thích máy ảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020204,
					"content": "Có một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "Ây, máy ảnh của tôi không phải loại tầm thường đâu, nó là kỹ thuật mới nhất của Fontaine đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020207,
					"content": "Bức ảnh được in ra từ chiếc máy này có màu sắc khác biệt mà máy ảnh bình thường không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020208,
					"content": "Làm sao làm được như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "Ầy! Bạn không tin tưởng gì hết, nếu không tin, hãy đến Hiệp Hội Nhà Mạo Hiểm hỏi thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020211,
					"content": "Trước đây tôi cũng không tin, loay hoay với nó cả buổi cũng không xong, may là một nhà mạo hiểm trong hiệp hội đã giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020212,
					"content": "Chiếc máy ảnh này khác với loại máy thông thường ở một kết cấu nhỏ trong máy móc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020213,
					"content": "Tra một loại thuốc đặc biệt vào kết cấu này sẽ giúp bức ảnh in ra có chất lượng đặc biệt, đẹp hơn rất nhiều so với máy ảnh bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020214,
					"content": "Thế nào? Nếu thích, bạn cứ lấy cái này chơi thử. Thuốc trong máy tuy không nhiều nhưng vẫn đủ cho bạn trải nghiệm thử đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020215,
					"content": "Sau này tôi còn nhập một đợt thuốc mới từ Fontaine, nếu bạn có hứng thú, thì hoan nghênh đến xem nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020216,
					"content": "À... cám ơn nha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "Chiếc máy này tặng cho bạn dùng đó, nếu thấy tốt, sau này hãy nhớ ủng hộ tiệm của tôi nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020217,
					"content": "Số thuốc đó bao nhiêu tiền?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "Ừm... thì... khụ, bạn đừng lo, một lọ rẻ lắm. Nếu bạn muốn mua nhiều, thì có thể thương lượng giảm giá một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020209,
					"content": "Phải không đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "Không thích...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
