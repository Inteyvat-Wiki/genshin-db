				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "Được rồi, chiếc máy ảnh này tặng bạn đó, nhận lấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020302,
					"content": "Chiếc máy ảnh này... tặng tôi hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "Số thuốc này cũng đủ cho bạn dùng một khoảng thời gian, nếu dùng hết... bạn có thể tìm đến tôi để mua mà, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020305,
					"content": "Hơn nữa tôi còn chuẩn bị đi tìm người đó, nhập thêm nhiều loại thuốc nữa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020306,
					"content": "Nếu sau này có hứng thú, hoan nghênh bạn đến chỗ tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020307,
					"content": "Ây da... không ngờ mua máy ảnh lại mua được một kèo buôn bán ngon lành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020303,
					"content": "Nếu dùng hết loại thuốc đó thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}