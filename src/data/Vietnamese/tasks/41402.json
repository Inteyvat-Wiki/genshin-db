				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "Ôi, bạn đến rồi, vừa hay tôi có chuyện muốn nói với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020102,
					"content": "Có chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "Không cần nữa không cần nữa, tôi đã tìm được nguyên nhân rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020105,
					"content": "Mấy ngày trước tôi đã tìm được người bán chiếc máy ảnh này cho tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020106,
					"content": "Tôi nói máy ảnh của anh ấy có vấn đề, nhưng anh ấy không chịu tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020107,
					"content": "Cũng nhờ trước đó bạn đã giúp tôi chụp rất nhiều ảnh, nếu không có nhiều ảnh như vậy, thì tên đó chắc sẽ không chịu thừa nhận đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020108,
					"content": "Có số ảnh mà bạn chụp giúp, anh ấy mới đồng ý kiểm tra lại lô máy ảnh đã bán cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020109,
					"content": "Hôm qua anh ấy vừa mang một lọ thuốc gì đó cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020110,
					"content": "Anh ấy nói kết cấu của máy ảnh này khác với những chiếc máy bình thường, cần phải tra ít thuốc vào động cơ, thì ảnh in ra mới đặc biệt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020111,
					"content": "Nếu không tra loại thuốc này vào thì sẽ giống với loạt ảnh mà bạn đã chụp hôm trước, chỉ có màu chứ không sắc nét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020112,
					"content": "Máy ảnh không sao là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Ừm, có thể nói như vậy, nhưng tôi có hứng thú với loại thuốc này hơn là chiếc máy ảnh đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020115,
					"content": "Bạn nghĩ đi, đa số mọi người chỉ mua một chiếc máy ảnh đúng không? Mua một lần là dùng được mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020116,
					"content": "Nhưng loại thuốc này dùng sẽ phải hết, nếu muốn dùng tiếp phải tiếp tục mua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020117,
					"content": "Vả lại người đó cũng nói, tùy theo từng loại thuốc mà chất lượng ảnh cũng khác nhau. Bên chỗ anh ấy cũng đang nghiên cứu thêm nhiều loại thuốc nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020118,
					"content": "Có lẽ... loại thuốc đó mới chính là mối làm ăn lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020119,
					"content": "Khụ, xin lỗi, tôi cứ tự mình nói mãi không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020120,
					"content": "Cám ơn bạn đã giúp đỡ, đưa máy ảnh cho tôi nào, tôi tra thuốc vào cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020113,
					"content": "Vậy là ổn cả rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "Hôm nay cần chụp đồ có màu sắc mạnh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
