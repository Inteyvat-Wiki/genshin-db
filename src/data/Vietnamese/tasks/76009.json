			"dialogs": [
				{
					"id": 760090601,
					"content": "Woa, dự cảm của em quả nhiên là đúng! Chỉ cần đặt hai viên đá lại gần nhau là sẽ xảy ra chuyện vô cùng ghê gớm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090602
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090602,
					"content": "Ừm, nhưng như vậy thì viên đá vừa tìm được cũng mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090603,
					"content": "Ơ? Không sao đâu. Chị Paimon quên rồi à? Ban đầu em muốn tìm mảnh vỡ chỉ là để mua chuộc May...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090604
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090604,
					"content": "Nếu đã có \"câu chuyện\" về viên đá đột nhiên bay đi, vậy thì bản thân viên đá không còn quan trọng nữa. Dù sao thì, May giỏi kể chuyện như vậy, chắc chắn cũng sẽ thích những câu chuyện mới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090605
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090605,
					"content": "#Vậy cảm ơn hai người nhé, {M#anh}{F#chị} {NICKNAME} và chị Paimon! Tuy quá trình không giống như em nghĩ, nhưng vẫn cảm ơn hai người đã giúp đỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090606
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090606,
					"content": "#Đúng rồi, đây là viên đá em vừa tìm được! Vì cũng rất đẹp nên em sẽ tặng cho {M#anh}{F#chị} {NICKNAME} để làm quà cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kasha"
				}
			]
