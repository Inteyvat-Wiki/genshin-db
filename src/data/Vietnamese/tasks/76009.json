			"dialogs": [
				{
					"id": 760090101,
					"content": "#Cảm ơn {M#anh chị}{F#hai chị} đã tốt bụng! Giá mà tìm được những <color=#00E1FFFF>viên đá đẹp</color> ở quanh đây nhỉ...",
					"roleType": "TALK_ROLE_NPC",
