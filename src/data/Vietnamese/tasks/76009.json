			"dialogs": [
				{
					"id": 760090501,
					"content": "Chúng tôi về rồi đây! Kasha, em xem thứ này có được tính là một viên đá xinh đẹp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090502,
					"content": "#Wow, nhanh quá! {M#Anh}{F#Chị} {NICKNAME} không hổ là nhà mạo hiểm chuyên nghiệp, thật lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090503
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090503,
					"content": "Hì hì, chuyện nhỏ này dễ như trở bàn tay thôi. Đâu phải bảo chúng tôi chui vào hang động sâu mấy trăm mét, hay là đi đến những nơi cách xa vài nghìn mét để chụp ảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090504,
					"content": "Ừm... ừm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090505
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090505,
					"content": "Ủa, sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090506,
					"content": "Ừm... tuy đúng là một viên đá rất xinh đẹp, nhưng em cứ cảm thấy hình như nó đang bị tảng đá lớn này thu hút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090507
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090507,
					"content": "Hả? Sao tôi hoàn toàn không cảm nhận được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090508,
					"content": "Em cũng không rõ lắm... chỉ là một dự cảm mơ hồ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090509
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090509,
					"content": "Giống như... May cũng đã nói, Reed Miller cũng chính nhờ cảm nhận được sự dẫn lối của Nguyệt Thần, nên mới gặp được công chúa fae. Dự cảm của em hẳn cũng là thứ tương tự nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090510
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090510,
					"content": "Ồ ồ! Đây chính là khả năng tiên tri tương lai trong truyền thuyết... Không đúng, Nguyệt Thần đại nhân chắc cũng không rảnh rỗi đến thế đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090511,
					"content": "Vậy... dự cảm của em bảo em làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090512,
					"content": "Ừm... ví dụ như, đặt viên đá này, về lại đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090513
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090513,
					"content": "#Tuy em không còn là trẻ con nữa, nhưng vẫn không với tới được chỗ cao như vậy... {M#Anh}{F#Chị} {NICKNAME}, có thể giúp em thử một chút không?",
