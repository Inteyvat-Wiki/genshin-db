					"Kasha"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1758.865,
							223.864,
							10442.06
						],
						"pointId": 11130
					},
					{
						"sceneId": 3,
						"position": [
							1759.742,
							223.758,
							10440.77
						],
						"pointId": 12560
					},
					{
						"sceneId": 3,
						"position": [
							1760.837,
							223.823,
							10442.14
						],
						"pointId": 12561
					}
				]
			},
			"dialogs": [
				{
					"id": 760090201,
					"content": "Ừm... hình như cũng không phải là mảnh này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090202
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090202,
					"content": "#A, chào hai người, người {M#anh}{F#chị} chưa từng gặp, và... ừm, tinh linh trắng trẻo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090203
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090203,
					"content": "#Chào mừng {M#anh chị}{F#hai chị} đến với Sương Nguyệt Phường! Có cần giúp gì không ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090204
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090204,
					"content": "#Không không, chỉ là thấy em một mình ở đây nên hơi tò mò thôi. Nhân tiện, tôi là Paimon, còn đây là {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090205,
					"content": "#Ừm ừm, vậy là {M#anh}{F#chị} {NICKNAME} và chị Paimon! Xem ra, hai người không phải là người ở Thị Trấn Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090206,
						760090208
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090206,
					"content": "Chúng tôi là nhà mạo hiểm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090207
					]
				},
				{
					"id": 760090207,
					"content": "#Đúng vậy, {NICKNAME} và tôi là những nhà mạo hiểm siêu đẳng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090211,
					"content": "Thật tuyệt vời. Được cùng bạn bè đi phiêu lưu khắp nơi, ngắm nhìn những phong cảnh khác nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090212
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090212,
					"content": "Đúng đúng, chúng tôi đã đi qua rất nhiều nơi rồi. Vậy lúc nãy em một mình ở đây làm gì thế? Đang tìm thứ gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090213,
					"content": "Vâng, em đang tìm những viên đá xinh đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090214
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090214,
					"content": "A, hiểu rồi, là để sưu tầm phải không! Không chỉ trẻ con, một số người lớn cũng có sở thích này đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090215,
					"content": "À, không phải đâu ạ. Em muốn dùng những viên đá xinh đẹp mua chuộc May để còn bắt cóc em đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090216
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090216,
					"content": "Ồ, ra là vậy, là để bắt... Khoan đã, em đang nói gì vậy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090217,
						760090218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090217,
					"content": "Nghe hơi vô lý nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090220
					]
				},
				{
					"id": 760090220,
					"content": "#Ơ? {M#Anh}{F#Chị} {NICKNAME} chưa từng nghe câu chuyện về đạo tặc Reed Miller và công chúa fae sao? May bảo với em là ai ở ngoài kia cũng biết câu chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090221
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090221,
					"content": "\"Nào, thưa tiểu thư có đôi mắt như ánh trăng, hãy để tôi dùng viên ngọc quý tương xứng với đôi mắt của nàng để đánh đổi trái tim nàng, đưa nàng rời khỏi chiếc lồng son này...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090222
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090222,
					"content": "Tuy em cũng không hiểu câu chuyện này rốt cuộc có ý gì, nhưng chỉ cần tặng thứ mà người khác thích là có thể cùng đối phương đi phiêu lưu rồi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090223,
						760090225
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090223,
					"content": "Câu đó chắc không phải ý này đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090224
					]
				},
				{
					"id": 760090224,
					"content": "Đúng, đúng vậy, ý của câu đó thực ra là... Ừm, tóm lại không phải câu chuyện dành cho trẻ con đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090227,
					"content": "Nói mới nhớ, May mà em nói là ai vậy? Sao lại kể cho trẻ con nghe những thứ kỳ lạ này, nghe cứ như là kẻ xấu có ý đồ gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090228,
					"content": "May không phải là kẻ xấu đâu, cũng tầm tuổi em thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090229
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090229,
					"content": "#Giống như {M#anh chị}{F#hai chị}, đó là một nhà mạo hiểm đến từ bên ngoài! Trước đây bạn ấy một mình lén lút ở gần doanh trại và đã bị em bắt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090230
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090230,
					"content": "Không biết tại sao, hình như bạn ấy nghĩ chúng em là một băng đảng quái nhân đáng sợ nào đó, sẽ bắt trẻ con để hiến tế cho Nguyệt Thần. Bạn ấy vừa giả vờ bình tĩnh, vừa khuyên em đừng giết mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090231
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090231,
					"content": "Thật, thật là một sự hiểu lầm kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090232,
					"content": "Đúng không? Em cũng không biết May đã nghe tin đồn này từ đâu, kỳ lạ thật. Nhưng vì trông có vẻ thú vị nên em cũng không phản bác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090233
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090233,
					"content": "Những lúc như thế này em nên phản bác đi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090234,
					"content": "Dù sao thì, để đổi lại, May đã hứa sẽ làm bạn thân nhất của em rồi, còn kể cho em nghe rất nhiều rất nhiều câu chuyện bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090235
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090235,
					"content": "Bình thường cha mẹ không cho em đọc những câu chuyện bên ngoài, nói rằng chỉ có những kẻ vô tín ngưỡng mới thích những thứ rác rưởi như vậy... nhưng những câu chuyện May kể thật sự rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090236
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090236,
					"content": "Ví dụ như, chàng ngư dân yêu một nàng tinh linh, tên đạo tặc đã chết ba lần nhưng cả ba lần đều thoát khỏi tay nữ chủ nhân địa ngục, một \"hoán sinh linh\" khao khát trở thành con người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090237
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090237,
					"content": "Người tốt, người không tốt lắm, người rất rất xấu, dù giàu hay nghèo, chính nghĩa hay tà ác, cuối cùng mọi người đều như nhau, chết trong khổ đau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090238,
						760090240
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090238,
					"content": "Cha mẹ em nói đúng đấy, đúng là hơi rác rưởi thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090239
					]
				},
				{
					"id": 760090239,
					"content": "Đúng vậy, câu chuyện như vậy thật sự không thích hợp để kể cho trẻ con nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090243,
					"content": "Nhưng mà, em không còn là trẻ con nữa. May trước đây cũng nói, thế giới bên ngoài quá hỗn loạn, không thích hợp cho một đứa trẻ như em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090244
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090244,
					"content": "Rõ ràng bạn ấy còn chẳng thể sử dụng chúc phúc{RUBY#[S]Kuuvahki} của Nguyệt Thần, tuổi tác cũng chỉ tầm em thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090245
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090245,
					"content": "Nhưng không sao, em rất thông minh đó! Trước khi May bị em bắt được, bạn ấy cứ luôn lẩm bẩm \"đá\" gì đó, chứng tỏ mục đích của bạn ấy là thu thập những viên đá xinh đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090246
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090246,
					"content": "Chỉ cần tìm được <color=#00E1FFFF>những viên đá đẹp</color>, chắc chắn bạn ấy sẽ bị em mua chuộc, rồi đưa em rời khỏi đây giống như Reed Miller dụ dỗ tiểu thư fae vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090247
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090247,
					"content": "Đừng dùng từ \"mua chuộc\" nữa! Thực ra là muốn tìm những viên đá xinh đẹp để tặng cho bạn thân, không cần phải dùng cách nói kỳ lạ như vậy đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090248,
					"content": "Ừm... dù sao tiếp theo chúng tôi chắc cũng sẽ đi dạo ở gần đây, nếu thấy mảnh đá nào xinh đẹp sẽ mang về cho em nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090249,
					"content": "#Wow, thật sao? Vậy xin cảm ơn {M#anh chị}{F#hai chị} tốt bụng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090240,
					"content": "Muốn nghe quá, em kể chi tiết hơn được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090241
					]
				},
				{
					"id": 760090241,
					"content": "Hả? Được thôi. Ví dụ như, bạn đồng hành của Reed Miller, \"Chồn Bóng Đêm\" đã thề sẽ không bao giờ bước vào ánh trăng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090242
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090242,
					"content": "Này, giờ không phải là lúc để nói những chuyện này đâu! Mà câu chuyện như vậy cũng không thích hợp để kể cho trẻ con nghe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090225,
					"content": "#Đúng vậy, đó là cách mà {M#anh}{F#chị} đã dụ được Paimon đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090226
					]
				},
				{
					"id": 760090226,
					"content": "#Này, đừng có dạy hư trẻ con! Tuy món tôi thích nhất đúng là những món mà {NICKNAME} nấu... nhưng, nhưng không thể gọi là bị lừa đi được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090218,
					"content": "Ở Nod-Krai thì cũng bình thường thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090219
					]
				},
				{
					"id": 760090219,
					"content": "Dù là ở Nod-Krai thì cũng không bình thường đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090208,
					"content": "#Thực ra {M#anh}{F#chị} mới là kẻ đứng đằng sau thao túng Thị Trấn Nasha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090209
					]
				},
				{
					"id": 760090209,
					"content": "#Wow, nghe ngầu quá! Vậy em có thể trở thành tùy tùng của {M#anh}{F#chị} {NICKNAME} không? Giống như trong truyện vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090210
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090210,
					"content": "Nói linh tinh gì vậy, chúng tôi chỉ là những nhà mạo hiểm đi ngang qua đây thôi! Làm gì có chuyện âm thầm thao túng thế lực ở Thị Trấn Nasha... chắc là không đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "Paimon"
				}
			]
		},
