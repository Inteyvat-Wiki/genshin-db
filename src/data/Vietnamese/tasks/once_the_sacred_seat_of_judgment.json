			"dialogs": [
				{
					"id": 751890701,
					"content": "Phát hiện mối đe dọa từ kẻ địch bóng tối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890702,
					"content": "Phòng thủ nội bộ... Kích hoạt chế độ tự động sửa chữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890703,
					"content": "Ah, không ngờ bên trong loại kiến trúc này cũng có thứ cơ quan như vậy... Đám ma vật đó trong tích tắc đã bị tiêu diệt hết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890704,
					"content": "\"Dù sao thì kiến trúc này cũng được xây dựng để đứng vững hàng ngàn năm. Không những có thể chống địch, mà còn có thể tự sửa chữa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890705,
					"content": "Hơn nữa, ánh vàng lấp lánh... thật muốn chạm vào quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890706,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "\"Haha, từ bỏ suy nghĩ đó đi... Nó sẽ không phân biệt ai là bạn bè ai là kẻ thù đâu... Nó chỉ đốt cháy mọi thứ mà nó chạm phải thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890708,
					"content": "\"...Cách làm vừa ngu ngốc vừa thô bạo, hừm, không biết là ai thiết kế ra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890709,
					"content": "Nhưng mà, chúng ta cũng có thể dùng nó để mở lá chắn bao quanh giấy phép...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890710,
					"content": "Rất đáng để thử...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "Vậy chúng ta... nghĩ cách nâng thứ này lên trên đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890712,
					"content": "Đề xuất nghiêm túc thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "Grroah, Raowrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "\"Nói đúng lắm. Không ngờ vị sứ giả màu trắng này lại... đầy trí tuệ như vậy. Thật khiến người khác phải ngạc nhiên.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890715,
					"content": "...Tôi không hiểu có gì đáng để ngạc nhiên nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "Paimon"
				}
			]
