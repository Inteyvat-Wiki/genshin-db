			"dialogs": [
				{
					"id": 751890601,
					"content": "\"Ở đó, thứ có thể kích hoạt ánh sáng khắc trên đá vảy, chính là giấy phép...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890602,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "Ở đây có thể nhìn thấy... toàn bộ Thánh Thành này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890604,
					"content": "\"Đúng vậy, quả là tàn ảnh bi thương của hào quang trong quá khứ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890605,
					"content": "Wrroh... Rawrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "\"Ngươi muốn hỏi kết quả cuối cùng của buổi xét xử đó sao? Haha...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890607,
					"content": "\"Kẻ đòi thực hiện phán xét thiêng liêng đương nhiên cũng biết chủ nhân nắm giữ mọi ánh lửa đang chìm vào trạng thái chết giả, chẳng qua khi vị vua thỉnh thoảng tỉnh táo xuất hiện ở hiện trường thì...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890608,
					"content": "\"Mười ba vị lãnh chúa và ba vị thân vương vốn dĩ đang ồn ào lập tức im bặt, buổi xét xử hệt như một trò hề cũng vì vậy mà lẳng lặng kết thúc...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890609,
					"content": "Grroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "\"Sau đó... ba vị thân vương trong đó đã chết trong cuộc chiến với con người, mười trong số mười ba vị lãnh chúa đã ngã xuống trong sự sụp đổ của Thánh Thành Tollan, một vị ở lại Chichen Uctokah...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890611,
					"content": "\"Chỉ có một vị lãnh chúa sống sót đến ngày nay...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890612,
					"content": "\"Nhưng có lẽ, đó không phải là hình thức mà vị lãnh chúa đó muốn tiếp tục tồn tại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890613,
					"content": "\"Được rồi... Tiếp tục đến Trái Tim Của Núi Thánh nào. Nơi đó chôn giấu tất cả. Chôn giấu... khát vọng ở cuối chuyến hành trình.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890614,
					"content": "\"Sứ mệnh của ta kết thúc ở đây... Người được rồng chọn, nơi này từng là một nơi tuyệt đẹp biết bao...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890615,
					"content": "\"Hãy chạm vào ánh sáng khắc trên vảy lửa... Để nhận được giấy phép đi đến Trái Tim Của Núi Thánh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890616,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "Awanyu... Chậc, lại đi mất rồi! Còn chưa gọi tên được mấy lần mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890618,
					"content": "Nhưng cuối cùng cũng đã có được giấy phép để đi đến Trái Tim Của Núi Thánh rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890619,
					"content": "Rrrawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "Ánh sáng bên này... biến mất rồi...",
