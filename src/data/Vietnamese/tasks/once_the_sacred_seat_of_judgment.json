			"dialogs": [
				{
					"id": 751890301,
					"content": "\"Đi nào, chúng ta hãy xem thử họ giấu giấy phép ở đâu thôi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890302,
					"content": "\"Xem ra họ đã để ở ngay đó... Đúng là còn không thèm giấu đấy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890303,
					"content": "\"Nhưng có vẻ như chỉ là một cái vỏ rỗng thôi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890304,
					"content": "Ối, sao đột nhiên lại có nhiều Chó Săn Ma Vật thế? Hừm, vậy là giấy phép đó cũng bị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890305,
					"content": "\"Chắc là do lớp bảo vệ ở ngoài cổng không còn, nên chúng mới có thể lẻn vào.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890306,
					"content": "Vậy, vậy bây giờ phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890307,
					"content": "\"Không sao cả. Chỉ cần khởi động thiết bị thanh tẩy trong Sảnh Thương Nghị là được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890308,
					"content": "\"Là ở đó...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hầu Cận Rồng"
				}
			]
		},
