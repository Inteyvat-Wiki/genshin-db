			"dialogs": [
				{
					"id": 751890401,
					"content": "Cuối cùng cũng kết thúc... Hihi, thế là đã lấy được giấy phép để vào Trái Tim Của Núi Thánh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890402,
					"content": "\"Không, trước đây ta đã nói rồi, đây chỉ là lớp vỏ rỗng của giấy phép thôi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890403,
					"content": "\"Nếu chỉ cầm thứ làm bằng vảy này mà bên trong không có bất kỳ thông tin của người sở hữu nào, thì sẽ không thể nào biến thành giấy phép được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890404,
					"content": "\"Nếu không thì thứ này chẳng phải đã trở thành chiếc chìa khóa vạn năng mà 'chỉ cần là rồng là sẽ có thể sử dụng' sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890405,
					"content": "Mau bắt một con rồng có thân phận đến nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#Làm gì có con rồng nào như vậy chứ... À, {REALNAME[ID(2)|SHOWHOST(true)]} thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890407,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "\"Nó... hiện vẫn chưa có quyền năng như vậy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890409,
					"content": "Vậy bây giờ phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890410,
					"content": "\"Rất lâu trước đây, sau khi quân chủ vĩ đại bước vào Trái Tim Của Núi Thánh, cũng từng có những kẻ sở hữu quyền năng nhưng chưa từng kích hoạt giấy phép này.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890411,
					"content": "\"Có lẽ cũng vì thế nên mới để giấy phép ở nơi dễ phát hiện như vậy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hầu Cận Rồng"
				}
			]
		},
