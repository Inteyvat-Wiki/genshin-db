					"content": "\"Mặc dù biết tất cả đều vì phép lịch sự, nhưng quả thực rất vui khi gặp được các người.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890504,
					"content": "Ồ, quả nhiên là ngươi! Hmm, lần này ngươi tên là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890505,
					"content": "\"Cái tên lần này thuộc về quan thư ký của Sảnh Thương Nghị. Sau khi Hầu Cận Rồng được phát minh, tên đó đã rất ít khi tự mình động vào giấy bút.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890506,
					"content": "\"Awanyu... Ngươi có thể gọi ta như vậy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890507,
					"content": "Được rồi, Awanyu. Lần này ngươi đến để giúp bọn ta lấy được giấy phép để đi vào Trái Tim Của Núi Thánh gì đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890508,
					"content": "\"Nếu không, Tổ Hợp Tinh Tú do Trái Tim Của Núi Thánh thiết lập sẽ tấn công khi người không có được giấy phép tiến vào...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890509,
					"content": "\"...Ta đã trích xuất ghi chép của Awanyu, giấy phép để vào Trái Tim Của Núi Thánh được đặt ở Sảnh Thương Nghị.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890510,
					"content": "\"Vì thế, ta chỉ đành đặt chân đến nơi này... Nơi tụ tập của những kẻ ngu ngốc tự cho mình thông minh, nơi tụ tập của những kẻ bất tài mà lại tự hào vì sự bất tài của mình.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751890511,
					"content": "\"Cũng là nơi mà những kẻ này đã ra vẻ để phán quyết đồng loại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hầu Cận Rồng"
				}
			]
		},
