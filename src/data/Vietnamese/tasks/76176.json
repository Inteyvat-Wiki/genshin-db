				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "...Chị Aria, chị Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "Đây không phải lần đầu tiên. Đây đã... vượt xa phạm vi \"trừng phạt\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "Dù là thành phố của rồng mà nhà vua giao phó cho chúng ta, hay những ngôi nhà mong manh nhưng xinh đẹp mà những con người nhỏ bé đã xây dựng nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "Hai chị còn phải chứng kiến bao nhiêu sinh linh vô tội chết đi, thì mới chịu ra tay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "Giá như nhà vua của chúng ta còn ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "...Nhà vua của chúng ta không có ở đây, Sonnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760307,
					"content": "Nếu vị chúa tể không hề toàn năng kia coi vận mệnh nhợt nhạt và đáng sợ đó là \"trật tự\", nếu đây là khả năng duy nhất để thế giới đã định sẵn sẽ diệt vong này không bị nuốt chửng, vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760308,
					"content": "Bất kể cái giá nó đòi hỏi có nặng nề đến đâu... bất kể cái giá đó khiến chị đau buồn đến nhường nào, nó vẫn tốt hơn nhiều so với sự tĩnh lặng chết chóc tăm tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760309,
					"content": "Nếu thế giới đã định sẵn sẽ bị hủy diệt... vậy thì chống lại bóng tối còn có ý nghĩa gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "...Sonnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760311,
					"content": "Không... không có gì đâu, chị Aria! Em không nói gì hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "Em chỉ cảm thấy, chúng ta không nên ngồi yên nhìn vị bạo chúa đó tàn sát những sinh linh đã tin tưởng vào chúng ta... dù là rồng hay những con người nhỏ bé kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "Chẳng lẽ... chúng ta không nên cứu họ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760315,
					"content": "...Em có thể hiểu được sự phẫn nộ của Sonnet, Aria. Theo em, những gì mà vị chúa tể đó làm quả thực quá tàn nhẫn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760316,
					"content": "Dù chỉ có một tia hy vọng mong manh... em cũng muốn dốc hết sức mình để cứu lấy những sinh mạng còn có thể cứu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760317,
					"content": "Nhưng... còn những người không thể cứu được thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "Những người không thể cứu được, những sinh mạng không thể cứu được... Máu, nước mắt, tiếng khóc than của họ, chẳng lẽ nên biến mất không dấu vết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "Không... không nên như vậy. Em hy vọng mọi người đều được cứu, không một ai phải rơi vào khổ đau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "Chỉ cần \"trật tự\" của nó... chết đi cùng nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "...Sonnet. Em đừng quên lý do ban đầu chúng ta được sinh ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760322,
					"content": "Sứ mệnh của chúng ta chỉ là duy trì thế giới này, cho đến khi nhà vua ban cho chúng ta sự sống trở về từ phương xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760323,
					"content": "Ngay từ đầu, chúng ta đã rõ cái giá phải trả cho trật tự này... vì chúng ta không thể để mặc thế giới này đi đến hủy diệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760324,
					"content": "...Không, điều này thậm chí còn không liên quan đến trật tự, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760325,
					"content": "Sonnet, đối với chúng ta... đối với chị, em là cô em gái quan trọng nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760326,
					"content": "Cho nên... xin em đừng làm những điều khiến Aria và chị phải đau khổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760327,
					"content": "Đừng trực tiếp chống lại trật tự của trời cao. Ít nhất... không phải vào lúc thế giới vẫn còn yếu ớt như bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760328,
					"content": "Chị Canon... em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Istaroth từng nói với chị một từ chỉ thuộc về loài người... \"hy vọng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760330,
					"content": "Chỉ cần có sự sống thì sẽ có hy vọng... Sẽ luôn có hy vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}