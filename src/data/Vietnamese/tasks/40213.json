			},
			"dialogs": [
				{
					"id": 402130101,
					"content": "Rất xin lỗi! Không ngờ lại xảy ra chuyện lơ là chức trách, để người ngoài chiếm dụng tài sản của cục thiết kế... Thuộc hạ nhất định sẽ tra rõ ngọn ngành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130102
					],
					"speakerTitle": "\"Chuẩn Úy\""
				},
				{
					"id": 402130102,
					"content": "Không cần điều tra nữa, dẫn người của ngươi về và tiếp quản lại nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130103
					],
					"speakerTitle": "\"Đại Úy\""
				},
				{
					"id": 402130103,
					"content": "Không cần điều tra? Đây là ý của cấp trên sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130104
					],
					"speakerTitle": "\"Chuẩn Úy\""
				},
				{
					"id": 402130104,
					"content": "Không cần điều tra nữa, hiểu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130105
					],
					"speakerTitle": "\"Đại Úy\""
				},
				{
					"id": 402130105,
					"content": "Rõ, thưa đại úy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130106
					],
					"speakerTitle": "\"Chuẩn Úy\""
				},
				{
					"id": 402130106,
					"content": "Hửm? Các người tới đây từ khi nào thế? Đây là thiết bị của Cục Thiết Kế Thí Nghiệm Kuuvahki, những người không liên quan hãy mau rời khỏi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Đại Úy\""
				}
			]
