			"dialogs": [
				{
					"id": 190551001,
					"content": "Thông tin của chú rất chính xác, khi chúng ta đến thì đám Nobushi đó vẫn đang ngủ say, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "Thế là bị chúng ta tóm gọn một mẻ, tất cả hàng hóa thu về được đều nằm ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "Để kiểm tra xem nào... Ừm... Đều không sao cả, mọi người vất vả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "Sao lại nói thế, may mà có thương đội của chú Todoroki cố gắng buôn bán nên giá cả lương thực trong làng mới hạ xuống được đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "Đúng vậy, cả những thương binh như chúng tôi nữa, ai mà biết được di chứng để lại của chiến tranh nghiêm trọng đến thế chứ. May nhờ có thuốc cứu mạng của chú Todoroki mang về đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Cũng nhờ mấy anh giúp đỡ nên tình hình mới có chuyển biến tốt thôi. Kho trong làng thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Tối nay phải xác nhận cho xong đấy, sáng mai sau khi đến Sangonomiya nhận chỉ thị của đại nhân Gorou là sẽ phải xuất phát rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "Yên tâm đi chú Todoroki, chúng tôi đã sắp xếp danh sách xong cả rồi, cứ đi theo chúng tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
