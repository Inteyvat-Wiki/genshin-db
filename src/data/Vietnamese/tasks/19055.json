			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}, xin lỗi bạn lần nữa, tôi đã không nói sự thật với bạn, tôi thật sự rất áy náy, nhưng tôi... không thể không làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551602,
					"content": "Tôi hiểu mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "À mà Kokomi có biết chuyện này không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "Đại nhân Sangonomiya à... chỉ có thể nói rằng chiến tranh đã mang lại rất nhiều điều tồi tệ, nhưng cũng giúp chúng tôi trưởng thành hơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551605,
					"content": "Vậy rốt cuộc là biết hay không biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551606,
					"content": "Chuyện này... các bạn không tò mò xem ai là người thúc đẩy luật hàng hóa mới sao? Không thể nào là Hiệp Hội Kanjou được, điều này đối với họ không có lợi ích trực tiếp nào, chúng tôi cũng không có người quen nào bên đó cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551607,
					"content": "Đúng nhỉ, nói vậy không lẽ là có bàn tay của thần linh cứu giúp sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551608,
					"content": "Haha, thần linh sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551609,
					"content": "Cách đây không lâu, trên Đảo Narukami đã tổ chức Lễ Hội Irodori, tôi và đại nhân Sangonomiya cũng được mời tham dự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551610,
					"content": "Lúc đó khi tôi đang đợi ở chợ, đại nhân Sangonomiya đã đi đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
