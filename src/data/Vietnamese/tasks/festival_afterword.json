			"dialogs": [
				{
					"id": 725000101,
					"content": "Có chuyện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000102,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "Đại ca lại bị bắt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000104,
					"content": "Vừa rồi Hiệp Hội Tenryou phái người tới, dán một tờ thông báo trên bảng dặn dò, nói là muốn tạm dừng lễ hội của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000105,
					"content": "Không biết là có chuyện gì, nhưng hình như đại ca đã xông vào Thiên Thủ Các để phát tờ rơi quảng cáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000106,
					"content": "Còn nói Shogun đại nhân nhất định phải tham gia Đại Hội Đánh Trống Arataki Long Trọng Bậc Nhất nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000107,
					"content": "Hả? Nói vậy tôi lại cảm thấy đại ca nói không sai mà. Tôi cũng cảm thấy Shogun đại nhân chắc chắn muốn tham gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 725000108,
					"content": "Đúng vậy, chẳng lẽ anh không nghĩ vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000109,
					"content": "Hầy, ai mà quan tâm chúng ta nghĩ gì chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000110,
					"content": "Tóm lại đại ca bị Đội Điều Tra bắt tại chỗ, rồi đưa tới Hiệp Hội Tenryou rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000111,
					"content": "Vậy phải làm sao đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "Chắc chị Shinobu đã đi xử lý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000113,
					"content": "Nghe nói Đội Điều Tra bảo đại ca là nghi phạm làm loạn cấm địa quân sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000114,
					"content": "Sau đó bị Kujou Sara đại nhân đổi tội danh thành nghi phạm gây ảnh hưởng trật tự công cộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000115,
					"content": "Ả Tengu Kujou kia dám gán tội danh nặng hơn cho đại ca sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000116,
					"content": "Hầy, anh bị gì đấy! Tội này là nhẹ rồi, thường thì chỉ cần cảnh cáo là xong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000117,
					"content": "Chuyện lễ hội chỉ có thể chờ đại ca được thả rồi mới tính tiếp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000118,
					"content": "Nhà Lữ Hành, xin đừng lo, có chị Shinobu ở bên đó giải quyết, chắc sẽ không có vấn đề gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000119,
					"content": "Bạn ủng hộ lễ hội của chúng tôi như vậy, đợi khi đại ca ra ngoài nhất định sẽ đích thân cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000120,
					"content": "Mong rằng hành trình của bạn cũng giống như lễ hội của chúng tôi, có thể càng ngày càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000121,
					"content": "Càng ngày càng tốt!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				}
			]
		}
	]
