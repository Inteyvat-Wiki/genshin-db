			"dialogs": [
				{
					"id": 210070601,
					"content": "Ú ù... Là những người trước kia từng gặp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "Cây mọc một mình, chẳng thể thành rừng... Haha đúng là một mình không thể làm được gì cả....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuanqing"
				},
				{
					"id": 210070603,
					"content": "Lá đỏ nảy nầm, không gió cũng rơi... Nếu như ta tin anh cả và bố già thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070604,
					"content": "Lá đỏ nảy nầm, không gió cũng rơi... Báu vật... Chỉ vì báu vật đến nay chẳng còn lại gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070605,
					"content": "Cây lớn rậm rạp, che chở nhà ta... Các con ơi, chúng ta đều là người một nhà mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070606,
					"content": "Các con đều nghĩ là ta cất giữ báu vật xuống mỏ khoáng vật sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070607,
					"content": "Thế nhưng ta làm gì có báu vật... Còn nhớ gốc cây cả nhà chúng ta cùng trồng khi các con còn nhỏ không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070608,
					"content": "Mỗi năm bố đều đến đây chôn một vài món đồ xuống, hy vọng đến khi các con trưởng thành cả nhà chúng ta cùng nhau đào chúng lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070609,
					"content": "Đến khi đó, cả nhà chúng ta sẽ dùng những món đồ dưới đó mua đồ ăn ngon, uống rượu ngon, cả nhà quây quần nhắc đến những chuyện cũ trước kia",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070610,
					"content": "Các con à, các con ơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		}
