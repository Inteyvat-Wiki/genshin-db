						210070302
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070302,
					"content": "Lão già đúng là hồ đồ, mắt nhắm mắt mở...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070303,
					"content": "Bọn họ có lẽ không biết được dưới mỏ khoáng vật có ẩn chứa báu vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070304,
					"content": "Phải nhanh tay giành lấy báu vật rồi cao chạy xa bay...",
