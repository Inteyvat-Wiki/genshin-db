			"dialogs": [
				{
					"id": 210070401,
					"content": "Hehe... Báu vật đều là của ta rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070402,
					"content": "Đại ca và tiểu đệ đúng là những kẻ ngốc, mới nói hai câu đã chạy rồi, hí hí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070403,
					"content": "Giáo huấn tổ tiên là cái gì, chỉ có báu vật nằm trong mỏ khoáng vật mới là thứ đáng giá, hehe chẳng mấy chốc báu vật sẽ thuộc về ta rồi...",
