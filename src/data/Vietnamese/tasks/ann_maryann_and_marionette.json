			"dialogs": [
				{
					"id": 742530101,
					"content": "Nói thật, đến giờ tôi vẫn rất ngạc nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530102,
					"content": "Phải biết rằng, lúc đó tôi và Alain thật sự đều nghĩ cô đã không còn tồn tại trên đời này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530103,
					"content": "Ừm... Giá mà chúng tôi tỉnh lại sớm hơn, có lẽ vẫn kịp gặp được Alain và cô. Nhưng mà, đây chính là vận mệnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530104
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530104,
					"content": "Tiểu thư Mary-Ann...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530105
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530105,
					"content": "Nhưng vận mệnh cũng có sự diệu kỳ riêng của nó. Ai mà ngờ được tôi và Ann lại nhìn thấy áp phích bộ phim in hình tiểu thư Sandrone khi đi du lịch chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530106
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530106,
					"content": "Vậy nên cả hai mới tìm cách liên lạc với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530107,
					"content": "Đúng là như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530108
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530108,
					"content": "Ah... Mùi cà phê thật khiến người ta hoài niệm... Haha, cảm ơn cô đã mời chúng tôi đến đây tham gia tiệc trà, tiểu thư Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530109
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530109,
					"content": "Khu vườn được bày biện thanh lịch và trang nhã, rất phù hợp với gu thẩm mỹ của một quý cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530110
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530110,
					"content": "Đây từng là ngôi nhà của tôi và Alain, chăm chút cho đẹp đẽ một tí cũng là điều nên làm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530111,
					"content": "Xem kìa, điểm này thì cô giỏi hơn anh trai tôi nhiều đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530112
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530112,
					"content": "Alain chẳng bao giờ chịu trang trí phòng ốc cả, cũng không giỏi xử lý những thứ đẹp đẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530113
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530113,
					"content": "Đúng vậy, Rene cũng thế. Chỉ có tôi và Jakob là sẽ nghiêm túc trang trí phòng ốc và chuẩn bị tiệc trà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530114
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530114,
					"content": "Từ nhỏ đã như vậy sao? Tôi cứ tưởng là do lớn tuổi rồi mới thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530115,
					"content": "Từ nhỏ đã vậy rồi. Tuy đầu óc rất thông minh, nhưng ở những phương diện khác thì lại luôn vụng về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530116
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530116,
					"content": "Chắc vì thế nên anh ấy mới trở thành người duy nhất trong chúng tôi lựa chọn nỗi đau của sự thật, chứ không phải giấc mơ hư ảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530117
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530117,
					"content": "Tôi lại thấy ông ấy không có gì phải tiếc nuối cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530118,
					"content": "Ừm, vì đó chính là nguyện vọng của anh ấy với tư cách là một dũng sĩ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530119
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530119,
					"content": "Người phải tiếc nuối là chúng tôi. Nguyện vọng của anh ấy lẽ ra không nên cô đơn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530120,
					"content": "Còn tiểu thư Sandrone thì sao? Cô có nguyện vọng gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530121
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530121,
					"content": "Câu hỏi của cô và Alain giống hệt nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530122,
					"content": "Hmm? Anh ấy cũng hỏi câu này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530123
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530123,
					"content": "Xem ra anh ấy thực sự đã trưởng thành hơn nhiều rồi. Trước đây anh ấy không thể nào nói được những lời như thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530124
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530124,
					"content": "Từ \"nguyện vọng\" này thực sự quá mơ hồ rồi. Chỉ cần muốn là sẽ có được à? Ha, vậy thì trên đời sẽ không có nhiều chuyện bực mình đến thế rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530125,
					"content": "Tôi đang làm những điều mình muốn, những điều tôi cho là đúng. Tôi không biết điều này có được coi là nguyện vọng hay không, nhưng tôi rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530126,
					"content": "Ừm, đó là một việc rất tuyệt vời. Tôi rất ngưỡng mộ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530127
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530127,
					"content": "Vậy cô có... oán trách Alain không? Vì đã tạo ra cô theo hình dáng của... Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530128
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530128,
					"content": "Không bao giờ. Ông ấy luôn nói, tôi là chính mình, là độc nhất vô nhị, tôi nên tự lựa chọn cuộc đời của mình. Và tôi cũng đã làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530129
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530129,
					"content": "Haha, dù là câu chuyện hay trà bánh, chỉ cần là lựa chọn khiến cô hài lòng, thì đó chính là lựa chọn đúng đắn nhất, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530130
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530130,
					"content": "Đúng vậy, nên bây giờ, chúng ta hãy thưởng thức trà bánh mà cô đã chuẩn bị nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				}
			]
		},
