			"dialogs": [
				{
					"id": 742530201,
					"content": "Những ngày tháng yên bình thật tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530202,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742530204,
					"content": "Đã muộn thế này rồi sao? Haha, sau này hãy gặp nhau thường xuyên hơn nhé, tiểu thư Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530203,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
