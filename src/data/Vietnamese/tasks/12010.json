			},
			"dialogs": [
				{
					"id": 120100101,
					"content": "#{NICKNAME}, chúng em đang tìm \"Siêu Mujina Youkai\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100102
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100102,
					"content": "#{F#Chị}{M#Anh} có biết \"Siêu Mujina Youkai\" sống ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100103
					],
					"speakerTitle": "Saika"
				},
				{
					"id": 120100103,
					"content": "Siêu Mujina Youkai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100104,
					"content": "Chưa ai từng nghe đến nó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100105
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100105,
					"content": "Đó là một con yêu quái rất lợi hại và xảo quyệt, có thể biến thành đủ loại hình dạng, xuất quỷ nhập thần, rất thích lừa bịp người khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100106
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100106,
					"content": "Gạo ở nhà chúng em đã từng bị \"Siêu Mujina Youkai\" ăn vụng, có lần cha em còn bị nó đạp xuống hồ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100107
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100107,
					"content": "Quậy thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100108,
					"content": "Sao các em muốn tìm nó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100109
					]
				},
				{
					"id": 120100109,
					"content": "Vì chúng em đã có cách đánh đuổi nó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100110
					],
					"speakerTitle": "Saika"
				},
				{
					"id": 120100110,
					"content": "Cha em nói, \"Siêu Mujina Youkai\" thích nhất là trêu ghẹo những người không chịu về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100111
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100111,
					"content": "Chỉ cần đánh đuổi được \"Siêu Mujina Youkai\" là chúng em có thể ra ngoài chơi bất cứ lúc nào rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100112
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100112,
					"content": "Nhưng nếu nó là yêu quái lợi hại thì các em sẽ không sợ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100113,
					"content": "Cha mẹ cũng lo cho sự an toàn của các em đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100114,
					"content": "Không đâu, hôm nay em nói với cha là chúng em muốn đi bắt \"Siêu Mujina Youkai\", nhưng cha cũng không nói gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100115
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100115,
					"content": "Không chừng \"Siêu Mujina Youkai\" bây giờ đang rất yếu, chỉ có thể trốn đi để nghỉ ngơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100116
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100116,
					"content": "Ừm, chỉ cần về nhà trước khi \"Siêu Mujina Youkai\" hồi phục yêu lực thì sẽ không có nguy hiểm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100117
					],
					"speakerTitle": "Saika"
				},
				{
					"id": 120100117,
					"content": "Ừm...nghe lạ lùng ta, cũng không rõ ràng cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100118,
						120100119,
						120100120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100118,
					"content": "Nếu thật sự bị nhắm vào thì có trốn ở nhà cũng chẳng ăn thua mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100121,
					"content": "Ừm, tôi có cảm giác \"Siêu Mujina Youkai\" chỉ là yêu quái xuất hiện trong truyện cổ tích chứ không hề có thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100122,
						120100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100122,
					"content": "Tôi cũng cảm thấy đây chỉ là truyền thuyết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100124,
					"content": "Vậy thì nói cho bọn trẻ biết đi, để không cần tốn công sức đi tìm khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100125,
					"content": "Nghe này, các em không cần đi tìm \"Siêu Mujina Youkai\" nữa đâu, vì nó không hề tồn tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100126,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100127
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100127,
					"content": "Không phải chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100128
					],
					"speakerTitle": "Saika"
				},
				{
					"id": 120100128,
					"content": "Không thể nào, cha không thể lừa em được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100129
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100129,
					"content": "Người nhà của các em chỉ lo lắng cho các em thôi, nếu đi lung tung hoài sẽ rất nguy hiểm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100130,
					"content": "Không đúng, không đúng, chắc chắn có \"Siêu Mujina Youkai\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100131
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100131,
					"content": "Đúng rồi, chị Yoimiya còn chuẩn bị vũ khí cho bọn em nữa! Còn dạy bọn em cách làm yêu quái nổ tung mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100132
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100132,
					"content": "Ơ, Yoimiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100133,
					"content": "Chúng em đã kể chuyện của \"Siêu Mujina Youkai\" cho chị Yoimiya nghe. Chị ấy bảo chúng em đừng sợ, phải học cách để đuổi nó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100134
					],
					"speakerTitle": "Saika"
				},
				{
					"id": 120100134,
					"content": "Chúng em đã chờ rất lâu, cuối cùng chị Yoimiya nói hôm nay là thời cơ tốt, cho nên chúng em mới ra đây tìm \"Siêu Mujina Youkai\" đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100135
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100135,
					"content": "Đúng thế đúng thế, chị Yoimiya thường chơi với chúng em, kể chuyện cho chúng em nghe, chị ấy sẽ không lừa gạt vậy đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100136
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100136,
					"content": "Nhưng, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100137,
					"content": "Hứ! Chúng ta đi! Đi tìm chị Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100138
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100138,
					"content": "Chờ đã, đừng đi đừng đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100139,
					"content": "Haiz, làm chúng giận rồi. Nhưng tôi cũng vì lo cho chúng nên mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100140,
					"content": "Không biết vì sao còn có Yoimiya ở đây, chúng ta đuổi theo xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100123,
					"content": "Chỉ vì không muốn để bọn trẻ chạy lung tung khắp nơi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100119,
					"content": "#{F#Chị}{M#Anh} chưa từng gặp loại yêu quái này bao giờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100120,
					"content": "Thái độ của người cha hơi kỳ lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				}
			]
		},
		{
			"id": 1201002,
			"completionStepIds": [
				1201002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201002",
							"2"
						],
						"stepId": 1201002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100201,
					"content": "#Đừng buồn đừng buồn ha, {NICKNAME} chỉ nói đùa với các em thôi, \"Siêu Mujina Youkai\" sao lại không có thật chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100202
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100202,
					"content": "Nhưng, đúng là chúng em chưa từng gặp \"Siêu Mujina Youkai\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100203
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100203,
					"content": "Là vì \"Siêu Mujina Youkai\" rất lợi hại, và vì nó lợi hại như thế mới cần các em ra tay, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100204
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100204,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100205
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100205,
					"content": "Đừng vội, cũng đừng nản lòng, muốn trở thành anh hùng thì không thể thiếu đi lòng nhẫn nại và trí thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100206,
					"content": "Cứ cho là bây giờ không tìm được nó, thì trước khi lễ hội pháo hoa bắt đầu, nó chắc chắn sẽ xuất hiện thôi. Trước lúc đó, hãy nhớ đến nhà chị Yoimiya lấy vũ khí, biết chưa nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100207,
					"content": "Đốt pháo hoa do chị sáng chế, thì cho dù \"Siêu Mujina Youkai\" có lợi hại thế nào cũng có thể dọa nó chạy mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100208
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100208,
					"content": "Đồ đạc trong nhà, hoa màu trong vườn, và cả cha mẹ, đều sẽ được các em bảo vệ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100209
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100209,
					"content": "Em biết rồi! Nếu chị Yoimiya đã nói vậy thì chúng em sẽ kiên nhẫn một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100210
					],
					"speakerTitle": "Matsuzaka"
				},
				{
					"id": 120100210,
					"content": "Đúng rồi đúng rồi, đừng đi vội. Chị còn vài tấm giấy, mỗi đứa một tấm nhé, nhớ mang về cho cha mẹ, bảo họ cất giữ cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100211
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100211,
					"content": "Chỉ cần nói là chị Yoimiya đưa, họ sẽ hiểu ý thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100212
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100212,
					"content": "Em biết rồi! Cám ơn chị Yoimiya! Chúng em về trước nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100213
					],
					"speakerTitle": "Iwao"
				},
				{
					"id": 120100213,
					"content": "Cám ơn chị Yoimiya! Chị cũng phải về chơi với chúng em sớm sớm nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100214
					],
					"speakerTitle": "Saika"
				},
				{
					"id": 120100214,
					"content": "Được được, đi đường cẩn thận, lát nữa gặp nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100215
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100215,
					"content": "Cái, cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100216,
						120100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100216,
					"content": "Lâu rồi không gặp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				},
				{
					"id": 120100218,
					"content": "Quả nhiên là các bạn, nghe bọn trẻ miêu tả là tôi đoán ra ngay. Không sao hết, không trách các bạn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100219
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100219,
					"content": "\"Siêu Mujina Youkai\" rất nổi tiếng với bọn trẻ, phủ định sự tồn tại của nó đương nhiên sẽ khiến chúng bị tổn thương rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100220
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100220,
					"content": "Vậy chính xác thì \"Siêu Mujina Youkai\" không tồn tại phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100221,
					"content": "Ừm, lần đầu tiên nghe được câu chuyện của nó, tôi đã cảm thấy đa phần là yêu quái do cha mẹ bọn trẻ tự bịa ra, để bọn trẻ đừng chạy lung tung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100222
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100222,
					"content": "Nhưng khi chúng đến hỏi tôi, tôi đã không vạch trần, mà nói rằng trông nó rất dễ thương, thích bày trò chọc phá, và không thích làm hại người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100223
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100223,
					"content": "Bây giờ thứ mà chúng tin vào, chính là hình tượng mà tôi đã vẽ ra đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100224
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100224,
					"content": "Thì ra đều là ý tưởng của bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100225,
					"content": "Cứ nói dối như thế có vẻ không đúng lắm nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100226
					]
				},
				{
					"id": 120100226,
					"content": "Chắc là vậy, nhưng cho dù thế nào thì cũng không đến lượt tôi vạch trần lời nói dối này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100227
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100227,
					"content": "Cha mẹ chúng có thể vì không muốn chúng chạy lung tung, nhưng cũng có thể vẫn còn lý do nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100228
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100228,
					"content": "Trong lúc chưa hiểu rõ tình hình, nếu tôi lỡ miệng nói \"Siêu Mujina Youkai\" không tồn tại, e là sẽ làm hại chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100229
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100229,
					"content": "Vả lại, đối với trẻ con, tin tưởng và yêu thích là được rồi, những thứ thật thật giả giả không quan trọng đến thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100230
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100230,
					"content": "Trong lòng tôi cũng có rất nhiều rất nhiều mong mỏi đấy, sau khi đốt lên sẽ bắn ra \"kim cương lửa\" bảy sắc cầu vồng, và \"tinh linh sương khói\" sẽ chỉ đường lên tiên cảnh đang ẩn mình nơi núi rừng sâu thẳm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100231
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100231,
					"content": "Tôi biết chúng đều không tồn tại, nhưng tôi vẫn muốn tin. Nếu ai nói với tôi, rằng \"Đừng ngốc nghếch nữa, không có thật đâu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100232
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100232,
					"content": "Thì tôi sẽ làm mặt xấu với họ, ném đá vào họ! Vì như thế khiến người ta bực bội lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100233,
						120100235
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100233,
					"content": "Có lẽ tôi đã hiểu cảm giác này rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100234
					]
				},
				{
					"id": 120100234,
					"content": "Đúng nhỉ! Cho dù là giả, nhưng rất ngầu, rất lãng mạn đó, không cần ai phủ nhận đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100237,
					"content": "Những thứ đã từng tin tưởng, những chuyện đã từng trải qua thời thơ ấu, sẽ dần dần trở thành bảo vật không thể thay thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100238
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100238,
					"content": "Lúc còn nhỏ các bạn cũng từng tin vào dũng sĩ diệt rồng, kiếm thánh hủy diệt hắc ám phải không, tôi thấy thực ra chúng đều như nhau cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100239
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100239,
					"content": "Vạch trần đồng thoại là không có thật, thì phải kể với bọn trẻ chuyện gì? Chẳng lẽ là chuyện phong tỏa hiện tại của Inazuma sao? Hay là về lệnh truy lùng Vision? Chưa đến lúc đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100240
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100240,
					"content": "Ừm...đúng! Vẫn chưa đến lúc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100241,
						120100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100241,
					"content": "Bạn chỉ cần nhớ câu cuối cùng thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100243,
					"content": "Ha ha, cho dù có hiểu hay không, thì cứ yên tâm đi, tôi sẽ chú ý đến sự an toàn của bọn trẻ, bảo vệ chúng thật tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100244
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100244,
					"content": "Được rồi, tôi cũng phải về thôi, sắp đến \"Hội Pháo Hoa Naganohara\" rồi, còn nhiều chuyện phải làm lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100245
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100245,
					"content": "\"Hội Pháo Hoa Naganohara\"? Là sự kiện mà các bạn tổ chức sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100246,
					"content": "Đúng rồi, dù sao cũng đã để tên của nhà chúng tôi mà, đây là sự kiện rất nổi tiếng ở Inazuma đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100247
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100247,
					"content": "Đúng rồi, các bạn còn việc gì nữa không? Nếu không thì hãy đến tham gia đi, tôi sẽ chuẩn bị pháo hoa siêu đẹp cho các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100248,
						120100249
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100248,
					"content": "Tôi đã muốn xem từ lâu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100250,
					"content": "Hi hi, vậy tôi đưa các bạn đến Naganohara trước, gặp cha của tôi nhé! Vẫn còn vài cây pháo chưa làm xong nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100249,
					"content": "Vậy thì tôi không khách sáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100242,
					"content": "Đừng tâng bốc chúng quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100235,
					"content": "Sao cứ như trẻ con thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100236
					]
				},
				{
					"id": 120100236,
					"content": "Là vì thật giả chẳng có ý nghĩa gì cả, những thứ ngầu ngầu lãng mạn đều đáng để tin tưởng, không cần ai phủ nhận đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100217,
					"content": "Lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				}
			]
		},
		{
			"id": 1201003,
			"completionStepIds": [
				1201003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201003",
							"2"
						],
						"stepId": 1201003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100301,
					"content": "Cha, con về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100302
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100302,
					"content": "Sắp đến lễ hội pháo hoa rồi, pháo hoa của mỗi nhà đã chuẩn bị sắp xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100303
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100303,
					"content": "Hai người này cha chưa từng gặp đấy. Là bạn mới à? Hay là khách?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100304
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100304,
					"content": "Đều đúng hết, các bạn ấy vừa mới đến đây không lâu, nếu đã đến Inazuma mà không ngắm pháo hoa thì sao được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100305
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100305,
					"content": "Ha ha ha, tìm nơi nghỉ ngơi đã. Rồi Naganohara Ryuunosuke ta sẽ kể cho các cháu nghe về lịch sử lâu đời của nhà Naganohara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100306,
					"content": "Chuyện này để sau đã, con có chuyện cần hỏi cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100307
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100307,
					"content": "Ngày xửa ngày xưa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100308
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100308,
					"content": "Haiz, cha lại bắt đầu kể chuyện một mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100309
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100309,
					"content": "Ngại quá, trước kia cha bị thương nên tai không được tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100310
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100310,
					"content": "Vậy sao? Nhưng cuộc trò chuyện vừa nãy rất mạch lạc mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100311,
					"content": "Sau đó mọi người phải mất một thời gian rất dài mới biết có một loại khoáng thạch mà bột của nó có thể đốt lên những màu sắc tuyệt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100312
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100312,
					"content": "Cha, cha, khoan đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100313
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100313,
					"content": "Hả? Sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100314
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100314,
					"content": "Nguyên liệu đã đặt mua để làm pháo hoa đã gửi đến chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100315
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100315,
					"content": "Pháo hoa của hôm qua đã gửi đi rồi, hôm trước, hôm kia cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100316
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100316,
					"content": "Không phải, con nói là nguyên liệu, số nguyên liệu đã đặt mua trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100317
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100317,
					"content": "Pháo hoa hôm nay cũng làm sắp xong rồi, đừng lo, tay nghề của cha vẫn chưa mai một đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100318
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100318,
					"content": "Không phải, là nguyên liệu! Khoáng thạch dùng để làm pháo hoa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100319
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100319,
					"content": "Cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100320
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100320,
					"content": "Nguyên liệu khoáng thạch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100321
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100321,
					"content": "À à, nguyên liệu khoáng thạch hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100322
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100322,
					"content": "Đúng đúng đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100323,
					"content": "A, xin lỗi...cuối cùng cũng truyền đạt được rồi, tôi hơi bị kích động, ahihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100324,
					"content": "Nguyên liệu vẫn chưa đến, họ có nói nguyên nhân, nhưng cha không nghe rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100325
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100325,
					"content": "Không sao không sao, biết tin này là được rồi, vậy thì trễ chút mới làm vậy. Chờ họ gửi đến, cha nhớ nhận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100326
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100326,
					"content": "Ừ ừ, con yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100327
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120100327,
					"content": "Ngại quá, làm ồn tới các bạn rồi. Nếu có chuyện gì cần hỏi cha thì có hơi phiền một chút, như nãy giờ vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100328,
						120100330
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100328,
					"content": "Nhưng tôi lại thấy rất nhiệt tình hiếu khách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100329
					]
				},
				{
					"id": 120100329,
					"content": "Hi hi, đúng vậy, cha tôi là người rất tốt, ai cũng rất kính trọng cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100332,
					"content": "Cha không nghe rõ, nên chưa từng tranh cãi với người khác, cũng không phủ nhận lời người khác nói, cứ hớn hở nghe thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100333
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100333,
					"content": "Khi còn nhỏ tôi tưởng rằng cha là người hiểu tôi nhất, nghĩ là mình nói gì cũng đúng, nên có chuyện gì tôi cũng nói với cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100334
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100334,
					"content": "Sau này tôi mới biết, cha luôn cười hỉ hả như vậy là vì ông ấy không nghe rõ, nhưng tôi vẫn ngày ngày kể chuyện cho cha nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100335
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100335,
					"content": "Ơ? Vì sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100336,
					"content": "Chỉ cần nhìn thấy cha cười là tôi cũng rất vui. Như vậy cha cũng sẽ không cô đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100337
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100337,
					"content": "À, nhưng mà, nguyên liệu chưa được chuyển đến, trong khi lễ hội pháo hoa đã ở ngay trước mắt rồi, chúng ta phải nghĩ cách khác thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100338
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100338,
					"content": "Yoimiya về rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100339
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100339,
					"content": "Á?! Đừng có hù người ta vậy chứ, không phải đã bảo anh đừng có nói chuyện đột ngột rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100340
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100340,
					"content": "Xin, xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100341
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100341,
					"content": "Anh chờ tôi một chút, tôi qua ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100330,
					"content": "Nhưng tôi thấy tính cách của ông ấy rất giống bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100331
					]
				},
				{
					"id": 120100331,
					"content": "Hi hi, ai cũng nói vậy hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201004,
			"completionStepIds": [
				1201004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201004",
							"2"
						],
						"stepId": 1201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100401,
					"content": "Không có ai nhìn bên này hết, ra đi, đến bên hông nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100402,
					"content": "May mà không kinh động đến người của Hiệp Hội Tenryou, nếu không thì chúng ta gặp nguy hiểm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100403
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100403,
					"content": "Tại tôi nóng vội quá, nhưng tôi nghe nói cô trở về, nên mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100404
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100404,
					"content": "Yên tâm, Sakujirou, ít ra bây giờ mọi việc vẫn nằm trong kế hoạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100405,
					"content": "Lát nữa chúng tôi sẽ đi tìm nguyên liệu làm pháo hoa, tiện thể sẽ lo luôn chuyện tàu thuyền, là chuyện đã hứa với anh lúc trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100406
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100406,
					"content": "Cám ơn cô đã giúp tôi nhiều đến thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100407,
						120100408
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100407,
					"content": "Người này là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				},
				{
					"id": 120100409,
					"content": "Trước đây anh ấy là khách của nhà chúng tôi, cách đây không lâu đã trốn về Inazuma từ bên ngoài, kết quả là bị phát hiện lúc đang lén vượt biển, bây giờ đang bị Hiệp Hội Tenryou truy nã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100410
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100410,
					"content": "Truy nã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100411,
					"content": "Bạn nhỏ tiếng thôi, đừng gây chú ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100412,
					"content": "Nếu bị bắt thì không biết Sakujirou sẽ bị phán tội gì đâu, để giúp anh ấy tránh được hiểm họa này, chỉ có thể nghĩ cách tìm thuyền để đưa anh ấy đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100413
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100413,
					"content": "Nhưng vùng biển bên ngoài không phải có sấm sét sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100414
					]
				},
				{
					"id": 120100414,
					"content": "Đúng vậy, đây cũng là cách vô cùng nguy hiểm, nhưng bây giờ không còn nhiều sự lựa chọn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100415
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100415,
					"content": "Lỡ như không cẩn thận lật thuyền, thì...hu hu! Rơi xuống nước sợ lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100416,
					"content": "Nếu nguy hiểm như vậy thì ban đầu đừng quay về không phải được rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100417,
					"content": "Bởi vì có việc không thể không làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100418
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100418,
					"content": "Nhưng vừa về đến lại nghe nói đến rất nhiều thay đổi khó tin. Vốn dĩ tôi đã quyết tâm, nhưng bây giờ lại không biết nên làm thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100419
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100419,
					"content": "Tôi cũng không muốn gây phiền phức cho Yoimiya và ông Ryuunosuke, họ chịu cho tôi ở lại là tôi đã biết ơn lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100420
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100420,
					"content": "Không sao, đừng khách sáo. Còn nhớ lời tôi nói không, \"Chỉ cần có mẩu giấy của nhà chúng tôi, thì vẫn luôn là khách của Naganohara.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100421
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100421,
					"content": "Mẩu giấy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100422,
						120100423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100422,
					"content": "Hình như có chút ấn tượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100424,
					"content": "Ừm, thứ mà bọn trẻ lấy cũng giống như vậy. Chỉ cần là khách muốn đặt làm pháo hoa để kỷ niệm một việc gì đó, thì chúng tôi sẽ tặng kèm một mẩu giấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100425
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100425,
					"content": "Nội dung trên mẩu giấy chỉ có người nhà chúng tôi đọc hiểu, đó là công thức để chế tạo loại pháo hoa này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100426
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100426,
					"content": "Chỉ cần xem mẩu giấy này, thì cho dù mười năm hay một trăm năm đi nữa, Naganohara vẫn có thể bảo đảm làm ra được loại pháo hoa y hệt năm xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100427
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100427,
					"content": "Woa, nghe hay ho ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100428,
					"content": "Truyền thống xưa nay rồi, chỉ cần là khách quen thì ai cũng biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100429
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100429,
					"content": "Ừm, lúc đó cha mẹ tôi đã tìm chú Ryuunosuke để làm pháo hoa, bây giờ nghĩ lại, cũng đã 20 năm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100430
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100430,
					"content": "Haiz, không ngờ bây giờ lại trở thành thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100431
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100431,
					"content": "Không sao đâu, trừ phi bất đắc dĩ mới phải lên thuyền rời khỏi Inazuma thôi. Tôi vẫn sẽ giúp anh nghĩ cách khác, nếu có thể ở lại đương nhiên tốt hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100432
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100432,
					"content": "Dù cho bất cứ nguyên nhân gì, chỉ cần là khách tìm đến nhờ giúp đỡ, thì không thể để họ thất vọng trở về được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100433
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100433,
					"content": "Cám ơn cô, vậy thì tôi vẫn còn chút thời gian để suy nghĩ thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100434
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100434,
					"content": "Được rồi, đừng đứng ở ngoài quá lâu, mau vào nhà đi. Chờ tôi có tin sẽ về nói cho anh biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100435
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100435,
					"content": "Ừm, phiền cô quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100436
					],
					"speakerTitle": "Sakujirou"
				},
				{
					"id": 120100436,
					"content": "Haiz, rõ ràng là người Inazuma chính gốc lại không được phép trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100437
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100437,
					"content": "Đúng rồi, các bạn cũng vừa mới đến Inazuma gần đây thôi nhỉ, làm sao có được giấy phép thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100438
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100438,
					"content": "Tôi đã làm thủ tục Đảo Ritou rất phiền phức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100439
					]
				},
				{
					"id": 120100439,
					"content": "Rồi nhờ vào sự giúp đỡ của tiểu thư Hiiragi Chisato của Hiệp Hội Kanjou mới thuận lợi đến được đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120100440,
					"content": "Thì ra là vậy, có nhân vật lớn giúp đỡ. Vậy xem ra cũng không tham khảo được cho Sakujirou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100441
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100441,
					"content": "Haiz, nếu các hiệp hội của chúng tôi có thể châm chước một chút thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100442
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100442,
					"content": "Những nơi mà các bạn đã từng đến chắc đều không giống Inazuma nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100443,
						120100444
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120100443,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100445,
					"content": "Haiz, dù sao vẫn phải nghĩ cách giúp anh ấy.",
					"roleType": "TALK_ROLE_NPC",
