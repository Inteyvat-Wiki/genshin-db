			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "Đây là kết tinh từ một sức mạnh nào đó... Nhưng, Lisa, cô có thể phân tích kết cấu của nó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700402,
					"content": "Ừm, để tôi xem xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700403,
					"content": "Có thể thấy trong kết tinh có chút tạp chất nhiễm bẩn, nhưng muốn nghiên cứu kỹ hơn thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700404,
					"content": "Thật xin lỗi, hiện giờ vẫn chưa có kết luận có ích. Cho tôi chút thời gian, tôi đến khu để sách cấm tìm tài liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700405,
					"content": "Vậy thì Lisa, sau này việc nghiên cứu điều tra sẽ giao cho cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700406,
					"content": "Ừ, nếu có tiến triển gì, tôi sẽ thông báo cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700407,
					"content": "Nhưng mà, cũng đừng mong chờ ghi chép từ thời thượng cổ sẽ giúp ích gì. Mà...Haizz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700408,
					"content": "Á... đau quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700409,
					"content": "Tạp chất trong kết tinh, khi đến gần, sẽ khiến tôi có cảm giác bị đâm vào người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700410,
					"content": "Vậy sao, hóa ra là... tương khắc với Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700411,
					"content": "Sức mạnh nhiễm bẩn này, tương khắc với sức mạnh Nguyên Tố trong cơ thể chúng ta, tự giết lẫn nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#Nhưng mà, cũng thật kỳ lạ. {NICKNAME} rõ ràng cũng có thể dùng sức mạnh Nguyên Tố, nhưng lại không bị ảnh hưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700415,
					"content": "Đứa trẻ đáng yêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "Được, cứ vậy mà làm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "Tóm lại, viên kết tinh này cứ để đứa trẻ đáng yêu giữ đi. Để ở chỗ chúng tôi cũng chỉ khiến chúng tôi bị đau thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700417,
					"content": "...Thật là hiện tượng không thể ngờ tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700418,
					"content": "Đối với việc này bạn có chút manh mối nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700420,
					"content": "Tôi nghĩ cũng phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700421,
					"content": "#Vậy thì, {NICKNAME}. Đây là khẩn cầu thứ 2 của Đội Kỵ Sĩ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700422,
					"content": "Hãy chấp nhận chức vị Kỵ Sĩ Danh Dự của đội kỵ sĩ... và lời cảm ơn của Đội Trưởng Đại Diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700424,
					"content": "Kỵ Sĩ Danh Dự... của Tây Phong?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700426,
					"content": "Cũng mong bạn giúp chúng tôi lần nữa, tìm ra đáp án của những việc rắc rối này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "Jean"
