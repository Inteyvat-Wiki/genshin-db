			"dialogs": [
				{
					"id": 3700201,
					"content": "Í? Đó không phải đội trưởng Jean sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700202,
					"content": "Cô ấy hình như đang nói chuyện với ai đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700203,
					"content": "Đợi họ nói xong, chúng ta qua đó chào một tiếng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700204,
					"content": "...Cho nên, thái độ của chúng tôi là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700205,
					"content": "Nếu không thể lập tức tiêu diệt Ma Long, chi bằng hãy giao việc phòng thủ của thành Mondstadt cho Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700206,
					"content": "Tai nạn rồng của Mondstadt có thể xử lý được, chỉ cần chúng tôi khiến con dã thú đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700207,
					"content": "\"Dã thú\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700208,
					"content": "Hử? Ý của Đội Trưởng Đại Diện đại nhân là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700209,
					"content": "Hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700210,
					"content": "Hy vọng quan ngoại giao của quý quốc có thể có thái độ chuyên nghiệp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700211,
					"content": "Các ngài định \"xử lý\" một trong Tứ Phong Thủ Hộ của Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700212,
					"content": "Tôi không hy vọng có người nói năng điên rồ như vậy trước mặt Kỵ Sĩ Tây Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700213,
					"content": "He... hehehe.... cũng không điên như cô nói nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700214,
					"content": "Tốt lắm, cuộc đàm phán hôm nay kết thúc ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700215,
					"content": "Kết quả lần này là \"hai bên trao đổi ý kiến góp ý chân thành\", phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700216,
					"content": "Tôi sẽ... ghi lại kỹ càng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700217,
					"content": "#A, {NICKNAME}, bạn quay lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700218,
					"content": "Rất cảm ơn sự hỗ trợ của bạn, sự tuần hoàn của Nguyên Tố xung quanh thành phố cuối cùng cũng ổn định lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700219,
					"content": "Tàn dư của lần Phong Ma Long tập kích lúc trước, coi như tạm thời giải quyết xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700220,
					"content": "Nhưng mà, áp lực do sứ đoàn gây ra đã không thể xem thường được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700221,
					"content": "Sứ đoàn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700222,
					"content": "Là sứ đoàn ngoại giao à... đến từ Liyue? Hay là Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700223,
					"content": "Là Snezhnaya, đất nước thờ phụng Băng Thần trong bảy vị thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700224,
					"content": "Sứ giả của bọn họ có cái tên đặc biệt: Fatui - đã từng nghe nói qua chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700225,
					"content": "A, hóa ra là \"Fatui\". Quả thực đã từng nghe nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700226,
					"content": "Nhưng mà, danh tiếng không được tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700227,
					"content": "Tôi không nghĩ rằng giết chết Phong Ma Long là hành vi đúng đắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700228,
					"content": "Hơn nữa, Fatui do Băng Thần lãnh đạo, rất thèm muốn sức mạnh thuộc về Phong Thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700229,
					"content": "Chuyện này vốn dĩ đã rất khả nghi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700230,
					"content": "Nói đến \"sức mạnh\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#Sao vậy, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700232,
					"content": "Có món đồ muốn cho Đội Kỵ Sĩ xem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "Hở? Được, vậy thì chúng ta về tổng bộ Đội Kỵ Sĩ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700234,
					"content": "Đừng ở... nơi này bàn chuyện quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
