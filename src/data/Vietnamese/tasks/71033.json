					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331402,
					"content": "#Chú và {F#chị}{M#anh} này cần đi công chuyện chút, làm xong chúng ta chơi tiếp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331403,
					"content": "Í, chú Qingzhou, chú phải đi làm chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 710331404,
					"content": "Chú và một vị hoạ sĩ đã hẹn... so tài, chú phải viết một bài thơ hay nhất, còn chú ấy sẽ vẽ tranh để so tài, xem ai làm tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331405,
					"content": "Úi chà, vậy nhất định là chú Qingzhou thắng rồi, bao nhiêu câu đố đèn như vậy, bài thơ nào cũng hay tuyệt cú mèo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331406,
					"content": "Vậy sao, cảm ơn mấy đứa khen ngợi. Mấy đứa hãy cầm Đèn Tiêu này trở về Khinh Sách Trang từ từ đoán nhé, bên ngoài không an toàn lắm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331407,
					"content": "Chú yên tâm đi, tụi cháu quen đường ở đây rồi, tự mình có thể đi về, chú mau đi đánh bại vị hoạ sĩ kia đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331408,
					"content": "Vậy... chú ơi, sau khi chú và hoạ sĩ kia so tài xong hãy mau về đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "You"
				},
				{
					"id": 710331409,
					"content": "Đương nhiên rồi, chờ xong việc, chú sẽ đi tìm mấy đứa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331410,
					"content": "Đây đúng là một bài thơ hay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "Bài thơ này có thể thắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "Ha ha, thơ gì chứ, đây chỉ là một câu đố đèn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331413,
					"content": "Được rồi, chúng ta đi tìm hoạ sĩ kia đi, chắc chắn anh ấy đã sốt ruột lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
