			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "Nhà Lữ Hành, Nhà Lữ Hành, ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330102,
					"content": "Bạn là hoạ sĩ lần trước đã hẹn với Qingzhou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "Chính là tôi, tôi và nhà thơ đó đã hẹn, mỗi người tự sáng tác một tác phẩm nghệ thuật khái quát Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330104,
					"content": "Lần trước bạn còn giúp tôi đi tìm nguyên liệu đó, chắc bạn vẫn nhớ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330105,
					"content": "Vẫn nhớ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "Tranh của tôi... Khụ, cái này à... thực ra tôi đã vẽ rất nhiều, phong cảnh, nhân vật, thậm chí là động vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330108,
					"content": "Tôi tự tin rằng những bức tranh ấy đều diễn tả chính xác nội dung cần biểu đạt, nhưng... chẳng có bức nào có thể xem như khái quát được Tết Hải Đăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330109,
					"content": "Haiz, mấy ngày nay tôi ăn không ngon ngủ không yên, màu vẽ cũng sắp hết rồi mà vẫn chưa vẽ ra được bức tranh kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330110,
					"content": "Cho nên, tôi muốn đi tìm nhà thơ nọ, xem thử thơ văn của anh ấy viết ra sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330111,
					"content": "Nhà Lữ Hành, bạn biết nhà thơ nọ đi đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330112,
					"content": "Anh ấy đến Khinh Sách Trang rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "Khinh Sách Trang? Anh ấy đến đó làm gì... Lẽ nào, anh ấy muốn tìm đề tài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330114,
					"content": "Mau, Nhà Lữ Hành, chúng ta mau đến Khinh Sách Trang tìm anh ấy! Nếu nơi đó thích hợp, chưa biết chừng tôi cũng có thể tìm thấy nguồn cảm hứng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330115,
					"content": "Khụ! Tóm lại, chúng ta mau xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330106,
					"content": "Vậy tranh của bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
