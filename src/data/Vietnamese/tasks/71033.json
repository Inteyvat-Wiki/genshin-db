				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "Cuối cùng anh cũng tới rồi, anh đã làm thơ xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331102,
					"content": "Tôi chưa viết ra một bài thơ thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331103,
					"content": "Anh... anh cũng... Hừm, sao anh chưa viết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331104,
					"content": "Liyue rộng lớn, nhà nhà treo Đèn Tiêu, tôi nghĩ đi nghĩ lại cũng không thể dùng một bài thơ để khái quát, anh vẽ tranh xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331105,
					"content": "Tôi... tôi cũng chưa... Liyue rộng lớn như vậy! Biết vẽ thế nào đây, nếu tôi muốn vẽ thì phải dùng bầu trời làm giấy vẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331106,
					"content": "Nói vậy là, hai ta đều chưa sáng tác ra được thơ và tranh khái quát Cảng Liyue và Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331107,
					"content": "Vậy, coi như là \"hoà\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331108,
					"content": "Ừm... thôi được, vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331109,
					"content": "Chú Qingzhou! Chú Qingzhou! Câu đố đèn mà chú đưa cho chúng cháu, chúng cháu đoán ra rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331110,
					"content": "Câu... câu đố đèn? Đố đèn gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331111,
					"content": "Không cần bận tâm, vì tôi vui đùa cùng đám trẻ này nên ra câu đố đèn cho chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331112,
					"content": "Hửm? Là câu đố đèn gì vậy, có thể nói cho tôi nghe thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331113,
					"content": "\"Ngàn vạn con thuyền lướt trên sông, ánh nến soi sáng khoảng trời đêm. Cùng ra biển lớn theo dòng sáng, an giấc ngàn thu tại long cung.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331114,
					"content": "Đây là câu đố đèn mà bạn viết cho tụi nhỏ? Cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331115,
					"content": "Chú Qingzhou ơi, chú này là ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331116,
					"content": "Anh ấy chính là hoạ sĩ đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "Thật là, nếu không muốn so tài cùng tôi, vậy thì hứa hẹn với tôi làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331119,
					"content": "Bạn hiểu lầm rồi, lúc trước tôi thật sự có ý nghĩ muốn... quyết đấu thắng thua với bạn, đi khắp nơi tìm đề tài, dốc hết tâm sức viết ra một bài thơ hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331120,
					"content": "Nhưng chắc bạn cũng cảm nhận thấy rồi đó, chỉ dựa vào đôi câu vài lời thì không thể khái quát Cảng Liyue và Tết Hải Đăng được. Cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331121,
					"content": "Cho nên, bạn muốn chạy tới đây chơi cùng đám trẻ? Ra câu đố đèn cho chúng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331122,
					"content": "Đúng vậy, cho nên tôi tới đây chơi cùng đám trẻ, ra câu đố đèn cho chúng, muốn tìm thêm nguồn cảm hứng để làm thơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331123,
					"content": "Ha ha, nhưng nguồn cảm hứng tìm không thấy, lại làm ra được rất nhiều câu đố đèn, tụi trẻ cũng rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331124,
					"content": "Có lẽ... đây chính là bài \"thơ\" mà tôi đang tìm kiếm. Đáng tiếc, tôi không thể viết nó lại, cũng không thể phân định thắng thua với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331125,
					"content": "Người... người Liyue các bạn, đúng là kỳ lạ lắm luôn! Vậy cuộc so tài giữa hai ta rốt cuộc phải tính ra sao? Ai thua ai thắng? Tôi sẽ không chấp nhận hoà đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331126,
					"content": "Chú này sao mà cứ càm ràm vậy... chắc chắn là chú Qingzhou thắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331127,
					"content": "Chú ấy lợi hại lắm, ra biết bao nhiêu là câu đố đèn, chú chắc chắn sẽ không đoán nổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710331128,
					"content": "Nhà thơ như bạn đây... Ừm? Chờ đã, tôi có ý này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331129,
					"content": "Vậy, thế này đi! Hai ta so tài lại lần nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331130,
					"content": "Hửm? Vậy bạn muốn so tài lại như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331131,
					"content": "Chẳng phải bạn ra câu đố đèn cho đám trẻ này ư? Khi tôi đang tìm đề tài, cũng nhìn thấy rất nhiều hoa văn của Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331132,
					"content": "Hai chúng ta, một người ra câu đố đèn, một người vẽ Đèn Tiêu, để tụi nhỏ đánh giá xem chúng thích ai hơn, bạn thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331133,
					"content": "Được! Đúng với ý tôi, cũng hợp với Tết Hải Đăng, nếu vậy thì còn gì bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331134,
					"content": "Cứ vậy đi, chờ tôi thu dọn xong dụng cụ vẽ, chúng ta sẽ so tài lại ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331135,
					"content": "Hai bạn đúng là hăng hái...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "Tới đây, mấy đứa, giúp chú xem thử xem câu đố đèn mà nhà thơ này viết, chú vẽ cho mấy đứa Đèn Tiêu thật là đẹp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710331138,
					"content": "Ha ha, chỉ e tốc độ vẽ Đèn Tiêu của bạn không bắt kịp tốc độ ra câu đố đèn của tôi.",
					"roleType": "TALK_ROLE_NPC",
