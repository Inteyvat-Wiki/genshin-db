			"dialogs": [
				{
					"id": 710331201,
					"content": "Ừm? Các cháu có việc gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331202,
					"content": "Về cuộc so tài giữa Qingzhou và Vermeer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "Cháu nói hai người đó à, không sao, không sao, họ đồng ý chơi cùng tụi trẻ là tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331204,
					"content": "Ngày lễ ngày tết, phải nào nhiệt mới tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331205,
					"content": "Đứa trẻ này, chạy đông chạy tây suốt vì Khinh Sách Trang chúng ta, vất vả cho cháu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331206,
					"content": "Không sao ạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "Đứa trẻ như cháu đây đúng là nhiệt tình... Những thứ này hãy nhận lấy nhé, cảm ơn cháu, cháu cũng đón Tết vui vẻ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331209,
					"content": "Hi vọng những lần Tết Hải Đăng sau, nơi này cũng có thể náo nhiệt như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710331207,
					"content": "Bà đừng khách sáo ạ.",
					"roleType": "TALK_ROLE_PLAYER",
