				},
				{
					"id": 710331004,
					"content": "Ha ha ha, chú đã viết xong câu đố đèn lần này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710331005,
					"content": "Nhà Lữ Hành, bạn hãy giúp tôi một việc nhé, đem Đèn Tiêu này treo lên, cao một chút.",
