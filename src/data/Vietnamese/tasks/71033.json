			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "Ái chà, chào cháu, Nhà Lữ Hành, cảm ơn cháu nhiều, bây giờ trong Khinh Sách Trang coi như cũng có chút bầu không khí lễ hội rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330402,
					"content": "Í? Người bên cạnh cháu trông là lạ, vị này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330403,
					"content": "Đây là một hoạ sĩ, đến tìm Qingzhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "Tìm Qingzhou tiên sinh? Ừm, vừa hay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330405,
					"content": "Lúc tiểu thư Wang'ya rời đi mấy hôm trước, Qingzhou tiên sinh nói rằng còn muốn ở lại đây thêm một khoảng thời gian nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330406,
					"content": "Bây giờ Qingzhou còn đang chơi đoán câu đố đèn với đám trẻ kìa, bà nghĩ, ngài ấy dẫn đám trẻ ra ngoài rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330407,
					"content": "Nếu muốn tìm ngài ấy, chắc phải ra ngoài tìm xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 710330408,
					"content": "Đúng là anh ấy đang chơi giải đố đèn... Nhà Lữ Hành, vậy phiền bạn giúp tôi đi một chuyến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330409,
					"content": "Bạn đi nói với nhà thơ đó là tôi tới rồi, tôi ở đây chuẩn bị thêm một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330410,
					"content": "Bất luận ra sao, hôm nay nhất định phải phân định thắng thua với anh ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "Ha ha ha, mấy đứa cũng dần đoán được mẹo rồi, đoán càng ngày càng nhanh hơn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330502,
					"content": "Vermeer đến rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "Vermeer... À, hoạ sĩ đó, tôi nhẩm tính ngày, quả là đã đến lúc thực hiện lời hẹn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330505,
					"content": "Đáng tiếc, thơ của tôi cuối cùng vẫn chưa viết xong, đám nhóc này cũng còn chưa chơi đã đoán câu đố đèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330506,
					"content": "Ha ha, có lẽ thật sự là tài năng của tôi có hạn nhỉ... Vậy đi, bạn lại cùng tôi đi tìm nguồn cảm hứng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330507,
					"content": "Ừm... cũng không thể nói là tìm nguồn cảm hứng, cùng tôi đi tản bộ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330508,
					"content": "Chú Qingzhou! Không chơi đoán câu đố đèn nữa ư?? Cháu còn muốn đoán tiếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330509,
					"content": "Cháu cũng muốn đoán câu đố đèn, chú Qingzhou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 710330510,
					"content": "Ừm, cháu cũng muốn đoán thêm mấy câu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "You"
				},
				{
					"id": 710330511,
					"content": "#Ha ha, đừng gấp, đợi chú và {F#chị}{M#anh} này đi một vòng là sẽ có câu đố đèn mới thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330512,
					"content": "Các cháu cứ về Khinh Sách Trang trước đi, tới lúc đó chú sẽ đi tìm các cháu, như vậy được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330513,
					"content": "Được thôi! Chú Qingzhou quả là lợi hại, có thể nghĩ ra nhiều câu đố đèn như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "Zuo"
				},
				{
					"id": 710330514,
					"content": "Chú Qingzhou chắc chắn đã đọc rất nhiều rất nhiều sách đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 710330515,
					"content": "Nếu sau này mình cũng có thể giỏi như chú Qingzhou thì tốt biết mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330516
					],
					"speakerTitle": "You"
				},
				{
					"id": 710330516,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330517
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330517,
					"content": "Nhà Lữ Hành, chúng ta mau xuất phát thôi, mau giải quyết những chuyện vặt kia đi, đừng để đám nhóc này sốt ruột.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 710330503,
					"content": "Bạn còn nhớ cuộc hẹn với Vermeer chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				}
			]
		},
