			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "Đây chính là Khinh Sách Trang nhỉ... nhà thơ đó đâu? Chạy đi đâu tìm đề tài rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330302,
					"content": "Lần trước anh ấy đang cùng tụi trẻ chơi đoán câu đố đèn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "Chơi... chơi giải đố đèn? Chuyện này là... thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330304,
					"content": "Có phải anh ấy vì không tìm được nguồn cảm hứng nên chuẩn bị nhận thua không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330305,
					"content": "Thôi, dù anh ấy đang làm gì, trước mắt cũng chẳng còn mấy ngày nữa là đến Tết Hải Đăng, không thể kéo dài thêm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710330306,
					"content": "Chúng ta đi tìm quản gia của nơi này hỏi thử xem, hôm nay tôi nhất định phải phân cao thấp với anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
