				{
					"id": 20080314,
					"content": "Raiden Shogun sẽ tổ chức \"Nghi Thức Săn Vision\" cho Vision thứ 100 ở trước \"Tượng Trăm Mắt Nghìn Tay\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080315,
					"content": "Mà người nắm giữ Vision thứ 100...cũng chính là đối tượng sắp bị công khai truy lùng, e là...Thoma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080316,
					"content": "Chẳng lẽ nghi thức mà Hiệp Hội Tenryou đang chuẩn bị, chính là \"Nghi Thức Săn Vision\" chuẩn bị cho bạn ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080317,
					"content": "Chắc...là vậy, Shogun và người của Hiệp Hội Tenryou chuẩn bị dùng \"Nghi Thức Săn Vision\" cho Vision thứ 100 để chứng minh thành quả cho một giai đoạn săn lùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080318,
					"content": "...Không được, tôi phải đi cứu anh ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080319,
					"content": "Gâu! Gâu! Gâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080320,
					"content": "Bình tĩnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "Nhưng \"Shirasagi Himegimi\" cũng đại diện cho Hiệp Hội Yashiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "Đúng thế, nếu bạn đích thân đến đó, thì chẳng phải chứng tỏ Hiệp Hội Yashiro muốn đối địch với Raiden Shogun rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080323,
					"content": "Nếu công khai phản đối Raiden Shogun, thì những người bình thường của Hiệp Hội Yashiro cũng sẽ bị liên lụy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080324,
					"content": "Không còn cách nào khác... đã không đủ thời gian nữa, nghi thức sắp bắt đầu rồi, tôi không thể bỏ mặc Thoma được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080325,
					"content": "Anh ấy là bạn tốt của tôi, rõ ràng vừa mới đây chúng ta còn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080326,
					"content": "Bạn ấy cũng là bạn tôi, để tôi đi cứu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080328,
					"content": "Bạn cũng vừa nói đấy, không đủ thời gian rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080330,
					"content": "...Ừm, tôi sẽ...chờ các bạn bình an trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080331,
					"content": "Yên tâm đi, Ayaka, chuyện liên quan đến tính mạng của bạn bè, chúng tôi sẽ không sơ sẩy đâu!",
					"roleType": "TALK_ROLE_NPC",
