			"dialogs": [
				{
					"id": 200530101,
					"content": "Thật nhức đầu... ở đây phải giải quyết như thế nào chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "Vì đợt tuyển chọn kỵ sĩ sắp tới, tôi đang phải huấn luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530104,
					"content": "Ừm... nhưng mà, tôi không có sức mạnh như đại nhân Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530105,
					"content": "So với việc tập luyện \"sức mạnh\", tôi cảm thấy việc học \"kỹ năng\" thích hợp với tôi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530106,
					"content": "Ví dụ, cách làm sao để phá hủy các cột gỗ này cùng lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530107,
					"content": "Nếu bạn rảnh, hãy cùng suy nghĩ với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530108,
					"content": "Để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "Không sao, cứ từ từ nghĩ, cột gỗ không tự chạy đi mất được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530111,
					"content": "Thứ duy nhất chạy đi mất chỉ có thời gian và sinh mệnh bị tiêu phí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530114,
					"content": "Với khoảng cách này, tự ứng phó một bên, ném một đạn nổ để nổ tung một bên, là lựa chọn tốt nhất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530115,
					"content": "Hahaha tôi nói đùa đấy, đạn nổ làm sao dễ dàng tìm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530109,
					"content": "Hai người chúng ta cùng xông lên...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "Bạn có quen với việc tác chiến tập thể không? Thật là ngưỡng mộ... lúc nào cũng có thể gọi được người giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530113,
					"content": "Giống như tôi, chỉ có thể học cách chiến đấu một mình thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
