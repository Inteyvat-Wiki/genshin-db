				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "Xem ra bạn cũng rất thích ẩm thực mà. Các món ăn ở Liyue rất ngon, nếu có cơ hội hãy đi nếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001302,
					"content": "Có liên quan đến Nham Vương Gia hay không ư? Haha bạn đừng nói nữa, trong cảng Liyue có rất nhiều quán ăn ghi dòng chữ \"quán gia truyền\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001303,
					"content": "Bạn muốn có chứng cớ, nhất định là các chủ quán ở đó sẽ nói vào một ngày tháng năm nào đó, Nham Vương Gia từng đến đây ăn gì đó, tấm tắc khen món canh nào ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001304,
					"content": "Các truyền thuyết ấy khó phân thật giả. Thế nhưng bạn có thể thấy rằng, Nham Vương Gia xuất hiện ở cảng Liyue đã từ rất lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001305,
					"content": "Các học giả nghiên cứu Liyue đều nói Nham Vương Gia là bậc \"trưởng lão lớn tuổi nhất thế giới này\", vì vậy cung kính coi ngài là \"Thần Lịch Sử\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001306,
					"content": "Thế nhưng Nham Vương Gia rốt cuộc sống trên đời này bao lâu rồi, tôi nghĩ cũng chẳng ai biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
