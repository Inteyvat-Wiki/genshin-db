			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "Như thế này là được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "Tôi đang khấn vái Nham Vương Gia. Xem ra bạn không phải người bản địa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000104,
					"content": "Đây là Ỷ Nham Điện, nơi thờ Nham Vương Gia. Dân chúng Liyue thường xuyên đến đây thắp hương, cầu mong may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000105,
					"content": "Thế nhưng tôi ở cách đây khá xa, không thể đến thường xuyên được, vì vậy mỗi lần đến đều ở lại lâu một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000106,
					"content": "Có điều, tôi cũng xem rất nhiều điển tích liên quan đến Nham Vương Gia, càng đọc càng thấy Nham Vương Gia là người lợi hại vô song...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000107,
					"content": "So với việc Nham Vương Gia làm cho Liyue, tôi có đi quãng đường dài hơn nữa cũng chẳng đáng là bao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000108,
					"content": "Đúng rồi, bạn có lẽ không biết nhiều về Nham Vương Gia, tôi có thể kể câu chuyện về ngài cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000109,
					"content": "Thế nhưng bạn chắc hẳn không có ấn tượng sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000110,
					"content": "Ừm... Chi bằng, bạn đến <color=#00E1FFFF>gần cảng Liyue</color> tìm một chút nguyên liệu, tôi phối hợp với chút đồ rồi kể cho bạn nghe câu chuyện Nham Vương Gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000111,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "Vậy mau đi đi, tôi đợi bạn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000113,
					"content": "Cụ thể là món gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "Chỉ cần là đồ có liên quan đến <color=#00E1FFFF>cảng Liyue</color>, hoặc <color=#00E1FFFF>Nham Vương Gia</color> là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000115,
					"content": "Có điều, những câu chuyện mà tôi biết không nhiều... Không biết có thể kể ra gì không",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000116,
					"content": "Đợi bạn tìm thấy rồi, chúng ta cùng ngồi xuống xem xét, mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
