		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Haha, là khoáng thạch sao, xem ra bạn rất hiểu ý nghĩa của \"Nham\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "Đối với người dân Liyue mà nói, ngoài việc đúc luyện, những khoáng thạch này thuở ban đầu còn có ý nghĩa vô cùng quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "Những người đầu tiên đến đây bắt đầu khai hoang, họ dùng đá dựng thành bếp, lại lấy chúng chạm vào nhau tạo nên lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "Có được lửa thì có thể làm cơm, có đồ ăn nấu chín mới có sức lực mà làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "Tất cả đều bắt nguồn từ \"đá\", cũng là ân điển của Nham Vương Gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "Theo đó, Nham Vương Gia trong một vài cuốn sách cổ, đã có danh hiệu [Thần Bếp].",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Những quán ăn, quán rượu mới khai trương đều thắp hương cho Nham Vương Gia hy vọng ngài phù hộ cho lửa bếp cháy mãi, làm ăn phát đạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "Lần sau đến quán cơm ở Liyue, cũng đừng có quên cầu nguyện với Nham Vương Gia vài câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "Ồ, đây là rau dại mà bạn hái về sao? Nhất định là tốn công sức lắm đây, vất vả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "Ừm.. Bạn đã nhìn thấy rồi chứ, hiện tại cảng Liyue rất phát triển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "Có điều thành phố có lớn cỡ nào cũng là được xây dựng lên từ viên gạch cục đá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "Tổ tiên chúng tôi khi mới đến đây chưa có nơi gọi là [cảng Liyue].",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Đều là dùng mồ hôi và xương máu khai hoang từng chút một, từ đó thành phố lớn như vậy mới dần hình thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "Bạn cũng biết đó, gần cảng Liyue có rất nhiền núi đá nhấp nhô, quả thực rất khó có thể cải tạo. Thế nhưng những loài thực vật này, vẫn có thể kiên cường lớn lên trong những núi đá ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Mà các loại cây này đều có công dụng riêng của nó, giúp đỡ rất nhiều cho tổ tiên khai hoang của chúng tôi. Chúng tôi cho rằng, đây là sự trợ giúp của Nham Vương Gia ban cho chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "Sự tích về sự phấn đấu của tổ tiên mãi được lưu truyền ở cảng Liyue. Đến nay, một số Nhà Mạo Hiểm rời cảng Liyue đi thám hiểm, cũng là chịu ảnh hưởng của sự tích ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "Ngoài việc kế thừa tinh thần quật cường của tổ tiên, họ còn coi Nham Vương Gia là \"Thần Khai Sáng\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Những Nhà Mạo Hiểm kiên cường như Nham Thạch, cũng là yêu cầu của họ đối với bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230012",
							"2"
						],
						"stepId": 2230012,
						"stateName": "QUEST_STATE_UNFINISHED"
