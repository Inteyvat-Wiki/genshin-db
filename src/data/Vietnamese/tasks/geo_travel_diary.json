				{
					"id": 223008001,
					"content": "Ồ... Cũng không để ý, đã kể nhiều câu chuyện như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008002,
					"content": "Sao rồi, bạn cảm thấy bản thân đã hiểu được Nham Vương Gia bao phần rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008003,
					"content": "Có cảm giác hiểu thêm một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "Cũng được, nhưng chuyện của Nham Vương Gia không chỉ có vậy, lần sau có thời gian, chúng ta kể tiếp chuyện khác nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008005,
					"content": "Ơ? Bạn vẫn còn thống kê nhiều giấy nhớ thế sao...chăm chỉ thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008006,
					"content": "Vậy đi, hãy đưa số giấy nhớ này cho tôi trước, khi nào có thời gian tôi sẽ gom góp một số câu chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008007,
					"content": "Đến lúc đó tôi sẽ làm thành một quyển sổ tay cho bạn, bao gồm cả những câu chuyện trong mấy tờ giấy nhớ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008008,
					"content": "Nhưng chuyện của Nham Vương Gia rất nhiều, tôi phải gom góp từ từ, chắc hơi mất thời gian đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008009,
					"content": "Hãy nhận lấy những thứ này trước, cám ơn bạn đã đồng ý nghe tôi kể chuyện.",
					"roleType": "TALK_ROLE_NPC",
