				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "Í, món đồ này từ đâu ra vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "Nghe nói, bây giờ chỉ có Ngọc Kinh Đài có thể nhìn thấy cái đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "Coi như bạn cũng có lòng, để nghe được câu chuyện về Nham Vương Gia, món đồ như vậy cũng tìm ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "Có điều, \"Bách Hợp Lưu Ly\" này cũng là chỉ nguồn gốc xây dựng thành phố cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "Không hiểu ư? Tôi đang ngẫm đặc trưng của Bách Hợp Lưu Ly là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "Đúng, quý giá, Bách Hợp Lưu Ly vô cùng quý giá, có thể bán với giá cực tốt, khiến bạn có thể kiếm được rất nhiều Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001207,
					"content": "Tên \"Mora\" bắt nguồn từ tên gọi khác của Nham Vương Gia \"Morax\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001208,
					"content": "Chính vì thế, Nham Vương Gia trong tư tưởng của mọi người cũng là \"Thần Tài\", bất luận là thương nhân từ nơi nào đến, cứ làm ăn là phải khấn, thắp nhang cho Nham Vương Gia trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "Bởi vì Nham Vương Gia là người giàu có nhất thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001210,
					"content": "Hơn nữa theo tôi biết, trong bảy vị thần... Nham Vương Gia là thần nhiều của cải nhất thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230013,
