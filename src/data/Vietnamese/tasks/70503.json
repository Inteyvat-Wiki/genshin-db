			"dialogs": [
				{
					"id": 705030101,
					"content": "Một ly Bọt Biển San Hô nhỏ... cám ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030102,
						705030103
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030102,
					"content": "Eula?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				},
				{
					"id": 705030104,
					"content": "Tôi... Tôi không sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030105
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030105,
					"content": "Ừm... Trông Eula không ổn lắm, cô ấy đã uống rất nhiều rượu trước khi đến đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030106,
					"content": "Tôi nhớ Bọt Biển San Hô được pha bằng cà phê. Uống cà phê sau khi uống rượu, woa, bụng của cô ấy có chịu nổi không đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030107,
					"content": "Vì cái bụng của Eula, hay là lén lén đưa nước lọc cho cô ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030103,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				}
			]
		},
		{
			"id": 7050302,
			"completionStepIds": [
				7050303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050303",
							"2"
						],
						"stepId": 7050303,
						"stateName": "QUEST_STATE_UNFINISHED"
