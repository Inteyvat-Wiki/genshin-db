					}
				]
			},
			"dialogs": [
				{
					"id": 765110101,
					"content": "Theo dự đoán của quý cô Nefer, trận đấu diễn ra đến lúc này, thì vị cao thủ kia cũng sắp tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110102
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110102,
					"content": "#Đúng vậy, anh Sieciech, cơn gió đêm đã đưa hơi thở của {M#cậu ấy}{F#cô ấy} đến rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110103,
					"content": "#Lâu lắm không gặp, {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110104,
					"content": "Tôi rất vui khi thấy hai người tươi tắn khỏe mạnh như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110105,
						765110106
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110105,
					"content": "Thì ra là Kazuha sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				},
				{
					"id": 765110107,
					"content": "Không ngờ Kazuha cũng đến Nod-Krai, lại còn đang trò chuyện với Người Giữ Đèn này nữa chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110108,
					"content": "Khoan đã, tình hình xung quanh... sao không khí căng thẳng thế nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110109,
					"content": "Căng thẳng là tất nhiên rồi. Dù sao thì giải đấu đã đi đến giai đoạn gay cấn, cao thủ võ thuật từ khắp nơi đều đang chờ đợi kết quả cuối cùng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110110,
						765110111
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110110,
					"content": "Đang thi đấu ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110112,
					"content": "Đúng vậy, chào mừng đến với đấu trường chung kết \"Giải Đấu Bình Tĩnh Có Giới Hạn Nod-Krai\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110113
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110113,
					"content": "So với những chiêu thức phóng khoáng, thi đấu sáng tạo, giải đấu lần này tập trung vào kỹ năng dùng vũ khí thuần túy hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110114
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110114,
					"content": "Thế nên, ban tổ chức mới ủy thác Hiệp Hội Nhà Mạo Hiểm mời kiếm khách hàng đầu của Đội thuyền Nam Thập Tự đến làm cố vấn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110115
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110115,
					"content": "Tôi hiểu rồi, lần này Kazuha là giám khảo của một cuộc thi võ thuật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110116,
					"content": "Đúng vậy, lúc đầu tôi cũng hơi bất ngờ, không ngờ tin tức về trận đấu đó lại truyền đến tận Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110117,
					"content": "Chị đại và mọi người mới tham gia triển lãm ở Thị Trấn Nasha cách đây không lâu, xử lý xong hết công việc ở đó rồi nên trong thời gian ngắn sẽ không quay lại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110118
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110118,
					"content": "Còn tôi thì lại khá rảnh, lại có chút kinh nghiệm từ \"Hội Đấu Võ Nam Thập Tự\", nên đã nhận lời mời của ngài Sieciech.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110119,
					"content": "May nhờ khả năng quan sát nhạy bén cùng những đánh giá rất khách quan của anh Kazuha, nhiều tình huống hỗn loạn trong trận đấu mới được phán đoán chính xác kết quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110120
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110120,
					"content": "Nhưng giờ lại gặp rắc rối rồi. Cả ba ứng viên cho ngôi vô địch đều có thế mạnh riêng, chẳng ai phá giải được chiêu thức của đối phương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110121
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110121,
					"content": "Cứ đấu như vậy thì mấy ngày mấy đêm cũng không có kết quả mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110122
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110122,
					"content": "Ôi, chiến đấu bất phân thắng bại sao? Đúng là chưa từng nghe qua chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110123,
					"content": "Theo tôi thấy, vẫn nên thực hiện phương án đó thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110124,
					"content": "Đúng vậy, vẫn phải phiền đến vị chuyên gia trong số các chuyên gia đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110125
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110125,
					"content": "#Ủa, sao lại chuyển hướng sang {NICKNAME} rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110126,
					"content": "#Nếu {F#cô}{M#cậu} có thể tung vài chiêu, cục diện bế tắc sẽ được phá vỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110127,
						765110128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110127,
					"content": "Muốn nhờ tôi thi đấu biểu diễn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110129,
					"content": "#Không, mà là nhờ {F#cô}{M#cậu}, quán quân Hội Đấu Võ Nam Thập Tự, bậc thầy trong giới võ học, đóng vai người thí luyện cuối cùng để chọn ra quán quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110130
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110130,
					"content": "#{F#Cô}{M#Cậu} sẽ lần lượt đấu với ba ứng viên, rồi chấm điểm dựa trên mức độ uy hiếp mà họ gây ra cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110131,
					"content": "Cuối cùng, người có điểm cao nhất sẽ giành ngôi quán quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110132
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110132,
					"content": "#Và để cảm ơn những đóng góp của {F#cô}{M#cậu} cho giải đấu, một nửa tiền thưởng dành cho quán quân sẽ trao cho {F#cô}{M#cậu}, coi như là thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110133
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110133,
					"content": "Còn cả cách này nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110134,
					"content": "Vừa giải quyết được rắc rối khi trận đấu rơi vào bế tắc, lại vừa nể mặt và mang lại lợi ích cho chúng tôi... Không hổ là Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110135,
						765110136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110135,
					"content": "Tôi quả thực chưa gặp qua chuyện như thế này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110137,
					"content": "Ha, thế thì cứ quyết định như vậy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110138
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110138,
					"content": "#Làm phiền rồi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110139
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110139,
					"content": "#Ba đối thủ đều có tuyệt kỹ riêng, tôi tin là {F#cô}{M#cậu} sẽ tận hưởng trận đấu và thể hiện được phong thái của quán quân mùa trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110136,
					"content": "Đúng là cách làm rất mới lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110128,
					"content": "Giúp góp vui cho mọi người?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110111,
					"content": "Võ thuật à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110106,
					"content": "Lâu rồi không gặp!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				}
			]
		}
	]
}