			"dialogs": [
				{
					"id": 716710101,
					"content": "Chà, bí cảnh này đúng là khó nhằn như lời Yelan nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710102,
					"content": "Không biết là điểm Địa Mạch nhiễu loạn này đã ghi chép những trận chiến gì nữa... Những binh sĩ bình thường thực sự có thể đối phó được sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710103,
						716710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710103,
					"content": "Cuộc chiến cục bộ trong chiến tranh Ma Thần chăng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				},
				{
					"id": 716710105,
					"content": "Hmm... Chắc cũng không đến mức đáng sợ như vậy đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710106,
					"content": "Các vị về rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710107
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710107,
					"content": "Hmm, thần sắc ung dung, chắc hẳn là đã có kết quả không tệ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710108
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 716710108,
					"content": "Đúng là đã gặp phải tình huống vô cùng nguy hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710109,
					"content": "Kể cho Keqing và Yelan nghe về tình hình chiến đấu bên trong...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716710110
					]
				},
				{
					"id": 716710110,
					"content": "Ra là thế... Vất vả cho hai vị rồi, làm tốt lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710111
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710111,
					"content": "Sau khi hai người đi vào bí cảnh, ma vật tràn ra đã giảm đi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 716710112,
					"content": "Tuy không thể trực tiếp loại bỏ điểm nhiễu loạn, nhưng đúng là đã làm suy yếu hoạt động của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 716710113,
					"content": "Nhờ vậy mà độ nguy hiểm của ma vật đã giảm đi đáng kể, ngay cả binh sĩ Thiên Nham Quân bình thường cũng có thể đẩy lùi được chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710115,
						716710116
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710115,
					"content": "Vào một lần là biết ngay nguy hiểm thế nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710117,
					"content": "#Sao tôi cảm thấy ý chí chiến đấu của {NICKNAME} cứ bùng cháy lên thế nhỉ... Lại còn xoa tay háo hức nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710118,
					"content": "#Lúc nãy, thư hỏa tốc gửi đến Ngọc Kinh Đài đã được hồi âm, Thiên Quyền Tinh và Khai Dương Tinh đã đồng ý hợp tác lâu dài với {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710119
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710119,
					"content": "#Nhờ sự cố gắng của {NICKNAME}, thậm chí chúng ta còn có thể tận dụng điểm Địa Mạch nhiễu loạn này một cách hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710120
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710120,
					"content": "#Sau đó, {NICKNAME} sẽ nhận được sự hỗ trợ toàn lực của đội đóng quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710121
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710121,
					"content": "#Trong thời gian điểm nhiễu loạn hoạt động, nếu {NICKNAME} muốn thì có thể tự do tấn công vào bí cảnh. Ma vật tràn ra ngoài sẽ do Thiên Nham Quân xử lý, để các chiến sĩ luyện tập luân phiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710122
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 716710122,
					"content": "Coi như là biến nguy thành an, chuyển họa thành phúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710123,
						716710124
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 716710123,
					"content": "Từ giờ trở đi, tôi nhất định sẽ dốc hết sức!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710125,
					"content": "Phù... Cuối cùng cũng có thể thở phào nhẹ nhõm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710126,
					"content": "Mà nói chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710127,
					"content": "Địa Mạch đúng là thứ kỳ diệu. Trong tương lai chúng ta phải nghĩ cách để điều tra thêm nhiều bí mật về nó mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716710128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710128,
					"content": "Không biết chúng ta có gặp được ai đó thông minh giúp tìm ra một cuốn sách... \"Bách Khoa Toàn Thư Địa Mạch\" không nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716710124,
					"content": "Nếu đã loại bỏ nguy hiểm thì tôi sẽ hỗ trợ khi cần thiết!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710125
					]
				},
				{
					"id": 716710116,
					"content": "Khó đối phó thì phải từ từ xử lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710117
					]
				},
				{
					"id": 716710104,
					"content": "Thảm họa Khaenri'ah chăng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716710105
					]
				}
			]
		}
	]
}