			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "Thì ra cô chính là Varesa, chúng tôi đã từng nghe qua về cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180202,
					"content": "#Tôi là Paimon, còn đây là {NICKNAME}, chúng tôi là đồng đội tốt nhất của nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180203,
					"content": "#Ừm, Paimon và {NICKNAME}, đúng là những cái tên hay... Tôi đã ghi nhớ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180204,
					"content": "Vậy chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
