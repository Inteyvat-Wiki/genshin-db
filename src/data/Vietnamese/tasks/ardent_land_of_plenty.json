			},
			"dialogs": [
				{
					"id": 150180301,
					"content": "Xin chào, cho hỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180303,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180304,
					"content": "Hai vị bị lạc đường à? Có cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180305,
					"content": "Không, không có, chúng tôi chỉ muốn đến Cộng Đồng Trù Phú thôi... Xin hỏi nơi đó nằm ở hướng này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180306,
					"content": "Đúng vậy, đó là nhà của tôi, nếu cần thì tôi có thể dẫn hai vị qua đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180307,
					"content": "#Tốt quá, {NICKNAME}, lại gặp được người địa phương dẫn đường rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180308,
					"content": "Giọng điệu muốn làm biếng của Paimon lộ liễu quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "Người dẫn đường à... Tôi chắc sẽ làm được mà. Hihi, vậy từ bây giờ tôi sẽ là người dẫn đường của các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180310,
					"content": "Trên đường đi có rất nhiều phong cảnh đặc biệt, tôi có thể giới thiệu cho các vị. Hầu như ai tới đây lần đầu cũng đều xuýt xoa cảm thán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180311,
					"content": "Cảm ơn ý tốt của cô, nhưng mà đợi đã... Cô đồng ý nhanh như vậy làm tôi thấy hơi áy náy đó... Không sao thật chứ? Liệu có làm lỡ việc cô vốn phải làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180312,
					"content": "Không sao, vốn dĩ tôi cũng tới đây để tập luyện mà. Vừa hay tôi định dọn dẹp rồi về nhà, chúng ta cũng xem như là tiện đường đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180313,
					"content": "Hơn nữa nếu tôi làm người dẫn đường, thì các vị sẽ có thể tìm hiểu thêm về phong tục tập quán nơi này và biết thêm được nhiều kiến thức mới, vậy chắc chắn sẽ rất vui nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180314,
					"content": "Nếu các vị thấy vui thì tôi cũng vui theo. Chú Acatl nói, đây gọi là \"đạo tiếp khách\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180315,
					"content": "Ừm, vậy được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180316,
					"content": "Cô ấy có vẻ như rất ngây thơ và nhiệt tình đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180317,
					"content": "Cũng khá may mắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "Đúng thế, tôi cũng cảm thấy vậy, tôi thích cô ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180319,
					"content": "Sao thế? Nếu chuẩn bị xong rồi thì chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180320,
					"content": "Đúng rồi, tôi còn chưa hỏi cô tên gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180321,
					"content": "Cũng đúng! Tôi tên Varesa, rất vui được làm quen với hai vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
