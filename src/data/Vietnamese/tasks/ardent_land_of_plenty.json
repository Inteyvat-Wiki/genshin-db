					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180404,
					"content": "#Hai vị... chẳng lẽ là Paimon và {NICKNAME} sao?! Cuối cùng cũng chờ được hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180405,
					"content": "Woa! Cô biết chúng tôi sao? Thì ra danh tiếng của chúng tôi vang xa đến vậy rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180406,
					"content": "Nhưng mà... chẳng lẽ đã có người kể lại chuyện chúng tôi đến Cộng Đồng Trù Phú rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180407,
					"content": "Ồ, hai vị không biết sao? Huấn luyện viên Iansan nói với tôi là có mời các vị đến Cộng Đồng Trù Phú, cho nên tôi đã đến đây từ sớm để vừa luyện tập vừa chờ đợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180408,
					"content": "Các vị đến thật rồi... Hihi, không ngờ lại đến thật, tốt quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180409,
					"content": "Cũng, cũng không cần kích động như vậy đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180410,
					"content": "Các vị là anh hùng chống lại Vực Sâu đó! Sự tích đã lan truyền khắp Natlan rồi, tôi đã nhiều lần nghe kể về câu chuyện của \"Tum{RUBY#[S]Hy Vọng}aini\", ấn tượng vô cùng sâu sắc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180411,
					"content": "Từ khi huấn luyện viên Iansan nói các vị sẽ đến Cộng Đồng Trù Phú thì tôi đã rất mong chờ! À đúng rồi, tôi tên là Varesa, chắc huấn luyện viên Iansan từng nhắc đến tên tôi rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180412,
					"content": "A, tôi có ấn tượng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180413,
					"content": "Lúc đó khi Vực Sâu xâm lấn, chúng tôi hỏi Iansan có cần trở về Cộng Đồng Trù Phú chi viện không, thì cô ấy nói là Varesa đã giải quyết được mối đe dọa ở đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180414,
					"content": "Nói như vậy thì cô cũng rất lợi hại đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "Không có đâu. Vẫn là chú Acatl đã chỉ huy tốt, tôi chỉ tiêu diệt một số ma vật thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180417,
					"content": "Nghĩ lại chuyện xảy ra lúc đó, tới giờ tôi vẫn thấy hơi sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180418,
					"content": "Nhưng bây giờ tất cả đã kết thúc. Cộng Đồng Trù Phú chịu ảnh hưởng khá ít, việc xây dựng lại cũng đã hoàn thành. Người của bộ tộc chúng tôi gần đây đều đang đi chi viện ở khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180419,
					"content": "Hihi, để tôi dẫn các vị đến doanh trại của bộ tộc xem thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180420,
					"content": "Được, vậy thì xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180415,
					"content": "Là anh hùng thứ thiệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
