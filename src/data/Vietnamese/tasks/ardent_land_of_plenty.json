				]
			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "Cuối cùng chúng ta cũng đến rồi, đây chính là doanh trại của bộ tộc Cộng Đồng Trù Phú, cũng chính là nhà của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "Woa, thật tráng lệ! Tòa kiến trúc cao hình đầu bò đó thật oai phong, tôi rất thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Hihi, đó là Võ Đài Vang Dội, là nơi chúng tôi tổ chức các loại thi đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "Cảm ơn cô đã dẫn chúng tôi đến đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Đừng khách sáo, chuyện nhỏ thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "Tôi rất muốn dẫn các vị đi dạo quanh đây một vòng, nhưng tôi phải về nhà trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "Nhớ ra chuyện gì quan trọng sao? Vừa rồi khi Hilichurl xuất hiện, tôi đã cảm thấy cô dường như rất lo lắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "Hy vọng không làm chậm trễ việc của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "Không, không chậm trễ, vừa đúng lúc là đằng khác! Nhưng việc này đúng là rất quan trọng... Việc quan trọng nhất sau khi luyện tập chính là... Ăn cơm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "Khi đói bụng thì tôi sẽ cảm thấy không có sức lực, chóng mặt quay cuồng, tinh thần lơ đãng, nghĩ ngợi lung tung... Có thể nói là vô cùng tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Thật xin lỗi, tôi phải ăn cơm trước đã! Các vị cũng mau đi ăn đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "Chúng ta gặp lại ở Võ Đài Vang Dội sau nhé, tôi đi trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "Varesa đi mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Nói thế nào nhỉ, đúng là một cô gái thần kỳ mà, lúc thì dịu dàng, lúc lại xông thẳng vào chỗ nguy hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "Đây gọi là \"tuổi trẻ\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "Tuổi trẻ? Sao tự nhiên thốt ra câu nghe như người già vậy... Chúng ta vẫn còn trẻ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Nếu cô ấy về nhà rồi thì chúng ta tự đi dạo trước vậy, lát nữa mới đến Võ Đài Vang Dội đợi cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "Nơi cao như vậy, tầm nhìn chắc chắn sẽ rất đẹp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}