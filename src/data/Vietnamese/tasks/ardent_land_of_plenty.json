			"dialogs": [
				{
					"id": 150180101,
					"content": "Hửm... Tấm ván gỗ bên đường này dùng để làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180107,
					"content": "À, đây là thiết bị tập luyện của bộ tộc chúng tôi, tôi cũng thường hay dùng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180108,
					"content": "Thiết bị tập luyện à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180109,
					"content": "Ừm, để tôi nghĩ xem nào... Thay vì giải thích thì làm mẫu trực tiếp sẽ nhanh hơn đó. Varesa xông lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180103,
					"content": "Tiếp đất vững vàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180104,
					"content": "Ồ woa, cứ thế mà nhảy qua sao, thật đúng là lợi hại đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180105,
					"content": "Không có gì, không có gì, chỉ cần tập luyện nhiều thì ai cũng sẽ làm được như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180110,
					"content": "Ồ! Cô thậm chí không cần luyện tập mà chỉ cần bay trực tiếp qua là được. Vậy thì còn lợi hại hơn tôi nhiều đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180112,
					"content": "Đâu có giống nhau đâu... Hmm, mà hình như cũng rất có lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
