	"talks": [
		{
			"id": 1104501,
			"completionStepIds": [
				1104501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104501",
							"2"
						],
						"stepId": 1104501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "#Chắc là trong quá trình du hành, {F#cô}{M#cậu} cũng gặp rất nhiều câu đố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450102,
					"content": "#Cũng giống thử nghiệm thể lực, tôi muốn thông qua thực nghiệm để quan sát trí tuệ của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450103,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "#Tôi hy vọng {F#cô}{M#cậu} có thể tìm hiểu di tích ở đây, sau đó cho tôi biết đáp án {F#cô}{M#cậu} tìm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450106,
					"content": "Ở hai mặt của di tích này, mỗi bên sẽ có một câu đố, sau khi hoàn thành sẽ có thể khởi động cơ quan ở giữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450107,
					"content": "#Cũng giống như thử nghiệm thể lực, không hạn chế phương thức, tất cả những thứ {F#cô}{M#cậu} làm là những thứ tôi muốn quan sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450108,
					"content": "Việc này quá quen thuộc rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "Không hổ danh là nhà mạo hiểm lão làng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450112,
					"content": "#Thế thì phải xem biểu hiện của {F#cô}{M#cậu} nữa. Đi bên nào trước do {F#cô}{M#cậu} quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450110,
					"content": "Cứ thử rồi sẽ có cách thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "Đừng quên đây là thử nghiệm trí tuệ, không có sự may mắn trong thử nghiệm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450104,
					"content": "Cách nói này có phải hơi lạ lạ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450462,
					"content": "Tranh trông kỳ lạ quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "Theo như tôi biết, đây là một loại văn tự, mặc dù rải rác ở đại lục Teyvat, nhưng vẫn chỉ là một bí ẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450402,
					"content": "Còn rất nhiều điểm khó hiểu, hơn nữa, vì sao những phù văn này lại được để lại ở đây, thật kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450403,
					"content": "#Tóm lại, tôi phải sao chép lại trước. Sau khi xong việc nghiên cứu về {F#cô}{M#cậu}, tôi sẽ dành thời gian xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450404,
					"content": "Ồ, lại là những thứ khó hiểu. Tôi hoàn toàn không biết những vấn đề và cuộc thực nghiệm kỳ quái này sẽ được kết quả gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450405,
					"content": "Nhưng xem ra, muốn có được thù lao thì phải trả giá tương ứng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450406,
					"content": "Lần này tôi thu hoạch được rất nhiều thứ, nếu so ra, thì việc trả thù lao vặt vãnh đúng là chuyện không đáng nhắc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450407,
					"content": "Tôi về nơi trú ẩn trước, đợi hai vị trở lại, tôi sẽ cho mọi người chứng kiến thời khắc kỳ diệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450408,
					"content": "Vậy lát nữa gặp nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "Thực ra tôi vẫn đang rất háo hức xem có được kết quả gì sau khi bị giày vò như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450411,
					"content": "Nếu không có việc gì nữa, chúng ta cũng về nơi trú ẩn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450413,
					"content": "Đừng vội rời khỏi trước khi tôi loại trừ tất cả nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450414,
					"content": "A? Là cô! Thì ra cô không rời khỏi Núi Tuyết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450415,
					"content": "Đương nhiên, những việc hai người và Albedo làm, tôi đều thấy hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450416,
					"content": "#Phải nói là {F#cô}{M#cậu} không có sự phòng bị, hay là bị tư duy đặc biệt của anh ta, hay thái độ thân thiện lừa gạt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450417,
					"content": "Xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "Hành động theo chỉ thị của người lạ, uống thứ thuốc không rõ nguồn gốc, tham gia vào nhiều cuộc thử nghiệm không biết rõ kết quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450420,
					"content": "#Tôi thà tin rằng {F#cô}{M#cậu} bị lừa hơn là ngây thơ, hoặc là, ngay từ khi bắt đầu đã thông đồng với nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450421,
					"content": "Đúng là nữ tu có tinh thần cảnh giới cao độ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450422,
					"content": "Tôi chỉ hỗ trợ việc nghiên cứu của anh ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "#{F#Cô}{M#Cậu} nghĩ sao cũng được, việc của Albedo thì thế nào cũng được, tôi hiểu anh ấy nhiều hơn người từ nơi khác đến như {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450425,
					"content": "#Tôi chỉ quan tâm một điều, liệu {F#cô}{M#cậu} có bị thuật giả kim cải tạo, trở thành một quái vật không thể hiểu nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450426,
					"content": "Không phải chứ?! Tôi không cảm nhận được gì hết! Với lại, hình như anh ấy chẳng dùng thuật giả kim nào trên suốt đường đi cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450427,
					"content": "#Trình như anh ta, nếu muốn giở thủ đoạn, đương nhiên {F#cô}{M#cậu} sẽ không cảm nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450428,
					"content": "Tóm lại tôi sẽ không thả bất kỳ sự uy hiếp nào về Mondstadt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450429,
					"content": "Vậy, vậy cô muốn làm thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450430,
					"content": "Cô đến để xác nhận, đương nhiên sẽ có cách thực hiện điều đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "Về mặt này thì khá linh hoạt. Chỉ cần xác nhận tất cả những thứ mà hai người từng tiếp xúc không hề nguy hiểm, thì hai người sẽ không nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450432,
					"content": "Tôi đã hoàn thành việc điều tra những thứ khác, bây giờ chỉ còn duy nhất số phù văn này là chưa xác nhận thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450433,
					"content": "Số phù văn này chúng tôi xem còn chẳng hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450451,
					"content": "Tôi biết, hơn nữa... ừm, hình như cũng chỉ là phù văn, chứ không phải cơ quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450452,
					"content": "Nhưng để chắc ăn, cứ sao chép lại... ừm, còn phải đánh dấu đây là nơi quan trọng, cần phải tuần tra định kỳ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450434,
					"content": "Được rồi, nếu đã vậy thì hai người không phải là mối nguy hiểm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450435,
					"content": "Đây cũng là điều mà tôi hy vọng, nếu tôi phải tăng ca vì hai người thì tôi lỗ nặng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450436,
					"content": "Tăng, tăng ca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450437,
					"content": "#Người lạ à, trước khi chào tạm biệt, tôi thành thật khuyên {F#cô}{M#cậu} một câu, đừng quá tin Albedo, chí ít thì cũng đừng làm quá nhiều việc thiếu suy nghĩ như lần này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450439,
					"content": "Cô ấy đi rồi, đúng là chỉ biết làm theo ý mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450440,
					"content": "Người như cô ấy ở Mondstadt thật sự rất hiếm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450441,
					"content": "Có lẽ vì không có cảm giác an toàn đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "Ừm, thôi kệ cô ấy đi, chúng ta trở về gặp Albedo đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450442,
					"content": "Có lẽ hơi nhạy cảm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "Tôi không nghĩ anh ấy là người xấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "Anh ấy có ý đồ gì khác sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "Xem ra trí tuệ của tôi chẳng có vấn đề gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "Có cảm giác như đã thấy ở đâu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "Hai vị về rồi à, vừa hay tôi cũng sắp có kết luận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450502,
					"content": "Nhưng có vẻ đã mất rất nhiều thời gian, lẽ nào đã xảy ra chuyện gì trên đường?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450503,
					"content": "Không có gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "Nói về kết luận đi, hôm nay có được rất nhiều dữ liệu, rất khó để hoàn thành nghiên cứu cùng một lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450507,
					"content": "#Nhưng tôi có thể cho {F#cô}{M#cậu} một kết luận sơ bộ, đó là {F#cô}{M#cậu} rất giống loài người của thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "Nhìn là biết đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450511,
					"content": "Chúng tôi trầy da tróc vảy làm biết bao nhiêu chuyện, đổi lại chỉ được kết quả này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450512,
					"content": "Đừng nóng đừng nóng, có thể hai người cảm thấy đây là chuyện đương nhiên, nhưng thực ra trên thế giới chẳng có chuyện gì là đương nhiên cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450513,
					"content": "Hai người đã từng nghĩ đến khả năng này chưa? Rằng thế giới Teyvat này có thái độ cự tuyệt những kẻ ngoại lai một cách tự nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450514,
					"content": "Câu trả lời nằm ở Thần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "#Tôi đã đề cập đến quy luật của thế giới này, {F#cô}{M#cậu} có thể nói chuyện với tôi ở đây mà không gặp bất kỳ vấn đề gì, điều đó có vẻ bình thường nhưng thật ra lại là một kỳ tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450517,
					"content": "#Bởi vì sự sống đến từ nơi xa như {F#cô}{M#cậu} là hạt giống mà tôi từng đề cập trước đây, và dưới tác động của quy luật Teyvat, nó thậm chí không thể phát triển và ra hoa bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450518,
					"content": "#Nhưng sau khi quan sát {F#cô}{M#cậu}, tôi lại có suy nghĩ khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450519,
					"content": "#Mô phỏng cuộc sống của {F#cô}{M#cậu}, thêm linh cảm mới của tôi vào thuật giả kim, sau đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450520,
					"content": "Ồ, hình như, hình như có gì đó sắp xuất hiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450521,
					"content": "Từ không đến có, từ chớm nở đến thịnh vượng, và sau đó là kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450522,
					"content": "Nuôi dưỡng sinh mạng không thuộc về thế giới này, lẽ nào không phải đang nuôi dưỡng thế giới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450523,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450524,
					"content": "Đẹp quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "Ôi, đây dường như là cực hạn rồi. Những bông hoa chỉ có thể nở trong chốc lát nhưng lại vô cùng xinh đẹp, cực hạn của cuộc sống cũng chính là ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450527,
					"content": "Tôi cứ nghĩ chúng ta bỏ ra nhiều như vậy thì hoa có thể nở mãi. Mà hình như cũng không có kết quả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450528,
					"content": "Sinh mệnh là một thể tự do đa dạng, không nên định nghĩa theo ngắn dài, ngay cả khi nó chỉ nở trong chốc lát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450529,
					"content": "Sinh mệnh ngắn ngủi cũng chưa chắc là xấu. Hiệu quả cao, hoàn hảo, có nghĩa là không bị cô đơn làm phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450530,
					"content": "#Vì vậy, {F#cô}{M#cậu} có hiểu không? Chuyện tôi vừa nói, \"cuộc trò chuyện của chúng ta nói không chừng là kỳ tích\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450531,
					"content": "Ít ra thì bây giờ tôi vẫn chưa héo tàn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "Ơ? Tại sao bầu không khí đột nhiên trở nên như thế này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450534,
					"content": "#Hihi, đừng ủ rũ nữa, {NICKNAME}, bạn còn có tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450535,
					"content": "Còn Albedo nữa, tôi cũng muốn làm bạn với anh đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450536,
					"content": "...Cảm ơn hai người. Mặc dù tôi không nghĩ rằng giải quyết nỗi cô đơn là điều tất yếu của cuộc sống... Nhưng, cũng không xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}, chính sự giúp đỡ của {F#cô}{M#cậu} đã cho tôi nguồn cảm hứng và phát hiện ra khả năng làm cho nó nở rộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450538,
					"content": "Giúp đỡ như một \"vật thí nghiệm\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "#Không, khoảng thời gian đồng hành cùng {F#cô}{M#cậu} trên núi tuyết cũng là một hành trình đáng giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450540,
					"content": "Sau này... Nếu cần, tôi vẫn có thể nhờ hai người giúp đỡ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450541,
					"content": "Không có việc gì cần giúp cũng có thể đến tìm tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "#Vậy thì... nhờ {F#cô}{M#cậu} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450544,
					"content": "#Mặc dù tôi vẫn nói với {M#cậu ấy}{F#cô ấy} rằng kết quả thực nghiệm là \"bình thường\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450545,
					"content": "Nhưng kết tủa không nên có ở phần đáy này, lại là chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450546,
					"content": "#Gần mực thì đen, gần đèn thì sáng. {F#Cô}{M#Cậu} và tôi giống nhau, đều là loại \"chất liệu\" vẫn chưa được xác định...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450547,
					"content": "Nếu có một ngày, tôi mất kiểm soát và muốn hủy diệt tất cả... hủy diệt Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450548,
