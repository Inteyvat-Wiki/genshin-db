			"dialogs": [
				{
					"id": 701280101,
					"content": "Hừm, cái bình này khá nặng tay, hình như có cái gì đó ở bên trong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701280102,
					"content": "\"Người bạn cũ của chúng ta hôm qua đã đến và mang theo tin xấu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701280103,
					"content": "\"Đã lâu rồi vẫn không nhận được hồi âm. Có thể anh ta đã nói đúng, tôi nên chấp nhận sự thật.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701280104,
					"content": "\"Nhưng cho dù thế nào, nếu như bạn có ở ngoài kia, nếu như bạn nhận được dòng tin này, hy vọng bạn có thể hồi âm cho tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701280105,
					"content": "\"Trong thư có đính kèm huy hiệu của bạn, để tôi có thể dựa vào đó nhận ra bạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701280106,
					"content": "\"Còn nhớ Nhà Hàng Uyuu chứ? Chúng ta sẽ gặp nhau ở đó, tiền rượu cũng được gửi qua thư rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701280107,
					"content": "\"Nếu người nhận được thư này không phải là người tôi mong tìm...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Bình Trôi"
				},
				{
					"id": 701280108,
					"content": "\"Cũng hy vọng bạn giữ lấy tín vật này, có thể bạn sẽ giúp được tôi trả được về cho chủ cũ, số Mora này xin trả ơn bạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Trôi"
				}
			]
		}
	]
}