			"dialogs": [
				{
					"id": 705170101,
					"content": "Nơi này xem ra rất bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170102,
					"content": "Có vẻ như không tìm thấy thứ gì đó để ăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170103,
					"content": "Hớ rồi nhé Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "Ehe, trong quá trình điều tra cũng phải ăn cái gì đó mới được chứ, đây là lẽ thường tình mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170106,
					"content": "#Hơn nữa, dạo này để đỡ phiền nên chúng ta đã ăn quá nhiều đồ nướng rồi, {NICKNAME} cũng ngán rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170107,
					"content": "Nếu như chúng ta có thể nhặt được sò hay ốc gì đó trên bãi biển, rồi sau đó đem hầm với trái cây thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170108,
					"content": "Tươi tươi, ngọt ngọt, dai dai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170109,
					"content": "Nghe gớm quá, tôi không thèm món đó đâu nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "Thử đi mà, nói không chừng sẽ mở rộng tầm mắt đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170113,
					"content": "#Chờ đã, {NICKNAME}, xem bên đó kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170114,
					"content": "Sao lại có cơ quan xuất hiện thế nhỉ... thật kỳ lạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170115,
					"content": "Xung quanh còn có một số hành lý nữa, là đồ đạc của Fatui sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170116,
					"content": "Lại bị Paimon đoán trúng rồi, tuyệt quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "Linh cảm của tôi quả nhiên chính xác, tuyệt lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170118,
					"content": "À mà tuyệt cái gì chứ, xùy xùy xùy! Rõ ràng là chúng ta đang gặp rắc rối rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170119,
					"content": "Nếu đã là đồ của Fatui xuất hiện ở đây thì rất có khả năng đây là âm mưu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170120,
					"content": "Nếu cứ bỏ mặc chúng thì âm mưu của chúng sẽ ngày càng lớn mạnh, lúc đó sẽ khó đối phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170121,
					"content": "Tóm lại, hãy thử giải quyết cơ quan đó xem sao nhé? Nếu thấy cần thiết thì chúng ta sẽ đi điều tra đồ đạc của Fatui sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170122,
					"content": "#{NICKNAME}, hãy trổ hết tài năng ra đi nào, sau khi giải quyết chúng thì chúng ta sẽ có thể yên tâm tìm nguyên liệu nấu ăn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170111,
					"content": "Nghe có vẻ giống mùi vị của Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "Ê! Người ta không phải thủy sản nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705170104,
					"content": "Hèn gì tích cực dữ vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}