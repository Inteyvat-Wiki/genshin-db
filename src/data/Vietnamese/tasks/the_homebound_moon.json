			"dialogs": [
				{
					"id": 761180301,
					"content": "Tu sửa tượng Kuutar sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180302,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180303,
					"content": "Cô ấy đã không còn là Kuu{RUBY#[S]Thiếu Nữ Mặt Trăng}tar mất đi đôi cánh, chỉ biết cô độc ngắm nhìn vầng trăng ngoài bầu trời nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180304,
					"content": "Chúng ta đã chứng kiến dáng vẻ cô ấy dang rộng đôi cánh, cũng biết rằng cô ấy đã lấy lại sự tự do của sinh mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180305,
					"content": "Cho nên cũng đến lúc phải sửa sang lại tượng thần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180306,
					"content": "Nghe cũng được đấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180307,
					"content": "Cô đã kể cho những người khác trong Dòng Dõi Sương Nguyệt nghe chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "Ừm. Tôi đã kể cho mọi người về sự hy sinh và sự trở lại của Nguyệt Thần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180309,
					"content": "Và chúng ta đã chiến đấu chống lại sức mạnh làm vấy bẩn thế giới như thế nào dưới sự dẫn dắt của ánh sáng dịu dàng ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180310,
					"content": "Chuyện Nguyệt Thần trở về, mọi người đều vô cùng vui mừng. Nhân dịp này, tôi đã truyền đạt lại suy nghĩ của Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180311,
					"content": "Cô ấy muốn coi chúng ta như người thân trong gia đình, cũng mong muốn chúng ta xem cô ấy như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180312,
					"content": "Mọi người nói thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180314,
					"content": "Nguyệt Thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "Zirnytsia"
				},
				{
					"id": 761180315,
					"content": "Coi Nguyệt Thần như người thân trong gia đình... liệu có vượt quyền không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "Lauha"
				},
				{
					"id": 761180316,
					"content": "Tôi tin đây chính là mong muốn thực sự của Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180317,
					"content": "(Vịnh Nguyệt Sứ thực sự gọi Nguyệt Thần là \"Columbina\" kìa...!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "Kunegunda"
				},
				{
					"id": 761180318,
					"content": "Có lẽ các vị vẫn còn nhớ câu mà tôi đã từng nói vài ngày trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180319,
					"content": "\"...Con đường được trải bằng sự thật, và sẽ do chính chúng ta trải nên.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180320,
					"content": "Tôi không đòi hỏi mọi người phải lựa chọn giống tôi, nhưng hôm nay, tôi cũng có một lời khuyên muốn chia sẻ với các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180321,
					"content": "\"Nếu muốn mời ánh trăng ở lại, trước hết phải mở rộng cánh cửa đang đóng chặt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180322,
					"content": "...Đúng là như vậy. Tình hình mấy ngày nay, có vẻ còn lạc quan hơn tôi dự đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180323,
					"content": "Cô Lauma, lô đá mới đã được chuyển đến kho rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 761180324,
					"content": "Tôi biết rồi, tôi sẽ qua đó ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180325,
					"content": "#Những gì tôi vừa nói và cảnh tượng {F#cô}{M#cậu} vừa thấy, có thể tạm thời giữ bí mật với Columbina không? Tôi muốn cho cô ấy một bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180326,
