			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180102,
					"content": "Có ngửi thấy mùi rất thơm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180104,
					"content": "Columbina một mình ăn uống vô tội vạ kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180106,
					"content": "Cô ấy ăn rất vui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "Hai người có muốn nếm thử một chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180108,
					"content": "Cô cứ ăn đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "Hiếm khi thấy cô ăn uống ở đây, là cô đã mua từ bên ngoài đem về à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "Là do Lauma mang đến đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180111,
					"content": "Ồ! Cô ấy vẫn rất quan tâm đến cô đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "Nhưng điều kiện là tôi không rời khỏi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180113,
					"content": "Đây là giam lỏng hả?! Cô bị mấy thứ này mua chuộc rồi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "Cô ấy còn mang theo vài cuốn sách thú vị và đồ chơi tinh xảo nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180115,
					"content": "Cứ như mẹ đi công tác, còn con trông nhà một mình ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "Thế Lauma có giải thích lý do không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Cô ấy bảo tôi thời gian này đừng ra ngoài, nhất là đừng đến Dòng Dõi Sương Nguyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180118,
					"content": "Tôi đã hỏi những động vật nhỏ đến giao đồ ăn, nhưng chúng đều đã nhận được chỉ thị từ Lauma nên đều giữ im lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180119,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "Tôi đoán, chắc là cô ấy đang chuẩn bị gì đó có liên quan đến tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180121,
					"content": "Yên tâm đi, tôi vốn cũng không thấy ở đây nhàm chán. Đồ ăn ngon, hợp khẩu vị, không phải ra ngoài cũng tốt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180122,
					"content": "Hơn nữa, nếu Dòng Dõi Sương Nguyệt đang chuẩn bị gì đó, tôi càng không nên vì tò mò mà phá hỏng kế hoạch của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180123,
					"content": "Hay là chúng tôi đi nghe ngóng tình hình nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Đúng đấy, nói thế làm tôi cũng tò mò ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "Được thôi, nhưng hai người cũng nên chuẩn bị tinh thần nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761180126,
					"content": "Chắc cô ấy cũng đoán được là hai người sẽ đến gặp tôi, nên chắc sẽ không nói gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
