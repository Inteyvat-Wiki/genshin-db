	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "...Tóm lại, Khu Vực Ô Nhiễm thật ra là do địa mạch sâu trong rừng bị rò rỉ ra ngoài, bây giờ đã bình thường trở lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030102,
					"content": "Thì ra là vậy, vất vả cho các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030103,
					"content": "Vậy chờ khi năng lượng địa mạch còn lại trong không khí tiêu tan hết là có thể dán thông báo để người dân ra vào bình thường được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030104,
					"content": "Đây là phần thưởng như đã hứa, hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030105,
					"content": "Sau khi rời khỏi Hiệp Hội Nhà Mạo Hiểm, bị Paimon đưa đến một nơi yên tĩnh...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "Karkata... sắp bị đưa về Giáo Viện sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030107,
					"content": "Mặc dù nó đã bị hỏng, nhưng cứ nghĩ đến việc nó sắp bị tháo dỡ thì tôi vẫn thấy hơi buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030108,
					"content": "Tôi cũng hơi buồn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "Vậy! Hay là ngày mai chúng ta đi tìm Tighnari để năn nỉ anh ấy đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030110,
					"content": "Mặc dù tôi rất muốn đi ngay bây giờ, nhưng Tighnari nói là \"có việc gì để mai hẵng nói\", cho nên bây giờ chúng ta đi tìm là sẽ chọc anh ấy giận đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030111,
					"content": "Hình như đúng là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "Quyết định vậy nha! Ngày mai chúng ta cùng đi tìm Tighnari, để anh ấy đừng tháo dỡ Karkata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tighnari",
					"Karkata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "Tighnari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030302,
					"content": "Suỵt, nói nhỏ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030303,
					"content": "Thụy Hương, họ Thymelaeaceae, có tác dụng chống co giật rõ rệt, có thể dùng để làm bột gây mê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030304,
					"content": "Từ hai nhóm dữ liệu thí nghiệm cho thấy, nó đặc biệt độc hại đối với cá... cần ghi chép cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030305,
					"content": "Kolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030306,
					"content": "Karkata?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030307,
					"content": "Kalu! Kalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030308,
					"content": "Đã bảo là nhỏ tiếng thôi mà, mặc dù cây cỏ không sợ ồn ào, nhưng tai của tôi ù hết rồi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030309,
					"content": "Anh, anh không tháo dỡ Karkata sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030310,
					"content": "Tôi tháo nó ra để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030311,
					"content": "Nhưng không phải anh nói, \"theo quy định của Giáo Viện\" thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030312,
					"content": "Hóa ra sáng sớm hai người đến quấy rầy tôi là vì chuyện này sao. Được rồi, cũng tại hôm qua tôi nói không rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030313,
					"content": "Ý của tôi là, theo quy định của Giáo Viện, tất cả thành quả nghiên cứu đều phải bị tiêu hủy, vì vậy không thể để Giáo Viện phát hiện ra chỗ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030314,
					"content": "Vậy Tighnari ở lại đó thật ra là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "Tóm lại là phải sửa chữa Karkata trước. Lúc trước ở Giáo Viện, tôi đã tham gia khóa học của Học Phái Spantamad, không ngờ có ngày lại cần dùng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030316,
					"content": "Sau đó tôi và nó cùng chôn cất Abattouy. Còn về tài liệu thí nghiệm thì tôi đã sắp xếp lại rồi, một số đem về làm kỷ niệm, phần lớn còn lại đã đem đốt và chôn sâu để phi tang chứng cứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030317,
					"content": "Tôi lại không ở trong Giáo Viện, cho nên những quy tắc đó có liên quan gì đến tôi chứ? Ngược lại, bây giờ tôi là đội trưởng kiểm lâm của Rừng Avidya, tôi có nghĩa vụ phải bảo vệ cho hệ sinh thái trong rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030318,
					"content": "Bất kỳ sinh mệnh nào sinh ra trên đời cũng đều có ý nghĩa, và nó cũng không ngoại lệ. Nếu đã tồn tại rồi thì không nên bị vứt bỏ hay phá hủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030319,
					"content": "Hihi! Tuyệt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030320,
					"content": "Kolulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030321,
					"content": "Nhưng mà Tighnari vừa nói \"bất kỳ sinh mệnh nào\", lẽ nào anh đã xem Karkata là \"sinh mệnh thật sự\" rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030322,
					"content": "Chỉ là có thể thôi, dù sao thì chuyện nó thử \"sửa chữa\" Abattouy cũng rất khó giải thích mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030323,
					"content": "Nhưng ghi chép thí nghiệm của Abattouy để lại cũng chỉ là một phần nhỏ, không ai biết rốt cuộc nó được thiết lập bao nhiêu lệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030324,
					"content": "Có thể đó chỉ là sự xung đột giữa các lệnh nên dẫn đến việc Karkata hành động như vậy mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030325,
					"content": "Dưới góc nhìn khắt khe thì không thể kết luận rằng \"Karkata là sinh mệnh thật sự\" được. Nhưng nếu như có khả năng này thì tôi sẽ tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030326,
					"content": "Kolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030327,
					"content": "Phải nói rằng tôi không có hứng thú để tiếp tục nghiên cứu đề tài này, tôi để nó ở lại đây chỉ vì ở đây tương đối kín đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030328,
					"content": "Nhưng mà bây giờ lại thấy để nó làm trợ thủ thí nghiệm cũng không tệ, ít nhất tôi có thể để nó ghi chép thí nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030329,
					"content": "Như vậy ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030330,
					"content": "Kalu! Kalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karkata"
				}
			]
		},
