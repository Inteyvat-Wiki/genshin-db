				"points": []
			},
			"dialogs": [
				{
					"id": 700080101,
					"content": "Quả nhiên, phải tung ra một loại thức uống mới mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080102
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080103
					]
				},
				{
					"id": 700080103,
					"content": "Ồ, là bạn à, thật ra tôi đang nghĩ lấy chủ đề Lễ Hội Hoa Gió, để tung ra loại thức uống mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080104
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080104,
					"content": "Trong thời gian Lễ Hội Hoa Gió, mọi người chắc chắn sẽ dạo chơi trong thành, đi dạo thì chắc chắn cũng phải ăn uống gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080105
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080105,
					"content": "Nhưng mà nếu chỉ uống thôi sẽ dễ uống say, nếu say quá, không chừng còn bị Kỵ Sĩ Tây Phong đưa đi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080106
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080106,
					"content": "Mặt khác, mùi rượu nồng nặc, chắc cũng làm hỏng bầu không khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080107
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080107,
					"content": "Là, là vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080108
					]
				},
				{
					"id": 700080108,
					"content": "Mặc dù tôi cũng nghe nói, có người thích bầu không khí nồng nặc mùi rượu, nhưng say đến mức té ngã trên đường trong thời gian ngày lễ thì không hay cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080109
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080109,
					"content": "Vậy nên, tôi muốn tung ra một món thức uống với nguyên liệu chính là sữa bò, mang theo vị \"Gió\" nhẹ nhàng mà không chứa cồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080110
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080110,
					"content": "Để làm nổi bật mùi vị của \"gió\", tôi cảm thấy có thể dùng 2 loại phụ gia đặc biệt là Bồ Công Anh và Cúc Cánh Quạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080111
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080111,
					"content": "Nhưng nếu chỉ có một mình tôi thu thập thì sẽ mất nhiều thời gian... Nhà Lữ Hành, bạn có thể giúp tôi thu thập một loại gia vị được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080112,
						700080116
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080112,
					"content": "Tôi đi tìm Bồ Công Anh đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080113
					]
				},
				{
					"id": 700080113,
					"content": "Vậy thì nhờ bạn nhé, Bồ Công Anh gần Vực Hái Sao có chất lượng tốt, bạn hãy đến đó hái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080114,
					"content": "Tôi cũng sẽ đi thu thập Cúc Cánh Quạt, chúng ta gặp lại sau nhé",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080115
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080115,
					"content": "Sau khi điều chế ở đây xong, cũng tiện tìm người uống thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080116,
					"content": "Tôi đi tìm Cúc Cánh Quạt đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080117
					]
				},
				{
					"id": 700080117,
					"content": "Vậy thì nhờ bạn nhé, Cúc Cánh Quạt gần Phong Khởi Địa có chất lượng tốt, bạn hãy đến đó hái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080118
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080118,
					"content": "Tôi cũng sẽ đi thu thập một ít hạt Bồ Công Anh, chờ bạn thu thập đủ nguyên liệu, chúng ta sẽ gặp ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080119
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080119,
					"content": "Sau khi điều chế ở đây xong, cũng tiện tìm người uống thử...",
					"roleType": "TALK_ROLE_NPC",
