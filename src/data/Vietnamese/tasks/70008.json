			"dialogs": [
				{
					"id": 700083801,
					"content": "Được rồi, hai nguyên liệu này đã đủ, chúng ta bắt đầu pha đồ uống thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083802,
					"content": "Rốt cuộc có mùi vị gì nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "Thế nào, bạn cũng muốn thử loại thức uống này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083804,
					"content": "Ừm... Cách pha đồ uống này cũng không phức tạp, chỉ cần pha theo quy trình mà tôi đưa ra, chắc chắn sẽ thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083805,
					"content": "Nhà Lữ Hành, hay là... Bạn tự tay pha chế xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083806,
					"content": "Để tôi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "Không sao, tôi nói sơ qua về quy trình pha chế thức uống này, bạn nhớ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083808,
					"content": "Cho <color=#00E1FFFF>Hoa Ngọt</color> vào trước, sau đó đổ rượu chuyên để pha chế vào... Tất nhiên, lần này chúng ta dùng <color=#00E1FFFF>Sữa</color>, loại có vị ngọt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083809,
					"content": "Để tăng thêm hương vị, hãy thêm <color=#00E1FFFF>Cúc Cánh Quạt</color> vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083810,
					"content": "Sau đó đừng vội khuấy, phải <color=#00E1FFFF>để lắng</color> một lúc, để mùi thơm của hoa từ từ lan toả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083811,
					"content": "Rồi rắc <color=#00E1FFFF>hạt bồ công anh</color> lên, rượu sẽ trông đẹp mắt như rải các vì sao, cuối cùng cho <color=#00E1FFFF>đá viên</color> vào là xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083812,
					"content": "Thứ tự là như vậy, để làm ra một ly rượu ngon, bạn không thể đảo lộn thứ tự các bước, phải nhớ thật kỹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083813,
					"content": "Nhớ rồi thì hãy thử đi, nếu quên thì cứ đến hỏi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
