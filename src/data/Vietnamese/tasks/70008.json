				},
				{
					"id": 700081102,
					"content": "Về thức uống mới của Lễ Hội Hoa Gió tại Quán Rượu Đuôi Mèo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "Bạn muốn tôi uống thử sao? Hahaha, không thành vấn đề, tôi rất rành về rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081104,
					"content": "Để tôi thử xem... Ơ? Đồ uống này sao vậy, không có chút mùi rượu nào, cảm giác giống như là sữa vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081105,
					"content": "Chà, tuy uống vào mùi vị thơm ngon, nhưng không có chút mùi rượu nào, không thích hợp cho dịp lễ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081106,
					"content": "Dù sao thì cũng rất nhiều người đang mong chờ được \"say một cách hợp lý\" trong Lễ Hội Hoa Gió này, thức uống không cồn như vậy, e rằng sẽ rất ít người thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
