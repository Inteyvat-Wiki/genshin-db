					}
				]
			},
			"dialogs": [
				{
					"id": 741560801,
					"content": "Chào cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560802,
					"content": "...Thôi xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560803,
					"content": "Lúc Autumn bảo ngươi muốn chạy trốn thì ta còn rất kinh ngạc. Bọn ta đã nhốt ngươi lâu như thế, nhưng ngươi vẫn chưa suy sụp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560804,
					"content": "Hơn nữa, còn có thể chớp thời cơ xúi giục hai vị \"anh hùng chính nghĩa\" này giúp chạy trốn. Ý chí cầu sinh của ngươi làm ta cảm động đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560805,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560806,
					"content": "Rõ ràng ngươi có nhiều nơi để chạy, nhưng tại sao lại chọn nơi ngoại thành mà ngươi thường xuyên đưa Autumn đi dạo chứ? Quả là một lựa chọn không sáng suốt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560807,
					"content": "Ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560808,
					"content": "Không cần giải thích. Ta hiểu con người trong lúc nguy cấp thì thường sẽ không chạy bừa, mà sẽ chọn con đường mình quen thuộc nhất, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560809,
					"content": "Cũng may Autumn đi sau nên chưa đuổi theo kịp. Ta không muốn nói những chuyện này ở trước mặt cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560810,
					"content": "Cho nên rốt cuộc ngươi nghĩ thế nào? Ta thật sự không hiểu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560811,
					"content": "Ngươi lấy danh nghĩa hôn nhân, coi cô ấy như hàng hóa mà bán cho người khác. Bán tận hai lần, lần đầu là dùng cô ấy để đổi lấy căn nhà to ở Đại Sảnh Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560812,
					"content": "Lần thứ hai là chọn bừa một người, vì khi tiễn cô ấy đi, bất động sản và các tài sản khác đều thuộc về ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560813,
					"content": "Ngươi thậm chí còn làm ngơ khi cô ấy bị bắt nạt. Ngay cả đứa trẻ cô ấy sinh ra trong cuộc hôn nhân thứ hai cũng phải giao cho ngươi nuôi dưỡng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560814,
					"content": "Con của cô ấy đã bị ngươi tiễn đi, ta nghĩ chắc là để đổi lấy một khoản trợ cấp khổng lồ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560815,
					"content": "Bây giờ sao ngươi còn có thể thoải mái tặng bánh cho bọn trẻ, rồi mời chúng vào nhà làm khách thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560816,
					"content": "Ngươi không cảm thấy lương tâm cắn rứt dù chỉ một giây nào à? Ta nghĩ mãi cũng không thể hiểu được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560817,
					"content": "Thú thật, lúc ta gặp được Autumn là khi cô ấy đang lưu lạc khắp nơi. Cô ấy là một người mẹ rất dịu dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560818,
					"content": "Cô ấy đối xử với Penny, con gái của bạn ta vô cùng dịu dàng. Chỉ một ngày không gặp mà Penny đã đòi gặp chị Autumn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560819,
					"content": "À, để tránh cho ngươi cảm thấy mình còn cơ hội trở mình, ngoài ta ra thì Autumn vẫn còn rất nhiều bạn bè ngoài kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560820,
					"content": "Ngươi có chạy đến đâu cũng vô ích, bọn ta sẽ đuổi theo ngươi đến chân trời góc bể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560821,
					"content": "Tại sao người như cô ấy lại phải trắng tay và chịu giày vò, còn kẻ như ngươi lại giàu nứt vách chứ? Ta thấy chuyện này rất không công bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560822,
					"content": "Thu lại sự tò mò dư thừa của anh đi, ông ta không xứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741560823,
					"content": "Chậc, bị cô nghe thấy mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560824,
					"content": "Hóa ra cô chính là Autumn, xem ra tôi đã hiểu được mọi chuyện rồi. Chuyện nhà Leroy phức tạp thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560825,
					"content": "#{NICKNAME}, chúng ta đi theo ông Benoit cả chặng đường, kết quả là có nhiều chuyện khác với trước đây chúng ta nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560826,
					"content": "#Vậy thì... Chúng ta còn nên can thiệp vào chuyện này không? Tôi nghe theo ý {NICKNAME} đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
