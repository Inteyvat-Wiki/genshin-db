			"dialogs": [
				{
					"id": 741560401,
					"content": "#Tôi căng thẳng quá {NICKNAME}! Dựa theo nội dung trên giấy thì chúng ta chỉ cần ở đây chờ ông ấy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "Kiên nhẫn chờ đợi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "Được, tôi nghe theo vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "Lẳng lặng chờ đợi một lát, thấy cửa sổ mở ra với khuôn mặt quen thuộc cùng tiếng \"két...\". Ông Benoit thò đầu ra, sau khi thấy các bạn thì cẩn thận leo ra ngoài.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Ông Benoit, rốt cuộc chuyện này là thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "Chạy mau! Bị bọn họ phát hiện ra là hỏng bét đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560403,
					"content": "Tôi có một vài vấn đề cần hỏi ông ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
