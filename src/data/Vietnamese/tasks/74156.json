					"speakerTitle": "Morticia"
				},
				{
					"id": 741561211,
					"content": "Nếu cha nói thì con sẽ bỏ qua cho cha chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561212,
					"content": "Không, nhưng tôi sẽ để ông ra đi một cách không đau đớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561213
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561213,
					"content": "Haiz... Autumn, cô đúng là không biết cách nói dối mà! Như vậy thì chúng ta sẽ không bao giờ tìm được con bé đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561214
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561214,
					"content": "Các người đừng tưởng mình có thể muốn làm gì thì làm nhé! Ở đây còn có người khác đang nhìn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561215,
					"content": "Ngươi tưởng bọn ta không dám sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561216
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561216,
					"content": "...Autumn, từ bỏ đi. Hiện giờ con bé đang sống rất tốt, cha mẹ của nó rất giàu có, nên dù có tìm được nó cũng không làm gì được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561217
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561217,
					"content": "Nó cũng không thể theo con đi lang thang được. Con trốn từ trong Pháo Đài Meropide ra đấy, con muốn nó cũng phải sống như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561218,
					"content": "Con bé được nhận nuôi rồi sao... Tại sao không nói với tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561219
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561219,
					"content": "Con bé... vẫn sống tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561220
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561220,
					"content": "Để cha đi đi, Autumn. Đối với con mà nói thì cha sống hay chết đều đã không còn ý nghĩa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561221
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561221,
					"content": "Con bé đã có mẹ chăm sóc, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561222,
					"content": "Đúng thế! Mẹ nuôi của con bé đối xử với nó rất tốt. Còn tốt hơn so với những gì con và cha có thể làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561223
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561223,
					"content": "Bây giờ tìm lại con bé thì làm được gì... Còn có ý nghĩa gì chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561224
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561224,
					"content": "Đúng vậy, đều đã không còn ý nghĩa gì nữa rồi. Tất cả mọi thứ của cha ở Đại Sảnh Fontaine đều sẽ thuộc về con. Cha đã từ bỏ, hãy để cha đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561225
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561226
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561226,
					"content": "Cô ngẩn ngơ gì thế Autumn? Cô muốn thả hắn ta đi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561227
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561227,
					"content": "Chậc, Benoit, ngươi thật sự cho rằng mình có thể chạy trốn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561228
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561228,
					"content": "Tôi sẽ không đứng nhìn các người làm hại ông Benoit đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561229
					]
				},
				{
					"id": 741561229,
					"content": "Sao các người cứ muốn ngăn cản thế? Các người rõ ràng không liên quan, nhưng sao cứ phải cuốn vào chuyện này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561230
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561230,
					"content": "Lòng tốt đặt sai chỗ, đây chính là đánh giá dành cho các người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561231
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561231,
					"content": "Autumn muốn thả ông ta đi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561232
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561232,
					"content": "Tôi... Tôi không biết... Tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561233,
					"content": "Haiz, cô vẫn cứ mềm lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561234
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561234,
					"content": "Benoit, ngươi đánh cược đúng đấy. Con cái là điểm yếu lớn nhất của người mẹ. Bây giờ ngươi cũng đang có người giúp đỡ... Ta sẽ tha cho ngươi một mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561235,
					"content": "Nhưng để bọn ta xem thử ngươi có thể chạy được bao xa. Xem bọn ta tìm được ngươi trước, hay ngươi có thể chạy đến nơi mà bọn ta không tìm được trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561236
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561236,
					"content": "Cũng tiện nhắc luôn, đừng tưởng chỉ có bọn ta truy sát ngươi đến chân trời góc bể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561237
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561237,
					"content": "Bọn ta còn có rất nhiều anh em kết giao được trong Pháo Đài Meropide. Lần này trước khi đến Đại Sảnh Fontaine, bọn họ đều nói rất muốn gặp ngươi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561238,
					"content": "Các người có thể lấy tất cả tài sản của ta... Cứ lấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561239
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561239,
					"content": "Xem ra hôm nay không phải ngày chết của ngươi. Trước khi anh em ta tìm thấy ngươi thì ta cũng mong ngươi có thể sống thêm vài ngày đấy. Cút đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561240
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561240,
					"content": "Benoit đi theo hướng ngược với Đại Sảnh Fontaine, không quay đầu lại mà chạy theo đường núi để thoát khỏi tầm mắt các bạn.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561241
					]
				},
				{
					"id": 741561241,
					"content": "Về phần các người... Bây giờ chúng tôi sẽ rời khỏi Đại Sảnh Fontaine, tôi nghĩ sau này chúng ta cũng sẽ không gặp lại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561242,
					"content": "Autumn, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561243
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561243,
					"content": "Thực sự xin lỗi, Athos, con của tôi, nó... Rất xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561244,
					"content": "Không sao. Đây là chuyện của cô, nên cô tự mình quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561245,
					"content": "Chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561246
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561246,
					"content": "Thì ra... Tất cả mọi chuyện là vậy. Đúng là một gia đình phức tạp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561247,
					"content": "Nói thế nào nhỉ? Tôi cũng không biết nên đánh giá ra sao nữa. Tôi thấy hơi tội nghiệp cho Autumn, cuối cùng cô ấy cũng không tìm được con mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561248,
					"content": "Dù sao thì ít nhất chúng ta cũng đã ngăn được một vụ án đẫm máu. Thế là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}