			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Họ có thể tự giải quyết, tôi sẽ không nhúng tay vào nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Autumn, con thực sự muốn đối xử với cha như thế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561103,
					"content": "Những đứa con gái ở Fleuve Cendre làm gì có ai hạnh phúc như con? Bánh ngọt con ăn, váy lụa con mặc, sách mà con đọc đều tốn tiền cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561104,
					"content": "Lúc người khác phải chịu rét chịu đói thì con đang ở trong nhà đeo dây chuyền và mặc váy cho chó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561105,
					"content": "Loại cuộc sống đó là do cha giành lấy, chẳng lẽ con không nên báo đáp à? Làm gì có chuyện không trả giá mà có được thu hoạch chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561106,
					"content": "Cha tàn nhẫn với con sao? Vậy là đã quá hào phóng rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561107,
					"content": "Autumn, con nghĩ thử xem. Trong cuộc sống của con, có bước đi nào mà cha không sắp xếp sẵn cho chứ? Con đi chệch hướng đều là do chính con chọn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561108,
					"content": "Ái chà, ngài Benoit, dùng từ ngữ cao cả như thế để che đậy sự ích kỷ sao? Nói toạc ra vẫn là vì bản thân mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561109,
					"content": "Ông tốt với tôi, chẳng qua là vì món hời của sau này, nên đừng có nói ra lời ngon tiếng ngọt nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "Sự thương hại lớn nhất của tôi dành cho ông chính là một cái kết gọn gàng. Nhưng trước đó hãy cho tôi biết, con tôi đang ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "Dù là nhà cũ hay nhà mới cũng đều không có dấu vết gì. Ông giấu con tôi đi đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "Nếu cha nói thì con sẽ bỏ qua cho cha chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561113,
					"content": "Không, nhưng tôi sẽ để ông ra đi một cách không đau đớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "Nói cũng chết, không nói cũng chết... Hừ, vậy thì tại sao ta phải nói để ngươi được lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561115,
					"content": "Haiz... Autumn, cô đúng là không biết cách nói dối mà! Như vậy thì chúng ta sẽ không bao giờ tìm được con bé đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561116,
					"content": "Ta biết con bé ở đâu, haha! Nhưng ta sẽ không nói cho các người biết, tuyệt đối không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561117,
					"content": "Ngươi sẽ mãi mãi không tìm được nó, tuyệt đối không tìm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561118,
					"content": "Tôi muốn dẫn ông ta về nhà, mọi người không có ý kiến gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Cứ tự nhiên, chúng tôi sẽ không can thiệp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "Các người cứ tự giải quyết là được rồi. Chúng tôi sẽ không nhúng tay vào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoit cứ lẩm bẩm \"tuyệt đối không tìm được\", rồi bị Autumn đưa đi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "Tôi vốn không định để người khác biết chuyện này, dù sao thì cô ấy vẫn đang bị truy nã mà. Thế nhưng... tôi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561123,
					"content": "Nếu bây giờ các người đến Sảnh Chấp Pháp tố cáo thì chắc sẽ nhận được không ít tiền đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561124,
					"content": "Nhưng tôi không khuyến khích làm thế. Bởi vì nếu như vậy thì chúng tôi sẽ không quên hai người đâu. Nên là, cứ thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561125,
					"content": "Tôi sẽ không tố cáo đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Haha, tôi cũng cảm thấy hai người sẽ nói như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561128,
					"content": "Vậy thì, đóa Tường Vi Cầu Vồng này tặng cho hai người nhé. Chúng tôi rất thích loại hoa này, nó mang rất nhiều ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561129,
					"content": "Hiện giờ thì ý nghĩa của nó là cảnh cáo, hy vọng hai người giữ vững suy nghĩ này của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561130,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561131,
					"content": "Thì ra... Tất cả mọi chuyện là vậy. Đúng là một gia đình phức tạp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Nói thế nào nhỉ? Tôi cũng không biết nên đánh giá ra sao nữa, cũng may lúc trước không tố cáo lên Sảnh Chấp Pháp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "Tôi thấy Autumn hơi đáng thương, đến cuối cùng vẫn không tìm được con mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "Với ban đầu tôi cứ nghĩ Benoit là người tốt... Chậc, có phải tôi rất dễ bị lừa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "Paimon tự phát hiện ra rồi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "Này! Đến lúc này rồi mà vẫn muốn chọc tôi sao... Không mời tôi đến Khách Sạn Debord ăn món ngon thì tôi sẽ không bỏ qua đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Paimon là đồ ngốc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "Tôi không thiếu tiền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
