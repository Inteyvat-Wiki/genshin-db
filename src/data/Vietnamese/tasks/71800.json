			"dialogs": [
				{
					"id": 718000301,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000302,
						718000305
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 718000302,
					"content": "Bà ơi, quần áo cháu ướt hết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000303
					]
				},
				{
					"id": 718000303,
					"content": "Xin lỗi các cháu, là ta suy nghĩ không thấu đáo, haiz, ta còn tưởng chưa tích được bao nhiêu nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000304
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 718000304,
					"content": "Nhưng ấm trà này chắc cũng đã rửa sạch rồi, mấy góc ngoài rìa cứ từ dọn nốt cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 718000307,
					"content": "Bà bà, bà đựng nước của cả con sông Bích Thủy vào rồi ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718000308,
					"content": "Đứa bé này, sao có thể chứ, người trong thành vẫn phải dùng nước cơ mà... Ta chỉ đựng nước của nửa con sông thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000309
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 718000309,
					"content": "Được rồi các cháu, lần này để các cháu chịu khổ rồi. Cầm lấy mấy thứ này đi, các cháu vất vả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000310
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 718000310,
					"content": "Đúng rồi, ta còn phải nhân lúc rảnh rỗi, đem nước trong chiếc ấm này đổ về sông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 718000305,
					"content": "Bên trong ấm đã dọn sạch sẽ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000306
					]
				},
				{
					"id": 718000306,
					"content": "Ừm, vẫn còn mấy góc ngoài rìa, phải vào dọn kỹ hơn mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Bình Lão Lão"
				}
			]
