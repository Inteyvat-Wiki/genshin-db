			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "Quả nhiên vẫn phải chăm sóc một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270102,
					"content": "Cô đang làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "Bạn là... Ồ, nhìn dáng vẻ thì chắc là Nhà Lữ Hành, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270104,
					"content": "Tôi là học viên của Học Viện Amurta - Yasmin, đang nghiên cứu về \"Cây Thánh\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270105,
					"content": "\"Cây Thánh\" này đã sống lâu hơn cả số lượng tất cả hạt cơm ở Cảng Ormos cộng lại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270106,
					"content": "Đồng thời nó còn nâng đỡ cả Giáo Viện... Tầm quan trọng của nó có thể so với rau cải lót dưới món Gà Nướng Tandoori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270107,
					"content": "So sánh kiểu gì thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Nhưng nếu nó xảy ra vấn đề gì thì Thành Sumeru cũng sẽ gặp tai họa lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270111,
					"content": "Ví dụ như, nó bị sâu bệnh, hay lượng châu chấu lớn hơn cả căn nhà chui ra vào trong cây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270112,
					"content": "Hoặc cành cây của nó mọc không kiểm soát, bộ rễ khổng lồ trồi lên từ dưới đất hệt như lũ lụt, phá hủy tất cả nhà cửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270113,
					"content": "Hoặc là, nếu như \"Cây Thánh\" này bị héo rũ, thân cây ngã xuống sẽ đè sập hơn phân nửa Thành Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270114,
					"content": "Không, không phải chứ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Đó là đương nhiên rồi, nhưng tới giờ thì tình trạng của nó vẫn rất bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270116,
					"content": "Nhưng nói mới nhớ, lúc bạn đi vào rừng hái nấm, Nấm Quỷ tấn công bạn cũng có báo trước với bạn là chúng sẽ tới đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270117,
					"content": "Sở dĩ tôi nghiên cứu ở đây, cũng là vì quan sát tình hình của cái cây này, để chuẩn bị sẵn sàng cho tất cả tình huống bất ngờ có thể xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270118,
					"content": "Nhưng như bạn thấy đó, tuy tư duy của tôi nhanh như Chim Hoàng Hôn, nhưng thể lực của tôi lại yếu như nấm sao vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270119,
					"content": "Nên Nhà Lữ Hành, bạn có thể giúp tôi ghi chép lại tình hình bộ rễ của \"Cây Thánh\" ở vài nơi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270120,
					"content": "Bình thường thì tôi sẽ thuê nhà mạo hiểm đi cùng, nhưng hình như bây giờ họ đang không rảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270121,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "Học giả các bạn đều nói chuyện như vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "Hả? Ý bạn là kiểu so sánh đó à? Thật xin lỗi, xưa giờ tôi luôn nói chuyện như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270124,
					"content": "Trong học viện cũng có rất nhiều người ý kiến về chuyện này với tôi, nhưng tôi không thể sửa được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270125,
					"content": "Vậy chuyện này xin nhờ cả vào bạn nhé, tôi sẽ ở đây chờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270108,
					"content": "Paimon chắc sẽ nghe hiểu nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Đúng là một cổ thụ vĩ đại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Paimon"
				}
			]
		},
