			"dialogs": [
				{
					"id": 230270201,
					"content": "Nhà Lữ Hành, trùng hợp thế, lại gặp được bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270202,
					"content": "Bạn vẫn đang nghiên cứu à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "Ừ, Ladep và Pharez nói là cần phải lấy thêm nhiều dữ liệu hơn, tôi chỉ có thể tiếp tục làm việc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270204,
					"content": "Nhưng không biết tình trạng của bộ rễ kia bây giờ thế nào rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270205,
					"content": "Nhà Lữ Hành, nếu như bạn rảnh thì xin giúp tôi ghi lại tình trạng của những bộ rễ kia nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
