			"dialogs": [
				{
					"id": 230271101,
					"content": "Các bạn về rồi, tình trạng bộ rễ của Cây Thánh thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271102,
					"content": "Nói lại tình hình bộ rễ cho Yasmin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "...Đã có sinh vật tụ tập ở đó, vậy chứng tỏ vùng đất đó vẫn còn sức sống rất mãnh liệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Yasmin"
				},
