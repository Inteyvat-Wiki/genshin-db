			"dialogs": [
				{
					"id": 225000101,
					"content": "Bao giờ mới làm xong đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000102,
					"content": "Hôm nay không chơi trò chơi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "#{NICKNAME}, là {F#chị}{M#anh} à, dạo này không thích hợp chơi trò chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000104,
					"content": "Meng có vẻ không vui, cứ một mình ngẩn ngơ, Fei thì chẳng thấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000105,
					"content": "Em hỏi Meng bị làm sao thế, Meng cũng không nói cho em biết... Em luôn cảm thấy rằng mọi người dạo gần đây có chút kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000106,
					"content": "Lớn lên sẽ như vậy đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "Con người ta lớn lên rồi thì sẽ không hạnh phúc sao? Nhưng Meng và Fei đều rất muốn lớn lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000108,
					"content": "Nếu mà như vậy, em sẽ không lớn lên thì tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000109,
					"content": "#Không nói chuyện này nữa, em có chút chuyện muốn nhờ {F#chị}{M#anh} giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000112,
					"content": "#{F#Chị}{M#Anh} có thể giúp em đến chỗ chị Ying'er lấy chút đồ không? Em đã nói với chị ấy, chắc chị ấy đã chuẩn bị sẵn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000113,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "#Vậy thì nhờ {F#chị}{M#anh} giúp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000115,
					"content": "Từ chỗ Ying'er...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "#{F#Chị}{M#Anh} đừng có nghĩ linh tinh, em chỉ nhờ chị Ying'er làm giúp chút đồ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000117,
					"content": "#Tóm lại là nhờ {F#chị}{M#anh} giúp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 225000110,
					"content": "Em cũng đang buồn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "#Em? Em vẫn ổn, chỉ là... có chút chuyện muốn nhờ {F#chị}{M#anh} giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Lulu"
				}
			]
		},
