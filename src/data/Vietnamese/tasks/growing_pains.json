					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "Ừm, vậy cũng được, tôi biết rất rõ... là bạn có kinh nghiệm phong phú trong chuyện này, hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000403,
					"content": "Tôi vẫn còn nguyên liệu chưa dùng hết, tôi sẽ đến bếp của Thầy Mao để xử lý chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000404,
					"content": "Trước tiên bạn hãy đi hái ba cây Bạc Hà, sau đó mang bạc hà đến đài ghép chế thành tinh dầu, chắc bạn đã nắm rõ cách làm rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000405,
					"content": "Đem tinh dầu bạc hà cho tôi, tôi sẽ làm sáp thơm cho Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
