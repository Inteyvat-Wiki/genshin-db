			"dialogs": [
				{
					"id": 225000201,
					"content": "Ui da, lại là bạn à, lần này đến tìm tôi muốn làm cái gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000202,
					"content": "Đến lấy đồ cho Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "Đồ của đứa trẻ đó à... Tôi nhớ rồi, cô bé thực sự có nhờ tôi làm một phần sáp thơm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000204,
					"content": "Nhưng mà, các bạn đến thật không đúng lúc... không biết tại sao, từ sau ngày mà các bạn đến gặp tôi, đột nhiên có rất nhiều người đến tìm tôi để đặt sáp thơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000205,
					"content": "Nhiều đơn hàng như vậy, tôi còn phải xử lý việc buôn bán của tiệm, một mình thực sự không làm xuể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000206,
					"content": "Mà Lulu vẫn là một đứa trẻ, sáp thơm là thứ mà người lớn thường dùng, nếu đưa cho cô bé dùng thì có chút không thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000207,
					"content": "Lúc trước tôi có suy nghĩ về việc điều chỉnh công thức của sáp thơm, mới vừa nghĩ ra một cách, còn chưa bắt đầu thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000208,
					"content": "Nếu cần gấp cũng không phải không được, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying'er"
				}
			]
		},
