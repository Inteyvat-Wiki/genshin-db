			"dialogs": [
				{
					"id": 225000501,
					"content": "Sáp thơm đã làm xong rồi, tôi đã dùng tinh dầu bạc hà đặc biệt làm ra đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000502,
					"content": "Này, hãy cầm lấy, mang về cho Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000503,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "Tại sao lại là tinh dầu bạc hà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "Pha loãng một với số thành phần mang tính kích thích... sẽ làm trung hoà mùi hương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000506,
					"content": "Có điều, lúc đó tôi thực không nghĩ đến sẽ nhận được đơn đặt hàng của Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000507,
					"content": "Nhớ lại cái hồi mới biết yêu thực là ngại ngùng, tim cũng đập nhanh, nếu như khi đó hiểu biết hơn một chút thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000508,
					"content": "Khụ... được rồi, bạn hãy mau mang về cho Lulu.",
