						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Bạn thật là thiếu kiên nhẫn... được rồi, coi như tôi nể mặt bạn, tôi sẽ làm cho Lulu một phần sáp thơm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000303,
					"content": "Nhưng ban ngày tôi phải trông cửa hàng, chỉ có buổi tối mới có thể làm chút việc riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000304,
					"content": "Buổi tối bạn quay lại tìm tôi nhé, tôi sẽ chuẩn bị trước mọi thứ.",
					"roleType": "TALK_ROLE_NPC",
