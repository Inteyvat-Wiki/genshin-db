			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Doudou ngoan nhé, uống thuốc là khỏi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "Không chịu đâu! Thuốc đắng lắm, con không muốn uống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "Là Nhà Lữ Hành sao... Sự việc là thế này, Doudou nhà tôi sức khỏe không được tốt, trước kia có nhờ ngài Bai bốc thuốc chữa bệnh cho con bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "Thế nhưng Doudou nhất quyết không chịu uống vì thuốc quá đắng, haizz trên thế gian này làm gì có thứ thuốc nào mà không đắng cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "Để dỗ con bé, tôi đồng ý mua cho nó 1 phần \"Đậu Hũ Hạnh Nhân\" nếu chịu uống thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "Nhà Lữ Hành nếu có thời gian rảnh hay giúp tôi kiếm \"Đậu Hũ Hạnh Nhân\" được không? Tôi phải ở đây dỗ Doudou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Nhờ bạn giúp vậy, chỉ cần 1 phần cho Doudou là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "Cô bé mắc bệnh gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "Haizz ngài Bai nói bệnh của con bé rất khó trị khỏi, cho dù chữa triệu chứng cũng phải liên tục uống thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "Tôi sợ Doudou phải uống thuốc cả đời mất, con bé mới nhỏ như vậy mà... Tôi không dám nghĩ tiếp nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "Tại sao người mắc bệnh không phải là tôi cơ chứ. Hiện tại... Tôi chỉ mong Doudou có thể bớt chịu khổ mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "Nhà Lữ Hành, nhờ bạn giúp vậy, giúp tôi tìm một phần Đậu Hũ Hạnh Nhân, một phần là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Doudou vì sao không muốn uống thuốc vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "Thuốc đắng quá! Thuốc của Lulu không có khó uống như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Doudou, Lulu hai đứa đang chơi trò chơi mà, đó đều là chè Đậu Hũ Hạnh Nhân, không phải là thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Vậy... Con ăn Đậu Hũ Hạnh Nhân có thể chữa lành bệnh không? Vì sao phải uống thuốc đắng chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Doudou ngoan nhé, chỉ cần bệnh khỏi rồi về sau thích ăn gì mẹ cũng mua cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "Tại sao thuốc không ngon ngọt như Đậu Hũ Hạnh Nhân chứ, thật là đáng ghét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "Đứa trẻ này, haizz... Nhà Lữ Hành phải phiền bạn kiếm hộ tôi Đậu Hũ Hạnh Nhân, chỉ cần 1 phần thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
