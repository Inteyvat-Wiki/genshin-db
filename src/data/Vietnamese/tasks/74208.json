				{
					"id": 742080301,
					"content": "Về Tinh Thạch Dị Sắc Thần Bí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742080302
					]
				},
				{
					"id": 742080302,
					"content": "Quy tắc cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080303
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080303,
					"content": "Được lắm. Nhưng tôi nghĩ, có lẽ sau này chúng ta không còn cơ hội làm ăn vui vẻ như vậy nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080304
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080304,
					"content": "Những thứ bí ẩn luôn thần bí vì chúng hiếm có. Trước đây tôi cũng từng mua lại một số Tinh Thạch Dị Sắc Thần Bí từ tay các nhà mạo hiểm, nhưng cũng chỉ giao dịch được ba lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080305
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080305,
					"content": "Theo lời anh ta, sau đó không còn kiếm được thứ tương tự như vậy nữa. Hẳn trong đó có những bí ẩn mà chúng ta không hề biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080306
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080306,
					"content": "Theo tôi, giữ lại chút bí ẩn cho thế giới này cũng là một lựa chọn không tồi, phải không?",
					"roleType": "TALK_ROLE_NPC",
