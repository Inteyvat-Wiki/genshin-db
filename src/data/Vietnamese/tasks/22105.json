			"dialogs": [
				{
					"id": 221050101,
					"content": "Phiền quá à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "Tôi luôn cảm thấy quanh nhà trọ có gì đó không ổn, nhưng không rõ là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050104,
					"content": "Hơn nữa trong nhà trọ của chúng tôi, lại toàn những khách trọ vô cùng nhạy cảm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050105,
					"content": "Gió thổi cỏ lay, rèm cửa rơi vài cái, nói không biết chừng sàn nhà vỡ vài miếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050106,
					"content": "Tuy là khách trọ đều tự bỏ tiền túi ra sửa, thế nhưng đằng đông một miếng bên tây một miếng cũng nhìn khó chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050107,
					"content": "Bạn có thể đi quanh nhà trọ? Xem có gì không thỏa đáng thì xử lý, tôi còn phải tiếp khách ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050108,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Vậy thì nhờ bạn giúp đỡ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050109,
					"content": "Những vị khách này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "Quý khách? Ai da, đừng để bụng, những người quanh năm lăn lộn bên ngoài khó tránh khỏi hơi nhạy cảm quá đà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050112,
					"content": "Vậy nhờ vào bạn rồi, mau đi quanh xem có chuyện gì xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
