			"dialogs": [
				{
					"id": 706920101,
					"content": "Ồ ồ, kỵ sĩ nhỏ à, cậu thu hút đại anh hùng của chúng ta đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920102
					],
					"speakerTitle": "\"Điên Cuồng Vì Tranh\""
				},
				{
					"id": 706920102,
					"content": "Là tiền bối Kỵ Sĩ Danh Dự và trợ thủ nhỏ màu trắng! Xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920103,
					"content": "Mika và... người bạn Natlan? Cả hai đang bận rộn chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920104,
					"content": "Chúng tôi đang quảng bá một loại \"Trinh Sát Saurian\" rất hữu ích cho các đội mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920105
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920105,
					"content": "Nó được kết hợp từ lõi đồng đội trinh sát mà tiền bối Amber mang về từ Sumeru, cùng với dáng vẻ búp bê Saurian do bạn bè Natlan gửi tặng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920106,
					"content": "Đồng đội máy móc à... Ồ, tôi có ấn tượng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920107,
					"content": "Tương tự với chức năng của đồng đội trinh sát ở Sumeru, Trinh Sát Saurian có thể giúp do thám ma vật và thăm dò địa hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920108,
					"content": "Tuy nhiên, do chức năng được tập trung vào vế sau, nên nó sẽ chú trọng hơn vào khả năng kiểm soát và độ chính xác trong hành động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920109,
					"content": "...Tiền bối Kỵ Sĩ Danh Dự có muốn bay thử chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920110,
						706920111
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920110,
					"content": "Quả là một lời giới thiệu nghiêm túc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				},
				{
					"id": 706920112,
					"content": "Hả? Là... là tại tôi căng thẳng quá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920113,
					"content": "#Hình như là vậy... Rõ ràng lúc trước đã thả lỏng được rồi, có thể đối diện với {F#cô}{M#cậu} một cách tự nhiên hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920114,
					"content": "#Nhưng gần đây nghe từ bạn bè ở nhiều nước khác kể về thành tích của {NICKNAME}, chợt cảm thấy {NICKNAME} ngày càng lợi hại và xuất sắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920115
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920115,
					"content": "#Nghĩ đến việc, sau này phải giúp được {NICKNAME}, không được phép làm vướng chân {F#cô}{M#cậu}, vô thức tôi lại càng thêm căng thẳng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920116
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920116,
					"content": "Đúng là suy nghĩ đặc trưng của Mika mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920117,
					"content": "Cậu làm tốt lắm rồi, kỵ sĩ nhỏ à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920118
					],
					"speakerTitle": "\"Điên Cuồng Vì Tranh\""
				},
				{
					"id": 706920118,
					"content": "#Ở Natlan, khi gặp được {NICKNAME}, có những chiến binh bộ tộc còn phấn khích đến mức nói năng lộn xộn, thậm chí có người còn không nói được câu nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920119
					],
					"speakerTitle": "\"Điên Cuồng Vì Tranh\""
				},
				{
					"id": 706920119,
					"content": "#Cậu là đồng nghiệp của {NICKNAME}, cũng được coi là cao thủ huyền thoại rồi. Nếu có trò chuyện với tộc trưởng của chúng tôi thì cũng không cần e ngại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920120
					],
					"speakerTitle": "\"Điên Cuồng Vì Tranh\""
				},
				{
					"id": 706920120,
					"content": "Đúng rồi đúng rồi, Mika phải tự tin lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920121,
					"content": "Còn có chuyện như vậy à... Tôi chưa từng nghĩ đến góc độ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920122
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920122,
					"content": "#Tóm lại, nếu {NICKNAME} cảm thấy hài lòng sau khi bay thử Trinh Sát Saurian, thì chắc chắn cỗ máy hỗ trợ vừa dễ thương vừa đáng tin cậy này sẽ giúp ích được cho nhiều đội mạo hiểm hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920123,
						706920124
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920123,
					"content": "Chuyện này tôi rành lắm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920125,
					"content": "Được! Giờ tôi sẽ điều chỉnh Trinh Sát Saurian, chúng ta có thể bắt đầu sớm thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920124,
					"content": "Để tôi xem thử khả năng của Saurian nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920111,
					"content": "Không cần phải trang trọng vậy đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				}
			]
		}
	]
}