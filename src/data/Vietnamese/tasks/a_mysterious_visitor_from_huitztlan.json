					}
				]
			},
			"dialogs": [
				{
					"id": 150000501,
					"content": "#Woa! {M#Anh chị}{F#Hai chị} giỏi ghê! Mới đó mà đã quay lại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000502
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000502,
					"content": "#Các bé Saurian không sao thì tốt quá. Vậy chúng em có thể yên tâm về nhà rồi. Cảm ơn {M#anh chị}{F#hai chị} nhiều nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000503
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000503,
					"content": "Đừng khách sáo, cũng chẳng mất bao nhiêu công sức mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000504,
					"content": "#{M#Anh chị}{F#Hai chị} đã leo lên núi cao như thế, chắc chắn là rất vất vả. Nhìn cách ăn mặc của {M#anh chị}{F#hai chị} chắc không phải người bản địa nhỉ? Hay tới nhà em nghỉ chân nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000505
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000505,
					"content": "#Đúng đó, nhân cơ hội này để chúng em thể hiện sự nhiệt tình hiếu khách của Dòng Dõi Vườn Treo! {F#Hai chị}{M#Anh chị} tốt bụng như thế, không như cái chú đeo kính lúc trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000506
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000506,
					"content": "Như các em nói thì người đó cũng từ nơi khác tới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000507,
					"content": "Trang phục của chú ấy không phải kiểu Natlan... Giờ nghĩ lại thì thấy đúng là khả nghi quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000508
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000508,
					"content": "Người từ nơi khác đến mà khả nghi sao? Chắc không phải là người mà Ajaw nói đến đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000509,
					"content": "Các em có thể nói kỹ hơn về người đó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000510
					]
				},
				{
					"id": 150000510,
					"content": "#{M#Anh chị}{F#Hai chị} có hứng thú với chú đó sao? Để em nghĩ xem, chuyện là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000511
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000511,
					"content": "Chú ơi, cháu đã kể mấy câu chuyện luôn rồi đó... Khi nào chú mới có thể giúp cháu đi tìm các bé Saurian ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000512
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000512,
					"content": "Kể thêm một câu chuyện nữa đi. Hay kể tiếp chuyện về ngọn lửa đó nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000513
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000513,
					"content": "Chú nghe nói là có một ngọn lửa trong suốt khổng lồ, đã cháy từ năm trăm năm, một ngàn năm hoặc là còn từ xa xưa hơn nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000514
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000514,
					"content": "Đó là Hồi Hỏa! Tên Cổ \"Mal{RUBY#[D]Hồi Hỏa}ipo\" là được sinh ra từ truyền thuyết này đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000515
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000515,
					"content": "Chà, là nguồn gốc của Tên Cổ sao? Lợi hại thật nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000516
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000516,
					"content": "Vâng, mọi Tên Cổ đều có truyền thuyết khởi nguồn mà. Trong truyền thuyết, Hồi Hỏa xuất hiện từ thời Đại Liên Minh Natlan, được bạo chúa Och-Kan dùng để thống trị và đàn áp những người phản đối ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000517
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000517,
					"content": "Điểm khác biệt nhất của Hồi Hỏa và lửa bình thường là những người bị nó thiêu đốt tuy sẽ cảm thấy đau đớn ở sau lưng, nhưng sẽ không chết ngay. Và lúc này thì tuyệt đối không được quay đầu lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000518
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000518,
					"content": "Không được quay đầu lại?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000519
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000519,
					"content": "Vì quay đầu lại là tiêu đời luôn, sẽ bị thiêu rụi thành tro ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000520
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000520,
					"content": "Woa, đốt quần áo thì cũng thôi đi, đốt cả người thì tàn nhẫn quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000521
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000521,
					"content": "Đúng chứ? Sao lại có thể đốt sau lưng người ta mà không cho quay lại chứ? Och-Kan đúng là một bạo chúa mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000522
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000522,
					"content": "Theo truyền thuyết thì phải có người đứng ra chống lại chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000523
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000523,
					"content": "Chú đeo kính cũng biết nhiều ghê. Đúng là như thế, người đó chính là tổ tiên của Dòng Dõi Vườn Treo chúng cháu, ngài Yupanqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000524
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000524,
					"content": "Hmm, ngài Yupanqui cùng bạo chúa Och-Kan, và cả Hỏa Thần đầu tiên là ngài Xbalanque đều là bạn bè. Ông ấy là chỉ huy quân giới của Đại Liên Minh khi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000525
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000525,
					"content": "Ông ấy không đồng tình trước sự thống trị tàn khốc của Och-Kan, nên đã trộm Hồi Hỏa đi và ném nó về phía quân của bạo chúa. Không ai có thể chống đỡ được, các binh sĩ đều bị thiêu thành tro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000526
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000526,
					"content": "Cứ như thế, tổ tiên đã giải phóng mọi người. Nhưng khi trốn khỏi thành thì ông ấy dường như nghe thấy tiếng gọi của Och-Kan từ phía sau truyền đến, thế là ma xui quỷ khiến thế nào liền quay đầu lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000527
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000527,
					"content": "Nhưng ông chỉ nhìn thấy tòa thành cháy đen, binh lính bị thiêu rụi và ngọn lửa bốc lên tận trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000528
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000528,
					"content": "Ngay sau đó, ngọn lửa lóe lên trong mắt ông, và cuối cùng nuốt chửng lấy tổ tiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000529
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000529,
					"content": "Chỉ ngoảnh lại nhìn một cái thôi đó! Là bị thiêu thành tro luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000530
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000530,
					"content": "Đây là cái giá phải trả cho việc trộm lửa... hay là quay đầu lại đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000531
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000531,
					"content": "Chẳng ai biết cả, nhưng ngọn lửa trên người ngài Yupanqui còn dữ dội hơn những nơi khác. Nó cháy rực suốt cả một trăm ngày, cuối cùng đến cả Địa Mạch cũng bị thiêu thành một cái hố lớn luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000532
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000532,
					"content": "Sau đó ánh lửa lóe lên rồi rơi vào Vương Quốc Dạ Thần đen tối, cuối cùng cháy mãi tới ngày nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000533
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000533,
					"content": "Những người lớn đều nói rằng nó chiếu sáng con đường của kiếp sau. Nhưng người chết cũng phải chịu đựng sự thiêu đốt của nó, như thế thì mới có thể sạch sẽ để đón chào kiếp sống mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000534
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000534,
					"content": "Giống như là hồi tưởng và thẩm vấn về cả cuộc đời... Cho nên mọi người gọi nó là Hồi Hỏa của Yupanqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000535
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000535,
					"content": "Ồ... Câu chuyện đầy ý thơ đó! Cho nên là ở Vương Quốc Dạ Thần thật sự có thể nhìn thấy ngọn lửa này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000536
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000536,
					"content": "Cháu không biết... Đây chỉ là một truyền thuyết thôi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000537
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000537,
					"content": "Cho nên về sau, chỗ các cháu có người kế thừa cái Tên Cổ này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000538
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000538,
					"content": "Tất nhiên rồi! Ví dụ như vị anh hùng Burkina của tế lễ Đêm Hồi Hỏa. Nhưng mà đó là người của năm trăm năm trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000539
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000539,
					"content": "Ừm, bây giờ cái Tên Cổ này thuộc về anh Kinich rồi... \"Mal{RUBY#[D]Hồi Hỏa}ipo\" Kinich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000540
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000540,
					"content": "Kinich...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000541
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000541,
					"content": "Được rồi, chú đeo kính, chúng cháu đã kể rất nhiều câu chuyện rồi, chú nên đi tìm các bé Saurian rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000542
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000542,
					"content": "À... Nhưng truyền thuyết về Hồi Hỏa không phải đã dạy chúng ta rằng đừng quay đầu lại sao? Cho nên là đừng nhắc lại những gì đã nói trước đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000543
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000543,
					"content": "Hãy kể thêm về Kinich nhé, từ giờ trở đi mới tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000544
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000544,
					"content": "Ấy? Toba, sao trông cháu như muốn mắng chú vậy? Thế là không được đâu nhé, đó là đặc quyền của người lớn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000545
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000545,
					"content": "Chú... Chú mà lừa chúng cháu... Thì khi chết đi sẽ bị Hồi Hỏa thiêu đốt thảm lắm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000546
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000546,
					"content": "Lửa ở đây thì làm sao mà thiêu đốt được người từ nơi khác đến chứ? Chú không phải là đồng hương của các cháu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000547
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000547,
					"content": "Hả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000548
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000548,
					"content": "Đợi đã... Đó là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000549
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000549,
					"content": "Được rồi các cháu, chú sẽ không nghe kể chuyện không công đâu. Chú sẽ cử hai người bạn tới đây, ừm... Họ sẽ tới giúp các cháu ngay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000550
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000550,
					"content": "Các cháu cứ nhờ vả họ nhiệt tình nhé. Không cần nể mặt chú đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000551
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000551,
					"content": "Thật chứ ạ? Vậy chú đeo kính, chú tên là gì ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000552
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000552,
					"content": "Chúng ta gặp nhau dưới vách núi này, vậy nên gọi chú là \"Sanka\" nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000553
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000553,
					"content": "Có phải không đấy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000554
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000554,
					"content": "Không tin thì quay lại nhìn xem, họ đã tới rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000555
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000555,
					"content": "Hả? Làm gì có đâu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000556
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000556,
					"content": "Chú... Ơ, chú Sanka đâu rồi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000557
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000557,
					"content": "Nghe có vẻ như tên này có chút khả nghi đấy... Hình như là đang nghe ngóng câu chuyện về Tên Cổ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000558
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000558,
					"content": "Đúng đó! Cái chú đeo kính đáng ghét đó đã phản bội chúng em! Chú ấy sẽ phải trả giá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000559
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000559,
					"content": "Nhưng cũng chỉ là nghe vài câu chuyện rồi đi mất thôi mà, chắc cũng chẳng có gì to tát đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000560
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000560,
					"content": "#Hmm... {NICKNAME}, chúng ta có nên nói cho Kinich biết không? Tuy Ajaw đang điều tra rồi, nhưng tôi cứ cảm thấy không đáng tin cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000561
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000561,
					"content": "#Hửm? {F#Hai chị}{M#Anh chị} cũng biết anh Kinich sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000562
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000562,
					"content": "Thật ra thì cũng không tính là thân thiết lắm, chỉ mới gặp nhau và dùng bữa chung thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000563
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000563,
					"content": "Ngưỡng mộ quá! Em còn chưa được nói chuyện với anh Kinich bao giờ cả. Anh ấy là thợ săn Saurian trong tộc, còn có Tên Cổ rất lợi hại nữa, ngầu lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000564
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000564,
					"content": "Em cũng thế! Nhưng cha em không thích anh ấy lắm, còn bảo em ít tiếp xúc với anh ấy nữa... Chắc chắn là do người bạn đồng hành vừa kiêu căng vừa độc ác bên cạnh anh ấy rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000565
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000565,
					"content": "#A! Là cái tên xấu xa tự xưng là K'uhul Ajaw đó sao! {F#Hai chị}{M#Anh chị} cũng gặp rồi, đúng là cứ như sợ người ta không ghét được mình ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000566
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000566,
					"content": "Đúng đó! Thật là không hiểu sao anh Kinich lại chọn tên đó làm bạn nữa. Sao không chọn em này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000567
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000567,
					"content": "Úi! Toi rồi, Huni, chúng ta ra ngoài lâu quá rồi... Còn không về ngay là sẽ bị mắng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000568
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000568,
					"content": "#À đúng nhỉ. Vậy... {M#anh chị}{F#hai chị} cứ đi theo con đường này là sẽ đến tộc của bọn em rồi. Nếu có ý định qua đó thì nhớ tới thăm nhà em nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000569
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000569,
					"content": "Nếu có cần gì thì em sẽ nhờ cha giúp cho. Nhất định phải tới đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000570
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000570,
					"content": "#Tạm biệt {M#anh chị}{F#hai chị} nhé! Chúng em đi trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toba"
				}
			]
		},
