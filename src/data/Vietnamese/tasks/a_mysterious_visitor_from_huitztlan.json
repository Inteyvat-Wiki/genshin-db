				]
			},
			"dialogs": [
				{
					"id": 150000401,
					"content": "Awoo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000402
					],
					"speakerTitle": "Pocchi",
					"speakerSubtitle": "Yumkasaurus Con"
				},
				{
					"id": 150000402,
					"content": "Các bé Saurian ở đây này! Ấy? Bên cạnh còn có... Ajaw?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000403,
					"content": "Đây chẳng phải là hai người bạn tốt của người hầu đi chung với ta sao? Ở dưới kia nhìn thấy bóng dáng anh dũng của ta nên mới leo lên đây tôn thờ ta hả? Xem ra mấy ngày trước gặp nhau là đã khắc sâu sự vĩ đại của ta vào trong tâm trí rồi chứ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000404
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000404,
					"content": "Đúng là hết cách mà. Nào, hãy hôn lên chân ta. Thánh Long K'uhul Ajaw Toàn Năng đây cho phép các ngươi thờ phụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000405
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000405,
					"content": "Ngươi... Ngươi không phải là tùy tùng của Kinich đó sao? Đang lẩm bẩm gì thế? Còn đáng ghét hơn cả lần trước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000406,
					"content": "Ăn nói hàm hồ! Cái gì mà tùy tùng chứ? Ta là loài rồng tối cao! Là lãnh chúa vĩ đại của Vương Quốc Lửa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000407
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000407,
					"content": "Lần trước nếu không phải Kinich van xin lạy lục thì ta còn lâu mới nhân từ mà nói chuyện với các người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000408
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000408,
					"content": "Gì vậy trời! Rõ ràng là bị Kinich nhốt lại mà, ngươi cũng giỏi ra vẻ quá nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000409,
						150000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000409,
					"content": "Ngài lãnh chúa, ngài làm gì trên núi này thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000410
					]
				},
				{
					"id": 150000410,
					"content": "Hừ, thế này còn tạm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000413,
					"content": "Nếu muốn biết thì dạo này ta đã đồng ý với lời khẩn cầu của tên tùy tùng kia, để điều tra vấn đề về Vực Sâu ở gần Huitztlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000414
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000414,
					"content": "Vấn đề về Vực Sâu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000415,
					"content": "Thấy đám bò sát nhỏ này không? Mẹ của nó là một con bò sát trung bình, đã bị sức mạnh Vực Sâu ăn mòn. Sau đó nó tấn công bộ tộc của tùy tùng ta, thậm chí còn tấn công chính con cái của mình nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000416
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000416,
					"content": "Hả... Vậy giờ nó thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000417,
					"content": "Đám bò sát thấp kém thì sao có thể đối đầu với Vực Sâu chứ? Tất nhiên là đã đi đến Vương Quốc Dạ Thần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000418
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000418,
					"content": "Sinh linh yếu ớt đó... Nghe nói đã nhảy từ vách núi cao xuống tự kết liễu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000419
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000419,
					"content": "Nhảy từ vách núi cao xuống à...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000420,
					"content": "Nào, con kiến bay nhỏ màu trắng kia, đừng trưng ra vẻ mặt ngốc nghếch với hàng trăm câu hỏi như thế nữa. Thánh Long K'uhul Ajaw Toàn Năng ta đây không phải là dòng suối để cho cầu nguyện đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000421
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000421,
					"content": "Ai là kiến bay nhỏ màu trắng chứ?! Ta phải nghĩ cho ngươi một cái biệt danh gì đó thật khó nghe mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000422,
					"content": "Hừ, ta phát hiện gần đây có chút dấu vết của Vực Sâu, chắc chắn là có thuật sĩ tà ác giỏi ẩn nấp xuất hiện. Nếu gặp phải người khả nghi từ nơi khác tới thì các ngươi phải hỏi cho thật kỹ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000423
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000423,
					"content": "Người khả nghi từ nơi khác tới... Này, đang nói móc ta đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000424,
					"content": "Haha! Lấy lòng tôi tớ đo bụng chủ nhân! Nếu ngươi không phải là bạn của người hầu ta thì ta đã đánh ngươi từ lâu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000425
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000425,
					"content": "Nếu đã không phải tới bái lạy ta thì hãy mau lui xuống đi! Thánh Long K'uhul Ajaw Toàn Năng đây còn phải đi lo việc quan trọng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000411,
					"content": "Tùy tùng nhỏ đang làm gì trên núi thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000412
					]
				},
				{
					"id": 150000412,
					"content": "Là ngài lãnh chúa! Muốn làm cho Thánh Long K'uhul Ajaw Toàn Năng ta đây tức giận sao? Tội lỗi của ngươi sẽ bị Hồi Hỏa thiêu rụi trong hàng ngàn năm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "Ajaw"
				}
			]
		},
		{
