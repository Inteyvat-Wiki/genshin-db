				]
			},
			"dialogs": [
				{
					"id": 150000101,
					"content": "#Chào {M#anh chị}{F#hai chị}! Em là Huni, {M#anh chị}{F#hai chị} tới giúp em tìm kiếm Saurian con sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000102
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000102,
					"content": "#Em là Toba. Nếu em không nhầm thì {F#hai chị}{M#anh chị} chính là người giúp đỡ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000103
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000103,
					"content": "#Hửm? Bạn nhỏ, rất vui được gặp các em, nhưng mà {F#hai chị}{M#anh chị} chỉ đi ngang qua thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000104,
					"content": "#Nhưng chú Sanka nói là sẽ nhờ bạn bè tới giúp mà... Không phải là {F#hai chị}{M#anh chị} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000105
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000105,
					"content": "#{M#Anh chị}{F#Hai chị} đúng là có vài người bạn, nhưng mà không có ai tên là Sanka cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000106
					]
				},
				{
					"id": 150000106,
					"content": "...Tuy không rõ tình hình cụ thể là thế nào, nhưng có lẽ các em nhận nhầm người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000107,
					"content": "Nhận nhầm người à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000108
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000108,
					"content": "Chết rồi, Huni, nhất định là chúng ta bị lừa rồi. Cái chú đeo kính đó quả nhiên là lừa đảo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000109
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000109,
					"content": "Vậy thì Saurian con phải làm thế nào bây giờ... Không còn nhiều thời gian nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000110
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000110,
					"content": "Bạn nhỏ, đừng sốt ruột, Saurian con mà em nói tới bị làm sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000111,
					"content": "Dạo này trong tộc không được yên bình lắm, Saurian của cha em gặp chuyện rồi. Nó tên là Nanna, và có ba bé Saurian con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000112
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000112,
					"content": "Sau khi Nanna gặp chuyện, các bé ấy đều rất sợ hãi, trốn mất tiêu. Em lo lắm, nên muốn đi tìm chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000113
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000113,
					"content": "Saurian của cha em... Vậy cha em không lo lắng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000114,
					"content": "Cha là trưởng lão trong tộc, đang bận chuẩn bị cho Đêm Hồi Hỏa. Chuyện đó quan trọng lắm, ít nhất là quan trọng hơn chuyện này. Em cũng giấu cha chạy ra đây đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000115
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000115,
					"content": "Em tưởng là sẽ không lâu lắm, nhưng mà cái chú ban nãy cứ bám lấy bọn em đòi nghe rất nhiều chuyện, nên là lãng phí rất nhiều thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000116
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000116,
					"content": "Thật đáng ghét, chú đeo kính đó thật là vô tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000117
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000117,
					"content": "#Được rồi, hay là để {F#hai chị}{M#anh chị} tìm giúp cho! Nghe có vẻ cũng không rắc rối lắm, {F#hai chị}{M#anh chị} đây cũng rất tốt bụng nữa. Phải không, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000118,
					"content": "Tất nhiên rồi. Vậy là các bé Saurian đó ở xung quanh đây à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000119
					]
				},
				{
					"id": 150000119,
					"content": "Chắc là thế ạ. Em đã phát hiện vài dấu vết rồi, chắc chúng đang trốn ở vách núi gần đây thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000120
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000120,
					"content": "#Cứ giao cho {M#anh}{F#chị} và Paimon nhé, sẽ không lâu đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000121
					]
				},
				{
					"id": 150000121,
					"content": "#Thật chứ ạ? Vậy... Vậy em cảm ơn {M#anh}{F#chị} {NICKNAME} và chị Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000122
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000122,
					"content": "#À! {M#Anh chị}{F#Hai chị} phải cẩn thận nhé, vách núi rất dốc, người lớn trong tộc cũng khó khăn lắm mới leo được lên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toba"
				}
			]
		},
