			"dialogs": [
				{
					"id": 740580101,
					"content": "Puca, chúng ta lại gặp nhau rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#{M#Anh}{F#Chị} {NICKNAME} và Paimon đến chơi với Puca phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580103,
					"content": "Cũng không hẳn, lần trước Puca nói là có thể đến hỏi em chuyện liên quan tới khoáng thạch quanh đây, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Đúng vậy, em đã thu thập hết những viên đá đẹp ở quanh đây, không biết mọi người muốn tìm viên đá thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580105,
					"content": "Chính là viên mà lần trước nhặt được đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "Mọi người kể Puca nghe chuyện bán khoáng thạch cho thương nhân ở Đại Sảnh Fontaine...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "Hả? Hóa ra với người ngoài thì đó là đá quý sao? Lúc trước em có mang cho chị em xem qua rồi... Đúng là không hiểu được suy nghĩ của người ngoài mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580108,
					"content": "Nhưng em biết còn rất nhiều nơi có loại đá này, để em nói cho mọi người nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580109,
					"content": "Puca đánh dấu địa điểm có thể tìm được khoáng thạch kỳ lạ cho các bạn.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "Tốt quá rồi, cảm ơn Puca nhé! Đây là số Mora mà Chesil ứng trước, hihi, chia một nửa cho em đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "Em không cần đâu, cuộc sống trong làng cũng không cần đến thứ này... Hơn nữa mọi người đã giúp em rất nhiều, chuyện này có đáng gì đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		},
