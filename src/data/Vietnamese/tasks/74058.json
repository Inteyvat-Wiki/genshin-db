			"dialogs": [
				{
					"id": 740580201,
					"content": "Có nhiều vậy sao? Các vị thật sự đã giúp tôi một việc lớn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "Thợ thủ công có vẻ không hiểu rõ lắm về tính chất của loại đá quý này, nên dẫn đến một vài vấn đề... Viên đá quý lần trước đưa đi gia công đến bây giờ vẫn chưa nhận được thành phẩm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "Nhưng không sao, tôi tin tưởng vào tầm nhìn của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "Tôi sẽ gia công chúng thành kiểu dáng trang sức thời thượng nhất, chắc chắn sẽ nổi tiếng khắp Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "Lần sau các vị đến chắc sẽ thấy được thành phẩm rồi đấy! Lúc đó, tôi cũng sẽ tặng hàng mẫu cho các vị coi như thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "Nhưng không chừng các vị sẽ nhìn thấy trên người các quý tộc thượng lưu trước đấy, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "Được rồi, tôi mong chờ lần nhập hàng tiếp theo đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
