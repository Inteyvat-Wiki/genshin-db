			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iron Ingot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "\"Chòm sao Cửu Thiên Huyền La Tiên Nhân Mạn Thiên Phi\"... đẹp quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330102,
					"content": "Bạn đang ngắm sao à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "Đúng... mà cũng không đúng, không phải đang là tết hải đăng sao? Ngắm nhìn những thứ tao nhã như thế này cũng hợp cảnh mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330104,
					"content": "Tôi còn học làm thơ, nghe các anh em khác nói con gái bây giờ rất thích như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330105,
					"content": "Hì, chắc là Ziwei cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330106,
					"content": "Làm thơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "E hèm... Tôi nghe Ziwei nói về tên của rất nhiều chòm sao, ôi... những cái tên đó thật hay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330109,
					"content": "Bạn xem, tôi phải cảm ơn mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330110,
					"content": "Tôi nghĩ, tôi sẽ viết bài thơ của mình lên đèn tiêu, cùng Ziwei tìm một nơi đẹp nhất để thả... nhâm nhi vài món ăn vặt và hát một bài hát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330111,
					"content": "Chuyện tốt này chằng phải rất tốt rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330112,
					"content": "Rất tốt...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "E hèm! Ý tôi là... bầu không khí lễ tết này không phải đã rất tốt rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330114,
					"content": "Tóm lại, tôi muốn tìm một nơi không khí tốt hơn, ít người qua lại hơn, cảnh đẹp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330115,
					"content": "Tôi đã tìm người để hỏi, tìm được hai chỗ... Bạn xem, là hai chỗ này nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330116,
					"content": "Tôi nghe các anh em khác nói trước đây họ đều thả đèn ở hai chỗ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330117,
					"content": "Nhưng tôi còn phải làm thơ... Đi loanh quanh sẽ bị mất cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330118,
					"content": "Bạn có thể đi khảo sát giúp tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330119,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "Cám ơn bạn đồng ý giúp đỡ, vậy thì phiền bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330107,
					"content": "Ziwei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
