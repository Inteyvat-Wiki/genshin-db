			"dialogs": [
				{
					"id": 413330301,
					"content": "Hả? Các bạn đến từ khi nào vậy, Đậu Hũ Hạnh Nhân chuẩn bị tới đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330302,
						413330303
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330302,
					"content": "Chuẩn bị xong rồi",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "Vẫn cần thêm chút thời gian...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "Ồ, không sao đâu, tôi cũng đang nghĩ xem bài thơ này nên viết như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				}
			]
		},
		{
