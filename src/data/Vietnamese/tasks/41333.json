			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iron Ingot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "\"Iron Ingot và Ziwei vừa gặp gỡ\"... Không được không được, lộ liễu quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330202,
					"content": "Hả? Các bạn đến đây từ lúc nào vậy, tìm hết các nơi chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330203,
					"content": "Tìm hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "Nhanh vậy? Để tôi xem xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330205,
					"content": "Ừm... Để tôi xem xem... một cái chồng lên nhau rất đặc biệt, một cái xếp rải rác thành hàng... Đúng là \"Bên này là núi kia là non\"... câu tiếp theo là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330206,
					"content": "...Thôi mặc kệ đi, nhìn từ phía trước vẫn đẹp và khí thế hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330207,
					"content": "Ừm, được rồi! Tôi biết phải chọn ở đâu rồi... Nhà Lữ Hành, tôi muốn nhờ bạn giúp thêm một việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330208,
					"content": "Anh em tôi nói, khi nói chuyện với người khác, tốt nhất là nên chuẩn bị một ít đồ ăn, bạn nghĩ nếu nói chuyện với Ziwei thì tôi nên chuẩn bị gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330209,
					"content": "Cá Hổ Nướng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "Cá Hổ Nướng... Ôi, có nhiều dầu mỡ quá không, cũng không quá đặc biệt, hay là Đậu Hũ Hạnh Nhân đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330212,
					"content": "Đúng, Đậu Hũ Hạnh Nhân, món này rất thích hợp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330213,
					"content": "Nhà Lữ Hành, nhờ bạn giúp tôi chuẩn bị một phần Đậu Hũ Hạnh Nhân, tôi đang lo làm cho xong bài thơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330214,
					"content": "\"Sẽ bắn ra vô số tia lửa\"... câu này không tệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330211,
					"content": "Đậu Hũ Hạnh Nhân",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
