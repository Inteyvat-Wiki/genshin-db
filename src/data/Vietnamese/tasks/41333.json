				"objectNames": [
					"Ziwei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "Góc độ này... chòm sao này... rất giống một chú chó... Nên đặt tên gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330702,
					"content": "Ồ, là Iron Ingot à? Các bạn tìm tôi có gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330703,
					"content": "Ừm... chuyện là... khi đi dạo bên ngoài cảng Liyue, tôi vô tình phát hiện một nơi rất tuyệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330704,
					"content": "Một nơi rất tuyệt? Là nơi để ngắm sao sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330705,
					"content": "Đúng vậy, là một nơi rất đẹp để ngắm sao, cũng là nơi để thả đèn tiêu. Tôi đã chuẩn bị xong đèn tiêu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330706,
					"content": "Bạn xem, tôi còn... còn viết một bài thơ lên trên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330707,
					"content": "\"Sắt và thiên thạch vừa gặp nhau, vô số tia lửa cùng xuất hiện\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330708,
					"content": "Ừm... Tuy tôi không biết bạn muốn ước gì, nhưng bài thơ này rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330709,
					"content": "Nhưng nguyện vọng trên đèn tiêu không được để người khác xem trước, nếu không sẽ mất linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330710,
					"content": "Rồi sao, bạn đến tìm tôi có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330711,
					"content": "Tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330712,
					"content": "Bạn ấy đã tìm được một nơi rất thích hợp để thả đèn tiêu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "Thả đèn tiêu? Ừm... xin lỗi, thật ra tôi đang muốn tìm một nơi ít đèn tiêu một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330715,
					"content": "Vì ánh sáng của đèn tiêu sẽ ảnh hưởng đến việc ngắm sao, tôi định đi xa hơn một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330716,
					"content": "Cảm ơn ý tốt của bạn, tôi phải đi về bên này, chúc các bạn tết hải đăng vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330717,
					"content": "Hả... Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330718,
					"content": "Đi mất rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "Tôi... Tôi không sao, chắc do tôi viết mơ hồ quá nên Ziwei không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330721,
					"content": "Yên tâm, tôi sẽ không nản lòng đâu, rồi có một ngày... cô ấy sẽ hiểu được tấm lòng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330722,
					"content": "Nhà Lữ Hành, cảm ơn bạn đã giúp tôi, hãy nhận lấy những thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330723,
					"content": "Haiz, ít ra thì tôi cũng phải thả chiếc đèn tiêu này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330719,
					"content": "Đừng nản lòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "Nếu bạn muốn thả đèn tiêu, hay là đi cùng bạn ấy đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
