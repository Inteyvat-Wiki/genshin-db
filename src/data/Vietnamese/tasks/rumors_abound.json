						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "Không ngờ đám Fatui đó lại lấy doanh trại Hilichurl che mắt mọi người để đóng quân ở đây một thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210202,
					"content": "Mục đích của chúng là gì nhỉ? Không lẽ đúng như các quân sĩ nói, chúng đã cấu kết với Hiệp Hội Tenryou sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210203,
					"content": "Chúng ta phải điều tra doanh trại này thật kỹ, nếu như vị thương nhân đó không nói dối thì hàng hóa nhất định vẫn còn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210204,
					"content": "Được! Chúng ta đi xung quanh tìm thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202103,
