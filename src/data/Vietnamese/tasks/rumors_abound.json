			"dialogs": [
				{
					"id": 120210401,
					"content": "Đó là, đó là hàng hóa của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210402,
					"content": "Đa tạ đại nhân Sangonomiya! Đa tạ đội trưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210403,
					"content": "Vậy là đã đủ chứng minh cho sự trong sạch của tôi rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210404,
					"content": "Hứ... ai nói thế, nói không chừng ngươi đã thương lượng trước với Fatui rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210405,
					"content": "Xét theo phía thông tin từ doanh trại Fatui cho thấy, anh và Fatui không có mối liên hệ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210406,
					"content": "Nếu không thì với phong cách làm việc của Fatui, nhất định sẽ để lại manh mối gì đó mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210407,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210408,
					"content": "Không nhưng nhị gì cả, giờ đã tìm được hàng hóa rồi, chúng ta phải giải oan cho anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210409,
					"content": "Xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210410,
					"content": "Là do chúng tôi lỗ mãng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210411,
					"content": "Hừ... tôi đã sớm nói những tên lính các người thích lo chuyện bao đồng rồi, lại còn dám kiếm chuyện với tôi nữa. Lần này đã biết lỗi rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210412,
					"content": "Vị thương nhân này đừng tự đắc quá, tuy chúng tôi đã chứng minh được sự trong sạch của anh, nhưng căn cứ theo pháp lệnh mới nhất, anh đã phạm tội đầu cơ tích trữ, cần phải trừng phạt theo đúng luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210413,
					"content": "Nếu anh đã thừa nhận đây là hàng hóa của anh, vậy thì chúng tôi sẽ dùng biện pháp thiết yếu để cưỡng chế bình ổn giá cả, anh còn phải đóng thêm một khoản tiền phạt, con số là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210414,
					"content": "Chờ, chờ đã! Đại nhân Sangonomiya, đại nhân không phải đang đứng về phía tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210415,
					"content": "Đương nhiên là không rồi! Tôi là \"Thánh Pháp Sư Đương Nhiệm\" của đảo Watatsumi, phải tuân thủ theo nguyên tắc thưởng phạt phân minh chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210416,
					"content": "Có công ắt thưởng, có tội ắt phạt. Tôi đã trả anh sự trong sạch, nhưng anh cũng phải trả giá cho sai phạm của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210417,
					"content": "Cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210418,
					"content": "Nhìn cái gì, mau đi nộp phạt đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210419,
					"content": "Đại nhân Sangonomiya, tuy người này nói đây đều là hàng hóa của hắn, nhưng tôi cảm thấy có gì đó kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210420,
					"content": "Có nhiều món hàng có con dấu của Hiệp Hội Tenryou, không thể giả được, nhưng có một số thì không có. Đặc biệt là thứ này, rõ ràng là để chuyển cho đền thần mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210421,
					"content": "Ừm... có lẽ Fatui đã để chung những món đồ mà chúng cướp được với nhau. Những món hàng khác thì phiền các anh tìm lại khổ chủ nhé, chuyện của đền thần thì cứ giao cho tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210422,
					"content": "Vất vả cho các anh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210423,
					"content": "Không đâu, thưa đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210424,
					"content": "Nhưng mà đại nhân, tuy lần này không bắt được thóp, nhưng việc Hiệp Hội Tenryou cấu kết với Fatui đích thực là có người thấy tận mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210425,
					"content": "Chuyện đàm phán... mong đại nhân suy nghĩ cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210426,
					"content": "Tôi biết rồi, tôi sẽ suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210427,
					"content": "#{NICKNAME}, chúng ta chuẩn bị mang những món này về Sangonomiya thôi, bạn muốn cùng tôi đi một chuyến chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
