				{
					"id": 120210807,
					"content": "Từ lúc đó trở đi, mối quan hệ của đảo Watatsumi và Shogunate dần xấu đi, thành kiến càng ngày càng lộ rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210808
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210808,
					"content": "Lần đàm phán này, tôi vốn dĩ muốn thảo luận vấn đề này với Hiệp Hội Tenryou. Mối ân oán này cũng nên có ngày chấm dứt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210809
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210809,
					"content": "Đại nhân Sangonomiya, hôm nay có thời gian đến đây chơi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210810
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210810,
					"content": "Sắc mặt của đại nhân hơi kém hơn lần trước. Người là chỗ dựa lớn nhất của chúng tôi, nên đại nhân cần phải cố gắng chăm sóc cho bản thân nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210811
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210811,
					"content": "Ừm, không sao đâu, đừng lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210812
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210812,
					"content": "Đại nhân Sangonomiya, nghe tôi khuyên một câu, chúng ta đã chiến đấu với quân Shogunate lâu như vậy rồi, không thể nói hòa là hòa được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210813
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210813,
					"content": "Nếu như hòa giải với chúng, vậy thì vị ma thần bảo hộ cho chúng ta đã xem như chết oan rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210814
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210814,
					"content": "Được rồi, cũng đã nhiều năm như vậy rồi. Cũng vừa mới chiến tranh xong, cứ sống trong bình yên không phải tốt hơn sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210815
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210815,
					"content": "Tôi dĩ nhiên biết là thế, chỉ là... Haiz, ít ra thái độ cần phải cứng rắn một chút, không thể tùy tiện thỏa hiệp như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210816
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210816,
					"content": "Tôi hiểu rồi, chuyện này tôi sẽ suy nghĩ thêm, nhất định sẽ xử lý ổn thỏa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210817
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210817,
					"content": "Tốt quá... vậy thì phiền đại nhân Sangonomiya rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210818
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210818,
					"content": "Đại nhân Sangonomiya? Ây da, không ngờ lại gặp được đại nhân ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210819
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210819,
					"content": "Con gái của tôi năm nay đã báo danh tham gia cuộc tuyển chọn pháp sư rồi. Nếu như nó có thể gia nhập vào Sangonomiya là tốt rồi, đại nhân Sangonomiya hiền lành, nhất định sẽ không bạc đãi nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210820
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210820,
					"content": "Haiz, tôi cũng thường xuyên nói với nó là có cơ hội phải đi theo đại nhân Sangonomiya học hỏi thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210821
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210821,
					"content": "Đại nhân Sangonomiya trẻ tuổi như vậy mà đã là người xuất chúng, lại thông minh lanh lợi... Con gái của tôi luôn noi theo gương của đại nhân đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210822
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210822,
					"content": "Nếu như cô ấy có thể vào được Sangonomiya thì tôi sẽ chiếu cố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210823
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210823,
					"content": "Đại nhân Sangonomiya! Cuối cùng cũng gặp được đại nhân rồi. Tôi đang tìm cách để báo cáo cho đại nhân về vấn đề mùa màng thất thu của năm nay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210824
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 120210824,
					"content": "#Đại nhân Sangonomiya, người này không phải là đội trưởng Đội Cá Kiếm 2 sao? {F#Cô ấy}{M#Anh ta} sau này sẽ ở lại trên đảo Watatsumi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210825
					],
					"speakerTitle": "Ryouko"
				},
				{
					"id": 120210825,
					"content": "Đại nhân Sangonomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210826
					],
					"speakerTitle": "Yukiya"
				},
				{
					"id": 120210826,
					"content": "Phù... mọi người yên lặng chút, tôi đều sẽ nghe hết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210827
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210827,
					"content": "Nhưng mà, những vấn đề dài quá thì tôi đề nghị nên viết thành báo cáo trình đến cho Sangonomiya. Tôi có thời gian sẽ giải quyết sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210828
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210828,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210829
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210829,
					"content": "#{NICKNAME}, bạn vẫn khỏe chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210830,
						120210832
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210830,
					"content": "Vẫn khỏe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210831
					]
				},
				{
					"id": 120210831,
					"content": "Haha... xem ra bạn rất giỏi ứng phó những trường hợp này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210834,
					"content": "Đại nhân Sangonomiya, thì ra đại nhân đang ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210835
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210835,
					"content": "Có một chuyện cần báo cáo với đại nhân, chúng tôi có một lô hàng dùng cho tế lễ chưa được chuyển đến, tôi lo rằng lô hàng đã bị cướp rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210836
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210836,
					"content": "Tôi đã tìm lại được rồi, không cần lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210837
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210837,
					"content": "Thật sao? Không hổ danh là đại nhân Sangonomiya, thật lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210838
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210838,
					"content": "Công văn gần đây tôi cũng sắp xếp rồi, tôi đã để hết trên bàn làm việc của đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210839
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210839,
					"content": "Ngoài ra, theo lịch thì hôm nay vẫn còn một cuộc hội nghị phát triển ngành dệt nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210840
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210840,
					"content": "...Hôm nay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210841
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210841,
					"content": "Thưa vâng, hai vị cô nương từ xa đến đang đợi đại nhân ạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210842
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210842,
					"content": "#Được rồi... {NICKNAME}, tôi vốn dĩ định dẫn bạn đi dạo một vòng đảo Watatsumi, nhưng xem ra tôi có công chuyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210843
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210843,
					"content": "Chúng ta hẹn lại vào ngày mai ở trước cổng Sangonomiya nhé, sau đó chúng ta cùng đi chuẩn bị lễ ban thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210844
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210844,
					"content": "Hay quá! Chắc là có nhiều thức ăn lắm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210845
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210845,
					"content": "Haha... đương nhiên rồi, những món ngon trên đảo Watatsumi đều sẽ xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210846
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210846,
					"content": "Ngon! Vậy hẹn ngày mai nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210847,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210832,
					"content": "Có chút mệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210833
					]
				},
				{
					"id": 120210833,
					"content": "Vậy sao, tôi cũng thấy hơi đau đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
