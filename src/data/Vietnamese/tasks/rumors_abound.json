			},
			"dialogs": [
				{
					"id": 120210301,
					"content": "Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210302,
					"content": "Kokomi, chúng tôi tìm được hàng hóa của thương nhân rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210303,
					"content": "Ừm... hừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210304,
					"content": "Có chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "Không có gì, tôi chỉ hơi lơ là chút thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210307,
					"content": "Để tôi xem... quả thật đây là hàng hóa bị mất của vị thương nhân đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210308,
					"content": "Lương thực, thuốc men, công cụ làm ruộng... đều là những thứ cần cho thời bình. Anh ta tích trữ những thứ này có lẽ là để sau này bán cho được giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210309,
					"content": "Hiệp Hội Tenryou cũng không thiếu những thứ này, anh ta không cần thiết phải vận chuyển những thứ này về hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210310,
					"content": "Hơn một nửa khả năng anh ta chỉ là một thương nhân đang đầu cơ mà thôi, không khoa trương như Matsuda và Uchimura nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210311,
					"content": "Ừm... nhưng mà, nếu như cố ý đầu cơ tích trữ thì cũng là một người xấu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210312,
					"content": "Chúng ta cứ vậy mà mang hàng hóa trả lại sao? Có cảm giác không cam tâm cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210313,
					"content": "Yên tâm, tôi đã tính toán qua tình huống như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210314,
					"content": "Trong \"Pháp Lệnh Hậu Chiến Tranh\" mới nhất, tôi có đặt ra giới hạn về giá cả của nhu yếu phẩm, để dân chúng có thể mua được hàng hóa với mức giá bình dân nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210315,
					"content": "Nếu anh ta đọc lệnh sớm hơn thì giờ đã không phải chịu kết cục này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210316,
					"content": "Hihi, có cảm giác như Kokomi là \"chuyên gia\" trong lĩnh vực này nhỉ, tính được hết tất cả các khả năng luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210317,
					"content": "Bạn quá khen rồi, việc trước mắt mà nói, tôi vẫn chưa có manh mối về việc Hiệp Hội Tenryou cấu kết với Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210318,
					"content": "Đúng lúc lại không còn đủ \"năng lượng\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210319,
					"content": "Hử? Kokomi, bạn nói vậy là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210320,
					"content": "Không có gì, chúng ta mau chuyển hàng về đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210321,
					"content": "Tiệc ăn mừng sắp được tổ chức rồi, những chuyện thế này cần phải hoàn thành xong sớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210322,
					"content": "Được! Chúng tôi cũng muốn mau chóng dự tiệc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210305,
					"content": "Kokomi đang suy nghĩ gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
