			"dialogs": [
				{
					"id": 120211101,
					"content": "Tôi có cảm giác hơi khác so với chiến thuật định sẵn ban đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211102,
					"content": "Không sao, cục diện chiến trận phức tạp, không cần câu nệ phải một mực tuân theo, cần phải ứng biến linh hoạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211103,
					"content": "Hì hì, lúc đánh nhau loạn cả lên, quên mất chiến thuật luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211104,
					"content": "Chỉ cần kết quả có lợi là được rồi, chứng tỏ các bạn ứng biến cũng rất nhanh đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
