						120210805
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210805,
					"content": "Ở đó gần với Thất Thiên Thần Tượng của đảo, lúc đó đảo Watatsumi không tôn sùng Shogun lắm, nhưng cũng thừa nhận sự tồn tại của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
