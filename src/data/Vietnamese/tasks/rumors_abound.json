			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210101,
					"content": "Doanh trại Fatui mà vị thương nhân đó nói có lẽ là ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210102,
					"content": "Trông cách bày trí thì có lẽ đây từng là doanh trại của Hilichurl, không biết tại sao lại bị Fatui chiếm cứ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210103,
					"content": "Woa... Trông có vẻ như được canh phòng cẩn mật lắm. Chúng ta có thể vào trong đó thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210104,
					"content": "Nếu như đột phá trực tiếp thì e rằng khá khó. Nhưng không sao, địa hình thế này có lợi cho chúng ta, vả lại vị trí của chúng ta cũng chưa bị lộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210105,
					"content": "Kẻ địch ngoài sáng ta trong tối, đúng là một cơ hội tốt để dùng mưu kế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210106,
					"content": "Quân sư đại nhân có cao kiến gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210107
					]
				},
				{
					"id": 120210107,
					"content": "Theo như tôi thấy thì sẽ có không quá ba loại đối sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210108,
					"content": "Cách thứ nhất là cầm tặc cầm vương. Thế lực của Fatui ở Inazuma đã suy yếu nhiều, đám này chỉ là tàn binh bại tướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210109,
					"content": "Nếu như có thể bay từ trên cao xuống, tiêu diệt ngay được thủ lĩnh của chúng thì những tên còn lại sẽ như ong vỡ tổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210110,
					"content": "Cách thứ hai là mượn thế tấn công. Bạn xem, ở phía kia có thùng thuốc nổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210111
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210111,
					"content": "Nếu như tránh được sự chú ý của chúng rồi bắn nổ cái thùng đó, thì chúng ta sẽ chiếm được tiên cơ, lợi thế rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210112,
					"content": "Bọn chúng sẽ không phản ứng kịp, sĩ khí dao động, nhanh chóng vỡ trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210113,
					"content": "Cách cuối cùng chính là lợi dụng địa hình. Gần đây có biển, chúng ta sẽ dẫn nước vào, phối hợp với nguyên tố lôi của bạn để giật cho chúng tê tái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210114,
					"content": "Không hổ danh là Kokomi, tìm ra cách nhanh thật, vậy chúng ta sẽ chọn cách gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210115,
					"content": "Điểm khác biệt trong ba phương án trên chính là dựa vào năng lực phán đoán của người thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210116
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210116,
					"content": "Tấn công từ trên cao là cách nhanh nhất, nhưng cần phải có trình độ võ nghệ rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210117
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210117,
					"content": "Dẫn nổ thùng thuốc nổ sẽ nhanh chóng chiếm được lợi thế, nhưng cần phải hành động cẩn trọng, không thể để lộ vị trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210118
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210118,
					"content": "#Còn nếu như lợi dụng địa hình, thì phải chuẩn bị đầy đủ vật tư cho trận đánh dài hơi này. {NICKNAME}, bạn cảm thấy phương án nào thích hợp với bạn hơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210119,
						120210123,
						120210127
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210119,
					"content": "Đột kích doanh trại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210120
					]
				},
				{
					"id": 120210120,
					"content": "Haha... quả không hổ danh là đội trưởng Đội Cá Kiếm 2, rất tự tin vào khả năng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210121
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210121,
					"content": "Nếu như đã chọn xong chiến thuật rồi thì chúng ta cùng tác chiến thôi. Tôi tuy không giỏi võ nghệ, nhưng có thể hỗ trợ cho các bạn, gia tăng sĩ khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210122
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210122,
					"content": "Nhanh chóng tiêu diệt chúng rồi tìm lại hàng hóa cho thương nhân thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210123,
					"content": "Dẫn nổ thùng thuốc nổ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210124
					]
				},
				{
					"id": 120210124,
					"content": "Haha... Tính của bạn giống tôi đấy, thích dùng mưu kế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210125
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210125,
					"content": "Tôi thích phương án này, vì độ rủi ro của nó thấp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210126
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210126,
					"content": "Vậy chúng ta sẽ phối hợp với nhau để tạo \"bất ngờ\" cho chúng nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210127,
					"content": "Kết hợp dẫn điện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210128
					]
				},
				{
					"id": 120210128,
					"content": "Ừm, dụ bọn chúng ra, có thể đảm bảo được tính nguyên vẹn của doanh trại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210129
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210129,
					"content": "Nhưng mà, trước đó chúng ta chưa từng có cơ hội tác chiến qua, không biết tôi có thể theo kịp bạn không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210130
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210130,
					"content": "Yên tâm, tuy tôi không giỏi võ nghệ, nhưng đã ở trong quân doanh rất lâu, những mặt trận thế này tôi rất tự tin ứng phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210131
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210131,
					"content": "Đến lúc tiêu diệt doanh trại của bọn Fatui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
