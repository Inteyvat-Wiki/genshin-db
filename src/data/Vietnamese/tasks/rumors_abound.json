					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211002,
					"content": "Hihi, cũng đều nhờ vào chiến thuật của Kokomi bày cho đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211003,
					"content": "Dù là chiến thuật gì đi nữa thì điểm mấu chốt cũng nằm ở người thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211004
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211004,
					"content": "Bất kỳ trận thắng nào cũng đều nhờ vào công lao của tất cả mọi người, chứ không phải chỉ có một mình tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211005
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211005,
					"content": "Đúng vậy, tôi cũng có cống hiến rất nhiều đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211006,
					"content": "Ở đâu vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120211007
					]
				},
				{
					"id": 120211007,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211008,
					"content": "Không ngờ đám Fatui đó lại lấy doanh trại Hilichurl che mắt mọi người để đóng quân ở đây một thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211009
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211009,
					"content": "Mục đích của chúng là gì nhỉ? Không lẽ đúng như các quân sĩ nói, chúng đã cấu kết với Hiệp Hội Tenryou sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211010
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211010,
					"content": "Chúng ta phải điều tra doanh trại này thật kỹ, nếu như vị thương nhân đó không nói dối thì hàng hóa nhất định vẫn còn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211011
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211011,
					"content": "Được! Chúng ta đi xung quanh tìm thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
