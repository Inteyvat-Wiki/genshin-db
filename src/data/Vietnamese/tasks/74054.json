				{
					"id": 740540801,
					"content": "Kéo cần gạt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#Woa! {NICKNAME}, bạn làm gì vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540803,
					"content": "Bạn không nghĩ ngợi gì, kéo cần gạt rất dứt khoát.\\nKhoảnh khắc sau đó, âm thanh đinh tai nhức óc như sấm sét vang lên, cả tòa tháp bắt đầu rung chuyển, cảm giác như trời đất đang sụp đổ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "Sau đó... Bụp một tiếng, cỗ máy nhả ra một cuộn băng giấy, rơi vào tay bạn.\\nMọi thứ tĩnh lặng trở lại.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "Là... thế này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540806,
					"content": "Hừm... Hoàn toàn không hiểu trên đó khắc gì, nhưng có vẻ rất quan trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}, chúng ta nên giữ lại những cuộn băng này nhỉ? Biết đâu có chỗ để dùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
