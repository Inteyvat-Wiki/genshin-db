					}
				]
			},
			"dialogs": [
				{
					"id": 760190101,
					"content": "\"Chứng Nhận Trí Giả\"? Chẳng lẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190102,
					"content": "Mấy người tới đây làm gì? Bọn tôi đang bàn tính một chuyện bí mật về manh mối \"Kho Báu Vĩ Đại\" của Reed Miller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190103,
						760190104
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190103,
					"content": "Tốt quá, tính luôn phần của tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				},
				{
					"id": 760190105,
					"content": "Hm... Nếu vậy thì chúng ta lập nhóm đi. Tôi đang lo vì không đủ vốn để khởi động vụ này đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190106
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190106,
					"content": "Chúng ta mỗi người một phần, đứa biết bay này một phần nữa. Tổng cộng ba phần đủ cho ba người, mỗi người 500.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190107
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190107,
					"content": "500.000 Mora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190108,
					"content": "Haiz, nhóc Vieri à, không phải chị đã nói đây là bí mật của chúng ta sao? Chị tin tưởng nhóc nên mới nói ra đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190109
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190109,
					"content": "Nhưng 1.5 triệu Mora... Đối với em thì đó không phải là quỹ khởi động khả thi đâu. 500.000 may ra em gom đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190110
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190110,
					"content": "Hai người họ trông cũng giống nhà mạo hiểm có kinh nghiệm mà. Nếu chúng ta lập đội, vậy thì khả năng thành công chẳng phải sẽ cao hơn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190111
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190111,
					"content": "Haiz, chị đánh giá cao nhóc đấy, Vieri. Nếu họ đã là ứng cử viên của em thì chị cũng muốn làm bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190112
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190112,
					"content": "Nhưng người bạn biết bay này không giống với chúng ta, nên cần phải đặc biệt lưu ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190113
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190113,
					"content": "Ồ, có món quà gì muốn tặng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190114,
					"content": "Ừm. Vì là hàng đặc chế, nên tập khách hàng sử dụng cũng rộng rãi hơn so với \"Nước Mạnh\" gốc của Natlan. Những người bạn biết bay khác cũng có thể yên tâm sử dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190115
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190115,
					"content": "Còn về giá cả... Nếu là người khác thì đúng ra phải thu hai triệu Mora, nhưng nể tình hai vị là bạn của Vieri nên tôi chỉ lấy rẻ một triệu Mora thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190116
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190116,
					"content": "Một triệu Mora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190117,
						760190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190117,
					"content": "Quả là món quà bất ngờ đấy, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190118
					]
				},
				{
					"id": 760190118,
					"content": "Giống đang dọa thì đúng hơn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190121,
					"content": "Đúng đó! Chị Hidimbi, em cũng không nghĩ nhóc biết bay này sẽ có ích, cho nên \"Nước Mạnh\" không cần phải chia cho cô ấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190122
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190122,
					"content": "Khoan đã, đây đâu phải là nói giúp tôi đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190123,
					"content": "Hừ, vốn chỉ muốn nghe thử xem có manh mối về kho báu không, ai dè hai người đúng là một tên xấu một tên ngốc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190124,
					"content": "#Muốn gạt tôi và {NICKNAME} à? Không dễ vậy đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190125,
					"content": "Ai là kẻ xấu chứ? Manh mối là thật, hàng hóa cũng thế, còn về giá cả thì... đều là thuận mua vừa bán cả. Còn cái thứ nhỏ bé lắm mồm như ngươi thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190126
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190126,
					"content": "...Tôi ghét nhất loại người tự cho là đúng đấy. Rõ ràng chẳng có bản lĩnh gì mà còn lên mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190127
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190127,
					"content": "Hidimbi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190128
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190128,
					"content": "Còn nhóc Vieri nữa, đã là chuyện bí mật thì phải nói nhỏ, thì thầm vào tai chứ. Cứ hét toáng lên để mời hai kẻ rảnh hơi này đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190129
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190129,
					"content": "Bực bội thật. Không cho mấy người một bài học thì lửa giận khó mà nguôi được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190130
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190130,
					"content": "Tiếp chiêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190119,
					"content": "500.000 Mora. Không bán thì tôi đi đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190120
					]
				},
				{
					"id": 760190120,
					"content": "Sao lại trả giá thế? Chúng ta có cần thứ này đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190104,
					"content": "Bị người khác nghe thấy thì không còn là bí mật nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				}
			]
		},
