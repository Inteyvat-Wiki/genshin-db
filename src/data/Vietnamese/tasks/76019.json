			"dialogs": [
				{
					"id": 760190301,
					"content": "...Hừ, muốn chém muốn giết thì tùy ý các người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190302
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190302,
					"content": "#Woa, tôi với {NICKNAME} không làm mấy chuyện đáng sợ đó đâu! Chỉ cần sau này cô đừng đi lừa người khác nữa là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190303,
					"content": "Dù là tên ngốc như Vieri... Ơ? Cậu ta lẻn đi lúc nào thế? Tóm lại, đến cả tên ngốc như cậu ta cũng không được lừa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190304,
					"content": "Hai người thật tốt bụng... Haiz, nếu hồi ở Sumeru tôi cũng gặp được người tốt như vậy thì có khi đã không ra nông nỗi này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190305
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190306
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190306,
					"content": "Hai người không hỏi tôi đã gặp phải chuyện gì à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190307,
						760190308
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190307,
					"content": "Trực giác mách bảo tôi là đừng hỏi thêm nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190309
					]
				},
				{
					"id": 760190309,
					"content": "Đúng là nhạy bén... Haiz, dạo gần đây chẳng làm ăn được gì, có lẽ đến lúc phải đổi nghề rồi. Tôi cũng không muốn bị Thương Hội Voynich để mắt tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190310
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190310,
					"content": "Nếu cô sớm nghĩ được vậy thì lúc nãy đã không phải chịu đòn oan rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190311,
					"content": "Khi đưa ra những lựa chọn lớn trong đời thì luôn cần một cơ hội mà, dù là tốt hay xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190312
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190312,
					"content": "Được rồi, nếu hai người cần cơ hội này thì có thể đến tìm tôi bất cứ lúc nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190313
					],
					"speakerTitle": "Hidimbi"
				},
				{
