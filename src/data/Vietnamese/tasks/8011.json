			},
			"dialogs": [
				{
					"id": 80110301,
					"content": "Dừng lại, loài người. Các ngươi không được phép đến nơi này để tìm kiếm \"số phận\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Sứ Đồ Vận Mệnh"
				},
				{
					"id": 80110302,
					"content": "(Sứ Đồ Vực Sâu? Không đúng, hình như trước đây chưa từng thấy qua tên này trong Giáo Đoàn Vực Sâu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Thế nào, các ngươi kiên quyết \"yết kiến\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Sứ Đồ Vận Mệnh"
				},
				{
					"id": 80110304,
					"content": "...Cũng không sao, vậy thì ta sẽ ban cho các ngươi \"thí luyện của vận mệnh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sứ Đồ Vận Mệnh"
				}
			]
		},
		{
			"id": 801104,
			"completionStepIds": [
				801108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
