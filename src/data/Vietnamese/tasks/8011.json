				"points": []
			},
			"dialogs": [
				{
					"id": 80110101,
					"content": "Hình như... không phải là Caribert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110102,
					"content": "Không phải Caribert...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "Ừm. Chiếc khăn trên tay Caribert là món quà mà ta tặng cho mẹ nó, giờ đây đã là ký hiệu của riêng ta với nó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110105,
					"content": "Ta e rằng mắt ta cũng sắp chịu không nổi, đến con của ta cũng không nhận ra rồi. Cơ thể này... Haiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110106,
					"content": "Nhưng Hilichurl này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "Đúng vậy, có vẻ như hoàn toàn không có hứng thú với chúng ta, mà chỉ chăm chăm hướng về phía đó... Bên đó có gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110109,
					"content": "Không rõ nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "Ừm, về Hilichurl... chúng ta nên biết càng nhiều càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110110,
					"content": "Đi theo xem thử thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "Có gì đó kỳ lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "Trên tay không có khăn quàng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
			"completionStepIds": [
				801104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801104",
							"2"
						],
						"stepId": 801104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "Trước đây từng có nơi này trong khu rừng sao? Có vẻ như chưa từng phát hiện ra vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110202,
					"content": "Nhìn kìa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "Hả? Chúng... chúng đang bái tế gì sao? Vừa đi vừa bái tế... trông rất thành kính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110205,
					"content": "Ta chưa từng thấy qua cảnh tượng này, nơi này rốt cuộc đã chôn giấu những gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110206,
					"content": "Phải đi tìm hiểu cho rõ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110207,
					"content": "(Bầu không khí lạ thường này, không lẽ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "Những Hilichurl đó đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
