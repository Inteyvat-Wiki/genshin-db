			"dialogs": [
				{
					"id": 80110501,
					"content": "Nơi này chính là... điểm đích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110502
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110502,
					"content": "Thứ này là!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110503
					]
				},
				{
					"id": 80110503,
					"content": "(Dây xích tầng tầng lớp lớp, treo giữa không trung, phát ra bầu không khí kỳ dị... Rất giống với \"Tượng Thần Ô Uế\"!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110504
					]
				},
				{
					"id": 80110504,
					"content": "(Quả nhiên có liên quan đến Giáo Đoàn Vực Sâu sao, những Hilichurl đang quỳ bái đó, cũng giống với \"kẻ đó\" khi xưa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110505
					]
				},
				{
					"id": 80110505,
					"content": "Eide, nơi này có vấn đề, chạy mau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110506
					]
				},
				{
					"id": 80110506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110507
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110507,
					"content": "Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110508
					]
				},
				{
					"id": 80110508,
					"content": "...Sinh mệnh, tại sao lại quỳ bái, là vì lo sợ điều chưa biết? Hay là do ham muốn có sức mạnh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110509
					],
					"speakerTitle": "Ghép"
				},
				{
					"id": 80110509,
					"content": "(Âm thanh gì vậy, từ trong đầu mình phát ra... Eide, hình như không nghe thấy?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110510
					]
				},
				{
					"id": 80110510,
					"content": "...Sinh mệnh, tại sao lại quỳ bái, ta nào phải thần linh, ta chỉ là... \"Tội Nhân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110511
					],
					"speakerTitle": "Ghép"
				},
				{
					"id": 80110511,
					"content": "(\"Tội Nhân\"...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110512
					]
				},
				{
					"id": 80110512,
					"content": "Đóa hoa sinh ra trong tội lỗi nhưng vẫn không nhuốm ô uế, ta hiểu rõ vận mệnh của ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110513
					],
					"speakerTitle": "Ghép"
				},
				{
					"id": 80110513,
					"content": "Không cần đè nén những bất mãn, không cần chịu đựng tất cả lời nói dối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110514
					],
					"speakerTitle": "Ghép"
				},
				{
					"id": 80110514,
					"content": "Đi trở thành cá thể \"siêu nhiên\" đi, vượt qua tất cả \"vận mệnh giao phó\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110515
					],
					"speakerTitle": "Ghép"
				},
				{
					"id": 80110515,
					"content": "Ta sẽ rơi lệ vào khoảnh khắc cuối của thời gian... ngước nhìn lấy tất cả về ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110516
					],
					"speakerTitle": "Ghép"
				},
				{
					"id": 80110516,
					"content": "(Rốt cuộc là ai, những lời này có ý nghĩa gì?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110517
					]
				},
				{
					"id": 80110517,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110518
					],
					"speakerTitle": "Ghép"
				},
				{
					"id": 80110518,
					"content": "(Âm thanh... biến mất rồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110519
					]
				},
				{
					"id": 80110519,
					"content": "!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110520
					]
				},
				{
					"id": 80110520,
					"content": "...Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110521
					]
				},
				{
					"id": 80110521,
					"content": "Khụ... khụ... Ban nãy xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110522
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110522,
					"content": "Hình như trong khoảnh khắc ta nhìn thấy thứ đó, cảm xúc trong lòng ta như đã được kìm hãm, chỉ còn lại cảm giác kính nể... hoặc hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110523
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110523,
					"content": "Anh bây giờ không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110524
					]
				},
				{
					"id": 80110524,
					"content": "Không sao, ta cảm thấy rất ổn, hoặc là... ổn hơn nhiều so với lúc bước vào đây, thật kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110525
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110525,
					"content": "Nơi này có vấn đề, chúng ta mau chóng rời khỏi đây đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110526
					]
				},
				{
					"id": 80110526,
					"content": "Vậy, vậy sao... Được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110527,
					"content": "Hai người khi rời khỏi hang động kỳ lạ, liền đi thẳng về ngôi nhà của Eide...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
