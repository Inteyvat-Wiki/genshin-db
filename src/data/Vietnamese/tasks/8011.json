				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110401,
					"content": "Cái tên ban nãy rốt cuộc là gì vậy? Đúng là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110402,
					"content": "Bị dọa cho sợ rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "...Quả là một sinh mệnh hoàn mỹ, thật đáng để tán thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110405,
					"content": "Sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "Trên người hắn toát ra mùi vị thần bí, sức mạnh vừa nguy hiểm vừa nhã nhặn. Đúng là hấp dẫn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110407,
					"content": "Vậy mà ngươi có thể đánh bại được thực thể này sao, sức mạnh của ngươi đúng là vượt quá sự tưởng tượng của ta mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110408,
					"content": "Gu của anh đặc biệt thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "Chúng ta tiếp tục tiến lên đi, ta càng ngày càng tò mò, càng ngày càng phấn khích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110409,
					"content": "Tôi chỉ là có nhiều kinh nghiệm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "Trước đây tôi từng thấy qua những tên giống vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
			]
		},
