			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "Caribert, cảm ơn trời đất, nơi này không sao cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110602,
					"content": "Anh không đi bái tế Thất Thiên Thần Tượng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "Ta... chỉ là có đôi chút cảm giác, có vẻ như chuyện ban nãy chính là sự sắp xếp của vận mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110605,
					"content": "Lúc ta không muốn bái tế tượng thần nhất thì đã xảy ra chuyện ban nãy. Có vẻ như là một ám hiệu nào đó chăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110606,
					"content": "Nghe ngươi nói, ta hình như đã quỳ bái trước \"thứ đó\". Nói không chừng... hiệu quả cũng giống nhau chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110607,
					"content": "Thật kỳ diệu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "Dù ngươi nói thế nào thì ta cũng phải thử... Cũng như ngươi đã nói, \"phải thử hết tất cả khả năng\" chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110610,
					"content": "Thử cho Hilichurl uống thuốc lại lần nữa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "Caribert...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110613,
					"content": "Cha... cha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110614,
					"content": "Ôi... Caribert! Trời ơi, là thật, đúng là kỳ tích mà, Caribert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110615,
					"content": "Quả nhiên...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "Thấy rồi chứ, có hiệu lực rồi, Caribert có thể nói chuyện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110618,
					"content": "Mẹ đâu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110619,
					"content": "Mẹ con... Caribert, con nhìn cha trước đi, con có nhận ra cha không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110620,
					"content": "Dạ, con nhận ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110621,
					"content": "Ha...hahaha... Cứu rỗi, đây chính là cảm giác được cứu rỗi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110622,
					"content": "Con cảm thấy ổn chứ, Caribert, ý thức vẫn còn tỉnh táo chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110623,
					"content": "Dạ... Con hình như đã ngủ rất lâu rồi, trong mơ con thấy con nấp trong một căn phòng nhỏ, mãi không dám bước ra, cũng không muốn bước ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110624,
					"content": "Con...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110625,
					"content": "Cơ thể của con! Cơ thể của con sao vậy! Đây, đây là con sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110626,
					"content": "Cha... đã xảy ra chuyện gì vậy!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110627,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110628,
					"content": "...Bình tĩnh nào, con trai, chỉ là... chỉ là trong lúc con ngủ, chúng ta đã sống trong một thế giới truyện cổ tích thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110629,
					"content": "Thế giới này không còn Khaenri'ah nữa, không còn mái nhà của chúng ta nữa, nhưng cũng không còn bầu trời màu đỏ và thảm họa tận thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110630,
					"content": "Con sẽ giống như vậy, trở thành một con quái vật nhỏ, ở mãi bên cạnh cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110631,
					"content": "Con... con đã chết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110632,
					"content": "Không có, nói thế nào nhỉ, Caribert... Trên cánh tay con vẫn còn có chiếc khăn của mẹ, mẹ con cũng sẽ chúc phúc cho con, vậy thì sao con lại có thể chết đi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110633,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110634,
					"content": "Ừm, con vừa tỉnh dậy chắc đang rất bối rối, con nghỉ ngơi trước nhé... Mọi chuyện rồi sẽ tốt lên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110635,
					"content": "À đúng rồi... con phải nhớ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110636,
					"content": "Đừng tháo mặt nạ ra nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110637,
					"content": "Nhớ chưa? Đừng tháo mặt nạ ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110638,
					"content": "Được rồi... Con biết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110639,
					"content": "Hai cha con nói chuyện với nhau hồi lâu, Eide bỗng chốc như được cứu rỗi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "Từ hôm đó trở đi, chưa bao giờ ta thấy vui như bây giờ... Đây quả nhiên là sự thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110641,
					"content": "Đúng vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "Hừ, ta đã sớm biết không thể trông mong gì vào Thất Thần mà. Xùy... Vậy mà ta lại còn đi bái tế Thất Thiên Thần Tượng nữa, đúng là một sự sỉ nhục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110644,
					"content": "Hung thủ, mãi mãi là hung thủ, ta muốn nhờ họ cứu rỗi gì chứ, ta đúng là ngây thơ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110645,
					"content": "Ngược lại thì vị thần vô danh mà chúng ta gặp được ở trong hang đó mới thực sự là vị thần vĩ đại, khác xa với đám Thất Thần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110646,
					"content": "Luồng sức mạnh thần bí đó, khiến người ta si mê... chắc là do ta đã chân thành quỳ bái đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110647,
					"content": "Kể ra thì, cầu nguyện với thần linh, sau khi đạt được ước nguyện thì... phải đi \"trả lễ\" đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110648,
					"content": "Chuyện cầu xin thần linh thì ta không rành lắm, nhưng lần này ta nhất định phải đi \"trả lễ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110649,
					"content": "Nhưng mà... đó không phải thần linh đâu, Eide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "\"Tội Nhân\"? Này, ngươi nói nhảm gì thế, ngươi hiểu gì về vị thần đó mà dám phát ngôn ngông cuồng như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110652,
					"content": "Ngươi cũng thấy được sức mạnh của vị thần đó mà, Thất Thần thì làm sao mà mang đến điều kỳ diệu như vậy được chứ? Vị thần đó chắc chắn cao quý hơn Thất Thần, chứ không phải \"Tội Nhân\" gì đó như ngươi nói đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110653,
					"content": "Thôi bỏ đi... dù ngươi có nói gì thì cũng không ảnh hưởng đến lòng thành kính của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110654,
					"content": "Ta giờ phải đi trả lễ, ngươi có đi theo không thì tùy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110655,
						80110656
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110655,
					"content": "Hừ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110657,
					"content": "(Tâm trí của Eide hình như đã chịu ảnh hưởng... Tuy nói anh ta vốn không bình thường lắm, nhưng giờ trông thật sự...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110658
					]
				},
				{
					"id": 80110658,
					"content": "(Haiz, thôi thì cứ đi theo xem thử vậy, ở đó có không ít ma vật, anh ta sẽ bị tấn công mất...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110656,
					"content": "Tùy anh vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110650,
					"content": "Đó là... \"Tội Nhân\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110642,
					"content": "Đúng là không thể tin được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110616,
					"content": "Thật không thể tin được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110608,
					"content": "Được rồi, dù gì thì anh cũng cố chấp như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110603,
					"content": "Sao lại quay về đây rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				}
			]
		},
