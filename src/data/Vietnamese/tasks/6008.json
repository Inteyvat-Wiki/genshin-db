			"dialogs": [
				{
					"id": 60080101,
					"content": "Để xem... Sau vài ngày thì nơi này đã thế nào rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080102,
					"content": "Sự thay đổi dường như không lớn như trong tưởng tượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "Xem ra tình hình cũng dần ổn định lại rồi. Lauma thật có bản lĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080104,
					"content": "Lauma, chúng tôi đến rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080105,
					"content": "Mấy ngày nay thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "Việc thu dọn phức tạp hơn tôi tưởng nhiều. Giải quyết những vấn đề tích tụ lâu ngày vốn không phải chuyện dễ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080107,
					"content": "Theo tiến độ hiện tại, chắc sẽ phải cần thêm vài tuần nữa. May mà những người ở lại cũng đã gạt bỏ hết những mơ hồ trong lòng và trở nên tích cực hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080108,
					"content": "Như thể trong giờ phút này họ mới thực sự tìm được tín ngưỡng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080109,
					"content": "Đều nhờ vào công sức của cô cả đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080110,
					"content": "Đừng nói thế... Lẽ ra tôi phải làm chuyện này sớm hơn mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080111,
					"content": "#Dạo này tôi đang tập trung hồi phục. Bây giờ {F#cô}{M#cậu} đang bảo quản Tủy Mặt Trăng, tôi có thể giúp {F#cô}{M#cậu} thử tìm hiểu chuyện trong quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080112,
					"content": "Cảm ơn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "Nhắc mới nhớ, cô có nghe được tin tức gì mới về bóng ma đó chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080114,
					"content": "Tôi đã thử hỏi vài người rồi, nhưng cũng không có manh mối gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080115,
					"content": "Chỗ hai vị thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080116,
					"content": "Tiến triển không nhiều, nhưng tình hình là như vầy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080117,
					"content": "Tôi hiểu đại khái rồi... Công việc của mọi người cũng không dễ dàng chút nào. Hãy chăm sóc sức khỏe cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080118,
					"content": "#Vậy thì, {NICKNAME}, mời đi qua bên đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "#{NICKNAME} đã thấy gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080121,
					"content": "(Đây là... Nod-Krai ư? Hình như mình có chút ấn tượng với khung cảnh này...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "(Trên bầu trời kia là... một ngôi sao băng?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "(...! Không đúng! Đó là phi thuyền của chúng ta!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "Kết thúc rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080125,
					"content": "Đây hình như là chuyện đã xảy ra từ rất lâu rồi. Ký ức mà tôi cảm nhận được rất lộn xộn, với sức mạnh của tôi thì chỉ có thể nhìn thấy được nhiêu đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080126,
					"content": "(Ít nhất thì cũng biết được phi thuyền đã hạ cánh ở Nod-Krai... Hình như là ở gần Bãi Cát Sao.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#(Cũng khớp với sự thật mà {M#Lumine}{F#anh hai} kể cho mình... Nhưng mà, mình vẫn muốn biết thêm...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 60080129,
					"content": "Ơ, sao nhóc lại xuất hiện rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080130,
					"content": "Màu hoa thay đổi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080131,
					"content": "(Loài hoa này tượng trưng cho sức mạnh của Columbina. Chẳng lẽ cơ thể cô ấy lại...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "(Tôi nhớ hình như cô ấy từng nói là muốn dùng Tủy Mặt Trăng để hồi phục đôi chút sức mạnh...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "Ừm! Chúng ta mau đi gặp cô ấy đi, xem xem có thể giúp được gì không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080135,
					"content": "Vậy thì phiền hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080136,
					"content": "Phải rồi, đây là thuốc mà trước đây cô nhờ Hội Đồng Bí Mật chuẩn bị giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080137,
					"content": "Cảm ơn hai vị đã mang đến cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080138,
					"content": "#Ngoài ra... Tôi nghĩ \"Kuu{RUBY#[S]Thiếu Nữ Mặt Trăng}tar\" có thể cho {F#cô}{M#cậu} thấy thêm nhiều đoạn khác về chuyện phi thuyền nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080139,
					"content": "Đúng nhỉ! Cô ấy là Nguyệt Thần mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080140,
					"content": "Nhưng trước hết phải đảm bảo cô ấy không gặp vấn đề gì nghiêm trọng đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080141,
					"content": "Vậy hẹn gặp lại sau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
