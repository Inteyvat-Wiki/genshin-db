					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "Không. Chỉ là tưởng tượng ra vẻ mặt không phục của cô ấy khiến tôi thấy rất thú vị thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080409,
					"content": "Lúc đó cô ấy có vẻ khá bàng hoàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Đó chỉ là tạm thời thôi. Cô ấy rất giỏi tự điều tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080411,
					"content": "Hơi lạc đề rồi. Vậy nếu đã biết kẻ nhăm nhe Tủy Mặt Trăng nguy hiểm đến vậy, cô thật sự vẫn muốn mang theo nó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "Giả sử thông tin của Fatui là đáng tin, vậy khi Rerir dùng hết sức thì cả Nod-Krai cũng không phải là đối thủ của hắn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080413,
					"content": "Hiện giờ... Hình như đang có nguyên nhân nào đó đang hạn chế sức mạnh của hắn.",
