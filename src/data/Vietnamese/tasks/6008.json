			"dialogs": [
				{
					"id": 60080201,
					"content": "Columbina trông không có tinh thần lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "Làm phiền rồi. Cô vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080204,
					"content": "Tình trạng sức khỏe lại xấu đi rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "...Chóng mặt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080206,
					"content": "Cảm thấy như tôi đang... trở về mặt trăng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080207,
					"content": "Không đến nỗi thế chứ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "#Hmm? Tôi... cảm nhận được sức mạnh của mặt trăng... từ trong cơ thể {F#cô}{M#cậu}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080209,
					"content": "Chúng tôi đã đoạt lại Tủy Mặt Trăng từ tay Fatui rồi. Nó có thể giúp được cô không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Hm... Lần này hai người cần gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080211,
					"content": "Sao vẫn nói những chuyện này thế? Lúc này sức khỏe của cô quan trọng hơn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080213,
					"content": "(Lẽ nào... đây là thói quen của cô ấy sao? Vì luôn sống trong môi trường lợi dụng lẫn nhau...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "Có lẽ sau này cô có thể giúp tôi một việc đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "...Ừm, được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080216,
					"content": "Đưa tay cho tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080217,
					"content": "#Mmm... Cảm ơn {F#cô}{M#cậu}, tôi đã trở về mặt đất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080218,
					"content": "Thì cô vốn ở đây mà... Bây giờ thấy thế nào rồi? Đã đỡ hơn chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Đỡ hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080220,
					"content": "Cô vừa làm gì đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "#Mặt trăng trong người {F#cô}{M#cậu} yên tĩnh như mặt nước phản chiếu vậy... Thật kỳ diệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080223,
					"content": "Tôi chỉ lấy một tia sáng từ dưới nước thôi, là đủ để tôi trở về mặt đất trong thời gian ngắn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080224,
					"content": "Hình như tôi còn cảm nhận được vài thay đổi khác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "Đó là \"Chúc Phúc Của Nguyệt Thần\". Chỉ cần là vật chạm vào tôi thì đều sẽ mang theo dấu ấn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080226,
					"content": "Dấu ấn này vô hại, một thời gian sau sẽ tự biến mất thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080227,
					"content": "À, nếu cô đã khôi phục lại sức mạnh, vậy cô có muốn bảo quản Tủy Mặt Trăng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "Theo lý thì đây cũng là thứ thuộc về \"thần linh\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "Đây là di hài của Nữ Thần Hằng Nguyệt Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080230,
					"content": "Quả nhiên là... Haaả?!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "Trước đây hai người không biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080232,
					"content": "Lauma chỉ nói là nó khác với những mảnh vỡ khác, và cô ấy có thể cảm nhận được sức mạnh của thần linh từ trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "Cô ấy nói đúng. Vừa rồi khi tôi lấy đi tia sáng trong đó, cũng đã lấy lại một phần ký ức của Tủy Mặt Trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080234,
					"content": "Ký ức này cho tôi biết là nó thuộc về Nữ Thần Hằng Nguyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080235,
					"content": "Nhưng Lauma đã dùng Tủy Mặt Trăng để xem lịch sử trước đây mà, sao cô ấy lại không phát hiện ra nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma nói mình chỉ có thể nhìn thấy những mảnh vụn của quá khứ, hơn nữa lại rất mơ hồ... Có lẽ đây là thứ mà chỉ có Nguyệt Thần mới có thể cảm nhận được...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Trên bầu trời trước đây từng có ba mặt trăng, có ba nữ thần cai quản mặt trăng thuộc về mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080238,
					"content": "Nhưng sau Trận Chiến Tang Hỏa, cả ba nữ thần đều đã mất, và hai mặt trăng đã vỡ vụn trong trận chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080239,
					"content": "Sau khi Hằng Nguyệt Aria chết đi, sức mạnh của cô ấy đã ngưng tụ lại thành Tủy Mặt Trăng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080240,
					"content": "Di hài của Hồng Nguyệt chưa được tìm thấy. Còn nữ thần Sương Nguyệt tuy đã mất, nhưng mặt trăng lại chưa từng bị vỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080241,
					"content": "Đúng như lời tiên tri, vầng trăng này sớm muộn gì cũng sẽ sinh ra vị thần mới. Cũng chính là \"Kuu{RUBY#[S]Thiếu Nữ Mặt Trăng}tar\" mà Dòng Dõi Sương Nguyệt nhắc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080242,
					"content": "Tôi có thể cảm nhận được sức mạnh của mình thuộc về Sương Nguyệt. Nhưng nó nằm ngoài bầu trời giả tạo, cách tôi quá xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080243,
					"content": "Bây giờ đừng nói đến việc \"điều khiển\" nó, có lúc ngay cả \"cảm nhận\" thôi cũng đã rất khó khăn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080244,
					"content": "Để tôi đếm thử xem... Chúng ta đã lấy được Hằng Nguyệt, còn Hồng Nguyệt thì không tìm thấy... Vậy thì trong người cô đang có Tủy Mặt Trăng của Sương Nguyệt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "Không. Tủy Mặt Trăng là thứ ngưng kết lại sau khi Nguyệt Thần chết đi. Bản chất của nó là một loại lõi sức mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080246,
					"content": "Giống như không nên hỏi trên mặt trăng có đá cuội hay không vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080247,
					"content": "À! Tức là bản thân cô đã đại diện cho sức mạnh của Sương Nguyệt rồi, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "#Ừm. Ma Thần có Gnosis sẽ được gọi là thần linh, còn {F#cô}{M#cậu} có Tủy Mặt Trăng... có phải cũng sẽ làm được Nguyệt Thần không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080249,
					"content": "Hình như không giống nhau lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "#{F#Cô}{M#Cậu} không muốn làm Nguyệt Thần sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080251,
					"content": "Đó không phải vấn đề! Có vẻ như cô rất muốn nhường danh hiệu này cho người khác nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "Tóm lại, đừng bàn đến việc ai sẽ làm Nguyệt Thần nữa. Bây giờ có phải chúng tôi nên trả lại Tủy Mặt Trăng này cho cô không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "Tôi không muốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080254,
					"content": "...Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "Với lại trông nó có vẻ như cũng không muốn đến với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080256,
					"content": "Nghĩa là sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "Lúc nãy khi tiếp xúc với nguồn sức mạnh đó, tôi cảm nhận được một loại \"bài xích\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080258,
					"content": "Có lẽ vì tôi cũng là Nguyệt Thần. Hai vầng trăng không thể mọc lên cùng lúc, lại càng không thể hấp thụ nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080259,
					"content": "Vậy thì tôi đành phải mang theo rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "#Thật sao? Tuy Lauma nói sức mạnh này được giấu rất cẩn thận trong người {NICKNAME}, nhưng Columbina không phải cũng đã cảm nhận được nó đấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "Cuộc Săn Hoang Dã cũng không phải thứ bình thường, nếu như bị nó phát hiện ra thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "Cuộc Săn Hoang Dã? Cách Paimon nói về hiện tượng đó như thể đang miêu tả một con người vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080263,
					"content": "Là vì trông giống như có kẻ chủ mưu vậy. Thậm chí là giống một con người có mục đích rõ ràng hơn... Lúc trước nó cứ đuổi theo Tủy Mặt Trăng mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "Nghe có vẻ khá quen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080265,
					"content": "Hả? Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "Khi tôi vẫn còn ở trong Fatui, tôi đã từng nghe các đồng liêu nhắc đến một người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080267,
					"content": "Hắn ta đến từ Khaenri'ah, trong thời kỳ thảm họa đã có được sức mạnh của Vực Sâu... Hơn nữa lại có chấp niệm rất lớn với mặt trăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080268,
					"content": "Khaenri'ah? Tuy chúng tôi không rõ bóng ma đó có liên quan hay không, nhưng những cái khác nghe có vẻ trùng khớp đấy... Thế hắn ta tên là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "Tôi chỉ biết người khác gọi hắn là... \"Thợ Săn Á{RUBY#[D]Rächer of Solnari}nh Trăng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080270,
					"content": "Một trong Năm Tội Nhân?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Ah, đúng là còn có danh hiệu này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080272,
					"content": "Hả?! Là... là người mà Dain nhắc tới sao? Đối thủ của chúng ta là Tội Nhân trong truyền thuyết, \"Thợ Săn Ánh Trăng\" Rerir?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "Nhưng nếu là Năm Tội Nhân thì hẳn là phải mạnh hơn thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "Nghe nói Rerir đã biến mất ngay sau thảm họa Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080275,
					"content": "Tôi hỏi các đồng liêu rằng hắn ta đã đi đâu, thì họ hỏi ngược lại tôi là \"Cô thật sự không biết sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080276,
					"content": "Tại sao vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "Bởi vì nghe nói Rerir đã rơi vào trong \"hình ảnh phản chiếu của mặt trăng\", không bao giờ quay trở lại nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080278,
					"content": "Khoan đã... Nhiều thứ quá, tôi chưa tiếp thu kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "Tôi lúc đó cũng vậy. Họ luôn cảm thấy, chỉ cần là chủ đề liên quan đến mặt trăng thì chắc chắn tôi sẽ biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080280,
					"content": "Nhưng tôi đã nói rồi... \"Phần mở đầu\" của tôi đã ở bên ngoài bầu trời giả, đến cả tên mình tôi còn không biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080281,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "Nói chung, sau khi Rerir biến mất, hiện tượng Cuộc Săn Hoang Dã của Nod-Krai đã trở nên nghiêm trọng hơn, trở thành một từ đồng nghĩa với thảm họa Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080283,
					"content": "Cuộc Săn Hoang Dã bây giờ chỉ là kế thừa cái tên đó. Nó tuy tương tự, nhưng quy mô và mức độ nguy hiểm đã vượt xa trước kia rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080284,
					"content": "Tôi vẫn thấy thật khó tin. Đối thủ của chúng ta lại là một trong Năm Tội Nhân huyền thoại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "Thế thì nguy hiểm quá! Cảm thấy lúc ở Bãi Cát Sao chỉ là may mắn thôi... Có lẽ do hắn chưa dùng hết sức lực chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "Nhưng dù là thế thì ngay cả Sandrone cũng bị hắn đánh bại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "Hoặc là, tôi vừa làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
