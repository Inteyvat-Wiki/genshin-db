					"nextDialogs": [
						60080447
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080447,
					"content": "Thật sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "#Bản thân nó ở trong cơ thể {F#cô}{M#cậu} đã khó phát hiện rồi. Tôi có thể dạy {F#cô}{M#cậu} vài cách sử dụng Kuuvahki để che giấu Tủy Mặt Trăng kỹ hơn.",
