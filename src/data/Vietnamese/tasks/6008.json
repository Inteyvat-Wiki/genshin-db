					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(Đây là... Cảm giác thật nhẹ nhàng... Giống như ánh trăng vậy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Cảm nhận được chứ? Bây giờ hãy thử duy trì nó nhé.",
