					"nextDialogs": [
						60080449
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080449,
					"content": "Kiểu như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
