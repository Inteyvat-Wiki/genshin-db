					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Trước khi quyết định, tôi có một việc muốn nhờ Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "Chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080417,
					"content": "#Cô có thể cho tôi xem chuyện gì đã xảy ra khi phi thuyền của tôi và {M#em gái}{F#anh trai} vừa đáp xuống Nod-Krai không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080419,
					"content": "Đồng ý nhanh vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "Tôi đã nói rồi, việc này với tôi chỉ là chuyện nhỏ thôi. Không có gì khó cả.",
