					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#({M#Lumine}{F#Anh hai} và mình chắc vẫn còn ở trong đó. Chúng ta đã ở trong phi thuyền rất lâu, khi nào thì {M#Lumine}{F#anh hai} mới ra ngoài đây?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Ấy?! Kia là... {M#Lumine}{F#anh hai}?!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(Tại sao chứ? Rõ ràng sau khi phi thuyền buộc phải hạ cánh thì không có ai ra ngoài cả! Cánh cửa của phi thuyền cũng chưa từng mở ra!)",
