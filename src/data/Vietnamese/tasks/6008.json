					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "#{NICKNAME}! Vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "Phi thuyền của chúng tôi... Một thời gian rất dài đã trôi qua sau khi chúng tôi hạ cánh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#Không một ai rời khỏi phi thuyền cả, nhưng {M#Lumine}{F#Aether}... lại tìm thấy tôi từ bên ngoài phi thuyền...",
