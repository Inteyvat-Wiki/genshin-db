					"speakerTitle": "Columbina"
				},
				{
					"id": 60080421,
					"content": "Đưa tay cho tôi và chuẩn bị sẵn sàng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(Vẫn như những gì lần trước đã thấy, chỉ là lần này rõ nét hơn...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(May mà lúc đó hạ cánh an toàn...)",
