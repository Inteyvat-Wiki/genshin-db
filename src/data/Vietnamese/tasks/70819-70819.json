					"Hannelore"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "#Cảm ơn sự hào phóng của {F#cô}{M#cậu}. Chỉ có điều, tôi là tu nữ của Giáo Hội Tây Phong, không thể nhận lễ vật từ người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190202,
					"content": "Đối với tôi mà nói, có thể mượn gió biển để ngửi thấy hương thơm tuyệt vời như vậy là đủ rồi. Để lại những điều tốt đẹp cho làn gió, thay vì chiếm giữ cho riêng mình, đó mới là điều mà một tín đồ sùng đạo nên làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190203,
					"content": "#Nhưng tôi đã nhận được sự tử tế ấm áp như làn gió nam của {F#cô}{M#cậu}. Để đáp lại, xin hãy nhận cuốn sách này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190204,
					"content": "#Mong Phong Thần phù hộ {F#cô}{M#cậu}. Mong rằng con đường tương lai của {F#cô}{M#cậu} cũng sẽ như hương thơm này, tràn đầy đức hạnh, tự do và nhân ái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hannelore"
				}
			]
		},
