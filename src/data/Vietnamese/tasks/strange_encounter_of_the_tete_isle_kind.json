					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "#Quan trọng là, {F#cô}{M#cậu} có thấy một người đầu trọc ở gần đây không? Tôi có việc cần tìm anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520702,
					"content": "Tôi cũng tới tìm anh ta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Ồ? Lúc nãy anh ta ở đây sao? Xem ra chạy mất rồi, chắc cũng biết tôi đang đuổi theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520709,
					"content": "Hừm, Icahua... đừng hòng chạy thoát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520706,
					"content": "#Nể tình chúng ta có duyên, khuyên {F#cô}{M#cậu} tránh xa tên đó và tôi ra, cũng là để khuôn mặt đẹp của {F#cô}{M#cậu} không phải dính màu vẽ dơ bẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520707,
					"content": "Đây là những thứ tôi tìm được trong doanh trại, tôi đoán là anh ta không kịp mang theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520708,
					"content": "#Tặng cho {F#cô}{M#cậu} vậy. Đừng lo, bây giờ những thứ này là do tôi quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520710,
					"content": "Cái mạng của tên đó sớm muộn gì cũng lọt vào tay tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520703,
					"content": "Chưa thấy qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "#{F#Cô}{M#Cậu} không lừa tôi đấy chứ? Tôi tạm tin vào sự thành khẩn của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				}
			]
