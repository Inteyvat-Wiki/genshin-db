			"dialogs": [
				{
					"id": 752520601,
					"content": "Anh là khách trong quán rượu. Chúng ta từng gặp nhau rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520602
					]
				},
				{
					"id": 752520602,
					"content": "#Vậy à? Chẳng trách lại thấy {F#cô}{M#cậu} quen mắt, nhưng mà một ngày tôi gặp rất nhiều người, nên không nhớ rõ... Nhưng cũng không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525207,
			"completionStepIds": [
				7525205
