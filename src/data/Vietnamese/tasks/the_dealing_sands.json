						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "Có duyên kết bạn, mấy lời cảm ơn bỏ qua đi. Cần gì thì cứ gọi một tiếng là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160203,
					"content": "Ừm! Lịch sự lạ lùng thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "Vậy thì tôi nói thẳng, gần đây tiền bạc hơi eo hẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "Cần Mora à? Haha, nói thì dễ nhưng làm thì hơi rắc rối một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160206,
					"content": "Mora của chúng tôi đều bị đại ca mang đi hết rồi. Hiện giờ thì hang màu mỡ đã thành ổ cỏ úa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160210,
					"content": "Đại ca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Là đại ca của Bang Thiết Diêm đó! Đại ca đang cùng một nhóm người Fontaine \"đãi cát\" ở bên kia, để chúng tôi ở lại trông giữ hang ổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160212,
					"content": "#Nhưng vừa rồi {F#cô}{M#cậu} cũng thấy đó. Đám Fontaine kia, nhân lúc đại ca đang bàn chuyện thì lẻn vào, chọc vào mông chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160213,
					"content": "Ơ... Chọc vào mông...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Úi...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Lũ khốn, tưởng chúng tôi dễ bị lừa vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160216,
					"content": "Hiện tại ở đây đã \"ngập nước\", không chừng đại ca sẽ rơi vào bẫy. Bằng hữu, giúp người thì giúp cho trót, có thể giúp chúng tôi thêm lần nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160217,
					"content": "Nếu đại ca không sao thì đảm bảo các vị sẽ ăn sung mặc sướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160218,
					"content": "Ở đâu? Để tôi đi kiểm tra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "Bãi biển dưới chân núi bên kia, các vị qua đó là sẽ thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160220,
					"content": "Hai vị bằng hữu, phiền hai vị đi trước một bước, tôi thu dọn đồ đạc xong sẽ tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160207,
					"content": "Đi đường gặp chuyện bất bình nên ra tay giúp đỡ chút thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "Nghĩa khí ngút trời! Nghĩa khí ngút trời! Đã vậy, vừa hay tôi có chuyện muốn nói với hai vị bằng hữu đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160209,
					"content": "Tôi thấy phía đại ca có lẽ sẽ gặp chuyện, phải đi giúp một phen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Thiết Đậu Nhi"
				}
			]
		},
