			},
			"dialogs": [
				{
					"id": 711160601,
					"content": "Đa tạ hai vị khách hào hiệp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160602,
					"content": "Không cần cảm ơn! Dù giao dịch ở đâu thì cũng phải tuân thủ khế ước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "Haha, vị hiệp khách tí hon này nói đúng. Nhưng xem ra, hai người hiểu rất rõ giao dịch của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160604,
					"content": "Là Thiết Đậu Nhi nói với chúng tôi, cô ấy nói mấy người đang ở đây \"đãi cát\" gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "Nhưng \"đãi cát\" là sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "Hình như không phải việc làm ăn hợp pháp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "Nếu đã vậy, tôi phải cảm ơn hai người thật đàng hoàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160608,
					"content": "Người đâu! Trói họ lại, ném xuống biển!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160609,
					"content": "Nhớ buộc thêm mấy hòn đá nữa, hai người này có ơn với Bang Thiết Diêm chúng ta, đừng để họ phải chịu thiệt thòi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160610,
					"content": "Cái gì?! Các người... định làm gì chúng tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "Hai vị, lúc nãy không phải hai vị rất hiểu chuyện sao? Liyue là quốc gia rất coi trọng khế ước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160612,
					"content": "Phá hoại giao dịch ngầm của băng đảng, nhất định sẽ bị diệt khẩu, đây không phải là khế ước mà ai cũng biết hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160613,
					"content": "Làm gì có thứ khế ước nào như vậy! Lấy oán báo ơn kiểu này mới là thiếu xem trọng khế ước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "Đừng lãng phí ý tốt của tôi. Để tôi đích thân ra tay thì các người sẽ phải nếm mùi đau khổ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160615,
					"content": "Biết tôi là ai không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "Đừng nhiều lời! Thiết Đậu Nhi! Thiết Thuyền Nhi! Còn không mau ra tay?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160618,
					"content": "Đại ca Thiết Minh đúng là kẻ bất nhân bất nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160619,
					"content": "Không uổng công chúng tôi nỗ lực, tuyệt đối không thể để những người như anh tiếp tục lộng hành ở Liyue nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160626,
					"content": "Thu lưới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160620,
					"content": "Cái... cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160621,
					"content": "Gian tặc Thiết Minh! Mở to mắt ra mà xem chúng tôi là ai?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160622,
					"content": "Thiên... Thiên Nham Quân?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160623,
					"content": "Này này! Chuyện gì vậy?! Tại sao đột nhiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "Ta tưởng các ngươi là lính mới, không ngờ lại là lũ chó săn của chính quyền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160625,
					"content": "Đừng tưởng ta sẽ khoanh tay chịu trói! Ta liều mạng với các ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160616,
					"content": "Ối! Sợ quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
