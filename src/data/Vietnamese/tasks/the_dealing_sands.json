			"dialogs": [
				{
					"id": 711160801,
					"content": "Thật là một chuyến đi đáng giá! Không ngờ lần hành động này không chỉ bắt được người, mà còn gặp cả Nhà Lữ Hành nổi tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160802
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160802,
					"content": "Hai người biết chúng tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160803
					]
				},
				{
					"id": 711160803,
					"content": "Đương nhiên rồi, Nhà Lữ Hành. Tôi có người thân ở cảng Liyue, cũng được nghe nhiều về hai người, nên lúc mới gặp tôi đã nhận ra ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160804
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160804,
					"content": "Nhưng lúc đó đông người xung quanh, sợ bại lộ thông tin sẽ khiến đám người này bỏ chạy, nên tôi đã không nói rõ ngọn ngành, thật ngại quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160805
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160805,
					"content": "Thì ra chúng tôi không gặp phải băng đảng giao dịch phi pháp, mà là bắt gặp Thiên Nham Quân đang truy bắt kẻ xấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160806,
					"content": "Haha, đúng vậy. Chúng tôi đã để mắt đến nhóm buôn lậu muối này một thời gian rồi, tình cờ lúc trước nhận được giúp đỡ, nên đã xâm nhập thành công vào nội bộ băng đảng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160807
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160807,
					"content": "Sau gần một tháng chờ đợi, cuối cùng hôm nay cũng có cơ hội bắt được con cá lớn của Bang Thiết Diêm và Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160808
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160808,
					"content": "Khỏi phải nói, khi nãy tôi suýt bị một con cá lớn dìm xuống nước, ra tay rất độc ác... cũng may có Nhà Lữ Hành đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160809
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160809,
					"content": "Tóm lại, Nhà Lữ Hành, lúc nãy hứa cho các vị ăn sung mặc sướng, có lẽ sẽ không thực hiện được. Nhưng ở đây có chút Mora, xin hãy giữ lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160810
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160810,
					"content": "Hai vị xin đừng từ chối. Giúp đỡ người khác thì cũng đáng được nhận đền đáp, mọi người đều phải tuân thủ khế ước này mới được. Nếu không, sau này sẽ ngày càng ít người chịu ra tay giúp đỡ mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160811
					],
					"speakerTitle": "Thiết Đậu Nhi"
				},
				{
					"id": 711160811,
					"content": "Được rồi, đã đến lúc chúng tôi giải quyết chuyện còn lại, không lãng phí thời gian của hai vị nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160812
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160812,
					"content": "Chúc hai vị may mắn thuận lợi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thiết Thuyền Nhi"
				}
			]
		},
