			"dialogs": [
				{
					"id": 711160401,
					"content": "Anh Johnnie, chúng ta là bạn, tôi cũng hiểu khó khăn của mấy người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160402,
					"content": "Có thắc mắc gì cứ trao đổi trực tiếp với tôi, nếu làm như vậy... Khó tránh khỏi sứt mẻ tình cảm, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160403,
					"content": "Này, anh bạn... Anh biết đấy, việc làm ăn của chúng tôi không còn như trước. Spina di Rosula gần đây phát triển khá mạnh, anh em chúng tôi dạo này hơi khó sống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160404,
					"content": "Những chú chim nhỏ còn đang há miệng chờ ăn. Nếu cứ tiếp tục như vậy, e là đến mẩu vụn cũng không có mà rỉa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160405,
					"content": "Công việc kinh doanh của chúng ta rất tốt, rất hợp lý. Nếu sau này chúng tôi có cơ hội để... cảm ơn anh, tôi nghĩ các anh sẽ dễ dàng cảm nhận được thành ý của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160406,
					"content": "Bằng không... Haha, đại dương rộng lớn như vậy, anh Thiết Minh, các anh cũng không khó để tìm thấy bạn mới đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160407,
					"content": "Nói như vậy, anh Johnnie... Báo giá này chính là thành ý của anh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160408,
					"content": "Giá cả như vậy có vấn đề gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160409,
					"content": "Này lão đại Fontaine! Mở to mắt ra hộ cái! Chút tiền đó thì sĩ gì chứ? Sao không \"nổ\" to thêm tí nữa đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160410,
					"content": "Trật tự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160411,
					"content": "Anh Johnnie, hàng của tôi bán cho nhà Don Pesci, một rương 58 ngàn. Bán cho nhà De Niro, một rương 70 ngàn. Họ đều là băng đảng ngầm nổi tiếng ở Cảng Lumidouce, cái này tôi không cần nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160412,
					"content": "Hàng của tôi bán cho anh, ba rương chỉ 100 ngàn, bao lấy hàng giao hàng... Tại sao à? Vì tôi quý trọng người bạn như anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160413,
					"content": "Không nói nhiều nữa... Tôi tin anh Johnnie vẫn chưa suy nghĩ thấu đáo! Chúng ta tìm chỗ uống một ly rồi bàn tiếp, được chứ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160414,
					"content": "Haha, không cần phải vậy. Tôi biết người Liyue rất xem trọng khế ước, trong khế ước lại rất xem trọng công bằng. Tôi chưa từng nghe nói tình cảm lại có thể quan trọng hơn công bằng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160415,
					"content": "Haha, anh Johnnie! Nếu đã xem trọng khế ước như vậy, đàn em của tôi cũng phải học hỏi ở anh nhiều đấy, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160416,
					"content": "Chỉ là, trong chuyện này, trước tiên tôi muốn xem mấy người tôn trọng khế ước đến đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160417,
					"content": "Đương nhiên, đương nhiên rồi! Lời này của anh không thể hợp lý hơn, khế ước cổ xưa của Liyue thật sự đáng được tôn kính, xem ra tôi phải thể hiện sự tôn trọng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160418,
					"content": "Walker, báo giá cho mỗi kiện tăng thêm... một Mora, ngươi thấy được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160419,
					"content": "Rất hợp lý, ngài Johnnie. Những người Liyue này đã rất chăm chỉ, mỗi kiện hàng nên được nhận thêm... một Mora tiền thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160420,
					"content": "Tên Fontaine kia! Rốt cuộc các người có ý gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160421,
					"content": "Này anh bạn, các anh vẫn chưa cảm nhận được thành ý đến từ phương xa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160422,
					"content": "Anh Johnnie, các anh quyết tâm vi phạm khế ước sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160423,
					"content": "Ồ? Vậy à? Walker, ngươi thấy có phải vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160424,
					"content": "Ngài Johnnie, nếu ngài hỏi ý tôi... Đại dương rộng lớn như vậy, thứ tôm tép thì nên biết mình là ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160425,
					"content": "Walker, ta thật xấu hổ với ngươi, sao ngươi có thể xúc phạm người bạn Liyue của chúng ta như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160426,
					"content": "Dù sao thì sau này chúng ta cũng sẽ chiếm lấy địa bàn của họ, chẳng phải nên biết ơn chút sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160427,
					"content": "Xin lỗi, ngài Johnnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160428,
					"content": "Các ngươi! Khốn kiếp! Không ngờ các ngươi lại có ý định này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160429,
					"content": "Sao lại mắng người rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "Ơ? Hai bạn nhỏ này là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160431,
					"content": "Haha, thật là thú vị, những bạn nhỏ ở Liyue gan dạ vậy sao? Walker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160432,
					"content": "Này! Quỷ nhỏ đâu ra vậy? Cho các ngươi một ít Mora, mau quay về mua sữa uống đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160433,
					"content": "Ngươi! Mấy người thật chẳng lịch sự chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160434,
					"content": "Hai người là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160435,
					"content": "Chúng tôi đến để được ăn sung mặc sướng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "Hahaha! Nói như vậy... Các ngươi được anh Thiết Minh đây mời đến giúp đỡ à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160438,
					"content": "Thì ra anh Thiết Minh sớm đã có tâm tư với chúng tôi rồi à? Hừm, bọn tôi cũng không phải không chuẩn bị gì... Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160439,
					"content": "Ra đi! Anh em! Đến lúc rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160440,
					"content": "Cái gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "Thiết Thuyền Nhi"
				},
				{
					"id": 711160441,
					"content": "Hừ, chuyện gì xảy ra vậy? Hình như chúng ta vẫn đông người hơn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160442,
					"content": "Anh Thiết Minh, thật đáng tiếc, tôi đã sắp xếp trước một số công việc cho người của tôi. Đám người anh giữ lại trong trại, có lẽ bây giờ đã bị xử lý hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160443,
					"content": "Hãy yên tâm, chúng tôi sẽ chăm sóc tốt cho công việc kinh doanh của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160444,
					"content": "\"Đại ca\" Johnnie... muốn dính líu đến Bang Thiết Diêm chúng ta à... Không đơn giản vậy đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "Thiết Minh"
				},
				{
					"id": 711160445,
					"content": "Mong là cái mạng của anh cũng cứng như miệng anh vậy. Ra tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160436,
					"content": "Chúng tôi đến để tiễn ai đó về nhà uống sữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
