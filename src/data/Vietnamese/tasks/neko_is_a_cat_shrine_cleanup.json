					"nextDialogs": [
						721640205
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640205,
					"content": "Meo meo...nhất định phải làm cho đền thần náo nhiệt trở lại trước khi Hibiki trở về...meo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640206,
					"content": "Hôm nay đến đây thôi, cám ơn ngươi đã giúp...meo meo...",
