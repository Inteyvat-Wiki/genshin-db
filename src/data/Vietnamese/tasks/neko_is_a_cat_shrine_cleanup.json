					"nextDialogs": [
						721640207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640207,
					"content": "Nói tiếng người nãy giờ...mệt quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640208,
					"content": "Ta phải nghỉ ngơi rồi, khoảng thời gian tới, không chừng ta còn phải nhờ mọi người giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640209
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640209,
					"content": "Đến lúc đó, ngươi nhất định phải đến nhé...meo meo...",
