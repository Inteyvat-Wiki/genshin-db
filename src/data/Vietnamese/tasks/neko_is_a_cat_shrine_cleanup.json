			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "Meo...cái hòm đó đúng là hữu ích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640102,
					"content": "Là ngươi sao. Hòm Công Đức đó quả thật rất hữu ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640103,
					"content": "Sau khi ngươi sửa xong thì có hai tên xanh xanh đến viếng đền ngay, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640104,
					"content": "Không những bỏ tiền vào, mà cái tên xanh xanh cao cao đó sau khi nghe ta nói chuyện thì rất kích động. Con người đúng là lạ lùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640105,
					"content": "Hòm Công Đức đúng là đồ tốt đấy. Nếu làm thêm một cái nữa thì sẽ có nhiều người hơn chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640106,
					"content": "Sự việc không phải vậy đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "Vậy sao. Chuyện của con người rắc rối ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640108,
					"content": "Vấn đề này, chắc, chắc có liên quan đến hoàn cảnh ở ngôi đền đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640109,
					"content": "Ngôi đền của ta thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640110,
					"content": "Hơi lộn xộn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "Ây da thế à? Nhưng bọn nhóc rất thích chơi trong đống lá rụng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640113,
					"content": "A, nhưng nghĩ kỹ lại thì Hibiki cũng hay dùng cây gậy dài dài để gom lá lại một chỗ. Nếu Hibiki đã làm vậy thì chắc chắn đó là việc nên làm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640114,
					"content": "Muốn quét dọn ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "Ta sao có thể hiểu được loài người xem trọng thứ gì chứ. Ừm...nếu là Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640117,
					"content": "Lúc mặt trời còn chưa mọc, Hibiki thường dùng cây gậy dài dài đó quét qua quét lại trên đất. Ta rất thích đuổi theo cây gậy đó để chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640118,
					"content": "Nhưng bây giờ ta là \"Guuji Đại Diện\" rồi, cư xử như vậy không đúng phép tắc. Ta không phải là một kẻ bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640119,
					"content": "Nhưng Hibiki cũng dùng nước hắt lên đất. Nước là thứ xấu xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640120,
					"content": "Thỉnh thoảng Domeki cũng đến, dùng những tấm kim loại đan chéo lạch cạch lạch cạch. Sau đó thì cành và lá cây rơi xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640121,
					"content": "Domeki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "Là một người cao thiệt là cao, có tiếng nói lớn thiệt là lớn. Thường chơi cùng với Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640125,
					"content": "Hứ! Lần nào hắn cũng cắt mất mấy cành cây mà ta thích nhất, đúng là kẻ đáng ghét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640126,
					"content": "Nghe thì đúng là đang \"quét dọn\", hoặc có thể nói là \"chỉnh trang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640127,
					"content": "Quét sân, tưới nước, còn cắt tỉa cành lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640128,
					"content": "Đều là những công việc rất quen thuộc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "Đây chính là \"quét dọn\" sao? Ta hiểu rồi, vậy thì nhờ vào ngươi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640130,
					"content": "Đúng rồi, lạch cạch lạch cạch thì không cần đâu. Ta rất thích mấy cành cây đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640131,
					"content": "Chỉ cần lá cây với nước là được rồi. Ngươi có hiểu hông?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640132,
					"content": "Cứ giao cho chúng tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "Meo meo, việc này là Hibiki giao riêng cho ta đó, công việc quan trọng chỉ có ta làm được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640133,
					"content": "Đúng rồi, Hibiki là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "Hibiki là Hibiki, nữ tu sĩ của Đền Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640135,
					"content": "Vậy tên của ngươi là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "Ta là Neko, tên do Hibiki đặt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640137,
					"content": "Bình thường đều do Hibiki ra mặt đón tiếp khách đến thăm đền, không cần ta phải lo liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640138,
					"content": "Trước đây ta không có tên, cũng không cần làm Guuji Đại Diện, muốn ngủ thì ngủ, muốn tìm ai chơi thì tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640139,
					"content": "Sau đó Hibiki nói, do ta hay ngủ, nên cứ gọi là Neko đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640140,
					"content": "Hibiki bây giờ không có ở đây, nhưng ngôi đền này không thể không có ai quản lý, vì vậy mà ta đã làm Guuji Đại Diện đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640141
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640141,
					"content": "Cho nên, trước khi Hibiki trở về, ta phải làm cho ngôi đền trở nên thật đẹp thật náo nhiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640142
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640142,
					"content": "...Đúng rồi! Nếu vậy thì khi cô ấy trở về, ta có thể ngủ trong lòng cô ấy rồi, không cần chờ cô ấy sửa Hòm Công Đức, cũng không cần chờ cô ấy dọn lá cây nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640143
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640143,
					"content": "Nói chung chuyện này nhờ hết vào ngươi đó, ta đi đuổi mấy con sâu dám leo vào đền thần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640144
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640123,
					"content": "Lạch cạch lạch cạch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640124
					]
				},
				{
					"id": 721640124,
					"content": "A, là cắt tỉa cành cây đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640115,
					"content": "Cụ thể muốn làm gì?",
