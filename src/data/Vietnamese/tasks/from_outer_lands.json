			"dialogs": [
				{
					"id": 790030401,
					"content": "Đây chắc là phần còn lại của chiếc thuyền vỡ đó. Tôi xem thử...bên trên cũng có khắc chữ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030402,
					"content": "\"...Nửa phần trước đã không còn nữa mà nửa sau vẫn có thể trôi xa như vậy, không hổ danh là thuyền của ta, ha ha ha...Nhưng mà, đồ vật trên thuyền có lẽ đã chìm xuống biển hết rồi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030403,
					"content": "\"...Chắc là trôi theo hướng đông nam chăng? Kệ vậy, vấn đề cần phải giải quyết hiện giờ là làm sao để rời khỏi đây...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030405,
					"content": "Chữ khắc trên hai mảnh thuyền hình như nối tiếp nhau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030406
					]
				},
				{
					"id": 790030406,
					"content": "Nếu ghép lại với nhau, thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030407,
					"content": "\"Tuy không biết đang ở đâu, nhưng xem ra đã cách Inazuma rất xa rồi, đám người Shogunate chắc cũng đã biết sự lợi hại của chúng ta!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030408,
					"content": "\"Nhưng, xung quanh đây chẳng thấy đất liền gì cả, cứ đi tiếp như thế này, e là thuyền sắp không chống đỡ nổi...phải nghĩ cách mới được...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
