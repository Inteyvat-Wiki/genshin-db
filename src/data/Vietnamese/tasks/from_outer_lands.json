						790030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030311,
					"content": "Xem ra đám người này đang vận chuyển thứ gì đó thì gặp nạn trên biển, rồi trôi dạt đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030312,
						790030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030312,
					"content": "Xem ra lành ít dữ nhiều rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030313
					]
				},
				{
					"id": 790030313,
					"content": "Chắc là vậy rồi. Dù sao thì thuyền cũng bị vỡ đôi làm hai mảnh thế này mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030316,
					"content": "Nhưng thuyền của họ vận chuyển gì nhỉ? Thật là làm người ta tò mò...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030317,
					"content": "Hay là chúng ta tìm xung quanh thử xem, không chừng có kho báu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030318,
						790030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030318,
					"content": "Ngâm trong nước lâu như thế, chắc hỏng hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030319
					]
				},
				{
					"id": 790030319,
					"content": "Đừng nói những lời chán nản như thế! Tìm kiếm bảo vật là phải tin rằng chúng vẫn hoàn hảo không hề bị tổn hại gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030322,
					"content": "Được rồi, chúng ta xuất phát thôi, biển lớn như vậy, không chừng phải tìm kiếm lâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030320,
					"content": "Không chừng lại sắp gặp ma vật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030321
					]
				},
				{
					"id": 790030321,
					"content": "Nơi này là biển mà, sao có khả năng đó, cùng lắm cũng chỉ gặp vài con cá to thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030314,
					"content": "Có lẽ họ may mắn thoát nạn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030315
					]
				},
				{
					"id": 790030315,
					"content": "Hi vọng là vậy...nhưng ngay cả thuyền còn vỡ đôi, tôi cảm thấy khó mà thoát nạn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030316
					],
					"speakerTitle": "Paimon"
				}
			]
		},
