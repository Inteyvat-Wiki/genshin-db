			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790030101,
					"content": "Đây là...một con thuyền, à không, nửa con thuyền sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030102,
					"content": "Sao ở đây lại có nửa con thuyền vậy? Ấy, trên thuyền có khắc chữ nữa, để xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030103,
					"content": "\"...Nửa phần trước đã không còn nữa mà nửa sau vẫn có thể trôi xa như vậy, không hổ danh là thuyền của ta, ha ha ha...Nhưng mà, đồ vật trên thuyền có lẽ đã chìm xuống biển hết rồi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030104,
					"content": "\"...Chắc là trôi theo hướng đông nam chăng? Kệ vậy, vấn đề cần phải giải quyết hiện giờ là làm sao để rời khỏi đây...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030105,
					"content": "Hình như là một nhóm người gặp nạn trên biển, ở trên đây có nói \"nửa trước\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030106,
					"content": "Woa...Không lẽ đây chính là \"nửa sau\" của thuyền sao? Cả con thuyền đều bị gãy làm đôi rồi, họ rốt cuộc đã gặp phải chuyện gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030107,
					"content": "Trên đó có ghi, họ trôi dạt theo hướng đông nam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030108,
					"content": "Vậy thì chúng ta đi theo hướng đó để tìm \"nửa trước\" của chiếc thuyền xem, không chừng sẽ có phát hiện gì đó",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030109,
					"content": "Hãy mang theo cả tấm ván gỗ có khắc chữ này theo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030110
					]
				},
				{
					"id": 790030110,
					"content": "Bạn cảm thấy chữ khắc trên đó cũng là manh mối sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030111,
					"content": "Được thôi, dù sao thì ván gỗ trên chiếc thuyền này cũng sắp hỏng hết rồi, chắc cũng dễ nứt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030112,
					"content": "Lấy xong rồi thì chúng ta mau đi tìm phần còn lại thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
