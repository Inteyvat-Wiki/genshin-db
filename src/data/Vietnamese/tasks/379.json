					"nextDialogs": [
						3790402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790402,
					"content": "Đàn Thiên Không dường như... đang phát ra một luồng gió tươi mát như thanh xuân?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790403,
					"content": "Đội trưởng đang tự khen bản thân mình sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790404,
					"content": "...Tôi đang nói về Đàn Thiên Không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790405,
					"content": "#Nhờ {NICKNAME} thanh tẩy kết tinh, Nguyên Tố Phong của Đàn Thiên Không mới không còn khô cạn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790406,
					"content": "Nhưng vẫn còn kém xa so với trước đây. Nếu có thể có thêm nước mắt Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790407,
					"content": "Chúng tôi sẽ giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "Nhưng làm sao để thu thập Nước Mắt Kết Tinh chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790411,
					"content": "Ngay lúc này, Dvalin chắc cũng đang khóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790412,
					"content": "Chịu đựng sự đau khổ, ở nơi không có bóng người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790413,
					"content": "Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790414,
					"content": "Thật là một đứa trẻ đáng thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790415,
					"content": "Đây không phải việc của một mình Kỵ Sĩ Danh Dự, chúng tôi sẽ lập tức hành động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790416,
					"content": "#Sau khi lấy được giọt nước mắt kết tinh, phải nhờ {NICKNAME} thanh tẩy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790417,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "Ừm... thật tốt quá. Câu chuyện anh hùng tin tưởng lẫn nhau, cùng nhau khởi hành luôn thật đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790419,
					"content": "Hãy để tôi dùng khúc nhạc này tiễn các bạn lên đường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790420,
					"content": "Hử? Anh muốn lười biếng... chỉ ngồi nói miệng thôi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790421,
					"content": "Đánh đàn phải dùng tay mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790422,
					"content": "Hứ, thật tức quá. Tôi quyết định tặng cho anh một danh hiệu khó nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790423,
					"content": "Ừm... quyết định rồi, sau này gọi anh là \"<color=#00E1FFFF>tên hát rong</color>\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790409,
					"content": "Làm sao để thu thập Nước Mắt Kết Tinh chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "Làm sao để nó khóc? Đánh nó là được phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
