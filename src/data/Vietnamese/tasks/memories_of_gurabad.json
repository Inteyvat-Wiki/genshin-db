			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050402,
					"content": "Ừm... Liloupar, cô vẫn ổn chứ? Sao lại đột nhiên không có phản ứng vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050403,
					"content": "Suỵt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "Đợi đã, nhìn kìa... cô ấy đang phát sáng. Không giống như trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050406,
					"content": "Bình ma của Trấn Linh phát sáng, có vẻ như đồng điệu với nhịp của \"Quân Cờ\".\\nBạn nghe được dòng chảy của thời gian, như tiếng giọt nước trong nhà giam... Vừa dài như một đời, vừa ngắn như thoáng chốc.\\nTuy nhiên, Liloupar vẫn không nói chuyện.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "Sau đó, bạn nhìn thấy được một tòa thành khổng lồ, hùng vĩ lại lạnh lẽo trong gió bụi.\\nMặt đất nứt ra và nuốt lấy toàn bộ Thành Gurabad...\\nCửa thành khảm trên vách núi, vẻ xấu xí của nó như thể tập hợp từ tất cả sự ô uế của thế giới cổ xưa, nhưng lại khuất khỏi tầm mắt của mọi người...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "Nó ở đây, Gurabad. Ta đã nhớ ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050409,
					"content": "Đầu tôi đau quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "Ối, có chuyện gì vậy... Lần sau như vậy nữa thì báo tôi biết sớm nha! Đừng có hù tôi như vậy nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050411,
					"content": "Xin lỗi, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "Hứ, tôi giận rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050415,
					"content": "#Haiz... Đứa trẻ nào cũng vậy. Được rồi, đừng lo lắng nữa, ta sẽ trả {NICKNAME} lại cho mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050416,
					"content": "#Đến lúc đó, {NICKNAME} sẽ mua cho Paimon rất nhiều đồ ăn... Ừm, còn có cả \"Maura\" nữa, loại tiền tệ của các người đó, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050417,
					"content": "Là \"Mora\"... Mà sao tôi phải sửa lời cô nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "Vậy thì được... Tôi nhớ rồi đấy nhé! Đồ ăn ngon, còn cả Mora nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050420,
					"content": "Được rồi, thời gian dành cho trẻ con đã kết thúc, chúng ta đến Thành Gurabad thôi, thưa chủ nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050421,
					"content": "Tại sao chúng ta phải đi đến đó vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "Tại sao à? Ta không biết... có thể lý do thực sự không quan trọng, nhưng ta cần phải đến đó. Cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050423,
					"content": "#Nếu như phải lấy ra một lý do thì ta hy vọng {F#cô}{M#cậu} thấy được quá khứ của ta, thấy được giáo huấn của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050429,
					"content": "Tuy là không đầu không đuôi... tôi cũng nghe không hiểu, nhưng lời của cô có vẻ như là từ biệt vậy. Đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050430,
					"content": "Haha, không có gì... Chỉ là, có vài chuyện ta muốn các người chứng kiến thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050431,
					"content": "Sao thế, già đầu như vậy rồi mà còn úp úp mở mở sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050432,
					"content": "Nói chung thì các người đi theo ta nhé, ta sẽ chỉ vị trí của Gurabad cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050424,
					"content": "Gurabad... trong đó có gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "Không có gì cả, không có gì còn sót lại cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050426,
					"content": "Thứ còn lại ở đó chỉ là hồi ức của hồn ma, những mảnh vụn của ước mơ và dư vị ngọt ngào của trả thù... Ừm, ta sẽ nói như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050427,
					"content": "#Tuy thỉnh cầu này hơi quá đáng... nhưng ta hy vọng {F#cô}{M#cậu} thấy được quá khứ của ta, thấy được giáo huấn của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050418,
					"content": "Đừng có tự ý thay tôi quyết định chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "Tôi không sao, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "Hứ, lần nào cũng nói vậy cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050404,
					"content": "Liloupar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
		{
			"id": 7330506,
			"completionStepIds": [
				7330506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330506",
