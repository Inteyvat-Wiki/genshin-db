			"dialogs": [
				{
					"id": 733052201,
					"content": "Hãy liên kết ta với \"Quân Cờ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052202,
					"content": "Liên... liên kết? Là sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052203,
					"content": "Hiểu đơn giản là, tìm điểm nhô ra trên bề mặt của nó, sau đó cắm chiếc bình của ta vô trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052204,
					"content": "Hử... Có thứ như vậy sao? Nhưng bình của cô trông rất nhẵn bóng... cũng không có chỗ để cắm vào mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052205,
					"content": "Là do các người không nhìn thấy mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052206,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052207,
					"content": "Là ta mới bịa ra đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052208
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052208,
					"content": "Ê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052209,
					"content": "#Thôi không đùa nữa. Chủ nhân của ta, {F#cô}{M#cậu} chỉ cần để ta tiếp xúc với \"Quân Cờ\" đó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
			]
		}
