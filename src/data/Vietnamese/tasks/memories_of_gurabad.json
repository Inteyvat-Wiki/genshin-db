			"dialogs": [
				{
					"id": 733051201,
					"content": "...Cẩn thận, ở sâu dưới lòng đất có chấn động kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051202
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733051202,
					"content": "Hả? Cô cảm nhận được gì đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733051203,
					"content": "Không có gì... là diễn tập thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051204
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733051204,
					"content": "À ừm, vậy không sao rồi, chỉ là \"diễn tập\" thôi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733051205,
					"content": "Đợi đã... Cái gì mà \"diễn tập\" chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733051206,
					"content": "Suỵt... Chúng đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
