						],
						"stepId": 7330506,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330505",
							"3"
						],
						"stepId": 7330505,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "Woa! Ban nãy vừa mới ở bên cạnh \"Quân Cờ\", vậy mà vụt một cái là đã đến được đây rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050602,
					"content": "Chuyện này là sao vậy, lợi hại quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050603,
					"content": "Haha, muốn thử lại lần nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050604,
					"content": "Lại lần nữa đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "Nghiêm túc chút đi! Còn là con nít sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050608,
					"content": "Chuyện bình thường thôi, tọa độ thay đổi rồi. Có thể là do vấn đề về lão hóa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050609,
					"content": "Ủa... Đây không phải là hẻm núi ban đầu chúng ta đến sao? Cô dẫn chúng tôi đến đây để làm gì? Ở đây có gì đáng để xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050610,
					"content": "Hỏi nhiều quá rồi đó, nhóc ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050611,
					"content": "Kỳ lạ... chắc là ở đây mà nhỉ... Ối, ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050606,
					"content": "Thôi đi, tôi có chút chóng mặt rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "Kể ra thì tôi cũng có chút chóng mặt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "Khi mảnh vỡ lấp lánh được hút vào bình ma của Liloupar, bạn cũng cảm thấy sức mạnh của mình bị rút đi một ít...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "\"Shiruyeh là Khorramdin.\"\\nNgười đàn ông đeo mặt nạ bằng đồng nói.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "\"Sẽ không ai tiếp nối tên ngươi, ta phá hủy một loạt bức tượng trong thần miếu của ngươi; Ta sẽ chôn ngươi xuống mồ vì sự bỉ ổi.\"\\nNgười đàn ông đeo mặt nạ bằng đồng nói.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "Từ ánh mắt hoang mang của Trấn Linh, bạn chứng kiến cảnh tượng thành Gurabad bị màn đêm nuốt chửng...\\nThành Gurabad từ xa xưa vốn là hồ nước rộng lớn, nay dân chúng như dòng nước lũ trốn chạy khắp nơi.\\nTrấn Linh không chút trí tuệ từ trong cỗ máy lạnh lẽo, vũ khí của quân lính tràn ra... rượu đỏ, nước ép lựu cũng chảy ra từ đó...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "Quả lựu lăn mình rạn nứt, lại bị giẫm cho nát vụn, trộn lẫn vào nhau... Căng tròn hay khô héo, phú quý hay nghèo hèn... Trái đỏ sôi nổi hò reo trước sự xuất hiện của Khorramdin - hân hoan của sinh mệnh, khoái cảm của báo thù.\\nMùi vị của nước ép êm dịu ngọt ngào, ngập tràn khắp thành rồi biến thành một vùng biển đỏ thẫm...\\nBiển lớn nhấn chìm đám nô lệ trước tiên, sau đó đẩy dạt chủ nhân trôi nổi trong biển tối than khóc.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "Cuối cùng, bạn nhìn thấy vua của mặt nạ đồng. Hắn ta hòa vào bóng tối và ôm lấy Shirin...\\nKhuôn mặt của cô già nua và mờ nhạt, dấu vết của sinh mệnh và lý trí như hạt cát giữa đêm gió tiêu tan.\\nCòn vua Kisra hóa thành quái vật đen... Họ đều là người cùng huyết mạch, nhưng bản thân vẫn vui mừng, vẫn hân hoan trong báo ứng.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "Thành Gurabad à, vết thương của ngươi không thể chữa lành. Sự nhục nhã của ngươi đã được chúng dân chứng kiến...\\nNgười nghe được tin này sẽ vỗ tay reo mừng.\\nAi mà chưa từng bị ngươi bạo ngược chứ?",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "\"Gurabad ơi, vết thương của ngươi không thể chữa lành, nỗi tủi nhục của ngươi đã bày ra trước mặt mọi người...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050909,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "Ormazd từng là người yêu của Liloupar, hắn vì tình yêu của Trấn Linh mà từ người chăn cừu trở thành vua của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050912,
					"content": "Ta từng ngỡ hắn ta là người bạn đời siêu phàm, ta đã ngu ngốc yêu phải đôi mắt của hắn ta... Nhưng hư vinh của vua và sự ích kỷ của bản thân đã cướp lấy hắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050913,
					"content": "Hắn ta cũng giống như những tên vua chúa khác... chỉ biết xây dựng cung điện trên cát, ngày ngày chìm đắm trong chinh phạt và bức hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050914,
					"content": "Cho nên, cô đã ám hại người đó sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "Ta đã trừng phạt hắn ta. Từ cha đến con, liên tục ba đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050916,
					"content": "Kisra Parvezravan, Shirin, đều là huyết mạch của ta... Ta đã dùng âm mưu của máu, cực hình của mật ngọt, dã tâm của cuồng bạo để trừng phạt tất cả họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050917,
					"content": "Không chỉ như vậy... Haiz, không chỉ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050918,
					"content": "Về việc \"trừng phạt\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "Parvezravan của hư vinh, con trai của ta... Nó muốn có quyền lực vô biên, nên ta đã chiều theo nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050921,
					"content": "Ta đã thiết kế cho nó bộ máy chạy bằng tàn dư linh hồn của Trấn Linh, giấc mộng đêm đen đã truyền cảm hứng cho nó tạo nên cỗ máy khổng lồ nuốt chửng mọi thứ nhân tạo như dòng nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050922,
					"content": "Chúng đem đến sự giàu có vô tận, nhưng lại cướp đi sinh mệnh của người lao động và tài sản của nông dân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050923,
					"content": "Quý tộc và phú thương reo hò tán thưởng. Đây là khải hoàn của phàm nhân, đây là kết thúc của nô dịch. Nhưng ta hiểu, chỉ mình ta biết rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050924,
					"content": "Hủy bỏ chính sách nô lệ mới chính là sự khởi đầu tàn khốc của nô dịch. Chủ nô được xóa bỏ nghĩa vụ chăm sóc nô lệ, còn nô lệ lại bị cướp đi ân huệ nhỏ bé đó là bữa cơm tránh đói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050925,
					"content": "Tôi... nghe không hiểu nữa... Cô đang nói gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050926,
					"content": "Nghèo đói sinh thù hận, thù hận hóa dã tâm... Giàu có sinh tham lam, tham lam đốt dã tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050927,
					"content": "Dã tâm khiến nó ép vương hậu Shirin - cũng là chị gái ruột của mình sản sinh ra Trấn Linh dị dạng không lý trí... Sự đau khổ của nó đã làm ta vui sướng và cho ta sức mạnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050928,
					"content": "...Giúp ta có thể nuôi dưỡng cốt nhục của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050929,
					"content": "Ý cô là Shiruyeh sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "Shiruyeh chính là Khorramdin \"mặt nạ đồng\". Tiện dân và nô lệ coi nó là sứ giả của nữ vương, là kẻ cứu thế trong khổ nạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050931,
					"content": "Cho nên, Shiruyeh dẫn dắt họ đến với chính nghĩa... đón nhận cái chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050935,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050936,
					"content": "Hử? Nhóc con, sao không lên tiếng vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050937,
					"content": "Ừm... Chỉ là tôi nghe không hiểu lắm... Hơn nữa lại còn rất đáng sợ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050938,
					"content": "Không sao đâu... Những thứ ta vừa kể chỉ là quá khứ và vận mệnh của ta mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050939,
					"content": "À ừm... Tôi không biết phải nói gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050940,
					"content": "#Cám ơn {F#cô}{M#cậu} giúp đỡ, ta mới có thể quay về vườn hoa của nữ vương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050941,
					"content": "Sao đột nhiên lại nói vậy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050942,
					"content": "Đối với ta, Gurabad là vùng đất vận mệnh. Ta phải quay về để hoàn thành sứ mệnh của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050943,
					"content": "Ồ... Là do trước kia cô làm nhiều điều sai trái, nên cần phải quay lại bù đắp đúng không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050944,
					"content": "Sai trái...? Hở... Ta có làm gì sai đâu. Đám trẻ nhà ta vẫn ở đó, con bé và Shiruyeh... nhất định sẽ rất buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050945,
					"content": "Ý của cô là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "Bóng tối ngày càng lớn mạnh... Chỉ có sức mạnh của mẹ mới có thể đối đầu trực tiếp với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050947,
					"content": "Ta cứ nghĩ mình có thể điều khiển vực sâu đen tối trừng phạt những gì mình căm ghét... nhưng bản thân lại nhận nghiệp báo... Sứ mệnh của ta chính là đi vào Gurabad để đối diện với sự báo thù của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050948,
					"content": "#Chủ nhân của ta... Rất xin lỗi vì không thể ở bên cạnh {F#cô}{M#cậu} lâu hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050949,
					"content": "#Nhưng ta hiểu, vận mệnh sẽ an bài cho chúng ta gặp lại nhau. Với phẩm chất cao quý của {F#cô}{M#cậu}, ta tin rằng... sự lựa chọn của bản thân là hoàn toàn chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050950,
					"content": "Lựa chọn của cô...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "Theo lẽ thường mà nói, không phải chủ nhân lựa chọn Trấn Linh, mà là ngược lại. Cho dù chúng ta có chia cách, thì sự kết nối giữa chúng ta cũng không kết thúc dễ dàng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050953,
					"content": "Vì vậy... hãy nhận lấy món quà cuối cùng của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050954,
					"content": "#Xin {F#cô}{M#cậu} hãy đưa lên tai... một lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050955,
					"content": "Bạn đưa bình ma ghé sát vô tai...\\nCùng với tiếng cười, giọng nói vô cùng nhẹ nhàng và thanh thoát bỗng thủ thỉ bên cạnh...\\nThứ mà cô ấy kể khó đoán như dòng nước, nhưng bạn vẫn nghe hiểu từng chữ một.\\nCuối cùng, giọng nói biến mất, chỉ để lại chút dư âm lạnh lẽo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "Với sự giúp đỡ của cô ấy, bạn biết được âm luật của những áng văn cổ...\\nNhưng cô ấy không còn cất lời nữa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "Nhìn kìa, màu của chiếc bình trở nên tối hơn rồi... Liloupar, cô vẫn khỏe chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050958,
					"content": "Liloupar... Liloupar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050959,
					"content": "(Ánh sáng từ chiếc bình tối hơn rồi dần lấp lánh trở lại. Nhưng cô ấy không nói thêm lời nào nữa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050960,
					"content": "Cô ấy rời đi rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "Là như vậy sao... Cuối cùng thì vẫn là chia cách mà... Chúng ta vẫn còn cơ hội gặp lại cô ấy chứ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050963,
					"content": "Ừm... Chúng ta... cũng về thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050961,
					"content": "Gurabad... đang đợi cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "Cô phải rời đi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "\"Mặt nạ đồng\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "...Khorramdin chính là vua Shiruyeh đeo mặt nạ đồng. \"Sứ giả của nữ vương\", \"kẻ cứu thế cho người cùng khổ và đám nô lệ\". Haha, đúng là kẻ lừa đảo thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050934,
					"content": "Cuối cùng, Shiruyeh dẫn những người theo mình đến chỗ diệt vong... Toàn bộ Gurabad đã bị mặt đất nuốt chửng, rơi vào khe nứt đen tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050919,
					"content": "Về kết cuộc của Gurabad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "Vì vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
