			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150101,
					"content": "#{NICKNAME}, tình trạng của Teppei có ổn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150102,
						20150103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150102,
					"content": "Chúng ta đều không để ý đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				},
				{
					"id": 20150104,
					"content": "...Tôi đã hạ lệnh, tịch thu tất cả Delusion trong quân đội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150105,
					"content": "Phần lớn binh sĩ tuy có tình trạng tổn thất sinh lực, nhưng không đến nỗi nghiêm trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150106,
					"content": "Nhưng cũng có một phần nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150107,
					"content": "Sangonomiya đại nhân, tôi định mở riêng một trại thương binh để quan sát tình trạng của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150108
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20150108,
					"content": "Các binh sĩ rất náo loạn, rõ ràng biết đó là Delusion, nhưng họ vẫn muốn tiếp tục dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150109
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20150109,
					"content": "Việc này giao cho anh phụ trách, tôi phải đến tiền tuyến một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150110,
					"content": "Xảy ra việc lớn như vậy, lòng quân ắt có dao động. Nếu lúc này quân Shogunate thừa cơ tấn công, thì xem như mất cả chì lẫn chài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150111
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150111,
					"content": "#{NICKNAME}, bạn có dự định gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150112,
					"content": "Kế hoạch ngăn cản Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150113
					]
				},
				{
					"id": 20150113,
					"content": "Không được, quá nguy hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150114,
					"content": "Lệnh bế quan tỏa cảng vẫn đang có hiệu lực, Delusion của chúng chắc là sản xuất tại Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150115,
					"content": "Có thể điều động nhân lực và tài nguyên với quy mô to lớn như vậy, phía sau chắc chắn có thế lực bản địa ủng hộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150116
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150116,
					"content": "Muốn ngăn cản chúng, chỉ còn cách phá hủy công xưởng sản xuất Delusion của chúng. Nhưng ở đó chắc chắn có nhiều binh lính canh giữ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150117
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150117,
					"content": "Không thể để bạn mạo hiểm như vậy, chí ít phải dẫn theo một đội quân đi cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150118
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150118,
					"content": "Không còn thời gian nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150119
					]
				},
				{
					"id": 20150119,
					"content": "Sangonomiya đại nhân, lúc chúng ta tịch thu Delusion đã rất vội vàng, chắc sẽ không qua được tai mắt của Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150120
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20150120,
					"content": "Nếu chúng ta mất thêm thời gian chỉnh đốn quân đội, để chúng biết tin thì chúng nhất định sẽ chạy trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150121
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20150121,
					"content": "Tôi biết...để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150122
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150122,
					"content": "Khi tịch thu Delusion, tôi quả thật đã suy nghĩ. Công xưởng vừa phải lớn, lại phải kín đáo, còn phải gần đường giao thông chính để đảm bảo cung ứng đầy đủ nguyên liệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150123
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150123,
					"content": "Nơi phù hợp với những điều kiện này không nhiều, kết hợp với địa điểm mà những binh sĩ đó nhận được Delusion để suy đoán, công xưởng rất có thể nằm ở vách núi sát biển phía Tây Nam <color=#00E1FFFF>Đảo Yashiori</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150124
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150124,
					"content": "Tôi sẽ không ngăn cản bạn, nhưng bạn nhất định phải cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150125
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150125,
					"content": "Tôi đã mất đi rất nhiều người cùng kề vai chiến đấu, không muốn lại mất đi bạn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150126
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20150126,
					"content": "Chúng ta đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150127
					]
				},
				{
					"id": 20150127,
					"content": "Hử? Muốn đến chỗ <color=#00E1FFFF>Công Xưởng Delusion</color> đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20150128,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150129
					]
				},
				{
					"id": 20150129,
					"content": "Thật sao? Thật sự không suy nghĩ thêm sao? Được thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20150103,
					"content": "Tình trạng đột nhiên chuyển biến xấu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				}
			]
		},
