				"points": []
			},
			"dialogs": [
				{
					"id": 20150401,
					"content": "Không ngờ các ngươi có thể tìm đến đây, cũng khá lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150402
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150402,
					"content": "Thú vị. Mới gặp mặt đã làm ra vẻ như muốn liều mạng với ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150403,
						20150404
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150403,
					"content": "Các ngươi chế tạo Delusion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				},
				{
					"id": 20150405,
					"content": "À, ra là nói chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150406
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150406,
					"content": "Hình như các ngươi có chút nhầm lẫn rồi. Tuy rằng ta đứng ở đây, nhưng chỉ là thay mặt thực hiện kế hoạch mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150407
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150407,
					"content": "Chủ mưu đương nhiên là người khác. Không phải giỏi lắm sao? Cứ tìm tự nhiên nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150408
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150408,
					"content": "Mới có chút \"chuyện nhỏ\" mà đã bị chọc tức rồi à? Hình như ngươi thay đổi rồi...trông yếu đuối hơn nhiều đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150409
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150409,
					"content": "Ngươi dám nói đây là chuyện nhỏ sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20150410,
					"content": "Chẳng lẽ không phải sao? Trong thế giới này, sinh mạng cũng như cỏ rác mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150411
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150411,
					"content": "Không có Delusion, chúng cũng sẽ chết. Chí ít thì Delusion còn cho chúng cơ hội để thực hiện \"ước nguyện\" của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150412
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150412,
					"content": "Giá trị của Lệnh Truy Lùng Vision, các ngươi có thật sự hiểu không? Ban đầu để thúc tiến cho việc này đã phải tốn không ít công sức, đương nhiên là vì nó có lợi cho bọn ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150413
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150413,
					"content": "Nhưng bây giờ xem ra, tất cả đều rất xứng đáng. Tạo ra tranh chấp là để lót đường cho việc phát tán Delusion, để sức mạnh tự thu hút những kẻ yếu đuối đang theo đuổi nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150414
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150414,
					"content": "Chỉ phải trả một cái giá rẻ bèo, là đã có được cảm giác nắm lấy cả thế giới trong tay. Dùng sinh mạng để đổi lấy sức mạnh vô thượng, chẳng phải lời quá rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150415
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150415,
					"content": "Lệnh Truy Lùng Vision là do các ngươi thúc đẩy mà thành sao? Chẳng lẽ, ngay từ đầu các ngươi đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20150416,
					"content": "Inazuma nhìn từ bên ngoài có vẻ vô cùng kiên cố, nhưng bên trong...thì tràn trề cơ hội dành cho bọn ta. Chỉ cần dùng chút sức lực, là có thể công phá từ bên trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150417
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150417,
					"content": "Vĩnh hằng có thể khiến thời gian kéo dài vô tận, thế nhưng mỗi một mốc bên trong đó đều sẽ trở nên yếu đuối vô cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150418
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150418,
					"content": "Cũng giống như những người bạn trong quân kháng chiến của ngươi, bất luận có cố gắng thế nào đi nữa, thì cũng đều là tốn công vô ích mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150419
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150419,
					"content": "Giống như bong bóng nước vậy, đẹp đẽ đó, nhưng rồi sẽ phải tan biến ngay lập tức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150420
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150420,
					"content": "Càng dễ mất đi thì càng muốn có được, càng vô dụng thì lại càng vùng vẫy! Hahaha, vở kịch này thật vui biết bao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150421,
						20150422
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 20150421,
