					"id": 706690202,
					"content": "Meo...\"Bài Thủ Huyền Thoại là một danh hiệu rất lợi hại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690203
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706690203,
					"content": "#\"Hy vọng {NICKNAME} có thể tiếp tục cải thiện kỹ năng chơi bài của mình trong tương lai! Để trở thành một bài thủ xuất sắc xứng đáng với danh hiệu Bài Thủ Huyền Thoại!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690204
					],
					"speakerTitle": "\"Tiểu Hoàng Tử\""
				},
				{
					"id": 706690204,
					"content": "\"Bây giờ mới nói có lẽ hơi thừa, nhưng mà...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706690205
