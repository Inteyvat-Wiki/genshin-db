				]
			},
			"dialogs": [
				{
					"id": 745090101,
					"content": "Một thời gian sau, bạn và Paimon tới trước gian hàng \"Đấu Nấm Chiến Thuật\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745090102
					]
				},
				{
					"id": 745090102,
					"content": "Ôi! \"Trí Dũng Song Tinh\", hai vị lại đến chơi \"Đấu Nấm Chiến Thuật\" rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090103
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090103,
					"content": "Enghiene nhận được nhiệm vụ, nên tới chỗ Sảnh Chấp Pháp trước rồi, từ giờ để tôi chơi cùng hai vị nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090104
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090104,
					"content": "Souka trở về rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090105,
					"content": "Lúc chúng tôi gặp Haniyyah đã thấy rất ngạc nhiên rồi, không ngờ trang phục của cô còn khí thế hơn đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090106,
					"content": "Vậy là tốt rồi. Tôi còn phải làm rất nhiều việc, nên phải duy trì khí thế này mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090107
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090107,
					"content": "Giống như vung rìu để phá tan mọi khó khăn vậy, hihi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090108,
						745090109
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090108,
					"content": "Chuyện bên tòa soạn thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				},
				{
					"id": 745090110,
					"content": "Đang tiến triển ổn định, loại sự kiện mới lạ này có khả năng thu hút không ít sự chú ý, nên tòa soạn sẽ không bỏ qua cơ hội này đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090111
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090111,
					"content": "Mặc dù chúng tôi không giành được trang nhất, nhưng mức độ quan tâm của mọi người cũng đã tăng lên rõ ràng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090112
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090112,
					"content": "Đúng thế. Trong khoảng thời gian này, lượng người đến chơi thử Đấu Nấm Chiến Thuật đang liên tục tăng lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090113
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090113,
					"content": "Không ít người đều đang thảo luận xem nên phối hợp đội hình thế nào mới có thể chiến thắng nhanh nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090114
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090114,
					"content": "Tôi cũng nghe nói mọi người muốn tìm Sao Băng Vàng và Ngôi Sao Bạc để so tài đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090115,
						745090116
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090115,
					"content": "Cao thủ sẽ không tùy tiện ra mặt đâu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090117,
					"content": "Trừ khi Haniyyah và Souka đích thân chiến đấu, hai người bạn này đã quá hiểu chiến thuật của chúng ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090118,
					"content": "Cuộc so tài của chúng ta mới xem như... có chất lượng chuyên môn cao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090119,
					"content": "Vậy chúng ta làm một ván hữu nghị chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090120
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090120,
					"content": "Giải đấu Cúp Nilotpala trước đó tôi đã bị hai vị đánh bại chỉ sau vài đòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090121
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090121,
					"content": "Thật là hoài niệm... Sau chuyện đó tôi và Haniyyah đã trải qua nhiều chuyện, cũng đã trưởng thành hơn. Chắc chắn hai vị cũng thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090122
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090122,
					"content": "Nhưng loại dũng khí không sợ hãi của hai vị... cứ như viên pha lê vững chắc vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090123
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090123,
					"content": "Chỉ từ điểm này là chúng tôi đã quyết định đi theo hai vị sau lần sự kiện Kỳ Trận Nấm Linh đó. Đúng là không chọn sai mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090124
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090124,
					"content": "Sao đột nhiên Souka lại nói những chuyện này vậy? Đây cũng là cảm hứng của một tác giả sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090125,
						745090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090125,
					"content": "Tôi cũng rất hoài niệm những hồi ức khi đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090127,
					"content": "Đúng đó! Quả là một lời thoại xuất sắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090128
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090128,
					"content": "Vậy thì chuẩn bị nhé. Thân là một trong những người thiết kế trò chơi, tôi sẽ chuẩn bị quân cờ mạnh mẽ cho mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090129
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090129,
					"content": "Muốn dùng quân cờ đó sao, Souka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090130
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090130,
					"content": "Đúng vậy. Để tôi làm nóng bầu không khí, sau đó để Haniyyah chỉ huy đội hình mạnh nhất để quyết đấu lần nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090131
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090131,
					"content": "Nghênh chiến nhé, Sao Băng Vàng và Ngôi Sao Bạc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090132,
						745090133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090132,
					"content": "Được rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090134,
					"content": "#Vậy là {NICKNAME} lại sắp so tài với Haniyyah rồi... Mong chờ quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090135,
					"content": "Nhưng lần này chỉ là ván đấu giao hữu, phải chơi thật vui nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090133,
					"content": "Bắt đầu thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090126,
					"content": "Chúng ta còn có thể tạo ra những hồi ức mới mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090116,
					"content": "Nhiều người như vậy thì chắc tôi thua mất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090109,
					"content": "Việc đăng quảng cáo cho sự kiện có thuận lợi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				}
			]
		}
	]
}