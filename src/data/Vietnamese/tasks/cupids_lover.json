						740751806
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751806,
					"content": "Trước đây chúng tôi từng xảy ra xung đột ở Elynas. Đính chính lại, là ở Elynas vào thời điểm gần đây nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751807
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740751807,
					"content": "Lúc trước nhìn thấy nạn nhân ở trước cổng, tôi đã biết ngay là do anh ta làm. Quả nhiên anh ta vẫn đang hoạt động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751808,
					"content": "Vậy hắn ta lấy những thứ ở đây đi để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751809,
					"content": "Rất đơn giản. Anh ta cũng muốn rèn lại Thánh Kiếm Narzissenkreuz. Vì sự nghiệp của Hội Narzissenkreuz vẫn chưa kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751810
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751810,
