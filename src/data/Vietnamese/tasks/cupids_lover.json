			},
			"dialogs": [
				{
					"id": 740750201,
					"content": "Nơi này dường như có người mới tới. Không ngờ lại gặp được người rành về thám hiểm hơn chúng ta nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750202,
					"content": "Trên mặt đất còn có... một chiếc đồng hồ bỏ túi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750203,
					"content": "Theo thói quen thì để tôi xem kỹ lời nhắc trên bia đá đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750204,
					"content": "\"Đây là nơi của Orthant Linh Hồn, Thần Điện Linh Hồn, Khoảng Không Linh Hồn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750205,
					"content": "\"Cùng nhau yên giấc\"... \"Sinh ra trong khoảnh khắc, thường hay mâu thuẫn, mãi không xa rời\"... \"Báu vật thế gian\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750206,
					"content": "Đơn giản mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "Hmm... Đồng hồ bỏ túi đắt tiền, và báu vật thế gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750209,
					"content": "Tôi hiểu rồi, chắc chắn là Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750210,
					"content": "Không giống lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "Cũng có lý, đáp án chắc không bình thường như vậy đâu nhỉ. Chắc phải là, nói thế nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750212,
					"content": "Đúng rồi, là \"tài phú\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750213,
					"content": "Hay quá, nhưng chúng ta tạm thời coi như không phải đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "Tức chết mất, sao lại không tin tưởng tôi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750215,
					"content": "Vậy nói xem đáp án là gì đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750216,
					"content": "Thời tiết hôm nay đẹp thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750217
					]
				},
				{
					"id": 740750217,
					"content": "Ê, đừng có đánh trống lảng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750218,
					"content": "Không quan trọng đâu, cứ đi vào trong xem thử đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750219
					]
				},
				{
					"id": 740750219,
					"content": "Ê, không biết thì nói là không biết đi! Đừng có đi nhanh thế chứ, đợi tôi đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750207,
					"content": "Một câu đố bí ẩn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				}
