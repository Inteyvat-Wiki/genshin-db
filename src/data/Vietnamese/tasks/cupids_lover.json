						740751603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751603,
					"content": "Cũng không phải vậy, hình như bị ai đó lấy đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751604
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751604,
					"content": "Vậy chẳng phải kế hoạch của chúng ta đã thất bại rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751605,
					"content": "Muốn \"Lý Tính\" ra đời, cần có bốn Orthant hợp lại. Chỉ cần chúng ta lấy được những phần còn lại thì vẫn còn cơ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751606
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751606,
					"content": "Vậy chúng ta đến nơi tiếp theo thôi.",
