			"dialogs": [
				{
					"id": 740751701,
					"content": "Kiểm tra phần đỉnh thiết bị một cách cẩn thận, nhưng không phát hiện được gì.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
