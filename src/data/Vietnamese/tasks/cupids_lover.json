			"dialogs": [
				{
					"id": 740750101,
					"content": "\"Đây là nơi của Orthant Linh Hồn, Thần Điện Linh Hồn, Khoảng Không Linh Hồn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750102,
					"content": "\"Cùng nhau yên giấc\"... \"Sinh ra trong khoảnh khắc, thường hay mâu thuẫn, mãi không xa rời\"... \"Báu vật thế gian\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750103,
					"content": "Phù... Lần này không phải là thứ gì đó đáng sợ. Đáp án là đồng hồ bỏ túi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750104,
					"content": "Hình như Ann cũng có một cái đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750105,
					"content": "Đồng hồ chắc đắt lắm nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "Vậy nên đáp án là tiền, hay chính là Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750107,
					"content": "Yên giấc ngàn thu cùng tiền là đại bi kịch thứ hai trong đời người. Đừng hỏi cái thứ nhất là gì nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750108,
					"content": "Vậy đại bi kịch thứ nhất là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750109,
					"content": "Cái này tôi biết đó, đáp án là \"nằm trong quan tài mà không một xu dính túi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750110,
					"content": "Giá trị quan kiểu này không ổn lắm đâu. Trên thế giới này còn nhiều thứ quan trọng hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750111,
					"content": "Vậy nên tôi mới nói là đừng hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750112,
					"content": "Tôi xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750113,
					"content": "Quay lại vấn đề. Với những lý do trên, tôi không nghĩ đáp án sẽ là đồng hồ hay Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750114,
					"content": "Vậy nó là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750115,
					"content": "Rất đơn giản, có thể kiểm tra các câu đố cùng loại với nó, tỉ lệ đúng lên đến 70%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750116,
					"content": "Theo tiểu thuyết cổ điển từ mấy trăm năm trước, nguyên văn là \"Tôi được sinh ra khi ánh mắt chúng tôi chạm vào nhau, và tôi quay lưng chạy về phía người truy đuổi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750117,
					"content": "\"...Bỏ hết tất cả thịt, xương và cả nội tạng, anh vẫn nằm cạnh em trong xương tủy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750118,
					"content": "Đáp án là \"tình yêu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750119,
					"content": "Như vậy thì dễ hiểu hơn rồi. Chiếc đồng hồ này cũng giống như chiếc đồng hồ của tôi. Chắc chắn bên trong nó cũng tràn ngập những ký ức tình yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750120,
					"content": "Nếu mở được chiếc đồng hồ đó ra thì tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "Ừm, sẽ có một ngày mở được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750122,
					"content": "Chó ngốc, làm tốt lắm! Đúng là chú chó robot đáng yêu nhất trên đời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750123,
					"content": "Đó là vinh hạnh của tôi. Có điều, đáng yêu là một từ miêu tả chủ quan, cách khen hợp lý cho tôi là \"cỗ máy 4ACV07 đáng tin cậy và bền bỉ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750124,
					"content": "Ừm, đó cũng là nguyên nhân khiến Seymour đáng yêu đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750125,
					"content": "...Hai người đang diễn phân cảnh kinh điển à? Hình như tôi từng thấy cảnh này rồi thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750126,
					"content": "Dù sao thì câu đố ở đây cũng đã bị người khác giải rồi. Chúng ta mau hành động thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
