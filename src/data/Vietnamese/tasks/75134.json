			},
			"dialogs": [
				{
					"id": 751340401,
					"content": "Cuối cùng các vị cũng trở về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340402,
					"content": "Các vị đã phát hiện ra thứ gì ở dưới đó vậy? Mau nói cho tôi nghe với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340403
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340403,
					"content": "Thực ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340404,
					"content": "Các bạn kể cho Bona nghe về những gì đã trải qua và thứ phát hiện dưới đó...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751340405
					]
				},
				{
					"id": 751340405,
					"content": "Hả?! Lại tìm thấy một mảnh Hỏa Lân Thạch ở dưới đó nữa sao? Tôi cứ tưởng đây là mảnh duy nhất chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340406
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340406,
					"content": "Chờ đã, không lẽ mảnh tôi đang cầm là hàng giả sao...? Hmm, chẳng trách bao năm rồi mà tôi không phát hiện ra nó có gì đặc biệt cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340407
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340407,
					"content": "Không thể nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340408
					]
				},
				{
					"id": 751340408,
					"content": "Đúng vậy, vì mảnh mà chúng tôi tìm thấy ở dưới cũng giống vậy. Ngoài họa tiết ra thì không có gì đặc biệt cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340409,
					"content": "Chúng tôi còn phát hiện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340410
					]
				},
				{
					"id": 751340410,
					"content": "À đúng rồi, chúng tôi còn tìm thấy một đoạn ghi chép kỳ lạ. Có vẻ như là nhà mạo hiểm trước đó để lại, cô có muốn xem không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340411,
					"content": "Ghi chép của nhà mạo hiểm? Những nhà mạo hiểm đến thành phố bị nguyền rủa này đa phần là vì Mảnh Ngọc Quay Về. Vì vậy... Tôi không xem đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340412
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340412,
					"content": "Hả? Nhưng trên đó có nhắc đến Hỏa Lân Thạch, còn cả chuyện về tế đàn, có thể sẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340413,
					"content": "Tôi hiểu. Chính vì vậy nên tôi mới không muốn xem trước khi tìm được Mảnh Ngọc Quay Về đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340414
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340414,
					"content": "Tại sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340415,
					"content": "Nhiều năm qua, vô số nhà mạo hiểm đã lên đường để tìm kiếm Tonatiuh và Mảnh Ngọc Quay Về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340416
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340416,
					"content": "Nhưng họ đều thất bại. Không ai có thể chứng minh rằng con thuyền trên trời đó thật sự tồn tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340417
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340417,
					"content": "Trong mắt mọi người, đó có lẽ chỉ là giấc mơ hão huyền, là ảo tưởng của những người chịu khổ vì Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340418
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340418,
					"content": "Vì vậy, cuộc phiêu lưu của họ sẽ không được người kể chuyện ghi lại, thành tựu của họ cũng sẽ không được ai ca ngợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340419
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340419,
					"content": "Nếu không thể tìm được Tonatiuh và Mảnh Ngọc Quay Về, thì mọi việc họ đã làm đều không có ý nghĩa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340420
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340420,
					"content": "Chính cuộc hành trình đó đã có ý nghĩa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340421
					]
				},
				{
					"id": 751340421,
					"content": "#Thật sao, {F#cô}{M#cậu} nghĩ vậy à? Kiểu nhà mạo hiểm thích trải nghiệm như vậy ở Natlan không nhiều đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340422
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340422,
					"content": "Dù sao thì cũng vẫn có những nhà mạo hiểm không có thành tích, nhưng hầu hết mọi người vẫn cần những thứ có thể chứng minh bản thân mà, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340423
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340423,
					"content": "Kinh nghiệm cũng rất quan trọng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340424
					]
				},
				{
					"id": 751340424,
					"content": "#Câu nói của {F#cô}{M#cậu} dựa trên giả thuyết con thuyền đó thật sự tồn tại. Nhưng nếu trên thế giới này không có Tonatiuh thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340425
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340425,
					"content": "Vì vậy, nhất định phải tìm được Tonatiuh. Cho dù là vì cha tôi hay những nhà mạo hiểm khác đã hy sinh vì điều này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340426
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340426,
					"content": "Và phần ghi chép đó... Bất kể là của ai để lại thì chỉ khi bước lên được Tonatiuh, chúng ta mới có thể nhận được giá trị thích đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340427
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340427,
					"content": "#Vậy nên {NICKNAME} và Paimon à, nếu chúng ta thật sự tìm thấy Tonatiuh và an toàn trở về, thì các vị hãy truyền bá thành tích này đến Hiệp Hội Nhà Mạo Hiểm nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340428
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340428,
					"content": "Đừng lo, Paimon rất giỏi chuyện này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340429
					]
				},
				{
					"id": 751340429,
					"content": "Cái gì chứ, ý là tôi giỏi khoác lác à? Nếu thật sự tìm thấy con thuyền huyền thoại đó thì tôi chỉ cần nói cho Katheryne nghe là tin sẽ truyền khắp Teyvat thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340430,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340431
					]
				},
				{
					"id": 751340431,
					"content": "Ừm, dù sao thì chúng ta cũng coi như là nhà mạo hiểm huyền thoại mà. Chỉ cần kể chuyện cho phóng viên nào đó là sẽ lên trang nhất ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340432,
					"content": "#Cứ giao cho {REALNAME[ID(2)|SHOWHOST(true)]} đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340433
					]
				},
				{
					"id": 751340433,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340434
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340434,
					"content": "Cho dù nó vui vẻ nhận lời, nhưng nếu muốn tuyên truyền thì cũng chỉ có thể nói với những nhà mạo hiểm Saurian thôi... Mà khoan, trong số các Saurian liệu có nhà mạo hiểm không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340435,
					"content": "Haha... Nhưng nói lâu như vậy rồi mà các vị vẫn chưa lấy mảnh Hỏa Lân Thạch ra cho tôi xem thử đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340436
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340436,
					"content": "#Đúng nhỉ! {NICKNAME}, mau lấy mảnh Hỏa Lân Thạch ra đi! Không biết Coco có thấy được gì không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340437,
					"content": "Kulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340438
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751340438,
					"content": "Rooo... Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340439
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340439,
					"content": "Ối! Chuyện gì thế này? Chói mắt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340440,
					"content": "Chee! Kuchee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340441
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751340441,
					"content": "Hửm! Hình như Coco đột nhiên hồi phục sức sống rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340442,
					"content": "Xem ra có thể dùng \"Tia Laser Siêu Cấp\" rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340443
					]
				},
				{
					"id": 751340443,
					"content": "#Hả? Sao {NICKNAME} lại nhớ cái tên khoa trương đó vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340444,
					"content": "Nhưng đúng thật, chẳng lẽ Hỏa Lân Thạch là dùng để lưu trữ năng lượng giống như những mảnh vụn năng lượng mà chúng ta tìm thấy trước đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340445,
					"content": "Có vẻ như Hỏa Lân Thạch cũng ẩn chứa loại năng lượng đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340446
					]
				},
				{
					"id": 751340446,
					"content": "Đúng rồi, chẳng lẽ Hỏa Lân Thạch là dùng để lưu trữ năng lượng giống như những mảnh vụn năng lượng mà chúng ta tìm thấy trước đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340447,
					"content": "Rồi cũng chính vì có loại năng lượng này mà Coco mới có thể đối phó với Vực Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340448,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340449
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340449,
					"content": "#{NICKNAME}, mau nhìn này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340450
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340450,
					"content": "Hả, lại có chuyện gì vậy? Bức bích họa này sao lại thay đổi hoàn toàn rồi!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340451,
					"content": "Có vẻ như bức bích họa mà chúng ta thấy trước đó là lớp phủ trên cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340452
					],
