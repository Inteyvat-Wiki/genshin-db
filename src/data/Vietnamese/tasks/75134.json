			"dialogs": [
				{
					"id": 751340201,
					"content": "Rrooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "Ôi, bên ngoài đã bị Vực Sâu xâm lấn hết rồi, cảm giác như có thể rơi xuống bất cứ lúc nào ấy. Không lẽ thứ mà Coco chỉ cho chúng ta chính là cái này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340203,
					"content": "Cũng không biết bên trong có thứ gì, nhưng tôi nghĩ chắc chắn không phải là tế đàn đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340204,
					"content": "\"Nếu chỉ vận dụng logic một cách khô khan...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "À, tôi hiểu rồi. Chính vì Vực Sâu mà Coco mới không muốn vào đây phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340206,
					"content": "Không thể để mặc Vực Sâu được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "Chính vì Vực Sâu mà Coco mới không muốn vào đây. Chúng ta không thể để mặc chúng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340208,
					"content": "#Xuất phát thôi, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "Này, sao cả hai lại loại trừ tôi ra vậy? Thật quá đáng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340211,
					"content": "Dù sao thì chúng ta cũng hãy dọn dẹp những thứ bẩn thỉu này trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
