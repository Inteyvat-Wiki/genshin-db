			"dialogs": [
				{
					"id": 751340301,
					"content": "Phù, cuối cùng cũng xong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340302,
					"content": "Cỗ Máy Bí Ẩn bảo vệ nó cũng đã nằm yên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340303,
					"content": "Được rồi, xem xem bên trong rốt cuộc là thứ gì nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340304,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340305,
					"content": "Đừng để tôi thất vọng nhé... Hả? Lại một mảnh Hỏa Lân Thạch nữa à? Hóa ra món này không phải chỉ có một mảnh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340306,
					"content": "Khoan đã, cuộn vải bọc nó trông cũng quen... Giống như cuốn ghi chép mà chúng ta đã nhặt được ở tòa tháp bên ngoài di tích ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340307,
					"content": "Rawr... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340308,
					"content": "#Thật kỳ quái. {REALNAME[ID(2)|SHOWHOST(true)]} cũng thấy vậy đúng không? {NICKNAME}, mau xem trên đó viết gì đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340309,
					"content": "Chà, đúng là ghi chép của nhà mạo hiểm trước đó để lại. Vậy thì Lõi Chu'ulel chính là đang nói về nơi này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340310,
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340310,
					"content": "Còn có khả năng khác nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340311
					]
				},
				{
					"id": 751340311,
					"content": "Ừm, chúng ta cũng đã tìm thấy một mảnh Hỏa Lân Thạch mới ở đây, biết đâu ở những nơi khác cũng có nữa thì sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340312,
					"content": "Có quá nhiều điều không thể hiểu được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340313
					]
				},
				{
					"id": 751340313,
					"content": "Đúng vậy. Hơn nữa Coco đã dẫn chúng ta đến đây, chẳng lẽ nó đã biết dưới này còn giấu một mảnh Hỏa Lân Thạch, nên muốn chúng ta lấy được sao? Thật không thể hiểu nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340314,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340315,
					"content": "Chúng ta quay về trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340316
					]
				},
				{
					"id": 751340316,
					"content": "Đúng vậy, Coco chắc chắn biết điều gì đó. Với chúng ta cũng đã hứa với Bona là có phát hiện được gì thì cũng phải quay về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340317,
					"content": "Chúng ta mang về cho Bona xem đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340318
					]
				},
				{
					"id": 751340318,
					"content": "Đúng vậy, biết đâu Bona sẽ có phát hiện gì đó. Với chúng ta cũng đã hứa với Bona là có phát hiện được gì thì cũng phải quay về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340319,
					"content": "Chúng ta mau chóng rời khỏi đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
