			"dialogs": [
				{
					"id": 190250501,
					"content": "Không ngờ lại bị tìm ra dễ dàng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250502,
					"content": "Do thiếu kinh nghiệm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "Tôi cứ tưởng chỗ tôi chọn có thể trốn rất kỹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250505,
					"content": "Đám yêu tà mà tôi hay tìm bắt đều là cao thủ che giấu tung tích, nên tôi đã đại khái tổng kết được một số kinh nghiệm về chỗ trốn của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250506,
					"content": "Giống như ở đây, xung quanh đều là những thứ vuông vức, bên trên đều đóng bụi, ánh sáng cũng không thể chiếu xuyên qua được, yêu tà rất thích trốn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250507,
					"content": "Lại đem trò trốn tìm liên kết với phương thuật nữa rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "Ừ, quả nhiên không nên làm theo những kinh nghiệm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250511,
					"content": "Bị tìm thấy rồi, tôi sẽ vui vẻ nhận thua vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250512,
					"content": "Nhưng mà sau khi chơi thử, tôi thấy trò chơi đơn giản này cũng rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250513,
					"content": "Vậy lần sau chơi nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "Được thôi, chúng ta sẽ gọi thêm bạn bè đến luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250517,
					"content": "Vậy chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250515,
					"content": "May mà không để bạn làm ma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "Ha ha, cũng đúng, nếu để tôi đi tìm, thì chắc cả tiếng sau cũng tìm không ra quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250509,
					"content": "Nhưng mà chỉ cần nhìn qua là thấy ngay rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "Ừm, do quá căng thẳng nên đã bỏ qua thứ đáng chú ý nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250503,
					"content": "...Sao lại chọn trốn ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
