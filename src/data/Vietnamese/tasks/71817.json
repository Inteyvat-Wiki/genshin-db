			},
			"dialogs": [
				{
					"id": 718170101,
					"content": "Thật là phiền phức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170103
					]
				},
				{
					"id": 718170103,
					"content": "Tết Hải Đăng ấy à, người ở nhà trọ đều về nghỉ lễ, thiếu người làm, bận muốn chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170104,
					"content": "Bây giờ tôi chẳng có hơi sức đâu nói chuyện với bạn, phải mau đi chuẩn bị, để buổi tối khách khứa còn gọi món, chắc tôi còn chẳng kịp uống ngụm nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170105
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170105,
					"content": "Nếu bạn đã quan tâm tôi như vậy, thì buổi tối nhất định phải đến giúp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170106,
					"content": "Chẹp, tìm được người nào đỡ việc thì hay người đó, Yuhua chạy đi đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 7181702,
