			"dialogs": [
				{
					"id": 718173201,
					"content": "Cảm ơn nhé, có bạn giúp đỡ đúng là đỡ được rất nhiều việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173202
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718173202,
					"content": "Bận quá đi, rõ ràng là Tết Hải Đăng, mà chưa làm nổi một chiếc Đèn Tiêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173203
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718173203,
					"content": "Phải rồi Nhà Lữ Hành, bạn biết làm Đèn Tiêu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173204
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718173204,
					"content": "Còn kêu bạn giúp thì đúng là ngại quá, nhưng tôi thật sự không có thời gian đi mua nguyên liệu làm Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173205
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718173205,
					"content": "Nếu bạn đồng ý giúp, có thể giúp tôi làm một chiếc... À không, hai chiếc, hai chiếc Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173206
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718173206,
					"content": "Một chiếc tôi giữ, chiếc còn lại bạn hãy giúp tôi đem cho Jiangxue, anh ấy thường câu cá bên cạnh nhà trọ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718173207
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718173207,
					"content": "Cái tên ăn trực đó... cũng không biết làm sao mà bình thường đều tới ăn chùa uống chùa, hôm nay lại không tới...",
