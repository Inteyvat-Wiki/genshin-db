				"points": []
			},
			"dialogs": [
				{
					"id": 718170301,
					"content": "Ây da, bận đến quên mất rồi, bàn ở dưới lầu vẫn chưa chọn món.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170302,
					"content": "Thế này đi, bạn tới bàn chỗ hai vị khách ngoại quốc dưới tầng để nhận món, chính là bàn của Holderlin và Caspar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170303,
					"content": "Chắc họ đã đợi khá lâu rồi, có vẻ đã hơi bực mình, bạn nhớ đem lên trước cho họ <color=#00E1FFFF>2 phần</color> món khai vị, <color=#00E1FFFF>Xiên Thịt Gà Nấm Ngon</color> là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170304,
					"content": "Sau khi mang món khai vị lên xong, thì hỏi xem họ muốn ăn thêm món chính gì, đỡ phải đi thêm chuyến nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170305
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170305,
					"content": "Mau đi đi, đừng để khách sốt ruột.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
