					"speakerTitle": "Holderlin"
				},
				{
					"id": 718170602,
					"content": "Xin hỏi hai bạn muốn gọi món gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170603
					]
				},
				{
					"id": 718170603,
					"content": "Thường nghe nói người Liyue có sở trường làm món hải sản, tôi muốn thử một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170604
					],
					"speakerTitle": "Holderlin"
				},
				{
					"id": 718170604,
					"content": "Nhưng dạo gần đây tôi đang thử ăn chay, không thể ăn thịt, không biết có món chay nào... có vị hải sản không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170605
					],
					"speakerTitle": "Holderlin"
				},
				{
					"id": 718170605,
					"content": "Từ lần nếm món cay ở Vạn Dân Đường lần trước, tôi đã kết mùi vị này rồi, bây giờ bữa cơm nào không có vị cay là không nuốt nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170606
					],
					"speakerTitle": "Caspar"
				},
				{
					"id": 718170606,
					"content": "Hải sản thì thôi vậy, dạo này ăn ngấy rồi, nhưng nếu có Thịt Gia Cầm là tuyệt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170607
					],
					"speakerTitle": "Caspar"
				},
				{
					"id": 718170607,
					"content": "Tôi không quen ăn món Liyue, gọi món gì bạn cứ quyết định là được, vậy thì phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
