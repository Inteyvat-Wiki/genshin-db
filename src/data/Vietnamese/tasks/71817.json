			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718170201,
					"content": "Không được, tôi đã mỏi tay tới mức không nhấc nổi chiếc nồi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170202
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170202,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170203
					]
				},
				{
					"id": 718170203,
					"content": "Ấy, Nhà Lữ Hành, ban nãy tôi còn đang nghĩ nếu có người tới giúp thì tốt rồi... Bạn đồng ý giúp tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170204
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170204,
					"content": "Việc gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718170205
					]
				},
				{
					"id": 718170205,
					"content": "Vào Tết Hải Đăng, người trong nhà trọ đều về nghỉ lễ hết rồi, không đủ nhân lực làm việc, chúng tôi đều bận tới nỗi không kịp trở tay, thêm một người tới giúp thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170206
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170206,
					"content": "Bạn cũng không cần quá lo lắng, không cần bạn giúp việc nặng nhọc, chỉ cần bạn giúp bưng bê đồ ăn, mua sắm ít nguyên liệu là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170207
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718170207,
					"content": "Bạn chờ một lát, tôi xem xem, bây giờ có gì có thể nhờ bạn giúp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao"
				}
			]
		},
		{
			"id": 7181703,
			"completionStepIds": [
				7181702
			],
