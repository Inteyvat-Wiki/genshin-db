						718171403
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718171403,
					"content": "1 phần Đậu Hũ Hạnh Nhân cho Dì Qiao, 1 phần Tôm Viên Tơ Vàng cho Zhuyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718171404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718171404,
					"content": "Mới một lát mà làm nhiều món như vậy, nguyên liệu ở nhà bếp sắp hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718171405
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718171405,
					"content": "Thế này đi, lần này bạn ra ngoài tranh thủ mang nguyên liệu về, <color=#00E1FFFF>Lúa Nước, Hạnh Nhân, Đậu Hũ</color> mỗi thứ <color=#00E1FFFF>3 phần</color> nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718171406
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 718171406,
					"content": "Bây giờ chút nguyên liệu ở nhà bếp thật sự không đủ dùng rồi, phiền bạn ra ngoài mua vậy, có thể mua ở <color=#00E1FFFF>Cửa Hàng Vinh Phát</color> của Cảng Liyue, quay về tìm tôi báo hoá đơn là được.",
