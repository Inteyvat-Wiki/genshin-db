					"nextDialogs": [
						741710104
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 741710104,
					"content": "\"Anh có thể đích thân lên đây trải nghiệm! Hãy liên hệ với Roussimoff để đăng ký.\"",
