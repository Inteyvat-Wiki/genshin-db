						741710102
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 741710102,
					"content": "\"Quy tắc hiệp phụ nên được ghi vào thể lệ cuộc thi bằng văn bản rõ ràng.\"",
					"roleType": "TALK_ROLE_NPC",
