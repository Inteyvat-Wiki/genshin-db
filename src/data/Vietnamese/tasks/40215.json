			},
			"dialogs": [
				{
					"id": 766530401,
					"content": "Cuối cùng cũng đến. Cơ hội thuê bên ngoài hiếm có như vậy, cô sẽ không quên chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530402
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530402,
					"content": "Chờ đã, đơn hàng của anh là cái nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530403
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530403,
					"content": "...Tôi là Gaudenty, người đại diện được Cục Thiết Kế Thí Nghiệm Kuuvahki cử đến. Giờ thì cô nhớ ra chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530404
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530404,
					"content": "Thật dài dòng... Nói nội dung đơn hàng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530405
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530405,
					"content": "Cô...! Tôi giải thích lại lần nữa. Gần đây có một lô robot trinh sát mất kiểm soát đã bay ra khỏi Cục Thiết Kế Thí Nghiệm Kuuvahki và lang thang khắp nơi. Nhiệm vụ của tôi là thu hồi chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530406
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530406,
					"content": "Nhưng những con robot này đều bay rất cao, một mình tôi xử lý rất vất vả, nên mới cung cấp cơ hội thuê ngoài này cho cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530407
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530407,
					"content": "Nói là thu hồi, nhưng thực ra phá hủy tại chỗ cũng được. Mục tiêu của chúng tôi là không để những con robot này rơi vào tay người ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530408
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530408,
					"content": "À, tôi nhớ ra rồi. Những con robot trinh sát đó bay rất cao, người thường không thể với tới, nhưng tôi nắm được một phương pháp tạo ra Con Đường Kuuhenki nhân tạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530409,
					"content": "#Tôi nhớ {NICKNAME} có thể nhờ Kuuhenki giúp đỡ nhỉ? Vậy thì thử để nó tận dụng Con Đường Kuuhenki mà bay lên trời, bắn hạ hết những con robot trinh sát đó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530410
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530410,
					"content": "#Ừm, giao cho {NICKNAME} chắc chắn không vấn đề gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530411,
						766530412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530411,
					"content": "Chuyện nhỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				},
				{
					"id": 766530413,
					"content": "À, tôi không định trả bằng Mora đâu. Về phần thù lao, cứ dùng linh kiện của robot trinh sát để trừ nợ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530414
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530414,
					"content": "Điểm này lúc gửi đơn hàng đã nói rõ rồi, đừng có mà đổi ý đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530415
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530415,
					"content": "Dùng linh kiện trừ nợ? Anh vừa nói không muốn những con robot trinh sát đó rơi vào tay người ngoài mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530416,
					"content": "Thế nên tôi mới nói đây là cơ hội thuê ngoài hiếm có đấy! Chuyện gì cũng có thể linh động mà. Coi như nể tình mọi người vất vả, tôi không ngại mắt nhắm mắt mở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530417
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530417,
					"content": "Lạ thật đó, trông giống như không muốn thanh toán hơn thì phải?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530418,
					"content": "Có Mora hay không cũng được. Những linh kiện đó rất quan trọng, dự án nghiên cứu tiếp theo của tôi vừa hay cần dùng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530419
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530419,
					"content": "Thôi được, nếu Aino đã nói vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530412,
					"content": "Có chút thử thách đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				}
			]
		}
	]
}