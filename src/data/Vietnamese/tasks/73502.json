					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "\"Ban ngày giao thoa với ban ngày, có thể nhìn thấy tại bóng lưng tan làm vội vã của tháp đèn ở trên cầu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "Điều Tra"
				},
				{
					"id": 735020102,
					"content": "Đây, đây là cái gì... là câu đố ư? Hay là ngạn ngữ gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020103,
					"content": "Ban ngày giao thoa với ban ngày? Cái bóng khi tan làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020104,
					"content": "Đây chẳng phải là Nhà Lữ Hành sao? Các bạn cũng hứng thú với những câu đố của ngài Drusus sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020105,
					"content": "Đây thực sự là câu đố sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "Người đặt ra câu đố này là một học giả của Giáo Viện, ngài Drusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020108,
					"content": "Theo như tôi biết thì... anh ấy cũng được xem như một kẻ lập dị trong Giáo Viện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020109,
					"content": "Anh ấy thích nhất là được thảo luận về tất cả các loại câu đố với mọi người, còn nghiên cứu về tất cả các phương pháp mã hóa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020110,
					"content": "Nhưng câu đố của anh ấy thực sự quá tối nghĩa và khó hiểu, cho nên cũng không mấy ai sẵn lòng giao lưu với anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020111,
					"content": "Vì vậy nên anh ấy đã nghĩ ra cách \"giải đố có thưởng\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020112,
					"content": "Nói một cách đơn giản, câu đố này thực ra đang ám chỉ đến một \"địa điểm kho báu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020113,
					"content": "Chỉ cần vào đúng thời điểm, dùng đúng cách, đến được địa điểm chính xác thì có thể nhận được kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020114,
					"content": "Ngài Drusus cũng đã đưa ra gợi ý, nói rằng những \"địa điểm kho báu\" này đều nằm trong Thành Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020115,
					"content": "Nhưng như bạn thấy, vẫn chưa có nhà mạo hiểm nào có thể giải được câu đố này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020116,
					"content": "Nếu bạn có hứng thú thì có thể thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020117,
					"content": "Nhưng theo quan điểm cá nhân, tôi khuyên bạn nên làm việc chính thì hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020106,
					"content": "Anh có biết ai đã đặt ra chúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "Hôm nay cũng không có ai tới à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020302,
					"content": "Đây chính là \"Cánh Cổng Đền Tri Thức\" ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "Đúng vậy! Đây chính là \"Cánh Cổng Đền Tri Thức\", xem ra bạn đã giải được tất cả câu đố của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020304,
					"content": "Tốt quá rồi! Tôi còn tưởng hôm nay cũng không ai làm được chuyện này chứ! Suýt nữa là tôi đi về ăn cơm trưa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020305,
					"content": "Tại sao anh lại viết những câu đố này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "Đương nhiên là vì \"thú vị\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020307,
					"content": "Trả lời nhanh nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020308,
					"content": "Ngoại trừ lý do này ra, các bạn cảm thấy tại sao tôi lại viết những câu đố này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020309,
					"content": "Chẳng lẽ các bạn cho rằng tôi chỉ đang hưởng thụ cảm giác làm khó dễ người khác thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020310,
					"content": "Ai biết được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "Hahaha, vậy thì các bạn cũng hiểu lầm tôi như những người trong Giáo Viện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020313,
					"content": "Sở dĩ tôi viết những câu đố này, chỉ đơn giản là vì thích cảm giác suy nghĩ lúc giải đố mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020314,
					"content": "Các bạn có thể xem lại câu đố của tôi, trong đó luôn có \"từ mấu chốt\" để giải đố mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020315,
					"content": "Chỉ cần lần theo từ mấu chốt này để suy nghĩ thì nhất định có thể giải được câu đố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020316,
					"content": "Nếu tôi chỉ muốn làm khó dễ người khác thì chỉ cần xóa hết tất cả manh mối, biến những câu đố này thành \"câu đố khó giải\" thật sự là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020317,
					"content": "Tạm không nói mấy cái này, nếu các bạn đã giải được tất cả câu đố của tôi thì những thứ này các bạn cứ cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020318,
					"content": "Đây là phần thưởng các bạn đã dùng \"suy luận\" của mình để có được, hãy giữ cho kỹ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020311,
					"content": "Tôi không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
