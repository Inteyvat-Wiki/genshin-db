			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Malta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#Anh}{F#Chị} ơi, {F#chị}{M#anh} có thấy những con Cua Đá kia không? Hình như chúng đang thực hiện nghi thức bí ẩn nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050102,
					"content": "Đây là đặc điểm sinh thái của chúng thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "Vậy sao? À... Hình như em hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050104,
					"content": "Thị Trấn Nasha cũng có nhiều người giống như những con Cua Đá này. Có người thân thiết sẽ kề vai nhau bước đi, có người vừa gặp mặt đã động tay động chân rồi lại tách ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050105,
					"content": "Đó chính là đặc điểm sinh thái của Thị Trấn Nasha nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050106,
					"content": "Đúng vậy, hiểu nhanh lắm đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#{M#Anh}{F#Chị} ơi, {F#chị}{M#anh} có thể dẫn đàn Cua Đá vào trong ao nhỏ được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050109,
					"content": "Hmm... Cũng giống như khi gọi tất cả thợ săn kho báu đến Soái Hạm nhỉ? Chắc sẽ thú vị lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761051501,
					"content": "#Thật tò mò, không biết khi tất cả Cua Đá tụ tập lại với nhau thì sẽ xảy ra chuyện gì nhỉ... Bây giờ {M#anh}{F#chị} có rảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050107,
					"content": "Hình như có chút khác biệt nho nhỏ, nhưng thôi kệ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
