			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "Giáo Đoàn Vực Sâu...những quái vật đối địch với loài người, mạng lưới tình báo ngầm cũng rất ít có thông tin của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970202,
					"content": "Tuy rằng phiền phức, nhưng chung quy vẫn là bị tôi tìm ra manh mối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970203,
					"content": "Nhanh như vậy đã có manh mối sao? Không hổ là lão gia Diluc thông tin nhanh nhạy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970204,
					"content": "Nhưng nói chứ, Phong Thần đại nhân Barbatos, tại sao phải mượn sức mạnh của loài người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970205,
					"content": "Haha, phải nói sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970206,
					"content": "Bảy vị thần mà loài người nói đến, cách xưng hô vốn là \"Bảy vị chấp chính trần thế\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970207,
					"content": "Chia trần thế ra, mỗi vị thống trị một phần bảy, đó là trách nhiệm của thần chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970208,
					"content": "Thực hiện trách nhiệm của Thần, mới có thể tích lũy thần lực. Nhưng tôi không thích thống trị... tôi cảm thấy Mondstadt cũng sẽ không thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970209,
					"content": "\"Hãy tạo dựng một thành bang không có người làm vua\" - lý tưởng của đại nhân Barbatos, chúng tôi vẫn luôn ghi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970210,
					"content": "Đội trưởng Jean, rất thành kính!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970211,
					"content": "Hoàn toàn không thể nghĩ tới nguyên do là người nào đó quá sức vô kỷ luật, không thích làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970212,
					"content": "Khụ khụ. Tóm lại các bạn xem, lâu quá tôi không về lại Mondstadt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970213,
					"content": "Cho nên tôi hiện nay, hoàn toàn không nghi ngờ gì, là người yếu nhất trong bảy vị thần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970214,
					"content": "Nói vậy cũng thẳng thắn quá đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "Quá khen quá khen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970217,
					"content": "Hơ... chúng ta có một vị Phong Thần đại nhân như vậy, nên nói là tốt hay không tốt nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970218,
					"content": "Nhưng hiện nay thì nên bỏ qua đề tài bảy đất nước và bảy vị thần đi, quan tâm đến kẻ địch chung của loài người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970219,
					"content": "Lần này tìm ra <color=#00E1FFFF>dấu vết Pháp Sư Vực Sâu</color>, là ở gần <color=#00E1FFFF>Tửu Trang</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970220,
					"content": "Không thể để bọn chúng chạy thoát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970221,
					"content": "Bắt đầu săn bắt nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "Không hổ là thần của \"Thành Phố Tự Do\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
