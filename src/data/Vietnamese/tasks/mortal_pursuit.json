			},
			"dialogs": [
				{
					"id": 150220301,
					"content": "Chasca, mọi người cuối cùng cũng về rồi. Bầu không khí trong bộ tộc ngày càng trầm trọng, chuyện mà cô điều tra có tiến triển gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220302,
					"content": "Còn có người đang nghi ngờ chúng ta khống chế thương đội là vì thiên vị đội bay nên muốn gây áp lực lên Cánh Phlogiston.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220303,
					"content": "Khống chế được thương đội, nhưng mâu thuẫn lại ngày càng mở rộng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "Chúng tôi đã tìm được một số manh mối. Nhưng nếu muốn tìm ra chứng cứ thì vẫn còn một khó khăn trước mắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220306,
					"content": "Chasca nói rõ tình hình của Tepal và suy đoán về công xưởng trên không...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "Di vật từ Thành Tro Tàn? Bao nhiêu năm trôi qua rồi mà di sản độc hại từ Och-Kan vẫn đang tạo ra mâu thuẫn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220308,
					"content": "Công xưởng trên không... Khí cầu phía trên khu vực thí luyện... Hmm, đây chính là điểm đến tiếp theo của mọi người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220309,
					"content": "Có cách nào để lên đó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "Cho dù là dựa vào Qucusaur hay Cánh Phlogiston thì đều không thể bay cao như vậy... Tepal có thực sự có mặt ở đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220311,
					"content": "Hmm... Cách thức à... cũng không phải không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220312,
					"content": "Thật à!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220313,
					"content": "Mọi người còn nhớ những lỗ thông khí trong khu vực thí luyện không? Lúc trước Địa Mạch bất thường đã gây tắc nghẽn, dẫn đến việc thiếu hụt Phlogiston Thể Khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220314,
					"content": "Nhưng hiện tại khi Phlogiston Thể Khí đã dồi dào trở lại, nếu tiến hành chặn những lỗ thông đó lại thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220315,
					"content": "Ý là... Chỉ để lại lỗ thông cao nhất, đem tất cả áp lực dồn vào một điểm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220316,
					"content": "Nếu làm vậy, khi Phlogiston Thể Khí tích tụ sẽ tạo ra áp suất cực mạnh ở nơi cao nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220317,
					"content": "Sau đó chúng ta có thể đón luồng gió này để bay lên cao à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220318,
					"content": "Ừm. Tuy hơi mạo hiểm, nhưng với kỹ thuật của Chasca thì chắc sẽ không thành vấn đề đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220319,
					"content": "Thực sự khá mạo hiểm đấy... Nhưng cũng rất khả thi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220320,
					"content": "Còn về kỹ thuật chặn lỗ thông hơi thì... Có thể đến địa điểm thí luyện hỏi thăm Inkanak thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220321,
					"content": "Chasca... Có thể tóm được chứng cứ bay trên cao hay không thì đành phải trông cậy vào cô rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220304,
					"content": "Lẽ nào không chỉ người của thương đội đang gây rối sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
