			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Chờ đợi một lúc trước xưởng của Xilonen...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "Để mọi người đợi lâu rồi. Đây là Puma, mẹ của Tepal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Xin chào, chúng tôi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Mấy lời hỏi han khách sáo thì bỏ đi, tôi không muốn nói nhiều về nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "Hả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "Nó sớm đã không còn quan hệ gì với chúng tôi rồi... Tôi không có đứa con như nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "Trong lòng nó chỉ có giấc mơ bay cao... Dù tôi có khuyên thế nào cũng không ngộ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "Hừm... Sau cùng khi nó rời đi, còn nói muốn xây dựng công xưởng ở trên trời để tránh bị người dưới đất chỉ trỏ dòm ngó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "Đây là sổ tay mà nó để lại, mọi người có vấn đề gì thì tự xem đi. Tôi không muốn nói nhiều nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "Tôi chưa từng có đứa con này... Dù sao thì nó cũng chưa từng nhận tôi là mẹ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "Không ngờ mối quan hệ của họ lại tệ đến vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Chồng của dì ấy, cũng là cha của Tepal... mới qua đời chưa lâu. Nhưng dù vậy thì Tepal cũng không xuất hiện trong tang lễ của cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "Có lẽ vì vậy mà dì Puma đã mất hết hy vọng vào Tepal rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "Tôi đi an ủi dì ấy trước, có việc gì thì để nói sau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Làm phiền mọi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Vậy manh mối hiện giờ... chỉ còn cuốn sổ tay này thôi sao? Trong đó viết gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Hmm... Ý tưởng ban đầu của Cánh Phlogiston... và cả \"công xưởng trên không\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Thành Tro Tàn Ochkanatlan... Xem ra nguyên mẫu kỹ thuật của Cánh Phlogiston bắt nguồn từ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "Muốn tạo ra công xưởng bay trên trời à? Một mình Tepal... có thể làm được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "Khí cầu trên bản vẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "...A! Chính là cái ở phía trên khu vực thí luyện! Cái khí cầu bay rất cao đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "Khí cầu đó xuất hiện đã một thời gian rồi, không ai biết nó bay lên đó bằng cách nào... Nhưng nếu nó không phải do ai đó thả cho bay lên thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "Thì có thể là do sự cố nào đó khiến nó đã \"hạ xuống\" từ tầng mây cao hơn thì sao nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "Lẽ nào đó là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "Một phần của công xưởng trên cao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "Rất có khả năng. Chẳng trách ngay cả Isidore cũng không biết căn cứ của Tepal ở đâu... Thì ra là được giấu trên tầng mây cao như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Không ngờ nó thực sự ở trên trời đấy... Vậy chúng ta lên đó thế nào đây? Chasca... Cô có bay cao đến vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "#Rất khó... Nếu phải chở theo cả {NICKNAME} thì càng khó hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "Cho dù có dùng Cánh Phlogiston thì cũng không thể bay cao được như vậy... Trừ khi dùng đến \"di vật\" được ghi trong sổ tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "Di vật này hẳn vẫn đang ở trong tay Tepal... Chắc không còn hy vọng gì rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "Paimon có bay được lên đó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "#Tôi chịu đấy! Nghĩ thế nào cũng không bay được! Hơn nữa, {NICKNAME} nhẫn tâm để tôi một mình bay lên đó chiến đấu với Tepal sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "Yên tâm, chúng ta không nghĩ ra cách, nhưng không có nghĩa là người khác cũng không nghĩ ra. Cao thủ bay lượn trong Hội Hoa Vũ không chỉ có mình tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Ồ... Đúng vậy! Đi tìm trưởng lão Allpa có vẻ được đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "Năm đó Mutota cũng là một cao thủ trong đội bay, quay về Hội Hoa Vũ hỏi ý kiến của họ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Hình như đã gặp qua ở đâu rồi thì phải?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
