			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Theo lời Allpa thì Tepal đến từ Con Của Tiếng Vang nhỉ? Phải làm sao để tìm người này đây? Hay là tìm ai hỏi thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "Tìm người quen trong Con Của Tiếng Vang nhờ giúp chắc sẽ nhanh hơn đấy. Người dễ tìm nhất lúc này chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "Này, Xilonen, dậy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "Hơ... Là cô à? Oáp... Đợi chút, tôi xuống khỏi cái cây này đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "Hơ... oáp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "Cả hai người đều thích ở trên cây nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Tôi trèo lên cây vì muốn bay lâu hơn và nhìn xa hơn, chứ thường sẽ không nghỉ ngơi trên đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "Đâu phải ai cũng giống cô, chạy khắp nơi suốt cả ngày mà không biết mệt... Nào, lần này vì chuyện gì mà đến làm phiền thời gian nghỉ ngơi quý báu của tôi đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "Xin lỗi, Xilonen, nhưng chuyện này rất cấp bách... Cô có quen thợ thủ công nào tên là Tepal không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "Tepal à? Hình như có chút ấn tượng... Chắc là con cái trong nhà Puma nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "Vậy người này có đang ở đây không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "Không, từ mấy năm trước đã không ở đây rồi... Kể ra thì, mọi người tìm anh ta làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "Nói ra thì dài lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Các bạn cố gắng kể lại chuyện đã xảy ra một cách ngắn gọn nhất...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "\"Cánh Phlogiston\"? Tên Tepal này, không ngờ lại thực sự làm ra thứ lợi hại như vậy... Xem ra hôm nay không còn thời gian nghỉ ngơi nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "\"Lại thực sự\"? Lẽ nào trước đây Tepal từng nghiên cứu ra thứ tương tự à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "Đúng vậy. Đại khái là từ sau khi trở về từ Hội Hoa Vũ, Tepal liền nghiên cứu cách thức bay lên trời bằng công cụ nhân tạo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "Sau khi trở thành người mất cánh... Công cụ nhân tạo... Giống với khẩu súng cô chế tạo cho tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "Khẩu súng đó của cô còn khó thuần phục hơn cả con Qucusaur kiêu ngạo nhất đấy... Còn thứ Tepal muốn, chính là để những người thường không có tài năng cũng có thể bay lượn tự do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "Nhưng thời điểm đó Tepal toàn gặp thất bại, làm nổ tung xưởng tận mấy lần, còn suýt mất mạng. Chuyện sau đó thì tôi không để ý nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "Cha mẹ của Tepal năm xưa từng du ngoạn bên ngoài, sau khi Tepal ra đời mới quay về bộ tộc. Nhưng họ cũng lựa chọn sống ở vùng ven hẻo lánh, không giao tiếp nhiều với người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "Người trong tộc cũng không quá thân quen với họ... Muốn tìm hiểu cụ thể thì có lẽ đi tìm người nhà Tepal sẽ ổn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "Giờ tôi sẽ đi hẹn gặp Puma, mọi người đợi ở trước xưởng của tôi một lát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
