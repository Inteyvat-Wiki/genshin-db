			"dialogs": [
				{
					"id": 230230201,
					"content": "Chúng ta cần khá nhiều phân bón đặc chế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230202
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230202,
					"content": "Nguyên liệu khác của loại phân bón đặc chế này chúng tôi vẫn còn dự trữ một ít, chỉ có \"Quả Harra\" là đã dùng hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230203,
					"content": "Nhà Lữ Hành, cháu hãy đi lấy một ít \"Quả Harra\" về đây giúp chúng tôi được không.",
					"roleType": "TALK_ROLE_NPC",
