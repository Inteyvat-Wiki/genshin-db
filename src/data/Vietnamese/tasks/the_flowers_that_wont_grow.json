					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230401,
					"content": "Ngoại trừ vấn đề tăng độ màu mỡ cho đất ra thì có lẽ \"nước\" cũng là một trong số những nguyên nhân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "Có lẽ nào do chúng ta vùi tường vi sâu quá, khiến chúng không thể hấp thu được đủ lượng nước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "Nhà Lữ Hành, xin hãy giúp chúng tôi, cùng chúng tôi tưới nước cho cây tường vi này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302306,
			"completionStepIds": [
				2302306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
