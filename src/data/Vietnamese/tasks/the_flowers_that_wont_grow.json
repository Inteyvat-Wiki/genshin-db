			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "Cứ tiếp tục như vậy không được đâu, ba à, Tường Vi sinh trưởng không tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230102,
					"content": "Phải nhanh nghĩ cách thôi, nếu không năm nay chúng ta không thể nào giao thảo dược đúng hẹn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230103,
					"content": "Đất đai thì không có vấn đề gì, cỏ dại và sâu hại đều diệt trừ rồi, rốt cuộc tại sao lại như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230104,
					"content": "Mọi người đang buồn rầu chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "Ồ? Cháu là khách tới mua thảo dược ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230106,
					"content": "Chuyện là thế này, cứ cách một thời gian, chúng tôi sẽ cung cấp một lượng thảo dược cho \"Bimarstan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230107,
					"content": "Trong số đó loại quan trọng nhất là bụi \"Tường Vi Sumeru\" này đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230108,
					"content": "Hóa ra tường vi cũng làm thuốc sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "Chuyện này thì nên hỏi các bác sĩ của \"Bimarstan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230110,
					"content": "Họ nói là loại tường vi này kết hợp với những loại thuốc khác có thể trị cảm nắng, có hiệu quả xoa dịu bệnh dạ dày, còn có những công hiệu khác nữa... tôi cũng không nhớ rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230111,
					"content": "Đã vậy thì tôi sẽ giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "Thật lòng cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230113,
					"content": "Cây tường vi này bị làm sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "Không biết tại sao mà cây tường vi này phát triển rất chậm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230115,
					"content": "Theo kinh nghiệm lúc trước của chúng tôi, chuyện này xảy ra có thể do đất đai hoặc sâu hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230116,
					"content": "Nhưng lúc trước chúng tôi vừa dùng loại đất này trồng một loạt thảo dược mà, loạt thảo dược đó phát triển tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230117,
					"content": "Ngày nào chúng tôi cũng trừ sâu, sâu hại khỏi phải nhắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230118,
					"content": "Haiz, nhưng bây giờ cũng không thể cứ loay hoay với vấn đề này được, cứ như thế thì cây tường vi này không thể giao cho \"Bimarstan\" đúng hạn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230119,
					"content": "Thế nên chúng tôi lên kế hoạch, trước hết sử dụng phân bón đặc chế tăng dưỡng chất cho đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230120,
					"content": "Nhưng hai chúng tôi còn phải xử lý những ruộng thảo dược khác, vốn không có thời gian thu gom vật liệu làm phân bón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230121,
					"content": "Nhà Lữ Hành, xem như vì người bệnh của \"Bimarstan\"... có thể nhờ bạn giúp chúng tôi việc này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230122,
					"content": "Tôi sẽ giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "Thật lòng cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230124,
					"content": "Để tôi xem tình hình hiện giờ thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
