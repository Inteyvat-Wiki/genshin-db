			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "Chỗ này chắc đủ rồi, thật sự cảm ơn cháu, Nhà Lữ Hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230302,
					"content": "Có loại phân bón đặc chế này thì độ phì nhiêu của đất chắc chắn sẽ không có vấn đề, cây tường vi này sẽ lớn rất nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230303,
					"content": "Mong là không giống như chỗ phân bón trước kia, rải xong chẳng có tí tác dụng gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230304,
					"content": "Lúc trước mọi người có dùng phân bón à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "Có dùng một số loại bình thường, nhưng hiệu quả không tốt... nói đúng hơn là chẳng có hiệu quả gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230306,
					"content": "Nhưng những phân bón đó sử dụng ở những mảnh đất khác lại có hiệu quả rất tốt, cũng không biết nơi này có vấn đề gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230307,
					"content": "Tạm không nói những chuyện này, đây là một ít quà cảm ơn, mong hãy nhận lấy, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302304,
			"completionStepIds": [
				2302304
