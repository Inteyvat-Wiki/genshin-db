				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "Phù... cũng tạm rồi, lượng nước cho đất đai tạm đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230602,
					"content": "Cảm ơn bạn, Nhà Lữ Hành. Nếu không có bạn giúp đỡ, chắc chúng tôi mệt đến gục luôn mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230603,
					"content": "Lạ thật, sao lần này phải tưới nhiều nước như vậy đất mới thấm ướt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230604,
					"content": "Tôi cảm thấy, lượng nước tưới lần này còn hơn gấp đôi bình thường nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230605,
					"content": "Do bạn mệt quá nên mới ảo giác như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230606,
					"content": "Nếu tưới gấp đôi lượng nước, đất đai sẽ bị úng nước, nhưng độ ẩm của đất hiện giờ khá bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230607,
					"content": "Nói thì nói như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "Vardan"
				},
				{
