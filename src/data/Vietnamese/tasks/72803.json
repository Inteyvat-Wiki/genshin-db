			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Đạo Bảo Đoàn Chua Ngoa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030201,
					"content": "Mấy tên trộm các ngươi! Đều tại các ngươi lấy mất cống phẩm của ta nên thần linh mới không hồi đáp ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030202
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030202,
					"content": "Cống phẩm? Ý nhóc là mấy thứ đặt bên cạnh miếu thờ sao? Ôi trời, mấy thứ rách nát đó có cho ta cũng không thèm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030203
					],
					"speakerTitle": "Đạo Bảo Đoàn Chua Ngoa"
				},
				{
					"id": 728030203,
					"content": "Thêm nữa, dùng mấy thứ rách nát đó để cúng tế miếu thần, thần linh hồi đáp ngươi mới lạ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030204
					],
					"speakerTitle": "Đạo Bảo Đoàn Chua Ngoa"
				},
				{
					"id": 728030204,
					"content": "Ngươi...ngươi...ngươi nói láo! Đó không phải thứ rách nát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030205
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030205,
					"content": "Thôi bỏ đi, ta không có thời gian tranh luận với ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030207
					],
					"speakerTitle": "Đạo Bảo Đoàn Chua Ngoa"
				},
				{
					"id": 728030207,
					"content": "Ta...những thứ mà ta cúng tế cho thần linh không phải thứ rách nát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030208
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030208,
					"content": "Ước nguyện của em là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030209
					]
				},
				{
					"id": 728030209,
					"content": "Ừm...dù sao chuyện cũng đã rồi, ước nguyện của em chắc cũng chẳng thể thành hiện thực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030210,
					"content": "Hai ước nguyện của em đều rất đơn giản, một là sau này không cần thi cử nữa! Không cần thi cử thì em sẽ không bị phê bình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030211
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030211,
					"content": "Hai là...kẻ xấu xa đi học cùng em sẽ không bắt nạt em nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030212,
						728030214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030212,
					"content": "#{F#Chị}{M#Anh} cũng không thích thi cử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030213
					]
				},
				{
					"id": 728030213,
					"content": "Đúng vậy! Thi cử khiến người ta khó chịu...Nhưng, kẻ xấu xa kia còn khó chịu hơn cả việc thi cử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030216,
					"content": "Mấy lần liền cô ấy bắt gặp em đang cầu nguyện ở miếu thần nói là không muốn thi, liền tới chỗ thầy giáo hỏi thành tích thi cử của em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030217
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030217,
					"content": "Từ đó về sau, cô ấy cứ tóm em lại nói, suốt ngày cầu nguyện với thần linh để không phải thi cử, chi bằng bỏ thời gian học bài, cứ lẩm bẩm mãi như vậy thì thần linh cũng sẽ thấy phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030218
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030218,
					"content": "Còn nói gì mà, em làm như vậy trông rất...rất không có tiền đồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030219
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030219,
					"content": "Quá dựa dẫm thần linh đúng là không tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030220
					]
				},
				{
					"id": 728030220,
					"content": "Nhưng khi người lớn gặp vấn đề cũng thường đến miếu thờ cúng lễ mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030221,
						728030222
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030221,
					"content": "Đó chỉ là một kiểu cầu nguyện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030223,
					"content": "Ưm...em không hiểu...lẽ nào mọi người không phải vì muốn thần linh giúp giải quyết vấn đề nên mới đến miếu thờ cúng tế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030224
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030224,
					"content": "Chúng ta đi hỏi người khác xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030225
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030225,
					"content": "Ừm...được thôi, nhưng dù thế nào thì ước nguyện của em chắc chắn không thể thực hiện nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030222,
					"content": "Cuối cùng vẫn phải tự mình giải quyết vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030214,
					"content": "Kẻ xấu xa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030215
					]
				},
				{
					"id": 728030215,
					"content": "Là người cùng đi học với em, nhưng cô ấy...cô ấy rất vô lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
