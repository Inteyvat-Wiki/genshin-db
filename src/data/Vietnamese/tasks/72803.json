			"trigger": {
				"objectNames": [
					"Kouichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030401,
					"content": "Xin chào, có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030402,
					"content": "Về cúng tế miếu thờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "#Ồ...{F#chị}{M#anh} nói về việc này à, em đúng là có tới đó mấy lần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030404,
					"content": "Hi hi, em muốn được thần linh phù hộ, sau này lớn lên có thể ra thế giới bên ngoài mở mang tầm mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030405,
					"content": "Nhưng mà, cúng tế là cúng tế, bình thường em cũng luôn nỗ lực học tập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030406,
					"content": "Vì cha mẹ em nói, muốn chu du bên ngoài, bắt buộc phải có đủ tiền mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030407,
					"content": "Đúng, chỉ cần thần linh phù hộ, những điều này chắc chắn có thể thành công một cách thuận lợi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030408,
					"content": "Ây da, cũng không thể nói như vậy. Dù sao thì nếu như tôi có ra bên ngoài du ngoạn, thì thần linh của Inazuma chắc cũng không thể bảo vệ đến nước khác đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030409,
					"content": "Dùng lời lẽ của cha mẹ em mà nói, chuyện cúng tế thần linh nhiều nhất chỉ xem như là cầu bình an mà thôi. Muốn hoàn thành ước nguyện, vẫn phải dựa vào sự nỗ lực của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030410,
					"content": "Em cũng không thể nói sâu xa về đạo lý, nếu mọi người muốn tìm hiểu, thì hãy đi hỏi chị Nanatsuki nhé, chị ấy rất hiểu những chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030411,
					"content": "Ưm...vậy chúng ta đi tìm chị Nanatsuki xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280305,
			"completionStepIds": [
				7280307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280307",
							"2"
						],
						"stepId": 7280307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "Shouta? Sao trông em có vẻ uất ức vậy, có ai bắt nạt em à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030502,
					"content": "Chị Nanatsuki, chị nhất định biết chuyện mọi người trong thành đều cúng tế miếu thờ, cầu khấn thần linh phù hộ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030503,
					"content": "Chỉ cần cố gắng hết sức cúng tế miếu thờ, để thần linh đồng ý hồi đáp, tất cả ước nguyện đều sẽ thành sự thực...phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030504,
					"content": "Ấy? Tại sao đột nhiên lại nhắc đến việc này...đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030505,
					"content": "Sự tình là như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "Đứa bé này...thì ra em có suy nghĩ như vậy, nên mới tích cực đi cúng tế miếu thờ à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030508,
					"content": "Vâng! Em rất thành khẩn cúng tế thần linh, nhưng cống phẩm lại bị người khác lấy mất...Thần linh chắc chắn sẽ trách tội em, sẽ không phù hộ em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030509,
					"content": "Đứa bé này...yên tâm đi, thần linh sẽ không tức giận vì chuyện cỏn con này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030510,
					"content": "Vậy, vậy sao? Vậy thì tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030511,
					"content": "Nhưng đồng thời, thần linh cũng sẽ không vì chút cống phẩm mà đặc biệt phù hộ một ai đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030512,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030513,
					"content": "Sở dĩ mọi người đi cúng tế miếu thờ, cầu khấn thần linh phù hộ, nói là hy vọng thần linh giúp đỡ mình hoàn thành tâm nguyện, nhưng không phải như lời nói, mà là để thiết lập \"niềm tin\" vững chắc cho bản thân mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030514,
					"content": "Niềm tin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030515,
					"content": "\"Đều đã từng nói ra ước nguyện trước mặt thần linh, nhất định phải nỗ lực hết sức mới được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030516,
					"content": "\"Có thần linh phù hộ, tiếp tục cố gắng nhất định sẽ thành công.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030517,
					"content": "Sau khi có \"niềm tin\" như vậy, tiếp tục dốc sức phấn đầu vì ước nguyện của mình. Đây mới là nguyên nhân mà mọi người đi cúng tế miếu thờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030518,
					"content": "Dù sao thì...sự thành tại nhân, nếu chỉ mong chờ thần linh giúp đỡ, nhưng bản thân lại không chịu hành động, cho dù thần linh có thật sự muốn giúp em, cũng chẳng có chỗ mà nhúng tay vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030519,
					"content": "Nhưng, nhưng mà! Ngày trước sau khi cúng tế miếu thờ, thần linh đều giúp đỡ em ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030520,
					"content": "Giống như là vụ hoả hoạn kia, ông bác muốn trở nên mạnh mẽ, còn cả truyện tranh kia của em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030521,
					"content": "(Vẫn đang lẩm bẩm về thần linh à...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "Ừm...Đúng vậy, xem ra cách mà vị thần linh này thực hiện ước nguyện rất trực tiếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030524,
					"content": "Nhưng, nhưng lần thi cử này không biến mất, người bắt nạt em cũng vẫn còn, cô ấy cứ muốn em đi học bài, ngày nào cũng giục em không ngừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030525,
					"content": "Ủa, chờ đã, người \"bắt nạt\" em kia tên là gì? Xuất hiện từ khi nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030526,
					"content": "Cô ấy tên là...là...gì nhỉ? Cô ấy tên là gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030527,
					"content": "Hình như cô ấy cùng nhập học với em...không phải không phải, hình như sớm hơn em một chút...hay là muộn hơn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030528,
					"content": "Kỳ lạ...sao em, sao em không nhớ rõ nhỉ, chỉ nhớ có một cô bé ngày nào cũng đến giục mình học bài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030529,
					"content": "Ừm xem ra vị thần linh đó lần này cũng đã hồi đáp lời cầu nguyện của em, đang giúp em vượt qua kỳ thi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030530,
					"content": "Chị, ý chị là, người suốt ngày bắt nạt em đó là thần linh bảo cô ấy tới giục em học bài sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030531,
					"content": "Không, không thể nào! Em không muốn học bài, em không muốn thi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030532,
					"content": "Á! Cô ấy lại tới rồi, ở ngay bên đó, đến từ bên kia đường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030533,
					"content": "Ở đâu nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "Mọi người không nhìn thấy cô ấy sao?! Trong tay cô ấy còn ôm một xếp đề thi kìa! Ôi! Đừng mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030536,
					"content": "Xem ra vị thần đó rất là chuyên nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030537,
					"content": "Thần linh này cũng quá đáng nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "Nhưng có thần linh đích thân đôn đốc làm bài tập, đứa trẻ này chắc sẽ thi cử thuận lợi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030540,
					"content": "Dù sao đứa trẻ đó suốt ngày lẩm bẩm trước miếu thờ, thần linh chắc cũng sắp không chịu nổi nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030541,
					"content": "Ấy, chờ đã, sao trên con đường này lại có lá, vừa nãy làm gì có nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030538,
					"content": "Nghe không giống như việc mà thần linh làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "Hoàn toàn không nhìn thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "(Không thể hiểu nổi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
}