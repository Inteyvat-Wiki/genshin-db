			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "Xin chào, tôi là Daya của Học Viện Kshahrewar! Bạn cũng đến tham gia Hội Chợ Trí Tuệ à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900102,
					"content": "Đây là hạng mục trò chơi do học viện chúng tôi đưa ra: \"Quy Hoạch Thông Lộ\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900103,
					"content": "Thế nào? Có muốn chơi thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900104,
					"content": "Tôi nhớ Học Viện Kshahrewar chuyên nghiên cứu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "Rất nhiều nghiên cứu của học viện chúng tôi đều liên quan đến cơ quan và kiến trúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900107,
					"content": "E hèm, nói hơi xa rồi... Để tham gia Hội Chợ Trí Tuệ lần này, rất nhiều học sinh trong học viện chúng tôi đã cùng nhau động não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900108,
					"content": "Cuối cùng đã nghiên cứu ra trò chơi Quy Hoạch Thông Lộ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900109,
					"content": "Nói một cách đơn giản, trò chơi yêu cầu sử dụng vật dụng mà chúng tôi đã chuẩn bị để làm đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900110,
					"content": "Bất kể là xây cầu, làm cầu thang... mục tiêu cuối cùng chính là làm ra một con đường để mọi người có thể đi lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900111,
					"content": "Sau khi xây xong, chúng tôi sẽ kiểm tra lại... giống như nghiệm thu công trình vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900112,
					"content": "Tóm lại, chỉ cần có thể làm ra được một con đường an toàn là xem như thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900113,
					"content": "Nghe có vẻ phức tạp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "Hahaha, đừng lo, đây đâu phải xây thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900116,
					"content": "Cho dù xây dựng có sai sót hay đường có sập cũng không sao, chỉ cần xây lại là được, chúng tôi cũng không giới hạn số lần thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900117,
					"content": "Chỉ cần phát huy trí tưởng tượng, xây dựng lên một con đường xinh đẹp là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900118,
					"content": "Tôi muốn thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "Không thành vấn đề, vậy thì nhìn sang bên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900120,
					"content": "Còn bận việc khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "Thế à... Không sao, gian hàng của chúng tôi vẫn sẽ mở suốt thời gian Hội Chợ Trí Tuệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900122,
					"content": "Bất kể khi nào, chỉ cần bạn muốn thử thì cứ đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900114,
					"content": "Tôi không có năng khiếu xây dựng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
