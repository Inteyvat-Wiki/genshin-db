			"dialogs": [
				{
					"id": 766530201,
					"content": "Rốt cuộc là sai ở đâu chứ? Nếu chỉ có kiến thức lý thuyết thì quả nhiên là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530202,
					"content": "Đơn hàng của người này thì không cần xác nhận... Ginette, kỹ sư đến từ Fontaine... Đơn hàng này tôi hứng thú nhất đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530203,
					"content": "Cuối cùng cũng đến rồi! Vậy là còn hy vọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530204,
					"content": "Xin chào, chúng tôi coi như là trợ lý của Aino. Cô cần chúng tôi giúp gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530205,
					"content": "Cô ấy thiết kế một loại robot có thể sử dụng Kuuvahki để giao tiếp từ xa, rất thú vị! Nhưng mà bị lỗi nhiều quá nên mới phải tìm tôi để sửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530206,
					"content": "Thật đáng xấu hổ. Chỉ ôm tâm lý tò mò thử một chút thì chẳng thể làm ra được thành quả mà, cuối cùng vẫn phải dựa vào thực tiễn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530207,
					"content": "Nghe không có vẻ gì là phiền phức nhỉ... Vậy giao cho chúng tôi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530208,
					"content": "Nói ra có chút ngại... Tôi hy vọng có thể sửa đổi nội dung đơn hàng. Trước đó trong lúc chờ hồi âm không có việc gì làm, tôi lại làm hỏng thêm vài việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530209,
					"content": "Tôi bỗng tò mò không biết đổi môi trường có giải quyết được vấn đề trục trặc không, nên đã tìm vài khu vực có Kuuvahki khác nhau rồi lần lượt thử nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530210,
					"content": "Kết quả là robot vẫn bị lỗi, tất cả đều mất liên lạc... Thế nên, ngoài việc sửa lỗi trước đó, các vị có thể giúp tôi tìm lại những con robot đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530211,
					"content": "Lạc hết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530212,
					"content": "Nếu cần trả thêm thù lao thì tôi sẽ nghĩ cách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530213,
					"content": "Hm... Có rất nhiều phương pháp dò tìm tương ứng. Những con robot đó đều được điều khiển bằng Kuuvahki, những nơi chúng hoạt động qua sẽ để lại một số Hoa Văn Kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530214,
					"content": "Tôi sẽ chuẩn bị một loại thiết bị đặc biệt, chỉ cần dùng nó thu thập đủ Hoa Văn Kuuvahki là có thể dò ra được vị trí của robot tương ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530215,
					"content": "Chà... Chắc là sẽ rất vui đây. Nể tình điều này, tôi sẽ không thu thêm phí nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530216,
					"content": "Thật sao? Cảm ơn rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
			]
		}
	]
}