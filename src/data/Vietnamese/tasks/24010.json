	"talks": [
		{
			"id": 2401001,
			"completionStepIds": [
				2401001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401001",
							"2"
						],
						"stepId": 2401001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "Ý tưởng này cũng hay, nhưng mà... có thể làm như vậy sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100102,
					"content": "Anh vẽ tới đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "Ấy, là bạn à. Rất cảm ơn bạn lúc trước đã giúp tôi chụp ảnh, cảnh vật trong đó cho tôi rất nhiều cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100104,
					"content": "Tôi đã có ý tưởng khái quát, cũng vẽ được vài bản nháp, nhưng mà... nói sao nhỉ, đều không như ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100105,
					"content": "Bạn đừng hiểu lầm, không phải tôi nói mấy bức tranh mình vẽ đều là đồ bỏ đi, chỉ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100106,
					"content": "Để khác biệt với hội họa thông thường, chúng vẫn thiếu một chút \"đặc biệt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100107,
					"content": "Hơn nữa, hình ảnh tôi tưởng tượng hơi nặng tính hình thể. Nếu cứ vẽ như vậy, chắc chắn sẽ tổn hại đến cái đẹp mà tôi muốn truyền tải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100108,
					"content": "Haiz, mọi họa sĩ đều phải đau đầu vì vấn đề này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100109,
					"content": "Thử vẽ thứ khác xem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Cảm ơn ý kiến của bạn. Vấn đề này, không phải chỉ đổi đề tài là giải quyết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100111,
					"content": "Dù là vẽ cảnh vật núi sông, động vật hay là phố phường dân dã, vấn đề này vẫn luôn tồn tại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100112,
					"content": "Để giải quyết vấn đề, vài đồng nghiệp của tôi đã dùng cảm xúc nội tâm để phân tách và biến đổi những cảnh vật hình thể này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100113,
					"content": "Cách vẽ đó sẽ nhấn mạnh vào cảm xúc nội tâm trên bức tranh của họ... nói sao nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100114,
					"content": "Đúng rồi! Trên bức tranh, dù là người hay cảnh vật, thậm chí đến cả những đường nét ánh sáng cũng mang một cảm giác kỳ quái, không hề có vẻ thẩm mỹ truyền thống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100115,
					"content": "Nếu chỉ xem qua về mặt hình ảnh, đa số đều cho rằng người vẽ không hiểu gì về hội họa hoặc là kẻ thô lỗ, hoặc là bị điên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100116,
					"content": "Nhưng chỉ cần bạn tĩnh tâm lại, dùng tâm hồn và linh cảm để lắng nghe, nhất định sẽ nghe thấy bức tranh đang gào thét thay cho vị họa sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100117,
					"content": "Tiếng thét từ tâm hồn vị họa sĩ, bộc lộ ra mọi xúc cảm của người đó... Hơn nữa, những cảm xúc này phần lớn đều rất mãnh liệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100118,
					"content": "Âm thanh này không thể lắng nghe bằng đôi tai, mà phải dùng tâm hồn để tìm kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100124,
					"content": "Còn tôi thì... không muốn từ bỏ cảnh vật hình thể, vì vậy tôi đã nghĩ ra một phương pháp khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100125,
					"content": "Tôi quyết định đặt trọng tâm vào màu sắc. Tôi phải tìm ra cảm giác sắc độ mãnh liệt hơn, với bút pháp đơn giản nhưng mạnh mẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100126,
					"content": "Đồng thời phải làm suy yếu ánh sáng và tạo hình cảnh vật truyền thống... Những thứ này sẽ ảnh hưởng đến tính biểu đạt, vì vậy tôi sẽ tạm thời gạt bỏ chúng khỏi phần hình ảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100127,
					"content": "Nhưng vấn đề là... Để tạo ra cảm giác sắc độ mãnh liệt, tôi phải dùng rất nhiều màu vẽ. Khi cần thiết, còn phải nặn màu trực tiếp lên tranh vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100128,
					"content": "Thế nên... màu vẽ của tôi... dùng hết sạch rồi. Bây giờ lại không thể mang theo giá vẽ rời khỏi đây, làm vậy sẽ ảnh hưởng đến tác phẩm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100129,
					"content": "Nhà Lữ Hành, có thể phiền bạn vào trong thành một chuyến không? Tôi đã nhờ Boucicaut mua một lô màu, chắc là chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100130,
					"content": "Hoặc là... Bạn có thể giúp tôi tìm một ít Mật Hoa Lừa Dối, tôi sẽ tự pha chế màu vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100131,
					"content": "Mật hoa cũng làm màu vẽ được à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Hahaha, đương nhiên là được. Vài đồng nghiệp của tôi còn dùng trứng chim để làm màu vẽ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100133,
					"content": "Nghe nói màu vẽ được làm theo cách này sẽ rất tinh tế, giàu chiều sâu, rất phù hợp để vẽ những khung cảnh rực rỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100136,
					"content": "Bạn rất tốt bụng, chắc sẽ không từ chối thỉnh cầu của một nghệ sĩ đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100137,
					"content": "Tôi biết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "Được! Vậy đành phiền bạn, tôi sẽ đợi ở đây, bạn lấy được đồ xong đem về cho tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100138,
					"content": "Anh thật là... Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "Anh còn biết làm màu vẽ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Hahaha, tất nhiên rồi. Môn học đầu tiên khi làm họa sĩ là phải học được cách tự mình điều chế màu vẽ, như vậy sẽ giúp nắm bắt hình ảnh tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100119,
					"content": "Thử đổi cách vẽ khác xem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "Nói rất hay. Vài đồng nghiệp của tôi cũng nghĩ vậy, vì thế họ cũng đang thử nghiệm một số phương pháp \"phi hình thể\" để thể hiện một số hình mẫu \"trừu tượng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100121,
					"content": "Những người cấp tiến trong số họ thậm chí còn từ bỏ việc miêu tả cụ thể hình tượng, thay vào đó chỉ dùng những mảng màu đơn lẻ để biểu đạt hình ảnh... họ gọi đó là \"chủ nghĩa miêu tả mới\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100122,
					"content": "Nhưng cũng phải nói, ngay cả tôi cũng khó hiểu được tác phẩm của họ, nhiều lắm cũng chỉ cảm thấy nhịp độ thẩm mỹ trong những mảng màu và đường nét đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100123,
					"content": "Còn bức tranh đó rốt cuộc muốn thể hiện điều gì... Cũng chỉ còn cách nhờ vị họa sĩ đó giải thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2401002,
			"completionStepIds": [
				2401002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401002",
							"2"
						],
						"stepId": 2401002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Boucicaut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "Xin chào, bạn muốn mua gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100202,
					"content": "Về màu vẽ của Depierris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "Ồ, bạn thay anh ấy đến lấy màu vẽ sao? Tôi chuẩn bị xong cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100204,
					"content": "Anh ta xài màu hao thật, giống như vừa mua về liền đem đổ đi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100205,
					"content": "Được rồi, màu vẽ của anh ấy đều ở đây, bạn đem đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boucicaut"
				}
			]
		},
		{
			"id": 2401003,
