			"dialogs": [
				{
					"id": 741870201,
					"content": "Này, tên ngốc kia! Sao vẫn còn nhiều bảo vật ở đây thế? Lề mề như vậy thì phải làm đến bao giờ đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870202
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870202,
					"content": "Không phải đâu đại ca! Số kho báu này thực sự quá nặng, chúng ta đã vận chuyển cả ngày rồi mà không ngờ vẫn còn nhiều như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870203
					],
					"speakerTitle": "Người Bị Gọi là \"Tên Ngốc\""
				},
				{
					"id": 741870203,
					"content": "Ngươi ăn gì để lớn thế? Đây là kho báu, nặng một chút không phải rất bình thường sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870204
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870204,
					"content": "Huống hồ những kho báu này đều do chúng ta \"thu thập\" từ tay đám man tộc chết tiệt đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870205
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870205,
					"content": "Hừ, đám sâu bọ đó chỉ đáng sống như bầy gia súc thôi, để lại kho báu trong tay chúng thì thật là lãng phí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870206
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870206,
					"content": "Nhưng nếu muốn đem tất cả kho báu này về Remuria... Thì chắc phải nhờ cấp trên phái thêm vài chiếc thuyền đến chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870207
					],
					"speakerTitle": "Người Bị Gọi là \"Tên Ngốc\""
				},
				{
					"id": 741870207,
					"content": "Ngươi điên à? Thuyền vận chuyển của đế quốc thì sao có thể để chúng ta làm việc đó chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870208
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870208,
					"content": "Nếu đã vậy thì hãy phá hủy hết đi! Dù sao thì cũng không thể để rơi vào tay những kẻ man tộc đó được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870209
					],
					"speakerTitle": "Người Bị Gọi là \"Tên Ngốc\""
				},
				{
					"id": 741870209,
					"content": "Ừm, cuộc nói chuyện này cứ có cảm giác quen thuộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870210,
						741870211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870210,
					"content": "Lúc mới đến Thị Trấn Petrichor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				},
				{
					"id": 741870212,
					"content": "Đúng vậy, những nhà mạo hiểm xui xẻo bị chúng ta đánh đuổi trước đó cũng từng nói những lời tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870213,
					"content": "Hơn nữa cảm giác nghe còn quá đáng hơn lúc trước nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870214,
					"content": "Không lẽ thuyền của họ bị chìm, sau đó họ cũng biến thành Ma Tượng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870215,
					"content": "Nghĩ thế nào cũng thấy đáng sợ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870216,
					"content": "Các người là người của Quân Đoàn IX sao? Ở đây làm gì? Theo lệnh thì có lẽ Quân Đoàn IX đã rút về Pháo Đài Charybdis rồi mới phải chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870217
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870217,
					"content": "Này, Este! Đừng có làm hỏng chuyện tốt của chúng tôi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870218
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870218,
					"content": "Dù sao đối phó với đám man tộc này cũng dễ hơn đối phó với cá chết mà. Cứ để chúng tôi ở đây chơi thêm một lúc nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870219
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870219,
					"content": "Số tài sản này... Haiz, tôi không biết người chỉnh âm quản lý các người đã ra lệnh như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870220
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870220,
					"content": "Nhưng Sebastos lệnh cho chúng ta đi chinh phục những bộ tộc lạc hậu, cốt là để phá vỡ xiềng xích vận mệnh trói buộc họ. Còn những gì các người đang làm rõ ràng là đang phạm tội đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870221
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870221,
					"content": "Hả? Chỉ huy của chúng tôi, ngài Boethius vĩ đại đã ra lệnh cho chúng tôi phải trừng phạt bọn man tộc này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870222
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870222,
					"content": "Huống hồ chúng tôi không bị trừng phạt, có nghĩa dù là Phobos hay bệ hạ thì cũng đã chấp nhận hành động của chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870223
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870223,
					"content": "Nhưng anh lại ở đây nói linh tinh phạm tội gì đó... Anh cố ý gây sự sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870224
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870224,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870225
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870225,
					"content": "Một Este khác sao? Sự việc càng ngày càng kỳ lạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870226,
					"content": "Xem ra bây giờ là lúc để trả lời câu hỏi lúc trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870227
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870227,
					"content": "Este mà hai vị gặp trong thị trấn chính là hậu duệ của người Remuria chúng tôi. Lúc đó tổ tiên của Este theo tôi gia nhập đất nước mới, trở thành người Fontaine bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870228
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870228,
					"content": "Vì vậy, \"bản nhạc\" cướp đi linh hồn người Fontaine đã vô hiệu với Este. Ngược lại, giai điệu ghi lại ký ức của tổ tiên vì không có nơi để đi nên đã gắn chặt với bức tượng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870229
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870229,
					"content": "Nói như vậy, Este ở đây thật ra là tổ tiên của Este trong thị trấn sao? Vậy còn những người khác thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870230,
					"content": "Đều chỉ là những linh hồn quanh quẩn ở đây vì đã lạc lối trong ký ức quá khứ. Chúng ta qua đó xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870231
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870231,
					"content": "Các bạn cùng Ngài Os đi về phía trước...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741870232
					]
				},
				{
					"id": 741870232,
					"content": "Xin chào, Este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870233,
					"content": "Hửm? Xin chào, các người là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870234
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870234,
					"content": "Xem ra không phải người Remuria, không lẽ là man tộc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870235,
						741870236
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870235,
					"content": "Chỉ là một nhà lữ hành qua đường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870237,
					"content": "Đây là chiến trường, rất nguy hiểm. Dù các người là ai thì vẫn nên rời khỏi đây mau đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870238
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870238,
					"content": "Là tôi đây, Este. Lâu rồi không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870239
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870239,
					"content": "Ôi trời! Ngài Cassiodor! Ngài hiếm khi xuất hiện trong hình dạng như vậy đấy. Suýt nữa tôi đã không nhận ra ngài rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870240
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870240,
					"content": "Vậy hai vị này... Là thị vệ của ngài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870241,
						741870242
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870241,
					"content": "...Cứ cho là vậy đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870245
					]
				},
				{
					"id": 741870245,
					"content": "Nhưng mà, sao ngài Cassiodor lại ở đây? Không phải Sebastos đã phái ngài đi... Đáng ghét, sao tôi không nhớ ra được? Không lẽ tôi đang nằm mơ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870246
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870246,
					"content": "Xem ra đúng là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870247
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870247,
					"content": "Haha, ngài thật biết nói đùa đấy. Tôi thấy là Sebastos chắc lại giao nhiệm vụ bí mật gì đó cho ngài rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870248
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870248,
					"content": "Anh đoán không sai. Kể ra thì, mấy binh sĩ của Quân Đoàn IX kia tại sao lại canh giữ xiềng xích vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870249
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870249,
					"content": "Xiềng xích... Ngài đang nói về những kho báu đó sao? Có vẻ như họ đã cướp chúng trong trận chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870250
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870250,
					"content": "Tuy Sebastos coi chiến tranh là biện pháp không thể không dùng để đạt được nguyện vọng to lớn của chúng ta, nhưng từ lâu đã nghiêm cấm hành vi tàn bạo này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870251
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870251,
					"content": "Nên ngài cũng biết đấy, chuyện này đã trở nên khá bình thường rồi... Chúng ta đang trên con đường đi vào bóng tối, nhưng mọi người đều không nhận ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870252
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870252,
					"content": "Ngài Cassiodor, rốt cuộc đã xảy ra chuyện gì? Phobos vốn nên đem lại hạnh phúc cho chúng ta, nhưng bây giờ tôi chỉ cảm thấy đau khổ khó tả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870253
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870253,
					"content": "Tôi cũng đang tìm câu trả lời đây. Nhưng xem ra, chúng ta phải giải quyết rắc rối trước mắt đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870254
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870254,
					"content": "Ừm. Nhưng dù thế nào thì họ cũng là thành viên của quân đoàn chúng ta, vẫn nên cố gắng giải quyết bằng hòa bình thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741870242,
					"content": "Thật ra tôi mới là chủ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870243
					]
				},
				{
					"id": 741870243,
					"content": "...Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870244
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870244,
					"content": "#Ối, {NICKNAME}, đừng làm mọi chuyện trở nên phức tạp hơn nữa. Chúng tôi chỉ đùa thôi, Este, anh cứ nói tiếp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870236,
					"content": "Tôi cũng có thể trở nên khá man rợ đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870211,
					"content": "Là \"Đạo Bảo Đoàn\" đã gặp phải trước đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				}
			]
		},
		{
			"id": 7418706,
