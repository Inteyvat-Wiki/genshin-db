					"content": "Rốt cuộc đã xảy ra vấn đề gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870705,
					"content": "Nếu khi các người trở về có gặp được Sebastos thì hãy báo lại với ngài ấy về tình hình ở đây và những hoài nghi của chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
