				{
					"id": 741870904,
					"content": "Với lại, thay vì giao cho Phobos hay người chỉnh âm nào đó để đánh giá đúng sai, thì tin vào phán đoán của bản thân vẫn sẽ quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870905,
					"content": "Sebastos tạo ra Phobos là để chúng ta thoát khỏi sự nô dịch của số phận, nhưng nếu người dân cứ đi theo một cách mù quáng thì sẽ khiến chúng ta rơi vào cảnh nô dịch còn đáng sợ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870906,
					"content": "Trong tương lai có lẽ anh sẽ gặp lại sự lựa chọn như vậy. Tôi hy vọng anh có thể đưa ra quyết định đúng đắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870907,
					"content": "Ngài Cassiodor, sao ngài lại đột nhiên nói những điều này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870908,
					"content": "Nhưng tôi sẽ ghi nhớ, Este tôi đương nhiên sẽ kiên trì với chính nghĩa trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870909,
					"content": "Rất tốt. Vậy thì tạm biệt nhé, tôi nghĩ chúng ta sẽ còn gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
