			"dialogs": [
				{
					"id": 741870601,
					"content": "Khụ, các binh sĩ của Quân Đoàn IX!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "Hửm? Các người là ai? Không lẽ là trợ thủ mà Este tìm đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870603,
					"content": "Đúng là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "Không phải trợ thủ bình thường, mà là trợ thủ rất mạnh! Chúng tôi đi theo ngài Cassiodor đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "#(Xem ra {NICKNAME} và Paimon cũng có năng khiếu diễn kịch nhỉ.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870610,
					"content": "Ừm... Ngài Cassiodor... Tôi nghe nói Sebastos đã phái ngài ấy đến Aremorica, không lẽ về nhanh vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870611,
					"content": "Cái này... Thật ra con mèo đứng bên cạnh chúng tôi chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870613,
					"content": "Khụ, tóm lại thì chúng tôi đến để quan sát tình hình quân đoàn ở tiền tuyến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "Được thôi, tôi cũng đoán thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870615,
					"content": "Mặc dù chúng tôi không đi theo quân đoàn chính đến Pháo Đài Charybdis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870616,
					"content": "Nhưng thân là hậu phương, việc ở lại đây để \"dọn dẹp\" cũng xem như hợp tình hợp lý mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870617,
					"content": "Đây cũng là mệnh lệnh của Phobos sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Chuyện này... Phobos vốn nên chỉ dẫn cho mọi hành động của chúng tôi. Nhưng từ khi tới đây thì chúng tôi không thường hay nhận được giai điệu của Phobos nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870619,
					"content": "Cho nên, chúng tôi chỉ đành hành động theo chỉ thị của ngài Boethius thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870620,
					"content": "Tên vô lễ đó sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "Này, tên kia, dám bất kính với ngài Boethius sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870622,
					"content": "Thân là một người chỉnh âm cao quý, ngài Boethius làm mọi việc theo chỉ thị của Sebastos. Mệnh lệnh của ngài ấy cũng tương đương với Phobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870626,
					"content": "Có lẽ Phobos cũng phạm sai lầm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "Hai người có phải là người Remuria không đấy? Không lẽ hai người không biết Phobos được tạo ra bởi Sebastos toàn năng và nhà tiên tri hoàn hảo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870628,
					"content": "Nhưng các người cũng có nhận được giai điệu đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Ừm... Đúng là vậy. Nhưng ngoài Phobos ra thì chúng tôi còn có thể tin vào gì chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870630,
					"content": "Nếu chúng tôi đi sai đường thì sao Phobos có thể mặc kệ được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870623,
					"content": "Sebastos không khiến các người tàn sát người vô tội.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "Tàn sát người vô tội... Tuy trước khi chiến tranh bắt đầu thì mệnh lệnh của Sebastos là giúp đỡ những con người yếu đuối này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870625,
					"content": "Nhưng hành động của chúng tôi bây giờ đã được Phobos ngầm phê chuẩn, không lẽ điều luật của Phobos đi ngược lại với thánh ý của Sebastos sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Thủ Lĩnh"
				},
				{
					"id": 741870605,
					"content": "Chúng tôi là đặc phái viên do Sebastos phái đến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "Đặc phái viên là gì... À, đúng đó! Chúng tôi đến đây theo ngài Cassiodor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "Chúng tôi là thị vệ của Cassiodor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "Đúng vậy, chúng tôi là thị vệ của ngài Cassiodor đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
