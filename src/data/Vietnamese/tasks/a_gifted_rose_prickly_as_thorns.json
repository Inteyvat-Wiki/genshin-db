			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "Hai bạn nhỏ làm gì vậy, các cháu cũng đến đây xem để trêu cười lão già \"trồng đá\" này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040102,
					"content": "Ta vẫn ổn, không cần người trong làng bận tâm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040103,
					"content": "Ôi, đâu nhất thiết là vừa đến đã có thái độ thù địch như vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040104,
					"content": "Ông nhầm rồi, chúng cháu không phải người của Làng Aaru, cũng không phải tới để trêu cười.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040105,
					"content": "Chúng cháu chỉ đi ngang qua thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "Người đi đường à? Cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040110,
					"content": "Bình thường có vài người quen cũ sẽ tới chỗ ta, hết lòng khuyên ta từ bỏ khu vườn này đi mà chuyển về làng ở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040111,
					"content": "Còn có mấy thằng nhóc hư đốn, suốt ngày chạy đến chỗ ta nghịch ngợm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040112,
					"content": "Đây là lần đầu tiên ta thấy có người ăn mặc như hai cháu đấy, các cháu làm gì ở đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040113,
					"content": "Chúng cháu đang đi tìm người thân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "Đúng vậy, vì lý do này mà chúng cháu đã đi một đoạn đường rất xa, vừa đi tìm, vừa thám hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME} là một người rất có lòng chính nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040119,
					"content": "Chúng cháu sẽ không bao giờ làm mấy chuyện như bắt nạt người già neo đơn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040120,
					"content": "Cho nên ông không cần lo lắng, chúng cháu không phải người xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040121,
					"content": "Khụ khụ, phải xin lỗi hai bạn nhỏ quả thật là xấu hổ quá, nhưng ai bảo ta chưa rõ ngọn ngành mà đã phán xét chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040122,
					"content": "Hai bạn nhỏ, ông Affan đây xin lỗi các cháu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040123,
					"content": "Các cháu tuổi còn trẻ vậy mà đã tự nuôi sống bản thân rồi, khá lắm, giỏi hơn cả ta hồi còn trẻ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040124,
					"content": "Theo những gì các cháu vừa nói, nếu ta gặp phải rắc rối không giải quyết được, có phải cũng có thể nhờ các cháu giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040125,
					"content": "Ý ông là có việc muốn nhờ chúng cháu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040126,
					"content": "Ông gặp phải vấn đề gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "Ban đầu ta có hai khu vườn ươm, ở đây một khu, còn một khu ở phía tây ngôi làng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040128,
					"content": "Cũng do tuổi đã cao, một người không thể chăm sóc hết được, mấy ngày không đến xem, khu vườn bên kia đã bị thứ kỳ lạ màu đen phá hỏng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040129,
					"content": "Bên đó vô cùng nguy hiểm, vào đó xong suýt chút đã không ra được, làm ta sợ đến mức không sang đó thêm lần nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040130,
					"content": "Nguyện vọng lớn nhất của ta bây giờ chính là sửa sang đất ở vườn ươm, để tiện sau này trồng thêm hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040131,
					"content": "#Nghe có vẻ không quá phức tạp. Thế nào? {NICKNAME}, chúng ta có nhận lời ủy thác này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040132,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "Khu vườn ươm đó nằm ở phía tây ngôi làng, các cháu đừng đi lạc đường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040134,
					"content": "Chuyện nhỏ, ông cứ yên tâm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040116,
					"content": "Là nhà mạo hiểm đi khám phá thế giới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "Đúng vậy, chúng cháu đã vượt qua rất nhiều ngọn núi cao, băng qua những hồ nước rộng lớn để đến Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040118,
					"content": "Người ta nói sao nhỉ, chúng cháu là... ừm... nhà mạo hiểm với tấm lòng cao cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040107,
					"content": "Nghe nói ở đây có người đang trồng hoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "Đúng thế, ta trồng hoa chứ không phải trồng đá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040109,
					"content": "Vừa nãy ta cứ tưởng là... Ôi, xem cách ăn nói của ta kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "Hai cháu quay về rồi à? Tình trạng của khu vườn ươm đó thế nào, các cháu thấy nó còn cứu được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040402,
					"content": "Đã giải quyết xong rồi ạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "Giải thích cho ông Affan nghe về Tử Vực.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "Thì ra là như vậy, bảo sao đất đang tươi tốt tự dưng lại xuất hiện nhiều vật kỳ lạ màu đen như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040405,
					"content": "Được rồi, thế này thì ta có thể an tâm gieo hạt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040406,
					"content": "Đợi ba hạt giống này nảy mầm ra hoa kết thành hạt mới, rồi trồng tiếp ở đất bên đó, sau này sẽ có thể thấy loài hoa này nở ở khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040407,
					"content": "À, là những... những hòn đá hình thù kỳ quái này à? Chúng có thể nở hoa được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040408,
					"content": "Ông Affan à, ông mua cái này ở đâu vậy, coi chừng bị người ta lừa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040409,
					"content": "Hai bạn nhỏ này thật có lòng tốt, các cháu yên tâm, Mora cũng không mua được những hạt giống hoa này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040410,
					"content": "Ba hạt này đều là quỷ... khụ khụ... những hạt giống quý báu mà một người bạn để lại cho ta. Đương nhiên là sẽ khác với hạt giống hoa thông thường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040411,
					"content": "Càng nghe càng thấy lạ. Ông Affan, thứ ông trồng rốt cuộc là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040412,
					"content": "Haha, thứ ta trồng là sự giao phó của một người bạn, là nguyện vọng của người ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040413,
					"content": "Cách nói kỳ lạ quá, thứ đó có thể trồng được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040414,
					"content": "Bạn nhỏ, nói với cháu rồi cháu cũng không hiểu đâu, sau này có cơ hội lại tới đây xem nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040415,
					"content": "Đừng thấy nơi đây trống trải như vậy, sau này ba hạt giống trong vườn ươm này đều sẽ đâm chồi và nở hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040416,
					"content": "Sau này chúng sẽ mọc càng ngày càng nhiều. Haha, khi đó chắc hẳn sẽ rất đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040417,
					"content": "Được rồi được rồi, đã nói là nhờ các cháu giúp đỡ, nên ta cũng sẽ không kì kèo không trả thù lao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040418,
					"content": "Hai cháu cầm lấy đi, ta cũng không có gì nhiều, tất cả đều ở đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040419,
					"content": "Ôi, hoàn thành ủy thác, chạy nửa ngày trời bụng tôi hơi đói rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040420,
					"content": "Rõ ràng là chỉ có mình tôi chạy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "Tôi cũng nói chuyện với bạn suốt cả đoạn đường mà, nói chuyện cũng sẽ tiêu hao năng lượng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040422,
					"content": "#Đừng nhỏ nhen như vậy chứ {NICKNAME}, chúng ta lấy tiền đi mua ít đồ ngon tự khao bản thân được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040423,
					"content": "Mau xem xem thù lao có gì, đủ cho chúng ta ăn mấy bữa đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040424,
					"content": "Để tôi xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "Ồ, ngoài Mora thì phần lớn là thức ăn... như Cuốn Shawarma, Tahchin, và còn có rất nhiều rau xanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040426,
					"content": "Vậy thì nhiều quá rồi đấy. Chúng ta... có phải đã lấy tất cả thức ăn trong một ngày của ông Affan không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040427,
					"content": "Ông Affan một mình sống ở ngoài làng, chắc cũng không dễ dàng gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040428,
					"content": "Mora thì cũng đành, nhưng nếu thức ăn cũng đều cho chúng ta thì... ừm, cảm giác hơi nghiêm trọng rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040429,
					"content": "Hơn nữa, rõ ràng là hạt giống ông ấy trồng giống y hệt hòn đá, nhưng lại bảo rằng thứ mình trồng là... nguyện vọng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040430,
					"content": "Bạn nói xem, ông ấy có phải là vì ở một mình quá lâu nên bị ảo giác không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040431,
					"content": "Càng nghĩ càng không yên tâm, khi nào rảnh chúng ta đến thăm ông ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
