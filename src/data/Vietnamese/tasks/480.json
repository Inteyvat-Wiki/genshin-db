			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Đọc xong rồi, nhưng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "Quy định...không tài nào thuộc được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "A, bạn đến rồi. Đã đọc xong hướng dẫn bay lượn chưa? Nắm được hết quy định rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "Ồ, giọng điệu miễn cưỡng như vậy, tôi hiểu tôi hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "Hướng dẫn bay lượn cũng khô khan khó đọc, tôi cũng không đọc nổi... á, đừng nói với đội trưởng Jean là tôi nói như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "Vậy sao? Tôi thấy câu chuyện kể trong \"Hướng Dẫn Bay Lượn\" cũng rất thú vị đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "Câu chuyện thú vị? A... ý bạn là những vụ án điển hình ở phần phụ lục phía sau à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Có một số chỗ tôi cũng rất thích, thích nhất là chuyện dùng Slime Phong để bay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "Mượn sức gió khi Slime Phong bị đánh vỡ để bay lên, nghe nói có thế bay rất cao rất cao, thật muốn thử quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "Không phải cái này! Là câu chuyện một con chim nhỏ muốn học bay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "Í... A?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Đễ tôi xem... Haiz! Đây không phải chuyện ngụ ngôn hồi nhỏ tôi thích đọc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "Xin lỗi! Hôm qua tôi để nó chung với quyển hướng dẫn bay của đội Kỵ Sĩ, chắc là khi ra ngoài cầm nhầm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "Hai quyển này... có khả năng cầm nhầm được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Hì... chuyện đã vậy nói cái này, thì thật ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "Nhưng nguyên nhân cầm nhầm, có lẽ do trong lòng tôi nghĩ, quyển này mới là quyển sách dạy tôi biết bay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "\"Thứ quan trọng nhất không phải gió mạnh mà là dũng khí, là nó khiến các bạn trở thành những con chim đầu tiên trên thế giới\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Chính là câu nói này cho tôi dũng khi bay lượn, khiến tôi trở thành Kỵ Sĩ Trinh Thám, và Quán Quân Bay Lượn của Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "Được rồi được rồi, chúng ta không nói chuyện này nữa, mau bắt đầu thi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "Đừng gấp, chỉ cần phát huy khả năng bay lượn thường ngày của bạn là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "Tôi chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Theo <color=#00E1FFFF>tuyến đường đánh dấu</color> tôi đã làm sẵn, bay thẳng đến mục tiêu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
