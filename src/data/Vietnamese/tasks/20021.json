			"dialogs": [
				{
					"id": 200210101,
					"content": "Tại sao đã dùng Phong Chi Dực mà vẫn phải thi bằng bay lượn chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210102,
					"content": "Anh, anh từng thi bằng bay lượn chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210103,
					"content": "Anh không dùng Phong Chi Dực, cũng chưa từng thi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200210104,
					"content": "Cô phải thi bằng bay lượn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210105
					]
				},
				{
					"id": 200210105,
					"content": "Bởi vì Phong Chi Dực là đạo cụ cần có để mạo hiểm, nên tôi muốn tập luyện cách sử dụng Phong Chi Dực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210106,
					"content": "Nhưng tôi không ngờ rằng... lại còn có cả thứ gọi là bằng bay lượn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210107,
					"content": "Mặc dù tôi đã đăng ký thi rồi...nhưng tôi vẫn chưa thuộc một số kiến thức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210108,
					"content": "Nhà Lữ Hành, tôi nghe chị Amber nói bạn đã có bằng bay lượn, bạn có thể phụ đạo cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210109,
						200210113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210109,
					"content": "Amber sẽ gác thi cho cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210110
					]
				},
				{
					"id": 200210110,
					"content": "Không phải, tôi chỉ gặp chị Amber lúc đăng ký thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210111,
					"content": "Khi chị ấy giới thiệu với tôi về tình hình thi bằng bay lượn, chị ấy có nhắc đến bạn, chị ấy nói bạn thi rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210112,
					"content": "Vì vậy, tôi muốn hỏi bạn những câu hỏi về kỳ thi bằng bay lượn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210115,
					"content": "Vậy...tôi có ba vấn đề muốn hỏi bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210116,
					"content": "Ừm...vấn đề thứ nhất, khi bay, tối đa bao nhiêu người có thể dùng chung một Phong Chi Dực?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210113,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210114
					]
				},
				{
					"id": 200210114,
					"content": "Tuyệt quá! Vậy thì nhờ bạn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				}
			]
		},
