			"dialogs": [
				{
					"id": 10280601,
					"content": "Không ngờ chúng ta lại bị mắc kẹt ở nơi này. Khó khăn thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "Cho dù tôi học rộng hiểu nhiều, nhưng đó chỉ nằm trong lĩnh vực pháp luật. Tôi không biết cách để \"vượt ngục\" đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "Tôi đã hứa với bố mình rằng \"phải sống thật hạnh phúc vui vẻ\"... Hừm, ít ra thì tôi cũng không được chán nản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "Nghĩ tới điều tốt, đi tới nơi mới để mở mang tầm mắt, còn có thể đoàn tụ với bạn cũ, đó đều là chuyện tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "Ừm ừm... Đúng, chuyện tốt. Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
		{
