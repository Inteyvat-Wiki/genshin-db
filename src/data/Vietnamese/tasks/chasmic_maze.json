				"points": []
			},
			"dialogs": [
				{
					"id": 10280701,
					"content": "Tình hình bây giờ đang khá nghiêm trọng, tạm thời không tìm được lối ra. Chúng ta phải chuẩn bị tâm lý ở lại đây một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "May mà không thiếu vật tư. Trong đội ngũ chắp vá này cũng có những người giỏi xử lý khủng hoảng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280703,
					"content": "Mọi người tạm thời tự lo cho bản thân nhé, còn lại cứ để tôi nghĩ cách giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
