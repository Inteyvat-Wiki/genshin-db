			"dialogs": [
				{
					"id": 726640101,
					"content": "Ừm... xem ra cần sắp xếp thêm một đợt rương mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640102,
					"content": "Rương gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "Bạn là... Nhà Lữ Hành sao? Bạn cũng đến tham gia Lễ Trục Nguyệt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640104,
					"content": "Có thể xem là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "Vậy thật đúng lúc. Để chúc mừng Lễ Trục Nguyệt, Hiệp Hội Nhà Mạo Hiểm chúng tôi đang tổ chức hoạt động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640106,
					"content": "Sao nào, bạn muốn tìm hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640107,
					"content": "Cụ thể là hoạt động gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "Trong thời gian Lễ Trục Nguyệt, Hiệp Hội Nhà Mạo Hiểm chúng tôi đã bố trí một thứ gọi là Bùa Trục Nguyệt ở khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640111,
					"content": "Người tìm được Bùa Trục Nguyệt này, có thể đem chúng về hiệp hội để đổi phần thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640112,
					"content": "Ngoài ra, hiệp hội còn phái một số Nhà Mạo Hiểm, bố trí một số rương đặc biệt ở ngoại ô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640113,
					"content": "Bên trong số rương đặc biệt này, đều chứa đựng các loại bảo vật mà hiệp hội đặc biệt chuẩn bị đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640114,
					"content": "Ngoài hai hoạt động này, hiệp hội còn thiết lập một loạt thử thách độ khó cao cho những Nhà Mạo Hiểm muốn thử thách bản thân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640115,
					"content": "Cụ thể... thì là một loạt doanh trại ma vật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640116,
					"content": "Cái này có liên quan đến Lễ Trục Nguyệt sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "Ha ha ha, bạn... bạn đừng nói vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640119,
					"content": "Chỉ cần thảo phạt bọn Ma Vật đó, hiệp hội sẽ trao thù lao tương xứng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640120,
					"content": "Có gì khác với ủy thác bình thường không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "Làm ơn đi mà! Trong thời gian Lễ Trục Nguyệt, đa số Nhà Mạo Hiểm đều đi dự lễ, rất nhiều ủy thác đều không ai nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640122,
					"content": "Thế nào? Với thân thủ của bạn, dư sức đối phó bọn Ma Vật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640123,
					"content": "Được thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "Thù lao sẽ không khiến bạn thất vọng đâu, yên tâm đi Nhà Lữ Hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640126,
					"content": "Trong thời gian Lễ Trục Nguyệt, tôi sẽ luôn đợi ở đây, có vấn đề gì, bạn cứ đến hỏi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640127,
					"content": "Vậy thì nhờ bạn nhé, Nhà Lữ Hành. Hãy tận hưởng Lễ Trục Nguyệt nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640124,
					"content": "Chuẩn bị sẵn thù lao nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "Cái này không liên quan gì đến Lễ Trục Nguyệt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "Không phải lại là việc vặt hằng ngày chứ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "Không phải! Hoạt động lần này đều rất có tính mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "Linyang"
				}
			]
		}
	]
}