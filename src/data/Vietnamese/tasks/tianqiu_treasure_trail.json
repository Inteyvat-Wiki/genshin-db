					"nextDialogs": [
						718120208
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120208,
					"content": "Tôi cũng sẽ nhanh chóng sắp xếp người đến Tuần Ngọc Lăng để tìm hiểu kỹ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120209,
					"content": "Thật kỳ lạ... Đã tìm ở Tuần Ngọc Lăng mấy lần rồi, tại sao vẫn còn chỗ bị sót...",
