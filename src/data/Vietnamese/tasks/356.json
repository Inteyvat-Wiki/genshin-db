			"dialogs": [
				{
					"id": 3560401,
					"content": "Vậy, món quà chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560402,
					"content": "<color=#00E1FFFF>Phong Chi Dực</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560403,
					"content": "Kỵ Sĩ Trinh Thám nhờ vào nó để hành động trên không, người dân trong thành Mondstadt cũng rất thích dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560404,
					"content": "Tôi đặc biệt gọi bạn đến đây, chính là vì để bạn có thể cảm nhận được cái lợi của nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560405,
					"content": "Đây là ngữ khí đề xuất nhiệt tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560406,
					"content": "Vì \"Phong\" là linh hồn của Mondstadt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560407,
					"content": "Được rồi, mau đến thử tính năng của Phong Chi Dực đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560408,
					"content": "Tuy rằng cách dùng rất đơn giản, nhưng bạn nhất định phải nghe theo hướng dẫn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
