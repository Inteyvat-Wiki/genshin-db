			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132901,
					"content": "(Vết khắc cũ kỹ, người khắc đã viết...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132902
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790132902,
					"content": "\"Gió lớn quá, nên không dùng sổ tay nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132910
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790132910,
					"content": "\"Lên tới nơi phát hiện ra món Gà Nấu Hoa Ngọt vẫn còn hơi ấm, quả thật là kỳ tích!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132903
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790132903,
					"content": "\"Khoan nói đến việc ai đã để lại, nhưng biết được cả việc tôi muốn ăn Gà Nấu Hoa Ngọt, tuy cảm thấy hơi kỳ lạ, nhưng tôi vẫn rất lấy làm cảm kích.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132904
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790132904,
					"content": "\"Xin cảm ơn người đã để lại vết khắc, Gà Nấu Hoa Ngọt của bạn là món Gà Nấu Hoa Ngọt ngon nhất tôi từng được ăn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132905
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790132905,
					"content": "\"Cám ơn, tôi biết rằng núi tuyết nguy hiểm, cũng hiểu được bản thân mình... Nhưng tôi vẫn muốn đến núi tuyết.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132906
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790132906,
					"content": "\"Tôi đến núi tuyết, chắc dùng cả mạng sống này cũng chỉ có thể để lại lời nhắc nhở \"nơi đây có cạm bẫy\" mà thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132907
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790132907,
					"content": "\"Nhưng nếu như có người vì vậy mà tránh được nguy hiểm, bước được thêm một bước so với nơi mà tôi đến được. Đối với tôi mà nói, đó là chuyện còn hạnh phúc hơn được ăn Gà Nấu Hoa Ngọt nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132908
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790132908,
					"content": "\"Cám ơn bạn, người đã để lại vết khắc, chính vì núi tuyết nguy hiểm, cho nên mới có nhà mạo hiểm mà.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132909
					],
					"speakerTitle": "Vết Khắc"
				},
