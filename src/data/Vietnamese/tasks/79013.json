			},
			"dialogs": [
				{
					"id": 790132401,
					"content": "Anh ta đã thoát khỏi mật thất rồi này! Còn tự khoe là mình tỉ mỉ nữa chứ... rõ ràng là chúng ta cố ý để lại lời nhắn ở nơi dễ thấy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132410,
					"content": "Và còn nữa, người này rốt cuộc đem theo bên mình bao nhiêu quyển sổ tay thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132402,
					"content": "Haiz... Không ngờ anh ta bị giam trong mật thất mà vẫn không nghĩ đến chuyện quay về, vẫn dám đi mạo hiểm tiếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132403,
						790132404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132403,
					"content": "Do anh ấy đã giải quyết được mối nguy hiểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				},
				{
					"id": 790132405,
					"content": "Đúng ha, mật thất vốn dĩ là nơi anh ta bị kẹt lại, bây giờ đã biến thành một trong những khó khăn mà anh ta dễ dàng khắc phục được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132406,
					"content": "Có điều, di tích trên núi mà anh ta nói, ở trên hòn đảo bên ngoài hồ nước là đã nhìn thấy được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132407,
					"content": "Dù gì cũng đã qua lâu lắm rồi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132408
					]
				},
				{
					"id": 790132408,
					"content": "Không phải là đã sụp đổ rồi chìm xuống biển đó chứ... Cứ cảm thấy đã từng nhìn thấy kiến trúc tương tự như vậy ở trên mặt biển ở bên ngoài rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132409,
					"content": "Khi nào có thời gian chúng ta hãy đi xem thử vùng biển ở gần đây đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132404,
					"content": "Do anh ấy đã thoát khỏi mật thất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				}
