					"nextDialogs": [
						790131802
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790131802,
					"content": "\"Gió lớn quá, nên không dùng sổ tay nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790131803,
					"content": "\"Ở đây mặt trời mọc rất đẹp, vượt qua gian khổ đến được đây, cảm thấy vô cùng hài lòng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790131804,
					"content": "\"Không biết sau tôi, sẽ còn có người đến được đây để nhìn thấy cảnh sắc như vậy hay không đây.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790131805,
					"content": "\"...Nơi nguy hiểm này tôi cũng đã đến rồi, lần sau, đi Long Tích Tuyết Sơn thôi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "Vết Khắc"
				},
				{
					"id": 790131806,
					"content": "\"Nơi này thật tuyệt, đáng tiếc là không có Gà Nấu Hoa Ngọt...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
