				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "Hèn gì không thấy sổ tay đâu hết, hóa ra là anh ta đã khắc lời nhắn lên cột... Cái tên này đã đến được đây rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131902,
					"content": "Nhưng mà, anh ta lấy đâu ra sự tự tin đó vậy... Nếu không có chúng ta giúp đỡ thì anh ta đã bị kẹt trong mật thất di tích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131903,
					"content": "Anh ta đến núi tuyết nhất định sẽ bị đông thành \"Thịt Tươi Lạnh\" cho xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131904,
					"content": "\"Thịt Tươi Lạnh\" thì có hơi quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "Tôi, ý tôi là, anh ta đi đến núi tuyết thì nhất định sẽ gặp nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131908,
					"content": "Chúng ta phải nói cho anh ấy biết là không được đến núi tuyết mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131909,
					"content": "Vậy hãy để lại lời nhắn cho anh ta thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131910
					]
				},
				{
					"id": 790131910,
					"content": "Ừm ừm, tôi cũng nghĩ vậy... Đúng rồi, lần này chuẩn bị thêm một phần Gà Nấu Hoa Ngọt đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131911,
					"content": "Nói không chừng ăn Gà Nấu Hoa Ngọt rồi anh ấy sẽ nhớ về sự ấm áp của Mondstadt, sau đó sẽ không đến núi tuyết nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131912,
					"content": "Gà Nấu Hoa Ngọt sẽ hỏng mất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131913
					]
				},
				{
					"id": 790131913,
					"content": "Ừm... Chỉ là tấm lòng thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131906,
					"content": "Chắc chắn sẽ gặp nguy hiểm rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131907
					]
				},
				{
					"id": 790131907,
					"content": "Đúng thế, núi tuyết lạnh như vậy, còn có nhiều Hilichurl như thế, và còn có cả... Vua Heo Tuyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
