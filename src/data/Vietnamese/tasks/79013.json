					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "Vậy phải làm sao đây... Ừm, hay là chúng ta để lại lời nhắn cho anh ấy đi!",
					"roleType": "TALK_ROLE_NPC",
