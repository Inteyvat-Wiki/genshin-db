			"dialogs": [
				{
					"id": 790132601,
					"content": "May phước là anh ta không có đi vào nữa, thật nhẹ nhõm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132602,
					"content": "Nhưng không biết tại sao, khi thấy bộ dạng dương dương tự đắc của anh ta thì tôi lại thấy hơi quạu nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132603,
					"content": "Cứ thấy có hơi đắc ý một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132604
					]
				},
				{
					"id": 790132604,
					"content": "Nhưng di tích trên cao mà anh ta nói, chắc là bên cạnh di tích bị chìm xuống biển lần trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132605,
					"content": "Chúng ta đi xem thử đi... Thật không biết anh ta có thể an toàn leo đến nơi cao như vậy không...",
					"roleType": "TALK_ROLE_NPC",
