					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131603,
					"content": "Những thay đổi trong ảo cảnh sẽ không thể thay đổi được quá khứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "À... đúng vậy, cả Quần Đảo Táo Vàng đều bị thiết bị đó ảnh hưởng, nên Wolfgang mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131606,
					"content": "Cho nên tôi mới tưởng rằng Wolfgang đã được cứu ra khỏi mật thất... chứ thật ra đến sau cùng, anh ấy vẫn ở trong mật thất ban đầu không thể đi ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131607,
					"content": "Nhưng mà! Nhưng mà cái tên Wolfgang này cũng thật khiến người ta bực mình... Chúng ta giúp anh ta nhiều như vậy, vậy mà anh ta vẫn cảm thấy \"sập bẫy giùm người khác\" là hay lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131608,
					"content": "Anh ta không thể quý trọng sinh mạng của mình hơn được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131609,
					"content": "Mỗi người đều có thứ mà mình muốn theo đuổi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "Tôi hiểu rồi, tôi biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131612,
					"content": "Nhưng tôi vẫn cảm thấy họ nên có kết cục tốt hơn, ví dụ như quay về Mondstadt, trở thành nhà mạo hiểm vĩ đại... sau đó còn có thể đến quán ăn để chơi với mèo, tha hồ thưởng thức món Gà Nấu Hoa Ngọt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131613,
					"content": "Tại sao họ lại không thể có một kết cục tốt hơn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131610,
					"content": "Chính vì có họ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "\"Wolfgang\" không thể đến núi tuyết đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
