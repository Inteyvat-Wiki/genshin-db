					"content": "Chỉ có người đã nếm trải khổ cực thì mới rút được kinh nghiệm thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132505,
					"content": "#Kiến trúc dưới biển này... chắc là di tích trên núi ở hòn đảo bên hồ nước... {NICKNAME}, chúng ta đến hòn đảo trong hồ xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132503,
