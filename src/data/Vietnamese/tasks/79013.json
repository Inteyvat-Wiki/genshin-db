			"dialogs": [
				{
					"id": 790130201,
					"content": "Ừm, Gà Nấu Hoa Ngọt thật sự rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130202,
					"content": "Quả thật có thể hiểu được tại sao nhà mạo hiểm tên \"Wolfgang\" đó lại nhớ nhung đến vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130203,
					"content": "Nhưng lại bị nhốt ở đây, cả Gà Nấu Hoa Ngọt cũng không được ăn, thật đáng thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130204,
					"content": "Quyển sổ tay này đã rất cũ rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "#Đúng vậy... nhưng mà nói chứ... {NICKNAME}, còn nhớ chuyện chúng ta từ hồ nước trên đảo mà đi vào được một hòn đảo khác không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130217,
					"content": "Kiến trúc trên đảo trong hồ trông có vẻ hoàn chỉnh hơn nhiều so với bên ngoài hồ nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130218,
					"content": "Kiến trúc trên đảo hiện tại so với kiến trúc lúc ở đó, cứ giống y như di tích vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130219,
					"content": "Có lẽ nào kiến trúc trong hồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "Rất có thể! Nói không chừng kiến trúc trên đảo trong hồ chính là nguyên trạng ban đầu của di tích trên đảo bên ngoài hồ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}, có thể nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130223,
					"content": "Hòn đảo trong hồ, chính là hòn đảo trước đây sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "Đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130207,
					"content": "Hơn nữa... nếu như chúng ta tìm thấy được mật thất lúc trước ở đâu, vậy thì sẽ cứu được nhà mạo hiểm này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130208,
					"content": "Chuyện chỉ xảy ra trong ảo cảnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "Nhưng mà... cho dù tất cả có là giả thì nói không chừng nhà mạo hiểm này cũng không hề tồn tại, nhưng thấy anh ta đáng thương như vậy, giúp đỡ một chút cũng là chuyện nên làm mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130211,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130212,
					"content": "Quả thật, Paimon nói đúng lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "#Ừm! Tôi biết {NICKNAME} cũng sẽ cảm thấy như vậy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130216,
					"content": "Chúng ta đến hòn đảo trong hồ xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130214,
					"content": "Vậy thì đi xem thử thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "Ừm, nếu có thể giúp được nhà mạo hiểm tên Wolfgang đó thì tốt quá rồi!",
