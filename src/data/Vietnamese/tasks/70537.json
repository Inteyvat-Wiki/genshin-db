			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rương Gỗ Khả Nghi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371101,
					"content": "Nghiên cứu thử nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371102
					]
				},
				{
					"id": 705371102,
					"content": "Lời nhắn trên cái rương này... nghe thật đáng sợ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371103,
					"content": "Rõ ràng là vật nguy hiểm, nhưng lại bị đặt cạnh Hồ Rượu Trái Cây ư? Chẳng lẽ là đồ của hai vị kỵ sĩ bên kia sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371104,
					"content": "Trên đó có một khe hở lớn, có thể xem thử bên trong có gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371105,
					"content": "Để xem nào... Bên trong có nhét rất nhiều... trái bóng màu đỏ tròn, to hơn Quả Nhật Lạc khá nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371106,
					"content": "Đợi đã, chẳng lẽ là bom sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371107,
					"content": "Sao Đội Kỵ Sĩ lại để một rương bom bên hồ vậy? Chẳng lẽ là dùng để nổ... loài cá xâm nhập vào Hồ Rượu Trái Cây mà Lisa đã nhắc đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7053712,
			"completionStepIds": [
				7053701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
