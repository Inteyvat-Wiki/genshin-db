			"dialogs": [
				{
					"id": 705370101,
					"content": "Một chiếc rương gỗ khả nghi, khe hở trên nắp kẹp một tờ giấy ghi: \"Thiết bị của đội điều tra, hàng nguy hiểm cấp cao nhất. Hãy thận trọng\".",
					"roleType": "TALK_ROLE_NPC",
