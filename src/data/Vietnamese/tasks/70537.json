							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7053701",
							"2"
						],
						"stepId": 7053701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rương Gỗ Khả Nghi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705371201,
					"content": "Ôi! Là bom! Tôi muốn chơi nổ cá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371202
					]
				},
				{
					"id": 705371202,
					"content": "Sao đột nhiên hưng phấn vậy? Bây giờ còn chưa biết uy lực của chúng, lỡ làm hại người qua đường thì tiêu mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371203,
						705371204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371203,
					"content": "Dù sao cũng dùng để nổ cá, ném vào trong hồ nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371205
					]
				},
				{
					"id": 705371205,
					"content": "Hả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371206,
					"content": "Tôi cũng có chút háo hức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371207,
					"content": "Thường ngày chỉ toàn nghe Klee muốn nổ cá, đang nổ cá, đã nổ cá và cuối cùng là bị phạt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371208,
					"content": "Giờ có một rương bom đặt cạnh hồ thì cũng muốn được thử thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371209,
					"content": "Nếu chỉ ném một quả... chắc không sao đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371210,
						705371211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371210,
					"content": "Chúng ta mỗi người một quả nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371212
					]
				},
				{
					"id": 705371212,
					"content": "Cùng Paimon mở rương gỗ khả nghi, mỗi người lấy một quả bom, châm lửa và đếm ngược \"3, 2, 1\". Giật kíp nổ, cùng ném vào Hồ Rượu Trái Cây...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371213
					]
				},
				{
					"id": 705371213,
					"content": "Dưới nước truyền đến một tiếng nổ, hai cột nước văng lên, vài con cá văng ra...\\nBạn cùng Paimon nhìn nhau cười, rồi vui vẻ đập tay. Sau đó nhanh chóng thu thập thành quả và rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371214
					]
				},
				{
					"id": 705371214,
					"content": "Nhưng lần \"hành động âm thầm nổ cá do một phút bốc đồng\" dường như không thành công, có vẻ như vào giây phút bom nổ thì hai người đã bị bại lộ rồi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705371215
					]
				},
				{
					"id": 705371215,
					"content": "Aaaaaaahhhhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371216
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 705371216,
					"content": "Tai của tôi!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371217
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 705371217,
					"content": "Dọa chết tôi rồi! Sao rồi Phonia, không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371218
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Tiếng Hét Thất Thanh"
				},
				{
					"id": 705371218,
					"content": "Dưới nước đột nhiên phát nổ... thiếu chút là điếc cả tai rồi! Cái tiếng này, chắc chắn là bom của cô đó, Ematol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371219
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Giọng Nói Oán Giận Vô Cùng"
				},
				{
					"id": 705371219,
					"content": "Hả? Tôi luôn ở gần cô và không làm gì cả mà? Trong tay tôi làm gì có bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371220
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371220,
					"content": "Cô muốn trêu tôi, nên đã đặt bom hẹn giờ vào trong hồ đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371221
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Giọng Nói Oán Giận Vô Cùng"
				},
				{
					"id": 705371221,
					"content": "Nếu vậy thì tôi phải mang theo máy ảnh để chụp cảnh cô quỳ dưới đất, ôm đầu khóc thét mới phải. Dù sao thì cơ hội này cũng rất hiếm có mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371222
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371222,
					"content": "Hừ! Đừng hòng tôi giảm tiền thuê phòng tháng sau cho cô nữa! Còn chi phí nước, nội thất và cơm nước... thì cô phải bù lại hết cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371223
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Giọng Nói Oán Giận Vô Cùng"
				},
				{
					"id": 705371223,
					"content": "Đừng mà, tôi sai rồi! Phonia, người chị tốt của tôi! Cho dù mười mấy lần bày trò trước đó đều do tôi làm... Nhưng lúc nãy chắc chắn không phải do tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371224
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371224,
					"content": "Nếu tôi có thể làm ra mấy cái kíp nổ ngâm được nhiều giờ trong nước mà vẫn cực kỳ hiệu quả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371225
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371225,
					"content": "Vậy lần trước khi chúng ta gài bẫy Hilichurl, tôi đâu cần phải liều chết xông vào chỗ phục kích để tự kích nổ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371226
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371226,
					"content": "...Cũng đúng, đầu óc cô đơn giản như vậy, chắc không thể nghĩ đến việc dùng kíp nổ hẹn giờ để gài bẫy tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371227
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Giọng Nói Oán Giận Vô Cùng"
				},
				{
					"id": 705371227,
					"content": "Cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371228
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371228,
					"content": "Cô cũng lừa tôi mà! Chẳng phải cô từng nói, khi cô dùng bộ thiết bị thăm dò này, bất kì tiếng động lớn nào cũng sẽ ảnh hưởng đến thính lực của cô sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371229
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371229,
					"content": "Tôi thấy giờ cô cũng đâu có điếc đâu, còn cãi nhau hăng say với tôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371230
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371230,
					"content": "Cô chẳng hiểu gì cả! Tổn hại thính lực là tích lũy dần! Cô bây giờ lớn tiếng cãi nhau cũng sẽ tăng thêm mức tổn hại thính lực cho tôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371231
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Giọng Nói Oán Giận Vô Cùng"
				},
				{
					"id": 705371231,
					"content": "Nếu một ngày nào đó trong tương lai, tôi đột nhiên không phân biệt được âm thanh nữa thì tôi sẽ thất nghiệp mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371232
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Giọng Nói Oán Giận Vô Cùng"
				},
				{
					"id": 705371232,
					"content": "Đến lúc đó, cô cũng không còn nơi để ở nữa! Vì tôi sẽ để người ra giá cao hơn thuê cả căn nhà! Sau đó đi... đi... đi làm ngư dân! Tóm lại là tôi sẽ bỏ mặc cô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371233
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Giọng Nói Oán Giận Vô Cùng"
				},
				{
					"id": 705371233,
					"content": "Vậy, vậy tôi cãi nhau với cô nhỏ tiếng chút là được mà... Tôi sẽ nhỏ tiếng chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371234
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Hoảng Hốt"
				},
				{
					"id": 705371234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371235
					],
					"speakerTitle": "Ematol",
					"speakerSubtitle": "Giọng Nói Mơ Hồ"
				},
				{
					"id": 705371235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371236
					],
					"speakerTitle": "Phonia",
					"speakerSubtitle": "Giọng Nói Dần Yếu Ớt"
				},
				{
					"id": 705371236,
					"content": "Nghe không rõ bên đó nói gì rồi... họ chỉ lo cãi nhau thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371237,
						705371238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371237,
					"content": "Vui thật!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705371239
					]
				},
				{
					"id": 705371239,
					"content": "Vui quá đi! Ném thêm lần nữa nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371240,
					"content": "Không đúng, một lần là đủ rồi, ném thêm vài lần nữa thì họ sẽ qua đây điều tra đó. Chúng ta không được để bị tóm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705371241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705371241,
					"content": "Hình như chúng ta đã gây ra... một vấn đề không nhỏ nhỉ? Nhưng tôi đã hết tò mò về chuyện nổ bom rồi, thật mãn nguyện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
