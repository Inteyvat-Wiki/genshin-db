			"dialogs": [
				{
					"id": 721850201,
					"content": "Haiz, có món ăn mới lạ nào trên thế giới này có thể thỏa mãn vị giác của tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850202,
					"content": "Về pizza của \"Nhà Hàng Kiminami\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "Chiếc pizza đó hương vị đúng là không tồi, còn kết hợp không ít nguyên liệu bản địa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850204,
					"content": "Nhưng trước kia tôi cùng từng nếm Pizza Nấm Rơm Nướng chính hiệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850205,
					"content": "Tôi nhớ, loại pizza đó có Phô Mai, Bắp Cải Cuộn và Nấm Rơm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850206,
					"content": "Ha ha ha, cá nhân tôi nghĩ, món ăn ngoại quốc này, tốt nhất nên giữ nét đặc trưng của đất nước đó sẽ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matsumoto"
				}
			]
		},
