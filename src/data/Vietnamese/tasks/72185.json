						721850505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850505,
					"content": "Cảm ơn bạn, Nhà Lữ Hành, xin hãy nhận lấy những thứ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
