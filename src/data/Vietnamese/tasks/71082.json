			"trigger": {
				"objectNames": [
					"Tự Xưng \"Tang Wuchou\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "Ừm? Sao vậy, chẳng lẽ bạn lại bó tay trước trò đào báu vật của Lão Chou sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				},
				{
					"id": 710820102,
					"content": "Tôi nói rồi, cái trò đào báu vật của anh ta, <color=#00E1FFFF>đồ càng tốt thì xung quanh càng nhiều thùng thuốc nổ. Đồ càng dỏm, thì xung quanh càng an toàn.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				},
				{
					"id": 710820103,
					"content": "Hãy nhớ kỹ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tự Xưng \"Tang Wuchou\"",
					"Chú Hà",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "Cái tên dư đảng Đào Bảo Đoàn nhà người, hừ hừ... nếu không phải gần đây ta không có nấm để ăn, toàn thân không có sức lực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710820202,
					"content": "Thì ta đã đánh ngươi cho tàn phế từ lâu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710820203,
					"content": "Lão tặc kia, lên đây chỉ Lưu Ly ta trồng, Thanh Tâm của ta trồng, rồi nói đó là nấm, hái xong là bỏ vô miệng ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				},
				{
					"id": 710820204,
					"content": "Hừ hừ... Làm gì có, làm gì có chuyện đó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				},
				{
					"id": 710820205,
					"content": "A, Chú Hà, đại hiệp, sao hai người đánh nhau vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820206,
					"content": "Tôi, tôi đang đi tìm nấm. Nhưng họ không cho tôi xuống mỏ nữa, nên tôi chỉ tìm đến đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710820207,
					"content": "Khó khăn lắm mới phát hiện chỗ này có nấm, vừa mới đưa tay ra, thì mấy người này đã nhào đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710820208,
					"content": "#Ông ta dám xâm phạm lãnh địa tu luyện của truyền nhân Phái Cổ Hoa, hoa này ngoài tôi, còn có anh hùng {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				},
				{
					"id": 710820209,
					"content": "Và cả anh hùng Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820210,
					"content": "Và cả anh hùng Paimon, ngoài ba người chúng ta ra, làm sao cho phép người khác động vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				},
				{
					"id": 710820211,
					"content": "Dư đảng Đạo Bảo Đoàn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710820212,
					"content": "Lão tặc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				},
				{
					"id": 710820213,
					"content": "Thôi thôi được rồi, Chú Hà, Tang Wuchou đã rửa tay gác kiếm rồi, không còn là Đạo Bảo Đoàn nữa rồi, hơn nữa thứ anh ấy trồng là hoa, không phải nấm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820214,
					"content": "Hở? Thế sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710820215,
					"content": "Chú hãy nhìn kỹ xem, đây không phải Thanh Tâm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820216,
					"content": "Ấy, hình như là Thanh Tâm thật này, xem ra đầu óc vẫn còn hơi choáng váng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710820217,
					"content": "Còn có Tang Wuchou, anh còn đang suy nghĩ muốn mở vườn hoa Bách Hợp Lưu Ly siêu to khổng lồ sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820218,
					"content": "Haiz, nếu ở đây có một vườn Bách Hợp Lưu Ly rộng lớn, chẳng phải cũng là một cảnh đẹp sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				},
				{
					"id": 710820219,
					"content": "Đừng đánh nhau nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820220,
					"content": "Haiz, không có nấm, đi thôi đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710820221,
					"content": "Cái tên nhiều chuyện này cuối cùng cũng đi rồi, cuối cùng tôi cũng có thể nghiêm túc nghiên cứu việc trồng hoa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tự Xưng \"Tang Wuchou\""
				}
			]
		}
	]
}