						400661702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661702,
					"content": "Haha, xem như là một quy luật thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661703
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661703,
					"content": "Chúng ta lại bước vào mê cung trong ảo cảnh rồi, nhưng hình như lần này không giống với lần trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661704,
					"content": "Kể lại trải nghiệm lần này...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400661705
					]
				},
				{
					"id": 400661705,
					"content": "Không khí dần lãnh đạm, cả đồ trang trí cũng không còn lộng lẫy... Ừm, vốn dĩ là nên như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661706
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661706,
					"content": "Những gì mà mọi người thấy hẳn là lúc gia tộc Kaedehara đang suy tàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661707
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661707,
					"content": "Tuy nhiên, Kazuha trong ảo cảnh cũng giống như một cái bóng vậy, không giống với hiện giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400661708,
					"content": "Đúng vậy, bổn công chúa cũng đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400661709,
					"content": "So với Kazuha hiện tại, ảo ảnh đó có phần lạc lối và mang số phận nặng nề hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400661710,
					"content": "Quả thực có thể xem là mang một số phận nặng nề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400661711,
					"content": "Vậy có nghĩa là bây giờ tôi đã trưởng thành rồi. Xin lỗi vì đã để mọi người phải nhìn thấy một tôi lúc chưa trưởng thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661712
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661712,
					"content": "Bẵng đi một thời gian dài sau khi rời khỏi Inazuma, cuộc sống của tôi đầy thăng trầm. Nhưng cũng không phải chuyện xấu, nhờ đó mà tôi đã trầm tĩnh hơn trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661713
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661713,
					"content": "Giá mà tôi cũng nhìn thấy tôi trước đây thì tốt quá. Nếu cậu ấy nhìn thấy tôi thì sẽ hiểu rõ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661714
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661714,
					"content": "Đường đời còn dài, tôi còn phải đi thật xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
