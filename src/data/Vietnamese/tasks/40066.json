				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660301,
					"content": "Woa, không gian mới này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400660302,
					"content": "Cũng giống như lần trước, chỉ có Kazuha không có ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660303
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400660303,
					"content": "Được, chỗ này cứ giao lại cho chúng ta đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kageharu",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "...Tốt quá, vậy là được rồi. Kazuha, tới đúng lúc lắm, con thấy cha điêu khắc tảng đá này thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660602,
					"content": "Trông rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660603,
					"content": "Đây là cảnh núi non mà cha đã thấy trong sách. Các nước khác đều có rất nhiều ngọn núi nổi tiếng, cao hơn cả mây, cha muốn đến đó xem quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660604,
					"content": "Nếu cha muốn đi thì có thể xuất phát lúc nào cũng được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660605,
					"content": "Không thể nói như vậy được. Cha là gia chủ đương nhiệm của gia tộc, tuy nhà Kaedehara không còn được như xưa, nhưng những chuyện nên làm vẫn phải làm cho đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660606,
					"content": "Nhưng mà... cứ cố chấp hy sinh tất cả cho một gia tộc đang sa sút thế này, liệu có đáng không chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660607,
					"content": "Cha à, con... không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660608,
					"content": "...Kazuha, cha mong con nhớ rõ chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660609,
					"content": "Gia tộc tuy quan trọng, nhưng con người cũng không nên bị trói chặt vào nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660610,
					"content": "Nhà tồn tại là vì có người. Nếu chính bản thân chúng ta sống đau khổ thì nói gì đến chuyện khiến người thân hạnh phúc chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660611,
					"content": "Chuyện quá khứ đã ảnh hưởng rất nhiều đến gia tộc, nhưng nó không phải là gánh nặng để con cháu đời sau phải gánh trên lưng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660612,
					"content": "...Nếu có một ngày, con chán ghét cuộc sống buồn tẻ này, thì hãy buông bỏ hết tất cả và ra ngoài đi. Hãy nhớ, đừng để cuộc sống trói buộc con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660613,
					"content": "Dạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006611",
							"2"
						],
						"stepId": 4006611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kaedehara Kageharu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "Thứ lỗi cho con vì đã không thể lý giải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661102,
					"content": "Kazuha, con đã quên lời giao ước giữa cha con chúng ta rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661103,
					"content": "Cha muốn từ bỏ tất cả sao? Nhưng mà... dù cho cha có gặp khó khăn gian khổ đến đâu thì cũng có con bên cạnh mà. Không lẽ con không thể giúp được gì cho cha sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661104,
					"content": "Khi cha bằng tuổi con, cha đã có thể chia sẻ gánh nặng với ông nội. Là con vô dụng, con đã khiến cha thất vọng, con...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661105,
					"content": "Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661106,
					"content": "...Haiz, nếu con tự trách mình vì chuyện này thì chỉ chứng tỏ cha là một người thất bại mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661107,
					"content": "Nhà Kaedehara đã phải trả giá quá nhiều cho sai lầm trong quá khứ. Bắt đầu từ thời ông cố của con cho tới bây giờ, chúng ta vẫn chưa thực sự bước ra khỏi bóng ma quá khứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661108,
					"content": "Rèn đao là sự nghiệp của gia tộc chúng ta, nhưng con hãy nhớ, sự nghiệp gia tộc chưa chắc đã là tất cả của con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661109,
					"content": "Con thú bị thương nếu muốn thoát khỏi bẫy thì phải nhịn đau mà vứt đi cái chân đang mắc kẹt. Con thấy đây là tổn thất, nhưng nếu chúng ta không thoát khỏi bẫy thì hậu quả sẽ còn nguy hiểm đến tính mạng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661110,
					"content": "Đủ rồi Kazuha. Cha là gia chủ, nhưng không thể phục hưng lại gia tộc và cho con một cuộc sống cao quý. Con không trách cha là cha đã vui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661111,
					"content": "Nỗi đau trên người của mấy thế hệ... cứ để nó kết thúc vào hôm nay đi. Từ giờ trở đi, chúng ta sẽ buông bỏ gánh nặng để sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661112,
					"content": "Còn tiếng xấu vứt bỏ gia nghiệp thì cứ để cha mang là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
