					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661113,
					"content": "Cha... xin đừng vậy mà. Tiếng xấu như vậy đâu thể nào đổ hết lên người cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661114,
					"content": "Nếu như có ngày đó, con muốn cùng chia sẻ với cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661115,
					"content": "Cha cứ chờ con. Nhà Kaedehara sớm muộn gì cũng sẽ truyền đến tay con. Đến khi ấy, chính con sẽ xử lý những việc này.",
					"roleType": "TALK_ROLE_NPC",
