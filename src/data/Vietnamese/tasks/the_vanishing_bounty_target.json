			"dialogs": [
				{
					"id": 760440301,
					"content": "Treo thưởng của \"Soái Hạm\"... mới đây mà chỉ còn lại một mục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440302,
					"content": "#Nghe nói đều nhờ sự năng nổ của {NICKNAME} đấy. Nhưng xem ra cũng phải bó tay với mục treo thưởng cuối cùng này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440303,
					"content": "Dù sao thì cũng không có manh mối gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440304,
					"content": "À, treo thưởng không ghi, nhưng cũng chưa chắc là không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440305,
					"content": "Xem ra em có manh mối rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440306,
					"content": "Để em đi tìm Leszek hỏi thử xem, với thân phận dày dặn kinh nghiệm này, chắc sẽ hỏi ra được điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "Jahoda"
				},
				{
