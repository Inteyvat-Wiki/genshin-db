			"dialogs": [
				{
					"id": 760440101,
					"content": "Bảng truy nã của Soái Hạm có một nhiệm vụ rất khó, gần như không có manh mối gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440102,
					"content": "Trước đó em còn nghe nói hắn ta ở phía bắc Đảo Lempo gây thương tích cho người khác, giờ lại đột nhiên biến mất không tin tức gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440103,
					"content": "\"Chỉ cần đi qua đều sẽ để lại dấu vết.\" Dù có xóa hết thì vẫn sẽ có dấu vết mới xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440104,
					"content": "Hơn nữa, trong truy nã không ghi rõ, không có nghĩa là họ không có thông tin gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440105,
					"content": "Cũng đúng. Để em đi tìm Leszek hỏi thử xem, với thân phận dày dặn kinh nghiệm này, chắc sẽ hỏi ra được điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440106,
					"content": "Vậy thì giao cho em nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440107,
					"content": "Ừm, cứ yên tâm nhé sếp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
