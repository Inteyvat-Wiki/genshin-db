				]
			},
			"dialogs": [
				{
					"id": 760440201,
					"content": "Thông tin của mục tiêu truy nã đều ở trên bảng. Hỏi tôi cũng được, nhưng về tiền thưởng thì không thể thương lượng nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440202
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440202,
					"content": "Về mục tiêu treo thưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440203,
					"content": "Trên bảng có bốn mục tiêu, nhưng chỉ có ba manh mối. Bị tố cáo lừa đảo và truy nã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440204
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440204,
					"content": "...Dừng lại, dừng lại! Qua quýt với mấy thợ săn kho báu mới vào nghề thì cũng đành đi, nhưng lại đối xử với tôi như vậy hả? Biết thừa tôi muốn hỏi cái nào mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440205,
					"content": "Hội Đồng Bí Mật muốn can thiệp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440206
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440206,
					"content": "Vậy còn phải xem ý sếp đã. Ơ? Sao lại thành anh hỏi tôi rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440207,
					"content": "Hark \"Hàm Nứt\" đến giờ vẫn không rõ tung tích, chẳng lẽ không phải do manh mối mà các người cung cấp quá mơ hồ à? Tự xem đi, đến cả đặc điểm ngoại hình cũng không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440208
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440208,
					"content": "Nếu thợ săn kho báu nào đó mà đến cái này cũng không biết, thì chắc chắn không phải là đối thủ của Hark, tại sao phải để họ phí thời gian... lãng phí tính mạng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440209
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440209,
					"content": "Được rồi, ngoài vết sẹo đáng sợ trên cằm thì còn có đặc điểm gì khác không? Tốt nhất là đặc điểm mà người khác không biết ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440210,
					"content": "Người khác không biết à... Ý cô là ở trên người, ví dụ như dấu vết trên lưng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440211
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440211,
					"content": "Đúng rồi, là kiểu đấy đấy. Thế là có thật à! Nhưng sao anh biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440212
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440212,
					"content": "Tôi biết đâu. Có hay không tôi cũng không biết. Hơn nữa, cứ cho là có thật thì cô định kiểm tra thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440213
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440213,
					"content": "Nói vậy cũng đúng nhỉ... Haiz, thật sự không có tin độc quyền nào à? Nể tình chúng ta thân quen như thế, không thể tiết lộ chút xíu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440214,
					"content": "Hark sau khi để lộ bản tính ở Thị Trấn Nasha đã trốn đến vùng phía bắc Đảo Lempo để tiếp tục gây chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440215
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440215,
					"content": "Những chuyện này tôi biết rồi, lúc trước cũng nghe nói qua ít nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440216,
					"content": "Nhưng dạo này không phải hắn ta biệt tăm biệt tích rồi sao? Nếu như đi về phía bắc, ở Piramida còn đỡ, chứ nếu đến Snezhnograd thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440217
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440217,
					"content": "(Trời lạnh thế này, liệu tay mình chịu nổi không đây...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440218,
					"content": "Không, hắn vẫn ở Đảo Lempo, chỉ là không biết hắn trốn ở đâu. Đây là tin độc quyền đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440219
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440219,
					"content": "Hửm, làm sao anh chắc chắn được điều này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440220
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440220,
					"content": "Đó là bí mật kinh doanh rồi, muốn biết thì giá cả sẽ khác đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440221
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440221,
					"content": "Hừ, keo kiệt. Haiz, một người đàn ông cao to có vết sẹo dưới cằm, chỉ tính trên Đảo Lempo thôi thì cứ mười bước là sẽ gặp được một người như thế. Mình tìm kiểu gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440222
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440222,
					"content": "Vậy nể tình chúng ta thân quen như thế, cho cô một lời khuyên nhé. Đừng chỉ nhìn vào vết sẹo dưới cằm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440223
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440223,
					"content": "...Ý anh là hắn sẽ nghĩ cách che đi vết sẹo dưới cằm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440224
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440224,
					"content": "Có lý... Hắn ta được gọi là \"Hàm Nứt\" cũng vì vết sẹo đặc trưng đó. Ngược lại, nếu không có vết sẹo đó thì hắn ta sẽ không khác gì những người đàn ông cao lớn khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440225
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440225,
					"content": "Vậy thì chỉ cần tìm một người đàn ông cao to cố tình che cằm là được. Đây là manh mối mới, được rồi, nếu sau này có tiến triển gì sẽ đến tìm anh sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440226
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440226,
					"content": "Chờ tin vui của cô nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
