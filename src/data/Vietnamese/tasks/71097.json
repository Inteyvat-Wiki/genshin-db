			"dialogs": [
				{
					"id": 710970101,
					"content": "Hai vị đã tìm được Lão Thạch chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970102,
					"content": "Ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "Tính thêm lần này, tổng cộng là 9 viên \"Lão Thạch\", chắc là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970202,
					"content": "Có thể hoàn thành yêu cầu của Huy Sơn Đình nhanh như vậy... quả không hổ danh là các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970203,
					"content": "Chỉ là tiện chân mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970204,
					"content": "Là tiện tay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "À ừm! Thì ý của tôi là... tìm những thứ này dễ như trở bàn chân thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970206,
					"content": "Vừa bướng vừa sai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "Haha... Paimon nói đúng, chiến công của hai vị tôi cũng đã chứng kiến rồi, cho nên những chuyện nhỏ này chắc chắn không làm khó được hai vị đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970208,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "Kể ra thì, không thể ngờ là sau khi vào Tổng Vụ rồi mà cũng còn phải phụ trách công việc tìm \"Lão Thạch trong Vực Đá Sâu\" nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970211,
					"content": "Đúng nhỉ, trước đó anh nói là gây gổ với bố mình mỗi ngày mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970212,
					"content": "Tại sao sau này lại có thể vào được Tổng Vụ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970213,
					"content": "Trước đó tôi đã nói là có nợ một khoản lớn, hết đường lẩn trốn, lại không muốn về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970214,
					"content": "Kết quả là chủ nợ trực tiếp đến Thịnh Lộ Đình tìm bố tôi... Tôi nghe xong liền nghĩ quả này bố chắc chắn sẽ đánh gãy chân tôi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970215,
					"content": "Nhưng chân của anh vẫn còn nguyên kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970216,
					"content": "Đúng vậy... nói ra thì thật xấu hổ, bố tôi đã trả nợ cho tôi, và tìm được tôi đang lang thang trên đường, rồi nói: \"nợ của mày tao đã trả rồi, giờ mày chính thức nợ tiền của tao\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970217,
					"content": "Rồi ông ấy vịn vào đó để ép tôi làm việc trả nợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970218,
					"content": "Thì ra bây giờ anh đang nợ bố anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970219,
					"content": "Đúng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970220,
					"content": "Lúc đó tôi trốn nợ khắp nơi, lang thang mỗi ngày, nên sớm đã quyết định là nếu có cơ hội thì tôi sẽ quyết tâm làm lại từ đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970221,
					"content": "Nhưng không ngờ cơ hội này lại là của người bố hay gây gổ với tôi cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970222,
					"content": "Đó là lần đầu tiên bố không mắng chửi tôi nữa, mà thay vào đó là một buổi nói chuyện đàng hoàng... chuyện này đáng lẽ nên sớm xảy ra mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970223,
					"content": "Nhưng mà cho dù lúc đó ông ấy có lòng, thì tôi lúc đó cũng không có ý định nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970224,
					"content": "Xem ra bố anh đối xử với anh rất tốt đó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970225,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970226,
					"content": "Nên cho dù thế nào thì tôi cũng sẽ làm tốt công việc của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970227,
					"content": "Cho dù là việc chính ở Vực Đá Sâu, hay là giúp đỡ Huy Sơn Đình tìm \"Lão Thạch\" đi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970228,
					"content": "Lần này rõ ràng là do chúng tôi giúp mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "Có thể tìm được người giúp cũng là một cách để hoàn thành công việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970230,
					"content": "Nhưng lần này cũng may nhờ có hai vị nên công việc mới thuận lợi như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970231,
					"content": "Biết là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970209,
					"content": "Khó thì cũng có hơi khó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}