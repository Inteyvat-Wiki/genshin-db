				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "Là các bạn à. Đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330102,
					"content": "Tôi vừa khảo sát xong một vài địa điểm khả nghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330103,
					"content": "Trong đó có một doanh trại do con chó đội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330104,
					"content": "E hèm, do \"bóng đen\" kia canh giữ. Nếu không có vấn đề gì khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330105,
					"content": "Vụ \"điều tra\" đã nói hôm qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "Chuyện đó à, đến bây giờ tôi vẫn chưa biết gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330107,
					"content": "Ơ? Không phải Sango kêu anh đi điều tra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330108,
					"content": "Đúng vậy, nhưng mà...phải nói thế nào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330109,
					"content": "Ví dụ như, \"dưa tím chín rục\" và \"dấu tay bùn trên rèm cửa\", đối với tôi, là hai việc không hề liên quan đến nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330110,
					"content": "Nhưng với hội trưởng Sango thì nó có thể trở thành mấu chốt để mở khóa những bí ẩn phức tạp như \"yosegizaiku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330111,
					"content": "\"Dưa tím chín rục\" và \"dấu tay bùn trên rèm cửa\"...chúng có liên quan gì với nhau sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330112,
					"content": "Chỉ là ví dụ thôi. Tôi làm theo lời của cô ấy, điều tra một số nơi trên Đảo Yashiori và Rừng Chinju, rồi báo cáo những gì tôi nghe và nhìn thấy cho cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330113,
					"content": "Và cô ấy có thể rút ra kết luận gì từ báo cáo của tôi thì chỉ có mình cô ấy biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330114,
					"content": "Chỉ có anh Shikanoin mới có thể sánh ngang với tư duy của cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330115,
					"content": "Shikanoin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "Là người của Hiệp Hội Tenryou. Trong lần điều tra trước, tôi đã may mắn được gặp anh ta một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330117,
					"content": "Là một người... có khí chất đặc biệt. Nếu đã gặp thì chắc chắn vừa nhìn sẽ nhận ra ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330118,
					"content": "Tóm lại, bọn thú nhỏ nhờ cả vào bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330119,
					"content": "Tôi vẫn rất quan tâm đến vụ \"Dưa Tím chín rục\" đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003303",
							"2"
						],
						"stepId": 4003303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "Vất vả cho các bạn rồi! May quá! Lần này có lẽ đã đủ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330302,
					"content": "Hả? Sao vẫn còn thiếu mấy con nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330303,
					"content": "Hic, sao lại như thế. Cảm giác cứ như làm hoài còn hoài vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330304,
					"content": "Thật ra, đôi khi điều tra cần phải thật kiên nhẫn. Nếu không may đi sai hướng là xôi hỏng bỏng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330305,
					"content": "Ít nhất bây giờ chúng ta đã tìm lại được rất nhiều thú nhỏ, vì vậy có lẽ chúng ta đã đi đúng hướng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330306,
					"content": "Chỉ là có thể chúng ta đã bỏ sót một số manh mối hoặc không nghĩ đến một nơi nào đó, cho nên mới bế tắc. Nhưng tôi tin đây chỉ là tạm thời thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330307,
					"content": "Tôi hiểu rồi! Ý anh là chúng ta đang thiếu một chút cảm giác bùng nổ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330308,
					"content": "Cảm giác bùng nổ...cũng có thể nói như vậy. Và chúng ta tiến triển không hề chậm, vì may mà có Nhà Lữ Hành và Paimon, vì vậy đừng nản lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330309,
					"content": "(Nghe hiểu cả lời Paimon nói luôn...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "Hihi, tôi thấy anh nói rất có lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330312,
					"content": "Quá khen, chẳng qua là kinh nghiệm điều tra tích lũy được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330313,
					"content": "Bí mật chôn vùi càng lâu sẽ càng có giá trị nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330314,
					"content": "Chỉ tiếc là bây giờ cũng chưa có thông tin gì khác, hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330315,
					"content": "Vậy được rồi, tôi trở về báo cáo tình hình hiện tại cho hội trưởng Sango trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330316,
					"content": "Chắc chắn hội trưởng Sango sẽ có thể nghĩ ra điều gì đó mà chúng ta không nghĩ đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330317,
					"content": "Ừm! Anh nói rất có lý, nghe theo anh vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330318,
					"content": "Quyết định vậy nha. Vẫn như cũ, gặp nhau ở chỗ cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330319,
					"content": "Lỡ như tôi bận việc gì đó không đến được, các bạn cứ trực tiếp đến tìm hội trưởng Sango là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330310,
					"content": "(Ryuuji hiểu Paimon quá rồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
