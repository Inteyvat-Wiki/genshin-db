				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "Nhà Lữ Hành, bạn tới thật đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110102,
					"content": "Katheryne, xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110103,
					"content": "Phải, đã xảy ra một chuyện phải nhờ đến các nhà mạo hiểm ra tay giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110104,
					"content": "Có nhiệm vụ vô cùng quan trọng cần nhờ đến bạn, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110105,
					"content": "Wow... nghe có vẻ rất nghiêm trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110106,
					"content": "Không giấu gì bạn, đây cũng là lần đầu bọn tôi gặp chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110107,
					"content": "Trong hiệp hội bận đến tối mắt, nên phải nhờ vào những nhà mạo hiểm du hành bên ngoài đồng tâm hiệp lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110108,
					"content": "Rất sẵn lòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "Hãy chờ đã, an toàn trên hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110111,
					"content": "Katheryne! Hỡi thần dân của Vương Đô U Ám, chẳng lẽ ngươi đang thành kính gọi tôn danh của bổn công chúa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110112,
					"content": "A, tới rồi đây tới rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110113,
					"content": "Lại gặp nhau rồi, cô Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110114,
					"content": "A! Con quạ này biết nói?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110115,
					"content": "Ha ha, không cần phải ngạc nhiên vì chuyện nhỏ nhặt này đâu, bạn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110116,
					"content": "Bề tôi trung thành của ta, nhìn vẻ mặt lo âu của ngươi, chắc là bọn gian tà lại mưu đồ phá rối sự bình yên của Mondstadt đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110117,
					"content": "Nhà Lữ Hành, đây là Fischl, thành viên lâu năm của Hiệp Hội Nhà Mạo Hiểm Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110118,
					"content": "Fischl, Oz, đây là nhà lữ hành mà tôi từng nói đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110119,
					"content": "Ồ? Là ngươi sao? Hừ... thật tinh mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110120,
					"content": "Kỵ Sĩ Danh Dự Đội Kỵ Sĩ Tây Phong và người đồng hành Paimon. Ngưỡng mộ đã lâu, rất vui được gặp hai bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110121,
					"content": "Nhà Lữ Hành, ngươi cũng muốn chống lại Kết Tinh Hắc Ám nơi vực sâu vô biên kia à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110122,
					"content": "Chống lại... Hắc Ám gì? Hắc Ám gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110123,
					"content": "Katheryne, thứ vừa nói không phải cái này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "Thứ mà tiểu thư nói, chính là số <color=#00E1FFFF>thiên thạch</color> kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110126,
					"content": "Phía hiệp hội vẫn chưa xác định được nguyên nhân hình thành và tác dụng phụ của mưa thiên thạch. Vì vậy, chúng tôi hy vọng nhà mạo hiểm sẽ lập thành hai nhóm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110127,
					"content": "Nhà Lữ Hành, Fischl, hy vọng cả hai sẽ chăm sóc lẫn nhau, hành động với điều kiện giữ cho bản thân được an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110128,
					"content": "Hừ, nếu đó là thỉnh cầu của Katheryne trung thành, bổn công chúa đành phải cho phép thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110129,
					"content": "Hãy vui lên! Được bắt đầu cuộc hành trình với công chúa định tội Fischl, đó là niềm tự hào của cuộc đời ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110130,
					"content": "Đây là chủ nhân của tôi, công chúa Fischl đến từ Vương Đô U Ám. Tôi là quạ đêm của người, Oz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110131,
					"content": "Người, người có lai lịch không vừa đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110132,
					"content": "#Tôi là Paimon, {M#anh ấy}{F#cô ấy} là {NICKNAME}, mong được giúp đỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110133,
					"content": "Ngươi vừa nói, dị giới?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "Ừ, sau này bạn sẽ hiểu dần thôi... Chỉ cần đủ thân với Fischl thì sẽ hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110136,
					"content": "Chỉ là những kẻ lữ hành, chưa biết được sự vĩ đại của Vương Đô U Ám vô tận âu cũng là điều dễ đoán. Không sao, ta tha thứ cho ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110137,
					"content": "Tha thứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110138,
					"content": "Ý của cô ấy là \"xin chào\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110139,
					"content": "Hai người này từ nãy đến giờ cứ như hát bè vậy... Chủ nhân cứ tỏ vẻ thần bí, còn gia quyến lại hay phá đám, thật kỳ lạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110140,
					"content": "Chắc hai vị có rất nhiều câu hỏi, hay chúng ta vừa đi vừa nói nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110141,
					"content": "Ơ, chúng ta có phải đội hai người đâu, rõ ràng là đội bốn người mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110134,
					"content": "Vương Đô U Ám... Lần đầu tôi nghe nói tới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "Cảm ơn bạn đã nói với tôi, tôi lên đường ngay đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
