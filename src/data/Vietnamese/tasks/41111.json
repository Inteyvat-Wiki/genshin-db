			"dialogs": [
				{
					"id": 411111801,
					"content": "Như vậy thì gần như dọn sạch rồi, liệu có giúp được gì cho người dân Thanh Tuyền Trấn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111802,
					"content": "Thiên thạch chứa sức mạnh nguyên tố... Chính là thủ phạm của vụ này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111803
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111803,
					"content": "Thề với giao ước thánh, những thiên thạch này chính là nguồn gốc của ác mộng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111804
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111804,
					"content": "Quay lại thị trấn để xác nhận nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111805
					]
				},
				{
					"id": 411111805,
					"content": "Ừm!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
