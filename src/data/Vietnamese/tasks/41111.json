				{
					"id": 411111610,
					"content": "Tôi đã thử rồi. Anh ta có tỉnh dậy một lúc, nhưng lại ngủ ngay sau đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111611
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111611,
					"content": "Sau khi tỉnh lại, anh ta có tiết lộ thông tin gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111612,
					"content": "Anh ta nói anh ta mơ thấy mình đang ở trên núi, và cảm thấy rất lạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111613
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111613,
					"content": "Trên núi? Lạnh? Hừm...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111614,
					"content": "Chẳng lẽ là lời nguyền lạnh lẽo của ác ma núi tuyết... Thanh Tuyền Trấn được Tinh Linh Dòng Suối che chở, cuối cùng cũng trở thành vùng đất bị ác quỷ nhắm tới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111615
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111615,
					"content": "Đúng là tình huống khó khăn, nhưng không sao, chỉ cần do ta định tội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111616
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111616,
					"content": "Xin lỗi đã làm phiền các vị, bây giờ mọi người có rảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111617,
					"content": "Là ngài Draff! Đã xảy ra chuyện gì rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111618,
					"content": "...Thật khó mở lời quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111619,
					"content": "Ở <color=#00E1FFFF>sau núi</color> chỗ chúng tôi đây cũng có <color=#00E1FFFF>Thiên Thạch</color>, <color=#00E1FFFF>Allan</color> cứ đòi đến đó xem thử, cậu ấy đã đi một mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111620
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111620,
					"content": "Mọi người cũng thấy sự nguy hiểm của thiên thạch rồi đó, tôi lo cậu ấy sẽ gặp phải bất trắc, nên muốn nhờ các vị đi cùng tôi đến đón cậu ấy về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111621
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111621,
					"content": "Nguy hiểm như vậy, anh ta còn đi góp vui cho được à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111622,
					"content": "Phải! Chờ cậu ấy quay về, tôi phải mắng cậu ấy một trận nghiêm khắc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111623
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111623,
					"content": "Nói phải lắm, vậy bây giờ chúng ta đi tìm anh ta thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111117,
			"completionStepIds": [
				4111117
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111117",
							"2"
						],
						"stepId": 4111117,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111701,
					"content": "A! Tôi còn tưởng tôi sẽ chết ở đó chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111702
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 411111702,
					"content": "Nhóc con! Trong giai đoạn rắc rối này còn dám gây chuyện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111703
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111703,
					"content": "Con sai rồi, con sẽ không dám nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111704
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 411111704,
					"content": "Thành thật xin lỗi, tôi sẽ dạy dỗ cậu ấy thật tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111705
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111705,
					"content": "Lần sau đừng có chạy lung tung nữa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111706,
					"content": "Thiên thạch ở đằng kia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "Để tôi đi xem có gì... Ủa? Công chúa, <color=#00E1FFFF>Vision</color> của người đang <color=#00E1FFFF>chớp</color> kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111708,
					"content": "Hả? Lẽ nào lời nguyền lạnh lẽo đã nhận ra, năng lượng chảy trong Ngọc Vực Sâu, đang gõ vang bài ca đưa tiễn cho số phận của nó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111709,
					"content": "Chà, Vision sẽ có phản ứng với vật gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111710,
					"content": "Thế giới tĩnh mịch, trời sao thì thầm, lời nguyền ma quỷ, và cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111711,
					"content": "Cái gì vậy! Ngươi nói chuyện thực sự khó hiểu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111712,
					"content": "Thất lễ rồi, công chúa không quen với ngôn ngữ của người phàm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111713
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111713,
					"content": "Tức là phải nhờ ngươi dịch hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111714,
					"content": "Tôi sợ đây không phải là dịch, mà là truyền ý chỉ của công chúa. Tôi nghĩ môi trường xung quanh sẽ ảnh hưởng đến <color=#00E1FFFF>Vision</color>, e rằng chỉ có <color=#00E1FFFF>sức mạnh nguyên tố</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111715
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111715,
					"content": "Ừm, ngươi vất vả rồi, Oz. Người bị trần tục làm mờ mắt không bao giờ có thể giống như ngươi, nhanh chóng hiểu được ý tứ thật sự của bổn công chúa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111716
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111716,
					"content": "Trong thiên thạch có chứa sức mạnh nguyên tố? Vision phát sáng, là đang đáp lại lời gọi của sức mạnh nguyên tố sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111717,
						411111718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111717,
					"content": "Vision có thể đảo chiều để tìm kiếm sức mạnh nguyên tố không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "Cảm thấy... chắc cũng được? Hay chúng ta cứ thử xem liệu có thể dùng <color=#00E1FFFF>Vision</color> để tìm <color=#00E1FFFF>Mảnh Thiên Thạch</color>, xoá bỏ nguy cơ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111718,
					"content": "Lời gọi này sẽ xảy ra theo cả hai hướng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				}
			]
		},
