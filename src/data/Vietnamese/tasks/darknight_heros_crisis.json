			"dialogs": [
				{
					"id": 4650201,
					"content": "Lão gia Diluc! Hãy nghe tôi nói, lúc nãy ở Đội Kỵ Sĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650202,
					"content": "Là chiến thư của Giáo Đoàn Vực Sâu à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650203,
					"content": "Tôi đã biết rồi, cảm ơn hai người đã đến báo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650204,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650205,
					"content": "Mạng lưới tình báo của Tửu Trang Dawn không phải chỉ có tình báo về tình hình thương mại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650206,
					"content": "Vậy thì lão gia Diluc định như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650207,
					"content": "Ý của hai người thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650208,
					"content": "Nên liên thủ với Đội Kỵ Sĩ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "Vậy thì hợp ý bọn Giáo Đoàn Vực Sâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650210,
					"content": "Bọn họ nhìn ra tôi không hợp với Đội Kỵ Sĩ, muốn ép tôi xuất hiện trước bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650211,
					"content": "Một khi thân phận tôi bị bại lộ, hành động sau này khó tránh bị Đội Kỵ Sĩ can dự vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650212,
					"content": "Dù gì thì không có tổ chức nắm quyền nào, muốn để người ngoài \"thay mặt thực hiện chính nghĩa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650217,
					"content": "Um... lần này Giáo Đoàn Vực Sâu đúng là đưa ra một câu đố khó, những tên xảo quyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650218,
					"content": "Cách thì không phải không có, chỉ là cần phải có ưu thế về mặt thông tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650219,
					"content": "...Thông tin bị cố ý che đậy đi trong chiến thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650220,
					"content": "Cố ý che đậy? Anh nói đến những chỗ đọc không hiểu đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650221,
					"content": "Có lẽ chỉ có bọn họ mới đọc hiểu được, một loại ký hiệu lưu truyền nội bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650222,
					"content": "Chẳng lẽ \"chiến thư\" là để cho người của họ xem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "Cho nên đấy không chỉ là \"chiến thư\", mà còn là \"thông báo hành động\" của bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650225,
					"content": "Khi đứng ở hai phe đối lập, \"anh hùng\" trong mắt một bên chính là \"kẻ xấu\" trong mắt bên còn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650226,
					"content": "Không ngờ tôi đã làm \"kẻ xấu\" lâu như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650227,
					"content": "Giáo Đoàn Vực Sâu xem tôi là mục tiêu hành động, thì có thể tăng sức mạnh đoàn kết nội bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650228,
					"content": "...Ồ ồ... có phải những người anh hùng đều có đầu óc lợi hại như vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650229,
					"content": "Tôi chỉ là hiểu rõ bọn họ, cũng như tôi nói \"anh hùng\" cũng là \"kẻ xấu\" ở một góc nhìn khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650230,
					"content": "Nên những thông tin đọc không hiểu đó, chúng ta phải làm thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650231,
					"content": "Không hiểu thì đi hỏi, đơn giản mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650232,
					"content": "Tôi đã điều tra được một <color=#00E1FFFF>cứ điểm</color> của bọn họ... nếu có hứng thú thì đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650223,
					"content": "Nếu chúng ta đã không hiểu, vậy tại sao phải viết ra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "Ở lại trong tửu trang để tránh sóng gió?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "Vậy thì cũng có nghĩa là giao cho Đội Kỵ Sĩ giải quyết mọi việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650215,
					"content": "Nếu bọn họ đáng tin cậy, thì sự việc cũng không đến mức như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650216,
					"content": "Hơn nữa Diluc này cũng chưa đến mức phải trốn đi, để Đội Kỵ Sĩ thu dọn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				}
			]
		},
