			"dialogs": [
				{
					"id": 4650401,
					"content": "Không ngờ bị các người tìm đến đây... Đội Kỵ Sĩ đáng ghét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650402,
					"content": "Tôi không phải kỵ sĩ gì cả. Hãy thành thật đi, kế hoạch của các ngươi là gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650403,
					"content": "Hóa ra các người cũng đã đọc \"thư\" rồi... đừng hòng ta nói cho các người bí mật, khà khà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650404,
					"content": "Ngươi dường như không biết rõ hoàn cảnh của mình nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651001,
					"content": "Dùng <color=#00E1FFFF>Bàn Tay Lửa</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "Dùng tay làm vật trung gian để phóng ra lửa của Vision?... Nóng quá!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650601,
					"content": "Để ta xem ngươi cứng miệng được tới đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650405,
					"content": "Sử dụng <color=#00E1FFFF>\"Bàn Tay Lửa\"</color> lần nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "Dừng tay!... Xin ngài hãy dừng sự đau đớn này lại!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650406,
					"content": "Sử dụng <color=#00E1FFFF>\"Bàn Tay Lửa\"</color> lần nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "Khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4651403,
					"content": "Đừng có giả chết, mức độ ngọn lửa này còn chưa đến mức... Hở? Hình như <color=#00E1FFFF>ngất đi mất rồi</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651404,
					"content": "...Này, còn chưa đến giờ đi ngủ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651405,
					"content": "Á Á... Nóng quá!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650901,
					"content": "Tôi nói tôi nói! Khụ khụ khụ... Mau dừng lại, tôi <color=#00E1FFFF>sẽ nói hết</color>!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650902,
					"content": "Giáo đoàn... Giáo đoàn tập hợp tất cả sức mạnh thù hận Anh Hùng Bóng Đêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650903,
					"content": "Chuẩn bị 10 giờ tối mai tập kích thành Mondstadt từ <color=#00E1FFFF>cổng chính</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650904,
					"content": "Tôi chỉ biết đến đây thôi... Thật đấy, loại lửa này... tôi không thể chịu được nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Thẩm Vấn"
				},
				{
					"id": 4650905,
					"content": "Chỉ có vậy thôi sao? Hừ... thôi vậy, ta đoán ngươi cũng không dám giấu diếm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651201,
					"content": "Thử dùng <color=#00E1FFFF>Chất Vấn</color> để lấy thông tin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
		},
