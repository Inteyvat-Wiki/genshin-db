			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "Huffman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650102,
					"content": "Ồ, là hai vị à. Cảm ơn sự phối hợp của hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650103,
					"content": "Lần trước chúng ta nói về \"Anh Hùng Bóng Đêm\"... Cho hỏi có thêm thông tin gì có thể cung cấp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650104,
					"content": "Tôi có thể hỏi đã xảy ra việc gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "Nói cũng phải, trước khi hỏi cũng nên cung cấp một số thông tin cần thiết, tôi đã quên mất phép lịch sự của Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650108,
					"content": "Thật ra sự việc là như vầy... Hai vị xem cái này trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650109,
					"content": "Oa, nét chữ xấu quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650110,
					"content": "Ồ, xem kỹ thì... dường như có rất nhiều chỗ khó hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650111,
					"content": "Quả thực, mặc dù là \"tiếng phổ thông\", nhưng lại có nhiều chỗ viết trông như \"mật mã\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650112,
					"content": "Nhìn những chỗ có thể đọc ra chắc cũng hiểu được đại ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650119,
					"content": "Đây là, chiến thư Giáo Đoàn Vực Sâu gửi cho Anh Hùng Bóng Đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650113,
					"content": "Ý là Anh Hùng Bóng Đêm đã bị kẻ xấu dòm ngó rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650114,
					"content": "Nói vậy cũng đúng. Cho nên nếu có thể, chúng tôi hy vọng có thể bàn đối sách với anh ấy sớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650115,
					"content": "Dù gì đây cũng không phải là việc của một mình Anh Hùng Bóng Đêm, mà là việc của toàn thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650116,
					"content": "Cám ơn anh đã chia sẻ thông tin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "Ừm, nếu gần đây có phát hiện gì, hãy đến tìm tôi bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650117,
					"content": "Tôi sẽ chú ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "Xin lỗi, thật là không có thông tin gì thêm cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "Vậy sao... thật tiếc quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				}
			]
		},
