					"nextDialogs": [
						4650502
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650502,
					"content": "Đội Kỵ Sĩ định giải quyết việc \"chiến thư\" thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650503
					]
				},
				{
					"id": 4650503,
					"content": "A... là hai vị. Không giấu hai vị, quả thật có chút đau đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650504
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650504,
					"content": "#Lúc nãy trong cuộc họp đã quyết định phương án hành động lần này, {F#cô}{M#cậu} đoán xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650505,
						4650508
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650505,
					"content": "Kệ nó luôn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650506
					]
				},
				{
					"id": 4650506,
					"content": "#{F#Cô}{M#Cậu} đang nói đùa sao, Đội Kỵ Sĩ sẽ không bỏ mặc bất cứ nguy cơ nào ảnh hưởng đến sự an toàn của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650507
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650507,
					"content": "Nếu không sẽ có thêm nhiều người lựa chọn tin tưởng Anh Hùng Bóng Đêm, chứ không phải Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650511,
					"content": "Ồ, vậy kế hoạch của các anh là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650512,
					"content": "Điều tra thân phận thực sự của Anh Hùng Bóng Đêm, sau đó \"bảo vệ\" anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650513
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650513,
					"content": "\"Bảo vệ\"? Với thực lực của anh ấy còn cần Đội Kỵ Sĩ bảo vệ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650514,
					"content": "Suỵt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650515
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650515,
					"content": "Được rồi, nể tình hai vị đã từng giúp Đội Kỵ Sĩ... tôi sẽ nói thẳng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650516
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650516,
					"content": "Thật ra, \"bảo vệ\" thì chỉ là trên danh nghĩa, ý đồ thực sự là: Đội Kỵ Sĩ chuẩn bị tiếp nhận toàn bộ sự việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650517
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650517,
					"content": "Không để Anh Hùng Bóng Đêm ra tay sao? Tại sao lại như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650518,
					"content": "Đầu tiên là để chứng minh thực lực của Đội Kỵ Sĩ, cho người dân biết không có Anh Hùng Bóng Đêm, Đội Kỵ Sĩ cũng có thể giải quyết mọi việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650519
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650519,
					"content": "Hơn nữa Giáo Đoàn Vực Sâu lần này không có thiện ý, lỡ như Anh Hùng Bóng Đêm có gì bất trắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650520
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650520,
					"content": "...Vậy thì giống như giúp cho kẻ địch rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650521
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650521,
					"content": "Ồ... Đội Kỵ Sĩ cũng có nỗi khổ riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650522,
					"content": "Tuy là nói như vậy, nếu như không biết thân phận của Anh Hùng Bóng Đêm, mọi việc cũng không đi tới đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650523
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650523,
					"content": "Không cần khổ não như vậy, Huffman, làm theo tôi nói là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650524,
					"content": "Đội trưởng Kaeya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650525
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650525,
					"content": "Gần đây mỗi tối, lão gia Diluc đều pha chế rượu ở quán Quà Tặng Của Thiên Sứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650526,
					"content": "Anh chỉ cần phụ trách theo dõi anh ấy là được. Thế nào, có phải là một công việc nhẹ nhàng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650527,
					"content": "Không vấn đề gì. Chỉ là... ý của đội trưởng Kaeya là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650528
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650528,
					"content": "Anh Hùng Bóng Đêm chính là tiên sinh Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650529
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650529,
					"content": "Hử? Ai biết chứ, có thể chỉ là cảm giác của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650508,
					"content": "Bắt tay với Anh Hùng Bóng Đêm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650509
					]
				},
				{
					"id": 4650509,
					"content": "Không phải, họ nói như vậy thì giống như ủng hộ sự tồn tại của Anh Hùng Bóng Đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650510
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650510,
					"content": "Cách làm ủng hộ chủ nghĩa anh hùng cá nhân, ảnh hưởng tới quyền uy của Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				}
			]
		},
