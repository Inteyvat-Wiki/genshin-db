						740850235
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850235,
					"content": "Thứ màu tím, âm thầm tiến vào rễ. Thứ màu tím, âm thầm phá hoại rễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850236,
					"content": "Pahsiv, âm thầm quan sát. Pahsiv, âm thầm mài bia đá.",
