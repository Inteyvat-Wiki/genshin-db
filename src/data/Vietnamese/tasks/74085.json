			"dialogs": [
				{
					"id": 740850201,
					"content": "Chìa khóa, bức tượng, chìa khóa, bức tượng, chìa khóa, bức tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850202,
					"content": "Ý cô là đặt chìa khóa vào bức tượng đúng không? Được rồi, ba chìa khóa cho ba bức tượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850203,
					"content": "Chúng ta thử xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850204,
					"content": "Đặt xong chìa khóa sẽ có chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "Cửa mở, cửa mở...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850206,
					"content": "Cửa à? Ở đâu? Sau cánh cửa có gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850207,
					"content": "Rễ, Erinnyes, rất sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850208,
					"content": "Cánh cửa dẫn tới gốc rễ của Đảo Erinnyes à?! Pahsiv biết nhiều thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850209,
					"content": "Pahsiv, bảo vệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850210,
					"content": "Có điều gì chúng tôi cần biết nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "...Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850212,
					"content": "Ý là thông tin đó! Càng nhiều càng tốt, biết càng nhiều thì càng chắc ăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850213,
					"content": "Thông... tin? Thông... tin... Pahsiv! Thông tin, rất nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850214,
					"content": "Tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850215,
					"content": "Erinnyes, thông tin, rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850216,
					"content": "Ừm... Rất nhiều thông tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850217,
					"content": "Thông tin, mạch nước, rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850218,
					"content": "Ừm... Rất nhiều mạch nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850219,
					"content": "Mạch nước, vị khách đó, rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850220,
					"content": "Ừm... Hả?! Rất nhiều vị khách đó?! Đợi chút, tôi chưa hiểu... Đâu ra nhiều vị khách đó vậy? Vị khách đó biết phân thân à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850221,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850222,
					"content": "Mạch nước, vị khách đó, thưởng thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850223,
					"content": "Tà ác, vị khách đó, nhận thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850224,
					"content": "Thưởng thức tà ác trong mạch nước? Khẩu vị gì mà kỳ quái vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850225,
					"content": "Vị khách đó có thể cảm nhận thông tin trong mạch nước?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850227,
					"content": "Liễu rũ, thu thập. Đường sương, xử lý. Nước suối, gửi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850228,
					"content": "Rễ, mạch nước, trung tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850229,
					"content": "Đảo Erinnyes là trung tâm của thông tin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "Ý cô là toàn bộ Đảo Erinnyes là một hệ thống thông tin của vị khách đó sao? Người đó có thể thông qua nó để cảm nhận được những thứ tồi tệ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850231,
					"content": "#Paimon thông minh! {NICKNAME} thông minh! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850232,
					"content": "Chậc, vị khách đó rốt cuộc là nhân vật thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850233,
					"content": "Fontaine, vị khách đó, bảo vệ.",
