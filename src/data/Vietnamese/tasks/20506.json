					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "Thật thần kỳ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060202,
					"content": "Thuật giả kim chúng ta dùng bây giờ, đều chỉ là mô phỏng cách dùng của người cổ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060203,
					"content": "Người biết dùng Phong Chi Dực thì không cần biết nó được làm ra như thế nào, thuật giả kim cũng có đạo lý như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060204,
					"content": "Nhưng mỗi khi tôi cảm thấy mình gần tìm ra được một nguyên lý nào đó, thì nó lại lập tức khiến người khác bất ngờ, haizz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060205,
					"content": "Thuật giả kim còn được dùng làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "Nói thật là tôi cũng không hiểu, nhưng chính là không biết nên mới khiến người khác hiếu kỳ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060210,
					"content": "Có rất nhiều công thức thần kỳ tôi vẫn còn đang nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060211,
					"content": "Trên con đường phiêu lưu, bạn có thể thấy một số ghi chép về thuật giả kim do nền văn minh cổ đại để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060212,
					"content": "Khi hạng mạo hiểm tăng, công thức bạn có được cũng sẽ càng nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060213,
					"content": "Cám ơn bạn đã giải thích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "Không cần cảm ơn, đừng quên chia sẻ kiến thức và thành quả của bạn cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060218,
					"content": "Vậy thì, chúng ta gặp lại sau. Chúc con đường của các bạn luôn có gió thổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060215,
					"content": "Tới lúc đó có thể tạo ra Paimon rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "Còn suy nghĩ việc này, tôi có chỗ nào khiến bạn không vừa ý chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060217,
					"content": "Haha, hai bạn thật thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060207,
					"content": "Có thể tạo ra Paimon không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "Có một tôi còn không đủ sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060209,
					"content": "Hahaha, đáng tiếc hiện tại vẫn chưa làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
