			"dialogs": [
				{
					"id": 205060101,
					"content": "Xin chào, tôi là nhà nghiên cứu thuật giả kim Timaeus, chào mừng đến với Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060102,
					"content": "Thuật giả kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "Đây là một kỹ thuật được lưu truyền từ thời cổ đại, hiện chúng ta vẫn biết rất ít về nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060104,
					"content": "Quy tắc của nó thần bí và kỳ diệu, hoàn toàn khác với nguyên lý tạo ra vật thể mà chúng ta từng biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060105,
					"content": "Nếu có thể nắm vững kỹ thuật này, chúng ta chắc sẽ làm được nhiều thứ hay ho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060106,
					"content": "Cái thứ này là bệ dùng trong thuật giả kim à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060107,
					"content": "Đúng vậy. Phải rồi, hay là tự sử dụng thuật giả kim xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060108,
					"content": "Nghe có vẻ rất phức tạp, không vấn đề gì chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "Không sao, ít nhất thì thao tác cũng không phức tạp. Nếu bạn có hứng thú tôi có thể dạy cho bạn cơ bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060111,
					"content": "Ghép Giả Kim",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "Có bị nổ không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
