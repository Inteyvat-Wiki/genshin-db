					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "Ừm, động tĩnh lần này gây ra cũng khá lớn rồi, cộng với hành động của Amano và Andou trong thành nữa, tên trộm nhất định đã phát giác được thông tin này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350205,
					"content": "Việc này còn phải duy trì bao lâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Sẽ nhanh thôi, chỉ cần hội trưởng chuẩn bị xong thì chúng ta sẽ có thể khép lại vụ án này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350207,
					"content": "Phần thù lao này là của bạn, cảm ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350208,
					"content": "Đây là con số mà hội trưởng chỉ định, chắc là rất thích hợp, bạn nhận lấy nhé, phiền cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
