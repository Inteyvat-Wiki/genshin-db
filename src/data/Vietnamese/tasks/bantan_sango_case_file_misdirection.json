	"talks": [
		{
			"id": 2203501,
			"completionStepIds": [
				2203501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203501",
							"2"
						],
						"stepId": 2203501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "Nhà lữ hành, lại gặp mặt rồi. Lần trước cũng nhờ có bạn mà hội trưởng đã xác nhận được tên tội phạm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350102,
					"content": "Nhưng để tên đó sập bẫy hoàn toàn thì cần phải chuẩn bị thêm chút nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350103,
					"content": "Hội trưởng sẽ xử lý những việc khác, chúng ta cứ tiếp tục công việc trước đó vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350104,
					"content": "Phải tiếp tục đánh đuổi đám Đạo Bảo Đoàn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "Đúng vậy. Tuy là tên tội phạm đó có thể không liên quan đến đám Đạo Bảo Đoàn mà chúng ta sắp đối phó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350106,
					"content": "Nhưng đám Đạo Bảo Đoàn thường ngày cũng không làm chuyện gì tốt, nên để chúng tiếp tục \"giúp\" chúng ta vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350112,
					"content": "Hội trưởng đã ghi lại địa điểm cụ thể cho chúng ta rồi, chỉ ở ngoài thành không xa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350113,
					"content": "Còn ở trong thành thì...hội trưởng đã liên kết với Amano và Andou để phối hợp hành động rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350114,
					"content": "Vả lại...hội trưởng đã hứa với họ rằng họ sẽ nhận được tất cả công lao sau khi phá án. Cho nên họ rất hăng hái giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350115,
					"content": "Cứ để hội trưởng suy nghĩ kế hoạch vậy, chúng ta tiếp tục \"giao lưu\" với đám Đạo Bảo Đoàn là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350116,
					"content": "Tôi có ghi lại địa điểm trên bản đồ, chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350107,
					"content": "Phải tiếp tục hành hạ chúng đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "Đúng vậy, chúng ta phải tiếp tục để hắn nghĩ rằng mục tiêu của chúng ta vẫn là Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350109,
					"content": "Như vậy thì hội trưởng mới có đủ thời gian để hoàn thiện kế hoạch được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350110,
					"content": "Ha ha, dù sao thì đám Đạo Bảo Đoàn đó bình thường cũng không làm việc gì tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350111,
					"content": "Cho nên lần này để chúng tiếp tục \"giúp\" chúng ta vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2203502,
			"completionStepIds": [
				2203508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
