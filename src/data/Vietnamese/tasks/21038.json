				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "Cảm ơn bạn, Nhà Lữ Hành. Bức ảnh này là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380203,
					"content": "Haiz, cuối cùng cũng phải đi rồi. Mặc dù thường ngày nghe người ta nói \"nam nhi chí tại bốn phương\", \"đọc vạn cuốn sách không bằng đi vạn dặm đường\", tôi luôn cảm thấy tự hào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380204,
					"content": "Nhưng đến khi chính mình phải rời xa quê hương thì tôi lại không cảm thấy có chút tự hào nào, chỉ muốn ở lại đây thêm một chút nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380205,
					"content": "Nhà Lữ Hành, bạn nghĩ tôi sẽ thật sự tìm thấy thứ mình muốn trong chuyến đi này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380206,
					"content": "Tôi không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Haha... Nói cũng phải, rốt cuộc tôi muốn tìm thứ gì nhỉ? Ngay cả bản thân tôi cũng không biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380210,
					"content": "Được rồi, cũng sắp đến giờ rồi, tôi phải đi gặp vị thương nhân kia đây. Nhà Lữ Hành, mong bạn nhận lấy phần thù lao này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380211,
					"content": "Sư muội... vẫn chưa đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380208,
					"content": "Tùy thuộc vào anh thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Những gì bạn nói... gần như là \"vạn sự tùy duyên\" vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
