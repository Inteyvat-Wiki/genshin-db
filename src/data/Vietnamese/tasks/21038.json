			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "Nhà Lữ Hành, bạn tới rồi à, tôi còn tưởng hôm nay không chờ được bạn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380102,
					"content": "Hôm nay là ngày tôi rời khỏi Cảng Liyue, trước đây làm phiền bạn quá nhiều... tôi phải cảm ơn bạn một cách đàng hoàng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380104,
					"content": "E hèm... Vốn dĩ lúc nãy tôi chỉ đang nháp, nghĩ xem sau khi gặp bạn phải nói gì để cảm ơn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380105,
					"content": "Kết quả là bây giờ thật sự phải nói thì tôi lại quên sạch, để bạn chê cười rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380106,
					"content": "Không sao, sau này vẫn còn gặp lại mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "Thật sao? Hahaha, vậy thì quá tốt rồi, đến lúc đó tôi sẽ dẫn bạn đi khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380109,
					"content": "Đúng rồi, hôm nay tôi vẫn phải nhờ bạn giúp một việc cuối cùng. Tôi nhớ bạn có một chiếc máy ảnh đúng không? Tôi muốn nhờ bạn chụp giúp tôi một bức ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380110,
					"content": "Tôi nghe một thủy thủ nói, tốt nhất là nên lưu giữ một bức ảnh về quê hương của mình để làm kỷ niệm khi phiêu bạt bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380111,
					"content": "Nhưng tôi không có máy ảnh, nên đành phải nhờ bạn giúp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380112,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "Anh tạo dáng đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "Tạo, tạo dáng như thế nào bây giờ? Ôi, chủ yếu là chụp cảnh phía sau ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380107,
					"content": "Một thời gian nữa tôi sẽ đến Fontaine tìm anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
			"completionStepIds": [
				2103803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
