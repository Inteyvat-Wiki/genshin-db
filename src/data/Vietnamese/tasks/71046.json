			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "Xin dừng bước! Cấm địa Vực Đá Sâu, khách bên ngoài... A, là bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "Tiêu rồi, chạy mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Paimon, yên nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "Hahahaha... Xin lỗi đã làm các bạn sợ. Ơn cứu mạng tôi làm sao quên được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "Tôi cũng mới được điều qua gần đây thôi... Thật không ngờ có thể gặp được ân nhân, đúng là may mắn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "Ân nhân...? Chúng tôi từng làm chuyện tốt gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "Sao lại nói vậy chứ! Lúc mọi người đối phó với ma vật dưới biển, tôi cũng có mặt ở Quần Ngọc Các. Bị thương nhẹ, gần đây mới khỏe lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "Có thể bạn không có ấn tượng với tôi, nhưng tôi thì không thể nào quên được. Các huynh đệ kề vai sát cánh đều chứng kiến được những gì bạn đã làm cho Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "Về Vực Đá Sâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "Hai năm trước trong hầm mỏ đã xảy ra một việc không rõ nguyên nhân, nên Thất Tinh đã hạ lệnh đóng cửa. Các thợ mỏ cũng sơ tán an toàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "Chỉ có điều, tiếc quá, một hầm mỏ lớn như vậy mà lại ngừng sản xuất như thế. Các công nhân nhận trợ cấp rồi mạnh ai nấy tự làm ăn... Haiz, một đám người ly tán rồi, khó mà hội tụ lại được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "A, xin lỗi tôi nói nhiều quá. Tôi tin rằng bạn có việc quan trọng nên mới đến đây, tôi sẽ không ngăn cản bạn. Nếu có việc gì cứ trực tiếp đi tìm Muning đi, anh ta ở ngay doanh trại tại cổng vào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "Chẹp... Không phải không tin tưởng, chỉ là do chức trách. Nên tôi phải dặn dò một câu, đừng làm những điều phạm luật ở đây nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "Yên tâm đi, anh không tin tưởng chúng tôi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "Anh biết tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "Bị nhận ra rồi, chạy mau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
