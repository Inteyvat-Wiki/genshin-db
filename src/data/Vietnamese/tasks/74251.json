				]
			},
			"dialogs": [
				{
					"id": 742510101,
					"content": "Cảm ơn lời mời của tiểu thư Guillotin. Tôi nghĩ chắc hẳn là cô đã đặc biệt chuẩn bị số nước tinh khiết này cho buổi tiệc trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510102,
					"content": "Không có gì đâu. Ngài Neuvillette là thẩm phán tối cao của Fontaine, dù bận rộn vẫn dành thời gian đến uống... nước, là vinh dự của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510103,
					"content": "Tiểu thư Guillotin có công vụ nào liên quan đến Fatui cần bàn bạc với tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510104,
					"content": "Không, không liên quan đến Fatui đâu, lần này là chuyện riêng. Cũng không đến mức bàn bạc gì cả. Tôi chỉ muốn hỏi ngài về một người quen cũ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510105,
					"content": "Người quen cũ... Ồ, cô đang nói đến ngài Alain Guillotin phải không? Bậc Thầy Cơ Khí vĩ đại đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510106,
					"content": "Ừm, đúng vậy. Ông ấy từng là người như thế nào? Tôi nghe nói, hồi trẻ ông ấy cũng có thể xem là cấp dưới của ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510107,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510108,
					"content": "Ngài Guillotin là người chân thành, thực tế. Dù là sau khi được phong tước \"Bạch Kỵ Sĩ Hộ Quốc\" cũng chưa bao giờ tỏ ra kiêu ngạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510109,
					"content": "Phần lớn thời gian đều chìm đắm trong nghiên cứu cơ khí, không quan tâm đến chuyện bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510110,
					"content": "Hmm... Lúc trẻ cũng đã như vậy rồi sao? Chẳng biết đây là trưởng thành sớm hay là không hiểu chuyện đời nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510111,
					"content": "Nhưng mà... sau khi mất đi gia đình và bạn bè, ngài ấy đã thay đổi khá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510112,
					"content": "Tháp Mô Thức sao... Còn cả Elynas nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510113,
					"content": "Đúng vậy. Khi cùng tôi ký lệnh khám xét Tháp Mô Thức, ngài ấy trông rất... bất lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510114,
					"content": "Sự khác biệt và xa cách trong quá khứ đã dẫn đến tình cảnh hiện tại, chắc hẳn ông ấy cũng cảm thấy áy náy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510115,
					"content": "Ừm, sau đó ngài ấy càng ít nói. Chúng tôi cũng ít gặp nhau hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510116,
					"content": "Khi được phong làm \"Bậc Thầy Cơ Khí\", ngài ấy đã nói với mọi người dưới sân khấu một câu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510117,
					"content": "\"Sống tĩnh lặng và khiêm nhường, dễ dàng tìm thấy hạnh phúc hơn là một mực theo đuổi sự hoàn hảo vô tận.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510118,
					"content": "Hah... Cuối đời, ông ấy cũng đã thực sự làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510119,
					"content": "Tôi đoán, câu đó không chỉ là nói cho những người dưới sân khấu nghe, mà còn là nói cho chính bản thân ông ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510120,
					"content": "Tiểu thư Guillotin nghĩ sao về điều này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510121,
					"content": "Tôi ấy à? Hmm, tôi sẽ không đánh giá gì về sự giác ngộ hay lối sống của ông ấy, giống như ông ấy chưa bao giờ yêu cầu tôi phải sống theo kiểu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510122,
					"content": "Tôi cũng không định đi lại con đường cũ của ông ấy hay sống cuộc sống lý tưởng của ông ấy. Tôi có cuộc sống riêng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510123,
					"content": "Ha... Cảm ơn ngài đã giúp tôi hiểu hơn về ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510124,
					"content": "Không có gì đâu. Tôi cũng rất vui khi được chia sẻ những chuyện xưa với hậu duệ của ngài Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
