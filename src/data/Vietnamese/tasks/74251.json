			"dialogs": [
				{
					"id": 742510201,
					"content": "Thật vui khi được vừa thưởng thức nước vừa chia sẻ những chuyện xưa với tiểu thư Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 742510204,
					"content": "Được, vậy thì chúc may mắn thuận lợi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
