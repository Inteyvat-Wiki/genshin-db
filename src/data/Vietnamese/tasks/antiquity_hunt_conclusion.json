				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "Hả? Tìm được tất cả Mô Hình Văn Vật rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "Khá lắm! Bạn rất có tài năng khảo cổ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Phần quà này tặng cho bạn, cảm ơn bạn đã tham gia sự kiện của học viện chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "Hy vọng qua hoạt động này, bạn có thể cảm nhận được niềm vui khảo cổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "Mặc dù trong việc khảo cổ thật sự, phần lớn thời gian là nhàm chán và khó khăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "Nhưng cảm giác khi khai quật được văn vật có giá trị, sẽ lại cảm thấy mọi vất vả đều xứng đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "Vậy nếu không đào được thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Nếu không đào được... thì như tục ngữ đã nói, một chuyến đi \"công cốc\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "Hơn nữa, tình trạng công cốc đó mới là rất thường thấy, số lần đào được văn vật có giá trị thường rất ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "Nhưng làm công việc khảo cổ chính là tập làm quen với loại tình huống này, lúc nào cũng phải lạc quan, nếu không thì sẽ không trụ được bao lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "Cũng có lúc không đào được mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
