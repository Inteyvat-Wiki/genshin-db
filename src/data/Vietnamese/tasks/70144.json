						701440102
					]
				},
				{
					"id": 701440102,
					"content": "Sao rồi, điều tra ra kết quả gì chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440103,
					"content": "Có những phát hiện này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440104
					]
				},
				{
					"id": 701440104,
					"content": "Thứ này đã xuất hiện trong tuyết sơn khi nào vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440105,
					"content": "Cảm ơn bạn đã giúp đỡ điều tra, tôi sẽ báo lại chuyện này cho hiệp hội, còn đây là thù lao của bạn, vất vả cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7014402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
