			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440201,
					"content": "Có ủy thác gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440202
					]
				},
				{
					"id": 701440202,
					"content": "Ủy thác? Ừm, bạn đến đúng lúc lắm, tôi đang tìm một nhà mạo hiểm có nhiều kinh nghiệm để điều tra dòng khí lạnh kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440203,
					"content": "Dòng khí lạnh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440204
					]
				},
				{
					"id": 701440204,
					"content": "Là như vầy. Trước đó có một đội khảo sát đã đi vào đó, cũng có vài nhà mạo hiểm có kinh nghiệm đi theo. Lộ trình đi cũng rất an toàn, tránh được những khu vực nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440205,
					"content": "Nhưng mà không biết đã xảy ra chuyện gì, họ đã gặp phải dòng khí lạnh dữ đội, nên phải quay trở lại doanh trại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440206
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440206,
					"content": "Theo lời những nhà mạo hiểm đã trở về, trên con đường mà họ đi căn bản không thể xuất hiện dòng khí lạnh như vậy. Cho nên họ cho rằng dòng khí lạnh này không phải từ tự nhiên mà ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440207
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440207,
					"content": "Sau đó, có nhiều nhà mạo hiểm sau khi nhận được tin báo này liền tiến hành điều tra chuyên sâu, cuối cùng cũng xác minh được nguồn gốc của dòng khí lạnh đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440208
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440208,
					"content": "Nhưng mà sau nhiều lần điều tra như vậy, các nhà mạo hiểm trong đội đều đã kiệt sức, họ cần phải nghỉ ngơi. Cho nên chúng tôi tạm thời không có người để điều tra tiếp nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440209
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440209,
					"content": "Nhà Lữ Hành, nếu có thể thì bạn đi điều tra nguồn gốc của dòng khí lạnh giúp chúng tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440210,
						701440212
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440210,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440211
					]
				},
				{
					"id": 701440211,
					"content": "Vậy tôi trông cậy vào bạn nhé, dòng khí lạnh đó rất đáng ngờ, nhất định phải chuẩn bị cho kỹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440215,
					"content": "Vậy thì, bạn đi nhanh về nhanh nhé, nhờ cả vào bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440212,
					"content": "Về thù lao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440213
					]
				},
				{
					"id": 701440213,
					"content": "Chà? Bạn cũng thẳng thắn thật. Yên tâm nhé, hiệp hội sẽ không bạc đãi nhà mạo hiểm đâu, tôi sẽ chuẩn bị sẵn thù lao đợi bạn về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440214
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440214,
					"content": "Còn về phần thưởng cụ thể... thì cần phải xem kết quả của bạn để quyết định, bạn hiểu quy tắc mà phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "Iris"
				}
			]
		},
