			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "Có chút bản lãnh, không phải là kẻ vô dụng... cứ như vậy, tổn thất sẽ rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "Người Xử Lý Nợ"
				},
				{
					"id": 120030802,
					"content": "Chúng sắp không cầm cự được rồi, tiếp tục lên đi! Cướp Thạch Phách về đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030803,
					"content": "Fatui và ngươi vốn chỉ có mối quan hệ hợp tác làm ăn, ta không bảo ngươi đem người của ta đi đánh nhau, gây ra rắc rối này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "Người Xử Lý Nợ"
				},
				{
					"id": 120030804,
					"content": "Nói... nói cái gì? Đại nhân, tôi... tôi cũng là vì hoàn thành đơn hàng mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030805,
					"content": "Việc đơn hàng, tự mình nghĩ cách đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "Người Xử Lý Nợ"
				},
				{
					"id": 120030806,
					"content": "Đừng... đừng đi mà! Này! Này! Đại nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030807,
					"content": "Thiếu gia?! Tại sao ngài ở đây? Không bị thương chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030808,
					"content": "Có vị này giúp đỡ, thật may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030809,
					"content": "Thiếu gia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030810,
					"content": "Thiếu gia?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "Bạn, bạn chính là thiếu gia của Thương Hội Phi Vân?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030813,
					"content": "Tại hạ đi không đổi danh ngồi không đổi họ, ta là đệ tử phái Cổ Hoa, con thứ của chưởng quỹ Thương Hội Phi Vân, Xingqiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030814,
					"content": "Đáng chết, bị ngươi tính kế rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030815,
					"content": "Mậu Tài Công, cướp bóc đối với người làm kinh doanh mà nói thì thật quá mất mặt, hay là dùng kinh doanh để giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030816,
					"content": "Không có Thạch Phách này, Fatui sẽ làm gì ông, có cần tôi nói giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030817,
					"content": "Đáng ghét... nói đi, ngươi muốn sao mới chịu bán cho ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030818,
					"content": "Nếu ngươi đã muốn ép Thường Cửu Gia giảm 70%, vậy thì cứ tính thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030819,
					"content": "Gấp 3 lần giá thị trường, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030820,
					"content": "Ngươi ăn cướp! Ép người quá đáng! Ngươi... ngươi...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030821,
					"content": "La lối om sòm như vậy, mua hay là không mua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030822,
					"content": "Ta... haiz, được được được, ta đồng ý, ta đi gom tiền, được chưa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030823,
					"content": "Cám ơn quý khách đã đến Thương Hội Phi Vân, sau này hãy nhớ đến ủng hộ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030824,
					"content": "Ngươi ngươi ngươi... là thiếu gia của Thương Hội Phi Vân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030825,
					"content": "Mora mà chúng tôi dùng máy đếm tiền cũng đếm không hết, đều là từ trong kho tiền của bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030826,
					"content": "Chuyện nhỏ thôi. Đây là một vụ kiếm tiền chắc chắn thắng, còn có thể tiện tay dạy dỗ Mậu Tài Công, nhất cử lưỡng tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030827,
					"content": "Thật là người không thể nhìn vẻ bề ngoài.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "Quá khen quá khen, tấm lòng hiệp nghĩa của bạn cũng khiến người ta khâm phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030831,
					"content": "A! Lúc trước tôi toàn gọi hắn là tên mọt sách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030832,
					"content": "Tôi đọc được trong tiểu thuyết võ hiệp, thiếu gia có tiền nếu tức giận, sẽ thuê xã hội đen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030833,
					"content": "Làm sao đây? Làm sao đây? Xin lỗi! Xin lỗi! Thật sự rất xin lỗi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030834,
					"content": "Nếu bạn đã có thể bay, thì chân cũng không phải thứ cần thiết nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030835,
					"content": "#Huhu! {NICKNAME} giúp tôi với! Ánh mắt của hắn là làm thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030836,
					"content": "Rõ ràng là đang đùa giỡn với bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "Thôi không đùa nữa, lần này hai bạn đã giúp đỡ rất nhiều, thật sự cảm ơn hai bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030839,
					"content": "Quyển [Thần Tiêu Trảm Kích Lục] này cũng khiến tôi thấy rất vui, phiền các bạn giúp tôi trả cho Thường Cửu Gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030840,
					"content": "Lại kêu chúng tôi đi giúp việc?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "Vì thực ra tôi cũng không làm gì, không nên đi nhận sự cảm ơn. Mà hai vị vốn không liên quan gì đến việc này, lại giúp đến cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030842,
					"content": "Có thể kết giao với những người bạn có tấm lòng hiệp nghĩa như vậy, tại hạ cũng mãn nguyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030843,
					"content": "Thiếu gia, xin lỗi ngắt lời ngài, nhưng phía lão gia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030844,
					"content": "Về việc này, hãy chuyển lời đến bố tôi, lần này tôi đã giải quyết xong việc, còn kiếm được nhiều tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030845,
					"content": "Không biết có thể đổi chút công lao, đổi thêm vài ngày tự do? Thần Tiêu Trảm Kích Lục có nhắc đến một Bí Cảnh, tôi muốn đi tìm thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030846,
					"content": "Nói dễ nghe như vậy, thực ra là do bạn không muốn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030847,
					"content": "Hahaha, nếu như tôi nói, Thường Cửu Gia không những cảm ơn, mà còn có quà thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030848,
					"content": "Quà! Vậy... vậy còn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030849,
					"content": "Haiz, xem ra bất kể tôi nói cái gì, cũng không thể giữ được thiếu gia ngài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030850,
					"content": "Nên sớm nói Xingqiu là thiếu gia nhà bạn chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "Tôi... tôi cũng không nghĩ rằng các bạn không biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030852,
					"content": "Vậy thì việc trả sách phải nhờ hai vị rồi. Xingqiu xin cáo từ, có duyên chúng ta gặp lại trên giang hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030837,
					"content": "Bạn đọc có thật là tiểu thuyết võ hiệp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "Thiếu gia nhà giàu hiện nay đều không luyện chữ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "Hahaha, đừng nhắc đến nỗi khổ của tôi. Nhìn thấy chữ người nhà đều biết đó là tôi, cũng coi như một điểm đặc trưng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030811,
					"content": "...Quả nhiên là việc như vậy à.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
