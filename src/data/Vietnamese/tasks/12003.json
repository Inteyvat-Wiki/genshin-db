				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030401,
					"content": "Vở kịch hay cuối cùng không thể thiếu hai khán giả quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030402,
					"content": "Nói thì dễ, lúc chúng tôi đang chạy chỗ này chỗ kia, bạn đã làm gì hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030403,
					"content": "Cái này mà... Tất nhiên là có một khoảng thời gian tuyệt vời đọc hết cuốn [Thần Tiêu Trảm Kích Lục].",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030404,
					"content": "Thần Kích và Tà Kiếm, Mir và Weiyang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030405
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030405,
					"content": "5 cuốn đầu của câu chuyện có thể nói là \"tuyệt\" hoặc là \"hay\", thế nhưng đến cuốn thứ 6 lại không tìm được từ gì phù hợp để hình dung rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030426
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030426,
					"content": "Trên thế giới này, chỉ có người như vậy mới viết ra được kiệt tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030427
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030427,
					"content": "Có điều là chuyện này có quan hệ gì với Mậu Tài Công?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030406,
					"content": "Chỉ là than thở thôi. Xét cho cùng, \"nằm ngoài dự đoán\" là chuyện vô cùng hiếm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030407,
						120030409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030407,
					"content": "Sự việc đều bị bạn đoán được cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030408
					]
				},
				{
					"id": 120030408,
					"content": "Nhờ có sự giúp đỡ của bạn dự định của tôi mới được thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030411,
					"content": "Cái, cái gì? Này...bầu không khí này \"chỉ mình là không hiểu\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030412,
					"content": "Vậy... vậy tại sao bạn nói muốn xem kịch hay ở trong kho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030413,
					"content": "Thử nghĩ xem, Mậu Tài Công chạy khắp cảng Liyue cũng không mua được nửa miếng Thạch Phách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030414
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030414,
					"content": "Hắn sẽ lo lắng, không có nguyên liệu sẽ không thể hoàn thành giao dịch, không hoàn thành được giao dịch, thì sẽ đắc tội người Fatui",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030415,
					"content": "Trong sợ hãi hắn nghe thấy tên Thương Hội Phi Vân đột nhiên cuống cuồng nhớn nhác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030416,
					"content": "Mậu Tài Công có quyền có thế, chưa từng bị đối xử như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030417
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030417,
					"content": "Mặc kệ là muốn trút giận hay muốn giải quyết vấn đề, hắn ta đều phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030418
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030418,
					"content": "Hóa ra là các ngươi, các ngươi đang ra mặt giúp cho Thường Cửu Gia à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030419
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030419,
					"content": "Nhìn kìa, nói đến là đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030420,
					"content": "Ta đi một vòng, ở đâu cũng không mua được Thạch Phách, mới biết là Thương Hội Phi Vân đang thu gom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030421
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030421,
					"content": "Đây vốn không phải khoáng vật hiếm có gì, lại bị đứt hàng, các người cố tình đối đầu với ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030422
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030422,
					"content": "Không phải là đối đầu, chỉ là báo ơn. Giữa đường gặp chuyện bất bình rút đao tương trợ, đây là việc rất bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030423,
					"content": "Tôi nhớ là người của các ngươi nói mà, việc này sẽ không kết thúc ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030424
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030424,
					"content": "Hứ, thật là không biết tốt xấu, vậy ta cũng không phí lời nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030425
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030425,
					"content": "Đại nhân, nhờ người rồi, cướp hết tất cả Thạch Phách ở đây đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 120030409,
					"content": "Đoạn kết của sách có hay không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030410
					]
				},
				{
					"id": 120030410,
					"content": "Hay lắm... hy vọng kết quả ở đây cũng như mong đợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "Xingqiu"
				}
			]
		},
