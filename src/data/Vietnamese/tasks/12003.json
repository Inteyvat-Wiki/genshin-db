			"trigger": {
				"objectNames": [
					"Thường Cửu Gia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "Các bạn cuối cùng cũng đến! Sáng nay người của tiệm cầm đồ đã chủ động trả sách lại cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030902,
					"content": "Tất cả những việc này đều là do các bạn giúp phải không, thật là cảm ơn, rất cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030903,
					"content": "Đừng khách sáo, giúp được là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "Ái chà, đừng nói như vậy, việc này với tôi mà nói là việc trọng đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030906,
					"content": "Thường gia vốn cũng được xem là đại gia tộc Liyue, đáng tiếc lúc tôi làm thiếu đương gia, việc kinh doanh gặp nhiều khó khăn, thua lỗ tài sản của gia đình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030907,
					"content": "Tôi tích lũy nhiều năm, muốn chấn hưng lại gia tộc... việc bán lô Thạch Phách này, chính là toàn bộ hy vọng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030908,
					"content": "Nếu không phải các bạn, chắc là tôi đã bị chôn trong nơi thâm sâu cùng cốc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030909,
					"content": "Thật không ngờ bạn cũng là một \"Thiếu gia\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030910,
					"content": "Hử? Là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030911,
					"content": "A không có gì! Phải rồi, chúng tôi đến để trả sách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030912,
					"content": "Ồ ồ, Thần Tiêu Trảm Kích Lục! Tôi bảo sao cái thằng nhóc phái Cổ Hoa tự nhiên mất tích, còn tưởng là một tên trộm chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030913,
					"content": "Phái Cổ Hoa... bị người khác coi thường vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030914,
					"content": "Môn phái này có lịch sử mấy trăm năm, cũng từng có thời kỳ huy hoàng, nhưng hiện nay đã tuột dốc thê thảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030915,
					"content": "Muốn chấn hưng môn phải dựa vào những nhân tố mới, nhưng nếu cứ tiếp tục tuột dốc như thế, thì vĩnh viễn sẽ không thu hút được nhân tài mới, đây là một sự tuần hoàn ác độc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030916,
					"content": "Hiện nay những người trẻ của phái Cổ Hoa... giống như tên nhóc đó, nói là báo ơn, mà trách nhiệm lại kém xa các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030917,
					"content": "Cũng không đến nỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "Haiz, mặc kệ vậy. Phải rồi, các bạn đến tìm chương Liyue trong Hướng Dẫn Du Ngoạn Teyvat phải không! Tôi đã chuẩn bị sẵn cho các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030920,
					"content": "Tặng các bạn đó, không cần trả đâu. Ngoài ra, đại ơn khó mà báo đáp, còn có một món quà nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030921,
						120030922
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030921,
					"content": "Cám ơn, coi như không phí một lần đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030923,
					"content": "Khoáng đã bán rồi, sách bảo bối cũng về lại rồi, đây thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030924
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120030924,
					"content": "Í?",
					"roleType": "TALK_ROLE_NPC",
