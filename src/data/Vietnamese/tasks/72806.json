			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "Ấy? Nhà Lữ Hành, hôm nay bạn tới có việc gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 728060202,
					"content": "Về thư và quà của \"Nhà Xuất Bản Yae\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "Thư của \"Nhà Xuất Bản Yae\"? Không phải lại đến bảo tôi đổi bút danh chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 728060204,
					"content": "Tôi đã nói rồi, tôi lấy tên thật là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 728060205,
					"content": "Thôi, bỏ đi, tôi xem thử xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 728060206,
					"content": "Cuộc thi tiểu thuyết...Ban giám khảo, cái này... có lẽ tôi không có thời gian đi, nhưng vẫn cảm ơn ý tốt của họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 728060207,
					"content": "Ấy? Sao đằng sau còn nhiều vậy, đây là...đề xuất sáng tác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 728060208,
					"content": "Ơ, tôi, tôi sẽ xem cẩn thận, cảm ơn bạn, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
