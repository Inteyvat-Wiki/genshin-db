					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060705
					]
				},
				{
					"id": 728060705,
					"content": "Vậy thì tốt, vậy thì tốt. Haiz... đáng tiếc là hai tác giả đó đều ở Liyue xa xôi... Bình thường cũng chẳng có cách nào đi thăm hỏi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060706
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060706,
					"content": "Đặc biệt là quyển “Trầm Thu Thập Kiếm Lục” của tác giả Zhenyu còn không phải do chính anh ấy gửi đến, mà là được một thương gia mang về Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060707
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060707,
					"content": "Sau đó một biên tập của Nhà Xuất Bản Yae chúng tôi đã đọc được quyển sách ấy, cảm nhận được giá trị của nó, bèn muốn đích thân đến Liyue một chuyến để gặp \"Zhenyu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060708
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060708,
					"content": "Nhưng không ngờ... tình hình của Inazuma thay đổi, kế hoạch bị trì hoãn, thư gửi đi cũng chẳng có hồi âm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060709
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060709,
					"content": "Chúng tôi đành tự mình in và phát hành quyển sách này, ghi chép nhuận bút cho tác giả \"Zhenyu\", chờ sau khi có cách liên hệ sẽ trả anh ấy một thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060710
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060710,
					"content": "Haiz, tác giả \"Zhenyu\" nhất định phải tham gia cuộc thi lần này đó, nhuận bút... nhuận bút không thể chồng chất thêm nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
