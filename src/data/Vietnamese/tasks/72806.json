			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "Ừm...chỗ này viết không tồi, văn phong khá mới lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060402,
					"content": "Xingqiu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "Thì ra là vậy, thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060404,
					"content": "Xingqiu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#Ủa? Là bạn à, {NICKNAME}, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060406,
					"content": "Nghe tiếng bạn chào hỏi ban nãy, thấy bạn vẫn tràn đầy năng lượng, không tồi, không tồi...Tìm tôi có việc gì à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060407,
					"content": "Thực ra chúng tôi muốn hỏi bạn về một người, bạn đọc nhiều sách, chắc sẽ biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060408,
					"content": "Một người? Chắc không phải các bạn muốn tìm tác giả nào đó chứ? Ừm...cứ nói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060409,
					"content": "Về \"Zhenyu\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "\"Zhenyu\"? Bạn, bạn nghe thấy cái tên này ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060411,
					"content": "Trên quyển “Trầm Thu Thập Kiếm Lục” có viết kìa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "Chúng tôi đang tìm vị \"Zhenyu\" này, Nhà Xuất Bản Yae của Inazuma nhờ chúng tôi đưa cho tác giả này một bức thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060413,
					"content": "Bạn biết vị \"Zhenyu\" này rốt cuộc là ai không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060414,
					"content": "Ừm...\"Zhenyu\" này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060415,
					"content": "Thật xấu hổ, thực ra chính là...bút danh của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060416,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060417,
					"content": "Trước đây chưa từng nghe bạn nói qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "Chuyện này...chuyện này cũng không có gì đáng để nhắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060419,
					"content": "Hồi đó ở Liyue, biên tập phụ trách nói quyển sách mà tôi viết \"bối cảnh quá kỳ lạ, tình tiết cũ rích, sẽ không có người thích\", sau đó từ chối nhận tác phẩm của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060420,
					"content": "Tôi nghe xong thì...khụ, không phục lắm, bèn tự mình in ra mấy quyển, lén để vào Vạn Văn Tập, xem thử có người thích không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060421,
					"content": "Kết quả là chỉ có vài người lấy để đọc, tôi cũng không đặt nặng tâm huyết nữa. Nào ngờ quyển sách này lại được đánh giá cao như vậy ở Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060422,
					"content": "Nhưng dù sao, có người chịu xem sách mà tôi viết đương nhiên là chuyện tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060423,
					"content": "Tôi sẽ xem bức thư này cẩn thận, cảm ơn bạn, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				}
			]
		},
