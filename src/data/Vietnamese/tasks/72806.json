			},
			"dialogs": [
				{
					"id": 728060501,
					"content": "Ôi, cuối cùng bạn đã về rồi! Thế nào, đã gặp hai tác giả đó chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060502,
					"content": "Đã gửi thư hết cho họ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "Tốt quá rồi! Cảm ơn bạn, Nhà Lữ Hành, vậy hai vị đó nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060504,
					"content": "Họ nói sẽ đọc thư cẩn thận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Vậy thì tốt, vậy thì tốt. Haiz...đáng tiếc là hai tác giả đó đều ở Liyue xa xôi...Bình thường cũng chẳng có cách nào đi thăm hỏi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060506,
					"content": "Đặc biệt là quyển “Trầm Thu Thập Kiếm Lục” của tác giả Zhenyu còn không phải do chính anh ấy gửi đến, mà là được một thương gia mang về Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060507,
					"content": "Sau đó một biên tập của Nhà Xuất Bản Yae chúng tôi đã đọc được quyển sách ấy, cảm nhận được giá trị của nó, bèn muốn đích thân đến Liyue một chuyến để gặp \"Zhenyu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060508,
					"content": "Nhưng không ngờ...tình hình của Inazuma thay đổi, chúng tôi không thể phái người đi Liyue, thư gửi đi cũng chẳng có hồi âm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060509,
					"content": "Chúng tôi đành tự mình in và phát hành quyển sách này, ghi chép nhuận bút cho tác giả \"Zhenyu\", chờ sau khi có cách liên hệ sẽ trả anh ấy một thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060510,
					"content": "Nhưng đã lâu như vậy rồi, lượng sách bán ra của “Trầm Thu Thập Kiếm Lục” vẫn cao ngất, nhuận bút cũng ngày một nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060511,
					"content": "Haiz, tác giả \"Zhenyu\" nhất định phải tham gia cuộc thi lần này đó, nhuận bút...nhuận bút không thể chồng chất thêm nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
