			"dialogs": [
				{
					"id": 50130801,
					"content": "Ma vật ở Con Của Tiếng Vang đã bị tiêu diệt sạch sẽ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130802,
					"content": "Em cũng đã xử lý xong Khối U Vực Sâu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50130803,
					"content": "Bên phía Cư Dân Suối Nước cũng đã xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130804,
					"content": "Nguy hiểm của Chủ Nhân Gió Đêm cũng đã được giải quyết, chúng ta có cần đến Hội Hoa Vũ để giúp đỡ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50130805,
					"content": "Tình hình bên đó hình như khá nghiêm trọng, phải mau chóng đến đó mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50130806,
					"content": "Không cần đâu. Đã xử lý xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130807,
					"content": "Nhanh vậy sao?! Lúc nãy cô vẫn còn ở trong đấu trường mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130808,
					"content": "Ừm, tôi đã nhịn rất lâu để tìm ai đó mà đập cho một trận rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130809,
					"content": "À ừm, được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130810,
					"content": "Iansan, bên Cộng Đồng Trù Phú thì sao đây? Bộ tộc của cô cách đấu trường xa lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130811,
					"content": "À, không cần lo. Ban nãy Varesa đã liên lạc với tôi, bảo bên đó cũng đã giải quyết xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50130812,
					"content": "Xem ra tất cả đều không sao. Hình như Vực Sâu cũng yếu đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130813,
					"content": "Đúng đó, đám đấy chỉ biết cậy số lượng. Khi chúng ta có Thơ Hoàn Hồn thì tình thế đã đổi chiều rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130814,
					"content": "Đợi đã, hình như Vực Sâu đang triệu tập một đám ma vật để xông về phía đấu trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130815,
					"content": "Xem ra chúng cũng nhận ra Thơ Hoàn Hồn là rắc rối lớn nhất, nên chúng muốn phá hủy Lửa Thánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130816,
					"content": "Sao có thể để chúng đạt được mục đích chứ. Nào mọi người, tập trung đến đấu trường nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130817,
					"content": "Tôi thấy có Khối U Vực Sâu vừa mới rơi xuống, đều ở gần đấu trường cả. Chúng ta chia nhau ra xử lý đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130818,
					"content": "Ừm, còn cần có người canh giữ cổng lớn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130819,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "Được. Đây là trận chiến cuối cùng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		}
	]
