			"trigger": {
				"objectNames": [
					"Văn Tứ Gia",
					"Hoàng Tam Gia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "Haiz... Không ngờ Phái Cổ Hoa kế thừa truyền thống nghìn năm giờ lại rơi vào tình cảnh đi lừa gạt để kiếm cái ăn... Thật đáng xấu hổ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "Văn Tứ Gia"
				},
				{
					"id": 711092502,
					"content": "Chậc... Được rồi, huynh làm thế này cũng là không nỡ để sư đệ chết đói vì bảo vệ sư môn này đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "Hoàng Tam Gia"
				},
				{
					"id": 711092503,
					"content": "#Đệ cũng đừng làm ra vẻ mặt đó. Ngày nào cũng chán nản... Nhìn thấy {M#chàng trai}{F#cô gái} lúc nãy tích cực như vậy, đệ cũng khá hài lòng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "Hoàng Tam Gia"
				},
				{
					"id": 711092504,
					"content": "Tên ngốc đó sao? Vào trong dạo một vòng rồi làm cho huynh bữa cơm à? Vậy mà đệ còn hài lòng sao? Nếu đệ trẻ hơn vài tuổi thì đã một chưởng đánh chết huynh rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "Văn Tứ Gia"
				},
				{
					"id": 711092505,
					"content": "Này, có trẻ hơn vài tuổi đi nữa thì chưởng pháp của đệ cũng không bằng huynh đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "Hoàng Tam Gia"
				},
				{
					"id": 711092506,
					"content": "Được rồi, nghe đây... Chỉ còn lại vài lão già chúng ta thôi, nếu không đi thăm dò người có duyên như thế này... Không lẽ muốn những thứ trong Tàng Thư Các theo chúng ta vào quan tài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "Hoàng Tam Gia"
				},
				{
					"id": 711092507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "Văn Tứ Gia"
				},
				{
					"id": 711092508,
					"content": "Haha... Thôi, những lời xui xẻo khó nghe này đừng nói ra thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "Hoàng Tam Gia"
				},
				{
					"id": 711092509,
					"content": "Đúng rồi, hai đứa trẻ lúc nãy vừa làm cho huynh một món ngon, đệ ăn thử nhé? Haha, huynh thấy còn ngon hơn Vạn Dân Đường đấy! Nào, thử một miếng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hoàng Tam Gia"
				}
			]
		}
	]
}