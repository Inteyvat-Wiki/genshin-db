			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "\"Trời cao phản bội, hiếm ai có được phước lành để tâm. Vận mệnh vô thường, ít ai có được hưng thịnh vĩnh cửu... Người được trời cao để tâm đôi khi còn gặp phải chướng ngại, huống chi là kẻ bị trời cao ruồng bỏ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Chữ Khắc Trên Bia"
				},
				{
					"id": 711090502,
					"content": "\"...Bia đá này lập ra để hỏi thế hệ mai sau. Khi đến ngõ cụt thì bản thân nên làm gì?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Chữ Khắc Trên Bia"
				},
				{
					"id": 711090503,
					"content": "(Chạm vào bia đá.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "(Rời đi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7110906,
			"completionStepIds": [
				7110906
