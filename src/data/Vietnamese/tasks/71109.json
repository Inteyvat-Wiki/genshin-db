			"dialogs": [
				{
					"id": 711090201,
					"content": "Woa, không ngờ bên trong Sảnh Vương Sơn tàn tạ này lại ẩn chứa một nơi bí mật như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "Tôi cũng không ngờ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Mà Hoàng Tam Gia hình như cũng không biết có nơi này... Khoan đã, chẳng lẽ nơi này chính là kho báu Cổ Hoa trong truyền thuyết sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#Hơn nữa... {NICKNAME} nhìn kìa, hình như có thứ gì đó đang phát sáng trên bệ đá đằng kia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "Là kho báu đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Dù sao thì chúng ta cũng qua đó xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "Là cơ quan sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "Có lẽ đây chính là đừng nhìn mặt mà bắt hình dong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
