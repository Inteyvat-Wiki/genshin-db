				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "Hả? Trên thanh kiếm này hình như viết gì đó? Để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "\"Vuốt kiếm lòng hát ca, trả bằng máu chém rồng. Tia sáng như ánh điện, lưỡi băng phá núi cao...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Bia Khắc Cổ Kiếm"
				},
				{
					"id": 711090603,
					"content": "\"Chém hổ dưới Thiên Hoành, đâm giao long Vân Hải. Sau khi khải hoàn về, sống ung dung tự tại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Bia Khắc Cổ Kiếm"
				},
				{
					"id": 711090604,
					"content": "Hình như bên cạnh còn có một tấm bia đá... Này, chữ viết bên dưới có vẻ khác nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "\"...Ta muốn để lại đây một món ngon đậm đà gồm cá và thịt, nhưng nó sẽ bị thối theo thời gian. Nên ta để lại công thức ở đây, người đến sau có thể tự mình nấu. Thật tuyệt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Vết Khắc Cổ Xưa"
				},
				{
					"id": 711090606,
					"content": "\"...Nơi này không có gì khác ngoài thanh kiếm và khung cảnh này.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Vết Khắc Cổ Xưa"
				},
				{
					"id": 711090607,
					"content": "\"...Đi đến đường cùng thì phải làm sao? Đôi chân sẽ tự biết.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Vết Khắc Cổ Xưa"
				},
				{
					"id": 711090608,
					"content": "\"Không lấy... báu vật, chỉ để lại một... Từ nay về sau...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Vết Khắc Xiêu Vẹo"
				},
				{
					"id": 711090609,
					"content": "\"Hãy đọc ta... khi đang trong tuyệt vọng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Vết Khắc Xiêu Vẹo"
				},
				{
					"id": 711090610,
					"content": "Ôi... Những dòng sau viết nguệch ngoạc quá, không hiểu gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "Đại khái là người đó không mang gì đi cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "Ôi, cuối cùng cũng không tìm được báu vật vô giá nào, đúng là mong đợi vô ích mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "Đúng vậy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Nhưng không ngờ lại được nhìn thấy khung cảnh đẹp như vậy ở nơi thế này... Ít ra thì nó cũng đáng mà, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "Không sao, tôi sẽ nấu cho Paimon ăn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#Hả?! Thật sao! {NICKNAME}, nói phải giữ lời nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "Tôi cũng không thể hiểu nổi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
