			"dialogs": [
				{
					"id": 3061101,
					"content": "Chính là ở đây, một trong những phế tích của <color=#00E1FFFF>Đền Tứ Phong Thủ Hộ</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061102,
					"content": "Các ngôi đền này đã bị bỏ hoang rất nhiều năm rồi, người dân Mondstadt cũng không đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061103,
					"content": "Không chừng trong này còn có sào huyệt của dã thú, hoặc là doanh trại của người Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061104,
					"content": "Haiz... Cả Phong Ma Long, cũng từ bỏ đền của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061105,
					"content": "Bạn nói Phong Ma Long...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "...Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061108,
					"content": "Tuy rằng tôi cũng không muốn chấp nhận, nhưng... Phong Ma Long, cũng từng là một trong \"Tứ Phong Thủ Hộ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061109,
					"content": "Eh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3061110,
					"content": "Tạm thời không nói những chuyện này nữa. Bạn cảm nhận được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061111,
					"content": "Gió ở đây, có chút kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061112,
					"content": "#Đi vào xem đi, {NICKNAME}. Cần cẩn thận, sức mạnh của rồng đang ảnh hưởng đến chỗ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061106,
					"content": "Bạn nói \"Đền của mình\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
