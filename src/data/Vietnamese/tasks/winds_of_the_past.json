			"dialogs": [
				{
					"id": 3061001,
					"content": "Haizz... thật phiền phức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061002,
					"content": "Nhưng ít nhất bằng cách này, chúng ta cũng có thể chia sẻ một phần công việc với đội trưởng Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061003,
					"content": "Trước đây sức phòng ngự của chúng tôi, ít nhất còn có thể bảo vệ được sự an toàn trong thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061004,
					"content": "Nói một cách đơn giản thì là do có Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061005,
					"content": "Nhưng hiện nay Phong Ma Long đã tấn công thẳng vào trong thành Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061006,
					"content": "\"Gió đổi hướng rồi, chiến lược của chúng ta cũng phải thay đổi tương ứng với nó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061007,
					"content": "Nghe rất chi là triết lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "Đây là câu Lisa thích nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061010,
					"content": "Phải rồi, chủ đề về Tứ Phong Thủ Hộ chúng ta nói trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061011,
					"content": "Nếu muốn biết lịch sử lúc trước, có thể đi hỏi Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061012,
					"content": "...Nhưng nói trước, không phải do môn lịch sử tôi học không tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061013,
					"content": "Kho tàng kiến thức của người quản lý thư viện, thường thì... sẽ tốt hơn Kỵ Sĩ Trinh Thám một chút chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061008,
					"content": "Bạn tự sáng tác ra phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
		{
			"id": 30611,
