			"dialogs": [
				{
					"id": 230400401,
					"content": "Sao rồi, bạn đã xử lý hết lũ Kền Kền Đỏ đó rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400402,
					"content": "Đã giải quyết xong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "Vô cùng cảm ơn bạn, thế này thì có thể coi như Habachi được ăn một bữa bình thường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400405,
					"content": "Đúng rồi, phần thưởng này dành cho bạn, mời bạn nhận cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400406,
					"content": "Ừm, hôm nay có những món đồ gì cần nhập kho đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400403,
					"content": "Bọn chúng có lẽ sẽ tạm thời không dám ghé lại đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
