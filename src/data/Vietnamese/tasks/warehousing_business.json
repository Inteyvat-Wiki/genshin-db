					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "Ôi, Habachi lúc nào mới có thể được nghỉ một chút đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400502,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "Nhà Lữ Hành, bạn đến thật đúng lúc, nhờ bạn giúp chúng tôi một việc nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400504,
					"content": "Vừa rồi có một lô thực phẩm hong khô từ bên ngoài chuyển đến làng, Habachi đang chuẩn bị nhập kho lô hàng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400505,
					"content": "Nhưng một lũ Kền Kền Đỏ đã ngửi thấy mùi của đồ ăn, đột nhiên tụ tập thành đàn bổ nhào xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400506,
					"content": "Tuy các thủ vệ khác đã mau chóng chạy đến đánh đuổi lũ Kền Kền Đỏ này, nhưng lô thực phẩm hong khô vẫn bị chúng cấu rỉa vung vãi khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400507,
					"content": "Họ đã đi cảnh báo những đội vận chuyển hàng khác rồi, Habachi cũng đang bận rộn để thu lại chỗ thực phẩm còn dùng được... Nhà Lữ Hành, bạn có thể giúp đỡ chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400508,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Vậy phiền bạn rồi, lát nữa tôi còn phải hỗ trợ nhận hàng, thực sự làm không xuể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400510,
					"content": "Habachi vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "Haiz, tôi bảo anh ấy nghỉ ngơi một chút cũng không chịu, nói là sau khi thu thập xong thực phẩm, còn phải kiểm kê nhà kho một lượt. Cứ thế này thì sức khỏe của anh ấy sao mà đảm bảo được chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400512,
					"content": "Lô hàng hóa kia có lẽ ở khu vực quanh Thang Trắng... Nhà Lữ Hành, nhờ bạn giúp chúng tôi thu hồi lô hàng hóa đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
