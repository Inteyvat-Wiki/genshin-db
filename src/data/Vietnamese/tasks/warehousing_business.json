			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "Ấy... bọn Kền Kền Đỏ, thật sự hết cách mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "Xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "Bạn là... Nhà Lữ Hành, phải không? Tôi có nghe đứa nhỏ Ebeid nhắc đến bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "Haha, không ngờ lại có nhà lữ hành đến thăm ngôi làng này, tôi thật sự không ngờ tới đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "Ừm, bạn từng gặp Habachi chưa? Anh ấy vẫn luôn rất nghiêm túc... khi nói chuyện với bạn, nếu như anh ấy có chút nóng nảy thì cũng mong bạn bỏ qua nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "Dù gì thì... nhiều thứ đồ của làng chúng tôi đều được giữ trong nhà kho, không chỉ là lương thực, còn có quần áo, vũ khí, thậm chí là một chút tài sản nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "Trong làng chỉ có mấy người trẻ tuổi đó thôi, vừa phải bảo vệ làng, vừa phải giúp người trong làng xử lý các thể loại việc... Trước giờ cũng chỉ có mình Habachi canh giữ nhà kho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "Tôi ngoài việc ghi chép sổ sách và kiểm kê ra, cũng chẳng thể giúp được việc gì nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "Cô vừa nói Kền Kền Đỏ à...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "Ôi, đừng nhắc đến nữa, dạo trước vừa có một lô thịt khô chuyển vào nhà kho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "Không biết mùi hương thoát ra từ chỗ nào nữa, năm lần bảy lượt có mấy con Kền Kền Đỏ bay đến, dừng ở trên núi cạnh nhà kho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "Bọn chúng không thể moi được thịt khô trong nhà kho, nhưng chỉ cần có người dùng bữa trước mặt chúng thì lũ Kền Kền Đỏ này sẽ bất ngờ bay xuống tấn công ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "Thủ vệ trong làng không rảnh đi giải quyết chúng, anh Habachi cũng không thể đi được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "Nhà Lữ Hành, nếu bạn rảnh, có thể giúp chúng tôi giải quyết lũ Kền Kền Đỏ đó được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Vậy thì nhờ bạn rồi, lũ Kền Kền Đỏ kia rất hung hãn, tốt nhất không nên lại gần... nếu như bạn biết dùng cung tên thì có lẽ sẽ giải quyết chúng một cách an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "Bọn chúng từng tập kích gì rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Hàng hóa đi ngang qua, thịt phơi khô, và cả hộp cơm của Habachi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "Khi Habachi dùng bữa trong lúc gác sẽ có thói quen để đồ ăn sang một bên, lũ Kền Kền Đỏ thường nhắm đúng cơ hội đó để bay xuống cuỗm hết thịt đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "Bởi vì còn phải đứng gác nên anh ấy không thể đi dạy cho lũ Kền Kền Đỏ đó một bài học được. Chỉ có thể nhìn bọn chúng bay đi, sau đó nhanh chóng dùng bữa với chỗ đồ ăn còn lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "Nhờ bạn nhé, Nhà Lữ Hành, hãy mau chóng giải quyết lũ Kền Kền Đỏ kia nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
