			"dialogs": [
				{
					"id": 120370501,
					"content": "Xin chào, anh có biết Kazuha đang ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370502,
					"content": "Các bạn cũng tới tìm Kazuha sao, xem ra đúng là cậu ấy đã làm ra chuyện gì đó ghê gớm lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370503,
					"content": "\"Cũng\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "Hahaha, lần này chúng tôi đi thuyền nhỏ đến đây để bổ sung hàng. Ai ngờ vừa tới cảng thì có rất nhiều người Inazuma ùa tới hỏi thăm về chuyện của Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370505,
					"content": "Trong trận chiến ở Bờ Nazuchi tôi thấy chị đại cũng xuất sắc lắm mà, nhưng có thấy chị đại nổi tiếng như thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370506,
					"content": "Kazuha trong đội thuyền có hơi chìm, thỉnh thoảng còn không nghe lời chị đại nữa, nhưng chị ấy chẳng thèm để ý, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370507,
					"content": "Hóa ra anh còn không biết Kazuha đã làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370508,
					"content": "Có nghe loáng thoáng, hình như là chặn được \"Lưỡi Đao Vô Tưởng\" của Raiden Shogun gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370509,
					"content": "Cái đó lợi hại lắm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370510,
					"content": "Giống như lần Beidou chém chết Hải Sơn ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "À, nói thế thì tôi hiểu rồi. Hahaha, vậy Kazuha được mến mộ vậy cũng là chuyện thường tình thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370512,
					"content": "Ban nãy Kazuha đã bị người của Hiệp Hội Tenryou gọi đi rồi, bảo là có chuyện quan trọng cần bàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370513,
					"content": "Lúc đầu tôi còn tưởng là tới bắt người cơ, nhưng mà thái độ của bọn họ rất thân thiện, cảm giác như cậu ta rất được tôn trọng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370514,
					"content": "Nếu là trước đây thì đúng là không thể nào tưởng tượng ra nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370515,
					"content": "Hiệp Hội Tenryou chắc cũng muốn tỏ thái độ thân thiện nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "Cảm ơn anh, chúng tôi sẽ đến Hiệp Hội Tenryou xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370518,
					"content": "Ừm, vậy tôi ở đây đối phó với đám người hiếu kỳ này tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370516,
					"content": "Dẫu sao thì thái độ của Raiden Shogun cũng đã thay đổi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
			"completionStepIds": [
				1203706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203706",
							"2"
						],
						"stepId": 1203706,
						"stateName": "QUEST_STATE_UNFINISHED"
