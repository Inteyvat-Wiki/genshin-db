			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#Ồ? Là bạn à, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370602,
					"content": "Chào các bạn, chúng tôi đang nói về chuyện hủy bỏ lệnh \"Truy Lùng Vision\". Nếu các bạn đã tới thì cùng nghe đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370603,
					"content": "Lần này tôi mời Kaedehara Kazuha tới là để bày tỏ tình hữu nghị của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370604,
					"content": "Chính nhờ sự cố gắng của các bạn nên Inazuma mới có cục diện tốt đẹp thế này. Tôi cũng có cơ hội sửa lại sai lầm mà gia tộc mình đã phạm phải. Tôi rất biết ơn các bạn vì chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370605,
					"content": "Đại nhân Shogun đang chỉnh đốn lại nhiều phương diện, hòa giải hoặc xoa dịu những mâu thuẫn đã tích tụ trong thời gian qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370606,
					"content": "Hiệp Hội Tam Cực đề nghị, muốn nhân cơ hội này để trả lại danh dự cho nhà Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370607,
					"content": "Chuyện liên quan đến nhà Kaedehara, chắc bạn cũng nghe qua rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370608,
					"content": "Có nghe qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "Nói ngắn gọn thì ở Inazuma từng có những người thợ rèn hoàng gia, kế thừa kỹ thuật rèn đao của Shogun đại nhân và lấy việc phát huy nó làm vinh dự. Nhà Kaedehara cũng là một trong số đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370611,
					"content": "Nhưng vào thời kỳ nào đó, có một vài thợ rèn đã chạy trốn sang Snezhnaya, nhà Kaedehara và nhà Kamisato vì quản lý không nghiêm mà bị truy cứu, gặp phải đại họa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370612,
					"content": "Nhưng sau này mọi người đã biết, kẻ đứng đằng sau chuyện này là Fatui. Nếu quy hết tất cả sai lầm cho hai nhà Kaedehara và Kamisato thì chẳng công bằng chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370613,
					"content": "Lần này Kaedehara Kazuha lại còn lập công lớn, đại nhân Shogun cho rằng không chỉ khen thưởng, mà còn phải bồi thường cho quyết định xử phạt trước đây nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370614,
					"content": "Nhưng vì để tránh việc gia tộc rèn đao bị Fatui bức hại lần nữa, nên kết quả điều tra lần này không được chúng tôi công bố, xin thứ lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370615,
					"content": "Quá lời rồi, có thể nhận được ý tốt từ đại nhân Shogun và Hiệp Hội Tenryou thế này, tôi rất vui mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370616,
					"content": "Có điều ý tốt này không miễn phí nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370617,
					"content": "Anh nghĩ nhiều rồi, đây chỉ là \"bồi thường\" mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370618,
					"content": "Sau khi lấy lại danh dự, nhà Kaedehara có thể gầy dựng lại nghề rèn, anh cũng không cần phiêu bạt khắp nơi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370619,
					"content": "Dưới sự che chở lẫn ủng hộ của đại nhân Shogun và Shogunate, anh sẽ có cuộc sống an nhàn yên ổn ở Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370620,
					"content": "Tôi quanh năm dầm mưa dãi nắng đã lâu, e là sẽ không quen với những ngày tháng nhà cao cửa rộng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370621,
					"content": "Nhưng tổ tiên nhà tôi vẫn luôn tự hào vì dòng họ Kaedehara và kỹ thuật rèn đao, tôi phải có trách nhiệm lấy lại danh dự cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370622,
					"content": "Có vẻ anh vẫn còn do dự nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370623,
					"content": "Nếu anh đồng ý, tôi nghĩ những lời đồn xấu về anh trên phố sẽ biến mất thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370624,
					"content": "Lời đồn xấu? Suốt cả quãng đường tôi chỉ thấy người ta khen, tâng bốc anh ấy lên tận mây thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370625,
					"content": "Với một vài người, \"Lưỡi Đao Vô Tưởng\" là thứ không thể nào chiến thắng được, nên họ không chấp nhận được việc anh Kaedehara đỡ được nhát đao ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370626,
					"content": "Lúc đó có người chứng kiến được ngoài nguyên tố Phong ra, còn có cả nguyên tố Lôi nữa, cho nên việc \"Kaedehara Kazuha sử dụng Delusion\" đã lan truyền khắp nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370627,
					"content": "Hả? Nhưng mà người dùng Delusion sẽ già đi rất nhanh, Kazuha có như thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370628,
					"content": "Ừm, nhưng đối với họ, chuyện một người có thể dùng được hai loại nguyên tố thế này còn khó hiểu hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370629,
					"content": "Lời đồn tương tự như thế nhiều lắm, tôi không quen với chuyện bị cuốn vào dư luận, bị người ta đeo bám hoặc nghi ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370630,
					"content": "Nhưng nếu Shogunate đồng ý hỗ trợ tôi thì chắc là chuyện này sẽ nhanh chóng lắng xuống thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370631,
					"content": "Nên anh có thể cân nhắc thử, chuyện này tốt cho cả hai chúng ta mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370632,
					"content": "Ừm, để tôi suy nghĩ lại đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370633,
					"content": "Tạm không bàn chuyện này nữa. Sao hai bạn lại tới đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370634,
					"content": "Á, suýt thì quên mất chuyện quan trọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370635,
					"content": "Kể lại chuyện có kẻ tập kích cho Kazuha nghe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "Một người nguy hiểm như thế đang tìm tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370637,
					"content": "Kazuha có anh chị em ruột không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "Không có, bây giờ tôi cũng khá hoang mang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370640,
					"content": "Võ nghệ của tôi là do gia đình truyền dạy, vốn để chém ra những đường đao thẳng thớm khi thử đao. Vì để kiểm tra chất lượng của từng thanh đao một mà chúng tôi đã phải luyện tập rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370641,
					"content": "Dần dà, gia tộc tôi đã tạo ra một bộ Thuật Thử Đao, những kỹ năng tương ứng cũng ra đời từ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370642,
					"content": "Nó khác hẳn với kỹ thuật sử dụng thực tế trên chiến trường, khó mà tưởng tượng nổi chỉ là trùng hợp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370643,
					"content": "Vậy anh phải cẩn thận đấy, tôi thấy người này rất kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370644,
					"content": "Ừm, anh ta nóng nảy như vậy, nếu ra tay với người khác thì rất dễ gây ra hậu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370645,
					"content": "Nếu đã như vậy thì tôi sẽ cử người đi điều tra ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370646,
					"content": "Ừm, làm phiền anh rồi. Tôi cũng rất tò mò, thế này đi, đúng lúc tôi cũng cần thời gian để suy nghĩ về đề nghị ban nãy của anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370647,
					"content": "Tôi và họ sẽ đi điều tra kẻ tập kích trước, sau đó trả lời cho anh về sự lựa chọn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370648,
					"content": "Được, vậy các bạn phải chú ý an toàn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370649,
					"content": "Đi thôi, chúng ta đi tìm kẻ tập kích kia thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370638,
					"content": "Kazuha có huynh đệ đồng môn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "Không có ấn tượng gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
