			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "Hở? Hóa ra ngươi không có Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370402,
					"content": "Xem ra ta đã nhận nhầm người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370403,
					"content": "Ít nhất cũng phải nhìn rõ là ai đã rồi mới ra tay chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370404,
					"content": "Không đúng... Dù ngươi tìm ai đi nữa thì bất ngờ tấn công người khác cũng nguy hiểm lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370405,
					"content": "Các người có từng gặp một người tên là Kaedehara Kazuha không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370406,
					"content": "Cũng như ngươi vậy, dùng kiếm đơn, nghe nói còn có Vision hệ Phong nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370407,
					"content": "Ngươi tìm Kazuha để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "Không liên quan gì đến ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370409,
					"content": "Thôi, xem ra ngươi không biết gì rồi, đúng là phí thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370410,
					"content": "Sao tên này kỳ lạ thế nhỉ, chỉ biết cầm đao múa may, lại còn khó hiểu nữa, đến cả câu xin lỗi cũng không thèm nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370411,
					"content": "Mình không thể nói thông tin của Kazuha bừa bãi cho loại người này được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370412,
					"content": "Nói đúng lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "Hmm! Tuy rằng tôi cảm thấy nếu quyết đấu đàng hoàng thì hắn ta cũng không thể làm gì được Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370416,
					"content": "Để đề phòng, chúng ta mau báo cho Kazuha biết thì hơn, để anh ấy chú ý an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370417,
					"content": "Thật ra tôi thấy thế này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "Hửm? Thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370419,
					"content": "Hắn ta có thể có mối quan hệ đặc biệt với Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "Quan hệ đặc biệt? Ý là bạn nghĩ hắn ta quen Kazuha sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370421,
					"content": "Tuy đây chỉ là một cảm giác mơ hồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "Ừm, kể ra cũng phải. Nhưng chiêu thức của mọi người trông cũng na ná nhau mà, vậy đâu có nói lên được gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370424,
					"content": "Tóm lại chúng ta mau báo cho Kazuha biết đi, bằng không anh ấy sẽ gặp nguy hiểm mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370425,
					"content": "Tôi nghe nói đội thuyền \"Nam Thập Tự\" đang ở Đảo Ritou để bổ sung hàng, chắc anh ấy đang ở bên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370422,
					"content": "Nhưng chiêu thức mà hắn ta dùng hơi giống với Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "Hiếm khi thấy Paimon thông minh như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "Ê, tôi giận đấy nhé. Lúc nào mà tôi chẳng thông minh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
