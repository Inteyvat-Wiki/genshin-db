					"content": "Chỉ trong phút chốc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				},
				{
					"id": 120370205,
					"content": "Xem như cuộc hành trình của chúng ta đã có tiến triển nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370206,
					"content": "Bây giờ chúng ta đi đâu đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370207
