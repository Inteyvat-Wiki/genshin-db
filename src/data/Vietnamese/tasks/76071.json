			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Nếu có thể làm ra những chiếc bánh mì ngon, chắc chắn sẽ giúp mọi người phấn chấn hơn. Nhưng tình hình hiện tại thì hơi khó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710102,
					"content": "Gặp phải khó khăn gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "Là thế này, tôi đang định làm một loại bánh mì mới, là loại giống như Nấm Rơm mà mẹ từng làm cho tôi hồi nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710106,
					"content": "Trong trí nhớ của tôi, loại bánh mì này cần dùng Nấm Rơm và quả mọng để làm nhân sốt, sau đó nhồi nhân sốt vào bột đã nhào kỹ, rồi cho vào lò nướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710107,
					"content": "Quan trọng nhất là phải dùng bột mì được xay từ lúa mì tươi, như vậy thì bánh mì mới tỏa ra hương thơm ấm áp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710108,
					"content": "Ban đầu tôi chỉ định đến đây hái một ít lúa mì thôi, nhưng không biết có phải dạo này đồng nghiệp đang bận không, mà để ruộng lúa mì chẳng ai trông coi, xung quanh xuất hiện rất nhiều sinh vật nhỏ kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710109,
					"content": "Nếu ngài Valdis có ở đây thì chắc có thể xử lý được rồi, nhưng tôi thực sự không giỏi mấy chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710110,
					"content": "#Vậy nếu được thì {F#cô}{M#cậu} có thể giúp tôi hái một ít lúa mì không? Chỉ cần một chút thôi. Để đáp lại, tôi có thể dạy {F#cô}{M#cậu} làm bánh mì Nấm Rơm ấm nóng, làm ơn đi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710103,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "#Ơ kìa, {F#cô}{M#cậu} đừng đi mà, giúp tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				}
			]
		},
