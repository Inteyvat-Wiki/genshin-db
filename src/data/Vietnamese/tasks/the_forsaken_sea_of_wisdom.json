			"dialogs": [
				{
					"id": 751750101,
					"content": "Sau khi cơ thể chìm vào Phlogiston Thể Lỏng, hình ảnh tựa như hồi ức ấm áp hiện lên trong đầu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750102
					]
				},
				{
					"id": 751750102,
					"content": "Bên cạnh hồ lửa, bóng hình màu trắng và bóng hình phủ đầy tro bụi trò chuyện với nội dung như sau...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750103
					]
				},
				{
					"id": 751750103,
					"content": "\"...Thí nghiệm kiểm chứng giai đoạn hai đã kết thúc. Thứ sẽ thanh lọc và tiến hóa tất cả, ta sẽ đặt tên cho nó là 'Huitzilopochtli' hoặc là 'Lửa Trời Càn Quét'...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750104
					]
				},
				{
					"id": 751750104,
					"content": "\"Không quan trọng nữa, ở nơi đây tên gọi sớm muộn gì cũng sẽ mất đi ý nghĩa.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750105
					]
				},
				{
					"id": 751750105,
					"content": "\"Để đối phó với sự xâm chiếm, cần điều khiển Tổ Hợp Tinh Tú chủ động tiếp cận, sau đó trước khi bị bóp méo hoàn toàn thì dùng cách tự hủy để tiêu diệt sự ảnh hưởng của Vực Sâu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750106
					],
					"speakerTitle": "Đắm Mình Trong Hồ"
				},
				{
					"id": 751750106,
					"content": "Nhưng sao có thể phán đoán chính xác đối tượng bị xâm chiếm và mẫu có thể kiểm soát được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750107
					],
					"speakerTitle": "Đắm Mình Trong Hồ"
				},
				{
					"id": 751750107,
					"content": "Thật điên rồ, đây là đang thí nghiệm trên chính mình sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750108
					],
					"speakerTitle": "Đắm Mình Trong Hồ"
				},
				{
					"id": 751750108,
					"content": "\"Vậy cũng tốt mà. Làm như thế ít ra thì cơ thể mục nát này cũng có chút công dụng.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750109
					]
				},
				{
					"id": 751750109,
					"content": "...Cho nên, sau khi khởi động hệ thống này, người không có khả năng sống sót nhất chính là bản thân ngài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750110
					],
					"speakerTitle": "Đắm Mình Trong Hồ"
				},
				{
					"id": 751750110,
					"content": "Cuối cùng đến cả đầu óc của ngài cũng bị Vực Sâu ăn mòn rồi à? Hay chẳng qua, ngài chỉ muốn cả dòng tộc đều phải cùng hy sinh trong tang lễ của mình sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750111
					],
					"speakerTitle": "Đắm Mình Trong Hồ"
				},
				{
					"id": 751750111,
					"content": "\"Ngươi không tin tưởng người cùng tộc vậy sao. Ngoài ngươi ra, tất cả lãnh chúa khác đều đã đồng ý với chuyện này.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750112
					]
				},
				{
					"id": 751750112,
					"content": "Chẳng qua họ chỉ ngu ngốc nghe theo kế hoạch của ngài mà chưa bao giờ suy nghĩ đến ý nghĩa thật sự phía sau thôi... Ta sẽ không đồng ý đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750113
					],
					"speakerTitle": "Đắm Mình Trong Hồ"
				},
				{
					"id": 751750113,
					"content": "\"...Điều đó không quan trọng. 'Hủy diệt'... cũng chính là 'sự sống mới', ta đã hạ quyết tâm rồi.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750114
					]
				},
				{
					"id": 751750114,
					"content": "\"Hah... Thời gian ta duy trì sự tỉnh táo mỗi ngày chỉ còn từng này thôi. Tóm lại, ta sẽ kích hoạt nó sau khi mọi thứ đã sẵn sàng.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750115
					]
				},
				{
					"id": 751750115,
					"content": "Không còn cách xoay chuyển nữa sao? Ta vẫn đang thử tìm cách khác... Ngài thật sự không phải vì lòng thù hận cá nhân mà đẩy thế giới vào biển lửa đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750116
					],
					"speakerTitle": "Đắm Mình Trong Hồ"
				},
				{
					"id": 751750116,
					"content": "\"Cũng không chừng đấy. Ta có thể không từ thủ đoạn để ngăn cản kẻ địch trong bóng tối tránh xa thế giới này.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750117
					]
				},
				{
					"id": 751750117,
					"content": "\"Hơn nữa, nếu dùng cách khác... Ngươi thật sự có thể tìm được thứ mình muốn từ những 'con người' đó sao? Ngươi đã lún sâu quá rồi...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750118
					]
				},
				{
					"id": 751750118,
					"content": "\"Ta cũng từng định khiến cho ngươi hiểu... Nhưng cũng giống như dòng tộc muốn thông qua hồ lửa để biết về trí tuệ, biết và thật sự chấp nhận là hai việc khác nhau.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750119
					]
				},
				{
					"id": 751750119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750120
					],
					"speakerTitle": "Đắm Mình Trong Hồ"
				},
				{
					"id": 751750120,
					"content": "\"Nếu ngươi cho rằng ta chỉ đơn thuần muốn 'hủy diệt', còn ngươi lại có thế giới riêng mà mình muốn xây dựng... Vậy thì hãy đến ngăn cản ta, giết chết ta để chứng minh cho ta xem đi!\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750121
					]
				},
				{
					"id": 751750121,
					"content": "\"Nhưng rồi sẽ có một ngày, đây không phải là lời tiên tri đâu, Kukulkan. Đây chẳng qua chỉ là lời khuyên của người từng trải... Rồi sẽ có một ngày...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750122
					]
				},
				{
					"id": 751750122,
					"content": "\"Ngươi sẽ bước lên con đường giống như ta.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}