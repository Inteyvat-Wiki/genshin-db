			"dialogs": [
				{
					"id": 3890601,
					"content": "Không có cách tiến lên, trong di tích này hình như có <color=#00E1FFFF>Phong Ấn</color> vô cùng cổ xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890602,
					"content": "Đây cũng là do Dvalin làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890603,
					"content": "Không phải. Phế tích này từng là một thành phố cổ xưa, Dvalin chỉ là ở tạm ở đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890604,
					"content": "Bản thân phế tích, thật ra còn cổ xưa hơn thời đại của Tứ Phong Thủ Hộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890605,
					"content": "Mondstadt là một thành phố không có vua, nhưng trước khi Mondstadt được thành lập...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890606,
					"content": "Từng có một tên vua hung ác thống trị nơi này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890607,
					"content": "Ừm... Sau này nếu có cơ hội, sẽ kể cho các bạn nghe thêm về ông vua đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890608,
					"content": "Kiểu của phong ấn này... Theo kiến thức khảo cổ học của tôi, có lẽ là <color=#00E1FFFF>Cơ Quan Dẫn Sáng</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890609,
					"content": "Đem tất cả <color=#00E1FFFF>linh kiện </color>đặt vào <color=#00E1FFFF>bản thể</color>, có thể hoàn thành <color=#00E1FFFF>Nghi Thức Dẫn Sáng</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890610,
					"content": "Từ tình hình tại hiện trường cho thấy, nghi thức dẫn sáng tại cơ quan này gần hoàn thành rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3890611,
					"content": "Đem <color=#00E1FFFF>linh kiện cuối cùng</color> đặt vào trước đã, rồi xem tình hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		}
