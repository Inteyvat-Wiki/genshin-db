					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890303,
					"content": "Ừm... <color=#00E1FFFF>Đỉnh nóc</color> bên đó, có phải là vỡ <color=#00E1FFFF>một mảng lớn</color> không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890304,
					"content": "Ừm... <color=#00E1FFFF>Trận gió</color> bên đó, hình như có thể lợi dụng nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890305,
