					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200503,
					"content": "Bạn cứ trực tiếp nói cho tôi nghe là được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
