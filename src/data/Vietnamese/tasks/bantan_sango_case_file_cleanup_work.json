			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "Nhà lữ hành, không ngờ lại gặp bạn ở đây, xem ra hội trưởng nói không sai, chúng ta rất có duyên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200102,
					"content": "Bạn ở đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "Là hội trưởng dặn dò tôi dọn dẹp lại vụ án lần trước thôi ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200104,
					"content": "Thực ra là tôi cần phải mang chút điểm tâm này đến cho lính tuần tra, để cảm ơn sự giúp đỡ của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200105,
					"content": "Họ phải là người đi cảm ơn mới đúng chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "Nói vậy cũng không sai, nhưng thực ra chỉ là đem chút quà đi để lấy lòng thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200108,
					"content": "Dẫu sao thì sau này có thể Trụ Sở Thám Tử sẽ có thêm nhiều việc cần họ chiếu cố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200109,
					"content": "Cái này là do Sango nói đúng không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "Ha ha, đúng vậy, trực giác của bạn nhạy bén thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200112,
					"content": "Vậy bản thân bạn có suy nghĩ gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "Tôi sao? Amano và Andou trước đó có làm việc chung với tôi qua, mang chút điểm tâm đi tặng cũng là chuyện bình thường thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200114,
					"content": "Nhưng mà...hôm nay hội trưởng lại nhờ tôi đi điều tra thêm một việc, cho nên tôi tạm thời không có đủ thời gian cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200115,
					"content": "Nhà lữ hành, bạn có thể giúp tôi giao số điểm tâm này cho ba người được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200116,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "Cảm ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200121,
					"content": "Đây là ba phần điểm tâm, cần phải đi giao cho Amano, Andou và Owada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200122,
					"content": "Owada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "Anh ấy cũng là đồng nghiệp cũ của tôi. Sau khi tôi rời khỏi hiệp hội, anh ấy cũng chiếu cố tôi khá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200124,
					"content": "Trước đó khi xử lý vụ trộm liên hoàn, anh ấy cũng có giúp chúng tôi điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200125,
					"content": "Việc này nhờ vào bạn nhé nhà lữ hành. Sau khi giao xong thì gặp nhau ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200118,
					"content": "Bạn đi giao sẽ hay hơn đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "Nhưng mà...ủy thác của hội trưởng có vẻ quan trọng hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200120,
					"content": "Sau này tôi sẽ tìm thời gian đi thăm ba người đó sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200110,
					"content": "Vừa nghe là biết Sango muốn tìm lý do rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "Không phải là do chúng ta giúp họ phá án sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
