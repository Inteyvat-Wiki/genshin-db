				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "Ấy? Nhà lữ hành, sao bạn lại đến đây rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200202,
					"content": "Đây là quà mà Ryuuji tặng cho hai bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "Vậy hả? Để tôi xem thử...đây là Bánh Anh Đào sao...tên Ryuuji đó cũng khách sáo quá đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200204,
					"content": "Này, Andou đừng có đề phòng như vậy chứ, tuy Nhà Lữ Hành là người nước ngoài, nhưng không phải vừa giúp chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200205,
					"content": "Cái tên Ryuuji đó vẫn còn nhớ tôi thích ăn món gì, không uổng phí tình đồng nghiệp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200206,
					"content": "Ryuuji trước đây có làm việc qua với hai bạn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "Hả? Anh ta không có kể cho bạn nghe sao? Trước đây đúng là chúng tôi có làm việc với nhau một thời gian ngắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200208,
					"content": "Nhưng không biết tại sao anh ấy đột nhiên bị cuốn vào một chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200209,
					"content": "Tuy là sau đó được Sango tìm ra hung thủ thực sự, giải oan cho Ryuuji. Nhưng sau đó anh ta đã rời khỏi Hiệp Hội để đi làm việc cho Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200210,
					"content": "Ngoài vụ đó ra thì tôi không còn biết thêm gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200211,
					"content": "Được rồi, nói đến đây là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200212,
					"content": "À, cũng phải. Cái tên đó làm việc với Sango có vẻ hợp hơn với chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200213,
					"content": "Nếu có thể thì tôi cũng muốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200214,
					"content": "Thiệt tình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200215,
					"content": "Khụ! Không nói nữa, cảm ơn nhà lữ hành, tôi xin số điểm tâm này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200216,
					"content": "Nhớ cho tôi gửi lời hỏi thăm tới Sango và Ryuuji nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amano"
				}
			]
		},
		{
