			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "Ấy? Bạn là...một nhà lữ hành tóc vàng sao, tôi có nghe Amano kể về bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200302,
					"content": "Sao rồi, bạn tìm tôi có việc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200303,
					"content": "Đây là quà của Ryuuji tặng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "Ây da, là \"Bánh Anh Đào\" sao, vậy thì phải giữ lại để tìm chỗ nào đó thưởng thức mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200305,
					"content": "Uesugi, ở đây đợi tôi chút nhé. Nếu có ai đến tìm tôi thì bảo họ đợi chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200306,
					"content": "Ngài Owada, đang trong giờ làm việc mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200307,
					"content": "Ha ha, không sao, tôi đi hít thở không khí chút thôi mà, lát nữa về ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200308,
					"content": "À ừm...Được rồi, nhưng mà về nhanh nhanh nhé, để bị phát hiện thì phiền phức lắm đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200309,
					"content": "Yên tâm, Hiệp Hội vừa mới phá án xong, cho dù có người tới thì cũng là để chúc mừng mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200310,
					"content": "Giao cho anh nhé Uesugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200311,
					"content": "Nhà lữ hành, đi chung với tôi nhé, tôi biết có một nơi rất thích hợp để thưởng thức món điểm tâm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
