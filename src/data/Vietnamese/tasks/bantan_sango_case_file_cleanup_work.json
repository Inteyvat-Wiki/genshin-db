			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "Vất vả cho bạn rồi, nhà lữ hành, bạn đã giao đi hết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200502,
					"content": "Đây đều là do Sango dặn dò bạn làm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "Bạn...phát hiện rồi sao? Xin lỗi...việc nhờ bạn đi giao quà đúng là do hội trưởng dặn dò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200505,
					"content": "Hội trưởng nói rằng muốn giải quyết triệt để vụ án năm xưa, lôi cho bằng được tên hung thủ đó ra ánh sáng, nên bạn là một trợ thủ không thể thiếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200506,
					"content": "Vụ án đó vẫn chưa được giải quyết sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "Vẫn chưa. Hội trưởng có nói, tên \"hung thủ\" mà cô ấy tìm được năm xưa, mọi chuyện đều...quá hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200508,
					"content": "Sau khi hội trưởng điều tra chuyên sâu, thì tất cả manh mối động cơ bằng chứng đều tự chạy hết vào tay của hội trưởng, tất cả đều chỉ hết về người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200509,
					"content": "Sau cùng Hiệp Hội phải bắt giữ người đó, nhưng hội trưởng cho rằng hung thủ thực sự là một người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200514,
					"content": "Tôi nghĩ lý do mà cô ấy giữ tôi ở lại trụ sở làm việc, nhất định là do muốn phá vụ án đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200515,
					"content": "Nhưng mà, tôi cũng không có giúp được gì nhiều...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "Suy nghĩ của hội trưởng...trước giờ tôi đều nhìn không thấu. Nhưng có lần cô ấy nói với tôi rằng, có lẽ do cô ấy luôn ở trong Inazuma, nên tầm nhìn đã trở nên hạn hẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200517,
					"content": "Nếu như có một người hiểu biết sâu rộng đến giúp đỡ, nói không chừng sẽ có khả năng phá được vụ án đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200518,
					"content": "Nhà lữ hành, có thể hội trưởng cảm thấy bạn chính là người sẽ giúp được cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200519,
					"content": "Vậy là tôi cũng đã là một \"thám tử\" rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "Nếu như bạn chịu giúp thì đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200523,
					"content": "Nhưng dù thế nào, bạn giúp trụ sở chúng tôi nhiều như vậy, phần thù lao này xem như quà của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200524,
					"content": "Những lời này đều là do Sango dặn dò sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "Không không, lần này là do tự tôi muốn nói thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200526,
					"content": "Lần nữa cảm ơn sự giúp đỡ của bạn, nếu có thời gian thì hãy thường xuyên đến chỗ chúng tôi nhé, hội trưởng nhất định sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200521,
					"content": "Thù lao của vụ án này có nhiều không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "Tôi không rõ lắm, nhưng mà...nhất định sẽ khiến bạn hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200510,
					"content": "Đây chính là \"vụ án hoàn hảo\" mà Sango nhắc đến sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "Đúng vậy. Hội trưởng nói rằng \"hung thủ\" mà cô ấy tìm được năm xưa, mọi chuyện đều...quá hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200512,
					"content": "Sau khi hội trưởng điều tra chuyên sâu, thì tất cả manh mối động cơ bằng chứng đều tự chạy hết vào tay của hội trưởng, tất cả đều chỉ hết về người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
