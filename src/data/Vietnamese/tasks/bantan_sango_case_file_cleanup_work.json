			"dialogs": [
				{
					"id": 220200404,
					"content": "Ừm...Chỗ này không tệ, tôi cũng thường hay đến đây để thư giãn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200405,
					"content": "Cảnh sắc rất đẹp, không khí cũng rất trong lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200406,
					"content": "Bạn có chuyện gì muốn hỏi thì cứ việc hỏi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200407,
					"content": "Bạn và Ryuuji là đồng nghiệp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "Đúng vậy, Ryuuji đúng là từng làm việc với tôi qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200411,
					"content": "Chuyện năm đó không biết Ryuuji đã nói cho bạn nghe chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200412,
					"content": "Đơn giản mà nói thì Ryuuji do quá manh động nên đã rơi vào cái bẫy giăng sẵn, trở thành vật thế thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200413,
					"content": "Cho dù là tôi có đứng ra bảo lãnh thì anh ta cũng không thể thoát tội được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200414,
					"content": "Tuy nhiên tôi cũng có nhờ rất nhiều người điều tra, nhưng cũng không có kết quả. Lại còn bảo ngược lại cho tôi rằng đừng nên điều tra tiếp nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200415,
					"content": "Ha ha, đương nhiên là tôi...nghe theo lời cảnh báo, không điều tra tiếp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200416,
					"content": "Chuyện \"Ryuuji bị oan\" này là một bí mật mà mọi người đều biết, cho nên nói cho bạn nghe cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200417,
					"content": "Nếu như là mọi người đều biết thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "Chính vì ai cũng ý thức được việc \"mọi người đều biết\", nên thành ra không ai dám xen vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200419,
					"content": "Thế nhưng, may mà có một thám tử mới chuyển đến, cảm thấy có hứng thú với vụ án này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200420,
					"content": "Sau một thời gian điều tra, cuối cùng đã tìm được hung thủ thực sự, Ryuuji đã được giải oan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200421,
					"content": "Sau đó, Ryuuji rời khỏi Hiệp Hội để làm việc cho vị thám tử đó. Câu chuyện đến đây là kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200422,
					"content": "Sao bạn lại nói với tôi chuyện này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "Là ai nhờ bạn mang phần điểm tâm này đến?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200424,
					"content": "Là Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "Lý do mà Ryuuji mang quà đến tặng tôi, chắc cũng là do \"hội trưởng dặn dò\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200426,
					"content": "Với tính cách của Ryuuji, nếu như là Sango dặn dò, thì lao vào biển lửa anh ta cũng sẽ đích thân giao đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200427,
					"content": "Nếu như Ryuuji nhờ bạn giao, thì đó có nghĩa là do Sango dặn dò phải làm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200428,
					"content": "Là Sango muốn tôi biết chuyện này ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "Ha ha ha, đầu bạn nhảy số cũng nhanh đấy. Giờ bạn ở đây, cũng gần như là Sango đang muốn nói với tôi: \"Tôi đã có trợ thủ mới rồi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200430,
					"content": "Xem ra, cô ấy vẫn luôn canh cánh chuyện cũ trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200431,
					"content": "Cũng khó trách, dù sao...đến giờ cô ấy vẫn chưa tìm được người đã tạo ra cái bẫy đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200432,
					"content": "Được rồi, chuyện có thể nói cũng đã nói rồi. Muốn hợp tác chung với Sango hay không do bạn tự quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200433,
					"content": "À đúng rồi, khi quay về thì tiện thể gửi lời cảm ơn cho Ryuuji về \"Bánh Anh Đào\" nhé, đây là món khoái khẩu của tôi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200409,
					"content": "Ryuuji tại sao lại rời khỏi Hiệp Hội vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "Là do anh ta tự chọn rời đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				}
			]
		},
