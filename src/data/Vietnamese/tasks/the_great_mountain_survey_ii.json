			"dialogs": [
				{
					"id": 701080301,
					"content": "Bạn đặt đèn hiệu xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Đặt xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Tốt quá, cảm ơn bạn nhé, như vậy chắc chắn tôi sẽ đo được độ cao của núi tuyết cho xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "À đúng rồi, tôi đã nhờ Cyrus chuẩn bị thù lao cho bạn rồi, hãy vào thành tìm anh ấy để nhận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "Sẵn tiện giúp tôi mang bức thư này cho anh ấy, anh ấy đã hứa sẽ lưu ý đến đội thám hiểm thứ hai lên núi tuyết, nhưng đến giờ cũng chẳng thấy tin tức gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Sau khi sửa xong số đèn hiệu đó, tôi vẫn phải lên núi bố trí lại lần nữa. Ngọn núi tuyết này còn rất nhiều thứ cần thăm dò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
