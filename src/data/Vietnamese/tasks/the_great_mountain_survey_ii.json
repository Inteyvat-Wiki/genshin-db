			"dialogs": [
				{
					"id": 701080401,
					"content": "Xin chào, có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "Bức thư này gửi cho bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "Thư? A... của cô ấy sao, tôi biết rồi, chắc chắn lại hỏi tôi về chuyện của đội thám hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "Haiz, tôi cũng không còn cách nào khác, bây giờ chẳng có bao nhiêu đội thám hiểm lên núi tuyết cả, nơi đó quá nguy hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "Chờ lát nữa tôi viết thư cho cô ấy để nói rõ tình hình, cảm ơn bạn đã đưa thư nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "À đúng rồi, đây là thù lao mà cô ấy viết thư bảo tôi chuẩn bị cho bạn, hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "Còn nữa... tuy bạn rất có bản lĩnh, nhưng hành động trên núi tuyết cũng phải cẩn trọng mới được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "Haiz, núi tuyết... nếu có cơ hội, tôi chắc chắn phải tự dẫn đội vào thử xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
