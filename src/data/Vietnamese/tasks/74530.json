			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "#A, sư phụ! {F#Chị}{M#Anh} về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300402,
					"content": "Trông Kachina rất vui nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "Hì hì! Lần này khai quật em đã tìm được quặng thô chất lượng khá tốt đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300405,
					"content": "Nếu mài giũa cẩn thận thì không chừng sẽ trở thành viên đá quý lấp lánh khổng lồ luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300406,
					"content": "Tuyệt quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "Ừm! Vốn dĩ lúc đầu chẳng thu hoạch được gì, em suýt chút nữa phải về tay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300408,
					"content": "Nhưng em nghĩ là phải kiên trì thêm chút nữa... Thế là tự nhủ với bản thân, đào xuống thêm chút nữa, thêm chút nữa thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300409,
					"content": "Không biết rốt cuộc đã lặp lại bao nhiêu lần, cuối cùng cũng tìm được thứ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300410,
					"content": "Đến lúc ra ngoài thì em mới phát hiện mặt trời sắp xuống núi rồi... Có vẻ em đã vô tình đào suốt cả ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300411,
					"content": "Không hổ danh là Kachina, rất có nghị lực.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "Ôi, thật sao? Em... đối diện với ống kính em dễ xấu hổ lắm... chưa chắc đã chụp được ảnh đẹp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300414,
					"content": "Nhưng mà... nếu là yêu cầu của sư phụ, em sẽ cố gắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300415,
					"content": "Em đã rất cố gắng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "Vâng, em hiểu rồi. Vậy giao cho sư phụ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300416,
					"content": "Kachina hiện tại đã rất giỏi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "Để chụp lại khoảnh khắc rạng ngời của em nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "Có chuyện tốt gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
}