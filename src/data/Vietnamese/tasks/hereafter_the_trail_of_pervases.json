			"dialogs": [
				{
					"id": 710350201,
					"content": "Sao bạn đến đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350202,
					"content": "Bạn cũng đến gặp Đồng Tước sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "Chỉ là đi ngang qua đây, dừng chân chốc lát mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350204,
					"content": "Các bạn đến có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350205,
					"content": "Chúng tôi đến thăm Đồng Tước tiên sinh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350206,
					"content": "Nhưng, xung quanh đây vẫn y như cũ nhỉ, mọi thứ loạn cả lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350207,
					"content": "Đã xây miếu, làm cả tượng... vậy tại sao lại không có ai trông nom chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350208,
					"content": "Có lẽ đã quên mất rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "Chuyện này cũng quên được sao? Dạ Xoa rõ ràng là đại anh hùng đã bảo vệ Cảng Liyue mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350211,
					"content": "Xiao...Bạn, bạn không vui sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350212,
					"content": "Không, Dạ Xoa đảm nhiệm trách nhiệm bảo vệ nơi này, vốn không hề có ước mong được người đời sau tưởng niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350213,
					"content": "Không nói chuyện này nữa, chúng ta mau ăn Cá Hổ Nướng thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350214,
					"content": "Ơ...Nếu Xiao cũng muốn ăn, thì chúng tôi mỗi người chia một nửa cho bạn nhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350215,
					"content": "Không cần đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350216,
					"content": "Cứu tôi với! Cứu tôi với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350217,
					"content": "Ủa? Hình như tôi nghe thấy tiếng gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350218,
					"content": "Có người kêu cứu, ở bên đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350219,
					"content": "Mau đi thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "Này? Gói ghém Cá Hổ Nướng lại cho cẩn thận nha! Tôi còn chưa ăn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
