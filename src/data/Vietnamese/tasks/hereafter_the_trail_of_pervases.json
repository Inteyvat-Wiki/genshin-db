			"dialogs": [
				{
					"id": 710350101,
					"content": "Hai vị muốn chọn món gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 710350102,
					"content": "Ba phần Cá Hổ Nướng, mang về.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "Được thôi! Xin đợi một lát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 710350104,
					"content": "Ba phần? Bạn một phần, tôi một phần...còn một phần là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "Tính đi thăm Đồng Tước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "Ý bạn nói là vị Đồng Tước tiên sinh mà trước đây đưa Đèn Thất Tinh và Lư Hương cho chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "Phải ha, nhớ là Đồng Tước tiên sinh từng nói anh ấy rất nhớ món Cá Hổ Nướng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "Nhưng mà, Đồng Tước tiên sinh chắc đã đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Đến xem thử cũng được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Ừm, vậy chúng ta đi xem thử thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "Lúc trước khi gặp Đồng Tước tiên sinh ở bên đó, ngôi miếu đó cũ kỹ tồi tàn, bên cạnh còn có dấu tích của Đạo Bảo Đoàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Hy vọng tượng của Đồng Tước tiên sinh không bị hư hỏng gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Hai vị, ba phần Cá Hổ Nướng của các vị đã đóng gói xong rồi, xin hãy cầm lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 710350115,
					"content": "#Thơm quá! {NICKNAME}, vậy chúng ta mau chóng xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350106,
					"content": "Đồng Tước thích ăn Cá Hổ Nướng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
