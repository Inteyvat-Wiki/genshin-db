			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "Ngôi miếu này vẫn cũ kỹ như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350402,
					"content": "Mau khai thật đi, sao đột nhiên anh lại muốn đến tu sửa ngôi miếu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350403,
					"content": "Khụ, nói ra thì dài dòng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350404,
					"content": "Trước đây vì để giả trang làm tiên nhân, nên tôi đã sưu tầm rất nhiều tư liệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350405,
					"content": "Lần đó sau khi được tiên sư giáo huấn, không phải tôi đã lập lời thề sao? Sau khi trở về, tôi chuẩn bị hủy hết toàn bộ tư liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350406,
					"content": "Nhưng tôi chợt nghĩ đến...Thay vì đem tiêu hủy hết mớ tư liệu này, chi bằng đem các tư liệu này, và cả các thủ đoạn tôi đã lừa gạt mọi người soạn thành sách, phân phát cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350407,
					"content": "Như vậy, nói không chừng có thể giúp mọi người nhìn thấu được những tên lừa đảo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350408,
					"content": "Nhưng không ngờ rằng, quyển sách mà tôi biên soạn này đã giúp được rất nhiều người không bị lừa, ngay cả người của Tổng Vụ cũng nói quyển sách này rất hữu ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350409,
					"content": "Ngoài những nội dung mà tôi tự viết ra, họ còn nhờ tôi thêm vào các nội dung đề phòng lừa đảo khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350410,
					"content": "Vì chuyện này, Tổng Vụ đã trả cho tôi không ít tiền đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350411,
					"content": "Ngoài quyển sách đó ra, tôi còn đang viết một quyển liên quan đến \"Hộ Pháp Dạ Xoa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350412,
					"content": "Tôi muốn dùng quyển sách này để truyền bá đến mọi người về câu chuyện của \"Hộ Pháp Dạ Xoa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350413,
					"content": "Làm như vậy, những kiến thức dân dã của tôi cũng được dùng vào chuyện chính đạo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350414,
					"content": "Ngôi miếu của vị \"Đồng Tước\" này, tôi đã phát hiện được khi đang biên soạn quyển sách về \"Hộ Pháp Dạ Xoa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350415,
					"content": "Trên đó có ghi, ngôi miếu đó vốn là do dân chúng xây dựng để tưởng niệm Dạ Xoa \"Đồng Tước\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350416,
					"content": "Nhưng khi tôi đến ngôi miếu này, thật không ngờ là nó tồi tàn như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350417,
					"content": "Sau khi quay về tôi đã suy nghĩ rất nhiều, cuối cùng đã quyết định...tự bỏ tiền ra để tu sửa ngôi miếu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350418,
					"content": "Dù sao thì, tôi có thể quay về chính đạo cũng nhờ có tiên sư dạy dỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350419,
					"content": "Tu sửa ngôi miếu cũng xem như chuộc lại những lỗi lầm trước đây của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350420,
					"content": "Ừm...nghe không có vẻ là đang nói dối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350421,
					"content": "#{NICKNAME}, bạn thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350422,
					"content": "Cảm thấy rất thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "Gì mà cảm thấy rất thật chứ, đây rõ ràng là sự thật mà, không chút gian dối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350426,
					"content": "Haiz, thôi vậy, bạn muốn nghĩ sao thì tùy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350427,
					"content": "Nếu như bạn không tin, thì hãy chờ đến lúc chính thức thi công hãy đích thân đến xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350424,
					"content": "Trước đây anh là kẻ lừa đảo mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "Bây giờ hết rồi! Bây giờ tôi là một chính nhân quân tử, không phải tôi cũng từng lập lời thề trước mặt tiên sư sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
