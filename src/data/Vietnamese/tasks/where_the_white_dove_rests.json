			"dialogs": [
				{
					"id": 761800401,
					"content": "Trước đây thường đến vườn của Sandrone để tụ họp, giờ đổi lại Sandrone đến vườn của tôi uống trà, cảm giác thật mới lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800402,
					"content": "Nhưng trà và bánh vẫn do tôi chuẩn bị, cảm giác cũng không khác mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800403,
					"content": "Ừm, vẫn ngon như trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800404,
					"content": "#Hừm. Nhưng mà, nghe nói {NICKNAME} cũng hay đến đây thăm cô, những lúc đó thì hai người thường làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800405,
					"content": "#Ừm... Lúc thì trò chuyện, lúc thì cùng Kuuhenki chơi trò chơi, xem Kuuhenki vẽ tranh. À, tôi còn chơi Cờ Mặt Trăng với {M#cậu ấy}{F#cô ấy} nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800406,
					"content": "Cờ Mặt Trăng? Là loại cờ ba quân cờ nối thành hàng đó à? Ai thắng nhiều hơn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800407,
					"content": "#Tôi không đếm, nhưng {NICKNAME} chơi khá giỏi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800408,
					"content": "Hừm, đó là vì cô chưa chơi với tôi thôi. Muốn thử một ván không? Để tôi cho cô thấy thế nào là giỏi. Hòa cũng tính là tôi thua nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800409,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
