			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "Gì... gì cơ? Sao có thể chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800602,
					"content": "Là cô thua rồi đó, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800603,
					"content": "Tôi... tôi nhường cô thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800604,
					"content": "Thật sao? Trông cô có vẻ không cam tâm chút nào mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800605,
					"content": "Đáng ghét... Chơi lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800606,
					"content": "Hừ, cũng đơn giản thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800607,
					"content": "Tôi thua rồi. Cô quả nhiên rất lợi hại, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800608,
					"content": "Lần sau tôi sẽ chơi trò gì khó hơn với cô. Tôi biết nhiều trò chơi toán học thú vị lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800609,
					"content": "Được đấy, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800610,
					"content": "Cô cười gì đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800611,
					"content": "Trước đây hiếm khi thấy Sandrone vui vẻ như vậy, cũng chẳng mấy khi rủ tôi chơi trò chơi, còn hay đuổi tôi đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800612,
					"content": "Này... đừng có nói như thể tôi hay bắt nạt cô lắm ấy! Từ giờ tôi sẽ rủ cô tổ chức tiệc trà nhiều hơn là được chứ gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800613,
					"content": "Ừm, được chứ. Tôi rất thích những buổi tiệc trà trải qua cùng Sandrone như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
