			"dialogs": [
				{
					"id": 761800801,
					"content": "Chơi trò chơi với Sandrone vui thật đấy. Lần sau lại chơi cùng nhau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800802,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761800804,
					"content": "Phải đi rồi sao? Được thôi, vậy hẹn gặp lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761800803,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Sandrone"
				}
