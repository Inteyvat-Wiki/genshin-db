			"dialogs": [
				{
					"id": 400570601,
					"content": "Không lâu sau, Albedo đã hoàn thành hai bức chân dung...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570602
					]
				},
				{
					"id": 400570602,
					"content": "Ừm... Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570603,
						400570604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570603,
					"content": "Paimon, sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570605
					]
				},
				{
					"id": 400570605,
					"content": "Đúng vậy, thực ra thì kể từ khi tôi đọc xong câu chuyện của Ngũ Ca Tiên, có một điều mà tôi mãi vẫn chưa hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570606,
					"content": "Nhắc mới nhớ, không phải trong Ngũ Ca Tiên còn có một người tên là \"Kuronushi\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570607,
					"content": "Hiện giờ, chẳng phải là khi người này hoàn toàn chưa xuất hiện, mà câu chuyện về Ngũ Ca Tiên đã kết thúc rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570608,
					"content": "Oh... Hahaha, Paimon vẫn chưa phát hiện ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570609
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570609,
					"content": "Này, tên hát rong, đừng có quá đáng nha! Tôi chưa phát hiện gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570610,
					"content": "Paimon, thật ra trong bốn bài thơ hiện có, đã bao gồm câu chuyện về Kuronushi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570611,
					"content": "Thật, thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570612,
					"content": "Điểm mấu chốt của vấn đề nằm ở bài thơ được viết bởi Aoi no Okina sau khi nhìn thấy Sumizome đang rửa tập thơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570613
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570613,
					"content": "Cảnh cô gái đang rửa tập thơ của Akahito đối với người bình thường mà nói thì sẽ không thể hiểu được nguyên do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570614
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570614,
					"content": "Thậm chí ngay cả Aoi no Okina cũng không hiểu hành động của Sumizome có ý nghĩa gì. Anh ta chỉ đơn giản là nhìn vật nhớ người, nhớ lại những người bạn cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570615
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570615,
					"content": "Nhưng mà, đối với những phạm nhân hãm hại Akahito thì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570616
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570616,
					"content": "Chỉ có anh ta lo lắng, nếu để Shogun nhìn thấy bài thơ này, có thể Shogun sẽ phát hiện ra chân tướng chuyện Akahito đạo thơ, vậy thì coi như anh ta sẽ xong đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570617
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570617,
					"content": "Vì vậy, anh ta mới mạo hiểm, uy hiếp Aoi no Okina xé bài thơ đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570618
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570618,
					"content": "Thì ra tên uy hiếp Aoi no Okina kia chính là kẻ đã hãm hại Akahito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570619,
					"content": "Tên tội phạm đó chính là \"Kuronushi\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570620
					]
				},
				{
					"id": 400570620,
					"content": "Cái gì, anh ta chính là \"Kuronushi\" sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570621,
					"content": "Đúng vậy, mặc dù chỉ có bốn bài thơ, nhưng họ vẫn có thể kể được câu chuyện hoàn chỉnh của \"Ngũ Ca Tiên\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570622
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570622,
					"content": "Vì Shogun được nhắc đến trong các bài thơ chắc chắn không phải Ca Tiên, nhân vật duy nhất còn lại chỉ có người bí ẩn chưa rõ danh tính kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570623
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570623,
					"content": "Sau khi nghe mọi người giải thích thì tôi cũng đã hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570624,
					"content": "Nhưng mà bây giờ tôi đang nghĩ đến một chuyện khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570625
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570625,
					"content": "Câu chuyện của Ngũ Ca Tiên và những chuyện xảy ra xung quanh chúng ta ít nhiều cũng có liên quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570626
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570626,
					"content": "Vậy trên thực tế, cũng sẽ có một \"Kuronushi\" như vậy tồn tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570627
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570627,
					"content": "\"Kuronushi\"... trên thực tế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570628,
					"content": "Không lẽ, Kazuha đã nghĩ ra chuyện gì đó rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570629,
					"content": "Kazuha? Đúng rồi, hình như ngay từ đầu anh ấy đã rất im lặng, chúng ta qua đó hỏi thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570604,
					"content": "Trông Paimon có vẻ buồn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570605
					]
				}
			]
		},
		{
