							"2"
						],
						"stepId": 4005703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570101,
					"content": "#Chào {NICKNAME}, Paimon. Tôi nghe nói Lễ Hội Irodori sẽ có hướng dẫn viên, nhưng không ngờ lại là các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570102,
					"content": "Hihi, chúng tôi cũng không ngờ Kazuha lại trở về Inazuma với tư cách là khách mời của Lễ Hội Irodori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570103,
					"content": "Tôi cũng hơi ngạc nhiên khi nhận được lời mời, nhưng sau khi phiêu bạt bên ngoài một thời gian dài, nhân cơ hội này trở về quê hương và bái tế cố nhân cũng là ý hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570104,
					"content": "Kazuha, lúc nãy đứng từ xa chúng tôi thấy anh như đang tìm gì đó, xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570105,
					"content": "Là thế này, lúc nãy khi tôi cùng mọi người xuống thuyền thì đột nhiên nghe thấy bên cạnh có tiếng bước chân rất nhẹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570106
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570106,
					"content": "Kiểu bước chân đó tuyệt đối không phải là hành khách bình thường, nhưng khi tôi quay đầu lại thì không thấy người đó đâu nữa, và chỉ nghe một tiếng \"tõm\" phía dưới cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570107,
					"content": "Tôi không tìm thấy bất kỳ dấu vết nào của người đó, nhưng lại phát hiện ra một mảnh giấy kỳ lạ dưới chân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570108,
					"content": "Kazuha, có phải trên tờ giấy đó có viết một bài thơ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570109,
					"content": "Ơ, sao các bạn biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570110
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570110,
					"content": "Nói chuyện xảy ra mấy ngày trước cho Kazuha nghe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570111
					]
				},
				{
					"id": 400570111,
					"content": "Có cả chuyện này nữa sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570112,
					"content": "Kazuha, có thể cho tôi xem tờ giấy đó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570113
					]
				},
				{
					"id": 400570113,
					"content": "Đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570114,
					"content": "Lần trước, bài thơ của Aoi no Okina có đề cập đến Akahito ở cuối bài, quả nhiên đây là câu chuyện của Akahito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570115,
					"content": "Câu chuyện lần này đại khái là: Vì Akahito thích dùng con dấu màu đỏ nên mới có biệt danh này, nhưng lại bị Shogun phát hiện hành vi đạo văn, sau đó bị lưu đày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570116,
					"content": "Nói thế nào nhỉ, để mà đánh giá thì câu chuyện hôm nay nghe có vẻ không được tốt lành cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570117,
					"content": "Thật ra những câu chuyện khác cũng không khá hơn là bao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570118
					]
				},
				{
					"id": 400570118,
					"content": "Tôi nghĩ không có gì sai trong câu chuyện này cả, lúc trước tôi cũng từng là tội phạm bị Shogunate truy nã, cũng giống với Akahito trong câu chuyện này vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570119,
					"content": "Akahito trong câu chuyện này đã làm chuyện xấu và bị Shogun đày ải, không hề giống với Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570120,
					"content": "Này, bạn đang nghĩ gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570121,
						400570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570121,
					"content": "\"Con dấu\" trong câu chuyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				},
				{
					"id": 400570123,
					"content": "À đúng rồi, lúc nãy các bạn có nói đến một người bạn đang gặp khó khăn vì không thể ký tên nhanh đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570124,
					"content": "Ở Liyue và Inazuma đúng là có câu \"con dấu tương đương với chữ ký\", đây có thể là một ý tưởng khả thi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570125
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570125,
					"content": "Khi chèo thuyền trên biển, thỉnh thoảng tôi cũng sẽ khắc cái gì đó để giết thời gian, nếu muốn làm con dấu thì có lẽ tôi sẽ giúp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570126
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570126,
					"content": "Woa, vậy thì tốt quá! Bây giờ chúng ta đi tìm Albedo bàn bạc trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570122,
					"content": "Nói không chừng có thể giúp được Xingqiu thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				}
			]
		},
		{
			"id": 4005702,
			"completionStepIds": [
				4005704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
