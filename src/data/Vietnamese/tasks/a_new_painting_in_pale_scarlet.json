				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570201,
					"content": "Albedo, chúng tôi đã tìm được cách để giúp Xingqiu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570202,
					"content": "Nói chuyện xảy ra ban nãy cho Albedo nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570203
					]
				},
				{
					"id": 400570203,
					"content": "Quả nhiên câu chuyện của Ngũ Ca Tiên lại xuất hiện, mà lại còn xuất hiện bằng cách này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570204
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570204,
					"content": "Con dấu, ừm, để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570205,
					"content": "Thực sự là một giải pháp hiệu quả cao, vậy là từ giờ Xingqiu không cần lo lắng về chữ viết tay nữa. Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570206,
						400570207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570206,
					"content": "\"Nhưng mà\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				},
				{
					"id": 400570208,
					"content": "Bởi vì chữ ký của Xingqiu đã được công bố với độc giả từ trước, nên chương mới này nếu chỉ có con dấu thì có vẻ như không đủ chân thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570209
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570209,
					"content": "Tôi có một ý tưởng khác, đương nhiên con dấu cũng là một phần trong đó. Bây giờ chúng ta đến Nhà Hàng Uyuu để bàn bạc với mọi người đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570207,
					"content": "Có vấn đề gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				}
			]
		},
		{
			"id": 4005703,
			"completionStepIds": [
				4005706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005706",
							"2"
						],
						"stepId": 4005706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570301,
					"content": "Cố lên nào Zhenyu, chữ viết hôm nay đã tiến bộ hơn rồi, điều đó cho thấy buổi huấn luyện đặc biệt này đã có hiệu quả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570302
					],
					"speakerTitle": "Hirayama"
				},
				{
					"id": 400570302,
					"content": "Ôi, không được rồi, tay tôi đau đến nỗi không nhấc lên được nữa rồi... Sớm biết như vậy thì lúc trước tôi đã không lén đọc tiểu thuyết trong lớp luyện thư pháp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570303
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 400570303,
					"content": "Lúc nãy đã nghỉ mười phút rồi, cố gắng thêm chút nữa đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570304
					],
					"speakerTitle": "Hirayama"
				},
				{
					"id": 400570304,
					"content": "Tổng biên tập không hổ danh là người giục bản thảo đáng sợ nhất trong số chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570305
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 400570305,
					"content": "Ừm, chẳng trách sao hễ gặp phải tác giả phiền phức là Yae đại nhân lại để tổng biên tập ra mặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570306
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 400570306,
					"content": "Đáng sợ thật, mới chỉ không gặp một thời gian mà Xingqiu đã trở thành cái xác không hồn luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570307,
					"content": "Tổng biên tập, thật ra lúc nãy chúng tôi đã nghĩ ra một cách, có lẽ sẽ giải quyết được khó khăn của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570308,
					"content": "Liyue và Inazuma đều sử dụng con dấu rất rộng rãi, và con dấu thường được coi là tương đương với chữ ký. Chúng ta có thể sử dụng ý tưởng này để làm cho việc ký tên dễ dàng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570309,
					"content": "Đương nhiên là chỉ có con dấu thôi cũng không được, chữ ký phải bao gồm hai yếu tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570310,
					"content": "Đầu tiên là con dấu cá nhân, phần này được khắc chữ ký của tác giả Zhenyu làm bản mẫu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570311,
					"content": "Đồng thời, tôi cũng sẽ thiết kế một hình mẫu đơn giản nhưng trang nhã cho Zhenyu, Zhenyu chỉ cần ký mẫu này vào mỗi cuốn sách là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570312,
					"content": "Để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570313
					],
					"speakerTitle": "Hirayama"
				},
				{
					"id": 400570313,
					"content": "Ừm, cách này được đó! Không chỉ do chính tác giả ký, mà hiệu ứng có lẽ cũng sẽ đẹp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570314
					],
					"speakerTitle": "Hirayama"
				},
				{
					"id": 400570314,
					"content": "Thật sao, vậy là cuối cùng tôi cũng được cứu rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570315
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 400570315,
					"content": "Tổng biên tập, đột nhiên tôi nghĩ ra, sở dĩ trước đây chúng tôi bỏ buổi ký tặng trực tiếp là vì các tác giả phải tốn rất nhiều thời gian để ký từng cuốn sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570316
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 400570316,
					"content": "Nhưng nếu ký tên theo dạng này thì các tác giả sẽ có đủ thời gian để ký trực tiếp rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570317
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 400570317,
					"content": "Hơn nữa nếu tất cả tác giả đều dùng cách này thì chữ ký của Zhenyu cũng sẽ không gây sự chú ý nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570318
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 400570318,
					"content": "Nếu mọi người cảm thấy khả quan thì tôi cũng rất sẵn lòng thiết kế chữ ký cho các tác giả khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570319,
					"content": "Còn chuyện khắc con dấu cứ giao cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570320
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570320,
					"content": "Vậy thì bây giờ tôi sẽ liên hệ thêm với hai tác giả khác trong buổi ra mắt sách mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570321
					],
					"speakerTitle": "Hirayama"
				},
				{
					"id": 400570321,
					"content": "Không lâu sau, hai tác giả đã đến...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570322
					]
				},
				{
					"id": 400570322,
					"content": "Thật vinh dự khi có được chữ ký do họa sĩ Vôi Trắng thiết kế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570323
					],
					"speakerTitle": "Satomi"
				},
				{
					"id": 400570323,
					"content": "Bởi vì chữ ký của tôi rất phức tạp, không thích hợp để ký trong buổi ký tặng, bây giờ cuối cùng tôi cũng có thể thực hiện được tâm nguyện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570324
					],
					"speakerTitle": "Kadenokouji Kenzaburou"
				},
				{
					"id": 400570324,
					"content": "Tuyệt quá, xem ra mọi người đều đồng ý với đề xuất này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570325,
					"content": "Khiến Zhenyu bận rộn nhiều ngày như vậy thật ngại quá, mấy ngày tới hãy nghỉ ngơi cho lại sức nhé, những việc còn lại cứ giao cho chúng tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570326
					],
					"speakerTitle": "Hirayama"
				},
				{
					"id": 400570326,
					"content": "Những cuốn sách có chữ ký này cũng sẽ được sử dụng để làm giải thưởng đặc biệt cho các sự kiện sắp tới của Nhà Xuất Bản Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570327
					],
					"speakerTitle": "Hirayama"
				},
				{
					"id": 400570327,
					"content": "Phù... Được cứu rồi, được cứu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570328
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 400570328,
					"content": "Nhờ sự giúp đỡ của mọi người mà tôi và Onodera mới có thể thoát khỏi bể khổ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570329
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 400570329,
					"content": "Hì hì, cuối cùng thì Xingqiu cũng được tự do rồi, đi ra ngoài hít thở không khí trong lành thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
