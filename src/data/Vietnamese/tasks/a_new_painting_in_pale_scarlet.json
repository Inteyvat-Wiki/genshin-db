			},
			"dialogs": [
				{
					"id": 400570701,
					"content": "Kazuha, sao vậy? Nãy giờ anh cứ đứng ở bức tranh trống này một mình, sắc mặt cũng không được tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570702,
					"content": "Xin lỗi, mặc dù đây chỉ là suy đoán của chúng tôi, nhưng có phải câu chuyện về Ngũ Ca Tiên đã khiến anh nghĩ đến điều gì đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570703
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570703,
					"content": "Đúng là lúc nãy tôi có nghĩ đến một số chuyện, nhưng đó chỉ là những chuyện cũ về gia đình tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570704
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570704,
					"content": "Mặc dù tôi không ngại nói với mọi người, nhưng tôi cảm thấy không nên làm phiền các bạn thêm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570705
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570705,
					"content": "Kazuha, chúng ta đều là bạn của nhau, không có chuyện làm phiền nhau gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570706,
					"content": "Kaedehara, tôi mạo muội hỏi một câu, chuyện anh đang nghĩ đến có phải liên quan đến \"Raiden Gokaden\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570707
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570707,
					"content": "\"Raiden Gokaden\" là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570708,
					"content": "Xem ra tôi và tiểu thư Kamisato đang nghĩ về cùng một chuyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570709
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570709,
					"content": "Chuyện này cũng liên quan không ít đến Hiệp Hội Yashiro, không biết cô có đồng ý để tôi kể cho mọi người nghe không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570710
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570710,
					"content": "Tất cả mọi người có mặt ở đây đều là những người đáng tin cậy, anh cứ nói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570711
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570711,
					"content": "Có điều chuyện này giải thích ra có hơi phức tạp, hay là để tôi bắt đầu kể từ chuyện của \"Raiden Gokaden\" nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570712
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570712,
					"content": "Như các vị đã biết, Hiệp Hội Yashiro chủ yếu quản lý hoạt động tế lễ và kế thừa văn hóa, mà \"kỹ năng rèn đao\" của Inazuma cũng là một phần cực kỳ quan trọng trong số đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570713
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570713,
					"content": "\"Raiden Gokaden\" từng là năm phái rèn đao hàng đầu của Inazuma, mặc dù năm gia tộc này là thợ rèn đao, nhưng cũng đảm nhiệm rất nhiều chức vụ trong Hiệp Hội Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570714
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570714,
					"content": "Chỉ đáng tiếc, Raiden Gokaden bây giờ chỉ còn lại \"Trường Phái Amenoma\" là có sư đồ kế thừa, \"Trường Phái Isshin\" mặc dù đã thất truyền, nhưng may là hậu nhân vẫn còn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570715
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570715,
					"content": "Mà nhà Kaedehara chính là hậu duệ của \"Isshin\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570716
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570716,
					"content": "Chúng ta chỉ biết nhà Kazuha từng là quý tộc, nhưng không ngờ còn liên quan tới cả Hiệp Hội Yashiro và nghề rèn đao luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570717,
					"content": "Ừm, nhưng đây đều là chuyện rất lâu về trước rồi, \"Trường Phái Isshin\" đã biến mất từ thời ông cố tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570718
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570718,
					"content": "Ông nội tôi bất mãn với hành động của ông cố, khi còn trẻ, ông đã du lịch khắp Teyvat để tìm cách vực dậy công việc kinh doanh của gia đình, nhưng không may là ông đã không thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570719
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570719,
					"content": "Và đến đời tôi thì cả ngôi nhà tổ tiên cũng không còn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570720
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570720,
					"content": "Trước đây tôi có nghe anh trai tôi nói, \"Raiden Gokaden\" suy tàn rất nhanh, chỉ trong vài thập kỷ ngắn ngủi, ba gia đình đã phải chịu nhiều bất hạnh, và cuối cùng là biến mất hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570721
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570721,
					"content": "Sau đó có người đoán rằng, những bất hạnh này thực ra là kết quả của sự thao túng bí mật, có kẻ muốn xóa sổ \"Raiden Gokaden\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570722
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570722,
					"content": "Nhưng vì Raiden Gokaden vẫn chưa hoàn toàn biến mất, nên cuối cùng cũng chỉ được coi là một tin đồn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570723
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570723,
					"content": "Đúng vậy, lúc trước tôi cũng luôn nghĩ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570724
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570724,
					"content": "Nhưng tôi biết, có \"một chuyện lớn\" đã xảy ra với ông cố tôi khi ông ấy còn trẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570725
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570725,
					"content": "Chuyện đó không chỉ liên lụy đến gia tộc Kaedehara chúng tôi, mà thậm chí suýt chút nữa còn làm lung lay địa vị của nhà Kamisato trong Hiệp Hội Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570726
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570726,
					"content": "Sau khi tôi đọc câu chuyện của Ngũ Ca Tiên, tôi mơ hồ nhận ra rằng nó dường như đang nhắc nhở tôi về sự thật của vụ việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570727
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570727,
					"content": "Kazuha, rốt cuộc năm đó đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570728,
					"content": "Về một số chi tiết của sự việc đó, tôi vẫn cần tìm người xác minh, hẹn mọi người gặp nhau ở đây vào trưa mai nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570729
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570729,
					"content": "Đến lúc đó, tôi sẽ nói cho mọi người tất cả những gì tôi biết một cách chi tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
