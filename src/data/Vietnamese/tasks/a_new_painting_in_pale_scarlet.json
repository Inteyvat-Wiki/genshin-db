			"dialogs": [
				{
					"id": 400570501,
					"content": "Cẩn thận nhúng giấy vào trong nước...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570502
					]
				},
				{
					"id": 400570502,
					"content": "Woa, nhìn nè, đúng là đã có rất nhiều chữ xuất hiện rồi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570503,
					"content": "Mau đưa tôi xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570504,
					"content": "Ừm... Câu chuyện kể rằng, sau khi Sumizome lấy được tập thơ của Akahito, thì đã để tập thơ đó dưới suối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570505,
					"content": "Sau đó, những chữ đạo văn trong bài thơ bị mờ đi... Tại sao lại như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570506,
					"content": "Paimon, trước đây khi nghề in chưa phát triển, chữ viết tay trên sách rất dễ bị mờ do độ ẩm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570507
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570507,
					"content": "Để giữ nét chữ được lâu hơn, người ta thường viết bằng một loại mực chuyên dụng, hoặc sau khi viết xong, người ta sẽ quét một lớp sơn chống thấm lên giấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570508
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570508,
					"content": "Chế tác loại mực đặc biệt này tốn rất nhiều thời gian và công sức, và cách đánh sơn cũng không hề đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570509
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570509,
					"content": "Nhưng mà, tập thơ của Akahito là một vật quan trọng để trình lên cho Shogun, lẽ ra phải dùng một trong trong hai cách này mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570510
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570510,
					"content": "Nhưng bài thơ chép lại bây giờ không chỉ thiếu con dấu của Akahito, mà tình trạng nét chữ sau khi gặp nước cũng rất khác so với các loại giấy khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570511,
						400570512
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570511,
					"content": "Bài thơ này không phải do Akahito viết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570513
					]
				},
				{
					"id": 400570513,
					"content": "Cũng tức là Akahito không hề làm chuyện xấu, anh ta bị hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570514,
					"content": "Đúng vậy, đây là sự thật mà câu chuyện của Sumizome muốn nói với chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570515,
					"content": "Mặc dù câu chuyện khiến người ta thổn thức, nhưng nội dung của hai bức tranh \"Akahito\" và \"Sumizome\" bây giờ đã có thể quyết định được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570516,
					"content": "Kazuha, Ayaka, hai bạn có đồng ý làm người mẫu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570517,
					"content": "Đương nhiên là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570518
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570518,
					"content": "Tôi cũng không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570519
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400570519,
					"content": "Tuyệt quá, vậy là có thể hoàn thành hai bức tranh cùng một lúc rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570520,
					"content": "Ừm, bây giờ cả bốn câu chuyện đều đã thu thập đủ rồi, câu chuyện của Ngũ Ca Tiên cuối cùng cũng có thể hoàn thành rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570512,
					"content": "Nó đã được thêm vào sau đó bởi những người khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570513
					]
				}
			]
		},
