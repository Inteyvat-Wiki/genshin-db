					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570403,
					"content": "Ủa, là Ayaka và Venti... Sao hai người lại đi chung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570404,
					"content": "Chuyện là lúc nãy khi tôi đến hội trường để chuẩn bị cho lớp cắm hoa, tôi đã nhìn thấy một mảnh giấy bí ẩn trên kệ hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570405
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570405,
					"content": "Đúng lúc nhà thơ này cũng có mặt ở đó, tôi nghe anh ấy nói mấy hôm nay mọi người cũng phát hiện những thứ như vậy, cho nên tôi đã cùng anh ấy đến đây tìm các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570406
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570406,
					"content": "Nhưng mảnh giấy mà vị tiểu thư này tìm được không giống với của chúng ta tìm được cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 400570407,
					"content": "Mảnh giấy ở đây, mọi người xem thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 400570408,
					"content": "Các bài thơ trước đều có độ dài như nhau, nhưng lần này thì chỉ có hai câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400570409,
					"content": "Đúng là chỉ có hai câu ngắn gọn, lại không có tiêu đề, cũng không được viết ở giữa tờ giấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570410
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570410,
					"content": "Vị trí của bút tích như muốn nói với chúng ta rằng ngoài hai câu thơ này, sẽ còn có điều gì khác trên mảnh giấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570411
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400570411,
					"content": "Nếu hiểu bài thơ này theo nghĩa đen, nó sẽ là \"bỏ giấy vào nước, sự thật sẽ xuất hiện.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570412
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 400570412,
					"content": "Nói mới nhớ, trong nhà tôi có một cuốn sách cổ chuyên kể về những giai thoại và điển tích xưa, trong sách có nhắc đến một loại mực đặc biệt, có thể hiện chữ khi gặp nước và biến mất khi khô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570413
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 400570413,
					"content": "Vậy chúng ta thử xem nhé? Vừa hay gần đây cũng có một bể nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
