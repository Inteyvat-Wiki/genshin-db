				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180301,
					"content": "#{NICKNAME} và Paimon, các bạn ở đây à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180302
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180302,
					"content": "Ồ! Là Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180303,
						705180304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180303,
					"content": "Xin chào, Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				},
				{
					"id": 705180305,
					"content": "Ừm, Lễ Hội Rượu vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180306,
					"content": "Lễ Hội Rượu là một trong những lễ hội sôi động nhất ở Mondstadt, tôi rất vui vì có thể gặp được các bạn trong lúc này, hy vọng các bạn cũng sẽ thích Lễ Hội Rượu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180307
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180307,
					"content": "Nhắc mới nhớ, hồi nãy tôi nghe anh Georg nói, các bạn muốn thu thập \"Pha Lê Fairbrew\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180308
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180308,
					"content": "Tôi hơi tò mò, các bạn đang giúp Đội Kỵ Sĩ bán hàng từ thiện hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180309
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180309,
					"content": "Đúng vậy, chúng tôi cũng là một phần của Đội Kỵ Sĩ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180310,
					"content": "Bây giờ cửa hàng vẫn chưa mở, chúng tôi phải chạy thêm vài chuyến, gom góp vốn để mở tiệm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180311,
					"content": "Tuy chưa biết sau khi mở tiệm sẽ gặp phải những vấn đề gì, nhưng chắc chắn chúng tôi sẽ có thể giải quyết tất cả rắc rối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180312,
					"content": "Thật đáng tin cậy! Hihi... có các bạn giúp đỡ, chắc chắn sẽ đạt được thành công chưa từng có!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180313
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180313,
					"content": "Mong sẽ như lời bạn nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180314
					]
				},
				{
					"id": 705180314,
					"content": "Trước đây khi Đội Kỵ Sĩ tổ chức một đợt bán hàng từ thiện nhỏ, tôi cũng có đến giúp một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180315
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180315,
					"content": "Mặc dù, cách tôi giúp chỉ là đứng trước cửa hàng và hát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180316
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180316,
					"content": "Đúng rồi! Lần đó tôi cũng đã gặp người hát rong tên Venti đó! Anh ấy còn mời tôi hát chung một bài nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180317
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180317,
					"content": "Những bài nhạc anh ấy diễn tấu vừa cổ xưa lại thanh thoát, lúc đầu tôi chỉ dám hát nhỏ giọng, sợ chỗ nào không đúng sẽ phá hỏng bầu không khí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180318
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180318,
					"content": "May mà anh ấy đã dùng hòa âm để hướng dẫn tôi, rồi chúng tôi đã nhanh chóng tìm được cảm giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180319
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180319,
					"content": "Cuối cùng, các thính giả đều rất thích thú, hàng hóa cũng bán cực kỳ chạy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180320
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180320,
					"content": "Thì ra Barbara và tên hát rong đã từng hợp tác chung với nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180321,
					"content": "Tôi cũng có chút muốn nghe đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180322
					]
				},
				{
					"id": 705180322,
					"content": "Ừm, chỉ tiếc là thời gian không ủng hộ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180323
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180323,
					"content": "Trong thời gian Lễ Hội Rượu, Giáo Hội Tây Phong sẽ tổ chức ca hát đặc biệt ở nơi phong cảnh tươi đẹp, tôi còn phải tham gia tập luyện nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180324,
						705180325
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180324,
					"content": "Barbara cứ đi đi, không sao đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180326,
					"content": "Ừm, đều là công việc rất có ý nghĩa, chúng ta ai nấy đều hãy cố gắng hết sức mình nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180327,
					"content": "Cảm ơn các bạn! Tuy không thể ở lại đây để hát, nhưng tôi cũng muốn làm điều gì đó cho mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180328
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180328,
					"content": "Tôi... tôi sẽ quảng cáo cửa hàng của các bạn cho mọi người biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180329
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180329,
					"content": "Ừm... Nên làm thành một áp phích lớn, hay là tờ rơi đây nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180330
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180330,
					"content": "Thiết kế khẩu hiệu quảng bá! Đính kèm chữ ký thì sẽ có thành ý hơn không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180331
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180331,
					"content": "Ừm, hay là thông báo đến cho từng người thì sẽ hay hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180332
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180332,
					"content": "Wow, có Barbara giúp quảng cáo thì độ nổi tiếng của cửa hàng sẽ được nhân rộng nhanh thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180333,
						705180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180333,
					"content": "Làm phiền Barbara rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180335,
					"content": "Đó là việc nhỏ mà tôi có thể làm, các bạn nói như vậy, tôi sẽ rất ngại đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180336
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180336,
					"content": "#Vậy tôi sẽ suy nghĩ thêm, cũng sẽ hỏi thêm những người khác về kinh nghiệm quảng bá. {NICKNAME}, Paimon, chúng ta hẹn gặp lại sau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180337
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180337,
					"content": "...Mọi người trong Đội Kỵ Sĩ và Giáo Hội sẽ rất tự hào về các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180338
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180338,
					"content": "Ừm! Cùng nhau cố lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180339,
					"content": "#Bây giờ tôi càng có động lực hơn rồi! {NICKNAME}, chúng ta phải làm cho thật tốt đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180334,
					"content": "Cố gắng hết sức mình là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180325,
					"content": "Việc bán hàng từ thiện cứ giao cho chúng tôi là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180304,
					"content": "Lễ Hội Rượu vui vẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				}
			]
		},
