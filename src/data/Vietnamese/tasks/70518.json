			},
			"dialogs": [
				{
					"id": 705182401,
					"content": "Giá tiền này... Tuy có hơi đáng tiếc, nhưng nể mặt người quen cũ nên vẫn cứ chốt đơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
			"id": 7051825,
