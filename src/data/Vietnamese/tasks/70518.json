					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182301,
					"content": "Tốt đấy, giá rất sát với năm trước, chốt đơn thành công nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
			"id": 7051824,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
