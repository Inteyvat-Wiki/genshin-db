					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182601,
					"content": "Như thường lệ, tôi sẽ sắp xếp người giao những thức uống này trực tiếp đến cửa hàng của anh Shevirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182602
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705182602,
					"content": "Các bạn cứ yên tâm, nhớ giữ kỹ phần biên lai này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182603
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705182603,
					"content": "Được rồi, tiếp theo chúng ta cứ tiếp tục chuẩn bị kinh phí, mục tiêu là thu thập đủ \"Pha Lê Fairbrew\" càng sớm càng tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705182604,
					"content": "Theo Bernhard thì cách làm có thể tự chọn, chỉ cần chuẩn bị đủ vốn là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705182605,
					"content": "Sau khi khách ở nơi khác đặt hàng, sẽ nhận được một khoản phí, không cần phải bán nhiều nguyên liệu nấu rượu như vậy cho những thương nhân buôn rượu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705182606,
					"content": "Nhưng để đề phòng bất trắc, chúng ta hãy đến chỗ những thương nhân buôn rượu khác xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
