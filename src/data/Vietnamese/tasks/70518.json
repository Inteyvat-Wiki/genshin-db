	"talks": [
		{
			"id": 7051801,
			"completionStepIds": [
				7051804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051804",
							"2"
						],
						"stepId": 7051804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Bernhard"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180101,
					"content": "Xin dừng bước! Kỵ Sĩ Danh Dự tiếng tăm lừng lẫy, và cả \"người dẫn đường giỏi nhất Teyvat\" Paimon này nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180102,
					"content": "Xin các bạn hãy giúp tôi một việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180103
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180103,
					"content": "Ấy! Có người gọi tôi như thế sao? Cuối cùng biệt danh của tôi cũng đã lan rộng rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180140,
					"content": "Đợi đã... sao có cảm giác anh hơi quen quen nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180104,
					"content": "Chúng ta đã từng gặp nhau ở đại sảnh của tổng bộ Đội Kỵ Sĩ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180105
					]
				},
				{
					"id": 705180105,
					"content": "Đúng vậy, tôi là Kỵ Sĩ Tây Phong Bernhard, thuộc tiểu đội hậu cần của đội trưởng Hertha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180106,
					"content": "Theo lễ nghi cơ bản, lẽ ra trước tiên tôi phải làm quen với bạn... Nhưng thời gian quá eo hẹp, tôi chỉ có thể mặt dày cầu xin bạn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180107
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180107,
					"content": "Xin bạn hãy giúp đỡ, cứu lấy hoạt động bán hàng từ thiện lần này của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180108
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180108,
					"content": "Cứu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180109
					]
				},
				{
					"id": 705180109,
					"content": "Hoạt động bán hàng từ thiện... Hình như từng nghe đội trưởng Jean nhắc đến thì phải. Anh đang gặp phải rắc rối gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180110,
					"content": "Là thế này, Đội Kỵ Sĩ Tây Phong định mở một cửa hàng trong Lễ Hội Rượu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180111
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180111,
					"content": "Số tiền mà cửa hàng kiếm được sẽ được sử dụng cho việc từ thiện, cung cấp cho trẻ em và người già sống trong điều kiện khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180112
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180112,
					"content": "Các ứng cử viên được quyết định bằng cách rút thăm, tình cờ... rút trúng tôi. Vì để lần bán hàng từ thiện này không bị thất bại, tôi đã tham khảo ý kiến của nhiều người, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180113
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180113,
					"content": "Nhưng thường ngày tôi chỉ phụ trách công việc kho bãi và vận chuyển, đến cả việc bán thứ gì cũng phải suy nghĩ rất lâu, chứ đừng nhắc tới việc kinh doanh cửa hàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180114
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180114,
					"content": "Vì vậy, tôi muốn nhờ các bạn giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180115,
						705180116
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180115,
					"content": "Tôi hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				},
				{
					"id": 705180117,
					"content": "Đúng thế đúng thế, anh nói chuyện không cần phải khách sáo như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180118,
					"content": "Theo như anh nói, hoạt động bán hàng từ thiện là vì trẻ em và người già ở Mondstadt mà, việc này rất có ý nghĩa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180119,
					"content": "#{NICKNAME} là Kỵ Sĩ Danh Dự, tôi cũng là bạn cũ của Đội Kỵ Sĩ, chia sẻ một chút trách nhiệm cũng chẳng đáng là bao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180120,
						705180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180120,
					"content": "Hãy để chúng tôi góp một phần sức lực của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180122,
					"content": "Cảm ơn các bạn nhiều lắm! Vậy tôi sẽ nói ngắn gọn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180123
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180123,
					"content": "Trước khi bắt đầu hoạt động, chúng ta cần chuẩn bị <color=#00E1FFFF>\"Pha Lê Fairbrew\"</color>. Đây là nguồn vốn chính để kinh doanh cửa hàng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180124
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180124,
					"content": "Những tiệm rượu gần đây đều đang rất cần nguyên liệu ủ rượu, bán nguyên liệu cho họ thì sẽ có thể lấy được \"Pha Lê Fairbrew\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180125
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180125,
					"content": "Ngoài ra, một số khách nước ngoài cũng muốn mua đồ uống số lượng lớn trong Lễ Hội Rượu, họ đang tìm người đại diện để hỗ trợ đặt hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180126
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180126,
					"content": "Xuất phát từ suy nghĩ hợp tác lâu dài, số tiền mà những vị khách này đưa ra thường rất hậu hĩnh, cho phép có nhiều cơ hội thương lượng hơn với các nhà phân phối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180127
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180127,
					"content": "Giá tiền chênh lệch này chính là tiền công của chúng ta, cũng có thể đổi thành \"Pha Lê Fairbrew\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180128
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180128,
					"content": "Nói cách khác, nhiệm vụ của chúng ta là cung cấp nguyên liệu ủ rượu cho các thương nhân buôn rượu, giúp khách bên ngoài đặt hàng và trả giá, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180129,
					"content": "Hoàn toàn không khó như tôi nghĩ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180130,
					"content": "Đều là những việc chuyên môn của chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180131
					]
				},
				{
					"id": 705180131,
					"content": "Thật, thật sao? Vậy thì tốt quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180132
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180132,
					"content": "Tôi đã nhận được một đơn đặt hàng ở đây, anh Shevirme từ Sumeru muốn đặt <color=#00E1FFFF>50 rương \"Hương Vị Lễ Hội\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180133
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180133,
					"content": "Thức uống này có thể mua ở <color=#00E1FFFF>cửa hàng \"Quà Tặng Của Thiên Sứ\"</color>, chủ tiệm là <color=#00E1FFFF>Georg</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180134
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180134,
					"content": "Georg khá hiền lành, nhưng cũng không chịu làm ăn lỗ vốn đâu. Các bạn phải cân nhắc kỹ giá cả để giao dịch với Georg nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180135
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180135,
					"content": "Tôi sẽ tiếp tục dựng cửa hàng trước. Khi các bạn chuẩn bị đủ \"Pha Lê Fairbrew\" thì hãy quay lại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180136
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180136,
					"content": "Còn những nguyên liệu khác liên quan đến cửa hàng thì không cần các bạn phải lo nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180137
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180137,
					"content": "Tôi đã liên hệ với nguồn cung rồi, chỉ đợi tiền vào là họ sẽ giao hàng đến ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180138
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180138,
					"content": "Được rồi! Vậy việc sắp xếp cửa hàng giao cho anh, còn việc chuẩn bị vốn cứ giao cho chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180139,
					"content": "Hai vị đã giúp tôi cả một việc lớn, vất vả rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180121,
					"content": "Chúng tôi phải làm gì đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180116,
					"content": "Mỗi người đều có thứ không phải sở trường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				}
			]
		},
		{
			"id": 7051802,
