				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180201,
					"content": "Xin chào anh Georg. Chúng tôi là người đại diện của anh Shevirme, muốn thay anh ấy mua 50 rương \"Hương Vị Lễ Hội\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180202,
					"content": "Ồ? Anh Shevirme à? Là khách quen của tôi, số lượng đặt hàng hiếm khi có thay đổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705180203,
					"content": "Trở lại chuyện chính, năm nay các bạn định trả bao nhiêu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
			"id": 7051803,
