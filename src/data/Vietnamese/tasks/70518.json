			},
			"dialogs": [
				{
					"id": 705182201,
					"content": "Mặc dù năm nay được mùa bội thu, giá thành sản xuất rượu giảm nhiều so với những năm trước, nhưng mức giá này vẫn hơi khó chấp nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
			"id": 7051823,
