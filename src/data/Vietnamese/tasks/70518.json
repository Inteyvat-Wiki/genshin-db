			"dialogs": [
				{
					"id": 705182501,
					"content": "Thật ngại quá, tôi thực sự không thể chấp nhận con số thấp như vậy. Nếu các bạn vẫn muốn đặt hàng thì hãy đồng ý với mức giá tôi đã nói.",
					"roleType": "TALK_ROLE_NPC",
