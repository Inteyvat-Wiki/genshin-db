			"dialogs": [
				{
					"id": 101100203,
					"content": "Bạn xem, đó là người bạn tưởng tượng của cô ấy. Ừm, một cái cây mong manh... là quả bồng bồng.",
					"roleType": "TALK_ROLE_NPC",
