			"dialogs": [
				{
					"id": 101100101,
					"content": "#{NICKNAME}, nhìn bên kia nhìn bên kia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100102,
					"content": "Cô ấy, cô ấy đứng một mình đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100103,
					"content": "Nhưng rõ ràng cô ấy đang nói chuyện với người khác! Bạn xem, cô ấy còn cười nữa! Huhuhu, đáng sợ quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100104,
					"content": "Lúc nhỏ tôi cũng hay chơi với \"người bạn tưởng tượng\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#Hả? {NICKNAME}, trước đây bạn cũng làm những chuyện như vậy sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100106,
					"content": "Lẽ nào là ảo giác? Hay là thật sự có loại bạn không thể nhìn thấy chơi cùng bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100107,
					"content": "Ảo giác chính là người bạn tưởng tượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "Người bạn tưởng tượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100111,
					"content": "Ồ, vậy là \"người bạn tưởng tượng ra\" à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100112,
					"content": "Người bạn tưởng tượng của bạn trông thế nào, cho tôi xem với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100113,
					"content": "Bây giờ không hay xuất hiện nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "Ơ? Lẽ nào \"người bạn tưởng tượng\" sẽ biến mất khi con người ta lớn lên sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100116,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#Ừm... Tôi còn muốn xem xem thế nào... Đúng rồi, {M#em gái}{F#anh trai} của bạn cũng là người bạn tưởng tượng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100119,
					"content": "Có thật đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "Nếu có thì quá tiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100121,
					"content": "Bạn đã từng nghe đến trò chơi bài của Liyue chưa? Thường thì có bốn người chơi, nhưng hai người các bạn cũng chơi được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100122,
					"content": "Nhà Lữ Hành! Thật trùng hợp, các bạn cũng ở đây à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100123,
					"content": "Tên hát rong, sao lại là bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100124,
					"content": "Haha, là vì dạo gần đây Lisa đã làm một số thứ rất thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100125,
					"content": "Cái \"thú vị\" mà Lisa nói làm tôi thấy sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100126,
					"content": "Hì, đừng đánh giá một quý cô như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100127,
					"content": "Để làm thứ thú vị đó, cô ấy đã đến chỗ Sumeru lấy một số nguyên liệu nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100128,
					"content": "Bạn vừa nói \"nguy hiểm\" đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100129,
					"content": "Có phải là máy dò có hình dạng mắt kính không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "Đúng vậy, tuy trông giống kính một mắt, nhưng nó lại là một chiếc máy dò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100133,
					"content": "Tiếc là Lisa không dùng được, nên tôi mượn nó về chơi, tiện thể giúp cô ấy thử nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100134,
					"content": "Ơ? Tại sao Lisa lại không dùng được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100135,
					"content": "Chuyện này à... Phải nói là thiếu một chút hồn nhiên của trẻ con? Hay là vì nguyên nhân nào khác nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100136,
					"content": "Lần sau gặp các bạn tự hỏi cô ấy là biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100137,
					"content": "Vậy bạn có nhìn thấy không Venti? Mau nói cho tôi biết, người bạn tưởng tượng của tên đó trông thế nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100138,
					"content": "Ừm, chuyện này à... bí mật ^_^",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100139,
					"content": "Tóm lại đồ đã đưa cho bạn rồi, bạn thử đi, xem \"người bạn tưởng tượng\" của Nora đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100140,
					"content": "Thế nào thế nào? Thấy được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100141,
					"content": "Là có thật!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "Đúng là sau khi đeo lên bạn cũng có thể nhìn thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100144,
					"content": "Đáng ghét, tôi cũng muốn xem! Nhưng kích thước này tôi không đeo được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100145,
					"content": "#{NICKNAME}, vậy phải nhờ bạn rồi! Chúng ta đi xem người bạn tưởng tượng của <color=#00E1FFFF>người khác</color> trông thế nào đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100142,
					"content": "Là một đứa trẻ trông rất hợp với cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "Trông giống kính một mắt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "Đúng chứ? Tôi cũng cảm thấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100117,
					"content": "Thật đáng tiếc, nhưng thật sự là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "Không còn nhìn thấy nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "Người bạn tưởng tượng chính là ảo giác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "Ảo giác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
