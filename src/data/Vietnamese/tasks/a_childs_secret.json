						101100204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100204,
					"content": "Người bạn tưởng tượng cũng có thể là cây sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100205,
					"content": "Hihi, Nhà Lữ Hành, nhà thơ, chào các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100206,
					"content": "Chào bạn, tôi có thể hỏi bạn một chuyện không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "Được thôi, tìm Flora có việc gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100209,
					"content": "Bên cạnh bạn là...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "Ơ? Bạn có thể nhìn thấy Bồng Bồng? Những người khác không thấy được Bồng Bồng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "Flora"
				},
				{
