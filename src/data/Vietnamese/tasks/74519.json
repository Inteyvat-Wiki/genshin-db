					"Noelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "A... Chào tiền bối! Tiền bối đến tìm Đội Trưởng Jean à? Hay là... có gì cần tôi giúp đỡ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190402,
					"content": "Tôi chỉ đang đi dạo quanh đây thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "Tôi đang tổng vệ sinh định kỳ khu vực làm việc của Đội Kỵ Sĩ. Hiện tại cơ bản đã dọn xong bụi bặm, tiếp theo là sắp xếp lại hồ sơ cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190405,
					"content": "Những tài liệu đó chất đống rất lâu rồi, tôi nghĩ nếu có thể phân loại chúng theo từng mục, sau này mọi người tra cứu sẽ thuận tiện hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190406,
					"content": "Hơn nữa, việc sắp xếp lại ghi chép của người đi trước cũng giúp tôi học hỏi được rất nhiều. Với tôi thì đây cũng là một cách rèn luyện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190407,
					"content": "Noelle vẫn luôn đáng tin cậy và chăm chỉ như vậy nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "Đây là trách nhiệm tôi cần hoàn thành mà. Hơn nữa, tiền bối và mọi người trong Đội Kỵ Sĩ đều không ngừng tiến bộ, tôi cũng muốn sớm đuổi kịp mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190409,
					"content": "Vậy để kỷ niệm quyết tâm này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "Ơ? Tiền bối muốn chụp hình à? Tôi... đương nhiên rất sẵn lòng! Nhưng tôi vừa dọn dẹp xong, người còn dính đầy bụi bẩn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190412,
					"content": "Cái tôi muốn chụp chính là dáng vẻ nỗ lực của Noelle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "Danh, danh hiệu này vẫn còn quá sớm đó! Nhưng nếu tiền bối muốn chụp... thì dù có dính bụi, tôi cũng cảm thấy rất vinh hạnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190415,
					"content": "#Vậy xin hãy ấn nút chụp vào thời điểm {F#cô}{M#cậu} cho là thích hợp nhất nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190413,
					"content": "Đây là \"khoảnh khắc quyết định\" của Kỵ Sĩ Hầu Gái!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "Để tôi chụp cho cô một bức hình nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "Noelle đang bận gì thế nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
