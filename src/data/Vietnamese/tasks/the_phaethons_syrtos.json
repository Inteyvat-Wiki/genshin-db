					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "Bảy ngọn đèn linh hồn đã sáng lên rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440302,
					"content": "Xem ra các bạn đã hoàn thành việc kính viếng giúp tôi, tôi sẽ mãi khắc ghi trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440303,
					"content": "Vậy, tôi sẽ giúp các bạn mở ra... con đường dẫn đến Khu Dẫn Hồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440304,
					"content": "Lữ khách phương xa, tuy tôi đã mang đến nhiều phiền phức cho bạn...nhưng tôi vẫn hy vọng bạn có thể chứng kiến nghi thức an hồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440305,
					"content": "Hãy đi theo con đường đó nhé, tôi sẽ đợi bạn ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224404,
