	"talks": [
		{
			"id": 7224401,
			"completionStepIds": [
				7224401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
