			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "Nhà lữ hành, bạn đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440402,
					"content": "Nơi này chính là Khu Dẫn Hồn, cũng chính là nơi chứa đựng chấp niệm cuối cùng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440403,
					"content": "Người Con Của Mặt Trời mỗi khi đến một độ tuổi nhất định sẽ được tổ chức điển lễ, được rước vào Dainichi Mikoshi trong ngày sinh nhật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440404,
					"content": "Rước vào Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Đúng vậy, cái gọi là rước vào Dainichi Mikoshi, chính là \"Tế Lễ Trở Về\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440407,
					"content": "Người Con Của Mặt Trời được sinh ra từ Dainichi Mikoshi, và chúng sẽ trở lại ngai vị của mặt trời trước khi thế giới phàm trần làm nhơ bẩn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440408,
					"content": "...Nhiệt độ của Dainichi Mikoshi cao đến mức ánh sáng của nó có thể sưởi ấm cả Vương Quốc Đêm Trắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440409,
					"content": "Những Người Con Của Mặt Trời, đến cuối cùng khi trở về Khu Dẫn Hồn thì chỉ còn lại tàn hồn lạc phách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440410,
					"content": "Nhưng tôi nghĩ rằng, có lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440411,
					"content": "Có lẽ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "Có lẽ nếu tôi mở Khu Dẫn Hồn ra, sẽ có thể dùng ký ức của tôi để bổ sung những gì còn lại trong tàn hồn của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440426,
					"content": "Để tôi thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440427,
					"content": "Pirarumon...Orupeusu...thần ở đây, hai vị còn chưa quay về sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440429,
					"content": "Thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "Haiz, trong 7 Người Con Của Mặt Trời, Pirarumon và Orupeusu là do tôi nuôi lớn, nếu ngay cả chúng cũng không muốn trả lời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440413,
					"content": "Dường như ký ức của một mình tôi vẫn không đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440414,
					"content": "Nếu có gì đó làm trung gian, nếu có dây cương tượng trưng cho thân phận Người Con Của Mặt Trời thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440415,
					"content": "Tiếc rằng Dây Cương đó sớm đã bị mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440416,
					"content": "Ôi... vương quốc này, Vương Quốc Đêm Trắng, vẫn còn đang trút cơn giận lên Người Con Của Mặt Trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440417,
					"content": "Xem ra, việc giải phóng tàn hồn của chúng đến cuối cùng cũng chỉ là giấc mơ viễn vông của tôi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440418,
					"content": "...Nhà lữ hành, xem như đây là lần nhờ vả cuối cùng của tôi... có thể tìm lại Dây Cương Thánh Thần cho tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440419,
					"content": "Tuy cơ hội để tìm được không lớn. Bạn cũng đã giúp tôi rất nhiều rồi, đưa ra yêu cầu này quả thật có hơi vô sỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440420,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440421,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "Vậy... vậy cảm ơn bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440424,
					"content": "Dây Cương bị mất đã lâu, cũng không thể tìm lại trong một sớm một chiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440425,
					"content": "Nếu như có tin tức thì cứ đến chỗ tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440422,
					"content": "Tôi sẽ cố gắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "Vậy có nghĩa là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
