			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Clymene",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "Hmm? Thật kỳ lạ, tôi đã rất lâu rồi chưa thấy qua người ăn mặc như bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440102,
					"content": "Cả cử chỉ và hành động, hình như không phải là cư dân Vương Quốc Đêm Trắng đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440103,
					"content": "Không lẽ, bạn là lữ khách từ bên ngoài lạc vào đây sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440104,
					"content": "Đúng vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "Thật không ngờ, Vương Quốc Đêm Trắng cũng có con đường thông ra thế giới bên ngoài sao... thật đáng kinh ngạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440106,
					"content": "Nói ra thì, tôi từ khi ra đời đã ở trong Vương Quốc Đêm Trắng, cho nên chưa từng thấy người bên ngoài qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440107,
					"content": "Trước đó từng có người đề cập qua chuyện này với tôi, nói là muốn ngắm nhìn thế giới bên ngoài. Lúc đó tôi còn tưởng người đó nói đùa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440108,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440109,
					"content": "Nhà lữ hành, thực ra tôi có chuyện cần nhờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440110,
					"content": "Ở quanh Vương Quốc Đêm Trắng có 7 Bia Mộ Ngự Lăng chôn cất di hài \"Người Con C{RUBY#[D]Phaethon}ủa Mặt Trời\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440111,
					"content": "Người Con Của Mặt Trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440112,
					"content": "Ừm, Vương Quốc Đêm Trắng kính trọng Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440113,
					"content": "Mỗi cách vài năm sẽ có một đứa trẻ mới chào đời được chọn làm Người Con Của Mặt Trời, quản lý vương quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440114,
					"content": "Tổng cộng có 7 vị... Người Con Của Mặt Trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440115,
					"content": "Ở Vương Quốc Đêm Trắng rất khó gặp được lữ khách phương xa, cho nên phiền bạn đến trước bia mộ của họ kính viếng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440116,
					"content": "Ủa, nhưng mà tại sao phải cần những người ngoài như tôi đến kính viếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440117,
					"content": "Thông thường mà nói, người quen đi kính viếng sẽ tốt hơn chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440118,
					"content": "Chiếu theo lý mà nói thì đúng là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440119,
					"content": "Haiz, chỉ là, cư dân của Vương Quốc Đêm Trắng không ai muốn đi kính viếng họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440120,
					"content": "Thậm chí những ngôi mộ đó đã lâu rồi chưa có người bái tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440121,
					"content": "Nhưng mà... tại sao lại vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440122,
					"content": "Không lẽ cư dân ở đây đều không ưa Người Con Của Mặt Trời sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440123,
					"content": "Thay vì nói không ưa... chi bằng nói là uất hận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440124,
					"content": "Ban nãy tôi có nói, những đứa trẻ đó vừa chào đời là trở thành Người Con Của Mặt Trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440125,
					"content": "Những đứa trẻ như thế làm sao có thể quản lý vương quốc chứ, cho nên việc của vương quốc đều được đưa đến những đại nhân đứng sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440126,
					"content": "Người Con Của Mặt Trời chỉ là bù nhìn nghe theo sắp đặt của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440127,
					"content": "Thế nhưng... đám người đó quá tham lam, bóc lột người dân, thao túng Người Con Của Mặt Trời, làm đủ chuyện ác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440128,
					"content": "Do đó, người dân phẫn nộ, quy rất nhiều lỗi lầm về phía Người Con Của Mặt Trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440129,
					"content": "Sao lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440130,
					"content": "Người Con Của Mặt Trời rõ ràng vô tội mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440131,
					"content": "...Không, chúng không bị oan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440132,
					"content": "Đối với cư dân Vương Quốc Đêm Trắng mà nói, sự vô tri từ Người Con Của Mặt Trời mới là lỗi lầm lớn nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440133,
					"content": "Những tội lỗi gây hại đến người khác bởi sự vô tri của mình, người như vậy có thể xem là vô tội không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440134,
					"content": "E rằng rất khó, bởi vì tổn thương gây ra đã không thể nào cứu vãn được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440135,
					"content": "Nếu là như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "Xem như là... thỉnh cầu của riêng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440138,
					"content": "Tôi tên là Clymene, là một nữ quan phụ trách việc chăm sóc cho Người Con Của Mặt Trời trong Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440139,
					"content": "Tuy biết rằng những việc chúng làm là sai, cũng biết được chúng đều bị thao túng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440140,
					"content": "Nhưng dẫu sao thì đó cũng là những đứa trẻ mà tôi đã chăm sóc, cảm xúc của tôi đối với chúng, vừa bi ai, vừa tội nghiệp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440141,
					"content": "Tôi chỉ... không thể hận chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440142,
					"content": "Huống chi, tuy với chức vị của tôi, ngày đêm tiếp xúc với Người Con Của Mặt Trời, nhưng xung quanh lại bị giám sát nghiêm ngặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440143,
					"content": "Khi ở bên chúng, tôi không được phép nói ra bất kỳ câu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440144,
					"content": "Những đứa trẻ này, tứ cố vô thân, chúng đã nói với tôi rất nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440145,
					"content": "Nhưng tôi lại không thể đưa ra bất cứ phản ứng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440146,
					"content": "Nếu như, nếu như tôi có dũng khí để hy sinh, có thể nói chuyện gì đó với chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440147,
					"content": "Có lẽ... mọi chuyện sẽ được đổi khác chăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440148,
					"content": "Phiền bạn rồi, đến giờ phút này tôi vẫn không có mặt mũi đi đối mặt với chúng, chỉ có thể dùng cách này để bái tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440149,
					"content": "Chuyện kính viếng, phiền nhà lữ hành giúp tôi lần này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440150,
					"content": "Chỉ cần, đặt một viên Trân Châu San Hô... trước mộ của chúng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440153,
					"content": "Như vậy là có thể thắp sáng U Đăng trên hốc đá ở đây, mở đường đến Khu Dẫn Hồn, và cầu nguyện cho họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440151,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "Cảm ơn, vậy làm phiền các vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440136,
					"content": "Tại sao còn phải đi kính viếng nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
