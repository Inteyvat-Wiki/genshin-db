				"points": []
			},
			"dialogs": [
				{
					"id": 722441101,
					"content": "#Một hai ba... Ừm, {NICKNAME}, hình như đã kính viếng xong bảy bia mộ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722441102,
					"content": "Chúng ta quay về miếu thờ kia để báo cáo với ảo ảnh ở đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224412,
			"completionStepIds": [
				7224425
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224425",
							"2"
						],
						"stepId": 7224425,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Haha, Pirarumon, ngài thích đọc sách, luôn miệng nói rằng có một vùng đất ở ngoài đó, lúc đó thần không tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441202,
					"content": "Thần chỉ luôn lắc đầu cười trừ trước mỗi câu nói ngông cuồng của ngài. Đáng ra thần phải tin vào ngài chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441203,
					"content": "Ngài nói, nếu như có cơ hội, nhất định sẽ trốn khỏi Dainichi Mikoshi để đến với thế giới bên ngoài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441204,
					"content": "Đi đi Pirarumon, giờ đã không còn ai trói buộc ngài cả rồi, cứ đi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441205,
					"content": "Còn nữa, Orupeusu, Orupeusu, thần muốn nghe lại khúc ca của ngài quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441206,
					"content": "Khi nghe thấy khúc ca và chất giọng trong trẻo đó của ngài, ai mà lại không tự hát theo trong lòng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441207,
					"content": "Đêm trước Tế Lễ Trở Về, ngài đột nhiên muốn nghe giọng của thần, dù thế nào cũng muốn thần hát cho ngài nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441208,
					"content": "Nói là không sao đâu, cho dù khó nghe đến đâu thì ngài cũng sẽ không cười.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441209,
					"content": "Có phải ngài đã biết rằng... đã biết rằng Tế Lễ Trở Về đó chính là ngày tàn của bản thân chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441210,
					"content": "Hic... thần đến cuối cùng cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441211,
					"content": "Clymene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "...Xin lỗi nhà lữ hành, tôi thất lễ quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441213,
					"content": "Nữ quan cung phụng cho Người Con Của Mặt Trời, phải giữ bản thân cho thuần khiết... cả đời không được gả cho người ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441214,
					"content": "Cho nên tôi cả đời không có được đứa con của riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441215,
					"content": "Những đứa trẻ này đều do tôi nuôi dưỡng, chứng kiến chúng lớn lên, bất giác cảm thấy thân thiết hơn cả máu mủ ruột thịt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441216,
					"content": "Cảm ơn bạn, nhà lữ hành, cảm ơn bạn đã tìm lại Dây Cương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441217,
					"content": "Dây Cương này đã trải qua nhiều đời Người Con Của Mặt Trời, ký ức chứa đựng trong đó đủ để lấp đầy tàn hồn lạc phách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441218,
					"content": "Dù cho, những ký ức này cũng có hai mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441219,
					"content": "Hai mặt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "Đúng vậy, ký ức chia thành hai loại, một loại là ký ức của bản thân, một loại là ký ức của người khác đối với bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441222,
					"content": "Để bổ sung cho sự tồn tại của họ, đã có ký ức về Người Con Của Mặt Trời trên Dây Cương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441223,
					"content": "Cũng có Dây Cương làm biểu tượng cho sự định tội từ Vương Quốc Đêm Trắng, chứa đựng ký ức của người con mang tội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441224,
					"content": "Ký ức của tôi không đủ để lấp đầy hồn phách của chúng, cho nên chỉ nhờ vào ký ức của người dân Vương Quốc Đêm Trắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441225,
					"content": "Những đứa trẻ này, cũng chính vì tội lỗi của chúng nên mới được Vương Quốc Đêm Trắng ghi nhớ, từ đó lưu lại ảo ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441226,
					"content": "Cảm ơn bạn, nhà lữ hành... tôi đã hoàn thành được ước nguyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441227,
					"content": "Tôi cuối cùng cũng... có thể... an tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441228,
					"content": "Cuối cùng cũng... được ở bên cạnh những đứa trẻ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441220,
					"content": "Ký ức cũng có mặt khác sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
