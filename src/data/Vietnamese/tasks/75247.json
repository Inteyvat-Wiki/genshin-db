			"dialogs": [
				{
					"id": 752470101,
					"content": "Xem ra đây chính là nơi trong ảnh rồi. Hai người họ đều ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470102,
					"content": "Xin chào nhé...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470103,
					"content": "Tông giọng này thì có vẻ như Paimon đang vui nhỉ. Tốt quá rồi, không cần phải cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470104,
					"content": "Paimon có \"tức giận\" cũng không cần phải cảnh giác đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "Đáng ghét! Xem thường ai vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470106,
					"content": "Mời Paimon ăn ngon là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "Hứ, vậy còn tạm được... Không đúng, sao lại nói như kiểu tôi giống với Cacucu vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470108,
					"content": "Thôi vậy, hôm nay tôi là Paimon \"vui vẻ\", không tính toán với mấy người nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470109,
					"content": "Mà Cacucu đâu rồi? Không phải bị Vua Capybara ăn mất rồi đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470110,
					"content": "Hả? Sao lại nói thế chứ, người anh em?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470111,
					"content": "Cacucu đang hợp tác với phe địch để ức hiếp chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470112,
					"content": "Haha, Cacucu ức hiếp hai người họ kìa!? Ororon đùa vui thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470113,
					"content": "Tôi không phải đang đùa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470114,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470115,
					"content": "Vậy kẻ địch là ai đây...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "Nó nói nó tên là \"Cacasha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470117,
					"content": "Hả? Thật sao? Asha biết nói chuyện à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470118,
					"content": "Khoan đã, đừng nghe anh ta nói bậy... Để tôi nói cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470119,
					"content": "Cacucu... Chậc, nó đang chơi trốn tìm với con Asha mà chúng tôi gặp ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470120,
					"content": "Nên chính xác là Cacucu và Cacasha đang chung nhóm để đối phó với chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470121,
					"content": "Cacucu rất nhanh, Cacasha lại rất biết cách ngụy trang... Chúng là những đối thủ khó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470122,
					"content": "Trước khi hai người xuất hiện, chúng tôi đã chơi với chúng rất nhiều ván rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470123,
					"content": "Cacucu rất lợi hại, nhưng tôi từ tâm trạng tự hào ban đầu chuyển thành không còn sức sống rồi đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470124,
					"content": "Do anh không theo học lớp rèn luyện của Iansan đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470125,
					"content": "Haiz, cứ leo lên leo xuống tìm kiếm như vậy làm tôi đau lưng quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470126,
					"content": "Thì đó, là do anh không theo học lớp rèn luyện của Iansan đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470127,
					"content": "...Được rồi được rồi, xong vụ này tôi sẽ đi tập ngay đây. Hài lòng chưa nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470128,
					"content": "Này, hai người đừng hoạnh họe nhau nữa! Tóm lại, bây giờ ai phụ trách việc bắt Cacucu và Cacasha đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470129,
					"content": "À! Thì giao cho phương án dự phòng hoàn hảo của chúng tôi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470130,
					"content": "Lại là tôi phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "Mm-hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470132,
					"content": "Được, để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#Chắc chắn {M#ông}{F#bà} {NICKNAME} sẽ làm được mà! Cả bà Paimon cũng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470134,
					"content": "Đừng miễn cưỡng nhé, nếu cần giúp đỡ thì cứ gọi chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470135,
					"content": "Ơ, tôi tưởng hai chúng ta sẽ vào vai Asha chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470136,
					"content": "Vào vai Asha... Ý là hai anh cũng muốn trốn rồi đợi chúng tôi đi tìm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470137,
					"content": "Ừm! Giờ tôi sẽ là Orasha, anh ta là Ifasha. Chúng tôi đi trốn đây, cố lên nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470138,
					"content": "Này, người anh em...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470139,
					"content": "Xin lỗi, cứ phối hợp với họ chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470140,
					"content": "Chuyện nhỏ thôi, cũng vui mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "Vậy thì nhờ hai người nhé, cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470141,
					"content": "Đừng lo, tôi còn nhiều năng lượng lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
