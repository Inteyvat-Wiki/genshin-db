				{
					"id": 752475101,
					"content": "Lại gặp nhau rồi, người anh em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "Thật ra vừa rồi tôi định nói, lần đầu tiên tôi gặp Ifa không phải là ngày hôm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "Nhưng sau đó vẫn kìm lại được. Dù sao tôi cũng rất chín chắn, nói chuyện đều biết nhìn hoàn cảnh mà.",
					"roleType": "TALK_ROLE_NPC",
