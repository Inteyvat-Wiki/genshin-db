			"dialogs": [
				{
					"id": 752475001,
					"content": "Thế nào, chơi có vui không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475002,
					"content": "Ôi trời ơi, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475003,
					"content": "Xem ra là vui rồi. Sinh nhật vui vẻ nhé, người anh em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475004,
					"content": "Mà sao anh lại không cho tôi biết trước kế hoạch này thế? Không coi tôi là anh em à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475005,
					"content": "Haha... Tôi chỉ muốn xem thử xem anh có còn nhớ ngày này không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475006,
					"content": "Ifa, anh thay đổi rồi, giờ anh đã nham hiểm hơn trước nhiều. Sau này tôi phải đề phòng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475007,
					"content": "May mà tôi nhớ, nên đã để lại mật tươi cho Cacucu, không thôi sẽ bị Cacucu mổ đầu đến hết năm mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475008,
					"content": "Không đâu, người anh em, anh là tuyệt nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		},
		{
