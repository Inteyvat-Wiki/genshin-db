				{
					"id": 752470451,
					"content": "Tới nào! \"Hân hạnh được gặp gỡ, người anh em!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470452
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470452,
					"content": "Woa, đây là gì thế!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470453
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470453,
					"content": "Boom boom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470454
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470454,
					"content": "Ôi trời ơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470455
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470455,
					"content": "E hèm... Trứng Lấp Lánh, may mắn đồng hành! Xin chúc mừng ngài Cacucu đây đã trở thành vị khách thứ ba giành được giải đặc biệt hôm nay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470456
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470456,
					"content": "Ngoài Túi Asha Nhỏ hiếm có này, chúng tôi còn tặng thêm một phần những món ăn mà Trứng Lấp Lánh có thể mở ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470457
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470457,
					"content": "Không phải chứ, người anh em!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470458
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470458,
					"content": "Không phải chứ!? Không lẽ Cacucu mới là người may mắn nhất trong nhóm chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470459,
					"content": "Haha, chúc mừng nhé, người anh em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470460
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470460,
					"content": "Người anh em Cacucu, thật ra tôi có một yêu cầu hơi quá đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470461
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470461,
					"content": "Nghe nói nắm tay thì sẽ nhận được chút may mắn đấy, liệu chúng tôi có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470462
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470462,
					"content": "Haha! Không thành vấn đề, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470463,
						752470466
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470463,
					"content": "Dưới sự dẫn dắt của Ororon, mọi người đều nắm lấy cánh của Cacucu.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470464
					]
				},
				{
					"id": 752470464,
					"content": "Vì thấy quá dễ thương, nên mọi người đã chuyển sang xoa đầu Cacucu.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470465
					]
				},
				{
					"id": 752470465,
					"content": "Tròn tròn, mềm mại, đúng là khiến cho lưu luyến không nỡ rời tay.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470466,
					"content": "Hihi, cảm thấy như đủ may mắn cho đến cuối năm luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470467,
					"content": "Sẽ được thôi mà. Bởi vì Paimon có người bạn đồng hành cực kỳ tốt, giống như Cacucu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470468
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470468,
					"content": "Này, sao lại nhìn tôi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470469
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470469,
					"content": "Kế hoạch của anh thành công rồi, cũng nên nói sự thật ra rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470470
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470470,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470471
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470471,
					"content": "Ơ, hả? Ý là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470472,
						752470473
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470472,
					"content": "Chẳng lẽ may mắn của Cacucu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470474,
					"content": "Được rồi, chuyện nhỏ mà. Có người anh em như tôi đây thì đúng là một trong những may mắn của Cacucu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470475
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470475,
					"content": "Đừng vòng vo nữa, nói thật đi. Ngay cả khi câu cá cũng đều là do anh sắp xếp đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470476
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470476,
					"content": "Mmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470477
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470477,
					"content": "Anh đã quen biết nhà mạo hiểm đến từ Mondstadt đó từ trước rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470478
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470478,
					"content": "Không, cũng chỉ quen biết sớm hơn anh một ngày, nên tôi đã nhờ cậu ấy chỉ đường trước thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470479
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470479,
					"content": "Tôi đã sắp xếp những bức ảnh để Cacucu chơi cùng Capybara và Asha. Số Trứng Lấp Lánh kia cũng là do tôi chuẩn bị từ trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470480
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470480,
					"content": "Ôi trời, người anh em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470481
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470481,
					"content": "Haha... Quả nhiên là con người không thể hoàn toàn khiến động vật hiểu được ý của mình, nên đã bị Vua Capybara hiểu lầm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470482
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470482,
					"content": "Tôi đoán nó tưởng tôi đưa người khác đến cướp lại những thứ vốn chuẩn bị cho Cacucu, nên nó mới giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470483
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470483,
					"content": "Thì ra nó tên là Vua Capybara thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470484
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470484,
					"content": "Đương nhiên không phải rồi. Tôi chỉ đang nói theo cách của anh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470485
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470485,
					"content": "Ôi, người anh em! Làm tôi cảm động quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470486
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470486,
					"content": "...Ừm, tóm lại chuyện là vậy đó! Dạo này sắp đến ngày kỷ niệm tôi và Cacucu lần đầu gặp nhau, nên tôi định chuẩn bị chút quà nhỏ cho nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470487
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470487,
					"content": "Vì không biết sinh nhật của Cacucu là ngày nào, nên chúng tôi luôn xem ngày đó như sinh nhật để chúc mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470488
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470488,
					"content": "Tuy Cacucu luôn tỏ ra chín chắn như anh cả, nhưng bản chất thì nó cũng chỉ là một chú Saurian nhỏ ham chơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470489
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470489,
					"content": "Saurian nhỏ thì nên có dáng vẻ của Saurian nhỏ, phải chơi thật thoải mái, hiểu chưa nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470490
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470490,
					"content": "Ôi, người anh em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470491
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470491,
					"content": "Ơ? Cacucu có điều gì muốn nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470492
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470492,
					"content": "Người anh em, không phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470493
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470493,
					"content": "Ừm, hiểu mà. Ngươi không cần nói đâu, mọi người ở đây đều yêu thương ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470494
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470494,
					"content": "Đúng vậy, đừng ngại. Mấy ngày này cứ tự do chơi đùa như bất kỳ chú Qucusaur nào khác nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470495
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470495,
					"content": "Ngày kỷ niệm vui vẻ, Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470496
					]
				},
				{
					"id": 752470496,
					"content": "Ôi, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470473,
					"content": "Đều là do anh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470440,
					"content": "Cacucu lên sau cùng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				}
			]
		},
