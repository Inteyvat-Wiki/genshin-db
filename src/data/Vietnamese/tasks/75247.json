			"dialogs": [
				{
					"id": 752470301,
					"content": "Phù... Kết thúc rồi! Cũng vất vả thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470303,
					"content": "Ngươi là Cacasha đúng không? Ngươi và Cacucu cũng lợi hại đấy chứ, chúng tôi công nhận đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
