			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Nếu về sau Mahamata không thông báo ở đây nữa, vậy để cho quán rượu Lambad chúng tôi làm bảng tin nhắn, về sau có việc gì mọi người có thể để lại lời nhắn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731941102,
					"content": "\"Ông chủ, mười thùng rượu tôi đặt trước đó đã có hàng chưa, hôm qua tôi đến theo thời gian đã hẹn thì không có hàng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731941103,
					"content": "Sao lại thế! Trước đó có một người tóc vàng tự xưng là bạn cùng phòng của anh mang hết rượu đi rồi. Tôi nhớ hai người từng ghé quán chung mà, có nhầm lẫn gì không đấy?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731941104,
					"content": "\"...Được rồi, tôi hiểu rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
