			},
			"dialogs": [
				{
					"id": 731941001,
					"content": "Treo Thưởng Truy Nã: Mustah",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731941002,
					"content": "Người này giả danh là Mahamata, đi khắp cảng Bazaar, lừa đảo tống tiền, cướp bóc đội buôn. Hiện do Đại Sảnh Regzar vào cuộc điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731941003,
					"content": "Có thông tin rằng người này đã ẩn thân trong rừng, nếu cư dân thành phố có thấy bắt gặp, nhất định phải trình báo lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319411,
			"completionStepIds": [
				7319411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
