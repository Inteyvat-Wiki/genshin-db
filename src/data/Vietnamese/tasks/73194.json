				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "Đây là bảng thông báo của Mahamata, công việc quan trọng trong Thành Sumeru đều thông báo ở đây, nếu có vấn đề liên quan cũng có thể nhắn lại ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "\"Nghe gì chưa? Nghe người đi tuần rừng nói, không biết từ lúc nào mà phía bắc khu rừng đã xây nên một tòa cung điện hoa lệ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940202,
					"content": "\"Nhưng dường như người đến đó đều bị lừa sạch tiền của, khi được Đội Trưởng Kiểm Lâm tìm thấy thì chỉ còn lại cái quần cụt thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940203,
					"content": "\"Hỏi họ đã xảy ra chuyện gì thì không chịu nói, chỉ biết khóc, thật đáng sợ quá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940204,
					"content": "\"Mọi người tốt nhất đừng chạy lung tung trong rừng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "Việc lớn trong và ngoài Sumeru đều đã chuyển cho Akasha ban bố, mọi người hãy đeo \"Trạm Cuối Akasha\" bất kỳ lúc nào để tránh bỏ lỡ thông tin quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940302,
					"content": "Để tiện cho thương khách nước khác và người già, trẻ nhỏ, tạm thời duy trì bảng thông báo này. Trong tương lai có thể gỡ bỏ bất kỳ lúc nào, mọi người xin đừng lệ thuộc quá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "\"Kiến Thức Màu Mỡ\" của năm nay đã bắt đầu phát hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940402,
					"content": "Theo nguyên tắc, tiếp tục tiến hành theo chính sách và yêu cầu phát hành năm ngoái, nội dung cụ thể đã ban bố thông qua Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940403,
					"content": "Nếu có thay đổi gì hãy liên lạc trước với Mahamata gần nhất để gửi yêu cầu điều chỉnh đến Giáo Viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "Dạo này trong thành bùng phát bệnh \"Eleazar\", nếu bạn có những triệu chứng như da dẻ mất cảm giác, tay chân không có sức, hoặc cơ thể xuất hiện những mảng vảy đen, hãy nhanh chóng đến Bimarstan để điều trị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940502,
					"content": "Nếu bỏ lỡ giai đoạn chữa trị tốt nhất, khiến tình trạng bệnh nghiêm trọng hơn, có thể dẫn đến hậu quả nghiêm trọng như mất đi khả năng hoạt động, mong mọi người hãy để ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319406",
							"2"
						],
						"stepId": 7319406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Nhắc nhở đặc biệt, toàn bộ ngành lính đánh thuê của Sumeru đều do \"Eremite\" tiếp nhận, không có bên nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940602,
					"content": "Đừng dễ dàng tin tưởng người khác, đề phòng bị người không rõ lai lịch gạt mất tiền thuê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940603,
					"content": "Nếu cần thuê vệ sĩ, thủ vệ hay những yêu cầu khác, hãy liên lạc với Parchamdar Rukh Shah của \"Lữ Đoàn 30\" hoặc gửi ủy thác đến người liên lạc Effendi của Giáo Viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319407",
							"2"
						],
						"stepId": 7319407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Bimarstan là cơ quan phục vụ chữa trị thuộc Học Viện Amurta, chữa bệnh miễn phí cho cư dân trong và ngoài Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940702,
					"content": "Bác sĩ ở đây đều đạt được giấy phép hành nghề do Học Phái Amurta trao tặng, phương án khám chữa bệnh được giao cho Akasha kiểm tra nhiều lần, cung cấp phục vụ chuyên nghiệp và an toàn nhất cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940703,
					"content": "Mong hầu hết cư dân đừng tin vào bác sĩ không rõ lai lịch, để tránh tiền mất tật mang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319408",
							"2"
						],
						"stepId": 7319408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "Đừng mang quá nhiều tiền ở những nơi đông người trong thành, đề phòng trộm cắp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940802,
					"content": "Nếu xảy ra trộm cắp, xin đừng nhờ Eremite tuần tra gần đó giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940803,
					"content": "Vì rất có thể, họ chính là kẻ đã trộm đồ của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319409,
			"completionStepIds": [
				7319409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319409",
							"2"
						],
						"stepId": 7319409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940901,
					"content": "Treo Thưởng Truy Nã: Kasim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940902,
					"content": "Người này tự xưng là kẻ trộm nổi tiếng đi qua nhiều nước, thực ra là kẻ bịp bợm, vô danh trên bảng xếp hạng thực lực của Eremite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731940903,
					"content": "Dạo này phát sinh nhiều vụ án lừa gạt liên quan đến người này, mong mọi người đề cao cảnh giác, tránh bị lừa gạt.",
					"roleType": "TALK_ROLE_NPC",
