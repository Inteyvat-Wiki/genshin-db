			},
			"dialogs": [
				{
					"id": 731941201,
					"content": "\"Nếu mọi người phải vào rừng mưa thì phải cẩn thận, lần trước tôi bị người hướng dẫn phái đi rừng mưa thu hoạch một ít thảo dược nhưng gặp phải Hổ Lông Dài, suýt thì mất mạng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731941202,
					"content": "\"May mà có nhân viên kiểm lâm gần đó cứu giúp, dù cô ấy tự xưng là nhân viên kiểm lâm thực tập, nhưng có vẻ kinh nghiệm chiến đấu rất phong phú. Quan trọng nhất là cô ấy còn dùng đồ ăn ngon để an ủi tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731941203,
					"content": "\"Nghe nói cô ấy còn là học trò của tiền bối Tighnari, quả là danh sư xuất cao đồ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
