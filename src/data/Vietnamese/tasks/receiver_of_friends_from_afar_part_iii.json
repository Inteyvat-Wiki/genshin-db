			"dialogs": [
				{
					"id": 401480401,
					"content": "#Bạn của {F#cô}{M#cậu} đúng là rất cá tính... Có điều món Tri Túc Thường Lạc này cũng không khó làm, lần này chắc không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480402,
					"content": "Kể ra thì, tại sao lại gọi là \"Tri Túc Thường Lạc\" nhỉ? Những món thịt trong đó không hề giống với một cái tên khiêm tốn này chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480403,
					"content": "Tôi cũng có nói món này là thịt đâu... Món này chỉ trông giống thịt thôi, thực ra là dùng đậu hũ rồi thêm hương thơm của thịt vào, nên mới gọi là \"Tri Túc Thường Lạc\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480404,
					"content": "Đậu hũ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480405
					]
				},
				{
					"id": 401480405,
					"content": "Á! Tôi nhớ là... hình như tên thả bò không ăn được đậu. Sao bây giờ, có nên kêu họ đổi món khác không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480406,
					"content": "Mọi người gặp rắc rối gì sao? Hình như tôi vừa nghe thấy \"đậu hũ\" gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480407
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480407,
					"content": "Đợi đã, người lạ không được vào nhà bếp... Haiz, giờ không phải lúc nói chuyện này... Có thể bảo đại ca của cô đổi món khác được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480408
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480408,
					"content": "...Haha! Không ai hiểu người anh em Ayato như bổn đại gia đâu! Món Tri Túc Thường Lạc này chính là minh chứng cho tình bạn của chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480409
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480409,
					"content": "...Này! Vẫn chưa xong sao? Nhanh lên nhanh lên, câu chuyện về Xích Hồng Chùy của ta sắp kể xong rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480410
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480410,
					"content": "...Mọi người cũng thấy rồi đấy, e là có chút khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480411
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480411,
					"content": "Hỏng rồi, tên đó phấn khích quá rồi. Để chọn giữa thể diện và cái bụng thì anh ta chắc chắn sẽ chọn thể diện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480412,
						401480413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480412,
					"content": "Hết cách, đành phải làm trước vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				},
				{
					"id": 401480414,
					"content": "Ừm, tôi sẽ bảo đại ca ăn nhiều món ăn kèm cho no bụng... Đến lúc đó xem tình hình rồi tính tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480413,
					"content": "Hay chúng ta thêm chút món ăn kèm vào vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				}
			]
		},
