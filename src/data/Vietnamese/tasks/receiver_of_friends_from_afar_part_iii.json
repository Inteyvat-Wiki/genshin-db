			},
			"dialogs": [
				{
					"id": 401480101,
					"content": "#Chào buổi sáng, {NICKNAME}! Hôm nay cũng vất cả cho {F#cô}{M#cậu} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480102,
					"content": "Có kinh nghiệm từ mấy lần trước, các bạn làm ngày càng quen tay...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "#Ừm... {F#Cô}{M#Cậu} ngày càng thích ứng với việc bếp núc ở đây rồi đấy! Cho dù khách hàng có khó tính đến đâu cũng sẽ không thành vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480104,
					"content": "Thôi đi! Mỗi lần anh nói câu này là y như rằng sẽ có chuyện phiền phức xảy ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480105,
					"content": "Haha, làm gì có! Tôi đâu phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480106,
					"content": "Ahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480107,
					"content": "Ây da, không ngờ lại gặp được người bạn tốt này ở Liyue! Ờm, câu tục ngữ đó nói thế nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480108,
					"content": "\"Gặp bạn cũ nơi đất khách\" đó, đại ca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480109,
					"content": "Đúng, chính là câu này! Có phải không, Ayato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480110,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480111,
					"content": "Tên thả bò? Sao lại là anh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480112,
					"content": "Hửm? Dưa tím lùn, à không... Dưa Tím Thép Trắng Kinh Thiên Động Địa? Còn có bạn tốt của ta nữa! Hôm nay may mắn thật, gặp được nhiều bạn cũ ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480113,
					"content": "Lúc trước không phải anh nói sẽ quay về và cố gắng kiếm tiền sao? Sao quay lại Liyue sớm thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480114,
					"content": "Haha, với thân thủ như bổn đại gia thì chuyện kiếm tiền không phải dễ như ăn kẹo sao? Chuyến này đến đây tất nhiên là để đánh chén no nê rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480115,
					"content": "E hèm... Tiện thể xem thử xem Hanakado ở Liyue thế nào rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480116,
					"content": "(Shinobu đang dùng ánh mắt ra hiệu là... \"đừng hỏi thêm nữa\"...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "Vậy còn Ayato thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "...Lúc trước tôi nghe nói ở Liyue có người tổ chức đại hội đấu bọ, cho nên định đến xem. Nhưng đáng tiếc, tôi hình như đã bỏ lỡ mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480119,
					"content": "Gì cơ? Bỏ lỡ đại hội đó sao? Haiz, vậy thì thật là đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480120,
					"content": "Đúng vậy, may là chuyến này lại gặp được Itto, có thể nghe anh kể về đại hội trọng đại lúc đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480121,
					"content": "Haha, được thôi! Chúng ta vừa ăn vừa nói chuyện đi. Đầu bếp đâu nhỉ? Mau gọi đầu bếp ra đây, ta phải cho bạn bè mình ăn một bữa no nê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480122,
					"content": "Tôi là đầu bếp đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "...Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480124,
					"content": "Tên thả bò lại học theo trong sách rồi, kiểu vẫy tay là sẽ có người chạy đến ấy... Chúng ta cho anh ta chút thể diện vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480125,
					"content": "...Nhưng còn có đầu bếp khác nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "Ah... haha! Ngươi thật biết đùa, vậy mau mời vị đầu bếp đó ra đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480127,
					"content": "Bạn và Paimon quay về phía sau bếp, nói rõ tình hình với Yanxiao và mời anh ấy ra mặt...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "Ừm... Xin hỏi quý khách muốn gọi món gì? Nếu muốn đãi khách thì chỗ chúng tôi có món Kim Ngọc Mãn Đường, Giai Điệu Hối Hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480129,
					"content": "Đại ca, chú ý ngân sách nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480130,
					"content": "Ờ... ờ... Ừm, còn có món nào... ờ, món nào thực tế hơn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480131,
					"content": "Thực tế? À... Cũng có một món gọi là \"Tri Túc Thường Lạc\", hương thơm nức mũi, dư vị dài lâu, là lựa chọn hàng đầu cho một bữa ăn ngon mà giá lại rẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480132,
					"content": "Tri Túc Thường Lạc? Tên hay! Nghe là biết ngon rồi, vậy thì chọn món này đi! Ở đây đều là bạn bè, không cần phải màu mè làm gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480133,
					"content": "Người anh em Itto quả là có mắt nhìn, tôi trước giờ cũng không thích mấy món ăn quá cầu kỳ. Ha... Đây gọi là tri kỷ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480134,
					"content": "Tri kỷ? Haha, đúng, chính là tri kỷ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480135,
					"content": "Thật sao? Thôi vậy, hai người vui là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
