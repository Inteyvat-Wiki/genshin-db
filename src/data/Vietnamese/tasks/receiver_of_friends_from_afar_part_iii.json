					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "Món ăn... đến rồi đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480202,
					"content": "Ồ, đây chính là Tri Túc Thường Lạc sao? Quả nhiên nhiều thật, không tồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480203,
					"content": "Nào, ngươi cũng ngồi xuống đi. Ở đây đều là bạn bè cả, ai cũng đừng khách sáo nhé! Ta lấy một miếng trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480204,
					"content": "Khụ! Đại ca, có câu \"nhập gia tùy tục\", theo như lễ nghi ở Liyue thì phải mời khách nếm thử trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480205,
					"content": "Hở? Shinobu, không phải ngươi ghét nhất là mấy quy tắc này sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480206,
					"content": "Bây giờ tôi cũng xem như là khách rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "Hm? Ngay cả ngươi cũng... Ồ, ta hiểu rồi, chắc là quá thơm phải không? Được, các ngươi đã nói vậy thì bổn đại gia sẽ là người ăn cuối cùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480210,
					"content": "Bạn và Paimon, Ayato, Shinobu lần lượt gắp một vòng, \"thịt\" trên đĩa cũng ít đi rất nhiều...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "...Hah, hóa ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480212,
					"content": "Cuối cùng cũng đến lượt bổn đại gia rồi, giờ ta sẽ lấy miếng to nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480213,
					"content": "Đợi, đợi đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480214,
					"content": "Hửm? Lại chuyện gì nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480215,
					"content": "Paimon, ở đây giao cho Paimon đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Tôi... sẽ cố gắng... Ờm, vừa rồi tôi quên giới thiệu nguồn gốc của món ăn này cho mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480218,
					"content": "Nguồn gốc của món ăn? Có gì đáng để nghe đâu, không phải ăn là được rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480219,
					"content": "Chậc... Không nghe giới thiệu trước khi ăn thì cũng giống như đi du lịch mà không có hướng dẫn viên vậy! Nghe xong rồi mới ăn sẽ ngon hơn nhiều đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480220,
					"content": "Đúng vậy, giống như các loại trà khác nhau sẽ có cách thưởng thức khác nhau, không nghe giới thiệu chẳng phải đã lãng phí tâm ý của đầu bếp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480221,
					"content": "Đúng là không thể phụ lòng... Vậy thì nói đi, ta đang nghe đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480222,
					"content": "Chúng ta hãy nói về nguyên liệu trước đã... À không, nói về Nhà Trọ Vọng Thư... nói về lịch sử của Địch Hoa Châu đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480223,
					"content": "#({NICKNAME}, nhân lúc này!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480224,
					"content": "(Được!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "Nhân lúc Paimon thu hút sự chú ý của Itto, bạn và Shinobu bắt đầu càn quét món ăn trên bàn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "Không ngờ Địch Hoa Châu lại có câu chuyện cảm động như vậy... Có được cuộc sống như bây giờ, đúng là nên biết đủ như tên của món \"Tri Túc Thường Lạc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480227,
					"content": "(Tiêu rồi, không thể nhắc đến đậu hũ. Chủ đề cũng sắp hết rồi... May mà chỉ còn lại một ít!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480228,
					"content": "(Nhưng chúng ta... không ăn nổi nữa rồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "Á! Shinobu! Các ngươi đã bắt đầu ăn từ khi nào thế? Chỉ còn lại vài miếng thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480230,
					"content": "Bây giờ có nói gì thì ta cũng không nhường nữa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480231,
					"content": "Đợi đã! Đại ca, thực ra là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480232,
					"content": "Đợi đã, người anh em Itto... Tôi có một yêu cầu này muốn nhờ anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480233,
					"content": "Chuyến này tôi đi vội quá, không có dẫn theo người nhà. Họ thường nghe đến đại danh của anh, và cũng hâm mộ Bang Arataki đã lâu. Đáng tiếc lần này không có cơ hội ngồi chung bàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480234,
					"content": "Nhưng nếu anh có thể gói phần \"Tri Túc Thường Lạc\" còn lại này đem tặng cho họ... Ừm, chắc chắn họ sẽ rất vui đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480235,
					"content": "Như vậy... không ổn lắm nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480236,
					"content": "Đại ca, văn hóa Liyue luôn đề cao việc giúp đỡ người khác mà... Hơn nữa lúc đợi món ăn lên, đại ca chẳng phải đã ăn mấy con cá nướng rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480237,
					"content": "...Đến phần của tôi và anh Ayato cũng ăn hết luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480238,
					"content": "Hử? Hóa ra là phần của các ngươi à... kể chuyện nhập tâm quá nên ta không để ý đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480239,
					"content": "Khụ, vậy phiền người anh em Ayato thay ta hỏi thăm họ nhé! Chủ tiệm, làm phiền đóng gói lại giùm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480216,
					"content": "Có thể biểu diễn lại lần nữa không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "Tôi cũng muốn ăn một miếng trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
