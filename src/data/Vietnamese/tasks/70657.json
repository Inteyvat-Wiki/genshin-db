			"dialogs": [
				{
					"id": 706570101,
					"content": "Xin chào, tôi là Lizz của Đội Kỵ Sĩ Tây Phong. Tin chắc rằng bạn đã nghe qua rồi, trong thời gian Lễ Hội Hoa Gió, Mondstadt sẽ tổ chức rất nhiều hoạt động thú vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570102,
						706570103
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570102,
					"content": "Đã có nghe qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				},
				{
					"id": 706570104,
					"content": "Công việc của tôi chính là đón tiếp khách đến Mondstadt, để mọi người có thể tận hưởng trọn vẹn niềm vui của ngày lễ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570105
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570105,
					"content": "Do địa điểm tổ chức sự kiện không nhất thiết ở nội thành, nếu không có người giới thiệu, sẽ có rất nhiều trò chơi đặc sắc bị bỏ lỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570106
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570106,
					"content": "Sự kiện tôi muốn giới thiệu với mọi người chính là - \"Bách Phát Bách Trúng\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570107
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570107,
					"content": "Như tên của nó, chính là bắn mục tiêu trên không, nếu như vừa nhanh vừa chính xác sẽ đạt được điểm cao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570108,
						706570109
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570108,
					"content": "Có vẻ rất thú vị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570110,
					"content": "Không sao, tôi sẽ giúp bạn đánh dấu vị trí, bạn thử rồi sẽ biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570111
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570111,
					"content": "Ngoài ra còn nhận thưởng theo số điểm nhận được, cho dù là trải nghiệm hay là theo đuổi sự hoàn hảo cũng đều rất thú vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570112,
						706570113
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570112,
					"content": "Khá thú vị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570114,
					"content": "Ừ ừ, cứ đi thử trước xem! Nếu bạn muốn tìm hiểu các hoạt động thú vị khác thì cứ đến tìm tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570115
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570115,
					"content": "Chúc bạn chơi vui vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706570113,
					"content": "Cám ơn bạn đã giới thiệu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570109,
					"content": "Có vẻ hơi khó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570103,
					"content": "Lần đầu nghe thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				}
			]
		}
	]
