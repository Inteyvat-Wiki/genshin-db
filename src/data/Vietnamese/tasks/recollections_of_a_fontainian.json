			"dialogs": [
				{
					"id": 733500201,
					"content": "Bạn chụp xong rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500202
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500202,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500203
					]
				},
				{
					"id": 733500203,
					"content": "Ồ, cứ từ từ, việc chụp hình cũng không phải đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Augustus Lovelace"
				}
			]
		},
		{
			"id": 7335003,
			"completionStepIds": [
				7335003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7335003",
							"2"
						],
						"stepId": 7335003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Augustus Lovelace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500301,
					"content": "Bức ảnh này không tệ, bạn rất có năng khiếu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500302
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500302,
					"content": "Từ khi đi du lịch đến giờ, tôi thấy bạn là người đầu tiên hiểu về bố cục và màu sắc đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500303
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500303,
					"content": "Anh đã đi qua những nơi nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500304
					]
				},
				{
					"id": 733500304,
					"content": "Chuyện này sao, ừm... Vốn dĩ tôi có thể đến thẳng Sumeru từ Fontaine. Dù sao thì Fontaine cũng có tuyến tàu đến thẳng Cảng Bayda của Sumeru mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500312
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500312,
					"content": "Người ta nói đi du lịch quan trọng nằm ở quá trình, nên tôi vẫn sẽ chọn một lộ trình... thú vị hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500313
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500313,
					"content": "Đầu tiên thì tôi đi qua Cảng Lumidouce để đến Trầm Ngọc Cốc, sau đó đi qua Khinh Sách Trang để đến Cổng Đá, ranh giới giữa Mondstadt và Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500310
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500310,
					"content": "Sau khi thăm Tửu Trang Dawn, tôi quyết định xuống phía nam để tới Cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500305
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500305,
					"content": "Từ Cảng Liyue tôi đi thuyền đến Cảng Ormos, sau đó đi theo đường sông lên phía bắc thì tới nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500306
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500306,
					"content": "Dù sao mục tiêu của chuyến đi này cũng là để cho khuây khỏa mà. Còn nếu tôi là một dũng sĩ đam mê mạo hiểm thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500311
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500311,
					"content": "Hoặc tôi sẽ khởi hành từ Cảng Romaritime, rồi đi theo con đường hành hương cổ xưa về phía nam để đến sa mạc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500307
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500307,
					"content": "Thì ai biết được chứ? Có thể trên đường về tôi sẽ băng qua sa mạc đấy. Dù sao thì kinh phí vẫn còn nhiều, ý tưởng vượt sa mạc để đến Natlan nghe chừng không tệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500308
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500308,
					"content": "Được rồi, không phiền bạn nữa. Cảm ơn bạn đã giúp tôi, đây là thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500309
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500309,
					"content": "Tôi phải mau chóng viết thư cho Xavier mới được. Nếu anh ta không đến Sumeru nữa thì tôi phải về Fontaine rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Augustus Lovelace"
				}
			]
		},
