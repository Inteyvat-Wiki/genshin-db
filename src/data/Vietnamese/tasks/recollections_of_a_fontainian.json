						"stepId": 7335001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7228724",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Augustus Lovelace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500401,
					"content": "Hơ... Hắt xì! Mùi của những hương liệu này thật là... Hắt xì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500402
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500402,
					"content": "Chụp hình lại rồi về phòng đợi vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500403
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500403,
					"content": "Nhà Lữ Hành! Này, chờ chút đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500404,
						733500405
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500404,
					"content": "Gọi tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500406
					]
				},
				{
					"id": 733500406,
					"content": "Bạn có thể giúp tôi chụp một bức hình ở đây không? Không tốn thời gian đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500409
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500409,
					"content": "Mùi hương liệu ở đây quả thật quá nồng đối với tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500410
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500410,
					"content": "Khi còn ở Fontaine thì tôi không hề ăn một chút vị cay nào, cùng lắm chỉ là thêm chút muối thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500411
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500411,
					"content": "Ở đây, tôi nhảy mũi đến nỗi... Át xì! Đến nỗi máy ảnh cũng không cầm vững luôn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500412
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500412,
					"content": "Cho nên, tôi chỉ có thể nhờ... nhờ người khác giúp tôi chụp ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500413
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500413,
					"content": "Trông bạn có vẻ là người tốt, cho nên... tôi muốn nhờ bạn giúp tôi việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500414
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500414,
					"content": "Anh tới từ Fontaine sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500415
					]
				},
				{
					"id": 733500415,
					"content": "Đúng vậy. Xin lỗi, tôi quên tự giới thiệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500416
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500416,
					"content": "Tôi tên Augustus Lovelace, là nhà nghiên cứu của \"Viện Nghiên Cứu Khoa Học Công Trình Động Năng Fontaine\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500417,
						733500418
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500417,
					"content": "\"Viện Nghiên Cứu Khoa Học Công Trình Động Năng Fontaine\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500419
					]
				},
				{
					"id": 733500419,
					"content": "Tên hơi dài đúng không? Chỉ cần gọi Viện Khoa Học Fontaine là được, người Fontaine đều gọi thế cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500420
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500420,
					"content": "Trước đây thì nơi đó là thánh địa của các nhà nghiên cứu, đa số các loại máy móc đều xuất xứ từ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500421
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500421,
					"content": "Nhưng nhờ có thiên tài Edwin mà phần lớn kiến trúc của Viện Khoa Học Fontaine đã thành đống đổ nát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500422
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500422,
					"content": "Dù sau này ngài Raimondo và Choiseul có xây dựng lại, nhưng tinh thần nghiên cứu trong viện cũng đang đi xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500423
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500423,
					"content": "Tôi là người ưa sạch sẽ, không muốn sống trong đống đổ nát. Vậy nên tôi đã đi du lịch khắp nơi để khuây khỏa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500424
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500424,
					"content": "Đừng khó chịu mà, chuyện này không liên quan đến bạn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500425
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500425,
					"content": "Nào, chụp cho tôi một tấm nhé. Nếu Xavier thấy được phong cảnh của Sumeru thì chắc chắn sẽ không ở Inazuma nữa cho mà xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500426,
						733500436
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500426,
					"content": "Chúng tôi từng làm việc chung...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500427
					]
				},
				{
					"id": 733500427,
					"content": "Ủa...? Không lẽ bạn là Nhà Lữ Hành mà Xavier nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500428
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500428,
					"content": "Thật hân hạnh! Tôi đã nghe Xavier kể về chuyện của bạn ở \"Lò Luyện Mikage\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500429
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500429,
					"content": "Hơn nữa, mỗi lần Xavier nói đến phim đều sẽ khen khả năng diễn xuất đỉnh cao của bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500430
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500430,
					"content": "Anh ấy nói bạn có tài, lại cao thượng, và quan trọng nhất là rất có khiếu hài hước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500431
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500431,
					"content": "Chậc, lát nữa chụp ảnh xong thì phiền bạn ký tên cho tôi nhé, ký trên ảnh là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500432
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500432,
					"content": "Xavier vẫn khỏe chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500433
					]
				},
				{
					"id": 733500433,
					"content": "Nói thật thì không ổn lắm, anh ta cứ rầu vì \"phim\" mãi. Trong thư viết là anh ta dạo này không tìm được đề tài mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500434
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500434,
					"content": "Tôi cũng bảo anh ta hãy làm như tôi, tạm gác công việc lại, rồi đến Sumeru cho khuây khỏa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500435
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500435,
					"content": "Nhưng anh ta bảo là phải quay được một bộ phim xuất sắc nhất cho \"Hiệp Hội Yashiro\". Còn trước lúc đó thì sẽ không rời khỏi Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500441
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500441,
					"content": "Thôi không nói những chuyện này nữa, bạn giúp tôi chụp một tấm nhé! Ở đây là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500436,
					"content": "Anh quen Xavier như thế nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500437
					]
				},
				{
					"id": 733500437,
					"content": "Chắc bạn cũng biết Xavier là nhà nghiên cứu trong Viện Khoa Học Fontaine nhỉ. Chúng tôi từng làm việc chung, nên Xavier đã hướng dẫn cho tôi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500438
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500438,
					"content": "Xavier thích quay phim và muốn trở thành đạo diễn, nhưng suy nghĩ này đã không được đón nhận khi còn ở trong Viện Khoa Học Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500439
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500439,
					"content": "Cho dù sau này bị chuyển sang dự án khác, nhưng anh ta vẫn mượn danh nghĩa ghi lại quá trình nghiên cứu mà không ngừng quay \"phim tài liệu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500442
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500442,
					"content": "Và anh ấy cứ đi đi lại lại giữa các dự án như thế, đến cuối cùng thì bị cử đến Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500440
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500440,
					"content": "Anh ấy rất có chí, nếu như sinh ra trong quá khứ, nơi kinh phí đầy đủ, hoặc là sinh ra trong tương lai tươi đẹp, thì chắc sẽ đạt được thành tựu lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500441
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500418,
					"content": "Đó là nơi nào thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500419
					]
				},
				{
					"id": 733500405,
					"content": "Có chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500406
					]
				}
			]
		}
	]
}