			"dialogs": [
				{
					"id": 732030602,
					"content": "Đây là Tường Vi Sumeru tôi hái được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "Loài hoa khiến người ta nhung nhớ, tôi đã chuẩn bị xong món quà tặng bạn, bạn cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030604,
					"content": "Toàn là những loài thực vật không thể nảy mầm sinh trưởng ở nơi đây, nếu bạn có khu vườn ở nơi khác thì có thể nhìn thấy chúng sinh trưởng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
