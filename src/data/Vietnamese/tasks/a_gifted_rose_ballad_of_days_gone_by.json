				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070101,
					"content": "Các cháu đến rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070102,
					"content": "Đây là người mà các cháu tìm đến giúp đỡ nhỉ, mấy ngày trước ta vừa nói lời khó nghe với cô ấy xong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070103,
					"content": "Ta đúng là... ôi, già rồi lẩm cẩm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070104,
					"content": "Bây giờ chúng ta đang nói chuyện một cách thân thiện với nhau rồi mà, ông đừng để tâm điều đó nữa ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070105,
					"content": "Hạt giống đã nảy mầm chưa ạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070106
					]
				},
				{
					"id": 732070106,
					"content": "Thật tiếc là tôi và ông Affan đã xem rồi, hạt giống vẫn như cũ, chưa hề nảy mầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070107,
					"content": "Theo tôi quan sát, bên ngoài mấy hạt giống này có hiện tượng khoáng thạch hóa, tại sao lại như vậy, có hai nguyên nhân giả thiết:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070108,
					"content": "Thứ nhất, trải qua sự phong hóa tự nhiên trong thời gian dài, chúng đã mất đi hoạt tính của sinh vật sống và đang chuyển thành hình thái hóa thạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070109,
					"content": "Trong hình thái như vậy, hạt giống đương nhiên không thể nảy mầm được. Nhưng khả năng hình thành của giả thiết này khá thấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070110,
					"content": "Thời gian cần thiết để hiện tượng hóa thạch xuất hiện tương đối dài, những hạt giống này không đạt điều kiện về thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070111,
					"content": "Thứ hai, bản thân loại hạt giống này có lực hấp dẫn Nguyên Tố Nham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070112,
					"content": "Trong giai đoạn hạt, chúng đã hấp thụ đủ Nguyên Tố Nham, nên ở bề mặt hạt giống hình thành một lớp vỏ đá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070113,
					"content": "Nếu giả thiết nói trên là đúng, đây cũng chính là nguyên lý cơ bản để hạt giống có thể bảo quản trong thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070114
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070114,
					"content": "Tôi... tôi không hiểu cho lắm, ý Sabbah nói là hạt giống đều biến thành đá hết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070115,
					"content": "Thành đá à, quả nhiên là không còn hi vọng gì rồi, đá làm sao nở ra Tường Vi Vàng được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070116,
					"content": "Tường Vi Vàng? Là Tường Vi Vàng trong bài ca dao ấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070117,
					"content": "Ồ, các cháu chắc vẫn chưa biết sao, Ca Dao Tường Vi được lưu truyền trong làng, ban đầu chính là do ông Shafaqat biên soạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070118
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070118,
					"content": "Ông ấy dạy cho trưởng bối của ta bài ca dao tự ông biên soạn, trưởng bối của ta lại truyền dạy cho con cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070119
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070119,
					"content": "Đến thế hệ của ta cũng đã có người không biết chuyện này rồi, đợi đến khi người của thế hệ này ra đi hết rồi thì sẽ chẳng còn ai nhớ đến ông ấy nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070120
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070120,
					"content": "\"Tường vi ơi tường vi, hãy thực hiện nguyện vọng của ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070121
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070121,
					"content": "\"Hoa nở từ đá, Tường Vi Vàng ca hát cho ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070122,
					"content": "Đúng vậy... chúng ta có thể làm đá nở hoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070123
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070123,
					"content": "Sabbah nghĩ ra gì rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070124
					]
				},
				{
					"id": 732070124,
					"content": "Giống như gợi ý có trong bài ca dao ấy, có lẽ tách vỡ lớp vỏ đá bên ngoài thì sẽ có thể làm cho hạt giống nảy mầm từ trong đá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070125
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070125,
					"content": "Bình thường khi trồng cây cũng cần phải tạo một điều kiện lý tưởng để đánh thức hạt giống, làm cho chúng tự phá vỡ vỏ hạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070126
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070126,
					"content": "Nhưng nếu vỏ ngoài của loài tường vi này quá cứng rắn, mầm cây khó có thể tự mình phá vỡ vỏ hạt, chúng ta có thể thử giúp chúng từ bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070127
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070127,
					"content": "Ông Affan, ông xem có được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070128
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070128,
					"content": "Muốn dùng phương pháp bạo lực đập vỡ hạt giống ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070129,
					"content": "Đương nhiên không thể đập vỡ hoàn toàn hạt giống, chúng ta phải để người khéo tay làm chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070130
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070130,
					"content": "#{NICKNAME}, có thể nhờ bạn được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070131,
						732070132
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070131,
					"content": "Quả nhiên lại là tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				},
				{
					"id": 732070133,
					"content": "Trong lúc thực hiện nhất định phải cẩn thận, đầu tiên dùng <color=#00E1FFFF>trọng kiếm</color> đập vỡ lớp vỏ hạt giống, sau đó dùng sức mạnh của <color=#00E1FFFF>Nguyên Tố Thảo </color> để \"đánh thức\" hạt giống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070132,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				}
			]
		},
		{
			"id": 7320703,
			"completionStepIds": [
				7320703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320703",
							"2"
						],
						"stepId": 7320703,
						"stateName": "QUEST_STATE_UNFINISHED"
