			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060402,
					"content": "Về Affan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "Ừm? Chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060404,
					"content": "Nói với Sabbah về chuyện ông Affan gặp khó khăn.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "Thì ra là vậy, thế nên bạn đến nhờ tôi trợ giúp à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060406,
					"content": "Tuy rằng được bạn nhớ đến vào những lúc thế này là niềm vinh hạnh đối với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060407,
					"content": "Nhưng suy cho cùng, tôi không phải học giả chuyên nghiên cứu về nuôi trồng thực vật, kinh nghiệm của tôi cũng có hạn thôi, không chắc sẽ giúp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060408,
					"content": "Nhưng tôi sẽ cố gắng thử xem sao, huống gì người nuôi trồng được giống tường vi mới mà bạn nhắc cũng rất đáng quan tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060409,
					"content": "Đợi khi tôi rảnh sẽ đến vườn ươm của ông Affan, sau này cứ đến đó tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320606,
			"completionStepIds": [
				7320706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
