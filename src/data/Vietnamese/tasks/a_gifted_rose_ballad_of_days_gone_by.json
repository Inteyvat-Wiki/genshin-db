				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "Sau khi lặng lẽ chờ đợi một chốc, chồi non chậm rãi trồi lên khỏi mặt đất.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "Cách của Sabbah thật sự có hiệu quả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070302,
					"content": "Cuối cùng cũng nảy mầm rồi, cuối cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070303,
					"content": "Xem ra, tâm nguyện khi còn sống của ông Shafaqat có thể thành hiện thực rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070304,
					"content": "Ông Affan, trước đây ông từng nói với cháu, loại tường vi này là do ông ấy gây trồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070305,
					"content": "Có thể gây trồng ra giống mới, ông ấy cũng là học giả bị lưu đày đến nơi này như cháu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070306,
					"content": "...Đúng thế. Ông ấy bị lưu đày đến làng này, sống cả đời ở ngôi nhà sau lưng chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070307,
					"content": "Ra là vậy. Cũng đúng, nếu đã biến thành kẻ bị lưu đày thì kết cục sau cùng đều sẽ như thế mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070308,
					"content": "Nói ra thì, việc gây trồng giống mới chỉ có học giả đạt trình độ cao nhất mới làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070309,
					"content": "Một người như ông ấy lại không được lưu danh, cứ thế ra đi ở nơi ngoài Giáo Viện, thật là đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070310,
					"content": "Sabbah đang nghĩ đến tương lai của bản thân sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070311,
					"content": "Phấn chấn lên nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "Đúng vậy, cô bé à, cháu vẫn còn con đường rất dài phải đi, còn rất nhiều chuyện có thể làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070313,
					"content": "Đừng để muộn phiền vây lấy, ta không muốn nhìn thấy quỷ già thứ hai xuất hiện đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070317,
					"content": "Nói cũng đúng, tại sao mình lại buồn bã trong thời khắc vui vẻ thế này chứ, chúng ta nói chuyện chính đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070318,
					"content": "Hiện tại những cây Tường Vi Vàng này chỉ mới nảy mầm, vẫn chưa ra hoa. Tôi muốn được chứng kiến Tường Vi Vàng nở rộ, mọi người thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070319,
					"content": "Tôi cũng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "Vậy chúng ta đợi thêm chút nữa để chúng hấp thụ dinh dưỡng nhé, sau một thời gian rồi cùng chứng kiến chúng nở rộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070314,
					"content": "(Không biết làm sao để khuyên nhủ Sabbah...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "Đừng buồn, cháu xem, đến cuối cùng ông ấy vẫn để lại cho chúng ta Tường Vi Vàng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070316,
					"content": "Chúng có thể chứng minh là ông Shafaqat đã từng đến thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				}
			]
		},
