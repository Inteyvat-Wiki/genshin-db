				"points": []
			},
			"dialogs": [
				{
					"id": 732060601,
					"content": "Ông Shafaqat, cháu không thể thay ông hoàn thành tâm nguyện cuối cùng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060602,
						732060609
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060602,
					"content": "Shafaqat là ai vậy ạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060603
					]
				},
				{
					"id": 732060603,
					"content": "Chẳng phải trước đó các cháu còn hỏi ta chuyện của quỷ già sao, thật ra quỷ già vốn không phải tên là quỷ già, dù gì cũng chẳng có tên thật của ai lại gọi như vậy cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060604
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060604,
					"content": "Nghe trưởng bối của ta bảo, ông ấy thật ra tên là Shafaqat, thời còn trẻ đã rời khỏi Thành Sumeru để đến ngôi làng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060605
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060605,
					"content": "Sau khi ông ấy đến thì đã xây một căn nhà nhỏ để sống một mình, sau đó suốt mấy chục năm trời hầu như không rời đi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060606
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060606,
					"content": "Ta chưa gặp ông ấy thời còn trẻ, nhưng nghe nói khi ấy ông ấy vẫn chưa ghét trẻ con đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060607
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060607,
					"content": "Trước và sau nhà ông ấy trồng rất nhiều hoa và cây cối, bọn trẻ con rất thích chạy đến nhà ông ấy chơi, cùng ăn Quả Ajilenakh, nghe ông ấy kể chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060608
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060608,
					"content": "Nhưng khi ta gặp ông ấy thì ông ấy đã già rồi, bị người ta gọi là quỷ già và trở nên ghét trẻ con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060621,
					"content": "Chắc chắn vẫn còn cách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060622
					]
				},
				{
					"id": 732060622,
					"content": "Vẫn còn có cách nào ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060623
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060623,
					"content": "Ông Shafaqat... cũng chính là quỷ già, đã lặng lẽ rời đi từ lâu. Nếu không ta còn có thể đi hỏi xem có cách đặc biệt nào để trồng những bông tường vi này hay không rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060624
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060624,
					"content": "Bây giờ ta còn có thể hỏi ai đây chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060625
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060625,
					"content": "Cháu có quen một học giả của Học Phái Amurta tên là Sabbah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060626
					]
				},
				{
					"id": 732060626,
					"content": "Ồ, cháu đang nói về cô gái từ bên ngoài đến à. Cô ấy có thể giúp được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060627
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060627,
					"content": "Hơn nữa, trước đây cô ấy có đi qua chỗ ta, bị ta nói cho mấy câu đuổi đi mất rồi. Liệu cô ấy sẽ đồng ý giúp đỡ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060628
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060628,
					"content": "Cháu sẽ thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060629
					]
				},
				{
					"id": 732060629,
					"content": "Cháu thật là một đứa trẻ tốt bụng, nếu không tìm được người giúp đỡ thì cũng không sao, cháu có lòng tốt như vậy là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060609,
					"content": "Tại sao lại cố chấp với việc trồng hoa vậy ạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060610
					]
				},
				{
					"id": 732060610,
					"content": "Trong làng chúng tôi, thỉnh thoảng sẽ có một số người từ bên ngoài đến và bất đắc dĩ phải định cư ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060611
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060611,
					"content": "Có người dù có cố bắt ép bản thân, nhưng vẫn không thể quen với cuộc sống ở đây, cuối cùng sống cô độc đến hết đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060612
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060612,
					"content": "Có lẽ quỷ già... cũng chính là ông Shafaqat, cũng là một trong số đó. Bao lâu nay, mọi người đều đã quen với chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060613
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060613,
					"content": "Nhưng dù thế nào, ta vẫn không cam lòng làm quen với điều này. Thật đáng tiếc thay cho ông ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060614
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060614,
					"content": "Nếu cháu nhìn thấy vườn hoa của ông ấy hẳn cũng sẽ thích cho mà xem, những loài hoa đủ màu sắc, còn có cả cây cối cao cao thấp thấp mọc xen nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060615
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060615,
					"content": "Người đã chăm được một vườn hoa như thế mà lại âm thầm ra đi. Những chuyện liên quan đến ông ấy, mọi người chỉ nhớ mỗi việc quỷ già sẽ bắt cóc những đứa trẻ nghịch ngợm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060616
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060616,
					"content": "Ta không hề muốn chấp nhận chuyện này, sổ ghi chép mà ông ấy để lại viết rằng ông ấy muốn những bông tường vi này mọc ở khắp nơi, ta rất muốn hoàn thành tâm nguyện của ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060617
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060617,
					"content": "Dẫu sao thì ta cũng đã ở tuổi này rồi, mọi người nghĩ sao về ta cũng chẳng sao, có thể làm xong việc này thì xem như cuộc sống của ta không vô nghĩa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060618
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060618,
					"content": "Ta đã dọn dẹp nhà cửa gọn gàng cho ông ấy, đống sổ ghi chép ông ấy để lại ta cũng đã phân loại xong xuôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060619
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060619,
					"content": "Nếu cháu hứng thú, ta có thể lấy một quyển ra cho cháu xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060620
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060620,
					"content": "Ta đặt ở <color=#00E1FFFF>trước cửa</color> nhé, để ông ấy được cảm nhận ánh mặt trời dù chỉ thông qua những quyển sổ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
