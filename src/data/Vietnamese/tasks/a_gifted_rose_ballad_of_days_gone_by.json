			"dialogs": [
				{
					"id": 732030619,
					"content": "Cuộc sống ở Làng Aaru thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "Cũng tàm tạm. Có cơm ăn, có chỗ ở, về cơ bản cuộc sống được bảo đảm như vậy là rất ổn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030621,
					"content": "Dù gì cũng là người bị đuổi đến nơi này nên cũng không thể yêu cầu thái quá về sách và vật dụng nghiên cứu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030622,
					"content": "Hơn nữa từ trước đó, ngôi làng này đã là nơi Giáo Viện lưu đày học giả, điều kiện sinh sống và điều kiện nghiên cứu không thể sánh với Thành Sumeru, nghiễm nhiên cũng không có bầu không khí học thuật gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030623,
					"content": "Tôi không phải là kẻ lưu đày đầu tiên tới đây, có lẽ cũng không phải là người cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030624,
					"content": "Đến cũng đã đến rồi, quen rồi là được. Chỉ có thể nghĩ như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
					"content": "Một lúc mà tôi đã nói nhiều chuyện như vậy rồi, thật nhẹ nhõm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030626,
					"content": "Trước khi bạn đến, tôi ở đây không có bạn bè, quả thật là có hơi cô đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030629,
					"content": "Ở trong thôn, có rất ít người rảnh rỗi trồng hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030630,
					"content": "Ừm... nói như vậy là không đúng, ở phía bắc ngôi làng cũng có một ông lão tạo ra một khu vườn ươm, dùng để trồng hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030631,
					"content": "Tôi đến thăm ông ấy rồi, một ông lão hơi kỳ quặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030632,
					"content": "Rõ ràng ông trồng \"đá\", nhưng lại nói mình đang trồng hoa, còn đuổi tôi đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030633,
					"content": "Sống một mình cũng hơi cô đơn nhỉ, tôi có thể hiểu được tâm trạng ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030634,
					"content": "Bạn có thể giúp Tường Vi Sumeru của tôi ra hoa, nói không chừng cũng có thể giúp được ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030635,
					"content": "Nếu có cơ hội, bạn và Paimon cũng tới thăm ông ấy thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320604,
