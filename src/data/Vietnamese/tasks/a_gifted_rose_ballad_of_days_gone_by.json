			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030701,
					"content": "Đến tìm tôi để trò chuyện hả? Tôi đang có một đống chuyện muốn kể đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "Cô là học giả của học phái nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "Muốn nói về học phái của tôi ư? Tôi có thể nói ba ngày ba đêm không nghỉ đấy, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030607,
					"content": "Trước đây tôi thuộc Học Phái Amurta, chuyên nghiên cứu về sự biến đổi của thực vật, cũng tính là một ngành khoa học nghiên cứu thực chứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030608,
					"content": "Điều này có nghĩa là không có tài liệu mới thì sẽ rất khó để khám phá ra kết luận mới, bạn có thể hiểu đơn giản là: Muốn kiểm tra những loài thực vật cũ thì mẫu vật lịch sử là cơ sở nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030609,
					"content": "Nhưng những mẫu vật dễ thu thập thì rất nhiều, về cơ bản chúng đều được thu thập hết cả rồi, những mẫu vật mới mà Giáo Viện có thể cung cấp thì có hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030610,
					"content": "Điều kiện khách quan là như vậy, nhưng trong Giáo Viện vẫn đang không ngừng yêu cầu chỉ tiêu nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030611,
					"content": "Có người lấy tất cả những thành tựu nghiên cứu trước đây, thay chỗ này một tí, thêm chỗ kia một tí, rồi cũng tính là báo cáo kết quả nghiên cứu. Bạn chắc chắn cũng cảm thấy như vậy chẳng có ý nghĩa gì đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030612,
					"content": "Thật ra tôi hoàn toàn có thể thử tìm tài liệu mới từ góc độ địa lý lịch sử, như vậy nhất định sẽ có được phát hiện mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030613,
					"content": "Cũng có thể sử dụng những tài liệu văn học không được Học Phái Amurta chú trọng. Có điều nếu như vậy thì sẽ không tránh khỏi phải liên quan tới lĩnh vực của Học Phái Vahumana và Học Phái Haravatat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030614,
					"content": "Tôi lại không hiểu biết những lĩnh vực đó, thủ tục xin những \"kiến thức\" ấy lại quá rắc rối, hợp tác với các học giả của lĩnh vực liên quan thì lại càng khó hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030615,
					"content": "Nhưng tôi tin rằng, nếu chúng tôi có thể hợp tác liên ngành thì nhiều vấn đề của trước kia cũng sẽ có bước đột phá mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030616,
					"content": "Chỉ tiếc là không thể tiếp tục thực hiện những thử nghiệm như thế nữa, cách những con người kỳ quặc của Học Phái Vahumana và Học Phái Haravatat thảo thuận công việc rất là... ừm... vi diệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030617,
					"content": "Trong những đề án tôi đưa cho họ, tất cả các từ ngữ diễn đạt đều được cân nhắc kỹ lưỡng để tránh xảy ra hiểu lầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030618,
					"content": "Trước khi bị đuổi khỏi Giáo Viện, tôi vẫn đang cãi nhau với một tên thuộc Học Phái Haravatat. Bây giờ thì hay rồi, muốn tìm họ để cãi nhau cũng khó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
					"content": "Một lúc mà tôi đã nói nhiều chuyện như vậy rồi, thật nhẹ nhõm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030626,
					"content": "Trước khi bạn đến, tôi ở đây không có bạn bè, quả thật là có hơi cô đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030629,
					"content": "Ở trong thôn, có rất ít người rảnh rỗi trồng hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030630,
					"content": "Ừm... nói như vậy là không đúng, ở phía bắc ngôi làng cũng có một ông lão tạo ra một khu vườn ươm, dùng để trồng hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030631,
					"content": "Tôi đến thăm ông ấy rồi, một ông lão hơi kỳ quặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030632,
					"content": "Rõ ràng ông trồng \"đá\", nhưng lại nói mình đang trồng hoa, còn đuổi tôi đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030633,
					"content": "Sống một mình cũng hơi cô đơn nhỉ, tôi có thể hiểu được tâm trạng ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030634,
					"content": "Bạn có thể giúp Tường Vi Sumeru của tôi ra hoa, nói không chừng cũng có thể giúp được ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030635,
					"content": "Nếu có cơ hội, bạn và Paimon cũng tới thăm ông ấy thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
