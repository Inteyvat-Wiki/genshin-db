			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "Loài hoa khiến người ta nhung nhớ, tôi đã chuẩn bị xong món quà tặng bạn, bạn cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900202,
					"content": "Toàn là những loài thực vật không thể nảy mầm sinh trưởng ở nơi đây, nếu bạn có khu vườn ở nơi khác thì có thể nhìn thấy chúng sinh trưởng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900203,
					"content": "Một lúc mà tôi đã nói nhiều chuyện như vậy rồi, thật nhẹ nhõm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900204,
					"content": "Trước khi bạn đến, tôi ở đây không có bạn bè, quả thật là có hơi cô đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900207,
					"content": "Ở trong thôn, có rất ít người rảnh rỗi trồng hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900208,
					"content": "Ừm... nói như vậy là không đúng, ở phía bắc ngôi làng cũng có một ông lão tạo ra một khu vườn ươm, dùng để trồng hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900209,
					"content": "Tôi đến thăm ông ấy rồi, một ông lão hơi kỳ quặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900210,
					"content": "Rõ ràng ông trồng \"đá\", nhưng lại nói mình đang trồng hoa, còn đuổi tôi đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900211,
					"content": "Sống một mình cũng hơi cô đơn nhỉ, tôi có thể hiểu được tâm trạng ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900212,
					"content": "Bạn có thể giúp Tường Vi Sumeru của tôi ra hoa, nói không chừng cũng có thể giúp được ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900213,
					"content": "Nếu có cơ hội, bạn và Paimon cũng tới thăm ông ấy thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
