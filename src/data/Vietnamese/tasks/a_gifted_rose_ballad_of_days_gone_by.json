			"dialogs": [
				{
					"id": 732070501,
					"content": "\"Tường vi ơi tường vi, hãy thực hiện nguyện vọng của ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070502,
					"content": "\"Hoa nở từ đá, Tường Vi Vàng ca hát cho ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070503,
					"content": "\"Hát rằng:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070504,
					"content": "\"Ta chẳng tồn tại trong đất cát, chỉ ẩn chứa trong thơ ca.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070505,
					"content": "\"Ca dao đánh tan số phận, viết lại kết cục của ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070506,
					"content": "\"Đánh bại ta, đánh bại thời gian, đánh bại sự tan biến luôn trường tồn.\"",
					"roleType": "TALK_ROLE_NPC",
