			"dialogs": [
				{
					"id": 210049001,
					"content": "Bí mật nào được giấu trong \"truyền thuyết\" của Liyue đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049002,
					"content": "Về chi tiết \"Truyền thuyết\" ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049003
					]
				},
				{
					"id": 210049003,
					"content": "Ồ, nhắc đến \"truyền thuyết\", chi bằng nói nó là \"câu đố\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049004,
					"content": "\"Câu đố\" này được các cư dân sống tại vùng \"Quy Li Nguyên\" lưu truyền bằng miệng",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049005,
					"content": "\"Ở nơi giao nhau giữa trí tuệ và ý chí, đoàn kết và kiên nghị, ta sẽ cho thấy kho báu dồi dào của đại lục\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049006,
					"content": "Thế nào? \"Câu đố\" này giống như đang nói về báu vật được cất giấu sâu dưới lòng đất vùng \"Quy Li Nguyên\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049007,
					"content": "Nếu dự đoán của tôi là chính xác, bốn từ nên nói đến bốn di tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049008,
					"content": "Nếu tìm thấy tất cả bốn di tích này, có thể có thể giải được \"truyền thuyết\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049009,
					"content": "Tuy nhiên, thể lực của tôi không được tốt lắm... Phát hiện được di tích, quay về cũng cần nhiều ngày nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049010,
					"content": "Nếu bạn có hứng thú đi tìm biết đâu có thể... bạn sẽ tìm thấy điều gì đó đặc biệt trước tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
