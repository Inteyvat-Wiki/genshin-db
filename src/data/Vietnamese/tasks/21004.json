			"dialogs": [
				{
					"id": 210040201,
					"content": "Tôi có hứng thú.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040202
					]
				},
				{
					"id": 210040202,
					"content": "Tôi đã đánh dấu trên bản đồ cho bạn những di tích được phát hiện rồi, mau đi xem đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040203,
					"content": "Nhân tiện, nếu bạn tìm thấy bất kỳ manh mối nào, đừng quá phấn khích, hãy nhớ <color=#00E1FFFF>đánh dấu</color>, rồi dần giải mã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
