				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "Thế nào rồi? Các bạn tìm thấy kho báu rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "Tìm thấy rồi, quả thực là ở \"vùng đất hợp thành\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Thì ra là vậy... Đúng như \"bốn lời răn Guizhong\" nhắc đến, kho báu nằm ở \"vùng đất hợp thành\" của bốn lời răn ư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Người đặt ra câu đố như vậy, chắc hẳn rất tôn kính \"Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "Dẫu cho quê hương bị hủy diệt vẫn dùng cách thức này để \"Bốn lời răn Guizhong\" mãi được lưu truyền sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "Hơn nữa \"Guizhong\" - người viết ra 4 lời răn này chắc chắn rất yêu quý con dân trong vùng đất mình bảo vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "Cô ấy hy vọng con dân của mình sử dụng trí tuệ và đạo đức để nhận thức hành vi của bản thân, ban lời chúc phúc cho họ được khỏe mạnh, đoàn kết cùng nhau bảo vệ quê nhà \"Quy Li Tập\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "Có điều cô ấy vẫn thất bại đó thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Thất bại ư? Nói như vậy quả là không sai, cái chết của cô ấy... Khiến \"Quy Li Tập\" bị hủy diệt, còn con dân lại sống lưu lạc khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "Nhưng chẳng phải chúng ta đang muốn \"Bốn lời răn Guizhong\" tái xuất trên thế gian này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "Đây chính là lời răn mà \"Guizhong\" tự tay viết cho con dân của mình, hơn nữa còn ban phúc cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Tuân theo \"Bốn lời răn Guizhong\", cô ấy từng cùng con dân của mình cùng nhau bảo vệ vùng đất rộng lớn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "Dẫu cho cô ấy có hy sinh, thế nhưng lý tưởng và đức tin của Guizhong mãi không phai nhòa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "Hơn nữa người sùng kính cô cũng vô cùng thông minh, nghĩ ra cách dùng \"kho báu\" để khiến \"Bốn lời răn Guizhong\" truyền lại đời sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Có điều cũng không hiểu rõ báu vật cuối cùng là chỉ tiền tài hay là \"Bốn lời răn Guizhong\" này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Haha, theo tôi thấy, báu vật thực sự chính là \"lời răn\", chúng còn quý hơn cả vàng bạc trang sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "...Thế nhưng nếu để con người ta lựa chọn có bao nhiêu người chấp nhận từ bỏ tiền tài để nhận lấy \"lời răn\" này cơ chứ? Haizz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "Quả là một ma thần hiền hậu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "Sử dụng từ \"hiền hậu\" để liên tưởng đến một vị \"ma thần\" có chút không phù hợp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "Trong rất nhiều ma thần từng dẫn dắt loài người, có lẽ cũng có ma thần \"hiền hậu\" như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Bảo vệ con dân của mình, cùng họ vững bước trên cả vùng đất rộng lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "...Có điều ma thần hiền hậu như vậy, cuối cùng vẫn không thể bảo toàn tính mạng của mình. Đến ngay cả lời răn dành cho con dân cũng phải ẩn mình dưới cách nói \"kho báu\" mới có thể lưu truyền về sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "Tôi rất muốn gặp cô ấy một lần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "Bạn còn muốn gặp ma thần sao, ý nghĩ của bạn thật khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "Thế nhưng nếu thực sự gặp được \"Guizhong\", bạn sẽ làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "Chẳng lẽ nói những lời như \"ngài vất vả rồi\", \"cảm ơn ngài\" để an ủi cô ấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "Nếu là tôi, chi bằng học thuộc lòng \"Bốn lời răn Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "Sau đó sẽ nói với cô ấy rằng, lý tưởng và đức tin của cô ấy sẽ truyền mãi, người dân trên vùng đất rộng lớn này sẽ nhớ mãi lời giáo huấn của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "Đối với người đã mất đi tất cả như \"Guizhong\" có lẽ... Đây là lời an ủi tốt nhất với cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
