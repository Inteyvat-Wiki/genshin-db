				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "Cho dù là ma thần, cũng không thoát khỏi vòng cuốn của định mệnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042002,
					"content": "Tìm thấy 4 manh mối trong ở 4 di tích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "4 di tích, 4 manh mối... Rất giống với số lượng trong \"Bốn lời răn Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042004,
					"content": "Có điều, bốn câu này đều giải thích cho một thứ gì đó trong \"Bốn lời răn Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042005,
					"content": "Muốn có cách hiểu chính xác quan trọng nhất phải dựa vào văn gốc của \"Bốn lời răn Guizhong\", còn 4 câu này chỉ là giải thích thêm mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042006,
					"content": "Phải ghép cả 5 đoạn này lại, nhưng giải thích thế nào mới phù hợp đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042007,
					"content": "\"Hội chi nhi thành\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "Hội chi nhi thành... Dường như đang nói đến việc ghép chúng lại với nhau bằng một cách nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042009,
					"content": "Đợt một lát, tôi còn nhớ 4 đoạn \"lời răn\" đều có ở một di tích nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042010,
					"content": "Ồ... Suy đoán của tôi vẫn không chắc chắn lắm. Nếu muốn giải thích 4 đoạn \"lời răn\" này phải nhờ vào sự giúp đỡ của <color=#00E1FFFF>\"di tích\"</color> - nơi ghi lại những \"lời răn\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042011,
					"content": "Có điều cách thức cụ thể thế nào tôi vẫn cần chút thời gian... Bạn cũng nghĩ cùng với tôi đi, nếu phát hiện ra điều gì mới cứ trực tiếp tiến hành là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042012,
					"content": "Bởi vì bạn khác với người có \"thân thể suy nhược\" như tôi, chỉ chạy vài bước là... Thật ngưỡng mộ bạn có thể lực tốt như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042013,
					"content": "Được rồi, tôi ở đây suy nghĩ một lát, nếu bạn có phát hiện gì mới nhớ nói với tôi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
