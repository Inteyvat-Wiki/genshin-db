			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "\"Bốn lời răn Guizhong\"... Là ám chỉ thứ gì chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040102,
					"content": "Tôi chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "Haha bạn đã hưng phấn như vậy sao. Thôi được rồi, chúng ta bắt đầu giải mã \"bốn lời răn Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040106,
					"content": "\"Giáo chi dĩ trí, luật chi dĩ đức, kiên kỳ cân cốt, chúng chí nhất tâm, tứ giả hội chi nhi thành Quy Li Tập.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040107,
					"content": "Về mặt chữ mà nói, quả đúng là \"lời răn\" trong cuộc sống thường ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040108,
					"content": "Nhưng câu nói này đâu có nhắc đến manh mối nào về kho báu đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040109,
					"content": "... Hết cách rồi, chỉ có thể dùng phương thức được coi là ngốc nhất, khó thực thi nhất của đám học giả chúng tôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040110,
					"content": "Đầu tiên là nơi chúng ta phát hiện ra chúng đều nằm trong các \"di tích\" có kiến trúc khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040111,
					"content": "Hiện tại vẫn chưa biết phải xử lý thế nào, vậy thì chúng ta tiếp tục tìm manh mối ở \"di tích\" xem sao vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040112,
					"content": "Tìm ở đâu cơ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Hừm... Khu vực tìm kiếm trước mắt tạm thời khoanh vùng ở \"Quy Li Nguyên\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040114,
					"content": "Bạn thấy đấy, học giả như tôi nhất định không thể nào theo nổi bước chân của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040115,
					"content": "Vì vậy việc tìm manh mối ở di tích phải nhờ cả vào bạn rồi, nếu có phát hiện gì mới thì nhớ về nói với tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040129,
					"content": "À hình như trước kia tôi từng phát hiện một di tích nằm gần khu vực này, hơn nữa tại đó còn có đĩa tròn kỳ lạ, bên trên còn có bút tích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040130,
					"content": "Lúc đó tôi chỉ làm một vài nghiên cứu đơn giản, chứ không đi sâu vào tìm hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040131,
					"content": "Bây giờ nghĩ lại, cái đĩa tròn trong khu vực ấy có lẽ liên quan đến \"bốn lời răn Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040132,
					"content": "Xong rồi, tôi đánh dấu chúng trên bản đồ bây giờ bạn có thể đến xem, không biết chừng có phát hiện gì mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040116,
					"content": "Phải tìm hết một lượt sao....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "Đương nhiên là không rồi, nếu phạm vi tìm kiếm là cả khu vực Liyue thì hai chúng ta sẽ chẳng bao giờ đi hết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040118,
					"content": "Nếu kho báu nằm ở \"Quy Li Tập\" thuộc Quy Li Nguyên, vậy thì chúng ta thu hẹp phạm vi tìm kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040119,
					"content": "Khu vực tìm kiếm tạm thời nằm trong \"Quy Li Nguyên\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040120,
					"content": "À đúng rồi, bạn thấy đấy người học giả như tôi nhất định là không theo kịp bước chân của bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040121,
					"content": "Vì vậy việc tìm manh mối ở di tích phải nhờ cả vào bạn rồi, nếu có phát hiện gì mới thì nhớ về nói với tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040122,
					"content": "Vậy là tôi phải đi xem hết một loạt di tích trong Liyue rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "Đợi một lát! Chớ có manh động như vậy chứ, Liyue lớn như thế này tìm đến lúc nào mới xong được?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040124,
					"content": "Nghe đến kho báu là hừng hực khí thế như vậy... Tôi quả thực không biết nói bạn thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040125,
					"content": "Nếu kho báu là ở \"Quy Li Tập\" nằm trên \"Quy Li Nguyên\", vậy thì chúng ta thu hẹp phạm vi tìm kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040126,
					"content": "Tôi muốn... Tạm thời tìm kiếm trong vùng \"Quy Li Nguyên\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040127,
					"content": "Này, nghe tôi nói xong rồi hãy đi chứ! Nhớ rõ chưa, nhất định phải tìm kiếm trong di tích cẩn thận, nếu có phát hiện gì mới nhớ nói với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040128,
					"content": "Nhớ rõ rồi, tìm kiếm bên trong khu vực \"Quy Li Nguyên\", không tìm quá xa là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040104,
					"content": "Đi tìm kho báu ư!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "Mới nói đến kho báu mà mắt bạn đã sáng như đèn pha rồi... Thôi được rồi, chúng ta bắt đầu giải mã \"bốn lời răn Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				}
			]
		},
