						210042202
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042202,
					"content": "\"Giúp đỡ\" thế nào thì tôi vẫn đang suy nghĩ. Hơn nữa... Tôi không có đủ sức khỏe để thử từng suy đoán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042203,
					"content": "Nhưng nếu cứ tiếp tục theo cách này thì sẽ chẳng có tiến triển gì vượt bậc...",
					"roleType": "TALK_ROLE_NPC",
