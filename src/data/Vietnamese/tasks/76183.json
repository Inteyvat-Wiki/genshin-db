			"dialogs": [
				{
					"id": 761830101,
					"content": "Cảm ơn lời mời của cô, Sandrone. Bánh và trà vẫn là hương vị quen thuộc, thật khiến người ta hoài niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830102
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830102,
					"content": "Đừng khách sáo. Nếu thích thì ở Snezhnaya chúng ta cũng hãy gặp gỡ thường xuyên như trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830103,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830104
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830104,
					"content": "Nói đến Snezhnaya, bên cô vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830105,
					"content": "Ừm, kế hoạch của Nữ Hoàng bệ hạ đã có tiến triển, nhưng việc thực thi Kế Hoạch Stuzha lại khó khăn hơn nhiều so với tưởng tượng của ngài thị trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830106
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830106,
					"content": "Nói vậy thì sau này chúng ta đều sẽ bận rộn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830107,
					"content": "Nhưng chắc vẫn có thời gian thỉnh thoảng ra ngoài uống trà hay đến Đoàn Kịch Korolevskiy xem biểu diễn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830124,
					"content": "Ừm, thỉnh thoảng ra ngoài uống trà hay đến Đoàn Kịch Korolevskiy xem biểu diễn thì chắc vẫn có thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830108
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830108,
					"content": "Odette vẫn còn múa ba lê chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830109,
					"content": "Ừm, một thời gian không gặp, kỹ thuật của cô ấy lại tiến bộ thêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830110
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830110,
					"content": "Thật tốt quá, khi nào về tôi cũng muốn đến xem một vở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830111,
					"content": "Có lúc nhìn cô ấy sẽ thấy rất kỳ diệu. Rõ ràng là do Rosalyne dạy dỗ, nhưng tính cách và cách hành xử lại hoàn toàn khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830112,
					"content": "Thế cũng chưa chắc đã là chuyện xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830113
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830113,
					"content": "Ừm... nếu như Rosalyne cho người ta cảm giác rực rỡ như ngọn lửa thì Odette lại như tảng băng kiên cố. Một tảng băng không thể nhìn thấu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830114,
					"content": "Cô ấy dường như đang gánh vác rất nhiều thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830115
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830115,
					"content": "Đúng vậy, nhưng khi biểu diễn trên sân khấu, những bước nhảy lại thuần khiết đến lạ thường, như thể trong lòng không vướng chút tạp niệm nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830116,
					"content": "Hoặc là đã che giấu chúng ở nơi người ta không thể nhìn thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830117
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830117,
					"content": "Ừm, suy cho cùng thì vẫn giống băng, nhưng không hề mong manh chút nào. Băng kiên cố, cứng cáp. Dù sao cũng là kiểu vô cùng nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830118,
					"content": "Điểm này lại rất giống Rosalyne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830119
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830119,
					"content": "Mặt nguy hiểm ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830120,
					"content": "Mặt kiên cường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830121
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830121,
					"content": "Cũng đúng. Không lạ khi người ta nói cô ấy là thành viên Fatui có tiềm năng kế thừa danh hiệu \"Signora\" nhất hiện nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830122,
					"content": "Ha... Nếu sau này thân thiết hơn, thì mời cô ấy đến tham gia tiệc trà của chúng ta đi. Hy vọng cô ấy sẽ không từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830123,
					"content": "Hy vọng là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "Arlecchino"
				}
			]
		},
