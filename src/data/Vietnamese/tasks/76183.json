			"dialogs": [
				{
					"id": 761830201,
					"content": "Thỉnh thoảng thư giãn như vậy rất cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830202,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761830204,
					"content": "Được, hẹn gặp lại ở Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 761830203,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
