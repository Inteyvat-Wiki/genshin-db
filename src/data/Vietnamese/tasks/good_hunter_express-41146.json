						411460102
					]
				},
				{
					"id": 411460102,
					"content": "Vậy phiền bạn rồi, nơi đó xa quá, chúng tôi quả thực không cử ai đi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460103,
					"content": "Phải rồi, lúc đưa nhất định phải cẩn thận, <color=#00E1FFFF>đừng chạy quá nhanh, cũng đừng dùng Phong Chi Dực, càng không được leo núi gì đó...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460104,
					"content": "Nếu trên đường bị đụng phải, nước thịt và mì có khả năng sẽ bị tách rời... Nếu vậy khách chắc chắn sẽ không nhận món.",
