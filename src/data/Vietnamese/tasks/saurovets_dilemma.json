						750180342
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180342,
					"content": "Đây là loại có hiệu quả không bằng, nhưng màu sắc nhìn ngon miệng hơn.",
