			"dialogs": [
				{
					"id": 750180101,
					"content": "...Shwaaaargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "\"Kururuk\""
				},
				{
					"id": 750180102,
					"content": "Ngoan nào, đừng quấy nữa! Không uống thuốc thì sao cơ thể hồi phục được chứ... Ối!",
					"roleType": "TALK_ROLE_NPC",
