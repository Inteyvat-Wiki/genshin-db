				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "\"Shwrawr!\"\\nNhư biết mình không phải đối thủ, Qucusaur kêu lên rồi bay về phía xa...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "Ôi! Bay nhanh quá! Chớp mắt một cái đã bay xa vậy rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180303,
					"content": "Paimon, mau đuổi theo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "Hả, tôi đuổi theo? Tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180307,
					"content": "Hmm, bay nhanh như vậy, xem ra thể lực cũng đã hồi phục kha khá rồi. Tiếp theo sẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180308,
					"content": "Mà nói ra thì con Qucusaur này tại sao lại giận dữ như vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180309,
					"content": "...A, tôi biết rồi! Chẳng lẽ là món ăn sáng của nó bị ai đó lén ăn mất sao? Mối ân oán do thức ăn thường sẽ rất sâu đậm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180310,
					"content": "Hả? Đúng là tôi có làm qua. Nhưng Kururuk không phải là Qucusaur nhỏ nhen, cho nên sẽ không để tâm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180311,
					"content": "Kururuk? Thì ra nó cũng là một con Saurian có tên à... Nhưng nhìn có vẻ tính tình không tốt lắm nhỉ. Ban nãy còn tấn công lung tung nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180312,
					"content": "Ừm... Cũng không trách nó được, đều vì việc chữa trị cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180313,
					"content": "Thì ra bị đánh cũng là chữa trị à? Kiến thức mới đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#Sao mà có cách chữa trị như vậy chứ? Nhìn xem, {REALNAME[ID(2)|SHOWHOST(true)]} tin là thật rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180316,
					"content": "Rawr? Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "Haha, nếu thật sự có cách chữa trị này thì tôi cũng muốn thử xem đó! Nhưng Saurian khác với con người, dù có nói với chúng là sẽ nhanh chóng khỏi bệnh thì chúng cũng không hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180318,
					"content": "Đúng rồi, vẫn chưa tự giới thiệu. Tôi là Mazkal, thường sẽ chăm sóc cho Saurian bị thương hoặc bị bệnh ở quanh đây. Không phải tự khen, nhưng thuốc của tôi điều chế được đánh giá khá tốt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180319,
					"content": "Hmm, người bạn nhỏ của các vị có vẻ như rất khỏe mạnh, xem ra không cần tôi chăm sóc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180320,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "Thì ra là bác sĩ Saurian à. Hừm, nhìn tình trạng của Kururuk thì có vẻ như đây là một công việc rất cực khổ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180322,
					"content": "Tôi cảm thấy cũng không cực khổ lắm đâu, chẳng qua tình hình của Kururuk hơi đặc thù thôi... Giờ nó cực kỳ không tin tưởng loài người, cũng rất kháng cự việc chữa trị và uống thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180323,
					"content": "Haiz, nếu tôi cũng là Saurian thì tốt rồi. Theo quan sát trước đây thì nó cũng khá hòa hợp với những con Saurian khác, nếu là Saurian khuyên nó uống thuốc thì không chừng nó sẽ đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180324,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "Nếu là như vậy, nói không chừng chúng tôi có thể giúp được đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180326,
					"content": "Hả? Chẳng... Chẳng lẽ các vị là Saurian sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180327,
					"content": "Suy nghĩ này hơi xa quá rồi đó! Chậc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180328,
					"content": "#Thực ra là vì {REALNAME[ID(2)|SHOWHOST(true)]} là một chú Saurian nhỏ rất thông minh! Chuyện này có thể nhờ nó giúp đỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180329,
					"content": "Ồ? Thì ra nó lợi hại đến vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180330,
					"content": "Có thể chọn được tôi thì ít nhất là đã có đôi mắt tinh tường rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "Nói không sai... Nhưng mà bây giờ trọng tâm không phải chuyện này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180333,
					"content": "#Tóm lại thì chuyện nhỏ này cứ giao cho {REALNAME[ID(2)|SHOWHOST(true)]} là được!",
