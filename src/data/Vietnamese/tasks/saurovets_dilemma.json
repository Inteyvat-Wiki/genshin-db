			"dialogs": [
				{
					"id": 750181001,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181002
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750181002,
					"content": "Mọi người trở về rồi! Sao nào? Kururuk chịu uống thuốc chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181003
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181003,
					"content": "Uống thì có uống rồi, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181004,
					"content": "Giải thích ngắn gọn về tình hình ban nãy...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750181017
					]
				},
				{
					"id": 750181017,
					"content": "Thì ra là vậy... Để kiểm tra xem! Hmm... Không sao, chắc không có gì đáng ngại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181005
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181005,
					"content": "Dù sao thì nó chịu uống thuốc đã là chuyện tốt rồi! Hơn nữa tôi cũng biết được phản ứng của nó, sau này có thể điều chỉnh công thức cụ thể hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181006
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181006,
					"content": "#Ừm, chắc chắn sẽ không sao. Thật sự cảm ơn các vị, đặc biệt là {REALNAME[ID(2)|SHOWHOST(true)]} đấy, đúng là một con Tepetlisaur tuyệt vời mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181007
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181007,
					"content": "Rawwr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750181008,
					"content": "#Hihi, nghe người khác khen {REALNAME[ID(2)|SHOWHOST(true)]}, cảm thấy còn vui hơn mình được khen nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181009,
					"content": "Hai vị có thể ăn ý với Tepetlisaur như thế cũng rất giỏi rồi! Tôi cũng phải học hỏi hai vị mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181010,
						750181011
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181010,
					"content": "Không hổ danh là tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				},
				{
					"id": 750181012,
					"content": "Tuy rất muốn hỏi là có gì tôi có thể hỗ trợ hay làm giúp các vị không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181013
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181013,
					"content": "Nhưng vẫn nên chúc mọi người khỏe mạnh, tốt nhất là không bao giờ cần tìm đến sự giúp đỡ của tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181014
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181014,
					"content": "À, nhưng nếu các vị chỉ muốn đến trò chuyện thì hoan nghênh bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181015
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181015,
					"content": "Được đó. Cũng chúc Kururuk sớm ngày hồi phục, ít nhất thì không còn tấn công loạn lên nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181016,
					"content": "Chuyện này thì... Hãy tin tưởng tôi nhé, sau này tôi cũng sẽ nghĩ cách. Sau khi hồi phục nói không chừng tính tình cũng sẽ tốt lên đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181011,
					"content": "#Không đâu, vẫn là {REALNAME[ID(2)|SHOWHOST(true)]} giỏi hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				}
			]
