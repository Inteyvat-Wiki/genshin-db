					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "Ây da, đây chẳng phải là bạn mới của con gái chú sao? Hôm nay lại đến chơi nữa à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490102,
					"content": "Hôm nay buôn bán ổn chứ chú?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "Rất tốt! Ha ha ha, cũng đều nhờ vào pháo hoa của con gái chú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490104,
					"content": "Hôm nay các cháu đến tìm con bé sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490107,
					"content": "Thật không đúng lúc, con bé nói cần tìm nguyên liệu để làm pháo hoa nên đã ra ngoài rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490108,
					"content": "Vậy cô ấy đi đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "Cái, cái gì? Cháu nói gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490110,
					"content": "Yoimiya, cô ấy đi đâu rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "Ây da... Chú không rõ, con bé có nói nhưng chú nghe không rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490112,
					"content": "Các cháu tìm con bé có việc gì sao? Muốn mua pháo hoa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490113,
					"content": "Muốn tìm Yoimiya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "Ừm, lần này có lẽ các cháu không tìm được con bé rồi, mỗi lần con bé ra ngoài mần mò pháo hoa, thì không biết khi nào mới trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490115,
					"content": "Như vầy, trước khi con bé ra ngoài đã làm một số pháo hoa mới để ở tiệm, các cháu lấy những pháo hoa này chơi trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490118,
					"content": "Chú để mấy cái pháo hoa đó ở đâu mất rồi... hình như ở trong nhà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490119,
					"content": "Như vậy có phải không tốt lắm không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "Không sao không sao, trong tiệm còn nhiều hàng dự trữ lắm, các cháu lấy một hai cái không vấn đề gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490122,
					"content": "Hơn nữa, con bé vốn muốn tìm người chơi thử những loại pháo hoa mới này, hôm nay các cháu đến đây, đúng lúc có thể dùng thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490123,
					"content": "Các cháu cứ lấy pháo hoa đi chơi đi, sau khi chơi hãy nói cho chú biết pháo hoa như thế nào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490124,
					"content": "Đợi con bé trở về, chú sẽ nói lại với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490125,
					"content": "Yên tâm, con bé nếu biết pháo hoa là do các cháu lấy đi, nhất định sẽ rất vui mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490126,
					"content": "Mau đi đi, các cháu hãy đốt pháo hoa ở ngoài thành nhé. Nếu đốt pháo hoa trong thành sẽ gây chú ý đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490120,
					"content": "Cũng chưa nói với Yoimiya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "Muốn đốt pháo hoa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "Ha ha vậy được. Con bé trước khi ra ngoài đã làm một số pháo hoa mới để ở tiệm, các cháu hãy lấy chơi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490105,
					"content": "Cho hỏi Yoimiya có ở đây không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "Ây da, các cháu đến tìm con bé sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		},
