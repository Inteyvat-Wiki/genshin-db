				},
				{
					"id": 220490302,
					"content": "Rất đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "Các cháu thích là được, ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490306,
					"content": "Được rồi, chú phải đi trông tiệm rồi, gần đây số người mua pháo hoa càng ngày càng nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490307,
					"content": "Sao con bé đến giờ vẫn chưa quay về nhỉ, rốt cuộc nó đã đi đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490304,
					"content": "Chưa chơi đủ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "Các cháu rất thích sao? Vậy thì tốt, lần sau các cháu lại đến lấy để chơi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
