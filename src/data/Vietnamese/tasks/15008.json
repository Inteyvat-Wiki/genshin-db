					"nextDialogs": [
						150080509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080509,
					"content": "Có cần chụp lại không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080510,
					"content": "Ánh đèn sẽ làm phiền đến chúng mất. Để tôi sao chép lại vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080511
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080511,
					"content": "Sau khi sao chép lại hình vẽ, Mualani dẫn các bạn âm thầm quay trở về, rồi kể lại cho Viramdra và Karya về chuyện đã gặp phải.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080512
					]
				},
				{
					"id": 150080512,
					"content": "Nếu như vậy thì xem như đã vượt ải đầu tiên một cách hoàn hảo rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080513,
					"content": "Thì ra là vậy. Nếu ngay từ đầu chọn cách đuổi đàn Saurian đó đi, thì chắc chắn không thể có được manh mối... Quả nhiên có thể dùng lý luận để giải thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080514
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080514,
					"content": "Chị Karya, anh ấy luôn như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080515
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080515,
					"content": "Viramdra chỉ là quá đam mê nghiên cứu thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080516
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080516,
					"content": "Nhưng điều này cũng đã chứng minh phán đoán của tôi, nên có thể tin tưởng tôi mà. Lần sau mọi người không cần tranh cãi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080517
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080517,
					"content": "Tôi hiểu rồi... Như vậy đúng là có thể tránh bị mất thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080518
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080518,
					"content": "Mualani đúng là rất biết cách dẫn dắt đội đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080519,
					"content": "Dù sao thì cô ấy cũng là người dẫn đường chuyên nghiệp mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150080520
					]
				},
				{
					"id": 150080520,
					"content": "Tiếp theo là phải dùng manh mối mới này để tìm nơi tiếp theo phải đi. Hình ảnh này đại diện cho điều gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080521,
					"content": "Nhìn trừu tượng quá, tôi là không nhìn ra gì rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080522,
					"content": "...Hah! Là ở đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080523
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080523,
					"content": "Những đường nét này tuy rất đơn giản, nhưng tôi vẫn có thể nhìn ra được chúng là đường ranh giới giữa nước và đất liền của Đồi Váy Ngọc. Chỉ cần đặt nó vào chỗ trống trên bản đồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080524
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080524,
					"content": "Thế là có điểm đến tiếp theo rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080525
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080525,
					"content": "Vậy mà cũng nhìn ra được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080526,
					"content": "Thật ra là có yếu tố trực giác nữa. Chắc do tôi là người dẫn đường, xem nhiều bản đồ rồi nên khá nhạy với loại hình ảnh như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080527
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080527,
					"content": "Chuẩn bị đi thôi nào, thời gian nghỉ ngơi đã kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
