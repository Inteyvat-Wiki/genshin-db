			"dialogs": [
				{
					"id": 150080301,
					"content": "Những con Koholasaur này cảnh giác quá, như vậy đâu có lẻn vào được đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080302,
					"content": "Nếu như manh mối nằm trong thung lũng, vậy thì cứ đuổi đàn Koholasaur này đi là được mà nhỉ? Thân thủ của các vị đây chắc đều rất lợi hại đúng không?",
