					"nextDialogs": [
						150080306
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080306,
					"content": "Được rồi, chúng ta thử nghĩ cách khác xem nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080307
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080307,
					"content": "Ừm... Chắc chắn sẽ có cách để vào trong thung lũng mà không bị chúng phát hiện. Chỉ mình tôi nghĩ cách thì chắc chắn sẽ rất lâu, tôi muốn nhờ mọi người cùng góp ý xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080308
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080308,
					"content": "Để tôi nghĩ xem... Nếu đi đường vòng thì sao?",
