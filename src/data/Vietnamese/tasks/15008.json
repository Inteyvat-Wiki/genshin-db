				},
				{
					"id": 150080506,
					"content": "Bây giờ ngẫm lại thì đúng là như vậy thật... Hửm? Đó là gì vậy? Trên tảng đá xuất hiện... hình vẽ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080507,
					"content": "Đúng là tôi có nghe qua về một loại rêu đổi màu, có thể phản ứng với tín hiệu sinh vật do Koholasaur phát ra. Nhưng để kích hoạt thì cần phải có rất nhiều Koholasaur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080508
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080508,
					"content": "Đây chính là manh mối!",
