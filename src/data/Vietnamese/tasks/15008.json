			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME}, Paimon, bên này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080102,
					"content": "Mualani đến rồi sao. Ồ, còn có cả ông anh kỳ lạ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080103,
					"content": "Chào buổi sáng, hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080104,
					"content": "Chào buổi sáng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080105,
					"content": "Khi nào thì chúng ta xuất phát?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080106,
					"content": "Haha, trông anh giống như trẻ con vậy, luôn sốt ruột trước khi bắt đầu chuyến hành trình nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080107,
					"content": "Tôi muốn nhanh chóng giải quyết chuyện chính thôi... Chắc cô cũng biết đây không phải là chuyến du xuân nhẹ nhàng gì, nên tôi mong chúng ta nên mang theo thái độ chuyên nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080108,
					"content": "Đừng lo, tôi là người dẫn đường chuyên nghiệp mà. Khụ... Vậy thì, chuyến hành trình đến đảo thần bí của chúng ta chính thức bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080109,
					"content": "Được đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080110,
					"content": "Trước hết, mọi người có thấy bức tượng này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080111,
					"content": "Hmm, nó là manh mối quan trọng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080112,
					"content": "Cũng không phải manh mối đâu. Nó được thủ lĩnh đời đầu của Cư Dân Suối Nước dựng nên sau khi quay về từ đảo thần bí, được xem là một địa điểm kỷ niệm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080113,
					"content": "Việc cần làm trước khi xuất phát chính là chạm vào bức tượng này và cầu nguyện với tổ tiên. Như vậy thì hành trình đến đảo thần bí của chúng ta sẽ thêm thuận lợi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080114,
					"content": "...Cách nói này có lý luận nào chứng minh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080115,
					"content": "Lý luận chứng minh? Không có. Nhưng thầy tôi từng dạy, rằng đây là một bước bắt buộc trước khi khởi hành đến đảo thần bí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080117,
					"content": "Tốt lắm! Anh không cố tranh luận với tôi về điều mà anh không hiểu. Quả là chuyên nghiệp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080118,
					"content": "Được rồi, chẳng qua tôi không thể viết vào luận văn như vậy thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080119,
					"content": "Mọi người cùng đến đây nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080120,
					"content": "Xin tỏ lòng thành kính với tổ tiên. Chúng hậu bối chuẩn bị bước lên chuyến hành trình mà người từng đi qua, chứng kiến những thành tựu mà người từng hoàn thành. Xuất phát dưới sự dõi theo của người, trở về trong sự bảo vệ của người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080121,
					"content": "Thật có cảm giác bắt đầu một chuyến hành trình vĩ đại đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080122,
					"content": "Tiếp theo thì hãy chuẩn bị sẵn sàng nào. Chúng ta đi tìm manh mối đầu tiên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
