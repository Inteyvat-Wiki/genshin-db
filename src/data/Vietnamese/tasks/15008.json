			"dialogs": [
				{
					"id": 150080201,
					"content": "Ối, phía trước có nhiều Koholasaur quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080202,
					"content": "Quả nhiên, manh mối đầu tiên có liên quan đến Koholasaur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080203
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080203,
					"content": "Người bên ngoài bộ tộc khi lấy được bản sao của bản đồ, phần lớn đều đưa ra kết luận này, nhưng hướng mà họ tìm kiếm thường là sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080204
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080204,
					"content": "Thủ lĩnh đời đầu khi tạo ra bản đồ đã để lại một ký hiệu đặc biệt trong giai đoạn này. Đó chính là ám hiệu mà bộ tộc chúng tôi dùng để đánh dấu đàn Koholasaur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080205
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080205,
					"content": "Cho nên, tìm đại một hai con Koholasaur lạc đàn thì sẽ không thể lấy được manh mối đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080206
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080206,
					"content": "Mualani quả nhiên rất chuyên nghiệp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080207,
					"content": "Nhưng theo tài liệu mà tôi nghiên cứu, ngoài lúc tranh giành suối nước nóng ra thì Koholasaur vốn không thích tụ tập thành đàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080208
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080208,
					"content": "Vậy để tôi bật mí một bí mật mà chỉ có người dẫn đường của Cư Dân Suối Nước mới biết nhé. Koholasaur hoang dã cứ cách một khoảng thời gian thì sẽ tụ tập ở thung lũng phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080209
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080209,
					"content": "Giống như là... buổi tụ hội định kỳ do bộ tộc tổ chức vậy. Nhưng một khi qua thời gian đó thì chúng sẽ nhanh chóng rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080210
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080210,
					"content": "Nếu không phải là người dẫn đường thường xuyên đi lại ở Natlan thì sẽ khó mà nhìn thấy cảnh tượng như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080211
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080211,
					"content": "Có chuyện như vậy sao? Phải ghi chép lại ngay, cần giải thích rõ trong phần thảo luận liên quan mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080212
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080212,
					"content": "Theo như tôi giải mã bản đồ thì manh mối được giấu ở sâu trong thung lũng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080213
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080213,
					"content": "Nếu muốn qua đó thì phải đi ngang qua đàn Saurian trước sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080214,
					"content": "Ừm... Chỉ có thể nghĩ cách âm thầm đi qua thôi, cố gắng đừng để bị chúng phát hiện. Chúng đang tụ hội cùng bạn bè, chắc chắn không muốn bị làm phiền đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080215
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080215,
					"content": "Ý là phải chủ động đi qua đàn Saurian đó sao? Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080216
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080216,
					"content": "Khụ... Nếu đã quyết định hợp tác thì hai bên đều nên góp sức. Nhưng Karya trước đây vừa bị Koholasaur tấn công, nên không tiện làm những việc như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080217
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080217,
					"content": "Còn tôi... thì không thành vấn đề! Hãy để Karya đợi ở đây, nhiệm vụ vốn giao cho cô ấy thì cứ để tôi hoàn thành là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080218
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080218,
					"content": "Hihi... Vốn dĩ đâu cần mọi người cùng đi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080219
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080219,
					"content": "#Chúng ta cũng cần phải có người ở lại trông coi hành lý nữa. Vậy thì nhờ hai vị nhé, để {NICKNAME} và Paimon đi theo tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080220
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080220,
					"content": "Vậy sao? Vậy thì tốt quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080221
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080221,
					"content": "Nhưng mà, tôi đã cảm nhận được tấm lòng chăm sóc hậu bối của anh rồi đấy.",
