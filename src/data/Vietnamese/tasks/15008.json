					"speakerTitle": "Mualani"
				},
				{
					"id": 150080304,
					"content": "Ngoài ra, tự ý xông vào buổi tụ hội của người khác thì thôi, còn muốn đuổi người ta đi sao? Hành vi này thật sự rất xấu xa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080305
					],
					"speakerTitle": "Mualani"
				},
