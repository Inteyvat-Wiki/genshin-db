			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "Anh thợ mỏ, chúng tôi đến để báo cáo kết quả ủy thác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080102,
					"content": "Ồ! Cuối cùng cũng lại gặp được các bạn! Trước đây tôi có chút lo lắng, mặc dù đã trả tiền, nhưng nghĩ kỹ lại, ủy thác người khác đi điều tra một nơi quỷ dị như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080103,
					"content": "Lỡ như có chuyện gì, tôi sẽ cắn rứt lương tâm cả đời đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080104,
					"content": "Không sao không sao, chúng tôi đã trở về an toàn rồi mà! Tình hình bên dưới cũng đã được điều tra rõ ràng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080105,
					"content": "Lợi hại thế! Vậy thì tình hình bên dưới là như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080106,
					"content": "Ừm... Haiz... Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080107,
					"content": "Có một nhóm Hilichurl đang dưỡng lão ở bên dưới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Dưỡng lão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080111,
					"content": "Tóm, tóm lại, đám Hilichurl bên dưới không có ý xấu, tôi cũng mong các thợ mỏ sẽ không làm phiền chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080112,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "Những người thợ mỏ chúng tôi rất sợ rắc rối, tuyệt đối không chủ động gây sự với chúng đâu. Trong mắt chúng tôi, chỉ có những thứ sáng bóng và lấp lánh ánh vàng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080115,
					"content": "Ồ, ồ... vậy nhờ cả vào các anh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080116,
					"content": "Mặc dù không hiểu hai vị đang nói gì, nhưng có hai vị đảm bảo là tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080117,
					"content": "Lần này may nhờ có hai vị! Đi như vậy vất vả cho hai vị quá, đây là quà cảm ơn, hãy nhận lấy món quà này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080113,
					"content": "Có thể yên tâm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "Bên dưới là nơi ở lý tưởng của Hilichurl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Nơi ở lý tưởng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				}
			]
		}
	]
