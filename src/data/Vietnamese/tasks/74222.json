				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "Hãy giữ cảnh giác nhé, công dân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "Em đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "#Tôi ư? Như {F#cô}{M#cậu} thấy đấy, tôi đang bận xử lý mối đe dọa của man tộc. Gần đây thì chúng tấn công càng ngày càng gần, nói không chừng sẽ có gián điệp lẻn vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "Đây không phải chuyện nhỏ, chúng ta phải cảnh giác gấp bội trước khi quân đoàn chi viện đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "Nếu có chuyện gì khác thì hãy đi báo cáo với phó chỉ huy nhé, công dân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "Trẻ con ở đây một mình sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Hả? Trẻ con? Trẻ con ở đâu? Không phải là tân binh nào đó lại vi phạm quân lệnh, tự ý đưa người nhà vào nơi đóng quân đấy chứ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "Haiz, ngài Cassiodor vẫn quá nhân từ với mấy tên tân binh này. Nếu chuyện này xảy ra vào ba mươi năm trước thì chỉ huy đã mang roi đến rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "Có chuyện đáng ngờ gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Hiện giờ thì chưa có. Nhưng man tộc giống như thú dữ xảo quyệt, sẽ luôn tập kích vào lúc chúng ta mất cảnh giác. Sở trường mà chúng am hiểu nhất chính là tấn công bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "Chúng sẽ dùng mọi thủ đoạn bẩn thỉu nhất để xâm nhập vào thành phố và tìm hiểu bí mật của chúng ta. Dù chỉ mảy may lơ là cũng sẽ gây ra thảm họa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "Haiz... Ba mươi năm trước, khi theo ngài Boethius đi viễn chinh phương bắc thì chúng mới chỉ là đám người hoang dã nguyên thủy, chưa biết dùng những thủ đoạn gian trá này. Rốt cuộc chúng đã học được những thứ này ở đâu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Ba mươi năm trước... Có lẽ cha mẹ em còn chưa ra đời nữa đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "#Hửm? {F#Cô}{M#Cậu} vừa nói gì vậy? Tôi có tuổi rồi, nên chuyện lắng nghe cũng không còn rõ như lúc trước nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "Haiz... Nhớ năm xưa khi chinh phục Bituria, tôi còn nghe được cả tiếng chuông tập kết của man tộc từ cách mấy dặm đường đấy. Đúng là năm tháng không tha một ai mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "Tạm biệt, công dân. Nếu gặp kẻ khả nghi thì nhớ báo cáo cho tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "Haiz, không biết cuộc chiến này bao giờ mới kết thúc đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220202,
					"content": "Anh làm gì trên mái nhà thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "Hửm? Đương nhiên là giám sát xem có hoạt động của man tộc khả nghi không rồi! Dạo này... Khoan đã, công dân, sao lại chạy lên đỉnh tháp canh vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220204,
					"content": "Tôi phải hỏi mới đúng chứ nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "Haiz, thôi, cái này không quan trọng. Chỉ huy Mettius nói là man tộc tấn công ngày một gần. Dạo này nói không chừng sẽ có gián điệp trà trộn vào, phải tăng cường cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220206,
					"content": "#Nhưng {F#cô}{M#cậu} nói xem, thành phố nhỏ hẻo lánh như ở đây, dù là man tộc cũng sẽ không có hứng thú đúng không? Chứ đừng nói đến việc phái gián điệp gì đó đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220207,
					"content": "Mục tiêu thì vẫn luôn là mục tiêu mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "#Công dân, {F#cô}{M#cậu} nói rất có lý! Xem ra tôi phải phấn chấn lên mới được. Nhưng nghe giọng điệu của {F#cô}{M#cậu}, chẳng lẽ là có nhiều kinh nghiệm về chuyện này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220209,
					"content": "#Vậy thì, có thể nhờ {F#cô}{M#cậu} điều tra xung quanh không? Nếu thật sự có man tộc hoạt động thì nhất định sẽ để lại manh mối gì đó, chẳng hạn như thanh kiếm gỗ gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220210,
					"content": "Ồ, giống chơi đánh trận giả nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Dù sao cũng là man tộc mà, có lấy cành cây làm vũ khí thì cũng không có gì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220212,
					"content": "#Tóm lại, phải nhờ {F#cô}{M#cậu} rồi, nếu có phát hiện gì ở xung quanh thì hãy báo cho tôi nhé. Đây cũng là nghĩa vụ của công dân Remuria đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422207,
