				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220701,
					"content": "Xin chào, công dân, có phát hiện được gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220702,
					"content": "Tôi tìm được một ít...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "Không có gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "Chú ý an toàn nhé, nếu có gì thì báo cáo với tôi bất cứ lúc nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
							"2"
						],
						"stepId": 7422208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "Không ngờ... Đúng vậy, đây chính là cột tín hiệu mà man tộc dùng để truyền tin tức!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220802,
					"content": "Thật không đấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "Haiz, không ngờ thật sự có gián điệp man tộc trà trộn vào đây, xem ra sự lo lắng của chỉ huy Mettius quả nhiên không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220805,
					"content": "Chỉ cần báo cáo lại tình hình là coi như tôi đã hoàn thành công việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220806,
					"content": "#Nói thế nào thì cũng phải cảm ơn {F#cô}{M#cậu}, công dân. Nếu không có sự giúp đỡ của {F#cô}{M#cậu}, chưa biết chừng trước khi đại quân man tộc tới thì phòng ngự của chúng ta đã bị phá vỡ từ bên trong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220807,
					"content": "#Khi báo cáo lên chỉ huy Mettius, tôi nhất định sẽ nhắc đến sự cống hiến của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220803,
					"content": "Vừa nãy còn nói là kiếm gỗ mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}