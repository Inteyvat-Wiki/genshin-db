					"id": 730410101,
					"content": "Ồ, là Nara Vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410102,
					"content": "Người bạn Nara, đến chơi với Aralila đi! Aranishat yếu ớt quá, đừng chơi với anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410103,
					"content": "Haha, lần trước Aralila thua Aranishat, Aralila yếu hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410104,
					"content": "Được đó, đừng quan tâm đến mặt trời hay mặt trăng gì cả. Đúng lúc người bạn Nara đang ở đây, chúng ta hãy chơi cùng Nara đi, so xem ai mạnh ai yếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410105,
					"content": "So thì so, Aranishat không sợ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410106,
					"content": "Aralila trốn trước, để người bạn Nara đi tìm. Sau đó Aranishat trốn, để người bạn Nara tìm. Ai bị tìm thấy trước là thua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410107,
					"content": "Người bạn Nara, có muốn chơi không? Chuẩn bị xong thì bắt đầu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				}
