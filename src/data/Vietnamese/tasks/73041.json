						730410602
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410602,
					"content": "Aranishat cũng bị tìm thấy nhanh như thế, yếu y như Aralila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410603,
					"content": "Hu... Đều yếu, chỉ có Nara Vàng mạnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410604,
					"content": "Cứ tiếp tục như vậy không thể được, phải rèn luyện Ararakalari. Có Ararakalari mạnh, người bạn Nara chắc chắn sẽ không tìm thấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410605,
					"content": "Chắc không phải vậy đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "Có phải Nara sợ thua không? Chơi trò chơi thôi mà, đừng để ý đến thắng thua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410609,
					"content": "Tuy thua nhưng chơi vui quá, Nara Vàng quả nhiên là Nara tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410610,
					"content": "Người bạn Nara thắng rồi. Giỏi quá đi! Nhận lấy đóa hoa của chúng tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410611,
					"content": "Cảm ơn Nara tốt! Bạn là người bạn tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410607,
					"content": "Cố lên nhé.",
