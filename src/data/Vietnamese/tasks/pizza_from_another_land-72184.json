			"dialogs": [
				{
					"id": 721840201,
					"content": "Xin chào, bạn có việc gì tìm tôi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840202,
					"content": "Về pizza của \"Nhà Hàng Kiminami\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "À, chiếc pizza đó hương vị đúng là không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840204,
					"content": "Nhưng...biết nói sao nhỉ, cứ cảm thấy ăn không quen lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840205,
					"content": "Cá nhân tôi nghĩ, nếu có thể kết hợp một số nguyên liệu bản địa của Inazuma vào pizza, ví dụ như Dưa Tím chẳng hạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840206,
					"content": "Có lẽ món pizza sẽ được mọi người yêu thích hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rie"
				}
			]
		},
		{
