			"dialogs": [
				{
					"id": 721840301,
					"content": "Nhà Lữ Hành, bạn về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840302,
					"content": "Thế nào, bạn hỏi được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840303,
					"content": "Về phản hồi của khách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Pizza Dưa Tím...có vẻ không phức tạp lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840305,
					"content": "Nguyên liệu còn lại cứ chuẩn bị sẵn như bình thường được rồi, ừm, nếu đã nói là muốn \"kết hợp một số nguyên liệu bản địa của Inazuma\", thì tôi sẽ thêm một số nguyên liệu khác là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840306,
					"content": "Ừm, Hải Linh Chi? Cỏ Naku? Ừm...Nấm U Ám thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840307,
					"content": "Cái đó, cần tôi giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "Ồ! Xin lỗi, tôi chỉ mải nghĩ bỏ nguyên liệu gì vào thì ngon! Tôi xem thử Dưa Tím trong tiệm hình như sắp hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840309,
					"content": "Nhà Lữ Hành, bạn hãy giúp tôi đem một ít Dưa Tím đến nhé, về nguyên liệu...chắc cũng chỉ thiếu mỗi thứ này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840310,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "Ừm, vậy phiền bạn rồi, chỉ cần một quả Dưa Tím là đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840312,
					"content": "Còn cần tìm nguyên liệu khác không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "Nguyên liệu khác trong tiệm vẫn còn hàng, bạn mang một quả Dưa Tím về là được, phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
