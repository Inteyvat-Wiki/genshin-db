					"nextDialogs": [
						721840505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840505,
					"content": "Cảm ơn bạn, Nhà Lữ Hành, xin hãy nhận lấy những thứ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840506,
					"content": "Chốc nữa tôi sẽ từ từ thưởng thức nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840507,
					"content": "Nếu ngon...chắc rất nhanh sẽ trở thành món mới được bán chính thức rồi.",
					"roleType": "TALK_ROLE_NPC",
