				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "Hora! Nghe lời nào, đừng cử động! Chỉ lau nhẹ một chút thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200102,
					"content": "Grào, grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200103,
					"content": "Nào! Vậy chúng ta đi tắm trước nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200104,
					"content": "Nhìn xem, hồ nước kia cách đây không xa, tắm xong rồi chúng ta có thể quay lại đây chơi tiếp ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200105,
					"content": "Grào, grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200106,
					"content": "Ê! Chờ đã! Đừng có chạy lung tung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200107,
					"content": "Lúc nãy, hình như có thứ gì đó lướt qua nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "#{F#Cô}{M#Cậu} là khách đến chơi đúng không? Thật ngại quá, dạo này Hora hơi hiếu động, cứ chạy nhảy suốt. Chắc không dọa cho {F#cô}{M#cậu} sợ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200110,
					"content": "Ban nãy anh đang khuyên nó đi tắm à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "Khuyên ư? Haiz, tôi đang \"năn nỉ\" Hora đi tắm đấy. Mấy ngày nay mưa nhiều, lần nào nó ra ngoài chơi cũng lấm lem bùn đất cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200112,
					"content": "Tôi chỉ muốn tắm cho Hora sạch sẽ thôi, nhưng nó chỉ mải chơi, lúc nào cũng chạy nhảy khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200113,
					"content": "Còn tôi thì chỉ là một người bình thường, hoàn toàn không thể theo kịp nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200114,
					"content": "Thử dùng đồ ăn ngon dụ dỗ xem sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "Tôi đã thử rồi. Nhưng nó như thể đã biết được ý đồ của tôi, chỉ cần nhìn thấy tôi ở gần là nó sẽ không ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200116,
					"content": "Chỉ cần tôi vừa lơ là thì nó đã chui từ dưới đất lên, ăn sạch thức ăn rồi lại lẩn vào trong lòng đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200117,
					"content": "Không hổ danh là Tepetlisaurus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "Đúng vậy. Khi nó lớn lên, tôi không dám tưởng tượng là nó sẽ gây ra cho tôi những rắc rối gì nữa đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200119,
					"content": "Chỉ mong nó đừng húc đổ cửa hàng của Cheven là được... Không thì tôi không đền nổi số đá quý đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200120,
					"content": "Haiz, bây giờ chỉ đành phải thử cách của Batz thôi. Nhưng quả cầu này... có thể thu hút Tepetlisaurus sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200121,
					"content": "Batz là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "À, anh ấy là người phụ trách chăm sóc Tepetlisaur trong bộ tộc. Anh chàng này rất thông minh, lại còn am hiểu về âm nhạc, cả Saurian lẫn người đều rất yêu quý anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200123,
					"content": "Rất lâu trước đây, khi tôi nói với Batz về việc này, anh ta đã đưa cho tôi một bản vẽ chế tạo \"Bóng Nổi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200124,
					"content": "Đây là thứ anh ấy kiếm được từ Mataoho, bọn Saurian nhỏ rất thích. Để tôi cũng thử làm một cái cho Hora xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200125,
					"content": "Tôi vừa thu thập xong nguyên liệu, chuẩn bị bắt tay vào làm thì Hora lại làm loạn cả lên, không thể nào yên được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200126,
					"content": "Đành chịu, giờ chỉ còn hy vọng vào Bóng Nổi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200127,
					"content": "Tôi có thể giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "#{F#Cô}{M#Cậu} đồng ý giúp ư? Vậy thì tốt quá! Tôi may mắn thật, có thể gặp được người nhiệt tình như {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200130,
					"content": "#Vậy phiền {F#cô}{M#cậu} đến chiếc rương bên kia lấy một ít Cành Nhụy Tro đến đây nhé. Tôi sẽ làm cái khung của \"Bóng Nổi\" trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200128,
					"content": "Cần tôi giúp gì thì cứ nói nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "Chậc! Suýt nữa bị húc ngã rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
