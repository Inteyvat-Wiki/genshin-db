			},
			"dialogs": [
				{
					"id": 250200501,
					"content": "Grào? Grào...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200502,
					"content": "Grào, grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200503,
					"content": "Hora vui vẻ ôm lấy Bóng Nổi và lăn tròn trong hồ nước. Nước bắn tung tóe, bùn đất trên người nó cũng được rửa sạch sẽ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "Hahaha, nó có vẻ rất thích quả bóng này đấy. Không ngờ nó lại chơi trong hồ nước luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200505,
					"content": "Chúng ta qua đó thôi. Thế cũng coi như là tắm rửa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200506,
					"content": "Grào...? Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200507,
					"content": "Thích món quà này chứ? Tặng cho ngươi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200508,
					"content": "Grào, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200509,
					"content": "Tắm rửa cho ngươi quả là vất vả mà... Haha, nhưng giờ ta đã biết cách trị ngươi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200510,
					"content": "Grào... grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200511,
					"content": "Ngươi chạm vào tay ta làm gì? Những vết thương này... chỉ là trầy xước nhẹ thôi, không sao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200512,
					"content": "Grào, grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200513,
					"content": "Này, sao tự dưng lại ủ rũ thế? Nãy còn chơi vui vẻ mà? Mệt rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200514,
					"content": "#À, cảm ơn {F#cô}{M#cậu} nhé. Những thứ này coi như thù lao cho {F#cô}{M#cậu}. Không có gì đắt giá đâu, {F#cô}{M#cậu} cứ yên tâm nhận đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200515,
					"content": "Grào! Gràooo! Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200516,
					"content": "Đợi đã! Đừng quay lại hồ nước! Hora! Ta vừa mới lau khô cho ngươi mà!",
					"roleType": "TALK_ROLE_NPC",
