					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "Woa, vừa nãy là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240502,
					"content": "Đó là một trong những công việc hàng ngày của tư tế. Chúng tôi thử liên lạc với linh hồn của tổ tiên để tiếp nhận chỉ thị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240503,
					"content": "Thủ lĩnh ở bên kia. Tôi xin phép đi báo cáo trước, hai vị đợi ở đây một lát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240504,
					"content": "Nói thế nào nhỉ, Chủ Nhân Gió Đêm quả là một bộ tộc thần bí mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240505,
					"content": "Tôi đã kể rõ tình hình rồi, hai vị hãy đi theo tôi đến gặp thủ lĩnh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240506,
					"content": "Hai vị chính là ứng cử viên mà lời chỉ thị nhắc đến đúng không? Tôi là Biram, thủ lĩnh đương nhiệm của Chủ Nhân Gió Đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240507,
					"content": "Cao thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240508,
					"content": "Tôi sinh ra đã có dáng người khác thường, xin đừng lấy làm lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240509,
					"content": "Đương nhiên là không rồi! Lúc nãy tôi chỉ hơi ngạc nhiên thôi, xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240510,
					"content": "Cho hỏi, \"chỉ thị\" là gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "Tình hình cụ thể thì Caholom đã nói với tôi rồi, tôi có thể hiểu được thắc mắc của hai vị. Hai vị là khách từ bên ngoài, nên đương nhiên không hiểu loại \"chỉ thị\" này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240512,
					"content": "Trong lịch sử dài đằng đẵng trước đây, những người được chỉ thị lựa chọn đều là người trong tộc của Chủ Nhân Gió Đêm cả. Đây là lần đầu tiên người ngoại tộc được chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240513,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240514,
					"content": "Cho phép tôi giải thích một chút. Chúng tôi có một truyền thống cổ xưa, đó chính là chế tạo vải dệt để ghi lại lịch sử của Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240515,
					"content": "Hơn nữa không chỉ là lịch sử của tộc này, mà cả truyền thuyết và sự tích anh hùng của các bộ tộc khác cũng sẽ được ghi chép lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240516,
					"content": "Hàng ngàn năm nay đều như vậy. Chúng tôi coi đó là sứ mệnh của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240517,
					"content": "Nhưng nếu là sự kiện lớn ảnh hưởng đến toàn bộ Natlan, thì cần một loại vải dệt cực kỳ đặc biệt để ghi lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240518,
					"content": "Mà loại vải này chỉ có người được Đại Trưởng Lão Iktomisaur chỉ định mới có thể hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240519,
					"content": "Khi Đại Trưởng Lão Iktomisaur quan sát thấy sự thay đổi quan trọng của Địa Mạch, sẽ phát ra một loại chỉ thị để chỉ định ra người chế tác loại vải này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240520,
					"content": "Có nghĩa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240521,
					"content": "Trưởng Lão Tlapo hiện tại đã phát hiện ra sự thay đổi của Địa Mạch từ lâu, nhưng sau khi hai vị đến, trưởng lão mới chỉ định được người làm vải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240522,
					"content": "#Thì ra là vậy... Nhưng mà tôi và {NICKNAME} không biết cách để làm ra loại vải này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240523,
					"content": "Chuyện này thì tôi không hề ngạc nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240524,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240525,
					"content": "Trưởng Lão Tlapo kế nhiệm khoảng hai trăm năm trước, đồng thời cũng tiếp nhận chức trách xác định ứng cử viên. Mà người được chọn đều không biết cách để làm ra loại vải này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240526,
					"content": "Vậy những sự kiện lịch sử lớn trong hai trăm năm qua đều không có ghi chép sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240527,
					"content": "Không, những người đó đều nộp thành quả đúng hạn. Chỉ là hầu hết họ đều nói đó không phải do họ tự làm, mà là do nhận được \"món quà của linh hồn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240528,
					"content": "Chậc... Chủ Nhân Gió Đêm quả là một bộ tộc thần bí mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240529,
					"content": "Nhưng đây chính là điều khiến tôi bối rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240530,
					"content": "Chuyện quan trọng như ghi chép lịch sử, nếu chỉ có thể gửi gắm hy vọng vào những thứ bí ẩn như \"món quà của linh hồn\" thì thật không thể yên tâm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240531,
					"content": "Hm... Nghe thủ lĩnh của Chủ Nhân Gió Đêm nói vậy thì cũng có chút bất ngờ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240532,
					"content": "Tôi hiểu suy nghĩ của hai vị. Chắc trong mắt hai vị thì người của Chủ Nhân Gió Đêm đều rất thần bí, thứ mà họ sùng bái chắc chắn đều khó diễn tả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240533,
					"content": "Và tôi thực sự là một ngoại lệ. Tuy tôi là thủ lĩnh của Chủ Nhân Gió Đêm, nhưng chủ trương của tôi vẫn là thay đổi những truyền thống này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240534,
					"content": "Tôi dốc sức phân tích các sự vật thần bí, vì như vậy sẽ có thể đặt ra quy tắc rõ ràng. Từ đó, tôi duy trì truyền thống của bộ tộc được tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240535,
					"content": "Woa, nghe thật lợi hại... Vậy anh đã khám phá ra bí ẩn mang tên \"món quà của linh hồn\" chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240536,
					"content": "Chưa... Tôi đã điều tra rất lâu, cũng không tìm ra được \"món quà của linh hồn\" là chỉ cái gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240537,
					"content": "Những sự kiện lớn cần dùng loại vải đó để ghi lại chỉ đếm trên đầu ngón tay, mỗi sự kiện cũng cách nhau hàng thập kỷ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240538,
					"content": "Đến khi chỉ thị tiếp theo được ban bố thì thủ lĩnh cũng đã thay đổi. Tôi căn bản là không có cơ hội để điều tra sâu về chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240539,
					"content": "Vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240540,
					"content": "Tuy tôi chưa điều tra rõ toàn bộ sự việc, nhưng vẫn có chút tiến triển. Chỉ có điều, tôi cần người được chọn phối hợp với tôi để kiểm chứng một số suy đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240541,
					"content": "Vậy thì chúng tôi phải tiếp nhận bài kiểm tra nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "Đúng vậy. Nhưng không cần lo lắng, lần kiểm tra này chỉ để kiểm chứng suy đoán của tôi thôi. Sẽ không tốn quá nhiều sức lực của hai vị, và cũng không có nguy hiểm nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240543,
					"content": "Vậy cụ thể là bài kiểm tra như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "Tôi có thể đưa hai vị đến địa điểm thử nghiệm và giải thích. Nhưng giờ hãy đợi một chút, để tôi cởi bỏ chiếc Áo Choàng Linh Hồn này đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240545,
					"content": "Đây là thánh vật do các thủ lĩnh truyền lại, chỉ mặc khi tổ chức nghi lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240546,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240547,
					"content": "Biram cởi bỏ chiếc áo choàng trên người, cẩn thận giao cho một vị tư tế cất giữ.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "Xin hãy đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240549,
					"content": "Hai vị có nhìn thấy tấm vải dệt này không? Chạm vào nó là có thể đi vào một không gian bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240550,
					"content": "Thử thách mà hai vị cần trải qua, chính là tìm cách thoát khỏi không gian đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240551,
					"content": "Như vậy là được rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240552,
					"content": "Đừng xem thường bài kiểm tra này nhé. Nếu thực sự không tìm được cách thoát thì tôi sẽ đích thân đưa hai vị trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240553,
					"content": "Chỉ là nếu như vậy thì chỉ thị vẫn sẽ là một câu đố không có lời giải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240554,
					"content": "Vậy để chúng tôi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "Được. Hai vị có thể tiếp xúc với tấm vải đó để bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
		{
