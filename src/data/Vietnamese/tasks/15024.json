					}
				]
			},
			"dialogs": [
				{
					"id": 150240701,
					"content": "Phù, cuối cùng cũng ra được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240702,
					"content": "Xem ra hai vị quả nhiên có khả năng gánh vác sứ mệnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240703,
					"content": "Suy đoán của anh đã được kiểm chứng chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "Ừm. Hai vị đã nhìn thấy rất nhiều cuộn vải đặc biệt ở đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240705,
					"content": "Ừm, đúng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240706,
					"content": "Tôi đã nghiên cứu kỹ loại vải mà tổ tiên để lại rồi, và tôi phát hiện ra rằng chúng đều có màu sắc khác với các loại vải thông thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240707,
					"content": "Loại màu sắc này rất thần kỳ. Ngay cả tôi cũng phải dựa vào cách thức đặc biệt mới có thể xác nhận được sự tồn tại của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240708,
					"content": "Nhưng sẽ có một kiểu người vốn có sẵn khả năng phân biệt loại màu sắc này... Và đây chính là mục tiêu mà tôi kiểm tra hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240709,
					"content": "Có nghĩa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240710,
					"content": "Không gian mà hai vị vừa vào chính là phòng trưng bày số vải dệt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240711,
					"content": "Vài trăm năm trước, có một shaman vĩ đại tên là Huitzilin đã từng ra lệnh cấm cho căn phòng trưng bày này. Nếu người ngoài xông vào mà chưa được cho phép thì sẽ bị nhốt trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240712,
					"content": "Loại lệnh cấm này đến nay vẫn còn tồn tại. Tuy tôi không hiểu nguyên lý, nhưng tôi đã tìm được cách để mở và tắt nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240713,
					"content": "Một khi bị nhốt, nếu không có sự giúp đỡ từ bên ngoài thì gần như không thể thoát thân, trừ khi người bị nhốt cũng giống như vị shaman đó, có khả năng nhận biết loại màu sắc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240714,
					"content": "Tôi nhớ ra rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "#Xem ra {F#cô}{M#cậu} quả nhiên có khả năng này... Có lẽ Trưởng Lão Iktomisaur có thể nhận biết được người sở hữu, nên mới căn cứ vào đó để xác định ứng cử viên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240717,
					"content": "#Này! Rốt cuộc {NICKNAME} còn bao nhiêu bí mật mà tôi chưa biết thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240718,
					"content": "Nhưng mà, cho dù là có khả năng này đi nữa, nếu như để chúng tôi làm vải thì vẫn không biết phải bắt đầu từ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240719,
					"content": "Không cần lo lắng. Tôi đã so sánh kỹ thuật dệt của loại vải này rồi, không khác gì với loại thông thường cả. Sự khác biệt cốt lõi nhất có thể nằm ở thuốc nhuộm và màu nhuộm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240720,
					"content": "Nếu tôi đoán đúng thì điểm mấu chốt chính là một loại thuốc nhuộm đặc biệt, và muốn có được thì phải dựa vào năng lực của hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240721,
					"content": "Còn về nhuộm màu... Chỉ cần lấy được thuốc nhuộm thì chắc sẽ không có vấn đề gì. Phần công việc này tôi có thể hướng dẫn hai vị hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240722,
					"content": "...Ừm, vậy thì nghe theo thủ lĩnh vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240723,
					"content": "Vậy thì phiền hai vị dùng năng lực này để tìm ra thuốc nhuộm cần thiết nhé, và tôi sẽ tìm người chuẩn bị một số vải để thử nghiệm thuốc nhuộm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240724,
					"content": "Chúng ta hãy làm một số mẫu để kiểm chứng suy đoán của tôi trước, chỉ cần thành công là có thể chính thức bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240725,
					"content": "Sau khi xong việc, tôi sẽ trả thù lao hậu hĩnh để báo đáp. Hai vị thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240726,
					"content": "Năng lực càng cao thì trách nhiệm càng lớn mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "Ừm, lại còn có thù lao nữa! À, trong phần thù lao đó có đồ ăn ngon không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240728,
					"content": "Chuyện này có ý nghĩa rất lớn đối với Chủ Nhân Gió Đêm chúng tôi, nên tôi sẵn sàng trả một khoản Mora lớn để cảm tạ, huống chi chỉ là một bữa ăn ngon chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240729,
					"content": "Được đó! Mà nói chứ, chúng tôi phải đi đâu để tìm loại thuốc nhuộm đó đây? Chắc không cần phải đi khắp Natlan đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240730,
					"content": "Đương nhiên là không rồi. Trong lần chuẩn bị trước đó thì tôi đã điều tra được một địa điểm khả thi, và đã sắp xếp người dẫn đường cho hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240731,
					"content": "Nếu hai vị chuẩn bị xong thì có thể xuất phát ngay. Người dẫn đường đang chờ ở bên ngoài rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240715,
					"content": "Là loại \"màu sắc\" đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
