					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "Tại sao lại xảy ra chuyện này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240112,
					"content": "#{NICKNAME}, lại sao nữa rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240113,
					"content": "Nó ở bên kia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "Nhìn kìa! Là con Iktomisaur non đó, hình như nó cũng muốn đưa chúng ta theo. Từ góc độ của nhà mạo hiểm mà nói thì phải đi tìm hiểu mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "Paimon"
				},
				{
