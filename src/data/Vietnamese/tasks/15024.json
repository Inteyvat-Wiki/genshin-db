					"nextDialogs": [
						150240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240306,
					"content": "Là ai đấy? Không được vô lễ với trưởng lão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240308,
					"content": "Ý là... Ồ, tôi hiểu rồi. Ban nãy tôi mạo muội quá. Hai vị đã là khách được mời đến, tôi vốn nên nhiệt tình tiếp đón mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240309,
					"content": "Để tôi giới thiệu một chút, tôi là Caholom, một trong những tư tế của Chủ Nhân Gió Đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240310,
					"content": "Đây là Đại Trưởng Lão Iktomisaur đương nhiệm, Tlapopoctiztetl vĩ đại, là vật tổ sống của Chủ Nhân Gió Đêm chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240311,
					"content": "Cái tên dài thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240312,
					"content": "Người trong tộc chúng tôi thường gọi là Trưởng Lão Tlapo. Hai vị cũng có thể gọi bằng cái tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240313,
					"content": "Cách mà nó mời người ta đến đây cũng thật đặc biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "À, là đang nói đến năng lực của trưởng lão đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240315,
					"content": "Trưởng Lão Tlapo đã sống mấy trăm năm, bí mật trên người trưởng lão ngay cả một tư tế như tôi cũng khó mà nói rõ được, nên hai vị cảm thấy khó hiểu cũng là chuyện thường tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240316,
					"content": "Nhưng có một điều tôi có thể chắc chắn, Trưởng Lão Tlapo đã gửi lời chỉ thị quan trọng tới hai vị, nên tôi muốn mời hai vị làm một bài kiểm tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240317,
					"content": "Chỉ thị? Kiểm tra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240318,
					"content": "Nếu được thì xin hai vị hãy theo tôi đến gặp thủ lĩnh bộ tộc. So với tôi thì thủ lĩnh sẽ có khả năng giải đáp thắc mắc của hai vị hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240319,
					"content": "Ừm... Được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240320,
					"content": "Nếu hai vị chuẩn bị xong thì hãy đi theo tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240401,
					"content": "Dùng tấm vải dệt này là có thể đến trực tiếp Tế Đàn Obsidian để gặp thủ lĩnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240402,
					"content": "Đừng lo lắng, đây là một trong rất nhiều bí thuật mà bộ tộc chúng tôi sử dụng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caholom"
				}
			]
		},
