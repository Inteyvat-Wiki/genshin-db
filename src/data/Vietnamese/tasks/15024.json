					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240108,
					"content": "Chậc... Rốt cuộc đã qua bao lâu rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240109,
					"content": "#{NICKNAME}, vừa rồi tôi và con Iktomisaur đó nhìn nhau một cái thì bị kéo vào một không gian kỳ lạ, còn nhìn thấy một con Iktomisaur khổng lồ nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
