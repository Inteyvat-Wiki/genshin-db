			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "Xin chào tiền bối! Chúng ta tìm chỗ nào ngồi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360402,
					"content": "Về chuyện mạo hiểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "Bạn đang muốn hỏi tại sao trước đây tôi lại bướng bỉnh và khiến mọi người phải lo lắng nhiều như vậy sao? Haha... tôi biết mình sai rồi, đừng lên lớp tôi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360404,
					"content": "Nhưng thành thật mà nói, nỗi ám ảnh về \"nguy hiểm\" có thể là bản chất của những nhà mạo hiểm như chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360405,
					"content": "Suy cho cùng, chúng ta sinh ra với sống lưng cứng rắn và tay chân nhanh nhẹn... Khi nghĩ đến bản thân mang theo vũ khí lại phải sống một cuộc đời không có sóng gió thì cảm thấy có chút không cam tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360406,
					"content": "Về phần rủi ro chết người, không phải là tôi chưa nghĩ đến, mà là... hmm, cho tôi hỏi một câu được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360407,
					"content": "Bạn nói đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "Stanley, nhà mạo hiểm vĩ đại đến từ Mondstadt, được biết đến bởi chiến công vượt qua Vùng Biển Lặng... anh ấy đã mất đi người bạn thân nhất của mình trong chuyến mạo hiểm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360409,
					"content": "Vì chuyến mạo hiểm này của anh ấy, mà người bạn kia đã chết... Mặc dù rất ít người biết tên anh ấy là gì, nhưng ký ức về anh vẫn được lưu truyền trong giới nhà mạo hiểm cho đến ngày nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360410,
					"content": "Tôi đang nghĩ... Haha, tiền bối đừng chê tôi ấu trĩ nhé. Người bạn đã mất của Stanley... có khi nào vẫn chưa chết, mà đang thực sự \"sống\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360411,
					"content": "Chỉ có bản thân cuộc sống mới là quan trọng nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "Nhưng việc khiến người người ta ghi nhớ vốn là... mặc dù sự nghiệp ấy khiến anh ấy chết sớm, nhưng đó không phải là một cách tiếp tục cuộc sống sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360413,
					"content": "Và bây giờ anh ấy tiếp tục sống giữa mọi người theo một cách khác, thông qua khao khát và ký ức, đánh giá và quan điểm của người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360422,
					"content": "Đừng quá chú ý đến những gì người khác nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "Rất nhiều người đã khuyên tôi như vậy, \"Hãy cứ là chính mình\", \"lo việc của mình là được rồi\"... Bề ngoài là khuyên răn nhưng thực chất chỉ là thuyết phục người ta bỏ cuộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360424,
					"content": "Như tôi đã nói trước đây, những cuộc mạo hiểm của tôi không phải vì người khác... thậm chí cũng không phải vì bản thân tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360425,
					"content": "Hmm ... bạn đã bao giờ nghĩ vậy chưa, tiền bối...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360426,
					"content": "Thế giới này là ở sự sắp đặt của các vị thần... Nhưng chúng ta là người phàm, dù không được thần linh ban tặng \"đôi mắt\", những vẫn có sự cố chấp không muốn một cuộc sống yên ổn và bị lãng quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360427,
					"content": "Tôi tin rằng cảm giác không cam lòng này không phải là vô nghĩa, vì vậy tôi mới điên cuồng chạy đi khám phá những nơi nguy hiểm đó. Dù sao thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360428,
					"content": "Chiến đấu với sự vĩnh hằng trong một cơ thể yếu ớt, điều mà ngay cả các vị thần cũng sợ hãi, là điều khiến một người trở thành \"con người\"... Tôi tin là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360429,
					"content": "Nhưng bạn không hề đơn độc trong việc mang lại ý nghĩa cho cuộc mạo hiểm của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "Ừm... tôi hiểu rồi. Tôi sẽ không quên sự giúp đỡ của mọi người, và những rắc rối mà tôi đã gây ra cho tiền bối... Dù sao thì chuyến mạo hiểm này không chỉ có một mình tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360437,
					"content": "Ha ha, đây không phải là mạo hiểm sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360432,
					"content": "Bạn muốn trở thành anh hùng đến vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "So với tiền bối, tôi còn kém quá xa... so với việc muốn trở thành anh hùng, hmm... chi bằng nói rằng \"Những người muốn sống mới không sợ chết\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360434,
					"content": "Câu này là một tiền bối đến từ Sumeru dạy tôi đó, chị ấy cũng nghe được từ thành viên của Eremite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360435,
					"content": "Tôi cảm thấy rất có lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360436,
					"content": "Chi bằng nói là một kẻ chuyên theo đuổi những việc đen đủi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360414,
					"content": "Được mọi người nhớ đến cũng là một thành công.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "Chà... tôi chưa bao giờ khao khát một cuộc sống \"thành công\". Ngược lại, dù có \"thất bại\", chỉ cần có thể gây ấn tượng với mọi người là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360416,
					"content": "Ít nhất sẽ có người nói: \"Zhiqiong cũng đã khiêu chiến Vực Đá Sâu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360417,
					"content": "Ít nhất là không giống như những tiền bối đã hy sinh ở vùng đất không người... Ít nhất là không giống như tôi bây giờ, bị người đời lãng quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360418,
					"content": "Tôi chưa từng nghĩ đến chuyện này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "Vậy sao...? Có lẽ đó là bởi vì những người ngoài cuộc như tiền bối sẽ nghiễm nhiên trở thành tâm điểm của sự chú ý dù xuất hiện ở bất cứ nơi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360420,
