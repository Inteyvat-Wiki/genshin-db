				{
					"id": 413360904,
					"content": "\"Luôn nhập hàng mới về, biển xanh sóng vỗ về\"... Ừm, không tệ, rất hợp đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360905
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360905,
					"content": "Thực ra tôi cũng có viết một câu, tặng bạn luôn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360906
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360906,
					"content": "Vẫn còn sao, để tôi xem thử ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360907
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360907,
					"content": "Ban ngày ngỡ như... Khụ! Cái... cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360908
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360908,
					"content": "Thế nào, khá chuẩn đấy phải không, nếu bạn thích thì cứ viết vào Đèn Tiêu khác nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360909
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360909,
					"content": "Khụ khụ...! Cảm ơn nhé, tôi có chút chuyện phải đi trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360910
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360910,
					"content": "Đèn Tiêu đã được gửi đi hết rồi, vất vả cho bạn quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360911
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360911,
					"content": "Hình như họ rất hài lòng đó. Xem ra tôi với bạn rất có khiếu trong lĩnh vực này nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360912
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360912,
					"content": "Haiz, trong thành này, không được mấy người có thể tiếp lời tôi được như bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360913
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360913,
					"content": "Nếu sau này bạn có thời gian thì cứ đến tìm tôi, chúng ta sẽ tiếp tục nghiên cứu văn chương nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360914
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360914,
					"content": "Chắc chắn rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360915
					]
				},
				{
					"id": 413360915,
					"content": "Vậy thì tốt. Tôi còn phải nhanh nhanh suy nghĩ câu chúc cho bản thân tôi nữa... Hi hi, cái này thì không cần bạn giúp rồi, tự tôi sẽ nghĩ ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360916
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360916,
					"content": "À, bạn nhận thứ này nhé, xem như thù lao của bạn, trong ngày lễ vẫn bắt bạn đi phụ giúp tôi, thành thật cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
