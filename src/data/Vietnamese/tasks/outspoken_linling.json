			"dialogs": [
				{
					"id": 413360501,
					"content": "Linling à, có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "Xiao Tổng Quản"
				},
				{
					"id": 413360502,
					"content": "Chữ lần trước ông nhờ cháu viết, cháu đã cùng Nhà Lữ Hành viết xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360503,
					"content": "Còn viết giùm ông lên Đèn Tiêu nữa, của ông này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360504,
					"content": "Cảm ơn nhé, để ông xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "Xiao Tổng Quản"
				},
				{
					"id": 413360505,
					"content": "\"Vãn bối đến, mắt nhìn kim cang bát diện uy phong\", \"Buồm lướt đi, an yên ngon giấc ngáy vang rền\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "Xiao Tổng Quản"
				},
				{
					"id": 413360506,
					"content": "\"Vững như Thái Sơn\"... Kaka, cũng không tệ, cảm ơn cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
