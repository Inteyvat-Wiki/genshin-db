			"dialogs": [
				{
					"id": 413360401,
					"content": "Xiao Tổng Quản ở bên kia, chúng ta ở đây quan sát một chút đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360402,
					"content": "Tôi nghĩ, tôi rất có ấn tượng với Xiao Tổng Quản, chữ viết cho ông ấy chắc chắn sẽ xong nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360403,
					"content": "Để tôi đọc cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360404,
					"content": "\"Lão già thối tính khí thất thường\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360405,
					"content": "A?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "\"Nhưng lại có trái tim ấm áp\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360408,
					"content": "Hở?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "Còn tiêu đề nữa. Tiêu đề là \"Đúng Là Một Người Tốt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360411,
					"content": "Thế nào, rất thích hợp đúng không, Xiao Tổng Quản tuy trông rất hung dữ, nhưng thật ra rất tốt tính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360412,
					"content": "Còn lựa chọn nào khác không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "À cũng còn một lựa chọn, có điều tôi không biết phải viết tiếp như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360414,
					"content": "Hay là bạn nghĩ tiếp giúp tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360415,
					"content": "Câu trước là \"vãn bối đến, mắt nhìn kim cang bát diện uy phong\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360416,
					"content": "\"Buồm lướt đi, an yên ngon giấc ngáy vang rền\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "Cũng ổn nhỉ, còn cái tựa nữa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360418,
					"content": "Ừm... \"Vững như Thái Sơn\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "Ồ! Không ngờ bạn cũng có chút tài năng nhỉ, bài này hay đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360420,
					"content": "Vậy để tôi viết lên Đèn Tiêu, bạn chờ chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360421,
					"content": "Được rồi, viết xong rồi, chúng ta đưa nó đến cho Xiao Tổng Quản thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360409,
					"content": "Đừng đọc nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "Chờ chút chờ chút!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
