			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "Hừm... phải đến tận nơi để tìm đề tài mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "Tôi đang giúp mọi người suy nghĩ những lời thích hợp để viết lên Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360104,
					"content": "Trong Tết Hải Đăng này, mọi người không phải đều sẽ thả Đèn Tiêu và viết điều ước sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360105,
					"content": "Để cho không khí thêm phần náo nhiệt, có nhiều người muốn viết điều ước của mình sao cho... nói sao nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360106,
					"content": "Sao cho \"hoa mỹ\" một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360107,
					"content": "Bibo, Xiao Tổng Quản và Degui nhờ hết vào tôi, hãy giúp họ nghĩ một vài lời chúc \"đặc sắc\" sau đó viết lên đèn tiêu rồi đem tặng cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360108,
					"content": "Nếu tôi chỉ đứng đây suy nghĩ thì nhất định sẽ không nghĩ ra cái gì hay ho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360109,
					"content": "Cho nên tôi muốn làm xong Đèn Tiêu trước, sau đó quan sát họ, rồi mới có thể viết cho từng người được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360110,
					"content": "Nhưng tôi lại không biết làm Đèn Tiêu mới khổ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360111,
					"content": "Để tôi giúp cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "Vậy sao? Vậy phiền bạn làm giúp tôi 3 cái Đèn Tiêu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360114,
					"content": "Sau đó tôi sẽ đích thân đến chỗ họ, xem xem có thể viết những gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360115,
					"content": "Hi hi, tôi có chút ý tưởng rồi, chỉ cần tìm thêm chút cảm hứng nữa thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360112,
					"content": "Tôi có thể làm Đèn Tiêu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
