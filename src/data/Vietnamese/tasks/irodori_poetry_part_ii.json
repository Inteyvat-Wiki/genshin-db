			"dialogs": [
				{
					"id": 726920101,
					"content": "Cháu đến thật đúng lúc, ta và Lenne đang sáng tác thơ mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920102,
					"content": "Muốn cháu tìm cảm hứng giúp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920103
					]
				},
				{
					"id": 726920103,
					"content": "Haha, bạn nói đúng. Hai ngày qua, dưới sự hướng dẫn của Ootomo, tôi đã thử sáng tác ra một bài thơ theo phong cách Inazuma, nhưng đáng tiếc trình độ vẫn còn rất non nớt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920104,
					"content": "Bài thơ này viết về \"tình bạn\", quả thực tôi và Ootomo đã ước được gặp nhau sớm hơn. Trong đó có một câu thơ, tôi muốn miêu tả cảnh các con vật dạo chơi cùng nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920105
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920105,
					"content": "Vì là bài thơ mang phong cách Inazuma, nên chỉ có thể tham khảo <color=#00E1FFFF>loài động vật độc đáo ở vùng đất Inazuma</color> thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920106,
					"content": "Nói đến những loài động vật độc đáo ở Inazuma, chúng ta thường thấy rất nhiều loại chạy dưới đất, bay trên trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920107,
					"content": "#Nhưng động vật đều xuất hiện ở ngoài thành, {NICKNAME} chúng ta ra ngoài thành tìm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920108,
					"content": "Nhờ bạn đấy, chỉ cần giúp tôi chụp <color=#00E1FFFF>4 tấm</color> hình có nội dung khác nhau về động vật của Inazuma là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
