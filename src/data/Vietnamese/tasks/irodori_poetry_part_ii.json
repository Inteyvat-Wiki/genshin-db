					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "Để tôi xem nào... ừm, rất tốt, tôi đã có ý tưởng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920204,
					"content": "Lần này tôi cũng đã viết những câu thơ phiên bản khác nhau dựa theo những tấm hình mà bạn mang về, bạn hãy chọn xem nên dùng câu nào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
