					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460375,
					"content": "Vậy rượu mật sẽ thuộc về tôi sao? Tốt quá! Nhưng mà, nó vốn là của tôi mà...",
					"roleType": "TALK_ROLE_NPC",
