				},
				{
					"id": 752460385,
					"content": "Vậy thì tôi không khách sáo nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#Woa, vừa vào đã đến cao trào rồi sao! Cao thủ {NICKNAME} của chúng ta đã sử dụng tuyệt kỹ để kéo câu! Câu được một con...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460302,
					"content": "Ơ... Một... Một con Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460303,
					"content": "Bất ngờ đây... Vừa mới bắt đầu là đã câu được một thứ không ngờ đến, làm khó hệ thống chấm điểm quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460304,
					"content": "#Không hổ danh là {M#ông}{F#bà} {NICKNAME}! Nếu những người khác không thể câu được khách mời đặc biệt hơn nữa thì đây chắc là quán quân mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460305,
					"content": "Cảm ơn các đối thủ mạnh mẽ, cảm ơn các khán giả thân mến! Mượn lời chúc phúc của cháu ngoan, tôi tin rằng mình sẽ trở thành quán quân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#Tốt quá! {NICKNAME} vừa ra trận là đã gây áp lực cho hai tuyển thủ còn lại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460307,
					"content": "Thí sinh Ifa hãy vào vị trí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460308,
					"content": "Cố lên, người anh em! Giúp một tay nào, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460309,
					"content": "Xin lỗi, Cacucu, bây giờ không phải là lúc giúp đỡ lẫn nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460310,
					"content": "Đừng đôi co nào... Đợi đã, đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460311,
					"content": "Ifa cố gắng kéo cần câu, trông có vẻ như đã câu được cá lớn.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "Nhưng thứ nổi lên mặt nước lại là...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "Ối... Thí sinh Ifa câu được Koholasaur từ trong hồ, lại còn đeo theo Capybara? Không biết tại sao lại đi chung với nhau nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460314,
					"content": "Tuyệt thật! Anh vẫn được động vật quý mến đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460315,
					"content": "Không đúng, cái đuôi của con Koholasaur này không ổn... Lẽ nào do bị đá dưới nước làm kẹt lại, rồi con Capybara này muốn giúp nó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460316,
					"content": "Cũng có thể là Capybara muốn ăn đuôi của Koholasaur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460317,
					"content": "Có vẻ không đúng đâu, người anh em. Cacucu, đi hỏi xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460318,
					"content": "Hmm... Đúng vậy, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460319,
					"content": "Xem đi, tôi đoán đúng rồi... Mà khoan, chuyện này giờ không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460320,
					"content": "Ifa nhanh chóng kiểm tra đuôi của Koholasaur. May mà chỉ bị trầy xước nhẹ, không có gì đáng ngại.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "Sau khi sát khuẩn và bôi thuốc, Koholasaur và Capybara đã cùng rời đi.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "Kết bạn rồi à. Xem ra hôm nay cũng là ngày may mắn của chúng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460323,
					"content": "\"Cũng\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460324,
					"content": "Ừm, tôi có dự cảm là mình sẽ thắng đấy. Đến lượt tôi phấn đấu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460325,
					"content": "Giúp một tay nào, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460326,
					"content": "Đang cổ vũ cho chúng tôi đó hả? Rốt cuộc là học từ đâu đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460327,
					"content": "Bậc thầy cổ vũ câu cá, Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "Chúng ta đang phấn đấu, vậy thì nó phải được gọi là bậc thầy cổ vũ phấn đấu, như vậy nghe sẽ hoành tráng hơn... Hửm?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460329,
					"content": "Thứ gì vậy?! Mọi người mau tránh ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460330,
					"content": "Tuy nhìn có chút đặc biệt... Nhưng sao lại là Capybara thế! Sinh vật này tính tình rất ôn hòa mà, sao trông nó như sắp lao vào chúng ta nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460331,
					"content": "Chắc nó cũng đang phấn đấu vì điều quan trọng của mình. Hmm, tôi có thể cảm nhận được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460332,
					"content": "Hmm, hình như không đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460333,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460334,
					"content": "Tâm trạng của nó đang không tốt, người nên phấn đấu là chúng ta đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460335,
					"content": "Nào, người bạn thân mến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460336,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460337,
					"content": "Haha! Tuyệt vời quá, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460338,
					"content": "Hả? Cacucu đang... thuyết phục nó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460339,
					"content": "Chắc là đang an ủi. Đừng thấy Cacucu như vậy, nó rất giỏi trong việc an ủi bệnh nhân đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460340,
					"content": "Hóa ra là vậy, nhưng kho từ vựng của Cacucu có đủ dùng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460341,
					"content": "Paimon, dùng từ ngữ của con người vốn dĩ cũng không thể giao tiếp với Capybara được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460342,
					"content": "Ah... Đúng nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460343,
					"content": "Trong tình huống này, phải tin tưởng vào người anh em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460344,
					"content": "Hơn nữa tôi cho rằng, khi giao tiếp thì giọng điệu sẽ quan trọng và có sức thuyết phục hơn cả nội dung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460345,
					"content": "Ví dụ như \"xin chào\" này là có ý vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460346,
					"content": "\"Xin chào\" này... là có ý miễn cưỡng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460347,
					"content": "Còn \"Xin chào!\" này là đang tức giận, thường mang ý có nguy hiểm ở gần và phải tránh xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460348,
					"content": "Được rồi, cũng có lý. Nhưng nghĩ thế nào cũng thấy khó hiểu quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460349,
					"content": "Học được điều mới rồi, cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "Thật sao? Đáng mừng đấy. Thường ngày tôi cũng giao lưu với đám bọ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460351,
					"content": "Nhân viên bọ chứ... Quên rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460352,
					"content": "Cũng có những con bọ không muốn làm nhân viên mà. Tôi hiểu và cũng tôn trọng sự lựa chọn của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460353,
					"content": "...Vậy có thể hiểu cho tâm trạng của tôi trước được không? Bây giờ tâm trạng của tôi đang rất phức tạp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460354,
					"content": "Thật sao? Tôi thấy anh nên tự hào mới phải. Nhìn bên kia kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460355,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460356,
					"content": "Haha! Đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460357,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460358,
					"content": "Trời ơi là trời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460359,
					"content": "Trò chuyện sôi nổi ghê nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460360,
					"content": "Cũng có chút tự hào đấy, nhưng tôi thấy... Hửm? Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460361,
					"content": "Đừng lo, tôi có cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460362,
					"content": "Xin chào, Vua Capybara. Có muốn ăn chút đồ ăn vặt không? Bánh quy tươi ngon mà Ifa vừa mới làm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460363,
					"content": "Rrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460364,
					"content": "Vua Capybara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460365,
					"content": "Ăn rồi kìa! Trông nó có vẻ rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460366,
					"content": "Ôi chà! Ôi chà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460367,
					"content": "Mà này... Có ai còn nhớ chúng ta đang thi câu cá không? Nơi này sắp thành vườn thú luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460368,
					"content": "Không phải rất tốt sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "Cũng phải... Vậy quán quân lần này chắc là Ororon nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460371,
					"content": "Vì anh ấy câu được... Vua Capybara gì đó.",
