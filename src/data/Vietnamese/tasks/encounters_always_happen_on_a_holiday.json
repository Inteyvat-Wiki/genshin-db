					"nextDialogs": [
						752460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460377,
					"content": "Nói đúng lắm, mà chúng ta cũng có thu hoạch đấy. Nhìn kìa, Vua Capybara hình như có mang quà cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460378,
					"content": "Trứng Lấp Lánh và một tấm ảnh à? Nơi chụp trên đó trông có vẻ quen đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460379,
					"content": "Vua Capybara muốn chúng ta tới nơi này sao? Xem ra là một loại chỉ dẫn nào đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460380,
					"content": "Hay là đi tìm thử xem.",
