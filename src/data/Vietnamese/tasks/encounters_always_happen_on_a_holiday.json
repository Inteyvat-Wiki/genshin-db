			"dialogs": [
				{
					"id": 752460101,
					"content": "#{NICKNAME}, mau nhìn kìa, bên kia có người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460102,
					"content": "Ơ? Hai bóng lưng này là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "Ororon và Ifa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460104,
					"content": "#Giọng nói quen thuộc, là {M#ông}{F#bà} {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460105,
					"content": "Ồ, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460106,
					"content": "Lâu rồi không gặp, các vị cũng tới khu nghỉ dưỡng à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460107,
					"content": "Chasca có nói hai người đến làm việc ở khu nghỉ dưỡng, không ngờ lại gặp nhau như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460108,
					"content": "Đúng vậy. Bầu không khí ở đây thật tuyệt, nghe nói mọi người đều chơi rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460109,
					"content": "Hihi, hy vọng nơi này sẽ càng ngày càng phát triển, du khách càng ngày càng đông!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460110,
					"content": "Hai người thì sao? Công việc thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460111,
					"content": "Cũng không tệ. Nhân viên Saurian và bọ mật mà chúng tôi chăm sóc đều rất khỏe mạnh, tràn đầy sức sống. Nhờ vậy mà chúng tôi cũng có thời gian đi dạo khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460112,
					"content": "...Nhân viên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460113,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460114,
					"content": "Là nhân viên bọ mật. Nhân viên Saurian và nhân viên bọ mật. Anh nói thiếu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460115,
					"content": "Đúng vậy đó, người anh em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460116,
					"content": "Haiz... Xin lỗi. Vậy thì cảm ơn tất cả nhân viên, và cả Ororon đây, người đã tích cực phục vụ các nhân viên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460117,
					"content": "Dậy sớm vài ngày để phấn đấu vì những điều quan trọng. Ừm, rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460118,
					"content": "Lần đầu tiên người anh em này nhận được thư mời chính thức đó, nên tích cực lắm. Xin đừng bận tâm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460119,
					"content": "Giữ được nhiệt huyết là chuyện tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#Nhìn xem, {M#ông}{F#bà} {NICKNAME} cũng nói thế kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460121,
					"content": "Mỗi ngày đều rất quan trọng, công việc của mỗi ngày là chiến đấu để bảo vệ những điều quan trọng. Đây là những gì Cacucu đã dạy tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460122,
					"content": "Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460123,
					"content": "Nhưng mà... Trông có vẻ như các anh đang câu cá mà? Câu cá cũng được xem là chiến đấu để bảo vệ điều quan trọng ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460124,
					"content": "Tự nghe lại lời mình vừa nói xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460125,
					"content": "Rất quan trọng. Vì câu cá là do một người bạn đã đề nghị. Cậu ấy là nhà mạo hiểm nổi tiếng của Mondstadt, đã vậy còn rất may mắn nữa. Nghe theo cậu ấy là không sai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460126,
					"content": "(À... Là Bennett sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "Người anh em đó dùng cành cây xoay một vòng, cành cây đã chỉ về hồ nước này. Ororon nói cầu may không bằng gặp may, nên đã đến đây câu cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460128,
					"content": "Đợi đã, từ nãy tôi đã muốn hỏi rồi... Xung quanh hồ này đều là Capybara mà! Thật sự có thể câu được cá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460129,
					"content": "Không sao đâu, Capybara rất hiền lành, không hung hăng, nên không cần cảnh giác. Có nước là có thể câu cá, đây là lời dạy của bà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460130,
					"content": "Bà còn nói có cơm thì ăn, người ta chừa đường cho thì tự biết mà lui, nhớ chưa nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460131,
					"content": "#Đúng đó, nên giờ tôi đang đứng trên đường đây. {M#Ông}{F#Bà} {NICKNAME} và Paimon, có muốn cùng câu cá không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460132,
					"content": "Tiện thể nói luôn, người câu được con cá lớn nhất sẽ nhận được rượu mật của Ororon đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460133,
					"content": "Có chuyện tốt như vậy sao không nói sớm chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460134,
					"content": "#Hừm, xem ra anh không biết mình đã chọc phải ai rồi... Tới luôn! Gặp phải {NICKNAME} thì xem như anh đã đụng độ đối thủ mạnh rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460135,
					"content": "Người anh em thân mến, phân thắng bại thôi nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "Thật năng nổ, vậy thì tôi cũng xin góp vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460137,
					"content": "Cháu yêu, cùng câu cá nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "Không thành vấn đề. Tôi cược tất cả rượu mật của nhân viên bọ, quyết phân thắng bại nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
