					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220201,
					"content": "Mondstadt có một món \"Thịt Om Táo Đất Bắc\", nhưng Xudong đã viết loạn lên hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220202,
					"content": "\"Bơ đắt hơn một chút và thịt động vật khó bảo quản. Chi bằng nhào bột lấy tinh bột mì ra, hấp cùng với gia vị rau củ quả sẽ có vị thơm như thịt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220203,
					"content": "Cái tên đó, bơ thì quý giá gì đâu chứ, thịt rừng thì có thể tự đi tìm đồ tươi được mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220204,
					"content": "Thôi kệ đi...nhà lữ hành, vậy nguyên liệu để làm \"Thịt Om Táo Đất Bắc\", ngoài Táo, Bơ và Thịt Rừng ra, còn cần nguyên liệu gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220205,
					"content": "Hạnh Nhân",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "Ừm...vậy sao? Để tôi ghi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220206,
					"content": "Tiêu",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "Ừm...vậy sao? Để tôi ghi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Ớt Tuyệt Vân",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "Giăm Bông",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
