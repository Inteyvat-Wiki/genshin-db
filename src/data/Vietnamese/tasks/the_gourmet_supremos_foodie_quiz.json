			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "Công thức này hình như là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220102,
					"content": "Bạn đang làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "Tôi đang sắp xếp lại công thức, haiz...có một số công thức tôi nhớ không rõ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220104,
					"content": "Cái này đi hỏi Xudong là được thôi mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "Xudong sao...những công thức mà tôi nhớ không rõ, đa phần nguyên nhân đều là do cái tư tưởng \"sáng tạo nấu ăn\" của anh ấy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220109,
					"content": "Mỗi khi anh ấy lấy được công thức gì đó, cùng lắm là làm theo hai ba ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220110,
					"content": "Sau đó anh ấy lại bắt đầu...dùng nhiều phương pháp khác nhau để \"sáng tạo\" cái công thức đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220111,
					"content": "Tại sao phải làm vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "Theo anh ấy nói thì làm vậy để giảm giá thành xuống...nhưng tôi không nhớ rõ là tại sao anh ấy lại làm vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220118,
					"content": "Nhưng dù nói thế nào đi nữa thì xét về mặt kết quả, anh ấy cũng đã thành công trong biệt cải biến món ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220119,
					"content": "Mùi vị khá tương đồng với bản gốc, nhưng giá thành thì lại rẻ đến quá đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220120,
					"content": "Chúng tôi đồng ý đồng hành với nhau, cũng là do cách chế biến món ăn quá đáng này của anh ấy. Còn anh ấy chịu cho tôi đi chung, có lẽ là nhắm tới kỹ thuật của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220121,
					"content": "Vậy, bạn có cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "À à! Đúng rồi, mãi nói chuyện của Xudong nên quên mất chuyện chính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220128,
					"content": "Chính vì Xudong thường xuyên kéo tôi vào những vụ cải biến món ăn, lại còn vẽ loạn vào cả công thức nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220129,
					"content": "Vì vậy để cho chuẩn xác, tôi phải tìm cách khôi phục lại bản gốc, sau đó sao chép lại một bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220130,
					"content": "Nhà lữ hành, nếu như bạn nhớ những công thức đó thì có thể nhắc lại cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220131,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "Vậy thì nhờ vào bạn nhé, tôi sắp xếp lại thực đơn trước, chút nữa bạn chỉnh lại những chỗ không rõ là được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220132,
					"content": "Tôi đã ăn gần hết cái Teyvat rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "Kỹ thuật của bạn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "Trước đó không phải tôi có nói qua rồi sao? Phần nghiên cứu của tôi có tựa đề là \"gia vị vạn năng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220125,
					"content": "Nói đơn giản thì là một loại gia vị khi thêm vào bất kỳ món ăn nào đều sẽ biến thành mỹ vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220126,
					"content": "Để nghiên cứu ra loại gia vị này, tôi đã đi du học qua rất nhiều quốc gia để thu thập các loại nguyên liệu khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220127,
					"content": "Khụ, nói hơi xa rồi, nói lại chuyện chính nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220113,
					"content": "Cụ thể anh ấy làm như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "Ừm...việc cải biến của anh ấy có hơi khác biệt so với những đầu bếp khác, các đầu bếp khác thường sẽ thêm thắt để khiến cho món ăn thêm phần phong phú để bán cho được giá hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220115,
					"content": "Nhưng Xudong thì lại đi ngược lại hoàn toàn với nguyên tắc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220116,
					"content": "Anh ta dùng những nguyên liệu như đậu hũ...nấm...và một số nguyên liệu giá rẻ khác để chế biến. Nhưng khi ăn thì lại có mùi thơm đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220117,
					"content": "Anh ấy còn dùng cả Khoai Tây, Lúa Nước, Đài Sen, Ớt Tuyệt Vân và Thịt Rừng để làm ra món \"Tiên Nhảy Tường\" phiên bản giá rẻ nữa. Nhưng mà mùi vị khi ăn cũng không thua bản gốc là mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220106,
					"content": "Nhóm của bạn không phải là \"nhóm ẩm thực toàn năng\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "Cầu xin bạn đừng nhắc lại cái tên này nữa! Trong luận văn của tôi cũng sẽ không đề cập đến năm chữ này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220108,
					"content": "Hơn nữa, việc không nhớ được công thức, phần lớn nguyên nhân đều xuất phát từ ý định \"sáng tạo thức ăn\" của Xudong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
