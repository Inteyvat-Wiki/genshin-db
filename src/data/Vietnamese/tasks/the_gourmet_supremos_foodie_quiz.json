			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220301,
					"content": "Liyue có một món \"Thịt Thiên Khu\" rất nổi tiếng, để tôi xem, Xudong lại viết bậy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220302,
					"content": "\"Gọt vỏ khoai tây và hấp chín, tán nhuyễn khi còn nóng, trộn với dầu và muối, đổ ra bát, sau đó trộn với bột mì cho đặc lại, nếm thử vị ngon như thịt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220303
					],
					"speakerTitle": "Parvaneh"
				},
				{
