			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "Nhờ có dữ liệu dùng thử của bạn, công việc hiệu chỉnh cuối cùng của Gai Pursina cũng đã hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280102,
					"content": "Bây giờ, tôi hoàn toàn có thể chắc chắn rằng nó có thể vận hành ổn định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280103,
					"content": "Chỉ cần chúng ta đem Gai Pursina đặt ở nơi mô hình di tích hay xuất hiện là có thể khống chế được nguồn cung cấp năng lượng của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280104,
					"content": "Chỉ cần khởi động chiếc gai, thì cỗ máy sẽ không thể tự mình sửa chữa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280105,
					"content": "Cảm ơn bạn đã giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "Công lao không phải của riêng tôi, chúng ta phải cảm ơn những tiền bối đã để lại kiến thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280109,
					"content": "Nếu không có sự hướng dẫn của những kiến thức đó, thì dù thế nào tôi cũng nghĩ không ra cách để hạ gục mô hình di tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280110,
					"content": "Mọi thứ chúng ta làm đều phụ thuộc vào sự hướng dẫn của kiến thức, và kiến thức là nguồn tài nguyên quan trọng nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280111,
					"content": "Nghe có vẻ rất khó hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "Bạn không hiểu được đạo lý cơ bản nhất này cũng rất bình thường, vì dù sao bạn cũng chưa từng được soi sáng bởi trí tuệ tối cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280113,
					"content": "Mất biết bao công sức mới sửa được Gai Pursina, tôi có hơi kích động, haha, lúc nãy tôi đi hơi xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280114,
					"content": "Chúng ta chỉ còn một việc cuối cùng, đó là đến Đảo Tsurumi để bố trí Gai Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280115,
					"content": "Xin lỗi, chuyện này tôi không giúp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280116,
					"content": "Theo quy định ở Inazuma, những người ngay cả thủ tục cư trú còn chưa có như tôi không được phép tự do hành động, việc này bạn phải tự làm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280117,
					"content": "Hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "Phụ thuộc vào bạn đó. Tôi khuyên bạn không nên hành động ngay sau khi đặt mà hãy quan sát xem mọi thứ có hoạt động bình thường không rồi báo lại với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280119,
					"content": "Vì sự an toàn của bạn, tốt nhất chúng ta nên thận trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280107,
					"content": "Cảm ơn sức mạnh của công nghệ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "Tôi lại không nghĩ vậy, chúng ta nên cảm ơn những tiền bối đã để lại kiến thức cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				}
			]
		},
