			"dialogs": [
				{
					"id": 700280301,
					"content": "Thế nào? Nó có vận hành bình thường không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280302,
					"content": "Vẫn bình thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "Ừm, vậy là tốt, hy vọng sau này cũng không xảy ra sự cố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280304,
					"content": "Như vậy, chỉ cần khởi động chiếc gai khi mô hình di tích đến gần nó, thì nguồn cung cấp năng lượng của mô hình sẽ bị cắt đứt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280305,
					"content": "Lần này, bạn sẽ đánh bại được nó, hành động đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280306,
					"content": "Tôi tin vào thực lực của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
