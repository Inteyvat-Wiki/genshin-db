				"points": []
			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "Nhìn bạn vội vàng quá, có điều gì khiến bạn lo lắng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100102,
					"content": "Có nhiều chuyện lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "Ấy... Tôi thấy bạn trông mệt mỏi lắm, nhưng hành động vẫn rất vội vã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100104,
					"content": "Chắc chắn bạn đang lo lắng về vấn đề gì đó, nhưng lại không thể nhanh chóng tìm ra phương án giải quyết đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100109,
					"content": "Nếu bạn bằng lòng cho tôi chút thời gian, tôi mong bạn có thể ngồi xuống, cùng thưởng thức đồ ăn ngon với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100110,
					"content": "Bôn ba khắp nơi là trạng thái bình thường trong đời... nhưng người ta hay nói, nước sông mãnh liệt dâng trào về phía trước thỉnh thoảng cũng sẽ lẳng lặng chảy qua dòng suối nhỏ yên tĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100111,
					"content": "Dù có vất vả thế nào đi nữa, cũng nên cho mình chút thời gian nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100112,
					"content": "Để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100113,
					"content": "Chi bằng chúng ta cùng thưởng thức \"Canh Đậu Bạc Hà\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100114,
					"content": "Bạn không cần trả Mora cho tôi, chỉ cần tìm cho tôi một phần bạc hà là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100115,
					"content": "À, phải rồi, lúc tìm bạc hà đừng khắt khe quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100116,
					"content": "Nên nhớ, bạn chỉ tìm một phần bạc hà bình thường thôi chứ không phải đang tìm vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100105,
					"content": "Thật ra thì vẫn ổn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "Ồ... như vậy là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100107,
					"content": "Nhưng bước chân của bạn vội vàng như vậy, chắc phải bôn ba để giải quyết vấn đề nào đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100108,
					"content": "Chà, tuy tôi không biết bạn phải giải quyết chuyện gì, nhưng tôi có một đề nghị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				}
			]
		},
