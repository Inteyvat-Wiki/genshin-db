			"dialogs": [
				{
					"id": 230100801,
					"content": "Nhìn bạn vội vàng quá, có điều gì khiến bạn lo lắng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100802,
						230100805
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100802,
					"content": "Có nhiều chuyện lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "Ấy... Tôi thấy bạn trông mệt mỏi lắm, nhưng hành động vẫn rất vội vã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100804,
					"content": "Chắc chắn bạn đang lo lắng về vấn đề gì đó, nhưng lại không thể nhanh chóng tìm ra phương án giải quyết đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100809,
					"content": "Nếu bạn bằng lòng cho tôi chút thời gian, tôi mong bạn có thể ngồi xuống, cùng thưởng thức đồ ăn ngon với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100810,
					"content": "Bôn ba khắp nơi là trạng thái bình thường trong đời... nhưng người ta hay nói, nước sông mãnh liệt dâng trào về phía trước thỉnh thoảng cũng sẽ lẳng lặng chảy qua dòng suối nhỏ yên tĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100811,
					"content": "Dù có vất vả thế nào đi nữa, cũng nên cho mình chút thời gian nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100812,
					"content": "Để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100813,
					"content": "Chi bằng chúng ta cùng thưởng thức \"Cuốn Shawarma\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100814,
					"content": "Bạn không cần trả Mora cho tôi, chỉ cần tìm cho tôi một miếng Thịt Rừng là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100815,
					"content": "Dù dùng đến cách gì để tìm được Thịt Rừng cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100816,
					"content": "Nên nhớ, bạn chỉ cần tìm được một miếng Thịt Rừng thôi, chứ không phải qua một cửa ải khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100805,
					"content": "Thật ra thì vẫn ổn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "Ồ... như vậy là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100807,
					"content": "Nhưng bước chân của bạn vội vàng như vậy, chắc phải bôn ba để giải quyết vấn đề nào đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100808,
					"content": "Chà, tuy tôi không biết bạn phải giải quyết chuyện gì, nhưng tôi có một đề nghị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "Jafar"
				}
			]
