					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100702,
					"content": "Jafar lấy các nguyên liệu khác ra bắt đầu nấu nướng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100703,
					"content": "Đây là \"Panipuri\" được nấu từ chỗ nguyên liệu bạn mang đến đấy, nếm thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100704
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100704,
					"content": "Cảm ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100705
					]
				},
				{
					"id": 230100705,
					"content": "Đừng khách sáo. Tập trung hưởng thụ món ngon này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100706
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100706,
					"content": "Đối với tôi mà nói, lúc hưởng thụ đồ ăn ngon, tôi sẽ ném hết đề tài và nghiên cứu khiến người ta mệt mỏi kia ra khỏi đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100707
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100707,
					"content": "Cứ thế mà thả những suy nghĩ của tôi êm đềm trôi qua dòng suối nhỏ... Đây là cách tôi nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100708
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100708,
					"content": "Tốt rồi, bạn hãy cảm nhận tỉ mỉ món ngon này đi. Mong là suy nghĩ của bạn cũng được nghỉ ngơi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
		},
