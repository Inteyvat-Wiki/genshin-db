				{
					"id": 230100301,
					"content": "Bạc hà tuyệt lắm, xin chờ một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100302,
					"content": "Jafar lấy các nguyên liệu khác ra bắt đầu nấu nướng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "Đây là \"Canh Đậu Bạc Hà\" được nấu từ chỗ nguyên liệu bạn mang đến đấy, nếm thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100304,
					"content": "Cảm ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "Đừng khách sáo. Tập trung hưởng thụ món ngon này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100306,
					"content": "Đối với tôi mà nói, lúc hưởng thụ đồ ăn ngon, tôi sẽ ném hết đề tài và nghiên cứu khiến người ta mệt mỏi kia ra khỏi đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100307,
					"content": "Cứ thế mà thả những suy nghĩ của tôi êm đềm trôi qua dòng suối nhỏ... Đây là cách tôi nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100308,
					"content": "Tốt rồi, bạn hãy cảm nhận tỉ mỉ món ngon này đi. Mong là suy nghĩ của bạn cũng được nghỉ ngơi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
