				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "Ba người các ngươi, ai là đại ca? Bước ra đây đấu với ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Xe Bay Ồn Ào Sennichi"
				},
				{
					"id": 727350102,
					"content": "Xe Bay Ồn Ào Sennichi ta là tinh nhuệ trong tinh nhuệ, đại diện cho Tướng Quân Hanakado, đến lấy mạng của đại ca Bang Arataki các ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Xe Bay Ồn Ào Sennichi"
				},
				{
					"id": 727350103,
					"content": "Hic, hung dữ quá! Nói chuyện cũng dữ dằn quá! Lần này hình như là kẻ mạnh rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "Hừm! Danh hiệu của ngươi cũng oách đấy, nhưng ngươi muốn oách hơn bổn đại gia ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Bổn đại gia sẽ đánh bại loại tinh nhuệ như ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "Thanh niên này cao, cao quá vậy, lại còn là... tộc Oni nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Xe Bay Ồn Ào Sennichi"
				},
				{
					"id": 727350107,
					"content": "Người có khí thế như vậy mà sao đi tham gia vào trò chơi cho con nít chứ... Đúng là gặp quỷ thật rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Xe Bay Ồn Ào Sennichi"
				},
				{
					"id": 727350108,
					"content": "Ngươi nói cái gì? Ngươi đang xem thường trò chơi đấu bọ sao? Đúng là to gan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Những kẻ hoàn toàn không hiểu gì về đấu bọ thì phải để những người yêu thích đấu bọ ta đây dạy dỗ! Bổn đại gia sẽ giáo huấn ngươi đàng hoàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "Dạy dỗ hắn! Dạy dỗ hắn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "Đúng đúng, không thể để hắn cứ khoác lác như vậy được! Trông cậy vào anh đó, Tên Thả Bò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Không còn cách nào khác rồi... Chơi luôn, xem ai sợ ai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xe Bay Ồn Ào Sennichi"
				},
				{
					"id": 727350111,
					"content": "Giáo huấn hắn! Giáo huấn hắn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}