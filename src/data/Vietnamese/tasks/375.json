			"dialogs": [
				{
					"id": 3750101,
					"content": "Haiz, quả nhiên bạn cũng không được nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750102,
					"content": "Quả... quả nhiên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750103,
					"content": "#Tôi chỉ muốn xem {NICKNAME} là thành viên siêu cấp mới của đội kỵ sĩ, có đủ sức nặng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750104,
					"content": "Bạn xem, dũng sĩ tiện tay lấy mất bảo kiếm trong thôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750105,
					"content": "Đây có phải câu chuyện rất thích hợp để ca hát lưu truyền không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750106,
					"content": "Hứ, cảm thấy sự ví dụ của bạn thật thất lễ, nhà thơ lang thang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750107,
					"content": "Haiz, bạn hiểu lầm tôi rồi. Đây là sự thất vọng với Mondstadt, trước mặt dũng sĩ mà còn tiếc của.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750108,
					"content": "Vậy thì, xem ra mượn trực tiếp không được, đành phải lén lấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750110,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "Hôm nay chúng ta tuyệt đối tôn trọng ý chí tự do, các bạn nói xem thích lấy như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750112,
					"content": "Kỳ thực tôi không thích lấy trộm đồ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "Nói đi, không cần câu nệ, ý chí tự do là cần phải nói chuyện thoải mái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750113,
					"content": "Heheh, xem bạn kìa, vừa mở miệng đã lạc đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750114,
					"content": "Nghiêm túc mà nói, việc này bạn đi làm thích hợp hơn tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750115,
					"content": "Vì tôi ngoài việc ca hát ra, thì không có sở trường nào đáng tự hào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750116,
					"content": "Hơn nữa tôi không có thân nhân nào ở Mondstadt, bị bắt rồi không có người kêu oan, nhất định sẽ bị phạt nặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750117,
					"content": "Ăn trộm bị bắt cũng không có gì oan ức mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750118,
					"content": "#Nhưng {NICKNAME} thì khác. Bạn là người đã cống hiến cho Mondstadt, là ngôi sao ngày mai của đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750119,
					"content": "Sau khi thất thủ thì giải thích một chút, chắc là sẽ thoát được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750140,
					"content": "Mà thủ vệ ở đây, hình như là sẽ không làm việc vào ban đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750141,
					"content": "Ái chà, nếu có thể nắm lấy thời cơ này, muốn thất bại cũng khó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750120,
					"content": "Đừng cứ coi thất bại là tiền đề chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750122,
					"content": "Lúc nãy anh nói mình là Barbatos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#{NICKNAME}... bạn nghĩ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750123,
					"content": "A, hình như có nói như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750125,
					"content": "Nếu anh thật sự là Thần, thì không thể khoanh tay đứng nhìn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "Cho nên là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750126,
					"content": "Ồ? Vì sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750128,
					"content": "Nếu anh không phải là Thần, tôi cũng sẽ cứu Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#Liên quan đến quá khứ của {NICKNAME}, sau này từ từ nói vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750130,
					"content": "Tôi sẽ đem \"Thiên Không\" về cho anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "Vì tôi không muốn lại nhìn thấy \"sự ly biệt\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "...Hử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "Venti"
				}
			]
		},
