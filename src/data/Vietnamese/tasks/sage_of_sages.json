				},
				{
					"id": 130380503,
					"content": "Tôi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380504
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380504,
					"content": "Đây là vòng cuối cùng của nghi thức lần này, hãy nhớ kỹ điều kiện mà hai bên đưa ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380505
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380505,
					"content": "Chuẩn bị xong rồi thì có thể bắt đầu bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380506
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380507
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380507,
					"content": "Tôi là Sethos, là người thích hợp với sức mạnh của Hermanubis, cháu của Bamoun, thủ lĩnh đương nhiệm của Ngôi Đền Im Lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380508
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380508,
					"content": "Bao lâu nay, Ngôi Đền Im Lặng chúng tôi giữ bí mật theo yêu cầu của Hermanubis. Cũng vì tự bảo vệ mà tiến hành thí nghiệm khi lâm vào đường cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380509
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380509,
					"content": "Chúng tôi theo đuổi chân lý và sức mạnh của Hermanubis, khát khao linh hồn và ánh sáng của ngài ấy xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380510
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380510,
					"content": "Giờ đây, tôi phải chiến đấu để giành lấy sức mạnh này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380511
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380511,
					"content": "Tôi là Cyno, Tổng Quản Mahamatra, là học trò và người kế thừa của hiền giả Cyrus, sẽ chiến đấu để bảo vệ sức mạnh của bản thân, thầy giáo và đất nước của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380512
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380512,
					"content": "Còn anh? Vẫn còn lời chưa nói phải không. Nếu đã là quyết đấu cao quý, thì hãy thể hiện lòng chân thành trước Hermanubis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380513
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380514
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380514,
					"content": "(Tất cả mọi người... Già trẻ gái trai, đều đang rất mong chờ vào kết quả của trận quyết đấu này.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380515
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380515,
					"content": "Ông là người lãnh đạo khôn ngoan, cũng là thủ lĩnh không ngại vấy máu. Tôi biết ông ấy nghĩ thế nào, cũng biết ông ấy trông đợi vào tôi ra sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380516
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380516,
					"content": "Nhưng chúng tôi đã bị tín ngưỡng ràng buộc quá lâu. Sau đó tôi đã tới rừng mưa một chuyến, gặp gỡ những người trong thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380517
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380517,
					"content": "Thời đại đã thay đổi, người Sumeru bây giờ dường như vui vẻ tự do hơn. Tôi đứng ở trên cao, nhìn xuống cảnh phố phường bên dưới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380518
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380518,
					"content": "Sau đó tôi nghĩ tới anh. Cyno, anh cũng có sức mạnh này, nhưng lại sống một cuộc đời hoàn toàn khác với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380519
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380519,
					"content": "Bạt Linh của Hermanubis đều có biểu tượng, uy lực, vinh quang... và nhiều bí mật chưa được giải đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380520
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380520,
					"content": "Tôi từng nghĩ, chắc là do biểu tượng của Bạt Linh mà chúng ta nhận được khác nhau nên mới khác biệt như thế. Hoặc có lẽ... Anh đã tìm thấy câu trả lời mà tôi vẫn chưa tìm ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380521
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380521,
					"content": "Tôi không chỉ là một chiến binh, tôi còn là chính mình nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380522
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380522,
					"content": "...Đúng thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380523
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380524
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380524,
					"content": "Chúng ta đều là vật chứa của Hermanubis, cũng không hoàn toàn là thế. Tên của ngài ấy ảnh hưởng đến chúng ta, thay đổi cuộc đời của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380525
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380525,
					"content": "Nếu là anh thì chắc sẽ có thể trả lời câu hỏi của tôi. Ngoài sức mạnh và tín ngưỡng này... Thì tôi còn có thể đem lại cái gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380526
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380526,
					"content": "Lên đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380527
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380527,
					"content": "Thế nào? Vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380528,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380529
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380529,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
