			"dialogs": [
				{
					"id": 130380301,
					"content": "Hôm nay, trước sự chứng kiến từ sức mạnh và uy lực của Hermanubis, hiền giả trong các hiền giả, chúng ta sẽ một lần nữa tổ chức Nghi Thức Quyết Đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380302,
					"content": "Đây là nghi thức thiêng liêng, người xem không được gây rối, phải cung kính quan sát toàn bộ quá trình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380303,
					"content": "Đại diện của Ngôi Đền Im Lặng. Bên phòng thủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380304,
					"content": "Ông nội, ông tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380305,
					"content": "Khụ... Đã bao nhiêu năm rồi, không ngờ cháu lại tổ chức nghi thức này, Sethos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "Bamoun"
				},
				{
					"id": 130380306,
					"content": "Cháu biết mình đang làm gì, ông cứ yên tâm xem nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380307,
					"content": "Đại diện của Giáo Viện. Bên tấn công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380308,
					"content": "Đã sẵn sàng. Hôm nay chúng tôi sẽ dùng thực lực để giành lấy quyền phát ngôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380309,
					"content": "Vậy thì, mời hai bên vào vị trí và quyết định thứ tự chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380310,
					"content": "Ở đây, chúng tôi không hỏi điều gì đã mang chúng ta đến đây và điều gì sẽ xảy ra với người thua cuộc. Đặt cược bằng sức mạnh của Hermanubis, chiến đấu đến khi phân thắng thua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380311,
					"content": "Để tôi lên trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "Hả? Có chắc chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380313,
					"content": "Ừm. Sĩ khí quan trọng lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "#Tôi đồng ý, {NICKNAME} rất mạnh, tiên phong ra trận sẽ khiến đối thủ e ngại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380315,
					"content": "Tiếp theo sẽ đến anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380316,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380317,
					"content": "Quyết định vậy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380318,
					"content": "Chúng tôi cũng quyết định xong rồi, bắt đầu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
