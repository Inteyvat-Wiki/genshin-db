			"dialogs": [
				{
					"id": 130380601,
					"content": "Đã đến nước này rồi, chúng ta đã không còn đường lui nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380602,
					"content": "Cũng không phải mới bắt đầu. Từ lúc thầy lẻn đi là tôi đã không còn đường lui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380603,
					"content": "Anh phải thắng. Cho dù là Tổng Quản Mahamatra hay là chính bản thân anh, đều cần đến sức mạnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380604,
					"content": "Đúng thế. Hơn nữa sức mạnh này đã theo anh lâu như vậy, nó nhất định cũng công nhận anh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380605,
					"content": "Cho dù là một Matra, hay là bản thân tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380606,
					"content": "Đúng vậy, nghĩ lại thì tôi cũng khó khăn lắm mới vượt qua khó khăn để kiểm soát được sức mạnh này. Đâu phải ai cũng làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380607,
					"content": "Đúng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380608,
					"content": "Đừng nghĩ nhiều, hãy giành chiến thắng nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#Ừm, tôi và {NICKNAME} chắc chắn sẽ không thua đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380611,
					"content": "Tôi cũng thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380612,
					"content": "Nền văn minh sa mạc rất cổ xưa, nhưng vì nhiều nguyên nhân nên đã nảy sinh ra khoảng cách với rừng mưa. Giống như Dehya đã nói, thành kiến ngăn cản mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380613,
					"content": "Tâm bệnh là nguồn gốc của mọi thứ. Tôi luôn cảm thấy cái mà Bamoun quan tâm dường như không chỉ có những thứ này. Sethos cũng không phải kẻ xấu, anh ta có dự tính của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380614,
					"content": "...Tất cả trông chờ vào ngày mai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380609,
					"content": "Chúng tôi cũng sẽ giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
		},
