			"dialogs": [
				{
					"id": 130380101,
					"content": "Mọi người gặp lại nhau khi đến giờ hẹn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "Tôi đã suy nghĩ nghiêm túc rồi. Với tính cách của thầy, có thể một mình chạy đến sa mạc thì chắc chắn đã chuẩn bị sẵn sàng cho việc không quay lại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380103,
					"content": "Ông ấy là người yêu hận rõ ràng và hơi cố chấp, chúng ta không thể thuyết phục ông ấy bỏ chạy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380104,
					"content": "Tôi đồng ý. Thầy Naphis cũng từng nói thầy Cyrus là một người rất kiên quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380105,
					"content": "Ừm, ngoài ra thì tôi còn nhớ ra vài chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380106,
					"content": "Mọi người đều biết rõ thông tin về Ngôi Đền Im Lặng rồi, chỗ này tôi không có gì cần bổ sung thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380107,
					"content": "Ký ức của tôi về nơi này vẫn rất mơ hồ, đa phần là do ảnh hưởng của Bạt Linh. Hồi nhỏ tôi thường bị đau đầu và sốt liên tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380108,
					"content": "Khi đó tôi còn đột nhiên cảm nhận được một loại cảm xúc vĩ đại nào đó, nhìn thấy một vài cái bóng mơ hồ. Nhưng đều là những mảnh ghép rời rạc, không thể nhớ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380109,
					"content": "Khi đó còn nhỏ, chỉ biết trong đầu có một luồng ý chí ngoan cường. Giờ nghĩ lại, cho dù không thể giao tiếp thì Hermanubis cũng đã dùng cách nào đó để khích lệ con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380110,
					"content": "Sức mạnh đó truyền vào tinh thần, có lẽ chính là thứ mà họ tin vào. Ý chí và sức mạnh của Hermanubis thực sự tồn tại, vậy nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380111,
					"content": "Chẳng lẽ anh sẽ chấp nhận làm theo lời họ sao? Không còn cách nào tốt hơn ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380112,
					"content": "Đừng manh động, Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "Không, tôi không định trả lại. Có lẽ họ có đủ tư cách nắm bắt tung tích của sức mạnh bảy trụ cột, nhưng tôi cần sức mạnh này để bảo vệ Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380115,
					"content": "Tôi phải đối mặt trực tiếp, đường đường chính chính, một lần nữa chiến thắng sức mạnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380116,
					"content": "Đúng rồi, trước khi đi Alhaitham đã nhắc nhở, Ngôi Đền Im Lặng trước đây là một tổ chức quý tộc cổ xưa, mà quý tộc thì luôn bị ràng buộc bởi lễ nghi của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380117,
					"content": "Kaveh cũng kể rằng khi anh ta làm việc ở sa mạc đã từng nghe nói phần lớn các bộ lạc sa mạc đều có những quy tắc của mình. Họ luôn nói rằng sẽ không bao giờ làm trái những quy tắc do huyết thống hay bộ lạc đặt ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380118,
					"content": "Vậy thì hay là chúng ta chủ động đưa ra phương án của mình nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380119,
					"content": "Ồ... Thì ra cũng có thể như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380120,
					"content": "Suy nghĩ của chúng ta giống nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380121,
					"content": "Tận dụng lợi thế, chủ động đưa ra điều kiện không thể từ chối, chúng ta sẽ có khả năng chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380122,
					"content": "Nghe có vẻ như đúng là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "Ừm, tôi cũng nghĩ ra cách mở lời rồi. Chúng ta có thể đi tìm Sethos, nói với anh ta rằng tôi biết một chút về y học, muốn xem tình hình của ông nội anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380113,
					"content": "Chắc chắn vẫn còn cách!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
