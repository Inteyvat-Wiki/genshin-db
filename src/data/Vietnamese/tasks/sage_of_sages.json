			"dialogs": [
				{
					"id": 130380201,
					"content": "Sethos, chúng ta nói chuyện nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380202,
					"content": "Đã nghĩ thông suốt chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380203,
					"content": "Tạm gác lại chuyện này đã. Tôi có biết một chút về y học, có thể cho tôi xem tình trạng của Bamoun không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380204,
					"content": "Không thành vấn đề. Nhưng ở đây chúng tôi cũng có bác sĩ, anh muốn giở trò gì cũng khó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380205,
					"content": "Tôi chỉ cần một câu trả lời thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380206,
					"content": "Theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380207,
					"content": "Nhỏ tiếng thôi, đừng làm ồn đến ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380208,
					"content": "Tighnari lấy một số dụng cụ mang theo bên mình ra rồi kiểm tra sơ bộ cho Bamoun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380210,
					"content": "Chúng ta ra ngoài rồi nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380211,
					"content": "Bamoun đang hôn mê sâu, tình hình không mấy lạc quan. Bác sĩ của các anh chắc cũng chẩn đoán ra kết quả tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380212,
					"content": "Lúc còn trẻ từng bị thương nặng, sau đó lại lao động nặng đến phát bệnh, từ đó sức khỏe tuổi già suy yếu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380213,
					"content": "Rất tiếc phải thông báo rằng... Tình trạng này tôi bắt gặp nhiều rồi, thông thường những người như vậy tối đa chỉ có thể kiên trì thêm vài ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380214,
					"content": "...Ừm, chúng tôi đã biết từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380215,
					"content": "Anh là người kế thừa đúng không? Có thể thấy được là anh tôn trọng ông ấy, nhưng suy nghĩ của hai người không hoàn toàn giống nhau. Anh tính toán đến nhiều phương diện và cũng thực tế hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380216,
					"content": "Ra điều kiện đi, kết thúc chuyện này khi Bamoun còn sống, tôi biết anh quan tâm tới điều này mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380217,
					"content": "Đúng vậy. Có rất nhiều việc không thể trì hoãn, chắc anh cũng hiểu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380219,
					"content": "Thật ra, hai người đang trong hoàn cảnh rất giống nhau, đều có suy nghĩ khác với người nuôi dưỡng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380220,
					"content": "Hơn nữa, rõ ràng là mâu thuẫn của một thế hệ khác, nhưng người đưa ra quyết định lại là hai người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380221,
					"content": "...Đúng vậy, lập trường của hai bên trong chuyện này đã thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380222,
					"content": "Tôi đồng ý, Cyno. Mọi thứ đều bắt nguồn từ Hermanubis, chi bằng dùng nghi thức của Hermanubis để kết thúc đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380223,
					"content": "Truyền thuyết kể rằng, khi Hermanubis mới đến Thành Tulaytullah thì đã từng so tài với người khác. Ngài ấy và hai người bạn liên tục chiến đấu để thu phục lòng người, từ đó chiêu mộ được rất nhiều người có chí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380224,
					"content": "Những người đó sau này đều trở thành một phần của Ngôi Đền Im Lặng. Đây là sự khởi đầu và cũng là nghi thức của chúng tôi - \"Nghi Thức Quyết Đấu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380225,
					"content": "Rất có ý nghĩa, dùng cách này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380226,
					"content": "Anh cũng có sức mạnh của Hermanubis, và có mối quan hệ rất mật thiết với Ngôi Đền Im Lặng. Tôi chấp thuận việc anh dẫn theo đồng đội để tham gia vào cuộc so tài này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380227,
					"content": "Ba đấu ba, nghe được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380228,
					"content": "Nhưng tôi có yêu cầu. Với tư cách là người thách đấu, anh bắt buộc phải thắng liên tiếp ba ván. Hơn nữa, Cyno, anh và tôi đều phải đặt cược Bạt Linh của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380229,
					"content": "Vì lòng thương hại mà để mặc cho Cyrus đem Bạt Linh đi, đó là lỗi lầm mà ông nội từng phạm phải, cũng là vấn đề mà Ngôi Đền Im Lặng phải vượt qua. Về điểm này thì tôi không thể nhún nhường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380230,
					"content": "Đúng ý tôi lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380231,
					"content": "Nếu tôi thắng, thì Ngôi Đền Im Lặng phải thả Cyrus, và xóa bỏ mọi chuyện trong quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380232,
					"content": "Còn nếu anh thắng, thì tôi sẽ trả lại nguồn sức mạnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380233,
					"content": "Quyết định vậy đi. Vậy thì tối mai tám giờ, chúng ta gặp nhau ở Sảnh Nghi Thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
