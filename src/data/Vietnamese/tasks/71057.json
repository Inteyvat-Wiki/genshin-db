					"nextDialogs": [
						710570130
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570130,
					"content": "#Hết cách rồi, {NICKNAME}, chúng ta tìm một ít nấm cho chú ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
