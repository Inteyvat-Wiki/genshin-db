					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570409,
					"content": "Nấm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570410,
					"content": "Môi trường bên dưới Vực Đá Sâu rất nguy hiểm đối với người bình thường, các loại nấm và thực vật sinh trưởng ở đó không chừng sẽ có hại cho con người, cho nên Huy Sơn Đình đã nghiêm cấm thợ mỏ ăn những thứ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570411
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570411,
					"content": "Nhưng mấy năm nay Chú Hà đã bị kẹt trong hầm mỏ, ăn nấm cũng chỉ là bất đắc dĩ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570412
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570412,
					"content": "Trở thành như thế này thì tôi làm sao ăn nói với người nhà chú ấy đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570413,
						710570414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570413,
					"content": "Nếu là nấm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570415
					]
				},
				{
					"id": 710570415,
					"content": "Nói vậy thì Khedive không chừng sẽ có cách gì đó, dù gì cũng là học giả Sumeru mà, nhất định có nghiên cứu về nấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570416
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570416,
					"content": "Về Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570417
					]
				},
				{
					"id": 710570417,
					"content": "Cái tên này vẫn ở doanh trại trên mặt đất, nói là phải tổng hợp một ít tài liệu nghiên cứu để đem xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570418
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570418,
					"content": "Đành phải chờ anh ta xuống rồi hỏi thăm tình hình thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570419
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570419,
					"content": "Hy vọng Chú Hà có thể hồi phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570420,
					"content": "Haiz, Chú Hà là bậc tiền bối rồi, thân thủ nhanh nhẹn, rất hay chăm sóc cho những người trẻ tuổi mới đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570421
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570421,
					"content": "Năm đó khi chú ấy mất tích... mọi người đều cảm thấy rằng Nham Vương Gia không có mắt, tại sao người tốt mà lại không có kết cục tốt chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570422
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570422,
					"content": "Nếu như chú ấy có thể hồi phục, bình an trở về, mọi người nhất định sẽ rất vui mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570423
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570423,
					"content": "#Xin cám ơn bạn nhé, {NICKNAME}, chờ Khedive xem xong tình trạng của Chú Hà, bất luận thế nào, tôi cũng sẽ đưa chú ấy trở lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570424
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570424,
					"content": "Lần này thật sự vất vả cho bạn rồi, tôi không biết phải cảm ơn bạn như thế nào nữa.",
