			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chú Hà",
					"Jinwu",
					"Paimon",
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710570301,
					"content": "Nấm... Hehehe... Ăn một bữa nấm cho no nê, nấm nhỏ, nấm lớn, nấm dại... hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570302
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570302,
					"content": "Chú Hà? Sắc mặt sao kỳ lạ như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570303
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570303,
					"content": "Haiz... Tôi biết là chú nhất định còn sống mà! Người nhà của chú còn mời tôi dự tang lễ, lúc đó tôi đã nói rồi, chưa thấy di thể thì tang lễ gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570304
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570304,
					"content": "Sắc mặt tệ như vậy, nhất định là đã chịu khổ rất nhiều ở dưới đó rồi, nhưng mà, còn sống là tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570305,
					"content": "Sống tốt lắm! Nấm sống ăn ngon lắm... hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570306
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570306,
					"content": "Chú Hà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570307
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570307,
					"content": "Khi chúng tôi phát hiện ra chú ấy thì đã như thế rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570308,
					"content": "Cứ điên điên khùng khùng... luôn miệng lảm nhảm chuyện ăn nấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570309,
					"content": "Nấm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570310
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570310,
					"content": "Môi trường bên dưới Vực Đá Sâu rất nguy hiểm đối với người bình thường, các loại nấm và thực vật sinh trưởng ở đó không chừng sẽ có hại cho con người, cho nên Huy Sơn Đình đã nghiêm cấm thợ mỏ ăn những thứ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570311
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570311,
					"content": "Nhưng mấy năm nay Chú Hà đã bị kẹt trong hầm mỏ, ăn nấm cũng chỉ là bất đắc dĩ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570312
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570312,
					"content": "Trở thành như thế này thì tôi làm sao ăn nói với người nhà chú ấy đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570313,
						710570314
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570313,
					"content": "Nếu là nấm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				},
				{
					"id": 710570315,
					"content": "Nói vậy thì Khedive không chừng sẽ có cách gì đó, dù gì cũng là học giả Sumeru mà, nhất định có nghiên cứu về nấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570316
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570316,
					"content": "Các bạn hãy ở đây đợi một lát, tôi đi gọi Khedive đến xem tình trạng của Chú Hà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570317
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570317,
					"content": "Nấm... nấm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570318
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570318,
					"content": "Haiz, không biết Chú Hà có thể hồi phục không đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570319,
					"content": "Nếu cứ như vậy suốt, thì cho dù có trở về thì người nhà cũng không vui đâu nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570320,
					"content": "Đang viết báo cáo giữa chừng thì bị kéo đến đây, Jinwu à, cho dù cô là người chịu trách nhiệm an toàn cho đội thăm dò, nhưng làm chậm trễ tiến độ nghiên cứu của tôi thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570321
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570321,
					"content": "Tôi sẽ suy nghĩ nghiêm túc về đề án cắt giảm thù lao đội của cô đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570322
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570322,
					"content": "Chuyện thù lao thì sao cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570323
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570323,
					"content": "Anh hãy mau xem tình trạng của người này đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570324
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570324,
					"content": "Ngứa lỗ tai quá... hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570325
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570325,
					"content": "Ừm? Đây là ai! Sao sắc mặt lại kỳ lạ thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570326
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570326,
					"content": "#{NICKNAME}, người này là bạn tìm về à? Sao các bạn cứ luôn gặp được những chuyện thần kỳ vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570327
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570327,
					"content": "Vậy... khi phát hiện ra ông ấy thì tình hình lúc đó thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570328
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570328,
					"content": "Kể cho Khedive về chuyện của Chú Hà...\\nKhedive kiểm tra cho Chú Hà.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570329
					]
				},
				{
					"id": 710570329,
					"content": "Cũng may cũng may, không gì nghiêm trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570330
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570330,
					"content": "Xem nè, không phải chú ấy luôn miệng nói ngứa lỗ tai sao, đó là vì bào tử của loại nấm này đã chui vào tai của chú ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570331
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570331,
					"content": "Mà loại nấm này... tuy rằng ăn trong thời gian dài quả thật sẽ khiến người ta tinh thần thất thường, nhưng đối với cơ thể người mà nói thì tổn hại không quá lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570332
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570332,
					"content": "Cũng có nghĩa là, chú ấy có thể hồi phục sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570333
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570333,
					"content": "Tôi đã xử lý sạch sẽ nấm trên người chú ấy rồi, cũng đã làm ra loại thuốc để giúp thần kinh được bình ổn trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570334
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570334,
					"content": "Chỉ cần nghỉ ngơi tịnh dưỡng, thì khả năng hồi phục cũng rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570335
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570335,
					"content": "Vậy thế này đi, tiền thuốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570336
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570336,
					"content": "Nguyên liệu làm thuốc rất rẻ, chỉ bằng tiền ăn ở Tân Nguyệt Hiên trong suốt một tháng mà thôi, không có gì nhiều đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570337
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570337,
					"content": "Chậc... tôi sẽ nghĩ cách gom tiền cho anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570338
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570338,
					"content": "Số tiền này không cần trả tôi đâu, nhờ nó mà phần báo cáo của tôi lại có thêm được một ý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570339
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570339,
					"content": "Lúc đến Vực Đá Sâu phát hiện ra loại nấm kỳ lạ, tôi đã muốn nghiên cứu xem ăn loại nấm này một thời gian dài sẽ có hậu quả gì... Nhưng tôi không tìm được trợ thủ đồng ý giúp tôi tiến hành thí nghiệm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570340,
						710570342
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570340,
					"content": "Trợ thủ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570341
					]
				},
				{
					"id": 710570341,
					"content": "Thì là người phụ trách ăn nấm đó, mọi người đều tránh né loại nấm này, tuy biết rằng không có tổn hại gì nhiều, nhưng cũng không dám tùy tiện ăn thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570344,
					"content": "Nhưng mà... môi trường ở Vực Đá Sâu khá đặc thù, nói không chừng sẽ có ảnh hưởng từ môi trường. Tóm lại, chỉ cần dùng thuốc này, sau đó nghỉ ngơi tịnh dưỡng, thì rất có khả năng sẽ bình phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570345
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570345,
					"content": "Vậy là được rồi... Lát nữa tôi sẽ đưa Chú Hà lên trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570346
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570346,
					"content": "Đợi khi nào chú ấy hồi phục rồi sẽ đưa về nhà, còn phải báo với những anh em tốt của chú ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570347
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570347,
					"content": "Chú Hà là bậc tiền bối rồi, thân thủ nhanh nhẹn, rất hay chăm sóc cho những người trẻ tuổi mới đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570348
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570348,
					"content": "Năm đó khi chú ấy mất tích... mọi người đều cảm thấy rằng Nham Vương Gia không có mắt, tại sao người tốt mà lại không có kết cục tốt chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570349
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570349,
					"content": "Bây giờ chú ấy trở về, mọi người nhất định sẽ rất vui mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570342,
					"content": "Là đối tượng thí nghiệm à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570343
					]
				},
				{
					"id": 710570343,
					"content": "Cũng có thể nói vậy, nhưng loại nấm này trước đây đã từng được phân tích, nó sẽ không gây ra tổn hại lớn cho cơ thể và tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570314,
					"content": "Ở đây có ai nghiên cứu về nấm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				}
			]
		},
