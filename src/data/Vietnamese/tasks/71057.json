			"dialogs": [
				{
					"id": 710570133,
					"content": "Có tiếng nói truyền đến từ sau lưng:\\n\"Hehehe... nấm... hehehe...\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "Các người, hehehe, sao lại xuất hiện ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570102,
					"content": "Ối ối! Sắc mặt của người này sao kỳ lạ quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570103,
					"content": "#Hơn nữa, {NICKNAME}, đến gần sau lưng người này còn phát ra âm thanh nho nhỏ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570104,
					"content": "Không phải là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570105,
					"content": "Chắc không đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "Hehehe... Sao các người... ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570107,
					"content": "Đồ ăn của các người, cũng ăn hết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570108,
					"content": "Chẳng lẽ chú là Chú Hà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "Hả... gì vậy? Người trẻ tuổi, các người nói gì vậy, nghe không rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570110,
					"content": "Tụi cháu đang hỏi! Chú là Chú Hà phải không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570111,
					"content": "À à, đúng vậy, hehehe, ta chính là Chú Hà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570112,
					"content": "Các người... không phải cũng bị nhốt dưới này giống ta chứ, ăn hết đồ ăn rồi phải không... Ây da, các người cũng xui thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570113,
					"content": "He he he, nhưng không sao, chỗ ta có đồ ăn... đói lâu lắm rồi phải không... He he he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570114,
					"content": "Nói tới cũng thấy hơi đói rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570115,
					"content": "Nấm không được ăn bậy đâu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "Đúng, đúng ha, trông ông ta tinh thần bất ổn, sắc mặt cũng... kỳ lạ, chắc không phải do ăn nấm mà ra đó chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570118,
					"content": "Nấm? Hehehe, nấm rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570119,
					"content": "Nào tới đây, ta cho các ngươi một ít nấm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570120,
					"content": "Hehehe nấm... ủa, tại sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570121,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570122,
					"content": "Nấm, đâu hết trơn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570123,
					"content": "Vậy thôi kệ nó đi, chúng ta quay về doanh trại trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570124,
					"content": "Không được, hết nấm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570125,
					"content": "Không có nấm, không có sức để đi, ta không đi đâu cả... Không có nấm... nơi này không còn gì ăn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570126,
					"content": "Có nấm rồi thì đi đâu cũng được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570127,
					"content": "Ở... ở đâu có loại nấm này?",
