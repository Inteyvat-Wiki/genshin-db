					"nextDialogs": [
						710570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570128,
					"content": "Nấm... Hehehe... Ta biết ở đâu có, chúng ta kiếm một ít về ăn, vậy là sẽ có sức làm việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "Chú Hà"
				},
				{
					"id": 710570129,
					"content": "Ở ngay gần đây...",
