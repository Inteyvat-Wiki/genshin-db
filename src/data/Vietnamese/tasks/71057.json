					"nextDialogs": [
						710570628
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570628,
					"content": "Kể cho Khedive về chuyện của Chú Hà...\\nKhedive kiểm tra cho Chú Hà.",
