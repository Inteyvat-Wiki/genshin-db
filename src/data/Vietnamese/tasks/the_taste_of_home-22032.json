			},
			"dialogs": [
				{
					"id": 220320301,
					"content": "Ôi! Tuyệt quá! Đây đúng là mùi vị của quê hương...Hu hu...thật là cảm động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320302,
					"content": "Cảm ơn nhé! Tôi lại phấn chấn trở lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320303,
					"content": "Cái này tặng bạn, chúc bạn thượng lộ bình an nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203204,
			"completionStepIds": [
				2203204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
