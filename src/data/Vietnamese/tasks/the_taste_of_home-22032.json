					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320603,
					"content": "Không ngờ lại có món như vậy, tài nghệ làm bếp của bạn quả là hiếm thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320604,
					"content": "Vất vả cho bạn rồi! Đây là thù lao của bạn, món này tôi sẽ...từ từ thưởng thức sau...",
