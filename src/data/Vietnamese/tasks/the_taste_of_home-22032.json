				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320501,
					"content": "Ấy? Đây, đây hình như là món Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320502,
					"content": "Tôi nhớ hình như món tôi muốn ăn không phải là món này. Mà thôi kệ vậy, no bụng là được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320503,
					"content": "Nói chung cảm ơn bạn nhé, đây là thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
