				},
				{
					"id": 220320602,
					"content": "Cũng không thể nói là tinh xảo...mà là...kỳ lạ, biết nói sao nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320603
