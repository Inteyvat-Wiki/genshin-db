			"dialogs": [
				{
					"id": 220320201,
					"content": "Về nhanh vậy sao? Bạn không phải là đầu bếp ẩn danh đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320202,
					"content": "...Nhanh nhanh nào, để tôi nếm thử món ăn của bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320203,
					"content": "Mời thưởng thức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "Để xem nào...ban nãy nói đến món gì nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Ừm...là món Cá Đuôi Sóc, Cá Chép Đen Hấp, còn món Cá Nướng Mondstadt nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320206,
					"content": "Quyết định xong thì giao cho Tang Wen nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
