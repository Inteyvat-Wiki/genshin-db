			"dialogs": [
				{
					"id": 741570301,
					"content": "Nhà đang chờ bán, giá cả phải chăng, mua ngay kẻo trễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "Thông Tin Bán Nhà"
				},
				{
					"id": 741570302,
					"content": "#...{M#Anh}{F#Chị} {NICKNAME}, chị Paimon, {M#anh chị}{F#hai chị} đến tìm ông Leroy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570303,
					"content": "Ông Benoit có trong nhà không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "Không có. Cha nói là ông Leroy sẽ không sống ở đây nữa, ông ấy xuống dưới đất ở rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570308,
					"content": "Fleuve Cendre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "Là Fleuve Cendre mà chúng ta từng đến trước đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "Chắc là không phải, cha nói là ở bên dưới mặt đất cơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570311,
					"content": "Trên tờ báo Chim Hơi Nước viết rằng lúc ông Leroy leo núi đã ngã xuống từ nơi rất cao, ngã rất mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570312,
					"content": "Thực ra em cũng không hiểu lắm giữa ngã và dọn nhà có liên quan gì với nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570313,
					"content": "À, lúc em mới tới còn thấy ông anh con rể, còn có dì kia cũng rất tốt bụng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570314,
					"content": "Dì ấy rất quý em, mắt dì ấy cũng có màu tím giống em nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570315,
					"content": "Dì ấy còn hỏi nhà em ở đâu, bảo là khi rảnh sẽ tới gặp em, còn muốn làm bạn tốt của em nữa. Cả nhà ông Leroy quả nhiên đều là người tốt cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570316,
					"content": "Haiz, vốn dĩ em có mang Trái Bulle tới định tặng cho ông Leroy, nhưng giờ ông ấy không ở đây rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570317,
					"content": "#Em tặng cho {M#anh chị}{F#hai chị} nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570318,
					"content": "Cảm ơn em nhé, Molli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "Đừng khách sáo... Cha mẹ từng nói là phải hào phóng với bạn bè mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570320,
					"content": "Hôm nay em lại làm được một việc tốt rồi! Lúc về em sẽ viết vào trong nhật ký, vui ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570321,
					"content": "Bạn đưa mắt nhìn Molli hạnh phúc bước ra khỏi con phố. Câu chuyện về nhà Leroy đã kết thúc như thế.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "Chỉ là tình cờ đi ngang qua thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "#Vừa rồi em còn đang nghĩ, có nên nói cho {M#anh chị}{F#hai chị} biết chuyện ông Leroy đã dọn nhà rồi không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570307,
					"content": "Cha nói ông Leroy sẽ không ở đây nữa, mà xuống dưới đất ở rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				}
			]
		},
