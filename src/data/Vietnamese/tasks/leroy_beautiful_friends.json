			"dialogs": [
				{
					"id": 741570201,
					"content": "Nhà đang chờ bán, giá cả phải chăng, mua ngay kẻo trễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "Thông Tin Bán Nhà"
				},
				{
					"id": 741570202,
					"content": "#{M#Anh}{F#Chị} {NICKNAME}, chị Paimon, ông Leroy hình như không còn ở đây nữa rồi. {M#Anh chị}{F#Hai chị} có gặp được ông ấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570203,
					"content": "(Này, chúng ta có cần phải nói thật không?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570204,
					"content": "#{M#Anh chị}{F#Hai chị} có gặp ông ấy rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "#Hóa ra {M#anh chị}{F#hai chị} đã gặp rồi! Vậy {M#anh chị}{F#hai chị} đã nói cho ông ấy nghe là bánh của ông ấy rất ngon giùm em chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570206,
					"content": "Nói rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#Em biết là {M#anh chị}{F#hai chị} sẽ giữ lời hứa mà. Em có mang theo Trái Bulle đây, em mời {M#anh chị}{F#hai chị} dùng ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570214,
					"content": "Molli thở dài, vẫy tay tạm biệt và định rời đi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "Bỗng cánh cửa mở ra, Autumn và Athos từ trong nhà đi ra.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "Quả nhiên giọng nói bên ngoài là của các người. Còn có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570217,
					"content": "Chỉ là tình cờ đi ngang qua thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "Thật sao? Thế giới này nhỏ thật. Vừa hay tôi và Autumn cũng đang định rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570219,
					"content": "Benoit đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "À, ông ta đã dọn đến nơi khác rồi. Chỗ đó tầm mấy mươi năm sau chúng tôi mới đến. Các người trong thời gian ngắn chắc cũng không gặp được ông ta đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570221,
					"content": "Nhưng cũng không thể nói trước. Giữa ngày mai và điều bất trắc thì cái nào sẽ tới trước? Ai mà biết được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570225,
					"content": "Đây chẳng phải là cô nhóc luôn đến tìm Benoit sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570227,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570228,
					"content": "Trông giống quá, còn có cặp mắt màu tím nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570229,
					"content": "Dì có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570230,
					"content": "Cháu mấy tuổi rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570231,
					"content": "Cháu chín tuổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570232,
					"content": "Cha mẹ cháu tên gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570233,
					"content": "Ối... Dì làm sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570234,
					"content": "Sao thế... Đứa bé này làm sao? Chắc sẽ không trùng hợp như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570235,
					"content": "Nói cho dì biết là có phải cháu được nhận nuôi không đi? Mau lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570236,
					"content": "#{M#Anh}{F#Chị} {NICKNAME} có biết dì này không? Dì ấy muốn làm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570237,
					"content": "Ai lại hỏi như thế chứ? Để tôi cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570238,
					"content": "Cô bé à, anh nhớ là em rất thân với cha của anh, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570239,
					"content": "Đúng vậy. Ông Leroy đối xử với em rất tốt. Ông ấy không còn sống ở đây nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570240,
					"content": "Đúng thế. Ông ấy đã tới một nơi rất xa, sau này cũng sẽ không quay về đây ở nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570241,
					"content": "Thường ngày cha anh hay trò chuyện điều gì vậy? Có thể nói cho anh biết không, để sau này anh có thể nói với cha là em rất nhớ ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570242,
					"content": "Ông Leroy mời em ăn bánh ngọt, cho em vuốt ve Nana, còn khen mắt em đẹp nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570243,
					"content": "Còn gì nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570244,
					"content": "Ông ấy hay bảo em thay ông ấy chào hỏi cha mẹ, mặc dù cha mẹ rất không thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570245,
					"content": "Lần nào cha cũng rất tức giận, nói ông Leroy là người xấu và \"tống tiền\" họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570246,
					"content": "Mặc dù cha mẹ không cho phép em tới, nhưng em và ông Leroy đã hẹn nhau rồi, em vẫn sẽ lén tới đây. Anh đừng nói cho cha em biết nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570247,
					"content": "Ông ta chính là kẻ như thế, không vắt kiệt đến đồng cuối cùng thì sẽ không dừng tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570248,
					"content": "Khốn nạn... À xin lỗi, vừa rồi bọn anh đang nói chuyện khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570249,
					"content": "Còn có chuyện gì khác không ạ? Nếu không có thì em về nhà đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570250,
					"content": "...Cha mẹ có yêu quý cháu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570251,
					"content": "Họ là cha và mẹ tốt nhất trên đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570252,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570253,
					"content": "Vậy thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570254,
					"content": "Em phải về nhà rồi, tạm biệt mọi người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570255,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570256,
					"content": "Chỉ thế là được rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "Tôi đã từng suy nghĩ đến chuyện này nhiều lần... Không có gì tốt hơn việc biết con bé được sống hạnh phúc cả. Như vậy là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570259,
					"content": "Tôi... Không giống cha tôi. Tôi không có ý định gây phiền toái cho gia đình hiện giờ của con bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570260,
					"content": "Không phải tôi cố ý làm cô mất hứng đâu, nhưng chẳng phải cô có mua cho con bé một hộp nhạc à? Không định tặng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570261,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570262,
					"content": "Không cần nữa. Con bé... trông có vẻ như không thiếu những thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570263,
					"content": "Về sau tôi sẽ thường xuyên nghĩ cách đến gặp con bé, nó cần gì thì tôi cũng sẽ nghĩ cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570264,
					"content": "...Hộp nhạc này tôi tặng người khác vậy, dù sao thì cũng đã mất công chọn lâu như vậy rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570265,
					"content": "Cô bé tóc trắng, cô có thích quà không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570266,
					"content": "Tôi? Cô muốn tặng cho tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570267,
					"content": "Đúng đó, cứ để nó phát huy chút giá trị cuối cùng của nó vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570268,
					"content": "Athos, thật sự xin lỗi, e là chúng ta còn phải ở lại Đại Sảnh Fontaine thêm một thời gian nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570269,
					"content": "Không sao, với tôi thì đi đâu cũng giống nhau cả thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570270,
					"content": "Các bạn đưa mắt nhìn hai người họ bước ra khỏi con phố. Câu chuyện về nhà Leroy đã kết thúc như thế.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "Cô không định cho con bé biết sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "Benoit sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "Thế giới này tràn đầy bất công, bần cùng và tham lam. Sự trừng phạt của luật pháp Fontaine không thể thi hành thì hãy để chúng tôi thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570224,
					"content": "Ý tôi là, ông ta đã đi đến nơi ông ta cần đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570208,
					"content": "Quên rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "#Thế ạ? Vậy thì tiếc quá, xem ra em đã không còn cơ hội để nói cho ông Leroy biết rồi. Thế thì Trái Bulle mà em mang theo... tặng cho {M#anh chị}{F#hai chị} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570210,
					"content": "#{M#Anh chị}{F#Hai chị} chưa gặp ông ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "Đáng tiếc thật. Chắc là em đã không còn cơ hội để gặp ông Leroy nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570212,
					"content": "#Em có mang theo Trái Bulle cho ông ấy, bây giờ ông ấy không ở đây nữa thì em tặng cho {M#anh chị}{F#hai chị} vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570213,
					"content": "Dù sao thì em vẫn sẽ luôn nhớ đến ông Leroy. Tạm biệt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				}
			]
		},
