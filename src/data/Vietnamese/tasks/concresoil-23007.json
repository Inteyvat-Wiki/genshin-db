			},
			"dialogs": [
				{
					"id": 230070101,
					"content": "Có nguyên liệu nào tốt hơn không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070102,
					"content": "Nguyên liệu gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "Xin lỗi, tôi đang lẩm bẩm thôi. Dạo này thời tiết rất khó đoán, tình trạng phòng ốc xảy ra sự cố rất nhiều, tôi bận muốn ngất luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070104,
					"content": "Chẳng phải anh làm đồ gốm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "Đúng vậy, nhưng tôi cũng là thợ xây, toàn làm việc với đất đá, mà cũng không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070106,
					"content": "Bạn đã từng nghe câu này chưa? \"Học hành cũng giống như xây nhà, muốn nhà cao cửa rộng thì phải đặt nền móng thật tốt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070107,
					"content": "\"Nếu bạn muốn mở rộng lý luận học thuật, bạn phải củng cố nền tảng. Nếu như nền tảng không vững chắc thì mặt đất sẽ rung chuyển...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070108,
					"content": "Người thông minh hay nói mấy câu này, tuy tôi không hiểu lắm, nhưng bạn thấy đấy, họ cho rằng xây nhà cũng quan trọng như việc học.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070109,
					"content": "Đây chẳng qua là phép so sánh thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "Bất kể nói thế nào, khi nói tới nền móng nhà cửa thì người ta thường nghĩ ngay tới vật liệu xây dựng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070112,
					"content": "Bùn đất làm chất kết dính, nâng đỡ, nếu có thể tăng cường sức bền và khả năng thích ứng thì nhà sẽ vững chắc hơn, tôi cũng không phải bận rộn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070110,
					"content": "Đáng lẽ không phải giải thích như thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
