			"dialogs": [
				{
					"id": 230070201,
					"content": "Hiện tại tôi có vài ý tưởng, hôm nay... tôi muốn tìm Đất Thấm Dịch Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070202,
					"content": "Tôi đã nhờ người hỏi thăm về nơi tập trung của Slime rồi, Nhà Lữ Hành, bạn có thể giúp tôi lấy chút bùn đất về không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070203,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "Vậy nhờ bạn rồi, không đánh bại chúng cũng không sao, chỉ cần lấy chút bùn đất gần nơi chúng tụ tập là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070205,
					"content": "Tôi đã đánh dấu vị trí của địa điểm tập kết Slime trên bản đồ cho bạn rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070206,
					"content": "Anh không đi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "Tôi cũng muốn đi lắm, nhưng tôi còn phải giải quyết vấn đề vật dụng gia đình nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070208,
					"content": "Yên tâm đi, tôi sẽ chuẩn bị thù lao xứng đáng cho bạn, vậy chuyện này giao cho bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070209,
					"content": "Bạn cứ đến đó tìm chút bùn đất về, tôi đã đánh dấu vị trí trên bản đồ cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070210
