			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Frejus",
					"Chenee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "Từ số liệu cho thấy, phát minh lần này đã thành công mỹ mãn. Cảm ơn sự giúp đỡ của hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120102,
					"content": "Cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120103,
					"content": "Nhìn xem, tôi đã nói là sẽ suôn sẻ mà. Dù sao tiền bối Frejus cũng là thiên tài trong lĩnh vực này, bệ pháo điều khiển từ xa này chắc chắn là chuyện nhỏ thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120104,
					"content": "Đúng, đúng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120105,
					"content": "Vậy thì tranh thủ thời gian để thực hiện phát minh tiếp theo nhé! Đúng lúc tôi có một thứ rất thú vị đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120106,
					"content": "Là cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120107,
					"content": "Phi thuyền có thể khám phá bầu trời, được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120108,
					"content": "À ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120109,
					"content": "Hay là máy khoan siêu cấp có thể đào sâu vào lòng đất?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120110,
					"content": "Hah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120111,
					"content": "Có vẻ như cô ấy đang làm khó Frejus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120112,
					"content": "Chắc khó có thể làm được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "Tiền bối Frejus, người đã ba lần từ chối Viện Khoa Học Fontaine, chắc chắn có thể làm được những thứ mà Viện Khoa Học không thể làm được, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120114,
					"content": "Tất nhiên rồi. Có lẽ những thứ này hơi... khó một chút, nhưng vấn đề không lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120115,
					"content": "Haiz, nhưng đột nhiên tôi không muốn những thứ này nữa. Bay lên trời hay khoan xuống đất thì chán lắm. Trên trời thì lạnh lẽo, dưới lòng đất thì ngột ngạt, chẳng có gì thú vị cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120116,
					"content": "Ừm, tôi cũng thấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120117,
					"content": "Vậy tiền bối Frejus có thể tạo ra một phát minh có thể ứng dụng trong cuộc sống hằng ngày không? À, tôi thích ngủ nướng vào buổi sáng, nên có thể nhờ tiền bối giúp tôi làm một cái máy nướng bánh tự động cho bữa sáng được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120118,
					"content": "Cái này nghe có vẻ khả thi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120119,
					"content": "Vậy những ý tưởng trước đó là do cô ấy cố tình nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "Được rồi, để tôi nghĩ xem nên thiết kế như thế nào đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120121,
					"content": "Được! Vậy xem như đã hứa rồi nhé. Nếu không làm được thì sau này bữa sáng của tôi sẽ do chính tay tiền bối Frejus chuẩn bị cho đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120122,
					"content": "Hả? Sao lại... Tóm lại thì cứ yên tâm đi, mấy cái phát minh nhỏ này tôi chắc chắn làm được. Tôi là \"thiên tài\" trong lĩnh vực này mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				}
			]
		},
