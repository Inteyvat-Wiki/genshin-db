			"dialogs": [
				{
					"id": 200370301,
					"content": "Chào bạn... a, âm thanh này, là Nhà Lữ Hành lúc trước phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370302,
					"content": "Cho hỏi bạn tìm tôi có việc gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370303,
					"content": "Có người nhờ tôi đem cho bạn một bức thư.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "Thư? Ai viết thư cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370305,
					"content": "Không lẽ là Godwin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370306,
					"content": "Bạn gặp anh ấy rồi sao? Anh ấy vẫn khỏe chứ, anh ấy nói khi nào sẽ về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370307,
					"content": "Xin lỗi, anh ấy chắc là rất bận, bạn hãy quên những gì tôi nói lúc nãy đi, đừng để anh ấy thêm áp lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370308,
					"content": "Có thể nhờ bạn đọc giúp thư của anh ấy cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370309,
					"content": "Hãy nhỏ tiếng chút, đủ để hai chúng ta nghe thấy là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370310,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "Bạn đọc hay thật... chẳng lẽ, bạn thường đọc thư cho người khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370312,
					"content": "Thư viết đến đây thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "Cảng Liyue... Godwin quả thật đã đi đến nơi rất xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370314,
					"content": "Cám ơn bạn, tôi sẽ cất giữ bức thư này, khi gặp lại <color=#00E1FFFF>Godwin</color>, hãy nhớ hỏi thăm anh ấy giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "Glory"
				}
			]
		},
