			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "...Haiz, thật muốn về thẳng Mondstadt cho xong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370102,
					"content": "Hey, Nhà Lữ Hành, bạn có thể giúp tôi một việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370103,
					"content": "Giống như bạn nói, tôi là một kỵ sĩ Tây Phong, đang làm nhiệm vụ tuần tra bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370104,
					"content": "Tôi đã nói với bạn gái tôi, cứ một thời gian sẽ gửi cho cô ấy một bức thư báo bình an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370105,
					"content": "Kết quả là tôi bận nên quên mất, hahaha... bạn hãy giúp tôi đem bức <color=#00E1FFFF>thư</color> này giao cho cô ấy đi, cô ấy tên <color=#00E1FFFF>Glory</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370106,
					"content": "Đợi chút, Glory?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "Cái cô mù mắt... thu thập bồ công anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370108,
					"content": "Này! Godwin mà cô Glory nói đến, hóa ra là bạn à?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370109,
					"content": "Hở, tại sao các bạn lại biết Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370110,
					"content": "Chúng tôi từng giúp cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "Cô ấy, cô ấy tìm các bạn giúp đỡ? Là làm việc gì nguy hiểm sao? Các bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370112,
					"content": "Cô Glory chỉ là nhờ chúng tôi thu thập giúp bồ công anh. Nói là nếu rải nó trên bầu trời, có thể đưa tâm nguyện đến chỗ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370113,
					"content": "A, bồ công anh... quả thực giống với việc mà Glory làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370114,
					"content": "Bạn không phải rời khỏi Mondstadt rất lâu rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Vốn dĩ là như vậy. Thôi bỏ đi... để tôi nói vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370116,
					"content": "Bạn có nghe nói việc đại đội trưởng đem bốn phần năm đội Kỵ Sĩ rời khỏi Mondstadt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370117,
					"content": "Đúng vậy, tôi cũng là một trong những thành viên đội Kỵ Sĩ viễn chinh... nhưng trước khi xuất chinh, vì tôi làm mất tín vật của Glory, muốn đi tìm lại, nên đã lạc mất đội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370118,
					"content": "Tới giờ vẫn không biết cách quay lại đội, chỉ có thể đi lang thang gần đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370119,
					"content": "Cũng không mặt mũi nào về Mondstadt, nếu cứ như vầy mà quay lại, những kỵ sĩ Tây Phong sẽ nhìn tôi như thế nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370120,
					"content": "Còn cả Glory, tôi hứa với cô ấy, sẽ gửi thư và quà cho cô ấy từ khắp nơi trên thế giới, đem \"cả thế giới\" đến cho cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370121,
					"content": "Nếu cô ấy biết tôi còn chưa ra khỏi Mondstadt... thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370122,
					"content": "Hóa ra là vấn đề sĩ diện à",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370123,
					"content": "Năn nỉ đó, bạn có thể đem <color=#00E1FFFF>bức thư</color> đưa đến cho <color=#00E1FFFF>Glory</color> không? Nói không chừng, cô ấy vẫn đang lo lắng cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370124,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "Vậy thì phiền bạn rồi, Nhà Lữ Hành, phải giữ bí mật giúp tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370126,
					"content": "Hay là bạn dùng bồ công anh đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "Chuyện tôi muốn nói với Glory quá nhiều, bồ công anh làm sao chở hết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370128,
					"content": "Thư thì phiền bạn đem đến giúp, nhớ giúp tôi giữ bí mật nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
