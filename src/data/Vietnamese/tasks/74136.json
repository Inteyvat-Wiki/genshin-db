			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin... Biết ngay là ngươi đã dẫn họ tới... Ngươi lo thành quả nghiên cứu của ta sẽ vượt qua ngươi sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "Đúng đấy! Tôi đố kỵ với dáng vẻ ngu ngốc mà lại không biết tự nhìn nhận này. Bảo sao trước đây lại sống tốt trong Viện Khoa Học đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Nếu Choiseul trông thấy cảnh tượng này, chắc chắn sẽ bất tỉnh mất nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "Tốt nhất là anh ta đừng tỉnh lại nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "Dẫn họ về Viện Khoa Học nhận tội đi, tôi muốn tiếp tục nghiên cứu... Các người không làm hỏng thiết bị nghiên cứu của tôi đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "Ai cho anh nghiên cứu tiếp chứ?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "Các người muốn làm gì? Chẳng lẽ muốn bắt cả tôi về Viện Khoa Học sao? Thế thì sao tôi có thể nghiên cứu tiếp được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "Tên Raimondo kia chắc chắn đã biến Viện Khoa Học thành một mớ bòng bong, còn có tên Choiseul ngu ngốc kia nữa... Chậc! Chỉ nghĩ thôi cũng nhức đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "Người biến Viện Khoa Học thành mớ bòng bong chính là anh đấy! Đừng có chối bỏ trách nhiệm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "Tôi? Được rồi, Viện Khoa Học đã đổ hết trách nhiệm của vụ nổ Phòng Thí Nghiệm Trung Tâm lên đầu tôi rồi đúng không? Lúc đó tôi còn không có mặt ở Viện Khoa Học nữa là!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "Đám đần trong Viện Khoa Học quá nhiều, đến rót cốc cà phê cũng có thể khiến thiết bị nghiên cứu chết máy, nên gây ra vụ nổ đó cũng chẳng có gì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "Thế sao anh không giải thích rõ ràng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "Giải thích? Còn lâu tôi mới làm người chịu tội thay cho bọn họ. Tôi còn có rất nhiều mục nghiên cứu cần làm, không có thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "Nên anh hợp tác với cái người tên Concini kia à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Ừm, Concini cũng chẳng tốt đẹp gì... Đến một thiết bị chính xác cũng không mua được, tất cả đều cần tôi tự tay làm. Cũng may vẫn chịu bỏ tiền ra để nghiên cứu của tôi thuận lợi hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "Nhưng không ngờ tên Nacker này lại ôm phiên bản chưa hoàn thiện kia tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "Ta đã cải tiến nó! Công nghệ mà ta sử dụng chắc chắn ngươi sẽ không thể nghiên cứu và phát triển ra được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Haha. Nacker, bây giờ không có Concini để nịnh nọt đâu, đừng tự gạt mình nữa. Ngay cả một chút tự trọng của nhà nghiên cứu cũng không có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "Ta...! Những tính năng chưa hoàn chỉnh kia chỉ là do ngươi không biết hoàn thiện thôi! Ta biết ta có thể làm được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Được rồi, vậy thì mang theo cái thứ rác rưởi này về Viện Khoa Học kiếm ăn tiếp đi, tôi có chuyện quan trọng hơn cần làm. Cái cô Fusi gì đó ơi, chuyện này giao cho cô đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "Tại sao hai người này cứ cãi nhau hoài vậy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "...Đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "Có thể đừng lãng phí thời gian của tôi được không? Tôi còn phải tiếp tục làm việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "Tôi nói là... đủ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "Edwin Eastinghouse! Anh... chính là thủ phạm làm nổ Viện Khoa Học!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "Nacker! Ngươi... đã trộm tài sản của Viện Khoa Học!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "Còn khiến Viện Khoa Học nổ thêm một lần nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "Các người đã làm tổn hại đến lợi ích của Viện Khoa Học Fontaine... Với tư cách là điều tra viên, tôi sẽ đưa tất cả các người về Viện Khoa Học để xét xử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Đáng ghét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Chậc, đừng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Tôi và Lemarcq sẽ hỗ trợ áp giải. Làm việc lâu như vậy... Viện Khoa Học cũng nên cho chúng tôi chút thù lao chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "Nhớ phải im miệng trong lúc áp giải nhé. Nếu không thì các người sẽ được đến đích sớm hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "Anh đứng lại cho tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "Tôi cũng sắp bất tỉnh rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
