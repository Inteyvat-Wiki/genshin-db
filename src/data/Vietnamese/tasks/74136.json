				},
				{
					"id": 741360402,
					"content": "Rõ ràng cứ nói thẳng cho chúng ta biết là được, sao phải như vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360403,
					"content": "Hmm, ai biết chứ... Có vẻ như anh ta muốn giúp chúng ta tìm Nacker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360404,
					"content": "Những bộ đồ lặn đó cứ như chuẩn bị sẵn cho chúng ta vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360405,
					"content": "Xem ra anh ta đã để ý chúng ta trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "Không có giá trị nghiên cứu... Tôi... tôi bỏ bao nhiêu công sức như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360408,
					"content": "Fusilier... đã lẩm bẩm như vậy suốt quãng đường rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360409,
					"content": "#Có điều... {NICKNAME} có cảm giác mình bị người ta theo dõi không? Tôi, tôi cảm thấy sau lưng mình hơi rờn rợn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360410,
					"content": "...Tôi sẽ đi tiên phong để tiếp tục tìm kiếm.",
					"roleType": "TALK_ROLE_NPC",
