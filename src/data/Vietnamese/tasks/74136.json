			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "Tại sao lại quay trở về? Biết ngay là mấy người tìm năm vòng cũng tìm không ra mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "Nếu không được thì ngồi xuống đây uống ly trà đi. Đúng lúc tôi mới mua năm ly trà mới... cùng mấy cái chén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363403,
					"content": "Anh thích con số năm thật nhỉ, Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741363404,
					"content": "À, đây là con số thần kỳ đấy. Chỉ cần dùng nó đúng cách thì sẽ mở ra được cánh cửa cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363405,
					"content": "Tiện đang nhắc tới thì cánh cửa cảm hứng có năm cái. Phải vặn tay nắm ít nhất năm lần... Năm đấy! Hiểu không? Năm lần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363406,
					"content": "Xin lỗi, bây giờ tôi chỉ muốn đấm anh năm cái để anh im lặng, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lemarcq"
				}
			]
		}
	]
