						741360603
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360603,
					"content": "Mất công tôi đã nhận lấy vụ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360604,
					"content": "Tóm lại, tôi tiên phong mở đường trước, còn mọi người đi chung với nhau nhé. Nếu tình hình chuyển biến tệ thì hãy dẫn quý cô Viện Khoa Học này đi trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360605,
					"content": "Nhưng ở đây chẳng có gì cả, tình hình có xấu nữa chắc cũng không xấu hơn đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360606,
					"content": "Bíp bíp... Lạch cạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
