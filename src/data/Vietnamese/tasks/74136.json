			"dialogs": [
				{
					"id": 741360901,
					"content": "Tay sai của Viện Khoa Học! Choiseul và Raimondo đã cho các người bao nhiêu tiền!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Chỉ cho mỗi một danh hiệu thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "Hãy nghe tôi nói đã... Thả tôi ra, \"Máy Tạo Trường Lực\" của tôi sắp hoàn thành rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Chỉ cần tôi có thể kết nối nó với Lõi Động Năng Arkhium, vậy thì... tôi sẽ là Kỹ Sư Động Năng vĩ đại nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "...Trộm thành quả của người khác mà còn muốn trở thành kỹ sư vĩ đại nhất sao? Đúng là vô liêm sỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Tôi đã hiểu tại sao lúc trước... Edwin một mực không muốn cho anh tham gia nghiên cứu lõi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "Edwin căn bản không hiểu tác dụng của thứ này! Cô cũng là người của Viện Khoa Học... phải biết giá trị của nó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Giúp tôi đi, chúng ta có thể... cùng nghiên cứu! Sau đó sẽ không ai có thể sánh ngang với chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Edwin, Raimondo, Choiseul gì chứ... Không ai có thể đè đầu cưỡi cổ chúng ta nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Xem ra lời Raimondo nói là thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Thành quả của... Edwin thuộc về Viện Khoa Học. Tôi chỉ đến để thu hồi, những chuyện còn lại... Tôi không có hứng thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Fusilier... đột nhiên thay đổi xưng hô về Edwin luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "Đừng làm chuyện ngu ngốc! Cô không biết ngài Concini có thể cho chúng ta bao nhiêu lợi ích đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "Những lợi ích này dù chạy vặt cho Edwin mười ngàn năm cũng không kiếm được! Edwin và Viện Khoa Học chỉ muốn lợi dụng chúng ta... Chúng ta phải suy tính cho mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "Được rồi, im miệng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "Ngươi là ai!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "Bảo kê của Cảng Lumidouce, còn nói thêm nữa là ăn đấm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, giúp tôi trói hắn ta lại. Chúng ta cũng nên mang thứ này về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "Lúc trước chắc anh nhẫn nhịn khổ lắm nhỉ, Nacker?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "Tôi lao động công ích mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
