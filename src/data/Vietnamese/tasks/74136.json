			"dialogs": [
				{
					"id": 741360401,
					"content": "Trước đây anh ta cứ lặp đi lặp lại số \"năm\", hóa ra là nói cho chúng ta biết cách để giải đố...",
					"roleType": "TALK_ROLE_NPC",
