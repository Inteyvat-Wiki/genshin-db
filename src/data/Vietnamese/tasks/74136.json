					"id": 741361102,
					"content": "Hả, ối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "Woa! Choiseul sắp ngất thật rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "Không ngờ anh lại quay về Viện Khoa Học đấy, Choiseul. Tôi cứ tưởng cả đời anh chỉ giao tiếp với con dấu thôi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "Không... Không thể nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimondo, cảm giác tiếp quản công việc của tôi thế nào? Có việc gì đáng báo cáo cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "...Đúng là một cuộc hội ngộ tuyệt vời đấy, ngài Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361108,
					"content": "Haha! Nhìn xung quanh, có vẻ như anh rất hợp với công việc quét dọn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "...Hừ. Cũng có quét dọn sạch sẽ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Là do chưa quét anh ra ngoài đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Vô cùng cảm ơn Nhà Nghiên Cứu Danh Dự Cấp Cao {NICKNAME} và Fusilier đã đưa hai người này về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361112,
					"content": "Đống hỗn loạn của Viện Khoa Học Fontaine sẽ hoàn toàn chấm dứt từ hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361113,
					"content": "Hahaha, được. Viện Khoa Học Fontaine sẽ rơi vào sự im lặng chết chóc, từ nay sẽ không còn cảm hứng gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "Anh đã khiến tất cả nguồn cảm hứng ở Viện Khoa Học Fontaine nhảy nhót rất đặc sắc rồi, đã đến lúc để mọi thứ lắng xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361115,
					"content": "Raimondo Havenport, anh hoàn toàn không hiểu gì về nghiên cứu, không lãnh đạo được Viện Khoa Học Công Trình Động Năng Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "Nhưng tôi hiểu và có thể khiến nó vận hành bình thường đấy, anh Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361117,
					"content": "Điều anh cần làm bây giờ là tránh xa nghiên cứu và Arkhium một chút, như vậy sẽ tốt hơn với tất cả mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361118,
					"content": "Một lúc sau, người của Sảnh Chấp Pháp đã đến đưa Nacker và Edwin đi. Cuối cùng họ cũng rời khỏi Viện Khoa Học Fontaine hoàn toàn rồi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Cuối cùng tôi cũng tỉnh khỏi cơn ác mộng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Ngài Chaussivert và ngài Lemarcq phải không? Tôi đã nghe nói về sự giúp đỡ của các vị rồi. Tôi đã chuẩn bị sẵn thù lao, mời các vị nghỉ ngơi tạm ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Hahaha, tôi thật sự không ngờ rằng người như tôi cũng thiết lập được mối quan hệ với Viện Khoa Học đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "Đừng nói thế! Anh chân thành và nhiệt tình, chắc chắn là người tốt! Biết đâu sau này chúng tôi còn mời anh đến hỗ trợ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "Hơn nữa... Nhà Nghiên Cứu Danh Dự Cấp Cao lại giúp Viện Khoa Học chúng tôi một chuyện lớn rồi. Chúng tôi không biết nên cảm ơn thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Đừng có thêm vụ nổ nào nữa là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "Ấy, nhắc mới nhớ... Fusilier đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "...Để cô ấy một mình bình tĩnh lại đã. Xem ra hình ảnh Edwin Eastinghouse trong mắt cô ấy đã tan vỡ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361130,
					"content": "Edwin và Nacker cũng cần bình tĩnh lại... Hy vọng họ sớm nhận thức rõ về bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361131,
					"content": "Họ sẽ ở trong Pháo Đài Meropide cả đời à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Bàn về tính nguy hiểm thì tôi hy vọng họ sẽ mãi mãi không rời khỏi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361133,
					"content": "Nhưng xét về tình hình hiện tại của Viện Khoa Học Fontaine... Tôi hy vọng sẽ không gặp phải chuyện bắt buộc cần đến họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361134,
					"content": "Một lần nữa, tôi thay mặt Viện Khoa Học Fontaine cảm ơn Nhà Nghiên Cứu Danh Dự Cấp Cao. Nếu có chuyện gì muốn hỏi thì tôi sẽ sẵn lòng trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361125,
					"content": "Có thể nâng cấp danh hiệu cho tôi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Về mặt lý thuyết... thì danh hiệu này đã là cao nhất rồi... Nhưng tôi có thể thử đăng ký một danh hiệu đặc biệt khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "Chẳng hạn như... Nhà Nghiên Cứu Danh Dự Siêu Cấp? Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Choiseul"
				}
			]
		},
