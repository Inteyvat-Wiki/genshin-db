				{
					"id": 706720217,
					"content": "Nhưng sau khi nhận thư thì phải vượt ngàn dặm xa xôi để đến đây, khá là vất vả. Nên có người nhờ tôi đến đây, dùng thuật pháp để làm ra một căn phòng giống như Thế Giới Trong Ấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720218
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720218,
					"content": "Những người nhận được thư mời và muốn đến đây sẽ có thể xuất hiện ở căn phòng đó trong tích tắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720219
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720219,
					"content": "#Như vậy thì {NICKNAME} sẽ có thể dùng căn phòng này để mời người ta giao đấu, tránh được nhiều rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720220
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720220,
					"content": "Woa, như vậy thì quá tiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720221,
					"content": "Nhưng mà đây là quán rượu của tiểu thư Margaret, Tubby dùng tiên thuật như vậy thì Margaret có giận không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720222,
					"content": "Ừm... không sao, dù sao thì căn phòng này cũng không nằm trong Quán Rượu Đuôi Mèo. Hơn nữa, trước đó tôi cũng đã được chủ quán cho phép rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720223
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720223,
					"content": "\"Úi, phép thuật Liyue lợi hại vậy sao, có thể mở rộng diện tích quán rượu lên gấp đôi không?\" Chủ quán rượu nói như vậy đó... tiếc là phép thuật của tôi chưa đạt đến mức đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720224
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720224,
					"content": "Cũng khá giống cách nói chuyện của tiểu thư Margaret nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720225,
					"content": "Hai vị ở đây thật tốt quá, tôi đang băn khoăn không biết sau khi sắp xếp xong sẽ thông báo cho hai vị như thế nào đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720226
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720226,
					"content": "Vậy bây giờ bắt đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720227
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720227,
					"content": "Xong, như vậy là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720228
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720228,
					"content": "Woa, như vậy là được rồi sao? Phép thuật của Liyue thật thần kỳ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720229,
					"content": "Ừm... Cảm thấy hai vị có duyên với tôi, nói không chừng sau này vẫn còn cơ hội gặp lại đó. Nhưng chuyện sau này thì cứ để sau này hẵng nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720230
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720230,
					"content": "#Vậy thì bây giờ, {NICKNAME} đã có thể dùng căn phòng này để mời bạn bè khắp nơi đến quyết đấu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720231
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720231,
					"content": "À... Suýt nữa thì quên, là đứa nhỏ trong quán rượu nhờ tôi nói với bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720232
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720232,
					"content": "#{NICKNAME}, hy vọng bạn sẽ cảm nhận được sự thú vị của Thất Thánh Triệu Hồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720212,
					"content": "Không phải là đến để chơi bài đó chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720213
					]
				},
				{
					"id": 706720213,
					"content": "Không đúng nhưng cũng không hẳn là sai. Tôi không đến để chơi bài, nhưng chuyện được nhờ thì đúng là có liên quan đến bài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720233
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720233,
					"content": "Tubby thi triển tiên thuật để cải tạo quán rượu và thay đổi bảng mời.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}