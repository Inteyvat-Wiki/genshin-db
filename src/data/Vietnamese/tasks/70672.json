			},
			"dialogs": [
				{
					"id": 706720101,
					"content": "Ơ, đây chẳng phải là Tubby sao, sao lại đến Quán Rượu Đuôi Mèo vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720102,
					"content": "Tubby...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720103,
					"content": "Xin chào, Tubby!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720104
					]
				},
				{
					"id": 706720104,
					"content": "Thì ra là hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720105
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720105,
					"content": "Sao Tubby lại đến đây... Không đúng! Thì ra Tubby cũng có thể chui ra khỏi Ấm Trần Ca à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720106,
					"content": "Đương nhiên rồi... Ừm, mà nói chứ, đây là lần đầu tiên gặp hai vị ở bên ngoài ấm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720107
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720107,
					"content": "Mặc dù người ta nói rằng tiên nhân đã tạo ra \"Tiên Ấm\" để giải quyết nhiều vấn đề lặt vặt trong Động Tiên, nhưng hoạt động của Tiên Ấm thì không chỉ giới hạn trong Động Tiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720108
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720108,
					"content": "Cũng giống như Chubby... À không, \"Tầm Khôi Nạp Kỳ Chân Quân\" thì ngày thường cũng sẽ đi dạo khắp nơi, thu thập những báu vật bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720109
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720109,
					"content": "Haiz, so ra thì đúng là tôi rất ít khi ra khỏi ấm thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720110
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720110,
					"content": "Thì ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720111,
					"content": "À, nhưng mà tại sao lần này Tubby lại ra ngoài thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720112,
						706720115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720112,
					"content": "Lẽ nào là đến mua đồ uống sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720113
					]
				},
				{
					"id": 706720113,
					"content": "Mặc dù tôi cũng muốn nếm thử sự khác biệt giữa đồ uống ở đây và Liyue, nhưng hôm nay là được người khác nhờ vả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720114
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720114,
					"content": "Được người khác nhờ vả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720117,
					"content": "#Ừm... Hơn nữa suy cho cùng thì chuyện này cũng có chút liên quan tới {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720118
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720118,
					"content": "Tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720119
					]
				},
				{
					"id": 706720119,
					"content": "#Ôi, từ khi Thất Thánh Triệu Hồi thịnh hành, chắc {NICKNAME} cũng đã phát hiện ra là gửi thư mời bạn bè đến quán rượu chơi bài rất thú vị đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720120
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720120,
					"content": "Nhưng sau khi nhận thư thì phải vượt ngàn dặm xa xôi để đến đây, khá là vất vả. Nên có người nhờ tôi đến đây, dùng thuật pháp để làm ra một căn phòng giống như Thế Giới Trong Ấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720121
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720121,
					"content": "Những người nhận được thư mời và muốn đến đây sẽ có thể xuất hiện ở căn phòng đó trong tích tắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720122
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720122,
					"content": "#Như vậy thì {NICKNAME} sẽ có thể dùng căn phòng này để mời người ta giao đấu, tránh được nhiều rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720123
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720123,
					"content": "Woa, như vậy thì quá tiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720124,
					"content": "Nhưng mà đây là quán rượu của tiểu thư Margaret, Tubby dùng tiên thuật như vậy thì Margaret có giận không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720125,
					"content": "Ừm... không sao, dù sao thì căn phòng này cũng không nằm trong Quán Rượu Đuôi Mèo. Hơn nữa, trước đó tôi cũng đã được chủ quán cho phép rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720126
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720126,
					"content": "\"Úi, phép thuật Liyue lợi hại vậy sao, có thể mở rộng diện tích quán rượu lên gấp đôi không?\" Chủ quán rượu nói như vậy đó... tiếc là phép thuật của tôi chưa đạt đến mức đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720127
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720127,
					"content": "Cũng khá giống cách nói chuyện của tiểu thư Margaret nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720128,
					"content": "Hai vị đến cũng thật đúng lúc, tôi còn định khi nào mọi người quay về Thế Giới Trong Ấm rồi mới nói rõ chuyện này chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720129
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720129,
					"content": "Vậy bây giờ bắt đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720130
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720130,
					"content": "Xong, như vậy là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720131
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720131,
					"content": "#Vậy thì bây giờ, {NICKNAME} đã có thể dùng căn phòng này để mời bạn bè khắp nơi đến quyết đấu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720132
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720132,
					"content": "À... Suýt nữa thì quên, là đứa nhỏ trong quán rượu nhờ tôi nói với bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720133
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720133,
					"content": "#{NICKNAME}, hy vọng bạn sẽ cảm nhận được sự thú vị của Thất Thánh Triệu Hồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720115,
					"content": "Không phải là đến để chơi bài đó chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706720116
					]
				},
				{
					"id": 706720116,
					"content": "Không đúng nhưng cũng không hẳn là sai. Tôi không đến để chơi bài, nhưng chuyện được nhờ thì đúng là có liên quan đến bài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720134
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720134,
					"content": "Tubby thi triển tiên thuật để cải tạo quán rượu và thay đổi bảng mời.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
