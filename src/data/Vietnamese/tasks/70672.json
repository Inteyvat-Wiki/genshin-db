				},
				{
					"id": 706720202,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720203
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720203,
					"content": "#{NICKNAME}, nhìn kìa, ở đây có một con chim sẻ to quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720204,
					"content": "Tôi không phải chim sẻ, tên tôi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720205
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720205,
					"content": "Chậc, tên của tôi... tôi cũng không nhớ rõ nữa, cứ gọi tôi Tubby là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720206
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720206,
					"content": "Hình như chúng tôi chưa từng gặp Tubby ở Mondstadt thì phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706720207,
					"content": "Gặp được ở Mondstadt thì mới là chuyện lạ đấy. Thật không giấu gì, tôi vốn dĩ đến từ Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720208
					],
					"speakerTitle": "Tubby"
				},
				{
					"id": 706720208,
					"content": "Ừm, vậy sao... Nhưng mà, Tubby từ Liyue đến Quán Rượu Đuôi Mèo của Mondstadt để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706720209,
						706720212
					],
					"speakerTitle": "Paimon"
				},
