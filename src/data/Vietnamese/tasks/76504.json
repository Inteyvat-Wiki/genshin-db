					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Tôi hiểu rồi. Đi dạo khắp nơi, dùng ống kính ghi lại những gì mình thấy là một cách thư giãn không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040705,
					"content": "#Tuy nhiên, tôi không phát hiện thấy máy ảnh trên người {F#cô}{M#cậu}. Có phải lúc ra ngoài vội quá nên đã quên nó ở đâu rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040703,
