			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#{NICKNAME}, Paimon, hai vị khỏe không. Đã ăn gì chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "Ineffa? Sao cô cũng chạy lên nóc nhà vậy? Lẽ nào là... đang quan sát hình dạng của mây và tính toán xác suất mưa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "Tôi đang thực hiện một nhiệm vụ bất ngờ đi chệch khỏi quỹ đạo đã định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "Kế hoạch ban đầu là mua cho Aino \"bánh răng có độ chính xác cao\" và \"ốc vít lục giác đặc chế\" trong danh sách của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "Nhưng trên đường trở về xưởng, tôi đã gặp phải một vụ... chặn cướp vật tư không thể lường trước. Một con chim ưng với tốc độ cực nhanh đã quắp mất con ốc vít đặc chế từ tay tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "Thế là cô chạy lên đây để tìm chim ưng à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "Đúng vậy. Dựa vào tập tính của loài sinh vật này thì nóc nhà là điểm dừng chân tạm thời khả thi của nó. Tôi đang tiến hành quét hình ảnh và dò tìm âm thanh toàn diện, cố gắng xác định vị trí mục tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "Tuy nhiên, đến hiện tại vẫn chưa bắt được dấu vết hiệu quả nào. Theo suy đoán ban đầu, mục tiêu đã thoát khỏi phạm vi truy tìm của tôi, hoặc đã chuyển \"con mồi\" đến cái tổ kín đáo hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Kế hoạch dự phòng đã được khởi động: Quay lại chỗ nhà cung cấp để mua một con ốc vít cùng loại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "À mà, hai vị xuất hiện ở trên cao, lẽ nào cũng đang truy tìm loài động vật nào đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "Không không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Đúng đó. Chúng tôi vốn định tìm một nơi có tầm nhìn thoáng đãng để chụp một tấm ảnh toàn cảnh Thị Trấn Nasha, ghi lại dáng vẻ nhộn nhịp và đầy sức sống ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "Không ngờ lại gặp được Ineffa đang truy bắt kẻ trộm ở đây! Đây cũng là một \"sự kiện bất ngờ lệch khỏi quỹ đạo\" với xác suất cực nhỏ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "Cơ hội hiếm có...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "Được. Xin hãy chỉ thị vị trí đứng, hướng cơ thể và biểu cảm khuôn mặt mà tôi cần phối hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "#Suy tính: Việc tôi leo lên sân thượng, rồi gặp hai vị ở đây, lại còn có thể để {NICKNAME} chụp ảnh cho tôi. Xác suất xảy ra của chuỗi sự kiện này có lẽ còn thấp hơn cả việc con chim ưng đó trả lại cái ốc vít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "Xin hãy ghi lại khoảnh khắc \"bất ngờ\" hiếm có này một cách chính xác nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "Tôi có thể chụp ảnh cho cô không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "Tôi chỉ đang tìm kiếm tư liệu chụp ảnh thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
