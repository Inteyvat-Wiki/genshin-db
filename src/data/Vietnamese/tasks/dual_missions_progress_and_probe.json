			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831301,
					"content": "#{NICKNAME}, Paimon. Tôi thấy trên lịch thi đấu là các bạn đã lọt vào vòng trong rồi, chúc mừng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831302
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831302,
					"content": "Layla, hôm nay trông cô thật phấn chấn, \"Quái Thú Xoay Tròn\" cũng hào hứng nữa. Xem ra cô đã thắng trận hôm nay rồi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831303,
					"content": "Lần này tôi thắng hơi khó, may mà tôi đã cùng tiểu thư Yae tập luyện nhiều lần đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831304
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831304,
					"content": "Lúc nãy \"Thương Nhân Toàn Năng\" đã nhờ người đưa đồ của tôi đến, thật cảm ơn các bạn! Lát nữa tôi sẽ đưa \"Quái Thú Xoay Tròn\" đi xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831305
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831305,
					"content": "Khụ khụ... Không còn đủ sức nữa... Chúng ta nói chuyện nhẹ nhàng lại thôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831306
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831306,
					"content": "Mà này, sao không thấy Miko đâu hết vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831307,
					"content": "Tiểu thư Yae hình như có việc gấp gì đó nên đi với Souka rồi. Hình như còn có một người lính đánh thuê của \"Lữ Đoàn 30\" dẫn đường cho họ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831308
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831308,
					"content": "Lúc tôi về sân đấu thì họ đã đi xa rồi, đuổi theo hỏi thì có vẻ hơi đường đột...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831309,
						400831310
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831309,
					"content": "Chắc là cô ấy có việc phải làm nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				},
				{
					"id": 400831311,
					"content": "Cũng phải, dạo này Miko luôn dành thời gian cho nơi này, nên thỉnh thoảng đi xử lý công việc của tổng biên tập cũng là điều rất bình thường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831312,
					"content": "Với lại Miko từng nói, cô ấy muốn vừa đi nghỉ mát vừa lấy thông tin, không biết chừng người lính đánh thuê đó chính là hướng dẫn viên của họ thì sao. Chúng ta cũng không cần lo đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831313,
					"content": "Ừm, tiếp theo sẽ là trận top 8, trận đấu rất quan trọng đấy... Tuy hơi sợ, nhưng chúng ta hãy cùng nhau cố gắng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831314
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400831314,
					"content": "Được! Chúng ta nhất định sẽ vào được vòng trong, Layla cũng phải cố gắng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831315,
						400831316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831315,
					"content": "Chúng ta cũng không được lơ là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831317,
					"content": "Đúng vậy, chúng ta phải giữ cảnh giác! Còn thứ lấy được từ tay Dori, chúng ta cũng chụp vài tấm ảnh rồi đưa cho Miko xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400831316,
					"content": "Phải vừa thi đấu vừa kết hợp điều tra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831310,
					"content": "Dẫu sao thì công việc của \"Nhà Xuất Bản Yae\" cũng rất nhiều mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				}
			]
