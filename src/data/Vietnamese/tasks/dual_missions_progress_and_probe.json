	"talks": [
		{
			"id": 4008305,
			"completionStepIds": [
				4008305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008305",
							"2"
						],
						"stepId": 4008305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830501,
					"content": "Miko! Xin lỗi! Chúng tôi không ngờ \"Nón Trống Tròn\" lại đấu một trận bùng nổ, loại tiểu thư Souka mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830502,
						400830503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830502,
					"content": "Paimon... Người luyện thú là tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				},
				{
					"id": 400830504,
					"content": "Ủa? Souka có phải rất nản chí, lầm bầm mấy chữ như \"người bình thường không thể đuổi kịp\"? Rồi quỳ dưới đất khóc lóc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830505,
					"content": "Chính xác, Miko hiểu cô ấy thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830506,
					"content": "Như vậy càng tốt, Souka sẽ coi cú sốc lần này là bài học quý giá, rồi sẽ khắc họa một cách sinh động những trở ngại phải trải qua trong quá trình trưởng thành, làm lay động trái tim độc giả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830507
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830507,
					"content": "Còn nếu viết về áp lực của kẻ phản diện, và quá trình đoạt cúp đầy hấp dẫn, thì phải lấy đề tài từ các cưng đây. Nhưng đừng để bị loại trước một tuyển thủ gà mờ như tôi đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830508,
						400830509
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830508,
					"content": "Thôi rồi, tôi trở thành nhân vật phản diện rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830510,
					"content": "Hãy khoan nói đến chuyện mua chuộc đã! Miko đừng để Souka viết một cách tuyệt tình quá đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830511,
					"content": "#{NICKNAME}, Paimon, và cả tiểu thư Yae nữa... Khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830512
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830512,
					"content": "Layla, bình tĩnh chút nào, không thôi lại ngất nữa bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830513,
					"content": "Tôi vẫn ổn... Lúc trước tôi viết thư cho học viên của Amurta, nhưng không ngờ đối phương phản ứng rất nhiệt liệt, mấy giờ sau đã trả lời thư, còn kèm theo tài liệu mà tôi cần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830514
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830514,
					"content": "Theo những tài liệu này, tôi đã thử làm không ít đồ ăn cho \"Quái Thú Xoay Tròn\" rồi. Nhưng có thể là do nguyên liệu không đúng, nên \"Quái Thú Xoay Tròn\" có vẻ không thích lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830515
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830515,
					"content": "Sau đó tôi đã liệt kê ra một danh sách cải tiến, cũng bao gồm nguyên liệu mà \"Nón Trống Tròn\" có thể sẽ thích, rồi làm tới hơn nửa đêm mới ngủ, thành ra hôm nay hơi hụt hơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830516
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830516,
					"content": "Mới đó mà đã có kết quả rồi sao? Hiệu suất cao thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830517,
					"content": "(Chỉ là ngủ không ngon thôi... Không lẽ vậy cũng hụt hơi sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830518
					]
				},
				{
					"id": 400830518,
					"content": "Tình hình bên Layla thế nào? Chiêu đãi đối thủ có tốt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830519,
					"content": "Ừm! May mà có tiểu thư Yae đưa chúng ta đi rèn luyện, nên \"Quái Thú Xoay Tròn\" đã nghe lời tôi hơn, phản ứng nhanh tới nỗi khiến tôi có chút ngưỡng mộ luôn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830520
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830520,
					"content": "Nhưng đối thủ rõ ràng cũng đã mạnh hơn rồi, để vào được top 8, tôi muốn huấn luyện thêm cho \"Quái Thú Xoay Tròn\" lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830521
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830521,
					"content": "Vấn đề ở chỗ... tôi lại muốn 7 giờ sáng mai đi tìm \"Thương Nhân Toàn Năng\" để mua hết tất cả nguyên liệu trong kế hoạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830522
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830522,
					"content": "Chuyện này dễ thôi, tôi sẽ cùng cô đi huấn luyện, còn chuyện mua đồ thì nhờ mấy bé cưng này là được, họ rất giỏi chạy việc cho người khác đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830523
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830523,
					"content": "Nghe có vẻ như hai bạn thường xuyên làm việc cho tiểu thư Yae nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830524,
						400830525
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830524,
					"content": "Đúng vậy, chúng tôi rất sẵn lòng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830526,
					"content": "A! Đúng đúng! Đừng viết chúng tôi thành kẻ xấu xa hung dữ nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830527,
					"content": "Đừng lo, Layla à, lúc nãy họ còn xin lỗi tôi vì chuyện đánh bại Souka đấy. Cô đi mua ly đồ uống để cho khỏe người trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830528,
					"content": "Làm phiền mọi người rồi! Thực sự vô cùng cảm tạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830529
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830529,
					"content": "Đây là địa chỉ mà tôi và \"Thương Nhân Toàn Năng\" hẹn gặp nhau, danh sách nguyên liệu cũng đã ghi trên đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830530
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 400830530,
					"content": "Không cần khách sáo như vậy! Layla cũng đã điều tra sở thích của \"Nón Trống Tròn\" rồi mà. Chúng ta đang giúp đỡ lẫn nhau, cô cứ yên tâm đi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830531,
					"content": "Còn về buổi thảo luận lần trước chưa thực hiện được, \"nhân tố bất ổn\" đằng sau giải đấu này... Có lẽ có một điểm quan trọng cần lưu ý, chính là nguyên liệu dùng để bồi dưỡng Nấm Quỷ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830532,
						400830533
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830532,
					"content": "\"Rau Câu Hoa Hoa\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830534,
					"content": "Đây là một trong những đoạn hấp dẫn nhất trong tiểu thuyết: Bí mật điều tra. Cưng rất tò mò đúng không? Ma lực của \"Ngọc Trí Tuệ\" và \"Rau Câu Hoa Hoa\" từ đâu mà có?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830535,
					"content": "Hơn nữa, không làm rõ tình hình trận đấu này mà để cho Haniyyah làm theo ý mình thì có lẽ sẽ gây ra hỗn loạn lớn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830536,
					"content": "Ồ... Đề tài bỗng trở nên thật phức tạp, tôi không hiểu cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830537,
					"content": "Đề nghị mấy cưng hành động khi trời gần sáng. Lúc đó mọi người thường rất mệt mỏi, có lẽ sẽ tìm được manh mối quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 400830538,
					"content": "Bạn muốn làm theo lời Miko nói thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830539,
						400830540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830539,
					"content": "Đây là lý do lúc đầu dự thi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830541,
					"content": "Nói vậy cũng đúng, vậy hãy chờ đến sáng mai rồi đi đến chỗ bồi dưỡng Nấm Quỷ xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830542,
					"content": "Chúng ta chỉ đang xác nhận mức độ an toàn của trận đấu thôi. Tôi sẽ không nghi ngờ \"Nón Trống Tròn\" đâu, bạn cứ yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830540,
					"content": "Đây là vì để chung sống hòa bình với bạn đồng hành.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830533,
					"content": "Miko đã nghe được gì đó rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830525,
					"content": "Nếu không đáp ứng thì hình tượng của chúng tôi sẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830509,
					"content": "Paimon bị nhân vật phản diện mua chuộc, Paimon còn xấu xa hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830503,
					"content": "Người phải hoàn toàn chịu trách nhiệm là tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				}
			]
		},
		{
			"id": 4008308,
