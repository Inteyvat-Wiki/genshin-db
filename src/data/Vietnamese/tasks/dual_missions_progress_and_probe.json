			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830901,
					"content": "Theo mảnh giấy nhắn của Layla thì chắc phải gặp \"Thương Nhân Toàn Năng\" ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830902,
					"content": "Nhìn cách quý khách nhìn xung quanh, chắc là đang tìm \"Thương Nhân Toàn Năng\" đúng không? Vậy thì xin chào mừng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830903
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830903,
					"content": "Đúng vậy, sao cô biết thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830904,
					"content": "Không đúng, sao lại là Dori? \"Thương Nhân Toàn Năng\" mà Layla nói thì ra là cô sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830905,
					"content": "Có gì đâu mà lạ? Chủng loại hàng hóa của \"Đại Nhân Sangemah Bay này là nhiều nhất, thần kỳ nhất\", đây là điều mà các ông chủ và khách hàng của cả Đại Khu Bazaar đều biết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830906
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830906,
					"content": "\"Vạn năng\", \"toàn năng\", \"đại năng\" hay là năng gì cũng được... cũng là thương hiệu riêng của Dori tôi. Thương nhân khác muốn dùng thì miễn bàn, trừ khi trả trước mấy triệu phí ủy quyền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830907
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830907,
					"content": "Chúng ta nên nghĩ ra từ trước mới phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830908,
					"content": "Kể ra thì, Layla lại tìm hai vị đi chạy việc sao? Xem ra cô ấy thật sự chìm đắm trong giải đấu luyện thú rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830909
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830909,
					"content": "Xem ra mối quan hệ giữa cô và Layla rất tốt, Dori rất hiểu tình hình của cô ấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830910,
					"content": "Haha! Điều này không liên quan gì đến quan hệ tốt xấu. Layla từng mua ít đồ ở chỗ tôi, tuy không phải đắt giá gì, nhưng với một học giả thì cũng xem như là chi mạnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830911
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830911,
					"content": "Dĩ nhiên là tôi sẽ để mắt đến cô ấy, biết cô ấy đã tham gia cuộc thi đáng ngờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830912,
						400830913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830912,
					"content": "Dori cũng biết vài bí mật nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				},
				{
					"id": 400830914,
					"content": "Hmm, tôi chỉ cảm thấy có điều gì đó không ổn. Tình cờ chỗ tôi có vài món hàng tốt không bán được. Để không cũng uổng, hay là giao cho các vị nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830915
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830915,
					"content": "Ồ... có vẻ chỉ là vài linh kiện và ghi chép không hoàn chỉnh nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830916,
					"content": "Nghe nói đây là thiết bị và hồ sơ mà ban tổ chức cuộc thi đã tìm cách tiêu hủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830917
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830917,
					"content": "Họ quá sơ suất, một số người rất sẵn lòng nhặt rác để làm giàu! Những thứ này đã được vớt lên giao cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830918
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830918,
					"content": "Nếu quan sát kỹ, một số chữ trên các tài liệu này rất giống với công thức của \"Rau Câu Hoa Hoa\", các mảnh thiết bị cũng có một số điểm tương đồng với \"Ngọc Trí Tuệ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830919,
					"content": "Không biết chừng đó là sản phẩm dùng để thử nghiệm. Giờ cứ cất lại đã, sau đó để Miko xem thử, có lẽ cô ấy sẽ tìm ra được điều gì đó không ổn chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830920,
						400830921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830920,
					"content": "Nói chung là có vài giả thiết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830922,
					"content": "Hóa ra những lo sợ ban đầu của chúng ta sắp thành sự thật rồi... Tôi vẫn muốn chơi với \"Nón Trống Tròn\" mà không cần lo lắng gì cơ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830923,
					"content": "Tuy không biết các vị đang bàn chuyện gì, nhưng có vẻ như những thứ này khá hữu ích với các vị. Tôi sẽ giảm giá, 60 triệu Mora, cảm ơn đã chiếu cố!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830924
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830924,
					"content": "Hừ! Ranh mãnh quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830925,
					"content": "Hihi, đùa thôi, không ai quan tâm đến chuyện này ngoại trừ quý khách và Matra cả. Cứ coi đó là một món quà dành cho quý khách vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830926
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830926,
					"content": "Cứ giao đơn đặt hàng của Layla cho tôi, sau khi chuẩn bị xong hàng thì tôi sẽ cho người gửi đi. Các vị không cần phải chạy việc vặt nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830927
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830927,
					"content": "Làm tôi sợ chết khiếp, dù có được tiền thưởng thì cũng không thể trả nhiều tiền như vậy được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400830928,
					"content": "Đây là đơn hàng của Layla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830929
					]
				},
				{
					"id": 400830929,
					"content": "À, bột trộn với nhung tùng, mứt lâu năm và nước ép đào... Nấm Quỷ ăn được mấy thứ này thật sao? Sao Layla biết được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 400830921,
					"content": "Kautilya có vấn đề...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830913,
					"content": "Trong tay cô có thông tin gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				}
			]
		},
		{
