			},
			"dialogs": [
				{
					"id": 711150601,
					"content": "Phù... Đúng rồi, là như thế đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150602,
					"content": "Trước kia động phủ của Dược Quân từng dùng những con bướm đầy màu sắc trang trí cửa nhà. Sau đó cơ quan động phủ bị hủy hoại, những con bướm và hũ thuốc này... vốn dùng để nuôi dưỡng cây tiên bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150603,
					"content": "Cây tiên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "Ừm, không sai! Lúc đầu, cây tiên này là do Dược Quân đại nhân đích thân trồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150605,
					"content": "Dù bây giờ đã héo úa, nhưng Dược Quân đại nhân từng nói, chỉ cần bướm chưa bay hết thì cây sẽ có thể sống lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150606,
					"content": "Ôi... Từ sau khi không còn duy trì được hình dạng con người, cô ấy đã nhanh chóng rời khỏi. Không biết bây giờ sống ra sao nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150607,
					"content": "Nên tôi cần làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "À, xin lỗi, ta vô tình đắm chìm trong ký ức về Dược Quân đại nhân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150609,
					"content": "Khụ, nghe đây, loài người! Chỉ cần đuổi số bướm kia vào trong lọ, thì sẽ có thể nuôi dưỡng cây khô kia rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150610,
					"content": "Hừm, đây là cơ quan tiên gia mà Dược Quân đại nhân thiết kế, rất thần kỳ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150611,
					"content": "Tôi xem thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "Ừm, nhờ vào các ngươi vậy, loại người tốt bụng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150613,
					"content": "Tại sao lại là bướm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "Hửm? Đúng nhỉ, tại sao vậy... Có lẽ là vì Dược Quân đại nhân khá thích bướm chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150615,
					"content": "Hừm... Tóm lại, nhờ các ngươi giúp ta đuổi số bướm kia vào trong hũ nhé, loài người tốt bụng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiên Tượng Thong Dong"
				}
			]
		},
