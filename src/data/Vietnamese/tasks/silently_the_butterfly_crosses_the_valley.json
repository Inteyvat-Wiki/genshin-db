			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "Ừm... Hả? Các ngươi là ai mà dám quấy rầy giấc mơ đẹp của ta...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150402,
					"content": "Hả?! Thứ gì đang nói vậy? Đáng sợ quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "Agh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150404,
					"content": "Waaaah!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "Hahaha! Sợ là đúng rồi! Nếu ta không bị núi đá bao vây thì các ngươi đã sớm vào bụng ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150406,
					"content": "Sao...? Thì ra chỉ là một bức tượng đá biết nói... Còn tưởng là quái vật gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "Hừ, cái gì mà \"chỉ là một bức tượng đá biết nói\" chứ!? Tượng đá biết nói không đáng sợ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150408,
					"content": "À, chúng tôi đã thấy nhiều bức tượng đá kiểu này ở bên ngoài rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "Cái, cái gì! Thôi được, vậy xem ra không dọa được các ngươi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150410,
					"content": "Tại sao phải hù dọa người khác chứ? Thật là! Rõ ràng chỉ là một bức tượng đá thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "Hừ! Cho dù ta \"chỉ là một bức tượng đá\", nhưng nơi này cũng là động phủ của Dược Quân đại nhân! Khi Dược Quân đại nhân còn ở đây, cô ấy không thích người khác quấy rầy sự yên tĩnh của mình đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150412,
					"content": "Vậy nên ta phải xua đuổi đám người phiền toái đi! Cho dù Dược Quân đại nhân có rời đi rồi cũng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150413,
					"content": "Nhưng các ngươi hình như có chút khác biệt so với phàm nhân bình thường, hơn nữa cũng không bị ta dọa cho sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150414,
					"content": "Có thể nhờ các ngươi giúp ta một việc được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150415,
					"content": "Ồ? Vậy cần chúng tôi giúp gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "Khụ, các ngươi nhìn những con bướm đầy màu sắc này đi! Kể từ khi chủ nhân của động phủ rời đi, những con bướm nhỏ này đã bay tán loạn khắp nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150417,
					"content": "Suỵt... Đợi một chút, trên đầu ngươi có một con này! Để chúng tôi lấy xuống cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
