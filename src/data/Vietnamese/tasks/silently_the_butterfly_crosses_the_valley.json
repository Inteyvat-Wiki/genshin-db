			"dialogs": [
				{
					"id": 711151101,
					"content": "Này! Tên xấu xa kia, chúng tôi đã giúp đuổi toàn bộ bướm vào trong hũ rồi, sao cây tiên chẳng có gì thay đổi vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "Hừm...? Các ngươi là ai? Làm phiền ta... À, là các người, loài người tốt bụng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711151103,
					"content": "Ôi! Không ngờ các người thật sự tìm thấy số bướm này! Ta chỉ tùy tiện nói ra mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711151104,
					"content": "Không, không! Ý ta là... Ta cũng cảm nhận được sự bất ổn của tiên lực! Tiếp theo, chỉ cần học thuộc khẩu quyết của Dược Quân đại nhân để lại là có thể khiến cây tiên tái sinh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711151105,
					"content": "Đợi đã, khẩu quyết là cái gì nhỉ, để nhớ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711151106,
					"content": "\"Cây sinh ra trong mùa đông, năm tháng tươi đẹp khô héo. Ta nhớ đến mùa xuân, rồi lại trở nên xinh đẹp...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711151107,
					"content": "Cánh bướm bay lượn... bay lượn... Phần sau ta quên mất rồi. Tóm lại thì phần sau cùng là mọi thứ quay trở lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiên Tượng Thong Dong"
				}
			]
