			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "Phù... Đúng rồi, là như thế đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150502,
					"content": "Trước kia động phủ của Dược Quân từng dùng những con bướm đầy màu sắc trang trí cửa nhà. Sau đó cơ quan động phủ bị hủy hoại, những con bướm và hũ thuốc này... vốn dùng để nuôi dưỡng cây tiên bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150503,
					"content": "Cây tiên?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150504,
					"content": "Ừm, không sai! Lúc đầu, cây tiên này là do Dược Quân đại nhân đích thân trồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150505,
					"content": "Dù bây giờ đã héo úa, nhưng Dược Quân đại nhân từng nói, chỉ cần bướm chưa bay hết thì cây sẽ có thể sống lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150506,
					"content": "Ôi... Từ sau khi không còn duy trì được hình dạng con người, cô ấy đã nhanh chóng rời khỏi. Không biết bây giờ sống ra sao nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150507,
					"content": "\"Đàn bướm bay về tụ họp, cây khô lần nữa hồi sinh...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "Không sai! Chỉ cần... Không đúng, sao các người lại biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "Tiên Tượng Thong Dong"
				},
				{
					"id": 711150509,
					"content": "Bỏ đi, tóm lại là thế này! Chỉ cần đuổi số bướm kia vào trong lọ, thì sẽ có thể nuôi dưỡng cây khô kia rồi! Xin nhờ vào các người nhé, loài người tốt bụng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiên Tượng Thong Dong"
				}
			]
		},
