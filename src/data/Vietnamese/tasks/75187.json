			"dialogs": [
				{
					"id": 751870101,
					"content": "#Trên sừng không có hoa văn như ngọn lửa... Không phải {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870102,
					"content": "Hmm, cậu nhóc này từ đâu ra vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870103,
					"content": "Quả trứng Saurian của Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "Ồ, là quả trứng Saurian khi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870105,
					"content": "Roooah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870106,
					"content": "Không ngờ quả trứng này lại nở ra một con Tepetlisaur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870107,
					"content": "Tôi nhớ người bảo vệ quả trứng Saurian này đã đặt tên cho nó... Tên của nó là \"Aguara\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870108,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870109,
					"content": "Ồ, xem ra nhóc có ấn tượng với tên của mình rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870110,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870111,
					"content": "#Giống như {REALNAME[ID(2)|SHOWHOST(true)]}, nhóc này cũng không còn nhà nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870112,
					"content": "#Hay là đi cùng nhau nhé! Hihi, ta và {NICKNAME} rất biết cách bầu bạn với Tepetlisaur đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870113,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870114,
					"content": "Hihi... Ta biết là nhóc sẽ đồng ý mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870115,
					"content": "Bạn giúp nó buộc khăn lụa, giống như đã từng làm với người đồng đội trước đây của mình.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "Nhóc Saurian buộc khăn trước đó, cuối cùng đã lớn lên trở thành một chú Saurian vô cùng lợi hại đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870117,
					"content": "Aguara! Hy vọng nhóc cũng có thể giống như nó, lớn lên một cách khỏe mạnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
