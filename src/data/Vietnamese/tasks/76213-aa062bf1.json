						762130212
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130202,
					"content": "Vậy nên... là đang tìm sách sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
