			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "\"...Xui xẻo, balalaika của Katya bị hỏng rồi. Hành động khẩn cấp, không biết hư hỏng như thế nào, nhất định phải sửa nó trước khi bị mắng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "Mảnh Nhật Ký Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710590202,
					"content": "\"...Đây có phải là cách tổ tiên đã chiến đấu chống lại trận đại hồng thủy cách đây năm trăm năm không? Đại úy nói, so với tổ tiên của chúng ta, những trận chiến gian khổ mà chúng ta trải qua chỉ bằng một phần nhỏ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "Mảnh Nhật Ký Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710590203,
					"content": "(Nhiều trang ở giữa bị ố đen, sau khi tẩy vết ố đen đó, nét chữ viết bằng mực đã bị xóa mất hoàn toàn.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "Mảnh Nhật Ký Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710590204,
					"content": "\"...Không thể tiếp tục ở đây được nữa, có thể bọn chúng đang nhìn trộm hành tung của tôi qua lớp bùn đen...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "Mảnh Nhật Ký Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710590205,
					"content": "\"...Tiếp theo, phải tiếp tục di chuyển theo hướng ngược lại, và dẫn dắt chúng lần nữa rời xa chủ lực của đội...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "Mảnh Nhật Ký Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710590206,
					"content": "\"...Bên cạnh di tích pháo đài phía đông nam có một cái hố, có lẽ đi được bằng đường đó...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "Mảnh Nhật Ký Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710590207,
					"content": "\"...Chúc tôi may mắn đi! Không Ai, Ngoài Chúng Ta!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mảnh Nhật Ký Của Hạ Sĩ Nikolay"
				}
			]
		},
		{
