			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "Í... Phù hiệu này... là tên Fatui kia để lại đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590601,
					"content": "Ừm... ngay cả một bóng người cũng không có, chúng ta làm sao để quay về báo cáo đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590602,
					"content": "Ừm, cũng không còn cách nào khác, chúng ta về thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "Đây là... huy hiệu sĩ quan, nhật ký hành động và... ghi chú?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591306,
					"content": "Hãy nói cho tôi biết, Kolya đang ở đâu? Em ấy còn sống không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591307,
					"content": "Chúng tôi chưa tìm được anh ấy, nhưng có thể anh ấy vẫn còn sống.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "Kolya không thể bỏ lại tôi để đào ngũ được. Các bạn... các bạn có thể yên tâm, tôi hiểu, em ấy sẽ không chạy trốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591310,
					"content": "Những thứ này các bạn tìm thấy ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591311,
					"content": "Ở một hang động phía đông nam, để tôi đánh dấu cho cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "Là một nơi rất quái dị, có rất nhiều quái vật kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591313,
					"content": "Cảm ơn... Cảm ơn bạn, tôi... xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591314,
					"content": "Tôi... tôi mong là Kolya đã hy sinh, tôi thà tin như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591315,
					"content": "Kolya, xin đừng làm Nữ Hoàng bệ hạ khó xử, đừng để chị khó xử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591316,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "Khụ, khụ... Tôi không sao... Xin lỗi, xin lỗi! Làm cho bầu không khí trở nên căng thẳng rồi... tôi vẫn chưa cảm ơn các bạn nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591318,
					"content": "Đúng rồi, Hỏa Thủy... À, haiz... các bạn không uống rượu, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591319,
					"content": "Tôi còn một ít Mora... còn... một ít vật tư lúc trước thu thập được, dù sao cũng không còn dùng đến nữa, bạn hãy cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591320,
					"content": "Tiếp theo cô có dự định gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "Tiếp theo sao? Cảm ơn đã quan tâm, nhưng tôi không cần các bạn giúp \"làm chuyện xấu\" nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591323,
					"content": "Ừm... có lẽ là tôi vẫn sẽ đi tìm Kolya của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591324,
					"content": "Tôi vẫn còn giữ bức thư mà em ấy gửi cho tôi trước khi thay đổi nơi đóng quân... Đối với tôi, đây là bằng chứng cuối cùng rằng em ấy vẫn còn trên cõi đời này... Tôi sẽ giữ nó bên mình mãi mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591325,
					"content": "Nếu em ấy vẫn còn sống... Là Fatui của Nữ Hoàng bệ hạ, tôi sẽ lấy đầu của kẻ phản bội đó, dù em ấy có chạy đến đâu, và lẩn trốn đến khi nào đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591326,
					"content": "Còn nếu em ấy đã hi sinh... Là một người chị, tôi cũng sẽ gặp số phận mà bất cứ Fatui nào cũng phải đối mặt, và tôi tự hào về em ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591327,
					"content": "Cái gọi là \"Không Ai, Ngoài Chúng Ta\"... chính là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591328,
					"content": "Nếu cô làm điều ác, và tôi phải ngăn cản cô thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "...Tất cả chúng ta đều có những lúc không có sự lựa chọn, và có những việc không thể không làm, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591333,
					"content": "Được rồi... Bạn nghiêm túc thật, trẻ con chưa đến tuổi uống rượu luôn có những nỗi buồn phiền lạ lùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591334,
					"content": "Đến lúc đó hẵng nói đi, khi nào không còn sự lựa chọn nữa hẵng nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591335,
					"content": "Nhưng mà bây giờ, tôi cần nghỉ ngơi... Bạn cũng cần nghỉ ngơi một chút đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591336,
					"content": "Chỉ có một chiếc giường cỏ thì ngủ thế nào? Rõ ràng là đang đuổi chúng tôi đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591337,
					"content": "Hahahahaha! Đó là vấn đề của mấy bạn... thật đáng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591338,
					"content": "Nhưng mà dù sao tôi cũng thật tâm cảm ơn sự giúp đỡ của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591330,
					"content": "Cô nhất định phải câu nệ lập trường của Fatui sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "Hở? Đúng vậy, kỳ lạ lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591332,
					"content": "Khái niệm, lập trường, đều là những vấn đề quá nhàm chán. Xùy... Dưới lớp mặt nạ của tôi không phải chỉ có khái niệm đâu, tôi cũng rất sợ ăn đạn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591321,
					"content": "Có còn cần tôi giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "Có thể anh ấy đã trốn thoát bằng mật đạo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "\"...Vào được căn phòng tối, quái cơ quan khổng lồ vẫn đang lang thang bên ngoài, nó dường như đang kiên nhẫn chờ tôi thoát ra, giống như một kẻ săn mồi, bụng dạ khó lường, nham hiểm khác thường...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "Ghi Chép Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710591402,
					"content": "\"...Chân trái bị thương nặng, vội vàng băng bó, rất đau, sưng tấy. Có thể nhiễm trùng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "Ghi Chép Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710591403,
					"content": "\"...Bên trong hang đá còn một lối ra khác, không chắc nó sẽ dẫn đến đâu. Kết cấu của lối ra rất mong manh, nếu không có gì chống đỡ sẽ dễ bị sập dưới tác động ngoại lực mạnh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "Ghi Chép Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710591404,
					"content": "\"...Tôi bị phát hiện rồi, có người đến. Đó là một... kiếm sĩ... toàn thân đen thui...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "Ghi Chép Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710591405,
					"content": "\"...Hắn, không, nó...? Có vẻ như hàng rào kim loại chắc chắn cũng không thể ngăn cản nó, trông bộ dạng của nó, tôi biết...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "Ghi Chép Của Hạ Sĩ Nikolay"
				},
				{
					"id": 710591406,
					"content": "\"...Xin lỗi, Katya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ghi Chép Của Hạ Sĩ Nikolay"
				}
			]
		}
	]
}