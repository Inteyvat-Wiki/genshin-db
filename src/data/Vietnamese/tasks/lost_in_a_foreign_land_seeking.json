			},
			"dialogs": [
				{
					"id": 710590401,
					"content": "Bạn về rồi à. Có phát hiện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590402,
					"content": "Không có cũng không sao, cứ nghỉ ngơi một chút đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590403,
					"content": "Đừng quan tâm tôi có đang vội hay không... Dù sao tôi cũng có kế hoạch dưỡng lão ở đây, nói không chừng tôi còn phải nhờ bạn nộp đơn xin trợ cấp cho tôi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590404,
					"content": "Woa, rảnh rỗi quá ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590405,
					"content": "Hừm, nếu các bạn không có phát hiện gì mới, tôi sẽ phải ở đây thư giãn cho đến già.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
