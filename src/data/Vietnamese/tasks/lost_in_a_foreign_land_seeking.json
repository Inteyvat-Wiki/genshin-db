			"dialogs": [
				{
					"id": 710590301,
					"content": "Mọi người về rồi sao, tôi còn một ít Hỏa Thủy đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590302,
					"content": "Haha... Không bắt các bạn uống rượu cùng tôi đâu, nếu các bạn bị thương, Hỏa Thủy cũng có thể dùng để rửa vết thương đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590303,
					"content": "Thế nào? Có thu hoạch gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590304,
					"content": "Chúng tôi tìm thấy những thứ này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
