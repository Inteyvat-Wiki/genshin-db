			"dialogs": [
				{
					"id": 710580601,
					"content": "Tôi phải nghỉ ngơi rồi, vết thương cũ vẫn còn đau... xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580602,
					"content": "Nếu có việc gì thì xin hãy đến tìm tôi vào hôm khác nhé... Tôi cũng có việc cần nhờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "Các bạn đến rồi à! Ngồi thoải mái đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590102,
					"content": "Xin lỗi, lúc trước vội vã đuổi các bạn đi, cũng không nói rõ muốn nhờ các bạn giúp chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590103,
					"content": "Không sao, cô cứ nói đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "Yên tâm đi, tôi sẽ không bảo các bạn đi làm chuyện xấu đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590108,
					"content": "Vậy cô cứ nói đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "Là thế này... Kolya - Nikolay của tôi bị lạc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590114,
					"content": "Vì vậy... Tôi muốn nhờ bạn tìm manh mối của em ấy để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590115,
					"content": "Nếu em ấy vẫn còn sống, hãy đưa em ấy về gặp tôi. Còn nếu em ấy đã hi sinh... cũng hãy nói cho tôi biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590116,
					"content": "Thật xin lỗi vì nhờ bạn chuyện thế này, nhưng hy vọng các bạn có thể giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590117,
					"content": "Vậy à... Tôi còn tưởng cô tìm chúng tôi để làm chuyện xấu gì chứ! Ví dụ như phá hoại Thiên Nham Quân chẳng hạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590118,
					"content": "Thiên Nham Quân...? Tại sao chứ? Đối đầu với họ chẳng có lợi gì cho Fatui chúng tôi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590119,
					"content": "Nói vậy là có ý gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "Câu này đáng lẽ là tôi hỏi mới đúng đó...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590121,
					"content": "Khoan đã... Tôi hiểu rồi... Chúng tôi đã cãi nhau với người Liyue ở trên mặt đất...? Điều này giải thích tại sao nguồn tiếp tế của chúng tôi bị gián đoạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590122,
					"content": "Đáng ghét... Rốt cuộc trên mặt đất đã xảy ra chuyện gì chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590123,
					"content": "Nói ra dài dòng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "Hừm... chuyện đó nói sau đi. Chiến tranh là vậy... Bạn bè và kẻ thù thay đổi trong nháy mắt, đó chính là môi trường sống của Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590126,
					"content": "Nhưng tôi bây giờ... Ít nhất là bây giờ, tôi chỉ quan tâm một mình Kolya thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590127,
					"content": "Trên đường sơ tán, em ấy và tiểu đội đã lạc nhau... Sau đó, tôi quay lại tìm em ấy và cũng bị lạc luôn. Haiz, thật mất mặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590128,
					"content": "Còn về nơi cuối cùng em ấy xuất hiện... Tôi có thể giúp bạn đánh dấu lên bản đồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590129,
					"content": "Em ấy và chúng tôi tách ra ở đây, em ấy muốn dụ những kẻ truy đuổi... Em ấy là một chiến sĩ ưu tú, tôi biết em ấy sẽ không chết ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590130,
					"content": "Hy vọng em ấy có để lại manh mối ở đó... Hy vọng là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590124,
					"content": "Chuyện này là do các người khơi dậy đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "Chắc cô cũng sẽ không để chúng tôi đi làm hỏng chuyện của Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "Đúng vậy, nếu tôi làm những việc tốt mà bất lợi cho cô thì cô cũng không được ngăn cản chúng tôi đó nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590111,
					"content": "Cái gì mà việc tốt... việc xấu chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590112,
					"content": "Haiz... phiền phức ghê, nghe tôi nói hết câu có được không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590104,
					"content": "Không sao, chúng tôi vẫn chưa đồng ý với cô mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "Đúng vậy, cô là Fatui mà! Nếu bảo chúng tôi làm chuyện xấu, chúng tôi sẽ không làm đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590106,
					"content": "Ồ... Bạn nói rất có lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105902,
			"completionStepIds": [
				7105902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
