			"dialogs": [
				{
					"id": 401180901,
					"content": "Hậu duệ của gia tộc Lawrence tôn quý, trong chuyến hành trình cũng học được rất nhiều kỹ năng... ví dụ như làm bánh nướng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Ừm, độ lửa này chắc là vừa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "Không ngờ anh cũng biết làm bánh nướng đấy... Không phải anh là kiểu người không bao giờ rửa chén sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Đến đúng lúc lắm, lát nữa cô rảnh không? Có thể dạy tôi làm bánh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "Hả? Phải tốn hơi nhiều thời gian đó... Chúng ta đâu phải đến đây để tăng tình hữu nghị gia tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "Được rồi, lúc này đi nói mấy chuyện này làm gì! Cô cũng nói rồi, chúng ta là người bình thường, cứ học tập lẫn nhau như họ hàng bình thường đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
