			"dialogs": [
				{
					"id": 401181001,
					"content": "Muốn ngồi xe bay với chị \"Quân Sư\" quá! Nhưng hình như chị ấy sẽ xỉu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
