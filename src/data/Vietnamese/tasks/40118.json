					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Klee tinh mắt đó, chắc là thấy mấy ngôi sao bay tung tăng trong mắt \"Quân Sư\" rồi đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Hôm nay thì ít hơn một chút! Hôm qua có rất nhiều sao sáng bay tung tăng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "Nếu mẹ ở đây thì chắc sẽ nói đó là cá rơi vào trong đám mây nhỉ!",
					"roleType": "TALK_ROLE_NPC",
