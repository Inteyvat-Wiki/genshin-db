			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "Xin chào, tôi đã đợi hai vị lâu lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670102,
					"content": "Đã kết bạn được với Cây Nổ chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "Haiz, đừng nhắc nữa. Sau khi hai vị \"giao lưu\" một trận thì nó đã yên phận hơn rồi... Nhưng cũng chỉ được một lúc mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670104,
					"content": "Vừa hồi phục lại là nó như muốn đưa tôi vào chỗ chết vậy, thật đáng sợ. Xem ra hai vị nói đúng, kết bạn với Cây Nổ quả là quá miễn cưỡng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670105,
					"content": "Nhưng mà hương vị của Quả Cây Nổ đúng là không tệ, có vị nguyên tố Hỏa. Bạn bè ở Natlan chắc sẽ thích nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670106,
					"content": "Khó mà tưởng tượng ra được đó là vị gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670107,
					"content": "Muốn nếm thử không? Nếu muốn thì bây giờ tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670108,
					"content": "Không, không cần đâu! Quay lại câu chuyện nào, vậy anh chuẩn bị đi khiêu chiến với Rồng Đất Cổ Nham nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670109,
					"content": "Đúng vậy. Tôi cảm thấy lần này khả năng thành công khá cao. Dù sao thì Rồng Đất Cổ Nham khá giống với Tepetlisaurus mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670110,
					"content": "Nếu hai vị đi từ Sumeru đến Natlan giống tôi thì chắc sẽ gặp chúng đầu tiên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670111,
					"content": "Được rồi, nhưng tôi vẫn có cảm giác là lần này cũng sẽ không thành công... Sao anh không thử cân nhắc đến Rồng Đất Nhỏ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670112,
					"content": "...Do nó không có da bụng căng tròn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670113,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670114,
					"content": "Rồng Đất Nhỏ không có da bụng căng tròn. Chắc chắn vì chúng thường xoay tròn với tốc độ cao, nên dường như không tích lũy chút mỡ nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670115,
					"content": "Haiz, nhưng lý do chính vẫn là thiếu sự kích thích. Đối với những người bạn ở Natlan sống cùng với Saurian thì Rồng Đất Nhỏ có gì hiếm lạ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670116,
					"content": "Rồng Đất Cổ Nham thì khác, dù đặt vào trong câu chuyện cũng có thể xem là đối thủ rồi. Đối thủ mạnh thì nhân vật chính mới mạnh chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670117,
					"content": "Được rồi, chúng ta đừng chậm trễ nữa, Rồng Đất Cổ Nham đang đợi chúng ta ở phía trước đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670118,
					"content": "Vậy thì đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "Tôi còn bận việc khác, chờ một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "Không sao, tôi sẽ đợi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				}
			]
		}
	]
}