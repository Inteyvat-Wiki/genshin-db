					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "Những Hổ Phách đó đều là do người bạn của bà làm ra, ông ta nói thứ đó chỉ dùng để chống những quái vật và đạo tặc đến quấy nhiễu ngọn núi mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170404,
					"content": "Qua bao nhiêu năm rồi... Đến bây giờ nhiều Hổ Phách trên núi còn nuốt vào những thứ kỳ lạ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170405,
					"content": "Ôi, những hổ phách này, thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170406,
					"content": "Chiếc ấm của bà là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "Phải cảm ơn các cháu mới được, chiếc ấm của bà cuối cùng cũng sạch bóng lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170408,
					"content": "Bà đến để lấy đồ, phải làm sạch chiếc ấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170409,
					"content": "Sau khi rửa sạch sẽ, gọn gàng rồi, mới có thể đem đi mời khách được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
