			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "Haiz, chắc không rơi trên núi đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170102,
					"content": "Bà ơi... Sao bà lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "Sao hai cháu lại đến đây? Thật là trùng hợp... Chết mất thôi, sao hai cháu mặc ít đồ như vậy, ở đây gió lớn chớ có cảm lạnh nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170104,
					"content": "Bà vừa mới đến \"Hổ Lao Sơn\" gặp một người bạn ôn lại chuyện cũ, bây giờ chuẩn bị quay về thành rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170105,
					"content": "Thế nhưng đi được nửa đường thì đột nhiên phát hiện đánh rơi một món đồ, có lẽ rơi trên \"Hổ Lao Sơn\" rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170106,
					"content": "Phải đi đoạn đường dài với nhiều Hổ Phách như vậy, thân già này chẳng có sức mà đi lần thứ hai nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170107,
					"content": "Các cháu có thể giúp bà đến \"Hổ Lao Sơn\" tìm đồ được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170108,
					"content": "Bạn của bà là ai vậy ạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "Haizz là người sống ở \"Hổ Lao Sơn\", các cháu chắc đã gặp mặt rồi. Hổ Phách của ông ta... Rất là phiền mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170110,
					"content": "Cũng do trí nhớ ta không tốt, nếu không quên cho thứ đó vào trong chiếc ấm thì đã không có nhiều chuyện phiền phức như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170111,
					"content": "Món đồ bà làm rơi là gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "Có lẽ là một chiếc hộp, haizz cũng do trí nhớ của bà không tốt, nếu không quên cho thứ đó vào trong chiếc ấm thì đã không có nhiều chuyện phiền phức như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170113,
					"content": "Có điều nếu chiếc hộp của ta thực sự rơi trên \"Hổ Lao Sơn\", vầy thì tám chín phần bị kẹt ở trong Hổ Phách rồi, như vậy cũng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170114,
					"content": "Các cháu có thể giúp bà đến \"Hổ Lao Sơn\" tìm đồ được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170115,
					"content": "Các cháu phải cẩn thận nhé. Nhiều năm trôi qua rồi, Hổ Phách không biết bị tên đó nhét cái gì vào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				}
			]
		},
