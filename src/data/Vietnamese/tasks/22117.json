			"dialogs": [
				{
					"id": 221170301,
					"content": "Chi bằng cháu mặc thêm đồ đi! Chẳng may bị cảm lạnh là nguy hiểm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170302,
					"content": "Bà ơi, đây là món đồ bà làm rơi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "Để ta xem... Ồ đúng rồi, đây chính là thứ rơi ở trên núi, trí nhớ của ta thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170304,
					"content": "Các cháu đừng nhìn nữa, bên trong chiếc hộp chỉ toàn những thứ nhàm chán mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170305,
					"content": "Ồ, còn đây là quà cảm ơn các cháu đã giúp ta một phen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 221170306,
					"content": "Ôi, phải nhanh chóng đem những cái hộp này đặt vào trong ấm, đừng để quên nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				}
			]
