			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "Có cảm giác gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110302,
					"content": "Sức mạnh của kiếm mạnh mẽ hơn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "Tôi có một suy đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110305,
					"content": "Sau khi thanh kiếm này hấp thu sức mạnh từ kẻ địch, sẽ xảy ra cộng hưởng với xương cốt của Durin đang nằm sâu trong lòng núi tuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110306,
					"content": "Ồ... hình như rất lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110307,
					"content": "Nếu suy đoán này đúng, thì quái vật trên ngọn núi tuyết này cũng có thể cộng hưởng với xương cốt của Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110308,
					"content": "Sao lại cộng hưởng với xương cốt của rồng?",
