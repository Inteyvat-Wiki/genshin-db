					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "E là có liên quan đến nguồn sức mạnh của quái vật nơi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110310,
					"content": "Durin không phải quái vật thông thường. Ngay cả đến ngày nay, khi nó đã chết, thì cả ngọn núi tuyết này vẫn chịu sự ảnh hưởng từ tro cốt của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110311,
					"content": "Sức mạnh bí ẩn của rồng... có lẽ cũng là một lời nguyền nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110312,
					"content": "Thông tin vẫn chưa đủ. Muốn hiểu sâu hơn nữa cần phải có thêm nhiều dữ liệu. Đây cũng là nguyên nhân mà tôi tìm bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110313
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110313,
					"content": "Không ngờ nghe kể chuyện cũng tạo ra công ăn việc làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110314,
					"content": "Tôi có việc nghiên cứu phải hoàn thành, chúng ta nên chia nhau ra hành động. Sau đó gặp nhau ở cầu gãy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110303,
					"content": "Sự phối hợp khác nhau... lại có chung một dòng chảy sức mạnh.",
