			"dialogs": [
				{
					"id": 412110101,
					"content": "Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110102,
					"content": "Về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110103,
					"content": "Chúng tôi đã nỗ lực một thời gian dài rồi, mau xem thử thanh kiếm tiến triển thế nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110104,
					"content": "Bạn xem đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "Ừm... quả nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110106,
					"content": "Đúng như tôi nghĩ, thanh kiếm này trưởng thành dần qua những trận đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110107,
					"content": "Nó đâu phải con người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110108,
					"content": "Cho nên đây mới là điểm đặc biệt của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110109,
					"content": "Đúng rồi, nói chuyện quan trọng trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110110,
					"content": "Tôi đã điều tra khu vực tuyết phủ gần đây, phát hiện được vết tích khác thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110111,
					"content": "A, không phải là trộm chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110112,
					"content": "Không phải bạn nói chúng tôi là trộm chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "Cũng đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110115,
					"content": "Tôi cho rằng những vết tích đó không bình thường, cần phải điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110116,
					"content": "Là trộm hay là thứ gì đó, điều tra xong tự nhiên sẽ có kết luận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110113,
					"content": "Đạo Bảo Đoàn chắc không nghĩ thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121109",
							"2"
						],
						"stepId": 4121109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "Là Fatui sao? Đã thế lại còn chọn doanh trại của Đạo Bảo Đoàn mà tập kích chúng ta... chẳng lẽ chúng theo vết chúng ta đến đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110202,
					"content": "Nhưng sao lại phải đi theo chúng ta chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110203,
					"content": "A! Chắc không phải do bạn kéo theo tôi đi làm chuyện gì phạm pháp chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110204,
					"content": "Bạn làm chuyện gì phạm pháp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110205,
					"content": "Sao lại thế được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "Ồ... vậy không phải lỗi của chúng ta rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110208,
					"content": "Tôi đoán là Fatui cũng đang tìm thanh kiếm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110209,
					"content": "Ể? Không phải bạn giấu thanh kiếm này kỹ lắm sao, Fatui làm sao biết được sự tồn tại của nó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110210,
					"content": "Hoặc là chúng đã nhìn thấy bạn chiến đấu trên núi tuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110211,
					"content": "Nếu chúng có đôi mắt tinh tường chắc sẽ phát hiện điểm khác biệt của thanh kiếm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110212,
					"content": "Sao cái gì Fatui cũng muốn có thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110213,
					"content": "Không phải là cái gì cũng muốn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110214,
					"content": "Tôi nhớ rằng đã nghe qua tin tức có liên quan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "Fatui đang tìm kiếm những món liên quan đến Thần, chắc các bạn cũng đã biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110216,
					"content": "A, nếu thế thì đúng là đã nghe lão gia Diluc nhắc đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110217,
					"content": "Durin là kẻ thù và có sức mạnh tương đương với Phong Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110218,
					"content": "Nói nó là \"sự tồn tại có thể sánh ngang với Thần\" cũng được, là \"sự tồn tại có liên quan đến Thần\" cũng tốt, đều không quá đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110219,
					"content": "Chẳng lẽ thanh kiếm này bị Fatui xem là mục tiêu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110221,
					"content": "Trước đây không lâu tôi có đi xung quanh vẽ cảnh tả thực, thì có một phát hiện mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110222,
					"content": "Từ nơi này đi lên có một chỗ tương đối đặc biệt. Hướng dòng chảy địa mạch khác với những nơi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110223,
					"content": "Quái vật xung quanh bị nó thu hút rồi bị ảnh hưởng bởi nó, theo thời gian, thể chất của chúng cũng mạnh hơn đồng loại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110224,
					"content": "Có chuyện tốt vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110225,
					"content": "Chúng ta cần giúp thanh kiếm này trưởng thành phải không? Nếu đã đến rồi thì cứ tiện thể thử kiếm đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110226,
					"content": "Không sai. Sẵn tiện còn có thể quan sát tác động của kẻ địch khác nhau lên thanh kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110206,
					"content": "Tôi tuyệt đối không làm những chuyện như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
