			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "#Là fae biết bay! Ghi chép của em... Những ghi chép quan trọng đã bị Fatui lấy mất rồi, {F#chị}{M#anh} có thể giúp em lấy lại được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Tuy chị không phải là fae... nhưng việc nhỏ này thì cũng có thể giúp được. Mà nói chứ, tại sao Fatui lại lấy sổ tay của trẻ con vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "#Có lẽ là vì sợ em sẽ công khai nội dung trong cuốn sổ... Nếu {F#hai chị}{M#anh chị} giúp em tìm lại được cuốn sổ, em sẽ kể cho {F#hai chị}{M#anh chị} nghe một bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "#Mà chuyện đó để lát nữa nói sau, giờ nhờ {F#hai chị}{M#anh chị} giúp em <color=#00E1FFFF>tìm lại cuốn sổ</color> nhé. Không chừng là còn có vài <color=#00E1FFFF>trang rơi ra từ cuốn sổ</color> nữa đấy. Chính là ở bên kia, chỗ Fatui đang đứng ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7601816",
							"3"
						],
						"stepId": 7601816,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7609107",
							"2"
						],
						"stepId": 7609107,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7609105",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "Bạn giao lại cuốn sổ và các trang giấy đã lấy được...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "#Để em xem nào... Đúng rồi! Chính là những thứ này, cảm ơn {F#hai chị}{M#anh chị} nhiều. Trong này ghi lại nhiều bằng chứng phạm tội của Fatui lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910205,
					"content": "...Bằng chứng phạm tội á?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910206,
					"content": "Cứ nhìn những công trình mà họ xây dựng trên Đảo Paha đi, cả những thiết bị máy móc họ mang đến nữa... Đó vốn là nhà của rất nhiều loài động vật mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910207,
					"content": "Em vừa từ Lưu Vực Maroon trở về, chắc chắn là do cỗ máy của Fatui nên những con sứa ở đó mới đang thoi thóp... Em phải cho mọi người biết chuyện này mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910208,
					"content": "Hả? Là đang nói đến \"Thạch Dâu Đỏ\" phải không? Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910209,
					"content": "Bạn kể lại những trải nghiệm tại Lưu Vực Maroon...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "Đã quá muộn rồi sao... Nhưng dù thế nào thì cũng phải ghi chép lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910211,
					"content": "#Cuốn sổ này giao cho {F#hai chị}{M#anh chị} đấy. Em phải quay về sắp xếp lại nội dung của những cuốn sổ khác và viết thành bài báo mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910213,
					"content": "#À phải rồi, nếu {F#hai chị}{M#anh chị} nói chuyện này với người khác thì nhớ phải nói là do Semyon, tức là do em kể đấy nhé. Dù sao thì để viết thành báo và đăng lên cũng cần thời gian mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910214,
					"content": "#Dù sao thì cũng cảm ơn {F#hai chị}{M#anh chị} nhiều. Tạm biệt nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
