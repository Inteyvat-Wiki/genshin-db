			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#Ây da, đây không phải là {NICKNAME} và Paimon sao? Không ngờ lại có thể gặp hai người ở đây. Đây chắc chắn là duyên phận kỳ diệu mang lại may mắn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "Dori? Sao cô lại ở đây một mình? Lẽ nào đang bày hàng bán đồ sao? Hmm, mà sao tôi không thấy hàng hóa của cô đâu cả vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Thật ngại quá, hôm nay thương nhân lữ hành lừng danh Dori tạm thời nghỉ bán hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "Tôi giờ đang học theo những người dân Nod-Krai bản xứ, trải qua một ngày bình thường tự do tự tại trong miền đất hứa này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Hả, thật không? Dori mà không bận rộn buôn bán kiếm Mora à? Còn hiếm hơn cả trời mưa trong sa mạc nữa đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Hừ, cho dù bản thân đang tận hưởng một kỳ nghỉ hiếm có, thì những cửa hàng và nhân viên cần cù chăm chỉ của tôi vẫn đang không ngừng kiếm Mora về cho tôi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "Chỉ cần con số trên tài khoản của tôi vẫn đang tăng vùn vụt thì chẳng có gì phải lo lắng cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Nói vậy thì, hai người lẽ nào đã gặp phải vấn đề gì khó khăn sao? Tuy tôi đang nghỉ, nhưng đối với những mối làm ăn tự tìm đến cửa thì tôi chưa bao giờ từ chối cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "Chúng tôi đang tham quan xung quanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "Ồ, ra là muốn ghi lại phong cảnh độc đáo của Nod-Krai à? Vậy thì hai người hỏi đúng người rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "Mức độ quen thuộc của tôi với nơi này tuy có thể không bằng người bản địa, nhưng nói về những điểm chụp ảnh có phong cảnh độc đáo thì tôi vẫn có thể giới thiệu cho đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "Nể tình chúng ta thân thiết như vậy, để tôi đích thân làm hướng dẫn viên cho, giá vô cùng hữu nghị, một ngày chỉ lấy vỏn vẹn 500.000 Mora thôi! Thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "Ồ... Không hổ danh là Dori, vẫn là ba câu không rời chuyện móc Mora từ túi chúng tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "Ây da, tất cả những điều tôi làm đều là vì những khách hàng quan trọng nhất của mình, để hai người có thể lưu lại một kỷ niệm vui vẻ đáng nhớ nhất ở Nod-Krai mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Nếu cô đã nhiệt tình như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "Ủa? Chụp ảnh cho tôi? Đề nghị này nghe cũng thú vị đấy. Mà này, mấy tấm ảnh này không được dùng để quảng cáo thương mại đâu nhé, bản quyền hình ảnh của tôi là vô giá đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Yên tâm đi, chúng tôi chỉ đơn thuần muốn chụp một tấm ảnh cho người quen cũ để làm kỷ niệm thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Được được, nếu {NICKNAME} đích thân mở lời thì tôi sẽ phá lệ. Nhất định phải chụp tôi thật sang trọng, quý phái và khí chất hơn người đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Để tôi nghĩ xem nào... Chủ đề cho bức ảnh thì cứ gọi là \"Kỳ Nghỉ Ở Thiên Đường Của Dori Sangemah Bay\". Có tuyệt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "Tôi có thể chụp ảnh cho cô không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "Nhân tiện tìm kiếm tư liệu chụp ảnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
