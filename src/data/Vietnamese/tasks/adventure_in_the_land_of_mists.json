					"nextDialogs": [
						751330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330302,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#Không hổ danh là {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "Nhưng đừng tự mãn nhé, còn nhiều thử thách đang chờ đợi chúng ta đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330305,
					"content": "Cửa vào đã mở rồi, dù sao đi nữa thì chúng ta cũng phải xuống dưới để tìm hiểu rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330306,
					"content": "Tôi cũng đồng ý với Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330307,
					"content": "Cheep... Cheep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330308,
					"content": "Ơ? Coco, có phải đang sợ hãi không? Không thể lùi bước ở đây được, cuộc phiêu lưu của chúng ta mới chỉ hoàn thành một nửa thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330309,
					"content": "Ku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330310,
					"content": "Bona, đừng ép Coco, trông nó thật sự sợ hãi đấy. Không lẽ bên dưới có thứ gì đó nguy hiểm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330311,
					"content": "Thật đáng sợ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#Này, sao {NICKNAME} cũng bắt đầu sợ rồi? Hãy phấn chấn lên chứ, như {REALNAME[ID(2)|SHOWHOST(true)]} ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330313,
					"content": "Tôi bắt đầu thấy háo hức rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "#Không ngờ {NICKNAME} lại hăng hái như vậy đấy. Mặc dù tôi nghĩ thứ bên dưới cũng không phải là đối thủ của {NICKNAME} đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330315,
					"content": "Đừng lo, chúng ta đã có Saurian dũng cảm mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "Rawr... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "Nếu Coco sợ như vậy thì cứ để nó ở đây nhé. À, nhưng cũng không thể để Coco ở lại một mình được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330318,
					"content": "Xem ra không còn cách nào khác rồi, vậy tôi ở lại trên này với Coco nhé. Để thể hiện thành ý, tôi sẽ giao Hỏa Lân Thạch cho hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330319,
					"content": "Nói trước nhé, bất kể các vị phát hiện ra gì ở dưới thì cũng phải quay lại đây gặp tôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330320,
					"content": "Chúng tôi sẽ không bỏ rơi đồng đội đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330321
					]
				},
				{
					"id": 751330321,
					"content": "Vậy thì tốt rồi. Tôi sẽ ở đây chờ hai vị quay lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330322
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330322,
					"content": "Vậy thì ở đây chờ chúng tôi quay lại nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330323
