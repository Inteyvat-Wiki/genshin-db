					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "Không ngờ Coco lại đưa chúng ta đến đây. Trông giống như nơi chúng ta gặp Bona nhỉ, đúng là một pháo đài kỳ quái mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330102,
					"content": "Nhìn kìa, ở đây cũng có một bức bích họa giống hệt. Hmm... Nhưng bức này lại không có dấu vết bị xóa đi, có phải vì ở đây quá cao không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME} nói xem, hình vẽ trên đó chắc không phải là Xà Vương mà Bona vừa nói đến đấy chứ. Nhìn qua đã thấy không phải là thứ dễ đối phó mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330104,
					"content": "Ừm, đây chính là Xà Vương Och-Kan. Truyền thuyết kể rằng người này đã áp bức nhân dân một cách tàn nhẫn để xây dựng Tonatiuh, cho đến khi thu hút Vực Sâu, dẫn đến cái chết của bản thân và sự diệt vong của đất nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330105,
					"content": "Nhưng đây chỉ là truyền thuyết thôi. Vì ngay cả người kể chuyện trong bộ tộc cũng kể mấy trường hợp khác nhau về kết cục của Xà Vương mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330106,
					"content": "Biết đâu bây giờ hắn ta vẫn lang thang trên Tonatiuh và sống bằng kho báu. Hoặc có thể con rồng tà ác ngăn cản chúng ta chính là linh hồn báo thù của hắn không chừng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330107,
					"content": "Kuchi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330108,
					"content": "Đừng có nói những điều kinh khủng như vậy chứ! Đến cả Coco cũng bị dọa cho sợ rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330109,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#Kể từ khi đánh bại con rồng xấu xa đó thì {REALNAME[ID(2)|SHOWHOST(true)]} luôn tỏ ra háo hức. Không lẽ nó đang bí mật tham gia cuộc thi mạo hiểm cùng với Coco sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330111,
					"content": "Vậy cuối cùng thì tế đàn mà chúng ta đang tìm là ở đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330112,
					"content": "Nếu hướng mà Coco chỉ không sai thì là ở dưới này... Mà chờ đã, tôi tưởng là sẽ ở nơi cao hơn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330113,
					"content": "Chắc nhầm ở đâu rồi, Tế Đàn Lửa Nguồn chắc chắn không thể giấu ở giữa lòng núi được. Nếu không thì chẳng phải cần đánh sập cả ngọn núi để đưa chúng ta lên trời sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330114,
					"content": "Chẳng lẽ có phương pháp dịch chuyển đặc biệt sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "Ôi, vừa nãy ở dưới còn nói một cách chắc chắn, giờ thì khó rồi. Hơn nữa, chúng ta lại không hiểu Coco đang nói gì, cũng không biết nó có ý gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330116,
					"content": "Kulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330117,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} có ý tưởng gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330119,
					"content": "Tôi biết rồi. Ý nó là nếu chỉ vận dụng logic một cách khô khan thì cuộc phiêu lưu này sẽ không thể tiếp tục!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330120,
					"content": "Cô lại bịa ra chứ gì!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330121,
					"content": "Tóm lại, bất kể bên dưới là gì thì tôi nghĩ chúng ta cũng nên đi khám phá một chút. Đây cũng là một phần của cuộc phiêu lưu mà nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330122,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#Ừm, không ngờ {REALNAME[ID(2)|SHOWHOST(true)]} lại hăng hái như vậy. Vậy chúng ta hãy điều tra xem làm thế nào để xuống dưới nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
