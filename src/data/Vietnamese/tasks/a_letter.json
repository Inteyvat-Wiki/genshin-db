						741270506
					]
				},
				{
					"id": 741270506,
					"content": "#{NICKNAME}! À không... Nên gọi là Nhà Nghiên Cứu Danh Dự Cấp Cao! Rất vui được gặp mặt.",
					"roleType": "TALK_ROLE_NPC",
