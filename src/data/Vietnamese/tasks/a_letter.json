					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "Chà... Đây chính là \"Công Viên Kỷ Niệm Mary-Ann\" sao? Hoàn toàn nhìn không ra dáng vẻ của công viên đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270202,
					"content": "Ngài Roialte chắc phải thất vọng rồi, ngài ấy còn dự tính mời người đến đây diễn thuyết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270203,
					"content": "Không gian ở đây chắc không thể diễn thuyết được rồi... Cả kiến trúc tiêu biểu cũng không có, muốn chụp ảnh cũng không chụp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270204,
					"content": "Có thể bắt vài con robot về làm kỷ niệm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "Haha, đúng là hài hước. Nhưng trong Sảnh Phúc Luật không có chỗ để đặt những thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270206,
					"content": "Với lại dù muốn đem về thì tôi cũng phải đem chúng đi định giá, lập hồ sơ, phân loại, sau đó niêm phong cất giữ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270207,
					"content": "Này! Chúng tôi chỉ nói đùa thôi, đừng nghiêm túc quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270208,
					"content": "Nói đến lập hồ sơ... Tôi còn chưa lấy được tập tài liệu đó, ngài Roialte chắc lại thất vọng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270209,
					"content": "Choiseul làm khó anh à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "Cũng không tới mức đó. Yêu cầu của tôi quả thực có chút trái với quy định, ngài ấy không chịu cũng là chuyện thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270212,
					"content": "Chuyện là thế này, Viện Khoa Học Fontaine đang lên kế hoạch xây lại, nên một số việc điều phối nhân viên và vật tư cần phải trao đổi thông qua Sảnh Phúc Luật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270213,
					"content": "Sảnh Phúc Luật rất xem trọng chuyện này, thế là để ngài Roialte thành lập đội khảo sát đến Viện Khoa Học khảo sát thực địa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270214,
					"content": "Thế là ngài Roialte ở lại Sảnh Phúc Luật thống kê nhân viên, tôi đến Viện Khoa Học hỗ trợ việc tiếp đón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270215,
					"content": "Vừa đúng lúc Viện Khoa Học cần gửi một bức thư về Sảnh Phúc Luật. Tôi liền nghĩ, dù sao cũng đến đây rồi, nên tiện tay mang thư về thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270216,
					"content": "Nhưng ngài Choiseul lại nói chuyện này không phù hợp quy định, nói thế nào cũng không đưa cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270217,
					"content": "Không phù hợp? Lại không phù hợp dòng quy định nào chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270218,
					"content": "Lấy phần tài liệu cũng có quy định à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "Vậy chắc là kiểu chạy tới chạy lui đóng dấu, ký tên đủ chỗ, cuối cùng là nghe người ta càm ràm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270220,
					"content": "Nói đơn giản, phần lớn thư từ công vụ trong Sảnh Phúc Luật đều buộc phải gửi qua bưu điện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270221,
					"content": "Vậy... vậy lỡ như nơi muốn gửi thư chỉ cách con phố, hoặc nói thẳng ra là đối diện luôn thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270222,
					"content": "...Cũng phải dùng bưu điện, chuyện này là để có thể truy được ra nguồn gốc tất cả thư từ trong Sảnh Phúc Luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270223,
					"content": "Họ đúng là không ngại phiền đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "Tôi nghĩ mọi người đã quen với phiền toái rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270225,
					"content": "Thôi kệ, không nói chuyện này nữa, chúng ta đến nơi tiếp theo đi. Để tôi xem bảng ghi chú mà ngài Roialte viết nào... Ối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270226,
					"content": "Nơi này gọi là... \"Hội Trường Học Thuật\" của Viện Khoa Học Fontaine. Thật kỳ lạ, lúc tôi đến không thấy kiến trúc nào như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270227,
					"content": "Tôi biết ở đâu rồi, đi theo tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "Đúng là đáng tin cậy! Một mình tôi thì sao có thể làm xong việc đây chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270229,
					"content": "Vậy chúng ta mau xuất phát thôi, ở đây có nhiều robot mất kiểm soát quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270211,
					"content": "Anh và Choiseul thảo luận gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
