				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "...Như tôi đã nhấn mạnh trước đây thì quy định là vậy, tôi không thể làm gì được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270102,
					"content": "Quả thực ngài Roialte đã gửi danh sách tài liệu cần thiết đến, tôi cũng chuẩn bị xong những tài liệu kia rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270103,
					"content": "Nhưng cậu không thể cứ đến đây rồi \"lấy tài liệu đi\" như thế, chuyện này không phù hợp với quy định gửi thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270104,
					"content": "Hả? Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "Chào nhé Iaune! Trông anh khá ổn nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270108,
					"content": "Đều nhờ có sự hỗ trợ của ngài Roialte và ngài Semaine cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270109,
					"content": "#Hả? Iaune, cậu và {NICKNAME} quen nhau à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270110,
					"content": "#Đương nhiên, trước đây {NICKNAME} giúp đỡ tôi rất nhiều. Nếu không có {F#cô}{M#cậu} ấy thì tôi đã không thể tiếp tục làm việc ở Sảnh Phúc Luật nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270111,
					"content": "#Còn có chuyện này sao? {NICKNAME} quả không hổ danh là Nhà Nghiên Cứu Danh Dự Cấp Cao của Viện Khoa Học Fontaine, hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270112,
					"content": "Tôi rất giỏi ủng hộ tinh thần đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "Dù sao thì nếu không có được sự hỗ trợ đó thì tôi cũng không thể nào chống chọi tiếp được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270115,
					"content": "#Vừa rồi tôi nghe ngài Choiseul nói {F#cô}{M#cậu} là \"Nhà Nghiên Cứu Danh Dự Cấp Cao\" của Viện Khoa Học Fontaine sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270116,
					"content": "Dĩ nhiên rồi, tôi còn có giấy khen đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "Còn chụp ảnh nữa đó! Trong bức ảnh còn có tôi nữa, nhưng tiếc là tôi không có giấy khen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270118,
					"content": "#Đúng thế, để khen ngợi thành tích trước đó, viện của chúng tôi đã trao cho {NICKNAME} danh hiệu Nhà Nghiên Cứu Danh Dự Cấp Cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270119,
					"content": "#Còn về chuyện là thành tích gì... thì để {NICKNAME} đích thân kể nhé. Chúng ta tiếp tục bàn chuyện chính thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270120,
					"content": "Quả thực tôi không thể đưa cho cậu bản tài liệu kia vào lúc này được, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270121,
					"content": "Nhưng lúc trước cậu đã nói muốn mời một nhà nghiên cứu dẫn đường đi chụp ảnh kỷ niệm ở gần Viện Khoa Học Fontaine... Chuyện này thì không thành vấn đề!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270122,
					"content": "#Tôi cho rằng {NICKNAME} hoàn toàn làm được, {F#cô}{M#cậu} ấy rất quen thuộc địa hình ở đây, nên có thể đảm nhiệm công việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270123,
					"content": "#{NICKNAME} thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270124,
					"content": "Không thành vấn đề, cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "#Có {NICKNAME} giúp đỡ thì tôi yên tâm rồi. Lúc tôi đến nhìn thấy xung quanh toàn là máy móc mất kiểm soát với ma vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270127,
					"content": "Nhưng chuyện ảnh kỷ niệm không phải vấn đề chính... Nói thật nhé, ngài Choiseul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270128,
					"content": "Iaune, tôi cũng muốn giúp, nhưng quy định là như thế rồi. Đừng làm khó chuyên viên hành chính chỉ biết đóng dấu như tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270129,
					"content": "Được rồi... Để tôi quay về bàn bạc lại với ngài Roialte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270130,
					"content": "Tạm biệt ngài Choiseul, chúc một ngày vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270131,
					"content": "Cảm ơn, chúc cậu có quãng thời gian vui vẻ tại Viện Khoa Học Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270132,
					"content": "#{NICKNAME}, vậy thì chúng ta đến \"Công Viên Kỷ Niệm Mary-Ann\" trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270125,
					"content": "Rất vui được giúp đỡ Iaune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "Tôi chỉ sửa máy đóng dấu tự động thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "Lát nữa tôi sẽ đến đây sau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}! Trùng hợp quá, rất vui được gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "Iaune"
				}
			]
		},
