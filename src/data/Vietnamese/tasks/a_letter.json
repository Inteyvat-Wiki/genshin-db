			"dialogs": [
				{
					"id": 741270401,
					"content": "Ôi trời... Đúng là quá cao, quá cao rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270402
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270402,
					"content": "Anh đang nói về trình độ học thuật của Viện Khoa Học hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270403
					]
				},
				{
					"id": 741270403,
					"content": "Không, tôi đang nói về độ cao ở đây. Tuy là trình độ học thuật của Viện Khoa Học cũng không hề thấp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270404
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270404,
					"content": "Còn bây giờ thì... Haiz, ai ngờ Viện Khoa Học lại gặp chuyện như vậy chứ? Cũng không biết công việc xây lại có thể thuận lợi không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270405,
					"content": "Điểm đến cuối cùng là... \"Văn Phòng Thẩm Định Tư Chất Bên Ngoài Viện Khoa Học Fontaine\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270406,
					"content": "Không ngờ anh có thể một hơi đọc hết được đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270407
					]
				},
				{
					"id": 741270407,
					"content": "Cảm ơn nhé, nhưng mà nơi đó ở đâu? Tôi ở Viện Khoa Học chưa thấy qua văn phòng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270408,
					"content": "Người phụ trách văn phòng là Desnos đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270409
					]
				},
				{
					"id": 741270409,
					"content": "#Đúng! {F#Cô}{M#Cậu} biết sao? Quả không hổ danh là Nhà Nghiên Cứu Danh Dự Cấp Cao, cái gì của Viện Khoa Học cũng biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270410,
					"content": "Hừm... Tôi nhớ rồi! Là văn phòng ở trong phế tích đúng không? Nơi đó có được tính là văn phòng không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270411,
					"content": "Có lẽ ngài Desnos đã tạm lược bỏ phần tiền tố để dễ hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270412
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270412,
					"content": "#Nhờ {F#cô}{M#cậu} dẫn đường nhé, tôi phải đến tìm ngài Desnos để lấy một vài văn kiện. Sau khi lấy xong tôi sẽ quay về Sảnh Phúc Luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270413,
					"content": "Hôm nay đúng là thuận lợi, sắp quay về nghỉ ngơi được rồi. Tác phong của Viện Khoa Học Fontaine quả nhiên khác với... Khụ, tôi chưa nói gì hết nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
