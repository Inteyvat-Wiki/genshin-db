			"dialogs": [
				{
					"id": 741270301,
					"content": "Đây chính là \"Hội Trường Học Thuật\" của Viện Khoa Học Fontaine sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270302,
					"content": "Tôi thừa nhận kiến trúc này nhìn có vẻ giống hội trường, nhưng học thuật thì ở đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270303,
					"content": "Học thuật thì ở trong đầu các nhà nghiên cứu đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "Được rồi, may mà hôm nay tôi đến không phải vì học thuật. Dù sao thì kiến trúc này xem ra cũng rất... hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270306,
					"content": "Cũng chỉ còn lại từng này thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "Khụ! Chúng ta đi xung quanh nào, tôi thấy nơi này rất thích hợp để chụp một tấm ảnh nhóm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270308,
					"content": "Tôi phải đi tìm góc tốt, tránh cho ngài Roialte hỏi tới tôi lại luống cuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270309,
					"content": "#{NICKNAME} giúp tôi chụp vài tấm ảnh nhé. Tôi nghe nói {F#cô}{M#cậu} rất thạo chụp ảnh, nên chắc sẽ chụp tốt hơn tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270310,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "Dù gì cũng sẽ không ở trong mấy cục đá đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
