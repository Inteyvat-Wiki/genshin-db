					"speakerTitle": "Desnos"
				},
				{
					"id": 741270507,
					"content": "Iaune, sao ủ rũ vậy? Xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270508
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270508,
					"content": "Haiz... Sự việc là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270509
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270509,
					"content": "Iaune kể lại những chuyện đã qua...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270510
					]
				},
				{
					"id": 741270510,
					"content": "Ấy? Bức thư này... là tài liệu quan trọng gì à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270511
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270511,
					"content": "Không phải, thông tin bên trong cũng là mấy lời kiểu \"tôi biết rồi\", \"không có vấn đề gì\", \"tôi không biết\" thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270512
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270512,
					"content": "Cùng lắm là sao chép thư và gửi cho các bộ phận khác để thông báo cho mọi người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270513
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270513,
					"content": "Ồ, chẳng trách sao tôi cũng nhận được... Anh xem phải cái này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270514
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270514,
					"content": "Sao? Ngài Choiseul rõ ràng nói là chưa gửi đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270515
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270515,
					"content": "...Ừm, ngài ấy nói là \"thư gửi ra ngoài\" vẫn chưa gửi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270516
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270516,
					"content": "Anh ta lại không nói rõ ràng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270517
					]
				},
				{
					"id": 741270517,
					"content": "Người của Viện Khoa Học Fontaine... vẫn giỏi khiến người ta thấy không vui nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270518,
					"content": "Xem ra đây là tài liệu mà anh cần, tôi cũng xem vài lần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270519
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270519,
					"content": "Cái này giống với thứ anh cần sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270520
					]
				},
				{
					"id": 741270520,
					"content": "#{NICKNAME} đúng là nhạy bén. Iaune, tất cả thư mà Choiseul gửi đi chắc đều giống hệt nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270521
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270521,
					"content": "Vậy thì anh cứ lấy của tôi về nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270522
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270522,
					"content": "Ấy? Chờ đã, nếu Iaune lấy đi rồi thì anh như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270523,
					"content": "Hahaha, sẽ không ai để ý tôi bất cẩn làm mất một bức thư có cũng như không đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270524,
						741270525
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270524,
					"content": "Đúng thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				},
				{
					"id": 741270526,
					"content": "Vậy ly cà phê này tôi không uống không rồi nhé, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270527
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270527,
					"content": "Nhưng như vậy không phù hợp quy định. Tôi quay về đợi thư chính thức vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270528
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270528,
					"content": "...Iaune! Đầu óc linh hoạt chút đi, sao phải tự giày vò bản thân thế chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270529
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270529,
					"content": "Bức thư đó ai biết khi nào tới tay. Lấy thư sớm một ngày thì anh làm việc sớm một ngày, nhanh chóng chấm dứt chuyện phiền phức này còn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270530
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270530,
					"content": "Cảm ơn ý tốt của anh, nhưng tôi sẽ không làm trái quy định đâu. Nghề nghiệp của tôi yêu cầu phải như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270531
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270531,
					"content": "#{NICKNAME}, Desnos, còn có Paimon, tôi xin cáo từ trước. Ngài Roialte vẫn đang chờ tôi về báo cáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270532
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270532,
					"content": "Iaune nặng nề rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270533
					]
				},
				{
					"id": 741270533,
					"content": "...Haiz, Iaune thật khờ và cứng nhắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270534
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270534,
					"content": "Ai cũng muốn bản thân dễ sống chút, thế mà anh ta lại tự giày vò. Nhưng đây cũng không phải chuyện to tát gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270535,
						741270536
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270535,
					"content": "Tính cách của anh ta như thế rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270537,
					"content": "Đúng là khiến người ta vừa nể vừa sợ. Chẳng trách sao không có mấy bạn bè ở Sảnh Phúc Luật, chỉ có Roialte và Semaine làm bạn với anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270538
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270538,
					"content": "Tôi cũng là bạn của anh ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270539
					]
				},
				{
					"id": 741270539,
					"content": "Tôi cũng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270540,
					"content": "Haha, vậy cũng không tệ. Nên thường xuyên nói chuyện với anh ta nhé, tôi thấy cảm xúc của Iaune càng ngày càng tệ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270541
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270541,
					"content": "Chuyện thư từ tôi sẽ nghĩ cách. Tôi lát nữa đi tìm Choiseul để nhờ anh ta giao việc gửi thư cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270542
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270542,
					"content": "Nếu anh ta đồng ý thì tôi sẽ mau chóng gửi thư cho Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270543
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270543,
					"content": "Haiz, làm bạn với kẻ khờ đúng là khổ mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270536,
					"content": "Iaune chính là người như thế mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270525,
					"content": "Vậy sự việc không phải được giải quyết rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				}
			]
		},
