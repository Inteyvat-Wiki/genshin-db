			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442401,
					"content": "\"...Mong rằng vinh quang mãi mãi... người tạo ra hòa bình... nhân từ... Och-Kan...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "\"...Thợ thủ công Mahutzintl, Tlanalco, và... phụ trách xây bơm nước... Làm việc lười biếng dẫn đến chậm trễ... Nhân từ... không trừng phạt... Tạm ngừng tiếp tế ba tuần...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "\"...Khởi động <color=#00E1FFFF>chìa khóa đá</color> của <color=#00E1FFFF>máy bơm nước</color>... đặt ở... Không được tự ý... cho đến khi điều phối thợ thủ công khác...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
