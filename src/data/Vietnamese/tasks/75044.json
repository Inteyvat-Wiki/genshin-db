				{
					"id": 750444501,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444502
					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444502,
					"content": "Hừm, xem ra thứ này chưa đúng lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504446,
			"completionStepIds": [
				7504402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750444601,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444602
					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444602,
					"content": "Ồ, thì ra là thứ này. Có vẻ phải có chút màu đỏ mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444603,
					"content": "Nhưng mà, hmm? Thứ chúng ta cho vào trước đó giờ biến mất rồi... Đúng là chúng ta cho vào rồi mà nhỉ? Đợi đã, cứ cảm thấy kỳ quái sao ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444604,
					"content": "Trong lọ hình như có thứ gì khác kìa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444605,
					"content": "(Gõ vào lọ)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504447,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750444701,
					"content": "(Nét chữ non nớt viết ẩu:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "Ghi Chép Của Trẻ Nhỏ"
				},
				{
					"id": 750444702,
					"content": "Trò chơi này tên là \"Bing Bong Ding Dong\", quy tắc như sau:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "Ghi Chép Của Trẻ Nhỏ"
				},
				{
					"id": 750444703,
					"content": "1. Khi Bing Bong Monetoo không còn ding-dong nữa, cưỡi trên lưng tượng Saurian thì bức tượng sẽ tiến về phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "Ghi Chép Của Trẻ Nhỏ"
				},
				{
					"id": 750444704,
					"content": "2. Khi Bing Bong Monetoo đếm ngược đến \"ding!\", thì buộc phải xuống khỏi bức tượng Saurian, nếu không sẽ thua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "Ghi Chép Của Trẻ Nhỏ"
				},
				{
					"id": 750444705,
					"content": "3. Ai chạy đến bên cạnh Bing Bong Monetoo sớm nhất sẽ giành chiến thắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "Ghi Chép Của Trẻ Nhỏ"
				},
				{
					"id": 750444706,
					"content": "Không được phép nói \"thực chất chính là trò trốn tìm mà\". Quy tắc rất quan trọng. Hơn nữa, chính vì thiếu tôn trọng quy tắc mà mọi người mới không thắng nổi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ghi Chép Của Trẻ Nhỏ"
				}
			]
		}
	]
