		{
			"id": 7504407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "Sân tuyển Saurian tầng trên mở cả ngày, người và Saurian muốn tham gia buổi đặc huấn của Matahga hãy đến tầng trên khởi động. Nhớ là:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "Khẩu Hiệu Nổi Bật"
				},
				{
					"id": 750440702,
					"content": "Hãy lấy việc huấn luyện nghiêm túc làm vinh dự, lấy sự lười biếng tiêu cực làm nỗi ô nhục!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "Khẩu Hiệu Nổi Bật"
				},
				{
					"id": 750440703,
					"content": "Hôm nay không cố gắng, ngày mai ngậm trái đắng!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "Khẩu Hiệu Nổi Bật"
				},
				{
					"id": 750440704,
					"content": "Cố gắng tiến về phía trước, trở thành kỵ sĩ Saurian xuất sắc!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khẩu Hiệu Nổi Bật"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "Khẩu lệnh là thổi tù và bên trái trước, rồi đến bên phải, sau đó là bên trái, cuối cùng là bên phải. Đừng thổi lung tung, hậu quả tự chịu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "Matahga! Hãy Nhớ Kỹ!!"
				},
				{
					"id": 750440802,
					"content": "Tốt nhất cho ăn một chút thịt gia cầm, để tránh tâm trạng của Saurian không tốt khiến bản thân bị mổ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "Matahga! Hãy Nhớ Kỹ!!"
				},
				{
					"id": 750440803,
					"content": "(Có vẻ đây là lời nhắc nhở mà một người tên Matahga viết cho chính mình. Dù chỉ thông qua văn bản, nhưng cũng cảm nhận được cảm xúc mãnh liệt.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "Matahga! Hãy Nhớ Kỹ!!"
				},
				{
					"id": 750440804,
					"content": "(Nhưng mà thêm dấu chấm than vào cuối mỗi lời nhắc nhở cũng giống như không thêm nhỉ?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga! Hãy Nhớ Kỹ!!"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "\"...Phụng lệnh Người Canh G{RUBY#[D]Yajaw K'ahk'}iữ Lửa Thánh, thánh{RUBY#[D]Ti'sakhuun} vương bệ{RUBY#[D]Kalomte} hạ Och-Kan vinh quang, để xây dựng công trình thủy lợi, nay tuyển dụng lao động tại các bộ tộc...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "\"...Không có định mức, hoàn toàn tự giác tự nguyện... Xây dựng liên minh... Mong các bộ tộc tích cực hưởng ứng...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "\"Phụng lệnh Người Canh G{RUBY#[D]Yajaw K'ahk'}iữ Lửa Thánh, thánh{RUBY#[D]Ti'sakhuun} vương bệ{RUBY#[D]Kalomte} hạ Och-Kan vinh quang, bắt đầu từ hôm nay phong tỏa khu vực bị nguyền rủa. Tất cả thành viên liên minh đều cấm vào.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "\"Kẻ tự ý vào sẽ bị xem là kẻ thù của liên minh. Đây là tuyên ngôn chung của (...), Nanatzcayan, Meztli, Huitztlan và Teteocan.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "\"Nguyện vinh quang mãi thuộc về Người Canh G{RUBY#[D]Yajaw K'ahk'}iữ Lửa Thánh, Người Tạo Dựng {RUBY#[D]Q'atal Tzij}Hòa Bình Vĩ Đại, Thánh{RUBY#[D]Ti'sakhuun} Vương Och-Kan nhân từ.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "\"Do tiến độ tổng thể của công trình xả nước khu vực này tương đối chậm, để đảm bảo thắng lợi không thể ngăn cản của liên minh, nay tiến hành điều chỉnh nhỏ đối với chế độ thay phiên.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "\"Chia công nhân thành ba đội, mỗi đội làm việc mười sáu giờ, lặp lại chu kỳ hai ngày một lần. Đội có thành tích xuất sắc sẽ được thưởng thêm lương thực.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "\"Ánh sáng chiến thắng của việc <color=#00E1FFFF>thoát nước</color> đã gần kề. Một khi con kênh hoàn thành, <color=#00E1FFFF>máy bơm nước</color> sẽ có thể hoạt động bình thường. Cố lên một chút nữa!\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "\"...Hỡi đồng bào, người thân, anh chị em đã cống hiến cho chiến thắng không thể ngăn cản của liên minh...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "\"...Nhân từ... Từ (...) điều một lô thiết bị mới để chi viện vận chuyển, (...) và <color=#00E1FFFF>trục vớt dưới nước</color>...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "\"...Tiến lên, tiến lên nữa, không từ mọi giá để tiến lên... Vì tương lai huy hoàng của liên minh, vì tự do và vinh quang của mỗi người chúng ta, vì quê hương không còn bị đè nén bởi con rồng độc ác...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "\"...Chưa được cho phép... Cấm tự ý chạm vào <color=#00E1FFFF>cần điều khiển</color>... Tai nạn... đã khiến ba công nhân...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "\"...Phía sau bức tường đá ở phía bắc, có một con đường nhỏ dẫn đến phía trên thác nước. Hình như có thể dùng để làm <color=#00E1FFFF>kho</color>...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "\"...Tôi đã đánh dấu vài chỗ, để tránh sau này quên mất đường đi...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "\"...Vết thương của Sayani lại xấu đi, môi trường quá ẩm ướt... Khuyên cô ấy nghỉ ngơi, nhưng cô ấy cười từ chối... Nói rằng sẽ làm chậm tiến độ của cả đội, khiến mọi người không nhận được thêm tiếp tế...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "\"...Ban đêm, nhân lúc người khác không chú ý, tôi đã lén lút đem cho cô ấy một ngọn đuốc để đốt vết thương, nếu không tứ chi của cô ấy cũng sẽ thối rữa...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
