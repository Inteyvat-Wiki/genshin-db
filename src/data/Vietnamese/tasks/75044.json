			"dialogs": [
				{
					"id": 750444401,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444402
					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444402,
					"content": "Nhìn kỹ lại thì... Không biết tại sao chỉ có cái lọ trước mặt Monetoo này lại trống rỗng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444403,
					"content": "Lẽ nào... Những Monetoo khác đều tìm được thứ cần tìm, chỉ có Monetoo này là không sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444404,
					"content": "#Thật đáng tiếc... {NICKNAME}, hay là chúng ta giúp nó tìm xem? Chắc thứ ở trong lọ này... À mà phải bỏ thứ gì vào lọ này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444405,
					"content": "(Đặt Vào)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504445,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
