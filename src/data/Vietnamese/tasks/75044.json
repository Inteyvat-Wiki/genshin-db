		{
			"id": 7504436,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443601,
					"content": "(Tiểu thuyết lãng mạn do Dorothy Leeckson viết. Bìa đã phai màu, một người phụ nữ nằm trên cái giường đầy hoa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "\"Hoa Oải Hương\""
				},
				{
					"id": 750443602,
					"content": "(Sau khi đọc qua quyển sách này, bạn cảm thấy ấm áp và thỏa mãn, nhưng không có được bất kỳ gợi ý hữu ích nào.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "\"Hoa Oải Hương\""
				},
				{
					"id": 750443603,
					"content": "Vậy... rốt cuộc người đó là người làm vườn của cô ấy hay là anh rể thứ hai của em họ của bạn thân của cô ấy? Ôi, đau đầu quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(Tiểu sử của thanh tra Frank Drebin đã nghỉ hưu thuộc Đội Hắc Ảnh Marechaussee Fontaine. Đúng vậy, ngài thanh tra chính là một con mèo trắng nhanh nhẹn.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "\"Thám Tử Mèo Trắng\""
				},
				{
					"id": 750443702,
					"content": "(Trên trang bìa của cuốn sách này in một dấu chân mèo to, có lẽ là dấu ấn đặc biệt mà thanh tra để lại cho cấp dưới.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "\"Thám Tử Mèo Trắng\""
				},
				{
					"id": 750443703,
					"content": "Gì chứ... Lẽ ra cũng nên viết một quyển sách cho tôi nữa, gọi là... \"Thám Tử Tóc Trắng\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504438,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443801,
					"content": "(Tác phẩm của nhà viết kịch Fontaine, Jean Brooklyn. Quyển sách đủ dày để người nhỏ con kê chân.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Lược Sử Teyvat - Phần I\""
				}
			]
		},
		{
			"id": 7504439,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443901,
					"content": "(Một tập ảnh không được yêu thích lắm, bên trong có nhiều bức tranh các cô gái xinh đẹp.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443902
					],
					"speakerTitle": "\"Tuyển Tập Quảng Cáo Nước Hoa Fontaine\""
				},
				{
					"id": 750443902,
					"content": "Hừm... Chỉ có hình các cô gái thôi à? Chán quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
