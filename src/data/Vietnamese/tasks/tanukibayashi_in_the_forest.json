			"dialogs": [
				{
					"id": 721080101,
					"content": "Cuối cùng cũng đến rồi, đây có lẽ chính là rừng Chinju rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080102,
					"content": "Nữ pháp sư đeo mặt nạ nói, cố ấy có một người bạn cũ ở sâu trong rừng Chinju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080103,
					"content": "Vậy thì, chúng ta mau hành động thôi, tiến vào sâu bên trong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7210804,
			"completionStepIds": [
				7210816
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210816",
