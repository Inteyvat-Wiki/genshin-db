				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "Ừm, làm tốt lắm, nhìn chúng có vẻ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080902,
					"content": "...Hửm? Ờ, không vấn đề, để ta sẽ giúp ngươi hỏi chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080903,
					"content": "Gyoubu Koban muốn hỏi các ngươi: Các ngươi rõ ràng là loài người, tại sao trên người lại có mùi của tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080904,
					"content": "...Đúng nhỉ! Hãy cho ta một lời giải thích! Sao trên người các ngươi lại có mùi của tanuki thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080905,
					"content": "...Haiz? Bây giờ mới hỏi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080906,
					"content": "Nữ pháp sư đeo mặt nạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "Đúng! Là vậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080909,
					"content": "Trước đó, nữ pháp sư đeo mặt nạ đã đãi chúng tôi một bữa rất thịnh soạn, cô ấy nói rằng đã làm nó bằng pháp thuật bí mật học lén được từ tộc bake-danuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080910,
					"content": "Cái gì? Dám học trộm pháp thuật của ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080911,
					"content": "Hừm, không lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080912,
					"content": "Cái gì chứ, hồ ly thúi đó. Nếu vẫn còn sống thì nên sớm đến chào hỏi ta một tiếng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080913,
					"content": "Nữ pháp sư đeo mặt nạ đó nói rằng ngươi là \"người bạn cũ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080914,
					"content": "Mặt nạ? Ta chẳng biết mặt nạ gì, cũng không quen biết pháp sư nào cả, nhưng hồ ly thì có biết một con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080915,
					"content": "Nhắc mới nhớ, hình như trước đây con hồ ly thúi đó cũng đã từng xuất hiện dưới hình dạng của một pháp sư. Ngươi nói xem nữ pháp sư đó trông như nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080916,
					"content": "Đeo mặt nạ hồ ly trắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080917,
					"content": "Còn gì nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080918,
					"content": "Tóc ngắn màu đen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "Mặc trang phục pháp sư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080922,
					"content": "Mm.. không quen biết. Ta chưa từng gặp ai giống vậy cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080923,
					"content": "Vậy sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080924,
					"content": "...Ừm, được rồi, để ta lo chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080925,
					"content": "Shousei muốn nói là: \"Chơi cùng với các ngươi rất vui, cảm ơn!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080926,
					"content": "Paimon cũng rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080927,
					"content": "Về chiếc lược...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "Ta là bake-danuki Ioroi danh chấn thiên hạ, tất nhiên là nói phải giữ lời rồi. Chiếc lược này giao cho ngươi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080929,
					"content": "Nhưng mà, các ngươi muốn lấy chiếc lược này làm gì? Chải tóc sao? Trên đó không chừng vẫn còn mùi của hồ ly đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080930,
					"content": "Là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080920,
					"content": "Mặc trang phục pháp sư.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080921
					]
				},
				{
					"id": 721080921,
					"content": "Tóc ngắn màu đen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080907,
					"content": "Do ăn thứ gì đó rất lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				}
