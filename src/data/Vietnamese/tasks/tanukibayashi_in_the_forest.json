					"nextDialogs": [
						721081106
					]
				},
				{
					"id": 721081106,
					"content": "Đây là pháp thuật của bake-danuki sao? Thật thú vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081107,
					"content": "Cảm ơn, Kichiboushi! Lần sau chúng ta lại cùng nhau chơi trốn tìm nhé.",
