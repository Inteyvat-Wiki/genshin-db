			"dialogs": [
				{
					"id": 721080931,
					"content": "Cái gì, hóa ra là một vật quan trọng như vậy sao, sao không nói sớm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080932,
					"content": "Hại ta đang yên đang lành thì bị phong ấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "Một trăm năm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Mm! Đừng chọc ta nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "Thôi bỏ đi, đều là chuyện của quá khứ rồi. Về kết giới ở gần khu rừng, ta cũng có một chút manh mối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "Trước đây khi giao chiến với con hồ ly thúi đó, ta đã từng nhìn thấy nó ở bờ biển phía Đông. Nó có hình dạng của Lôi Anh Đào, kèm theo cổng Torii, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "Trước đây, vì nhìn thấy tên đó đánh nhau với đám yêu quái, ta đã lo rằng những yêu quái khác có thể thoát ra khỏi đó và gây hại cho khu rừng của ta, nên đã dùng pháp thuật phong ấn nơi đó lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "Để ta nghĩ xem, phong ấn nằm ở phía đông vực thẳm... Kichiboushi, con hãy đưa họ đến đó để phá bỏ phong ấn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "Cảm ơn Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Được rồi được rồi, đừng nói nữa, mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "Nếu gặp con hồ ly thúi kia, hãy giúp ta gửi lời, hãy nói rằng...để ta nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "\"Đồ khốn khiếp, tức chết ta mất. Hãy mau về đây tiếp tục giao đấu, ta và ngươi vẫn còn chưa phân thắng bại đâu đấy! Nhân tiện thì mau giúp ta giải bỏ phong ấn đi! Đúng rồi, cũng không phải ta không thể phá bỏ được phong ấn, chỉ là tên hồ ly thúi nhà ngươi vẫn còn nợ ta một ân tình! Gyoubu Koban nói rằng nó nhớ ngươi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "Dài quá! Dài thế này ai mà nhớ nổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080934,
