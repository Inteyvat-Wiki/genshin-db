			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080401,
					"content": "Bức tượng Thiên Hồ cất giữ vật trấn giữ...bên trong trống rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080402,
					"content": "Có lẽ nó đã bị \"bạn cũ\" của cô gái đeo mặt nạ giấu đi mất rồi. Mau đi hỏi xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080403,
					"content": "Nữ...mặt nạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080404
					]
				},
				{
					"id": 721080404,
					"content": "Tôi vừa nghĩ ra biệt danh đó. Thế nào? Rất dễ nhớ phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080405,
						721080406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080405,
					"content": "Chẳng dễ nhớ gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				},
				{
					"id": 721080407,
					"content": "Ờ, thôi bỏ đi...Dù sao thì chúng ta hãy tìm manh mối trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080406,
					"content": "Chẳng có ý nghĩa gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				}
			]
		},
		{
			"id": 7210807,
			"completionStepIds": [
				7210814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210814",
							"2"
						],
						"stepId": 7210814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080701,
					"content": "Ờ, ta...ta, ta chính là Ioroi, muốn chém, muốn giết tuỳ ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080702
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080702,
					"content": "Woa, tượng đá đang nói chuyện kìa! Còn sợ đến nỗi lắp bắp rồi kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080703,
					"content": "Ta không phải tượng đá! Chỉ là tạm thời bị phong ấn, nên mới biến thành hình dạng này thôi! Ta vẫn là bake-danuki danh chấn thiên hạ - Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080704,
						721080705
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080704,
					"content": "Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				},
				{
					"id": 721080706,
					"content": "Cái gì, đám tiểu bối các ngươi bây giờ đến tên của Ioroi ta cũng không biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080707
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080707,
					"content": "\"Tranh biếm hoạ Tanuki vườn thượng uyển\", \"Ấm trà Ioroi\", \"Kakushigami Oobayashi\", \"Trận Chiến Tanuki Trên Núi Yougou\"...Ngươi chưa từng nghe về những chuyện này? Phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080708
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080708,
					"content": "Rốt cuộc ta đã bị tên khốn đó phong ấn bao nhiêu năm rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080709,
						721080711
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080709,
					"content": "Tôi không có ý xấu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080710
					]
				},
				{
					"id": 721080710,
					"content": "Cái gì? Không phải đến để \"tiêu diệt\" ta sao? Sao không nói sớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080719,
					"content": "Ehem! Nói mau, các ngươi đến tìm bổn đại vương bake-danuki ta làm gì hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080720,
						721080722
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080720,
					"content": "Tế Lễ Anh Đào Thần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080721
					]
				},
				{
					"id": 721080721,
					"content": "Là cái gì vậy? Là bảo vật của quỷ tộc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080726,
					"content": "Thật là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080727
					]
				},
				{
					"id": 721080727,
					"content": "Haiz, người này chính là người bạn cũ mà nữ pháp sư đeo mặt nạ đó nói sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080728,
					"content": "Tóm lại, chúng tôi đang tìm một thứ được giấu bên trong tượng hồ ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080729,
					"content": "...Tìm, tìm tìm cái đó làm gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080730,
						721080731
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080730,
					"content": "Woa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080732,
					"content": "Chính là chiếc lược đó, hại ta bị phong ấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080733
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080733,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080734,
						721080735,
						721080736
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080734,
					"content": "Một trăm năm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080737,
					"content": "Ta cũng không biết là bao lâu! Trong rừng Chinju cả ngày không có mặt trời mặt trăng, nên cũng chẳng có cách nào để tính thời gian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080738
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080738,
					"content": "Lúc đó ta đã làm ầm ĩ khắp nơi để dụ con hồ ly hôi hám đó mà chẳng có kết quả gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080739
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080739,
					"content": "Khi ta muốn phá bỏ bức tượng hồ ly để trút giận, ta đã tìm thấy chiếc lược trong đó và nảy ra một kế hoạch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080740
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080740,
					"content": "Chiếc lược đó được giấu trong bức tượng hồ ly, bên trên còn có hình tượng của Bạch Thần, nghĩ đến bộ lông trắng đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080741
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080741,
					"content": "Ta cảm nhận thấy chiếc lược này chắc chắn rất quan trọng. Nếu muốn dụ tên hồ ly thúi đó ra, chỉ cần đem giấu chiếc lược đi là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080742
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080742,
					"content": "Ừm ừm, dùng bảo bối để thu hút người khác quả là rất hữu dụng! Kết quả thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080743,
					"content": "Kết quả là, một người trong Nhóm Yougou trước đây, đã đến xử lý ta cùng cả bộ tộc, biến tất cả mọi người trong tộc thành tượng đá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080744
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080744,
					"content": "Đây có lẽ là lý do Ioroi sợ con người nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080745
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080745,
					"content": "Hừ! Loài người tuổi thọ vừa ngắn, lại không biết biến hoá, không biết cái tên hồ ly thúi tha đó vì sao lại bênh vực bọn chúng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080746
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080746,
					"content": "Cái tên khốn kiếp phong ấn ta cũng thật quá quắt, còn nói cái gì mà \"Ừm ừm. Trước khi phong ấn, hãy tạo dáng cho đẹp, để còn dùng làm cảnh\" gì đó, tức chết đi được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080747
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080747,
					"content": "Tư thế này cũng khá đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080748
					]
				},
				{
					"id": 721080748,
					"content": "Hm? Tên nhóc này, sao cũng...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080749
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080749,
					"content": "#(Này, {NICKNAME}, nếu khiến hắn tức giận, không lấy được vật trấn giữ thì làm sao đây...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080750,
						721080751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080750,
					"content": "Ý là ngươi rất khôi ngô và cường tráng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080752,
					"content": "Đúng vậy đúng vậy, trong khu rừng tăm tối, tư thế hề hước này sẽ khiến khu rừng đỡ đáng sợ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080753,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080754
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080754,
					"content": "Nói tiếp đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080755,
						721080756
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080755,
					"content": "Giống như bức tượng của một vị thần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080757,
					"content": "Bởi vậy mới nói...bị phong ấn cũng không phải chuyện gì xấu, loài người cũng không có ác ý gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080758
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080758,
					"content": "Tuy ngươi nói nghe cũng hợp lý nhưng cũng có vẻ không phải như vậy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080759
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080759,
					"content": "Có thể mượn chiếc lược đó xem thử được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080760
					]
				},
				{
					"id": 721080760,
					"content": "Cũng không phải là không thể, nhưng các người phải chơi cùng lũ trẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080761
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080761,
					"content": "#Chuyện nhỏ như con thỏ. {NICKNAME} biết cách chiều trẻ con nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080762,
						721080763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080762,
					"content": "Thực ra tôi không giỏi việc chơi với trẻ con lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080765
					]
				},
				{
					"id": 721080765,
					"content": "Shousei, Gyoubu Koban và Kichiboushi. Hãy vào rừng tìm <color=#00E1FFFF>3 bé tanuki</color> này và chơi với chúng. Dù sao thì ta cũng không thể tự do di chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080766
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080766,
					"content": "Cũng tại tên khốn đó đã cẩu thả khi phong ấn, nên có vài tên nhóc đã thoát được ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080767
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080767,
					"content": "...Không đúng, phải nói là do pháp lực của bake-danuki lớn mạnh, có thể thoát khỏi phong ấn của con người là điều bình thường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080768,
						721080770
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080768,
					"content": "Vậy còn ngươi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080769
					]
				},
				{
					"id": 721080769,
					"content": "Suỵt! Người ta đã nói là pháp lực vô biên rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080771
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080771,
					"content": "Mặc dù sức mạnh của mấy đứa nhóc đó không thể so sánh với ta, nhưng vẫn có thể sử dụng phép thuật để ẩn mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080772
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080772,
					"content": "Được rồi, được rồi, ngươi mau đi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080770,
					"content": "Pháp lực vô biên!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080771
					]
				},
				{
					"id": 721080763,
					"content": "Đúng vậy, tôi vẫn thường hay chơi với Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080764
					]
				},
				{
					"id": 721080764,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080765
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080756,
					"content": "Thất Thiên Thần Tượng cũng không thể so sánh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080751,
					"content": "Ý là ngươi rất đẹp trai và mạnh mẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080735,
					"content": "Một nghìn năm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080736,
					"content": "Một triệu năm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080731,
					"content": "Có phản ứng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080722,
					"content": "\"Vật Trấn Giữ\" ở đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080723
					]
				},
				{
					"id": 721080723,
					"content": "Là cái gì thế? Dùng để nấu ăn à? Bake-danuki cũng biết khá nhiều về ẩm thực đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080724
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080724,
					"content": "Không phải, là \"Tế Lễ Anh Đào Thần\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080725,
					"content": "Anh Đào? Ừ cũng lâu lắm rồi ta không được ăn bánh anh đào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080711,
					"content": "Tôi đến để đòi nợ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080712
					]
				},
				{
					"id": 721080712,
					"content": "Í, đòi nợ?! Bao giờ, ở đâu? Để ta nghĩ xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080713
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080713,
					"content": "Ngươi, ngươi...ta...ta nợ ngươi cái gì hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080714
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080714,
					"content": "Đối phương có vẻ đang vắt não suy nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080715,
					"content": "Này, đừng có đùa giỡn với người lạ như thế chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080716,
					"content": "Này, đừng có đùa như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080717
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080717,
					"content": "Hầy, không có thì tốt, không có thì tốt...xác nhận thêm một lần nữa, Ioroi ta thật sự không nợ các ngươi cái gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080718
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080718,
					"content": "...Lẽ nào ngươi đang nợ nần chồng chất?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080705,
					"content": "Danh chấn thiên hạ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				}
			]
		},
