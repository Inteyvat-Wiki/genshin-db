				{
					"id": 721080801,
					"content": "Ooh...muốn được gãi gãi cái bụng quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080802
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080802,
					"content": "Hmm? Đứa nhóc này sao lại quay lại rồi. Hãy vào rừng tìm <color=#00E1FFFF>3 bé tanuki</color> là Shousei, Gyoubu Koban, Kichiboushi rồi chơi với chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080803
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080803,
					"content": "Được rồi, được rồi, ngươi mau đi đi!",
					"roleType": "TALK_ROLE_NPC",
