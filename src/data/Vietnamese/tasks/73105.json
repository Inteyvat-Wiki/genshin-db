				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Alrani... Rốt cuộc cô chạy đi đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050102,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "Hả? Alrani... Tôi nhớ rồi, là cô gái luôn viết luận văn kia đúng không? Cô gái mà chúng ta đã gặp ở đảo Watatsumi ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050104,
					"content": "Đúng vậy! Cô ấy nói là sẽ rời khỏi Giáo Viện để tìm tài liệu, bây giờ lẽ ra phải quay về rồi mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050105,
					"content": "Trông cô ấy có vẻ lo lắng... Chúng ta qua hỏi xem cô ấy đã gặp chuyện gì thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050106,
					"content": "Lỡ như Alrani đã trở về Giáo Viện rồi thì chúng ta đi chào hỏi luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050107,
					"content": "Xin chào, chuyện Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "Bạn là nhà mạo hiểm do Hiệp Hội Nhà Mạo Hiểm phái tới sao?! Xin hỏi bạn đã tìm được tung tích của Alrani chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050109,
					"content": "Tôi biết mình đã hối thúc nhiều lần lắm rồi, nhưng tôi thật sự rất lo cho cô ấy, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050110,
					"content": "Cô bình tĩnh chút, chúng tôi không phải do Hiệp Hội Nhà Mạo Hiểm phái tới, chúng tôi chỉ tình cờ đi ngang qua thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050111,
					"content": "Xin hỏi cô là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "Các bạn không phải nhà mạo hiểm sao? Xin lỗi nhé, vì bên phía hiệp hội mãi không có tin tức gì, tôi... tôi sốt ruột quá nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050149,
					"content": "Kể lại những chuyện đã trải qua cùng Alrani từ trước tới nay...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "Hóa ra bạn chính là Nhà Lữ Hành mà Alrani luôn nhắc tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050114,
					"content": "Tôi tên là Niloofar, là học giả của Giáo Viện... Chắc các bạn cũng có thể nhìn ra nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050115,
					"content": "Mặc dù nói là học giả, nhưng hiện tại phần lớn tâm sức của tôi đều đặt ở việc hướng dẫn học sinh nghiên cứu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050116,
					"content": "Alrani là một trong những học trò của tôi, việc viết luận văn của cô ấy đã gặp khá nhiều khó khăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050117,
					"content": "Cô, cô chính là người mà Alrani đã nói sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Alrani nói là rất nhiều luận văn của cô ấy đều bị người hướng dẫn bảo là không đạt, phải viết đi viết lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050119,
					"content": "Không đúng không đúng, bây giờ không phải lúc nói mấy chuyện này, tiểu thư Alrani đang bị làm sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050120,
					"content": "Alrani... mất tích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050121,
					"content": "Dạo trước, Alrani vội vã mang theo một bài luận văn từ Inazuma trở về, nội dung của luận văn đó là nghiên cứu văn hóa của người dân trên đảo Watatsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050122,
					"content": "Alrani rất tập trung để nghiên cứu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "Tôi có thể nhìn ra, bài luận văn đó viết rất tốt, đạt tiêu chuẩn cao ở mọi mặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050125,
					"content": "Nhưng... Nhưng cô ấy đã về quá muộn! Lúc trước tôi có bảo cô ấy gửi bản nháp trước cho tôi sớm, nhưng không nhận được hồi âm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050126,
					"content": "Khi cô ấy mang theo bài luận văn hoàn chỉnh trở về thì đã có một người nộp nội dung y hệt cô ấy, cũng đã được thông qua dự thẩm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050127,
					"content": "Tuy tôi đã cố gắng tranh thủ cơ hội giúp cô ấy, nhưng bài luận văn vẫn... không được thông qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050128,
					"content": "Không đúng, tiểu thư Alrani đã thu thập tài liệu từ lâu rồi mà? Sao lại kéo dài tới tận bây giờ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050129,
					"content": "Chờ đã, Inazuma... lẽ nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050130,
					"content": "Lệnh, lệnh bế quan tỏa cảng!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "Sao lại thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050132,
					"content": "Tôi không biết phải báo tin này với cô ấy thế nào... Vốn định chờ thêm mấy ngày nữa sẽ dùng cách thức uyển chuyển hơn để nói với cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050133,
					"content": "Nhưng không biết ai đã lắm mồm nói cho cô ấy biết chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050134,
					"content": "Sau đó cô ấy mất tích, tôi tìm khắp Giáo Viện cũng không thấy đâu, chỉ có thể đến Hiệp Hội Nhà Mạo Hiểm để đưa ủy thác thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050135,
					"content": "Nhưng nhà mạo hiểm cũng chỉ tìm ra sổ tay của Alrani chứ không thấy bóng dáng cô ấy đâu hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050136,
					"content": "Bây giờ chắc là các nhà mạo hiểm đó vẫn đang tìm kiếm tung tích của Alrani rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050137,
					"content": "Tôi, tôi thật sự không biết phải làm sao bây giờ, huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050138,
					"content": "Để tôi hỗ trợ tìm kiếm Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "Đúng, chúng tôi cũng sẽ hỗ trợ! Trước mắt... trước mắt cứ bắt đầu tìm từ vị trí của quyển sổ kia đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050142,
					"content": "Bạn đồng ý giúp sao? Thật cảm ơn, thật sự rất cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050143,
					"content": "Tôi sẽ đánh dấu vị trí phát hiện quyển sổ kia cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050144,
					"content": "Đúng rồi, có cả thù lao nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050145,
					"content": "Cái đó để sau hãy nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "Vậy làm phiền bạn rồi, tôi sẽ ở đây chờ tin tức của Hiệp Hội Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050148,
					"content": "Alrani, cô nhất định phải bình an đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050146,
					"content": "Tôi đi tìm Alrani trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "Vị trí của quyển sổ kia ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "Chúng tôi cũng sẽ hỗ trợ tìm kiếm tiểu thư Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050123,
					"content": "Alrani còn liều mạng để nghiên cứu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
