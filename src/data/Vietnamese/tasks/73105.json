						731053104
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053104,
					"content": "Hiểu lầm rồi. Lý do tôi làm thế rất đơn giản. Thứ nhất, Alrani đã trả tiền rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053105,
					"content": "Thứ hai, tôi xưa nay chỉ lấy tiền, không hại người, nếu tôi làm hại cô ấy thì mất danh tiếng trong ngành lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053106,
					"content": "Thứ ba, cô ấy là một người có học thức, có tương lai rộng mở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053107,
					"content": "Nếu giúp được cô ấy thì... có lẽ Đạo Bảo Đoàn cũng sẽ hưởng được chút tiếng thơm nhỉ? Hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053108,
					"content": "Cô ấy đưa cô bao nhiêu tiền?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "Không phải con số nhỏ đâu. Cô ấy nói là tiền kiếm được khi giúp người ta làm \"phân bón\" gì đó, tôi không rõ lắm, cũng lười tìm hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
