				{
					"id": 731050823,
					"content": "Kể cho Niloofar nghe những chuyện đã xảy ra, bao gồm lời nhắn mà Alrani gửi cho cô ấy...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050803
					]
				},
				{
					"id": 731050803,
					"content": "Narzam? Sao lại là cô ấy...",
