					"nextDialogs": [
						731050709
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050709,
					"content": "Nhà, Nhà Lữ Hành! Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050710,
					"content": "Tiểu thư Alrani, cô thật sự ở đây à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050711,
					"content": "Cô không sao là tốt rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "Hu... hu... Họ bắt nạt tôi! Rõ ràng luận văn đó là do tôi viết trước! Do tôi viết ra trước mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050714,
					"content": "Nếu không vì vướng lại lâu như vậy ở Inazuma thì luận văn của tôi đã được thông qua từ lâu rồi! Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050715,
					"content": "Tỉnh táo chút đi nào... Vậy bây giờ cô có muốn viết tiếp luận văn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050716,
					"content": "Hức... hức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050717,
					"content": "Tôi... tôi không viết nữa! Tôi không muốn đi học nữa! Giáo Viện thích làm gì thì làm đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050718,
					"content": "Dù sao tôi cũng đã trả tiền thuê Narzam bảo vệ tôi rồi, đừng ai hòng bắt tôi về viết luận văn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050719,
					"content": "Hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050720,
					"content": "Cô là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "#Tôi là Narzam, công việc chính của tôi... Hừm, thì chắc {F#cô}{M#cậu} cũng biết rồi, tôi không nói nhiều nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050722,
					"content": "#Tôi biết {F#cô}{M#cậu}, \"Nhà Lữ Hành\" gần đây hay hoạt động ở quanh nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050723,
					"content": "#Nếu như {F#cô}{M#cậu} đã nhận ủy thác thì có thể thuyết phục cô ta quay về, tôi sẽ không ngăn cản đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050724,
					"content": "Này! Tôi trả tiền rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050725,
					"content": "Cô trả ít tiền như thế thì làm được gì? Mua đồ ăn thức uống vài ngày thôi là hết sạch rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050726,
					"content": "Dù sao... Dù sao thì tôi cũng không muốn về nữa, về rồi lại phải nghĩ đề tài luận văn, lại phải đi khảo sát khắp nơi, ăn không ngon ngủ không yên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050727,
					"content": "Nói không chừng còn bị mấy người kỳ lạ bắt lại, hoặc gặp phải ma vật linh tinh nào đó nữa. Cuối cùng luận văn không viết được chữ nào, lại trễ ngày bảo vệ luận văn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050728,
					"content": "Huhuhu... Tôi không muốn... Tôi không muốn thế đâu... Thà bị Đạo Bảo Đoàn bắt lại còn hơn... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050729,
					"content": "Nhà Lữ Hành, bạn... bạn chuyển lời cho Niloofar giúp tôi nhé... Tôi... Tôi viết lời nhắn cho bạn... Tôi thật sự không muốn trở về nữa, tha cho tôi đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050738,
					"content": "Alrani sụt sịt viết lời nhắn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "Đây này... Huhuhu... Huhu... Tại sao trên đời này lại có luận văn chứ... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050731,
					"content": "...Được rồi, bình tĩnh đi, không ai đưa cô đi được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050732,
					"content": "Tiểu thư Alrani... Hình như tâm trạng của cô ấy bây giờ không ổn định lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050733,
					"content": "Cứ để cô ấy ở lại đây, chúng ta đưa tin nhắn này về cho Niloofar trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050734,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "Không cần lo, như cô ấy đã nói đấy, cô ấy đã trả tiền rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050737,
					"content": "Hơn nữa... Hừm, cuối cùng cũng tìm được một người có chút học vấn, tôi giữ cô ấy lại chắc sẽ có lúc dùng tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050735,
					"content": "Đạo Bảo Đoàn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "Tôi đã nghe Niloofar kể lại hết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
