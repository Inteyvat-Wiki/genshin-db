					"nextDialogs": [
						731050804
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050804,
					"content": "Cô quen cô ấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050805,
					"content": "Ừm... Không thể nói là quen, nhưng tôi có nghe người khác nói, cô ấy là một thành viên Đạo Bảo Đoàn kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050806,
					"content": "Nghe nói lúc cô ấy đánh cướp người đi đường, thường hỏi nạn nhân bị cướp một câu hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050807,
					"content": "Phạm vi câu hỏi từ văn học tới nguyên tố, cái gì cũng có, thậm chí... thậm chí còn mấy câu hỏi mẹo nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050808,
					"content": "Chỉ cần giải được câu hỏi của Narzam thì cô ấy không chỉ trả hết tất cả những gì đã cướp lại, còn tự mình hộ tống người đó về thành nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050809,
					"content": "Hóa ra cô ấy kỳ lạ như vậy à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050810,
					"content": "Đây là kiểu cướp gì thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "Không ai biết mục đích của cô ấy là gì. Sở dĩ tôi biết chuyện này cũng là vì thầy của tôi từng gặp phải Narzam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050813,
					"content": "Lúc đó câu hỏi Narzam đưa ra là: \"Dùng thứ gì có thể nhanh chóng nhét đầy một căn phòng trống.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050814,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "Gió! Đúng không? Chắc chắn là đúng rồi!",
