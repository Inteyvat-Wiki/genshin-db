				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "Anh hùng! Hảo hán, đừng đánh, đừng đánh nữa! Hiểu lầm thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050502,
					"content": "Không có hiểu lầm gì hết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "Các người đã làm gì tiểu thư Alrani hả? Mau thành thật khai báo đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050504,
					"content": "Bằng không... ngày này năm sau sẽ là ngày giỗ của ngươi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050507,
					"content": "Đừng, đừng đừng đừng, hãy nghe tôi nói hết đã, đây chỉ là hiểu lầm thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050508,
					"content": "Chúng tôi nào dám chọc cô ta chứ, chúng tôi căn bản không làm lại cô ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050509,
					"content": "Có ý gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "Cứ từ từ nghe tôi nói đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050512,
					"content": "Thời gian trước, đúng lúc anh em tôi thiếu tiền nên theo đại tỷ đi vòng quanh kiếm con mồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050513,
					"content": "Hứ! Chắc chắn lại muốn cướp bóc trộm cắp đây mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050514,
					"content": "...Chúng tôi là Đạo Bảo Đoàn, nên mỗi ngày đều phải dựa vào mấy chuyện này để kiếm cơm mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050515,
					"content": "Lúc chúng tôi đang lên kế hoạch ở doanh trại thì nhìn thấy một cô gái vác cái túi lớn đi về phía doanh trại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050516,
					"content": "Trông cô ấy có vẻ thất thần, làm chúng tôi giật hết cả mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050517,
					"content": "Chúng tôi đang định kiểm tra thì cô gái kia đột nhiên ngồi phịch xuống bên cạnh đống lửa, vừa khóc vừa ném mớ sách vào trong đống lửa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050518,
					"content": "Các anh em bị cô ta dọa cho sợ hết hồn luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050519,
					"content": "Mấy người mà cũng bị cô ấy dọa cho sợ á...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "Ôi trời, mặc dù chúng tôi là Đạo Bảo Đoàn, nhưng chúng tôi cũng chưa từng lấy mạng ai, cùng lắm chỉ là trộm ít đồ, cuỗm ít báu vật thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050522,
					"content": "Chúng tôi còn chưa kịp phản ứng thì cô ấy đã ném một túi Mora tới, bảo chúng tôi nhốt cô ấy lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050523,
					"content": "Hả! Sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050524,
					"content": "Chuyện gì thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "Ban đầu không ai dám bước tới đụng vào cô ấy. Nhưng cô ấy không chịu ăn uống gì, cứ nhất quyết đòi bị nhốt lại cho bằng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050527,
					"content": "Cuối cùng thì đại tỷ sai chúng tôi đi chặt mấy nhánh cây, làm thành cái lồng cho cô ấy chui vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050528,
					"content": "Đại tỷ của các người cũng tốt thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "Ai kêu đại tỷ của chúng tôi luôn tôn trọng người có học làm gì, chị ấy luôn nói, nếu có cơ hội thì chị ấy cũng muốn đi học...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050531,
					"content": "Khụ, nếu không tin... thì bà cô trẻ đó đang ở bên kia kìa, cứ tự mình đi xem đi, chắc bây giờ đại tỷ vẫn còn đang khuyên cô ấy đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050532,
					"content": "Nếu bạn khuyên được cô ta đi khỏi đây thì chúng tôi tặng quà cảm ơn luôn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050529,
					"content": "Các người đối xử với Alrani cũng tốt thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "Vậy các người có nhốt cô ấy lại không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "Chẳng phải các người là Đạo Bảo Đoàn sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "Quả nhiên Alrani đang ở chỗ các người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "Mấy người đã làm gì Alrani rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "Thành thật khai báo đi! Bằng không... ngày này năm sau sẽ là ngày giỗ của ngươi đó!",
