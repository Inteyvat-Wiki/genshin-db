			"dialogs": [
				{
					"id": 731050701,
					"content": "Alrani! Rốt cuộc cô có ra hay không!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050702,
					"content": "Không ra! Tôi không làm học giả nữa! Tôi cũng không muốn đi học nữa!",
