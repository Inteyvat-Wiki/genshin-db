					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Ừm... ánh nến?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "Thầy của tôi trả lời là: \"Sức mạnh nguyên tố có ở khắp nơi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050818,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "Ăn gian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Hahaha... Tóm lại là sau đó Narzam đã đưa thầy tôi về thành, lại còn lễ phép chào tạm biệt ông ấy nữa.",
