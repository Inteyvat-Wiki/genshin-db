					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680307,
					"content": "Không lẽ đây là hòn đảo liên quan đến Xinyan sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680308,
					"content": "Wow, chẳng lẽ đây là nhạc cụ được chuẩn bị riêng cho tôi ư? Vậy để tôi thử sử dụng xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680309,
					"content": "Chờ một chút, ngày hôm qua chạm vào chậu bonsai thì chúng ta bị chuyển đến một không gian đặc biệt. Xinyan, cô có muốn chuẩn bị trước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680310,
					"content": "Anh nói đúng, nhưng tôi không lo lắng lắm. Dù sao thì tôi cũng luôn sẵn sàng cho âm nhạc mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
