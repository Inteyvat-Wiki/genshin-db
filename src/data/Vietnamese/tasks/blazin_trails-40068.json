					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680304,
					"content": "Này! Xem tôi phát hiện được gì nè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680305,
					"content": "Thứ này... nên gọi là một cái trống, hay là một loài thực vật đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680306,
					"content": "Là một nhạc cụ làm từ thực vật sao...",
