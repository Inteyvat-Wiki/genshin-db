						400681503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681503,
					"content": "Nếu Mona có hứng thú thì có thể dùng thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681504,
					"content": "Không không, tôi không biết hát đâu... Nếu không có tác dụng thì xấu hổ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681505,
					"content": "Hahaha, giọng của Mona hay như vậy, rất thích hợp để hát. Nếu cô không chê thì sau khi về doanh trại tôi sẽ chỉ Mona cách lấy hơi để hát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681506,
					"content": "Hả? Thật, thật sao? Nhưng phải hứa là không được cười tôi đấy nhé.",
