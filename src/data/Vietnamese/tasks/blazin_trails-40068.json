				},
				{
					"id": 400680303,
					"content": "Ơ... Bàn bói nước của tôi sáng hơn một chút rồi, nhưng vẫn không thể nhìn rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
