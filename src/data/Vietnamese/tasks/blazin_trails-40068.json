			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "Dậy nào! Mặt trời chiếu tới mông rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680202,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "Paimon, tôi nằm ngửa mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "Được rồi, mặt trời chiếu tới bụng rồi kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}, tối qua ngủ ngon chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680206,
					"content": "Cũng tàm tạm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "Có vẻ như mọi người cũng như vậy. Hôm nay tôi đã dậy rất sớm để đi dạo quanh đây hái trái cây làm bữa sáng cho mọi người này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680209,
					"content": "#Trong lúc chờ {NICKNAME} dậy, tôi không nhịn nổi nên đã ăn trước rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680210,
					"content": "Mọi người cùng ăn sáng và tán gẫu với nhau...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "Ơ? Fischl đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680212,
					"content": "Ừm, hình như cô ấy không thích đi cùng chúng ta lắm, nói là có việc của nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680213,
					"content": "Nghe xạo thật đấy! Rõ ràng là nói đến đây để khôi phục Vương Đô U Ám, sao giờ lại trở thành làm việc cho Hiệp Hội Nhà Mạo Hiểm chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680214,
					"content": "Được rồi... Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "Hình như cô ấy đang có tâm sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680216,
					"content": "Chúng ta đã để Mona chăm sóc Fischl, nhưng cô ấy lại nói Mona không hiểu công việc của một nhà mạo hiểm, nên không thể đi cùng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680217,
					"content": "Để được đi một mình, Fischl thậm chí còn không cần đến cái cớ Vương Đô U Ám nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680218,
					"content": "Rõ ràng là cô ấy đang gặp phải vấn đề không nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680219,
					"content": "Haiz, là một người bạn, tôi cũng rất muốn giúp cô ấy, nhưng có một chuyện mà Fischl nói đúng, hôm nay chúng ta sẽ đi khám phá những hòn đảo khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680220,
					"content": "Hả, vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "Mọi người đều đã nhất trí rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680222,
					"content": "Tôi đã bỏ phiếu đâu, sao lại là mọi người đều đã nhất trí chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "Vậy sao, vừa rồi Paimon bỏ phiếu giùm bạn luôn rồi, nói là Paimon ở đâu thì bạn sẽ ở đó, và ngược lại cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680224,
					"content": "Hì hì, bạn là nhà mạo hiểm mà, nên chắc sẽ đi mà đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680225,
					"content": "(Paimon này, được rồi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "Fischl nói chúng ta cứ đi chung với nhau, cô ấy làm xong việc riêng sẽ quay lại tìm chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680227,
					"content": "Dù sao thì Fischl cũng là một nhà mạo hiểm đầy kinh nghiệm, tôi nghĩ chúng ta nên tin tưởng cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680228,
					"content": "Quen biết Fischl không lâu nên đây chỉ là suy đoán riêng của tôi. Tôi cho rằng... sự mâu thuẫn của Fischl đến từ chính bản thân cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680229,
					"content": "Có vẻ chuẩn đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680230,
					"content": "Nếu mâu thuẫn với người khác thì một là giải quyết hai là từ bỏ. Còn nếu với bản thân thì sẽ không thể buông bỏ dễ dàng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680231,
					"content": "...Tôi cũng từng trải qua thời kỳ như vậy nên có thể hiểu được cô ấy. Tuy không biết cô ấy đang phải vật lộn với điều gì, nhưng bây giờ cô ấy đang cần được ở một mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680232,
					"content": "Tôi cũng đồng ý, chỉ tiếc là chuyến phiêu lưu hôm nay... nếu có tất cả mọi người thì mới có ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680233,
					"content": "Xinyan nhiệt tình thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680234,
					"content": "#À đúng rồi, tôi quên chưa nói. Sáng nay ở phía bắc hòn đảo có xuất hiện ảo cảnh, đợi {NICKNAME} ăn sáng xong chúng ta đến đó điều tra nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680207,
					"content": "Không tệ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
