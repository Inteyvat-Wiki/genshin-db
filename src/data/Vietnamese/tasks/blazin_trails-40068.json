					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681002,
					"content": "Ừm... Đúng là bên ngoài vẫn sáng hơn, nhưng tôi không ghét cái hang động nóng nực đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681003,
					"content": "\"Suối Ngọt Giá Lạnh\" chắc là ở trên ngọn núi gần đây, chúng ta hãy cùng tìm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681004
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681004,
					"content": "Đợi đã, sao lại có ánh sáng dưới đất thế này? Đây là... mạch nước sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681005
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681005,
					"content": "Theo lời bông hoa đó... mạch nước có liên quan đến thực vật, thực vật lại có liên quan đến dòng suối trên núi. Vậy thì đi theo mạch nước này là đúng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
