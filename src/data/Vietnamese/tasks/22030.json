					"nextDialogs": [
						220300302
					]
				},
				{
					"id": 220300302,
					"content": "Vậy làm phiền các hạ rồi, tại hạ sẽ đi bên còn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300303
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300303,
					"content": "Một mình chú có đánh lại chúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300304
					]
				},
				{
					"id": 220300304,
					"content": "Chỉ là ma vật thôi mà, không cần phải lo, nếu không phải vì lo lắng cho nguyên liệu thì tôi đã tự đi giải quyết ma vật hai bên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300305
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300305,
					"content": "Được rồi, các hạ đi tiêu diệt ma vật rồi qua bên còn lại tìm tại hạ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300306
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300306,
					"content": "Chúng ta phải nhanh lên, nếu như nguyên liệu bị hư thì không thể làm ra món ngon được",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
