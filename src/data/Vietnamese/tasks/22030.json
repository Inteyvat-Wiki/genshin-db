				{
					"id": 220300201,
					"content": "Chính là ở đây. Hai bên đều có doanh trại ma vật trấn giữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300202,
					"content": "Tại hạ đã đi thám thính thử, ma vật của doanh trại bên trái yếu hơn, nhưng khá đông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300203,
					"content": "Ma vật của doanh trại bên phải ít hơn, nhưng rất mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300204,
					"content": "Phiền các hạ giúp đỡ tiêu diệt một bên nhé, tại hạ sẽ xử lý bên còn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
