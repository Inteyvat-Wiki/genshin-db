					"id": 220300601,
					"content": "Cảm ơn các hạ! Các nguyên liệu này vẫn còn dùng được...tôi bắt đầu đi nấu ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300602,
					"content": "Hoàn thành rồi, phù...may nhờ có các hạ nên món này mới được hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300603,
					"content": "Anh vẫn theo đuổi sự hoàn mỹ nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "Đương nhiên rồi, dù là bất kỳ sự việc nào, nếu như không truy cầu sự hoàn mỹ thì sẽ mất đi ý nghĩa của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "Truy cầu sự hoàn mỹ cũng chính là đạo làm người của tôi. Nhưng mà...Xudong có vẻ khác tôi ở điểm này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "Xudong từng nói với tôi, Liyue có hai chữ gọi là \"bình phàm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300607,
					"content": "Ý nghĩa là, cho dù làm việc hay làm người, không cần đạt đến đỉnh cao, không cần quá xuất chúng, cứ bình dị là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300608
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300608,
					"content": "Tôi cũng không hiểu câu này của Xudong lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300609
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300609,
					"content": "Nhưng tôi nghĩ...có lẽ Xudong cũng đã từng trải qua nhiều việc, mới có thể đúc kết được đạo lý này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300612,
					"content": "Nếu đã làm xong món ngon rồi thì không nên lãng phí thời gian nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300613
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300613,
					"content": "Phần này của các hạ, phần còn lại tại hạ sẽ mang cho Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300610,
					"content": "Đám ma vật đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300611
					]
				},
				{
					"id": 220300611,
					"content": "Đã bị tại hạ giải quyết rồi, các hạ cứ yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
