				{
					"id": 413342601,
					"content": "Cảm ơn ông chủ đã đón tiếp, đây là tiền của ông, ông đếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342602
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342602,
					"content": "Được rồi, nhiêu đây tiền là đủ rồi... Nhìn hai vị chắc là muốn lên đường tiếp đúng không? Hay là, muốn đi dạo trong thành?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342603
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342603,
					"content": "Tôi nghe nói \"Đèn Minh Tiêu\" năm nay rất hoành tráng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342604
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342604,
					"content": "Chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342605
					],
					"speakerTitle": "Huachu"
				},
				{
					"id": 413342605,
					"content": "Nếu có cơ hội chúng tôi sẽ đến đó xem thử, cảm ơn ông chủ đã giới thiệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342606
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342606,
					"content": "...Ông chủ, có thể bán cho tôi một cái Đèn Tiêu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342607
					],
					"speakerTitle": "Huachu"
				},
				{
					"id": 413342607,
					"content": "Cho dù không có cơ hội vào thành xem Đèn Minh Tiêu thì thả đèn cũng được mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342608
					],
					"speakerTitle": "Huachu"
				},
				{
					"id": 413342608,
					"content": "Tiểu thư nói phải, lễ này đương nhiên là phải thả Đèn Tiêu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342609
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342609,
					"content": "Không thành vấn đề, đúng lúc chỗ tôi có vài cái Đèn Tiêu vừa làm xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342610
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342610,
					"content": "Này, tặng các bạn một cái, ngày lễ trọng đại này tôi sẽ không tính tiền đèn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342611
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342611,
					"content": "Cảm ơn ông chủ, cho tôi hỏi thêm một câu, xung quanh đây có chỗ nào thích hợp để thả Đèn Tiêu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342612
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342612,
					"content": "Chỗ thả Đèn Tiêu à... Vậy đi lên chỗ cao chút, men theo con đường này lên núi, tôi nhớ có một chỗ thích hợp để thả đèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342613
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342613,
					"content": "Nhưng mà, tôi nghe nói trong núi có nhiều ma vật xuất hiện, các bạn phải cẩn thận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ông chủ Zhu"
				}
			]
		},
