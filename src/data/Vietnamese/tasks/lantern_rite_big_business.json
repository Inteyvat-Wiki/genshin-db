			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ông chủ Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413340101,
					"content": "Phải nghĩ cách thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340102
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340102,
					"content": "Nghĩ cách gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340103
					]
				},
				{
					"id": 413340103,
					"content": "À... Nhà Lữ Hành à, không phải đang là Tết Hải Đăng sao? Tôi muốn nhân dịp Tết Hải Đăng lần này để phát triển kinh doanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340104
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340104,
					"content": "Bạn xem, vị trí chỗ tôi cũng không tệ, môi trường cùng tốt, món ăn... cũng không ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340105
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340105,
					"content": "Đến khi trong thành thả Đèn Minh Tiêu, ngồi ở chỗ tôi, cảnh đẹp rượu ngon thức ăn ngon, cảm giác chắc chắn sẽ rất tuyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340106
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340106,
					"content": "Tôi sẽ dùng nó làm điểm mạnh để thu hút khách, bạn thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340107,
						413340108
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340107,
					"content": "Ở đây xem được Đèn Minh Tiêu sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				},
				{
					"id": 413340109,
					"content": "Ừm... chắc là được, Đèn Minh Tiêu lớn như vậy, có thế nào cũng sẽ thấy được một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340110
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340110,
					"content": "Chuyện này... không sao, đến lúc đó hẵng tính, tôi phải dọn dẹp tiệm trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340111
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340111,
					"content": "Nhà Lữ Hành, có thể giúp tôi thu thập nguyên liệu làm đèn tiêu không? Tôi muốn treo vài chiếc đèn tiêu trong tiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340112,
						413340113
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340112,
					"content": "Hay để tôi làm luôn cho bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340114,
					"content": "Không sao, chỉ cần nguyên liệu là được, làm đèn tiêu cũng khá phức tạp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340115
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340115,
					"content": "Thu thập đủ nguyên liệu rồi bạn cứ đưa cho Dummy, cậu ấy sẽ làm đèn tiêu. Tôi còn phải làm những việc khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340116
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340116,
					"content": "Đương nhiên, chắc chắn tôi sẽ không để bạn làm không công, đến lúc có khách và kinh doanh tốt, chắc chắn sẽ có thù lao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340117
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340117,
					"content": "Vậy nếu không có khách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340118
					]
				},
				{
					"id": 413340118,
					"content": "Ừm... Dù... không có khách, tôi cũng sẽ trả thù lao cho bạn, yên tâm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340119
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340119,
					"content": "Đợi tiệm sửa soạn xong thì khách cũng sẽ đến thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340120
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340120,
					"content": "Khụ... Vậy bạn đưa nguyên liệu cho Dummy là được rồi, để ngày mai xem tình hình thế nào rồi tôi sẽ thanh toán cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413340113,
					"content": "Chỉ cần nguyên liệu thôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340108,
					"content": "Ở đây chắc không xem được Đèn Minh Tiêu đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				}
			]
		},
