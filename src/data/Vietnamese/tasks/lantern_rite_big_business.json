				{
					"id": 413342201,
					"content": "Sao rồi, đồ ăn chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342202
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342202,
					"content": "Chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342203
					]
				},
				{
					"id": 413342203,
					"content": "Được rồi được rồi, đồ ăn đã lên đủ rồi, cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342204
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342204,
					"content": "Hai vị đợi lâu rồi, chúc ngon miệng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342205
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342205,
					"content": "Cảm ơn ông chủ. Nhà lữ hành này... cũng giúp đỡ nhiều việc rồi, ngồi xuống ăn chung nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342206
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342206,
					"content": "Cám ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342207
					]
				},
				{
					"id": 413342207,
					"content": "Ha ha, nhìn vẻ ngoài của bạn, có thể cũng là người đến từ phương xa như chúng tôi. Ngày lễ lớn như vậy, mọi người cùng ngồi xuống dùng bữa để không khí thêm phần nhộn nhịp nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342208
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342208,
					"content": "Ừm, ông chủ cũng cùng ăn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342209
					],
					"speakerTitle": "Huachu"
				},
				{
					"id": 413342209,
					"content": "Cũng được, vậy tôi sẽ không khách sáo nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ông chủ Zhu"
				}
			]
