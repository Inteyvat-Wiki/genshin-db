			"dialogs": [
				{
					"id": 413342501,
					"content": "Hai vị xin hãy qua bên này, chúng tôi đã chuẩn bị xong cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342502
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342502,
					"content": "Ông chủ, hai vị này là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342503
					]
				},
				{
					"id": 413342503,
					"content": "À, ban nãy tôi cũng có ra ngoài bắt khách, khi xuống đến dưới thì gặp hai vị này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342504
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342504,
					"content": "Đúng vậy, vị này là tiểu thư của Minh Hoa Tiền Trang, còn tôi là người làm công của Minh Hoa Tiền Trang",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342505
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342505,
					"content": "Tôi và tiểu thư đang đi du ngoạn thì thấy được Tết Hải Đăng này, tiểu thư có chút... nhớ nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342506
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342506,
					"content": "Cho nên chúng tôi muốn chọn chỗ nào đó để ngắm Đèn Tiêu, lại trùng hợp gặp được ông chủ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342507
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342507,
					"content": "Đúng vậy, quán của tôi cũng có rất nhiều Đèn Tiêu nè. Nhưng mà... Minh Hoa Tiền Trang? Đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342508
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342508,
					"content": "À... khụ khụ! Tôi không hỏi thêm nữa, không hỏi thêm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342509
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342509,
					"content": "Hai vị đi đường xa như vậy chắc rất mệt rồi, hãy uống chút nước trước nhé, tôi sẽ mang thức ăn đến ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342510
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342510,
					"content": "Nhà Lữ Hành, hãy giúp tôi nhé, hai vị đó, phải phục vụ chu đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342511
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 413342511,
					"content": "Hãy chuẩn bị món \"Canh Trân Châu Phỉ Thúy Bạch Ngọc Ngon\" cho tôi nhé, tôi sẽ trả thù lao cho bạn sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ông chủ Zhu"
				}
			]
