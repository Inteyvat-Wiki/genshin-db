				},
				{
					"id": 752130402,
					"content": "Xin chào, đồ uống của quý khách đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130403
					]
				},
				{
					"id": 752130403,
					"content": "Đồ uống? Tôi không có gọi đồ uống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130404
					],
					"speakerTitle": "Du Khách Áo Xanh"
				},
				{
					"id": 752130404,
					"content": "Không phải người này, chúng ta cần tìm người mặc quần xanh lam! Không phải áo xanh!",
