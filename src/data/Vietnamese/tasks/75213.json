			"dialogs": [
				{
					"id": 752130601,
					"content": "Xin chào, đồ uống của quý khách đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "Ồ! Thì ra là giao đồ uống à? Bảo sao nửa ngày trời rồi mà chưa nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130608,
					"content": "Trên đơn hàng ghi chú là \"giao cho vị khách quần xanh lam trên bãi cát\", rồi lại đi trốn trong đống cát, báo hại chúng tôi tìm cả nửa ngày trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130609,
					"content": "Lần giao hàng này nên trả thù lao gấp đôi mới đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130610,
					"content": "Ah, xin lỗi, tôi quên mất chuyện này. Tôi nên bỏ quần của mình ở bên cạnh mới đúng, như vậy sẽ tiện để hai người tìm thấy tôi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130611,
					"content": "Mà sao lại chôn mình trong cát vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "Vì nó rất thú vị. Tôi nghe nói rất nhiều người đều làm vậy khi đi nghỉ dưỡng, nên tôi cũng muốn thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130613,
					"content": "Nhưng tư thế này hình như không đúng lắm thì phải. Trông như củ cải cắm dưới đất ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130614,
					"content": "Hả? Như vậy thì có điểm nào không tốt chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130615,
					"content": "Dễ làm người khác vấp ngã, bản thân cũng sẽ bị thương.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Tôi hiểu rồi, tôi sẽ suy nghĩ. Đây là tiền giao hàng gấp đôi, cảm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aqo"
				}
			]
		},
