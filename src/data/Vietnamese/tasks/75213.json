				},
				{
					"id": 752130502,
					"content": "Xin chào, đồ uống của quý khách đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130503
					]
				},
				{
					"id": 752130503,
					"content": "Ly đồ uống này tặng cho tôi sao? Ôi trời! Lời cầu nguyện của tôi được thần linh nghe thấy rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
