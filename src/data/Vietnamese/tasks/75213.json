				"points": []
			},
			"dialogs": [
				{
					"id": 752130201,
					"content": "Có cần tôi giúp đỡ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "Ồ? Được không? Nhân viên của cửa hàng đã bị điều đi hết rồi, bây giờ vẫn còn một đơn hàng cần giao gấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "Trên đơn hàng ghi chú là giao cho một vị khách <color=#00E1FFFF>mặc quần màu xanh lam trên bãi biển</color>, chỉ cần kịp thời giao đến là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "#Thật sự vô cùng biết ơn. Ngoài phí giao hàng của đơn hàng này ra, tôi sẽ tặng {F#cô}{M#cậu} công thức đồ uống của cửa hàng xem như thù lao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
		{
			"id": 7521303,
