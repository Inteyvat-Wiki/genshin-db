			"dialogs": [
				{
					"id": 711100101,
					"content": "Hai bạn đến tham gia cuộc thi ảnh phong cảnh \"Hành Trình Trầm Ngọc\" phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100102,
					"content": "Cuộc thi ảnh phong cảnh là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100103,
					"content": "Đúng như tên gọi, đây là cuộc thi ảnh nhằm quảng bá cảnh đẹp Trầm Ngọc Cốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100104,
					"content": "Trước đó, chúng tôi đã gửi phiếu khảo sát người dân để thu thập những danh lam thắng cảnh hấp dẫn nhất ở Trầm Ngọc Cốc. Người tham gia được yêu cầu đến những địa điểm đã chọn và chụp những bức ảnh tương ứng bằng máy ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100105,
					"content": "Cuối cùng, chúng tôi sẽ chọn ra một số hình ảnh nổi bật và sử dụng chúng làm mẫu quảng bá để trưng bày công khai trên đường phố bên ngoài Dịch Trạm Hợp Triệt. Thế nào, hai bạn có hứng thú không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100106,
					"content": "Tôi là người hơi thực tế, nên là... có phần thưởng gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "Nếu tác phẩm bạn gửi được chọn, tất nhiên sẽ có một bất ngờ dành riêng cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100110,
					"content": "Ồ! Có bất ngờ à?! Vậy chúng tôi sẽ nỗ lực để có được điều bất ngờ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100111,
					"content": "Haha, nếu có tiếc nuối vì sau cùng không được chọn, thì chúng tôi cũng đã chuẩn bị một phần thưởng nhỏ cho thời gian và công sức mà các bạn đã bỏ ra. Hy vọng hai người sẽ hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100112,
					"content": "Làm thế nào để bắt đầu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "Vui lòng xem hướng dẫn này, trong đó có những danh lam thắng cảnh quyến rũ được người dân Trầm Ngọc Cốc giới thiệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100115,
					"content": "Ủa? Sao lại có chỗ bị gạch bỏ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100116,
					"content": "Haha, vì số lượng đăng ký đến các địa điểm đó đã đầy rồi. Chúng tôi hy vọng sẽ thể hiện được cảnh đẹp Trầm Ngọc Cốc một cách toàn diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100117,
					"content": "Bốn địa điểm còn lại vẫn có thể đăng ký, bạn có thể chọn bất kỳ một hoặc một vài địa điểm trong số đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100118,
					"content": "#Thì ra là vậy... {NICKNAME}, hay là chúng ta xử lý hết những chỗ còn lại đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100119,
					"content": "Nếu xác suất trúng giải khi chụp một bức ảnh là một phần tư, thì chúng ta chụp bốn bức là đủ trăm phần trăm! Nghĩa là chúng ta chắc chắn sẽ nhận được phần thưởng bất ngờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100120,
					"content": "Ai lại tính kiểu vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "Không phải sao? Nhưng một phần tư gấp bốn lên thì chẳng là trăm phần trăm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100122,
					"content": "Cũng không sai, nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "Hihi, vậy còn nói gì nữa, bắt đầu ngay đi thôi! Tất cả vì điều bất ngờ cuối cùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100123,
					"content": "Tính hay lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "Tuyệt vời, không ai chụp ảnh đẹp hơn tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "Có vẻ như bạn đã tràn đầy năng lượng rồi. Cho phép tôi bổ sung thêm, nếu tác phẩm bạn gửi được chọn, chúng tôi sẽ có một bất ngờ dành riêng cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				}
			]
		},
