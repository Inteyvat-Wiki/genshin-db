			"dialogs": [
				{
					"id": 711101701,
					"content": "Đây rồi! Tên gian thương Fontaine này! Cơ may của mình đến rồi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101702
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101702,
					"content": "Mặc dù nên lao vào bắt hắn ngay lúc này, nhưng thế thì không thể thưởng thức được những bức ảnh Trầm Ngọc Cốc đầy quyến rũ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101703
