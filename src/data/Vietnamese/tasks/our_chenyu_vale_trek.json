			"dialogs": [
				{
					"id": 711101101,
					"content": "Bạn nhỏ ơi, con bồ nông này là của nhà em à? Chúng tôi có thể chụp ảnh nó với Làng Kiều Anh được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101102,
					"content": "Hree hree! Hree hree anng anng hree hree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101103,
					"content": "Hả? Em đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "Đây là tiếng bồ nông, nghĩa là \"Được, được!\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "Em biết nói tiếng bồ nông sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Chỉ biết một chút thôi... Vì em phát hiện ra khi ăn chúng sẽ liên tục kêu \"Hree hree! Hree hree anng anng hree hree!!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "Nhất định là đang vui vẻ nói \"Được, được\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "Vậy nên sau đó em cũng học cách kêu như vậy, chúng nghe thấy sẽ bay tới, chắc là nghĩ có đồ để ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "Mọi người muốn chụp ảnh thì có thể thử gọi chúng xem! Tiếc là em phải về nhà rồi, nếu không em có thể dạy mọi người thêm nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "Không sao đâu bạn nhỏ, chúng tôi có thể tự mình thử xem sao! Cảm ơn em, đi đường cẩn thận nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}, chúng ta qua đó thử xem. Nếu có thể thu hút được bồ nông thì chắc chắn sẽ tăng cơ hội chiến thắng cho tác phẩm của chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
