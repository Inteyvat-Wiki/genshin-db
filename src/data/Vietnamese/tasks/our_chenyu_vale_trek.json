			},
			"dialogs": [
				{
					"id": 711101301,
					"content": "Đợi đã! Đừng đến đây! Mấy người... có phải người tốt không đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101302,
					"content": "Này này, chúng tôi vừa cứu anh đấy! Anh có đập đầu vào đâu không hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101303,
					"content": "À! Nói cũng phải... Thật xin lỗi, Hành Trình Trầm Ngọc này của tôi xui xẻo quá, khiến tôi có chút choáng váng... Vậy, cảm ơn hai vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101304,
					"content": "Anh cũng đến đây để tham gia cuộc thi ảnh à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "Hai vị cũng vậy à? Thật là trùng hợp, nhưng tôi chỉ là một khách du lịch bình thường... Tôi hoàn toàn không biết làm gì với đám Hilichurl đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101306,
					"content": "Thật đáng ghét, tôi gặp chúng trên đường, chúng bắt tôi về không một lời giải thích, lẽ nào Hilichurl cũng thu lộ phí à? Thật vô lý... may mà gặp được hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101307,
					"content": "À... Vậy hôm nay anh cũng xui xẻo đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101308,
					"content": "Không chỉ hôm nay đâu! Hôm qua cũng xui xẻo, tôi mua một chiếc máy ảnh rất đắt tiền từ một thương nhân Fontaine, nhưng mới dùng được vài lần đã hỏng. Khi tôi quay lại tìm hắn ta thì hắn ta đã biến mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101309,
					"content": "Đúng là gian thương... Hai vị ra ngoài nhớ phải cẩn thận với ví tiền của mình nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101310,
					"content": "Đúng rồi, các vị đã tham gia Hành Trình Trầm Ngọc, chắc hẳn cũng đến đây để chụp ảnh Huyền Luyện Sơn phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101311
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101311,
					"content": "Dù sao, để bày tỏ lòng biết ơn, tôi sẽ nói cho hai vị địa điểm chụp ảnh đẹp nhất mà tôi nghiên cứu được. Nào, tôi sẽ đánh dấu trên bản đồ của hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101312
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101312,
					"content": "Từ đây là có thể nhìn thấy, chính là nơi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101313
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101313,
					"content": "Hả? Vậy anh thì sao? Không phải anh cũng đến để tham gia cuộc thi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101314,
					"content": "Tôi thấy quanh đây vẫn rất nguy hiểm, tốt nhất nên đổi chỗ. Hình như trong hướng dẫn còn có những địa điểm khác nữa... Tôi muốn đến chỗ \"Tiên Nhân Thưởng Trà\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101315
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101315,
					"content": "Ừm, vậy thôi, xin tạm biệt. Hy vọng gặp được hai vị sẽ là khởi đầu may mắn của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akai"
				}
			]
		},
