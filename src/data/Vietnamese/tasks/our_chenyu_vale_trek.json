					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101002,
					"content": "Đã xem những bức ảnh được trưng bày chưa? \"Hành Trình Trầm Ngọc\" lần này có tổng cộng tám tác phẩm được chọn, một nửa trong số đó là của hai bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101003,
					"content": "Xin chúc mừng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101004,
					"content": "Ồ! Thật là tuyệt vời phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101005,
					"content": "#{NICKNAME}! Tôi nói rồi mà, kết quả cuối cùng là bốn trên bốn, là trăm phần trăm! Tôi tính toán ngày càng lợi hại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101006,
					"content": "Rõ ràng là bốn trên tám.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Haha, đúng như những gì tôi nghĩ ngày hôm qua, ban giám khảo cũng vô cùng khen ngợi hai tác phẩm còn lại của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101009,
					"content": "Vì vậy, xin hãy nhận lấy tập ảnh \"Hành Trình Trầm Ngọc\" bản giới hạn này, trong đó có tất cả các tác phẩm được tuyển chọn. Các bạn xứng đáng được nhận nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101010,
					"content": "Đây là bất ngờ sao? Nhìn có vẻ đẹp đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101011,
					"content": "Nếu bạn không chê, tôi vẫn còn một ít Mora ở đây, xin hãy nhận lấy. Tôi muốn cảm ơn một lần nữa vì sự hỗ trợ của các bạn, lần này là với tư cách cá nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101012,
					"content": "Vì đây là quê hương của tôi, các bạn đã ghi lại những cảnh đẹp động lòng của nó, những hình ảnh này chắc chắn sẽ khiến nhiều người yêu mến nơi này hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101013,
					"content": "Cảm ơn các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101007,
					"content": "Chà! Paimon tính siêu thật đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
		},
