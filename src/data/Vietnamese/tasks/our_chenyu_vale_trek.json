			"dialogs": [
				{
					"id": 711100201,
					"content": "Người bạn thân mến, bạn cũng đến đây để tham gia cuộc thi ảnh phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "Với tư cách là một nhiếp ảnh gia Fontaine đến từ nơi khai sinh ra máy ảnh, hãy để tôi cho bạn một lời khuyên: Tinh túy nhất trong những điều tinh túy của nhiếp ảnh, thực ra là máy ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "Vậy nên, để tôi giới thiệu cho các bạn một người, ở quê tôi ai cũng thích máy ảnh do anh ấy làm ra, giá cả lại phải chăng, tôi có nguồn mua hàng đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "Này này... đừng lộ vẻ mặt thờ ơ đó ra chứ, tôi sẽ xin giảm giá nhiều hơn cho các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "Này này... đừng đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
