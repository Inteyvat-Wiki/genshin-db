			"dialogs": [
				{
					"id": 711100801,
					"content": "Ồ... Những bức ảnh này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100802,
					"content": "Sao vậy? Ảnh của chúng tôi chưa đủ đẹp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "Hoàn toàn ngược lại... Mặc dù tôi đã xem rất nhiều tác phẩm xuất sắc trong vài ngày qua, nhưng tác phẩm của hai người vẫn khiến tôi thấy bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100805,
					"content": "Ví dụ, trong bức ảnh Làng Kiều Anh này, sự tham gia của bồ nông đã tạo thêm nét sống động cho ngôi làng yên bình, tương phản giữa tĩnh và động... Thật là một ý tưởng độc đáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100806,
					"content": "Theo góc nhìn thẩm mỹ của tôi, hai bạn nhất định sẽ được chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100807,
					"content": "Ồ! Quả là một đánh giá tốt, tôi thấy hơi ngại rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Paimon đâu phải người chụp, ngại ngùng gì chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "#Tôi ngại thay {NICKNAME} mà, tôi biết bạn khiêm tốn chứ bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Quay về chủ đề chính, công việc tuyển chọn của chúng tôi sẽ hoàn thành trước sáng mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100812,
					"content": "Ngày mai từ tám giờ sáng đến sáu giờ chiều, chúng tôi sẽ trưng bày các tác phẩm được chọn trước công chúng, cụ thể là trên phố bên ngoài Dịch Trạm Hợp Triệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100813,
					"content": "Cảm ơn cả hai đã ủng hộ cuộc thi ảnh phong cảnh \"Hành Trình Trầm Ngọc\". Ngày mai nhớ quay lại đây nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100814,
					"content": "Ừm! Chúng tôi sẽ không bỏ lỡ điều bất ngờ cuối cùng đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "Nói vậy làm tôi cũng hơi ngại rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
