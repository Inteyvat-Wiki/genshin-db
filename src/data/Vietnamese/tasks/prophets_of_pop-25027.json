			"dialogs": [
				{
					"id": 250270501,
					"content": "#Thế nào? {F#Cô}{M#Cậu} đã hỏi thăm phản hồi giúp tôi chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270502
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270502,
					"content": "Có những phản hồi như thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270503
					]
				},
				{
					"id": 250270503,
					"content": "Nói cho Milu Nui nghe phản hồi của khách hàng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250270504
					]
				},
				{
					"id": 250270504,
					"content": "#Thật, thật vậy sao? Cảm ơn {F#cô}{M#cậu}, những phản hồi này thực sự rất có giá trị. Tôi cũng sẽ cố gắng điều chỉnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270505
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270505,
					"content": "Nhưng nghe giọng điệu của khách... sao lại hoàn toàn coi đĩa nhạc của tôi là \"nhạc thiếu nhi\" thế nhỉ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270506
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270506,
					"content": "Không được, tôi nhất định phải thay đổi... Nhưng phải bắt đầu từ đâu đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
