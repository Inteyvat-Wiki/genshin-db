				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "Anh Milu lại ra đĩa nhạc mới rồi! Rốt cuộc có nên mua không đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "Về nhạc của Milu Nui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "Hmm? Nhạc của anh ấy hay mà. Cả Haloa và bé Saurian đều rất thích nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Mỗi khi hai đứa nghịch ngợm không chịu ngủ, tôi lại bật bài \"Ca Ngợi Mùa Xuân\" của anh Milu cho chúng nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "Nghe một lúc là chúng sẽ ngoan ngoãn ngủ thiếp đi, mà còn ngủ rất ngon nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "Nhưng mà... Haloa lại bảo thích những bản nhạc sôi động hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "Giá như anh Milu sáng tác thêm vài bài hát sôi động hơn thì hay biết mấy! Chắc chắn con bé sẽ chơi vui hơn nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
