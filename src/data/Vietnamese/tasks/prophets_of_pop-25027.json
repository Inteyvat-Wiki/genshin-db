					"nextDialogs": [
						250271308
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271308,
					"content": "Chỉ cần chuẩn bị sẵn sàng là tôi sẽ có thể bắt đầu ghi âm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271309
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271309,
					"content": "Hmm... Hay là bắt đầu thu từ \"âm thanh chiến đấu\" đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271310
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271310,
					"content": "...Không ổn, không ổn! Không thể bắt đầu từ đây được. Hay là tìm tư liệu âm thanh bình thường hơn đi.",
