					"Haloa Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "Woa, lại có đĩa nhạc mới rồi! Chắc chắn các bé saurian sẽ rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270302,
					"content": "Về nhạc của Milu Nui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "Em rất thích những ca khúc do chú Milu sáng tác, mà bé saurian nhà em còn thích hơn cả em nữa cơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270304,
					"content": "Mỗi khi nó quậy phá, mẹ lại bật nhạc của chú Milu, vừa nghe tiếng nhạc là nó sẽ lập tức ngoan ngoãn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270305,
					"content": "Ừm, nhưng mà những bài hát đó dài quá, em không nhớ nổi lời để hát cho bé saurian nhà em nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270306,
					"content": "Hihi, giá như chú Milu viết lời ngắn gọn hơn thì tốt, như vậy thì em có thể hát cho nó nghe mỗi ngày rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haloa Nui"
				}
			]
		},
