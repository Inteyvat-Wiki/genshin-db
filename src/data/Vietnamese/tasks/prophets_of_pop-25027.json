			"dialogs": [
				{
					"id": 250270401,
					"content": "Nhìn đàn chim phía trước kìa, thật tuyệt vời! Tiếng kêu của nó... nói không chừng có thể dùng làm tư liệu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Tuy nhiên, chỉ có vài con thì tiếng kêu của chúng sẽ hơi đơn điệu. Nếu sau này có thể tìm được cả đàn, thu âm tiếng kêu tập thể của chúng thì tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "#Khoan đã, phía trước là một bầy Koholasaur. {F#Cô}{M#Cậu} có nghe thấy tiếng nó cào móng vuốt lên đá không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "...Nó rất nhạy cảm, chúng ta đừng tới gần. Để tôi nhờ người của bộ tộc lấy tư liệu giúp vậy. Chắc chắn họ sẽ xử lý được chuyện này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Đó là... những chiến binh bộ tộc đang thi đấu. Tuyệt lắm, tiếng chiến đấu nghe rất hay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "Này! Ai đấy, đang làm gì vậy? Muốn ăn đòn à?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Chiến Binh Bộ Tộc Nóng Nảy"
				},
				{
					"id": 250270407,
					"content": "Chúng tôi đang... tìm cảm hứng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270408,
					"content": "Cảm hứng? Vậy thì ta sẽ cho ngươi tìm thỏa thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270409
					],
					"speakerTitle": "Chiến Binh Bộ Tộc Nóng Nảy"
				},
				{
					"id": 250270409,
					"content": "#Cứu, cứu tôi với! {NICKNAME}, mau ngăn anh ta lại đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
