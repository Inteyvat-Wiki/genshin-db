			"dialogs": [
				{
					"id": 250270901,
					"content": "Có lẽ nên tìm thêm cảm hứng từ âm thanh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "#Âm thanh? Ừm... Ý {F#cô}{M#cậu} là sử dụng trực tiếp âm thanh của thiên nhiên trong bài hát à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270903,
					"content": "#Hmm... Đó là một ý kiến hay đấy. Tuyệt vời! Tôi biết ngay là {F#cô}{M#cậu} rất thông minh và nhạy bén mà. Vậy chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270904,
					"content": "Khoan đã, anh đi tay không à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "Tất nhiên rồi. Chẳng lẽ tôi phải vác theo cả máy thu âm cồng kềnh ra ngoài trời để tìm cảm hứng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270906,
					"content": "Yên tâm đi, lần này mục đích của chúng ta chỉ là xác định xem những âm thanh nào có thể sử dụng được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270907,
					"content": "Ví dụ như tiếng vịt vỗ cánh, tiếng gợn sóng khi Koholasaur lao xuống nước, tiếng bước chân của Tepetlisaur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270908,
					"content": "Sau khi xác định được mục tiêu, tôi sẽ chuẩn bị đầy đủ mọi thứ rồi mới tiến hành thu âm chính thức... Nhưng đó là chuyện sau này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270909,
					"content": "Còn bây giờ, chúng ta hãy lên đường ngay thôi, đừng chần chừ gì nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
