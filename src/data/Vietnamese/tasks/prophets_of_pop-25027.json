			"dialogs": [
				{
					"id": 250270701,
					"content": "Trước tiên, phải hỏi ý kiến của khách hàng xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270702
					]
				},
				{
					"id": 250270702,
					"content": "Khụ... Tôi không phản bác. Dù sao thì trước đây tôi cũng đã hỏi qua nhiều người rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270703
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270703,
					"content": "...Tuy nhiên có thể khi gặp tôi, theo bản năng thì họ sẽ nói những lời xã giao. Từ đó không thể nói ra những phản hồi thật lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270704
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270704,
					"content": "#{NICKNAME}, {F#cô}{M#cậu} có thể hỏi ý kiến khách hàng giúp tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270705
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270705,
					"content": "#Trước mặt {F#cô}{M#cậu} thì họ chắc chắn sẽ nói ra... những ý kiến chân thật hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
