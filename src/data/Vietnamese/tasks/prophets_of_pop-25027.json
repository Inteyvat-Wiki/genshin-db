			"trigger": {
				"objectNames": [
					"Milu Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "Tên Pakaa này đúng là không thể nói chuyện nổi mà! Cậu ta chẳng hiểu gì về lý tưởng âm nhạc của tôi cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270102,
					"content": "Xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "#Ồ, {F#cô}{M#cậu} có vẻ là một... nhà lữ hành nhỉ? Xin chào, tôi là Milu Nui, một nhạc sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270105,
					"content": "#Nếu {F#cô}{M#cậu} đã từng đến Tiệm Đĩa Nhạc Xochicuicatl thì chắc chắn sẽ thấy đĩa nhạc mà tôi sáng tác ở khu nhạc pop đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270106,
					"content": "Trong đĩa nhạc đó có chứa đựng sự hiểu biết của tôi về \"pop\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270107,
					"content": "Chỉ có tên Pakaa kia là không hiểu thôi. Cậu ta cứ khăng khăng rằng nhạc của tôi giống \"nhạc thiếu nhi\" hơn là \"nhạc pop\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270108,
					"content": "Dù tôi có cố giải thích thế nào thì cậu ta cũng nhất quyết xếp đĩa nhạc của tôi vào khu nhạc thiếu nhi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270109,
					"content": "Mặc dù... đúng là bọn trẻ con rất thích, và cũng có một số phụ huynh mua về làm quà cho con mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270110,
					"content": "Nhưng đám trẻ luôn là những thính giả nhạy bén nhất! Với cả bộ tộc này cũng có không ít trẻ con mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270111,
					"content": "Nhạc của tôi được rất nhiều đứa trẻ yêu thích, nên hoàn toàn có thể xếp nó vào khu vực nhạc pop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270112,
					"content": "Ừm, nói cũng có lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "Đúng chứ? Hừ, tôi đã biết ngay là tên Pakaa đó không biết thưởng thức mà. Đợi tôi sáng tác xong bài hát mới này thì cậu ta chắc chắn sẽ bị tôi chinh phục!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270115,
					"content": "#Tôi không tin vào gu âm nhạc của cậu ta nữa... Nhà lữ hành, hiểu biết về âm nhạc của {F#cô}{M#cậu} là như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270116,
					"content": "À ừm... Âm nhạc thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "#{F#Cô}{M#Cậu} có biết chơi nhạc cụ không? Biết hát cũng được. Ngâm nga thôi cũng được luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270118,
					"content": "Đều là sở trường của tôi hết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "#Vậy thì tốt quá! Chắc chắn {F#cô}{M#cậu} sẽ hiểu được lý tưởng âm nhạc của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270122,
					"content": "#Tôi đang cần một người như {F#cô}{M#cậu} để giúp tôi sáng tác những bài hát mới đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270123,
					"content": "#Yên tâm, tôi sẽ chuẩn bị cho {F#cô}{M#cậu} một khoản thù lao xứng đáng, tuyệt đối không để {F#cô}{M#cậu} làm việc không công đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270124,
					"content": "#Nào, hãy cho tôi biết bằng trực giác của {F#cô}{M#cậu}. Theo {F#cô}{M#cậu}, tôi nên làm gì trước tiên để tạo ra một bản nhạc xuất sắc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270120,
					"content": "Tôi hoàn toàn không biết gì cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "#Không sao! Những người như {F#cô}{M#cậu} mới thực sự có thể thưởng thức âm nhạc bằng cả trái tim. Khi {F#cô}{M#cậu} bình luận âm nhạc thì chắc chắn sẽ khách quan và công bằng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270113,
					"content": "Cũng có thể coi là \"nhạc pop thiếu nhi\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "Lý tưởng âm nhạc của anh là gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
			"id": 2502702,
