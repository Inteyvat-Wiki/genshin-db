			"dialogs": [
				{
					"id": 760540301,
					"content": "Như này đúng không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540302,
					"content": "Để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540303,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540304,
					"content": "Mặt trăng... Mặt trăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540305,
					"content": "Ở đây thì thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540306,
					"content": "Lần này tôi thắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540307,
					"content": "Ba mặt trăng của tôi xếp thành một hàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540308,
					"content": "Ừm, thế là thắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540309,
					"content": "Hmm... Trăng lên rồi trăng lặn, đúng là quãng thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540310,
					"content": "Mặt trăng của chúng ta chẳng nhường nhịn nhau chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540311,
					"content": "Có phải... hòa rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540312,
					"content": "#Thì ra {F#cô}{M#cậu} thích suy nghĩ thấu đáo rồi mới đưa ra quyết định. Hmm, không sao, chúng ta có nhiều thời gian mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540313,
					"content": "Quên mất cách đặt \"mặt trăng\" lên \"bầu trời đêm\" sao? Có cần tôi giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540314,
					"content": "Không thích trò chơi này sao? Tôi thấy cũng thú vị lắm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540315,
					"content": "#Hửm? {F#Cô}{M#Cậu} đang nhìn tôi à? Tôi cảm nhận được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540316,
					"content": "Trên mặt tôi... có đáp án về mặt trăng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540317,
					"content": "Bàn cờ ở bên kia kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540318,
					"content": "#Ừm, mặt trăng của {F#cô}{M#cậu} thắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540319,
					"content": "#Bầu trời đêm này thuộc về {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540320,
					"content": "Ah... Sơ suất một chút thôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540321,
					"content": "Cùng Columbina trải qua thời gian chơi trò chơi vui vẻ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "Ba mặt trăng xếp thành một đường thẳng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210203,
					"content": "Sao thế? Vẫn còn đang nghĩ về chuyện thắng thua vừa rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "À không. Chỉ là... giờ nhìn lại trò chơi này lại có cảm giác hơi khó tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210205,
					"content": "À phải rồi, cô đã có được sức mạnh của cả ba mặt trăng, đó không đơn thuần là sức mạnh có thể chi phối trời đêm nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Ừm, tôi cũng hay nghĩ, nếu lúc đầu ba nữ thần mặt trăng không có bất đồng, nói không chừng vận mệnh của thế giới đã khác đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210207,
					"content": "Trông họ thế nào nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "Ừm... Người đầu tiên tôi gặp là Nữ Thần Hồng Nguyệt, Sonnet. Cô ấy hoạt bát hơn tôi nghĩ, giống như cô em gái ham chơi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210209,
					"content": "Nữ Thần Hằng Nguyệt Aria là người điềm đạm nhất, có khả năng lãnh đạo và cũng rất dịu dàng với người khác. À, giống như Lauma vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210210,
					"content": "Nữ Thần Sương Nguyệt Canon... có vẻ là một nữ thần vừa thông thái lại vừa có tầm nhìn. Chính cô ấy đã nhường mặt trăng của mình cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210211,
					"content": "Nghe có vẻ đều là những vị thần tốt bụng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Đúng vậy. Dù có bất đồng, nhưng họ đều yêu thế giới Teyvat này, yêu ngôi nhà này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210213,
					"content": "Khi tôi nói về chuyện tương lai, họ có vẻ rất vui. Như thể họ thấy hạnh phúc vì thế giới này vẫn còn một tương lai phong phú đến thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210214,
					"content": "Cũng chính vì thế, họ đã cho tôi sức mạnh, giúp tôi trở về \"ngôi nhà\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210215,
					"content": "Ừm... Thật muốn gặp họ một lần để cảm ơn cho đàng hoàng quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "Tôi cũng nghĩ vậy. Nhưng mà... chắc là chuyện không thể nào rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210217,
					"content": "May mà thế giới này vẫn tiếp tục tiến về phía trước, những người mà họ bảo vệ vẫn sống sót và truyền tụng những câu chuyện về họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210218,
					"content": "Đúng vậy! Chỉ cần sống tốt, không để kẻ xấu phá hủy thế giới này, đó chính là cách tốt nhất để cảm ơn ba nữ thần rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "Paimon cũng biết ăn nói quá ha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "Vậy là ngày nào Paimon cũng tràn ngập lòng biết ơn rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "Đương nhiên rồi! Tôi chắc chắn ngày nào cũng sẽ sống thật vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "Columbina cũng vậy nhé! Mỗi ngày phải ăn no ngủ kỹ, khi nào muốn chơi trò chơi thì cứ đến tìm chúng tôi nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Haha, được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210224,
					"content": "Sau này khi chơi Cờ Mặt Trăng, có lẽ tôi sẽ luôn nhớ tới ba vị nữ thần tốt bụng đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
