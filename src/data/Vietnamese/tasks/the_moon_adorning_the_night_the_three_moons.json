			"dialogs": [
				{
					"id": 761210101,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210102,
					"content": "Columbina, xin chào. Hôm nay tâm trạng cô có vẻ rất tốt nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210103,
					"content": "Hah... Lên đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210104,
					"content": "Ồ! Cô lại muốn chơi Cờ Mặt Trăng à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210105,
					"content": "Ừm, lâu rồi không chơi, cũng thấy hơi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210106,
					"content": "Luật chơi vẫn như cũ chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "Không phải vì cô đã trở thành nữ thần ba mặt trăng nên mỗi lần có thể di chuyển thêm mấy quân đâu nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210108,
					"content": "Thế là gian lận rồi, tôi không muốn thắng bằng cách đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761210109,
					"content": "Hihi, tôi biết mà, đùa chút thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210110,
					"content": "Vậy chúng ta bắt đầu nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
