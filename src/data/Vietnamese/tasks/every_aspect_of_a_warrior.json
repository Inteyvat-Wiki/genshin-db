			"dialogs": [
				{
					"id": 750330101,
					"content": "Tại sao em cứ phải kiên trì chứ? Em không được bỏ cuộc sao...? Em không làm nữa! Chị giúp em đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330102
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330102,
					"content": "Thật mất mặt! Anh to con như vậy mà gặp một chút khó khăn là đã muốn bỏ chạy. Vậy mà là dũng sĩ sao? Uổng công anh là anh của em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330103,
					"content": "Bộ em không có lúc nghĩ không ra cách hay cần tìm người giúp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330104
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330104,
					"content": "Có chứ. Em sẽ về tìm cha và chị, nhờ họ kiểm tra thành quả đặc huấn của em. Em không yếu đuối như anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330105,
					"content": "Acomitl, chị nghĩ đội trưởng từ chối đơn xin phép rời đội của em là hy vọng em sẽ suy nghĩ kỹ, không đưa ra quyết định trong lúc cảm xúc không ổn định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330106
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330106,
					"content": "Khi nào bình tĩnh trở lại thì tự đưa ra quyết định đi, sau này không hối hận là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330107,
					"content": "Chị đã giải ngũ rồi, bản thân cũng không biết mình nên làm gì, e là không có tư cách dạy em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330108
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330108,
					"content": "Không ngờ ba người là người một nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330109,
						750330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330109,
					"content": "Thật bất ngờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				},
				{
					"id": 750330111,
					"content": "Là hai người sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330112
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330112,
					"content": "Tin xấu đây. Ân nhân, kế hoạch chạy trốn thất bại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330113,
						750330114
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330113,
					"content": "Nằm trong dự kiến mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330115,
					"content": "Không có cách nào giúp tôi thoát khỏi nỗi đau này sao? Tại sao làm dũng sĩ lại mệt mỏi đến vậy? Tại sao mọi việc không thể đơn giản một chút chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330116
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330116,
					"content": "Còn đang suy nghĩ chuyện của đội bay sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330117
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330117,
					"content": "Xin lỗi, Acomitl. Theo kinh nghiệm của cha thì chắc là không đơn giản thế đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330118
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330118,
					"content": "Cha vừa sửa xong bao tay của Matahga rồi. Manyoya, bao tay của con cần sửa luôn không? Ồ? Chúng ta có khách này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330119
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330119,
					"content": "Cha, đây là nhà mạo hiểm mà tụi con gặp bên ngoài trong lúc huấn luyện. Họ còn giúp Acomitl nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330120,
					"content": "Xin chào, cứ gọi ta Xueyoni là được. Ta là huấn luyện viên, cũng là cha của mấy đứa này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330121
					],
					"speakerTitle": "Xueyoni",
					"speakerSubtitle": "Bậc Thầy Huấn Luyện \"Hội Hoa Vũ\""
				},
				{
					"id": 750330121,
					"content": "Tình trạng của Acomitl có vẻ rất không ổn. Chú có gì cần giúp thì cứ nói với tụi cháu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330122,
					"content": "Cảm ơn các cháu, nhưng ta không cảm thấy Acomitl có vấn đề gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330123
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330123,
					"content": "Hả? Chú định mặc kệ anh ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330124,
					"content": "Haha, ý ta là... Nói vậy đi, nếu các cháu là nhà mạo hiểm, chắc là từng gia nhập Hiệp Hội Nhà Mạo Hiểm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330125
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330125,
					"content": "Dạng tổ chức này tuyệt vời lắm. Nhà mạo hiểm, là người vì muốn khám phá thế giới mà hành động, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330126
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330126,
					"content": "Nếu hỏi mục đích cụ thể thì mỗi nhà mạo hiểm đều khác nhau. Có người vì Mora, có người vì tri thức, có người chỉ đơn thuần vì rảnh rỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330127
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330127,
					"content": "Tập hợp những người như vậy lại, bảo họ công nhận cùng một khẩu hiệu là chuyện rất lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330128
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330128,
					"content": "Như ta, một ông chú Kỵ Sĩ Saurian của đội bay đã giải ngũ, về sau trở thành huấn luyện viên trong bộ tộc. Ta không thể nào tưởng tượng được việc huấn luyện viên của sáu bộ tộc liên kết với nhau thành hiệp hội sẽ như thế nào đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330129
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330129,
					"content": "Hmm... Chuyện này có liên quan đến Acomitl sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330130,
					"content": "Cha nói chuyện lúc nào cũng vậy. Trước đây lúc ông ấy còn ở trong đội bay, ai cũng đều phải nghe ý kiến của ông ấy, kể cả Qucusaur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330131,
					"content": "Bây giờ cha là huấn luyện viên của bộ tộc, tất cả những người muốn trở thành dũng sĩ đều sẽ đến hỏi ý kiến của ông ấy. Nên là đừng sốt ruột, cứ nghe tiếp đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330132
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330132,
					"content": "Đó đều là chuyện quá khứ rồi, Manyoya. Nhưng cha vẫn sẽ nói hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330133
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330133,
					"content": "Tất cả huấn luyện viên ở đây đều vì hướng đến hình tượng \"dũng sĩ\" nên mới tốn nhiều công sức để bố trí, thiết kế hạng mục huấn luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330134
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330134,
					"content": "Mọi người đều muốn nhìn thấy dũng sĩ giỏi nhất trong mơ của mình xuất hiện. Nhưng dũng sĩ đó rốt cuộc là như thế nào thì không ai quy định được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330135
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330135,
					"content": "Do đó các huấn luyện viên không thể nào lập được hiệp hội, nguyên tắc hay điều lệ gì đó. Thật sự không thể nào viết ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330136
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330136,
					"content": "Vị dũng sĩ lợi hại nhất đó có hàng ngàn khuôn mặt, hàng ngàn loại tính cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330137
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330137,
					"content": "Vị dũng sĩ mà ai cũng muốn trở thành đó có lúc thì ý chí kiên cường, có lúc thì nghi ngờ bản thân, và còn sẽ già đi, sẽ qua đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330138
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330138,
					"content": "Dũng sĩ sẽ không mệt mỏi sao? Ta có thể đưa ra rất nhiều ví dụ ghi chép trên cuộn dệt, chứng minh việc tự nghi ngờ bản thân và cảm giác mệt mỏi đó sẽ đi theo tất cả mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330139
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330139,
					"content": "Dũng sĩ là phải cao to sao? Ta biết rất nhiều người cao to như người khổng lồ nhưng lại bỉ ổi đến ghê tởm, chuyện của họ cũng được ghi chép trên cuộn dệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330140
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330140,
					"content": "Dũng sĩ tất nhiên cũng sẽ yếu đuối, đó là quy luật tự nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330141
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330141,
					"content": "Con ta gọi ta là dũng sĩ, nhưng nhìn xem, bây giờ ta đã không bay được nữa. Chim già thì không còn sức để bay nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330142
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330142,
					"content": "Một người có khuôn mặt dũng sĩ hoàn hảo, mọi thứ đều phù hợp với tiêu chuẩn trong đầu những kẻ vô vị, thì sẽ không phải là anh hùng được Natlan công nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330143
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330143,
					"content": "Manyoya, Acomitl, Matahga, cha dẫn các con đến nhà bay, là vì các con muốn trở thành anh hùng của Hội Hoa Vũ, nhìn xuống dưới từ một nơi cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330144
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330144,
					"content": "Phiền não và khát vọng của các con đều là trạng thái nhất thời trên hành trình dài, không phải là vấn đề cần phải giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330145
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330145,
					"content": "Rời khỏi đội bay thì không phải dũng sĩ sao? Vào đội bay thì nhất định là dũng sĩ à? Không có chuyện như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330146
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330146,
					"content": "Có chí lớn cũng được, do dự cũng không sao, suy sụp cũng bình thường. Con là dũng sĩ, nên cần có trải nghiệm mới trở thành anh hùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330147
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330147,
					"content": "Sống chung với trạng thái của mình, dựa vào chính mình làm quen với nó, chiến thắng nó, đừng để bị nó chi phối ngược lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330148
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330148,
					"content": "Đây là cách làm của Natlan, cách làm của anh hùng, hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330149
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330149,
					"content": "Con hiểu ý của cha rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330150
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330150,
					"content": "Acomitl, con vẫn đang do dự đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330151
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330152
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330152,
					"content": "Nói một tràng đạo lý suông không phải tác phong của gia đình chúng ta. Con bay một lần với chị và em trai đi, giống như lúc nhỏ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330153
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330153,
					"content": "Cho cơ thể và tinh thần của con cùng quyết định. Cứ ru rú trong nhà thì không nghĩ ra cách hay đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330154
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330154,
					"content": "Con biết rồi, thưa cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330155
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330155,
					"content": "#Huấn luyện viên nói chuyện trừu tượng như vậy sao? Tôi cảm thấy mình nghe chưa hiểu. {NICKNAME} có hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330156,
						750330157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330156,
					"content": "Hiểu chứ. Tóm lại là thử thách bay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330158,
					"content": "Nhà mạo hiểm, ta đã nghe mấy đứa con kể về chuyện của cháu rồi. Cháu là một người trẻ tuổi thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330159
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330159,
					"content": "Có gan thi đấu với Manyoya, giúp đỡ Acomitl, và Matahga cũng công nhận cháu là dũng sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330160
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330160,
					"content": "Ta muốn mời cháu bay chung với mấy đứa này một lần. Cháu thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330161,
						750330162
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330161,
					"content": "Bay thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330163,
					"content": "Haha, được. Khi nào suy nghĩ xong thì đến đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330164
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330164,
					"content": "Ba đứa con của ta đều là cao thủ hàng đầu của Hội Hoa Vũ, mấy đứa bay chung chắc chắn sẽ sảng khoái lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330162,
					"content": "Để suy nghĩ đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330157,
					"content": "Không hiểu. Giáo dục gia đình cao siêu quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330114,
					"content": "(Nhún vai)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330110,
					"content": "Cũng đã đoán trước được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				}
			]
		},
		{
