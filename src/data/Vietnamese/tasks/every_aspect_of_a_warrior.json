			"dialogs": [
				{
					"id": 750330401,
					"content": "Bay giỏi lắm, người trẻ tuổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330402
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330402,
					"content": "#Ân nhân, lúc nãy {F#cô}{M#cậu} thấy tôi bay như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330403,
						750330404
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330403,
					"content": "Tốt lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				},
				{
					"id": 750330405,
					"content": "#Cảm ơn lời động viên. Tôi nhìn ra được, so với {F#cô}{M#cậu} thì tôi bay không tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330406
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330406,
					"content": "Acomitl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330407
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330407,
					"content": "Không phải như mọi người nghĩ đâu. Tôi không phải vì không bằng người khác mà chán nản. Tôi bay được, tôi biết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330408
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330408,
					"content": "Chỉ có điều ở trong trạng thái tồi tệ thời gian dài đã phá hoại lòng tin đối với bản thân rồi. Dù bay được tốt cũng không thể nào đối mặt một cách thoải mái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330409
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330409,
					"content": "#{NICKNAME} thì khác, {M#cậu}{F#cô} ấy thoải mái hơn nhiều. Mọi người đều có thể nhìn ra mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330410
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330410,
					"content": "Cha, con biết cha và chị muốn con tự quyết định, không được trốn tránh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330411
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330411,
					"content": "Nếu bây giờ con nói dù là cơ thể, não bộ hay trái tim này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330412
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330412,
					"content": "Đều không muốn tiếp tục bước đi trên con đường không phù hợp với mình nữa. Vậy thì mọi người còn ủng hộ quyết định này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330413
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330413,
					"content": "Không sao, chỉ cần là quyết định do bản thân em đưa ra, và chỉ cần em chịu gánh vác hậu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330414,
					"content": "Matahga, liệu em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330415
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330415,
					"content": "Này! Đừng tưởng lúc này em sẽ đứng ra chỉ trích anh chứ. Tính cách của anh như thế nào em cũng biết rõ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330416
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330416,
					"content": "Không chịu được thì dứt khoát từ bỏ. Chỉ cần thẳng thắn thì anh vẫn được xem là dũng sĩ, không ai có tư cách phê bình anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330417
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330417,
					"content": "Đôi lúc công việc của huấn luyện viên cũng nhẹ nhàng lắm. Lập kế hoạch huấn luyện cho dũng sĩ, còn bản thân thì không cần làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330418
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330418,
					"content": "Nhưng cha của các con cũng từng trải qua khoảng thời gian bay đi bay lại với Saurian suốt ngày, biết mùi vị thật sự của cuộc sống kiểu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330419
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330419,
					"content": "Phê bình người khác dễ lắm, còn bắt tay vào làm thì luôn khó hơn chỉ khua môi múa mép.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330420
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330420,
					"content": "Là một huấn luyện viên, cha kiến nghị con xin nghỉ phép để điều chỉnh trạng thái của mình. Dù làm vậy sẽ khiến đồng đội bất mãn, nhưng con cũng nên làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330421
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330421,
					"content": "Là một người cha, biết con không muốn tiếp tục nữa, cha tôn trọng lựa chọn của con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330422
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330422,
					"content": "Dù không ở trong đội bay nữa cũng không có gì to tát. Dũng sĩ của Hội Hoa Vũ không phải chỉ có thể dùng cách bay để chứng minh giá trị của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330423
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330423,
					"content": "Cảm ơn mọi người... Ban đầu còn lo rằng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330424
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330424,
					"content": "Đừng suy nghĩ nhiều nữa. Chúng ta là người một nhà, có chuyện gì thì mọi người đều sẽ cùng em nghĩ cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330425
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330425,
					"content": "Làm dũng sĩ cũng không dễ nhỉ. Không ngờ vào đội bay của Hội Hoa Vũ lại vất vả đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330426,
						750330428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330426,
					"content": "Chúng ta cũng có nỗi vất vả của chúng ta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330427
					]
				},
				{
					"id": 750330427,
					"content": "Cũng đúng. Nghĩ lại suốt dọc đường gặp bao nhiêu chuyện mà chúng ta vẫn vượt qua được, tôi cũng cảm thấy tự hào lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330430,
					"content": "Trở thành dũng sĩ vốn dĩ đã không dễ, muốn từ dũng sĩ trở thành anh hùng lại càng khó hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330431
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330431,
					"content": "Khi từng gặp qua nhiều dũng sĩ, việc người như thế nào sẽ có khí chất trở thành anh hùng thật ra rất dễ nhìn ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330432
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330432,
					"content": "Người trẻ tuổi, chắc chắn cháu đã trải qua rất nhiều thử thách nhỉ? Ánh mắt của cháu cho ta thấy điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330433,
						750330434
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330433,
					"content": "Chú khó mà tưởng tượng được đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330435,
					"content": "Xem ra ta nhìn không sai. Con đường của cháu khác với gia đình ta. Có lẽ cháu còn phải đi rất xa, và ta rất sẵn lòng giúp đỡ vị anh hùng của tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330436
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330436,
					"content": "Huống hồ cháu cũng đã quen biết với gia đình này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330437
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330437,
					"content": "Nếu muốn dùng đường đua huấn luyện thì chỉ cần nói với ta một tiếng. Bất kỳ lúc nào cũng có thể bay thử ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330438
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330438,
					"content": "Cảm ơn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330439
					]
				},
				{
					"id": 750330439,
					"content": "Không cần khách sáo. Ta rất mong chờ giây phút được nhìn thấy cháu trở thành anh hùng và tỏa sáng trên bầu trời đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330434,
					"content": "(Giữ im lặng)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330428,
					"content": "Dũng sĩ không phải ai cũng làm được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330429
					]
				},
				{
					"id": 750330429,
					"content": "Nghiêm khắc quá, nhưng nghĩ thấy cũng đúng. Thôi, dù sao tôi cũng không muốn vì trở thành dũng sĩ mà ngày nào cũng cực khổ rèn luyện đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330404,
					"content": "Cũng ổn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				}
			]
