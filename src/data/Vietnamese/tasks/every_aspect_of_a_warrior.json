						750330604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330604,
					"content": "Chị à, đừng cười em nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330605
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330605,
					"content": "Các con đều là con ngoan của cha, đều là dũng sĩ. Tất cả mọi dũng sĩ ở mỗi giai đoạn đều phải đối diện với các vấn đề khác nhau.",
