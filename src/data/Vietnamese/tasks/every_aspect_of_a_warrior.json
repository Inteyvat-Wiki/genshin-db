					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "Bay chung với mấy đứa con của ta đi, người trẻ tuổi. Được bay với cao thủ của Hội Hoa Vũ là cơ hội hiếm có đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330202,
					"content": "Đuổi theo <color=#00E1FFFF>đuốc bay</color> trên đường đua, ai đuổi kịp trước là người chiến thắng. Mấy đứa này từ nhỏ đã được huấn luyện theo cách này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>Đuốc được nâng lên bởi một quả khí cầu với lông vũ màu đỏ</color>, tượng trưng cho vinh dự và trách nhiệm mà dũng sĩ nên gách vác. Là ta làm cho chúng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330204,
					"content": "Khi nào thấy thì mấy đứa sẽ nhận ra ngay thôi. Thế nào, thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330205,
					"content": "Đã sẵn sàng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "Haha, được! Vậy thì đến điểm xuất phát chuẩn bị đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330207,
					"content": "Cần chuẩn bị thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "Vậy chờ khi nào chuẩn bị xong rồi thì tính tiếp vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
