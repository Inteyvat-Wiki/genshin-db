			"dialogs": [
				{
					"id": 708020201,
					"content": "Ở đây sao...Pallad, bạn chắc chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "Tôi chắc chắn, ngài Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020203,
					"content": "Mọi người đang nói về chuyện cha của Joel sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "Đây chẳng phải Nhà Lữ Hành sao? Xem ra bạn từ chỗ Joel đến nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "Đứa trẻ đó, ngày nào cũng nhờ người hỏi thăm tin tức ở chỗ tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "Tuy nhiên, lần này tôi muốn mang đến cho cậu ấy một tin tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "Thời gian trước, Hiệp Hội Nhà Mạo Hiểm chúng tôi vừa tổ chức một buổi \"Huấn Luyện Núi Tuyết\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "Để tôi nói tiếp, ngài Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020209,
					"content": "Trên đường đến chỗ tham gia buổi huấn luyện đặc biệt đó, vì gió tuyết quá lớn nên tôi đã đi lệch đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020210,
					"content": "Khi tôi đang mò mẫn tìm đường, tôi chợt nhìn thấy một bóng người mơ hồ trên vách đá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020211,
					"content": "Lúc đầu tôi nghĩ đó là một nhà mạo hiểm cũng lạc đường như tôi, vì vậy tôi đã gọi to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020212,
					"content": "Nhưng trước khi thu hút được sự chú ý của người đó...tiếng gọi của tôi đã thu hút bọn ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020213,
					"content": "Ở một môi trường như núi tuyết, tôi không đủ tự tin để đánh bại lũ ma vật đó, nên đành phải rút lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020214,
					"content": "Sau khi trở về, tôi nói chuyện này với ngài Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020215,
					"content": "Bóng người đó là cha của Joel sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "Chúng tôi cũng không chắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "Dù sao thì ít nhất chúng ta cũng biết được có người bị kẹt trong núi tuyết, chúng ta phải cứu người thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Còn về chuyện người đó rốt cuộc có phải cha của Joel không...thì phải xem vận may.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "Tóm lại, tôi đã cử người của hiệp hội có khả năng vào núi tuyết để đến đó tìm kiếm và giải cứu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "Tôi cũng chuẩn bị một chút, lát nữa sẽ đến núi tuyết tham gia tìm kiếm và giải cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020222,
					"content": "Để tôi đi cùng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Bạn đồng ý giúp sao? Tuyệt quá, vậy chúng ta cùng xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad Lỗ Mãng"
				},
				{
					"id": 708020223,
					"content": "Tôi sẽ đánh bại lũ ma vật đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Có lẽ là một nhà mạo hiểm lạc đường nào đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
