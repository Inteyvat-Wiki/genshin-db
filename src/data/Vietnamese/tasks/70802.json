			"dialogs": [
				{
					"id": 708020101,
					"content": "Lần này có thật sẽ tìm thấy cha không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020102,
					"content": "Có tin tức của cha em chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "#Là {F#chị}{M#anh} sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020104,
					"content": "Anh Pallad nói với em, hình như chú Cyrus đã tìm được tin tức có liên quan đến cha em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020105,
					"content": "Tuy rằng vẫn chưa thể xác nhận... nhưng anh Pallad nói, lần này manh mối họ tìm được rất hữu dụng, không chừng thật sự có thể tìm được cha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020106,
					"content": "Em muốn vào núi tuyết cùng họ, nhưng chú Cyrus bảo em ở lại trong doanh trại, khi nào có tin tức họ sẽ báo cho em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020107,
					"content": "#Nếu như có thể, {F#chị}{M#anh} giúp em đi hỏi tin tức ở chỗ chú Cyrus được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020108,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "Em, em sợ nghe được...tin dữ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020111,
					"content": "#Tóm lại, nhờ {F#chị}{M#anh} đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020109,
					"content": "Sao em không tự mình đi hỏi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
