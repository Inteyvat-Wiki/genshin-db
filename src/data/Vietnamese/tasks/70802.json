				},
				{
					"id": 708020407,
					"content": "Nhà Lữ Hành, hãy nói Joel chờ tôi, chút nữa tôi sẽ đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
