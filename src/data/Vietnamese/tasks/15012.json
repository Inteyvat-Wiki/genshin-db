				]
			},
			"dialogs": [
				{
					"id": 150120501,
					"content": "Tôi vừa sợ vừa hết cách, chỉ có thể đi đường nhỏ để vòng qua chúng. Không ngờ lại gặp đám cướp đó... May mà hai vị đến kịp lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120502,
					"content": "Lúc chạy trốn mà cô vẫn mang theo những tinh thạch này sao? Nguy hiểm như vậy, sao không vứt chúng đi thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120503,
					"content": "Tôi đã vứt nhiều lắm rồi. Chỉ còn lại một viên tinh thạch thuần khiết nhất thôi. Dù thế nào thì tôi cũng phải mang nó về cho bằng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120504,
					"content": "...Vì Tlazolli, cũng vì Nechca đáng thương nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120505,
					"content": "Hai người đó là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "#Ồ, {F#cô}{M#cậu} không biết cũng bình thường thôi. Tlazolli... từng là một thợ thủ công đúc Tên Cổ, còn Nechca là con gái của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "Cheven"
				}
			]
		},
