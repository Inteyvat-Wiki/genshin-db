					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120605,
					"content": "Tôi đã vứt nhiều lắm rồi. Chỉ còn lại một viên tinh thạch thuần khiết nhất thôi. Dù thế nào thì tôi cũng phải mang nó về cho bằng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120606
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120606,
					"content": "...Vì Tlazolli, cũng vì Nechca đáng thương nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120607
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120607,
					"content": "Hai người đó là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120608
					]
				},
				{
					"id": 150120608,
					"content": "#Ồ, {F#cô}{M#cậu} không biết cũng bình thường thôi. Tlazolli... từng là một thợ thủ công đúc Tên Cổ, còn Nechca là con gái của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120609
					],
					"speakerTitle": "Cheven"
				}
			]
		},
		{
			"id": 1501207,
			"completionStepIds": [
				1501204
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
