						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cheven"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1439.465,
							64.598,
							8237.596
						],
						"pointId": 350100078
					}
				]
			},
			"dialogs": [
				{
					"id": 150121405,
					"content": "Sao cô ấy lại không đúc Tên Cổ nữa vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121406
					]
				},
				{
					"id": 150121406,
					"content": "...Bởi vì con gái của cô ấy. Bé Nechca đáng thương bị bệnh nặng, Tlazolli gần như bỏ hết mọi thứ, toàn tâm chăm sóc cô bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121407,
					"content": "Lúc bệnh tình của Nechca nghiêm trọng nhất, Tlazolli giống như ngọn đuốc mắc kẹt trong vũng bùn, liều mạng phát ra ánh sáng và hơi ấm. Nhưng bùn lầy phía dưới lại càng ngày càng đến gần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121408
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121408,
					"content": "Nhưng may mà vẫn ổn! Có thuốc của bác sĩ, còn có sự bảo vệ của Wayob, ngọn lửa sinh mệnh của Nechca đã bùng cháy trở lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121409,
					"content": "Sau đó, tình trạng của Nechca dần được cải thiện. Dù còn rất yếu và chỉ có thể nghỉ ngơi ở nhà, nhưng cô bé đã có sức để viết thư rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121410,
					"content": "Nghe nói cô bé thường xuyên gửi thư cho Xilonen, cô bé cũng mơ ước trở thành một thợ thủ công đúc Tên Cổ và đảm nhận trọng trách mà mẹ mình từng tự hào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121411
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121411,
					"content": "Vài ngày nữa sẽ là sinh nhật của Nechca, nên Tlazolli đến nhờ tôi giúp cô ấy tìm Tinh Thạch Núi Lửa đủ độ tinh khiết để làm quà sinh nhật cho Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121412,
						150121413
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121412,
					"content": "Cho nên cô mới một mình đến đây đào khoáng sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				},
				{
					"id": 150121414,
					"content": "Đúng là một mẫu khoáng thạch có ý nghĩa rất lớn. Với món quà xinh đẹp như vậy, cô bé tên Nechca đó chắc chắn sẽ khỏi bệnh nhanh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121415,
					"content": "#Vậy tôi thay mặt Tlazolli và Nechca nhận lời chúc phúc của {F#cô}{M#cậu} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121416
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121416,
					"content": "Chúng ta về trước đi, không thể để Imix sốt ruột được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121417
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121417,
					"content": "#Đúng rồi, nếu {F#cô}{M#cậu} đồng ý thì ngày mai cùng tôi đi thăm Tlazolli nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121418
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121418,
					"content": "#May mà có {F#cô}{M#cậu} giúp đỡ, tinh thạch này mới không bị đám người đó cướp mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121419
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121419,
					"content": "#{F#Cô}{M#Cậu} đã bảo vệ viên tinh thạch có ý nghĩa to lớn như vậy, cũng nên nhận được một món quà có ý nghĩa lớn lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121420,
						150121423
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121420,
					"content": "Hy vọng có thể khiến cho Nechca vui vẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121421
					]
				},
				{
					"id": 150121421,
					"content": "Ừm, tâm trạng tốt thì bệnh sẽ khỏi nhanh hơn mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121422,
					"content": "Đương nhiên rồi. À ừm... Nếu tặng chút quà cho chúng tôi thì chúng tôi sẽ vui hơn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121426,
					"content": "Haha, yên tâm đi, món quà này chắc chắn sẽ khiến hai vị hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121427
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121427,
					"content": "Còn rốt cuộc nó là gì... thì đợi ngày mai Tlazolli đích thân nói cho hai vị biết nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121423,
					"content": "Chẳng lẽ là Tên Cổ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121424
					]
				},
				{
					"id": 150121424,
					"content": "Không phải là đã có Tên Cổ rồi sao? Món đồ này lấy một cái là đủ rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121425,
					"content": "Chúng tôi... chỉ cần một chút quà bình thường là được rồi, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121413,
					"content": "Tinh thạch này đúng là không thể dễ dàng bỏ lại được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				}
			]
		}
	]
}