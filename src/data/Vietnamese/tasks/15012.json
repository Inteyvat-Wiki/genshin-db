			},
			"dialogs": [
				{
					"id": 150120601,
					"content": "#Nhưng mà... {F#Cô}{M#Cậu} cũng thấy tình hình xung quanh rồi nhỉ? Một thời gian trước, Mũi Kim Bóng Tối trên đó đột nhiên rơi xuống, để lại một cái hố lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120602
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120602,
					"content": "Mặc dù mạch khoáng mà tôi tìm được nằm ở bên ngoài, nên miễn cưỡng tránh được tai nạn... Nhưng ma vật xung quanh đều bị kinh động rồi, khắp nơi đều là ma vật phát điên cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120603
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120603,
					"content": "Tôi vừa sợ vừa hết cách, chỉ có thể đi đường nhỏ để vòng qua chúng. Không ngờ lại gặp đám cướp đó... May mà hai vị đến kịp lúc.",
					"roleType": "TALK_ROLE_NPC",
