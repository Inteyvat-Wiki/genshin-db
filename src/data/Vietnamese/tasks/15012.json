			"dialogs": [
				{
					"id": 150120101,
					"content": "Vẫn, vẫn chưa về nữa... Chẳng lẽ sư phụ Cheven đã xảy ra chuyện gì sao... Hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120102,
					"content": "Cô bé bên kia sao lại khóc thế nhỉ, đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120103,
					"content": "#{NICKNAME}, chúng ta qua đó xem đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120104,
					"content": "Em gái, em sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "Hic... Sư phụ Cheven...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120106,
					"content": "Sư phụ nói là muốn đến bên kia thu thập Tinh Thạch Núi Lửa... Nhưng mà đến bây giờ vẫn chưa về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120107,
					"content": "Em đã nói với các chú thủ vệ, nhưng các chú ấy nói là bây giờ trong bộ tộc thật sự không có người. Hơn nữa, địa hình bên đó rất nguy hiểm, còn có rất nhiều ma vật và kẻ xấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120108,
					"content": "Họ chỉ có thể cố gắng chuẩn bị trước, đợi chuẩn bị xong rồi mới đi giải cứu sư phụ Cheven... Nhưng mà như thế thì không kịp mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120109,
					"content": "#Yên tâm đi, cứ để {M#anh}{F#chị} lo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "#{F#Chị}{M#Anh} đồng ý giúp em sao? Tốt quá rồi! Để em vẽ cho {F#chị}{M#anh} những nơi mà chú thủ vệ đã từng đi qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120112,
					"content": "Chú thủ vệ nói, đây có thể là nơi mà sư phụ Cheven từng đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120113,
					"content": "Nói không chừng, sư phụ bị dồn đến gần Mũi Kim Bóng Tối đó. Nếu như... nếu như vậy thì... hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120114,
					"content": "#Làm ơn đi mà, {M#anh}{F#chị}, hãy cứu sư phụ Cheven nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120110,
					"content": "#Xem ra câu chuyện anh hùng của {M#anh chị}{F#bọn chị} lại dài thêm một phần rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
