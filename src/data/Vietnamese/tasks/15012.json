			},
			"dialogs": [
				{
					"id": 150121301,
					"content": "Tôi nhớ Xilonen cũng là thợ thủ công đúc Tên Cổ đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121302
					]
				},
				{
					"id": 150121302,
					"content": "Hai vị biết Xilonen sao? Haha, mỗi lần Tlazolli nhắc đến Xilonen đều khen mãi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121303
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121303,
					"content": "\"Người có hiểu biết sâu sắc nhất về Tên Cổ\", \"tương lai của tộc chúng ta\", \"thợ thủ công hàng đầu\"... Thật là muốn khen hết lời hay ý đẹp mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121304
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121304,
					"content": "Dù Tlazolli không nói gì, nhưng tôi có thể nhìn ra, cô ấy vẫn còn nhớ khoảng thời gian đúc Tên Cổ trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				}
			]
		},
		{
			"id": 1501214,
			"completionStepIds": [
				1501204
			],
