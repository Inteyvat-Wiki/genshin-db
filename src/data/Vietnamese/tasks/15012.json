			"dialogs": [
				{
					"id": 150120401,
					"content": "Woa, chúng chạy nhanh với quyết đoán thật đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120402,
					"content": "Coi như họ thức thời.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "Phù... Cảm ơn hai vị rất nhiều. Nếu không có hai vị giúp đỡ thì chắc tôi đã bị ném xuống núi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120405,
					"content": "#Có thể được {NICKNAME} ra tay cứu giúp, hôm nay tôi may mắn thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120406,
					"content": "Xin lỗi, tôi chưa tự giới thiệu. Tôi là Cheven, một thợ kim hoàn xui xẻo vừa gặp may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120407,
					"content": "Là Imix nhờ chúng tôi tới đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Đứa nhỏ này... Haiz, khiến nó phải lo lắng rồi. Lúc rời tiệm, tôi còn tưởng cùng lắm là hai ngày sẽ về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120409,
					"content": "Tôi cũng không ngờ là có thể phát hiện một mạch khoáng Tinh Thạch Núi Lửa mới ở gần Mũi Kim Bóng Tối. Tinh thạch bên trong cực kỳ tinh khiết, sản lượng khoáng cũng rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120410,
					"content": "Tôi đã đào được rất nhiều Tinh Thạch Núi Lửa tinh khiết. Khi chuẩn bị trở về thì Phlogiston trong tinh thạch lại thu hút ma vật kéo đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120403,
					"content": "Nổi tiếng cũng có lợi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
