			"dialogs": [
				{
					"id": 110040301,
					"content": "Cây Cấp Đông, cây Cấp Đông ngon ngon~ cây Cấp Đông~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040302,
					"content": "Cây Cấp Đông~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040303,
						110040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040303,
					"content": "Bạn cũng khoa trương quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040304
					]
				},
				{
					"id": 110040304,
					"content": "Là do bạn thận trọng quá! Lấy được thực phẩm quý hiếm, trên thế giới này còn có chuyện đáng mừng hơn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040307,
					"content": "A, bên này hình như còn có thứ gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040308
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040308,
					"content": "Đây chính là con heo rừng mà ngài thợ săn nói nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040309,
					"content": "Hoa văn này chưa từng thấy trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040310,
					"content": "Hình như tôi từng nhìn thấy hoa văn này! Để tôi nghĩ, nghĩ chút... a phải rồi, là \"Phong Vật Chí Liyue\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040311,
					"content": "Loại hoa văn này... ừm, không sai được! Đây chính là heo rừng đã tuyệt chủng 300 năm trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040312,
					"content": "Hả?! Tại sao lâu như vậy mà vẫn còn sống chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040313,
					"content": "Vì bị đông cứng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "Hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040317,
					"content": "Trong sách có nói rằng, vì thịt của loại heo rừng ngày quá ngon, nên chúng đã bị săn bắt đến mức tuyệt chủng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040318,
					"content": "Cây Cấp Đông và heo rừng, tìm được cả hai báu vật này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040319,
					"content": "Lần này phần thắng nắm chắc trong tay rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "Ừ, chúng ta mau về Thanh Tuyền Trấn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040315,
					"content": "Vì có tuổi thọ cao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040316
					]
				},
				{
					"id": 110040316,
					"content": "Cũng hơi cao quá rồi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040305,
					"content": "Cây Cấp Đông~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040306
					]
				},
				{
					"id": 110040306,
					"content": "Hahaha, tại sao các bạn hát nghe kỳ quái vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
