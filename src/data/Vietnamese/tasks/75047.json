				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "Ừm, kiểm soát cân nặng rồi, nhưng mà... Hửm? Sao vậy, có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470402,
					"content": "Cho hỏi đây là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "À, tôi canh gác ở đây, nhưng hiện đang nghỉ phép...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470404,
					"content": "Nếu có việc gì thì hãy tìm Yukom ở bên cạnh nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470405,
					"content": "Có chuyện phiền lòng gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "Chuyện là gần đây tôi có chút tăng cân, nên đã thêm nhiều rau củ tốt cho sức khỏe vào trong Hạt Ngũ Cốc thường ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470407,
					"content": "Nhưng không biết tại sao, bạn đồng hành của tôi là Ur gần đây cũng học theo nên ăn rất nhiều cỏ... Tuy Saurian đều là động vật ăn tạp, nhưng nếu ăn nhiều cỏ quá thì dinh dưỡng sẽ bị thiếu hụt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470408,
					"content": "Vẫn nên tìm cơ hội để nói chuyện với nó vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470409,
					"content": "Không có gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "Được rồi, chúc chuyến hành trình suôn sẻ nhé, người ngoại quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				}
			]
		}
	]
