			},
			"dialogs": [
				{
					"id": 750470301,
					"content": "Buồn ngủ, muốn đi ngủ quá... Nhưng mà phải cùng đứng ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
					],
					"speakerTitle": "Huruk"
				},
				{
					"id": 750470302,
					"content": "Tại sao, con người, phải đứng ở đây cả ngày?",
					"roleType": "TALK_ROLE_NPC",
