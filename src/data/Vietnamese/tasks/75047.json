				{
					"id": 750470201,
					"content": "Hạt Ngũ Cốc ngon quá... Nhưng chỉ ăn Hạt Ngũ Cốc thôi thì qua vài ngày sẽ không còn ngon nữa.",
					"roleType": "TALK_ROLE_NPC",
