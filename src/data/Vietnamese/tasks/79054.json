					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "Ơ, sao mọi người lại đến đây vậy? Ở đây không có tuyến đường ray nào, lại nằm ở rìa Ảo Cảnh Veluriyam nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540102,
					"content": "Thường rất ít người đến đây, kể cả Idyia... Hừm, tôi nghĩ cô ấy cũng không biết chỗ này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540103,
					"content": "Ở đây chẳng có gì cả, anh ở đây làm gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540104,
					"content": "Tôi chỉ tản bộ chút thôi... Ấy, đừng nhìn tôi như kiểu \"vừa cãi nhau với Ferdinand rồi bỏ đi\" chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540105,
					"content": "Không có, thật sự không có cãi nhau. Tôi đi loanh quanh là vì... ừm, phải nói thế nào nhỉ, là vì sở thích cá nhân thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540106,
					"content": "Trước đó tôi đã nói là tôi đề ra ý tưởng về xe bay đúng không. Suy nghĩ ban đầu của tôi là muốn làm ra thứ gì đó để leo được lên cao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540107,
					"content": "Cho nên tôi mới nghĩ ra ý tưởng về xe bay và đường ray, là do tôi thích bầu trời và độ cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540108,
					"content": "Trông như một kẻ ngốc đúng không. Tôi nhớ Inazuma cũng có một câu nói đại loại như \"chỉ có những kẻ ngốc và khói mới thích bay lên cao\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540109,
					"content": "Xe bay là một ý tưởng tuyệt vời.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Nhưng trong Ảo Cảnh Veluriyam mới có thể chế tạo xe bay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540112,
					"content": "...Bỏ đi, không nói chuyện này nữa. Còn một lý do khiến tôi đến đây, đó là để ngắm bầu trời sao này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540113,
					"content": "Mặc dù bầu trời sao trong Ảo Cảnh Veluriyam cũng chỉ là sự phản chiếu của bầu trời sao bên ngoài chiếc bình. Nhưng đối với tôi thì nó cũng đủ đẹp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540114,
					"content": "Mỗi tối... chỉ cần nhìn lên bầu trời sao này thì lòng tôi sẽ thấy bình yên vô cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540115,
					"content": "Vậy là Jeroney thích bầu trời sao ư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Chỉ cần nhìn thấy bầu trời sao như vậy thì ai cũng sẽ thích thôi. Tiếc quá, nếu ban ngày cũng có thể thấy thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540117,
					"content": "Tất nhiên, nếu mỗi ngày không cần leo lên đây mà vẫn thấy được bầu trời sao thì sẽ tốt hơn, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540118,
					"content": "À! Tôi nghĩ ra một cách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540119,
					"content": "Hả, có cách thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540120,
					"content": "Chỉ cần chụp ảnh là được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "...Ảnh? Bây giờ có cả những thứ tiên tiến như vậy sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540122,
					"content": "Ừm, hay là chúng ta chụp một bức ảnh bầu trời sao cho Jeroney đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540123,
					"content": "Có thật là được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540124,
					"content": "Đương nhiên là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "Nhưng mà, không biết chụp ở đâu thì đẹp nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540126,
					"content": "À, ở đây! Ban đêm ở đài cao bên này sẽ xem được bầu trời sao đẹp nhất. Đây cũng là lý do tại sao tôi leo lên đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540127,
					"content": "Vậy sao, được! Jeroney, chờ ảnh của chúng tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540110,
					"content": "Xe bay rất thú vị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
