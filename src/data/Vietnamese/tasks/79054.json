			"dialogs": [
				{
					"id": 790540301,
					"content": "Jeroney! Chúng tôi về rồi đây. Xem này, đây là ảnh mà chúng tôi nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540302,
					"content": "...Trông y như thật vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540303,
					"content": "Bức ảnh này có thể cho tôi thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540304,
					"content": "Vốn dĩ là chụp cho anh mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540305,
					"content": "Haha, cảm ơn nhé... Không ngờ lại có loại công nghệ tuyệt vời như vậy. Giờ đã phát triển như vậy rồi, nói không chừng sau này xe bay có thể vận hành được ở bên ngoài đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540306,
					"content": "Bầu trời sao thật đẹp, nếu lúc đó cũng có công nghệ như thế này thì tốt quá. Như vậy thì... anh ấy cũng sẽ được nhìn thấy bầu trời sao bất cứ lúc nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeroney"
				}
			]
		},
