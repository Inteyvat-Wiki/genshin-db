			"dialogs": [
				{
					"id": 741860301,
					"content": "Ngài Cassiodor! Ngài Cassiodor... Là ngài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860303,
					"content": "Quả nhiên là ngài, cuối cùng thì ngài cũng đã trở về rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860304,
					"content": "Tôi nhận lệnh canh giữ cứ điểm này, nhưng rồng đất và man tộc tấn công quá mạnh mẽ. Chúng tôi chỉ đành phải lui dần đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860305,
					"content": "Kể từ đó hình như đã qua rất nhiều rất nhiều năm... Tình hình bên ngoài thế nào rồi, chúng ta thắng rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860307,
					"content": "Vậy... Vậy là chúng ta thua rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860308,
					"content": "Tôi xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860309,
					"content": "Ngài đừng nói vậy. Khi tôi gia nhập quân đoàn của Sebastos thì đã từng nghĩ là sẽ có một ngày như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860310,
					"content": "Sebastos từng nói là sẽ dẫn dắt chúng tôi phá vỡ xiềng xích của \"Fortuna\". Nhưng sự việc sao có thể dễ dàng như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860311,
					"content": "Dù sao thì thứ chúng ta chống lại chính là vận mệnh, ngay cả thần linh vĩ đại cũng không thể chống lại được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860312,
					"content": "Đến cuối cùng, mọi nỗ lực cũng đều vô ích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860313,
					"content": "Không, thưa ngài. Chúng ta từng giương đao kiếm chống lại thiên mệnh, sự nghiệp của chúng ta đã thách thức luật lệ của trời cao. Chúng ta đã đồng lòng chống lại lời tiên tri đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860314,
					"content": "Tuy chúng ta vẫn phải chịu thất bại... Nhưng nhất định là có người đã phản bội nên mới khiến chúng ta ra nông nỗi này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860315,
					"content": "Nhưng kết quả đã không còn quan trọng nữa. Dù thế nào thì chúng ta cũng sẽ được khắc ghi trong \"lịch sử\" của thế giới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "Ma Tượng Vô Danh"
				},
				{
					"id": 741860316,
					"content": "Này, sao anh ta lại ngã xuống vậy? Người đá cũng đột nhiên bị mất đi ý thức như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "Tôi vẫn chưa biết tên của anh ấy... Xem ra, \"lịch sử\" của anh ấy đã kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860318,
					"content": "Thật đáng thương, anh ta đã chiến đấu ở đây mấy ngàn năm rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "Nhưng bây giờ anh ấy đã được yên nghỉ rồi. Chúng ta đi tiếp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		}
	]
}