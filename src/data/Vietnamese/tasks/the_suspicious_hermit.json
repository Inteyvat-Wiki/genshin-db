			"dialogs": [
				{
					"id": 761140101,
					"content": "Lần này phải điều tra... \"ẩn sĩ có hành vi bất thường\" à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140102,
					"content": "Ẩn sĩ chẳng phải vốn đã là loại người kỳ quái sao? Những người sống ở nơi hoang vu như vậy, dù có làm gì cũng đâu có lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140103,
					"content": "Nhưng sự thay đổi luôn có nguyên nhân, dù nguyên nhân đó xuất phát từ nội tâm hay từ bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140104,
					"content": "Ngoài ra, thương nhân mất tích cũng đáng để tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140105,
					"content": "Hả? Nhưng ở đó nguy hiểm lắm, đây là điều ai cũng biết, bị cướp, bị ma vật tấn công... Có nhiều khả năng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140106,
					"content": "Đó là chuyện ai ai cũng biết, nên những thương nhân thường xuyên đến đó đương nhiên cũng có cách đối phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140107,
					"content": "Cho dù vậy, nhưng thương nhân dày dặn kinh nghiệm lại bị mất tích, chắc là có nguyên nhân mà không ai biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140108,
					"content": "Jahoda, lần này em đích thân đi gặp \"ẩn sĩ có hành vi bất thường\" này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140109,
					"content": "Đường xá xa xôi, nhớ đừng rời khỏi con đường chính nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140110,
					"content": "Đã rõ, thưa sếp! Chút chuyện nhỏ này cứ yên tâm giao cho em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
