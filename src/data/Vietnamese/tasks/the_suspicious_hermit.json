			"dialogs": [
				{
					"id": 761140301,
					"content": "(Hả? Đây là... hình như chưa cháy hết...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140302,
					"content": "(Trước đây có nghe nói ngài Derwent sẽ thu nhận các nhà mạo hiểm bị thương... Hình như đây là chuyện xảy ra gần đây.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140303,
					"content": "(Sao lại đốt những thứ này nhỉ...?)",
					"roleType": "TALK_ROLE_NPC",
