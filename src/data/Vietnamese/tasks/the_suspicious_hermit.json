			"dialogs": [
				{
					"id": 761140201,
					"content": "Xin chào, có ai ở đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140202,
					"content": "Xin hỏi ngài Derwent có ở nhà không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140203,
					"content": "...Ai đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140204,
					"content": "Tôi là Jahoda của Hội Đồng Bí Mật, vì có vài chuyện muốn hỏi thăm nên tôi tới đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140205,
					"content": "...Cô cứ hỏi đi. Tôi bị bệnh, không dậy nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140206,
					"content": "(Kỳ lạ, trước đây nghe đám nhóc Bang Ốc Biển nói là ngài Derwent dạy chúng học chữ, giọng điệu rất dịu dàng...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140207,
					"content": "(Bây giờ giọng nói khàn đặc, nhưng không giống bị bệnh, mà giống như giọng nói bẩm sinh...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140208,
					"content": "Ngài không sao chứ? Nếu như bệnh nặng thì để tôi đi mời bác sĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140209,
					"content": "...Không cần. Một thời gian nữa là khỏe thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140210,
					"content": "Thôi được, vậy đợi ngài hồi phục rồi hãy đến Thị Trấn Nasha nhé. Bạn ngài cũng rất nhớ ngài đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140212,
					"content": "(Sao không nói tiếp vậy? Có thể nghe thấy tiếng người đi lại trong phòng, nhưng bước chân rất nặng...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140213,
					"content": "Gần đây hình như ngài không ra ngoài mấy phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140214,
					"content": "...Là vì muốn chuyên tâm tu hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140215,
					"content": "Nghe nói gần đây chuyện ăn mặc của ngài cũng khác trước, có người nói hoàn toàn không ngờ ngài lại khỏe khoắn như vậy, lúc trước mặc áo choàng ẩn sĩ nên không nhận ra đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140216,
					"content": "Ồ, còn có chiếc mặt nạ ngăn cách Kuuvahki nữa... Là trào lưu mới à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140217,
					"content": "...Là để ngăn cách với tiếng ồn bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140218,
					"content": "Cũng là vì tu luyện sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140220,
					"content": "Vậy vị thương nhân trước đó từng ghé thăm, ngài có biết người đó đã đi đâu rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140221,
					"content": "...Không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140222,
					"content": "Được, được rồi... Vậy tôi không làm phiền nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140223,
					"content": "(Không biết tại sao, mình có cảm giác nếu tiếp tục hỏi sẽ rất nguy hiểm...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140224,
					"content": "(Hmm, họ nói đúng, cứ như là biến thành một người khác vậy...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140225,
					"content": "(Ít thông tin quá, cũng không thể cứ như vậy quay về đối diện với sếp Nef. Thử điều tra cẩn thận xung quanh xem sao.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
