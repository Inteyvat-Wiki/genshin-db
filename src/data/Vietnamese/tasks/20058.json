				{
					"id": 200580903,
					"content": "Ồ, do một vài lý do, mẹ cô bé... tạm thời không ở nhà, hiện tại do tôi chăm sóc nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580904,
					"content": "Còn một vài đứa trẻ nữa cần phải chăm sóc, đều do tôi phụ trách, là một trong những trách nhiệm của tu nữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580905,
					"content": "Giống như tôi đột nhiên có thêm nhiều đứa con vậy, chúng đều rất ngoan, rất hòa thuận với Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580906,
					"content": "Ồ... Timmie được tôi chăm sóc lâu nhất, cũng bắt đầu gọi tôi là mẹ Grace rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580907,
					"content": "Bố của Nora",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Ngài Patton, ông ấy trước kia rất thích uống rượu, gia đình có vấn đề rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580909,
					"content": "Đội Kỵ Sĩ Tây Phong và Giáo Hội đã nhiều lần cảnh cáo ông ấy, thế nhưng ông ấy không chịu hối cải, cuối cùng Lão gia Diluc giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580910,
					"content": "Ý của tu nữ Victoria, Patton hiện tại không phù hợp để chăm sóc Nora, vì vậy đem Nora giao cho Giáo Hội chăm sóc, để ngài Patton có thời gian ăn năn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580911,
					"content": "Thế nhưng, Nora cũng đang lớn, nói dối rằng \"Bố đang bận làm ăn, không được làm phiền\" cũng không còn tác dụng nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580912,
					"content": "Bồ công anh của Phong Thần đại nhân, cũng không phải nơi nào cũng đến được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
