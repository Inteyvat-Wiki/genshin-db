			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "Ừm ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580202,
					"content": "Trèo lên trên để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "Dì Grace nói, nếu như muốn thì thầm với ai đó, chỉ cần nói chuyện với bồ công anh, sau đó thổi chúng đi, Phong Thần đại nhân sẽ đưa bồ công anh và lời thì thầm đến với người cần nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580204,
					"content": "Hơn nữa nơi thả bồ công anh càng cao, thì tâm nguyện sẽ càng nhanh được thực hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580205,
					"content": "Chị Glory từng nhờ Nhà Mạo Hiểm giúp chị ấy thả bồ công anh ở trên tượng Phong Thần... Kết quả là chỉ vài ngày sau đó, anh Godwin đã trả lời thư rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580206,
					"content": "Nora cũng có lời thì thầm cần nói với bố, cũng tìm được bồ công anh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580207,
					"content": "Thế nhưng... Dì Grace không đồng ý, cứ nói rằng đợi em lớn lên rồi có thể ở cùng với bố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580208,
					"content": "Thế phải làm sao mới mau lớn đây, em cũng cố gắng tập luyện, thế nhưng vẫn nhỏ bé như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580209,
					"content": "#Ừm... Em thường xuyên thấy {F#chị}{M#anh} bay qua bay lại trong thành, {F#chị}{M#anh} có thể dạy em làm thế nào để bay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580210,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Hihi, vậy em đứng bên cạnh xem vậy. Lần này, trong phạm vi cho phép của dì Grace rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580212,
					"content": "Có muốn bay cùng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "Không được, không được, dì Grace mà nhìn thấy được sẽ mắng em một trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
