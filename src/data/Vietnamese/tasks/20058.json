			"dialogs": [
				{
					"id": 200581101,
					"content": "Thật lợi hại! Sau khi lớn lên, em cũng có thể bay như vậy ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581102,
						200581104
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581102,
					"content": "Được chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200581103
					]
				},
				{
					"id": 200581103,
					"content": "Vậy em phải nhanh chóng trưởng thành, đợi bố làm xong việc, em sẽ đi chơi cùng với ông ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581106
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581106,
					"content": "Không được, sau khi lớn sẽ không còn khó nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581107
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581107,
					"content": "#Cảm ơn {F#chị}{M#anh}, cho {F#chị}{M#anh} cái này, là bảo vật mà em tìm thấy, cho {F#chị}{M#anh} xem như là quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200581108
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581108,
					"content": "Mau nhận lấy đi... Còn nữa, đừng nói với dì Grace nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200581104,
					"content": "Còn phải thi bằng bay lượn nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200581105
					]
				},
				{
					"id": 200581105,
					"content": "Bằng bay lượn là gì? Hình như rất khó.",
					"roleType": "TALK_ROLE_NPC",
