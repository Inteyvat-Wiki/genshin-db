					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "Chất lượng nấm của tiệm này cũng được đấy, tạm thời cứ cho vào danh sách đặt mua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020102,
					"content": "Hanbei? Tên nghe quen thế, hình như đã nghe người ta nhắc qua ở đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020103,
					"content": "Chẳng lẽ là ở Tatarasuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "Ối! Là người hay trì hoãn và khiến \"Lò Luyện Mikage\" rơi vào hỗn loạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020106,
					"content": "Chắc anh ta tới đây làm \"sứ giả nước ngoài\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "Hóa ra anh ta thật sự tới Sumeru sao, tôi còn tưởng \"sứ giả nước ngoài\" kia là nói đùa chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020109,
					"content": "Ồ? Tóc vàng... bên cạnh còn có một cô nhóc biết bay nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020110,
					"content": "Chẳng lẽ chính là \"Nhà Lữ Hành\" kia ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020111,
					"content": "Đúng vậy, chính là tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "Haha, quả nhiên là bạn rồi, khi Yousuke viết thư sang đây đã nhắc đến bạn. Nói rằng bạn và Xavier đã cùng nhau xử lý ổn thỏa chuyện \"Lò Luyện Mikage\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020115,
					"content": "Haiz, tôi thật lấy làm xấu hổ, khi mọi người cùng sửa \"Lò Luyện Mikage\" thì tôi lại phải loay hoay với đống công việc giấy tờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020116,
					"content": "Công việc giấy tờ quan trọng hơn \"Lò Luyện Mikage\" sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "Trọng tâm làm việc của anh sai dữ lắm luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020118,
					"content": "Nói gì thế, nếu không lo liệu việc giấy tờ ổn thỏa thì sao có thể thúc đẩy việc sửa chữa \"Lò Luyện Mikage\" được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020119,
					"content": "Nhìn đi, sơ tán công nhân xung quanh, chuẩn bị vật liệu sửa chữa, điều động nhân viên sửa chữa, còn phải phối hợp với nhu cầu sản xuất của các bên nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020120,
					"content": "Nếu không có sự hỗ trợ từ công việc giấy tờ thì mọi thứ đã lộn xộn lên cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020121,
					"content": "Quả nhiên đúng như Toranosuke đã nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "Đúng là danh bất hư truyền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020123,
					"content": "Toranosuke... là người không quan tâm tới công việc giấy tờ, làm việc với anh ta luôn phải gánh thêm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020124,
					"content": "Nhưng hiện giờ tôi không quản lý \"Lò Luyện Mikage\" nữa, hiện tại tôi đang làm \"sứ giả nước ngoài\" ở Sumeru, chủ yếu quản lý việc mua bán nấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020125,
					"content": "Ừm... Nhà Lữ Hành, tôi đã nghe Yousuke kể về sự tích của hai vị rồi. Tôi cảm thấy... hai vị rất đáng tin cậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020126,
					"content": "Hai vị có thể giúp tôi một việc được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020127,
					"content": "Hiện tại tôi đang tìm một nhà cung ứng nấm đáng tin cậy, tôi cũng đã tìm rất nhiều thương nhân ở đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020128,
					"content": "Những mẫu nấm họ mang đến cho tôi đều là hàng tốt được lựa chọn kỹ càng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020129,
					"content": "Tôi cảm thấy cần phải tới chỗ họ sản xuất nấm để xem chất lượng tổng thể mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020130,
					"content": "Nhưng hai vị cũng thấy đấy, tôi thật sự không có kinh nghiệm khảo sát ngoài thành, nếu một mình vào rừng thì e là sẽ lành ít dữ nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020131,
					"content": "Nên tôi muốn nhờ hai vị giúp tôi vào rừng thu thập một ít nấm, sau đó mang về đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020132,
					"content": "Cũng không phải là không được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "Hai vị đồng ý sao? Tốt quá! Chuyện thù lao xin cứ yên tâm, tôi đã chuẩn bị xong giấy tờ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020135,
					"content": "Hãy nhìn vào đây, đúng, xem phần giấy tờ này trước, đây là giấy tờ thuê mướn và thống kê thù lao, phần này là thông báo nghĩa vụ và hiệp định bảo mật. À đúng rồi, còn có cả bản đồ nơi nấm mọc nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020136,
					"content": "Cùng Hanbei xem kỹ tất cả giấy tờ, cảm thấy mệt mỏi vô cùng...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "Được rồi, vậy là hai vị đã xem hết tất cả giấy tờ rồi, tôi sẽ đưa đến Shogunate, sau khi có phản hồi thì sẽ chính thức trở thành quan hệ thuê mướn với hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020138,
					"content": "Nhưng trước lúc đó, tôi sẽ tự bỏ tiền túi ra để trả thù lao cho hai vị. Dù sao thì chuyện mua nấm cũng không thể kéo dài được nữa mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020139,
					"content": "Đương nhiên, chuyện này tôi cũng sẽ tổng kết thành công văn nộp lên Shogunate, dù sao thì thù lao của hai vị cũng cần phải báo thuế mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020140,
					"content": "Tôi, tôi đi hái nấm trước đây!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "Hả? À... Vậy nhờ hai vị cả nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020142,
					"content": "Chúng ta sẽ không bị cuốn vào phiền toái nữa đó chứ, lo quá đi mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020143,
					"content": "Tôi sẽ để mắt tới anh ta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "Vậy sao? Được rồi, nghe cũng có lý đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020147,
					"content": "Ơ? Sao lại tỏ vẻ không tin tưởng tôi thế này... Yên tâm đi, công tác chuẩn bị đã đâu vào đấy rồi, tuyệt đối sẽ không để hai vị gặp phải chuyện gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020148,
					"content": "Chúng tôi không phải nói vấn đề này... Haiz, tóm lại chúng ta vào rừng hái nấm giúp anh ta trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020145,
					"content": "Để xem tên này còn có thể gây ra mớ hỗn độn gì nữa đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "Này! Nếu thật sự gây ra chuyện gì ở đây thì chúng tôi sẽ không tìm được người tới giúp đâu đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020133,
					"content": "Bàn thù lao trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "Đây chính là Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "Là Paimon, không phải \"nhóc biết bay\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020107,
					"content": "Chắc anh ta đến để quản lý việc mua bán nấm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "Người mà Toranosuke và Yousuke từng nhắc tới...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
