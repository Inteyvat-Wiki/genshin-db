			"dialogs": [
				{
					"id": 60280301,
					"content": "Thế nào rồi? Vết thương còn đau không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280302,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280303
					]
				},
				{
					"id": 60280303,
					"content": "Tôi đã nhờ người chuẩn bị một số thuốc có thể dùng đến rồi. Nếu cần thì cứ uống nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280304,
						60280305
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280304,
					"content": "Cảm ơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280306
					]
				},
				{
					"id": 60280306,
					"content": "Vậy, để tôi kể lại nội dung cuộc nói chuyện với dì Alice sau khi sự việc này xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280307
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280307,
					"content": "Tên Dottore đó vì để thu hút sự chú ý của Hội Ma Nữ... mà đã gây ra một sự kiện lớn ở vùng biên giới Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280308
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280308,
					"content": "Dì luôn cho rằng sức mạnh Vực Sâu từ bên ngoài thế giới đang quấy nhiễu Teyvat, đây là tình trạng khá thường thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280309
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280309,
					"content": "Nhưng sau khi nhóm của nhóc Durin thành công can thiệp vào hư ảnh ở Nod-Krai, dì đã nhận ra rằng sự can thiệp này cũng có thể đến từ bên trong Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280310
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280310,
					"content": "Nhưng mà, lần can thiệp đó đâu có thay đổi được số phận của hư ảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280311
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280311,
					"content": "Đúng vậy, mấy đứa không thể thay đổi kết cục của hư ảnh đó, nhưng một \"biến số\" nào đó đã ghi đè lên người cậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280312
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280312,
					"content": "Biến số?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280313
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280313,
					"content": "Ừm, chẳng hạn như việc mấy đứa nghe được những tin tức vốn không thể biết được, hoặc nảy sinh những suy nghĩ mà lẽ ra không thể có. Tất cả đều được coi là \"biến số\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280314
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280314,
					"content": "Tất nhiên, chuyện này chẳng có gì to tát khi đặt cạnh vô vàn khả năng khác. Nhưng khi nó được sắp đặt có chủ đích, thì ý nghĩa lại hoàn toàn khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280315
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280315,
					"content": "Và tất cả những biến số này chính là điều kiện cần thiết để Dottore có thể thực hiện âm mưu của mình vào đêm mấy đứa mở cổng dịch chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280316
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280316,
					"content": "Nhưng cụ thể Dottore đã làm gì thì chúng ta vẫn chưa biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 60280317,
					"content": "Ừm, còn phải làm rõ xem tình hình hiện tại của Columbina như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280318
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280318,
					"content": "Đại khái là vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280319
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280319,
					"content": "Đúng như tôi nghĩ, Dottore đã biến mất hoàn toàn. Nhưng ít nhất thì hắn ta đã không thể khống chế được Columbina như hắn muốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280320
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280320,
					"content": "Nhưng tình hình hiện tại có thể còn tệ hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280321
					]
				},
				{
					"id": 60280321,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280322,
						60280323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280322,
					"content": "Cô ấy vì muốn phá hỏng kế hoạch của Dottore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280324,
					"content": "Hả? Là vậy sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280325,
					"content": "Mọi người không thấy sao? Cô ấy đã nhảy vào trong rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280326
					]
				},
				{
					"id": 60280326,
					"content": "#Chúng tôi chỉ thấy Dottore xuất hiện và sử dụng một loại sức mạnh nào đó. Sau đó hắn ta và Columbina đều biến mất, còn {NICKNAME} thì rơi từ trên không xuống biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280327,
					"content": "(Thì ra là vậy. Dottore đã khóa lấy thời gian, chỉ có mình mới có thể tự do hành động.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280328
					]
				},
				{
					"id": 60280328,
					"content": "(Trong mắt họ, trận chiến đó và quyết định của Columbina chỉ là chuyện trong nháy mắt.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280329
					]
				},
				{
					"id": 60280329,
					"content": "(Đây chính là quyền năng của ba vầng trăng sao... Mình không bị ảnh hưởng... là vì mình là Kẻ Đổ Bộ chăng?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280330
					]
				},
				{
					"id": 60280330,
					"content": "Columbina đã chủ động mở Cổng Mặt Trăng, bước vào không gian thần bí mà Rerir và Tholindis từng đặt chân vào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280331
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280331,
					"content": "Xem ra lành ít dữ nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280332
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280332,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280333,
						60280334
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280333,
					"content": "Đó là lý do tại sao Dottore luôn trốn tránh chúng ta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280335,
					"content": "Xem ra, \"Ba Mặt Trăng Thẳng Hàng\" và sự xuất hiện của Rerir... e rằng đều do Dottore đứng sau giật dây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280336
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280336,
					"content": "Theo cách nói của dì Alice thì việc hắn ta muốn làm chính là vượt qua số mệnh của bản thân, hoàn thành thí nghiệm mà chỉ có thần linh mới có thể hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280337
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280337,
					"content": "Một kẻ điên đúng nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280338
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280338,
					"content": "À, Nón Tròn đâu rồi? Sao anh ta không có ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280339,
					"content": "Sau khi liên lạc với dì Alice thì anh ấy nói là có chút manh mối, nên đã lấy Bộ Liên Lạc Dodoco để một mình đi điều tra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280340
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280340,
					"content": "Lúc rời đi, biểu cảm của anh ấy trở nên rất đáng sợ. Tôi chưa từng thấy anh ấy như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280341
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280341,
					"content": "(Chắc là tức giận và không cam tâm. Rõ ràng đã đề phòng Dottore rồi, vậy mà vẫn bị hắn ta đi trước một bước.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280342
					]
				},
				{
					"id": 60280342,
					"content": "(Mà kể ra, chẳng phải mình cũng cảm thấy thế sao...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280343
					]
				},
				{
					"id": 60280343,
					"content": "Tôi về rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280344
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280344,
					"content": "Nón Tròn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280345
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280345,
					"content": "Tôi đã đi tìm lại những hư ảnh Hyperborea đó, cuối cùng cũng đã làm rõ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280346
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280346,
					"content": "Tôi bảo họ đối chất với Nicole ở bên kia thiết bị liên lạc, và phát hiện ra lịch sử mà họ miêu tả khác với ký ức của Nicole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280347
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280347,
					"content": "Tại sao lại như vậy? Nicole đáng lẽ sẽ không nhầm lẫn mới phải chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280348,
					"content": "Vì thứ bị lừa chính là những hư ảnh đó. Trong lịch sử của họ đã xuất hiện một Đấng Cứu Thế không nên tồn tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280349
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280349,
					"content": "Đấng Cứu Thế này hứa với họ rằng có thể tạo ra một vầng trăng mới trên bầu trời giả, còn có thể đưa Nguyệt Thần của họ trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280350
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280350,
					"content": "Những kẻ ngu ngốc đó đã tin tưởng, và cho hắn biết tất cả những gì hắn cần biết về mặt trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280351
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280351,
					"content": "Nghe là biết ngay do tên Dottore giở trò rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280352
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280352,
					"content": "Trong di tích Hyperborea, khi nghe hư ảnh kể về lịch sử, Nicole đã nói là có một vài chi tiết hơi kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280353
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280353,
					"content": "Nhưng chắc Dottore không thể đi qua cánh cổng đó chứ nhỉ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280354,
					"content": "Hắn ta chưa từng vào đó. Nicole nói rằng đây là hiện tượng bất thường do sự can thiệp vào mối liên hệ trước sau giữa các hư ảnh cùng thời đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280355
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280355,
					"content": "Và biến số mà Dottore tạo ra thậm chí lớn đến mức có thể ảnh hưởng đến cả những hư ảnh chưa từng gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280356
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280356,
					"content": "Thì ra không phải là ký ức không rõ ràng, mà là bị bóp méo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280357
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280357,
					"content": "Đây chính là khả năng mà Dottore đã tìm mọi cách để ghi đè lên. Hắn đã biến những biến số này thành kiến thức và sắp đặt tình huống để tất cả kiến thức đó đều nằm trong tay mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280358
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280358,
					"content": "Đêm Cầu Nguyệt... Hắn ta thực sự đã dùng những kiến thức này để tạo ra một \"vầng trăng giả\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280359
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280359,
					"content": "Chuyện này sao có thể chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280360,
					"content": "Nói chính xác là khiến cho cảm nhận về thuật pháp bị sai lệch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280361
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280361,
					"content": "Thuật pháp thông qua Kuuvahki để cảm nhận vị trí của mặt trăng, nên chỉ cần mặt trăng giả giống thật hơn là Sương Nguyệt ở ngoài không gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280362
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280362,
					"content": "Thì cánh cổng đó sẽ đưa Columbina đến vị trí của mặt trăng giả, cũng chính là đến chỗ Dottore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280363
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280363,
					"content": "Sau khi Dottore khống chế được Columbina thì thuật dịch chuyển vẫn được duy trì, hắn lại thao túng sức mạnh của cô ấy để đoạt đi hai mảnh Tủy Mặt Trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280364
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280364,
					"content": "Lúc đó, Tủy Mặt Trăng đột nhiên biến mất trước mắt chúng tôi... Khi rời khỏi di tích thì đã quá muộn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280365
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280365,
					"content": "Khi đó, Dottore đã thu thập được sức mạnh của ba vầng trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280366
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280366,
					"content": "Vậy bây giờ phải làm sao đây...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280367
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280367,
					"content": "Tôi muốn biết suy nghĩ của Nữ Hoàng bệ hạ. Những lo lắng trước đó của Nữ Hoàng quả nhiên đã xảy ra. Nhưng chúng ta cũng không thể chỉ ngồi chờ đợi quyết định của Nữ Hoàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280368
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280368,
					"content": "Người xem chúng ta như bạn bè không phải là Quan Chấp Hành Fatui Columbina, mà là Columbina Hyposelenia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280369
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280369,
					"content": "Trong tình hình nghiêm trọng này, nếu Nữ Hoàng bệ hạ vẫn cố ngăn cấm các Quan Chấp Hành dùng vũ lực để đối đầu với nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280370
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280370,
					"content": "Thì tôi cũng sẽ nghe theo sự lựa chọn của trái tim, dùng thân phận \"Peruere\" để nghênh chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280371
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280371,
					"content": "Arlecchino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280372,
					"content": "Thời gian cấp bách, tôi đi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280373
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280373,
					"content": "Có vẻ như Arlecchino cũng không còn giữ được bình tĩnh nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280374,
					"content": "(Có thể cô ấy cảm thấy mình phải có trách nhiệm trong chuyện này. Mình cũng vậy... Thật đáng ghét.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280375
					]
				},
				{
					"id": 60280375,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280376
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280376,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280377
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280377,
					"content": "Nào nào, mọi người đừng ủ rũ nữa, nghe tôi nói vài câu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280378
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280378,
					"content": "Tình hình bây giờ rất tệ, vô cùng tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280379
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280379,
					"content": "Dottore đã dùng cách mà mỗi kỵ sĩ đều sẽ mỉa mai để may mắn giành lấy chút lợi thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280380
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280380,
					"content": "Ngay cả ma nữ cũng nói hắn đã dùng \"biến số\" để ảnh hưởng đến vận mệnh. Haha, nhưng tôi thấy chưa chắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280381
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280381,
					"content": "Tôi đã nghe rất nhiều người nói với tôi, rằng vận mệnh của Teyvat đã được định sẵn, và sự thật cho thấy có vẻ như đúng là vậy. Vậy tại sao Dottore lại có thể trở thành một ngoại lệ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280382
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280382,
					"content": "Nếu Dottore có thể tạo ra biến số, thì tại sao chúng ta lại không thể?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280383
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280383,
					"content": "#Hơn nữa, lữ khách phương xa, {F#cô}{M#cậu} càng không nên buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280384
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280384,
					"content": "Mọi chuyện vẫn chưa kết thúc đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280385,
						60280386
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280385,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280387,
					"content": "#Không phải một mình {F#cô}{M#cậu} thôi đâu. Tất cả những người ở đây đều đang tự trách mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280388
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280388,
					"content": "Nhưng chúng ta không có một ai muốn nằm im mà chờ mặt trời mọc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280389
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280389,
					"content": "#Cho dù bị đánh ngã thì cũng sẽ nhanh chóng đứng dậy, đây mới là đạo lý của kỵ sĩ! Đừng quên, Kỵ Sĩ Danh Dự, {F#cô}{M#cậu} là kỵ sĩ chính thống của Mondstadt chúng tôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280390
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280390,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280391
					]
				},
				{
					"id": 60280391,
					"content": "Varka nói đúng, chuyện này chưa kết thúc đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280392
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280392,
					"content": "Chí ít thì cũng phải đánh cho tên Dottore đó một trận, tiện thể trả hết nợ mới lẫn nợ cũ luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280393
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280393,
					"content": "Vậy mới phải chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280394
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280394,
					"content": "Còn những người khác thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280395
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280395,
					"content": "Tôi sẽ mượn sức mạnh Kuuvahki để điều tra tung tích của Columbina. Tôi cũng không muốn từ bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280396
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280396,
					"content": "Tôi sẽ phụ trách cung cấp thông tin. Những chuyện xảy ra ở Nod-Krai, nếu Hội Đồng Bí Mật muốn biết thì chắc chắn sẽ tìm được cách để biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280397
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280397,
					"content": "Xưởng Krumkake Clink-Clank cũng sẽ hỗ trợ hết mình. Tôi và Aino dự định nghiên cứu lại hành động lần này của Dottore để tìm kiếm điểm đột phá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280398
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60280398,
					"content": "Tuy dì Alice và Nicole phải giải quyết tai họa đột ngột ở biên giới Teyvat, tạm thời không thể quay về đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280399
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280399,
					"content": "Nhưng họ đều rất tức giận, yêu cầu tôi và Albedo làm người đại diện của Hội Ma Nữ để dồn sức chống lại Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280401
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280401,
					"content": "Chuẩn bị xong chưa? Giai đoạn này cũng có rất nhiều công việc nghiên cứu cần phải làm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280402,
					"content": "Em sẽ cố gắng hết sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280403
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280403,
					"content": "Tôi xem như đã hiểu rõ phong cách hành sự của Dottore, tôi sẽ thử dự đoán hành động tiếp theo của hắn. Về phần điều tra thì tôi sẽ giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280404
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280404,
					"content": "Ừm, có vẻ như chúng ta đã có sự phân công sơ bộ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280405
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280405,
					"content": "Tôi sẽ liên hệ với Flins và Illuga, nhờ họ tìm Starshyna của họ để nói chuyện, lôi kéo Người Giữ Đèn đứng về phía chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280406
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280406,
					"content": "Đồng thời tôi cũng sẽ giao phó công việc cho Kỵ Sĩ Tây Phong ở Nod-Krai, cố gắng hết sức để hỗ trợ Người Giữ Đèn bảo vệ sự an toàn cho dân chúng ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280407,
						60280408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280407,
					"content": "Hiểu rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280409
					]
				},
				{
					"id": 60280409,
					"content": "Đúng đó, ai sợ ai chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280410,
					"content": "Ừm, mọi người cố lên nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280408,
					"content": "Chúng ta chuẩn bị sẵn sàng để đón nhận mọi thứ thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280409
					]
				},
				{
					"id": 60280386,
					"content": "Tôi có hơi tự trách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280334,
					"content": "Là vì đang chuẩn bị cho kế hoạch này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280323,
					"content": "Mà đã nhảy vào trong \"hình bóng phản chiếu của mặt trăng\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280305,
					"content": "Nhưng chúng ta vào thẳng vấn đề nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280306
					]
				}
			]
		},
