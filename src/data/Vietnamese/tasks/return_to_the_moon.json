			"dialogs": [
				{
					"id": 60280201,
					"content": "Đây chính là... nơi người Hyperborea giao tiếp với mặt trăng trong thời đại đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280202,
					"content": "Hằng Nguyệt, Sương Nguyệt, Hồng Nguyệt... Khi sức mạnh của ba vầng trăng hội tụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280203,
					"content": "Cánh cửa dẫn đến mặt trăng sẽ mở ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280204,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280205,
					"content": "Tủy Mặt Trăng đã sẵn sàng, chỉ còn thiếu bước cuối cùng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280206,
					"content": "Thị Trấn Nasha bây giờ chắc là lúc náo nhiệt nhất nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280207,
					"content": "Đúng vậy, đáng tiếc là chúng tôi phải đưa cô về vào lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280208,
					"content": "Không sao đâu, tôi thấy rất hài lòng về phần hành lý cuối cùng và cũng là duy nhất này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280210,
					"content": "Tôi đã cảm nhận được, lời kêu gọi từ mặt trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280212,
					"content": "Nhà của cô ở phía bên kia luồng sáng này, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "Arlecchino"
				},
				{
					"id": 60280213,
					"content": "Sau này cuối cùng cũng có lý do để cầu nguyện với vầng trăng thật sự rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280214,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Ừm, tôi nghe đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280216,
					"content": "Nếu có cơ hội, hãy quay lại đây thường xuyên nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Hah... Đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280218,
					"content": "Nếu không thì cũng hãy nhớ... Trên hành tinh này có một nhóm bạn bè đang nhớ đến \"Columbina\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Ừm, chắc chắn rồi. Cảm ơn mọi người đã làm nhiều thứ cho tôi như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280220,
					"content": "Cũng mong mọi người hãy nhớ là, ánh trăng sẽ kết nối chúng ta, bất kể ngày đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280221,
					"content": "Vậy... tạm biệt nhé, những người bạn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
