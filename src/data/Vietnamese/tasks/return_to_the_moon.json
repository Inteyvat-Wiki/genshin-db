					]
				},
				{
					"id": 60241102,
					"content": "Trước đây tôi chưa từng nghĩ \"Columbina\" sẽ trở thành tên thật của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60241103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60241104,
					"content": "Từ một biệt hiệu của Fatui, biến thành \"tôi trong lời nói của bạn bè\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60241105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 60280220,
					"content": "Cũng mong mọi người hãy nhớ là, ánh trăng sẽ kết nối chúng ta, bất kể ngày đêm.",
					"roleType": "TALK_ROLE_NPC",
