			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "Sumeru thật sự là một nơi tuyệt vời, lần sau chị sẽ lại đến chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321106,
					"content": "Nơi này luôn luôn chào đón, Avin cũng sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "Niousha"
				},
				{
					"id": 130321107,
					"content": "Chị nhớ giữ lời nhé, em sẽ đợi chị quay lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321108,
					"content": "Haha, đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321109,
					"content": "Chị, trước khi chị về, em muốn nói với chị, em đã có một ước mơ mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321110,
					"content": "Em phải tự mình đến Inazuma để xem pháo hoa ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321111,
					"content": "Ồ, hay đó! Haha, chị cũng không ngờ là đi chơi mà vẫn có thể kéo khách về cho tiệm pháo hoa nhà mình luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321112,
					"content": "Yên tâm đi, chị sẽ thiết kế riêng cho em một mẫu pháo hoa mới, để em nhớ mãi không quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321113,
					"content": "Các bạn cũng vậy, dù có bận đến đâu thì cũng hãy thường xuyên đến Inazuma xem pháo hoa nhé. Bất kể là lúc nào thì mọi người cũng sẽ chào đón các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321114,
					"content": "Thành quả của chuyến đi này, nói thế nào cũng phải để nó bay lên không trung dưới sự chứng kiến của các bạn chứ nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321115,
					"content": "Được, quyết định vậy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130321116,
					"content": "Bảo trọng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "#Ừm, {NICKNAME} vẫn luôn thận trọng như vậy nhỉ, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321122,
					"content": "#Đúng rồi đúng rồi, {NICKNAME} xem thử cái này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321123,
					"content": "Tượng gỗ Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "Đúng rồi, là kiểu mà bạn giúp tôi chọn đó, bạn và Paimon đều nói nó giống tôi. Lúc nãy tôi đã đi mua thêm một cái, tặng bạn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321125,
					"content": "Lúc không vui thì hãy lấy nó ra ngắm nhé. Nói không chừng sẽ có thể giúp bạn vực dậy tinh thần, và cảm thấy ít nhất vẫn còn có tôi ủng hộ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321126,
					"content": "Tất nhiên, tốt hơn hết vẫn là đến gặp tôi rồi, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321127,
					"content": "Cảm ơn Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "Ừm, vậy tôi về nhé, tôi tin chúng ta sẽ gặp lại nhau sớm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "Yoimiya"
				},
