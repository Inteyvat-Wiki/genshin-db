					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320901,
					"content": "Ừm... Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320902,
					"content": "Sao lại tỉnh dậy rồi, tôi còn chưa xem đủ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320903,
					"content": "Mưa sao băng mà chúng ta dùng ước nguyện để triệu hồi, không ngờ lại bay lên từ mặt đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320904
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320904,
					"content": "Chẳng phải giống với pháo hoa sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320905
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320905,
					"content": "Vẫn chưa thỏa mãn, vẫn chưa thỏa mãn mà. Đây là một giấc mơ chân thực nhất, lộng lẫy nhất, và lãng mạn nhất mà tôi từng mơ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320906,
					"content": "Tôi cũng vậy, nhưng tôi thật không ngờ là cô lại đưa cả chúng tôi nhảy vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320907,
					"content": "Hihi, thật ra tôi cũng không nghĩ quá nhiều đâu. Chỉ cảm thấy không nhân cơ hội này quậy một bữa thì thật là đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320908,
					"content": "Thật ra Yoimiya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "Đã biết đây là mơ rồi sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "Bạn biết tôi mà, có phải là mơ hay không, tôi không quan tâm lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320911,
					"content": "Nhưng tôi vẫn phải cảm ơn các bạn. Các bạn biết không dễ xem được mưa sao băng nên mới chuẩn bị phương án thay thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320912,
					"content": "Tôi rất thích, rất rất thích, trong số tất cả những món quà mà tôi nhận được thì nó vẫn là món quà tuyệt nhất đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320913,
					"content": "Tốt quá rồi! Tôi còn lo là cô sẽ giận khi biết được sự thật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320914,
					"content": "Sao có thể chứ? Tôi đã mơ thấy Aranara tốt bụng, thân thiện và đáng yêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320915,
					"content": "Tôi còn mơ thấy chúng ta đang bay quanh một rừng nấm lớn, và tìm thấy Đá Thông Xanh một cách đầy bất ngờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320916,
					"content": "Tôi nghĩ mình đã tỉnh dậy rồi, nhưng những gì xảy ra tiếp theo đó thậm chí còn lợi hại hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320917,
					"content": "Avin lấy từ trong ngực ra một chiếc kính do Đá Thông Xanh biến thành. Chúng ta đã cùng nhau tìm thấy sao băng bay lên từ mặt đất, và trở thành một phần của mưa sao băng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320918,
					"content": "Chúng ta vẫn luôn ở trong mơ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "Chúng ta chưa từng tỉnh lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "Đúng vậy, giấc mơ tuy là hư ảo, nhưng cũng là một \"trải nghiệm\" không thể sao chép, không thể lặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320921,
					"content": "Nếu như câu nệ chuyện thật giả, chẳng phải sẽ bỏ lỡ rất nhiều cảm xúc đẹp đẽ sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320922,
					"content": "Hihi, Yoimiya thật biết cách khen đó. Tôi phải cho Yoimiya lên thêm một bậc trong bảng xếp hạng bạn thân của Paimon mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320923,
					"content": "Có cả bảng xếp hạng này sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "Đúng rồi, nói đến Aranara, họ không muốn bị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320925,
					"content": "Đúng vậy, Aranara cũng rất đáng yêu. Điều này cũng nhờ vào những chiếc tượng gỗ thủ công đẹp mắt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320926,
					"content": "Ơ, tượng gỗ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320927,
					"content": "Đúng vậy, nếu chúng ta chưa từng thấy tượng gỗ, vậy thì sao có thể mơ thấy Aranara như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320928,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320929,
					"content": "Yoimiya hiểu ý của chúng ta rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "Tôi cũng cảm thấy nó đáng yêu hơn tượng gỗ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "Hihi, yên tâm đi, tôi hiểu mà. Tôi thấy hình tượng của chúng rất đáng yêu, và tôi muốn bảo vệ chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320932,
					"content": "Được rồi, cũng trễ rồi, phải đưa cô bé về nhà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321101,
					"content": "Cùng đưa Avin về nhà, và ở lại Sumeru với Yoimiya thêm vài ngày.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
