			"dialogs": [
				{
					"id": 130320201,
					"content": "Haha, vẫn là chị lợi hại hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320202,
					"content": "Hihi, cự ly xa hơn một chút nữa thì cũng khó nói đó, chị còn tưởng chị sẽ bị đuổi kịp nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320203,
					"content": "Avin dường như hoàn toàn không bị tụt lại phía sau nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320204,
					"content": "Trước đây em cũng từng thắng rất nhiều người lớn. Chân dài chưa chắc đã chạy nhanh, tập luyện cũng rất quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320205,
					"content": "Vậy sau mấy năm nữa thì chị cũng không phải là đối thủ rồi, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320206,
					"content": "Ừm, để xem tiếp theo nên đi hướng nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320207,
					"content": "Ơ, mau nhìn kìa, đằng trước hình như có thứ gì đó đang bay lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320208,
					"content": "Giống như... ngôi sao nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "Lẽ nào là muốn chúng ta đi theo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Avin"
				},
				{
