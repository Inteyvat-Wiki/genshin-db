				{
					"id": 130320501,
					"content": "Đây là điểm cuối cùng rồi, nhưng vẫn không thấy Aranara, chỉ có tảng đá lớn này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320502,
					"content": "Vui quá, cảm giác này như thể em đã quên đi từ lâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320503,
					"content": "Mọi người biết không? Nếu em không chạy thì em cảm thấy thế giới của em chỉ có chút xíu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320504,
					"content": "Nhưng chỉ cần không ngừng chạy về phía trước thì khung cảnh mới sẽ không ngừng xuất hiện, thế giới cũng sẽ mở ra vô tận trước mắt em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320505,
					"content": "#Mặc dù em không biết em đã làm được điều đó như thế nào, nhưng đó chắc chắn là nhờ {M#các anh chị}{F#các chị}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320506,
					"content": "Chuyện này không quan trọng đâu, quan trọng là em đã nhớ ra rất nhiều chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320507,
					"content": "Ký ức không chỉ tượng trưng cho quá khứ, mà còn có sức mạnh để soi sáng cả tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320508,
					"content": "Chỉ cần khỏi bệnh, thì những niềm vui này sẽ quay về bên cạnh em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320509,
					"content": "Ừm, cảm ơn chị, cảm ơn mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320510,
					"content": "Vậy chúng ta tiếp tục đi tìm Arashani đi, hình như Arashani không có ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320511,
					"content": "Đúng vậy, nhưng tại sao ngôi sao đó lại dẫn chúng ta đến đây chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320512,
					"content": "Tôi cũng thấy hòn đá này rất bắt mắt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "Em cũng không biết nó là gì, nhưng lại có cảm giác rất quen thuộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320514,
					"content": "Giống như nó là một phần của em vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320515,
					"content": "Chị biết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320516,
					"content": "Tảng đá này có phải là Đá Thông Xanh thuộc về cô bé không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320517,
					"content": "Đá Thông Xanh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320518,
					"content": "(Yoimiya thật biết cách nói dối.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "(Mình cũng sắp quên mất chuyện này luôn rồi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "Đó là một loại khoáng thạch hiếm có, tượng trưng cho trái tim và ước mơ của một người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320521,
					"content": "Em có thể nhìn thấy nó, chứng tỏ em đã tìm được thứ mà mình đánh mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320522,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320523,
					"content": "Sao lại giống truyện cổ tích vậy, em vốn dĩ không tin vào cổ tích nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320524,
					"content": "Nhưng thật may vì em đã có niềm tin trở lại rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320525,
					"content": "Ơ, xuyên qua rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320526,
					"content": "Chúng ta cũng đi qua đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320527,
					"content": "#Này, này Yoimiya! Haiz, hết cách rồi, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320528,
					"content": "Xuyên qua rồi, nhưng hình như xung quanh không có gì thay đổi cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320529,
					"content": "Lâu rồi không gặp, Nara Avin. Đã lâu lắm rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320530,
					"content": "Arashani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320531,
					"content": "Sao lại buồn bã thế. À, Arashani hiểu rồi, đây là biểu cảm vui vẻ sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320532,
					"content": "Arashani! Huhuhuhuhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320533,
					"content": "Haha, chuyến hành trình mà Aranara chuẩn bị cho chúng ta thật lãng mạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320534,
					"content": "Không chỉ giúp cô bé tìm lại được người bạn quan trọng nhất của mình, mà còn để chúng ta biết được Đá Thông Xanh rốt cuộc là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320535,
					"content": "Lát nữa chúng ta cũng phải tìm Đá Thông Xanh thuộc về mình mới được. Ừm, tôi nhất định sẽ làm ra được thấu kính thuần khiết nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320536,
					"content": "Ừm! Không biết tại sao, nhưng tôi cũng có cảm giác là sẽ làm được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320537,
					"content": "Đây chính là thám hiểm mà đúng không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "Tôi cũng thích nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "Nhưng trước hết phải đưa cô bé trở về Thành Sumeru đã, đừng để cha mẹ cô bé lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320540,
					"content": "Cảnh tượng trước mắt như một giấc mơ. Trong nháy mắt, các bạn lại trở về chỗ cũ.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
