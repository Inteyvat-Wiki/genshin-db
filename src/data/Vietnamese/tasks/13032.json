					"content": "Vậy là... kết thúc rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320602,
					"content": "Một giấc mơ thật đẹp đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320603,
					"content": "Đừng tỏ vẻ cô đơn như vậy, Aranara đó vẫn luôn ở bên cạnh em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320604,
					"content": "Arashani! Ara...shani vẫn ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320605,
					"content": "Arashani muốn xin lỗi, không phải vì không muốn đi tìm Nara, mà là do Arashani không thể nhớ thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320606,
					"content": "Arashani không dám vào trong thành, không gặp được Nara, Arashani tưởng Nara Avin đã có bạn mới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320607,
					"content": "Đây là chuyện bình thường, cũng là chuyện không thể tránh khỏi, không phải chuyện đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320608,
					"content": "Không sao, em hiểu, đều tại em không thể phấn chấn lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320609,
					"content": "Nhưng bây giờ em hiểu rồi. Chị nói rất đúng, ai cũng sẽ gặp phải vận rủi, quan trọng nhất là hỗ trợ lẫn nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320610,
					"content": "Cảm ơn mọi người đã giúp đỡ, em sẽ không phụ lòng những ký ức và ước mơ mà mọi người đã giúp em tìm lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320611,
					"content": "Hihi, em cũng đã giúp chị rất nhiều mà, không cần khách sáo đâu. Vốn dĩ bọn chị còn đang mù mịt về Đá Thông Xanh nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320612,
					"content": "Theo suy nghĩ hiện tại, chị nghĩ bọn chị cũng sẽ tìm được nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320613,
					"content": "Chị muốn xem mưa sao băng đúng không, vì vậy nên mới cần Đá Thông Xanh ạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320614,
					"content": "Ừm, đúng vậy. Đợi bọn chị tìm được rồi thì em cũng đến xem chung nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320615,
					"content": "Nếu vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320616,
					"content": "Em đồng ý cho chị mượn Đá Thông Xanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320617,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320618,
					"content": "Chuyện gì vậy? Một chiếc kính... từ trong ngực sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320619,
					"content": "Tôi cũng không biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320621,
					"content": "Hahaha, sao em biết chị cần cái này vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320622,
					"content": "Em cũng không biết, em chỉ thấy chị giúp em tìm lại người bạn tốt nhất, nên em cũng phải dùng thứ quý nhất để giúp chị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320623,
					"content": "Sau đó ánh sáng đã biến ra thứ này, đây là thứ chị cần đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320624,
					"content": "Cảm ơn em, không ngờ như vậy là giải quyết được rồi, bây giờ để chị thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320625,
					"content": "Mặc dù không rõ cách dùng, nhưng cứ dựa vào trực giác vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320626,
					"content": "Ở đâu, ở đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320627,
					"content": "Ồ! Hình như thấy rồi, khá rõ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320628,
					"content": "Đi thôi, để chị dẫn đường. Chúng ta xem mưa sao băng xong sẽ dẫn em về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320629,
					"content": "Cũng cảm ơn các bạn vì đã giúp chúng tôi, tôi có một lời khen chân thành dành cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320630,
					"content": "Các bạn rất biết cách kể chuyện đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320631,
					"content": "Ôi, thật trùng hợp. Tôi cũng đánh giá bạn như vậy đó, Nara Đỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapurva"
				}
			]
		},
		{
			"id": 1303209,
			"completionStepIds": [
