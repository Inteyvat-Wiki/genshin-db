				{
					"id": 80062103,
					"content": "Nếu là Paimon thì, chí ít... cũng sẽ rất nhớ mùi vị của đồ ăn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
