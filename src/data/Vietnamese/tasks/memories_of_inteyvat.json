				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80060501,
					"content": "Dưới lòng đất sâu như vậy sao lại có bông hoa thế này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060502,
					"content": "Là để dâng cho những Hilichurl đã chết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060503,
						80060504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060503,
					"content": "Tôi biết đây là hoa gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				},
				{
					"id": 80060505,
					"content": "Chậc, bạn nói vậy thì tôi thấy cũng quen quen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060506,
					"content": "Đây là quốc hoa của Khaenri'ah - \"Inteyvat\", từng nở rộ khắp mọi nơi trong lãnh địa Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060507,
					"content": "Vòng đời của loài hoa này chỉ có hai tuần. Nếu bị người khác ngắt đi, mang khỏi Khaenri'ah thì cánh hoa sẽ khô cứng lại, không còn sinh trưởng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060508,
					"content": "Cho đến khi quay về cố hương, cánh hoa mới mềm mại trở lại, tan biến tại quê nhà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060509,
					"content": "Vì vậy, Inteyvat cũng tượng trưng cho \"kẻ tha hương\", cũng có nghĩa là \"sự ấm áp của quê hương\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060510,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_Twins2Male|INFO_FEMALE_PRONOUN_Twins2Female]}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "A! Loài hoa này xuất hiện ở đây, cũng có nghĩa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060512,
					"content": "#{F#Hoàng tử}{M#Công chúa} điện hạ, người cuối cùng cũng đồng ý rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060513,
					"content": "Quá chú tâm vào việc chống lại \"Thiên Lý\" mà quên đi mất sứ mệnh \"khôi phục đất nước\".",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "Đúng vậy, ta không nên do dự như vậy.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "\"Thiết bị\" đã được chuẩn bị xong, đang đợi lệnh của điện hạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060516,
					"content": "Nắm chắc được bao nhiêu phần trăm?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "Dựa theo nguyên lý mà nói, vào khoảng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060518,
					"content": "Kệ đi, dù cho chỉ là một tia hy vọng mong manh đi chăng nữa...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "Chúng ta cũng như vậy mà đúng không, sớm đã ở trong Vực Sâu rồi.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "Đối với \"họ\" mà nói, sống một cuộc sống không có tôn nghiêm như vậy, thôi thì sớm quay về trong \"luân hồi\" thì hơn.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "Đừng để \"họ\" tiếp tục mang... những tội lỗi không đáng có đó.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "Sự quyết đoán của điện hạ chính là may mắn của giáo đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060523,
					"content": "#{M#Em}{F#Anh}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "Thấy được gì vậy, có thể nói cho tôi nghe không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060525,
					"content": "Đúng vậy, bạn đã thất thần một hồi lâu rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060526,
					"content": "Nói cho Dainsleif nghe cảnh tượng ban nãy...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "Phải chăng đây chính là sự kết nối kỳ diệu chỉ thuộc về những cặp song sinh sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060528,
					"content": "Nghe có vẻ, họ muốn lợi dụng thiết bị gì đó để thanh tẩy lời nguyền, có thể là vật mà chúng ta đã thấy trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060529,
					"content": "#Vả lại... {M#cô ấy}{F#cậu ấy} có nhắc đến \"phục quốc\", đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060530,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "Thật cứng đầu, quả nhiên đến giờ vẫn không buông bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060533,
					"content": "Xem ra, kế hoạch của giáo đoàn chính là mượn nơi này để thanh tẩy lời nguyền của Hilichurl, muốn khiến họ hồi sinh... từ đó làm bàn đạp để phục hưng Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060534,
					"content": "Dẫu sao thì, không có \"dân\" thì sao mà có \"quốc gia\" chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060535,
					"content": "Anh thấy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "Hừ, thật ngu ngốc, đến một phần trăm khả năng cũng không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060538,
					"content": "Tôi đã nói rồi, thân là một người sống chung với lời nguyền đã năm trăm năm, không ai hiểu rõ hơn tôi cả... không hề tồn tại sự cứu rỗi nào khác, lời nguyền sẽ không thể bị xóa bỏ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060539,
					"content": "Nếu như miễn cưỡng xóa bỏ lời nguyền, ngoài sự đau khổ ra thì không còn nhận được thêm gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060540,
					"content": "Cho nên, phải duy trì sự tỉnh táo, phải luôn nhắc nhở bản thân rằng những thứ đó đã không còn là... con người nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060541,
					"content": "Quá chấp nhất, đặt quá nhiều tình cảm vào chỉ tổ càng dấn càng sâu... đến cuối cùng giống như chúng vậy, sa lầy vào vũng bùn không lối thoát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060542,
					"content": "Nếu đã vậy thì hãy đặt hết tâm tư của mình vào thứ xứng đáng để cứu rỗi hơn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060543,
					"content": "Tại sao tôi phải tin anh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060545,
					"content": "#Haha... cũng đúng, giữa chúng ta không có mối quan hệ gì cả, mà {M#cô ta}{F#cậu ta} mới là người thân của {M#cậu}{F#cô}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060546,
					"content": "#{M#Cậu}{F#Cô} chọn đứng về phía {M#cô ta}{F#cậu ta}, về tình về lý, đúng là không có gì sai trái cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060547,
					"content": "#Dù cho {M#cậu}{F#cô} lựa chọn thế nào cũng không ảnh hưởng đến tôi. Ngăn cản Vực Sâu chính là con đường mà tôi đã chọn. Nếu như không có chung mục tiêu, vậy thì hãy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060548,
					"content": "Lần này tôi sẽ chọn tin anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "Nhưng không có nghĩa là tôi sẽ tin anh hoàn toàn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "Vậy sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060552,
					"content": "Một phần trăm khả năng có được sự cứu rỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "Không ai có đủ tư cách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "Huống chi những Hilichurl đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "#Xem ra, ba câu hỏi trước đây của tôi không phải không có ý nghĩa. {M#Cậu}{F#Cô} đã có cách nhìn độc lập về thế giới này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060559,
					"content": "#Nếu {M#cậu}{F#cô} đã thổ lộ suy nghĩ của mình, tôi cũng không muốn tiếp tục giấu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060560,
					"content": "Trước mắt, thay vì ngăn cản Vực Sâu, điều tôi quan tâm hơn là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060561,
					"content": "Tuyệt đối không cho phép Vực Sâu độc đoán chà đạp lên \"di nguyện\" của Halfdan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060562,
					"content": "Tôi hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "Vực Sâu có thể sẽ xuất hiện bất cứ lúc nào, hãy cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060563,
					"content": "Tiếp tục hợp tác thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "Vốn đã chọn được nơi an nghỉ của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "Để đưa ra lựa chọn cho sinh mạng của người khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "Chín mươi chín phần trăm có thể sẽ chết đi trong đau khổ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "#Chỉ là tôi không tán đồng cách làm của {M#cô ấy}{F#anh ấy} thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "Có cơ hội để thực hiện không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "#{M#Em ấy}{F#Anh ấy} nói đây là sứ mệnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "Tôi đã thấy qua loài hoa này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		},
		{
