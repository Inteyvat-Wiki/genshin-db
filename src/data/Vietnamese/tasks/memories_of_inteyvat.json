					"content": "Phù! Cuối cùng cũng tiêu diệt được hắn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060802,
					"content": "Không còn thời gian để nói chuyện phiếm nữa. Xem ra thiết bị của Giáo Đoàn Vực Sâu đã khởi động rồi, giờ đi phá hủy nó có lẽ vẫn còn kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060803
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060803,
					"content": "Ừm! Chúng ta mau qua đó xem thử thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
