			"dialogs": [
				{
					"id": 80062201,
					"content": "Những tên Hilichurl này... đã không còn thở nữa, sắp hòa mình vào trong bóng tối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062202,
					"content": "Những tên Hilichurl ồn ào sẽ già đi bằng cách này sao, đúng là không thể tưởng tượng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062203,
					"content": "Dù cho không có nhiều ký ức với Hilichurl lắm, nhưng mà, Paimon cũng hy vọng chúng có thể tìm được nơi bình yên cho mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 800655,
			"completionStepIds": [
