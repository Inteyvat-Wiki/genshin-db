			"dialogs": [
				{
					"id": 80060401,
					"content": "Một nơi có những doanh trại thô sơ của Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060402,
					"content": "Nơi đây cũng có những Hilichurl đáng thương, có một số... đã không còn thở nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060403,
					"content": "Nơi mà Halfdan muốn dẫn chúng ta đến chính là chỗ này phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060404,
					"content": "Dù phải hay không thì nơi này cũng rất đáng để điều tra đấy. Thử quan sát xung quanh xem, đừng để bỏ sót thứ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800605,
			"completionStepIds": [
				800605,
				800609,
				800610,
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800605",
							"2"
						],
						"stepId": 800605,
