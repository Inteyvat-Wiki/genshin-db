			},
			"dialogs": [
				{
					"id": 80060601,
					"content": "Ở đây cũng có thể thấy được tòa thành đảo ngược đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060602,
					"content": "Không ổn... cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060603,
					"content": "Wao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060604,
					"content": "Chuyện gì vậy! Là ánh sáng phát ra từ căn phòng trung tâm đó sao? Đau mắt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060605,
					"content": "Vực Sâu đã ra tay rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060606,
					"content": "Dainsleif... ngươi lại tiếp tục hợp tác với máu mủ của điện hạ sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060607
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060607,
					"content": "Lúc đấy chưa thiết lập xong mạng lưới dịch chuyển nên đã chuyển nhầm ngươi đến đây... quả là sai lầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060608
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060608,
					"content": "Hừ! Tên nhát gan chỉ biết bỏ chạy, là ai cho ngươi lòng can đảm để đứng đối diện với ta thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060609
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060609,
					"content": "Ý chí của điện hạ cần phải được bảo vệ, ta sẽ quét sạch tất cả chướng ngại cản đường bằng mọi giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060610
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060610,
					"content": "Lần này nhất định sẽ... thanh tẩy hoàn toàn lời nguyền giày vò dân chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060611
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060611,
					"content": "Thứ giày vò họ chính là các ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060612
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060612,
					"content": "Trên người đám Hilichurl đó ngoài lời nguyền ra, căn bản đã không còn lưu lại gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060613
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060613,
					"content": "Ta sẽ không trốn chạy nữa, xông lên đi, Dainsleif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060614
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80060614,
					"content": "Ý chí nực cười này, đáng để ngươi dùng sinh mạng để kéo dài thời gian sao? Nếu ngươi kiên quyết thì ta sẽ cho ngươi toại nguyện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
