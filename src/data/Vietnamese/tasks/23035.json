				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "Suỵt... Kia, kia có phải là Cyno không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350302,
					"content": "Nhìn trang phục của anh ấy, nhìn kiểu tóc và màu tóc đó... đúng là nhân vật chính tuyệt nhất của tiểu thuyết trò chơi thẻ bài rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350303,
					"content": "Hoàn toàn không hợp lý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "Ôi, bạn cứ tin vào trực giác của tôi trong thị trường tiểu thuyết đi. Nhưng bây giờ không phải là lúc để nói chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350309,
					"content": "Nhà Lữ Hành, chuyện nhờ Cyno làm người mẫu cho tôi... nhờ bạn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350305,
					"content": "Tôi còn biết khá nhiều những nhân vật chính kiểu này đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "Thật sao? Vậy thì tốt quá, tôi đang chuẩn bị viết phần thứ ba của Vua Triệu Hồi, lần này tôi không định viết theo lối chơi của Thất Thánh Triệu Hồi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350307,
					"content": "Tôi quyết định sẽ tạo ra một phương thức đối chiến hoàn toàn độc đáo. Ví dụ... tất cả thẻ bài được treo trong sân, người chơi phải vừa đối chiến vừa thu thập thẻ bài, đồng thời còn phải ngăn chặn đối thủ thu thập thẻ bài nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350308,
					"content": "Hahaha! Nghĩ thôi là đã thấy thú vị rồi! Nhưng bây giờ không phải là lúc để nói chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
