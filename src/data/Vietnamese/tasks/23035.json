			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "Haiz, muốn trở về Inazuma quá... Sao mình lại gặp phải chuyện như vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "Nhà Lữ Hành? Haiz, đừng nhắc đến tiểu thuyết nữa, tôi thấy bọn người làm Thất Thánh Triệu Hồi sắp không trụ nổi nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350105,
					"content": "Theo như một học giả khá thân với tôi nói, khi làm Thất Thánh Triệu Hồi, anh ta đã gặp phải nhiều vấn đề kỳ lạ không thể giải thích được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350106,
					"content": "Ví dụ như một ngày nọ, một học giả của học viện Haravatat đột nhiên đặt ra một câu hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350107,
					"content": "Anh ta nói, phần mô tả hiệu ứng thẻ bài trên mặt thẻ quá dài, có lẽ sẽ khiến những người không quen đọc dài không muốn chơi Thất Thánh Triệu Hồi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350108,
					"content": "Các học giả thì lại quen đọc những văn bản dài và không nhạy cảm với vấn đề này. Nhưng có thể có những người chơi không thích đọc những văn bản dài, và thậm chí không chơi Thất Thánh Triệu Hồi vì điều này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350109,
					"content": "Vì vậy anh ta đề xuất giảm bớt một nửa số chữ trên thẻ để người chơi dễ đọc hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350110,
					"content": "Phải làm như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "Tôi nghĩ nó không thành vấn đề... Nhưng các học giả vẫn đang nghiêm túc nghiên cứu vấn đề này. Dù sao thì việc có liên quan đến trải nghiệm của người chơi thì họ cũng không muốn để xảy ra vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350113,
					"content": "Haiz, không nói chuyện này nữa... Vấn đề lớn hơn bây giờ là, chuyện lúc trước họ hứa giúp chúng ta tìm người mẫu cũng xảy ra vấn đề rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350114,
					"content": "Không phải lúc trước tôi đã nói với bạn rồi sao, có một học giả nói, họ sẽ giúp tôi liên hệ với anh Tighnari và anh Cyno, và nhờ hai người đó làm người mẫu đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350115,
					"content": "Nhưng họ bận quá, tôi nghĩ tạm thời không nên trông cậy vào họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350116,
					"content": "Vậy phải làm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "Học giả đã tiếp tôi mặc dù không thể giúp tôi vấn đề này, nhưng anh ta đã cho tôi một ý kiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350119,
					"content": "Anh ta nói, Cyno thỉnh thoảng sẽ đến Tiệm Cà Phê Puspa để chơi bài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350120,
					"content": "Nếu được thì... có thể đến Tiệm Cà Phê Puspa đó thử vận may. Hoặc là, đợi họ rảnh rồi sẽ giúp tôi liên hệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350121,
					"content": "Vậy anh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "Haiz, đợi họ rảnh thì tiểu thuyết của tôi cũng sắp viết xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350123,
					"content": "Vậy nên tôi vẫn là tự lực cánh sinh, xem có thể tự mình tìm được Cyno không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350124,
					"content": "Nhưng cứ cho là tôi may mắn, gặp được Cyno ở Tiệm Cà Phê Puspa, vậy thì phải làm sao để bắt chuyện chứ? Thật là đau đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350128,
					"content": "Tôi có thể giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "Thật sao?! Tốt quá rồi! Nhưng sao bạn... Ừm, bỏ đi, tôi không hỏi vấn đề này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350131,
					"content": "Không thể chậm trễ nữa, chúng ta mau đến Tiệm Cà Phê Puspa đi. Hy vọng có thể gặp Cyno ở đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350129,
					"content": "Tôi và Cyno rất thân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "Làm thế nào để liên lạc?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "Thật ra cũng không đến nỗi dài lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "Việc viết tiểu thuyết không suôn sẻ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
