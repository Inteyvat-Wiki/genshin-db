			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "...Ừm, nhóm thẻ bài như vậy có vẻ không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350402,
					"content": "Nhưng năng lực ứng phó tấn công nhanh của những thẻ bài này hình như có hơi yếu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350403,
					"content": "Cyno, anh đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}? Không ngờ lại gặp {F#cô}{M#cậu} ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350405,
					"content": "Tôi đang thử xây dựng một bộ thẻ Thất Thánh Triệu Hồi với tốc độ tấn công chậm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350406,
					"content": "Trong suy nghĩ của tôi, người sử dụng bộ thẻ này sẽ có tài nguyên phong phú và các loại thẻ bài mạnh hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350407,
					"content": "Nhưng nói thật, bộ thẻ này quá khó xếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350408,
					"content": "Hiện giờ trong nhóm người chơi Thất Thánh Triệu Hồi, có một số người chơi thích sử dụng nhóm thẻ tấn công nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350409,
					"content": "Khi mới bắt đầu trò chơi đã đánh số lượng bài lớn cùng một lúc để hạ gục đối thủ với tốc độ nhanh nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350410,
					"content": "Nhưng tôi lại không thích chiến thuật đó. Tôi thích chiến thuật quyết đấu, là không ngừng tích lũy tài nguyên bằng mọi cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350411,
					"content": "Nắm bắt mỗi một thời cơ, không ngừng tích lũy ưu thế, và chắc chắn giành chiến thắng cuối cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350412,
					"content": "Chính xác! Chính là như vậy đấy! Quá tốt rồi, quá tốt rồi! Anh hoàn toàn giống với nhân vật chính trong tiểu thuyết của tôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350413,
					"content": "Xin lỗi! Ừm... Tôi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350414,
					"content": "Vị này là Fukumoto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "Vị này là tác giả của \"Vua Triệu Hồi\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "Xin chào, Tổng Quản Mahamatra, ừm... tôi đoán là anh chưa nghe qua tên tôi bao giờ nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350417,
					"content": "Tôi từng xem tiểu thuyết mà anh viết rồi, rất hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350418,
					"content": "Thật vinh hạnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350419,
					"content": "Điều khiến tôi ấn tượng nhất ở cuốn tiểu thuyết này là mỗi khi nhân vật chính rơi vào tình thế bất lợi là sẽ luôn rút được tấm thẻ bài vốn không tồn tại bằng nhiều cách khác nhau, sau đó vượt qua kẻ thù để giành chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350420,
					"content": "Tôi hiểu đây là yêu cầu của cốt truyện, nhưng cách giành chiến thắng này chắc chắn đã đi lệch khỏi bản chất của trò chơi Thất Thánh Triệu Hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350421,
					"content": "Chuyện này... mặc dù tôi thường xuyên chơi Thất Thánh Triệu Hồi, nhưng chơi không giỏi cho lắm... Hơn nữa, nếu thật sự dùng tư duy cạnh tranh để viết về quyết đấu thẻ bài trong tiểu thuyết thì cũng không hay cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350422,
					"content": "Ừm, vậy sao? Đúng lúc tôi vừa làm ra hai bộ thẻ, chúng ta có thể chơi vài ván Thất Thánh Triệu Hồi ở đây, nói không chừng anh sẽ có thể tìm được chút cảm hứng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350423,
					"content": "(Đột ngột vậy sao...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "(Anh ta đâu phải muốn chơi bài đâu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "Hả? Chơi, chơi bài với anh? Tôi rất sẵn lòng, nhưng thật ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350426,
					"content": "Để tôi nói cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "Về yêu cầu của Fukumoto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "Nhà Lữ Hành thuật lại yêu cầu của Fukumoto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "Muốn tôi làm người mẫu cho tranh minh họa Vua Triệu Hồi sao? Đương nhiên là không thành vấn đề rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350430,
					"content": "Tốt quá rồi! Nhà Lữ Hành, mau, mau giúp tôi chụp vài tấm ảnh đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				}
			]
		},
