					"content": "Nhanh tay chụp cho Cyno vài tấm hình...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350601,
					"content": "Bạn đã giúp tôi một việc lớn đấy, lần này tiểu thư Asagiri chắc chắn sẽ có thể vẽ được một bức tranh minh họa tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350602
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350602,
					"content": "Cảm ơn anh, Cyno, đợi tiểu thuyết xuất bản rồi tôi sẽ tặng cho anh một cuốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350603
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350603,
					"content": "Ừm, anh Cyno, hai bộ bài trong tay anh là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350604
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350604,
					"content": "Không phải anh đã đồng ý cùng tôi chơi vài ván Thất Thánh Triệu Hồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350605,
					"content": "Hả?! Tôi, tôi chơi không giỏi lắm. À... Nhà Lữ Hành! Bạn chắc sẽ chơi giỏi hơn tôi chứ nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350606,
						230350607
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350606,
					"content": "Tôi chưa chơi bao giờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350607,
					"content": "Anh giỏi hơn tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350608,
					"content": "Quyết định vậy nhé. Nào, cho anh nhóm thẻ thiên về tấn công nhanh đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350609
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350609,
					"content": "Tôi sẽ dùng bộ thẻ tấn công chậm, để xem tôi sẽ đối phó với chiến thuật tấn công của anh như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350610
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350610,
					"content": "Tôi nhất định sẽ cố gắng hết sức, anh Cyno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				}
			]
