			"dialogs": [
				{
					"id": 760580101,
					"content": "Mình chưa từng thấy qua con Chồn Đạo Bảo nào trắng thế này, chẳng lẽ nó bị bệnh sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580102,
					"content": "Nhìn nó nhảy nhót tung tăng thế kia, vừa rồi còn muốn giành đồ ăn của anh Jurva nữa, đâu có giống bị bệnh đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580103,
					"content": "Có khi là giống loài quý hiếm nhỉ? Linnea chắc biết đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580104,
					"content": "Woa! Chính là tên trộm Mora từng vét sạch quỹ đen của tôi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580105,
					"content": "Chồn Đạo Bảo cố gắng bỏ chạy, nhưng bị ba đứa trẻ nhanh tay đè lại. Nó vùng vẫy một lúc rồi thôi, bạn nhân lúc này kể lại cho bọn trẻ những gì đã xảy ra trước đó...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "Thì ra là tội phạm chuyên nghiệp. Vậy phải cho nó một bài học mới được, phạm lỗi thì phải chịu phạt, thế mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580107,
					"content": "Nhưng nó chỉ là động vật nhỏ thôi, nó đâu có hiểu mấy chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580108,
					"content": "Chỉ cần trả lại Mora cho Paimon là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "Dù gì đi nữa, trước tiên cứ lấy lại số Mora trên người nó đã. Nó cũng đâu tiêu được mấy đồng đó, nên tất cả vẫn còn nguyên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580111,
					"content": "Tuyệt quá! Hihi, vậy là quỹ đen lại đầy ắp rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580112,
					"content": "Nếu nuôi được nó thì tốt quá. Khi Helka về cũng có thể thấy được con Chồn Đạo Bảo hiếm có này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580113,
					"content": "Hả? Nhưng nó đâu có làm việc... Ăn trộm thì không tính là lao động đâu! Không làm việc thì lấy gì ăn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580114,
					"content": "Thôi nào, xử lý nó như thế nào thì... tụi mình bàn lại với chị Katya sau vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580109,
					"content": "Dù là động vật nhỏ cũng cần biết thế giới tàn khốc ra sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
