			"dialogs": [
				{
					"id": 205130101,
					"content": "Lần này cũng bình thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130102,
					"content": "Không phải bạn vẫn rất ổn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "Đúng vậy, ôi, đúng là tôi tự hù dọa mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130104,
					"content": "Sức khỏe của Anna cũng dần khởi sắc, vị thần y đó đúng là có bản lĩnh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130105,
					"content": "Nếu bạn đồng ý, có thể tiếp tục giúp tôi tìm thuốc không? Lần này là \"Cúc Cánh Quạt bị Slime Phong thổi bay\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130106,
					"content": "Nghe không giống thuốc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Ừm... đôi khi Cúc Cánh Quạt cũng được dùng làm thuốc, nhưng hầu hết là trị một số bệnh nhẹ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130108,
					"content": "Lẽ nào Slime Phong mới là chính, nhưng Cúc Cánh Quạt và Slime Phong thường không ở cùng một chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130109,
					"content": "Cũng may Jack nói bạn ấy gặp tình huống như vậy vài lần rồi, cũng đã nói cho tôi biết vị trí. Để tôi đánh dấu chỗ gần nhất lên bản đồ cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130110,
					"content": "Tôi không đối phó được Slime Phong, bọn chúng biết bay... cho nên, đành phải nhờ bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130111,
					"content": "Cũng... rất thích hợp với Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Ai nói không phải chứ. Nhưng Cúc Cánh Quạt và Slime Phong thường không ở cùng một chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130113,
					"content": "Cũng may Jack nói bạn ấy gặp tình huống như vậy vài lần rồi, cũng đã nói cho tôi biết vị trí. Để tôi đánh dấu chỗ gần nhất lên bản đồ của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130114,
					"content": "Tôi thật sự không đối phó được Slime Phong, bọn chúng biết bay. Cho nên, đành phải nhờ bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130115,
					"content": "Tôi lại bắt Slime Phong về cho bạn đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "Tôi nói này, thật ra là bạn chỉ muốn nhiều chuyện thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130117,
					"content": "Nhưng mà, Cúc Cánh Quạt và Slime Phong thật sự không hay ở cùng một chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130118,
					"content": "Cũng may Jack nói bạn ấy gặp tình huống như vậy vài lần rồi, cũng đã nói cho tôi biết vị trí. Để tôi đánh dấu chỗ gần nhất lên bản đồ của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130119,
					"content": "Nếu không tìm được thì hãy bắt Slime Phong về đây! Vì Anna, chuyện gì tôi cũng sẽ làm...",
