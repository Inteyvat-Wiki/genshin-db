					"Barbeloth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "Thực sự không thể sao chép một bản lưng bài này cho tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930102,
					"content": "Xin lỗi, không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930103,
					"content": "Thật sự rất ngầu mà, có thể thương lượng lại không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930104,
					"content": "Không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930105,
					"content": "Được rồi, để có được lưng bài tuyệt đẹp và sử dụng những thẻ bài mạnh đều phải trả giá, tôi hiểu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930106,
					"content": "Anh chẳng hiểu gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "#Này, {NICKNAME}! Còn chưa hỏi gì mà đã trực tiếp nói toạc nguyên nhân ra rồi sao? Biết đâu Cyno đến là để...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930110,
					"content": "Đúng vậy. Không hổ danh là bạn chí cốt của tôi, chúng ta cùng tần số rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930111,
					"content": "Nghiêm túc đấy hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930112,
					"content": "Gần đây Fontaine đang tổ chức một buổi gặp mặt nhỏ dành cho các bài thủ, nghe nói trong buổi gặp mặt sẽ phát miễn phí hộp đựng thẻ phiên bản giới hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930113,
					"content": "Giáo Viện không có việc gì quan trọng nên tôi đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930114,
					"content": "Dù có là việc quan trọng đến mấy, thì Cyno chắc chắn cũng sẽ biến nó thành việc không mấy quan trọng cho mà xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930115,
					"content": "Đúng vậy, tôi chỉ tăng ca hai tuần là đã xử lý gần hết mọi việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930116,
					"content": "Sethos cũng đã giúp đỡ, anh ta rất hợp với công việc giấy tờ. Tôi đã hứa sẽ mang cho anh ta một hộp đựng thẻ để đền bù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930117,
					"content": "Tổng Quản Mahamatra, rốt cuộc cậu có rút bài hay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930118,
					"content": "Đương nhiên là phải rút rồi. Vừa rồi cô nói, thẻ bài này có thể dùng để dự đoán tương lai của tôi, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930119,
					"content": "Nói chính xác thì không phải như vậy. Nhưng cậu hiểu như vậy cũng không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930120,
					"content": "Ra là vậy... Đây chính là \"đem vận mệnh đánh cược cho lượt rút bài tiếp theo\" được viết trong \"Vua Quyết Đấu\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930121,
					"content": "Vậy thì, đến lượt tôi rồi, rút bài...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930122,
					"content": "Cyno hít một hơi thật sâu, rồi rút bài với tư thế cực kỳ ngầu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "Là lá Tiết Độ đặt ngược. Tổng Quản Mahamatra của Giáo Viện Sumeru rút được lá này cũng không nằm ngoài dự đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930124,
					"content": "Trước đây cô từng nghe nói về Cyno rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "Alice đã từng nhắc đến vài lần, nói rằng không ngờ trong Giáo Viện cứng nhắc lại có một Tổng Quản Mahamatra hài hước như vậy, thật thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930126,
					"content": "Cảm ơn đã khen. Tôi đã rút bài rồi, tiếp theo phải làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930127,
					"content": "Nếu đã là lá Tiết Độ ngược, hay nói cách khác là \"kỹ nghệ\" ngược, vậy tôi đề nghị, tốt nhất nên duy trì trạng thái \"không làm gì cả\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930128,
					"content": "Cậu hành sự quá nôn nóng vội vàng, suýt chút nữa đã mất thăng bằng trên cây cầu gỗ nhỏ hẹp của vận mệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930129,
					"content": "Chẳng lẽ do tôi chơi bài không có chừng mực sao? Sethos và Tighnari cũng từng nói như vậy, tôi đã điều chỉnh lại thời gian biểu rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930130,
					"content": "...Tôi không nói đến chuyện chơi bài. Tôi đang nói đến thời gian làm việc. Những việc có thể khiến Tổng Quản Mahamatra phải toàn lực ứng phó, chắc không chỉ có Thất Thánh Triệu Hồi đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930131,
					"content": "Ngoài việc chơi bài, lịch trình của tôi cơ bản không có chút khoảng trống nào để \"điều chỉnh\" cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930132,
					"content": "Cậu đã quen tự mình gánh vác áp lực từ việc sắp xếp như vậy mang lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930133,
					"content": "Còn có các đồng nghiệp Matra khác nữa, chúng tôi sẽ cùng nhau gánh vác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930134,
					"content": "Nhưng họ đều đang trông cậy vào cậu. Không chỉ các Matra, mà còn có các học giả Giáo Viện, người dân Sumeru... rất nhiều người đều đang trông cậy vào Tổng Quản Mahamatra là cậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930135,
					"content": "Không ai nhắc đến chuyện này, hoặc là họ đều không ý thức được suy nghĩ này trong lòng mình... Bởi suy cho cùng, họ đều bị thu hút bởi khiếu hài hước của cậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930136,
					"content": "Nhưng cậu lại luôn cảm nhận được những ánh mắt ấy... Ồ, còn có cái bóng đồng hành cùng cậu nữa, đó cũng là một trong những gánh nặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930138,
					"content": "Cậu đã quen với việc đi đầu, đảm nhận hết trọng trách này đến trọng trách khác... Tôi nghĩ, có lẽ đó mới chính là nguyên nhân khiến cậu \"mất cân bằng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930139,
					"content": "Tôi có rất nhiều bạn bè, còn có cả Thất Thánh Triệu Hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930140,
					"content": "Xem ra, cậu không định nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930141,
					"content": "Vẫn chưa đến lúc có thể nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930142,
					"content": "Quả thật, đối với người như cậu, nếu cuộc chiến nội tâm không chấm dứt, thì cho dù đến ngày lìa đời cũng vẫn chưa phải lúc kết thúc chức trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930143,
					"content": "Hãy nhận lấy Thánh Bài Ánh Trăng này đi. Biết đâu nó có thể dẫn lối cho cậu, tìm ra \"lý do\" đủ để lấy lại cân bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930144,
					"content": "Đến lúc đó, cuộc chiến trong nội tâm cậu cũng sẽ bước vào trận quyết chiến cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930145,
					"content": "Cyno sẽ không thua đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#Cảm ơn {NICKNAME}, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930148,
					"content": "Cũng cảm ơn cô, tôi sẽ nhận lấy lá bài này. Tôi cam đoan sẽ không mang nó vào Pháo Đài Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930149,
					"content": "...Hả? Sao đột nhiên lại như vậy, đợi đã, lẽ nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930150,
					"content": "Sao lại nữa rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
