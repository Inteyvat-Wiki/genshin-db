			},
			"dialogs": [
				{
					"id": 721450101,
					"content": "\"...Nghe nói có ba đồng tử trong đôi mắt của sứ thần Omikami, một là \"Linh\", một là \"Kính\", một là \"Thực\"...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Bia đá cổ xưa"
				},
				{
					"id": 721450102,
					"content": "\"...Từ biển sâu thăm thẳm nhô lên, đến từ <color=#00E1FFFF>Nam</color>, vượt qua <color=#00E1FFFF>Bắc</color>, dừng lại ở bờ <color=#00E1FFFF>Tây</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Bia đá cổ xưa"
				},
				{
					"id": 721450103,
					"content": "\"...Ba đồng tử sáng quắc, đến nỗi Rồng Biển Sâu cũng không dám gây hấn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Bia đá cổ xưa"
				},
				{
					"id": 721450104,
					"content": "Ừm...chữ nào cũng biết, nhưng ghép lại với nhau thì lại không hiểu đang nói gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721450105,
					"content": "Xem ra xung quanh cũng không có manh mối...hay là sử dụng <color=#00E1FFFF>\"góc nhìn nguyên tố\"</color> để xem thử nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
