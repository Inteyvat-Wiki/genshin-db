			"dialogs": [
				{
					"id": 721630201,
					"content": "Nhức đầu ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630202,
					"content": "Về tấm hình này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "Địa hình trên tấm hình này trông giống một nơi nào đó trên Đảo Seirai đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630204,
					"content": "Sao bạn nhìn ra được thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "Dù sao hiệp hội cũng từng gửi một số ủy thác tìm kiếm những thứ liên quan đến Đảo Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630206,
					"content": "Những nhà mạo hiểm nhận ủy thác khi về hiệp hội báo cáo cũng mang về một ít tin tình báo có liên quan đến Đảo Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630207,
					"content": "Nhưng do không đủ nhân lực nên chúng tôi tạm không thể tổ chức cuộc tìm kiếm với quy mô lớn, chỉ có thể cách một thời gian thì cử vài nhà mạo hiểm qua đó tìm kiếm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630208,
					"content": "Vì vậy thông tin về Đảo Seirai trong tay tôi cũng có hạn, không thể giúp bạn giải mã tấm bản đồ này tiếp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630209,
					"content": "Nhưng tôi biết trong thành có một người hiểu biết về Đảo Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630210,
					"content": "Người đó là Oda Tarou, nghe nói...tổ tiên của anh ấy từng sống trên Đảo Seirai, sau đó vì nhiều nguyên nhân mới di cư đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630211,
					"content": "Trước đây anh ấy từng đến hiệp hội, nói muốn thuê vài nhà mạo hiểm đi cùng anh ấy về Đảo Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630212,
					"content": "Bạn có thể cầm tấm hình này đi tìm Oda Tarou hỏi thử, không chừng anh ấy sẽ biết gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furuya Noboru"
				}
			]
		},
		{
			"id": 7216303,
			"completionStepIds": [
				7216302
