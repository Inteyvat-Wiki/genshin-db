			"dialogs": [
				{
					"id": 721630401,
					"content": "Bạn về rồi sao, thế nào? Có chụp được ảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630402,
					"content": "Đã chụp xong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "Tốt quá, cho tôi xem với...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630404,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630405,
					"content": "Ha ha ha, không biết là nơi nào luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630406,
					"content": "Nhưng cảnh sắc trên ba bức ảnh đó đúng là đã thay đổi không ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630407,
					"content": "Không biết tiểu thư Fujiwara Toshiko đó...có nhận ra những nơi này không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630408,
					"content": "Nhưng...ha ha, tôi nghĩ cô ấy cũng khó lòng nhận ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630409,
					"content": "Cô ấy đến từ Đảo Seirai sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "Nói chính xác thì giống tôi đấy, tổ tiên cũng từng sống trên Đảo Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630411,
					"content": "Ây da, thực ra Inazuma này còn rất nhiều người có tổ tiên từng sinh sống ở Đảo Seirai lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630412,
					"content": "Sao mọi người lại đi khỏi Đảo Seirai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "Tôi không nhớ đâu...đó là chuyện rất lâu trước đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630414,
					"content": "Hình như là do mưa bão quá nặng nề, hay là để ngăn chặn vượt biên và nạn buôn lậu gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630415
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630415,
					"content": "Tóm lại là dưới sự sắp xếp của Shogunate, thì người trên Đảo Seirai đều đã di cư sang Đảo Narukami rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630416
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630416,
					"content": "À, khoan nói chuyện phiếm đã, những thứ này cho bạn, nhận lấy đi, cám ơn bạn đã giúp tôi đi một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630417
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630417,
					"content": "Haiz, không biết đến khi nào tôi mới có thể tự mình đến Đảo Seirai đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630418
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630418,
					"content": "Thôi cứ làm cho xong đơn hàng này trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oda Tarou"
				}
			]
