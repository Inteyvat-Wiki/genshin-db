				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "Haiz, không biết đến khi nào mới tìm được người đi với tôi về xem thử đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630302,
					"content": "Về tấm hình này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "Bạn là...nhà mạo hiểm của Hiệp Hội Nhà Mạo Hiểm sao? Cuối cùng họ cũng có người rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630304,
					"content": "Tôi chỉ là nhà lữ hành vô tình đi ngang qua thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "Được thôi, bạn muốn cho tôi xem hình gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630306,
					"content": "Để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630307,
					"content": "Đây, đây là...chẳng lẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630308,
					"content": "Bạn nhìn ra gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "Đây không phải là Đảo Seirai sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630311,
					"content": "Phải.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "Ha ha ha, thật sự là Đảo Seirai sao? Tôi cũng chỉ đoán thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630314,
					"content": "Tuy tổ tiên tôi từng sống trên đảo nhưng đó đã là chuyện rất xưa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630315,
					"content": "Đến đời của tôi thì hầu như không còn ấn tượng gì với Đảo Seirai nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630316,
					"content": "Đồ ở nhà có liên quan đến Đảo Seirai...cũng chỉ có ba bức tranh phong cảnh trên Đảo Seirai thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630317,
					"content": "Vậy sao bạn lại muốn trở về?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "Ừ thì...nói sao nhỉ, nơi đó dù sao cũng coi như là quê nhà của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630319,
					"content": "Tôi cứ luôn có cảm giác...cho dù thế nào cũng phải về đó xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630320,
					"content": "Nhưng bây giờ việc làm ăn bận bịu, tôi khó lòng trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630321,
					"content": "Với lại tôi cũng không tìm được nhà mạo hiểm có thể hộ tống tôi đến Đảo Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630322,
					"content": "Vì vậy tôi mới nhiều lần treo ủy thác ở Hiệp Hội Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630323,
					"content": "Hi vọng sẽ có nhà mạo hiểm thay tôi đến Đảo Seirai, tìm về nơi trong ba bức tranh đó, rồi dùng \"Máy Ảnh\" chụp lại vài tấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630324,
					"content": "Nhưng đến giờ vẫn chưa có ai nhận ủy thác này, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630325,
					"content": "Hãy giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "Thật, thật không?! Bạn giúp được là quá tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630328,
					"content": "Đừng lo về thù lao, tôi bảo đảm sẽ chuẩn bị đủ cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630329,
					"content": "Vậy thì nhờ bạn nhé. Tính luôn tấm mà bạn mang qua đây, thì tổng cộng có bốn tấm hình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630330,
					"content": "Bạn hãy đến Đảo Seirai, đến bốn địa điểm này và chụp cho tôi một bức ảnh ở từng địa điểm đó nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630326,
					"content": "Tôi có thể giúp bạn đi một chuyến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "Bạn nói đúng rồi đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "Đây là nhà bạn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
