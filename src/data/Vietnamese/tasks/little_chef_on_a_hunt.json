			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "Oa, nhiều vậy sao, một phần dùng để chiên, một phần xào với nấm rơm, còn một ít dùng với Dịch Slime xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000502,
					"content": "Cô ấy chìm đắm rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "Chúng ta bị bỏ quên rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000506,
					"content": "A a, thật ngại quá, cứ bất cẩn là lại nghĩ đến công thức nấu ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000507,
					"content": "Cái này là món ngon đã hứa cho các bạn. Hãy nếm thử xem! Nói cho tôi biết cảm nghĩ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000508,
					"content": "Chúng ta bị coi là người nếm đồ ăn rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000509,
					"content": "Ồ ồ! Cái.. cái này ngon quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000510,
					"content": "Có thể nói cho chúng tôi biết làm như thế nào không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000511,
					"content": "Hì hì, đương nhiên là được! Chỉ là tôi còn chưa ghi ra công thức, để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000512,
					"content": "Hay là như vầy đi! Bây giờ tôi làm lại một lần, các bạn học theo! Xem một lần là hiểu được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "Món phức tạp vậy nhìn một lần cũng không nhớ được... hơn nữa nồi và gia vị cũng không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000514,
					"content": "Ái chà, chuyện này đơn giản thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000515,
					"content": "Nồi thì dùng đá, dầu thì dùng mỡ của heo rừng vừa bắt được, xếp đá thành lò, gỗ và cỏ để mồi lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000516,
					"content": "Đường thì dùng Hoa Ngọt, muối thì, lúc trước tôi tìm thấy rất nhiều muối đá trong một cái động, đủ dùng cho mấy ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000517,
					"content": "Cái này... cũng chuyên nghiệp quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Hì hì, tôi thường không dằn được sở thích thử món mới. Nhưng cũng không thể lúc nào ra ngoài cũng đem theo nồi niêu xong chảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000520,
					"content": "Đợi một chút, bây giờ tôi đi chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000521,
					"content": "Này! Các bạn ở đây làm gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000601,
					"content": "Đây là nơi ở của đám heo rừng, không được phép săn bắn! Đuổi chúng chạy hết thì làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000602,
					"content": "Thợ săn chúng tôi không làm những việc đuổi gà giết chó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000603,
					"content": "A! Tôi hiểu tôi hiểu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000604,
					"content": "Chỉ có trong hoàn cảnh thích hợp mới sinh ra được chất thịt tươi ngon như vậy! Nếu bị dọa chạy mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000605,
					"content": "Không được không được, đây tuyệt đối là tổn thất của giới ẩm thực... không phải, của toàn nhân loại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000606,
					"content": "Thật là một cách lý giải có cá tính.",
