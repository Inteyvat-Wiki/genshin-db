			"dialogs": [
				{
					"id": 110000301,
					"content": "Khẽ một chút, tôi đang đi săn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000302,
					"content": "Sớm đã nghe nói Mondstadt có rất nhiều nguyên liệu tốt, bây giờ xem quả nhiên danh bất hư truyền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000303,
					"content": "Bạn là thợ săn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "Không không không, tôi là đầu bếp, muốn đi khắp mọi nơi, thu thập những nguyên liệu nấu ăn quý hiếm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000306,
					"content": "Mình là Xiangling, đến từ cảng Liyue, còn các bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000307,
					"content": "#Tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "Chào bạn, tôi là Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000309,
					"content": "Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000310,
					"content": "Thế nào rồi? Tại sao đột nhiên nhìn tôi chằm chằm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000311,
					"content": "Một sinh vật rất kỳ diệu, có thể ăn được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000312,
					"content": "Cô ấy là bạn tốt của tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "Thật đáng tiếc, là bạn thì không thể ăn được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000316,
					"content": "Quan hệ của các bạn thật tốt, thực ra tôi cũng có bạn tốt như vậy, tên là Guoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000317,
					"content": "Tên sao cũng là món ăn vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000318,
					"content": "Haha, vì rất đáng yêu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000319,
					"content": "Phải rồi phải rồi, các bạn có thể săn bắt giúp tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000320,
					"content": "Ở đây có rất nhiều thú săn, đều là những nguyên liệu tuyệt hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000321,
					"content": "Một mình tôi không bắt được hết, để chạy mất thì thật đáng tiếc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000322,
					"content": "Nghe có vẻ thật phiền phức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000323,
					"content": "Đừng nói như vậy, lát nữa tặng cho các bạn món ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000324,
					"content": "#Món ngon sao? Nhất ngôn cửu đỉnh, đây là sở trường của {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000325,
					"content": "Một chút lập trường cũng không có...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "Hì hì, đừng để ý đừng để ý, bạn của bạn đã đồng ý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000328,
					"content": "Cách nào cũng được, chỉ cần đem thịt rừng về là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000329,
					"content": "Vậy thì giao cho các bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000326,
					"content": "Đừng bỏ qua ý kiến của tôi chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "Đương nhiên là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "Không được! Paimon không phải để ăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000304,
					"content": "Bạn là Nhà Mạo Hiểm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
