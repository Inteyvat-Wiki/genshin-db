				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "Bang Arataki, ta đến quyết đấu với các ngươi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "Quái Kiệt 33"
				},
				{
					"id": 727320102,
					"content": "Sao thế? Tên Tướng Quân Hanakado đó lại phái một tên nhóc ra xuất chiến à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320103,
					"content": "Chắc không phải do thiếu người quá nên tuyển qua loa đó chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320104,
					"content": "...Không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "Quái Kiệt 33"
				},
				{
					"id": 727320105,
					"content": "Những kẻ ồn ào đa phần đều là tép riu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "Quái Kiệt 33"
				},
				{
					"id": 727320106,
					"content": "#Vị {M#đại ca}{F#đại tỷ} tóc vàng kia rất điềm tĩnh. {M#Anh ta}{F#Cô ta} mới là đại ca của Bang Arataki các ngươi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "Quái Kiệt 33"
				},
				{
					"id": 727320107,
					"content": "#Hihihi, có tầm nhìn đấy! Khen {NICKNAME} thêm mấy câu nữa đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320108,
					"content": "Hả? Ngươi đang nói cái gì vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320109,
					"content": "Bạn thân của ta đúng là mạnh thật, nhưng lần này chỉ là quân viện trợ của Bang Arataki bọn ta! Tên bang phái đã viết rất rõ ràng rồi, đại ca đương nhiên sẽ luôn là Arataki Itto ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320110,
					"content": "Vậy thì tôi thêm biệt danh đằng trước tên là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "Hay đó, thực lực của Bang Arataki thì bỏ qua một bên trước đi, rốt cuộc cảm giác làm đại ca là như thế nào nhỉ? Tôi cũng hơi tò mò đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320113,
					"content": "Nếu anh đồng ý thì tôi có thể đặt tên là \"Paimon Của Bang Arataki (Hết hạn sau 3 ngày)\", hoặc là \"Paimon Bang Arataki - Đại Ca Tạm Thời\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320114,
					"content": "Này này! Hai ngươi đừng để bị đối thủ làm phân tâm! Đối phương rõ ràng là... đang giở trò ly gián đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320115,
					"content": "Đợi khi bổn đại gia đánh thắng đại ca của chúng thì con bé sẽ phải hối hận vì những lời nói này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320116,
					"content": "Bỏ đi... Chuyện nội bộ của Bang Arataki các ngươi thì ta không quan tâm, ta chỉ muốn đấu với một đối thủ lợi hại thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "Quái Kiệt 33"
				},
				{
					"id": 727320117,
					"content": "#Để ta xem bản lĩnh đấu bọ của {M#đại ca}{F#đại tỷ} này trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quái Kiệt 33"
				},
				{
					"id": 727320111,
					"content": "Vị trí lão đại có thể cho tôi mượn vài ngày không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}