			},
			"dialogs": [
				{
					"id": 710610201,
					"content": "Chia năng lượng của \"chất xúc tác\" cho Xamaran.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "Woa, đầu nấm lớn sáng lên rồi! Bây giờ có phải nên gọi là \"đầu nấm huỳnh quang\" không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610203,
					"content": "#Hay lắm {NICKNAME}, hay lắm Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610204,
					"content": "#Nhờ {NICKNAME}, nhờ Paimon, Xamaran đã được sống lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610205,
					"content": "Nhưng đừng lơ là, Xamaran biết, nguồn tà khí vẫn còn đó, và tà khí có thể ập đến quấy rầy bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610206,
					"content": "Haiz, vậy phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Hừ, những thứ bùn đen này ở đâu ra vậy? Đây là \"tà khí\" mà đầu nấm lớn nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#Hay lắm {NICKNAME}, hay lắm Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610302,
					"content": "Tiếng gọi của Xamaran rất lâu vẫn không thấy hồi âm. Chưa kể đến những con nhiều chân và bốn chân, mà hai chân cũng bị tiếng kêu cứu của Xamaran làm cho điếc tai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610303,
					"content": "#Chỉ những người thực sự khôn ngoan mới trả lời được tiếng gọi của Xamaran. Paimon là người khôn ngoan, {NICKNAME} cũng là người khôn ngoan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610304,
					"content": "Người nổi bật nhất trong số hai chân xứng đáng nhận được lời cảm ơn của Xamaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610323,
					"content": "Hừ hừ, không được xem thường Paimon \"khôn ngoan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610305,
					"content": "Chuyện nhỏ như con thỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#Tin rằng một thời gian nữa, {NICKNAME} và Paimon cũng sẽ trở thành sự tồn tại ngang hàng với Xamaran và người cùng tộc của Xamaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610307,
					"content": "Khoan đã, đầu nấm lớn nói vậy là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610308,
					"content": "Nhiều chân không bằng bốn chân, bốn chân không bằng hai chân, đương nhiên hai chân cũng sẽ không bằng không chân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610309,
					"content": "#Mặc dù {NICKNAME} và Paimon bị khiếm khuyết bẩm sinh, nhưng chỉ cần có tâm, những cố gắng sau này cũng chưa chắc không thể thay đổi hướng đi của số phận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610310,
					"content": "Chẳng qua là một cây nấm huỳnh quang thôi mà, có gì mà kiêu ngạo vậy chứ! Không biết nấm huỳnh quang có thể chế biến thành món ăn được không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610311,
					"content": "Xiên Thịt Gà Nấm chắc là ngon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "Nấm đẹp sẽ luôn có độc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "Khẩu vị của Paimon không phải bình thường. Hôm nay ăn nấm, ngày mai ăn nấm, 100 ngày sau sẽ không còn Paimon nữa, mà chỉ còn lại nấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610314,
					"content": "#Hic, {NICKNAME}, đầu nấm lớn nói chuyện đáng sợ quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610315,
					"content": "Ừm, Paimon không biết hài hước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610316,
					"content": "Chẳng hài hước chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610317,
					"content": "Xamaran đã thoát được khỏi tà khí, nhưng những người cùng tộc vẫn đang phải chịu đựng. Xamaran lại không đủ sức để có thể bảo vệ những kẻ yếu như trong quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610318,
					"content": "#Xamaran khẩn xin {NICKNAME} hãy thương xót và cứu lấy những người yếu ớt không thể tự cứu lấy mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610319,
					"content": "#Ý là vẫn còn những cây nấm khác bị bệnh sao? {NICKNAME}, hay là giúp chúng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610320,
					"content": "Đến thì cũng đã đến rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "Cũng đang tiện đường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "Vậy thì mau xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Hừ, những thứ bùn đen này ở đâu ra vậy? Đây là \"tà khí\" mà đầu nấm lớn nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
