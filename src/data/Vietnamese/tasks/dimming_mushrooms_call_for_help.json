				},
				{
					"id": 710610403,
					"content": "Không phải là còn việc gì muốn nhờ vả chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "Nhưng Xamaran không phải người mà là nấm mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "Khả năng nhìn xa trông rộng của hai chân quả thật xứng với danh hiệu người khôn ngoan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610406,
					"content": "Đều là sinh vật hưởng ân huệ từ đất đai, phải giúp đỡ lẫn nhau mới hợp đạo nghĩa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610407,
					"content": "Xin đừng từ chối mà nhận lấy \"chúc phúc của tài năng và trí tuệ\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610408,
					"content": "Nhận được \"chúc phúc của tài năng và trí tuệ\".",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Ối... Đây là thứ gì, trông có vẻ rất đáng nghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610410,
					"content": "Nơi này vẫn còn không ít tà khí bay lượn trong không trung, Xamaran có thể cảm nhận được, nhưng không thể biết được nguồn gốc từ đâu. Lần theo nguồn nước mà tìm hiểu chắc sẽ có phát hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610411,
					"content": "#{NICKNAME} chỉ cần sử dụng \"chúc phúc của tài năng và trí tuệ\" vào nguồn gốc của tà khí, người cùng tộc của Xamaran sẽ tự xử lý vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610412,
					"content": "Nguồn gốc của tà khí... quả thật không thể bỏ mặc không quản.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "...Nói thật chứ, sao không tự mình đi đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME} hài hước hơn Paimon đó. Xamaran không có chân, {NICKNAME} thì có chân, và công việc của người có chân thì phải do người có chân thực hiện chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610415,
					"content": "Hơn nữa Xamaran còn có một sứ mệnh quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610416,
					"content": "Sứ mệnh quan trọng hơn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "#Lần này đã tiêu hao quá nhiều sức lực, nói chuyện với {NICKNAME} và Paimon rất vui, nhưng Xamaran còn phải đi ngủ, lấy sức chống lại tà khí, che chở cho gia tộc và sinh sôi nảy nở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610418,
					"content": "#Chúc phúc cho {NICKNAME}, chúc phúc cho Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610419,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610420,
					"content": "Này, đầu nấm lớn, này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, có vẻ như đầu nấm lớn ngủ rồi, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Hừ, những thứ bùn đen này ở đâu ra vậy? Đây là \"tà khí\" mà đầu nấm lớn nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
