					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610503,
					"content": "Nhưng vết nứt đã được bít lại rồi, bây giờ chắc không có vấn đề gì nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610504,
					"content": "#Hay lắm {NICKNAME}, hay lắm Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610505
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610505,
					"content": "Mong những gì đã qua không phải hối hận, và những gì sắp tới sẽ luôn suôn sẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610506
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610507
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610507,
					"content": "Có vẻ như đầu nấm lớn ngủ rồi, chúng ta đừng quấy rầy nó thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
