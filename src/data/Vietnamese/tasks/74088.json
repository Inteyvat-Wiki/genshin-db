			"dialogs": [
				{
					"id": 740880601,
					"content": "Hừ... Tôi vẫn không quên được cái kiểu vòng vo qua loa của Choiseul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880602,
					"content": "#Cả Raimondo nữa... Ngạo mạn kiêu căng quá chừng, {F#cô}{M#cậu} có để ý ánh mắt khi anh ta nhìn tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880603,
					"content": "#Tôi thấy {F#cô}{M#cậu} tốt hơn họ nhiều. Nếu là {F#cô}{M#cậu} ngồi trên vị trí đó, tuyệt đối sẽ không giống như vậy.",
					"roleType": "TALK_ROLE_NPC",
