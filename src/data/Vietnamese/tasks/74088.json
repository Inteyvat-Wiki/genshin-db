		},
		{
			"id": 7408805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nacker"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "Nơi này vốn dĩ là Viện Ứng Dụng Dây Cót của Butor. Anh Butor là người đứng đầu trong lĩnh vực nghiên cứu máy móc dây cót truyền thống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880502,
					"content": "Nhưng... từ góc độ học thuật, sự phát triển và cải tiến máy móc dây cót truyền thống đã đạt đến giới hạn, trên góc độ ứng dụng thì tương lai của chúng không sáng sủa cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880503,
					"content": "Tóm lại, nghiên cứu của Butor dần dần đi vào bế tắc, không chỉ bị cắt giảm chi phí mà nhân lực cũng không chiêu mộ được nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880504,
					"content": "Cuối cùng, sau một loạt sự cố không may, nhóm nghiên cứu của Butor đã bị tuyên bố giải thể, nơi này cũng dần bị lãng quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880505,
					"content": "Haiz, theo tôi thấy, anh Butor đúng là xui xẻo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
		{
