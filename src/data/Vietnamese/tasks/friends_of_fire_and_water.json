			"dialogs": [
				{
					"id": 751080101,
					"content": "Tuy là phải nấu ăn, nhưng mà chọn món nào mới được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080102,
					"content": "Tôi nhớ trước đây chúng ta từng cho Hải Thú Bồng Bềnh tên \"Nho Bồng Bềnh\" ăn thịt cá. Món cá đó chắc là ngon lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080103,
					"content": "#Phải làm cho cả Hải Thú Bồng Bềnh và {REALNAME[ID(2)|SHOWHOST(true)]} ăn ngon... Tôi thấy món Cá Nướng Sốt Bạc Hà của Natlan không tệ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080104,
					"content": "Cái này thì tôi giỏi lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "Được, vậy bắt đầu làm thôi. Tôi sẽ ở bên cạnh để góp ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080107,
					"content": "Cắt sâu hơn một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "Đúng thế! Cắt sâu một chút mới dễ ngấm vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080111,
					"content": "Mặn mà một chút, ăn vào cũng thấy vui vẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#Ừm, hương vị đậm đà khi vừa vào miệng, Hải Thú Bồng Bềnh và {REALNAME[ID(2)|SHOWHOST(true)]} chắc đều sẽ thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080115,
					"content": "Sốt Bạc Hà, càng nhiều càng ngon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "Cảm giác the mát, chắc chắn sẽ rất tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080119,
					"content": "Ớt thì không thể thiếu được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "Vị cay vừa phải, đủ để khai vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080123,
					"content": "Nướng trên lửa lớn, ngoài giòn trong mềm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "Hihi, trông ngon thật đấy, tôi chảy nước miếng luôn rồi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080127,
					"content": "#Sau quá trình nấu nướng đặc sắc, món cá nướng đặc biệt làm cho Hải Thú Bồng Bềnh và {REALNAME[ID(2)|SHOWHOST(true)]} đã hoàn thành...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "Nướng bằng lửa nhỏ, thơm mềm mọng nước!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#Woa, ngon thật. Cá nướng độc quyền của {NICKNAME}... Nói không chừng sau này có thể trở thành món sở trường để làm cho bạn bè ăn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080121,
					"content": "Sinh vật Fontaine chắc sẽ sợ cay nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "Nhưng mà không cay chút nào thì hình như cứ thiếu thiếu gì đó. Chúng ta cho một ít vào nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080117,
					"content": "Hải Thú Bồng Bềnh dưới nước có sợ Bạc Hà the lạnh không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "Hình như không phải thế đâu. Hải Thú Bồng Bềnh dưới nước mà lên bờ chắc sẽ rất khô rất nóng, thêm một chút sốt Bạc Hà sẽ giúp nó giải nhiệt nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080113,
					"content": "Hương vị vừa phải, không cần thêm muối nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "Đúng đó. Lát nữa còn có gia vị khác nữa, không nhất thiết phải cho nhiều muối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080109,
					"content": "Cắt nông thôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "Cũng không tệ. Vị nhạt một chút thì bên trong thịt cá vẫn còn giữ được hương vị vốn có, Hải Thú Bồng Bềnh sẽ thấy quen hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080105,
					"content": "Tôi không rành lắm, nhưng không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
