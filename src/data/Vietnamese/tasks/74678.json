			"dialogs": [
				{
					"id": 746780101,
					"content": "Tự ý chiến đấu! Bắt lại mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780102
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780102,
					"content": "Phát hiện ra bí cảnh nguy hiểm nhưng không báo lại cho Sảnh Chấp Pháp, mà tự tiện điều tra và sử dụng vũ lực... Anh hơi ngông cuồng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780103,
					"content": "Nhưng... nhưng mà... Thứ nhất, tôi không có tự ý đánh nhau ở Đại Sảnh Fontaine; thứ hai, tôi đánh ma vật mà, như vậy cũng bị bắt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780104
					],
					"speakerTitle": "Costentin"
				},
				{
					"id": 746780104,
					"content": "Vậy anh có phải là thành viên của Hiệp Hội Nhà Mạo Hiểm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780105
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780105,
					"content": "Không... Do sức khỏe của tôi không đủ tiêu chuẩn, nên không được vào hội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780106
					],
					"speakerTitle": "Costentin"
				},
				{
					"id": 746780106,
					"content": "Vậy anh đã báo lại cho Sảnh Chấp Pháp để xin quyền sử dụng vũ khí ở Fontaine chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780107
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780107,
					"content": "Cần phải làm vậy ư? Hóa ra sử dụng vũ khí cũng phải xin phép à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780108
					],
					"speakerTitle": "Costentin"
				},
				{
					"id": 746780108,
					"content": "Chắc chắn rồi! Nếu ai cũng đánh nhau trên đất Fontaine được thì Sảnh Chấp Pháp để trưng cho vui à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780109
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780109,
					"content": "Nếu không xin phép thì coi chừng Robot Hiến Binh sẽ nhận định những người cầm vũ khí như anh là kẻ xâm nhập đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780110
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780110,
					"content": "Trông anh kìa, cứ như giả dạng thành người Fontaine vậy. Bị bắt không oan chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780111
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780111,
					"content": "Tính sai mất rồi! Thân là tác giả mà lại nghiên cứu sai tài liệu, lại còn sai ở chỗ cơ bản nhất... Tôi tắc trách quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780112,
						746780113
					],
					"speakerTitle": "Costentin"
				},
				{
					"id": 746780112,
					"content": "Chúng ta cũng hay điều tra bí cảnh một cách bừa bãi thì phải?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780114
					]
				},
				{
					"id": 746780114,
					"content": "Nhưng chúng ta là nhà mạo hiểm, nên chắc không có vấn đề gì đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746780115,
					"content": "Ồ? Là hai vị sao, người nổi tiếng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780116,
					"content": "Khụ, tôi là Enghiene, đã canh gác bên ngoài lâu năm. Dạo trước trong lúc tuần tra xung quanh đây thì tôi phát hiện ra anh trai lỗ mãng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780117
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780117,
					"content": "Anh ta kể lại hết nguyên nhân tại sao lại ở đây, còn giới thiệu bí cảnh kỳ lạ này nữa. Bảo là hai vị cũng tham gia buổi \"Múa Kiếm\" gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780118
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780118,
					"content": "Ơ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780119,
						746780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746780119,
					"content": "Chúng tôi chơi trong bí cảnh rất vui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780121
					]
				},
				{
					"id": 746780121,
					"content": "Tất nhiên là không rồi. Ngược lại, hai vị là nhà mạo hiểm ưu tú, tôi còn định thưởng thêm cho hai vị một khoản nữa đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780122
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780122,
					"content": "Lần này chúng tôi chỉ khép anh ta vào tội \"sử dụng vũ lực chưa đăng ký\". Sau khi áp giải về thì chỉ khuyên răn bằng lời nói thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780123
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780123,
					"content": "Anh ta không phạm tội lớn, nên đương nhiên không thể trừng phạt nặng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780124
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780124,
					"content": "Dù phải nộp phạt thì tôi cũng chẳng có bao nhiêu Mora đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780125
					],
					"speakerTitle": "Costentin"
				},
				{
					"id": 746780125,
					"content": "Cũng may!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746780126,
					"content": "Tuy Costentin nói chuyện hơi khoa trương, nhưng không phải người xấu... Anh ấy chỉ đam mê những cuộc chiến đấu hoa lệ để viết tiểu thuyết thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746780127,
					"content": "Hai người nổi tiếng này đã xin hộ anh rồi đấy... Lần sau đừng vi phạm nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780128
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780128,
					"content": "Lần sau tôi sẽ chuẩn bị đầy đủ rồi mới đi tìm kiếm tài liệu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780129
					],
					"speakerTitle": "Costentin"
				},
				{
					"id": 746780129,
					"content": "Tôi sẽ làm việc theo quy định, dẫn anh ta về Sảnh Chấp Pháp để khuyên răn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780130
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780130,
					"content": "Một lúc sau, các hiến binh cũng tới đây để dọn dẹp bí cảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780131
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780131,
					"content": "Có điều, có hai vị ở đây rồi thì tòa bí cảnh này cũng không còn nguy hiểm gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780132
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780132,
					"content": "Nếu hai vị có hứng thú thì cứ tiếp tục chiến đấu nhé. Đánh bại thêm nhiều ma vật... cũng coi như giúp các hiến binh đỡ bận rộn hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780133
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 746780133,
					"content": "Vậy là chúng ta đã trở thành người tốt và dũng cảm rồi, lại lấy được thưởng từ tác giả và cả Sảnh Chấp Pháp nữa... Coi như không uổng công nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746780120,
					"content": "Cô định bắt cả hai chúng tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780121
					]
				},
				{
					"id": 746780113,
					"content": "Hình như chúng ta cũng chưa xin phép đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780114
					]
				}
			]
		}
	]
}