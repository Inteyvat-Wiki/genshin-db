				{
					"id": 722391903,
					"content": "...Đã lâu rồi không nghe được câu này, ta cũng gần như quên mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "Nói ta nghe, đồng chí, ai phái ngươi đến?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "Thầy Spartacus?! Là thầy sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "Ông ấy đang ở đâu? Ta chỉ biết ông ấy đã bị Người Con Của Mặt Trời bắt đi trong lúc loạn lạc. Sau đó đã không còn tin tức của ông ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "Ông ấy bị nhốt trong tế đàn ở Trái Tim Mãng Xà... với tình trạng của ông ấy e rằng không thoát ra được, cho nên nhờ chúng tôi đến tìm mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "Người Con Của Mặt Trời, đáng chết",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "Thầy giáo phái hai người đến có căn dặn gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "Ông chú đó có nhờ chúng tôi chuyển vài lời, ông ấy nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "Các con, đừng bao giờ bỏ cuộc, niềm hy vọng của Vương Quốc Đêm Trắng nằm trong tay các con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391914,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391915,
					"content": "Xin lỗi... thầy ơi, chúng con đã khiến thầy thất vọng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391916,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "Quân Kháng Chiến đã không còn tồn tại nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "Sau khi thầy bị bắt đi, Quân Kháng Chiến trên cơ bản đã bị tiêu diệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "Chỉ còn lại những học trò thường ngày đi theo thầy, vì cách xa nơi xảy ra chuyện nên mới thoát nạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "Sau đó những người may mắn thoát được đã chạy đến nơi ẩn mình đã chuẩn bị trước đó, hy vọng có thể tập trung lại lực lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "Trong chúng tôi vốn có mưu sĩ kiệt xuất, học giả chuyên nghiệp, thuật sĩ ưu tú, còn có bác sĩ đáng tin cậy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "Nghe có vẻ như rất có hy vọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "Chúng tôi cũng nghĩ như thế, chỉ cần cho chúng tôi thời gian thì chúng tôi nhất định sẽ tổ chức lại lực lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "Nhưng mà cần phải có tiền... mở rộng bất cứ hoạt động gì cũng cần phải có tiền, chúng tôi cái gì cũng có, chỉ là không có tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "Sau đó có người đề ra một ý kiến, là buôn lậu Ngọc Long Cốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "Ngọc Long Cốt là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "Là một loại quả mọc từ Hoa Long Cốt trong tình trạng đặc biệt, rất hiếm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "Nó sẽ tạo ra một hương thơm sảng khoái, giúp thư giãn tâm trí, xoa dịu nỗi lo lắng và những ưu sầu sẽ được xóa bỏ. Vì vậy nó có giá trị rất cao trên thị trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "Thần kỳ vậy sao? Có nói quá không đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "Nếu như thần kỳ như vậy là tốt rồi... Tôi ngu dốt, ban đầu không nhìn thấu được sự nguy hiểm bên trong nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "Tôi đã quên mất công thức từ đâu mà có rồi, chỉ biết là, thứ này đúng là đã mang đến cho chúng tôi rất nhiều tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "Mọi thứ đang diễn ra theo chiều hướng tốt... nhưng dần dần, tôi phát hiện ra một số chiến hữu của mình bắt đầu né tránh xung đột và từ chối chiến đấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "Những người này ngày càng nhiều hơn, đến cuối cùng, họ thậm chí còn xin tôi cho rời đội, và tôi cũng không thể giữ họ lại được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "Sao lại như vậy? Có phải vì bán ngọc kiếm được quá nhiều tiền, nên không muốn đánh trận nữa không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "Bạn đang nói về sự cám dỗ của tiền bạc sao? Không...tôi...tôi không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "Tôi chỉ biết, khi những người không cam chịu áp bức trở nên thỏa mãn, thì sẽ không thể tiếp tục kháng chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "Sự sụp đổ từ đó bắt đầu, và không còn gì cứu vãn được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "Có lúc tôi còn nghĩ, cái loại công thức này, liệu có phải do đám đại nhân bỉ ổi đó cố ý lưu truyền cho chúng tôi không nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "Thứ này bán chạy như vậy, liệu có phải cũng là sự giả dối do những kẻ thống trị hèn hạ kia tạo ra không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "Haiz, nếu là thầy thì thầy sẽ xử lý cục diện này như thế nào đây, thầy có phải sẽ ngăn chặn tất cả ngay từ khi bắt đầu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "Xin lỗi thầy, chúng con đã không thể trở thành niềm hy vọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "Thật đáng tiếc khi nghe thấy tin này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "Tôi đã không còn mặt mũi đi gặp ông ấy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391942,
					"content": "Dù cho thế nào đi nữa, cảm ơn bạn đã mang tin tức của thầy giáo đến cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391943,
					"content": "Tôi không có thứ gì để cảm tạ, nếu không phiền thì tôi sẽ nói bí mật của Ngọc Long Cốt cho bạn nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391944,
					"content": "Điều kiện đặc biệt để sản xuất nó chính là phải tưới nước của Tokoyo Reisen vào Hoa Long Cốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391945,
					"content": "Các bạn có thể mang đi đổi lấy tiền vàng, hoặc giữ cho riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391946,
					"content": "Nhưng dù thế nào, hy vọng mọi người vẫn giữ được trái tim hướng về phía trước của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391940,
					"content": "Anh có muốn đi gặp lại thầy mình không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722392401,
					"content": "(Chữ trên bia mộ được chia làm hai hàng, trong đó, hàng đầu tiên được viết bằng chữ của Vương Quốc Đêm Trắng, không thể đọc được.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "Bia Đá Cổ"
				},
				{
					"id": 722392402,
					"content": "(Hàng thứ hai là ngôn ngữ thông dụng, bên trên viết:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "Bia Đá Cổ"
				},
				{
					"id": 722392403,
					"content": "\"Nghĩa sĩ Spartacus, hiện được gọi là Supada no Hiko. Bên dưới là bản dịch tội ác của hắn. Hãy đọc và ghi nhớ đoạn lịch sử này.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "Bia Đá Cổ"
				},
				{
					"id": 722392404,
					"content": "\"Kẻ trộm Supada no Hiko, bậc thầy của tội lỗi, chủ mưu của những tội ác lớn và là căn nguyên của tình trạng bất ổn. Giờ đây, nhân danh Tokoyo Ookami, móc mắt hắn, nghiền nát linh hồn của hắn, tống vào ngục sâu, bây giờ và mãi mãi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bia Đá Cổ"
				}
			]
		}
	]
}