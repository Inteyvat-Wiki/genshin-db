			"dialogs": [
				{
					"id": 722390301,
					"content": "Các cháu... các cháu là ai? Giọng của các cháu nghe rất quen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390302,
					"content": "Hả? Quên nhanh vậy sao... Tình trạng của ông chú tệ vậy rồi sao? Thật là đáng lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390303,
					"content": "Cảm ơn, chúng ta từng quen biết thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390304,
					"content": "Chúng ta vừa mới gặp nhau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "À, ta nhớ ra rồi... linh hồn ở đây sẽ bị hao mòn, trí nhớ của ta suy giảm quá nghiêm trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390307,
					"content": "Xin lỗi, ta...haiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390308,
					"content": "Các cháu tìm được thông tin gì hữu ích không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390309,
					"content": "Tên của chú là Supada no Hiko đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "Supada no Hiko... Supada no Hiko, đúng rồi! Ta là thủ lĩnh của quân kháng chiến, Spartacus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390313,
					"content": "Vậy là cả hai đều là tên của chú đúng không? Không hổ danh là thủ lĩnh, đến tên cũng có hai cái nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390314,
					"content": "Cảm ơn các cháu đã tìm lại tên cho ta, hình như ta nhớ được thêm chút gì đó rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390316,
					"content": "\"Bóng tối đến phía sau mặt trời, ánh sáng ẩn giấu giữa chúng ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390317,
					"content": "Đây là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "Đây là khẩu lệnh bí mật của quân kháng chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390319,
					"content": "Tìm được tên, trí nhớ cũng dần quay lại. Đây có lẽ là ám hiệu của quân kháng chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390320,
					"content": "Bây giờ ta sẽ nói cho cháu biết nơi ẩn náu của bọn trẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390321,
					"content": "Có việc gì cần cháu chuyển lời không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "Để ta nghĩ xem, để ta nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390323,
					"content": "Hãy chuyển lời của ta đến chúng, nói với chúng đừng bao giờ từ bỏ, hy vọng của Vương Quốc Đêm Trắng đều nằm trong tay chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390324,
					"content": "Chú có muốn cháu đưa họ về không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "Đừng, đừng bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390326,
					"content": "Ưu thế duy nhất của ta là địch ở ngoài sáng ta ở trong tối, và tất cả người dân của Vương Quốc Đêm Trắng đều đồng lòng với ta. Đừng để bị bại lộ trước bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390327,
					"content": "Huống hồ, bây giờ ta không còn nhớ được tên của từng đứa nữa. Thậm chí tên của mình ta cũng đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390328,
					"content": "Chuyển lời giúp ta, nói với chúng đừng bao giờ từ bỏ, hy vọng của Vương Quốc Đêm Trắng nằm trong tay chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390329,
					"content": "Nếu họ không còn nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "Không đâu. Chỉ cần những tên bẩn thỉu thao túng Người Con Của Mặt Trời còn đó, chúng cũng sẽ còn đó. Và kháng chiến vẫn sẽ tiếp tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390331,
					"content": "Chuyển lời của ta đến chúng, nói với chúng đừng bao giờ từ bỏ, hy vọng của Vương Quốc Đêm Trắng nằm trong tay chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390332,
					"content": "Như vậy là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390310,
					"content": "Tên của chú là Supada Trộm Cướp đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "Ôi, không phải, là Supada no Hiko!",
