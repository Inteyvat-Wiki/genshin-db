			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Supada no Hiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "Các con, đừng bao giờ từ bỏ, hy vọng nằm ở chỗ các con đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390102,
					"content": "Là các con sao? Các con ơi, các con thành công rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390103,
					"content": "Không, không phải...Ta cảm nhận được rồi, các ngươi không phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}, hình như ông ấy là người sau khi bị mù mới bị lưu lại ảo ảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390105,
					"content": "Ai cũng được, hãy giúp ta! Giúp ta tìm các con, ta có lời muốn nói với chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390106,
					"content": "Nhưng mà, ông là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "Ta...Ta là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390108,
					"content": "Ta... quên tên của mình rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390109,
					"content": "Ta nhớ... ta từng đứng lên vì Vương Quốc Đêm Trắng, từng chiến đấu vì hy vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390110,
					"content": "Đến bây giờ ta vẫn là quân kháng chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390111,
					"content": "Nhưng ở một vương quốc dưới lòng đất như Vương Quốc Đêm Trắng thì ông chống lại cái gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390112,
					"content": "Đương nhiên là những tên quý tộc bẩn thỉu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390113,
					"content": "Bọn họ tự xưng là tiếp nhận ý chỉ của thần, miệng lúc nào cũng nói đến thần, nhưng những chuyện bọn họ làm chỉ là để thỏa mãn những ham muốn thấp kém của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390114,
					"content": "Bề ngoài họ là những người bảo vệ Người Con Của Mặt Trời, nhưng thực chất họ là người cai trị đất nước, bản chất của họ là những con sâu hút máu người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390115,
					"content": "Bọn họ phải bị tiêu diệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390116,
					"content": "Những thứ này thì nhớ rất rõ, nhưng lại quên mất tên mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390117,
					"content": "Là vì thủ đoạn của bọn họ quá tàn nhẫn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390118,
					"content": "Bởi vì thất bại lần trước, bọn họ đã bắt được ta, và nhốt ta ở tế đàn này để giày vò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390119,
					"content": "Đây là một nhà tù ác độc, ta có thể cảm nhận được, linh hồn của ta bị băm nát, và những thứ quý giá đang mất dần đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390120,
					"content": "Người lương thiện, ta xin ngươi, nhân lúc ta còn nhớ được, hãy giúp ta tìm các con!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390121,
					"content": "Nói cho chúng biết, đừng bao giờ từ bỏ, mọi hy vọng đều nằm ở chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390122,
					"content": "Các con?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "Có một nhóm thanh niên đồng ý đi theo ta, chúng rất thông minh. Chúng là học sinh của ta, cũng là quân dự bị của ta. Ta xem chúng như con của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390124,
					"content": "Bọn đại nhân ác độc kia dùng mọi cách để cạy miệng ta, bắt ta khai ra bọn trẻ, nhưng ta không thể nói ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390125,
					"content": "Bởi vì ta biết, hy vọng nằm ở chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390126,
					"content": "Bây giờ chắc họ cũng không còn nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390127,
					"content": "Không, không đâu! Chúng đều là những đứa trẻ ngoan và có lý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390128,
					"content": "Ta vẫn chưa từ bỏ...chắc chắn chúng vẫn đang kiên trì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390129,
					"content": "Phải làm sao để tìm được họ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "Ta phải nhớ được, ta phải nhớ được chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390131,
					"content": "Ta sẽ nói cho ngươi biết nơi ẩn náu của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390132,
					"content": "Nhưng nếu tìm được họ thì phải nói thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390133,
					"content": "\"Chúng tôi được một ông chú thuộc quân kháng chiến quên tên cử đến\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390134,
					"content": "Không, như vậy chưa đủ, ta đã dạy dỗ chúng rất tốt. Trừ khi các ngươi có thể chứng minh bản thân, nếu không chúng tuyệt đối sẽ không tin các ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390135,
					"content": "Nhưng bây giờ cả tên mình ta cũng không nhớ nổi, thật đáng ghét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390136,
					"content": "#{NICKNAME}, xem ra ông chú này từng là trọng phạm của Vương Quốc Đêm Trắng. Nói cách khác, là một người có thể được lưu tên trong sử sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390137,
					"content": "Manh mối của chú ấy có lẽ không khó tìm, nói không chừng ở gần đây thôi. Chúng ta thử tìm xem.",
					"roleType": "TALK_ROLE_NPC",
