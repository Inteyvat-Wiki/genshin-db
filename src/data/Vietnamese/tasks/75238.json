			"dialogs": [
				{
					"id": 752380101,
					"content": "Trà có vừa miệng không? Hay tôi nên chuẩn bị rượu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380102,
					"content": "Không cần đâu, trà cũng được mà. Uống rượu ban ngày thì hơi tội lỗi quá, nên hạn chế lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380103,
					"content": "Nhưng mà tiểu thư Guillotin, sao lại đến tận Natlan thế này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380104,
					"content": "Chỉ là đi đây đi đó, thăm những người bạn cũ thôi. Tôi cũng muốn cảm ơn cô đã sẵn lòng nhận công việc đó trong thời gian diễn ra Lễ Hội Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380105,
					"content": "Cô khách sáo quá rồi, chỉ vì chuyện đó mà đến đây một chuyến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380106,
					"content": "Ngoài ra, tuy lần trước cô không nói, nhưng tôi biết mình đã từng gây phiền phức cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380107,
					"content": "À... Chuyện cấp dưới của cô à. Cái lần liên quan đến cô robot tên Ineffa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380108,
					"content": "Ha... Đây chẳng phải là điều kỳ diệu của cuộc sống sao? Cấp trên của kẻ địch cũ có thể trở thành đồng đội, hoặc thậm chí là cấp trên của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380109,
					"content": "Mong cô sẽ nhận những thứ này. Là chút tâm ý của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380110,
					"content": "Đây... Đây là... tiểu thuyết bản giới hạn, à không, bản sưu tầm ư?! Mà còn đúng thể loại tôi thích nữa chứ? Sao... sao cô biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380111,
					"content": "#Tôi đã hỏi thăm {NICKNAME} về những thứ mà cô thích, rồi nghe theo ý kiến của {M#cậu}{F#cô} ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME}...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380113,
					"content": "(Đáng ghét...! Sao lại vừa vui vừa khó chịu thế này chứ?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380114,
					"content": "#(Tuy mình vui vì {M#cậu ấy}{F#cô ấy} hiểu mình thích gì, nhưng đừng tùy tiện nói cho người khác, mà nên tự tay tặng mới phải chứ!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380115,
					"content": "Cô có thích không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380116,
					"content": "À... Cảm ơn cô. Tiểu thư Guillotin khách sáo quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380117,
					"content": "#Nếu thích thì lần sau tôi sẽ mang thêm cho cô. Tất nhiên, lúc đó chắc lại phải phiền {NICKNAME} cùng đi chọn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380118,
					"content": "Cùng đi?! Hai người đã cùng đi... tiệm sách để chọn sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380119,
					"content": "#Ừm, {M#cậu ấy}{F#cô ấy} đã rất nghiêm túc khi chọn cuốn này cho cô đấy. Lần sau có lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380120,
					"content": "Không được có lần sau nữa!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380121,
					"content": "Hả... Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
