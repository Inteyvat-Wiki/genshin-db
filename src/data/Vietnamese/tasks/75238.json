			"dialogs": [
				{
					"id": 752380201,
					"content": "#Hừ... Để xem lần sau tôi xử lý {M#cậu ấy}{F#cô ấy} thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380202,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 752380204,
					"content": "Đã muộn thế rồi sao? Được rồi, cô Guillotin đi về cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380203,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Sandrone"
				}
			]
