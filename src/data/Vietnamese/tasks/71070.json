						710701906
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701906,
					"content": "Ui da, đau quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701907,
					"content": "Không làm phiền anh nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701908
					]
				},
				{
					"id": 710701908,
					"content": "Chậc... phù... sao thuốc này không có tác dụng vậy... A, đi thong thả, có chuyện gì mới nhớ nói tôi nghe nha!",
