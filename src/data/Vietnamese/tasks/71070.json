			"dialogs": [
				{
					"id": 710702701,
					"content": "Quả thật xin lỗi... Lúc trước do tôi bướng bỉnh, đã gây phiền phức cho tiền bối rồi.",
					"roleType": "TALK_ROLE_NPC",
