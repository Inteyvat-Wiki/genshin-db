	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "A, xin chào. Cảm ơn mọi người đã giúp tôi khai thông đường xá, Zhiqiong vì muốn mở đường cho chúng tôi cũng đã giúp đỡ không ít. Thành thật cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "Về doanh trại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "Thế nào, không tệ chứ? Nghề của nàng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "Tôi từ lúc mười mấy tuổi đã bắt đầu đi theo cha để học cách làm doanh trại, cách làm Đèn Tinh Thạch, cách làm công cụ bảo trì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "Sau này cha tôi già, mắt không còn sáng nữa, cho nên thiết bị an toàn của hầm mỏ đã chuyển cho tôi bảo trì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "Rồi sau đó nữa, tôi thấy... tôi cũng không còn trẻ nữa... có chồng thì chồng cũng không còn, có con gái thì nó cũng đến Sumeru để học...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "Đôi lúc, đàn ông trong hầm mỏ ra đi sớm, những đứa con mà họ để lại sẽ do tôi chăm sóc... cho nên tôi thường hay mang theo đồ ngọt trên người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "Trong ấn tượng của tôi thì trẻ con luôn có mùi ngọt ngọt, mắt ngơ ngác đứng trên đất đợi kẹo hoặc những viên đá xinh xắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "À ừm... vậy thì giờ Jinwu cũng đang mang theo kẹo đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "Kẹo sao? Những loại kẹo sặc sỡ trong thành thì không có rồi, nhưng chắc bạn không chê đường miếng đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "Thì ra là loại kẹo này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "Người bên cạnh đi đi về về, chỉ để lại nhung nhớ, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "Về Zhiqiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhiqiong thuộc thế hệ trẻ, xuất thân từ Minh Ôn Trấn. Thực ra những thợ mỏ có kinh nghiệm trong Vực Đá Sâu đều xuất thân từ Minh Ôn Trấn cả... Zhiqiong không nằm trong thế hệ vàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "À... đừng hiểu lầm, ý tôi không phải nói là bây giờ không tốt. Chỉ là vài năm trước Minh Ôn Trấn do cạn kiệt khoáng sản nên đã ngừng khai thác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "Zhiqiong sau này đến Vực Đá Sâu, Vực Đá Sâu cũng ngừng khai thác... đứa nhỏ này có lẽ không thích hợp để làm thợ mỏ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "Này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "Sau đó à, mọi người đều tự tìm đường sống riêng, tôi tiếp tục ở lại hầm mỏ, số thiết bị còn để lại sau khi sơ tán vẫn cần phải bảo dưỡng mà. Cô ấy thì đi làm nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "Đứa trẻ này cứ mãi không trưởng thành, không biết yêu thương bản thân. Có lẽ ngày tháng làm việc ở dưới này quá ít rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "Nếu cô ấy có thể quen với cuộc sống của thợ mỏ, nếu cô ấy cũng dùng đôi tay của mình cứu giúp những người lâm vào cảnh nguy hiểm... Chắc sẽ có nhận thức sâu sắc hơn về cuộc sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "Tuy là một yêu cầu chả ra làm sao cả... Nhưng tôi hy vọng bạn có thể để mắt đến cô ấy nhiều hơn, đừng để cô ấy hại chết chính bản thân cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Ừm, bảo trọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
