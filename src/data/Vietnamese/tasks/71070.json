						710702702
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702702,
					"content": "Sau này tôi sẽ tiếp tục vẽ chi tiết hóa các bản đồ đã có, và giúp đỡ chị Jinwu bố trí đèn hiệu, giám sát tình hình hoạt động của những vật chất đen đúa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702703
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702703,
					"content": "Những thứ đó... nghe họ nói rất có thể có liên quan đến tai họa đen tối của 500 năm trước. Chỉ không biết đây là tàn dư của quá khứ, hay là điềm báo lịch sử lặp lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702704
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702704,
					"content": "Bất luận thế nào, cũng rất cảm ơn tiền bối đã giúp tôi biết được đâu là giới hạn của người thường, và cả... làm thế nào để tìm thấy ý nghĩa của bản thân trong giới hạn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702705
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702705,
					"content": "Wa... sao đột nhiên Zhiqiong nói chuyện giống như một nhà triết học vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710702706,
					"content": "Tôi chưa từng nghĩ nhiều như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702707
					]
				},
				{
					"id": 710702707,
					"content": "Chỉ là tiền bối quả thật đã giúp tôi rất nhiều, so ra thì... ngay cả việc vẽ bản đồ mà tôi cũng luôn phiền tiền bối giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702708
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702708,
					"content": "Huống hồ chi khi đối mặt với hiểm nguy, thì luôn làm liên lụy đến các tiền bối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702709,
						710702710
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702709,
					"content": "Tôi chỉ quan tâm đến an nguy của bạn thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				},
				{
					"id": 710702711,
					"content": "Ừm... Tôi cũng sẽ không bỏ cuộc đâu, chờ nghỉ ngơi xong rồi chúng ta sẽ lại xuất phát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702710,
					"content": "Không sao, hy vọng bạn có thể hoàn thành bản đồ.",
