			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "Xin chào! Hành trình của bạn thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701702,
					"content": "Vẫn ổn, anh dạo này thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Cảm ơn bạn đã cho tôi cơ hội, từ sau vụ đó thì mọi người đã đồng ý cho tôi ở lại đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701704,
					"content": "Còn việc khi lên lại trên kia sẽ có dự định gì thì... Haha, tôi vẫn chưa nghĩ ra! Nhưng có lẽ sẽ không làm Đạo Bảo Đoàn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701705,
					"content": "Có lẽ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "Chắc chắn sẽ không, chắc chắn sẽ không mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701708,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "Bảo trọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701706,
					"content": "Thật sao...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "Cái tên này... ơ... ủa? A, xin chào. Xin lỗi, bạn làm phiền tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701802,
					"content": "Vậy xem như huề nha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "Thôi được rồi, không đùa nữa. Bây giờ tình hình không ổn lắm, bạn biết không? Rất không ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701805,
					"content": "Bạn cũng thấy miếng tinh thạch phát sáng đó mà đúng không? Theo tôi đoán thì ở sâu dưới kia sẽ còn một miếng to hơn nữa... tôi nghĩ bạn cũng đã sớm đoán ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701806,
					"content": "Theo lý thuyết, khi những mảnh vỡ đó \"trở về\", thì chỉ số năng lượng sẽ có xu thế ổn định... Ừm, thực tế cũng là vậy. Nhưng mà... đường sóng hoàn toàn không đúng... hoàn toàn không đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701807,
					"content": "Anh đang nói gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "Chẳng chịu học hành tử tế, hừm. Được thôi... Nói đơn giản là, chúng ta đang đối mặt với cuộc chiến của hai nguồn sức mạnh to lớn, giống như hạt đậu trên cối nghiền vậy đó, hiểu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701810,
					"content": "Nhìn từ góc độ thước đo thời gian, thì chúng ta đang bị hai nguồn sức mạnh bên trên và bên dưới nghiền nát nhanh chóng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701811,
					"content": "Nếu không tin thì cứ chờ đi, nhà mạo hiểm có tên Zhiqiong... người mà tôi thấy đã từng tiếp xúc gần với thứ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701812,
					"content": "Hôm nay cô ấy ho ra máu, ngày mai có thể sẽ ho văng cả phổi ra đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701813,
					"content": "Tôi có thể giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "Bạn? Ừm... Để tôi nghĩ xem, để tôi nghĩ xem... cho tôi chút thời gian, nhất định sẽ có cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701815,
					"content": "Nhưng mà hiện tại, việc quan trọng nhất của chúng ta là cần bạn tiếp tục điều tra, xem rốt cuộc đã xảy ra chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701816,
					"content": "Yên tâm đi, tôi sẽ không bỏ mặc chuyện nghiêm trọng như thế đâu... Tôi là người chịu trách nhiệm an toàn cho đội thăm dò mà, không thể để phung phí tiền của mình được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701817,
					"content": "Vậy anh có chịu trách nhiệm cho sự an toàn của tôi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "Ừm... Không thể không thừa nhận, năng lực của bạn vượt ngoài dự tính của tôi, cho nên... nếu bạn đã dư sức chịu trách nhiệm cho bản thân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701819,
					"content": "Haiz, thôi, đừng nói mấy câu khó xử đó nữa... Nếu bạn gặp chuyện gì bất trắc thì tôi sẽ bồi thường, được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701808,
					"content": "Nói tiếng gì tôi nghe hiểu được đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
