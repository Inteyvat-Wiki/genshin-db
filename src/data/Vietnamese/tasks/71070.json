						710701903
					]
				},
				{
					"id": 710701903,
					"content": "Tôi là nhà thơ thuộc trường phái cũ, tất nhiên đến đây là để tìm cảm hứng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710701904,
					"content": "Wa... rõ ràng lúc nãy rất phấn chấn, sao giờ nhìn bộ dạng như sắp chết vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710701905,
					"content": "Tôi chưa từng xuống hầm mỏ... hơn nữa... lúc đến do vội vàng quá, nên... hơi bị chuột rút rồi.",
					"roleType": "TALK_ROLE_NPC",
