			"dialogs": [
				{
					"id": 400030201,
					"content": "Các người... Ồ, phải rồi, là hai vị hôm qua đến cảnh báo nguy hiểm",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030202,
					"content": "Haizz... Không dám giấu diếm, trong thời gian diễn ra Tết Hải Đăng, tổng vụ công vụ bộn bề, tạm thời chưa điều người đi điều tra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030203,
					"content": "Hả? Sao lại như thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030204,
					"content": "Thực sự xin lỗi, hiếm có dịp các bạn nhiệt tình như vậy...để tôi nghĩ...có lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030205,
					"content": "Có lẽ chúng tôi có một phân đội nhỏ sẽ giúp ích được. Hôm nay nhiệm vụ của họ chỉ còn một thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030206,
					"content": "Họ đang dọn dẹp lũ quái vật trên Quy Li Nguyên, nếu các bạn có thể liên lạc với họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
