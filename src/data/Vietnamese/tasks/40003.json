						400030903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030903,
					"content": "#{NICKNAME}, phải làm sao đây, người này có vẻ khó tiếp cận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030904,
					"content": "Hả. Cảm...cảm giác không phải người tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030905,
					"content": "Không được dựa vào cảm giác chủ quan, \"tốt xấu\" không thể tùy tiện nói ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030906
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030906,
					"content": "Tuy nhiên, tôi thực sự là một ác quỷ. Tôi là hộ pháp dạ xoa - Xiao, người tiêu diệt ma quái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030908,
					"content": "Từ này dường như từng nghe qua đâu đó rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030909,
					"content": "Paimon biết \"Dạ Xoa\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030907,
					"content": "Hộ Pháp Dạ Xoa...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030908,
						400030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030910,
					"content": "Đúng, đúng rồi... Trước kia nghe người dân Liyue kể rằng... Dạ Xoa là tiên nhân bảo hộ Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030911,
					"content": "Bảo vệ thế giới con người trong im lặng, giúp người trừ yêu diệt ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030912,
					"content": "Về căn bản không phải là người tốt sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030913,
					"content": "...Không đúng. \"Hộ pháp\" của Dạ Xoa, không phải xuất phát từ lòng tốt với con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030914
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030914,
					"content": "Í... Thế nhưng Tết Hải Đăng rõ ràng là kỷ niệm anh hùng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030915,
					"content": "Những vị anh hùng từng bảo vệ Liyue trong lịch sử, hiếm hoi lắm mới cóc một người sống sót đến tận bây giờ, lại từ chối nhận mối chân tình ngày Tết tôn vinh bản thân sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030916,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030917
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030917,
					"content": "Ngài Xiao... Khụ, Thượng tiên Xiao...? Vì sao ngài không trực tiếp khống chế kẻ khả nghỉ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030918,
					"content": "Cứ tưởng là yêu vật làm trò, tôi mới qua đây xem xét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030919,
					"content": "Nếu như trong thế giới tiên và ma này, có thứ gì thoát ra khỏi quy luật, thì đó là trách nghiệm của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030920,
					"content": "Thế nhưng mối đe dọa lần này đến từ thế giới loài người, thế giới của các bạn, vì vậy trách nghiệm này là của bạn, lữ khách loài người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030921
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030921,
					"content": "Đến lúc cần thiết... Hy vọng bạn tự giác chút ít, ra tay quyết đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030922
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030922,
					"content": "Không được để tấm vải của ngọn thương trừ yêu nhuốm máu trần gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030923
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030923,
					"content": "Đây chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030925,
					"content": "Paimon có biết không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030926
					]
				},
				{
					"id": 400030924,
					"content": "Là ký hiệu mà người đó để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030925
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030926,
					"content": "Không có ấn tượng gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030927,
					"content": "Vậy thì hãy cố gắng cho ta xem, các bạn có thể làm đến đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030929,
					"content": "Màu sắc đó cũng khá tươi vui mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030930
					]
				},
				{
					"id": 400030928,
					"content": "Nếu như là tôi, có lẽ Tết Hải Đăng sẽ bị nhuộm đỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030929
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030930,
					"content": "Nghe mà rùng cả mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030931,
					"content": "Ê, bạn đừng manh động vậy. Đợi chúng ta hỏi rõ thông tin của những dấu hiệu này rồi hãy tính.",
					"roleType": "TALK_ROLE_NPC",
