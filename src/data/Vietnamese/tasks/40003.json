			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "Đã xong, dấu vết đám quái vật ở đây đã điều tra, có thể quay trở về được rồi——Hử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030402,
					"content": "Các người là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030403,
					"content": "Là Jiayi bảo tôi đến tìm bạn, anh ấy nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030404,
					"content": "Thì ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030405,
					"content": "Các ơn các bạn đã giúp đỡ công việc của tổng vụ, tôi đã ghi chép lại về sự việc này, sau đó sẽ bắt đầu điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030406,
					"content": "Vậy thì nếu có cơ hội hẹn gặp lại ở Liyue, Nhà Lữ Hành nhiệt tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}, bạn có thấy rằng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030408,
					"content": "Thái độ của tổng vụ dường như không để ý lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "Tôi cũng cảm thấy vậy Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030410,
					"content": "Người bản địa có lẽ đã ăn chán mấy món ngon đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030411,
					"content": "Thế nhưng với Nhà Lữ Hành phải lưu lạc nơi đồng hoang, lúc khó khăn nhất chỉ có thể ăn nấm dại để sống qua ngày thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030412,
					"content": "Đối với bạn mà nói, Tết Hải Đăng có Ý- Nghĩa-Vô-Cùng-Lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030416,
					"content": "Vậy thì chúng ta quay lại điểm ngày hôm qua điều tra thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030417,
					"content": "Theo lời ông lão bắt trộm, lũ tội phạm thích quay lại hiện trường vụ án. Tâm lý của kẻ phạm tội là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030418,
					"content": "Nhưng chưa xảy ra \"vụ án\" mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "Vì vậy phải khẩn trương lên thôi, nếu những vật phẩm dễ cháy này bị làm sao thì đã quá muộn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030413,
					"content": "Vẫn phải dựa vào sức lực của chúng ta vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "Tôi cũng nghĩ thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030415,
					"content": "Theo kinh nghiệm, sự việc này phụ trách đến cùng vẫn tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
