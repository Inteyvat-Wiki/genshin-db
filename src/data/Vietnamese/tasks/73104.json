				{
					"id": 731041212,
					"content": "Này! Tôi luôn nghiêm túc câu cá đấy, chứ không phải đi câu đồ cổ đâu nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041213
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041213,
					"content": "Hơn nữa dù kỹ thuật câu của tôi không giỏi, ném câu cũng không có sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041214
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041214,
					"content": "Nhưng tôi đã thả câu nhiều như thế rồi, dù là ăn may đi nữa thì ít nhiều gì cũng nên câu được vài con cá chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041215
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041215,
					"content": "Đến bây giờ tôi vẫn không câu được con cá nào hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041216
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041216,
					"content": "Ừm... Kể ra đúng là hơi lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041217,
					"content": "À thì... Anh Kayvan, nếu như anh có hứng thú thì tôi có thể giới thiệu anh với một vị học giả nghiên cứu câu cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041218
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041218,
					"content": "Các loại mồi câu và cần câu thịnh hành trên thị trường hiện tại đều được người đó tham gia thiết kế đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041219
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041219,
					"content": "Tuy không biết nguyên nhân tại sao anh không câu được cá, nhưng mà... đi tìm người khác để hỏi thử cũng được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041220
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041220,
					"content": "Nói không chừng, vị học giả kia cũng sẽ có hứng thú với anh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "Thấy hứng thú với tôi? Ý cô là thấy hứng thú với đặc điểm \"không câu được cá\" của tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041222
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041222,
					"content": "Nhưng cô nói cũng đúng, tôi cũng có thể nhân cơ hội này xem thử rốt cuộc kỹ thuật câu của tôi có vấn đề ở điểm nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041223
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041223,
					"content": "Không thành vấn đề, chuyện giới thiệu cứ giao cho tôi là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041224
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041224,
					"content": "Nhưng các học giả chỉ biết ngồi trong phòng đọc sách thật sự có hiểu biết về câu cá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041225
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041225,
					"content": "À... Đúng rồi! Còn phải cám ơn sự giúp đỡ của bạn nữa. Nhà Lữ Hành, đây là thù lao của bạn, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041211,
					"content": "Có lẽ đây chính là một trong số các tuyệt chiêu câu cá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				}
			]
		},
