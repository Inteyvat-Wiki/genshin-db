						731040402
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040402,
					"content": "Anh hãy nhanh chóng bắt đầu đi, bằng không mấy món đồ... À không... đám cá kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040403,
					"content": "Đừng vội, phải cảm nhận được quy luật của dòng chảy đã, khi thả câu thì phải bình tĩnh.",
