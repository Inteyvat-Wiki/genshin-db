			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "Anh châm chước cho tôi chút đi, tôi thật lòng muốn nhờ anh làm hộ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040102,
					"content": "Không có gì để nói, tôi không nhượng bộ đâu, xin hãy về đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040103,
					"content": "Ấy, sao hai người này lại cãi nhau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040104,
					"content": "Ồ, người ngoại quốc, giúp tôi thuyết phục vị tiểu thư này được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040105,
					"content": "Hôm nay cô ấy đột nhiên tới đây, cứ bám lấy tôi để nhờ vớt một mẻ đồ cổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040106,
					"content": "Dọa cho cá của tôi chạy mất đã đành, còn khiến tôi mất thời gian nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040107,
					"content": "Cô gấp đến vậy không lẽ đống đồ cổ đó đáng giá lắm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040108,
					"content": "Không phải đâu anh Kayvan, tôi là nhân viên tạm thời đến từ Giáo Viện, tên là Helbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040109,
					"content": "Những món đồ cổ đó đều do Giáo Viện sưu tầm, dùng cho mục đích nghiên cứu, tôi phụ trách quản lý chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040110,
					"content": "Nhưng ngày hôm qua thuyền vận chuyển gặp chút sự cố, cho nên có một vài món rơi xuống sông, theo dòng nước trôi xuống hạ lưu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040111,
					"content": "Vậy thì cô đi tìm đội chuyên nghiệp tới mà vớt đi! Tìm một người câu cá như tôi làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040112,
					"content": "Tìm đội chuyên nghiệp thì lâu quá, lúc trước tôi có nghe người ta giới thiệu, anh Kayvan \"Tuyệt Cảnh Trên Lưỡi Câu\" gần như ngày nào cũng câu được đồ bị mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040113,
					"content": "Hơn nữa anh cũng thường câu cá ở khu vực này, nên tôi mới nhờ anh câu thử xem có câu được những món đồ của tôi lên không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040114,
					"content": "Đúng là lúc tuyệt vọng thì cái gì cũng phải thử...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "Khụ khụ, tiểu thư Helbet, tôi rất đồng tình với chuyện đã xảy ra với cô, nhưng tôi chỉ là một người câu cá thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040118,
					"content": "Tôi thả câu vì cá, cũng chỉ mong câu được cá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040119,
					"content": "Rõ ràng là chưa câu được con cá nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040120,
					"content": "Khụ! Tôi vẫn chỉ muốn luyện tập kỹ năng câu cá, chưa bao giờ nghĩ dùng kỹ năng này để làm chuyện khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040121,
					"content": "Nên cô đi nhờ người khác đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040122,
					"content": "Ơ... ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040123,
					"content": "Hay là... như này đi, tôi không cần anh câu đồ bị mất, chỉ cần anh đổi nơi câu cá thôi, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040124,
					"content": "Anh cứ coi như... coi như tôi trả tiền cho anh câu cá đi! Đi mà, xin anh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040125,
					"content": "Tôi bảo này, tôi chỉ là người câu cá thôi! Một người câu cá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040126,
					"content": "Đổi chỗ khác câu cũng được mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "Đi mà, đi mà, anh xem, tôi chuẩn bị xong cả thù lao rồi, anh giúp tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040129,
					"content": "Đúng là không chịu nổi các người... Thôi được rồi, coi như thay đổi tâm trạng vậy. Cô muốn tôi câu cá ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040130,
					"content": "Tôi biết ơn anh nhiều lắm, cứ đi với tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040131,
					"content": "Cũng giống lúc trước, Nhà Lữ Hành, làm phiền các bạn đi tìm nguyên liệu làm mồi câu giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040132,
					"content": "Để tôi nghĩ lại xem... Nguyên liệu lần này là Bạc Hà, nhưng cần phải lấy ở chỗ tôi thường hay lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040133,
					"content": "Tôi đã đánh dấu vị trí đại khái trên bản đồ rồi, nhờ cả vào bạn nhé. Đợi khi bạn mang nguyên liệu về, tôi sẽ trả lại thù lao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040134,
					"content": "Tôi theo tiểu thư Helbet tới điểm câu cá trước, lát nữa gặp mặt ở bên kia nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040127,
					"content": "Người câu cá cũng thường hay câu được đồ mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Nếu Kayvan thả câu thì đúng là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "Tôi thả câu chỉ là để câu được cá lớn, được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Kayvan"
				}
			]
		},
