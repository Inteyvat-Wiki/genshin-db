			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "Hora, lần này đừng chạy lung tung nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210102,
					"content": "G-Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210103,
					"content": "Hôm nay Hora rất nghe lời nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "#Đúng vậy. Nhờ có Bóng Nổi mà {F#cô}{M#cậu} làm giúp tôi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210105,
					"content": "Có quả bóng này rồi thì tôi cũng có thể dụ Hora đi làm nhiều thứ. Dù là tắm rửa, ăn uống, ngủ nghỉ hay huấn luyện cũng đều đã dễ dàng hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210106,
					"content": "Đặc biệt là cắt móng! Nếu là trước đây thì việc đuổi theo Hora sẽ khiến tôi kiệt sức mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210107,
					"content": "Bây giờ chỉ cần đặt quả bóng trước mặt Hora là nó sẽ ngoan ngoãn ngồi xuống ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210108,
					"content": "Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210109,
					"content": "#Hora, còn nhớ {F#cô}{M#cậu} ấy không? Đây là người đã làm đồ chơi cho ngươi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210110,
					"content": "Grào, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210111,
					"content": "Ngoan lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "#Ồ! Hora nhớ {F#cô}{M#cậu} đấy, trông nó có vẻ khá vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210114,
					"content": "#{F#Cô}{M#Cậu} có muốn thử cắt móng cho nó không? Tiện thể lau sừng cho nó luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210115,
					"content": "Việc này rất quan trọng đối với Tepetlisaur con đấy. Vì chúng cần đào hang và bới đất, nên móng vuốt cần được mài giũa thường xuyên, đồng thời phải cắt tỉa những chiếc móng mọc lệch hoặc bị hư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210116,
					"content": "Có như vậy thì Tepetlisaur con mới có thể sở hữu một bộ móng hoàn hảo nhất khi trưởng thành được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210117,
					"content": "Nào, cầm lấy cái này! Chúng ta tranh thủ cắt tỉa móng và chăm sóc toàn thân cho Hora nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210118,
					"content": "Anh nói chi tiết thật đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "Grào, grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210121,
					"content": "Khụ... Hiếm khi thấy Hora nghe lời như vậy. Nghĩ đến việc hôm nay tôi không cần phải đuổi theo Hora chạy khắp bộ tộc thì tôi đã rất vui mừng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210122,
					"content": "Anh thật là vất vả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "#Không có gì! Vậy chúng ta bắt đầu thôi, tôi sẽ ở bên cạnh để hướng dẫn {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210124,
					"content": "Để làm cho Hora thả lỏng, đầu tiên phải dùng bàn chải lớn làm sạch lưng của nó một cách nhẹ nhàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210130,
					"content": "Rồi dùng bàn chải nhỏ để chà sạch sừng của nó. Lúc này cần phải dùng chút lực để làm sạch những ngóc ngách bên trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210125,
					"content": "Sau đó thì dùng khăn lau toàn thân cho Hora... Như thế thì nó sẽ từ từ thả lỏng và duỗi cả bốn chân ra. Lúc này chúng ta sẽ có thể tỉa móng cho nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210126,
					"content": "Trình bày chi tiết thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "Đương nhiên rồi. Hora được tôi nuôi dưỡng từ nhỏ. Cả bộ tộc... không, cả Natlan này không ai hiểu nó hơn tôi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210129,
					"content": "#Được rồi, {F#cô}{M#cậu} cứ làm theo hướng dẫn của tôi để tỉa móng cho Hora nhé. Tôi sẽ ở bên cạnh, nếu không rõ thì cứ hỏi tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210127,
					"content": "Anh hiểu rất rõ về Hora nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "Sao đột nhiên anh phấn khích vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(Vuốt ve Hora.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
