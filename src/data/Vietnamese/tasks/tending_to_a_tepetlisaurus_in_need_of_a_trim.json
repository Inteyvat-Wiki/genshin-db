				"points": []
			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Cơ thể Hora không hề thả lỏng. Thay vào đó, nó nhìn bạn với vẻ hoang mang.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212710,
					"content": "(Cazcal kịp thời tiếp quản công việc. Sau một hồi tỉ mỉ chải chuốt, cuối cùng vẫn có thể cắt tỉa móng cho Hora...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "#Không sao đâu, thỉnh thoảng tôi cũng đoán sai ý Hora. Nhưng chắc chắn nó biết {F#cô}{M#cậu} là một người bạn rất tốt với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212702,
					"content": "Grào, grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212703,
					"content": "Thấy chưa, tôi đã nói mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212704,
					"content": "Cảm ơn nhé. Những thứ này coi như quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212705,
					"content": "Suy nghĩ của Saurian con khó đoán vậy đấy. Tôi cũng phải mất một thời gian dài ở chung với Hora mới có thể đoán được phần lớn suy nghĩ của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212706,
					"content": "Làm được việc này thôi là tôi đã mãn nguyện rồi. Dù sao thì chúng tôi cũng phải tiếp tục chung sống mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212707,
					"content": "Ủa? Hora đi đâu rồi? Không phải lại chạy mất rồi đấy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212708,
