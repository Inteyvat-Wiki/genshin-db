			},
			"dialogs": [
				{
					"id": 250213701,
					"content": "(Hora nghiêng đầu, gãi bụng, nhìn với vẻ bối rối)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213702
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213702,
					"content": "Không thể cứ mãi chơi với Hora như thế được, vẫn còn có việc quan trọng cần làm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213703
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213703,
					"content": "Khụ! Thôi cứ để tôi. Để tôi làm mẫu cách vệ sinh đúng cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213704,
					"content": "(Cazcal kịp thời tiếp quản công việc. Sau một hồi tỉ mỉ chải chuốt, cuối cùng vẫn có thể cắt tỉa móng cho Hora...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213705
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213705,
					"content": "Không thể chỉ lo chơi với Hora mãi thế được đâu, vẫn nên làm việc chính trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213706,
					"content": "Grào! Gràooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213707
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213707,
					"content": "#Haha, có vẻ Hora rất thích chơi với {F#cô}{M#cậu} đấy. Chẳng trách lần này nó lại nghe lời như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213708,
					"content": "Dù sao thì cũng cảm ơn nhé. Những thứ này coi như quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213709
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213709,
					"content": "Ờm, hay là... lần sau tôi cũng thử như thế nhỉ. Chơi với Hora trước rồi mới bắt đầu vệ sinh cho nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213710,
					"content": "Hora, ý kiến này thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213711
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213711,
					"content": "Ủa? Hora đi đâu rồi? Không phải lại chạy mất rồi đấy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213712
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213712,
					"content": "Này! Hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
