			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(Hora dần thả lỏng. Nó duỗi người và xòe móng vuốt cả bốn chân. Có vẻ đã đến lúc cắt móng cho nó rồi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212610,
					"content": "Dưới sự hướng dẫn của Cazcal, móng vuốt của Hora đã được tỉa tót cẩn thận.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "#Hahaha, không ngờ {F#cô}{M#cậu} cũng giỏi việc này nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212602,
					"content": "Grào! Gràooo! Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212603,
					"content": "#Hora cũng đang cảm ơn {F#cô}{M#cậu} đấy. Nhờ {F#cô}{M#cậu} tỉa tót tỉ mỉ cho nó như vậy, chắc chắn nó sẽ đào đất nhanh hơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212604,
					"content": "#Những thứ này là quà cảm ơn {F#cô}{M#cậu}. Khụ... À đúng rồi, tôi khuyên {F#cô}{M#cậu} một câu. Sau này nếu {F#cô}{M#cậu} chăm sóc cho những con Saurian con khác thì đừng áp dụng rập khuôn phương pháp hôm nay nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212605,
					"content": "Mỗi con Saurian con đều có tính cách khác nhau, nên cách chăm sóc cũng sẽ khác nhau. Tôi vất vả mãi đến giờ mới chỉ tìm hiểu được cách để chăm sóc cho Hora thôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212606,
					"content": "Tuy nhiên, tìm hiểu được chuyện này thôi là tôi đã mãn nguyện rồi. Dù sao thì hai chúng tôi sẽ còn chung sống trong một thời gian dài nữa mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212607,
					"content": "Ủa? Hora đi đâu rồi? Không phải lại chạy mất rồi đấy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212608,
					"content": "Này! Hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
