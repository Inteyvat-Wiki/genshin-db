					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "Việc này không phải lo, theo như tôi biết, họ đều giống như tôi, có một trái tim hiệp nghĩa.",
