				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010302,
					"content": "Tôi là thương nhân đến từ Mondstadt, có hẹn với Mậu Tài Công.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Hở? Đã có thông báo trước rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010306,
					"content": "Lão gia hôm nay có việc đột xuất quan trọng, đã hủy tất cả các cuộc hẹn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010307,
					"content": "\"Quan trọng\"... là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "Gần đây lão gia bận một mối làm ăn rất lớn, từ sớm đã ra ngoài tiếp khách quý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010309,
					"content": "Vậy bây giờ ông ấy ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "Xin lỗi, cái này lão gia đặc biệt dặn dò, không được tiết lộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010311,
					"content": "Ý là chúng tôi không phải là khách quý?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "Không không không, tôi không có ý mạo phạm, xin đừng để ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010313,
					"content": "Nếu không để tôi gặp Mậu Tài Công, thì hãy coi chừng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "Xin lỗi, xin lỗi! Lão gia đang ở Tân Nguyệt Hiên bàn việc làm ăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010316,
					"content": "Mong ngài độ lượng, đừng để lão gia trách phạt xuống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010317,
					"content": "Lão gia chúng tôi còn có việc quan trọng, không mất thời gian với ngươi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "#Ngươi hãy mong {M#anh ấy}{F#cô ấy} sau khi bàn xong việc làm ăn với Mậu Tài Công thì có thể quên việc ngươi vô lễ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "Cảm... cảm ơn các ngài! Mong việc kinh doanh của các ngài luôn được Nham Vương Gia bảo hộ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Wu"
				},
				{
					"id": 120010320,
					"content": "#Không ngờ {NICKNAME} cũng có loại thiên phú này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "Chỉ là thuận tiện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "Sau này tôi phải cẩn thận hơn, không thể tùy tiện để bị bạn dọa nạt như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "Xem ra khách quý mà thủ vệ nhắc đến, chính là bọn Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "Tôi cũng đoán vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "Ừm, vậy đến Tân Nguyệt Hiên đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "Đến sớm không bằng đến đúng lúc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "Bạn diễn cũng không tồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Hehe, để cảm ơn, tôi mời bạn ăn điểm tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Hãy đợi lão gia ngươi trả giá cho việc mạo phạm của ngươi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#Tôi là {NICKNAME}, khách quý của chủ nhà các ngươi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "Thật kỳ lạ, trên danh sách không có cái tên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Wu"
				}
			]
		},
