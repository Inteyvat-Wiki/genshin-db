			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "Ồ, rốt cuộc phải làm thế nào mới biết được Mậu Tài Công và Fatui có cấu kết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010202,
					"content": "Phải có chứng cứ có tính quyết định.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "Vậy... trực tiếp đi tìm hắn? Có thể bắt được tại trận là tốt nhất, bắt không được cũng có thể hù họa hắn, nói không chừng có thể nói cho chúng ta biết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010205,
					"content": "Thăm dò thủ vệ trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "Vậy thì giao cho bạn rồi! Tôi sẽ phối hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010203,
					"content": "Nếu có thể nhìn thấy hiện trường thì tốt rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
