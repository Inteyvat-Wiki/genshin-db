					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "\"Xong việc phủi áo ra đi, công danh lợi lộc chẳng màng chi\", đây vốn là bản chất của nghĩa hiệp, càng nghĩ càng thấy hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010827,
					"content": "Chịu ơn một giọt, báo ơn một dòng, nhưng đây không chỉ là báo đáp, tôi không muốn nợ nhân tình, cũng không cần hồi báo.",
