					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010825,
					"content": "Tại sao? Hở? Tại sao, không phải bạn muốn báo ơn Thường Cửu Gia sao?",
