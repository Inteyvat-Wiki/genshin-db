			"dialogs": [
				{
					"id": 220370301,
					"content": "Cháu xử lý hết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370302,
					"content": "Tất cả số nấm đều đã ở đây hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "Chỉ nhiêu đây thôi sao? Ông nhớ là còn nhiều lắm, có phải cháu chưa xử lý hết không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370304,
					"content": "Dù sao thì cũng cảm ơn cháu. Đây là thù lao của cháu, cháu nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370305,
					"content": "Nhưng mà, loại phân bón này khá lợi hại đây, ngay cả nấm cũng sinh trưởng nhanh như vậy, nếu như hoa màu cũng sinh trưởng nhanh như vậy là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370306,
					"content": "Đợi khi ông có thời gian nhất định ông sẽ mua lại để thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
			]
