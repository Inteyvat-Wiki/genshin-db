					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "Chết rồi...sao lại như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "Nhà lữ hành, tôi đang tìm bạn đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370104,
					"content": "Bạn còn nhớ vị khách tên Konda Densuke chứ? Ông ấy vài ngày trước đến đây để hỏi về chuyện phân bón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370105,
					"content": "Ông ấy hài lòng chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "Cũng không biết nữa...có thể nói là ông ấy đang \"hoang mang\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370107,
					"content": "Hoang mang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "Là như vậy, lần trước khi bạn đi tuyên truyền, ông ấy đã dựa theo cách mà bạn nói để dùng thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370109,
					"content": "Tuy là hoa màu có sinh trưởng tốt hơn thật, nhưng đồng thời...cũng có rất nhiều nấm mọc ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370110,
					"content": "Sau khi nhận được phản hồi của ông ấy, tôi cũng có hơi hoang mang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370111,
					"content": "Nhưng dù thế nào thì tình trạng này có lẽ có liên quan đến phân bón rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370112,
					"content": "Nhà lữ hành, phiền bạn đến Làng Konda một chuyến, giúp ông Konda Densuke xử lý số nấm đó được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370113,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "Vậy phiền bạn nhé, tôi phải ở đây tra lại thông tin, xem xem tại sao lại xảy ra tình trạng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370115,
					"content": "Haiz, nếu như có Alrani ở đây thì tốt biết mấy, cô ấy sẽ tìm ra được nguyên nhân giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370116,
					"content": "Hay là để Alrani nghiên cứu vấn đề này đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "Nếu như cô ấy ở đây thì vấn đề này sẽ tìm ra được nguyên nhân nhanh thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370118,
					"content": "Nhưng mà cô ấy hiện vẫn chưa về, cũng không biết là đang ở đâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370119,
					"content": "Cho nên tôi đành phải nhờ bạn rồi, tôi phải ở đây tra lại thông tin, xem xem tại sao lại xảy ra tình trạng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
