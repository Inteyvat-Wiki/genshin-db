			"dialogs": [
				{
					"id": 710960101,
					"content": "Hai vị đã tìm được Lão Thạch chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960102,
					"content": "Ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "Lại là ba viên \"Lão Thạch\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960202,
					"content": "Hai vị nhiệt tình giao nộp \"Lão Thạch\" như vậy tôi cũng xin phép nhận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960203,
					"content": "Không ngờ tìm được ba viên nhanh như vậy, phẩm chất lại còn khá tốt nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960204,
					"content": "Haiz... làm tôi nhớ đến viên mà tôi từng có trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960205,
					"content": "Anh từng có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960206,
					"content": "Tự có mà còn bắt chúng tôi đi tìm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "Là \"trước đây\" thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960209,
					"content": "Khi bố tôi ở Thịnh Lộ Đình, viên \"Lão Thạch\" đó là một mẩu nguyên liệu thừa, phẩm chất cũng khá tốt, nên ông ấy tặng cho tôi như một món đồ chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960210,
					"content": "Lúc đó tôi ngày nào cũng gây gổ với ông ấy, lông bông suốt ngày, phần lớn thời gian tôi ở Tiệm Trà Trên Đá, còn nợ một khoản lớn nữa, lúc đó cùng đường mạt lộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960211,
					"content": "Hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960212,
					"content": "Kém nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "Ai cũng có một thời trẻ trâu mà, dù sao thì khi tôi cùng đường mạt lộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960214,
					"content": "Có một người nhận ra \"Lão Thạch\" nên ra giá để mua nó, nhờ nó mà tôi có được chút Mora để xoay sở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960215,
					"content": "Kết quả là mấy ngày trước đó bố tôi có hỏi đến, nói là: \"Muning à, viên đá lúc trước đâu rồi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960216,
					"content": "Tôi đành nói cho qua, \"chỉ một viên đá mà thôi, sao lại có thể giữ được đến giờ chứ?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960217,
					"content": "Miệng thì nói vậy, nhưng mà trong lòng nghĩ, nếu như lúc đó không bán viên đá, lúc bố hỏi đến tôi có thể lấy ra cho ông ấy xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960218,
					"content": "...Thôi vậy, giờ nghĩ lại chuyện này cũng vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960219,
					"content": "Giờ sửa lỗi vẫn còn kịp mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960220,
					"content": "Nói cũng phải... chỉ là tiền nợ trước đây vẫn phải từ từ trả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960221,
					"content": "Thôi không nói nữa, nếu như phát hiện ra \"Lão Thạch\" thì nhớ mang đến chỗ tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960222,
					"content": "Vẫn chưa đủ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "Thêm 3 viên nữa thôi là có lẽ đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960225,
					"content": "Lão Thạch vốn là khoáng sản hiếm có, Huy Sơn Đình nếu như vẫn cần, thì Vực Đá Sâu bên này chắc cũng không thể kiếm thêm được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960223,
					"content": "Rốt cuộc phải cần bao nhiêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "Nào, giao nộp viên của anh trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}