			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410201,
					"content": "Haha... lữ khách phương xa, là ngươi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410202,
					"content": "Nhờ phúc của ngươi nên hồn phách của ta giờ đã đủ đầy, ta đã nhớ lại được tất cả, thật không thể tin được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410203,
					"content": "Có thể ngươi đã biết được, rất lâu trước đây, Vương Quốc Đêm Trắng chỉ là một màn đêm đen, người dân sinh sống ở đây luôn bị Rồng Biển Sâu quấy nhiễu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410204,
					"content": "Lúc đó, ta đã chủ trì xây dựng Dainichi Mikoshi, từ đó Vương Quốc Đêm Trắng mới phân biệt được ngày và đêm, cái tên \"Đêm Trắng\" cũng ra đời từ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410205,
					"content": "Có nghĩa là: \"Từ khi Dainichi Mikoshi được xây dựng, tuy nơi này chỉ là bóng tối trường kỳ, nhưng ít ra có thể phân biệt được đen và trắng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410206
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410206,
					"content": "Đau đớn làm sao, trước khi những mảnh linh hồn của ta được đoàn tụ, ta thậm chí còn không nhớ ngày mà dân chúng tụ tập ăn mừng khi Dainichi Mikoshi được hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410207
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410207,
					"content": "Thật bi ai, đây đáng ra phải là cảnh tượng mà ta cần khắc sâu vào trong tâm khảm nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410208
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410208,
					"content": "Chỉ đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410209
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410209,
					"content": "Đáng tiếc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410210,
					"content": "Ngày Dainichi Mikoshi được hoàn thành, Tộc Rồng không quen thuộc với ánh sáng đã lập tức lụn bại, cư dân Đêm Trắng đã có được bình yên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410211
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410211,
					"content": "Nhưng khi có được bình yên... lòng người khó đoán, ai mà biết được người ta sẽ nảy sinh ra tâm địa tà ác thế nào chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410212
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410212,
					"content": "Hỡi lữ khách phương xa, đám tiểu nhân tham lam đó đã cướp lấy của cải và quyền lực mỗi khi có cơ hội... nhiều hơn những gì chúng xứng đáng được hưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410213
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410213,
					"content": "Những tên khốn đó lợi dụng dân chúng, bắt đầu tổ chức sùng bái Dainichi Mikoshi. Gửi gắm nhân tâm vào vật vô tri vô giác đó là một điều ngu dốt đến cùng cực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410214
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410214,
					"content": "Đến cuối cùng... chúng thậm chí còn đề cử ra \"Người Con {RUBY#[D]Phaethon}Của Mặt Trời\" để thống trị Vương Quốc Đêm Trắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410215
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410215,
					"content": "Người Con Của Mặt Trời?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410216
					]
				},
				{
					"id": 722410216,
					"content": "Đúng vậy, mỗi một nhiệm kỳ đều sẽ có một đứa trẻ sơ sinh được chọn làm Người Con Của Mặt Trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410217
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410217,
					"content": "Điều đương nhiên, những đứa trẻ non nớt đó vốn dĩ không thể đảm nhiệm chức vị vua của một quốc gia. Chúng chỉ là những con rối, phục vụ cho những kẻ giật dây phía sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410218
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410218,
					"content": "Ta muốn phản đối, nhưng bị chúng sai khiến Người Con Của Mặt Trời phán tội phản nghịch, giam cầm ở đây vĩnh viễn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410219
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410219,
					"content": "Người Con Của Mặt Trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410220,
					"content": "Nhưng rồi cũng sẽ có ngày hắn nhận ra bản thân đang bị giật dây mà đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410221,
					"content": "Người Con Của Mặt Trời, không ai có thể trưởng thành. Một khi trưởng thành sẽ không dễ bị thao túng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410222
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410222,
					"content": "\"Người Con Của Mặt Trời, chúc mừng sinh nhật, cưỡi trên chiến mã, đến lễ hội mặt trời...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410223,
						722410224
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410223,
					"content": "Chẳng lẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				},
				{
					"id": 722410225,
					"content": "Ừm, họ sẽ được đưa đến khu vực bên trong Dainichi Mikoshi, mặc quần áo sinh nhật, trang điểm đẹp đẽ, khi họ vui vẻ tận hưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410226
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410227
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410227,
					"content": "Đây là Dây Cương chứng nhận cho thân phận Người Con Của Mặt Trời, ta giấu ở đây, vốn định sau này đưa ra để cảnh tỉnh nhân thế. Chỉ tiếc là, giờ đã không còn ý nghĩa nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410228
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410228,
					"content": "Lữ khách phương xa, những đứa trẻ đó, và vương quốc này, đều là những thứ mà ta không thể bảo vệ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410229
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410229,
					"content": "Ta là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410230
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410230,
					"content": "Ta là người xây dựng Helios, tên là: Aberaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410231
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410231,
					"content": "Ta chủ trì việc xây dựng Dainichi Mikoshi, ta đã treo một chiếc gương sáng trên cao giữa màn đêm, và ta tự cho mình là một thiên tài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410232
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410232,
					"content": "Ta là thiên tài, ta thực sự có tài!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410233
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410233,
					"content": "Ta vốn nghĩ có thể dùng Dainichi Mikoshi để xua tan bóng tối, nhưng nào ngờ lòng người tham lam mới chính là thứ bóng tối nuốt chửng tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410234
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410234,
					"content": "Lữ khách phương xa, giờ ta sẽ tặng ngươi Dây Cương này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410235
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410235,
					"content": "Dây Cương Thánh Thần này là minh chứng cho lịch sử hoang đường đến nực cười này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410236
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410236,
					"content": "Hãy bảo quản cẩn thận... Không, tùy ngươi xử lý vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410237
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410237,
					"content": "Quý trọng quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410238
					]
				},
				{
					"id": 722410238,
					"content": "Vật này đã không còn ý nghĩa nữa, hôm nay có thể hồn phách quy tụ, trao vật này cho ngươi cũng xem như vận mệnh. Đối với vật này mà nói, cũng xem như là cái chết yên lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410239
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410239,
					"content": "Như vậy mới phải... như vậy mới phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410224,
					"content": "Trong một ngày sinh nhật nào đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				}
			]
		},
