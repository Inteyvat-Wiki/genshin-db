	"talks": [
		{
			"id": 7224102,
			"completionStepIds": [
				7224114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
