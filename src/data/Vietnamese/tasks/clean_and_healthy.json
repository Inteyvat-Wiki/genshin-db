				},
				{
					"id": 230060402,
					"content": "Đã dọn xong hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060403
					]
				},
				{
					"id": 230060403,
					"content": "Cảm ơn bạn rất nhiều, Nhà Lữ Hành, xin hãy nhận số thù lao này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060404,
					"content": "Nói chứ, gần đây anh Gurgen đang ép bản thân làm việc, tôi có nên dành nhiều thời gian hơn để thuyết phục anh ấy không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060405,
					"content": "Sắp tới vẫn còn rất nhiều việc cần phải làm, có thể lần sau việc dọn dẹp lại phải nhờ bạn rồi.",
