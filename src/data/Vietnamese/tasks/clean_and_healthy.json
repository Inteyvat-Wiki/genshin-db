			"dialogs": [
				{
					"id": 230060301,
					"content": "Nhà Lữ Hành, có điều gì muốn hỏi tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060302,
					"content": "Về Zakariya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "Bác sĩ Zakariya là một bác sĩ rất giỏi, cũng là một tín đồ rất sùng đạo của Thảo Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060304,
					"content": "Anh ấy thường chữa trị cho bệnh nhân không ngừng nghỉ, thậm chí còn chẳng màng đến cơm nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060305,
					"content": "Bác sĩ Zakariya còn nói, sứ mạng của anh ấy chính là để những phước lành của Thảo Thần đại nhân có thể đến được với nhiều người hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060306,
					"content": "Việc chữa trị của các bạn đều trông cậy vào phước lành của Thảo Thần sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "Nói một cách chính xác, chuyện \"trị bệnh\" chính là phước lành của Thảo Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060308,
					"content": "Thảo Thần bảo vệ chúng tôi để chúng tôi có thể tìm ra phương pháp chữa trị cho bệnh nhân, trồng trọt các loại thảo dược chữa bệnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060309,
					"content": "Cảm tạ phước lành của Thảo Thần đại nhân, mong rằng mọi người có thể thoát khỏi bệnh tật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
