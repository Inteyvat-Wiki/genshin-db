					"Golshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "Haiz, bây giờ làm sao tìm được người đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060102,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "A! Xin, xin chào, Nhà Lữ Hành, xin hỏi bạn có cần chữa trị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060104,
					"content": "Tôi chỉ đi ngang qua thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "Haha... Rõ ràng như thế à? Đúng là tôi đang rất lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060107,
					"content": "Không biết tại sao, gần đây người tới \"Bimarstan\" của chúng tôi nhờ chữa trị càng lúc càng nhiều, hầu như toàn bộ nhân viên của chúng tôi đều đang chăm sóc bệnh nhân rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060108,
					"content": "Nhưng bác sĩ Zakariya vẫn khăng khăng bắt tôi nghĩ cách dọn dẹp xung quanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060109,
					"content": "Anh ấy nói, để mọi người có thể dễ dàng tiếp nhận sự ban phước của đại nhân Thảo Thần, cần phải giữ cho thân thể và tinh thần của bệnh nhân, cũng như trong ngoài bệnh viện được sạch sẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060110,
					"content": "Ôi, nhưng bây giờ lại không tìm được ai, tôi cũng không thể nhờ những bệnh nhân có triệu chứng nhẹ đứng dậy giúp đỡ tôi được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060111,
					"content": "Hay là giao cho tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "Bạn chịu giúp sao? Thế thì cảm ơn bạn rất nhiều! Tôi sẽ chuẩn bị sẵn thù lao, mặc dù... không nhiều lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060123,
					"content": "Ôi, cầu cho Thảo Thần đại nhân phù hộ cho mọi người khỏi bệnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060113,
					"content": "Không thể thuê ai đó giúp đỡ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "Dù sao chỗ chúng tôi toàn là bệnh nhân, không có nhiều người tự nguyện tới giúp đỡ, kinh phí của chúng tôi cũng có hạn, cho nên không thể thuê nhiều người được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060115,
					"content": "Bình thường chúng tôi sẽ luân phiên dọn dẹp, nhưng giờ bận quá nên không ai rảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060116,
					"content": "Nhà Lữ Hành, nếu... nếu bạn bằng lòng, liệu có thể đến giúp chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060117,
					"content": "Chúng tôi sẽ trả thù lao! Mặc dù, mặc dù không nhiều lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060118,
					"content": "Triệu chứng ở đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "Thật ra tình trạng bệnh nhân ở đây đều là một số triệu chứng nhẹ như đau đầu chẳng hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060120,
					"content": "Bác sĩ Zakariya cũng từng tuyên truyền rất nhiều lần rằng những bệnh này không nguy hiểm gì cả, nhưng không ai nghe hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060121,
					"content": "Tôi nghĩ, có lẽ điều mà mọi người lo sợ không phải là triệu chứng bệnh, mà là chuyện bị bệnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060122,
					"content": "Vậy việc dọn dẹp nhờ vào bạn rồi, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060105,
					"content": "Chẳng qua trông cô có vẻ lo lắng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
		{
