					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400702,
					"content": "Woa, ngầu quá! Không ngờ nhìn gần nó lại to như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400703
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400703,
					"content": "Sau khi phun màu lên, cho dù đứng ở nơi rất xa cũng vẫn có thể nhìn thấy nó nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400704,
					"content": "Tất nhiên! Chỉ cần địa hình rộng rãi không bị núi che khuất, thì dù là hồ bơi trên nóc nhà ở Đồi Huha, hay là vịnh hẹp ở Đảo Tete cũng đều nhìn thấy được hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400705
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400705,
					"content": "Thật tự hào quá. Vậy thì hãy phát huy hết sức nhé!",
