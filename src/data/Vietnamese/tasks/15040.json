					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400311,
					"content": "Hai vị cứu tinh, hai vị có muốn thử nghiệm hạng mục bên tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400312,
					"content": "À không... Các vị có bằng lòng tô thêm màu sắc cho tòa kiến trúc mang tính biểu tượng của chúng tôi không?",
