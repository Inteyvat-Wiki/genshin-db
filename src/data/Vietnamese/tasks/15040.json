			"dialogs": [
				{
					"id": 150400101,
					"content": "Đến nơi rồi! Đây chính là \"Biển Hoa Bọt Màu\" trên bản đồ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400102,
					"content": "Sao lại... xanh vậy nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400103,
					"content": "Giống biển cỏ hơn là biển hoa đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400104
					]
				},
				{
					"id": 150400104,
					"content": "Haha, hơi khác với những gì tôi tưởng tượng... Nhưng những chuyện thế này cũng thường xuyên xảy ra mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400105,
					"content": "Ý là địa điểm thực tế không được như trong quảng cáo sao? Từ góc độ của tôi thì mức độ trước mắt đã đủ để đi khiếu nại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400106
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400106,
					"content": "Nếu tôi không khiếu nại thì khách hàng của tôi cũng sẽ khiếu nại tôi mất thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400107,
					"content": "Không không, là do tôi chưa nói rõ ràng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400108,
					"content": "Ý tôi là có cảm giác chênh lệch ấy. Những gì tôi thấy thì rất hay khác với những gì tôi tưởng tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400109,
					"content": "Chẳng lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400110,
					"content": "Ví dụ như leo lên đỉnh núi để ngắm cảnh, nhưng đột nhiên trên núi bỗng xuất hiện sương mù dày đặc, đến cả đường xuống núi cũng không còn nhìn rõ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400111
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400111,
					"content": "Hoặc khi về đến lều thì phát hiện có Slime Hỏa chui vào, đốt cháy hết toàn bộ củi gỗ thu thập được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400112,
					"content": "Nghe có vẻ hơi đáng thương nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400113,
					"content": "Tôi thì cũng quen rồi, tóm lại thì đó đều là những trắc trở trên chuyến hành trình thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400114,
					"content": "Cho nên, nơi này phong cảnh rộng lớn mênh mông, không khí trong lành thoáng đãng, lại không có ma vật nữa... Thế đã là rất may mắn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400115
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400115,
					"content": "Tôi nghĩ điều may mắn nhất chính là cậu có thể giữ được tâm trạng tích cực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400116
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400117,
					"content": "Asha có phải đã phát hiện được gì đó không? Nghe tiếng kêu thì chắc là có nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400118,
					"content": "Vừa mới đây thôi mà đã hiểu được nhau thế rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400119,
					"content": "(Bạn đọc xong tài liệu.)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400120
					]
				},
				{
					"id": 150400120,
					"content": "Như thế này thì gọi là \"kẻ thù không đội trời chung\" nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400121,
					"content": "Nếu cả hai bên đều là con người thì vẫn còn có thể thương lượng. Đáng tiếc, đối phương lại là Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400122
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400122,
					"content": "Được, vậy chúng ta giúp một tay đi! Asha, chuẩn bị sẵn sàng chưa nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400123
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400123,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400124
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400124,
					"content": "Hả? Tôi nghe sót cái gì à? Sao đã đến bước \"bắt đầu hành động\" rồi? Mọi người định làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400125,
					"content": "Sở thích của các Asha rất dễ quan sát, đó chính là nhuộm màu, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400126
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400126,
					"content": "Thì cũng không sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400127,
					"content": "Mà tâm tư của Asha cũng rất đơn thuần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400128
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400128,
					"content": "So với việc gây thêm rắc rối cho nhân viên ở đây thì tôi nghĩ, có thể nó không thích bãi cỏ đơn điệu, không có chút nghệ thuật gì hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400129
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400129,
					"content": "Cộng thêm việc cả hai trao đổi cũng không được thuận lợi cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400130,
					"content": "Ừm, vậy nên chỉ cần chúng ta phun sơn, biến bãi cỏ thành những mảng màu thật đẹp, phù hợp với tưởng tượng của mọi người về \"biển hoa\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400131
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400131,
					"content": "Nói không chừng có thể được nghệ sĩ Asha công nhận đấy, lại giải quyết được phiền não của vị nhân viên đó nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400132
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400132,
					"content": "Đúng vậy, đó chính là việc mà tôi muốn làm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400133
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400133,
					"content": "Không tệ. Xem ra cậu cũng rất thích hợp để làm người hòa giải đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400134
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400134,
					"content": "Tôi cũng sẽ tham gia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400135
					]
				},
				{
					"id": 150400135,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400136
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400136,
					"content": "Haha, nhột quá... Đừng như thế mà! Đợi đã, chúng ta phải đi đâu đây? Có xa không? Phải báo trước với bạn bè một tiếng đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400137
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400137,
					"content": "Này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400138,
					"content": "Phiên dịch viên à, cô xem có hiểu gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400139,
					"content": "Có lẽ là muốn chuyển thứ gì đó, hoặc là ở gần đây còn có người có việc cấp bách hơn cần giúp đỡ chăng...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400140
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400140,
					"content": "Không liên quan lắm nhỉ! Hơn nữa... Sao cô biết được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400141
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400141,
					"content": "Ừm... Nhìn lâu thì tôi cảm thấy ngôn ngữ cơ thể của chúng cũng có nhiều điểm giống với Saurian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400142
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400142,
					"content": "Cô đừng lừa tôi đấy nhé, thật sự là thế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400143
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400143,
					"content": "Mẹ tôi sẽ dùng động tác giơ cánh lên để bày tỏ hai ý nghĩa khác nhau là \"hôm nay về sớm ăn cơm\" và \"muốn ăn đòn à\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400144
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400144,
					"content": "Vậy cô phân biệt thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400145
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400145,
					"content": "Hồi nhỏ thì không phân biệt được, về nhà sớm thì lại bị đánh đòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400146
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400146,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400147
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400147,
					"content": "Kết cấu rất chắc chắn, tốc độ cũng nhanh nữa... Đây chính là khinh khí cầu của Natlan sao? Đỉnh quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400148
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400148,
					"content": "Mọi người ơi, chúng tôi về rồi! Nhìn lên xem này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
