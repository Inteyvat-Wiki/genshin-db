					"speakerTitle": "Paimon"
				},
				{
					"id": 150400305,
					"content": "Đừng vội, cứ từ từ nói nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400306,
					"content": "Hộc hộc... Được rồi, tôi là nhân viên phụ trách hạng mục khiêu chiến chính \"Asha Lướt Gió\" ở Vách Đá Sắc Màu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400307,
					"content": "Vừa rồi từ trên cao nhìn thấy bãi cỏ ở đây bỗng biến thành biển hoa, lại còn là màu sắc đầy tính nghệ thuật nữa... Làm tôi sợ đến nỗi run rẩy luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Tikraq"
				},
				{
