						150400715
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400715,
					"content": "Nhưng những thử thách mang tính cạnh tranh mới khiến hoạt động bình thường trở thành chuyến phiêu lưu hấp dẫn. Asha có vẻ rất thích điểm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400716,
					"content": "Nó... nó thực sự nói nhiều như vậy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400717,
					"content": "Haha, đại khái là vậy! Tôi đã thêm một vài cách hiểu của mình vào đó.",
