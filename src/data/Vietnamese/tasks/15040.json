					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "Quá tuyệt phải không? Để tôi giới thiệu cho các vị một nơi rất thích hợp để chụp ảnh nhé!",
					"roleType": "TALK_ROLE_NPC",
