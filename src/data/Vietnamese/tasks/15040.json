			"dialogs": [
				{
					"id": 150400301,
					"content": "Woa, hiệu quả tuyệt vời quá! Cuối cùng cũng ra dáng \"Biển Hoa Bọt Màu\" rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
