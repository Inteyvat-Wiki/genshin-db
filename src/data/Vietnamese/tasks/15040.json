					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400732,
					"content": "Tuyển thủ hai bên đã chuẩn bị xong chưa nào? Vậy thì đi theo tôi nhé, tôi làm trọng tài cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400726,
					"content": "Chỉ cần Bennett và Asha vui là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "#Không được, chỉ có chúng tôi vui thôi là không đủ! {NICKNAME}, tôi hy vọng {F#cô}{M#cậu} cũng có thể tận hưởng nó.",
