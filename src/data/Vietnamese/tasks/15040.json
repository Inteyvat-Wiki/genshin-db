					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400313,
					"content": "Nghe có vẻ hay đấy... Nhưng có thể làm thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400314,
					"content": "Đương nhiên rồi, nói đúng hơn là... năn nỉ các vị đấy, đồng ý đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400315,
					"content": "Các vị đã giúp đỡ đồng nghiệp của tôi, vì vậy tôi phải thay mặt cảm ơn. Và tôi nghĩ trải nghiệm này sẽ còn đặc biệt hơn cả phần thưởng bằng tiền nữa đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400316,
					"content": "Thế thì tôi lại cảm thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400317,
					"content": "Ý của Paimon là chúng tôi đồng ý rồi đó! Haha, vậy thì làm thế nào để đến đó nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Bennett"
				},
				{
