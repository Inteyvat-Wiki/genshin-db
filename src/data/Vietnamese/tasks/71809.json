			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Phạm Nhị Gia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Kịch bây giờ ấy mà, ông thật sự càng nghe càng không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Phạm Nhị Gia"
				},
				{
					"id": 718090302,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "Là Nhà Lữ Hành à, \"Hòa Dụ Trà Quán\" lại có kịch mới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Phạm Nhị Gia"
				},
				{
					"id": 718090304,
					"content": "Những vở kịch mới đó... náo nhiệt đấy, nhưng ông nghe không hiểu lắm, các bạn trẻ thì lại rất thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Phạm Nhị Gia"
				},
				{
					"id": 718090305,
					"content": "Ông cảm thấy như vậy ổn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "Chuyện này à... Đương nhiên ông thích nghe những vở kịch cũ hơn, bao nhiêu lâu nay nghe quen rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Phạm Nhị Gia"
				},
				{
					"id": 718090307,
					"content": "Nhưng bây giờ cả cảng Liyue đều đang thay đổi, kịch mới ra nhiều cũng là chuyện đương nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Phạm Nhị Gia"
				},
				{
					"id": 718090308,
					"content": "Haiz, nhưng thay đổi quá nhanh, kịch cũ cũng lâu rồi không mở, cũng không biết Nham Vương Gia... Thôi bỏ đi, không nói nữa, không nói nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Phạm Nhị Gia"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
