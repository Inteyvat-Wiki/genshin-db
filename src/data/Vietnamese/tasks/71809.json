					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "Có thu hoạch gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090402,
					"content": "Có khá nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "Ồ? Nói nghe xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090404,
					"content": "Bến tàu phía nam có rất nhiều chó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "Ồ, khá lắm khá lắm, có sức sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090406,
					"content": "Gần Nhà Thuốc Bubu có rất nhiều chim sẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "Chim sẻ, ừm... Cũng có thể xem như biểu tượng của hòa bình, thích hợp để làm thơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090408,
					"content": "Có người chỉ lo ăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "Như vậy cũng không sai, ăn đương nhiên là ưu tiên hàng đầu, đặc biệt là ở cảng Liyue này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090410,
					"content": "Cũng thú vị đấy, tôi sẽ ghi nhớ, nói không chừng cũng có thể làm thơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090411,
					"content": "Có người cảm thấy thay đổi quá nhanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "Ừm... Có người nghĩ vậy cũng bình thường thôi, cảng Liyue ngày nay có thể nói là thay đổi từng ngày, có một số thứ ngay cả tôi cũng không chấp nhận được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090413,
					"content": "Nhưng chủ đề này quá lớn, e là một bài thơ không đủ lột tả... Tôi cứ ghi lại trước vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090414,
					"content": "Vậy là được rồi, nhờ bạn giúp quả nhiên không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090415,
					"content": "Cứ như vậy, nói không chừng tập thơ của tôi lại sắp có thêm mấy bài mới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090416,
					"content": "À đúng rồi, ngoài chút tiền bạc ra... còn có chút lòng thành, xin hãy nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090417,
					"content": "Khi tập thơ tiếp theo của tôi được xuất bản, là có thể đổi lấy một tập thơ có chữ ký này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
