				},
				{
					"id": 741210605,
					"content": "Vận động sẽ đem đến chuyển động. Chuyển động đưa chúng tôi tới đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210606,
					"content": "Là do các anh làm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "Đúng vậy thì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210608,
					"content": "#Hunter, tôi nhớ ra rồi. Cậu nhìn {M#anh ấy}{F#cô ấy} kỹ hơn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210610,
					"content": "Là người tuyệt đối không được chọc giận mà anh ấy đã nhắc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210611,
					"content": "Đúng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210612,
					"content": "Các anh đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210613,
					"content": "Không có gì, chúng tôi chỉ đang đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210614,
					"content": "Đúng vậy. Chúng tôi chỉ đang đi dạo. Nếu không có việc gì khác, chúng tôi sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210615,
					"content": "Chúng tôi sẽ tiếp tục đi dạo đến chỗ khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210616,
					"content": "Ấy? Hai người không định làm chuyện gì đáng sợ với tôi đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210617,
					"content": "Bài học thế là đủ rồi, nếu anh đã hiểu được ý của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210618,
					"content": "Bài học gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "Không có gì. Ý tôi là, gà nướng rất nguy hiểm, sẽ thu hút rắc rối. Cứ coi như đây là một bài học quý giá đi. Chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210620,
					"content": "Nhưng mà, gà nướng... đó là Debord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210621,
					"content": "Mặc kệ gà nướng! Chúng ta nên đi dạo tiếp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210622,
					"content": "\"Lần sau sẽ để anh Sonny mời chúng ta gà nướng.\"\\nTurner vừa nói, vừa đưa Hunter đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "Cảm ơn! Cảm ơn hai vị, tôi biết hai vị sẽ hiểu được ý tôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210624,
					"content": "#Xem ra đúng như lời {NICKNAME} nói... Chúng ta đào Henri lên thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210625,
					"content": "Có điều, làm việc này rất tốn thể lực, vậy gà nướng sẽ thuộc về chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210626,
					"content": "Hừm? Ghét thật... hết cách rồi, đành đồng ý vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210627,
					"content": "Mất chút thời gian để đào Henri lên, và gỡ cái thùng trên người anh ấy xuống.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "Cùng Paimon bắt đầu thưởng thức gà nướng thơm ngon.\\nHenri có vẻ rất thèm. Nhưng anh ấy đã giữ được lời hứa và sự tôn nghiêm, không hề mở lời xin xỏ.\\nNhưng Paimon thấy bộ dạng của Henri như vậy, đã chủ động chia gà nướng cho anh ấy.\\nLớp da bên ngoài giòn rụm, phảng phất hương vị dầu mỡ thơm nức. Thật vô cùng ngon miệng!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
