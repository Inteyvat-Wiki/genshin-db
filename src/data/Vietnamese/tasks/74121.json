			"dialogs": [
				{
					"id": 741210101,
					"content": "Cảm ơn! Cảm ơn rất nhiều, hai người đúng là cứu tinh của tôi. Henri tôi sẽ không bao giờ quên ân tình này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210102,
					"content": "Không có gì, tôi chỉ tò mò tại sao anh lại rơi vào tình cảnh này thôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210103,
					"content": "Haiz, đám Cua chắc đã bị thu hút bởi mùi thơm của gà nướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210104,
					"content": "Tôi cũng bị mùi gà nướng dẫn đến đây đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210105,
					"content": "Cua với người sao giống nhau được! Tôi thấy chúng có vẻ đang suy nghĩ nên ăn tôi trước hay ăn gà trước, chỉ lo chúng sẽ chọn \"đồ tươi\" trước thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210106,
					"content": "Có lý, đồ tươi vẫn ngon hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "Này, Paimon đang hỏi chuyện của Henri mà! Người thường sẽ không bị chôn thế đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210108,
					"content": "Vậy anh có cần giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210111,
					"content": "Đương nhiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210112,
					"content": "Ờ... đương nhiên là không!! Không cần giúp đào tôi lên đâu!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210113,
					"content": "#Ai da, biết rồi biết rồi, chúng tôi nghe thấy, không cần phải hét lên như thế! Vậy chúng ta đi thôi, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210114,
					"content": "Khoan đã, làm ơn đợi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210115,
					"content": "Hử? Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210116,
					"content": "Tôi... hmm, khụ khụ! Là thế này! Xin hai vị nghe rõ!! Đây là một phương pháp làm đẹp hoàn toàn mới!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210117,
					"content": "Đã nói đừng có lớn tiếng như thế! Đau cả tai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210118,
					"content": "Hai vị xin đừng nghi ngờ!! Tôi là người hoàn toàn minh mẫn, đang áp dụng cách làm đẹp vừa khoa học vừa lành mạnh!! Với khả năng của bản thân, tự chôn mình xuống cát ẩm!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210119,
					"content": "Xin hãy mau rời đi!! Đừng có che khuất ánh mặt trời của tôi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210120,
					"content": "Hmm, vậy chúng ta đi thôi nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210121,
					"content": "Nếu hai người đã muốn biết, cũng hết cách!! Vậy hãy nghe tôi giải thích về sự kỳ diệu của phương pháp này!! Ờ, các loại giun và động vật dưới cát sẽ làm sạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210122,
					"content": "#(Ôi, ồn quá. {NICKNAME}, người này rốt cuộc bị sao thế? Câu trước đá câu sau...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210123,
					"content": "(Cảm thấy hơi kỳ quặc...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "(Đúng không? Bạn có cách gì không?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210125,
					"content": "(Xem xét tình hình xung quanh đã.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "Ơ kìa, hai người phải đi rồi à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210127,
					"content": "Chúng tôi đi xem xét xung quanh đã, rồi quay lại tìm anh sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210128,
					"content": "Được!! Hai người mau đi đi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210109,
					"content": "Hơi tò mò sao anh lại bị chôn xuống đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "Đúng vậy! Anh có cần giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
