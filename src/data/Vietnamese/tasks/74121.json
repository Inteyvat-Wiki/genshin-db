				},
				{
					"id": 741210603,
					"content": "Ối, các anh từ khi nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210604,
					"content": "Chúng tôi đang đi dạo. Đi dạo... là một kiểu vận động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
