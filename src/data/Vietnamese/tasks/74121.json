						741210307
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210307,
					"content": "Về cái người bên đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "Ai cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210309,
					"content": "Tôi không biết ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210310,
					"content": "Chúng tôi chỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210311,
					"content": "Đang đi dạo ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210312,
					"content": "Đúng vậy. Chúng tôi chỉ đang đi dạo ở đây. Hai người bình thường đang đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210313,
					"content": "Thời tiết rất đẹp. Đi dạo thật tuyệt. Bạn không nghĩ vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210314,
					"content": "Đi dạo là chuyện hết sức bình thường. Hiểu chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210315,
					"content": "Hở, các anh đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210316,
					"content": "Vừa nãy các anh có nghe thấy tiếng kêu cứu không? Ở bên đó, có người đang chôn mình dưới cát, suýt thì bị lũ cua đánh chén!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210317,
					"content": "Không ngờ lại có chuyện này xảy ra ở chỗ chúng tôi đi dạo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210318,
					"content": "Lại xảy ra trong một ngày đẹp trời như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210319,
					"content": "Nếu anh ta bị cua xơi tái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210320,
					"content": "Vậy thì thật buồn cười. À ý tôi là, đáng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210321,
					"content": "Đáng tiếc, chúng tôi sẽ không để việc này xảy ra. Ý tôi là, không thể được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210322,
					"content": "Nếu chúng tôi nhìn thấy khi đang đi dạo, chắc chắn sẽ ngăn chuyện đó lại. Ý tôi là, nếu như.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210323,
					"content": "Các anh làm gì ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "Đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210325,
					"content": "Nói rồi, đang đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210326,
					"content": "Thực sự không chú ý thấy gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210327,
					"content": "Không thấy gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210328,
					"content": "Đúng vậy, không thấy gì cả. Ngoài hai kẻ đang quấy rầy chúng tôi đi dạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210329,
					"content": "Đi dạo là việc rất... riêng tư. Chúng tôi không thích bị người khác làm phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210330,
					"content": "Tôi khuyên hai người nên tìm một nơi hay ho để đi dạo. Đài Phun Nước Lucine cũng rất thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210331,
					"content": "Đây là chỗ chúng tôi đi dạo. Ý tôi là, cảm nhận thiên nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210332,
					"content": "Vì vậy không muốn bị làm phiền. Tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Turner"
				}
			]
		},
