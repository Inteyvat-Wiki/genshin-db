			"dialogs": [
				{
					"id": 200160101,
					"content": "Đơn Giao Hàng Món Ăn",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "Nhà Lữ Hành! Bạn đến thật đúng lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "Xin lỗi, tuy là bạn có vẻ đói, nhưng có thể giúp tôi một việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "Gần đây những đơn giao hàng càng lúc càng nhiều, thường tôi sẽ chia đơn hàng theo khu vực trước, sau đó đánh dấu là của ai đặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "Nhưng ký hiệu người đặt của món <color=#00E1FFFF>Súp Hải Sản Hoa Calla Lily</color> bị tôi làm mất rồi, chỉ biết người đặt ở Thanh Tuyền Trấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "Bạn có thể giúp tôi đem <color=#00E1FFFF>Súp Hải Sản Hoa Calla Lily</color> giao đến Thanh Tuyền Trấn, rồi tìm xem ai đặt được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "Được thôi, nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "Đợi khi bạn quay lại, sẽ có một bữa thịnh soạn để đền đáp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "Nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "Đói quá rồi, tôi chỉ đến để ăn cơm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "Sau khi bạn giúp xong, tôi...tôi sẽ mời bạn đặc sản của quán Người Săn Hươu, nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
