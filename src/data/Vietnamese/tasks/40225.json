			"dialogs": [
				{
					"id": 402250201,
					"content": "Beidou chỉ huy thủy thủ dỡ hàng xuống, rồi cùng các bạn đến địa điểm triển lãm",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "Ở đây nhỉ? Vị trí tốt đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "#Khi nào {NICKNAME} rảnh thì đến giúp tôi thử điều khiển từ xa nhé. Rất thú vị đấy, {F#cô}{M#cậu} chắc chắn sẽ thích.",
