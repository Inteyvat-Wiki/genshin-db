			"dialogs": [
				{
					"id": 402250101,
					"content": "Chiếc thuyền này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250102,
					"content": "Ngôi Sao Chết Chóc?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "Đây là thuyền số 2 của đội thuyền, Ngôi Sao Chết Chóc vẫn đang tuần tra ở Cô Vân Các.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250104,
					"content": "Là Beidou! Ừm... thuyền trưởng đánh thuê khét tiếng trên biển xa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250105,
					"content": "Haha, cũng đâu phải lần đầu gặp mặt, dùng cách xưng hô khách sáo thế, xa cách quá rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250106,
					"content": "Nói ra thì dài lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250107,
					"content": "Đừng đứng đó nữa, ngồi xuống nói chuyện đi, tôi sẽ bảo anh em chiêu đãi khách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250108,
					"content": "#Ra là vậy, không ngờ {F#cô}{M#cậu} cũng có quen biết với chủ của Hội Đồng Bí Mật. Quả nhiên những người đi khắp Teyvat sẽ tích lũy được mạng lưới quan hệ đáng nể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250109,
					"content": "Hihi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250110,
					"content": "À đúng rồi, chuyện đăng ký...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "Suýt quên mất, chúng tôi cần đăng ký danh sách người tham gia triển lãm bên cô, và cô định giao dịch hàng hóa gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250112,
					"content": "Về người tham gia triển lãm thì cứ ghi tên tôi với mấy anh em trông hàng là được, những người còn lại sẽ ở trên thuyền. Còn hàng hóa giao dịch... thì đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250113,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250114,
					"content": "Từ lâu, Ningguang đã thực hiện cải tiến máy Guizhong, thứ trang bị trên thuyền Số 2 của tôi chính là một mẫu sau khi được cô ấy cải tiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250115,
					"content": "Loại máy Guizhong này có thể điều khiển từ xa để tấn công mục tiêu một cách chính xác, uy lực vô cùng mạnh mẽ, chắc chắn sẽ rất được ưa chuộng tại triển lãm này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250116,
					"content": "Cái này cũng đem bán được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250117,
					"content": "Haha, đừng lo, mẫu mới nhất mà Thiên Nham Quân đang trang bị hiện đại hơn cái này nhiều, mẫu này đã là đồ cổ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250118,
					"content": "...Thôi được rồi, cũng như Nefer đã nói, giao dịch ở đây không có gì cấm kỵ cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250119,
					"content": "Nhưng mà, ai sẽ mua món này nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Đừng lo, triển lãm thương mại Nod-Krai quy tụ người mua từ khắp Teyvat, chắc chắn sẽ thu hút được những khách hàng lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250121,
					"content": "Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250122,
					"content": "A xin lỗi, lo chuyện dỡ hàng nên quên mất chưa nói với các vị là cô ấy cũng ở trên thuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250123,
					"content": "Không sao đâu, nhưng Yelan cũng là thành viên tham gia triển lãm à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250124,
					"content": "Tôi chỉ đi nhờ đến Nod-Krai để xử lý vài công việc tình báo thôi, nên không cần đăng ký tên tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250125,
					"content": "#Lâu rồi không gặp, {NICKNAME}. Nếu có dịp hãy giúp tôi gửi lời chào đến chủ nhân Hội Đồng Bí Mật nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250126,
					"content": "Lần này cô đến định làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "Do yêu cầu công việc nên không tiện nói thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250128,
					"content": "Nghĩa là \"đừng hỏi nữa\" phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250129,
					"content": "Tôi cũng nghĩ vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "Vậy tôi xuống thuyền trước nhé, khi xong việc rồi tôi sẽ mời mọi người uống một ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250131,
					"content": "Haha, vậy thì tôi phải thưởng thức hương vị Nod-Krai một cách sảng khoái mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250132,
					"content": "Bên này đã đăng ký xong rồi, đi theo chúng tôi nào, tiếp theo sẽ dẫn mọi người đến hội trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
