			"dialogs": [
				{
					"id": 120060201,
					"content": "Nướng xong rồi nướng xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060202,
					"content": "Ừm, đây chính là thành phẩm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060203
					]
				},
				{
					"id": 120060203,
					"content": "Thơm quá...Nhà Lữ Hành, bạn đúng là rất giỏi nấu ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060204
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060204,
					"content": "Tôi cũng muốn trở thành đầu bếp siêu đẳng biết nấu món ăn của khắp mọi nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060205
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060205,
					"content": "Chỉ cần có công thức là sẽ học được, có cơ hội chúng mình sẽ lại mang vài công thức đến cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060206,
					"content": "Hay quá, tôi rất mong đợi có thể cùng các bạn giao lưu món ăn tâm đắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060207
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060207,
					"content": "Các vị, tình hình thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060208
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060208,
					"content": "A, cái này...tiểu thư Kamisato, đây chính là món ăn mà tiểu thư muốn làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060209
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060209,
					"content": "Đúng vậy, đây là món ăn ngoại quốc mà Nhà Lữ Hành đã giúp tôi chế biến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060210
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060210,
					"content": "Có thể phiền bạn giúp tôi đóng gói không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060211
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060211,
					"content": "Đương nhiên là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060212
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060212,
					"content": "Ồ! Thơm quá! Nhất định là món ăn vô cùng thơm ngon, à, tôi cũng muốn có một món như thế này trong tiệm của chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060213
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060213,
					"content": "Ha ha, muốn tôi dạy bạn cách làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060214,
					"content": "Ấy? Có được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060215
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060215,
					"content": "Được chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060216
					]
				},
				{
					"id": 120060216,
					"content": "Thức ăn vốn dĩ phải có mọi người cùng thưởng thức mới càng ngon hơn, tôi nghĩ, mọi người ở Mondstadt cũng sẽ không để bụng nếu chúng tôi truyền bá món ăn này đến Inazuma đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060217,
					"content": "Được thật sao? Ôi, tôi muốn học món ăn ngoại quốc từ lâu lắm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060218
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060218,
					"content": "Nếu các bạn đồng ý chép công thức cho tôi, thì tôi sẽ chế biến và bán món ăn này trong tiệm, còn dán quảng cáo của nó ở vị trí bắt mắt nhất nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060219
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060219,
					"content": "Từ khi phong tỏa đất nước, lâu lắm rồi mọi người chưa thưởng thức món ăn mới. Nhà Lữ Hành, cảm ơn bạn nhiều lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060220
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060220,
					"content": "Tôi đi đóng gói đồ ăn của tiểu thư Kamisato trước, các vị xong xuôi thì hãy đến nơi dùng bữa nhé, món ăn đều sẵn sàng cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060221
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060221,
					"content": "Rõ ràng là thứ có thể bán với giá cao, nhưng lại đồng ý tặng một cách vô tư như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060222
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060222,
					"content": "...Bạn thật tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060223
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060223,
					"content": "Ayaka quá khen rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060224
					]
				},
				{
					"id": 120060224,
					"content": "Tôi thật lòng đó. Tôi...rất ngưỡng mộ bạn, cũng rất tự hào khi có một người bạn hào hiệp như bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060225
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060225,
					"content": "À đúng rồi, có phải nên chép công thức ra không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060226
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060226,
					"content": "#{NICKNAME}, hãy viết công thức mà chúng ta yêu thích rồi tặng cho chủ tiệm nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060227,
					"content": "Đi làm Pizza nào! Hãy chọn nhóm nguyên liệu đầu tiên!",
