					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060403
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120060403,
					"content": "Cám ơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060404
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060404,
					"content": "Đúng là bộ trang phục hết sức đáng yêu, chúng tôi cũng rất phấn chấn khi làm nó, cảm ơn tiểu thư! Lần sau lại ghé thăm nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060405
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120060405,
					"content": "Nhà Lữ Hành, tôi có một món quà tặng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060406
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060406,
					"content": "Í? Thật vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060407
					]
				},
				{
					"id": 120060407,
					"content": "Wa...trông có vẻ là thứ rất cao cấp, là trang sức cho tóc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060408,
					"content": "Là cây trâm chế tác lấy chủ đề bạch hạc, vừa có thể làm trang sức tóc, cũng có thể làm đồ trưng bày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060409
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060409,
					"content": "Đâu thể để bạn giúp đỡ tôi không công, cái này...tặng cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060410,
						120060411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060410,
					"content": "Món quà tuyệt đẹp, cảm ơn bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				},
				{
					"id": 120060412,
					"content": "Ừ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060413,
					"content": "Phải rồi, danh hiệu của Ayaka chính là \"Shirasagi Himegimi\" nhỉ? Món quà này cũng đẹp như bạn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060414,
					"content": "Paimon quá khen rồi. Nếu trông thấy nó có thể khiến các bạn nhớ đến tôi, đương nhiên là không còn gì bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060415,
					"content": "Hi hi, nhất định rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060416,
					"content": "Được rồi, đã lấy được đồ xong xuôi thì có thể xuất phát rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060417,
					"content": "Đi xem thử nơi ở của \"Tsubaki\" nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060411,
					"content": "Tôi sẽ trân trọng nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				}
			]
		},
