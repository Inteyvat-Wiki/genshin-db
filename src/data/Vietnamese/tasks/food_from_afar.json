				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060101,
					"content": "Là cửa tiệm này nhỉ? Quả thật là quán ăn kiểu đường phố, ấm cúng quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060102,
					"content": "Chào mừng quý khách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060103
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060103,
					"content": "Chào bạn, Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060104
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060104,
					"content": "Ôi tiểu thư Kamisato, tiểu thư đến đúng giờ hẹn quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060105
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060105,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060106,
					"content": "Gọi món theo nội dung như tôi đã đặt nhé, ngoài ra, chuyện mà tôi đã nói ấy...cũng phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060107,
					"content": "Được, không vấn đề gì. Tôi đã chuẩn bị sẵn đồ mà tiểu thư cần rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060108
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060108,
					"content": "Nhà Lữ Hành và vị khách nhỏ này xin hãy chờ ở đây một lát, tôi đi chuẩn bị món.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060109
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060109,
					"content": "Nhà Lữ Hành, Paimon, ngồi xuống trước nhé. Tôi xin vắng mặt một lát, sẽ trở lại ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060110,
						120060111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060110,
					"content": "Có việc gì gấp sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				},
				{
					"id": 120060112,
					"content": "À...không phải việc đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060113,
					"content": "Chỉ là tôi cần giải quyết một số việc vặt, sẽ quay lại liền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060114,
					"content": "Đi mất rồi...đừng nói là bắt mình tự thanh toán nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060115,
					"content": "Hai vị là bạn của tiểu thư Kamisato sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060116
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060116,
					"content": "Ha ha, món mà tiệm chúng tôi làm đều là món ăn dân gian, không dám nói rằng cao cấp...nhưng mùi vị thì ngon lắm nhé! Hy vọng các bạn sẽ thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060117
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060117,
					"content": "Tiệm chúng tôi đã mở rất nhiều năm, xem như có chút giao tình với các đại nhân nhà Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060118
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060118,
					"content": "Hai anh em nhà Kamisato đều rất thích món của tiệm chúng tôi, ngày trước luôn kêu người đến tiệm đặt món và mua về phủ để thưởng thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060119
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060119,
					"content": "Nhưng không ngờ, lần này cô ấy lại tự mình đến tiệm, còn dẫn theo bạn nữa. Đây là lần đầu tiên tôi nghe nói tiểu thư Kamisato mời bạn bè ăn cơm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060120
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060120,
					"content": "Lần đầu tiên sao, nở mặt nở mày quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060121,
					"content": "Đúng thế, mặc dù nói ra có chút mạo phạm... nhưng tôi cũng cứ nói với các bạn vậy. Tôi nghe nói, hình như tiểu thư Kamisato không có nhiều bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060122
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060122,
					"content": "Thật ngạc nhiên...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060123
					]
				},
				{
					"id": 120060123,
					"content": "Sao có thể chứ? Cô ấy rất tốt, lại lịch sự, chắc phải rất được yêu mến mới đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060124,
					"content": "Vốn dĩ tôi cũng nghĩ vậy, nhưng quy luật giữa người với người lại không như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060125
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060125,
					"content": "Mọi người đều nói, tiểu thư Kamisato tướng mạo xinh đẹp, xuất thân cao quý, cử chỉ thanh tao nhã nhặn, hệt như đoá hoa mọc trên núi cao vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060126
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060126,
					"content": "Quá đỗi hoàn mỹ, lại khiến người ta cảm thấy xa cách. Đám trẻ nhà thường dân hầu như đều không dám nói chuyện tùy tiện với cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060127
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060127,
					"content": "Hoàn hảo như vậy hóa ra lại khó kết bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060128
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060128,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060129,
					"content": "Tôi không nói chuyện nhiều với cô ấy, nhưng cũng xem như quen biết đã lâu, tôi luôn ngưỡng mộ cô ấy vì tuổi còn trẻ mà đã gánh trên vai nhiều trách nhiệm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060130
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060130,
					"content": "Hôm nay thấy cô ấy dẫn bạn tới, tôi cũng rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060131
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060131,
					"content": "Hôm nay các bạn phải ăn nhiều vào nhé! Nếu được hãy nói chuyện với cô ấy nhiều một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060132
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060132,
					"content": "Xem như là thỉnh cầu của hàng xóm láng giềng chúng tôi nhé, phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060133
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060133,
					"content": "Á...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060134
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060134,
					"content": "Hửm? Giọng của Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060135,
					"content": "Xin lỗi, Nhà Lữ hành...à...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060136,
						120060137
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060136,
					"content": "Hình như có tiếng nổ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060138,
					"content": "Có thể cùng tôi qua bên đó không, có việc...muốn phiền bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060139
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060139,
					"content": "Xin lỗi! Đột nhiên gọi bạn ra đây, thật ra, thật ra...vừa nãy tôi nấu ăn thất bại rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060140
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060140,
					"content": "Thì ra âm thanh cực lớn đó là tiếng cái nồi bị nổ banh xác à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060141,
					"content": "Như bạn thấy đó, căn phòng này nằm ngay cạnh nhà hàng, là nơi ở riêng của chủ tiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060142
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060142,
					"content": "Khoảnh sân này cũng là khu vực riêng của gia đình họ, tôi nhờ chủ tiệm giúp chuẩn bị một số dụng cụ nấu ăn và nguyên liệu, định làm một món đặc sắc ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060143
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060143,
					"content": "Tại sao phải tự nấu ăn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060144
					]
				},
				{
					"id": 120060144,
					"content": "Đúng đó, nếu chỉ đơn giản là muốn ăn, thì có thể gọi món trực tiếp trong tiệm mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060145,
					"content": "Tôi muốn...tặng món quà gặp mặt cho \"Tsubaki\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060146
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060146,
					"content": "Theo ghi chép của mẹ tôi, \"Tsubaki\" thích món ăn ngoại quốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060147
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060147,
					"content": "Lần này đi gặp \"Tsubaki\", tôi liền nghĩ, làm một món ăn ngoại quốc mang tặng đối phương thì tốt hơn nhỉ..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060148
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060148,
					"content": "Món ăn ngoại quốc...chỉ cần không phải món Inazuma là được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060149,
					"content": "Vậy thì chẳng phải chúng ta có rất nhiều lựa chọn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060150,
						120060152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060150,
					"content": "Thật ra tôi là một đầu bếp đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060151
					]
				},
				{
					"id": 120060151,
					"content": "Tôi cũng nghĩ vậy! Người chu du khắp nơi như bạn nhất định là hiểu biết nhiều kiến thức về ẩm thực ở khắp mọi nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060154,
					"content": "Có thể phiền bạn giúp tôi hoàn thành việc này không? Xem như là giúp tôi nhé, có...có được không? Tôi sẽ cảm ơn bạn tử tế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060155,
						120060156
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060155,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060157,
					"content": "Món ăn ngoại quốc như thế nào sẽ thích hợp mang đi tặng người khác nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060158
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060158,
					"content": "Tôi biết tôi biết! Nghĩ về món ăn dạng này, nhất định chính là nó nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060159
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060159,
					"content": "\"Pizza\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060160,
					"content": "Pizza...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060161
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060161,
					"content": "Là một món ăn được làm bằng cách phết nhân và nước sốt lên bề mặt bột, rất ngon nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060162,
					"content": "Nghe có vẻ hay đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060163
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060163,
					"content": "Có cách nào thêm một chút hương vị bản địa của Inazuma không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060164
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060164,
					"content": "Không thành vấn đề, với Pizza thì điều gì cũng có thể!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060156,
					"content": "Đến lúc tôi biểu diễn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060152,
					"content": "Đến món ăn của thế giới khác cũng không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060153
					]
				},
				{
					"id": 120060153,
					"content": "Này, đừng nói lời kỳ quặc như vậy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060137,
					"content": "Xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060111,
					"content": "Cần giúp bạn chiến đấu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				}
			]
		},
