					"nextDialogs": [
						120060236
					]
				},
				{
					"id": 120060236,
					"content": "Wow...Bây giờ bạn càng ngày càng giống Xiangling rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060237,
					"content": "Hửm, xin hỏi Xiangling là...?",
