			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060301,
					"content": "Ấy, bạn viết xong công thức rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060601,
					"content": "Viết xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060602
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060602,
					"content": "Cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060603
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060603,
					"content": "Wa...thật đáng mong chờ, muốn làm món ăn mới ngay lập tức quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060604
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060604,
					"content": "Nhà Lữ Hành, Paimon, xin lỗi đã làm lỡ thời gian dùng bữa của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060605
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060605,
					"content": "Hi hi, ăn sau khi làm việc ngon miệng thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060606,
					"content": "Chúng ta tranh thủ ăn lúc còn nóng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060607
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060607,
					"content": "Thế nào, món ăn của Inazuma có hợp khẩu vị của bạn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060608
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060609,
					"content": "Rất ngon, tôi rất thích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060610,
					"content": "Hương vị đặc sắc lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060608,
					"content": "Ngon! Món này ngon tuyệt, còn cả món kia, cũng tuyệt cú mèo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060609,
						120060610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060611,
					"content": "Ha ha, vậy tôi yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060612
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060612,
					"content": "Đúng rồi, vừa nãy khi tôi thử nấu ăn ở bên kia, các bạn có nói chuyện phiếm với chủ tiệm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060613
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060613,
					"content": "Cô...cô ấy không nói chuyện gì...liên quan tới tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060614
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060614,
					"content": "Nói một chút à, nhưng cô ấy vui thay cho bạn, không có ý gì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060615,
					"content": "Vui thay...cho tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060616
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060616,
					"content": "Ưm...quả nhiên đã nói rồi! Có phải cô ấy...cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060617
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060617,
					"content": "Haiz, thôi vậy, tôi đúng là rất ít bạn bè, tôi cũng tự biết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060618
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060618,
					"content": "Không kỳ lạ đâu, chỉ là người khác chưa tìm thấy cơ hội nói chuyện nhiều hơn với bạn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060619,
					"content": "Cảm ơn bạn đã an ủi, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060620
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060620,
					"content": "Đó đều là sự thật, tôi ấy mà...đúng là khá ít bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060621
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060622,
					"content": "Không có chuyện đó đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060623,
					"content": "Tôi chính là bạn của bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060621,
					"content": "Bình thường gần gũi với tôi chỉ có người nhà và thuộc hạ. Cho nên, nhìn thấy tôi hẹn bạn ra ngoài dùng bữa, mọi người chắc sẽ rất ngạc nhiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060622,
						120060623
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060624,
					"content": "Đúng vậy đúng vậy, bạn có bạn bè, chúng ta đều là bạn của nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060625,
					"content": "Hức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060626
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060626,
					"content": "Cảm ơn các bạn, tôi...tôi rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060627
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060627,
					"content": "Xin lỗi...thật là thất lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060628
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060628,
					"content": "Bạn cảm thấy ra sao cứ việc thể hiện ra bên ngoài, đừng kìm nén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060629,
					"content": "Ừ! Cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060630
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060630,
					"content": "Tôi cũng là người bạn quan trọng của các bạn. Tôi thật sự...rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060631
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060631,
					"content": "Đương nhiên rồi, chúng ta mãi mãi sẽ là bạn tốt, ai đối tốt với chúng tôi, chúng tôi cũng sẽ đối tốt với người ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060632,
					"content": "Tình bạn rất quan trọng, sẽ ảnh hưởng đến rất nhiều người! Giống như sổ tay của mẹ bạn vậy, cũng sẽ khiến bạn muốn gặp người tên \"Tsubaki\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060633,
					"content": "Ừm! Tình bạn là rất quý giá đối với tôi, tôi sẽ trân trọng mối nhân duyên này với các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060634
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060634,
					"content": "Nhưng nói như vậy, người tên \"Tsubaki\" kia rốt cuộc là ai nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060636,
					"content": "Tôi đang nghe đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060637
					]
				},
				{
					"id": 120060635,
					"content": "Về chuyện này, tôi đã có phỏng đoán sơ bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060636
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060638,
					"content": "...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060639
					]
				},
				{
					"id": 120060637,
					"content": "Tôi cho rằng, \"Tsubaki\"...có lẽ là \"sứ thần hồ ly\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060638
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060639,
					"content": "\"Sứ thần hồ ly\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060640,
					"content": "Ừm, tôi nghĩ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060641
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060641,
					"content": "Ngay cả tôi cũng chưa từng nghe nói mẹ mình có một người bạn thần bí như vậy, nhất định là cao nhân mà ngày thường rất khó gặp mặt nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060642
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060642,
					"content": "Inazuma từ xưa đã có không ít truyền thuyết về sứ thần hồ ly rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060643
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060643,
					"content": "Chắc các bạn từng gặp Guuji Yae rồi nhỉ? Cô ấy chính là sứ thần hồ ly đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060644
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060644,
					"content": "Nếu suy đoán theo hướng này, có lẽ ở Inazuma còn có những sứ thần hồ ly không ai hay biết khác...Mà vị \"Tsubaki\" kia có lẽ là một trong số đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060645
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060645,
					"content": "Ồ, Inazuma cũng có tiên nhân à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060646,
					"content": "Bạn nói \"cũng\" là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060647
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060647,
					"content": "Trước khi đến Inazuma, chúng tôi từng đi qua Liyue. Liyue có rất nhiều tiên nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060648,
					"content": "Bay trên trời, chạy dưới đất, bơi trong nước, vùi dưới đất...kiểu gì cũng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060649,
					"content": "Mặc dù tôi từng thấy qua điều này trong sách vở, nhưng nghe người khác đích thân nói ra vẫn thấy thật sự kinh ngạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060650
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060650,
					"content": "Không hổ danh là Liyue... văn hoá cổ xưa tạo ra những truyền thuyết diễm lệ nhất, khiến người ta phải mong chờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060651
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060651,
					"content": "Nếu có cơ hội chúng ta hãy cùng tới Liyue chơi nhé, nơi đó cũng có rất nhiều đồ ăn ngon, tuyệt lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060652,
					"content": "Vậy sao? Tuyệt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060653
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060653,
					"content": "Nhưng trước đó, Nhà Lữ Hành, Paimon, các bạn ăn no chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060654
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060654,
					"content": "Ăn no rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060655,
					"content": "Vậy chúng ta đi lấy trang phục trước, sau đó mời hai bạn cùng tôi đi gặp cao nhân thần bí ở Inazuma nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
