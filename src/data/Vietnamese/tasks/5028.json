			"dialogs": [
				{
					"id": 50280501,
					"content": "Sinh mạng của Kẻ Đổ Bộ có giá trị hơn ngươi tưởng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280502
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280502,
					"content": "Ngươi đã tự tay bóp nát hy vọng của thế giới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280503
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280503,
					"content": "Nếu ta định sẵn sẽ thất bại, thì ngươi hà cớ gì phải sợ hãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280504
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280505
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280505,
					"content": "(Vì nguyện vọng, chúng ta bước lên con đường hành hương.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280506
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280506,
					"content": "(Vì danh dự là người mạnh nhất, chúng ta cùng nhau chiến đấu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280507
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280507,
					"content": "(Vì giấc mơ, chúng ta thiêu rụi trong kiếp hỏa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280508
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280508,
					"content": "(Cứ thế luân hồi, lần nữa lại lần nữa...)",
