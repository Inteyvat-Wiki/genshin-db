			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#Ah, {NICKNAME} và Paimon. Những chú chim trong rừng vừa mới bàn tán về sự xuất hiện của hai vị đấy. Hôm nay đến đây có chuyện quan trọng, hay là... cần tôi chỉ dẫn gì đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010102,
					"content": "Chúng tôi đang tham quan xung quanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "Nơi đây được ánh trăng gột rửa, dù là thảm thực vật hay sinh linh cư ngụ đều không giống với thế giới bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010105,
					"content": "Đúng là một nơi có thể lưu lại nhiều bức ảnh quý giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010106,
					"content": "Hai vị cứ tự nhiên dạo chơi, nếu có bất kỳ điều gì tò mò thì cứ hỏi tôi. Tôi sẽ giải đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010107,
					"content": "Bầu không khí ở đây thật yên tĩnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "Đúng vậy. Đây là nơi tôi tĩnh tâm, cũng là nơi tôi trò chuyện và giao lưu với vạn vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010110,
					"content": "Chỉ cần đứng ở đây, tâm hồn sẽ trở về với sự bình yên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010111,
					"content": "Woa, nghe thật có chất thơ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010112,
					"content": "Thực ra, tôi có một yêu cầu nhỏ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "Đúng vậy, Lauma đứng ở đây, hòa làm một với khung cảnh, đẹp như một bức tranh vậy! Dùng máy ảnh chụp lại chắc chắn sẽ rất đẹp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010115,
					"content": "Chụp ảnh cho tôi sao? Đây đúng là trải nghiệm mới lạ. Nếu hai vị cho rằng sự yên tĩnh lúc này, và cả bóng hình của tôi đáng để ống kính ghi lại thì tôi rất sẵn lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010116,
					"content": "Có thể trở thành một ký ức đẹp trong hành trình của hai vị cũng là vinh hạnh của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010117,
					"content": "Vậy thì, tôi nên phối hợp như thế nào đây? Có cần phải nhìn về một hướng nào đó, hay chỉ cần giữ tư thế tự nhiên là được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010118,
					"content": "Cứ như bình thường là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "#Được, vậy giao cho {F#cô}{M#cậu} nhé. Mong {F#cô}{M#cậu} có thể nắm bắt được nguồn cảm hứng thoáng qua đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010119,
					"content": "Tôi sẽ cố gắng bắt trọn khoảnh khắc lay động nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "Chúng tôi hy vọng có thể chụp ảnh cho cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "Lauma thường ở gần đây sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "Nhân tiện tìm kiếm tư liệu chụp ảnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
