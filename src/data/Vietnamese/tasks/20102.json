			"dialogs": [
				{
					"id": 201020401,
					"content": "...Không có tin tức gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020402,
					"content": "Em đang cho bồ câu ăn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "#Hôm nay em cho ăn xong rồi, sau đó nhanh chóng đuổi chúng bay đi đề phòng {F#chị}{M#anh} lại có ý đồ xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020404,
					"content": "Bây giờ em chỉ đang viết thư mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020407,
					"content": "Mẹ Grace nói, nếu bố có thời gian, nhất định sẽ gửi thư bồ câu về cho em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020408,
					"content": "Nhưng hôm nay đợi mãi chả thấy bức thư nào... Có lẽ bố đang rất bận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020409,
					"content": "Chính vì vậy em nghĩ rằng, nếu bố quá bận thì em sẽ viết thư và gửi ít quà cho ông ấy... Nhưng không biết phải chọn món quà gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020410,
					"content": "Đúng rồi, dùng <color=#00E1FFFF>bồ công anh</color> đi. Mẹ Grace nói mọi người ở Mondstadt đều thích bồ công anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020411,
					"content": "#Nếu {F#chị}{M#anh} có thời gian rảnh, hãy giúp em tìm <color=#00E1FFFF>bồ công anh</color> nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020412,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "#Thật sao! Em cảm ơn {F#chị}{M#anh}... {F#Chị}{M#Anh} đôi khi cũng rất tốt bụng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020414,
					"content": "Không tặng thêm quà gì nữa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "Em cũng muốn tặng, nhưng nếu nặng quá thì bồ câu bay không nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020416,
					"content": "Hơn nữa bố làm việc ở nơi rất xa, bồ câu cũng phải bay rất lâu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020405,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "Em đang viết thư cho bố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				}
			]
		},
