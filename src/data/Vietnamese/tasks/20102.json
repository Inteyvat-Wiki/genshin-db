				},
				{
					"id": 201020602,
					"content": "Tìm được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "Tốt quá đi, như vậy đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020604,
					"content": "Đặt hạt bồ công anh vào trong thư... sau đó gói kín...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020605,
					"content": "Xong rồi! Hihi, bố nhận được bức thư này nhất định rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020606,
					"content": "Có điều... Em nghe nói không phải chú bồ câu nào cũng làm bồ câu đưa thư được... Em lại chẳng biết địa chỉ của bố ở đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020607,
					"content": "Đúng rồi! Mẹ Grace nói chú Draff ở Thanh Tuyền Trấn nuôi một đàn bồ câu đưa thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020608,
					"content": "Hơn nữa bà còn nói, chú Draff còn quen biết với bố em, chú ấy nhất định sẽ biết cách gửi bức thư này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020609,
					"content": "#Vậy thì... Lại phải nhờ đến {F#chị}{M#anh} giúp em một việc rồi, đưa bức thư này cho chú Draff, nhờ chú ấy gửi cho bố của em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020610,
					"content": "Còn chuyện này nữa, không được đọc trộm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
