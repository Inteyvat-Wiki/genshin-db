			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "Cũng chẳng biết đứa trẻ ấy bị làm sao nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "Hửm? Ồ, bạn đến thật đúng lúc, còn nhớ đến bức thư lần trước chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020104,
					"content": "Nếu có thời gian thì mang giúp tôi bức thư này cho tu nữ Grace nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020105,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "Vậy phiền bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020107,
					"content": "Tại sao tôi phải đi cơ chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "Sự cố lần trước khiến tôi không dám dùng bồ câu đưa thư nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020109,
					"content": "Hơn nữa nếu tôi tự đến thành Mondstadt đưa thư thì nhất định sẽ gặp đứa trẻ ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020110,
					"content": "Thôi đừng hỏi thêm nữa, bức thư này nhờ bạn giúp vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "Hửm? Sao bạn vẫn chưa đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020202,
					"content": "Về bức thư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "...Trong đó chỉ nhắc đến những chuyện cũ mà thôi, lần trước bạn không xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020204,
					"content": "Chưa xem thì cũng đừng xem nữa, toàn là những chuyện linh tinh mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020205,
					"content": "Đứa trẻ đó là ai vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "Bạn bận tâm chuyện này làm gì, còn nhớ đứa trẻ luôn đứng trên cầu cho đám chim bồ câu ăn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020207,
					"content": "Nó là Timmie. Vì có một vài lý do... hiện tại tôi không tiện gặp thằng bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020208,
					"content": "Thỏa mãn lòng hiếu kỳ rồi phải không? Mau giúp tôi đưa thư đi, nếu không tu nữ Grace lại nghĩ ngợi lung tung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "Thật kỳ lạ, sao giờ vẫn chưa đến, chẳng lẽ có chuyện gì rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020302,
					"content": "Đây là thư của Draff gửi cho cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "Hả? Sao lại là bạn mang đến, không phải là đám bồ câu sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020304,
					"content": "Đám bồ câu có chút vấn đề? Thanh Tuyền Trấn đúng thật là... ngày nào cũng có chuyện \"phát sinh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020305,
					"content": "Cám ơn các cháu đã mang thư tới, đợi một lát tôi đi chuẩn bị quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020306,
					"content": "Về bức thư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "Bạn đã xem rồi sao? Cũng không phải là bí mật quan trọng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020308,
					"content": "Theo cách nói của Draff thì đây chỉ là những \"chuyện cũ\" mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020309,
					"content": "Có điều \"chuyện cũ\" này khiến hai bọn ta mãi không thể quên được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020310,
					"content": "\"Chuyện cũ\" này là gì vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "Bạn muốn biết sao? Được thôi, bạn là người đáng tin cậy... Có điều bạn phải hứa không được nói chuyện này cho người khác biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020312,
					"content": "Tôi hứa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "... Bố của Timmie là bạn thân của Draff, hai người họ thường cùng nhau săn bắn, uống rượu và thám hiểm nhiều nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020317,
					"content": "Cũng không biết bị Đội Kỵ Sĩ cảnh cáo và tu nữ Victoria khuyên ngăn bao nhiêu lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020318,
					"content": "Cho đến khi Timmie ra đời, ông ấy mới bắt đầu có nhận thức làm bố. Bắt đầu cai rượu, chăm chỉ làm ăn, thậm chí còn bảo rằng: \"Phải cố gắng ra dáng một người bố\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020319,
					"content": "Sau đó ông ấy cứ nói mãi về việc không được để Timmie học theo những điều xấu, khuyên Draff cai rượu bằng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020320,
					"content": "Chỉ đến khi hai người bọn họ không chịu được nữa, mới tự thưởng cho mình một bình nước táo lên men, thi thoảng tôi cũng đi uống với họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020321,
					"content": "Thế nhưng, trong một lần đi săn với nhau, bố của Timmie bất ngờ bị trọng thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020322,
					"content": "Tuy được đưa đi cấp cứu kịp thời, nhưng năng lực của các tu nữ cũng có hạn... Đáng buồn thay, ông ấy đã qua đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020323,
					"content": "Từ đó trở về sau, Draff nhờ tôi chăm sóc cho Timmie, còn ông ấy quay trở lại Thanh Tuyền Trấn tiếp tục săn bắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020324,
					"content": "Draff vẫn đều đặn hàng tháng viết thư cho Timmie, nhưng lại không dám gặp thằng bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020325,
					"content": "Thời gian gần đây, Draff liên tục nhắc đến việc phải nói sự thật cho Timmie biết, haizz cũng chẳng biết ông ấy đã trải qua những gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020326,
					"content": "Tu nữ không muốn Timmie biết sự thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "Đúng vậy, tôi nghĩ không nên nói cho Timmie biết sự thật, dù gì nó vẫn là một đứa bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020328,
					"content": "Tuy nó luôn tự nói mình là người lớn, còn giúp tôi chăm sóc Nora và Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020329,
					"content": "Thế nhưng... Sự thật đầy đau thương như vậy, nó làm sao có thể chịu nổi cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020330,
					"content": "Ít nhất đợi đến khi thằng bé đủ trưởng thành, có thể tiếp nhận sự thật này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020331,
					"content": "Cho dù lừa gạt thế nào, tôi cũng muốn dành cho nó những năm tháng tuổi thơ êm đềm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020341,
					"content": "Nhưng Timmie cũng đang lớn dần, có nhiều suy nghĩ, cũng có nhiều câu hỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020342,
					"content": "Ta ngày càng không biết phải đối mặt thế nào với đứa trẻ này nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020343,
					"content": "Nora trước kia từng nói, Timmie thường kéo theo con bé chạy khắp nơi chuẩn bị quà và viết thư cho bố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020344,
					"content": "Có điều thời gian gần đây, Timmie cứ lầm lì, có lúc còn không tập trung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020345,
					"content": "Nếu bạn có thời gian thì giúp ta đến thăm Timmie được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020346,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "Vậy thì nhờ bạn giúp đỡ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020348,
					"content": "Tại sao tu nữ không tự mình đến thăm thằng bé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "Thật là xấu hổ... Tuy miệng luôn nói bản thân đã suy nghĩ rất kỹ, không tiết lộ sự thật cho Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020350,
					"content": "Thế nhưng mỗi lần nghe thấy thằng bé nhắc đến chuyện viết thư cho bố, tôi lại mềm lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020351,
					"content": "Thực sự sợ một ngày nào đó, tôi chịu không được mà nói toàn bộ sự thật cho thằng bé biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020352,
					"content": "...Như vậy không thể chấp nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020353,
					"content": "Vì vậy, phải nhờ bạn đến thăm Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020332,
					"content": "Không thể lừa dối cả đời được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "...Tôi cũng biết điều đó, nhưng Timmie vẫn là một đứa bé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020334,
					"content": "Tôi hy vọng... Và tôi tin rằng thằng bé nên có những năm tháng tuổi thơ hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020335,
					"content": "Để sau này, cho dù nó có chịu đau khổ đến mức nào, những hồi ức tốt đẹp sẽ an ủi thằng bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020336,
					"content": "Biết sự thật có gì không tốt cơ chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "Hừm... Bạn nghĩ như vậy cũng có thể hiểu được, bạn là người từng trải, đủ dũng cảm và kiên cường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020338,
					"content": "Những chuyện bạn từng trải qua, nghe có vẻ vĩ đại nhưng đằng sau đó ắt hẳn chứa đựng rất nhiều đắng cay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020339,
					"content": "Timmie vẫn còn nhỏ, cho dù có chút quá đáng nhưng tôi cũng chỉ hy vọng thằng bé không phải hứng chịu quá nhiều đau khổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020340,
					"content": "...Chí ít, tôi chỉ muốn thằng bé có tuổi thơ hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020313,
					"content": "Tôi sẽ cố gắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "Haizz, người như bạn sao lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020315,
					"content": "... Có điều, tôi tin vào phẩm hạnh của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "Grace"
				}
			]
		},
