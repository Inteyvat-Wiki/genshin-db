					"content": "Đây là thư Timmie gửi cho bố.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "Thư Timmie gửi cho bố... Có lẽ tu nữ Grace đã nói sự thật cho bạn nghe rồi phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020704,
					"content": "Bức thư này... Quả thật không thể gửi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020705,
					"content": "Vậy là không gửi nữa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "Có dùng cách nào đi chăng nữa, cũng không thể gửi đi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020707,
					"content": "Không có cách nào cả, tạm thời hãy để tôi giữ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020717,
					"content": "Được rồi, tạm để bức thư này ở đây... Rồi coi như đã gửi thư đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020718,
					"content": "Người bạn của tôi nhất định sẽ hiểu cho tấm lòng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020719,
					"content": "Cảm ơn bạn nhé, nhớ giữ bí mật với Timmie, bạn sẽ làm được, phải không? Chí ít... Tôi cũng có chút quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020708,
					"content": "Hay là đốt nó đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "Haha, bạn quả là Nhà Mạo Hiểm dày dặn kinh nghiệm, làm việc nhanh chóng hiệu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020710,
					"content": "Nhưng tôi lại không phải là Nhà Mạo Hiểm, chỉ là một thợ săn bình thường mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020711,
					"content": "Tôi sẽ không đốt bức thư này, cũng không mở nó mà sẽ giữ nó một cách cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020712,
					"content": "Để tôi giữ giúp ngài.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "Bạn giữ nó để làm gì? Lẽ nào bạn nghĩ người bạn của ta vẫn chưa chết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020714,
					"content": "...Và nếu bạn đi nhiều nơi hơn nữa sẽ có cơ hội gặp được ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020715,
					"content": "Tôi cũng từng nghĩ như bạn vậy, thậm chí còn cố gắng đi tìm, thế nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020716,
					"content": "Cuối cùng tôi cũng phải thừa nhận sự thật là bạn của tôi đã vĩnh viễn rời bỏ thế gian này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				}
			]
