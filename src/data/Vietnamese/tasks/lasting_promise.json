			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "Mở ra chưa mở ra chưa? Có kho báu mà tiên nhân để lại không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070202,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070203,
					"content": "Hử...đây là sách ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070204,
					"content": "Xem ra cũng là một quyển sổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070205,
					"content": "Lẽ nào đây là sổ tay của \"Tsubaki\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070206,
					"content": "Các bạn, chúng ta ra ngoài thì hơn. Bầu không khí ở đây không giống với những gì tôi tưởng tượng lắm, cứ cảm thấy...không muốn mở quyển sổ này tại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070207,
					"content": "Nói đúng đó, không đủ ánh sáng dễ làm hại mắt. Đi thôi đi thôi, ra ngoài nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200703,
