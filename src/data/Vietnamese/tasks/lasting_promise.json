			"dialogs": [
				{
					"id": 120070301,
					"content": "Đến đây là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070302,
					"content": "Mau xem trong sổ tay viết gì đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070303,
					"content": "Hừm...có khi nào là kho báu thần bí không nhỉ, mong chờ quá à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070304,
					"content": "Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "Sao thế? Đột nhiên nhỏ giọng vậy, làm tôi cũng căng thẳng đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070306,
					"content": "Chúng ta đi qua một bên đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070308,
					"content": "Thì ra là không muốn làm phiền Ayaka xem ghi chép, xem ra quyển sổ đó thật sự quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070309,
					"content": "Nhưng trông sắc mặt của cô ấy...quá nửa không phải bản đồ kho báu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070310,
					"content": "Ưm, bên trong có gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070311,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070312,
					"content": "Phù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070313,
					"content": "Nhà Lữ Hành, Paimon, xin lỗi để các bạn chờ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070314,
					"content": "Mới có một lát thôi, bạn đã đọc rất nhanh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070315,
					"content": "Xem xong sổ tay rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "Ừm, xem xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070317,
					"content": "Tôi nghĩ, mình nên chia sẻ với các bạn chân tướng của quyển sổ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070318,
					"content": "Mặc dù nội dung bên trong hoàn toàn không giống như tôi nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070319,
					"content": "Không giống? Đây không phải sổ tay của sứ thần hồ ly ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070320,
					"content": "Không phải sứ thần hồ ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070321,
					"content": "Sự thật về \"Tsubaki\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070322,
					"content": "Chính là mẹ của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070323,
					"content": "Hử?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070324,
					"content": "Rất ngạc nhiên phải không? Tôi...tôi cũng rất kinh ngạc...nhưng quyển sổ này đã viết như vậy ngay từ lúc bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070325,
					"content": "\"Tsubaki vừa giống lại vừa khác tôi lúc bình thường, khi là Tsubaki, tôi không phải Kamisato Kayo, mà là một cô gái bình thường nhất.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070326,
					"content": "\"Tất cả mọi thứ sau đây, chỉ là một chuyện vụn vặt trong cuộc sống bình thường được tôi ghi chép lại mà thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070327,
					"content": "Nội dung trong sổ đa số là về suy nghĩ riêng về những bí mật và chuyện vụn vặt ngày thường của mẹ...Những chuyện mà chúng ta tưởng là liên quan đến \"Tsubaki\", cũng là suy nghĩ của bà ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070328,
					"content": "Tức là, bản vẽ thiết kế và món ăn ngoại quốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070329,
					"content": "Ừm, đều là những thứ mà mẹ tôi muốn thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070330,
					"content": "Có lẽ điều này hơi kỳ lạ với các bạn, nhưng đối với tôi, tôi lại vô cùng thấu hiểu hành động này của mẹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070331,
					"content": "Đúng hơn là, thật ra...thật ra tôi cũng có mặt giống như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070332,
					"content": "Lúc xem sổ tay, thậm chí tôi còn có chút bối rối, hệt như những suy nghĩ của mình được người khác nhìn thấu và viết lên quyển sổ này vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070333,
					"content": "Ayaka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070334,
					"content": "Sau khi mẹ tôi lấy cha tôi, bà luôn đảm đương mọi việc của nhà Kamisato với tư cách chủ mẫu. Thân phận của Hiệp Hội Yashiro rất tôn quý, phải để ý rất nhiều chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070335,
					"content": "Không chỉ vậy, từng cử chỉ lời nói của bà đều đại diện cho gia tộc Kamisato. Mọi người luôn dõi theo bà, trong hoàn cảnh này, bà nhất định sẽ không có nhiều thời gian làm việc mà mình muốn làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070336,
					"content": "Sau khi cha mẹ qua đời, tôi và anh trai tiếp quản mọi việc của nhà Kamisato. Trong thời gian đó, chúng tôi gặp rất nhiều khó khăn, người ngoài có lẽ sẽ hơi khó để tưởng tượng ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070337,
					"content": "Mỗi khi tôi gặp chuyện phiền lòng, tôi luôn nghĩ rằng: Năm xưa có phải mẹ cũng từng làm như vậy? Chuyện như vậy bà sẽ giải quyết ra sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070338,
					"content": "Có lẽ lâu quá rồi tôi chưa gặp mẹ. Rồi chẳng hiểu tại sao, trong ký ức của tôi cũng chỉ còn sót lại vẻ uy nghiêm và cao quý của mẹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070339,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "Nhưng...điều này không đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070341,
					"content": "Khi tôi nhìn thấy quyển sổ, liền nhận ra...bà và tôi giống nhau, dù chúng tôi gánh vác trọng trách ra sao, cũng chỉ là một con người bình thường mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070342,
					"content": "Thích kimono xinh đẹp, muốn thử món ngon khắp mọi nơi, khao khát nhìn ngắm cảnh đẹp chưa từng được chứng kiến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070343,
					"content": "Có lẽ các bạn nghe thấy những lời này sẽ cười tôi không đủ trưởng thành, nhưng...tôi thực sự cũng có suy nghĩ như vậy. Không phải sống như Kamisato Ayaka, mà sống như một cô bé bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070344,
					"content": "Mẹ viết rằng, bà luôn muốn tham gia lễ hội dân gian của Inazuma. Bà nói, vào một đêm trời quang, nhìn về phía đằng xa từ nhà của mình, thỉnh thoảng có thể trông thấy ánh đèn lễ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070345,
					"content": "Tôi cũng từng nhìn thấy đó! Rất náo nhiệt, rất đông người, lửa trong đèn lồng sáng rực, có thể chiếu sáng cả mảng đêm đen...Thỉnh thoảng chúng tôi còn phải lo lắng cả vấn đề trị an ở nơi đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070346,
					"content": "Nhưng với thân phận của chúng tôi, tuỳ tiện tham gia lễ hội có lẽ không hợp lễ tiết. Đặc biệt là thời đại của cha mẹ tôi, mối quan hệ giữa Hiệp Hội Yashiro và dân chúng chưa thân thiết như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070347,
					"content": "Dù không có ai hạn chế chúng tôi, người của Hiệp Hội Yashiro đột nhiên xuất hiện trong đám đông, mọi người ít nhiều cũng sẽ nhìn bằng ánh mắt kỳ lạ. Họ sẽ nghĩ, chúng tôi tới đó là muốn làm gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070348,
					"content": "Mẹ nói, bà không muốn khiến người khác cảm thấy cần thận trọng, hy vọng mọi người có thể tận hưởng niềm vui và sự tự do của lễ hội...Bà không muốn làm phiền người khác, cũng không có thời gian rảnh, nên chưa từng đi dù chỉ một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070349,
					"content": "Thì ra là vậy...Cho nên bản vẽ thiết kế đó chính là trang phục mà bà ấy định mặc đi lễ hội sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070350,
					"content": "Đúng vậy. Trong lễ hội đôi khi sẽ bán những món ăn ngoại quốc, đó cũng là thứ mà bà muốn nếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070351,
					"content": "Tôi hơi mạo muội một chút, nhưng...thật không ngờ mẹ của tôi cũng mang trái tim thiếu nữ như vậy, ha ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070352,
					"content": "Có gì mạo muội đâu, tôi cho rằng mẹ của bạn là một người đáng yêu lại rất có trách nhiệm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070353,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070354,
					"content": "Bất giác, tôi đã hoàn thành một số nguyện vọng giúp mẹ rồi. Duy chỉ có việc tham gia lễ hội là tôi không thể thay bà hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070355,
					"content": "Hình như...cũng không có cơ hội để nhìn thấy bà hoàn thành việc này rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070356,
					"content": "Bạn đã làm rất tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "Ừm, tôi hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070359,
					"content": "...Cảm ơn các bạn, hình như tôi đã hiểu ra một số chuyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070360,
					"content": "Mẹ và tôi, ở một số phương diện nào đó lại giống hệt nhau. Những chuyện bà từng gặp phải cũng giống với những chuyện mà tôi sắp phải đối mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070361,
					"content": "Bà đem những việc không thể thực hiện ủy thác cho \"Tsubaki\", còn tôi...đã hạ quyết tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070362,
					"content": "Í! Lẽ nào bạn cũng muốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070363,
					"content": "Không, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070364,
					"content": "Tôi không muốn dùng cách như vậy. Tôi muốn...tôi có mục tiêu mới, tôi sẽ sống mỗi ngày mà không có sự hối tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070365,
					"content": "Cái đó...Nhà Lữ Hành, tôi...ưm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070366,
					"content": "Phù...bình tĩnh, bình tĩnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070367,
					"content": "Bạn có hứng thú với lễ hội ở chỗ chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070368,
					"content": "Từ khi nhìn thấy áp phích, tôi đã luôn muốn đi rồi! Ayaka có phải cũng có hứng thú không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070369,
					"content": "Ayaka, bạn cũng chưa từng tham gia lễ hội sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "Xin đừng cười tôi! Tôi...tôi cũng từng lo lắng những chuyện đó...Nhưng giờ tôi đã không còn lo lắng nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070371,
					"content": "Tôi muốn đối mặt với trái tim mình một cách chân thành, hoàn thành nguyện vọng giống với mẹ tôi. Nếu là bạn, nhất định sẽ không trách sự ngẫu hứng của tôi chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070372,
					"content": "Tôi muốn...tôi muốn mời bạn tới lễ hội cùng với tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070373,
					"content": "Tôi rất sẵn lòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "Đi thôi đi thôi! Lễ hội chắc chắn có rất nhiều món ngon nhỉ? Còn có cả trò chơi nữa, hi hi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070375,
					"content": "...Tuyệt quá, cảm ơn các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070376,
					"content": "Nếu đi bây giờ chắc là vẫn kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070377,
					"content": "Đúng đó, hôm nay hình như là ngày cuối cùng nhỉ? Còn chờ gì nữa, mau đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070357,
					"content": "Không phải lỗi do Ayaka đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}