			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "Đây chính là nơi ở của cao nhân sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070102,
					"content": "Ưm...sao cảm giác ớn lạnh thế nhỉ...thật sự có người sống ở đây ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070103,
					"content": "Tôi...tôi cũng cảm thấy khá bất ngờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070104,
					"content": "Kỳ lạ, trong sổ tay nói đúng là nơi này, lẽ nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070105,
					"content": "Có lẽ chúng ta nhầm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "Ừm...tôi cũng không chắc lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070108,
					"content": "Nhưng nếu đã đến đây rồi, tôi nghĩ chúng ta vẫn nên đi vào tìm hiểu xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070109,
					"content": "Ừm, cũng có lý, ngộ nhỡ có gì đó bất ngờ thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070110,
					"content": "Phải rồi, trong sổ tay nói như thế nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070111,
					"content": "Để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070112,
					"content": "\"Hạc ngậm <color=#00E1FFFF>1</color> đóa hoa trang trí, thỏ trắng lấy <color=#00E1FFFF>4</color> mảnh trăng may thành chiếc váy. Tôi ăn diện đẹp đẽ, <color=#00E1FFFF>quay về phía đông</color> hô to <color=#00E1FFFF>7</color> tiếng Tsubaki, chớp mắt là đã ở trên con đường nhỏ dẫn đến nhà cô ấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070113,
					"content": "Nghe như chuyện cổ tích vậy...Lẽ nào chỉ cần làm như vậy, Tsubaki sẽ đến đón mẹ của bạn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070114,
					"content": "Càng lúc càng giống tiên nhân rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "Cứ cảm thấy giống như ám hiệu gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070116,
					"content": "Chúng ta lại gần một chút rồi phán đoán tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070117,
					"content": "Ừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070106,
					"content": "Không chắc đó là sứ thần hồ ly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
			"completionStepIds": [
				1200705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
