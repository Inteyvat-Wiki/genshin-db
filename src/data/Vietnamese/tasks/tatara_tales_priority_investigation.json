			"dialogs": [
				{
					"id": 721150301,
					"content": "Bạn đặt đèn hiệu xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150302,
					"content": "Đặt xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "Cảm ơn bạn, cứ để chúng từ từ thu thập dữ liệu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150304,
					"content": "Sao bạn lại biết những nơi đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "Tôi cũng có tham gia thiết kế \"Lò Luyện Mikage\", đặt đèn hiệu ở những vị trí đó sẽ thu thập được dữ liệu ở hầu hết các khu vực của \"Lò Luyện Mikage\".",
					"roleType": "TALK_ROLE_NPC",
