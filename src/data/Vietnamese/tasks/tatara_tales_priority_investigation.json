			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "#{NICKNAME}, thật vinh hạnh! Về \"Lò Luyện Mikage\", tôi có một tin tốt và một tin xấu, bạn muốn nghe tin nào trước?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150102,
					"content": "Tin tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "Tin tốt là, phần lõi lò chỉ bị hư hỏng nhẹ có vẻ không quá nghiêm trọng, và việc xử lý nó vẫn nằm trong khả năng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150104,
					"content": "Nhưng tin xấu là, Đám Fatui đang quanh quẩn bên trong không vui vẻ tiếp nhận tin tốt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150105,
					"content": "Hình như chúng còn không ngừng tìm kiếm cách chiếm lấy hạt nhân Họa Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150111,
					"content": "Cứ để chúng quanh quẩn ở đó đi, sức mạnh của Họa Thần sớm muộn cũng sẽ mất kiểm soát, sau đó sẽ làm nổ banh cả hòn đảo này và cả chúng ta nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150112,
					"content": "Nhưng nếu chúng ta chỉ chú ý đến Fatui bên này, thì Họa Thần tích lũy trong khiên sớm muộn gì cũng sẽ đạt đến giới hạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150113,
					"content": "Vì vậy chúng ta cần đồng thời đối phó cả hai bên?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "Ừm...nói thẳng ra là vậy, còn theo quan điểm học thuật, khách quan mà nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150115,
					"content": "Tình hình bây giờ là trước mắt chúng ta có hai vấn đề lớn đó là Fatui và Họa Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150116,
					"content": "Nhưng theo tình hình hiện tại của \"Lò Luyện Mikage\", nếu chúng ta muốn giải quyết một trong hai vấn đề này, thì trên thực tế, khả năng cao là chúng ta cũng phải đối mặt với vấn đề còn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150117,
					"content": "Vì vậy, tình hình thực tế mà chúng ta phải đối mặt là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150118,
					"content": "Bạn nói \"đúng\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "Ừm, đúng vậy. Chúng ta phải đối phó với cả hai cùng một lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150120,
					"content": "Nhưng chúng ta cứ làm từng bước một, chẳng phải người Liyue thường nói \"vội vàng thì không ăn được đậu phụ nóng\" sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150121,
					"content": "Bạn còn biết cả tục ngữ Liyue sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "Trước đây tôi cũng từng đến Liyue, tôi coi đây là đồ lưu niệm của cuộc hành trình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150123,
					"content": "Tôi còn rất nhiều đồ lưu niệm như vậy, nhưng đồ lưu niệm của Mondstadt tôi đã uống hết mất rồi...hương vị vô cùng tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150124,
					"content": "Được rồi, chúng ta quay về vấn đề chính đi. Để xử lý \"Lò Luyện Mikage\", tôi có một kế hoạch nhỏ cần bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150125,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "À há! Tôi thích...tính cách thẳng thắn này của bạn, quá tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150131,
					"content": "Ừm, chúng ta quay lại vấn đề chính đi. Hãy cầm lấy số \"đèn hiệu do thám\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150132,
					"content": "Tôi muốn nhờ bàn đặt số \"đèn hiệu do thám\" này ở một vài vị trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150133,
					"content": "Những đèn hiệu này có thể thu thập dữ liệu về mật độ và phân bố sức mạnh của \"Họa Thần\" trong \"Lò Luyện Mikage\", chỉ cần có dữ liệu này, tôi sẽ có thể lên kế hoạch chi tiết hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150134,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "Vậy thì nhờ cả vào bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150141,
					"content": "Tôi đã đánh dấu những vị trí đặt lên bản đồ cho bạn, trông cậy cả vào bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150136,
					"content": "Nguyên lý của đèn hiệu này rốt cuộc là gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "Nói một cách đơn giản...là một loại nguyên lý thiên về sức mạnh nguyên tố, là dụng cụ định lượng các dạng năng lượng khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150138,
					"content": "\"Nói một cách đơn giản\"...Tuy tôi muốn nói vậy, nhưng cơ chế của nó thì không thể giải thích đơn giản như vậy được. Đúng rồi, bắt đầu từ bảy loại nguyên tố đi! Là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150139,
					"content": "Không, không cần nói đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "Thôi được, theo ý bạn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150127,
					"content": "Tôi sẽ được lợi ích gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "Lợi ích sao...đương nhiên là kho báu chưa được phát hiện trên hòn đảo này, và \"nguyên liệu thừa\" trong \"Lò Luyện Mikage\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150129,
					"content": "Bạn xem, thân là xưởng rèn lớn nhất Inazuma, bên trong \"Lò Luyện Mikage\" chắc chắn có...ừm...thứ đáng phải xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150130,
					"content": "Đương nhiên! Là một người không có Vision, tôi không thể vào \"Lò Luyện Mikage\", tình hình bên trong tôi cũng không thể biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150106,
					"content": "Tin xấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "Tin xấu là, đám Fatui đó vẫn đang quanh quẩn bên trong \"Lò Luyện Mikage\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150108,
					"content": "Hình như chúng còn không ngừng tìm kiếm cách chiếm lấy hạt nhân Họa Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150109,
					"content": "Tuy vậy tin tốt là, phần lõi lò chỉ bị hư hỏng nhẹ không quá nghiêm trọng, và việc xử lý nó vẫn nằm trong khả năng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150110,
					"content": "Nhưng rõ ràng Fatui không hề vui vẻ tiếp nhận tin tốt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				}
			]
		},
