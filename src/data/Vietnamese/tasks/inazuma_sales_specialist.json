			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "Thời buổi này làm ăn khó khăn quá, những thứ mà mình bán đều là hàng chất lượng cao mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360102,
					"content": "Nhưng tại sao không có mấy ai đến mua nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360103,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "Là bạn sao nhà lữ hành. Haiz...đừng nhắc nữa, các loại phân bón trong tiệm càng ngày càng ế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360105,
					"content": "Không phải có Alrani giúp đỡ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "Cô ấy đúng là có giúp đỡ chút, nhưng vấn đề là cả hai chúng tôi đều không biết quảng bá như thế nào, chỉ có thể ngồi yên trong tiệm chờ khách đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360107,
					"content": "Nhưng tình hình ở Đảo Ritou như bạn cũng biết rồi đó, ở đây không có nhiều khách lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360108,
					"content": "Cho nên tôi đã đến thương hội để thỉnh giáo, họ đề nghị tôi nên \"quảng cáo\" một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360109,
					"content": "Cụ thể là, nói chuyện về hiệu quả phân bón nhiều hơn cho khách, đưa ra thêm văn bản chất lượng sản phẩm, kèm theo chương trình \"dùng thử\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360110,
					"content": "Nhưng mà...tôi không biết làm mấy cái \"cao siêu\" này lắm, với lại phân bón này cũng không phải do tôi nghiên cứu ra, nên cũng không biết phải nói thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360111,
					"content": "Nhưng mà, dù cho phải cầm sách hướng dẫn đi nữa thì giờ tôi cũng phải đi xung quanh để quảng cáo thử rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360112,
					"content": "Alrani cũng đã ra ngoài để quảng cáo rồi, tôi cũng sẽ đi theo. Nhà lữ hành, bạn có thể giúp tôi quảng cáo được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360113,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "Thật tốt quá! Vậy tôi trông cậy vào bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360115,
					"content": "Chỗ bạn cần phải đi là Làng Konda, cách đây không xa lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360119,
					"content": "Ở đó có một người tên là Konda Densuke, rất có hứng thú với phân bón của tiệm, trước đó ông ấy cũng đã đến tiệm để hỏi thăm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360120,
					"content": "Nếu như có thể mang chút hàng đến chỗ ông ấy quảng cáo rồi cho \"dùng thử\", không chừng ông ấy sẽ mua thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360116,
					"content": "Vậy Alrani đã đi đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "Cô ấy nói là tiện đường nên đi lấy chút đồ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360118,
					"content": "Chỗ bạn cần phải đi là Làng Konda, cách đây không xa lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				}
			]
		},
