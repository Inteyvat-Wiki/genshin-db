			"dialogs": [
				{
					"id": 220360201,
					"content": "Về hướng dẫn sử dụng của phân bón...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "À à, tôi vẫn chưa nói với bạn, phân bón này có cách sử dụng đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "Để tôi xem...theo như trong sổ tay hướng dẫn thì điều đầu tiên cần làm là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "Đầu tiên phải cho phân bón vào trong <color=#37FFFF>nước</color>, sau đó cho thêm <color=#37FFFF>lá vụn</color>, sau cùng <color=#37FFFF>trộn đều</color> rồi đổ vào ruộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "Đừng nhớ nhầm nhé, nếu không lỡ có xảy ra việc ngoài ý muốn là gây ảnh hưởng xấu đến trải nghiệm của khách đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "Tôi nhớ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "Vậy thì giao cho bạn nhé, sau khi giao \"Kiến Thức Màu Mỡ\" cho khách, khoản tiền đầu tiên mà khách trả sẽ là thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "Bạn nói lại nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "Đầu tiên phải cho phân bón vào trong <color=#37FFFF>nước</color>, sau đó cho thêm <color=#37FFFF>lá vụn</color>, sau cùng <color=#37FFFF>trộn đều</color> rồi đổ vào ruộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "Nhờ vào bạn nhé nhà lữ hành...chúng ta cùng cố gắng, hy vọng doanh thu tháng này sẽ khởi sắc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
