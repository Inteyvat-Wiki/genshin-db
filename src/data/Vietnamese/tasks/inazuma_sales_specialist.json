					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360505
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360505,
					"content": "Ông nghe nói ở Đảo Ritou có một tiệm phân bón khá độc đáo, nên đã đi hỏi thăm chủ tiệm Vahid để xem có thể dùng thử phân bón đó không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360506
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360506,
					"content": "Nếu hữu dụng thì hoa màu ở đây sẽ đạt năng suất cao, vực dậy được tình hình kinh tế của Làng Konda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360507
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360507,
					"content": "Haiz, việc vực dậy kinh tế cũng phải nhờ đến người già như ông, thanh niên trong làng này...thật không có tiền đồ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360508
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360508,
					"content": "Được rồi, cháu mau nói xem loại phân bón này dùng như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360509,
					"content": "Đầu tiên cho nước vào, thêm lá vụn, rồi trộn đều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "Nhiều bước thật đấy...được rồi, ông nhớ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360510,
					"content": "Đầu tiên cho lá vụn vào, rồi trộn đều, cuối cùng cho thêm nước.",
