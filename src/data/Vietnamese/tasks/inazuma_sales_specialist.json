					"nextDialogs": [
						220360402
					]
				},
				{
					"id": 220360402,
					"content": "À à, tôi vẫn chưa nói với bạn, phân bón này có cách sử dụng đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360403
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360403,
					"content": "Để tôi xem...theo như trong sổ tay hướng dẫn thì điều đầu tiên cần làm là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360404
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360404,
					"content": "Đầu tiên cho <color=#37FFFF>lá vụn</color> vào phân bón, sau đó cho <color=#37FFFF>nước</color> vào, sau cùng <color=#37FFFF>trộn đều</color> rồi đổ vào ruộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360405
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360405,
					"content": "Đừng nhớ nhầm nhé, nếu không lỡ có xảy ra việc ngoài ý muốn là gây ảnh hưởng xấu đến trải nghiệm của khách đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360406,
						220360408
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360406,
					"content": "Tôi nhớ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360407
					]
				},
				{
					"id": 220360407,
					"content": "Vậy thì giao cho bạn nhé, sau khi giao \"Kiến Thức Màu Mỡ\" cho khách, khoản tiền đầu tiên mà khách trả sẽ là thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360408,
					"content": "Bạn nói lại nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360409
					]
				},
				{
					"id": 220360409,
					"content": "Đầu tiên cho <color=#37FFFF>lá vụn</color> vào phân bón, sau đó cho <color=#37FFFF>nước</color> vào, sau cùng <color=#37FFFF>trộn đều</color> rồi đổ vào ruộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360410
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360410,
					"content": "Nhờ vào bạn nhé nhà lữ hành...chúng ta cùng cố gắng, hy vọng doanh thu tháng này sẽ khởi sắc!",
