						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "Haha, vậy thì không khách sáo nữa nhé! Cất vào ngăn phụ trong ba lô kho báu thôi, biết đâu lúc nào đó sẽ có thể dùng được đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
