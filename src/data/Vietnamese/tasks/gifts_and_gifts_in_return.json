			"dialogs": [
				{
					"id": 750350101,
					"content": "Xin hỏi... Ờm, anh là Kulahaw phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350102,
					"content": "Đó quả thật là tên của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350103,
					"content": "Hihi, thì ra anh chính là bậc thầy đá quý đang đi tìm cảm hứng! Chúng tôi được Imix giới thiệu tới đây! Ban nãy thấy anh đang nhìn chăm chú vào cái cây, lẽ nào cũng là đang tìm cảm hứng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350104,
					"content": "Ờm, thật ra... Thôi bỏ đi, bây giờ đã không còn quan trọng nữa rồi. Haiz, mọi người có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350105,
					"content": "#Chúng tôi có một viên đá quý rất đẹp, muốn nhờ anh giúp {REALNAME[ID(2)|SHOWHOST(true)]} của chúng tôi gia công một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350106,
					"content": "#Hihi, {REALNAME[ID(2)|SHOWHOST(true)]}, mau lấy đá quý ra đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350107,
					"content": "Rawr... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350109,
					"content": "#Tiếng vỗ cánh vang lên bên tai...\\nĐợi đến khi kịp phản ứng thì viên đá quý nằm trong vuốt của {REALNAME[ID(2)|SHOWHOST(true)]} đã không còn tăm hơi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "Raaaaah! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Ối! Đợi đã, đá quý đâu? Viên đá quý lớn đâu mất rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350112,
					"content": "Hình như bị chim gắp đi rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "Sao lại như thế, chim chóc ở đây còn ăn cướp nữa à? Thật bất lịch sự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350114,
					"content": "Roar... Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "Thật ra ban nãy tôi muốn nói chuyện này đó. Cho dù đá quý không bị cướp mất thì tôi cũng không thể gia công được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350116,
					"content": "Bởi vì đồ nghề của tôi cũng bị bầy chim đáng ghét đó cướp mất rồi! Ban nãy tôi xem từng con một, coi thử đồ nghề của tôi đang ở trong móng vuốt của con chim nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350117,
					"content": "#Còn có chuyện như vậy à? Đám chim xấu xa thật đó! {NICKNAME}, chúng ta mau đuổi theo lấy lại đá quý đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350118,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "Đừng quên còn có đồ nghề của tôi nữa nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
			]
		},
