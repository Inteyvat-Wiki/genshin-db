				{
					"id": 750350807,
					"content": "#Ồ? {F#Cô}{M#Cậu} cũng nghe nói về việc tìm cảm hứng rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
