						750351214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351214,
					"content": "#Cả hai quay người lại, chỉ nghe thấy tiếng leng keng không ngừng vang lên.\\nKhông biết {REALNAME[ID(2)|SHOWHOST(true)]} đang làm gì...\\nQua một hồi sau, {REALNAME[ID(2)|SHOWHOST(true)]} kêu lên \"Rawr rawr!\". Có lẽ đã đến lúc phải quay người lại rồi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "Woa, xuất hiện nhiều thứ quá!",
