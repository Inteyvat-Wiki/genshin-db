					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "Ôi mừng quá, tặng đúng quà rồi... Cẩn thận đấy, đừng làm rơi xuống đất nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351236,
					"content": "#...Cứ cảm thấy {REALNAME[ID(2)|SHOWHOST(true)]} cầm nó như vậy thì sẽ sớm làm mất thôi.",
