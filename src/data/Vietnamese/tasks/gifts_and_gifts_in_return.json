			"dialogs": [
				{
					"id": 750350401,
					"content": "Chào mừng ghé thăm! Nếu muốn gia công đá quý thì đến tiệm này là tìm đúng chỗ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350402
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350402,
					"content": "#Xin chào, {F#hai chị}{M#anh chị} có một viên đá quý muốn gia công để làm quà tặng cho Tepetlisaur nhỏ. Chính là viên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350403,
					"content": "Ối! Viên đá quý này, thật là hiếm thấy đó! Vừa lớn vừa trong suốt. Chỉ là nếu muốn gia công thì sẽ hơi khó thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350404
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350404,
					"content": "Lời thoại nghe quen tai ghê. Vậy tiếp theo là gì, cần phải trả thêm Mora sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350405,
					"content": "Không không, em đâu thể làm thế được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350406
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350406,
					"content": "Cửa tiệm này chuyên gia công đá quý. Nếu như gặp được viên đá tốt thì em thà không thu tiền cũng muốn mài giũa cho nó đẹp đẽ, để cho tên tuổi của mình được lưu truyền cùng với viên đá. Không có chuyện tính giá cao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350407
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350407,
					"content": "Nhưng cũng giống như một người thợ giỏi cần nguyên liệu tốt, một viên đá quý tốt cũng cần một người thợ phù hợp. Em biết một \"bậc thầy đá quý\", thầy ấy rất phù hợp để gia công viên đá này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350408
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350408,
					"content": "Ghê gớm vậy sao! Vậy mau mời anh ấy ra đây đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350409,
					"content": "Nhưng nếu muốn tìm thầy ấy thì có lẽ phải hẹn trước. Nếu như không hẹn trước thì thông thường thầy ấy đều sẽ ra bên ngoài tìm kiếm cảm hứng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350410
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350410,
					"content": "Tìm cảm hứng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350411
					]
				},
				{
					"id": 750350411,
					"content": "Phải đó! Sư phụ Kulahaw là một thợ gia công khá đặc biệt, thầy ấy cho rằng thợ thủ công không thể chỉ đơn giản là mài giũa theo bản vẽ, mà còn phải giỏi quan sát mọi cảnh đẹp trong thiên nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350412
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350412,
					"content": "Ví dụ như có thể học kỹ xảo đánh bóng từ làn sóng lăn tăn trong hồ nước, học các mẫu hoa văn từ áng mây... Thầy ấy nói đây được gọi là lấy cảm hứng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350413
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350413,
					"content": "Phức tạp quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350414,
					"content": "#Nhưng nếu {F#hai chị}{M#anh chị} cần gấp thì đến nơi lấy cảm hứng tìm thầy ấy nhé! Trước đó hình như thầy ấy nói muốn đi tới nơi này thì phải, để em đánh dấu cho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
