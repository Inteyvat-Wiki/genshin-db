						750351223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351221,
					"content": "Còn cành cây này thì thật tuyệt vời!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351222
					]
				},
				{
					"id": 750351222,
					"content": "Đúng! Cảm giác nó sẽ uy nghiêm như một thanh kiếm khi cầm trên tay và vung lên vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
