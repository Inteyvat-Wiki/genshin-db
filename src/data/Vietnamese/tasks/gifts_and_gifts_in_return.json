					"nextDialogs": [
						750351217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351217,
					"content": "#Những thứ này là nhóc tự mình thu thập sao? Định tặng cho ta và {NICKNAME} à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351218,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351219,
					"content": "Nhưng đồ ăn để lâu rồi thì không ăn được đâu. Dù là ai đi nữa thì ăn vào cũng sẽ bị đau bụng đó, nên là phải xử lý chúng trước đã...",
