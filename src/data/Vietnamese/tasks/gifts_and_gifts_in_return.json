			"dialogs": [
				{
					"id": 750350801,
					"content": "Ối, đồ nghề của tôi quay lại rồi! Thật là tốt quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350802,
					"content": "Ban nãy tôi chưa nhìn rõ, đây quả là một viên đá quý đẹp đẽ. Nó có màu vàng óng ánh giống như móng vuốt của chim vậy... Chậc! Không nên lấy đám xấu xa đó ra làm ẩn dụ mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350803,
					"content": "Như màu trời lúc bình minh vừa lên hay mặt trời vừa ló dạng... Ừm, hình dung thế này cũng được lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350804,
						750350806
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350804,
					"content": "Phép ẩn dụ này không \"bậc thầy\" lắm nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350805
					]
				},
				{
					"id": 750350805,
					"content": "Tôi đâu phải người kể chuyện, chỉ cần ghi nhớ được màu sắc đẹp đẽ trong tự nhiên là tốt rồi... Nói sao cho hay thì đâu phải là chuyên môn của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350808,
					"content": "#Giao đá quý cho tôi đi. Tôi sẽ gia công miễn phí cho {F#cô}{M#cậu}, coi như quà cảm ơn vì đã giúp tôi tìm lại đồ nghề. Còn về thời gian thì... Đợi hai ngày nữa đến tiệm đá quý lấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350806,
					"content": "Đây chính là ý nghĩa của việc \"tìm cảm hứng\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350807
