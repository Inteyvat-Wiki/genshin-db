					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351233,
					"content": "#Tada! Một viên đá quý lấp lánh, {REALNAME[ID(2)|SHOWHOST(true)]} có thích không?",
