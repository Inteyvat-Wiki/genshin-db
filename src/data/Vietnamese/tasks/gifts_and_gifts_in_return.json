				]
			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "#{F#Hai chị}{M#Anh chị} đến rồi à. Sư phụ Kulahaw đã để lại đá quý gia công xong bên trong tiệm rồi, còn dặn em phải tự tay giao cho {F#hai chị}{M#anh chị} nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "Hửm? Kulahaw hôm nay cũng không có ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "Đúng vậy. Sư phụ lại ra ngoài tìm cảm hứng rồi, còn làm một bộ ổ khóa có thể mang trên lưng, nói là để tránh bị trộm mất đồ nghề... Kỳ lạ, có ai muốn ăn cắp đồ nghề của tiệm chúng em đem bán sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "Tất nhiên là không rồi! Chỉ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(Thì ra Imix còn chưa biết chuyện bị chim cướp đồ... Thôi thì giữ chút thể diện cho anh ta vậy!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "Chắc... Chắc là có người cảm thấy dùng cách này sẽ có thể học lén tay nghề nhỉ, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "#Thôi kệ đi... Vậy {F#hai chị}{M#anh chị} nhận lại viên đá quý nhé! Đẹp thật đó, quả không hổ danh là \"bậc thầy\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#Xem ra {REALNAME[ID(2)|SHOWHOST(true)]} cũng thích lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "#Tôi thay mặt {REALNAME[ID(2)|SHOWHOST(true)]} cảm ơn mọi người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Hihi, chỉ cần bé Saurian thích là được rồi. Em sẽ chuyển lời cảm ơn cho sư phụ Kulahaw, mọi người nhớ ghé đến thường xuyên nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
