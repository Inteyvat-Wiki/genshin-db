			"dialogs": [
				{
					"id": 726720401,
					"content": "Thế nào, tấm lưới này có dễ sử dụng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720402,
					"content": "Dùng một lần đã hỏng mất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "Ừm...cũng không còn cách nào khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720404,
					"content": "Tôi từng nói rồi, thuật này có thể bắt hồn bọn thú nhỏ, nhưng nếu muốn giữ lại phần hồn đó, hoặc tái tạo hình dạng bọn thú nhỏ một lần nữa, thì vẫn cần một thứ làm trung gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720405,
					"content": "Tôi kết hợp thuật này vào \"Thiên La Địa Võng\", trung gian của việc giữ lại phần hồn và tái tạo hình thể chính là bản thân tấm lưới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720406,
					"content": "Phức tạp quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "Nói một cách đơn giản là tấm lưới này chỉ dùng được một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720408,
					"content": "Đây cũng là vấn đề mà đến giờ tôi vẫn chưa giải quyết được, nếu không thể tái sử dụng thì chi phí quá cao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720409,
					"content": "Tôi sẽ tiếp tục nghiên cứu tấm lưới này, tranh thủ nhanh chóng giải quyết vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720410,
					"content": "Nếu bạn còn cần \"Thiên La Địa Võng\" thì hãy đến tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720411,
					"content": "Còn nữa, chuyện là...tuy rằng lưới này hiện tại chỉ có thể bắt các động vật nhỏ, nhưng để làm ra nó thật ra cũng rất phiền phức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720412,
					"content": "Cho nên...hì hì, lần sau bạn cần loại lưới này nữa, thì phải trả cho tôi ít \"tiền vốn\" nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720413,
					"content": "Yên tâm! Bạn là bạn của Sango, tôi không tính giá mắc đâu, nhất định sẽ cho bạn mức giá hợp lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				}
			]
		},
