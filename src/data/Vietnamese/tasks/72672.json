				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "Wakamurasaki thật là... đúng là không nên để cô ấy biết chuyện của Kageroumaru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "Nhà Lữ Hành, là bạn à. Bạn có nhớ \"Lưới Bắt Thú\" không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720104,
					"content": "Sau khi tôi giải quyết xong chuyện lần trước, tôi có kể câu chuyện của bạn cho bạn của tôi nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720105,
					"content": "Cô ấy tên Wakamurasaki, là một...ừm...cô ấy nói mình là \"nhà thiết kế\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720106,
					"content": "Wakamurasaki sau khi nghe nói cách bạn sử dụng tấm lưới này thì có vẻ như rất hứng thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720107,
					"content": "Cô ấy cứ bám riết lấy tôi, muốn tôi giúp cô ấy tìm vài thuật mới, tiện cho cô ấy cải tiến \"Lưới Bắt Thú\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720108,
					"content": "Tôi thật sự hết cách, buộc phải lục sách cổ tìm cho cô ấy một thuật mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720109,
					"content": "Nhà Lữ Hành, nếu bạn có hứng thú thì đến chỗ Wakamurasaki xem xem, chắc là cô ấy đã cải tiến xong tấm lưới đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
