			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wakamurasaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "Vậy là sắp xong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720202,
					"content": "Xin hỏi cô có phải là Wakamurasaki không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "Là tôi đây, bạn tìm tôi có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720204,
					"content": "Về chuyện \"Lưới Bắt Thú\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "Ồ? Tôi nhớ ra rồi, bạn là Nhà Lữ Hành đúng không? Sango từng nhắc đến bạn với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720206,
					"content": "Cách bạn thao tác \"Lưới Bắt Thú\" thật sự rất tuyệt, và nó mang lại cho tôi rất nhiều cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720207,
					"content": "Nghe nói bạn đang cải tiến nó đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "Đúng vậy. Hihi...Sango đã cho tôi thuật Onmyoudou hoàn toàn mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720209,
					"content": "Tôi dùng thuật đó cải tiến tấm lưới một lần nữa, bây giờ tên của tấm lưới này là \"Thiên La Địa Võng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720210,
					"content": "Theo Sango nói, thuật này có thể bắt hồn của sinh vật sống, rồi sử dụng một số vật thể làm trung gian để tái tạo hình dạng của sinh vật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720211,
					"content": "Cô ấy còn nói, nếu phát triển thuật Onmyoudou đến cực hạn, thậm chí sẽ có thể tái tạo hình dạng của con người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720212,
					"content": "Cơ thể người được tái tạo có thể trả lời câu hỏi, và tuyệt đối sẽ không nói dối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720213,
					"content": "Đối với một thám tử như Sango mà nói, thuật này có thể coi là công cụ mạnh nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720214,
					"content": "Tôi nghĩ cô ấy cũng vì lý do này mới đồng ý cho tôi thuật này để tôi cải tiến lưới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720215,
					"content": "À! Bạn đừng nói lung tung nha! Bởi vì bạn là bạn của Sango, nên tôi mới nói với bạn những chuyện này thôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720216,
					"content": "Mạnh, mạnh vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "Chậc... tạm thời vẫn chưa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720219,
					"content": "Dù tôi có dùng cách nào để cải tạo thì tấm lưới này cũng chỉ có thể bắt được bọn thú nhỏ, với con người thì một chút cũng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720220,
					"content": "Nhà Lữ Hành, bạn cũng thử tấm lưới này xem, nói không chừng...cách bạn sử dụng nó sẽ một lần nữa cho tôi ý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720221,
					"content": "Này, cho bạn đó, bây giờ tấm lưới này có tên là \"Thiên La Địa Võng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720222,
					"content": "Bạn mau dùng tấm lưới này thử bắt bọn thú nhỏ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720217,
					"content": "Cải tiến thành công rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
