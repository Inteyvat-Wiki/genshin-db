				{
					"id": 726720503,
					"content": "\"Thiên La Địa Võng\"...Cái tên này hay đó, nhưng thuật kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720504,
					"content": "Thuật kia có thể bắt hồn người thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Ừm...không thể được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720506,
					"content": "Loại Onmyoudou chỉ có ghi chép, cách thi triển cụ thể thì đã thất truyền không biết bao lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720507,
					"content": "Thuật tôi cho Wakamurasaki chỉ có thể bắt hồn bọn thú nhỏ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720508,
					"content": "Vậy sao cô còn nói với Wakamurasaki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Chuyện này à. Tôi chỉ muốn để Wakamurasaki giúp tôi tung ra một tin thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720510,
					"content": "\"Hội trưởng của trụ sở thám tử Bantan Sango, đang nhờ người lấy Onmyoudou của Kamuna làm trung tâm, nghiên cứu chế tạo ra một loại lưới bắt mọi người nói sự thật.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720511,
					"content": "Kamuna Onmyoudou thất truyền đã lâu, trụ sở thám tử Bantan Sango, và cả tấm lưới thật sự có thể bắt hồn bọn thú nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720512,
					"content": "Sự kết hợp của những yếu tố này đủ để tạo thành một \"huyền thoại đường phố\" nghe rất lợi hại và cảm giác rất thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720513,
					"content": "Mặc dù \"huyền thoại đường phố\" này chỉ là một câu chuyện nhỏ đối với người bình thường...nhưng đối với những phạm nhân có dã tâm thì không đơn giản chỉ là một câu chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720514,
					"content": "Ra là vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "Một lý do nữa là...ai bảo Wakamurasaki cứ quấy rầy tôi, kêu tôi cho cô ấy một \"Onmyoudou lợi hại nhất\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720516,
					"content": "Tôi đã nói không còn nữa, nhưng cô ấy không chịu nghe. Tôi thật sự hết cách, đành dùng Onmyoudou này để tiễn cô ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720517,
					"content": "Nếu Wakamurasaki không nói chuyện này với ai thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "Không đâu, từ trước đến nay cô ấy không biết giữ bí mật. Tôi hiểu cô ấy quá mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720519,
					"content": "Vất vả cho bạn rồi, những thứ này cho bạn, xem như thù lao đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720520,
					"content": "Hy vọng Wakamurasaki sẽ không tìm tôi để đòi thuật Onmyoudou mới nữa, tôi là thám tử, chứ có phải là Onmyoji đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
