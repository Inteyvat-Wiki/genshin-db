					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111302,
					"content": "Tình hình sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "Không, chẳng có tác dụng gì. Khi lũ Hải Âu Tử Kim lao về chỗ đồ ăn thì nó trốn ra sau lưng tôi run lẩy bẩy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111305,
					"content": "Haiz, cũng khó trách. Con chó này từ khi sinh ra chỉ có một trách nhiệm là yêu thương người khác và được người khác yêu thương... Nó chưa từng được học cách tấn công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111306,
					"content": "Chúng ta cũng có thứ trách nhiệm này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "Có lẽ vậy. Nhưng trong một số tình huống, tình yêu sẽ được coi là quyền lực. Chỉ cần dính dáng đến quyền lực thì mọi chuyện sẽ theo hướng tồi tệ hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111308,
					"content": "Xin lỗi, tôi nói hơi nhiều rồi. Mấy ngày nay phải xử lý rất nhiều việc liên quan đến tranh chấp tình cảm, suy nghĩ vẫn chưa ổn định lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111309,
					"content": "Haiz, nhiệm vụ cấp bách hiện tại là làm sao để ăn hết phần khoai tây này một cách yên bình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111303,
					"content": "Chó con có giúp ích gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
