			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Hải Âu Tử Kim ơi Hải Âu Tử Kim. Ta biết các ngươi rất đói, nhưng ta cũng chưa ăn no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Thôi bỏ đi. Nếu như vậy có thể giúp các ngươi vui thì cũng được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "Anh đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "Nhà Lữ Hành? Rất vui được gặp bạn. Nếu đến tìm tôi để lo việc thì phải đợi một chút, tôi vẫn chưa ăn xong khoai tây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "Tôi không đến để giải quyết công việc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Vậy sao. Vậy thì tốt, tôi phải tranh thủ ăn hết phần khoai tây này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "Đây là bữa chính của tôi. Hôm nay phải ra ngoài lo công việc với ngài Roialte, nên chỉ có thể lót dạ bằng thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "Tôi không quen ăn uống trong Palais Mermonia, nên thường ra ngoài tìm nơi yên tĩnh để ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "Nhưng hôm nay lũ Hải Âu Tử Kim này không biết bị gì, cứ lao tới cướp khoai tây của tôi, ăn bao nhiêu cũng không đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Vì còn rất nhiều Hải Âu Tử Kim muốn ăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "Được rồi, cũng có lý. Nhưng tôi không thể cho tất cả Hải Âu Tử Kim ăn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Thì khoai tây là của anh mà? Đừng để chúng ăn tự nhiên như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "Như vậy thì anh sẽ phải nhịn đói đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "Trông anh có chút ủ rũ nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Sao cơ? À ừm... Thì cũng có đôi chút không ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "Tôi không biết ý nghĩa công việc của mình là gì. Tuy suốt ngày cặm cụi trong Sảnh Phúc Luật, nhưng lại chẳng có thành quả gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "Chẳng giúp được người nào, cũng chẳng đem lại lợi ích cho ai. Tuy ngài Roialte cứ nói công việc của tôi rất quan trọng, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "Mỗi ngày chỉ ngồi trước máy đánh chữ thì có tác dụng gì chứ? Thà tôi lại làm mất phím bấm thì Estelle còn kiếm được một ít...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Xin lỗi, tôi không nên nói nhiều như vậy, chỉ là hơi mất phương hướng thôi. Có lẽ... tôi cần thêm thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Tóm lại, ăn no trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Cũng đúng. Nhưng mà bây giờ... tôi không kịp mua thêm phần khoai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Thôi bỏ đi, chia khoai tây cho lũ Hải Âu Tử Kim vậy. Đợi tôi và ngài Roialte xử lý xong việc rồi mua chút gì ăn là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "Cũng chỉ... hmm... tầm nửa ngày là xong, không lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "Không ăn uống gì lâu như vậy, có chịu được không đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Lũ Hải Âu Tử Kim này cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Phiền bạn quá! Chỉ là phần khoai tây thôi mà, không cần phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "Ăn đi, không nên để bụng đói mà làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "Để tôi xử lý lũ Hải Âu Tử Kim này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Tóm lại, giải quyết vấn đề Hải Âu Tử Kim trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "Trông anh có vẻ... không được ổn nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Đâu phải con nào cũng được ăn khoai tây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "Sao anh lại ăn khoai tây ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
