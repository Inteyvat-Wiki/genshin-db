			"dialogs": [
				{
					"id": 240111201,
					"content": "Hừm... Đổi chỗ khác để ăn nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "Tạm thời tôi cũng chưa tìm được chỗ nào phù hợp để ăn. Nếu ở gần Palais Mermonia thì sẽ bị đồng nghiệp bắt gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111203,
					"content": "Sau đó họ sẽ kéo tôi lại, vừa ăn vừa bàn công việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111204,
					"content": "Nếu ở xa Palais Mermonia quá tôi lại không thể về văn phòng kịp, không chừng sẽ lỡ mất việc quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111205,
					"content": "Cân nhắc hai điểm này thì chỉ có chỗ này là tôi có thể yên tâm dùng bữa thôi.",
					"roleType": "TALK_ROLE_NPC",
