					}
				]
			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "Hihi! Dodoco đã đánh bại cả đám Lính Cá Sừng xấu xa rồi! Ngay cả Vua Cá Sừng cũng không đấu lại luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360102,
					"content": "Tổ hợp của Dodoco, Bom Nảy và Tia Lửa Mãnh Liệt là lợi hại nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360103,
					"content": "Là vô địch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "Khi chơi trò này, tôi thường nghĩ đến chuyện của Hồ Rượu Trái Cây... Chẳng lẽ Lisa đã tạo ra trò chơi này từ chủ đề đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360106,
					"content": "Nhưng kể ra thì, nếu không tìm được đám cá lạ đó thì cứ để Klee cho nổ hết số đá ngầm khả nghi, như vậy không phải là xong rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360107,
					"content": "Còn không được thì cứ cho chúng ta vài quả bom, là cũng xong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360108,
					"content": "Paimon với Klee đúng là ý tưởng lớn gặp nhau đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "Ừm, nhìn biểu cảm của mấy cưng, có vẻ rất tận hưởng trò chơi này nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360111,
					"content": "Chị Lisa, chị đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360112,
					"content": "Lisa, cô cuối cùng cũng đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360113,
					"content": "\"Hành Trình Bùng Nổ Của Dodoco\" mà Lisa thiết kế rất thú vị, chúng tôi và Klee chơi rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360114,
					"content": "Cảm ơn nhé. Vậy là phải thiết kế thêm phiên bản tiếp theo của trò chơi này rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360115,
					"content": "Tuyệt quá! Klee còn muốn xem... hành trình mạo hiểm ở nơi khác của Dodoco nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360116,
					"content": "Mà không đúng, Klee nhớ là chị Lisa đã tốn rất nhiều thời gian để làm ra trò chơi này, chắc là mệt lắm. Không thể để chị Lisa mệt như vậy được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360117,
					"content": "Ái chà, Klee quan tâm chị như vậy sao? Chị vui lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360118,
					"content": "Nếu như em thích trò chơi này và chịu ngoan ngoãn ở lại trong thành chơi, thì chị có tốn thêm bao nhiêu thời gian cũng đáng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360119,
					"content": "Tất nhiên chị cũng hiểu, được tự do đi mạo hiểm mới là điều em thích nhất, trò chơi này chỉ là món tiêu khiển mới mẻ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360120,
					"content": "Cho nên hôm nay chị mang đến cho mấy cưng một tin tốt và còn có cả quà nữa đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360121,
					"content": "Quà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360122,
					"content": "#À, em cũng có quà dành cho {M#anh}{F#chị} Kỵ Sĩ Danh Dự và Paimon này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360123,
					"content": "Quà thì để cuối cùng vậy, nói tin tốt trước nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360124,
					"content": "Vấn đề của Hồ Rượu Trái Cây đã xử lý xong rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "Đúng vậy. Hai kỵ sĩ của đội điều tra đã tìm được sào huyệt loài cá lạ, và loại bỏ chúng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360127,
					"content": "Còn về nguyên nhân loài cá đó đột nhiên xuất hiện thì Đội Kỵ Sĩ cũng đã điều tra ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360128,
					"content": "Sự cố lần này là do một thương nhân vô tình làm. Vì không có ác ý nên Đội Kỵ Sĩ chỉ bắt cô ấy nộp khoản tiền phạt tương ứng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360129,
					"content": "Phù... Cũng may là không gây ra ảnh hưởng gì lớn. Nhưng mà thương nhân đó cũng bất cẩn quá rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360130,
					"content": "Chất lượng nước của Hồ Rượu Trái Cây đã an toàn rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "Vậy giờ đã đến lúc công bố quà rồi nhỉ! Klee có thể công bố trước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360133,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360134,
					"content": "Chị cũng tò mò lắm. Bé Klee dạo này về nhà rất sớm, hoàn toàn không cần người khác nhắc nhở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360135,
					"content": "Hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360136,
					"content": "Buổi tối khi ở nhà, em đã xem quyển sổ của anh Albedo để vừa học vừa làm ra cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360137,
					"content": "Tada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360138,
					"content": "Đây là... Dodoco đang chuẩn bị ném Bom Nảy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360139,
					"content": "Đúng rồi! Klee đã mô phỏng vật dụng trong \"Hành Trình Bùng Nổ Của Dodoco\" để làm ra món đồ chơi Dodoco này đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360140,
					"content": "Tuy Dodoco này không thể ném bom, nhưng em cảm thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360141,
					"content": "#Chỉ cần nhìn thấy nó thì {M#anh}{F#chị} Kỵ Sĩ Danh Dự và Paimon sẽ nhớ đến những ngày tháng vui vẻ này, phiền não từ đó cũng sẽ bay đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360142,
					"content": "Món đồ chơi Dodoco! Đây đúng là một bất ngờ lớn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360143,
					"content": "Cảm thấy như lúc nào cũng có thể gặp được Klee và Dodoco rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360144,
					"content": "Cảm ơn nhé, Klee thật khéo tay!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "#Hihi, {M#anh}{F#chị} Kỵ Sĩ Danh Dự và Paimon thích quà của Klee, vậy là cố gắng của Klee đã thành công mỹ mãn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360147,
					"content": "Vậy quà của chị Lisa thì sao? Klee cũng muốn biết đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360148,
					"content": "Ừm, so với tấm lòng của Klee thì món quà của chị dĩ nhiên không bằng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360149,
					"content": "Cùng xem quyển sách \"Hành Trình Bùng Nổ Của Dodoco\" nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360150,
					"content": "Sách mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360151,
					"content": "Cả quyển luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360152,
					"content": "Các bé cưng đã quay về Mondstadt để cùng bé Klee gia nhập hành trình mạo hiểm của Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360153,
					"content": "Họ cùng nhau đánh bại Lính Cá Sừng xấu xa, rồi cùng vui vẻ nhâm nhi trà chiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360154,
					"content": "Đây mới là \"Hành Trình Bùng Nổ Của Dodoco\" hoàn hảo nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360155,
					"content": "Chẳng lẽ, khi cô thiết kế các ải trò chơi thì đã nghĩ ra được cả câu chuyện rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360156,
					"content": "Không phải. Câu chuyện này sẽ do các cưng cùng nhau hoàn thành, mọi người đều sẽ là nhân vật chính quyết định tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360157,
					"content": "Chị còn chừa một chỗ trống để chèn ảnh vào trong quyển sách này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360158,
					"content": "Chị có một đề xuất... hiếm khi mọi người rảnh rỗi gặp mặt nhau, hay là cùng chụp chung một tấm nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360159,
					"content": "Hay đó, được gặp nhau lại còn cùng chơi trò chơi nữa, khoảnh khắc này đúng là đáng để kỷ niệm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360160,
					"content": "Chụp hình nào!",
					"roleType": "TALK_ROLE_PLAYER",
