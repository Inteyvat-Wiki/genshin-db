			},
			"dialogs": [
				{
					"id": 733070201,
					"content": "Là Sorush và Yasnapati của cô ấy sao... Ôi, cả Paimon cũng ở đây nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070202
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070202,
					"content": "Này, sao tôi thì lại là \"cả\" và \"cũng\" chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070203,
					"content": "Khoan nói chuyện này đã, nhìn bộ dạng của các người, có phải đã phát hiện ra chuyện gì thú vị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070204
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070204,
					"content": "Cũng không hẳn là chuyện thú vị gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070205,
					"content": "Kể về chuyện Cây Fravashi cho Zurvan nghe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733070206
					]
				},
				{
					"id": 733070206,
					"content": "Ừm... Nên nói từ đâu đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070207,
					"content": "Thứ mọi người gặp quả đúng là \"Cây Fravashi\" do Pari hóa thành, nhưng thứ tá túc bên trong đó, thay vì nói là linh hồn còn sót lại thì nói đó là mảnh ký ức mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070208,
					"content": "Cũng giống như \"Tịnh Quang Vũ\" mà mọi người lấy được vậy, trong đó chất chứa ký ức chưa thể quay về với mặt đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070209,
						733070210,
						733070213
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070209,
					"content": "Chưa thể quay về mặt đất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070217
					]
				},
				{
					"id": 733070217,
					"content": "Pari sinh ra từ trong Amrita của Ốc Đảo Vourukasha, và cuối cùng sẽ quay về với nơi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070218
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070218,
					"content": "Giống như thần linh trấn giữ nơi này vậy, bọn ta là chủng loài bị dòng chảy thời gian chảy trong đất từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070219,
					"content": "Đương nhiên đây cũng là tâm nguyện của bọn ta. Việc không để cho những thứ đen tối cùng chảy vào mặt đất chính là sứ mạng của bọn ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070220,
					"content": "Chỉ cần khiến Cây Fravashi kết ra Tịnh Quang Vũ, vậy thì các Pari lưu lạc bên ngoài sẽ có thể quay về với vòng tay của Ốc Đảo Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070221,
					"content": "Dùng \"Tịnh Quang Vũ\" hiến tế cho Hồ Amrita, những ô uế đó sẽ bị thanh tẩy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070222,
					"content": "Ồ, xem ra đúng là chúng ta đã làm được một chuyện tốt nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070223,
					"content": "Hừm, Bóng Trắng Bay Bay ra vẻ lợi hại quá nhỉ, thật ra là nhờ vào năng lực vĩ đại của ta mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070224
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070224,
					"content": "Ừm, Sorush cũng rất lợi hại đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070225,
					"content": "Vậy còn được... Không đúng, ta không cần Bóng Trắng Bay Bay khen ngợi, ta chỉ cần có Yasnapati là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070226
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070226,
					"content": "Nhắc đến Yasnapati, nếu đã chấp nhận danh hiệu này, vậy thì thật sự đã trở thành ứng cử viên duy nhất cho nghi thức này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070227
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070227,
					"content": "Vào thời xưa, các dũng sĩ loài người đồng hành với Pari sẽ cử hành nghi thức rửa tội cho Pari lưu lạc trong sa mạc, đưa họ về Ốc Đảo Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070228
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070228,
					"content": "Và những người đã tạo lập nên liên kết đặc biệt này với Pari thì sẽ được gọi là \"Yasnapati\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070229,
					"content": "Ủa? Khác hẳn với những gì Sorush nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070230,
					"content": "Ây da, thì cũng xem như nói đại mà trúng đi. Thân là Yasnapati thì phải gánh vác trách nhiệm cứu giúp các Pari thất lạc chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070231,
					"content": "Nếu như có gặp phải Cây Fravashi như thế nữa thì hãy đưa Tịnh Quang Vũ kết ra từ đó trở về Ốc Đảo Vourukasha nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070232,
					"content": "Cho dù cô không nói thì chúng tôi cũng sẽ giúp những Pari đó mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070210,
					"content": "Thứ hiến tế cho Hồ Amrita cũng vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070211
					]
				},
				{
					"id": 733070211,
					"content": "Tịnh Quang Vũ là Khvarena của Simurgh hóa thành, còn Pari bọn ta ban đầu cũng được sinh ra từ sự kết hợp của Khvarena và Amrita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070212,
					"content": "Cũng chính vì vậy mà bọn ta mới được tôn là hậu duệ của Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070213,
					"content": "Nghe có chút quen thuộc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070214
					]
				},
				{
					"id": 733070214,
					"content": "Đúng vậy, trước đây Bija lấy được từ rừng rậm cũng chính là do ký ức của Aranara kết thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070215,
					"content": "Aranara... Các người cũng biết những sinh linh vô tư đó sao? Vậy thì việc giải thích sẽ dễ dàng hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070216,
					"content": "Nhưng hơi khác với Aranara, họ là chủng loài sinh ra từ mặt đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070217
					],
					"speakerTitle": "Zurvan"
				}
			]
		},
