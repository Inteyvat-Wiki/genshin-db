			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733070401,
					"content": "Ừm, các Pari lưu lạc trên mặt đất hình như đều đã quay về Ốc Đảo Vourukasha rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070402
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070402,
					"content": "Vất vả cho mọi người rồi, thật không hổ danh là Yasnapati được Sorush chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070403
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070403,
					"content": "Câu này của tiền bối xem như là đang khen tôi đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070404
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070404,
					"content": "Hihi, Ốc Đảo Vourukasha trông đã náo nhiệt hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070405,
					"content": "Tiếp theo chỉ cần giải quyết cái lỗ hổng đó nữa là ở đây sẽ khôi phục sự sống nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070406,
					"content": "Nhưng nhắc đến thì quả thật thần kỳ, nếu Pari vốn dĩ được sinh ra từ nước, vậy không phải nên gọi là \"Hydri\" mới đúng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070407,
					"content": "Bóng Trắng Bay Bay còn đặt tên lung tung cho bọn ta nữa chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070408
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070408,
					"content": "Haha, nhưng mà nhắc đến \"Hydri\" thì ta cũng nhớ lại vài chuyện trong quá khứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070409,
						733070410
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070409,
					"content": "Chuyện về Hydri sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				},
				{
					"id": 733070411,
					"content": "Rất lâu rất lâu trước đây, từng có rất nhiều Tinh Linh Nước Trong từ nơi khác vượt qua nghìn trùng ngăn cách để đến được đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070412
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070412,
					"content": "Lúc đó bên ngoài Ốc Đảo Vourukasha, ngoại trừ sa mạc ra thì còn có rất nhiều ma vật hoành hành. Đối với những thân quyến của dòng nước này mà nói, chuyến hành trình này chắc cũng rất gian khổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070413
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070413,
					"content": "Tuy rằng hình như họ đến vì vị thần đã mất, nhưng kết quả là không tìm thấy thứ mà họ muốn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070414
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070414,
					"content": "Sau khi nhìn thấy Harvisptokhm, họ đã nhanh chóng rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070415
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070415,
					"content": "Sau đó, truyền thuyết về Tinh Linh Nước Trong bắt đầu lưu truyền, và lại có rất nhiều người ngoại quốc men theo đường mà họ đã đi để hòng tìm ra bí mật của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070416
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070416,
					"content": "Tuy rằng ban đầu đều là những tin đồn sai lệch, nhưng dần dà, con đường này cũng được ban cho ý nghĩa là từ bỏ chính mình để tìm kiếm sự chân thật thuần khiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070417
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070417,
					"content": "Dù cho sau đó Ốc Đảo Vourukasha không còn rộng mở nữa, nhưng con đường hành hương của họ cũng tiếp diễn trong một thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070418
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070418,
					"content": "Có lẽ đối với họ, so với việc đến được điểm đích thì quá trình của chuyến đi còn mang nhiều ý nghĩa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070419
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070419,
					"content": "Cũng giống như so với sự hy sinh của việc một lần gian khổ để thảnh thơi mãi về sau, thì quá trình nỗ lực vì sứ mệnh mới càng có ý nghĩa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070420
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070420,
					"content": "Sao nói đến cuối cùng thì kết quả lại rơi lên đầu tôi thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070410,
					"content": "Hy vọng không quá dài...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				}
			]
		},
