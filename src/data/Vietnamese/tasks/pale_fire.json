				{
					"id": 733070518,
					"content": "Có lẽ đối với họ, so với việc đến được điểm đích thì quá trình của chuyến đi còn mang nhiều ý nghĩa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070519
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070519,
					"content": "Cũng giống như so với sự hy sinh của việc một lần gian khổ để thảnh thơi mãi về sau, thì quá trình nỗ lực vì sứ mệnh mới càng có ý nghĩa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070520
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070520,
					"content": "Sao nói đến cuối cùng thì kết quả lại rơi lên đầu tôi thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070510,
					"content": "Hy vọng không quá dài...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070511
					]
				}
			]
		},
		{
			"id": 7330706,
			"completionStepIds": [
				7330702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_B_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
