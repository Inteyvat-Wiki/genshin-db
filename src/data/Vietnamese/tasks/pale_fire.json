				{
					"id": 733070312,
					"content": "Đương nhiên đây cũng là tâm nguyện của bọn ta. Việc không để cho những thứ đen tối cùng chảy vào mặt đất chính là sứ mạng của bọn ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070313
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070313,
					"content": "Trong Hồ Amrita, bọn ta sẽ được thanh tẩy mọi ô uế vấy bẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070314
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070314,
					"content": "Chỉ cần hiến tế Tịnh Quang Vũ trong tay ở Hồ Amrita, thì các Pari lưu lạc bên ngoài sẽ có thể quay về vòng tay của Ốc Đảo Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070315
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070315,
					"content": "Ồ, xem ra đúng là chúng ta đã làm được một chuyện tốt nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070316,
					"content": "Hừm, Bóng Trắng Bay Bay ra vẻ lợi hại quá nhỉ, thật ra là nhờ vào năng lực vĩ đại của ta mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070317
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070317,
					"content": "Ừm, Sorush cũng rất lợi hại đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070318,
					"content": "Vậy còn được... Không đúng, ta không cần Bóng Trắng Bay Bay khen ngợi, ta chỉ cần có Yasnapati là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070319
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070319,
					"content": "Nhắc đến Yasnapati, nếu đã chấp nhận danh hiệu này, vậy thì thật sự đã trở thành ứng cử viên duy nhất cho nghi thức này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070320
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070320,
					"content": "Vào thời xưa, các dũng sĩ loài người đồng hành với Pari sẽ cử hành nghi thức rửa tội cho Pari lưu lạc trong sa mạc, đưa họ về Ốc Đảo Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070321
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070321,
					"content": "Và những người đã tạo lập nên liên kết đặc biệt này với Pari thì sẽ được gọi là \"Yasnapati\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070322
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070322,
					"content": "Ủa? Khác hẳn với những gì Sorush nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070323,
					"content": "Ây da, thì cũng xem như nói đại mà trúng đi. Thân là Yasnapati thì phải gánh vác trách nhiệm cứu giúp các Pari thất lạc chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070324
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070324,
					"content": "Nếu như có gặp phải Cây Fravashi như thế nữa thì hãy đưa Tịnh Quang Vũ kết ra từ đó trở về Ốc Đảo Vourukasha nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070325
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070325,
					"content": "Cho dù cô không nói thì chúng tôi cũng sẽ giúp những Pari đó mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7330704,
			"completionStepIds": [
				7330704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
