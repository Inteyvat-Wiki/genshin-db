			"dialogs": [
				{
					"id": 221000101,
					"content": "Ồ, vậy phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "Haiz, mở một nhà trọ ở đây không dễ gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000104,
					"content": "Cánh đồng hoa cỏ lau ở Địch Hoa Châu nhiều báu vật mà cũng lắm quái vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000105,
					"content": "May mà có Thiên Nham Quân, quái vật quanh đây đều được đánh đuổi hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000106,
					"content": "Thế nhưng không hiểu vì sao, thời gian gần đây chúng thường xuyên lẻn vào đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000107,
					"content": "Tuy chúng không dám đến trước nhà trọ, nhưng mỗi ngày thấy đám quái vật lởn vởn ở đây, không chỉ khách trọ mà đến tôi cũng thấy ngứa mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000108,
					"content": "Nếu bạn có thời gian thì hay đi quanh đây, dẹp hết lũ quái vật được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000109,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "Haha, bạn thật thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000114,
					"content": "Đúng rồi, sai khách trọ đi làm việc quả thật là ngại quá mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000115,
					"content": "Sau khi giải quyết xong, tiền thưởng sẽ không ít đâu, mong quý khách yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000116,
					"content": "Vậy thì mọi việc nhờ vào bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000110,
					"content": "Chỉ là ngứa mắt sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "Bạn nghĩ xem, ngứa mắt chính là điểm lũ quái vật ấy làm người khác khó chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000113,
					"content": "À, đặc biệt đối với ông chủ thích sạch sẽ kia, ông ấy mà thấy khó chịu, thì e rằng cả Địch Hoa Châu đều thấy khó chịu giống ông ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
