			"dialogs": [
				{
					"id": 221000201,
					"content": "Thế nào? Quái vật ở xung quanh đã xử lý xong hết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000202,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "Cũng không gấp, đám quái vật đó chỉ lởn vởn ngoài kia, không dám tiến đến gần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000204,
					"content": "Có điều, nếu có con quái vật nào có mắt không tròng dám đi vào đây, làm vướng bận ông lão sạch sẽ kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000205,
					"content": "Không biết chừng không chỉ Địch Hoa Châu bị dày vò, mà nhà trọ cũng phải đóng cửa mấy hôm nữa...",
