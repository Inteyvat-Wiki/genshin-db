			"dialogs": [
				{
					"id": 730240101,
					"content": "Ối, cảm ơn các bạn đã giúp đỡ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240102,
					"content": "Như hai bạn đã thấy đó, tôi là đội trưởng kiểm lâm. Gọi tôi Rana là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240103,
					"content": "#Tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "Tên tôi là Paimon! Chúng tôi đến từ một đất nước khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240107,
					"content": "Thì ra là vậy. Ừm... Trông cách ăn mặc, đúng là không giống cư dân trong rừng sâu... cũng không giống người đến từ sa mạc. Trang phục có vẻ thoáng khí đấy, rất thích hợp để hoạt động ở Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240108,
					"content": "Hửm? Nếu Rana là đội trưởng kiểm lâm thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240109,
					"content": "Chắc là quen biết Tighnari nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#Ồ! {NICKNAME} cũng biết tiền bối sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240111,
					"content": "Tuy tiền bối Tighnari luôn tỏ vẻ \"người lạ đừng đến gần\", nhưng thật ra lại là một người tốt. Khi còn thực tập, tôi đã được anh ấy chăm sóc rất nhiều. Hơn nữa, đôi tai của anh ấy rất đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240112,
					"content": "Ừm... Thật ra, tôi cũng rất muốn sờ thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240113,
					"content": "Thật ra, tôi cũng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "Ừm... Nếu lặng lẽ bay qua, không biết có thể sờ không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240115,
					"content": "Hahaha, nếu làm bậy thì tiền bối Tighnari sẽ tức giận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240118,
					"content": "Chắc vậy? Trông đôi tai ấy rất bắt mắt, không biết sờ vào sẽ thế nào. Cô nhóc mà anh ấy đang hướng dẫn cũng rất hứng thú với chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240119,
					"content": "Hả? Chẳng lẽ người mà Rana nói là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240120,
					"content": "Là Collei sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#Ồ, {NICKNAME} cũng biết Collei sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240122,
					"content": "Dường như sức khỏe của Collei không được tốt lắm. Dù vậy cô ấy vẫn cố gắng bảo vệ rừng sâu, dọn dẹp Tử Vực, mọi người đều rất lo lắng cho tình trạng của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240141,
					"content": "Khụ khụ! Nói thế nào đi nữa thì công việc của đội kiểm lâm chúng tôi cũng là bảo vệ rừng sâu, giúp đỡ lữ khách và đưa ra hướng dẫn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240142,
					"content": "#Như {NICKNAME} và Paimon đã thấy, gần đây tình trạng của khu rừng... có lẽ không được lý tưởng cho lắm. Dù là \"Nấm Quỷ\" hay quái thú đều vô cùng nóng nảy. Còn có cả \"Tử Vực\" nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240143,
					"content": "Hay là tôi đưa các bạn đi một đoạn nhé? Tuyến đường tuần tra tiếp theo của tôi sẽ đi qua Làng Vimara. Ở đó nếu men theo đường thủy thì dù đến Cảng Ormos hay Thành Sumeru đều rất thuận tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240144,
					"content": "Được rồi, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "Ừm, tôi sẽ đảm bảo an toàn cho hai bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240146,
					"content": "Được rồi, nhưng tạm thời tôi có việc khác cần giải quyết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "Tôi hiểu rồi, tôi sẽ tạm thời ở đây đợi các bạn. Phải chú ý an toàn đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240116,
					"content": "Paimon có thể lặng lẽ bay qua và sờ thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "Này! Nếu như vậy, Tighnari có tức giận không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240123,
					"content": "Có lẽ là biết Collei chứ nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#Ơ, {NICKNAME} và Collei đã gặp nhau rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240125,
					"content": "Dường như sức khỏe của Collei không được tốt lắm. Dù vậy cô ấy vẫn cố gắng bảo vệ rừng sâu, dọn dẹp Tử Vực, mọi người đều rất lo lắng cho tình trạng của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240126,
					"content": "Nhưng bên cạnh cô ấy đã có vị tiền bối \"có đôi tai rất muốn sờ\" đó, chắc hẳn sẽ không có vấn đề gì đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "Rana"
				},
				{
