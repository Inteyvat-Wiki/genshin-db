			"dialogs": [
				{
					"id": 730240501,
					"content": "Ối, cảm ơn các bạn đã giúp đỡ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240502
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240502,
					"content": "Như hai bạn đã thấy đó, tôi là đội trưởng kiểm lâm. Gọi tôi Rana là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240503,
						730240505
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240503,
					"content": "#Tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240504
					]
				},
				{
					"id": 730240504,
					"content": "Tên tôi là Paimon! Chúng tôi đến từ một đất nước khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240507,
					"content": "Thì ra là vậy. Ừm... Trông cách ăn mặc, đúng là không giống cư dân trong rừng sâu... cũng không giống người đến từ sa mạc. Trang phục có vẻ thoáng khí đấy, rất thích hợp để hoạt động ở Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240508
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240508,
					"content": "Khụ khụ! Nói thế nào đi nữa thì công việc của đội kiểm lâm chúng tôi cũng là bảo vệ rừng sâu, giúp đỡ lữ khách và đưa ra hướng dẫn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240509
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240509,
					"content": "#Như {NICKNAME} và Paimon đã thấy, gần đây tình trạng của khu rừng... có lẽ không được lý tưởng cho lắm. Dù là \"Nấm Quỷ\" hay quái thú đều vô cùng nóng nảy. Còn có cả \"Tử Vực\" nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240510
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240510,
					"content": "Hay là tôi đưa các bạn đi một đoạn nhé? Tuyến đường tuần tra tiếp theo của tôi sẽ đi qua Làng Vimara. Ở đó nếu men theo đường thủy thì dù đến Cảng Ormos hay Thành Sumeru đều rất thuận tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240511,
						730240513
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240511,
					"content": "Được rồi, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240512
					]
				},
				{
					"id": 730240512,
					"content": "Ừm, tôi sẽ đảm bảo an toàn cho hai bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240513,
					"content": "Được rồi, nhưng tạm thời tôi có việc khác cần giải quyết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240514
					]
				},
				{
					"id": 730240514,
					"content": "Tôi hiểu rồi, tôi sẽ tạm thời ở đây đợi các bạn. Phải chú ý an toàn đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240505,
					"content": "Chúng tôi đến từ một nơi rất xa...",
