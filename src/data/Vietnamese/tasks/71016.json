					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "Về kho báu vô danh",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "Thứ bạn đang cầm... trông rất đẹp, những hoa văn này chắc cũng đã lâu năm rồi. Đợi một chút để tôi mở ra xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "Mặc dù thứ này có thiếu sót, nhưng nếu bạn muốn bán ra luôn, tôi có thể đưa ra giá thu mua. Chỉ là giá không được cao mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "Tôi vừa mới xem thứ này. Hoạ tiết hoa văn này đúng là của Liyue, và trên đó còn ghi lại những giai thoại về \"Azhdaha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "Theo truyền thuyết, Azhdaha là ma long được sinh ra từ tinh hoa Nguyên Tố Nham của Liyue, ngay cả Nham Vương Đế Quân Morax cũng không dễ dàng trấn áp được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "Nham Vương Đế Quân đã triệu tập ba vị tiên nhân và bảo họ hợp sức tạo ra một hang động để trấn áp nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "Sau đó, Nham Vương Đế Quân đã đích thân chiến đấu với nó, rồi đánh vào trong động và lệnh cho các tiên nhân hợp sức chặn lối ra vào, như vậy mới khống chế được Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "Mà hoa văn trên thứ bạn mang đến, có lẽ là mô tả cảnh ba tiên nhân hợp sức tạo ra hang động trong trận đại chiến ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "Vì vậy tôi đoán rằng thứ này phải có ít nhất ba phần, kết hợp ba phần này lại, mới là một vật hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "Chuyện này bạn cũng biết sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Dù sao tôi cũng đang kinh doanh lĩnh vực này, kiến thức về mọi mặt đều cần phải biết một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "À, lại nói lạc đề rồi. Như đã nói, vật này tổng cộng có ba phần, nếu lấy một phần ra bán, e rằng giá trị không cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "Nếu có thể tìm đủ cả ba thì lại là vấn đề khác rồi. Có điều thứ này trông có vẻ cũng khá lâu năm rồi, muốn thu thập đủ cả ba phần e rằng càng khó khăn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue thật thần kỳ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Điều này thì tôi không biết, nhưng một vị tiền bối từng nói với tôi rằng, Liyue thực sự quá lớn, lịch sử cũng quá dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "Ở Liyue, cho dù có phát hiện ra cổ vật gì kỳ lạ cũng không cần ngạc nhiên. So với lịch sử lâu đời của Liyue, những gì chúng ta biết cũng chỉ như giọt nước trong đại dương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
