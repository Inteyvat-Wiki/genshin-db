					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "Nếu tôi đoán không sai, thứ lần trước bạn mang đến phải có ít nhất ba phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160303,
					"content": "Kết hợp ba phần lại, mới là một vật hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160304,
					"content": "Nếu bạn có thể tìm đủ, vậy thì tôi rất sẵn lòng trả giá cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160305,
					"content": "Có điều thứ này niên đại cũng khá lâu rồi, muốn thu thập đủ... cũng có chút khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
