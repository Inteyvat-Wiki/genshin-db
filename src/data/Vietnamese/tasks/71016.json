			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Tôi tìm được đủ ba phần rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "Bạn thực sự đã thu thập đủ rồi? Hãy cho tôi xem... hoa văn của ba phần này nối liền với nhau, đúng là đang miêu tả câu chuyện về Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "Có vẻ như con hạc này chính là Lí Thủy Điệp Sơn Chân Quân, còn con tuần lộc này... có lẽ là Tước Nguyệt Trúc Dương Chân Quân, nhưng con còn lại này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "Í? Hoa văn trên chiếc cuối cùng này hình như... bị người ta cố tình xoá đi, không còn nhìn thấy hình dáng. Vị tiên nhân thứ ba này rốt cuộc là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Thôi bỏ đi, những chuyện này đã nằm ngoài phạm vi kiến thức của tôi. Nhưng dù sao thì món bảo bối này cũng đã hoàn chỉnh rồi, có thể bán với giá tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "Sao nào, bạn muốn giữ làm kỷ niệm hay là bán bảo bối này cho tôi với giá tốt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "Bán cho bạn đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Được rồi, bạn hãy cầm lấy số tiền này đi, đồ thì tôi sẽ thu lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160509,
					"content": "Nhưng... tại sao hoa văn của một trong ba vị tiên nhân lại bị xoá đi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160510,
					"content": "Là ai đã tạo ra vật này, là ai đã đập vỡ nó, còn tự ý xoá đi hình ảnh của tiên nhân?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160511
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160511,
					"content": "Phải rồi, Soraya thường đến Liyue, tôi có thể viết thư hỏi cô ấy... cô ấy chắc chắn cũng sẽ hứng thú với món đồ này.",
					"roleType": "TALK_ROLE_NPC",
