			"dialogs": [
				{
					"id": 710160401,
					"content": "Tôi đi thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "Được thôi, nếu bạn thực sự thu thập đủ, hãy nhớ mang nó cho tôi xem nhé.",
					"roleType": "TALK_ROLE_NPC",
