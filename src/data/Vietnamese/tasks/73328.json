			"dialogs": [
				{
					"id": 733280101,
					"content": "Là Jeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}?! Còn có cả Paimon nữa!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280103,
					"content": "Bíp bíp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280104,
					"content": "Haha, tôi đã nói gì nhỉ! Chúng ta lại gặp nhau rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280105,
					"content": "Cô ở đây làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "Ừm... Là bí mật của phụ nữ chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280107,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280108,
					"content": "#{M#Ý của tôi là đừng có hỏi nữa! Tôi cũng có bí mật riêng của mình mà...}{F#Tôi muốn đến quán rượu và khiến bản thân trở nên vui vẻ, không biết chừng tôi có thể kể với cô vài điều... Có cần tôi dạy cho cô không?}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280109,
					"content": "#{M#Xin lỗi, đây là quy định của tiêu cục, nên tôi không thể nói cho cậu nghe.}{F#Chỉ là đùa thôi mà, đừng nghiêm túc quá! Là quy định của tiêu cục... nên lần này phải giữ bí mật. Xin lỗi nhé.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280110,
					"content": "Hừm, cứ úp úp mở mở!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280111,
					"content": "Dạo này... các bạn thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280112,
					"content": "Vẫn khỏe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "Ừm... tôi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280115,
					"content": "#Được rồi, tôi không phiền {F#cô}{M#cậu} nữa... Tôi còn có việc riêng phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280116,
					"content": "Jeht bận như vậy sao... Không giống như trước kia chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280117,
					"content": "Ừm... Tôi tìm được công việc \"ổn định\" rồi mà, nội dung công việc thì gần giống như trước kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280118,
					"content": "Sau một khoảng thời gian làm việc ở tiêu cục, tôi lại nhớ những ngày tự do không gò bó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280119,
					"content": "#Không biết {F#cô}{M#cậu} thế nào, nhưng tôi vẫn luôn mong chờ câu chuyện từ {F#cô}{M#cậu}. Còn có rất nhiều điều muốn kể cho {F#cô}{M#cậu} nghe đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280120,
					"content": "Nhưng không cần vội... Một câu chuyện hay sẽ giống như bình rượu ngon, cần thời gian để lên men. Xưa kia, những lữ khách trên sa mạc đều sống bằng những câu chuyện này mà! Hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280121,
					"content": "Ừm.. Tóm lại, nhớ bảo trọng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280122,
					"content": "Cô cũng vậy, Jeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "#Ừm, một nghìn cái ôm nhé, tôi sẽ luôn cầu nguyện cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280124,
					"content": "Bíp bíp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280125,
					"content": "Haha, Benben cũng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280113,
					"content": "Bình thường...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
