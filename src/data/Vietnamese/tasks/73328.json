			"dialogs": [
				{
					"id": 733280201,
					"content": "#Gửi đến {F#cô}{M#cậu} một nghìn cái ôm! Hẹn gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280202,
					"content": "Lần tới, tôi sẽ gặp cô ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "Ai mà biết được chứ? Đảo Thiên Không chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280204,
					"content": "#Haha, chỉ đùa thôi! Nhưng nếu {F#cô}{M#cậu} muốn gặp tôi ở đó thì tôi sẽ đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280205,
					"content": "Đừng hỏi tại sao. Chỉ là tôi biết vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280208,
					"content": "Tóm lại, hẹn gặp lại nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280206,
					"content": "#Gửi đến {F#cô}{M#cậu} một nghìn cái ôm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
