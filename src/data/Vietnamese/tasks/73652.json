	"talks": [
		{
			"id": 7365201,
			"completionStepIds": [
				7365201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365201",
							"2"
						],
						"stepId": 7365201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hajanad",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736520101,
					"content": "Cuối cùng cũng trở lại rồi? Tôi chờ các bạn lâu lắm rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520102
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520102,
					"content": "Đến đây, kể chi tiết hiệu quả của \"Thuốc Tái Luyện\" cho tôi nghe với.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520103
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520103,
					"content": "Hajanad hưng phấn quá nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520104
					]
				},
				{
					"id": 736520104,
					"content": "Vậy chúng ta nói về khuyết điểm trước đi, bạn đừng có sốc quá nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520105,
					"content": "Kể rõ ưu khuyết điểm của \"Thuốc Tái Luyện\" cho Hajanad nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520106
					]
				},
				{
					"id": 736520106,
					"content": "Ra là vậy... Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520107
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520107,
					"content": "Kiểu nổ hiện tại không thể khống chế chính xác số lượng thuốc hỗn hợp, nên hiệu quả không ổn định lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520108
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520108,
					"content": "Phải thêm vỏ đạn cho thuốc nổ, hạn chế sóng nổ, thêm nữa là chỉnh lại cách sắp xếp thuốc dự trữ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520109
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520109,
					"content": "Ừm, muốn cải tiến thì nhanh thôi, vấn đề là tài chính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520110
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520110,
					"content": "Cũng may trước đó vẫn còn giữ lại dự toán khẩn cấp. Sau này mỗi ngày chỉ ăn một bữa cơm, bán bớt một ít đồ cũ, chắc là cũng đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520111
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520111,
					"content": "Mỗi ngày chỉ ăn một bữa cơm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520112,
					"content": "Không được không được, nghe thôi cũng thấy không ổn rồi! Rõ ràng bạn không đủ tiền, sao không chịu nói sớm hơn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520113,
					"content": "À, các bạn cứ yên tâm, thù lao trả cho các bạn sẽ không bị cắt xén đâu, khoản dự toán này tôi đã tính toán sẵn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520114
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520114,
					"content": "Hồi trước tôi cũng thường hay chỉ ăn một bữa, có khi một tuần chỉ ăn ba bữa, quen từ lâu rồi, không vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520115
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520115,
					"content": "Không cần phải liều mạng như thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520116
					]
				},
				{
					"id": 736520116,
					"content": "Tôi vẫn rất để ý, phải hỏi cho rõ ràng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520117,
					"content": "Tiểu thư Hajanad, vì sao cô muốn trở thành học giả nổi tiếng đến thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520118,
					"content": "Vì thật sự rất thích nghiên cứu học thuật sao? Vì chứng minh tài năng của mình? Hay là dùng thuật luyện kim để thu về nhiều Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520119,
					"content": "Ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520120
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520120,
					"content": "Tự dưng hỏi vậy tôi cũng không trả lời được... Có lẽ vì trước kia bị bắt nạt nên không cam lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520121
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520121,
					"content": "Nếu tôi có thể chứng minh được năng lực của mình, có thể sống thoải mái hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520122
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520122,
					"content": "Vì lý do như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520123,
					"content": "Bạn bắt đầu nghiên cứu học thuật?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520124
					]
				},
				{
					"id": 736520124,
					"content": "Đúng thế, đây là đất nước đặt kiến thức lên cao nhất, đương nhiên phải dựa vào năng lực học thuật để trèo lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520125
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520125,
					"content": "Tôi không có thiên phú gì, chỉ số thông minh bình thường, chỉ có thể lựa chọn môn học mà ít người nghiên cứu để dốc sức tạo ra thành quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520126
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520126,
					"content": "Một người vùi đầu vào nghiên cứu trong thời gian quá dài, cũng không biết nên chung sống với người khác thế nào, tính tình trở nên khác thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520127,
						736520128
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520127,
					"content": "Trên đời này người tốt vẫn chiếm đa số.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				},
				{
					"id": 736520129,
					"content": "Đúng thế, giờ cô có mục tiêu cao hơn rồi, cuộc sống cũng nên dễ thở hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520130,
					"content": "Nếu cô giữ cho mình tâm trạng bình thường, trò chuyện với người khác đàng hoàng, chắc chắn sẽ còn rất nhiều người chịu giúp đỡ, cùng nghiên cứu với cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520131,
					"content": "Cảm ơn, tôi vẫn hiểu lý lẽ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520132
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520132,
					"content": "Tôi phát hiện ra, nghiên cứu thuật luyện kim rất thú vị, thoải mái hơn cách thức làm người và chuyện củi gạo dầu muối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520133
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520133,
					"content": "Sau khi gặp được các bạn, tôi cũng đã nhìn lại mình, quả thật tôi nên ổn định tâm trạng mình hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520134
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520134,
					"content": "Tóm lại, cảm ơn mọi người đã hỗ trợ tôi thí nghiệm \"Thuốc Tái Luyện\", tôi phải về thành viết luận văn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520135
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520135,
					"content": "Ngoại trừ thù lao đã hứa, đưa thêm cái này cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520136
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520136,
					"content": "Cái này là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520137
					]
				},
				{
					"id": 736520137,
					"content": "Nồi luyện kim tốt nhất của tôi, lúc trước bỏ ra không ít vốn liếng tích cóp mua về, nhưng mãi không dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520138
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520138,
					"content": "Này! Sao tự dưng cô không cần đến công cụ mình yêu quý nhất thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520139,
					"content": "\"Thuốc Tái Luyện\" không giống với chất thuốc truyền thống, cần chế tạo bằng dụng cụ tôi thiết kế mới hoàn toàn, nên tôi không cần đến nồi luyện kim này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520140
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520140,
					"content": "Dù gì trong số thù lao cho mọi người còn có một cam kết, đưa cái nồi luyện kim này làm chứng càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520141
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520141,
					"content": "Mọi người có thể thử dùng nó... nấu trà hay nấu canh gì đó? Nó có chức năng xúc tiến tinh lọc, nước canh được nấu chắc là ngon lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520142
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520142,
					"content": "Nếu cô đã nói thế rồi... chúng tôi cũng không tiện từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520143,
					"content": "Cố lên nhé, Hajanad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520144
					]
				},
				{
					"id": 736520144,
					"content": "Đương nhiên! Chờ tin tốt của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520145
					],
					"speakerTitle": "Hajanad"
				},
				{
					"id": 736520145,
					"content": "Hajanad rời đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520146
					]
				},
				{
					"id": 736520146,
					"content": "#{NICKNAME}, bạn nói xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520147,
					"content": "Lần này xem như chúng ta đã làm được một chuyện tốt đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520148,
						736520149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520148,
					"content": "Chỉ là mạo hiểm bình thường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520150,
					"content": "Nói cũng đúng, giờ vẫn chưa vội kết luận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520151,
					"content": "Biết đâu đến lúc nào đó chúng ta quên luôn rồi, đột ngột nhận tin Hajanad lên làm học giả, mời chúng ta đi thăm cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520152,
					"content": "Đừng nghĩ linh tinh nữa, đi thôi đi thôi. Tôi phải thử nấu trà bằng nồi luyện kim này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736520149,
					"content": "Tâm trạng của chúng ta cũng phải bình thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520128,
					"content": "Đừng quá câu nệ chuyện đã qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				}
			]
		}
	]
}