			"dialogs": [
				{
					"id": 740610401,
					"content": "Ôi, hai vị gì đó ơi. Phù, đuổi kịp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610402
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610402,
					"content": "Sao anh lại thở hồng hộc thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610403,
					"content": "Tôi đã giải quyết xong chuyện bên Khu Sản Xuất rồi, nên tranh thủ chạy tới đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610404
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610404,
					"content": "Sao rồi, mọi việc đã xong chưa? Có phải đã gửi thư đi rồi không? Tốt quá đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610405,
						740610406
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610405,
					"content": "Trên thư có ký tên là Lily Trắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610407
					]
				},
				{
					"id": 740610407,
					"content": "Hả? Thì ra đó là tên mà cô gái đó tự đặt sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610408
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610408,
					"content": "Được rồi, đây là thư của một cô gái nhờ tôi gửi. Tôi thấy cô ấy bệnh nặng nên đã đồng ý, một đồng thù lao cũng không lấy! Thù lao cho hai vị cũng là tiền túi của tôi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610409
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610409,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610410,
						740610411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610410,
					"content": "Xem nội dung trong thư thì đúng là cô ấy đang bệnh nặng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610412,
					"content": "Lúc ra ngoài tôi đã cầm nhầm thư. Haiz, thế này thì không kịp sinh nhật của con trai tôi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610413
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610413,
					"content": "Hôm nay lại cầm nhầm thư à? Anh Decembre đúng là xui xẻo y như trong lời đồn luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610414,
					"content": "Có thể số tôi là thế rồi. Thôi không nói chuyện nữa, tôi phải tranh thủ chạy về lấy thư đây. Mong là còn kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610415
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610415,
					"content": "Đây là thù lao của hai vị, hợp tác vui vẻ. Tôi còn phải đi gửi thư cho con trai nữa, lần sau gặp lại nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610416
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610416,
					"content": "Nhưng mà... Sao lại đi mất rồi! Chúng ta còn cả đống vấn đề muốn hỏi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610417,
					"content": "Bỏ đi, có Phiếu Đặc Cách là được rồi. Hả?! Sao chỉ có một chút thế này? Bấy nhiêu còn chưa đủ ăn một bữa cơm nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610418,
						740610420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610418,
					"content": "Xem ra đêm nay phải nhịn đói rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610419
					]
				},
				{
					"id": 740610419,
					"content": "Khôngggg, tôi đói lắm luôn rồi, huhu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610420,
					"content": "Hay là chúng ta nhận ủy thác xếp hàng thêm lần nữa nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610421
					]
				},
				{
					"id": 740610421,
					"content": "Thế thì tôi thà nhịn đói còn hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610411,
					"content": "Thật hay giả vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610406,
					"content": "Anh là Lily Trắng sao?",
