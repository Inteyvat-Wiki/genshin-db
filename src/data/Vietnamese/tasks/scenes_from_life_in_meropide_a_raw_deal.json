			"dialogs": [
				{
					"id": 740610201,
					"content": "Ai đó có thể giúp tôi không? Van xin mọi người hãy giúp đỡ kẻ đáng thương này đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610202
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610202,
					"content": "Anh không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610203,
					"content": "Cuối cùng cũng gặp được một người tốt rồi. Là thế này, ngày mai là sinh nhật của con trai tôi, tôi muốn viết một bức thư cho thằng bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610204
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610204,
					"content": "Nhưng nếu muốn gửi thư ra ngoài thì cần phải xếp hàng ở đây. Nhưng hiện tại tôi không có thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610205
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610205,
					"content": "Hả? Tại sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610206,
					"content": "Khu Sản Xuất xảy ra sự cố an toàn rất nghiêm trọng, tôi phải tới đó xử lý. Tôi muốn tìm người xếp hàng giúp tôi, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610207
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610207,
					"content": "Haiz... Đúng là báo ứng mà. Nhưng con trai tôi có lỗi gì chứ! Tại sao lại trừng phạt thằng bé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610208
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610208,
					"content": "Tôi chỉ muốn viết một bức thư, nói cho nó biết rằng cha không quên sinh nhật của nó, rằng cha rất yêu thương nó. Tiếc là ngay cả chuyện đó tôi cũng không thể làm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610209
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610209,
					"content": "#Đáng thương quá đi. {NICKNAME}, chúng ta giúp anh ta nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610210,
					"content": "Tuy hiện tại tôi cũng không dư dả gì nhiều, nhưng tôi sẽ trả thù lao cho các vị theo đúng giá thị trường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610211
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610211,
					"content": "Giá thị trường?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610212
					]
				},
				{
					"id": 740610212,
					"content": "Đúng vậy. Tôi từng xếp hàng giúp người ta nên biết giá cả thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610213
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610213,
					"content": "Không sao cả, thù lao không quan trọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610214,
					"content": "Cảm ơn nhiều lắm! Đúng là người tốt mà. À, tôi còn chưa hỏi tên của các vị nữa. Tôi tên Decembre, tên của hai vị là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610215
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610215,
					"content": "#Tôi là Paimon, đây là {NICKNAME}. Chúng tôi cùng nhau đi phiêu lưu mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610216,
					"content": "#Đây là thư tôi muốn gửi đi, cứ giao nó cho người tên Lutz ở bên trong là được. Paimon và {NICKNAME}, nhờ cả vào các vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610217
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740610217,
					"content": "Hihi, yên tâm, cứ giao cho tôi là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610218,
					"content": "Decembre giao thư xong liền vội rời đi.\\nMột lúc sau bạn và Paimon mới phát hiện, hàng người nhìn như thưa thớt lại giống như bị đóng băng vậy, hoàn toàn không hề nhích lên thêm chút nào.\\nĐúng lúc này, có một cuộc nói chuyện vang lên từ phía sau.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740610219
					]
				},
				{
					"id": 740610219,
					"content": "Ôi, chậm quá đi mất. Bầu không khí cũng ngột ngạt nữa, tôi sắp thở không nổi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610220
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610220,
					"content": "Đây là lần đầu tiên anh tới đây xếp hàng à? Nơi này có tiếng là xếp hàng lâu đấy, cả Pháo Đài Meropide này ai cũng biết cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610221
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610221,
					"content": "Cũng tại Lutz không bỏ được cái tật vừa gõ chữ vừa thêm mắm dặm muối vào trong thư. Mọi người toàn phải tốn cả đống thời gian để kiểm tra lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610222
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610222,
					"content": "Lâu lắm sao? Chân tôi nhũn hết rồi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610223
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610223,
					"content": "Haha, phải cố chịu thôi. Lỡ như chóng mặt ngất xỉu thì ngày mai lại phải tới nữa. Có người tới ba lần cũng không thể gửi thư được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610224
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610224,
					"content": "Ba lần? Sao mà nhọ thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610225
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610225,
					"content": "Chứ còn gì nữa! Cũng chỉ có anh ta mới tạo nên truyền thuyết xếp hàng ba lần đều thất bại. Nên chúng tôi gọi anh ta là Decembre số nhọ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610226
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610226,
					"content": "Nếu anh có hứng thú thì tôi sẽ kể cho nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610227
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610227,
					"content": "Nói thật thì tôi đang không có tâm trạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610228
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610228,
					"content": "Đừng thế mà, vui lên đi chứ. Khụ, đó là một buổi chiều oi ả vào mấy ngày trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610229
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610229,
					"content": "Tôi đã nói rồi... Haiz, bỏ đi, anh cứ kể vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610230
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610230,
					"content": "Trong buổi chiều đó, Decembre tới tìm tôi nói là mình cần xếp hàng gửi thư vào ngày hôm sau, mong tôi thay anh ta làm khuân vác cho Nhà Ăn Đặc Cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610231
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610231,
					"content": "Vốn dĩ tôi ngại phiền nên định từ chối. Nhưng anh ta mếu máo nói lần trước anh ta sơ ý ngủ quên, không xếp hàng được. Mà con trai của anh ta thì vẫn đang chờ tin của cha mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610232
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610232,
					"content": "Tôi mềm lòng nên đồng ý giúp. Nhưng anh đoán xem hôm qua tôi làm xong thì sao nào? Tôi phát hiện anh ta lại đang tìm người đi làm thay, vẫn nói là mình muốn gửi thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610233
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610233,
					"content": "Tôi bèn đi qua hỏi anh ta. Anh ta mới nói là mình đã rút kinh nghiệm từ bài học hôm trước, nên mới sáng sớm đã thức dậy. Nhưng lại có sự cố xảy ra nên vẫn không thể gửi thư đi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610234
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610234,
					"content": "Không phải là xếp hàng sai chỗ đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610235
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610235,
					"content": "Còn thú vị hơn thế nhiều. Anh ta nói với tôi là vì sốt ruột tới xếp hàng nên không màng ăn uống, kết quả xếp tới chiều thì anh ta không chịu nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610236
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610236,
					"content": "Anh ta vốn định cố chịu đựng thêm, kết quả là hôn mê bất tỉnh luôn. Đợi tới khi tỉnh lại thì đã muộn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610237
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610237,
					"content": "Haha, đúng thật là... Đợi đã, hình như tôi cũng chưa ăn cơm. Tiêu rồi, sao tự nhiên tôi cảm thấy bụng mình đang bắt đầu réo inh ỏi thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610238
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610238,
					"content": "Người họ đang nói là Decembre sao? Không ngờ xếp hàng ở đây lại vất vả như thế... May mà chúng ta luôn mang theo thức ăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610239,
						740610241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610239,
					"content": "Đúng đó, còn có Paimon ở đây mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610240
					]
				},
				{
					"id": 740610240,
					"content": "Hmm, tuy nghe giống như đang khen tôi, nhưng sao lại thấy là lạ thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610243,
					"content": "Thời gian xếp hàng vừa lâu vừa chán, các bạn dần quên đi nhiệm vụ của mình.\\nChỉ có tiếng nói chuyện to nhỏ nhắc nhở rằng thời gian đang trôi qua.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740610244
					]
				},
				{
					"id": 740610244,
					"content": "Tôi bắt đầu thấy chóng mặt rồi... Tiêu rồi, không phải tôi cũng phải chờ đến ngày mai mới gửi được thư đi đấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610245
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610245,
					"content": "Cầm lấy cái này ăn lót dạ đi đã. Chuẩn bị đủ thức ăn và nước uống chính là kiến thức khi xếp hàng ở đây đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610246
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610246,
					"content": "Cảm ơn. Nhưng thế này không phải hơi bị lố sao... Chỉ là xếp hàng thôi mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610247
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610247,
					"content": "Đúng là tấm chiếu mới. Nơi này là chiến trường khốc liệt nhất ở Pháo Đài Meropide đó. Cho dù là Đấu Trường Sức Mạnh cũng không bằng nó đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610248
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610248,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610249
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610249,
					"content": "Mỗi người xếp hàng đều vạch ra một kế hoạch cụ thể, có vài người còn mang theo ghế để ngồi nữa. Có người còn ghê gớm hơn, tối hôm trước đã ngủ sẵn ở cổng để chờ tới giờ mở cửa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610250
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610250,
					"content": "Không phải chỉ là xếp hàng thôi ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610251
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610251,
					"content": "Đây không phải xếp hàng bình thường, đây là chiến tranh! Mỗi người đều phải dốc hết sức mình! Ngay cả Decembre số nhọ cũng phải chuẩn bị đủ loại phương án dự phòng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610252
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610252,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610253
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610253,
					"content": "Đáng tiếc, phương án dự phòng cũng không thể cứu được anh ta. Lúc tôi quay về từ Khu Sản Xuất thì thấy anh ta rời khỏi đội ngũ rồi chạy về phía Nhà Ăn Đặc Cách đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610254
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610254,
					"content": "Nên tôi mới hỏi là anh ta không xếp hàng nữa sao? Anh đoán xem anh ta trả lời thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610255
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610255,
					"content": "Anh ta quá tập trung vào kinh nghiệm thất bại trước đó. Kết quả là anh ta quên mất chuyện quan trọng nhất, chính là mang theo thư! Nên chỉ có thể đi thêm lần nữa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610256
					],
					"speakerTitle": "Người Đàn Ông Cởi Mở"
				},
				{
					"id": 740610256,
					"content": "...Nghe anh kể như thế, tự nhiên tôi muốn gặp anh ta quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610257
					],
					"speakerTitle": "Người Đàn Ông Mệt Mỏi"
				},
				{
					"id": 740610257,
					"content": "Hả?! Không mang theo thư? Decembre đúng là số nhọ mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610258,
						740610259
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610258,
					"content": "Vậy cái chúng ta đang cầm là gì đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610260
					]
				},
				{
					"id": 740610260,
					"content": "Đúng đó! Chẳng phải thư đang ở chỗ chúng ta sao? Tôi bắt đầu thấy rối rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610261,
					"content": "Chúng ta mở thư ra xem thử đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610262
					]
				},
				{
					"id": 740610262,
					"content": "Để tôi xem trong thư viết gì nào... Chà! Đây là gì đây? Hoàn toàn không liên quan gì tới Decembre luôn ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610263,
						740610264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610263,
					"content": "(Mọi thông tin đều không khớp.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610265
					]
				},
				{
					"id": 740610265,
					"content": "#{NICKNAME}, sắp đến lượt chúng ta rồi! Hay là cứ gửi thư đi trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740610266,
					"content": "Việc này xem như cũng có ý nghĩa, bởi vì cuối cùng các bạn cũng kết thúc khoảng thời gian chờ đợi như tra tấn này.\\nNhưng với bạn mà nói thì đây vẫn chưa thể xem như đã giải thoát, vì vẫn còn nghi hoặc quanh quẩn.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740610264,
					"content": "(Lát nữa phải hỏi anh ta mới được...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610265
					]
				},
				{
					"id": 740610259,
					"content": "Không phải anh ấy đưa thư cho chúng ta rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610260
					]
				},
				{
					"id": 740610241,
					"content": "Dù gì lúc nào Paimon cũng đói bụng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610242
					]
				},
				{
					"id": 740610242,
					"content": "Hihi, nhét đầy bụng là chuyện quan trọng nhất trên đời mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610243
					],
					"speakerTitle": "Paimon"
				}
			]
		},
