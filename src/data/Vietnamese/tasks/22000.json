			"dialogs": [
				{
					"id": 220000301,
					"content": "Sạch sẽ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000302,
					"content": "Sạch sẽ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "#Ừm! Vất vả cho {F#chị}{M#anh} quá, cái này cho {F#chị}{M#anh}, cảm ơn {F#chị}{M#anh} đã chơi cùng chúng em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000304,
					"content": "Về sau hãy làm một người tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000305,
					"content": "Ê, bao giờ mới đến lượt tôi làm thuyền trưởng vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000306,
					"content": "Lần sau nhé, lần sau là bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000307,
					"content": "Hứ, lần trước cũng nói vậy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				}
			]
