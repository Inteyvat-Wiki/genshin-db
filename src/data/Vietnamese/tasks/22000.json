			"dialogs": [
				{
					"id": 220000101,
					"content": "Hôm nay chúng ta chơi gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000102,
					"content": "Hừm, nếu không ai làm hải tặc thì hôm nay cũng không chơi được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000103,
					"content": "Thế nhưng ai cũng không muốn làm hải tặc, phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000104,
					"content": "Các em đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "Chúng em đang chơi trò chơi, nhưng vẫn thiếu một người diễn hải tặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000106,
					"content": "Vì không có ai muốn làm hải tặc đến cướp bóc, nên chúng em vẫn chưa thể bắt đầu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000107,
					"content": "#Đúng rồi! {F#Chị}{M#Anh} có thể đóng vai hải tặc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000108,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Được chứ! Vậy chúng em đi chuẩn bị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000115,
					"content": "Chuẩn bị xong rồi thì qua đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000110,
					"content": "Tôi không biết cái này lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "Không sao đâu, hải tặc... Là kiểu không biết đạo lý là gì, là kẻ xấu hứng lên là cướp đồ của người khác ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000112,
					"content": "Tuy là em cũng chưa gặp bao giờ, nhưng có nghe chị Beidou nói qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000113,
					"content": "Em thấy... Người như vậy chắc cũng nhiều đất diễn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000114,
					"content": "#Hihi, vậy nhờ {F#chị}{M#anh} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "A Meng"
				}
			]
		},
