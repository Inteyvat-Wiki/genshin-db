			"dialogs": [
				{
					"id": 220000501,
					"content": "Xử lý xong hết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000502,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "#Hãy đi dọn dẹp nó đi, nhưng đây là cơ hội để {F#chị}{M#anh} cải tà quy chính đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000504,
					"content": "Ê, tôi nói rồi, làm người dọn dẹp có thể cải tà quy chính hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000505,
					"content": "Chỉ cần đồng ý làm việc tốt thì đó là người tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000506,
					"content": "Cũng dễ quá mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000507,
					"content": "Người tốt làm việc tốt, kẻ xấu làm điều xấu, chỉ đơn giản như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000508,
					"content": "Hứ, bạn nói dễ thì dễ, nhưng nếu dễ như vậy thì trên đời này làm gì có người xấu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000509,
					"content": "Là do việc trên đời này nói thì dễ, làm thì khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000510,
					"content": "Hơn nữa làm việc xấu dễ hơn việc tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000511,
					"content": "Đây cũng là lời chị Beidou nói?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000512,
					"content": "Là do tôi đọc được đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
