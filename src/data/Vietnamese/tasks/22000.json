			"dialogs": [
				{
					"id": 220000201,
					"content": "Chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "Vậy bắt đầu thôi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000203,
					"content": "Bắt đầu từ đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000204,
					"content": "Tên kia, cướp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "Á á! Là hải tặc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220000206,
					"content": "Lulu mau đến đây, tôi sẽ bảo vệ bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220000207,
					"content": "Là hải tặc, tại sao lại cướp bóc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000208,
					"content": "Ta là hải tặc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Hải tặc cũng có tốt xấu, không nhất thiết phải cướp bóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000211,
					"content": "Chị Beidou cũng nói bản thân mình là hải tặc, nhưng chị ấy là người tốt, đem đồ ăn ngon cho tôi và mọi người đều thích chị ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000212,
					"content": "#Vì sao {F#chị}{M#anh} phải làm hải tặc xấu mà không phải tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000213,
					"content": "Chẳng phải em nói hải tặc là loại \"không nói đạo lý\" mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "Được rồi, tôi sai rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Í, bằng lòng cải tà quy chính là việc tốt. Chị Beidou đã nói vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000217,
					"content": "#Vậy thì {F#chị}{M#anh} mau đi dọn dẹp xung quanh, chỉ cần làm việc tốt là trở thành người tốt, là một hải tặc tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220000215,
					"content": "Tôi muốn làm người tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "Hải tặc chuyên cướp bóc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
