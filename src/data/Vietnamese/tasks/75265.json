				"objectNames": [
					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "Này! Chỗ tôi có vài món đồ tốt, giá cả cũng lý tưởng, có muốn xem thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "Ủa? Đây không phải là đồ chơi Koholasaur đó sao? Hình như đã từng thấy ở Chợ Nhàn Nhã rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "Có mắt nhìn đấy chứ, nhưng giá của tôi rẻ, bán nửa giá thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "Tại sao lại rẻ như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "Haha, đừng lo, tôi có cách riêng của mình ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "Tuy là rẻ hơn nhiều, nhưng cảm thấy màu sắc của những con búp bê này có hơi kỳ lạ, không phải là hàng giả đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Hàng giả? Cái đồ không biết gì về hàng hóa kia... Mau tránh ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "Đi mau! Tôi không bán cho hai người nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
		{
