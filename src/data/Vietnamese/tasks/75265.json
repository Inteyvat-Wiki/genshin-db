			},
			"dialogs": [
				{
					"id": 752650301,
					"content": "Này! Chỗ tôi có vài món đồ tốt... Hả!? Sao lại là hai người nữa vậy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650302,
					"content": "Đã nói là không bán rồi mà, nghe không hiểu sao? Tránh ra đi, đừng cản trở ở đây thế chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650303,
					"content": "Cái tên này... Bây giờ xin lỗi chúng tôi vẫn còn kịp đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650304,
					"content": "Hai người có bị gì không vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650305,
					"content": "Anh bán hàng giả phải không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "Hah? Thế thì sao? Hai người nên bớt lo chuyện bao đồng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
