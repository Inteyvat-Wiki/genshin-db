				]
			},
			"dialogs": [
				{
					"id": 747140101,
					"content": "#{NICKNAME} và Paimon, tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140102,
					"content": "Lý do gần đây số thợ lặn tăng lên là để xử lý rác thải dưới nước, đẩy nhanh tiến độ phục hồi môi trường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140103,
					"content": "Nếu là như vậy, tôi nên cố gắng giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140104
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140104,
					"content": "Nếu ô nhiễm dưới nước trở nên nghiêm trọng, Hoa Romaritime sẽ trở nên ảm đạm, còn có nhiều hậu quả khủng khiếp khác mà tôi không dám nghĩ tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140105
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140105,
					"content": "Chúng tôi cũng sẽ góp sức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140106
					]
				},
				{
					"id": 747140106,
					"content": "Được! Vậy thì cùng cố gắng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140107,
					"content": "À đúng rồi, Freminet, khi ở dưới nước, chúng tôi tìm được một... kết cấu trông cũng khá xịn xò? Trông như thành phần của nhạc cụ nào đó ấy? Cậu xem thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140108,
					"content": "Được... Ồ, cấu tạo rất tinh xảo. Tôi từng nghiên cứu một số máy móc, nhưng trên thị trường thì chưa từng thấy tác phẩm nào tinh vi và độc đáo như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140109,
						747140110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140109,
					"content": "Cảm giác đặt ở đây cũng không tệ nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				},
				{
					"id": 747140111,
					"content": "Ừm, nhưng có vẻ còn thiếu vài thành phần khác nữa mới có thể khôi phục được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140112,
					"content": "Ừm! Từ từ thôi. Tôi cũng rất tò mò sau khi được sửa xong thì nó sẽ thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140113,
					"content": "Vậy tôi tiếp tục xuống nước giúp đỡ đây. Hai người có thể nghỉ ngơi thêm một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140114
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140114,
					"content": "Được, cậu cũng chú ý nghỉ ngơi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140115,
					"content": "Ơ? Thứ này... là hai người vớt lên à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747140116,
					"content": "Ừm, Sandrone, cô có biết đây là gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140117,
					"content": "Ha, đâu chỉ biết? Trước đây ngày nào tôi cũng ngồi trong vườn đàn nó mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747140118,
					"content": "Hả?! Đây là... đồ của cô sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140119,
					"content": "Từng là thôi. Đây là cây đàn piano cơ khí do Alain phát minh, vừa có thể để người đàn, vừa có thể tự đàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747140120,
					"content": "Lợi hại vậy à... Thế sao nó lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140121,
					"content": "Sau khi Alain bệnh nặng, ông ấy không thể nghe tiếng đàn nữa, nên tôi đã mang nó đi xử lý. Nhưng không ngờ được gặp lại nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747140122,
					"content": "Tôi đoán là người nhận được cây đàn piano này đã dùng hỏng mà không biết sửa, nên cuối cùng đã trở thành thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747140123,
					"content": "Cô có sửa được nó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140124
					]
				},
				{
					"id": 747140124,
					"content": "Dĩ nhiên rồi. Cái này đâu làm khó được tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747140125,
					"content": "Ừm, nhưng mà trông nó tan tành quá... Nếu hai người tìm được những phần còn lại của cây đàn piano thì tôi có thể nhanh chóng bắt tay vào việc sửa nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747140126,
					"content": "Được! Vậy thì thường ngày xuống nước, chúng tôi sẽ chú ý tìm thêm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140110,
					"content": "Hợp với không gian ở đây lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				}
			]
		}
	]
}