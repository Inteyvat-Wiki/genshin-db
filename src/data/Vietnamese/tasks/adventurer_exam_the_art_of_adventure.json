			"dialogs": [
				{
					"id": 200200101,
					"content": "Thì ra là vậy, thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200102,
					"content": "Anh, anh có biết loại cây này ngoài để nấu ăn ra thì còn công dụng gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200103,
					"content": "Sao anh biết được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200104,
					"content": "Anh chỉ biết hái chúng ở đâu, và chúng có ăn được hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200105,
					"content": "Ừm...vậy em tự đi xem được rồi, anh yên tâm đi, em chỉ đi thu thập thực vật thôi, tuyệt đối không đến gần ma vật đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200106,
					"content": "Haiz, em tự biết cẩn thận là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200107,
					"content": "Em biết rồi. Vậy hôm nay em về muộn một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200108,
					"content": "Cô vẫn đang tập luyện sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "Nhà Lữ Hành! Bạn đến thật đúng lúc, tôi đang chuẩn bị đi ra bên ngoài quan sát thực vật đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200111,
					"content": "Chú Cyrus nói với tôi, Nhà Mạo Hiểm thường hay ngủ ở bên ngoài, và tìm kiếm thức ăn là một khả năng rất quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200112,
					"content": "Vì vậy tôi định đi quan sát thực vật ở bên ngoài, ghi chép lại điểm phân bố và đặc tính của chúng rồi học thuộc dần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200113,
					"content": "Như vậy, sau này khi tìm thức ăn ở bên ngoài, ít nhất tôi sẽ biết loại nào ăn được, loại nào không ăn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200114,
					"content": "Nhưng mà...chỉ mô tả bằng chữ thì tôi thấy không đủ trực quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200115,
					"content": "Nhà Lữ Hành, tôi nghe nói bạn có một thứ gọi là máy ảnh, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200116,
					"content": "Bạn có thể giúp tôi ghi lại môi trường sinh trưởng của một số loài thực vật bằng máy ảnh được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200117,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "Vậy nhờ bạn giúp tôi ghi lại môi trường sinh trưởng của Hoa Calla Lily, Tiểu Đăng Thảo, và cả Cecilia nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200119,
					"content": "Sau đó hãy thu thập giúp tôi ba loại thực vật này, tôi cần dùng chúng làm tiêu bản để lưu trữ lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200120,
					"content": "Ảnh tư liệu về môi trường sinh trưởng của thực vật, tiêu bản thực vật và bài miêu tả chi tiết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200121,
					"content": "Cuốn \"những ghi chép về thực vật của nhà thám hiểm\" của tôi chắc chắn sẽ rất hay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200122,
					"content": "Vậy thì nhờ bạn nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200123,
					"content": "Bên con suối ở Thanh Tuyền Trấn chắc là có rất nhiều Hoa Calla Lily, Tiểu Đăng Thảo thì tìm trong Lang Lãnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200124,
					"content": "Cecilia...đương nhiên phải đến Vực Hái Sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200125,
					"content": "Tôi phải đi đến những nơi khác để tiếp tục quan sát thực vật đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200126,
					"content": "Đợi khi bạn chụp xong thì chúng ta gặp nhau ở trong thành nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200109,
					"content": "Cô tập luyện thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
