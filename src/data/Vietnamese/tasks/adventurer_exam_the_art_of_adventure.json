				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "Nhà Lữ Hành, bạn về rồi à, thế nào? Có chụp được ảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "Chụp xong hết rồi, và cũng hái về hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "Woa! Sao bạn chụp nhanh vậy...đây chính là nhà mạo hiểm kinh nghiệm phong phú sao? Thật lợi hại....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "Cảm ơn bạn, Nhà Lữ Hành! Ừm...thế này đi, để cảm ơn bạn, tôi sẽ đích thân làm một món ngon tặng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "Thế nào, nhìn cũng ngon phải không, hãy nếm thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "Tôi về viết nhật ký tiếp đây. Ừm...số cây này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "Tôi phải đi hỏi Jack, xem Jack có biết cách làm tiêu bản không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "Cecilia thì không làm tiêu bản nữa, cắm vào bình là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
