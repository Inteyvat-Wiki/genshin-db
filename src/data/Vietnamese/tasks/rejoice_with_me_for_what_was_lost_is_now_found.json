					"Người Giao Dịch Fatui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441701,
					"content": "Đừng, đừng đánh nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441702,
					"content": "Mau dừng tay, còn đánh nữa là sẽ xảy ra án mạng thật đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441703,
					"content": "Người bị đánh nói những lời này đúng là có sức thuyết phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441704,
					"content": "Nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441705,
					"content": "Mau nói!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "Tôi nói tôi nói, các vị muốn biết gì tôi đều nói hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441707,
					"content": "Nói những gì ngươi biết trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441708,
					"content": "Chúng, chúng tôi chỉ thực hiện một số giao dịch với Aderfi thôi... Nghe nói chủ mẫu của Tanit thích Azariq gì đó... còn có cả cô gái mới đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441709,
					"content": "Hừm, mặc dù tôi không biết chuyện gì đang xảy ra, nhưng hình như Azariq cũng mất tích rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441710,
					"content": "Người phụ nữ đó rất tàn nhẫn và sẽ không tha thứ cho những người làm mất giá trị của bộ tộc... Vì vậy, vì để giữ địa vị của mình, Aderfi đã liên hệ với chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441711,
					"content": "Công việc của chúng tôi ở sa mạc trước đây không suôn sẻ lắm, lần này thì có vẻ ổn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441712,
					"content": "Mất đi giá trị... ý ngươi là sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "Tôi không biết... Tôi thật sự không biết! Đó là chuyện nội bộ của họ... nhưng theo như tôi đoán, có thể là vì người phụ nữ đó cho rằng chúng tôi không đáng tin cậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441714,
					"content": "...Vì vậy cô ta mới xa lánh chúng tôi, và Aderfi thường hay liên lạc với chúng tôi cũng vì vậy mà cảm thấy bất an...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441715,
					"content": "Dù sao chúng tôi cũng vẫn còn có thể rút khỏi nơi quỷ quái này, còn anh ta thì chỉ có thể bị rút hết giá trị, sau đó bị bộ tộc xử lý thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441724,
					"content": "Chỉ là Aderfi cực kỳ gian xảo, chúng tôi đã đưa rất nhiều thứ hắn ta cần, nhưng thứ chúng tôi cần lại chẳng có là bao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441725,
					"content": "Nhưng nghe hắn ta xảy ra chuyện... Mặc dù không biết xảy ra chuyện gì, nhưng chúng tôi nghĩ, đây chẳng phải là cơ hội tốt sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441726,
					"content": "Cơ hội tốt? Cơ hội tốt gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441727,
					"content": "Chúng tôi nghĩ sau này có lẽ cũng không còn cơ hội giao dịch với Aderfi nữa, vì vậy chúng tôi đã yêu cầu hắn ta mang theo Kết Cấu Nguyên Thủy đặc biệt gì đó được đề cập trong các bức thư trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441728,
					"content": "Nếu có thể thì chúng tôi sẽ cướp về, mấy ngày nữa chúng tôi sơ tán hết, xem như không nợ không nần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441729,
					"content": "Cái gì, thì ra các ngươi cũng muốn cướp đồ sao. Chẳng trách cả hàng hóa lẫn \"Vật Chứa Chuyển Hóa Năng Lượng\" cũng không thấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441730,
					"content": "Hả? \"Cũng\" muốn đến cướp đồ là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441731,
					"content": "Đúng, mau đưa \"Vật Chứa Chuyển Hóa Năng Lượng\" ra đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "Ừm, chẳng lẽ \"Vật Chứa Chuyển Hóa Năng Lượng\" gì đó cũng là do các ngươi bịa ra đó chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441734,
					"content": "Không, Vật Chứa Chuyển Hóa Năng Lượng là thật, nhưng vì cũng là đồ cổ và có rất nhiều, nên không biết trong đó có cái nào dùng được không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441735,
					"content": "Vậy Vật Chứa Chuyển Hóa Năng Lượng đang ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441736,
					"content": "Paimon oai thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#Hihi, vậy sao... {NICKNAME} đừng chuyển chủ đề nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441738,
					"content": "Mau nói ra chỗ cất đồ của các ngươi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441739,
					"content": "Ở một căn cứ gần đây, đây là chìa khóa... Những gì tôi biết tôi đều nói hết rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441740,
					"content": "Đi thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "Được được, tôi đi ngay đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441741,
					"content": "Đừng để bọn ta gặp lại ngươi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "Gặp bọn ta xem như ngươi xui xẻo rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "Công việc của các ngươi ở sa mạc...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "...Bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441718,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#Ngươi xem, ngươi chọc {NICKNAME} nổi giận rồi đó! {NICKNAME} mà nổi giận thì hậu quả rất nghiêm trọng đó nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441720,
					"content": "Ừm...! Thôi được, thôi được! Đừng giận, tôi nói là được chứ gì! Mặc dù... mặc dù chuyện tôi biết cũng không nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441721,
					"content": "Nhiệm vụ của chúng tôi là điều tra tình hình hiện tại của cư dân các bộ lạc ở sa mạc, lôi kéo và dụ dỗ họ bằng con đường buôn bán, thu hút sự chú ý của hiền giả... để mang lại sự thuận tiện cho Quan Chấp Hành đại nhân trong thành Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441722,
					"content": "Ngoài ra... Giáo sư Froderock cũng đang tìm kiếm các mẫu sống trong sa mạc, ông ấy luôn không tuân theo sự lãnh đạo của ngài \"Dottore\"... Theo tôi, như vậy là ghen tị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				},
				{
					"id": 732441723,
					"content": "E hèm, nói nhiều quá rồi... Nói tóm lại thì Aderfi là người liên lạc với chúng tôi, giao dịch vật tư của chúng tôi cũng là do hắn ta phụ trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Người Giao Dịch Fatui"
				}
			]
		},
		{
