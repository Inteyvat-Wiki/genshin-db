			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "Nhìn này, hình như ở đây có thứ gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440302,
					"content": "Nhưng trông có vẻ như không giống ghi chép, mà là một bức thư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440303,
					"content": "Thư gì, mau mở ra xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440304,
					"content": "Theo như ý nghĩa của bức thư thì Benben không còn năng lượng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440305,
					"content": "Nghĩ lại thì dù là mở cửa Lăng Mộ Vua Deshret, hay kích hoạt quyền hạn cho chúng ta, Benben cũng đã giúp chúng ta rất nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440306,
					"content": "Cho dù là Benben, cũng sẽ cảm thấy mệt... Có thể là vì giúp chúng ta quá nhiều chuyện nên mới mất đi năng lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440307,
					"content": "Bên trên có nhắc đến Vật Chứa Chuyển Hóa Năng Lượng đặc biệt gì đó, nhưng trong lều hình như không có thứ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440308,
					"content": "Chẳng lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440309,
					"content": "Giấu ở nơi nào đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "Không giống lắm, nếu chỉ dùng để bảo trì Benben thì cũng không cần giấu đi làm gì, chẳng phải chỉ cần sử dụng trực tiếp là được rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440311,
					"content": "Tôi hiểu rồi! Chắc chắn là giao dịch này vẫn chưa phát sinh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440314,
					"content": "Cho nên Benben chưa bị Aderfi đưa đến nơi giao dịch, đương nhiên cũng không có Vật Chứa Chuyển Hóa Năng Lượng... Chỉ còn lại một vấn đề, đối tượng giao dịch với Aderfi là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440315,
					"content": "Hơ, đúng là một câu hỏi ngu ngốc, người bên ngoài bộ lạc giao dịch kiểu này với hắn e là chỉ có một loại người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440316,
					"content": "Là học giả Sumeru sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "Là Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440320,
					"content": "Vậy bây giờ chúng ta phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440321,
					"content": "Còn sao nữa, còn có gì để nói với bọn Fatui đó chứ. Tất nhiên là đến nơi giao dịch, cướp Vật Chứa Chuyển Hóa Năng Lượng kia về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440322,
					"content": "Được lắm, cướp về lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440323,
					"content": "Nhưng Benben... Với tình trạng bây giờ của Benben thì không thể mang trên người, và đương nhiên cũng không thể mang nó đến địa điểm giao dịch được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440324,
					"content": "Nếu để ở nơi khác thì cũng không an toàn. Để nó một mình ở một nơi khác... một lần là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440325,
					"content": "#Vây thì thế này đi, tôi và {NICKNAME} đi cướp Fatui, cô và Benben đợi ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440326,
					"content": "Được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "Được! Chúng ta đi cướp Fatui thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440330,
					"content": "#Mặc dù rất muốn tự mình đi, nhưng mà... {NICKNAME}, Paimon, Benben có hồi phục được hay không là nhờ vào hai bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440331,
					"content": "Vả lại, mặc dù đối phương chỉ là một bọn Fatui, nhưng cũng phải chú ý an toàn nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440332,
					"content": "Không sao đâu! Cứ yên tâm giao cho chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440333,
					"content": "Ừm, tôi cũng... không thể để Benben ở lại chỗ tên phản bội Aderfi này được, tôi sẽ đưa nó về chỗ tôi trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440334,
					"content": "Đợi khi lấy được Vật Chứa Chuyển Hóa Năng Lượng thì gặp nhau ở lều của tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440328,
					"content": "Cướp Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "Ừm, dù sao thì cũng không phải lần đầu mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440318,
					"content": "Là Fatui!",
