					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441020,
					"content": "Theo thói quen của tên đó, nếu đã điều tra thì chắc chắn sẽ để lại ghi chép. Chúng ta thử tìm xung quanh xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441021,
					"content": "Nếu không phải vấn đề gì nghiêm trọng, nói không chừng chúng ta cũng có thể giải quyết!",
