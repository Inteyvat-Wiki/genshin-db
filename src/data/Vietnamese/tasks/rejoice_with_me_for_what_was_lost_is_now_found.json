					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440312,
					"content": "Vẫn chưa lấy được?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "À, tôi hiểu ý của bạn, giao dịch này vẫn chưa phát sinh!",
