			"dialogs": [
				{
					"id": 732441901,
					"content": "Vật Chứa Chuyển Hóa Năng Lượng, hy vọng sau khi lấy được thứ đó sẽ có thể giúp Benben hồi phục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441902,
					"content": "Nếu không yên tâm thì tôi sẽ đi cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441903,
					"content": "Cô ở đây với Benben đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "Ừm, vậy thì tôi sẽ ở đây chờ tin của các bạn, nhất định phải trở về an toàn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441904,
					"content": "Chúng tôi sẽ quay về ngay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
