			"dialogs": [
				{
					"id": 200180101,
					"content": "Cám ơn bạn, Nhà Lữ Hành, hừ... tôi biết mà, tôi nhất định sẽ làm hỏng việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Magar Sợ Hãi"
				},
				{
					"id": 200180102,
					"content": "Chỉ là chuyển một xe rượu thôi cũng làm hỏng được, tôi rốt cuộc làm được cái gì chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Magar Sợ Hãi"
				},
				{
					"id": 200180103,
					"content": "Cứ như vậy sẽ bị tửu trang đuổi việc, ngài Connor không chừng đã sớm thấy năng lực làm việc của tôi không ổn, tiên sinh Elzer có thể đã viết xong thư đuổi việc tôi, thôi xong, hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Magar Sợ Hãi"
				},
				{
					"id": 200180104,
					"content": "Bạn... bạn bình tĩnh chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "Hức, tôi nhất định tiêu rồi, nhưng xe rượu này vẫn phải chuyển đến nơi mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Magar Sợ Hãi"
				},
				{
					"id": 200180106,
					"content": "Xe cũng bị hỏng rồi... Nhà Lữ Hành, có thể phiền bạn tìm giúp chút vật liệu không? Chỉ cần một <color=#00E1FFFF>thanh gỗ chắc chắn</color> là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar Sợ Hãi"
				}
			]
		},
