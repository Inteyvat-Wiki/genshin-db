					"speakerTitle": "Magar Sợ Hãi"
				},
				{
					"id": 200180404,
					"content": "Thôi vậy, đem xe về thị trấn trước rồi nghĩ cách sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Magar Sợ Hãi"
				},
				{
					"id": 200180405,
					"content": "Tôi nhớ trên xe có dây thừng... nhất định là bị đám đó lấy mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
