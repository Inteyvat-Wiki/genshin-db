			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "Là Arama và Nara Vàng à, bạn cao thật đó, nhưng còn màu trắng ở cạnh bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "Hử? Màu trắng thì làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "Nên nói thế nào nhỉ... Chắc là sẽ chui vừa vào các hốc cây nhỏ hẹp, rất tiện lợi! Tốt quá đi mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#Ừm! Dựa theo tập tục của Nara, nên giới thiệu trước mới phải. Đây là Nara {NICKNAME} và Paimon, đây là Arakavi, các bạn bắt tay đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "Bắt tay Arakavi với vẻ đầy bối rối...\\n Không dám dùng sức quá mạnh.\\n Cảm xúc đặc biệt thật.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "Thú vị thật đó. Trước đây tôi nghe mọi người nói rất nhiều chuyện về Nara rồi, nhưng đây là lần đầu tiên tiếp xúc trực tiếp với cơ thể của Nara. Cảm giác kỳ diệu thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "Lần cuối cùng có Nara đến chỗ chúng tôi là từ lâu lắm rồi. Có rất nhiều hạt giống đã trưởng thành thành đại thụ, biết bao câu chuyện xưa giờ trở thành truyền thuyết. Nghe nói, đó là Nara rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Nara {NICKNAME} cũng là Nara tốt, dũng cảm lại mạnh mẽ, như cây nhỏ mọc bên bờ vách đá. Hơn nữa, họ đến đây vì giúp Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Ồ, Arana ư... lâu rồi không gặp, mong là mọi thứ đều ổn cả. Cũng mong các Nara nhỏ ở Làng Vimara khỏe mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "Bạn cũng quen đám nhỏ ở Làng Vimara ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Đương nhiên rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "Chúng ta đều quen nhau! Arana quay về đã kể hết những câu chuyện về các Nara nhỏ tuổi. Vì thế, Nara Iotham, Nara Bahram, Narana đều là những người bạn Nara của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "Nghe vậy có vẻ cũng không giống quen biết cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "Vậy, vậy phải như thế nào mới tính là quen? Phải như Nara, \"giới thiệu\" xong rồi \"bắt tay\" ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "Ừ ừ, những gì Paimon nói tôi hiểu. Nara còn phải ăn cơm với nhau, tìm \"kho báu\" với nhau mới tính là quen nhau, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "Mọi chuyện cũng không đơn giản như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "Chỉ cần biết câu chuyện về một người, là coi như quen rồi. Bởi Aranara là thế giới của các khúc ca và giấc mộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Ừm, Arakavi nói đúng. Đối với Aranara thì, chỉ cần nghe được bài hát miêu tả về Nara {NICKNAME}, nhìn thấy hình dạng của Nara {NICKNAME} trong giấc mơ là đã quen nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "Tôi thấy, cái này có thể để sang một bên... Bởi vì, chúng tôi đã là bạn của Aranara rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "Bạn tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama Và Arakavi"
				},
				{
					"id": 730810325,
					"content": "Bạn tốt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Ừm, muốn tổ chức Lễ Hội Utsava, Arakavi phải chuẩn bị cho tốt đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "Quả nhiên là vậy. Là vì Bija đúng không? Tôi đã kêu Arayasa, Aradasa và Arasudraka đi tìm \"Sảnh Ashvattha\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Trực giác chuẩn thật... Có điều, tại sao các bạn không biết Sảnh Ashvattha ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "Sảnh Ashvattha là nơi rất thần thánh, bình thường chúng tôi không tới đó. Để yên cho Cây Vasara ngủ say trong giấc mộng thôi. Cho tới khi nào tất cả ký ức gặp nhau nơi Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "Rừng rậm sẽ nhớ tất cả. Tất cả những điều tốt đẹp sẽ không tan đi. Tất cả những điều đau khổ sẽ thành chất dinh dưỡng cho những điều tốt đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "Tóm lại Arayasa, Aradasa và Arasudraka đang đi tìm Sảnh Ashvattha ở bên ngoài. Arama hãy đi giúp họ nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#Ừ, tôi đi đây. Nếu Nara {NICKNAME} và Paimon gặp chúng tôi trong rừng thì chúng ta đi cùng nhau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Tốt tốt. Rất vui được quen các bạn, Nara {NICKNAME} và Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "Nói chuyện chính trước đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Nên nói thế nào nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "Tôi và Paimon cùng nhau ăn cơm, cùng nhau tìm kho báu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "Ừm! Chúng tôi chẳng những quen nhau, mà còn là bạn đồng hành tốt nhất của nhau nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#Nara {NICKNAME} và Paimon, tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
