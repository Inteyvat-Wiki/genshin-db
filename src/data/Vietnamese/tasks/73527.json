	"talks": [
		{
			"id": 7352701,
			"completionStepIds": [
				7352701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352701",
							"2"
						],
						"stepId": 7352701,
						"stateName": "QUEST_STATE_UNFINISHED"
