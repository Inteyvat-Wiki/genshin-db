				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chatillon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735270101,
					"content": "Không ngờ sau khi bị cảnh báo, hai người không rời đi mà lại lần theo âm thanh tới đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270102
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270102,
					"content": "Xin lỗi, trò chơi này vẫn chưa ra mắt chính thức, chờ vài phút để tôi điều chỉnh lại lần cuối nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270103,
						735270104
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270103,
					"content": "Anh đang có âm mưu gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270105
					]
				},
				{
					"id": 735270105,
					"content": "Chúng tôi nghe thấy từ Pháo Nước! Nguy hiểm thật! Chắc là thứ ở bên kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270106,
					"content": "Woa! Trông đáng sợ thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270107,
					"content": "Anh muốn làm gì? Chúng tôi sẽ không để yên đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270108,
					"content": "Không phải, hai người hiểu lầm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270109
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270109,
					"content": "Tôi là Chatillon, đang phụ trách dự án \"Loạn Chiến\", là một trò chơi nhỏ lấy bối cảnh trên biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270110
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270110,
					"content": "\"Loạn Chiến\" đã được Idyia duyệt rồi, nên có thể yên tâm về độ an toàn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270111
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270111,
					"content": "Nếu không tin thì có thể xem thử tài liệu có chữ ký của Idyia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270112
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270112,
					"content": "Chatillon trình văn bản liên quan và có chữ ký của Idyia ra.\\nBên cạnh còn ghi thêm vài lời cổ vũ. Xét về mặt chữ và phong cách thì đúng là của Idyia...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735270113
					]
				},
				{
					"id": 735270113,
					"content": "Hóa ra là dự án do Idyia phê duyệt... làm chúng tôi hết hồn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270114,
					"content": "Vậy Pháo Nước mà anh nhắc đến là gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270115,
					"content": "Chỉ là một cái tên tóm gọn thôi. Tên của thiết bị đó quá dài, nên người ta chỉ nhìn ngoại hình và gọi là Pháo Nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270116
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270116,
					"content": "Nhưng bóng nước bắn ra thì khá vô hại, cùng lắm thì khi trúng mục tiêu sẽ làm những du khách xung quanh bị ướt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270117
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270117,
					"content": "Có người thích cảm giác mát lạnh khi bị ướt, có người lại ghét vì quần áo sẽ dính vào người. Nên không thể để họ thấy khó chịu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270118
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270118,
					"content": "Nếu được thì tôi còn muốn đặt một vài biển báo ở gần đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270119
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270119,
					"content": "Không ngờ anh lại chu đáo thế, ý hay đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270120,
						735270121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270120,
					"content": "Tôi cũng hơi tò mò...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270122
					]
				},
				{
					"id": 735270122,
					"content": "Tên đầy đủ là \"Pháo Bắn Nước Giải Trí Kiểu Chiến Hạm Hạng Nặng Bọc Thép Hình Dạng Cá Sấu\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270123
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270123,
					"content": "Dài thật đấy! Không nhớ được, cũng không hiểu luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270124,
					"content": "Nhưng gọi là Pháo Nước thì không oai. Gọi là... Pháo Cá Sấu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270125,
					"content": "Chà, cái tên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270126
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270126,
					"content": "Hay đó! Đơn giản lại dễ nhớ, nghe là đã liên tưởng đến những trận pháo chiến trên biển rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270127
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270127,
					"content": "Pháo Cá Sấu! Bắn bên này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270128
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270128,
					"content": "Pháo Cá Sấu! Bắn bóng nước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270129,
						735270130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270129,
					"content": "Nghiêm túc sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270131
					]
				},
				{
					"id": 735270131,
					"content": "Nói chung thì tôi nghĩ chúng ta rất ăn ý! Bạn chắc cũng sẽ thấy thích trò chơi này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270132
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270132,
					"content": "Vậy hai bạn làm khách hàng đầu tiên của \"Loạn Chiến\" nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270133
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270133,
					"content": "Luật chơi đơn giản lắm! Chỉnh hướng của \"Pháo Cá Sấu\", bắn trúng các mục tiêu sẽ nhận điểm tương ứng, điểm đủ cao thì nhận được thưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270134
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270134,
					"content": "Cũng được, tôi cũng muốn thử xem cảm giác điều khiển Pháo Cá Sấu là như thế nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270135,
						735270136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735270135,
					"content": "Tôi nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270137
					]
				},
				{
					"id": 735270137,
					"content": "Tốt! Tôi điều chỉnh lại thiết bị một chút là sẽ chơi được ngay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735270138
					],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270138,
					"content": "Hy vọng các bạn chơi vui vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chatillon"
				},
				{
					"id": 735270136,
					"content": "Pháo Cá Sấu! Bắn nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270137
					]
				},
				{
					"id": 735270130,
					"content": "Paimon đừng bắt chước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270131
					]
				},
				{
					"id": 735270121,
					"content": "Tên thật của nó là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270122
					]
				},
				{
					"id": 735270104,
					"content": "Mau dừng lại!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735270105
					]
				}
			]
		}
	]
}