			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "Haiz, thật không khiến cho người ta bớt lo được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "Có gì cần giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "Dạo này chúng tôi thật sự không đủ người, đã mấy ngày liền tôi không được nghỉ ngơi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "Nhà Lữ Hành, nếu bạn không bận gì, có thể giúp tôi đưa thuốc cho bệnh nhân ở gần đây không? Cũng nhờ bạn xem thử tình trạng của họ với.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Vậy nhờ bạn nhé, vì Thảo Thần, tôi thật sự rất cần một người hỗ trợ không luôn miệng nhắc tới chuyện mong Thảo Thần phù hộ suốt cả ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "Ha, vì Thảo Thần... Mình đọc rành rẽ thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "Anh nên nghỉ ngơi một chút đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Tôi không nghỉ được, còn nhiều bệnh nhân bị nặng hơn đang chờ tôi, tôi phải kê đơn thuốc cho họ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "Haiz, chắc chắn những bệnh nhân kia lại hỏi tôi, bọn họ nên dùng cách gì để nhận được phước lành của Thảo Thần nữa cho xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "Xin bạn đấy, Nhà Lữ Hành, tôi thật sự rất cần một người giúp tôi mà không lảm nhảm về sự bảo hộ của Thảo Thần suốt ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "Ở đây đã xảy ra chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "Bạn là Nhà Lữ Hành phải không, nơi này là \"Bimarstan\", là một bệnh viện dành cho tất cả mọi người... Ừm... Bệnh viện đầy ắp phước lành của Thảo Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "Dù giàu hay nghèo, chúng tôi đều sẽ chữa trị cho người cần giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "Nhưng cũng vì thế... Gần đây có quá nhiều bệnh nhân đến khám, thật sự không thể lo xuể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "Haiz, dù sự nhân từ của Thảo Thần dành cho chúng ta là vô hạn... Nhưng kinh phí và nhân lực của bệnh viện cũng có hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "Có vài bệnh nhân hoàn toàn không nghe lời dặn của bác sĩ, chỉ biết hỏi tôi là phải làm sao mới có thể nhận được phước lành của Thảo Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "Haha, phước lành của Thảo Thần... ôi trời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "Nếu Thảo Thần thật sự có thể trực tiếp ban phước lành thì họ đã không mắc bệnh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "...À, xin lỗi, tôi không nên nói như vậy, bạn cũng đừng nói với Golshan nhé. Nếu không cô ấy sẽ lải nhải cho mà xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "Anh không phải tín đồ ngoan đạo của Thảo Thần sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "Tôi đúng là tín đồ, trong Thành Sumeru này còn ai không phải tín đồ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "Nhưng bạn hãy bỏ hai chữ ngoan đạo đó đi, tôi chỉ là một... tín đồ tương đối lý trí của Thảo Thần thôi, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "À... Xin lỗi, chắc là tôi mệt mỏi quá nên hơi bực bội, bạn đừng để bụng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "Có người nói bản thân việc chữa bệnh chính là phước lành của Thảo Thần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "Haiz, mấy câu đó nghe thôi, đừng cho là thật giống như những bệnh nhân kia nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "Nếu như Thảo Thần thật sự toàn năng như thế thì tôi chỉ mong là đưa ít nấm cho người bệnh ăn là họ sẽ khỏi ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301802,
			"completionStepIds": [
				2301802
