			"dialogs": [
				{
					"id": 230181401,
					"content": "Đây là thuốc phải đưa cho ông Aftab ở nông trại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181402
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181402,
					"content": "Ông ấy bình thường chỉ ăn thịt cá, nên dạ dày không khỏe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181403
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181403,
					"content": "Bạn đưa thuốc này cho ông ấy, sẵn tiện nói với ông ấy... Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181404
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181404,
					"content": "Ăn thanh đạm, bớt rượu thịt thì mới có thể nhận được phước lành của Thảo Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181405,
						230181406
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181405,
					"content": "Được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181408
					]
				},
				{
					"id": 230181408,
					"content": "Đưa thuốc xong thì về tìm tôi, tôi sẽ chuẩn bị sẵn thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181406,
					"content": "Anh nghe được mấy câu này từ đâu thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181407
					]
				},
				{
					"id": 230181407,
					"content": "Tôi nghe nói đúng là có học giả trong Giáo Viện làm như vậy, tôi cũng không biết tại sao nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181408
