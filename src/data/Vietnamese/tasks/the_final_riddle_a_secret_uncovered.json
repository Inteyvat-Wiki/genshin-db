					"nextDialogs": [
						400130128
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130128,
					"content": "Có tôi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130129,
					"content": "Mọi người đừng nói vậy...Lỡ như Đại Ma Vương Dodo chỉ là mời Klee đến nói chuyện thì sao? Hoặc là...hoặc là đã thừa nhận Klee rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130130,
					"content": "Hắn sẽ thừa nhận Klee chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130131,
					"content": "Sao lại không chứ? Klee đã làm rất tốt mà.",
