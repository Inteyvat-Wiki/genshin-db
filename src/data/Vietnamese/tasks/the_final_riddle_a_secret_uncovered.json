				},
				{
					"id": 400130202,
					"content": "Cả hòn đảo này, đúng là giống như rương quà chứa trong cái vỏ năng lượng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130203,
					"content": "Trong đó hình như có gì đó, có muốn qua đó xem thử không?",
