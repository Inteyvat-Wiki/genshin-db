					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130112,
					"content": "Klee, sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130113,
					"content": "Klee lo lắng...nếu như trong đó có Đại Ma Vương Dodo thật thì phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130114,
					"content": "Nếu như Đại Ma Vương Dodo không chấp thuận Klee và Dodoco là người nhà, hoặc là nếu Klee thua hắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130115,
					"content": "Vậy Dodoco sẽ không thể ở bên Klee nữa, mẹ cũng sẽ rất buồn...Dodoco là người bạn quan trọng mà mẹ tặng cho Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130116,
					"content": "Klee...Klee không dám nhấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130117,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130118,
					"content": "#Kỵ Sĩ Danh Dự {NICKNAME} có thể giúp Klee không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130119,
					"content": "#Klee, {F#chị}{M#anh} không thể giúp Klee rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130121,
					"content": "#Bởi vì {F#chị}{M#anh} phải cầm chắc vũ khí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "Vì vậy sẽ có thể bảo vệ Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "Đúng vậy, mọi người sẽ luôn ở cạnh Klee mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130124,
					"content": "Đúng là người đông thế mạnh nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130125,
					"content": "Cho dù kẻ địch là người như thế nào, chỉ cần có chúng tôi ở đây, thì Klee không phải sợ gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130126,
					"content": "Tôi cũng muốn xem thử kẻ địch trên hòn đảo này mạnh như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 400130127,
					"content": "Đi đi.",
