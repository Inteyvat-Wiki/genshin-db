					"nextDialogs": [
						400130204
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130204,
					"content": "Muốn chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130205,
					"content": "Cô gái đỏ tà ác, ngươi cuối cùng cũng đến rồi. Ta chờ ở đây lâu đến phát chán luôn rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130206,
					"content": "Ngươi dám đối đầu với Đại Ma Vương Dodo, quả là dũng cảm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130207,
					"content": "Sự dũng cảm này đáng khen ngợi đấy, nhưng đã không còn ý nghĩa nữa, bởi vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130208,
					"content": "Bởi vì Đại Ma Vương Dodo ta đây chính là mẹ của con, Alice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130209,
					"content": "Ơ, mẹ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130210,
					"content": "Alice...là người đã viết quyển \"Hướng Dẫn Du Ngoạn Teyvat\" sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130211,
					"content": "Klee, còn các vị đã cùng Klee đến đảo này nữa, xin chào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130212,
					"content": "Thế nào, hòn đảo này vui chứ? Có ánh nắng và bãi biển, đây là nơi tuyệt vời để nghỉ hè đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130213,
					"content": "Không cần tìm nữa, mẹ đang không có ở đây. Cỗ máy đang nói chuyện phía trước chính là \"Máy Ghi Âm Alice\" do mẹ phát minh, có thể gửi đi tình yêu của mẹ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130214,
					"content": "Hử? Đây đúng là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130215,
					"content": "Chà, có làm các cháu cảm thấy sợ không? Xin lỗi nhé, Klee nhà cô rất thích đồ chơi nên người làm mẹ như cô cũng phải chiều theo nó chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130216,
					"content": "Số đồ chơi này không ít đâu cô à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130217,
					"content": "Mẹ...mẹ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130218,
					"content": "Lần này tiếc là không thể gặp mặt, nhưng cô vẫn sẽ như ngày xưa, luôn trông chừng các cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130219,
					"content": "Không ngờ lại là cô Alice! Sơ ý thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130220,
					"content": "Ủa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130221,
					"content": "Các cháu có lẽ cảm thấy kỳ lạ rằng tại sao một người mẹ xa nhà lại cất công xây dựng một công viên trên biển này đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130222,
					"content": "Bingo! Cô cũng có đến qua hòn đảo này, và cũng thấy rất ấn tượng với di tích và địa hình nơi đây, cô cũng muốn chia sẻ nó cho mọi người nên mới thu xếp gọi mọi người đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130223,
					"content": "Mẹ của Klee cũng là một người rất tự do nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130224,
					"content": "Ha ha, có phải có ai đang nói xấu cô không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130225,
					"content": "Ủa? Không, không có! Cô ấy có máy nghe lén sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130226,
					"content": "Cô ấy không cần làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130227,
					"content": "Nói vậy có nghĩa là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130228,
					"content": "Cô Alice là một ma nữ rất thần bí và đầy quyền năng. Cho nên đừng ngạc nhiên quá, cô ấy là người như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130229,
					"content": "Mọi người có lẽ đang thắc mắc, những lá thư đó là gì, những con thuyền đó là gì, lại còn có vật nổi với vỏ năng lượng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130230,
					"content": "Hừm, cô cũng thấy có hơi khoa trương thật, nhưng chỉ có vậy thì mới mời được mọi người đến, đúng không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130231,
					"content": "Hòn đảo này vốn cũng có rất nhiều câu chuyện của nó, cư dân bản địa, tàu đắm, máy móc thần bí...Nếu như không sắp đặt như vậy thì lãng phí quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130232,
					"content": "Để cô đoán xem, những người nhận được thư đều đã ở đây rồi đúng không. Kaeya, Diluc, Razor, Jean, Barbara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130233,
					"content": "#Có cả Albedo thông minh, nhà lữ hành bí ẩn {NICKNAME} và Paimon - người bạn đồng hành tốt nhất nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130234,
					"content": "Các cháu đều chịu đến đây để chơi với Klee. Cảm ơn vì đã cho Klee một ngày hè đáng nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130235,
					"content": "Mọi thứ trên đảo đều là quà của cô dành cho các cháu. Sau khi nghe được đoạn ghi âm này có lẽ cô đã ở nơi khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130236,
					"content": "Cuộc sống lữ hành là vậy, tuy bận rộn nhưng rất thú vị, hỏi thử Nhà Lữ Hành bên cạnh là sẽ biết thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130237,
					"content": "Cô Alice là do quá bận không thể ở bên Klee nên mới làm vậy đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130238,
					"content": "Không phải đâu, mẹ chính là vậy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130239,
					"content": "Nếu các cháu đang suy nghĩ đến những chuyện sâu hơn nữa, thì cô cần phải nói rằng mọi chuyện không phức tạp như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130240,
					"content": "Cô thích thành Mondstadt là bởi vì tự do chính là ước mơ của hai mẹ con cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130241,
					"content": "Nguyện vọng của cô rất đơn giản, hy vọng Klee sẽ trưởng thành trong sự lương thiện và hiếu kỳ, chỉ cần nó muốn, là nó sẽ có thể đi bất cứ đâu, làm bất cứ chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130242,
					"content": "Thì ra...đây là phong cách sống của cô Alice, thật xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130243,
					"content": "Đúng là một người mẹ có cá tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130244,
					"content": "Ừm! Mẹ là người mẹ tốt nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130245,
					"content": "Mẹ ơi, lần này con đi đánh cá, đi thuyền, bơi lội, chơi vui lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130246,
					"content": "Mọi người xung quanh cũng rất tốt, rất dịu dàng với Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130247,
					"content": "Lần sau mẹ cũng đến đây chơi với con nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130248,
					"content": "Hai mẹ con đều mang trong mình tâm hồn của tự do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130249,
					"content": "Ngày hè...Nói đến ngày hè mới nhớ, khi mẹ đến hòn đảo này cũng là vào mùa hè. Ngồi trên bãi cát nghe tiếng sóng vỗ, trong khoảnh khắc mẹ nhớ đến con.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130250,
					"content": "Klee, con sinh ra vào mùa hè, là món quà của biển và gió tặng cho mẹ. Mẹ cảm thấy rất vui vì điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130251,
					"content": "Cho nên mẹ đã cất công cải tạo di tích cổ của nơi này thành công viên mùa hè, dùng danh nghĩa Đại Ma Vương Dodo để mời con đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130252,
					"content": "Trong truyền thuyết có nói ở đây có một quần đảo kỳ lạ tên là Táo Vàng. Nó chất chứa những giấc mơ tươi đẹp của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130253,
					"content": "Mẹ thích câu chuyện này, nên cũng muốn chia sẻ nó với con. Vì vậy mẹ tặng con bãi biển xanh biếc, bãi cát trắng muốt, và công viên tuyệt vời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130254,
					"content": "Và cả những người bạn quan tâm đến con nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130255,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130256,
					"content": "Vì vậy pha lê mới có ba mảnh đúng không...Màu đỏ của cánh hoa, màu xanh của sóng biển, màu vàng của lá thu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130257,
					"content": "Có thể dưới góc nhìn của cô Alice, quần đảo này chính là viên pha lê thứ tư...Một \"Pha Lê Mùa Hè\" màu lục bảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130258,
					"content": "Klee, con và mẹ đều thuộc tộc có tuổi thọ dài. Thời gian đối với chúng ta mà nói chỉ như một cơn gió, thoáng qua là sẽ kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130259,
					"content": "Trong cuộc đời dài này, cha mẹ chẳng qua cũng chỉ là một chặng đường của con cái. Cho dù không muốn rời xa đi nữa, thì cũng sẽ có ngày con cái phải đi trên con đường của riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130260,
					"content": "Klee, mẹ sẽ luôn yêu thương con, và ngoài mẹ ra, con vẫn còn có nhiều người bạn tốt xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130261,
					"content": "Những người bạn bên con, những người thầy dạy con, dù cho có nguy hiểm nhưng vẫn đến đảo này vì con...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130262,
					"content": "Mùa hè thuộc về mọi người. Cho dù cuộc sống có thay đổi thế nào thì mùa hè vẫn sẽ không biến mất, như tình yêu của con người với nhau vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130263,
					"content": "Hy vọng sau này con đi đâu cũng sẽ ghi nhớ, vẫn còn có nhiều người yêu thương con như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130264,
					"content": "À đúng rồi, ở nhà con phải nghe lời anh Albedo nhé, mẹ sẽ thường xuyên về thăm con. Thực ra, mỗi khi rảnh rỗi, mẹ liền lén quay về thăm Klee và mọi người ngay. Hì hì, chắc là không ai phát hiện ra đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130265,
					"content": "Vẫn như xưa nhỉ, dì Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130266,
					"content": "Cái tên Albedo này, chắc không phải là đã biết từ đầu rồi chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130267,
					"content": "Cũng sắp đến giờ rồi, tạm nói tới đây thôi vậy. À đúng rồi, cô đã tốn rất nhiều công sức cho việc này, các cháu nhớ phải chơi thật nhiệt tình nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130268,
					"content": "Vậy thì mọi người, và cả Klee của mẹ, hẹn gặp lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130269,
					"content": "Tạm biệt mẹ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130270,
					"content": "Klee hình như rất là vui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "Hihi...Đại ma vương chính là mẹ, không biết tại sao Klee cảm thấy rất vui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130272,
