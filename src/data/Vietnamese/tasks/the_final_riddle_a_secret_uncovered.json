						400130110
					]
				},
				{
					"id": 400130110,
					"content": "Ừm, Klee biết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "Klee"
