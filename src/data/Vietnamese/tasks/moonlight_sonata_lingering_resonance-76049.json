				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Columbina"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "...Hình như chỉnh cao lên rồi nhỉ, thử lại xem sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490102,
					"content": "Xin chào, Columbina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "Ấy? Cô đang... dạy Kuuhenki đàn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Ừm, lúc trước sửa xong cây đàn thì các Kuuhenki vui lắm, ngày nào cũng bám lấy tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490105,
					"content": "Nhưng thật ra tôi cũng không giỏi đánh đàn lắm đâu, trước đây toàn là nghe người khác đánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490106,
					"content": "Ừm, tôi hiểu. Cảm thấy như nếu lập nhóm nhạc thì Columbina sẽ phụ trách hát chính nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "#Nhưng mà, nói đến nhạc cụ thì {NICKNAME} giỏi lắm đó! Từ đàn của Mondstadt đến trống của Natlan cũng đều rất tinh thông!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "Cũng tạm thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "#Vậy sao...? Hay là {F#cô}{M#cậu} dạy chúng đàn nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490111,
					"content": "Vậy để tôi trổ tài nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "#Các Kuuhenki dạo này đang tập hát bài mà tôi hay hát, {F#cô}{M#cậu} vẫn nhớ giai điệu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490114,
					"content": "#Hay là... đàn mấy giai điệu mà {F#cô}{M#cậu} hay chơi nhé. Các Kuuhenki hiếm khi nghe nhạc từ các quốc gia khác, tôi cũng muốn nghe nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490115,
					"content": "(Đàn gì được nhỉ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Diễn tấu bài mà Columbina thường hát...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Nên diễn tấu với tâm trạng thế nào đây...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Giai điệu yên bình...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "#Hay lắm. Thì ra {F#cô}{M#cậu} nhớ hết những giai điệu mà tôi hay ngân nga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490605,
					"content": "Hihi, vì cô hát rất hay mà. Thỉnh thoảng chúng tôi cũng đứng bên để nghe một lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Các Kuuhenki cũng say mê lắng nghe lắm. Không biết chúng có học được không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490607,
					"content": "Không chừng sau này còn phải nhờ hai người hướng dẫn thêm vài lần nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490608,
					"content": "Nào, đưa tay cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490609,
					"content": "Ơ? Chúng tôi biểu diễn miễn phí mà, không thu học phí đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hả? Học phí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490611,
					"content": "Tôi chỉ cảm thấy, giai điệu hay thì nên có ánh trăng tươi đẹp bầu bạn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490701,
					"content": "Giai điệu vui vẻ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Hết rồi à? Tôi cảm thấy vẫn chưa nghe đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490703,
					"content": "Tôi từng nói đây là \"bài hát ru\" duy nhất mà tôi nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490704,
					"content": "#Cho dù vẫn chưa tìm ra ý nghĩa trong đó, nhưng sau khi nghe {F#cô}{M#cậu} đàn, tôi bắt đầu cảm thấy đáp án đang đợi tôi trên mặt trăng. Ít nhất sẽ là điều gì đó tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490705,
					"content": "Nào, đưa tay cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490706,
					"content": "Lần này không cần báo đáp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Không, tôi chỉ muốn thêm ánh trăng tươi đẹp cho giai điệu này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490801,
					"content": "Diễn tấu âm nhạc của quốc gia khác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "#Thật kỳ diệu. Trước đây tôi thỉnh thoảng cũng từng nghe giai điệu tương tự, nhưng nghe {F#cô}{M#cậu} đàn thì lại có cảm giác rất khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490803,
					"content": "#Có thể trong đó chứa đựng tình cảm của {NICKNAME} dành cho quốc gia đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "Điều kỳ diệu là tôi có thể tưởng tượng ra phong cảnh từ giai điệu đó... Không biết hiện thực có khác với tưởng tượng không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490805,
					"content": "Muốn xem chẳng phải là quá dễ sao? Đến lúc đó cứ để chúng tôi làm hướng dẫn viên cho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Ừm... Hy vọng là có ngày đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760490112,
					"content": "Đàn gì được nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "Hơi quen thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
