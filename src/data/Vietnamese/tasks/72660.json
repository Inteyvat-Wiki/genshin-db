			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "Chào! Người lạ mặt bên đó, có hứng thú chiến đấu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600102,
					"content": "Tôi là chiến sĩ từng trải trăm trận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "Tốt quá, tôi quả nhiên không nhìn nhầm người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600106,
					"content": "Chuyện là thế này, gần đây dường như lại có người đang bí mật tổ chức \"Hyakunin Ikki\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600107,
					"content": "Hyakunin Isshu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "Không không không, là Hyakunin Ikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600110,
					"content": "Là một loại nghi thức truyền thống, từng được lưu truyền trong \"Hội Tengu\". Đơn giản mà nói là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600111,
					"content": "Khi thời vận không tốt, khi tâm trạng xuống dốc; hoặc khi có chuyện vui gì đó đáng ăn mừng, hoặc chỉ đơn giản là khi buồn chán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600112,
					"content": "Bằng cách đánh nhau một trận thật sảng khoái để chúc mừng, hoặc để xua đuổi sự xui rủi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600113,
					"content": "Luật như vậy thì lúc nào cũng có thể tổ chức rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "...Nghĩ kỹ lại, hình như đúng là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600115,
					"content": "Tóm lại, chúng ta đổi chỗ khác nói chuyện đi. Trong thành người đông phức tạp, không tiện lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600109,
					"content": "Xin giải thích thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "Có ủy thác gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "Cũng không phải ủy thác gì. Tóm lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "Chúng ta đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600202,
					"content": "Chỉ cần bước qua cánh cổng trông có vẻ đáng ngờ này, là có thể vào đến võ quán Hyakunin Ikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600203,
					"content": "Thật phấn khích!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "Tuy \"Hội Tengu\" đã bị cấm từ lâu vì làm ảnh hưởng đến trật tự công cộng và thuần phong mỹ tục, nhưng thỉnh thoảng vẫn có người bí mật tổ chức đại hội loạn đấu Hyakunin Ikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600206,
					"content": "Mà các ma vật, Nhà Mạo Hiểm và chiến sĩ khao khát chiến đấu ở khắp nơi trên thế giới lại thường bị nó hấp dẫn, thoải mái ra tay chiến đấu quyết liệt trên võ đài của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600207,
					"content": "Bạn có thể tham gia chiến đấu cùng với bạn bè, chiến hữu có cùng chí hướng. Dù sao thì, cái gọi là Hyakunin dĩ nhiên là càng đông càng tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600208,
					"content": "Trông bạn có vẻ là Nhà Mạo Hiểm đã đi qua nhiều nơi, chắc sẽ có nhiều bạn bè muốn tham gia cùng bạn đúng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600209,
					"content": "Bạn không tham gia sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "Tôi sao? Tôi sẽ tham gia với tư cách khán giả, cổ vũ cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600211,
					"content": "Thật ra, mục tiêu của tôi là viết ra tiểu thuyết chiến đấu đặc sắc nhất, giành giải thưởng \"Quyển tiểu thuyết này thật lợi hại\" của Nhà Xuất Bản Yae.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600212,
					"content": "Và trực giác mách bảo tôi rằng, bạn nhất định là ngôi sao sáng nhất trên đấu trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600213,
					"content": "Tôi sẽ cố gắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "Tên của tiểu thuyết tôi cũng nghĩ xong rồi, gọi là \"Hyakunin Ikki-Đại Hội Võ Đấu Mạnh Nhất\". Nếu có một ngày bạn nhìn thấy quyển sách này trong tiệm sách Nhà Xuất Bản Yae, thì trong đó nhất định sẽ có vị chiến sĩ ngoại quốc tóc vàng xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600216,
					"content": "Tôi rất kỳ vọng vào thể hiện của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600214,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "Thật đáng nghi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}