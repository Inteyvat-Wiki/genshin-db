			"dialogs": [
				{
					"id": 705280401,
					"content": "Rốt cuộc hiệp hội có thật sự lo được việc này không, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280402,
					"content": "Nhà Lữ Hành! Thật ngại quá, lúc nãy tôi đang suy nghĩ chút chuyện của hiệp hội nên hơi thất thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280403,
					"content": "Bạn đến Thành Mondstadt để tham gia Lễ Hội Hoa Gió đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280404,
					"content": "Hiệp Hội Nhà Mạo Hiểm chúng tôi vừa ra mắt một trò chơi nhỏ, đảm bảo rất thú vị, tham gia là có thưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280405,
					"content": "Thế nào, bạn có muốn chơi thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280406,
					"content": "Tôi sẽ giới thiệu một chút về trò chơi này trước. Người thiết kế ra trò chơi này đặt tên cho nó là \"Cờ Trục Hoa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280407,
					"content": "Anh ta nói cảm hứng của anh ta đến từ những cánh hoa bay, và những ngọn gió đuổi theo cánh hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280408,
					"content": "Cảm giác của toàn bộ trò chơi cũng là mô phỏng... cảm giác lãng mạn khi đuổi theo những cánh hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280409,
					"content": "Giống như một câu chuyện nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Anh ấy là một nhà thơ... khá là giàu... trí tưởng tượng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280412,
					"content": "Nói một cách đơn giản thì khi chơi loại cờ này, người chơi cần thu thập càng nhiều Bóng Hoa Gió phân bố trên bàn cờ càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280413,
					"content": "Trong khi thu thập, cũng cần phải tránh các chướng ngại vật... Tất nhiên, trong bàn cờ còn có các loại đạo cụ phụ trợ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280414,
					"content": "Anh ta đã viết một bản hướng dẫn trò chơi chi tiết, lát nữa bạn có thể xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280415,
					"content": "Nếu có hứng thú thì bạn có thể chơi thử, tham gia là có thưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280410,
					"content": "Phức tạp vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
