			"dialogs": [
				{
					"id": 700650101,
					"content": "Đúng là không khuyên được kẻ muốn chết. Đã bảo bây giờ không thể lên núi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650102,
					"content": "Ấy ấy, ông Mann, đừng kích động thế. Có gì từ từ nói, bình tĩnh nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650103,
					"content": "Lúc trước chúng tôi còn trò chuyện rất vui vẻ ở Men Rượu Đêm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650104,
					"content": "Vừa nghe nói tôi muốn đến Núi Gió Lặng là bắt đầu túm lấy tôi, cứ giằng co suốt cả đoạn đường đến tận đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650105,
					"content": "Ơ, là Huffman đây mà. Ở đây xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "Như đã thấy đấy, ông Mann đây đang cố gắng thuyết phục mọi người tránh xa Núi Gió Lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650107,
					"content": "Để tôi giới thiệu, đây là nhà mạo hiểm Lipphart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650108,
					"content": "Những gì tôi trải qua đáng sợ lắm đấy! Mấy người thực sự muốn nghe sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650109,
					"content": "Được rồi, tôi đoán hôm nay chắc không rời đi được rồi. Thôi thì nghe thử vậy, coi như tiếp tục cuộc nói chuyện phiếm bên ly rượu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650110,
					"content": "Để xem rốt cuộc nguy hiểm ra sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650111,
					"content": "Viện điều dưỡng thực sự có ma! Chính mắt tôi nhìn thấy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650112,
					"content": "Ối, ma á!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "Chuyện tối qua là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mann"
				}
			]
		}
	]
