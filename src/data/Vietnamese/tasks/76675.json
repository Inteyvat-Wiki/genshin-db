			},
			"dialogs": [
				{
					"id": 766750401,
					"content": "Này, anh không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750402,
					"content": "Không... không sao... Phù, may mà các vị đến kịp lúc, chứ không thì đúng là nguy to rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750403
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750403,
					"content": "...May quá, có vẻ như \"vật tư quan trọng\" của chúng ta không bị gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750404,
					"content": "Ồ, vật tư gì quan trọng vậy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750405,
						766750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750405,
					"content": "Đây là rượu nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				},
				{
					"id": 766750407,
					"content": "Tinh tường lắm! Đây là rượu bồ công anh được đặt hàng từ Tửu Trang Dawn! Hương vị Mondstadt chính hiệu nhất đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750408,
					"content": "Vận chuyển từ Mondstadt đến đây, tốn nhiều công sức lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750409
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750409,
					"content": "Haha, chủ tiệm vất vả rồi! Tối nay có tiệc rượu, anh cũng đến uống một ly nhé? Chúng tôi đều rất mong anh đến đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750410
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750410,
					"content": "...Vậy ra lúc nãy anh vội vã như thế chỉ là để kịp cho bữa tiệc rượu tối nay thôi à? Hiếm khi mới thấy anh nghiêm túc một lần, ra là vì chuyện thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750411,
					"content": "Hả? Uống rượu chẳng phải là việc nghiêm túc nhất sao? Tôi đang muốn làm một ly ngay đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750412
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750412,
					"content": "Khoan, khoan đã, bây giờ e là không tiện lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750413
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750413,
					"content": "Đúng rồi, ít nhất cũng phải làm xong việc chính đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750414,
					"content": "Rượu này được đặt làm, cần phải lắc liên tục tránh lắng cặn để giữ được hương vị! Giờ để yên lâu thế này, chắc hương vị... chỉ còn 90% so với ban đầu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750415
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750415,
					"content": "Còn 90% thôi sao? Không được! Vậy thì tuyệt đối không thể uống bây giờ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750416
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750416,
					"content": "...Thôi được rồi, mọi người thấy vui là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750417,
					"content": "Phải làm sao để khôi phục hương vị vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750418
					]
				},
				{
					"id": 766750418,
					"content": "Vốn dĩ chúng tôi có tìm người chế tạo một thiết bị để lăn thùng rượu... Nhưng vừa rồi hình như rơi hỏng mất rồi. Bây giờ... chắc chỉ còn cách dùng sức người để lăn nó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750419
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750419,
					"content": "Hmm, vậy là phải <color=#00E1FFFF>liên tục đánh vào thùng gỗ để nó lăn đến đích</color> à... Nghe giống như bài huấn luyện sức mạnh truyền thống của Đội Kỵ Sĩ Tây Phong đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750420,
					"content": "Đội Kỵ Sĩ Tây Phong còn có cả mục huấn luyện này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750421
					]
				},
				{
					"id": 766750421,
					"content": "Ừm, mục huấn luyện này vừa phải kiểm soát lực, vừa phải kiểm soát góc độ, tránh để thùng gỗ đi chệch hướng. Đây là mục huấn luyện nhập môn của nhiều kỵ sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750422,
						766750423
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750422,
					"content": "Nghe cũng thú vị đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750424,
					"content": "Ồ? Kỵ Sĩ Danh Dự cũng có hứng thú với huấn luyện cơ bản sao? Hừm... Cũng còn một chút thời gian trước khi Laurent và những người khác quay về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750425
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750425,
					"content": "#Vậy giao cho {F#cô}{M#cậu} nhé, Kỵ Sĩ Danh Dự. Cứ yên tâm, nếu vô tình làm thùng rượu lăn quá xa thì cứ nói với tôi, tôi sẽ giúp {F#cô}{M#cậu} ném về vị trí cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750423,
					"content": "Kỵ Sĩ Danh Dự tôi cũng muốn thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750406,
					"content": "Sao ngửi thấy mùi như rượu vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				}
			]
		},
