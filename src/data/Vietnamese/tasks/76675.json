					"nextDialogs": [
						766750605
					]
				},
				{
					"id": 766750605,
					"content": "#Lần đầu tiên để Razor thử bài tập này, cậu ấy đã mất cả một ngày mới hoàn thành. {F#Cô}{M#Cậu} đoán xem tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750606
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750606,
					"content": "Vì cậu ta đã dành một phần tư thời gian để di chuyển thùng gỗ, còn ba phần tư thời gian để hiểu xem tôi đang nói gì.",
