				"objectNames": [
					"Varka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766750801,
					"content": "Hửm? Cần tôi giúp đặt lại thùng rượu không? Hay là muốn tán gẫu một chút?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750802,
						766750804
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750802,
					"content": "Xin hãy giúp tôi đặt lại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750803
					]
				},
				{
					"id": 766750803,
					"content": "Được rồi, đừng bỏ cuộc, thử lại lần nữa nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750804,
					"content": "Muốn tán gẫu một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750805
					]
				},
				{
					"id": 766750805,
					"content": "#Nói mới nhớ, chắc {F#cô}{M#cậu} chưa từng gặp Lohen đúng không? Tên nhóc đó quen thói tự tung tự tác rồi, đến ngày huấn luyện cũng chẳng thấy bóng dáng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750806,
					"content": "Sau này hỏi ra thì cậu ta bảo là đã chạy đi xử lý hang ổ ma vật, còn về việc huấn luyện với thùng gỗ... thì cậu ta không hứng thú với mục tiêu không biết phản kháng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
