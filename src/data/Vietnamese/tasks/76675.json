					}
				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "Nhân vật chính mang rượu ngon về cho mọi người sao lại chạy đến đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751002,
					"content": "Câu này phải là tôi hỏi anh mới đúng đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "Ừm... Thực ra trong ly của tôi là \"đồ đặc biệt\" bậc nhất, nên chỉ có thể uống một mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751005,
					"content": "#Nhưng đã bị {F#cô}{M#cậu} phát hiện rồi thì không còn cách nào khác, chia cho {F#cô}{M#cậu} một ly vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751006,
					"content": "...Biết ngay mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "#Xin lỗi nhé, tôi chỉ đùa thôi! Bên cạnh tôi bây giờ không có một giọt rượu nào cả. Nếu {F#cô}{M#cậu} muốn uống thì lát nữa có thể đến tìm Eumenie, bên đó có nhiều lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751009,
					"content": "Trong doanh trại luôn phải có một người tỉnh táo để trông chừng những đồng đội say xỉn và hiểm nguy trong đêm. Đây là quy tắc tôi đã đặt ra ngay từ khi bắt đầu viễn chinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751010,
					"content": "Thật không may, hôm nay lại vừa hay đến phiên tôi phải làm người tỉnh táo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751011,
					"content": "...Nên trong đêm khi tất cả họ đều say, tôi nhất định phải tỉnh táo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751012,
					"content": "Sao lại trùng hợp đến vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "Ai mà biết được chứ? Có khi số phận thích trêu đùa vậy đó? Nếu đến muộn một ngày thì không chừng người uống thỏa thích bên dưới sẽ là tôi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751015,
					"content": "#Nhưng nếu đến muộn một ngày, có lẽ {F#cô}{M#cậu} đã không tình cờ đến doanh trại này và tham gia bữa tiệc rượu, chúng ta cũng sẽ không có cơ hội trò chuyện như bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751016,
					"content": "Không ai nói trước được lựa chọn nào sẽ dẫn đến kết quả ra sao, cho đến khi thời điểm đó đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751017,
					"content": "Giống như khi tôi quyết định rời Mondstadt để đi viễn chinh, cũng không ngờ rằng mình sẽ đi đến tận ngày hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751018,
					"content": "Mục đích của cuộc viễn chinh... là vì Cuộc Săn Hoang Dã sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "Ừm... Nếu nói về kết quả thì đúng là vậy. Nhưng khi xuất phát, tôi chỉ biết rằng có một thảm họa Vực Sâu đang âm thầm hình thành ở phương bắc, và nó sẽ quét qua toàn bộ Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751020,
					"content": "Chúng tôi cũng đã mất một khoảng thời gian để huy động nhân lực và chuẩn bị... nhưng kẻ thù sẽ xuất hiện ở đâu và dưới hình thức nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751021,
					"content": "...Đó đều là những điều chúng tôi không thể biết trước khi xuất phát. Chúng tôi chỉ có thể thu thập tình báo dọc đường và chuẩn bị sẵn sàng cho mọi tình huống có thể xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751022,
					"content": "Chỉ với chừng đó tình báo mà đã phát động viễn chinh rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "Hah, học nhanh đấy! Nhưng đáng tiếc, kẻ địch sẽ không ngoan ngoãn chờ chúng tôi chuẩn bị chu toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751025,
					"content": "Trong khi chúng tôi còn đang do dự, Vực Sâu vẫn đang làm hại vô số sinh mạng. Càng sớm khởi hành sẽ càng sớm thay đổi vận mệnh của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751026,
					"content": "Chỉ riêng tình báo này thôi cũng đã đủ để chúng tôi phát động cuộc viễn chinh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751027,
					"content": "Không hổ danh là Kỵ Sĩ Bắc Phong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "#Đừng khách sáo thế, Kỵ Sĩ Danh Dự! {F#Cô}{M#Cậu} cũng vậy mà? Hành trình của {F#cô}{M#cậu} cũng đã thay đổi vận mệnh của rất nhiều người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751030,
					"content": "Dù là Mondstadt và Dvalin ngày trước... hay Nod-Krai, đội viễn chinh... và cả tôi của hiện tại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751031,
					"content": "#Giờ đây chúng ta có thể quây quần bên đống lửa, cùng hát ca, uống rượu và mơ về tương lai... Tất cả đều nhờ vào sự xuất hiện của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751032,
					"content": "...Tôi thực sự giỏi đến vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "...Haha, ai mà biết được chứ? Dù sao thì vận mệnh luôn là thứ khó đoán mà. Nhưng chỉ cần còn sống, thì vẫn luôn còn hy vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751034,
					"content": "Tối nay không được uống rượu thì ngày mai vẫn uống được mà, họ sẽ nhớ để dành cho tôi một ly. Chỉ cần còn sống, ngày mai sẽ luôn có rượu ngon và bạn bè chờ đợi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751035,
					"content": "#Vậy nên {NICKNAME}, nốc cạn ly này nào! Nâng ly vì ngày mai, vì hy vọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751028,
					"content": "Không hổ danh là Đội Kỵ Sĩ Tây Phong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "Không phải anh nói tình báo là nền tảng để hành quân sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "Vào đúng ngày rượu bồ công anh được giao đến sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751007,
					"content": "Quả nhiên là nước táo lên men.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751003,
					"content": "Sao lại uống rượu một mình vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				}
			]
		},
