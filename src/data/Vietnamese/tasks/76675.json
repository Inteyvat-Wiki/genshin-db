			"dialogs": [
				{
					"id": 766750901,
					"content": "Ah! Đại Đội Trưởng! Kỵ Sĩ Danh Dự! Họ đã trở về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750902,
					"content": "Trở về rồi! Trở về rồi! Mau ra đón họ nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750903,
					"content": "Woa, không ngờ lại được chào đón nồng nhiệt thế này đấy... Tôi thấy ngại quá đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750904,
					"content": "Cách xa mấy trăm mét là tôi đã ngửi thấy mùi hương trong gió rồi! Đó là mùi rượu bồ công anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750905,
					"content": "Là sản phẩm đặc chế của Tửu Trang Dawn! Đã trở về rồi... Ôi ký ức của tôi... đều đã trở về cả rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750906,
					"content": "Ừm... Vậy đối tượng mà mọi người tiếp đón không phải là chúng tôi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750907,
					"content": "Ừm... Đúng là mùi vị này... Giống hệt như trong ký ức!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750908,
					"content": "Thật tuyệt quá, bao nhiêu năm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750909,
					"content": "Tôi còn tưởng mình đã quên mất hương vị rượu của Tửu Trang Dawn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750910,
					"content": "Hương vị rượu vẫn không đổi... Vậy quê nhà ở Thanh Tuyền Trấn, chắc cũng không có gì thay đổi nhỉ? Chắc là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750911,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "#...Cảm ơn {F#cô}{M#cậu}, Kỵ Sĩ Danh Dự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750914,
					"content": "...Thôi nào, đừng kích động vậy, vẫn còn người chưa về doanh trại phải không? Đợi đông đủ rồi hãy mở ra. Mọi người chuẩn bị cho tiệc rượu trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750915,
					"content": "Vâng! Chúng tôi đi chuẩn bị ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750916,
					"content": "...Thấy chưa, tôi đã nói rồi mà: Uống rượu là việc nghiêm túc nhất đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750917,
					"content": "Hic... Thịt Nướng Mật Ong... Gà Nấu Hoa Ngọt... không ngờ lại được ăn những món Mondstadt chính hiệu như vậy ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750918,
					"content": "Ơ... Varka đâu rồi? Sao không thấy anh ấy nhỉ? Chắc không phải đang say xỉn ở góc nào đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750919,
					"content": "Với tửu lượng của anh ấy thì chắc không đâu nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "#Được rồi... tôi ăn nốt đĩa này sẽ đi tìm {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750920,
					"content": "Để tôi đi tìm xem, Paimon cứ ăn tiếp đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "Đúng vậy, tôi đã từng đến đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
