			"dialogs": [
				{
					"id": 766750101,
					"content": "Phía bắc có Nannina trông chừng, phía đông để Laurent đi vậy... Ừm, cứ như thế trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750102,
					"content": "Xin chào, Varka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750103,
					"content": "Ồ? Kỵ Sĩ Danh Dự và Paimon? Sao lại dạo đến doanh trại này vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750104,
						766750105
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750104,
					"content": "Dạo quanh một hồi thì tình cờ gặp được thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750106
					]
				},
				{
					"id": 766750106,
					"content": "#Không đâu, doanh trại của Đội Kỵ Sĩ Tây Phong chính là doanh trại của Kỵ Sĩ Danh Dự, {F#cô}{M#cậu} cứ coi đây như nhà mình là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750107
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750107,
					"content": "#Nhưng lần sau {F#cô}{M#cậu} đến thì có thể báo trước một tiếng, để tôi dặn đội hậu cần chuẩn bị thêm ít rượu và thức ăn ngon để tiếp đãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750108
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750108,
					"content": "Đây là doanh trại của quân viễn chinh sao? Người ở đây ít hơn tôi tưởng đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750109,
					"content": "Trong quân viễn chinh không có nhiều người ở lại đây. Số còn lại cũng đã được phân công đi tuần tra khắp nơi, nói thật thì... Hah, đúng là hơi vắng thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750110,
					"content": "Những người còn lại đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750111
					]
				},
				{
					"id": 766750111,
					"content": "Thu thập các tình báo liên quan đến Vực Sâu, và đương nhiên hiện tại chủ yếu là đối phó với Cuộc Săn Hoang Dã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750112,
					"content": "Thu thập tình báo từ khắp nơi ở Nod-Krai. Mặc dù Rerir đã bị phong ấn, nhưng những sóng gió ở đây vẫn chưa hoàn toàn lắng xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750113,
					"content": "Thu thập các tình báo liên quan đến Vực Sâu. Mặc dù Nod-Krai đã tạm ổn định, nhưng chúng ta vẫn phải đề phòng việc Vực Sâu quay trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750114,
					"content": "Tình báo là nền tảng để hành quân, không chỉ động thái của kẻ địch, mà cả địa hình, thời tiết cũng đều có thể trở thành điểm mấu chốt quyết định thắng thua trên chiến trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750115,
					"content": "Sau này Đội Kỵ Sĩ Tây Phong còn định hợp tác lâu dài với Mạng Lưới Tình Báo Bắc Đại Lục, biến căn cứ tạm thời này thành một trạm tình báo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750116,
					"content": "T-trạm tình báo á? Lẽ nào giống kiểu trong mấy tiểu thuyết gián điệp của Fontaine à!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750117,
					"content": "Haha, sao có thể chứ! Trong loại tiểu thuyết đó, có từng thấy doanh trại nào không phòng thủ như thế này chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750118,
					"content": "Trong hành trình viễn chinh suốt những năm qua, chúng tôi phát hiện ở khắp các nơi trên Teyvat đều xuất hiện các thảm họa Vực Sâu khác nhau. Chúng vô cùng xảo quyệt và có nhiều hình thái khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750119,
					"content": "Thông qua Mạng Lưới Tình Báo Bắc Đại Lục, tôi hy vọng có thể chia sẻ những kiến thức của quân viễn chinh, cũng như tiếp tục thu thập thêm thông tin về Vực Sâu từ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750120,
					"content": "Chống lại Vực Sâu không phải là việc của riêng một quốc gia nào. Và Nod-Krai, nơi mà mỗi ngày có vô vàn ngọn gió thổi qua... sẽ là địa điểm thích hợp nhất để thiết lập trạm tình báo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750121
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750121,
					"content": "Ra là vậy... Đây chính là tinh thần hiệp sĩ nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750122,
					"content": "\"Tinh thần\" thì tốt đấy, nhưng thực tế... Trạm này mới được thành lập chưa lâu, ngay cả tình báo về địa hình xung quanh cũng chưa đầy đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750123
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750123,
					"content": "#Nếu {NICKNAME} thu thập được vật liệu hay tình báo gì quanh đây thì nhớ tiện thể mang về cho tôi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750124,
					"content": "Yên tâm, Đội Kỵ Sĩ Tây Phong sẽ không bao giờ bạc đãi \"Kỵ Sĩ Danh Dự\" của mình đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750125,
					"content": "Cứ để tôi lo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750126
					]
				},
				{
					"id": 766750126,
					"content": "Hah, lại thêm một hành trình viễn chinh mới rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750127
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750127,
					"content": "Đại... Đại Đội Trưởng! Không ổn rồi Đại Đội Trưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750128
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750128,
					"content": "Hả? Chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750129
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750129,
					"content": "Vị khách hẹn hôm nay đến... bị kẹt ở dưới chân núi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750130
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750130,
					"content": "Sao?! Chẳng lẽ là... vị khách đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750131,
					"content": "Đúng rồi! Chính là người đó! Phần lớn nhân lực đều đang tuần tra ở những nơi khác, giờ phải điều động từ đâu đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750132
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750132,
					"content": "Không cần điều động thêm người đâu! Hãy chỉ đường đi, rồi tôi sẽ đích thân đến đó! Hẹn gặp lại hai vị sau nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750133
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750133,
					"content": "Varka vội vã rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766750134
					]
				},
				{
					"id": 766750134,
					"content": "Ồ, đây là lần đầu tiên tôi thấy Varka căng thẳng thế đấy... Vị khách kia rốt cuộc là ai nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750135,
					"content": "Chẳng lẽ là... người đưa tin quan trọng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750136
					]
				},
				{
					"id": 766750136,
					"content": "Có thể lắm! Chúng ta cũng đi theo giúp một tay nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750105,
					"content": "Có làm phiền đến mọi người không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750106
					]
				}
			]
		},
		{
