					"nextDialogs": [
						766750503
					]
				},
				{
					"id": 766750503,
					"content": "Được rồi, đừng bỏ cuộc, thử lại lần nữa nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750504,
					"content": "Muốn tán gẫu một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750505
					]
				},
				{
					"id": 766750505,
					"content": "Trước đây khi tôi hướng dẫn Noelle, cô ấy cứ căng thẳng là lại đập vỡ tung thùng gỗ, sau đó cũng nhất quyết phải tự mình dọn dẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750506
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750506,
					"content": "Lâu dần thì... Khả năng dọn dẹp của cô ấy đã vượt mặt cả Đội Kỵ Sĩ. Hah, tuy bản thân cô ấy không nhận ra, nhưng đây cũng là một sự \"tiến bộ\" đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
