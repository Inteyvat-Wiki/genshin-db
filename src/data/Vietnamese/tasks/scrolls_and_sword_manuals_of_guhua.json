		{
			"id": 7110803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110802",
							"2"
						],
						"stepId": 7110802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "\"Tu luyện công pháp Thích Minh. Người gỗ bất cẩn bị phá hủy hết... Do không có tiền... Nên đã tự nghĩ ra một cách, sao không buộc rơm làm người...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080302,
					"content": "\"Thu gom rơm rạ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080303,
					"content": "\"Buộc rơm, mệt quá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080304,
					"content": "\"Tu luyện công pháp Thích Minh. Người rơm bất cẩn bị phá hủy hết... Thôi thì luyện kiếm trước vậy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080305,
					"content": "Tiếp tục đọc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "\"Rảnh rỗi ngồi trước sân ngắm mưa, hơi đói bụng... Nghĩ về những gì đã thấy hôm trước, chợt cảm ngộ ra, nếu dùng kiếm... (Chữ mờ nhìn không rõ) Đặt tên là 'Tài Vũ', đợi hôm khác thử thi triển xem.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080308,
					"content": "\"Tu luyện công pháp Tài Vũ, bất cẩn bị ngã, may mà không bị thương nặng... Tự nghĩ ra một cách, chi bằng đào đất làm ao dưới trụ, vừa đỡ bị ngã đau vừa có thể nuôi cá làm thức ăn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080309,
					"content": "\"Lúc trước gặp ngư dân, mua mười con cá... Thử nấu cá lên thì vị rất thơm ngon, không con cá nào có thể sánh được...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080310,
					"content": "(Mười trang phía sau đều là các cách chế biến cá, ghi chép vô cùng chi tiết. Một số thậm chí còn kèm hình minh họa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080311,
					"content": "\"...Tu luyện công pháp Tài Vũ, bất cẩn bị ngã.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080312,
					"content": "\"...Thành công.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080313,
					"content": "Tiếp tục đọc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "\"Dùng thương kiếm phải thuần thục như dùng (Chữ mờ nhìn không rõ, bên cạnh có chú giải của chưởng môn đời thứ ba: Như dùng ngón tay)... Và là chân lý... hoặc là không... Làm sao để có được? Làm sao để tiết lộ?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080316,
					"content": "\"Cải tạo Tàng Thư Các. Lắp đặt... bên trong, và...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080317,
					"content": "\"...Nhìn bằng <color=#00E1FFFF>mắt</color>, và ghép <color=#00E1FFFF>cuộn sách ở khắp nơi</color> ứng với <color=#00E1FFFF>căn phòng ở khắp nơi</color> để...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080318,
					"content": "(Mấy trang phía sau đã bị vấy bẩn, không thể đọc được. Bên cạnh có chú giải của chưởng môn đời thứ ba: Đây là lời khuyên để thế hệ sau nên đọc nhiều.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080319,
					"content": "Tiếp tục đọc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "\"Bình phục vết thương. Tiểu Bai mang món thịt dê và cá đến. Thơm ngon không tanh. Hỏi về công thức... Truyền dạy công pháp Sinh Khắc... Vậy nên ghi lại.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080322,
					"content": "(Mấy trang phía sau ghi lại chi tiết những cách nấu thịt dê.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Sổ Tay Cổ Hoa\""
				},
				{
					"id": 711080320,
					"content": "Không đọc nữa, bị vấy bẩn hết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "Không đọc nữa, hoàn toàn không có viết gì về quá trình luyện tập...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "Không đọc nữa, thật vô nghĩa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
