				{
					"id": 751850401,
					"content": "Hai vị quả là giỏi đấy, mới chốc lát mà đã xong thử thách rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850402,
					"content": "Để tôi xem nào... Ồ, màu đen tuyền và mùi đậm đà, thật khiến người ta phát thèm. Mau thưởng thức khi còn nóng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850403,
					"content": "Công thức này hai vị cũng giữ lấy nhé, sau này nếu muốn ăn Trứng Đen thì có thể tự làm xem sao.",
