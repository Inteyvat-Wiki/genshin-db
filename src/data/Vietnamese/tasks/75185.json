			"dialogs": [
				{
					"id": 751850301,
					"content": "Trứng Đen là gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "Nhắc tới Trứng Đen, đó là món ngon chỉ vùng núi lửa chúng tôi mới có thể làm ra thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "Đặt trứng chim lên Lỗ Phun Địa Nhiệt, dùng Phlogiston Thể Khí từ núi lửa phun ra để nướng, đợi đến khi độ lửa vừa đủ thì lấy ra, sẽ có được một quả Trứng Đen hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "Nhưng nếu nướng quá thì mùi vị sẽ khá... khác thường đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
