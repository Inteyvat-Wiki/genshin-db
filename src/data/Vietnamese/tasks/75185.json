			"dialogs": [
				{
					"id": 751850701,
					"content": "Là hai vị à. Thế nào, đã thử tự tay làm món Trứng Đen rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850702,
					"content": "Tôi đã thử rồi, ăn xong cả người đều tràn đầy sức lực!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "Đúng không? Đây là món ngon chứa tinh hoa núi lửa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850704,
					"content": "Nghe nói nếu ăn mỗi ngày thì sẽ giúp cơ thể càng ngày càng khỏe mạnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850705,
					"content": "Tôi nướng quá tay rồi... Ăn xong suýt ngất đi luôn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "Haha, mùi vị đó rất ấn tượng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850707,
					"content": "Tôi lại cảm thấy là khi ăn quen rồi thì cũng không khó nuốt đến thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850710,
					"content": "Vẫn chưa, lần sau tôi sẽ thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
