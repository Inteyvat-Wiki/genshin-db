			},
			"dialogs": [
				{
					"id": 761630101,
					"content": "...Sonnet. Nghĩ kỹ lại thì mấy năm gần đây, em trốn việc, chạy ra ngoài chơi với con người ngày càng nhiều rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630102,
					"content": "Có... có sao đâu chứ! Việc thì cứ giao cho mấy Nguyệt Sứ xử lý là được rồi mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630103
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630103,
					"content": "Nếu chủ nhân mới mà các chị chọn sẵn sàng cử thuộc hạ đến chia sẻ công việc của chúng ta, thì em cũng chỉ đành chấp nhận thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630104
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630104,
					"content": "Hơn nữa, chị Canon cũng chơi rất vui đấy thôi! Thậm chí còn đi tham gia cả lễ hội của loài người nữa kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630105
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630105,
					"content": "...Đó là một phần công việc. Khi các tư tế của họ gọi tên chị, tất nhiên là chị phải đáp lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630106,
					"content": "Hửm? Giả làm một thiếu nữ loài người bình thường, rồi nhảy múa trước tượng thần của chính mình cũng được tính là công việc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630107,
					"content": "...Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630108
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630108,
					"content": "Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630109
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630109,
					"content": "...Ý em không phải là gọi tên nhau như thế... Thôi được rồi. Vậy nếu Nguyệt Sứ mới đến cũng không có ý kiến gì về việc giúp Sonnet xử lý công việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630110,
					"content": "Zibai. Tên cô ấy là Zibai. Phải nhớ kỹ tên người ta chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630111
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630111,
					"content": "...Nếu Zibai không có ý kiến gì thì em cũng sẽ không nói thêm nữa. Tuy nhiên, Sonnet, với tư cách là Ý Chí Của Mặt Trăng, không được quên cơ sở thuật thức duy trì vận hành thế giới đâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630112
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630112,
					"content": "Chuẩn bị tinh thần đi. Chị sẽ đưa ra vài đề cơ bản về kiểm chứng đẳng cấu hình thái. Chưa làm xong thì không được xuống mặt đất nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630113
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630113,
					"content": "Haha, đúng là xấu xa mà. Hệt như kẻ phản diện trong tiểu thuyết của người trên mặt đất, muốn bắt công chúa đào tẩu về lại mặt trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630114
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630114,
					"content": "Đúng đó, đúng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630115
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630115,
					"content": "...Chị chính là mặt trăng mà, đừng nói thế chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}