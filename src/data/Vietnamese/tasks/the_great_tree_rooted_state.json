			"dialogs": [
				{
					"id": 230280501,
					"content": "Chị Yasmin! Huhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "Mình, mình không thở được. Chúng ta mau rời khỏi đây thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "Đây là gì vậy... Khụ, khụ, khụ! Mùi gì đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280504,
					"content": "Xem ra Ladep làm việc rất hiệu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280505,
					"content": "Ở đây đã tưới xong rồi, chúng ta đi đến nơi tiếp theo đi. Gần đây thôi, không cần đi xa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
