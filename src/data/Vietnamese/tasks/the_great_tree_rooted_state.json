				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "Nhà Lữ Hành, các bạn tới rất đúng lúc, tôi đang cần tìm bạn giúp đỡ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280102,
					"content": "Rễ của Cây Thánh xảy ra vấn đề gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "Tình hình hiện tại của Cây Thánh vẫn rất bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280104,
					"content": "Mà chuyện tôi muốn làm, chính là để nó có thể tiếp tục bình thường như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280105,
					"content": "Cụ thể hơn, điều tôi cần phải làm là tưới nước thuốc này xung quanh bộ rễ của Cây Thánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280106,
					"content": "Nhưng nhiều nước thuốc như thế, một mình tôi không chuyển đi được, Ladep và Pharez thì đang bận việc nên không tới giúp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280107,
					"content": "Nên tôi muốn nhờ bạn giúp tôi chuyển những thùng nước thuốc này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280108,
					"content": "Ladep và Pharez là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "Họ cũng là học sinh giống tôi, nhưng Ladep ở Học Viện Spantamad, còn Pharez thì ở Học Viện Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280110,
					"content": "Chúng tôi có chung một đề tài, tuy quan điểm khác nhau, nhưng hiện tại vẫn đang hợp tác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280111,
					"content": "Số nước thuốc này chính là thành quả hợp tác của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280113,
					"content": "Ừm, tôi sẽ chuyển mớ bình này đi, chỗ còn lại bạn giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280114,
					"content": "Lúc vận chuyển cũng phải cẩn thận, Ladep từng nói, để đề phòng người khác uống nhầm nước thuốc này, anh ta đã cố ý làm cho nước thuốc có mùi rất hôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280115,
					"content": "Nếu dính lên quần áo thì mùi hôi kia sẽ bám rất lâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280112,
					"content": "Chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
