			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awan",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "Yasmin? Sao cô lại ở đây? A... Có phải cô lại tới đây tưới cái nước thuốc kia không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280402,
					"content": "Phần rễ này rất bình thường, không có vấn đề gì, không cần phải tưới loại nước thuốc đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280403,
					"content": "Cho dù là vậy thì cũng cần chăm sóc cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280404,
					"content": "Nếu chờ đến khi vấn đề xuất hiện rồi mới nghĩ cách, vậy có khác gì làm cuốn cá, cuốn xong rồi mới biết cá chưa chín không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280405,
					"content": "Dù làm lại lần nữa hay mở bánh đã cuốn ra cũng là chuyện vô cùng phiền phức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280406,
					"content": "Tôi thật sự là nói không lại cô, nhưng lần trước tôi cũng ý kiến với cô về mùi của nước thuốc kia rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280407,
					"content": "Tôi sống ở gần đây, không muốn ngửi cái mùi kì lạ đó mà đi ngủ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280408,
					"content": "Yên tâm đi, tôi đã bảo Ladep sửa công thức nước thuốc rồi, mùi không nồng như thế nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280409,
					"content": "Ôi, được rồi. Tôi đi trước đây. Nhưng đừng có tưới thứ thuốc đó vào sân nhà tôi đấy, tôi không chịu nổi đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280410,
					"content": "Được rồi, tôi biết rồi. Nhà Lữ Hành, đưa nước thuốc trong thùng cho tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280411,
					"content": "Cùng Yasmin rưới nước thuốc...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "Nước thuốc này đúng là hôi thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280413,
					"content": "Hình như cô không có cảm giác gì thì phải?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "Nếu ý bạn là mùi này thì... tôi từng tiếp xúc với rất nhiều thứ còn hôi hơn cả nước thuốc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280415,
					"content": "Thế này là được rồi, tôi đã ghi chép rất nhiều thông tin, chắc Pharez sẽ vui lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280416,
					"content": "Thù lao này giao cho bạn, Nhà Lữ Hành, cảm ơn bạn đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280417,
					"content": "Cũng không biết Ladep và Pharez làm việc thế nào rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
