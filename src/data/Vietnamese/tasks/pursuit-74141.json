					"nextDialogs": [
						741410804
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410804,
					"content": "#...Hóa ra là {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410805
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410805,
					"content": "Sao anh lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410806
					]
				},
				{
					"id": 741410806,
					"content": "Tôi cũng đang muốn hỏi câu này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410807
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410807,
					"content": "Không có gì, chỉ là tôi cảm thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410808,
					"content": "#{F#Cô}{M#Cậu} là {NICKNAME}, phải không? Bé con màu trắng bên cạnh... tên là gì nhỉ? Sao không đi cùng {F#cô}{M#cậu}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410809,
						741410811
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410809,
					"content": "Paimon đang đợi tôi ở bên ngoài.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410810
					]
				},
				{
					"id": 741410810,
					"content": "#Cô ấy tên như vậy sao? Thôi, không quan trọng nữa. {F#Cô}{M#Cậu} là người tốt, Paimon cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410812
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410812,
					"content": "#Tôi đến đây để tìm một vật rất quan trọng. {F#Cô}{M#Cậu} có biết tôi muốn tìm cái gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410813
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410813,
					"content": "#Thôi, coi như tôi chưa hỏi đi. Tại sao {F#cô}{M#cậu} lại ở đây? Mau đi đi, nơi này rất nguy hiểm. Trước kia có người đến đây để thí luyện, nhưng lại bị lạc đường, tinh thần trở nên hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410814
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410814,
					"content": "Tôi nhớ ra rồi, chúng ta đã làm những chuyện rất lớn lao. Đó là chuyện duy nhất đáng để tôi tự hào trong đời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410815
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410815,
					"content": "Anh đang nói đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410816,
						741410818
					]
				},
				{
					"id": 741410816,
					"content": "Việc chiến thắng Narzissenkreuz ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410817
					]
				},
				{
					"id": 741410817,
					"content": "#Đại sư thế nào rồi? {F#Cô}{M#Cậu} cũng là thành viên của Hội Narzissenkreuz à...? Hay là người của Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410820,
					"content": "A, bươm bướm vàng. Màu sắc lóa mắt như ánh nắng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410821
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410821,
					"content": "Chỉ cần có được ánh sáng như vậy, thì tất cả đều sẽ... Tất cả đều sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410818,
					"content": "Việc cứu Lanoire ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410819
					]
				},
				{
					"id": 741410819,
					"content": "Tôi nhớ ra rồi. Đúng vậy, chúng ta đã đưa Lanoire trốn khỏi nhà tù dưới đáy biển. Trẻ con không nên sống ở nơi như vậy. Em ấy nên sống với hoa và ánh mặt trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410811,
					"content": "Anh vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410812
					]
				}
			]
