			"dialogs": [
				{
					"id": 741411001,
					"content": "...Vậy sao? thế thì dễ rồi. À ừm, nhóc tên gì ấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
