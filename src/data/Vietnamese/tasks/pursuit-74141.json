			"dialogs": [
				{
					"id": 741410101,
					"content": "(Nội dung trên trang sách vẫn được tạo nên từ những hình vẽ, chữ viết và cổ ngữ vô cùng khó hiểu. Nhưng sau khi tập trung tinh thần, dần dần có thể hiểu được nội dung trong đó rồi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 741410102,
					"content": "Hình như Canotila không ở đây, có lẽ lại đến nơi bí ẩn kia rồi! Có nên thiền không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "Sau khi nghe những gì cô ấy nói lần trước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "Có hơi lo lắng, tôi muốn đi xem thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "Ừm... Mặc dù hơi bất an, nhưng mà chúng ta phải đi cùng nhau chứ! Canotila thật khiến người ta lo lắng mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Paimon chờ tôi ở bên ngoài là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "Thế giới trong Sách Khải Huyền...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "Có lẽ còn nguy hiểm hơn trong tưởng tượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "Cho nên, tôi không muốn Paimon phải mạo hiểm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "Nhưng mà... Chẳng phải chúng ta đã luôn đi chung sao? Khi chúng ta ở bên nhau thì không có khó khăn nào là không thể vượt qua cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "Những nguy hiểm bên trong có thể không giải quyết được bằng vũ lực.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "#Được rồi! Tôi tin tưởng {NICKNAME}. Đừng bỏ tôi lại nhé, tôi sẽ chờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "Có lẽ có một mặt nào đó mà chúng ta chưa biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
