					"content": "Caterpillar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#{NICKNAME}, không ngờ lại gặp {F#cô}{M#cậu} ở đây. Paimon không đi cùng à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411004,
					"content": "#Khoan đã, không phải {F#cô}{M#cậu} cũng là quái vật gì đó biến thành dạng con người để khiêu khích tôi đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411005,
					"content": "Chúng ta mới gặp nhau cách đây không lâu mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "...Vậy sao? Cảm giác như đã lâu lắm rồi kể từ khi tạm biệt nhau. Thôi, có lẽ là già rồi, càng ngày càng nhớ được ít chuyện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411007,
					"content": "#...{F#Cô}{M#Cậu} thật sự không phải là quái vật gì đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411008,
					"content": "Anh có còn nhớ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "Về chuyện vườn hoa của người khổng lồ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "#Tôi nhớ. Tôi nhớ. Đúng là {F#cô}{M#cậu} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411012,
					"content": "Xin lỗi, tôi đã gặp quá nhiều chuyện ở đây, đã trải qua rất nhiều cuộc chiến không thể thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411013,
					"content": "Nhưng cuối cùng ở đây đã có sự thay đổi. Ánh sáng vàng đã chiếu xuống, hoa hướng dương đã nở rộ. Có lẽ ngay cả vũ trụ mà người xưa tưởng tượng cũng sẽ thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411014,
					"content": "Chắc mọi chuyện rồi sẽ tốt hơn. Có lẽ tôi cũng thấu hiểu và buông bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411015,
					"content": "Caterpillar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Đi cùng tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "#Haha, xem ra đúng là {F#cô}{M#cậu} rồi. Tôi đã nhớ ra, tôi đã từng quen {F#cô}{M#cậu}, đến giờ vẫn không hề thay đổi. {F#Cô}{M#Cậu} luôn lo chuyện bao đồng, đó là do sự chính trực và lương thiện của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411018,
					"content": "#Nhưng {F#cô}{M#cậu} không cần lo cho tôi, tôi không cần giúp đỡ. {F#Cô}{M#Cậu} cũng từng chứng kiến bản lĩnh của tôi rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411019,
					"content": "#Huống hồ, có lẽ tôi còn biết nhiều chuyện ở đây hơn cả {F#cô}{M#cậu} đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411020,
					"content": "Hilichurl, hãy giúp tôi kêu người đó mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "Cún con có điều muốn nói với tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "#...{F#Cô}{M#Cậu} hiểu được lời tôi nói sao? Ừm, vậy trong mắt {F#cô}{M#cậu}, tôi là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "Một chú chó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Vậy à... Vậy thì vẫn còn kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "#Hãy rời khỏi nơi này đi. Điều này sẽ tốt hơn cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#Tôi cũng nghĩ thế. {NICKNAME} thuộc về thế giới tươi sáng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411027,
					"content": "Tôi còn một câu hỏi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "Điều đó là không nên. Tạm biệt. Đừng quay lại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "Về chuyện học trò và cá con.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
