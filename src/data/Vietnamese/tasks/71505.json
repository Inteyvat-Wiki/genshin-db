				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}, cuối cùng thì bạn cũng tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050102,
					"content": "Chạy thử thuận lợi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "Đã chạy thử rồi, mặc dù tôi hơi lo lắng, nhưng hiện tại chỉ có thể tạm thời đặt Gai Pursina vào chỗ sâu trong hầm mỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050104,
					"content": "Tôi cũng đã nhờ Khedive chế thuốc rồi, sẽ gửi cho Lão Tu và Hao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}, kích hoạt Gai Pursina, sau đó đóng lỗ thông phun bùn đen của Địa Mạch... nhất định phải làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050106,
					"content": "Vốn dĩ Khedive nhờ tôi tới giúp đỡ thôi, lúc đó tôi đã nghĩ, nếu như tôi không xử lý được vấn đề này, cùng lắm thì cầm Gai Pursina về Sumeru thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050107,
					"content": "Dù sao thì thí nghiệm của \"Gai Pursina\" cũng đủ rồi, quá đủ để hoàn thành một báo cáo với dữ liệu chi tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050108,
					"content": "Nhưng Lão Tu và Hao thì sao, những người sống ở đây... bọn họ chỉ có thể sống chung với đống bùn đen nguy hiểm đó cả đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050109,
					"content": "Nếu nghiên cứu của tôi thực sự không thể giúp được gì cho họ, mà chỉ để làm báo cáo, tôi nghĩ, nghiên cứu này sẽ không có ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050110,
					"content": "Chính vì vậy tôi quyết định tìm cách giải quyết vấn đề bùn đen tràn ra từ Địa Mạch, chưa kể, tiếp xúc với đống bùn đen này... Đó cũng là lời cảnh tỉnh cho tôi với tư cách là một học giả Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050111,
					"content": "#Tôi tin vào sức mạnh của bạn, nhưng nơi mà bùn đen xuất hiện vẫn còn nguy hiểm, hãy cẩn thận, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050112,
					"content": "Biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "Hahaha khụ khụ, khụ khụ... khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050115,
					"content": "#Ý tôi là bạn, {NICKNAME}, khởi động \"Gai Pursina\" ở chỗ lỗ thông hơi, mặc dù nó có thể làm giảm tác động của bùn đen lên quái vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050116,
					"content": "Nhưng vẫn còn quá nhiều quái vật bị thu hút bởi bùn đen trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050117,
					"content": "Bạn nhất định phải chú ý an toàn của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050113,
					"content": "Tôi sẽ bảo vệ Gai Pursina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
