					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "Xin chào quý khách, cháu biết con trai Guy của ông chứ? Khụ... khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600102,
					"content": "Bạn sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Không sao không sao, chỉ là bệnh thường thôi, không có vấn đề gì, thế nhưng cũng không khỏi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600104,
					"content": "Trước kia đến <color=#00E1FFFF>Giáo Hội</color> cũng xem qua rồi, tu nữ cũng bảo không thể chữa ngay được, chỉ có thể dùng thuốc từ từ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600105,
					"content": "Haizz, lớn tuổi rồi, cũng không đi được đường dài, trước kia đều nhờ Moco và Hillie thay ông đi bốc thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600106,
					"content": "Họ dường như có chuyện bận... Khụ khụ... Ông nói với <color=#00E1FFFF>tiểu thư Jilliana</color> rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600107,
					"content": "Đem nguyên liệu đến là cô ấy sẽ chế thuốc. Chỉ cần <color=#00E1FFFF>3 phần Hoa Ngọt</color> là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600108,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600109,
					"content": "Khụ khụ, khụ... Vậy nhờ cháu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600112,
					"content": "3 phần Hoa Ngọt, sau đó đến Giáo Hội tìm tu nữ Jilliana chế thuốc, <color=#00E1FFFF>đừng để Guy biết.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600113,
					"content": "Ông nghe nói, Giáo Hội và Đội Kỵ Sĩ Tây Phong có quan hệ với nhau, thằng bé là Kỵ Sĩ Tây Phong, thế nhưng luôn phải chú ý đến ngôn từ và cử chỉ của mình mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600114,
					"content": "Nếu chỉ vì lão già này mà phạm phải sai lầm nào, thì thật là phiền phức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600115,
					"content": "Xin lỗi, phải khiến cháu nghe ông luyên thuyên nửa ngày rồi, mau đi thôi, nhớ cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600110,
					"content": "Có thể nhờ con trai Guy của ông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600111,
					"content": "Đâu có được, thằng bé đang tham chiến ngoài kia, đám người già như bọn ông sao có thể thêm gánh nặng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				}
			]
		},
