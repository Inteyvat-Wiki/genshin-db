					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "Í? Không phải Moco và Hillie sao, hôm nay sao lại là bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
