			"dialogs": [
				{
					"id": 200600501,
					"content": "Í, xin chào! Trên tay bạn là Hoa Ngọt phải không. Tuy có chút đường đột, bạn có thể bán cho tôi 1 phần không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600502,
					"content": "Bố tôi cứ ho suốt, tôi đi hỏi tiểu thư Jilliana về phương thuốc chống ho, thế nhưng nguyên liệu chỗ cô ấy đã dùng hết mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600503,
					"content": "Tôi cũng cần đi chế thuốc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "Như vậy sao? vậy thôi vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600505,
					"content": "Xin lỗi, làm mất thời gian của bạn rồi, mau đến Giáo Đường, tiểu thư Jilliana vẫn ở đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600506,
					"content": "Hoa Ngọt chắc cũng dễ tìm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "Hả? Ồ... Tôi biết, thế nhưng tôi cần phải giữ cửa, thật sự không thể dứt ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600508,
					"content": "Phải đi hỏi tiểu thư Jilliana, tôi cũng chỉ có thể tranh thủ thời gian nghỉ trưa đi hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600509,
					"content": "Thôi vậy, xem bộ dạng của bạn, chắc cũng phải đi chế thuốc rồi... Không làm mất thời gian của bạn nữa, mau đến Giáo Đường, tiểu thư Jilliana đang ở đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				}
			]
		},
