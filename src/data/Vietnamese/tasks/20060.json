			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "Thuốc đã chế xong, thế nhưng loại thuốc này chỉ là tạm thời, không trị được căn nguyên, muốn trị khỏi hoàn toàn phải uống thuốc tĩnh dưỡng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600802,
					"content": "Tôi đã nói với ông ấy nhiều lần rồi, ông ấy dường như không nghe lời, cứ như vậy đâu có được, ai cũng không khuyên được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600803,
					"content": "Được rồi, bạn mau đem thuốc đến cho ngài Tunner đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600804,
					"content": "Cám ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600805,
					"content": "Đừng khách sáo, tôi chỉ làm tròn bổn phận của mình mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600806,
					"content": "Phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600807,
					"content": "Không sao. Í... Nếu như có người chăm sóc ngài Tunner, ông ấy sẽ không phải uống thuốc nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
