					"nextDialogs": [
						741180603
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180603,
					"content": "Thưa ngài, xem ra chúng ta phải nhanh chóng quay về Thị Trấn Petrichor thôi.",
