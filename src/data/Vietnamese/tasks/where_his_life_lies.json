						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "...Chắc ở đây là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180302,
					"content": "Để tôi kể từ đầu vậy. Từ sau khi ngài Garcia cải tiến Máy Đánh Số ở Sumeru thì tính năng của cỗ máy đó đã có bước tiến lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180303,
					"content": "Ngài ấy rất phấn khởi, muốn tiếp tục cải tiến nữa. Nhưng giống như lời ngài ấy nói, kết cấu truyền động truyền thống có chỗ hạn chế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180304,
					"content": "Tính năng của cỗ máy đó đã không thể đột phá được nữa, cho nên chúng tôi muốn quay về Fontaine để tìm kiếm một ý tưởng nghiên cứu khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180305,
					"content": "Nhưng khi chúng tôi quay về Fontaine thì có một người kỳ lạ đột nhiên đến gặp ngài Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180306,
					"content": "Người này bày tỏ là mình có thể cung cấp tài chính nghiên cứu cho ngài Garcia, thậm chí là giúp ngài ấy tìm kiếm một người hợp tác khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180307,
					"content": "Nhưng đổi lại, ngài Garcia phải chia sẻ tất cả ý tưởng và dữ liệu của Máy Đánh Số cho người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180308,
					"content": "Chắc chắn Garcia sẽ không đồng ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "Đúng vậy! Mở miệng ra là muốn lấy thành quả nghiên cứu của người ta, chắc là định ăn cướp rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180311,
					"content": "Đúng thế. Cho nên ngài Garcia đã từ chối người này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180312,
					"content": "Nhưng sau đó, hình như có một người liên tục bám theo tôi và ngài Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180313,
					"content": "Hơn nữa, cũng có người lẻn vào phòng chúng tôi nhân lúc chúng tôi đi vắng, lại còn tìm kiếm thứ gì đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180314,
					"content": "Mặc dù người kia đã trả lại tất cả mọi thứ như cũ, nhưng vẫn bị ngài Garcia phát hiện ra dấu vết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180315,
					"content": "Đáng sợ quá... Người ta không muốn đưa cho hắn nên hắn thẳng tay cướp về sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180316,
					"content": "Sau khi phát hiện căn phòng bị lục lọi, chúng tôi đã quyết định xoay sở tiền để quay về Thị Trấn Petrichor càng sớm càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180317,
					"content": "Đợi sau khi đến đó, chúng tôi sẽ liên lạc với những thành viên khác ở Câu Lạc Bộ Mơ Mộng để cùng nhau giải quyết vấn đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180318,
					"content": "Hơn nữa, Thị Trấn Petrichor cũng là... Haha, là căn cứ của ngài Garcia mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180319,
					"content": "Với ngài ấy mà nói thì không có nơi nào an toàn hơn Thị Trấn Petrichor cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180320,
					"content": "#Đáng lẽ hôm nay là ngày xuất phát. Chúng tôi đang chuẩn bị lên đường đến Thị Trấn Petrichor nên mới mời {F#cô}{M#cậu} hộ tống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180321,
					"content": "Không ngờ lại gặp phải tiểu thư Kaia... Vì lý do an toàn, tôi chỉ đành để ngài Garcia đưa tiểu thư Kaia về thành phố trước thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180322,
					"content": "Tôi có thể làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "#Xem ra, chúng tôi không thể kéo dài ngày khởi hành nữa. {F#Cô}{M#Cậu} bây giờ hãy đến chỗ ngài Garcia nhé. Như tôi đã nói lúc trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180325,
					"content": "#Có người bạn đồng hành danh tiếng như {F#cô}{M#cậu}, có lẽ chúng tôi sẽ tránh được một vài rắc rối không cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180326,
					"content": "Tôi sẽ qua đó ngay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "Ngài Garcia sẽ nói hết mọi chuyện cho tiểu thư Kaia. Còn chuyện sau này... thì để tiểu thư Kaia tự quyết định vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180331,
					"content": "Tóm lại, chúng ta mau chóng quay về thành phố thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180327,
					"content": "Họ sẽ không gặp phải nguy hiểm gì đó chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "Không đâu. Bây giờ ngài Garcia đang ở trong Đại Sảnh Fontaine, ở đó có rất nhiều Robot Hiến Binh tuần tra mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180329,
					"content": "Nếu như bọn họ muốn sử dụng bạo lực thì Sảnh Chấp Pháp sẽ giải quyết thay chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180323,
					"content": "Tôi có thể giúp gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "Người này nghe có vẻ không giống người tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
