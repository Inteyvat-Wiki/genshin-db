			"dialogs": [
				{
					"id": 741180201,
					"content": "Viện Ca Kịch quả là hoành tráng, tiền kiếm được chắc chắn không ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180202,
					"content": "Viện Ca Kịch... Haiz, chúng ta mau đi làm việc nào. Làm xong rồi thì về Thị Trấn Petrichor thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180203,
					"content": "Sau đó, tôi sẽ mở một cửa hàng bánh mì trong thị trấn, từ nay sẽ không động vào Máy Đánh Số gì đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180204,
					"content": "Khụ... Thưa ngài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180205,
					"content": "Lutong, sao thế? Vẻ mặt của anh... Chẳng lẽ gặp phải ma quỷ gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180206,
					"content": "Đúng là... gặp ma rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180207,
					"content": "Garcia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180208,
					"content": "Tiểu thư Kaia?! Tại sao cô lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180209,
					"content": "Quả là trùng hợp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "Thưa ngài, vừa rồi ngài phát biểu thật không hợp tình huống đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180211,
					"content": "Chậc, im lặng nào, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180212,
					"content": "#Garcia, rất vui được gặp anh ở đây, và cả {NICKNAME} nữa. Chắc anh đến đây để tính toán sổ sách của Viện Ca Kịch đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180213,
					"content": "Chẳng lẽ sổ sách anh ta muốn tính toán là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "Vậy thì không phải. Đoàn kịch của chúng tôi không biểu diễn trong Viện Ca Kịch này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180215,
					"content": "Chỉ có điều, dựa vào sự hiểu biết của tôi về Garcia thì anh ấy sẽ không đi xem ca kịch vào thời gian rảnh đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180216,
					"content": "Sở dĩ đến Viện Ca Kịch... Cũng chỉ vì được người ta thuê đi làm việc, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180217,
					"content": "Tôi thật lòng cảm thấy cô thích hợp thay thế tôi ở bên cạnh ngài ấy hơn đấy, tiểu thư Kaia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180218,
					"content": "Mỗi người chúng ta đều không thể thay thế mà, Lutong thân mến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180219,
					"content": "Tôi... Khụ... Kaia, rất hân hạnh được gặp cô, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180220,
					"content": "...Nhìn anh có vẻ như không được vui lắm, việc nghiên cứu của anh không suôn sẻ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180221,
					"content": "Cô cũng đoán được rồi ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "#À, ít nhất thì anh ấy sẽ không cảm thấy không vui khi nhìn thấy tôi, {F#cô}{M#cậu} hay là Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180223,
					"content": "Trong cuộc sống của anh Garcia thì điều có thể khiến anh ấy không vui chỉ có thể là cái \"Máy Đánh Số\" kia thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180224,
					"content": "Tại sao tiểu thư Kaia lại hiểu rõ anh Garcia vậy nhỉ? Rõ ràng họ đã xa nhau rất lâu mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180225,
					"content": "Có lẽ là trực giác của cô ấy chăng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "Có lẽ ngài nên đến quán cà phê và từ từ nói chuyện. Đây không phải là chuyện có thể nói rõ chỉ với dăm ba câu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180228,
					"content": "Tôi còn định... Khụ, không, tôi rất vui... Nhưng chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180229,
					"content": "Ngài yên tâm. Những phép tính kia cực kỳ đơn giản, một mình tôi cũng có thể giải quyết hết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180230,
					"content": "...Ngài không nên bỏ mặc tiểu thư Kaia cho đến khi chúng ta kết thúc công việc chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180231,
					"content": "Lutong, anh thật chu đáo. Chúng tôi sẽ mang một cốc cà phê về cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180232,
					"content": "Cảm ơn cô. Chúc tiểu thư và ngài Garcia đi vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180233,
					"content": "Garcia và Kaia cùng nhau rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "Họ cứ thế mà đi uống cà phê rồi... Hình như từ đầu đến cuối đều không có việc gì của mình nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180235,
					"content": "Chúng ta hoàn toàn không liên quan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#Không, {NICKNAME}. Sau đây mới là nội dung ủy thác chính thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180238,
					"content": "Anh muốn tìm nguyên liệu nấu ăn gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "#{F#Cô}{M#Cậu} thật hài hước. Nhưng tôi không có ý định làm lãng phí thời gian của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180242,
					"content": "Đúng là bây giờ ngài Garcia và tôi đang rơi vào thế nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180243,
					"content": "Hả...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180244,
					"content": "Chúng ta sang bên kia nói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180239,
					"content": "Anh muốn tìm linh kiện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "Hay là tôi đi chụp ảnh kỷ niệm cho họ nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "Vậy chúng ta ở đây làm gì nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "Có lẽ do anh Garcia khá dễ đoán chăng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
			"completionStepIds": [
				7411803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
