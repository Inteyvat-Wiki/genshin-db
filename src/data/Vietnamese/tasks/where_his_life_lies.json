					"nextDialogs": [
						741180624
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180624,
					"content": "Khụ! Lutong, chúng ta phải nhanh chóng tìm một nơi thích hợp để ở thôi! Tốt nhất là nơi nào đó nhiều người chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180625
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180625,
					"content": "Nơi nhiều người... Có lẽ chúng ta có thể đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180626
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180626,
					"content": "Hay là đến khách sạn của đoàn kịch chúng tôi nhé? Ở đó có rất nhiều người, mà mọi người cũng quen biết lẫn nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180627
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180627,
					"content": "Nếu có người lạ muốn trà trộn vào thì sẽ bị phát hiện ngay. Hơn nữa, trưởng đoàn kịch chúng tôi cũng rất muốn tìm hiểu về Máy Đánh Số.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180628
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180628,
					"content": "Khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180629
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180629,
					"content": "Cứ làm thế đi! Tuyệt quá, mọi vấn đề đều được giải quyết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180630
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180630,
					"content": "Mọi vấn đề ư?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180631
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180631,
					"content": "#Cứ quyết định như vậy đi. {NICKNAME}, hãy nhận lấy số tiền này coi như là phí hộ tống ứng trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180632
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180632,
					"content": "#Mặc dù không biết khi nào mới có thể xuất phát... Nhưng đến lúc đó thì mọi việc đều trông cậy vào {F#cô}{M#cậu} đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180633
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180633,
					"content": "Nhưng sao tôi cứ cảm thấy càng ngày càng có nhiều vấn đề nhỉ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180610,
					"content": "Tôi có thể đi hộ tống.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				}
			]
