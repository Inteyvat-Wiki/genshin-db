					}
				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "...Thưa ngài, có lẽ chúng ta nên đến Thị Trấn Petrichor trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180102,
					"content": "Mặc dù ngài Xavier và ngài Félix đều không ở đây, nhưng chắc là Mécantre và Babisse vẫn còn ở trong thị trấn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180103,
					"content": "Có lẽ họ sẽ cho ngài một vài đề xuất hoặc gợi ý. Cho dù trong tình huống xấu nhất thì ngài cũng có hai đối tượng để kể khổ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180104,
					"content": "Không không, Lutong thân mến, không... Việc nghiên cứu của Mécantre và Babisse bây giờ đang bùng cháy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180105,
					"content": "Lần trước họ viết thư cho tôi, nói là trong Thị Trấn Petrichor có một người rất thông minh của Viện Khoa Học Fontaine đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180106,
					"content": "Quý ngài tên là Bossuet này rất có học thức và hiểu biết, đã giúp họ giải quyết rất nhiều vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180107,
					"content": "Còn tôi thì... Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180108,
					"content": "Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#{NICKNAME}, quả là vinh hạnh. Không ngờ lại gặp được {F#cô}{M#cậu} ở Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180111,
					"content": "#Mặc dù... Thời điểm mà {F#cô}{M#cậu} đến đúng là quá trùng hợp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180112,
					"content": "#Đúng thế, cực kỳ trùng hợp... Nhưng vẫn rất vui được gặp {F#cô}{M#cậu}, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180113,
					"content": "Woa, trông anh ta có vẻ rất mệt mỏi nhỉ... Mắt thâm quầng, cả người phờ phạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180114,
					"content": "Garcia, anh sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Chúng tôi... Ừm, việc nghiên cứu của ngài ấy đang gặp phải một số vấn đề mà trước đây chưa từng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180116,
					"content": "Nhưng chuyện này rất dài dòng... Bây giờ chúng tôi đang định đến Viện Ca Kịch Epiclese để thanh toán sổ sách cho họ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180117,
					"content": "Sau khi công việc kết thúc, chúng ta tìm một nơi yên tĩnh để nói chuyện nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180118,
					"content": "Các anh đang làm công việc khác sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "Không hẳn là công việc. Chỉ là được người ta thuê đi hỗ trợ tính toán khắp nơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180120,
					"content": "Dạo này Viện Ca Kịch Epiclese tiếp đón rất nhiều đoàn kịch, nên cần tiến hành thanh toán gấp sổ sách tổng thể một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180121,
					"content": "Cho nên vì muốn gom góp chi phí để về Thị Trấn Petrichor thì tôi... đã thay mặt ngài Garcia nhận ủy thác này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180122,
					"content": "Đúng là dùng thiên tài cho việc nhỏ nhặt mà! Những sổ sách đó đơn giản vô cùng, tôi không cần \"Máy Đánh Số\" cũng có thể tính hết được trong một buổi chiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180123,
					"content": "Cho nên đây mới là phương pháp tốt để gom góp kinh phí đó. Chúng ta mau xuất phát thôi, thưa ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180124,
					"content": "#À đúng rồi, {NICKNAME} có thể đồng hành cùng chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180125,
					"content": "#Có người bạn đồng hành danh tiếng như {F#cô}{M#cậu}, có lẽ chúng tôi sẽ tránh được một vài rắc rối không cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180126,
					"content": "#Chúng tôi sẽ trả cho {F#cô}{M#cậu} thù lao tương xứng, xin hãy yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180127,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "Rất khó nói... Haha, tóm lại thì chúng ta mau lên đường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180128,
					"content": "Không lẽ trong thành phố đang có chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "Anh về Fontaine rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
