					"content": "...Quả nhiên, đám người kia vẫn đang theo dõi ngài Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180402
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180402,
					"content": "Nhìn cái bàn ở gần quầy kìa, có một người đàn ông với chiếc mũ trước mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180403
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180403,
					"content": "Tôi chắc chắn hắn vừa theo đuôi chúng tôi mấy ngày trước.",
