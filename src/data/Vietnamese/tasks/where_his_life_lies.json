				},
				{
					"id": 741185004,
					"content": "Mặc dù chúng tôi đã báo cho hiến binh, nhưng đến giờ vẫn chưa có manh mối gì, nên sự việc chưa có tiến triển.",
					"roleType": "TALK_ROLE_NPC",
