						741180605
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180605,
					"content": "Lát nữa tôi sẽ về báo cáo việc này, mấy ngày nữa là có kết quả thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180606
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180606,
					"content": "Tình huống khả quan nhất là chúng tôi sẽ điều động được vài đồng nghiệp đến hộ tống các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180607
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180607,
					"content": "Nhưng nhân lực của chúng tôi có hạn, còn phải lo chuyện trong thành phố nữa. Nên chúng tôi chỉ có thể hộ tống một đoạn thôi, không thể đưa thẳng đến Thị Trấn Petrichor được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180608
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180608,
					"content": "Hơn nữa, tốt nhất là các vị nên chuyển đến một nơi an toàn trước đã. Do thảo luận chuyện này có thể sẽ cần... một khoảng thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180609,
						741180610
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180609,
					"content": "Việc hộ tống thì cứ giao cho tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				},
				{
					"id": 741180611,
					"content": "#Cảm ơn. Có {F#cô}{M#cậu} đồng hành thì chắc chắn đám người kia sẽ không dám làm loạn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180612
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180612,
					"content": "Nhưng chẳng phải tiểu thư Kaia làm việc ở đoàn kịch sao? Các anh đến Thị Trấn Petrichor rồi thì cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180613,
					"content": "À, tôi sẽ đi cùng họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180614
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180614,
					"content": "Sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180615
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180615,
					"content": "Tiểu thư, tôi thật lòng cầu xin đấy. Xin hãy...",
