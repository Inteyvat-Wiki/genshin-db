					"speakerTitle": "Lutong"
				},
				{
					"id": 741180404,
					"content": "Tôi đi gọi hiến binh nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "Cũng được đấy... Vừa đúng lúc có một vị hiến binh ở gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180407,
					"content": "Trước đó chúng tôi đã báo cho một vị hiến binh tên Menthe rồi, cô ấy cũng đã hiểu tình hình hiện giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180408,
					"content": "Tôi tin cô ấy sẽ sẵn lòng giúp đỡ chúng tôi. Có một vị hiến binh ở đây, chắc đám người kia cũng không dám hành động quá khích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}, giúp tôi đi nói rõ tình hình với hiến binh Menthe nhé, tôi đi tìm ngài Garcia đây.",
