						741185005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185005,
					"content": "Hơn nữa, Đại Sảnh Fontaine rộng như vậy, hiến binh cũng không thể bảo vệ chúng tôi ở mọi nơi được.",
					"roleType": "TALK_ROLE_NPC",
