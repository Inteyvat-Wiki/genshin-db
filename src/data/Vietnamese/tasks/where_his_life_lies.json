			"dialogs": [
				{
					"id": 741180601,
					"content": "...Cảm ơn hiến binh Menthe nhé. Cô vừa đến là tên kia đứng dậy bỏ đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
