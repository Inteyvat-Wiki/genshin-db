					"nextDialogs": [
						741180604
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180604,
					"content": "Tôi nghĩ đám người kia đã dần mất kiên nhẫn rồi. Có lẽ... họ sẽ hành động quá khích đấy.",
					"roleType": "TALK_ROLE_NPC",
