				{
					"id": 741185007,
					"content": "Hy vọng ngài Garcia có thể thuyết phục tiểu thư Kaia mau chóng rời khỏi Fontaine. Nếu vậy thì chúng tôi còn có thể hành động theo kế hoạch ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185008,
					"content": "Không phải nghiên cứu của Garcia không có triển vọng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "\"Không có triển vọng\" ý là không thể nâng cấp tính năng lên thêm một bậc nữa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185010,
					"content": "Nhưng trong lĩnh vực ứng dụng thì Máy Đánh Số rất có triển vọng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185011,
					"content": "Chỉ có điều, ngài Garcia chưa bao giờ quan tâm đến lĩnh vực ứng dụng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185012,
					"content": "Tôi nghĩ đây cũng là một trong những nguyên nhân khiến ngài ấy thường bị bế tắc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185013,
					"content": "Có điều, cũng chính vì thế mà ngài ấy đóng vai hình tượng một nhà nghiên cứu thất bại vô cùng thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185014,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "Làm phiền rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
