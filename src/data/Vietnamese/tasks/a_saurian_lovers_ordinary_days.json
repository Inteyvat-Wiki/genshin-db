			"dialogs": [
				{
					"id": 750240101,
					"content": "Mấy nhóc à, sự nhiệt tình của mấy nhóc thật khiến ta chịu không nổi đấy. Phù... Ăn chút nước đá để làm dịu đầu óc, sau đó chúng ta từ từ trò chuyện được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240102
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240102,
					"content": "Grào...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240103
					],
					"speakerTitle": "\"Cúc Vạn Thọ\""
				},
				{
					"id": 750240103,
					"content": "Chỉ nghe thấy một tiếng hét thảm thiết, tiếp đó là tiếng vật nặng rơi mạnh xuống đất. Sau đó nữa chỉ còn lại tiếng nức nở của Saurian...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240104
					]
				},
				{
					"id": 750240104,
					"content": "Ấy?! Anh ta không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240105,
					"content": "Chà... Bị chúng vây chặt luôn rồi, không biết người bên trong thế nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240106,
					"content": "Paimon bay lên trên nhìn thử xem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240107
					]
				},
				{
					"id": 750240107,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240108,
					"content": "#Hình như {REALNAME[ID(2)|SHOWHOST(true)]} nói là để nó thử đấy. Vậy cứ giao cho nó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240109,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240110,
					"content": "Tình hình có vẻ không ổn lắm nhỉ? Anh ta không lẽ đã chết rồi sao... Chậc, cái miệng tôi bậy quá, nói không chừng chỉ là ngất đi thôi. Nhưng dù thế nào thì chúng ta cũng không thể thấy chết mà không cứu được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240111,
					"content": "Ờm thì... Cảm phiền ba vị cho tôi qua chút nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240112,
					"content": "Grào! Shrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240113
					],
					"speakerTitle": "\"Cúc Vạn Thọ\""
				},
				{
					"id": 750240113,
					"content": "Grào...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240114
					],
					"speakerTitle": "\"Sóng Nhỏ\""
				},
				{
					"id": 750240114,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240115
					],
					"speakerTitle": "\"Phỉ Thúy\""
				},
				{
					"id": 750240115,
					"content": "Tất cả chúng đều không chịu tránh đường... Rốt cuộc là có chuyện gì thế này? Theo lời người kia nói ban nãy thì chắc hẳn cũng không phải là những con Saurian xa lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240116,
					"content": "Nếu có nhiều manh mối hơn thì tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240117,
					"content": "...Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240118,
					"content": "#Hả? {REALNAME[ID(2)|SHOWHOST(true)]} có phát hiện gì rồi sao? Chúng ta mau qua đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502402,
			"completionStepIds": [
				7502402
			],
