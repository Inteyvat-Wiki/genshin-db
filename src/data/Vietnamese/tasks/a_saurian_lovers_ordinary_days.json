			"dialogs": [
				{
					"id": 750240601,
					"content": "Grào...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "\"Cúc Vạn Thọ\""
				},
				{
					"id": 750240602,
					"content": "Đừng kích động, bọn ta chỉ đang lo lắng người kia có bị thương hay không thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240603,
					"content": "Xem ra phải chiến đấu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "Đừng bỏ cuộc nhanh như thế! Cúc Vạn Thọ bé nhỏ, bọn này không có ác ý đâu. Bọn này cũng biết, ờm, ý định ban đầu của ngươi cũng không phải là muốn đánh nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240606,
					"content": "Grào! Shrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "\"Cúc Vạn Thọ\""
				},
				{
					"id": 750240607,
					"content": "Ối... Sao nó lại giận dữ hơn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240605,
					"content": "\"Cúc Vạn Thọ thân yêu của ta\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
		{
			"id": 7502407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
