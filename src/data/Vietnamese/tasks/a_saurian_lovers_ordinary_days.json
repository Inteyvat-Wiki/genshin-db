					}
				]
			},
			"dialogs": [
				{
					"id": 750240822,
					"content": "Con Tepetlisaur có tên Cúc Vạn Thọ kia sau khi thua trận đã chui xuống đất trốn mất. Nhân cơ hội này mau chóng đi kiểm tra người bị thương thôi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240801
					]
				},
				{
					"id": 750240801,
					"content": "Xem ra không có vết thương rõ ràng... Này... Anh có ổn không? Có thể nghe thấy lời tôi nói không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240802,
					"content": "Ôi, Cúc Vạn Thọ? Ngươi lo lắng cho ta sao? Đúng là tên nhóc mềm mỏng. Không sao, ta đã rèn luyện sức khỏe nhiều hơn để có thể chơi với ngươi mà không cần lo lắng gì rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240803
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240803,
					"content": "#Tôi là Paimon, không phải Cúc Vạn Thọ gì đó đâu! {NICKNAME}, anh ta có phải bị ngã đập trúng đầu rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240804,
						750240805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240804,
					"content": "Nói không chừng lát nữa là tỉnh táo lại thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240806
					]
				},
				{
					"id": 750240806,
					"content": "Hả? Không phải Cúc Vạn Thọ... Tôi bị sao thế này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240807
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240807,
					"content": "Kể lại chuyện anh ta bị ba con Saurian bao vây rồi bị Cúc Vạn Thọ húc ngã...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240808
					]
				},
				{
					"id": 750240808,
					"content": "Thì ra là như thế, gây rắc rối cho hai vị rồi... Xin hãy gọi tôi là Icayo. Như hai vị thấy đó, tôi là một nhà mạo hiểm thích đuổi theo Saurian... Thỉnh thoảng cũng bị Saurian truy đuổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240809
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240809,
					"content": "Đều tại tôi trước đó có chút vấn đề về sức khỏe, nằm liệt trên giường mất một thời gian, thậm chí không thể đến gặp riêng chúng đúng giờ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240810
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240810,
					"content": "Lần này tôi còn chưa vào đến lều trại là đã bị chúng vây lấy rồi. Có thể thấy là chúng lo lắng cho tôi lắm. Ôi, tôi thật sự quá hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240811,
						750240812
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240811,
					"content": "Xem ra anh rất giỏi suy nghĩ tích cực nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240813
					]
				},
				{
					"id": 750240813,
					"content": "Kể ra thì ban nãy chúng tôi vì cứu anh nên có xảy ra chút xung đột với Cúc Vạn Thọ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240814,
					"content": "A, không sao đâu. Đối với nó thì đó không khác gì việc chơi đùa thông thường cả. Chắc bây giờ nó đang trốn ở một góc nào đó mà dỗi rồi, vì dù sao cũng bị thua mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240815
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240815,
					"content": "Không giống như vẻ ngoài, nó là một tên nhóc đáng yêu với trái tim mềm yếu. Lát nữa tôi sẽ tìm và an ủi nó sau, hai vị yên tâm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240816
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240816,
					"content": "Được thôi. Nhìn anh chắc cũng không có vấn đề nghiêm trọng gì. Tuy mất công lo lắng, nhưng người không bị sao là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240817,
					"content": "Chân thành cảm ơn. À đúng rồi, tuy không phải thứ gì quý giá... nhưng xin hãy nhận lấy công thức làm món Cá Trích Sốt Chua này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240818
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240818,
					"content": "#Sóng Nhỏ rất thích món ăn này đó. {REALNAME[ID(2)|SHOWHOST(true)]} của {F#cô}{M#cậu} chắc cũng sẽ thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240819
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240819,
					"content": "Hmm... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
