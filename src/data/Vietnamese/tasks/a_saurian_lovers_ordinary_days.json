							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "\"Hôm nay là một ngày mưa. Chuẩn bị cho Sóng Nhỏ món <color=#00E1FFFF>Cá Trích Sốt Chua</color> mà nó thích nhất. Nhìn thấy dáng vẻ hài lòng thỏa mãn của nó thì tất cả mọi thứ đều đáng giá...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240202,
					"content": "\"Ngay cả khi nó đang bơi lội tung tăng, nhưng chỉ cần dọn món <color=#00E1FFFF>Cá Trích Sốt Chua</color> ra thì nó sẽ nhảy vọt lên khỏi mặt nước, vòng cung ấy có thể nói là hoàn hảo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240203,
					"content": "\"Tôi không nghi ngờ tình cảm của nó dành cho tôi. Chỉ là tôi lo lắng, có khi nào thực ra nó yêu thích <color=#00E1FFFF>Cá Trích Sốt Chua</color> nhiều hơn tôi hay không...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240204,
					"content": "Sóng Nhỏ... Chắc là đang nói đến Koholasaur nhỉ? Lửa trại ở đây cũng đang nấu Cá Trích Sốt Chua, chắc là đang chuẩn bị cho nó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240205,
					"content": "\"Đôi mắt to tròn, chiếc đuôi cuộn lại, tiếng kêu vui vẻ phấn khởi... Phỉ Thúy ơi Phỉ Thúy, trên thế gian này còn có con Saurian nào dễ thương hơn ngươi nữa không?...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240206,
					"content": "\"Chưa từng bị lừa gạt, cũng không biết nghi ngờ, dường như có thể kết bạn với tất cả sinh vật trên thế giới này, và cùng chia sẻ niềm vui chơi đùa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240207,
					"content": "\"Nếu như không phải quá bận thì ta rất muốn cùng ngươi vui chơi cả ngày lẫn đêm. Nhìn ngươi tung tăng chạy băng qua cánh rừng nắng, giống như đứa con của gió, như tinh linh vô tư vậy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240208,
					"content": "#Ồ, xem ra con Yumkasaur kia tên là Phỉ Thúy, còn là một con Saurian ham chơi. Nói không chừng {REALNAME[ID(2)|SHOWHOST(true)]} có thể kết bạn với nó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240209,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "\"Ta băng qua khắp núi đồi và thung lũng, chỉ vì tìm kiếm dấu vết của ngươi. Nếu như ngươi thực sự không muốn gặp ta, ngươi có thể cứ thế mà bỏ đi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240211,
					"content": "\"Nhưng ngươi lại dõi theo từng bước ta đi, đi rồi lại dừng, thậm chí còn thu nhặt cho ta rất nhiều Hạt Ngũ Cốc và những viên đá sáng lấp lánh đó...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240212,
					"content": "\"Cúc Vạn Thọ yêu dấu, chỉ có ta mới biết, vỏ ngoài cứng rắn ôm lấy trái tim dịu dàng ân cần. Hiếu chiến không phải ý định ban đầu của ngươi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "Nhật Ký Của Ai Đó"
				},
				{
					"id": 750240213,
					"content": "Cúc Vạn Thọ... Chắc không phải là nói con Tepetlisaur nóng tính kia chứ? Nhìn dáng vẻ hùng hổ đánh ngã người ta thì làm gì có chút dịu dàng ân cần nào chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240214,
					"content": "Nhưng kể ra thì ba con Saurian kia là... bạn của anh ta nhỉ? Rốt cuộc tại sao chúng lại húc anh ta bất tỉnh rồi bao vây xung quanh chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240215,
					"content": "Cứu người ra trước đi đã rồi nói sau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "Nói cũng phải. Nếu như có cách để bọn Saurian kia tránh ra thì tốt rồi... À, không phải trong nhật ký viết rằng Sóng Nhỏ thích ăn Cá Trích Sốt Chua sao? Vừa hay trong trại đang có, biết đâu có thể dụ nó rời đi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240217,
					"content": "#Để {REALNAME[ID(2)|SHOWHOST(true)]} kết bạn với Phỉ Thúy thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#Ừm! Phỉ Thúy rất ham chơi, {REALNAME[ID(2)|SHOWHOST(true)]} chỉ cần dẫn nó đi chơi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240221,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} cũng rất hăng hái đó nhé! Nhưng mà chúng ta vẫn nên thử biện pháp đơn giản nhất đã. Không ăn Cá Trích Sốt Chua là rất lãng phí đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240219,
					"content": "Chiến đấu với Cúc Vạn Thọ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#Vẫn nên thử các biện pháp hòa bình trước đã! Ví dụ như để cho {REALNAME[ID(2)|SHOWHOST(true)]} dụ Phỉ Thúy ham chơi rời đi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				}
			]
		},
