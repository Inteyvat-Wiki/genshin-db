			"dialogs": [
				{
					"id": 710660101,
					"content": "Haiz... kỳ lạ, thật là kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660102,
					"content": "Đáng lẽ vẫn phải ở đây mới đúng, sao không tìm ra được nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660103,
					"content": "Đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "Chiếc nhẫn của tôi... bị mất rồi. Chiếc nhẫn đó rất quan trọng đối với tôi, không thể bị mất ở đây được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660105,
					"content": "Chiếc nhẫn đó có hình dạng thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "Chiếc nhẫn đó làm từ đồng thau, trên đó khảm một viên bảo thạch đỏ lấp lánh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660107,
					"content": "Tôi nhặt được nó ở chỗ Hồ Dung Nham bên cạnh nơi ma long Durin trong truyền thuyết rơi xuống, điều này có thể lý giải vì sao nó mang ánh lửa hắc ám...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660108,
					"content": "Wao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660109,
					"content": "Trong truyền thuyết, chủ nhân khi đeo nó sẽ bị \"Vua Vực Sâu\" dõi theo, sẽ bị đội quân hắc ám truy sát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660110,
					"content": "Woa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
