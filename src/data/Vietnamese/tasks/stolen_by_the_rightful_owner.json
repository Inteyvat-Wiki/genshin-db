					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "Khụ khụ... xin lỗi xin lỗi, thân là nhà thơ nên tôi quen việc văn học hóa biểu đạt để tạo ra những câu chuyện mới mẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "Haha, thực ra chiếc nhẫn đó là do vài năm trước tôi lấy được từ hang ổ của Chồn Đạo Bảo... Trông vẫn còn mới với cũng khá đẹp nên tôi đã giữ lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "Hừ, thì ra là trộm đồ của tên trộm sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Đừng nói khó nghe thế chứ... là nhặt được mới đúng! Tôi rất trân trọng món báu vật này đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "Có manh mối gì về chiếc nhẫn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Ừm... nghe nói gần đây hay có Chồn Đạo Bảo xuất hiện, nói không chừng chính nó đã lấy trộm của tôi trong lúc tôi đang ngủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Ra là vẫn có người thích tháo nhẫn ra khi ngủ sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "Chưa từng nghe qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "Tôi có nói tôi đâu! Tháo nhẫn ra lại phải suy nghĩ xem để ở đâu, lãng phí thời gian ngủ lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "Có thật là có cỡ nhẫn dành cho Paimon không đấy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Hứ, đương nhiên rồi. Thế giới rộng lớn như vậy, vẫn còn nhiều thứ mà bạn chưa biết lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Được rồi! Hai vị đừng nên bình phẩm cuộc sống của người ta nữa, lại còn bàn tán giữa ban ngày nữa! Bất lịch sự lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "Nói chung thì, nếu hai người muốn giúp tôi tìm nhẫn thì... ừm, hãy tìm xem có hang ổ của Chồn Đạo Bảo không nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "Tôi nghe nói là Đạo Bảo Đoàn đã xây dựng doanh trại ở chỗ này. Để tôi đánh dấu cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "Nghe nói khu vực này thường có Chồn Đạo Bảo xuất hiện, rất có thể có liên quan đến Đạo Bảo Đoàn... Thôi thì cứ đi điều tra thử xem sao nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Hứ... trộm đồ của Chồn Đạo Bảo, rồi lại bị Chồn Đạo Bảo trộm, vậy xem như là vật về cố chủ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "Này! Đừng có mỉa mai tôi nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
