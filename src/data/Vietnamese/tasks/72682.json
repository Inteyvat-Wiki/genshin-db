			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "Ồ! Vị lữ khách tóc vàng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820102,
					"content": "Lại gặp mặt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "Ừm... bộ tóc vàng này trông quen lắm... không lẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820105,
					"content": "A đúng rồi! Trong đợt \"Hyakunin Ikki\" trước đó, biểu hiện của bạn như một \"cơn lốc vàng óng\" vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820106,
					"content": "Cơn lốc vàng óng...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "Lần trước, tôi đã ở một góc của đấu trường dõi theo những màn chiến đấu nảy lửa của những người tham gia, muốn thu thập những cảnh chiến đấu giao tranh gay cấn ấy làm tư liệu. Và tư thế chiến đấu của bạn khi đó tựa như một cơn lốc vàng óng quét sạch kẻ địch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820108,
					"content": "Không cần nói lời tâng bốc thế đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "Dù sao thì, sắp tới một số người sẽ lại tổ chức \"Hyakunin Ikki\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820114,
					"content": "Hyakunin Ikki là gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "Bằng cách đánh nhau một trận thật sảng khoái để chúc mừng, hoặc để xua đuổi sự xui rủi. Bất kể là võ sĩ hay ma vật đều có thể bỏ qua thân phận, chiến đấu vì đam mê thuần khiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820116,
					"content": "Nghe nói người bộc lộ hết tài năng trong đó, còn có thể nhận được rất nhiều báu vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820117,
					"content": "Mặc dù ban tổ chức và nhà tài trợ là ai, cho đến nay nó vẫn còn là một ẩn số.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820119,
					"content": "Tóm lại, chuyện này không thích hợp để thảo luận nơi đông người. Đi theo tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820118,
					"content": "Ra là vậy, tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "...Khen thêm chút nữa nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "E hèm... Có lẽ trong số quan khách, những người có thị lực nhanh như kiếm khách đã nhận ra, chiêu thức mà người dị nhân tóc vàng này đã sử dụng chính là \"Kouranka Daitatsumaki\" bị xem là cấm kỵ trong võ thuật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820111,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "Đây là cốt truyện lấy cảm hứng từ phong cách chiến đấu của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820103,
					"content": "Có ủy thác gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
		{
			"id": 7268202,
			"completionStepIds": [
				7268202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
