			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820201,
					"content": "Chúng ta đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820202,
					"content": "Chỉ cần bước qua cánh cổng trông có vẻ đáng ngờ này, là có thể vào được võ quán lần này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820203,
						726820204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820203,
					"content": "Thật phấn khích!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				},
				{
					"id": 726820205,
					"content": "Quy tắc lần này cũng tương tự với lần trước. Các ma vật, Nhà Mạo Hiểm và chiến sĩ khao khát chiến đấu ở khắp nơi trên thế giới, đều có thể thoải mái ra tay chiến đấu quyết liệt trên võ đài của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820206,
					"content": "Cũng giống như trước, bạn có thể tham gia chiến đấu cùng với bạn bè, chiến hữu có cùng chí hướng. Dù sao thì, cái gọi là Hyakunin dĩ nhiên là càng đông càng tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820207,
					"content": "Tôi rất kỳ vọng vào thể hiện của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820208,
					"content": "Lần này anh cũng không tham gia sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820209
					]
				},
				{
					"id": 726820209,
					"content": "Tôi sao? Tôi sẽ tham gia với tư cách khán giả, cổ vũ cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820210
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820210,
					"content": "Dẫu sao thì mục tiêu của tôi cũng là viết ra một bộ tiểu thuyết đối kháng đỉnh cao, chứ không phải trở thành một chiến sĩ giống bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820211,
					"content": "Và trực giác mách bảo tôi rằng, bạn nhất định là ngôi sao sáng nhất trên đấu trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820212,
						726820213
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820212,
					"content": "Tôi sẽ cố gắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820214,
					"content": "Ừm. Chắc hẳn lần này bạn cũng sẽ trình diễn được kỹ năng kiếm thuật xuất chúng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820213,
					"content": "Hãy chờ xem nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820204,
					"content": "Phiền thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				}
			]
		}
	]
}