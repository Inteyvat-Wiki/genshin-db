						740121204
					]
				},
				{
					"id": 740121204,
					"content": "Hmm, giống với cuộn băng lần trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740121205,
