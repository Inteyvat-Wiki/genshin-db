			"dialogs": [
				{
					"id": 740120501,
					"content": "Chà, thật nghiêm khắc! Tôi sẽ không bao giờ làm việc cho gã này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120502,
					"content": "Còn nói gì mà \"danh dự tập thể\"... Cơm còn không cho người ta ăn, danh dự cái gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120503,
					"content": "Lời của hắn ta không hẳn là vô lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "Thật là những quy định khó hiểu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "Hmm, kỷ luật tuy rất quan trọng... nhưng cũng không đến mức như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120506,
					"content": "Đúng thế! Những người càng thiếu thực tế sẽ càng thích đặt ra những quy định và kỷ luật khó hiểu như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120507,
					"content": "Hửm? Nghĩ kỹ lại, nếu chúng ta cũng gõ nồi thì biết đâu sẽ thu hút được đội trưởng tên Shumilov đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120508,
					"content": "#Không chừng chúng ta sẽ có thể lên trên được... {NICKNAME} mau thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
