					"nextDialogs": [
						751490407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490407,
					"content": "Tuy nhìn rất giống, nhưng không phải Ehecatl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490408,
					"content": "Nhưng mà, Thiên Trục... Vừa rồi Ehecatl có nhắc đến thứ này... Vậy nơi này chính là Thiên Trục cần được khởi động sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490409,
					"content": "Xem ra phải đi tìm hai Tổ Hợp Tinh Tú khác ở quanh đây rồi!",
					"roleType": "TALK_ROLE_NPC",
