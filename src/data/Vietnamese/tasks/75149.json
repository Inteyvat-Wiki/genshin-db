					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490602,
					"content": "Cạch cạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490603
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490603,
					"content": "\"Có vẻ như các vị đã khôi phục lại chức năng của hai Tổ Hợp Tinh Tú kia rồi... Rất nhanh thôi, nồng độ Phlogiston ở đây sẽ tăng đến mức có thể khởi động lại thiết bị liên lạc...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490604
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490604,
					"content": "\"Nhưng trước đó vẫn phải chờ một lúc. Với thân phận loài người thì những gì các vị làm đã là tốt lắm rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490605,
						751490606
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490605,
					"content": "Sao đột nhiên lại nói chuyện được rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490607
					]
				},
				{
					"id": 751490607,
					"content": "\"Không hẳn. Sự tồn tại của Ehecatl đã hoàn toàn biến mất rồi... Chỉ không lâu trước đó thôi. Tuy rằng ở đây tên gọi không có ý nghĩa gì, nhưng tên của cơ thể này là...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490608
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490608,
					"content": "\"'Amaru Tối Cao'... Haiz, đây là cái tên đã để lại cho cơ thể này. Chủ nhân ban đầu của cái tên này là một kẻ ngu xuẩn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490609
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490609,
					"content": "\"Nhưng các vị có thể gọi tôi bằng cái tên Amaru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490610
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490610,
					"content": "Amaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490611,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490612,
					"content": "\"Tên đó tự cao tự đại, nói năng tùy tiện, ngu ngốc và khiến người khác chán ghét... Nhưng trong trận chiến đó, hắn ta đã canh giữ trước Thiên Trục bị phong ấn đến hơi thở cuối cùng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490613
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490613,
					"content": "\"Chính là nơi này, cho nên tôi đã để lại Hầu Cận Rồng mà hắn ta kiểm soát ở đây... Nó sẽ rất sẵn lòng thay mặt chủ nhân của mình để canh giữ Thiên Trục.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490614
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490614,
					"content": "Kiểm tra nồng độ của Phlogiston... Hoàn tất kiểm tra... Cạch cạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490615
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490615,
					"content": "Trục nâng... Thiên Trục, đã khởi động lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490616
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490616,
					"content": "\"Xem ra cũng tương đối rồi, hãy đi vào sâu hơn nữa nào.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751490606,
					"content": "...Ngươi là Ehecatl sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490607
					]
				}
