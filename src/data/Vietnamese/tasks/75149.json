			"dialogs": [
				{
					"id": 751490902,
					"content": "Hỡi người được rồng chọn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490903,
					"content": "Xuyên qua thành phố vĩnh hằng, bước đến Trái Tim Của Núi Thánh đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490904,
					"content": "Tiêu diệt... kẻ địch bóng tối, thắp sáng... tro bụi sắp lụi tàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490905,
					"content": "Khụ khụ... Sao, sao rồi? Mọi người có sao không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490906,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490907
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490907,
					"content": "Sao thế, chóng mặt à? Dù sao thì cũng rơi từ nơi cao như vậy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490908,
					"content": "Không bị thương ở đâu đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490909,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490910
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490910,
					"content": "#Ừm, xem ra không bị thương. {NICKNAME} thì sao? Vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490911,
						751490913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490911,
					"content": "Trông thì vẫn còn nguyên vẹn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490912
					]
				},
				{
					"id": 751490912,
					"content": "Cái gì mà vẫn còn nguyên vẹn chứ? Không bị thương là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490915,
					"content": "Hmm... Không ngờ ở dưới miệng núi lửa thật sự có không gian lớn như vậy. Nhưng xung quanh sao tối đen như mực vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490916,
						751490918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490916,
					"content": "Phát sáng lên nào, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490917
					]
				},
				{
					"id": 751490917,
					"content": "Được rồi, để tôi thử cố gắng xem... Phát sáng được mới lạ đó! Ở nơi như này thì tôi chỉ có phát bực thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490920,
					"content": "Hãy thăm dò xung quanh trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490921,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490918,
					"content": "Đưa tôi đuốc nào, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490919
					]
				},
				{
					"id": 751490919,
					"content": "Cho dù nói với giọng điệu như thế thì tôi cũng không thể lấy ra thứ vốn không tồn tại đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490913,
					"content": "Bị dọa tới mức hồn lìa khỏi xác luôn rồi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490914
					]
				},
				{
					"id": 751490914,
					"content": "Được rồi! Có tinh thần để đùa thì xem ra vẫn rất khỏe mạnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490915
					],
					"speakerTitle": "Paimon"
				}
			]
		},
