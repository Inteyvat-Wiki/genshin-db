				},
				{
					"id": 751491104,
					"content": "Chẳng lẽ đó là... Vực Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491105,
					"content": "\"Đúng vậy... Ma vật Vực Sâu đang xâm chiếm Thánh Thành Tollan như một loại bệnh dịch.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491106
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491106,
					"content": "\"Đến mức độ này, nói không chừng chỉ có thể phá hủy cả Núi Thánh Tollan mới có thể ngăn cản được bước chân của chúng...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491107
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491107,
					"content": "Khi phát hiện một con ma vật Vực Sâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491108
					]
				},
				{
					"id": 751491108,
					"content": "\"Thì nói không chừng những kẻ địch đen tối nhơm nhớp kia đã chiếm lĩnh quê hương rồi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491109
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491109,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491110,
					"content": "Hmm, hai người đang nói chuyện gì đáng sợ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491111,
					"content": "Chỉ cần chặt chân là sẽ ngăn chặn được bước tiến của chúng thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491112
					]
				},
				{
					"id": 751491112,
					"content": "Thật sáng suốt, bây giờ chỉ cần tìm ra đôi chân của chúng là được... Hứ! Bộ tưởng tôi sẽ nói như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491113,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491114,
					"content": "\"Haha, thật đáng tiếc, e là đa số ma vật Vực Sâu đều không di chuyển bằng chân.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491115
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491115,
					"content": "\"...Chỉ khi loại bỏ được kẻ địch bóng tối cản đường, thì mọi người mới có thể vượt qua nơi này để đến được Trái Tim Của Núi Thánh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491116
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491116,
					"content": "\"Cho dù đã không thể giúp cho thành phố tan hoang này khôi phục lại như ban đầu, nhưng ít nhất thì cũng không nên để tàn tích của nó bị ma vật đen tối xâm chiếm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491117
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491117,
					"content": "Khoan đã, không phải chúng ta có quả cầu lửa lớn kia sao...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491118
					]
				},
				{
					"id": 751491118,
					"content": "Đúng vậy. Nó không phải là thứ dùng để chống lại Vực Sâu à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491119,
					"content": "\"Quả cầu lửa lớn... Ý là Tổ Hợp Tinh Tú sao? Chúng chỉ có thể gây ra sự hủy diệt lẫn nhau khi tiếp xúc với Vực Sâu, còn nếu không thì sẽ bị Vực Sâu vây quanh ăn mòn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491120
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491120,
					"content": "\"Chỉ tiếc là thành phố này đã bị phong tỏa quá lâu... Và để duy trì sự ổn định này thì không được tùy ý dịch chuyển Tổ Hợp Tinh Tú...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491121
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491121,
					"content": "\"Hỡi người được rồng chọn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491122
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491122,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491123,
					"content": "\"Trái Tim Của Núi Thánh là khu vực được khai quật lại sau khi Tollan thành lập... Được canh giữ bởi một bức tượng rồng cổ xưa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491124
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491124,
					"content": "\"Muốn vào Trái Tim Của Núi Thánh thì phải có được giấy phép...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491125
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491125,
					"content": "\"Chỉ có điều, nguồn năng lượng của bức tượng rồng kia cũng bị ăn mòn. Chúng ta phải nghĩ cách để khởi động lại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491126
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491126,
					"content": "\"Chúng...\" Cảnh báo, chức năng bị tổn hại, sắp tắt nguồn... \"A, xem ra cỗ máy này...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491127
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491127,
					"content": "Ối, Amaru!? Giấy phép gì đó là sao? Chậc, chưa nói gì hết mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491128,
					"content": "\"Heh... Hãy đi tiếp đi. Ở đó sẽ có một Hầu Cận Rồng mới chỉ đường thôi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491129
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491129,
					"content": "Cạch cạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491130
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491130,
					"content": "\"Đây là bản đồ trung tâm Thánh Thành. Tôi sẽ chờ ở...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491131
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491131,
					"content": "Á, ánh sáng trên người lại biến mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491132,
					"content": "Vậy là thứ tên \"Amaru\" này chắc cũng không thể nói chuyện nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491134
					],
					"speakerTitle": "Hầu Cận Rồng"
				},
				{
					"id": 751491134,
					"content": "Thật là tùy hứng mà. Hết cách rồi, chúng ta đi tiếp để tìm Hầu Cận Rồng mới vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}