						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490301,
					"content": "\"Tôi đã chính thức giới thiệu tên của nó chưa nhỉ? Hình như là chưa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490302
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490302,
					"content": "\"Nhưng không sao. Chào mừng đến với Thánh Thà{RUBY#[D]Vùng Đất Lửa Nguồn}nh Tollan đầu tiên. \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490303
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490303,
					"content": "Woa... Không ngờ bên trong núi lửa lại như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490304,
					"content": "Đây là bên trong núi lửa thật sao? Chắc không phải khi chúng ta vượt qua miệng núi lửa thì bị người ta lén đưa tới chỗ khác đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490305,
					"content": "Rrah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490306,
					"content": "\"Đây chắc chắn là bên trong Núi Thánh. Nhưng dù là tôi... thì cũng không biết lần cuối nhìn thấy cảnh tượng này là khi nào nữa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490307
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490307,
					"content": "\"Ah... Khi ánh sáng chiếu rọi ngươi một lần nữa, thì mới nhận ra rằng ngươi đã mục nát đến vậy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490308
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490308,
					"content": "Ehecatl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490310
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490310,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490311,
					"content": "\"Ồ, xin lỗi. Tôi chỉ đang chìm vào những cảm xúc không cần thiết thôi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490312
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490312,
					"content": "Năng lượng dự trữ thấp... Sắp ngủ đông, hãy nhanh chóng thay thế hoặc liên kết... năng lượng dự trữ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490313
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490313,
					"content": "\"Haha, xem ra Ehecatl bị lưu đày bên ngoài trong thời gian dài đã không thể chống đỡ được lâu hơn nữa rồi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490314
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490314,
					"content": "Á, lẽ nào, Ehecatl sắp, sắp chết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490315,
					"content": "\"Ehecatl, người sở hữu cái tên này đã sớm không còn nữa... Nói ngắn gọn thì muốn khởi động lại Tollan có lẽ sẽ phải tiêu hao rất nhiều năng lượng, không thể lãng phí được. Các vị cần...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490316
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490316,
					"content": "\"Hai 'Tổ Hợp {RUBY#[D]Tzitzimimeh}Tinh Tú' còn lại... Phá hủy phong ấn của một trong số đó... và cái còn lại\"... \"Mới có thể thật sự khởi động lại Thiên Trục ở khu vực trung tâm\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490317
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490317,
					"content": "\"Uhhh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490318
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490318,
					"content": "Vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490319
					]
				},
				{
					"id": 751490319,
					"content": "\"Không sao, chúng ta sẽ... còn gặp lại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490320
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490320,
					"content": "\"Haiz... Hãy tiến về phía trước đi, người được rồng chọn... Nỗi đau khi cơ thể mất đi sự sống, dù là bao nhiêu năm trôi qua vẫn... không thể nào thích ứng được...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490321
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490321,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490322
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490323
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490323,
					"content": "Ánh sáng quanh người nó biến mất rồi... Ehecatl cũng không động đậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490324,
					"content": "Tôi vẫn không hiểu lắm, người nói chuyện đó rốt cuộc là Ehecatl hay là một người khác vậy...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490325,
						751490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490325,
					"content": "Sau này chắc sẽ biết thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				},
				{
					"id": 751490327,
					"content": "Nhưng lúc nãy Ehecatl nói gì ấy nhỉ. Tổ Hợp Tinh Tú, chẳng lẽ là quả cầu lửa khổng lồ lúc nãy ư? Còn Thiên Trục thì sao? Không biết đó rốt cuộc là gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490328,
					"content": "Chúng ta cứ dạo quanh rồi thử tìm những thứ kỳ lạ mà Ehecatl nói đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490329,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490326,
					"content": "Bây giờ cứ tiếp tục đi về phía trước đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				}
			]
		},
