			"dialogs": [
				{
					"id": 751491001,
					"content": "#Hmm? {REALNAME[ID(2)|SHOWHOST(true)]} sao vậy? Phát hiện ra thứ gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491002,
					"content": "Whrooawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491003
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491003,
					"content": "A, đây chẳng phải bức tượng trước đây bị Qucusaur lấy mất sao. Không ngờ nó cũng rơi xuống đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491004,
					"content": "#Trông giống như... {REALNAME[ID(2)|SHOWHOST(true)]} tai to đang cuộn tròn lại nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491005,
					"content": "Rrrawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491006
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491006,
					"content": "Hửm? Nhóc thấy không giống à? Tôi thì thấy cũng hơi giống đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491007,
					"content": "Á... Nó chuyển động kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491008,
					"content": "Cạch... Cạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491009
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491009,
					"content": "Đang tự kiểm tra... bên ngoài khớp có chút bụi tích tụ... Kích hoạt trung gian lưu trữ, ngôn ngữ... trích xuất từ xa... cho phép can thiệp... Cạch cạch... Sửa chữa mục tính cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491010
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491010,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491011
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491011,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491012
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491012,
					"content": "Thì ra không phải tượng, mà là cơ quan gì đó à... Nhìn kỹ thì đúng là có hơi giống với Thiết Bị Nguồn. Trên người nó tỏa ra ánh sáng kỳ lạ, cứ cảm thấy hình như đã thấy ở đâu đó rồi thì phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491013,
					"content": "Ấy, sao nó không cử động nữa vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491014,
					"content": "\"Ốiii!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491015
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491015,
					"content": "Ốiiii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491016,
					"content": "\"Mô đun phát âm thanh xem ra không có vấn đề. Được rồi, các vị khách quý, tôi đã ở đây chờ các vị từ lâu rồi... Sao thế?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491017
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491017,
					"content": "Sao đột nhiên lại phát ra âm thanh lớn như vậy thế? Làm hết hồn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491018,
					"content": "\"Vậy thì tốt quá rồi, xuất hiện như thế mới để lại ấn tượng chứ. Tôi còn lo là các vị sẽ cảm thấy mình bị đối xử lạnh nhạt nữa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491019
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491019,
					"content": "Nhưng ngươi là ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491020,
					"content": "\"Hỏi tôi là ai à? Ừm, cơ thể này tên là Ehecatl, có thể gọi tôi như vậy, nhưng ở nơi đây thì tên gọi có ý nghĩa gì chứ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491021
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491021,
					"content": "Theo như trong ghi chép thì... yêu cầu thay đổi tên gọi nhận biết cá thể được thực hiện vào... 150 năm sau trận chiến đó... Tên được đổi thành Ehecatl trong danh sách tử trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491022
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491022,
					"content": "\"Đúng vậy. Từ đó trở đi, cơ thể này được gọi là Ehecatl...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491023
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491023,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491024
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491024,
					"content": "\"Đúng vậy, là tôi đây. Tôi chính là người đã gọi các vị đến. Hãy đến Trái Tim Của Núi Thánh... trước khi mọi thứ quá muộn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491025
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491025,
					"content": "\"Nhưng không cần phải vội, hãy để Ehecatl giúp xóa tan một chút bóng tối phía trước... Tôi biết trong lòng các vị còn nghi ngờ, nhưng hãy đi theo tôi trước đã.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ehecatl"
				}
			]
		},
