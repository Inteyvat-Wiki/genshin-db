			"dialogs": [
				{
					"id": 4540301,
					"content": "Chúng tôi quay lại rồi! Bạn xem nhiêu đây đủ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540302,
					"content": "Đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540303,
					"content": "Lúc nãy nói chuyện với bạn ấy một lúc. Quy tắc trong thế giới của sói, thật không tưởng tượng nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540304,
					"content": "Cám ơn các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540305,
					"content": "Đi hết một vòng cũng không tìm thấy con sói nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4540307,
					"content": "Sói thường là vậy. Con sói vừa bắt được chắc hẳn trí khôn có chút vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540308,
					"content": "Làm, làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4540309,
					"content": "Tính sổ với ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540310,
					"content": "Chính là hắn, người được sói nuôi lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540311,
					"content": "Hừ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4540312,
					"content": "Hóa ra là ngươi. Ta còn nghĩ làm sao sói thông minh như vậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4540313,
					"content": "Là ngươi giúp đám súc sinh đó tính kế à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4540314,
					"content": "Ai cho ăn thì đó là bố mẹ à, ngươi quên ngươi là thứ gì rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4540315,
					"content": "Đủ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540316,
					"content": "Các ngươi bắt nạt Razor không giỏi nói chuyện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540317,
					"content": "Hử! Đội Kỵ Sĩ muốn bảo vệ người này à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540318,
					"content": "Không phải chúng tôi, tập kích thôn làng...",
