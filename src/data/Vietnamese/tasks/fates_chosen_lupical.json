						4540603
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540603,
					"content": "Giống như trước đây, tên nhóc này nói. Bầy sói từ ngoài đến phá hoại quy tắc ở đây. Chúng nó sẽ bị xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540604
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540604,
					"content": "Nhưng ngươi - Razor, ngươi không được tham gia thảo phạt. Bởi vì đây là chuyện của sói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540605
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540605,
					"content": "Ngươi dùng gang thép chứ không phải móng vuốt, khống chế lôi điện chứ không phải răng nanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540606
					],
					"speakerTitle": "Boreas"
				},
				{
