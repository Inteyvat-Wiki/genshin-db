					"nextDialogs": [
						4540615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540615,
					"content": "Hiện giờ người ở bên ngoài cũng rất nguy hiểm với bạn. Tôi biết bạn không muốn làm hại bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540616,
					"content": "Tôi không sao, các bạn, yên tâm. Nhưng tôi không thuộc về thành phố...",
