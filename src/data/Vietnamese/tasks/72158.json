			"dialogs": [
				{
					"id": 721580101,
					"content": "Sấm sét...dừng lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580102,
					"content": "Xem ra 4 Trấn Thạch đều đã phong ấn xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580103,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "Bạn, bạn về rồi sao! Vừa nãy bạn lên đó như thế nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580105,
					"content": "Taisuke nói bạn đã đi xuyên qua một thứ trông như cánh cửa và rồi biến mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580106,
					"content": "Cánh cửa đó rốt cuộc là gì thế? Kỳ lạ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580107,
					"content": "Nhưng rốt cuộc trên đó đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580108,
					"content": "Tôi và Etsuko dưới đây nghe thấy trên đó có tiếng động rất lớn, nghe như tiếng sấm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580109,
					"content": "Nhưng rõ ràng là đã hết bão rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580110,
					"content": "Là thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "Tảng đá bay trong không trung rồi ghép thành một bệ đài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580112,
					"content": "Mới nghe lần đầu đấy, tôi chưa từng biết Đảo Seirai có hiện tượng tự nhiên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580113,
					"content": "Chuyện này sao có thể là...hiện tượng tự nhiên được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580114,
					"content": "Cho dù nghĩ thế nào cũng là một loại...hừm, hiện tượng...phi tự nhiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580115,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "Nhưng cho dù là hiện tượng gì đi nữa thì Đảo Seirai cũng đã hết bão sét rồi, nhiệm vụ mà hiệp hội ủy thác cho chúng ta cũng đã hoàn thành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580118,
					"content": "Về chiếc lông kỳ lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "Chiếc lông này...Taisuke, bạn đến xem thử chiếc lông này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580120,
					"content": "Để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580121,
					"content": "Xin lỗi, tôi không phân biệt được nguồn gốc của chiếc lông này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580122,
					"content": "Kết cấu và cảm giác của chiếc lông này không giống với những loài chim mà tôi biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580123,
					"content": "Hơn nữa bạn xem kích thước của nó này, nếu tính theo tỷ lệ, thì con chim này có vẻ phải to bằng bệ đá ở trên trời kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580124,
					"content": "Chiếc lông này quan trọng lắm sao? Nếu bạn muốn biết rõ nguồn gốc, chi bằng đến Hiệp Hội Nhà Mạo Hiểm treo ủy thác đi, không chừng có thể tìm được chút manh mối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580125,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "Ừm, cám ơn bạn lần nữa vì đã giúp nhé! Tôi và Taisuke về hiệp hội báo cáo đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580128,
					"content": "Đúng rồi, những thứ này cho bạn, cứ xem như là phần thưởng đi. Tuy không nhiều...nhưng không thể để bạn giúp không công được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580129,
					"content": "Taisuke, chuẩn bị đi, chúng ta phải về hiệp hội đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580130,
					"content": "À, Etsuko này...hay là chúng ta đến đền thần trước, gặp Neko đại nhân đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580131,
					"content": "Thiệt tình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580132,
					"content": "Là một con mèo biết nói đó! Mèo biết nói đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580133,
					"content": "Cái tên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580126,
					"content": "Để tôi suy nghĩ thêm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "Bạn nói đúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}