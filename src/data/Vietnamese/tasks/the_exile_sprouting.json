				"points": []
			},
			"dialogs": [
				{
					"id": 731930901,
					"content": "Bạn có thể sử dụng sức mạnh của Nguyên Tố Thảo sao? Không lẽ tôi đã gặp được người có Vision rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930902,
					"content": "Đã lâu chưa gặp người như vậy rồi, thật hoài niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930903,
					"content": "Sabbah, Sabbah, như vậy là được rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930904,
					"content": "Không sai, nếu trực tiếp sử dụng Nguyên Tố Thảo, có lẽ chúng sẽ sớm nảy mầm, chúng ta cứ đợi xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930905,
					"content": "Vài chồi non yếu ớt từ từ trồi lên từ bùn đất.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "Sau khi mọc vài phiến lá xanh, chồi non không sinh trưởng nữa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#Nảy mầm rồi nảy mầm rồi, tôi đã nói mà, {NICKNAME} có gì mà không làm được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930908,
					"content": "Quả nhiên có hiệu quả ngay lập tức, cảm ơn các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930909,
					"content": "Tiếc là không nở hoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "À, đây là điều bình thường mà, không thể gấp gáp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930911,
					"content": "Thực vật đều phải trải qua các thời kỳ sinh trưởng như nảy mầm, ra lá, đơm hoa, kết trái, bạn có thể khiến hạt giống nảy mầm nhanh vậy đã là rất lợi hại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930912,
					"content": "Hãy cho tường vi thêm thời gian hấp thu dưỡng chất để nở hoa, như vậy sẽ tốt cho chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930913,
					"content": "Tôi rất cảm ơn về những điều bạn đã làm hôm nay, nếu còn làm phiền hai bạn thì thật không phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930914,
					"content": "Sau này có thời gian rảnh rỗi, các bạn ghé qua xem chúng cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
