				},
				{
					"id": 413590302,
					"content": "Cái này cũng không thể làm khó được bạn ư... Bạn quả nhiên là nhà mạo hiểm rất cừ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590303
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590303,
					"content": "Mau đi xem thử bình phong đi, manh mối rương báu đều ẩn bên trong đó rồi.",
					"roleType": "TALK_ROLE_NPC",
