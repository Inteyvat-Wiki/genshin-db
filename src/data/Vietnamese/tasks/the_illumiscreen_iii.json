				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "Sao rồi, hành trình tìm kho báu thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590202,
					"content": "Đã tìm được tất cả kho báu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "Bạn đã giải hết rồi sao... đúng là lợi hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590204,
					"content": "Đối với nhà mạo hiểm có thực lực cao như bạn, hiệp hội chúng tôi đã đặc biệt chuẩn bị một phần quà lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590205,
					"content": "Nhìn thấy những rương báu đối diện không? Mở ra đi, thứ bên trong đều là của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590206,
					"content": "Sau khi tôi lấy thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "Thì người phía sau sẽ không lấy được nữa, thám hiểm chính là vậy, chiến lợi phẩm luôn dành cho kẻ nhanh nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590208,
					"content": "Được rồi, chúc bạn ngày lễ vui vẻ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
