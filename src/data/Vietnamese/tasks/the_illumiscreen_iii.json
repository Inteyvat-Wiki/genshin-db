			"dialogs": [
				{
					"id": 413590101,
					"content": "Hoan nghênh đến tham gia \"Linh Lung Tiêu Đăng Đồ\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590102,
					"content": "Lần này cũng chuẩn bị tranh khác à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "Đương nhiên rồi, dù sao cũng bị bạn liên tiếp giải được hai lần, lần này tôi sẽ đổi sang mấy chiếc đèn có độ khó cao nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590104,
					"content": "Nhưng, tranh đương nhiên vẫn được ghép hoàn chỉnh từ ba hình khác nhau, khó khăn vẫn nằm ở việc <color=#00E1FFFF>\"liền trục\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590105,
					"content": "Hi hi, bạn tự cảm nhận một chút nhé, tranh lần này là <color=#00E1FFFF>\"Hạc Tiên\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590106,
					"content": "Sau khi ghép xong hình thì bạn có thể đi tìm kho báu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
