			"dialogs": [
				{
					"id": 721290401,
					"content": "Khá lắm! Mây đã tan rất nhiều rồi, xem ra tôi đoán không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Tiếp theo ở Đầu Thần Rắn và Hầm Mỏ Jakotsu còn có hai vật trấn giữ cần sửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "Nếu bạn không bận tâm, hai vật trấn giữ đó cũng phiền bạn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "Rất cảm ơn bạn đã giúp, mặc dù tôi cũng không phải người có tiền gì, nhưng tôi đảm bảo sẽ không để bạn thiệt thòi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "Mặc dù không biết đến khi nào mới có hy vọng, nhưng ngày người thân bạn bè trở về cũng đã ngày một gần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "Nhân tiện khi xong việc, hãy đến phía tây hòn đảo tìm tôi, Đồn Mumei cũng từng bị phản quân xâm phạm, chắc cũng không tránh khỏi lần dị biến này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
