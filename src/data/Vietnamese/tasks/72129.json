			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "Chiếc đèn đá có hình dạng đặc biệt, dường như tản ra năng lượng khiến người khác bất an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721290102,
					"content": "Chiếc đèn lồng đá này thật kỳ lạ...khiến người khác cảm thấy không thoải mái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "Í, hình như trên cột đèn có chữ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "\"Người qua đường, nếu có thắc mắc gì về vật trấn giữ này, hãy đến Hẻm Núi Musoujin nói chuyện với ngài Kaji.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721290105,
					"content": "Chữ có vẻ rất mới, hình như mới viết không lâu. Bên dưới còn có mấy hàng chữ nhỏ bị nước mưa làm nhòe:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721290106,
					"content": "\"...Hãy gửi lời đến ngài Kaji, chúng tôi đã thử...nhưng rất tiếc...có lẽ ở gần đây có thể tìm được...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721290107,
					"content": "\"...Ngài Kaji hãy mau đến nơi tị nạn, người nhà anh ấy đang rất nhớ anh ấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721290108,
					"content": "Ngài Kaji dường như có vẻ rất quan tâm đến đèn lồng đá, chi bằng chúng ta đến Hẻm Núi Musoujin hỏi anh ta đi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
