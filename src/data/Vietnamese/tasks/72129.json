				"points": []
			},
			"dialogs": [
				{
					"id": 721290201,
					"content": "Bạn chăm chú nhìn vào vật trấn giữ, đột nhiên, một luồng năng lượng kỳ lạ dường như lao đến bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Chạm vào Vật Trấn Giữ"
				},
				{
					"id": 721290202,
					"content": "Bạn nhận thấy nó không phải chống lại bạn, mà nó đang yêu cầu bạn một cái gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Chạm vào Vật Trấn Giữ"
				},
				{
					"id": 721290203,
					"content": "Ừm...vật trấn giữ này hình như bị thiếu gì đó, chúng ta thử tìm xung quanh xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Dùng Góc Nhìn Nguyên Tố điều tra dấu vết nguyên tố xung quanh, nói không chừng sẽ phát hiện được gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
