			"dialogs": [
				{
					"id": 721290601,
					"content": "Thế nào? Nhanh như vậy đã sửa xong rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290602,
						721290603
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290602,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "Ừm ừm, không sao, cứ sửa từ từ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290603,
					"content": "Vẫn đang cố gắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "Nếu không được cũng không cần cố gắng, đừng ở lại nơi nguy hiểm này quá lâu.",
					"roleType": "TALK_ROLE_NPC",
