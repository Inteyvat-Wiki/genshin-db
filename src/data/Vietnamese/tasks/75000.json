			"dialogs": [
				{
					"id": 750000101,
					"content": "Này, này, nhóc to xác... Vẫn ổn chứ? Có đứng dậy được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000102,
					"content": "Trông nó có vẻ rất yếu ớt. Đúng thật là, rốt cuộc đã xảy ra chuyện gì vậy... Đám chó u linh bay lượn đó thật đáng ghét... Quả nhiên mấy kẻ bay lượn không có ai là tốt lành cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000103,
					"content": "Bản thân Paimon không phải cũng đang bay sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "Tôi với mấy kẻ đó sao mà giống nhau được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000105,
					"content": "#Không nói chuyện này nữa. Nhanh nào {NICKNAME}, chúng ta xem thử xem có gì cho nhóc to xác này ăn không... Sau đó để nó nghỉ ngơi một lát vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000106,
					"content": "Như vậy thì chắc nó sẽ tỉnh táo lại đôi chút đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000107,
					"content": "Đã quá trễ rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "Sao lại như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000110,
					"content": "...Guuừ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "Nhóc To Xác?"
				},
				{
					"id": 750000111,
					"content": "#Ôi, chắc nó đang rất khó chịu đấy, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000112,
					"content": "Tôi đã tiêu diệt kẻ địch rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "...Guuừ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "Nhóc To Xác?"
				},
				{
					"id": 750000115,
					"content": "Còn có... tâm nguyện gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "Muốn nói điều gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "Đưa... đưa tay ra, người... người được rồng chọn... Hãy đưa tay ra...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "Liên kết... sức mạnh, sau đó, đi chứng kiến tất cả, từ đó, giải phóng tất cả...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#{NICKNAME}, sao vậy? Mau làm gì đó đi! Bây giờ không phải là lúc ngây người đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000120,
					"content": "Không có gì, vừa nãy tôi chỉ nhất thời hoa mắt thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000121
					]
				},
				{
					"id": 750000121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000122
					],
					"speakerTitle": "Nhóc To Xác?"
				},
				{
					"id": 750000122,
					"content": "G-Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000123
					],
					"speakerTitle": "Nhóc To Xác?"
				},
				{
					"id": 750000123,
					"content": "Đây là nguyện vọng của ngươi sao...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000124
					]
				},
				{
					"id": 750000124,
					"content": "(Đưa tay về phía con thú sắp chết...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000125
					]
				},
				{
					"id": 750000125,
					"content": "#{NICKNAME} đang làm gì vậy... Ối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000126,
					"content": "#{NICKNAME}...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000113,
					"content": "Hãy nghỉ ngơi một lát nhé, nhóc to xác lợi hại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000108,
					"content": "Nó đã kiên trì rất lâu rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				}
