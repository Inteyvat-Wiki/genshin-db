					"nextDialogs": [
						750000903
					]
				},
				{
					"id": 750000903,
					"content": "...Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#Xem ra nó rất thích cái tên này đó... Hihi, hy vọng sau khi đến Natlan sẽ có thể giải được bí ẩn trên người nhóc... Đúng rồi, còn có việc {NICKNAME} đột nhiên có thể chui vào trong cơ thể của rồng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "#Lúc nãy quên hỏi, khi nãy {NICKNAME} đột nhiên biến thành rồng... Không xảy ra chuyện gì chứ? Có cảm thấy khó chịu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "Đầu rồng của tôi có hơi đau nhức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "Đầu rồng gì chứ!? Giờ còn có thời gian nói đùa sao, lần sau tôi không thèm quan tâm nữa đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Nhưng mà {NICKNAME}, trước đây tôi chưa từng nghe nói ở Natlan có người có thể hóa thành rồng đó... Cảm giác hơi kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "Thật là, vừa mới tới Natlan mà đã xảy ra nhiều chuyện như vậy rồi... Thôi được, vấn đề tiếp theo là, chúng ta phải ra ngoài bằng cách nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "Hửm? Nhóc biết chỗ để ra ngoài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
