				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Satoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Chào chú Satoru, gần đây chú thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120402,
					"content": "Chú vẫn như trước đây thôi, không thay đổi gì. Xem ra cháu vẫn hoạt bát như xưa nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120403,
					"content": "Cũng nhờ có mọi người ủng hộ nên công việc làm ăn của gia đình cháu mới càng ngày càng tốt thôi ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120404,
					"content": "Đợt pháo hoa lần trước giao cho Liyue nhận được nhiều phản hồi tốt lắm, xem ra sau này sẽ còn nhiều đơn hàng hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120405,
					"content": "Vậy thì cháu sẽ càng vất vả hơn rồi, một mình cháu và Ryuunosuke có làm xuể không đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120406,
					"content": "Nếu như cần giúp đỡ thì cứ gọi chú nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120407,
					"content": "Không thành vấn đề, chuyện pháo hoa cháu có thể tự mình lo liệu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120408,
					"content": "Đúng rồi, ở đây có chút Củ Cải Mặn mà bà Kaori nhờ cháu giao đến ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120409,
					"content": "Ấy da, thật cảm ơn nha, chú trước đây ăn không quen củ cải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120410,
					"content": "Nhưng sau khi thử tay nghề của bà ấy thì ghiền luôn, giờ ăn đến thành thói quen luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120411,
					"content": "Gia đình chú vẫn khỏe chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120412,
					"content": "Cũng khỏe, nhưng đôi lúc cũng có cãi vã chút, nhưng gia đình là thế mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120413,
					"content": "Chú cảm thấy, có người thân bên cạnh, dù cho có mâu thuẫn chút cũng tốt hơn là cứ xa cách nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120414,
					"content": "Tuy tình cảm của cô chú đó rất tốt, nhưng đứa con của họ thì luôn xa nhà, nên tính ra họ cũng rất cô đơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120415,
					"content": "Nhưng không đâu. có lẽ họ đã quen với cuộc sống như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120416,
					"content": "Nhưng mà lời chú nói cũng đúng, vậy sau này cháu phải thường xuyên đến đây hơn, ít nhất có người nói chuyện thì sẽ không cảm thấy nhàm chán đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120417,
					"content": "Tốt quá, làng Konda này luôn mong chờ sự hiện diện của cháu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120418,
					"content": "Hì hì, cảm ơn mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "Đúng là tuổi trẻ, làm việc nhanh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120502,
					"content": "Tuổi trẻ năng lượng dồi dào, còn người già có nhiều kinh nghiệm, ai cũng có mặt ưu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120503,
					"content": "Nói ra thì năm nay vừa tròn 50 năm rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120504,
					"content": "Đúng vậy, mỗi năm mỗi năm trôi qua thì không cảm thấy có gì khác, nhưng giờ quay đầu nhìn lại thì đã 50 năm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120505,
					"content": "50 năm? Có ngày gì quan trọng hẻ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120506,
					"content": "Ha ha, 50 năm trước là ngày vợ ông theo đuổi ông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120507,
					"content": "Này, không được nói tào lao trước mặt người ta, rõ ràng là ông cứ bám theo tôi trước mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120508,
					"content": "Đó là chuyện trước đó rồi, không tính. Nói chung, vào ngày Hội Pháo Hoa Naganohara năm đó, ông đã cầu hôn với bà ấy, sau đó sống chung đến giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120509,
					"content": "Đúng là hạnh phúc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "Thực ra ông vốn dĩ không có quyết tâm như vậy, nên đi ngắm pháo hoa với tâm trạng do dự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120512,
					"content": "Khi pháo hoa được bắn lên trời cao, ông vẫn chưa dám mở lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120513,
					"content": "Sau đó những tiếng pháo vang trời nổ ra, bầu trời lấp lánh ánh sáng, gương mặt nghiêng và đôi mắt của bà ấy cũng lấp lánh như pháo hoa vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120514,
					"content": "Sau đó cũng không biết khi nào, ông đã bất chợt mở lời, và bà ấy cũng đã đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120515,
					"content": "50 năm nói dài không dài nói ngắn không ngắn, cũng không phải là chuyện gì to lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120516,
					"content": "Nhưng cùng nhau đi qua quãng đường này, cũng rất đáng để kỷ niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120517,
					"content": "Cháu không biết là có ngày đặc biệt như vậy, nếu biết sớm thì cháu đã làm phần pháo hoa phiên bản đặc biệt cho hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120518,
					"content": "Không sao không sao, chỉ là sở thích của người già thôi mà, mỗi lần có hội pháo hoa là đều đi xem nên thành thói quen rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120519,
					"content": "Chỉ cần nhìn thấy pháo hoa thì sẽ lại nhớ lại khoảng thời gian đó. Như vậy thì cuộc sống mới không có gì phải hối tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120520,
					"content": "Tình cảm của hai ông bà tốt thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120521,
					"content": "À, khoan nói chuyện này đã. Yoimiya, không phải cháu đang bận việc của lễ hội pháo hoa sao, đến chỗ ông bà có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120522,
					"content": "À, thực ra có một chuyện hơi khó để mở lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120523,
					"content": "Sakujirou, nó...nó về rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120524,
					"content": "Hai vị biết anh ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120525,
					"content": "Nó là bạn thân thuở nhỏ của thằng con nhà ông bà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120526,
					"content": "Chúng chơi với nhau từ nhỏ đến lớn, đi đâu cũng đi cùng nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120527,
					"content": "Nhưng rồi bỗng nhiên có một ngày chúng cãi nhau, còn cãi rất kịch liệt nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120528,
					"content": "Ông nhớ lúc đó Sakujirou muốn đi ra khỏi Inazuma, nó bảo là ở đây quá yên bình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120529,
					"content": "Nhưng mà đứa con Keisuke từ nhỏ đã giống tính ông bà, thích sự nhàn nhã yên bình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120530,
					"content": "Tuổi trẻ mà, chúng vì chuyện này mà tranh cãi với nhau, sau cùng Sakujirou đã tự mình bỏ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120531,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120532,
					"content": "Keisuke tuy không nói gì với ông bà, nhưng có thể nhìn ra rằng nó rất đau lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120533,
					"content": "Sau đó, không biết vì nguyên nhân gì, nó đến làm ở Hiệp Hội Tenryou, từ đó rất ít khi quay về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120534,
					"content": "Đối với những chuyện khác, nếu ông bà nhờ thì nó có thể sẽ giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120535,
					"content": "Nhưng nếu là chuyện liên quan đến Sakujirou thì có thể...ông bà không giúp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120536,
					"content": "Không ngờ lại trùng hợp như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120537,
					"content": "Cháu hiểu rồi, cháu hỏi Sakujirou tại sao lại quay về, anh ta không có nói rõ, chỉ nói là \"lỗi lầm trước đây\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120538,
					"content": "Cuối cùng cháu cũng hiểu tại sao anh ấy không thể quyết đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120539,
					"content": "Rõ ràng là bạn thân thuở nhỏ, giờ đây một bên là người của Hiệp Hội Tenryou, một bên thì lại bị Hiệp Hội Tenryou truy nã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120540,
					"content": "Đúng là số phận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Không sao, nếu là vậy thì cháu không làm phiền hai ông bà nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120543,
					"content": "Chúng cháu sẽ nghĩ cách cho Sakujirou, hai vị cũng đừng lo lắng quá, chuyện này cứ để Sakujirou và Keisuke tự mình giải quyết vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120544,
					"content": "Ừm, chỉ mong mối quan hệ của chúng gắn kết được như xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120545,
					"content": "Nhiều năm như vậy, giờ chúng nó chắc đã nguôi ngoai rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120541,
					"content": "Tôi cũng không ngờ như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "Thật đáng ngưỡng mộ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201206",
							"2"
						],
						"stepId": 1201206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "Không ổn rồi, ban nãy người của Hiệp Hội Tenryou vừa mới đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120602,
					"content": "Tại sao họ lại biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120603,
					"content": "Cha không sao chứ? Họ có làm gì cha không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120604,
					"content": "Cha nói là bên trong căn phòng toàn là pháo hoa, không được tùy tiện đi vào để tránh hỏa hoạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120605,
					"content": "Nhưng họ không nghe, cứ khăng khăng rằng Sakujirou đang trốn trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120606,
					"content": "Nhưng cũng may là Sakujirou đã nghe được động tĩnh nên đã mở cửa sổ bỏ trốn, Hiệp Hội Tenryou không tìm được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120607,
					"content": "Chậc, phiền phức rồi, Sakujirou bây giờ vẫn còn đang do dự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120608,
					"content": "Cha, anh ta chạy theo hướng nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120609,
					"content": "Tôi nghĩ người của Tenryou nhất định sẽ truy đuổi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120610,
					"content": "Bạn có nghe tên của người đó chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "Đúng rồi! Đột nhiên đến bắt người như vậy, rất có khả năng người đó là Keisuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120612,
					"content": "Nếu không thì cũng sẽ không điều động quân lính chỉ vì một kẻ vượt biên như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120613,
					"content": "Tai của cha nghe không rõ, cũng không thấy được, có thể họ đã ra khỏi thành rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120614,
					"content": "Tên thì cha không có nghe thấy, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120615,
					"content": "Tôi hình như có nghe được tên của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120616,
					"content": "Ban nãy tôi có đến chỗ bạn bè để lấy đồ, về đến đây thì có thấy được họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120617,
					"content": "Người dẫn đầu có lẽ đúng như các bạn nói, tên là Keisuke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120618,
					"content": "Quả nhiên là vậy, cảm ơn anh nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120619,
					"content": "Nếu như Sakujirou vẫn chưa hạ quyết tâm thì việc hai người gặp lại không những không được hòa giải, mà lại càng nghiêm trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120620,
					"content": "#Như vậy rất không ổn. {NICKNAME}, đi theo tôi, chúng ta đi nghe ngóng thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
