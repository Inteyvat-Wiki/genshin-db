			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori",
					"Imatani Saburou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "Là Yoimiya sao, mau vào nhà nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120102,
					"content": "Ồ, cháu còn dẫn theo bạn bè đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120103,
					"content": "Dạ, đây là nhà lữ hành đến từ phương xa, giờ đây người bên ngoài muốn đến Inazuma đúng là khó thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120104,
					"content": "Đúng vậy, tình cảnh bây giờ khác biệt, nhưng nếu như đã đến đây rồi thì chúng ta phải chiêu đãi đặc biệt chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120105,
					"content": "À, đúng rồi, pháo hoa của hai vị đặt, cháu đã mang đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120106,
					"content": "Cảm ơn nhé, mỗi năm đều làm phiền gia đình cháu, trước đây là cha cháu, giờ lại đến lượt cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120107,
					"content": "Không biết ông có thọ đến lúc nhìn thấy được người kế nhiệm tiếp theo của \"Tiệm Pháo Hoa Naganohara\" không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120108,
					"content": "Sẽ được thôi, hai vị vẫn còn rất khỏe mạnh mà, đừng nói điềm gở như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120109,
					"content": "Haiz, cơ thể này của ông bà ngày càng già yếu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120110,
					"content": "Trước đây trồng trọt tưới tiêu cái gì cũng làm được, giờ đây chỉ cần đi vài bước là đã đau lưng nhức mỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120111,
					"content": "Hôm qua bà còn định đi nhổ cỏ dại, nhưng vừa khom lưng xuống là suýt nữa không đứng thẳng được luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120112,
					"content": "Chuyện này ông bà cứ nhờ cháu làm là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120113,
					"content": "Ấy, không không không, sao lại làm phiền cháu như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120114,
					"content": "Để ông lấy chút điểm tâm với trà, vừa ăn vừa trò chuyện nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120115,
					"content": "Không sao, cháu cũng thường hay giúp nhà ông dọn dẹp mà. Dạo gần đây do cháu cũng hơi bận công việc quá, sau này cháu sẽ đến thường xuyên hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120116,
					"content": "Đối với chúng cháu thì chỉ là chuyện nhỏ thôi mà, ông đừng khách sáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120117,
					"content": "Các cháu thật hiểu chuyện, chả bù với thằng con nhà bà, cũng già đến nơi rồi mà cứ ở một mình, lại còn thường xuyên không về nhà nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120118,
					"content": "Nếu cháu đã nói vậy rồi thì ở đây có một chút Củ Cải Mặn, cháu giúp bà mang nó cho Satoru nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120119,
					"content": "Được thôi, cháu đi ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120120,
					"content": "Đi theo tôi nhé, hai ông bà lão tay chân không còn linh hoạt nữa, chúng ta phải giúp đỡ họ, đầu tiên là <color=#00E1FFFF>nhổ cỏ</color>, sau đó đi <color=#00E1FFFF>giao Củ Cải Mặn</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
