			"dialogs": [
				{
					"id": 722700101,
					"content": "Ta là Jibashiri - Daimon. Dũng sĩ Sangonomiya, ta thừa nhận ngươi xứng đáng để thực hiện khiêu chiến này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "Dũng võ chính là không từ thủ đoạn tiêu diệt tất cả kẻ địch. Chỉ cần tiêu diệt tất cả kẻ địch, giải phóng \"Ngọn Lửa Cửa Cao\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "Một điều cần phải biết, chính là tất cả những kẻ thù này đều là ảo ảnh, được sinh ra từ Pháp Thuật Mặt Trời và những kẻ thù lớn trong thâm tâm của ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "Cho dù là vậy, chúng vẫn có thể đả thương những kẻ yếu đuối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "Ta sẽ đứng ở Tháp Tam Giới đợi ngươi hoàn thành khiêu chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
