				},
				{
					"id": 150295102,
					"content": "Không biết chỉ thị tiếp theo phải chờ bao lâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295103
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150295103,
					"content": "Kể ra thì hôm qua có người báo cáo Trưởng Lão Tlapo đột nhiên mất tích một thời gian, có ai biết xảy ra chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
