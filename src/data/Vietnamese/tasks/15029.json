			},
			"dialogs": [
				{
					"id": 150290401,
					"content": "Đã làm xong rồi sao? Xem ra lần này thực sự thu được những manh mối hữu ích khi điều tra về Thất Sắc Chiến rồi. Hy vọng các vị có thể chỉ giáo thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290402
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290402,
					"content": "Cuộn vải lần này đã làm xong rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290403
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150290403,
					"content": "Người được Trưởng Lão Tlapo chọn đúng là không thể sai được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290404
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150290404,
					"content": "#Ừm... Hãy nghe thật kỹ lời {NICKNAME} nói nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290405,
					"content": "Bạn đã kể chi tiết cho Biram mọi chuyện về màu sắc đó, nhưng lại cẩn thận che giấu phần của Citlali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290406
					]
				},
				{
					"id": 150290406,
					"content": "Thì ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290407
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290407,
					"content": "Trông anh không hề ngạc nhiên chút nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290408,
					"content": "Thực ra cũng không khó để suy luận. Lịch sử là ký ức của một dân tộc, cũng chỉ có những màu sắc bắt nguồn từ ký ức mới có thể khắc họa nên lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290409
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290409,
					"content": "Tiếp theo là tìm cách truyền lại bí thuật này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290410
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290410,
					"content": "#Dựa theo mô tả của {NICKNAME}, có vẻ như nếu muốn truyền lại bí thuật này thì cần phải tích cực chia sẻ ký ức của mình nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290411
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290411,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290412,
					"content": "#Vậy thì tôi chỉ có thể tìm cách sắp xếp cho các tư tế nghiên cứu lại bí thuật này dựa trên nguyên tắc được {NICKNAME} mô tả thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290413
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290413,
					"content": "#Suy cho cùng, những ký ức quý giá như thế, hầu hết mọi người sẽ chỉ chia sẻ với những người mà họ yêu quý nhất. Tôi không thể đưa ra quyết định này thay {F#cô}{M#cậu} được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290414
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290414,
					"content": "#{F#Cô}{M#Cậu} đã hoàn thành sứ mệnh này rất xuất sắc, còn nhiệm vụ kế thừa thì hãy để Chủ Nhân Gió Đêm tự hoàn thành nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290415
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290415,
					"content": "...Ừm, nghe theo thủ lĩnh sắp xếp vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290416,
					"content": "Còn nữa, nếu hai vị có gặp Bà Itztli thì hãy cảm ơn bà ấy giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290417
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290417,
					"content": "Chúng tôi đã thẩm vấn thương nhân Fontaine mà bà ấy bắt giữ rồi. Tôi phát hiện ra những người gần đây đặt câu hỏi về tính chân thực của Thất Sắc Chiến thật ra là đã bị hắn ta xúi giục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290418
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290418,
					"content": "Hắn ta đã thuê người tung tin đồn trong dân chúng, tạo ra những tranh cãi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290419
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290419,
					"content": "Chúng tôi đã ghi lại tất cả tội trạng của hắn ta rồi, và sẽ đàm phán với Fontaine bằng các biện pháp ngoại giao trong thời gian tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290420
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290420,
					"content": "Đúng vậy. Nếu không có tranh cãi này thì hắn ta cũng chẳng có khả năng lợi dụng sơ hở để mò đến điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290421,
					"content": "Tôi nói rồi mà, làm gì có ai lại nghi ngờ sự tích anh hùng của dân tộc mình cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290422,
					"content": "Vậy, chúng ta tạm biệt ở đây nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290423
					]
				},
				{
					"id": 150290423,
					"content": "Hẹn gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
