							11.813
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "#{F#Cô}{M#Cậu} vốn dĩ không cần phải làm ra loại vải đó, nhưng để kế thừa loại bí thuật ấy thì phải là {F#cô}{M#cậu} mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290102,
					"content": "Cô đang nói gì vậy, Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290103,
					"content": "Đi theo tôi trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290104,
					"content": "Căn phòng này... Citlali thường ngày cũng hay dệt vải sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290105,
					"content": "Vải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290106,
					"content": "Vải? Không phải cô nói là muốn cho tôi xem kiệt tác của đời mình sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290107,
					"content": "Tôi không nói dối đâu. Bí thuật này liên quan đến cuộn vải đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290108,
					"content": "Haiz... Nói đi, đó là bí thuật gì? Nó có thể nghịch chuyển trận chiến hay ngăn chặn thảm họa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290109,
					"content": "Trông cô bây giờ, dù có hẹn tôi ra ngoài đánh nhau thì cũng không thể rời khỏi giường được nữa. Tôi cho phép cô thắng tôi bằng cách cãi nhau đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290110,
					"content": "Khụ... Tôi có thể cảm nhận được là mình sắp rời đi rồi, không còn thời gian để tranh cãi với cô nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290111,
					"content": "Này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290112,
					"content": "Đừng lo lắng, bộ tộc chúng ta đã nói rồi mà... Con người trên đại lục này không thực sự chết đi, mà sẽ đến Vương Quốc Dạ Thần, một thế giới được tạo nên từ ký ức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290113,
					"content": "Vậy chắc hẳn cô cũng đoán được tại sao tổ tiên chúng ta lại nhất quyết sử dụng loại vải nhiều màu sắc này để ghi lại lịch sử rồi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290114,
					"content": "Bởi vì lịch sử là ký ức của cả một dân tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290115,
					"content": "Hy vọng họ vẫn có thể cảm nhận được sự ấm áp của ánh chiều tà sau khi đến thế giới đó, nên chúng ta đã nhuộm màu đỏ cam cho lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290116,
					"content": "Hy vọng họ vẫn có thể tận hưởng mùa bội thu sau khi đến thế giới đó, nên chúng ta đã trang trí lịch sử bằng những họa tiết Hạt Ngũ Cốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290117,
					"content": "Tất nhiên là tôi biết điều đó... Nghe có vẻ như là một vấn đề quan trọng của bộ tộc nhỉ? Tại sao không giao việc đó cho học trò của cô?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290118,
					"content": "Tôi đến đây để gặp cô, đúng là tôi đã có một chút ích kỷ với tư cách là một người bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290119,
					"content": "Khụ khụ... Thời gian còn lại, tôi e là sẽ không thể khiến cô hiểu được quyết định này, nhưng tôi tin là cô sẽ hiểu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290120,
					"content": "Hãy đồng ý với yêu cầu cuối cùng của tôi trước nhé, được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290121,
					"content": "...Chỉ lần này thôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290122,
					"content": "Giờ thì tôi đã hiểu quyết định của cô rồi. Móng Vuốt Nhỏ, giúp ta mang nó ra ngoài nhé. Ta sẽ tô màu cho nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME} và Paimon cũng đi theo tôi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
