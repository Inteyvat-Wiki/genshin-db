			"dialogs": [
				{
					"id": 150290501,
					"content": "Hai người đã kể chi tiết cho cậu ta nghe rồi hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290502,
					"content": "Ừm, đóng góp của Citlali thì chúng tôi đã cố tình che giấu rồi, nhưng có vẻ như suýt nữa bị lộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290503,
					"content": "Rõ ràng hai người có thể xử lý bằng cách nói đó là \"món quà của thần linh\" mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290504,
					"content": "Nỗ lực của Biram xứng đáng được báo đáp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "...Tôi biết cậu ta khác với những thủ lĩnh trước đây. Tôi chỉ sợ, nếu bị lộ thì sẽ có cả đống rắc rối tìm tới cửa nhà tôi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290506,
					"content": "Hóa ra các vị ở đây, làm tôi tìm mãi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290507,
					"content": "Anh là nhà nghiên cứu Fontaine dạo trước... Sao không đi chung với tên gian thương đó vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290508,
					"content": "Cứ gọi tôi là Allier nhé... Tôi cũng đã bị thẩm vấn, nhưng vì tôi không phạm tội gì cả nên được thả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290509,
					"content": "Sau khi mất đi chủ thuê, tôi phải quay lại Fontaine càng sớm càng tốt vì không còn kinh phí. Nhưng trước khi rời Natlan, ít nhất tôi muốn hoàn thành cuộc điều tra trước đó của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290510,
					"content": "Các vị có thể giúp tôi hoàn thành câu chuyện về Huitzilin, để những người ở ngoài Natlan biết đến sự tích về bà ấy được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290511,
					"content": "Ý là phỏng vấn à? Thật phiền toái... Tại sao ta phải quan tâm có ai ở ngoài Natlan biết đến câu chuyện này hay không chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290512,
					"content": "Đừng hiểu lầm, tôi không cố bóp méo lịch sử hay là muốn kiếm tiền từ nó đâu. Tôi chỉ đơn giản là quan tâm đến lịch sử của các quốc gia khác thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290513,
					"content": "Tôi cảm thấy nếu câu chuyện thật sự hay ho thì nên được cả Teyvat biết đến, nền văn hóa cũng trở nên phồn vinh nhờ vào sự giao lưu như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290514,
					"content": "Tôi cảm thấy rất có lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "Vậy mau hỏi đi, lát nữa ta còn có việc quan trọng phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290516,
					"content": "Việc quan trọng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290517,
					"content": "Cảm ơn rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290518,
					"content": "Allier hỏi chi tiết về những chuyện trong quá khứ liên quan đến Huitzilin, cho đến khi Citlali hơi bực mình mới đành rời đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "Lại vượt quá hạn mức xã giao hôm nay rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290520,
					"content": "Xem ra đã đến lúc chúng ta phải tạm biệt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290521
					]
				},
				{
					"id": 150290521,
					"content": "#Hmm... Chờ đã, {F#cô}{M#cậu} còn nợ tôi hai quyển sách đã ngừng xuất bản mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290522
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290522,
					"content": "Ồ, chuyện đó... Liên quan đến tiểu thuyết thì Citlali quả nhiên nhớ rất rõ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290523,
					"content": "Nhưng một sớm một chiều thì không tìm thấy ngay được đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290524
					]
				},
				{
					"id": 150290524,
					"content": "Tôi biết. Tôi hiểu sự quý giá của hai quyển sách đó hơn ai hết. Có lẽ tôi phải đến Nhà Xuất Bản Yae ở Inazuma một chuyến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290525
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290525,
					"content": "Tôi không cần tìm ngay, nhưng tốt nhất hãy nhớ cho kỹ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290526
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290526,
					"content": "Ừm ừm, tìm được sẽ đưa cho Citlali ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290527,
					"content": "#Đưa cho tôi à...? Tôi rất ghét phải nghe thấy tiếng gõ cửa khi say đấy. Thế này đi, cái này cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290528
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290528,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290529,
					"content": "Chìa khóa nhà tôi đấy. Lần sau tới đừng gõ cửa nữa, làm phiền người ta ngủ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
