			"dialogs": [
				{
					"id": 150290201,
					"content": "Tất cả chúng ta đều là những chú chim bay vút qua chân trời thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290203,
					"content": "(Video)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "#Quả nhiên là {F#cô}{M#cậu} hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290205,
					"content": "Đây... đây không phải là loại vải mà chúng ta cần làm sao? Sao Citlali lại biết cách làm ra nó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290206,
					"content": "Paimon, hãy nhớ lại \"món quà của thần linh\" nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "Citlali đã sống hơn hai trăm năm, cũng biết cách để làm ra loại vải này... Chẳng lẽ Citlali chính là vị thần đã ban tặng món quà sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290208,
					"content": "Tôi không muốn tiếp xúc với những người được lời chỉ thị lựa chọn, nên luôn dùng phép thuật để mê hoặc họ rồi để lại tấm vải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290209,
					"content": "Những người đó coi đây là \"món quà của thần linh\" vì họ quá kém, không nhìn ra được phép thuật của tôi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290210,
					"content": "Tại sao lại phải giấu họ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "Đúng vậy, tại sao cô phải một mình gánh vác sứ mệnh này suốt hai trăm năm chứ? Kể cả là không thích tiếp xúc thì vẫn có thể dạy cho người khác mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290212,
					"content": "#...{NICKNAME}, {F#cô}{M#cậu} có thể nhìn thấy màu sắc đó đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290213,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "Bản chất của màu sắc chính là ký ức. Quá trình nhuộm màu cho loại vải này thực chất là tìm kiếm màu sắc từ ký ức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290215,
					"content": "Muốn truyền lại bí thuật này, trước tiên phải cùng người khác chia sẻ ký ức và để lại màu sắc của riêng mình trong ký ức của nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290216,
					"content": "Dù cho đến ngày hôm nay tôi mới hiểu hết điều này, nhưng ít nhiều gì trước đây tôi cũng đã có nhận thức về nó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290217,
					"content": "Sau khi Huitzilin rời đi, tôi không còn muốn hình thành mối quan hệ như vậy với mọi người nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290218,
					"content": "Ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290219,
					"content": "Nhưng suy cho cùng, đây là ủy thác cuối cùng của cô ấy trước khi qua đời. Nên tôi từng nghĩ, nếu cuộc đời của tôi còn rất dài, chi bằng cứ để tôi gánh vác sứ mệnh này mãi mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290220,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290221,
					"content": "Móng Vuốt Nhỏ biết rõ điều này, nhưng vẫn không ngừng chỉ định người mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290222,
					"content": "Ý cô là trưởng lão muốn giới thiệu bạn mới cho cô sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "...Ngay từ đầu tôi đã đoán được những người khiến tôi muốn chia sẻ ký ức cũng có thể trở thành bạn của tôi, nhưng tôi luôn từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290224,
					"content": "Nhưng lần này coi như thành công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290226,
					"content": "#...Hãy nhận lấy này, đây là câu trả lời của tôi dành cho {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290227,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290228,
					"content": "Nếu phải chọn ra một màu để làm màu của mình, thì đó chắc chắn sẽ là màu của chiếc khăn tay này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290229,
					"content": "Mấy trăm năm qua, những người khác vẫn sống trong ký ức của tôi, nhưng một ngày nào đó, tôi cũng sẽ sống trong ký ức của người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290230,
					"content": "#{F#Cô}{M#Cậu} nói rằng tuổi thọ của {F#cô}{M#cậu} cũng rất dài, nên là ứng cử viên thích hợp để mang theo ký ức này... Tôi hy vọng ký ức của {F#cô}{M#cậu} cũng sẽ mang màu sắc của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290231,
					"content": "Có vẻ như tôi đã chính thức trở thành bạn của cô rồi nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "...Cất cẩn thận nhé, đừng có nhầm màu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290233,
					"content": "Chúng ta mới trở thành bạn bè thôi mà đã phải lên kế hoạch cho đến cuối đời rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290234,
					"content": "Bạn bè không phải chính là như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290235,
					"content": "#Quả là một lời hứa nghiêm túc... Nhưng mà, nếu {NICKNAME} muốn để lại màu sắc trong ký ức của Citlali thì đó hẳn phải là màu vàng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290236,
					"content": "Đã để lại rồi, còn nhớ tác dụng phụ mà vẫn chưa được xử lý không? Bây giờ tôi đã tìm ra lý do rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290237,
					"content": "Bí thuật chia sẻ cảm quan thực ra là một kiểu giao lưu ở cấp độ ý thức, tất nhiên sẽ liên quan đến ký ức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290238,
					"content": "#Tôi không ngờ {F#cô}{M#cậu} cũng có thể nhìn thấy màu sắc của ký ức như tôi. Khi tôi chia sẻ cảm quan với {F#cô}{M#cậu}, nó sẽ để lại mối liên hệ trong ký ức của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290239,
					"content": "Mối liên hệ này lại có tác dụng với bí thuật dùng để chia sẻ cảm quan, nên kết quả thành ra như bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290240,
					"content": "#Ồ, vậy là do {NICKNAME} đã để lại màu sắc trong ký ức của Citlali, nên cô mới có thể nghe thấy tiếng lòng của {NICKNAME} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290241,
					"content": "#Ngược lại cũng như vậy đúng không? Trước đây {NICKNAME} cũng có thể nghe thấy tiếng lòng của Citlali mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290242,
					"content": "Muốn làm được điều này, trước tiên phải đảm bảo trình độ bí thuật của mình phải ở mức rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290243,
					"content": "#Vì vậy, tác dụng phụ đối với {NICKNAME} chỉ kéo dài trong một thời gian thôi, còn với tôi thì lại tồn tại đến tận bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290244,
					"content": "Nhưng đừng lo, bây giờ tôi đã hiểu nguyên lý đằng sau nó rồi, và sẽ loại bỏ nó sớm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290245,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290246,
					"content": "(Thật ra, tôi đã nói dối Paimon. Mấu chốt để quyết định việc liệu tôi có thể nghe thấy tiếng lòng của người khác hay không phụ thuộc vào sức mạnh liên kết ký ức của chúng ta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290247,
					"content": "#(Sau tất cả những điều này, e là {F#cô}{M#cậu} lại có thể nghe lại tiếng lòng của tôi rồi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290248,
					"content": "(!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "(Quả nhiên đã nghe được rồi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290250,
					"content": "(Vậy có cách nào giải quyết không?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "#(Sau khi thiết lập mối liên hệ ký ức, giải pháp duy nhất tôi có thể nghĩ ra là {F#cô}{M#cậu} phải quên tôi hoặc tôi quên đi {F#cô}{M#cậu}.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290252,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "(Tôi dọa đấy. Tôi là shaman huyền thoại của Chủ Nhân Gió Đêm cơ mà. Giờ tôi đã hiểu nguyên nhân rồi, có nhiều cách để xử lý nó lắm.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290254,
					"content": "(Chỉ là sẽ mất chút thời gian... Còn bây giờ thì cứ tạm chấp nhận tác dụng phụ này đã.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290255,
					"content": "(Yên tâm, tôi rất thẳng thắn, nên không sợ bị nghe thấy điều gì đâu... À, lúc uống rượu xong thì không tính nhé.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290256,
					"content": "(Có thể xử lý được à? Thế thì hơi tiếc nhỉ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "(Tiếc sao? Nếu vẫn muốn chơi trò thần giao cách cảm này thì cứ tìm tôi để dùng bí thuật là được.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290258,
					"content": "(Nói trước nhé, tôi không hứa hẹn gì cả đâu. Có những suy nghĩ tốt nhất là nên giấu kín trong lòng.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290261,
					"content": "Ừm... Hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290259,
					"content": "(Có thể xử lý được sao? Vậy thì tốt rồi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "(Tôi biết, có những suy nghĩ vẫn nên giữ cho riêng mình thì hơn.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				}
			]
		},
