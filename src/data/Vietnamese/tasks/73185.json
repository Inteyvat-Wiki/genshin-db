			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "Phù... phù... cảm ơn bạn, Nhà Lữ Hành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850102,
					"content": "Không sao là tốt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "Tôi là Elber, một thương nhân, vốn định ở đây nghỉ ngơi một lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850105,
					"content": "Nhưng không ngờ lại bị mấy tên Hilichurl tập kích đột ngột...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850106,
					"content": "Anh không có vệ sĩ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "Phải, ở trong thành chúng tôi có nghe nói, các thương nhân ra ngoài vận chuyển hàng đều sẽ thuê người của \"Eremite\" hỗ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850109,
					"content": "Nhưng mà, tôi... tôi chỉ là không nỡ bỏ số tiền đó ra thôi ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850110,
					"content": "Người của \"Eremite\" đều rao giá cắt cổ, giá cao một cách quá đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850111,
					"content": "Tôi vốn chỉ làm ăn nhỏ, không trả nổi số tiền lớn như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850112,
					"content": "Tôi bèn nghĩ, dù gì tôi cũng biết chút võ nghệ, đường vận chuyển hàng cũng không xa, nên đành xuất phát thẳng luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850113,
					"content": "Nhưng không ngờ, lúc những tên Hilichurl kia tập kích, khiến hai con Thú Thồ Hàng của tôi giật mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850114,
					"content": "Tôi còn chưa kịp phản ứng lại thì bị một con Thú Thồ Hàng đụng ngã xuống đất, sau khi đứng dậy lại bị con Thú Thồ Hàng còn lại đá trúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850115,
					"content": "Chà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850116,
					"content": "Sau đó hai con Thú Thồ Hàng bỏ chạy, còn tôi thì bị đám Hilichurl vây đánh... May mà có các bạn hỗ trợ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850117,
					"content": "Nhưng toàn bộ tài sản của tôi đều ở trên người Thú Thồ Hàng rồi... Nhà lữ Hành, có thể nhờ bạn dẫn chúng về giúp tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850118,
					"content": "Tôi... tôi không muốn bị đá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "Không sao, không sao, đừng lo. Tính của chúng vốn ôn hòa, chỉ do đám Hilichurl kia đã hất đổ đồ ăn của chúng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850121,
					"content": "Chúng vác hàng hóa đi xa như vậy chắc đã đói lắm rồi, còn bị hất đổ thức ăn nên mới nóng nảy như vậy thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850122,
					"content": "Ra là vậy... trời đánh còn tránh bữa ăn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850123,
					"content": "Hừm, nghĩ thôi cũng đã thấy bực mình rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850124,
					"content": "Paimon thấu hiểu nhanh thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "Vậy nhé... nào, số thức ăn này giao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850126,
					"content": "Sau khi bạn tìm được Thú Thồ Hàng thì cho chúng chỗ thức ăn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850127,
					"content": "Chỉ cần có thức ăn thì chúng sẽ ngoan ngoãn lại thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850128,
					"content": "Trước đó tôi có để ý, có một con Thú Thồ Hàng đã tông bay đám Hilichurl rồi chạy mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850129,
					"content": "Con còn lại hình như bị đám Hilichurl kia bắt đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850130,
					"content": "Tôi giúp bạn đánh dấu đại khái hướng của hai con Thú Thồ Hàng... Giao lại chuyện này cho bạn đấy, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850131,
					"content": "Chỉ cần có thể tìm được hàng hóa về, chắc chắn tôi sẽ trả thù lao hậu hĩnh cho bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850119,
					"content": "Tôi... tôi không muốn bị tông...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "Không có ai bảo vệ anh sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "Chuyện vặt mà thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
