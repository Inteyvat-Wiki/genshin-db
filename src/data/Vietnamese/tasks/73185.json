			"dialogs": [
				{
					"id": 731850501,
					"content": "Hình như... tâm trạng của con Thú Thồ Hàng này không tốt lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850502,
					"content": "Úi, nhìn móng của nó kìa, có vẻ cứng cáp lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850503,
					"content": "Nếu bị nó đá một cái thì người bình thường chắc xỉu ngang luôn quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850504,
					"content": "Paimon, mang đồ ăn này qua cho nó đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "Bạn... bạn đi đi! Nhanh lên, nhanh lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850506,
					"content": "Mời dùng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "Tôi không muốn mạo phạm đến cái móng của mày đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "Thú Thồ Hàng chậm rãi nuốt đồ ăn, dường như đã bình tĩnh lại...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "Nhìn nó có vẻ không tức giận nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850509,
					"content": "Chúng ta mau đưa nó về đi, cẩn thận đấy! Đừng để bị đá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
