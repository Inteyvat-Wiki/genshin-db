					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "Nhưng đừng có lo, nơi tôi đến sẽ có rất nhiều người chơi cùng tôi! Tôi thực sự hy vọng bạn cũng có thể đến...nhưng chú màu vàng nói vẫn chưa đến lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "Nhưng không sao, không sao đâu! Tôi sẽ đợi bạn. Nếu không thể đợi được nữa, tôi sẽ biến thành những đốm sáng, đi vào giấc mơ của bạn để tìm bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "Đi cẩn thận nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Ừm, tôi biết rồi. Chơi cùng bạn rất vui, cảm ơn bạn.",
