			"dialogs": [
				{
					"id": 722030501,
					"content": "Haha, lại bị phát hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "Mặc dù không nỡ, nhưng mà...lần này tôi đến để tạm biệt. Chú màu vàng nói chúng tôi sắp phải đi rồi...",
