				{
					"id": 250290202,
					"content": "Grừ, grừ, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290203,
					"content": "Ồ, hăng hái thế à? Tốt! Vậy thì hôm nay phải cố gắng hơn nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290204,
					"content": "Cùng cố gắng nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#Ôi chào {M#anh}{F#chị}! Chúng em đang tập leo núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290207,
					"content": "Grào, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290208,
					"content": "Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290209,
					"content": "Tập luyện thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "Ừm... ít nhất có thể nói là \"có tiến bộ\". Lần này Qica leo cao hơn hẳn lần trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290211,
					"content": "Chỉ là lúc leo núi, động tác của Qica không được thuần thục lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290216,
					"content": "#{M#Anh}{F#Chị} có thể làm mẫu lại cho bọn em một lần được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290217,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "#Cảm ơn {M#anh}{F#chị}! Lần này em nhất định sẽ nhìn rõ động tác của {M#anh}{F#chị}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290219,
					"content": "Qica, cậu cũng phải nhìn cho kỹ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290220,
					"content": "Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290223,
					"content": "#Vậy thì nhờ {F#chị}{M#anh} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290224,
					"content": "#Chúng em sẽ ở dưới đất nhìn theo {M#anh}{F#chị}, và tính thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290225,
					"content": "Grào... Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290221,
					"content": "#Lần này nhất định phải nhìn rõ động tác của {M#anh}{F#chị} đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "Đương nhiên rồi. Em và Qica sẽ mở to mắt nhìn kỹ, lần này nhất định sẽ nhìn rõ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290212,
					"content": "Xem ra đã hồi phục tốt rồi nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290213
					]
				},
				{
					"id": 250290213,
					"content": "Đương nhiên rồi. Mẹ em bảo em rất giỏi chăm sóc Qica mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290214
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290214,
					"content": "Qica tiến bộ nhiều lắm, leo lên cao hơn hẳn so với lần trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290215
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290215,
					"content": "Chỉ là lúc leo núi, động tác của Qica không được thuần thục lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
