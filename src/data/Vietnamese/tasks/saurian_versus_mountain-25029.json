			"dialogs": [
				{
					"id": 250290301,
					"content": "#{M#Anh}{F#Chị} giỏi quá! Leo núi nhanh như Mayta vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290302,
						250290304
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290302,
					"content": "Có, có sai sót một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290303
					]
				},
				{
					"id": 250290303,
					"content": "#Sai sót? Chẳng lẽ {M#anh}{F#chị} còn có thể leo nhanh hơn ư? Đây là sức mạnh của nhà mạo hiểm siêu hạng sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290306,
					"content": "Nếu lấy thời gian leo núi này làm mục tiêu luyện tập thì... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290307
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290307,
					"content": "Grào... Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290308
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290308,
					"content": "...Haha, có vẻ hơi làm khó cho Qica rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290309
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290309,
					"content": "#Không sao, lát nữa tớ sẽ nói cho Mayta thời gian leo núi của {M#anh trai}{F#chị gái} đây. Biết đâu, cậu ấy có thể giúp tớ lập ra một... kế hoạch tập luyện hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290310
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290310,
					"content": "#Cảm ơn {M#anh}{F#chị} đã giúp đỡ, tặng {M#anh}{F#chị} Cacahuatl này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290311
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290311,
					"content": "Đây là bọn em vừa hái được, tươi lắm, làm Chocolate chắc chắn rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290312
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290312,
					"content": "Grào, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290313
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290313,
					"content": "Vậy thì chúng ta lên đường thôi, không biết Mayta có ở trong bộ tộc không. Chắc cậu ấy lại đi leo núi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290304,
					"content": "Mayta là ai vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290305
					]
				},
				{
					"id": 250290305,
					"content": "Cậu ấy là bạn của em, rất giỏi leo núi. Ngoài chị Roca ra, hầu như không ai có thể thắng cậu ấy trong môn leo núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlatem"
				}
			]
