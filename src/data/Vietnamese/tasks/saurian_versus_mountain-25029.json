			"dialogs": [
				{
					"id": 250290101,
					"content": "Bình tĩnh nào, đừng nản lòng. Chỉ cần cơ thể khỏe mạnh, sau đó... cố gắng luyện tập! Chắc chắn sẽ leo được lên đỉnh núi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290102,
					"content": "Grào... grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290103,
					"content": "Có phải cậu đói rồi không? Hmm... Vậy tớ đi lấy cho cậu chút đồ ăn nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290104,
					"content": "Grào... grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290105
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290105,
					"content": "Em đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290106
					]
				},
				{
					"id": 250290106,
					"content": "Em đang chơi với bạn đồng hành Qica của em. Dù cậu ấy còn nhỏ, nhưng mẹ em bảo sau khi lớn lên, cậu ấy chắc chắn sẽ giỏi như những Yumkasaur khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290107,
					"content": "Grào... Hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290108,
					"content": "Đừng buồn nữa. Chỉ là cơ thể cậu vẫn hơi yếu thôi, trước đây còn bị thương nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290109
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290109,
					"content": "Mẹ tớ bảo, chỉ cần cậu ăn nhiều đồ ngon, rồi tập luyện nhiều với tớ là sẽ khỏe lại thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290110
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290110,
					"content": "Grào... grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290111,
						250290113
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290111,
					"content": "(Vỗ về Qica.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290112
					]
				},
				{
					"id": 250290112,
					"content": "Grào... grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290119,
					"content": "Ôi, nói nhiều quá, sắp đến giờ tập luyện rồi, ăn chút gì trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290120,
					"content": "Đây là món trái cây sấy đặc biệt do mẹ tớ làm, được rang trong nồi lớn, sau đó cho thêm nhiều gia vị thơm ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290121,
					"content": "Còn thêm rất nhiều đường và cánh hoa nữa... Nói chung, nó rất ngon! Cho cậu cái này nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290122
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290122,
					"content": "Trái cây sấy đâu rồi nhỉ? Rõ ràng đã để trong túi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290123,
					"content": "Grào... grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290124
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290124,
					"content": "Ồ! Qica! Có phải cậu lén ăn hết rồi không? Tớ đã bảo là đừng ham ăn mà, ăn nhiều sẽ không chạy nổi đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290125,
					"content": "Grừ... Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290126,
						250290127
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290126,
					"content": "Ham ăn là tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290128,
					"content": "Grào, gràoooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290129
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290129,
					"content": "Vậy ư? Thế thì... em cũng muốn giống như Qica. Ăn thật nhiều, lớn thật nhanh, rồi sau đó sẽ giúp đỡ mẹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290130
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290130,
					"content": "Được, vậy chúng ta bắt đầu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290131
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290131,
					"content": "Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290132
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290132,
					"content": "Để tớ xem nào... hôm nay tập leo núi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290133
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290133,
					"content": "G-Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290134
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290134,
					"content": "Vẫn giống như lần trước thôi, không khó đâu. Cố lên nào, Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290135
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290135,
					"content": "...Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290136
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290136,
					"content": "Đúng rồi, chú Yawar đã nói với tớ, muốn tập luyện nghiêm túc thì cần phải có một \"mục tiêu tập luyện\" hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290137
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290137,
					"content": "Giá mà tớ tìm được một nhà mạo hiểm tài giỏi, để người đó giúp tớ đặt ra mục tiêu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290138,
						250290139
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290138,
					"content": "#{M#Anh}{F#Chị} là một nhà mạo hiểm khá giỏi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290140,
					"content": "#Thật sao?! {M#Anh}{F#Chị} đồng ý giúp em à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290141,
						250290142
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290141,
					"content": "#Muốn {M#anh}{F#chị} dẫn hai đứa đi leo núi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290143,
					"content": "#Không phải không phải, nếu {M#anh}{F#chị} tài giỏi như vậy thật, thì tụi em đuổi không kịp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290144
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290144,
					"content": "#Chúng em sẽ ở dưới đất nhìn theo {M#anh}{F#chị}, và tính thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290145
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290145,
					"content": "#Xin nhờ {M#anh}{F#chị} hãy dốc hết sức, trèo lên đỉnh núi với tốc độ nhanh nhất nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290146
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290146,
					"content": "Grào! Gràooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290142,
					"content": "#Được, đi theo {M#anh}{F#chị}, bắt đầu ngay thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290139,
					"content": "Nhà mạo hiểm tài giỏi ở ngay bên cạnh em đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290127,
					"content": "Ăn nhiều sẽ lớn nhanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290113,
					"content": "Qica bị thương như thế nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290114
					]
				},
				{
					"id": 250290114,
					"content": "Em không biết... Chắc là mẹ biết đó! Nhưng khi mẹ đưa Qica về nhà thì cậu ấy đã bị bệnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290115,
					"content": "Qica không ăn được gì, cũng không có sức để di chuyển. Em chỉ có thể pha thuốc vào nước mỗi ngày và cho cậu ấy uống thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290116,
					"content": "Mặc dù Qica đã khỏi bệnh, nhưng cơ thể vẫn còn rất yếu. Không thể leo trèo trên vách đá như những con Yumkasaur khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290117
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290117,
					"content": "Qica rất buồn vì điều này, vì vậy em muốn giúp cậu ấy! Em muốn Qica khỏe mạnh trở lại, và... trở nên mạnh hơn bất kỳ con Yumkasaur nào khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290118
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290118,
					"content": "Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				}
			]
		},
