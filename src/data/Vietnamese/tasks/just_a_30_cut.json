						747030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030103,
					"content": "...Kiếm được nhiều thế này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030104,
					"content": "Hối hận vì chỉ lấy 30% thôi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "#Trong mắt {F#cô}{M#cậu} tôi keo kiệt đến vậy sao? Tôi chỉ đang cảm thán không ngờ hai người vận hành thủy cung thành công như vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030106,
					"content": "Tôi thấy ít nhiều cũng có công lao của Liên Hoan Phim Fontinalia đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030107,
					"content": "Doanh thu này... không chỉ thu hồi lại tiền thuê Wingalet, mà còn lời một khoản đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030108,
					"content": "Muốn chuyển nghề rồi hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Cũng không đến nỗi. Tôi biết mình không hợp làm kinh doanh. Tôi vẫn thích nghiên cứu kết cấu máy móc và thuật thức hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030110,
					"content": "Nhưng mà... cũng đúng thôi, nhìn nơi này từ căn phòng trống trơn chẳng có con cá nào trở thành như bây giờ, đúng là khiến người ta bất ngờ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030111,
					"content": "Hì hì, cũng có công của Sandrone đã rộng lượng cho mượn mà! Căn phòng tự tay mình trang trí được mọi người thích như vậy, cũng rất vui đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030112,
					"content": "Hmm, chắc cũng có đôi chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747030113,
					"content": "Chỉ đôi chút thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030114,
					"content": "Chắc do cô ấy chỉ lấy 30% thôi đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "Tôi đã bảo là không quan tâm chuyện đó rồi mà!!",
