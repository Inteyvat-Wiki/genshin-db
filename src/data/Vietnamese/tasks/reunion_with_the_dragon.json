			"dialogs": [
				{
					"id": 3840201,
					"content": "Hm, đã đông đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840202,
					"content": "Ở nơi này, phong cảnh thật đẹp quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840203,
					"content": "Rất hợp với chủ đề \"Sự gặp lại của định mệnh\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840204,
					"content": "Vậy thì, chuẩn bị bắt đầu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840205,
					"content": "Ừ, bất kể kết quả như thế nào, ít nhất cũng nhìn thấy được cơ hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840206,
					"content": "Thời gian này, cả tòa thành Mondstadt đều đã gánh chịu quá nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840207,
					"content": "Chỉ là từ đầu đến giờ, người giải quyết vấn đề lại là Nhà Lữ Hành và một ca sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840208,
					"content": "Hê, đội Kỵ Sĩ miễn cưỡng coi như có chút công lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840209,
					"content": "Được rồi, mọi người tránh qua một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840210,
					"content": "Nhà thơ lang thang giỏi nhất thế gian, bắt đầu kéo lên dây đàn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
