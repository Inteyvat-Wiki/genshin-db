			"dialogs": [
				{
					"id": 750230201,
					"content": "#{NICKNAME}, nhìn kìa! Ở đây vừa có máy ảnh lại vừa có phông màn, có khi nào đây là một địa điểm quay phim không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230202,
					"content": "#Nhưng mà mấy căn nhà này nhỏ quá! Làm cho {NICKNAME} trông như người khổng lồ ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230203,
					"content": "Rawr... Rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230204,
						750230207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230204,
					"content": "Loài người nhỏ bé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230205
					]
				},
				{
					"id": 750230207,
					"content": "Cho Paimon ở chắc cũng khá ổn đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230208
					]
				},
				{
					"id": 750230205,
					"content": "Rawrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230206,
					"content": "Hihi, lần này chúng ta thực sự là những \"nhân vật lớn\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230208,
					"content": "Tôi không thèm ở trong mấy căn phòng nhỏ xíu thế đâu nhé! Tay chân không duỗi ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230239,
					"content": "Một người Natlan rất tự nhiên tham gia vào cuộc trò chuyện...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230209
					]
				},
				{
					"id": 750230209,
					"content": "Ồ! Mấy vị cũng quan tâm đến quay phim chụp ảnh à? Vậy xin hãy giúp đỡ Akatanga tôi một tay, để cho xu hướng mới càn quét vùng đất Natlan này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230210
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230210,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230211,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} sao trông vui vẻ thế? Nhóc hùa theo anh ta làm gì vậy? Nhóc cũng thích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230212,
					"content": "Raaaawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230213,
					"content": "Người bạn nhỏ này biết nhìn đấy! Nói thật, tất cả mọi thứ ở đây được chuẩn bị để biến một con Tepetlisaur bé nhỏ trở thành ngôi sao tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230214
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230214,
					"content": "Tiếc là con Tepetlisaur nhỏ ấy bị bạn của tôi mang đi mất rồi. Chúng tôi đã cãi nhau to vì ý tưởng sáng tạo bất đồng, sau đó cô ấy đã mang diễn viên quan trọng nhất của tôi một đi không trở lại, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230215
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230215,
					"content": "Đúng thật là không nên hợp tác với bạn bè. Dự án thất bại rồi, bạn bè cũng mất luôn. Tôi thua gấp đôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230216
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230216,
					"content": "Nhưng cũng không sao, bây giờ lại có một con Tepetlisaur nhỏ đến trước mặt tôi, xem dáng vẻ nó háo hức muốn thử kìa, chắc chắn có thể nổi tiếng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230217
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230217,
					"content": "Thế nào? Nếu mấy vị có thể giúp tôi hoàn thành tác phẩm vượt thời gian này, tôi chắc chắn sẽ báo đáp hậu hĩnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230218,
						750230219
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230218,
					"content": "#Nếu như {REALNAME[ID(2)|SHOWHOST(true)]} đã thích thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230221
					]
				},
				{
					"id": 750230219,
					"content": "Chắc chắn thành công... Nghe cứ như lừa đảo ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230220
					]
				},
				{
					"id": 750230220,
					"content": "Dù cho không thể nổi tiếng ngay lập tức thì tiền thù lao hỗ trợ quay phim vẫn sẽ được trả mà, mọi người sẽ không bị thiệt đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230221
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230221,
					"content": "Giúp đỡ thì có thể đó, nhưng chúng tôi còn chưa biết anh muốn quay nội dung gì mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230222,
					"content": "Những gì tôi tưởng tượng là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230223
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230223,
					"content": "Vù... Bùm bùm. Một tia sáng trắng chói lóa bất ngờ báo hiệu sự xuất hiện của vị khách không mời đến với bộ tộc. Nó hoàn toàn tròn trịa, trừ một chiếc gai duy nhất. Xèo xèo, khi nó dừng lại một lúc trên bãi cỏ, một mùi khét bắt đầu lan tỏa trong không khí. \"Ối! Sứ giả của Xibalba!\" Mọi người trong bộ tộc lộ ra vẻ mặt hoảng sợ. Ầm ầm... \"Nó đến rồi kìa! Sinh vật tà ác đến răng cũng không có! Nó sẽ ăn thịt cả bộ tộc mất thôi!\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230224
					]
				},
				{
					"id": 750230224,
					"content": "#Ngay khi tên ác nhân sắp phá vỡ hàng phòng thủ của bộ tộc! Đùng đùng... Vị cứu tinh của chúng ta với chiếc khăn đuôi đỏ từ hư không xuất hiện. \"Nó từ đâu đến?\" Cặp vuốt cứng hơn cả Đá Obsidian, dễ dàng phá vỡ bất kỳ loại đất đá nào, \"nhưng độ dẻo dai của đối thủ thậm chí còn hơn cả kẻ mặt dày vô lại, cơ hội chiến thắng của {REALNAME[ID(2)|SHOWHOST(true)]}...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230225
					]
				},
				{
					"id": 750230225,
					"content": "\"Rawrrrr!\" Thay vì nói đó là tiếng gầm giận dữ, thì nó giống như tiếng thét chói tai hơn. Sinh vật tà ác không răng cũng sẵn sàng nghênh chiến. Ngọn lửa dữ dội thắp sáng bầu trời, tiếp theo là tiếng ầm ầm như sấm sét, và một làn nhiệt còn nóng hơn cả Phlogiston Thể Lỏng! Sinh vật tà ác không răng bỏ chạy. \"Nóng quá! Nóng quá!\" Những người trong bộ tộc đã may mắn thoát khỏi thảm họa kêu lên khi cơn dư chấn ấy tràn qua họ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230226
					]
				},
				{
					"id": 750230226,
					"content": "Mà vị cứu tinh cùng chiếc khăn đỏ kia không biết đã lặng lẽ rời đi từ lúc nào, cũng giống như mọi người đều không hề hay biết nó đến bằng cách nào vậy...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750230227,
					"content": "Thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230228
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230228,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230229,
						750230231
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230229,
					"content": "Đây là tác phẩm tôi muốn xem đó! Quá tuyệt vời.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230230
					]
				},
				{
					"id": 750230231,
					"content": "Phong cách hơi độc đáo, hơi khó tiếp cận khán giả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230232
					]
				},
				{
					"id": 750230230,
					"content": "Tôi biết ngay mà! Sẽ có người thích phong cách này thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230232,
					"content": "À ừm... Trước đây tôi nghe người từ bên ngoài tới nói, rằng việc khác biệt cũng là một định hướng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230233,
					"content": "#Hmm, tôi không hiểu cho lắm, nhưng chỉ cần {REALNAME[ID(2)|SHOWHOST(true)]} thích là được rồi. Vậy thì cụ thể chúng ta nên làm những gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230234,
					"content": "Rất đơn giản. Đầu tiên là đặt các đạo cụ biểu diễn. <color=#00E1FFFF>Đặt thùng gỗ và mồi nhử nguyên tố vào vị trí thích hợp</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230235
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230235,
					"content": "Thùng gỗ thì tốt nhất là ở <color=#00E1FFFF>giữa khung hình</color>, nhưng không thể che khuất nhân vật chính và nhà cửa. Mồi nhử nguyên tố đặt theo hướng mà <color=#00E1FFFF>phản diện sẽ tiến vào</color> thì thích hợp hơn, cũng chính là phía chéo góc kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230236
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230236,
					"content": "#Diễn viên đều đã có mặt tại hiện trường, đã đến lúc di chuyển rồi. {REALNAME[ID(2)|SHOWHOST(true)]}, cứu tinh với đuôi cột khăn đỏ xuất hiện nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230237
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230237,
					"content": "Đợi đến khi kịch bản yêu cầu, hai vị <color=#00E1FFFF>dụ phản diện đến gần thùng gỗ</color>, sau đó nhanh chóng rời đi, đến vị trí an toàn <color=#00E1FFFF>phá vỡ thùng gỗ</color>, vậy là thành công rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230238
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230238,
					"content": "Tôi nóng lòng muốn xem hiệu ứng phim lắm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				}
			]
		},
