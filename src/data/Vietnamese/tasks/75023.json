			"dialogs": [
				{
					"id": 750230701,
					"content": "Rawr rawr! Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230702
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230702,
					"content": "Được rồi, đừng gấp gáp thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230703,
					"content": "Nói thật, vừa rồi tôi cũng lo lắng cho cậu nhóc này lắm. Vì để theo đuổi cảm giác chân thực mà lượng thuốc nổ cũng đã được chuẩn bị khá nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230704,
						750230706
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230704,
					"content": "Cú nổ nhẹ thôi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230705
					]
				},
				{
					"id": 750230705,
					"content": "Rawrawrawrawrawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230708,
					"content": "Tóm lại, có kinh nghiệm là sau này đã biết làm thế nào để cải thiện rồi. Cảm ơn các vị đã giúp đỡ, chúng ta xem hiệu ứng phim nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230709
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230709,
					"content": "Điều bất ngờ là, trong màn hình không có vị cứu tinh đuôi quấn khăn đỏ, cũng không có kẻ thù độc ác phát ra âm thanh xèo xèo, càng không có cảnh cháy nổ gay cấn nào hết... Chỉ có biểu cảm liên tục thay đổi của Akatanga thôi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230710
					]
				},
				{
					"id": 750230710,
					"content": "Tôi thành vai chính rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230711,
						750230713
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230711,
					"content": "Chúc mừng nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230712
					]
				},
				{
					"id": 750230712,
					"content": "Thế này không đúng nhỉ! Lẽ nào là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230714,
					"content": "Quả thật đây là lần đầu tiên tôi dùng... Lẽ nào là bị xoay ngược ống kính rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230715
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230715,
					"content": "Anh nói nhẹ nhàng ghê ấy, vậy những vất vả ban nãy của chúng tôi không phải đã phí công rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230716,
					"content": "Wooo... Rrrooo... Rrawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230717
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230717,
					"content": "#Rõ ràng là {REALNAME[ID(2)|SHOWHOST(true)]} cũng rất mong chờ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230718,
					"content": "Xin lỗi, là lỗi của tôi! Thế này đi, ban nãy coi như là diễn tập, lần này mới là chính thức. Tôi sẽ dốc hết sức để tạo ra những thước phim đặc sắc nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230719
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230719,
					"content": "Rrrooo... Rawrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230720,
					"content": "Nhóc vẫn còn hào hứng lắm, vậy coi như nhóc đồng ý rồi nhé. Nhưng mong lần này không xảy ra sai sót gì nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230721,
					"content": "Thế là mọi người thực hiện lại quy trình trước đó, cuối cùng cũng xem như đã nhận được kết quả mong muốn...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230722
					]
				},
				{
					"id": 750230722,
					"content": "Tuyệt lắm! Hoàn hảo! Chỉ có thể nói là vượt ngoài kỳ vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230723,
						750230724
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230723,
					"content": "Chuyện nhỏ thôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230725,
					"content": "Ngoài thù lao đã nói trước đó thì tấm ảnh này sẽ tặng cho mọi người làm kỷ niệm. Ôi, dù sao thì đây cũng được xem là tác phẩm tâm đắc của tôi đó, tất nhiên cũng nhờ có các vị đã giúp đỡ rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230726
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230726,
					"content": "#Woa, dáng vẻ oai phong lẫm liệt của {REALNAME[ID(2)|SHOWHOST(true)]} rất ngầu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230727,
					"content": "Rawr rawr! Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230728
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230728,
					"content": "#Hihi, {REALNAME[ID(2)|SHOWHOST(true)]} cũng rất hài lòng, vậy là mọi chuyện đều rất tuyệt vời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230724,
					"content": "Đạo diễn, tiền thưởng của chúng tôi đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230713,
					"content": "Anh đã từng dùng qua thiết bị này chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230714
					]
				},
				{
					"id": 750230706,
					"content": "Đến cả tôi cũng cảm thấy nguy hiểm đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230707
					]
				},
				{
					"id": 750230707,
					"content": "Đúng đó! Lỡ như làm ai bị thương thì không xong đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
