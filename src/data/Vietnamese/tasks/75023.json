			"dialogs": [
				{
					"id": 750231201,
					"content": "Phản diện lại là diễn viên tạm thời mà không bàn bạc trước sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750231202,
					"content": "Suỵt! Đừng ồn, chúng ta sắp bắt đầu quay phim rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231203
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231203,
					"content": "\"Không thể tha thứ... An nghỉ đi, bạn bè của tôi, huhu... huhu... Nhìn thấy những người trong bộ {RUBY#[D]anh em tốt}tộc ngã xuống, tôi thật sự muốn rơi nước mắt!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231204
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231204,
					"content": "\"Nhưng bây giờ không phải lúc để rơi lệ. Sứ {RUBY#[D]Xolotl}giả khô héo ở ngay trước mặt, hôm nay ta nhất định sẽ trả mối thâm thù này...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231205
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231205,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231206
					],
					"speakerTitle": "Akatanga"
				},
				{
