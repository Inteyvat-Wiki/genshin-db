			"dialogs": [
				{
					"id": 750230301,
					"content": "Sao rồi? Có cần tôi lặp lại các bước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230302,
					"content": "Nói lại lần nữa cho tôi nghe đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230303
					]
				},
				{
					"id": 750230303,
					"content": "Đầu tiên là đặt các đạo cụ biểu diễn. Thùng gỗ đặt ở <color=#00E1FFFF>giữa khung hình mà không được chắn mất nhân vật chính và khung cảnh</color>, mồi nhử nguyên tố đặt ở <color=#00E1FFFF>hướng mà phản diện bước vào</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230304
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230304,
					"content": "Sau đó, đợi đến lúc cần thiết thì <color=#00E1FFFF>dụ phản diện đến gần thùng gỗ</color>, rồi lui đến vị trí an toàn và <color=#00E1FFFF>phá vỡ thùng gỗ</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230305,
					"content": "Không cần đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230306
					]
				},
				{
					"id": 750230306,
					"content": "Vậy thì trông cậy vào mọi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				}
			]
		},
