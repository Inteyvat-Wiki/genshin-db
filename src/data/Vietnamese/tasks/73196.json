			"dialogs": [
				{
					"id": 731960701,
					"content": "Tiệm nhỏ kinh doanh các loại nhu yếu phẩm hằng ngày, mỗi món hàng đều do chủ tiệm đích thân kiểm định, chất lượng đảm bảo bạn sẽ hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731960702,
					"content": "\"Cha, có thể cho con mượn thêm tiền không? Con tìm hiểu kĩ rồi, sắp tới giá Quả Ajilenakh sẽ tăng mạnh, chắc chắn lần này có thể kiếm được một khoản lớn.\"",
					"roleType": "TALK_ROLE_NPC",
