				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961701,
					"content": "\"Tôi không giới thiệu nhiều nữa, dù gì mọi người cũng nghe qua tên Đại Nhân Sangemah Bay rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961702,
					"content": "\"Tóm lại gần đây mới nhập một đợt thảm mới, không biết bay, nhưng tốt hơn của tiệm Sulaykha nhiều. Mọi người muốn mua thì nhanh tay nhé, cách thức mua vẫn như cũ, hì hì.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961703,
					"content": "\"Nè! Đừng có quá đáng nha Dori!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		}
	]
