			"dialogs": [
				{
					"id": 731960101,
					"content": "Đây là bảng thông báo riêng của Sở Giao Dịch Kalimi, dành cho những nhà giao dịch trong và ngoài nước đăng tải thông tin thương mại, đừng tùy tiện dán những thông tin không liên quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "Sở giao dịch đảm bảo cung cấp tin tức thị trường chính xác đáng tin cậy, nhưng không đảm bảo tính chính xác và đầy đủ của thông tin đó dưới mọi hình thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731960202,
					"content": "Người dùng không được dùng một phần hay toàn bộ thông tin thị trường trên bảng thông báo để làm chứng cứ hay dùng để yêu cầu bồi thường khi gặp bất kỳ tổn thất gì gây ra bởi thông báo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "Bạn có nghe nói về thuật bay lượn chưa? Bạn nhìn thấy người bay trong không trung chưa? Bạn muốn biết bí mật ẩn giấu phía sau Thú Thồ Hàng biết bay không? Vậy thì đừng bỏ lỡ buổi biểu diễn đầu tiên của Đoàn Nghệ Thuật Bay Lượn Fontaine tại Sumeru nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731960302,
					"content": "Hoan nghênh ghé đến, đừng lỡ mất cơ hội, đến lúc nào xem lúc đó, chỉ cần 5 Mora là sẽ có thể thưởng thức màn trình diễn nghệ thuật đặc biệt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731960303,
					"content": "Nhận được tố cáo từ dân chúng, màn trình diễn chưa thông qua xét duyệt từ Giáo Viện, hiện đã bị hủy bỏ tư cách diễn xuất và quảng cáo này sẽ bị gỡ xuống ngay lập tức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319604",
