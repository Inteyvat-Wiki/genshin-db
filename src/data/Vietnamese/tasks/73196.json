				{
					"id": 731961001,
					"content": "\"Trong quá khứ tôi từng sở hữu khối tài sản vô tận, nhưng dù phung phí thế nào cũng không thể làm dịu trái tim tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961002,
					"content": "\"Trải qua chuyến đi này, giờ trong túi tôi chẳng còn Mora nào cả, nhưng tôi cảm thấy rất bình yên.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961003,
					"content": "\"Nếu muốn nghe câu chuyện của tôi, hãy đến sạp rau củ tìm tôi. Đương nhiên, nếu mua thêm rau thì càng tốt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319611,
			"completionStepIds": [
				7319611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319611",
							"2"
						],
						"stepId": 7319611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961101,
					"content": "Xưởng nhuộm Ani với thủ công tinh tế và kỹ thuật tinh xảo, thêm sắc màu mới cho quần áo của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961102,
					"content": "\"Ông chủ, vải mà tôi mang đến nhuộm tháng trước đã lấy được chưa?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961103,
					"content": "\"Xin lỗi! Hôm qua vợ tôi sinh con, không có thời gian làm. Ngày mai quý khách quay lại nhé, tôi bảo đảm giao hàng đúng hạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961104,
					"content": "\"Cũng đã ba tháng trôi qua rồi, hãy trả lại vải cho tôi, tôi không nhuộm nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961105,
					"content": "\"Xin lỗi! Vải của quý khách đã được nhuộm xong rồi, ngờ đâu lúc phơi vải không biết bị kẻ nào trộm mất. Nếu quý khách muốn lấy thì đi mà tìm kẻ trộm vải ấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319612,
			"completionStepIds": [
				7319612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319612",
							"2"
						],
						"stepId": 7319612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961201,
					"content": "Công ty chuyên về các dịch vụ thương mại ở nước ngoài, có hợp tác lâu dài với đội thuyền hùng mạnh như \"Đội Thuyền Nam Thập Tự\", hộ tống hàng hóa của bạn một cách an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961202,
					"content": "Sẽ mở thêm bốn tuyến đường mới trong mùa hè này cho các mặt hàng như tơ lụa, hương liệu, khoáng thạch... Những con thuyền mới mua có sức chở hàng lớn, chân thành chào đón các chủ thương gia nhập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961203,
					"content": "Nếu muốn đặt toàn bộ tuyến đường vận chuyển, hãy liên hệ trực tiếp với Farzaneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319613,
			"completionStepIds": [
				7319613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319613",
							"2"
						],
						"stepId": 7319613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961301,
					"content": "Căn cứ theo khiếu nại người tiêu dùng, xưởng nhuộm Ani bị tình nghi ăn cắp vải, hiện đã đóng cửa để điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961302
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961302,
					"content": "Sau khi điều tra, xưởng nhuộm hiện giờ đang trống không chẳng còn gì cả. Chúng tôi đang tìm cách lấy lại tài sản bị đánh cắp của những người khiếu nại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319614,
			"completionStepIds": [
				7319614
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319614",
							"2"
						],
						"stepId": 7319614,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961401,
					"content": "Liên quan đến vấn đề quyền sở hữu của Tiệm Cà Phê Puspa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961402,
					"content": "Sau khi điều tra, chủ tiệm đã mất tích trong chuyến khảo sát sa mạc cách đây ba năm, theo quy định thì tiệm cà phê hiện tại sẽ do cấp trên của Học Phái Vahumana quản lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961403,
					"content": "Kết quả phán quyết: Vì người khiếu nại rút đơn kiện nên vụ việc bị đình chỉ vô thời hạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319615,
			"completionStepIds": [
				7319615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319615",
							"2"
						],
						"stepId": 7319615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961501,
					"content": "\"Nhắc đến Đại Khu Bazaar, nơi không thể bỏ qua chính là Nhà Hát Zubayr.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961502,
					"content": "\"Còn ở trong Nhà Hát Zubayr, thì nhất định không thể bỏ qua điệu múa của cô Nilou!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961503,
					"content": "\"Đến Sumeru mà không xem Vũ Điệu Sabzeruz của cô Nilou thì đúng là uổng công đi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319616,
			"completionStepIds": [
				7319616
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319616",
							"2"
						],
						"stepId": 7319616,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961601,
					"content": "Phải nói nghề làm nhà mạo hiểm hiện nay đang là vua của mọi nghề, vừa có Mora vừa được xã hội trọng vọng. Hãy tham gia \"Hiep Hoi Nha Mao Hiem\" ngay để có được trải nghiệm tốt nhất, phí hội viên tháng đầu chỉ 5 Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961602,
					"content": "Kiến thức thực sự chỉ có thể có được từ thực hành thực tế. Dù phải từ giã cõi đời ở phương xa, vẫn cao quý hơn cả đời phải sống tạm bợ lãng phí thời gian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961603,
					"content": "\"Mọi người nhìn cho kỹ, cẩn thận bị lừa, đây là \"Hiep Hoi Nha Mao Hiem\" chứ không phải Hiệp Hội Nhà Mạo Hiểm thực sự đâu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731961604,
					"content": "\"Cái gì! Tôi đã trả phí hội viên một năm rồi đấy, tiền của tôi có được hoàn lại không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7319617,
			"completionStepIds": [
				7319617
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
