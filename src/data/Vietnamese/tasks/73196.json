				},
				{
					"id": 731960502,
					"content": "Mỗi cư dân của Sumeru đều nên có một tấm thảm như vậy trong đời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731960503,
					"content": "Thảm có giá, nghệ thuật vô giá!",
