			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "Sở giao dịch sắp tới sẽ mở văn phòng tại Sumeru, kính mong quý khách hàng tương lai hãy đón chờ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731960402,
					"content": "Để thực hiện các giao dịch, hãy liên lạc Viktor để được xử lý tại chi nhánh Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 731960403,
					"content": "Nếu có vấn đề về khoản vay vui lòng liên hệ người phụ trách xử lý khoản vay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
