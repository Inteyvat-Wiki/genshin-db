					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "Tôi chính là Quan Chấp Hành Sandrone của các người!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "Hả? Giờ... giờ chúng ta dùng luôn danh hiệu này sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071103,
					"content": "Hừm, tôi đánh giá cao sự gan dạ này đấy, nhưng nói dối trắng trợn như vậy thì cũng quá xem thường Fatui rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "Tôi là... nhà nghiên cứu được Sandrone tuyển vào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "Nhà nghiên cứu? Trình độ nghiên cứu về máy móc và Kuuvahki của cô ấy đã đạt đến mức đỉnh cao rồi, thật khó tưởng tượng được cô ấy vẫn cần tuyển thêm nhà nghiên cứu từ bên ngoài đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "Nghiên cứu khoa học được xây dựng dựa trên nền tảng hợp tác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Quả đúng là vậy. Tôi cũng đã thu thập được không ít báo cáo nghiên cứu từ Viện Khoa Học Fontaine cho cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "#Nếu {F#cô}{M#cậu} là chuyên gia trong lĩnh vực này, vậy thì việc sửa chữa Tàu Lục Chiến hẳn là rất dễ dàng đối với {F#cô}{M#cậu} phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "À... Tôi chỉ tập trung vào nghiên cứu lý thuyết thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "Ra là vậy, nghiên cứu lý thuyết về Kuuvahki là học vấn sâu sắc và khó khăn nhất, thật đáng nể! Còn việc sửa chữa Tàu Lục Chiến thiên về ứng dụng thực tế hơn, hai lĩnh vực này quả thật rất khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071403,
					"content": "#Nhưng mà, cô Sandrone hiện không có ở đây. {F#Cô}{M#Cậu} có thể đến gặp chỉ huy Azalea trước, có lẽ cô ấy sẽ biết kế hoạch tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
