			"dialogs": [
				{
					"id": 761071901,
					"content": "Có việc đấy, tôi muốn thử so tài với mấy người một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071902
					]
				},
				{
					"id": 761071902,
					"content": "So tài á? Hai người không phải là nhân viên được thuê bên ngoài sao... Hmm, giờ nghĩ kỹ lại thì hình như chưa bao giờ thấy cô ấy thuê ai từ bên ngoài cả... Hừ, quả nhiên là gián điệp, chịu chết đi!",
