			"dialogs": [
				{
					"id": 761071001,
					"content": "Ai đấy? Sao lại chạy đến đây? Nhân viên dỡ hàng lẽ ra phải ở gần cảng chứ.",
					"roleType": "TALK_ROLE_NPC",
