				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "Được thôi, cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Sau khi gõ vài cái lên Tàu Lục Chiến, giờ nó hoàn toàn không nhúc nhích nữa...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Có vẻ như... đã hỏng hoàn toàn rồi! Giờ phải làm sao đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "Hừm, từ nãy tôi đã thấy có gì đó không đúng rồi. Làm gì có nhà nghiên cứu nào lại khoe khoang như thế chứ? Quả nhiên là đồ giả mạo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610716,
