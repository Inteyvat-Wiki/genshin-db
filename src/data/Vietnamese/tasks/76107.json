			"dialogs": [
				{
					"id": 761071701,
					"content": "Tôi không có ý định tuân theo quy tắc của Fatui các người!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071702
					]
				},
				{
					"id": 761071702,
					"content": "Không chịu tuân theo quy tắc thì biến khỏi đây ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
