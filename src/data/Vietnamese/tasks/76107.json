			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "Tôi chính là người đã chỉ dạy cho cô ấy đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "#Ồ! Tôi từng thu thập không ít báo cáo nghiên cứu của Viện Khoa Học Fontaine cho cô ấy. Cô ấy đã không ngớt lời khen ngợi thành quả nghiên cứu của tiến sĩ Mosso. Chẳng lẽ {F#cô}{M#cậu} chính là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071603,
					"content": "Khụ khụ... Mm-hmm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "Đ-đúng vậy, thì ra danh tiếng của tiến sĩ Mosso đã truyền đến tận đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Hừm, theo như tôi biết, tiến sĩ Mosso đã qua đời từ ba mươi năm trước rồi. Thế thì để hai người cũng nối gót theo vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610717,
