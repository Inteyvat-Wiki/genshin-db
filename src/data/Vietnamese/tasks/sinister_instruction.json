						721411202,
						721411203
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411202,
					"content": "Bạn vẫn ổn chứ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				},
				{
					"id": 721411204,
					"content": "\"Ngài\" đang tức giận, \"Ngài\" sắp nổi giận rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411205,
					"content": "Cái gì...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "Vì sao ư! Vì người con gái đó! Kẻ tà ác đã từ chối ân điển! Kẻ tà ác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411208,
					"content": "Người con gái...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "Cô ta đang chạy trốn, nhưng sao cô ta có thể trốn được \"Ngài\"! Mười tám cặp mắt đẫm máu! Hàng nghìn chiếc răng nanh sắc nhọn! Vô số miệng lưỡi khát máu!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411211,
					"content": "Cô ta không thể trốn được, không thể trốn được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411212,
					"content": "À, đất nước sa mạc bạc bẽo, kẻ ăn mày ngu ngốc tự xưng khôn ngoan trong rừng, các ngươi sẽ không bảo vệ được cô ta đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411213,
					"content": "Bạn bình tĩnh một chút!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "Bạn đã nhận được phần thưởng, hãy mau bái tế! Mau bái tế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411214,
					"content": "Ồ ồ, nói hay lắm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "Á à, thật đáng chết!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
					"content": "Ơ ơ, sắp nổi giận rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411203,
					"content": "Ồ ồ, \"Ngài\" đến rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
