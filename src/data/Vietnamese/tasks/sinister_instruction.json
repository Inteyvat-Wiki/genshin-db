					"speakerTitle": "Washizu"
				},
				{
					"id": 721410602,
					"content": "Chẳng nghe thấy gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				},
				{
					"id": 721410604,
					"content": "Không sao, không sao, \"Ngài\" đang nhìn, \"Ngài\" đang nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410605
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410605,
					"content": "\"Ngài\" rất hài lòng, và người làm \"Ngài\" hài lòng sẽ được thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410606,
					"content": "Phần thưởng của \"Ngài\" không ở bỉ ngạn, thì ở ngày mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410607,
					"content": "Ngươi có biết mình đang nói gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "Lần sau quay lại đây sẽ rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410608,
					"content": "Thứ cho tôi nông cạn, vẫn chưa hiểu được đạo lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410603,
					"content": "Không đủ phước phần, không đủ duyên để nghe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				}
			]
		},
