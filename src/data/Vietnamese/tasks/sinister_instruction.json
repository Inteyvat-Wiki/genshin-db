					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411102,
					"content": "\"Ngài\" vì biết lắng nghe mà lớn mạnh, vì lớn mạnh mà có thể nhìn thấy tất cả, nghe thấy tất cả. Cho nên không có gì là chưa từng thấy chưa từng nghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411103,
					"content": "Fatui của Quân Sangonomiya hay gã khờ của Đảo Narukami, đều không hiểu hoặc không cảm nhận được điều này. Vì vậy họ chỉ biết tàn sát lẫn nhau, để máu che mờ hai mắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411104,
					"content": "Nhưng bạn phải hiểu điều này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411105,
					"content": "Cái tào lao gì vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "Câu trả lời nằm ở bái tế.",
					"roleType": "TALK_ROLE_NPC",
