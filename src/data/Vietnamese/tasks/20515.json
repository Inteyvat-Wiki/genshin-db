			"dialogs": [
				{
					"id": 205150101,
					"content": "Anna lại chạy đi đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150102,
					"content": "Lại không tìm thấy Anna sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "Đúng vậy, tôi tìm khắp thành phố rồi, vẫn không tìm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150104,
					"content": "Bạn tìm giúp tôi với, tôi không đi nổi nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150105,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "Vậy nhờ cả vào bạn, con bé này, bệnh của nó sắp khỏi rồi, nhưng cứ tiếp tục như vậy thì tôi cũng sẽ bệnh mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150111,
					"content": "Đúng rồi... trước đây Anna nói, nó muốn đến Giáo Đường để cảm ơn tu nữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150112,
					"content": "Bạn đến những chỗ gần Giáo Đường xem sao, còn nữa, bạn có thể hỏi ngài Albert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150113,
					"content": "Ngài ấy thường ở gần Giáo Đường, nói không chừng ngài ấy biết gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150107,
					"content": "Nói không chừng đã trở thành Nhà Mạo Hiểm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "Không thể nào, không thể nào, sao có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150109,
					"content": "Bạn, sao bạn không nói gì vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				}
			]
		},
