			"dialogs": [
				{
					"id": 205040101,
					"content": "Chào mừng, bảo vật ở đây đảm bảo độc nhất vô nhị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040102,
					"content": "Nhiều thứ chưa nhìn thấy bao giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040103,
					"content": "Haha, đương nhiên rồi, đây toàn là những báu vật quý hiếm được các Nhà Mạo Hiểm đem về từ khắp nơi trên thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040104,
					"content": "Thế nào, có món nào vừa nhìn đã thích không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040105,
					"content": "Cảm giác xa xỉ quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "Không đâu không đâu, quên giới thiệu với bạn, ở đây đều là lấy vật đổi vật, không nhận Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040108,
					"content": "Gần đây tôi muốn làm một món đồ đặc biệt, cần lượng lớn <color=#00E1FFFF>Ấn Phong</color> để trang trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040109,
					"content": "Các bạn có <color=#00E1FFFF>Ấn Phong</color> không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040110,
					"content": "Tìm được vài cái.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "Haha, xem ra cuộc mạo hiểm của các bạn đã được Phong Thần chấp nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040114,
					"content": "Tóm lại, chỉ cần bạn có <color=#00E1FFFF>Ấn Phong</color>, là có thể đổi bất kỳ món hàng nào trong tiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040115,
					"content": "Chọn Món Hàng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "Đó là cái gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "Đó là một loại ấn ký, Phong Thần sẽ tặng nó cho những Nhà Mạo Hiểm được chấp nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040106,
					"content": "Tôi không dám nhìn giá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
