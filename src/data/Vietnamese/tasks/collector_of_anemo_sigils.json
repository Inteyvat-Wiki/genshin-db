					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "Haha, nhất định, đảm bảo sẽ làm bạn ngạc nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040312,
					"content": "Chào mừng quay lại, hy vọng lần sau bạn sẽ mang đến thật nhiều <color=#00E1FFFF>Ấn Phong</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040313,
					"content": "Nếu tìm thấy bảo vật gì hiếm cũng nhớ đem đến chỗ tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
