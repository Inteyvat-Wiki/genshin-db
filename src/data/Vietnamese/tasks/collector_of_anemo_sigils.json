				},
				{
					"id": 205040304,
					"content": "Haha, các bạn cũng thật nhạy bén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040305,
					"content": "Giải thích thì rất phức tạp, dùng để trang trí thì ai cũng dễ hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040306,
					"content": "Tôi chọn dùng <color=#00E1FFFF>Ấn Phong</color>, đương nhiên là có lý do đặc biệt.",
