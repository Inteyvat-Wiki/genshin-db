				},
				{
					"id": 205040302,
					"content": "Thật là chỉ dùng để trang trí sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "Đúng vậy, nói thế nào thì cũng là quà tặng của Phong Thần.",
