					"nextDialogs": [
						200700506
					]
				},
				{
					"id": 200700506,
					"content": "Vậy thì trông cậy vào bạn nhé, tôi ở đây chờ bạn, nhớ đi nhanh về nhanh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700507,
					"content": "Tôi để ở đâu rồi nhỉ...",
