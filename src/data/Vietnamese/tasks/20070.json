			"dialogs": [
				{
					"id": 200700201,
					"content": "Hoa như thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700202,
					"content": "Xin lỗi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700203
					]
				},
				{
					"id": 200700203,
					"content": "Hử? Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700204,
					"content": "Tôi lỡ làm hỏng bình và hoa rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700205
					]
				},
				{
					"id": 200700205,
					"content": "Làm, làm hỏng sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700206,
					"content": "Huhu...đó đều là những đóa hoa tôi chọn kỹ lưỡng, hoa đẹp như vậy khó tìm lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700207,
					"content": "Núi tuyết nguy hiểm như vậy sao? Ngay cả Nhà Mạo Hiểm như bạn mà cũng lỡ tay, ngay cả một hộp hoa cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700208,
					"content": "Nhưng dù sao cũng cảm ơn bạn đã đi giúp tôi chuyến này, cho bạn nè, hãy nhận nhé, tôi phải đi chăm sóc hoa trong tiệm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700209,
					"content": "Haiz, nếu không thì...tôi cứ dùng lại cách của Sara xem sao vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
