			},
			"dialogs": [
				{
					"id": 721520101,
					"content": "\"...Đây từng là nơi cất giấu kho báu của hải tặc Rinzou, mấy anh em đã mang những rương cuối cùng đi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Nhật Ký Của Đạo Bảo Đoàn"
				},
				{
					"id": 721520102,
					"content": "\"...Nhưng khi còn sống Rinzou rất xảo quyệt, đã để lại ký hiệu riêng ở nhiều nơi trên đảo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Nhật Ký Của Đạo Bảo Đoàn"
				},
				{
					"id": 721520103,
					"content": "\"...Có lẽ chỉ là che đậy, nhưng biết đâu cũng có kho báu thật, chỉ khi nào tìm hiểu đến cùng mới có thể xác định...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Nhật Ký Của Đạo Bảo Đoàn"
				},
				{
					"id": 721520104,
					"content": "\"...Chúng tôi đã phát hiện một số ký hiệu, không thể chần chờ nữa, phải đi khai quật toàn bộ kho báu của Rinzou thôi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Nhật Ký Của Đạo Bảo Đoàn"
				},
				{
					"id": 721520105,
					"content": "Ỏ...dài quá...ngoài hai chữ \"kho báu\" ra thì không muốn đọc gì hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Ơ...? Kho báu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "Nếu đã có kho báu thì chúng ta hãy nhanh chóng xuất phát thôi! Đừng để Đạo Bảo Đoàn giành trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}