			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "A, dấu chân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220202,
					"content": "Xem ra họ đã đi qua Thần Luật Quan, tiếp tục tiến về phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220203,
					"content": "Đi theo dấu chân sẽ tìm được chỗ của họ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
