			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "Cho hỏi có gặp thợ mỏ nào quanh đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220402,
					"content": "Tầm bốn năm ngày trước có vài người đi qua đây, trên lưng vác một cái sọt, còn mang theo cuốc sắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220403,
					"content": "Đúng đúng, đúng là bọn họ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220404,
					"content": "Bốn năm ngày trước? Xem ra họ không đi nhanh như chúng ta tưởng, có lẽ là bị địa hình của Thần Luật Quan gây trở ngại, tốn không ít thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220405,
					"content": "Ây da, bọn họ rất kỳ lạ, bốn người đàn ông cao lớn, mặt ai cũng đờ đẫn, cứ như là chưa tỉnh ngủ vậy! Phía trước còn có một đứa nhỏ đi loạng choạng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220406,
					"content": "Cô có thấy rõ dáng dấp của đứa trẻ đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220407,
					"content": "Chỉ nhìn lướt qua thôi, tóc xanh, lùn lùn... hình như là một bé gái! Trông nó rất nghiêm túc, chẳng có vẻ gì là vui đùa cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220408,
					"content": "Bọn họ đi đường này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220409,
					"content": "Phải, đi thẳng từ chỗ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220410,
					"content": "Chúng ta đuổi theo đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
