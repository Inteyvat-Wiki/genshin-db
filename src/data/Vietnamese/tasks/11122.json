			"dialogs": [
				{
					"id": 111220901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220902,
					"content": "Sao rồi? Anh ấy sẽ không chết chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220903,
					"content": "Anh ấy mệt mỏi quá độ, nên đã rơi vào hôn mê. May là không nguy hiểm đến tính mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220904,
					"content": "Sao anh ấy lại mệt đến nông nỗi này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "Vừa nãy tôi nghe anh ấy nói đào đào cái gì đó, có khi nào là do đào đến kiệt sức rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220906,
					"content": "Cũng có thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220907,
					"content": "Kỳ lạ thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "Ơ? Trong túi của anh ấy hình như có thứ gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220910,
					"content": "Đây là... một mảnh đá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220911,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220912,
					"content": "Các vị, tôi đã xem ký ức từ mảnh đá trong túi của anh ấy. Đó là đá được người này mang từ khu mỏ ra, có thể nói rằng, người này thực sự là một trong bốn người thợ mỏ mà chúng ta cần tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220913,
					"content": "Vậy thì việc anh ấy nằm ở đây lại càng thú vị hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220914,
					"content": "Bị người ta dẫn đi, sau đó... bị bỏ rơi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220915,
					"content": "Nhưng nếu đã muốn bỏ rơi anh ấy, thì tại sao lại phải đưa anh ấy đến tận nơi này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220916,
					"content": "Trừ phi đã xảy ra chuyện gì đó, khiến anh ấy không thể không bỏ đội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220917,
					"content": "Hừm...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220918,
					"content": "Không được, thần bí quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220919,
					"content": "A, đúng rồi! Nhìn thấy những mảnh đá này mới nhớ, tôi cũng có một số thứ muốn tặng mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220920,
					"content": "Cái gì cái gì, có quà hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220921,
					"content": "Tặng cho chúng tôi? Vì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220922,
					"content": "Không giấu gì các vị, trước khi gặp Lão Dai, tôi lúc nào cũng mơ hồ, nhưng khi phá án cùng các vị, thì suy nghĩ ngày càng trở nên rõ ràng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220923,
					"content": "Tôi luôn thầm vui mừng vì Lão Dai tìm mọi người giúp đỡ. Nếu chỉ dựa vào một mình tôi, e là không thể tra ra được nhiều manh mối như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220924,
					"content": "Đây là số pha lê tôi mua ở chợ, không phải là loại pha lê thông thường đâu, màu sắc của nó phải nói là cực kỳ hiếm thấy đó! Mỗi người một viên, xem như là làm kỷ niệm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220925,
					"content": "Đẹp quá đi, còn đổi màu nữa kìa! Nhìn góc này, nhìn góc kia... đều thấy khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220926,
					"content": "Xem ra rất quý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "Đừng khách sáo, hãy cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220929,
					"content": "Viên này cho ngài Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220930,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220931,
					"content": "Ơ? Sao, sao thế, không thích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220932,
					"content": "Không, sao lại không thích được. Chỉ là không ngờ sẽ nhận được quà trong thời khắc như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220933,
					"content": "Cám ơn, tôi sẽ giữ kỹ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220934,
					"content": "Cám ơn các vị đã nhận. Món quà tốt tặng cho bằng hữu biết trân trọng mới có ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220935,
					"content": "Nơi này có không ít đá tảng, mọi người nghỉ ngơi trước đi, tôi đi dạo xung quanh, sẵn tiện kiểm tra đá một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220936,
					"content": "Kun Jun đúng là thích đá thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220937,
					"content": "Khoáng thạch là kết tinh của đại địa, là sự lắng đọng của thời gian. Ở bên nó, tôi sẽ cảm thấy an tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220938,
					"content": "Mọi người cứ nghỉ ngơi, trước khi xuất phát gọi tôi nhé. Tôi chỉ đi xung quanh thôi, không đi xa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220939,
					"content": "Anh ấy đi một mình không sao chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "Không cần lo lắng, vừa nãy tôi đã quan sát xung quanh rồi, không có gì nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220941,
					"content": "#Đúng rồi, tôi có chuyện muốn nói với {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220942,
					"content": "Ồ? Nghe có vẻ nghiêm túc nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220943,
					"content": "#Nhà Lữ Hành, {F#cô}{M#cậu} có ấn tượng gì về Trấn Long Thạch không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220944,
					"content": "Không có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "Là loại khoáng thạch mà anh ấy tìm phải không, có gì đặc biệt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220946,
					"content": "Trấn Long Thạch là một loại khoáng thạch dùng để rèn vô cùng hiếm thấy. Pha lê mà ta thường thấy được hình thành dưới nhiệt độ cao, còn Trấn Long Thạch lại là kết tinh của phản ứng nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220947,
					"content": "Phản ứng nguyên tố có thể tạo ra vật thể sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220948,
					"content": "Ừm. Nhưng chỉ có một phần rất ít là có thể giữ được lâu dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220949,
					"content": "Trấn Long Thạch được sinh ra từ một trận đại chiến vào hàng ngàn năm trước. Khi đó, sức mạnh nguyên tố lớn mạnh va chạm, tạo thành kết tinh nguyên tố, sau khi kết thúc trận chiến, những viên đá này đã lưu lại một cách thần kỳ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220950,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220951,
					"content": "Nhưng dù sao cũng chỉ là vật thể kết tinh, số lượng quá ít, cũng không nổi tiếng. Hơn nữa, nó vốn đã bị khai thác sạch từ mấy trăm năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220952,
					"content": "Vì sao người Liyue hiện đại lại muốn tìm loại khoáng thạch đã sớm không còn tồn tại này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220953,
					"content": "Đúng ha! Nếu anh ấy đã biết đến sự tồn tại của loại đá này thì phải càng biết rõ nó đã bị khai thác sạch rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220954,
					"content": "Kỳ lạ thật... không làm sao hiểu được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220955,
					"content": "Những người làm ngành khai thác mỏ cũng sẽ có người cảm thấy hứng thú với Trấn Long Thạch. Nhưng những người muốn tìm đá mà không biết nguyên nhân vì sao như Kun Jun thì... cực kỳ hiếm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220956,
					"content": "Có lẽ anh ấy có ý định khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "Ý định khác... Là người xấu sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220958,
					"content": "Bây giờ rất khó để kết luận, chi bằng cứ bình tĩnh quan sát đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220959,
					"content": "Đừng quên, mục tiêu quan trọng nhất bây giờ là cứu những người thợ mỏ kia. Còn những chuyện khác sớm muộn gì cũng phải lộ ra chân tướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220960,
					"content": "Khoảng cách đến mục tiêu đang được rút ngắn. Tôi thấy chúng ta nên tiếp tục đi theo đường này, nếu đã tìm được một trong số họ tức là sẽ có thể tìm thấy những người còn lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220961,
					"content": "#Chờ {F#cô}{M#cậu} nghỉ ngơi xong, hãy gọi Kun Jun, rồi chúng ta tiếp tục điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220962,
					"content": "Còn về người thợ mỏ này, cứ tạm để trong doanh trại đã, chờ đến lúc giải quyết xong mới quay lại chăm sóc cho anh ấy. Để lại vài dòng cho Lão Dai, nếu anh ấy tìm đến thì cũng có thể kịp thời xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220927,
					"content": "Thật sự cho tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "Không phải anh ấy bị đưa đi rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
