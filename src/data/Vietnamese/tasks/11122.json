			"dialogs": [
				{
					"id": 111229901,
					"content": "Chờ đã, dưới đất có manh mối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229902,
					"content": "Chắc chắn là những thợ mỏ đó để lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229903,
					"content": "Chúng ta đến cổng ra của Thần Luật Quan đi. Nếu nơi đó không có dấu chân, tức là bọn họ vẫn ở trong Thần Luật Quan, nếu có manh mối mới thì tiếp tục tra xét.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
