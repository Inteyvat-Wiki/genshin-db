			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "Bọn quái này thật tàn bạo, chỉ cần đi qua là bị chúng phát hiện ngay, chẳng nói năng gì là xông thẳng vào... may là có các vị cứu tôi, xin cám ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220702,
					"content": "Tôi là Wanyu, chịu sự quản lý của Thịnh Lộ Đình Liyue, phụ trách việc nghiên cứu di tích lịch sử văn hóa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220703,
					"content": "Ây da? Không phải thợ mỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220704,
					"content": "Thợ mỏ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220705,
					"content": "Ừm, chúng tôi đang tìm bốn người đàn ông cao lớn, họ đều là thợ mỏ, mang theo dụng cụ khai khoáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220706,
					"content": "Hình như tôi đã gặp những người mà cô nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220707,
					"content": "Thật vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220708,
					"content": "Đúng vậy, hôm trước tôi xuất phát từ Nam Thiên Môn, muốn đi về phía Thần Luật Quan. Giữa đường có gặp một nhóm người, gồm một đứa bé và vài người lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220709,
					"content": "Có thể nói chi tiết hơn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "Tôi đi vội nên không nhìn kỹ. Không nhớ gì về đặc trưng dáng dấp cả... Xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220711,
					"content": "Vậy là đủ rồi, cám ơn cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220712,
					"content": "Có thể giúp được các vị là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220713,
					"content": "Vậy tôi xin phép đi trước nhé, tôi còn phải tham gia hội nghị học thuật, cám ơn các vị lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220714,
					"content": "Theo lời học giả đó nói, thì những người này có vẻ đang đi về hướng Nam Thiên Môn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220715,
					"content": "Nhưng có chắc chắn là cùng một nhóm người không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220716,
					"content": "Một nhóm người gồm trẻ con và người lớn, chắc cũng không phải chuyện thường gặp đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220717,
					"content": "Có vẻ rất thường gặp đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "Ơ...chuyện đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220719,
					"content": "Này, mọi người nhìn tảng đá bên kia đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220720,
					"content": "Ồ ồ, còn có chiêu này nữa sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220721,
					"content": "Không chừng dùng được, để tôi thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220722,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220724,
					"content": "Không sai, là cùng một nhóm người. Họ đã đi theo con đường này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220725,
					"content": "Cảnh tượng Kun Jun đọc ký ức của đá, dù có xem bao nhiêu lần cũng thấy thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220726,
					"content": "Cái gọi là bản lĩnh này, bình thường cũng không có đất dùng. Nhưng có thể giúp ngài Zhongli tiêu khiển thì cũng xem như có chút ý nghĩa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220727,
					"content": "Kun Jun đúng là kim chỉ nam của chúng ta! Có anh ở đây thật sự rất dễ xác định phương hướng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220728,
					"content": "Ha ha, phải không? Vậy coi như cũng không uổng công đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220729,
					"content": "Ừm, cảm giác này... giống như đang phá án vậy, thú vị thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220730,
					"content": "Thú vị thì thú vị, nhưng đừng quên phải cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220731,
					"content": "Bốn người đàn ông mặt mày đờ đẫn đi theo một đứa trẻ, trèo đèo lội suối, bất kể ngày đêm... Việc này tuyệt đối không đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220732,
					"content": "Ừ ừ! Nói cũng phải, ngài Zhongli đúng là thận trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220733,
					"content": "Ngoài ra, vị học giả đó vừa nãy bị Rồng Đất Nhỏ tấn công, nhưng quái vật này vốn dĩ không có khả năng tấn công mạnh như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220734,
					"content": "Có rất nhiều manh mối trên đường đi, và chúng dường như có sự kết nối với nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220735,
					"content": "Hôm trước các thợ đi về hướng Nam Thiên Môn. Từ nơi này đến đó phải đi qua một con đường núi nguy hiểm, giả sử đích đến của họ là Nam Thiên Môn thì có lẽ chúng ta vẫn đuổi kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220736,
					"content": "Ừ, xuất phát ngay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220737,
					"content": "Vừa nãy tôi đã để lại ký hiệu ở gần đây, lỡ như Lão Dai theo đến cũng có thể dựa vào những ký hiệu để tìm được chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220738,
					"content": "Không hổ danh là Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
