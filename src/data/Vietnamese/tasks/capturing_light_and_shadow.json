			"dialogs": [
				{
					"id": 790501501,
					"content": "Hihi, thành công rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501502,
					"content": "Các Giọt Nước Nhỏ trông rất vui, làm tôi cũng thấy ấm lòng ghê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501503,
					"content": "Chúng ta đã bảo vệ được kết tinh của tình bạn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "Ừm, bạn bè và tác phẩm của vị họa sĩ trong Ảo Cảnh Veluriyam đã được giữ ở trạng thái hoàn hảo nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501506,
					"content": "Hy vọng một ngày nào đó, anh ấy sẽ quay về gặp lại bạn bè và ngắm nhìn kiệt tác của mình để lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501507,
					"content": "Kể ra thì, phong cách của bức tranh này khá là đặc biệt... Thoạt nhìn thì không hề lộng lẫy, nhưng lại rất giàu tính nghệ thuật nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501508,
					"content": "Quan trọng là tôi cũng hiểu được. Nếu bắt chước phong cách này thì nói không chừng tôi cũng có thể vẽ ra một kiệt tác đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501509,
					"content": "Hội họa đỉnh cao cũng không nhất thiết phải phức tạp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "#Ừm! Nếu {NICKNAME} thấy được, thì có thể chụp lại bức bích họa này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501512,
					"content": "Như vậy là tôi sẽ có thể học hỏi kỹ thuật của vị họa sĩ đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501514,
					"content": "Khi tôi vẽ ra kiệt tác, nói không chừng cũng thu hút được Giọt Nước Nhỏ tới bầu bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501510,
