				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "Các ngươi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370302,
					"content": "Ngươi là Antei sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370303,
					"content": "Đúng vậy, là ta. Ta thấy... hơi kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370304,
					"content": "Ta nhớ ta cứ đuổi theo bọn người đó, sau đó rút lõi hạt nhân ném vào doanh trại. Sau đó vì bị thương khá nặng nên ta thấy buồn ngủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370305,
					"content": "Bây giờ tỉnh dậy thấy hai người, ta thấy khá tỉnh táo. Có phải ta sắp chết nên hồi quang phản chiếu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370306,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "Khoan nói những chuyện này đi. Các ngươi đến bắt ta về sao? Ta đã chứng minh sự trong sạch của mình rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370308,
					"content": "Là tên Khaenri'ah, bọn chúng đã lấy trộm sách trong thư viện. Mặc dù ta là vệ sĩ bảo kê tiếp đón bọn họ, nhưng ta tuyệt đối không bắt tay với bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370309,
					"content": "Ta đã lần ra được tung tích của sứ đoàn, đánh bại tất cả bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370310,
					"content": "Để ngăn chặn cơ quan khổng lồ của bọn chúng, ta đã tìm hiểu rất lâu. Cuối cùng ta gỡ bỏ lõi của nó, nhưng cũng vì vậy mà ta bị thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370311,
					"content": "Cỗ máy bị hỏng đè lên quyển sách bị mất. Ta không thể lấy nó ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370312,
					"content": "Jibashiri của Vương Quốc Đêm Trắng thật lợi hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370313,
					"content": "Các ngươi không phải Jibashiri hay thuộc hạ sao? Haiz, không sao. Lúc đầu Jibashiri cũng đều là dũng sĩ chống lại Rồng Biển Sâu, sau đó mới trở thành người thực thi pháp luật, phán quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370314,
					"content": "Lõi hạt nhân ở trong doanh trại. Nếu không tin lời ta, các ngươi có thể đến đó xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
