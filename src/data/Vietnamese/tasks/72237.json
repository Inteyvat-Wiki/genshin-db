			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370401,
					"content": "Ta nghe nói sứ giả của Đảo Narukami từng nói về sinh vật giống như chim. Có cánh, và có thể bay trên bầu trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370402
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370402,
					"content": "Thật mơ mộng, các ngươi có tưởng tượng được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370403
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370403,
					"content": "Cũng có người nói, chúng là sứ giả của thần, phái đến để truyền tải số phận con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370404
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370404,
					"content": "Nếu ai đó bị lưu đày và chết ở nơi hoang vu, thì con chim đó sẽ đến mổ xác người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370405
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370405,
					"content": "Ta bị mê hoặc bởi những sinh linh như vậy. Nếu sau này còn có cơ hội nhìn thấy bầu trời, ta nhất định sẽ nuôi một con chim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223705,
			"completionStepIds": [
				7223708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
