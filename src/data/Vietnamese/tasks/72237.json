							"7223708",
							"2"
						],
						"stepId": 7223708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370501,
					"content": "Các ngươi lấy được sách chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370502
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370502,
					"content": "Lấy được rồi. Antei thật sự vô tội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370503,
					"content": "Từ những lời nói lúc nãy, các ngươi không phải Jibashiri, hơi đáng tiếc nhỉ. Nếu không sẽ có thể chính thức công nhận ta vô tội ngay tại chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370504
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370504,
					"content": "Nếu không sẽ có thể chứng minh ta trong sạch ngay lập tức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370505
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370505,
					"content": "Bây giờ ta cảm thấy rất tỉnh táo, nhưng cảm giác mệt mỏi vì mất quá nhiều máu cũng rất thật. Có phải ta sắp chết nên hồi quang phản chiếu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370506
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370506,
					"content": "Ơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370507,
					"content": "Haiz, ta hỏi ngươi này, người lạ. Bị Vương Quốc Đêm Trắng kết tội oan thì có phải là tội không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370508
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370509
					]
				},
				{
					"id": 722370509,
					"content": "Nếu ta bây giờ, do tâm trí rối loạn, bị Tokoyo Ookami giữ lại như ảo ảnh tội lỗi. Như vậy có phải là tội không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370510
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370510,
					"content": "Ta có tội sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370511
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370511,
					"content": "Ngươi không có tội.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370512
					]
				},
				{
					"id": 722370512,
					"content": "#Này, {NICKNAME}, bạn nói chuyện phải cẩn thận. Nếu để hắn nhận ra... nhận ra điều đó, hắn sẽ biến mất đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370513,
					"content": "Ngươi chỉ là ảo ảnh của Antei để lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370514
					]
				},
				{
					"id": 722370514,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370515
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370515,
					"content": "Ngươi vô tội, ta sẽ cho mọi người biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370516
					]
				},
				{
					"id": 722370516,
					"content": "Haha, vậy sao. Thì ra ta chỉ là ảo ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370517
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370517,
					"content": "Thì ra ta vô tội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370518,
					"content": "Ảo ảnh của Antei bắt đầu tự nói chuyện...\\n\"Rốt cuộc ta đã vi phạm điều luật nào...Tại sao những người bất hạnh lại trông cậy vào thần linh?\\nNhững việc ta làm có ý nghĩa không, sự tận tâm của ta là để đổi lấy tội danh sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		}
	]
}