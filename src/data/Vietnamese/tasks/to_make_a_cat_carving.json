			"dialogs": [
				{
					"id": 220430301,
					"content": "Ừm, nhiêu đây chắc đủ rồi. Thật xin lỗi đã phiền bạn giúp đỡ... Những thứ này xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430302,
					"content": "Sau khi tài nghệ điêu khắc của tôi thành thạo, nhất định sẽ tặng bạn một tượng gỗ tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430303,
					"content": "Tiếp theo nên chạm khắc tư thế gì của ngài Guuji Đại Diện nhỉ...",
