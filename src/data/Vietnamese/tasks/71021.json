						710210106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210102,
					"content": "Dùng Phong Chi Dực đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210103
					]
				},
				{
					"id": 710210103,
					"content": "Bỏ đi, sau khi tôi đến Giáo Viện thì phải ở trong đó cả năm, hoàn toàn không ra ngoài chơi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210104,
					"content": "Hơn nữa ở Giáo Viện cũng không có cơ hội dùng Phong Chi Dực, kiến thức Phong Chi Dực của tôi đã chữ thầy trả thầy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210105,
					"content": "Muốn tôi dùng Phong Chi Dực bay qua, là tôi sẽ giữa đường đứt gánh rơi xuống nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210106,
					"content": "Thuê thuyền đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210107
					]
				},
				{
					"id": 710210107,
					"content": "Tôi cũng nghĩ vậy, tôi nhớ ở cảng Dornman có thể thuê tàu, nhưng nơi đó cũng xa quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210108,
					"content": "Cả đến cả đi không biết phải tốn bao nhiêu thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210109,
					"content": "Nhưng tôi cũng không thể tự mình đóng một chiếc, trong Giáo Viện cũng chưa từng dạy làm việc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
	]
