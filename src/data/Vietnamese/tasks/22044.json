			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "Nhà Lữ Hành, sao bạn lại đến đây? Bạn muốn đến khấn bái sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440102,
					"content": "Tượng gỗ của bạn sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "Ha ha, cũng xem như khá thuận lợi, nhưng phải điều chỉnh thêm về kích thước của tượng gỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440104,
					"content": "Dù sao theo ý tưởng ban đầu của tôi thì kích thước của tượng gỗ này tốt nhất không nên lớn hơn chiều dài bàn tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440105,
					"content": "Như vậy sẽ có thể dễ dàng cầm trên tay hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440106,
					"content": "Hơn nữa ngoại trừ tượng... tôi còn muốn làm thêm một số \"trang sức\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440107,
					"content": "Lúc trước tôi thấy người khác điêu khắc, ngoại trừ tượng thì còn khắc thêm một số trang sức để kết hợp với tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440108,
					"content": "Như hoa nè, động vật nè, hoặc là bệ đỡ có hoa văn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440109,
					"content": "Tôi cũng muốn làm một bệ đỡ trang trí cho mấy chiếc tượng gỗ này... Tuy nhiên do vấn đề về kích thước nên một tượng gỗ chỉ có thể mang kèm một món đồ trang trí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440110,
					"content": "Nhưng tôi nghĩ là có thể làm những món trang sức đó trở thành có thể tháo gỡ là được. Lúc đó khách hàng muốn loại trang sức nào thì tôi sẽ gắn món đó lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440111,
					"content": "Tôi muốn bắt đầu từ loại trang sức đơn giản, ví dụ như Cỏ Naku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440112,
					"content": "Nhà Lữ Hành, có thể phiền bạn hái ba nhánh Cỏ Naku về cho tôi tham khảo được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440113,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "Vậy thì nhờ bạn nhé, Nhà Lữ Hành. Sau khi hái được Cỏ Naku thì mau đem về cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440114,
					"content": "Tại sao là ba nhánh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "Ba nhánh thì tôi có thể quan sát ba loại trạng thái khác nhau của Cỏ Naku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440116,
					"content": "Như vậy thì tôi nhất định sẽ điêu khắc được dạng Cỏ Naku đẹp nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
