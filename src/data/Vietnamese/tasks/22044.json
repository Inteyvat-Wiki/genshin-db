			"dialogs": [
				{
					"id": 220440301,
					"content": "Ồ! Như vậy là đủ rồi, cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440302,
					"content": "Chốc nữa tôi sẽ nghiên cứu... xem thử làm sao để chạm khắc gỗ thành hình dạng Cỏ Naku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440303,
					"content": "Ừm, nếu tôi có thể chạm khắc ra món trang sức đẹp đẽ chút, chủng loại nhiều hơn thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440304,
					"content": "Không chừng có thể bán lẻ những món trang sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
