						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "Kỳ lạ thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200702,
					"content": "Mấy đứa có thấy không? Cái cây này vừa sáng lên một cái, rồi còn mấy thứ kia nữa... Tiếc là không phải cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200703,
					"content": "Vậy là thứ ở giữa kia là rễ của nó à? Tuy không rõ nguyên lý, nhưng giờ nhìn long lanh như vậy đẹp hơn hẳn so với vẻ ảm đạm trước kia đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200704,
					"content": "Bạn kể lại chuyện đã xảy ra...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "Khó tin thật... Nhưng đâu cần bịa chuyện để lừa ta, có vẻ lời người bạn Dòng Dõi Sương Nguyệt kia nói đều là thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200706,
					"content": "Nhưng đó chỉ là tàn ảnh quá khứ thôi. Kệ bọn họ hát hò hay nói chuyện gì đó, chẳng ảnh hưởng gì đến người câu cá như ta cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200707,
					"content": "Nói mới nhớ, hai cháu cũng là thợ săn kho báu nhỉ? Thứ các cháu vừa nhặt được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200708,
					"content": "Đây chính là <color=#00E1FFFF>Chứng Nhận Trí Giả</color> phải không? Trông như một chiếc lông chim bình thường nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200709,
					"content": "Nghe những thương nhân quen biết nói, nếu thu thập đủ năm <color=#00E1FFFF>Chứng Nhận Trí Giả</color> là có thể tìm được \"Kho Báu Vĩ Đại\" gì đó được chôn ở Phía Đông Của Mặt Trăng, Phía Tây Của Mặt Trời. Không biết là thật hay giả.",
