			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "Woa... Ở đây có nhiều thứ nhỏ bé lấp lánh từng thấy trước đó này. Mà rốt cuộc chúng ta đang ở đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200302,
					"content": "Không lẽ chúng ta đã vòng xuống ngay dưới cái cây kỳ lạ đó rồi sao? Những thứ xanh xanh kia là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
