					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "#Được rồi, em tha thứ cho {F#chị}{M#anh}. Cái này cho {F#chị}{M#anh}, là Bánh Khoai Tây Mondstadt em thích ăn nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480305,
					"content": "Phải yêu thương thế giới này... mẹ em đã dạy như vậy.",
					"roleType": "TALK_ROLE_NPC",
