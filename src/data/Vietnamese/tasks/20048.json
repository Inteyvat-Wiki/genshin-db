				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "#Oa! Lại là {F#chị}{M#anh}! Bồ câu lại bay đi hết mất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480102,
					"content": "#Em còn đang cho chúng ăn, {F#chị}{M#anh} làm gì vậy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480103,
					"content": "Xin lỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "Mẹ em nói, xin lỗi cần hành động thực tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480105,
					"content": "Bồ câu trên cầu là bạn tốt của em, em đang cho chúng ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480106,
					"content": "Nhưng gần đây những con vịt thường đến cướp đồ ăn, làm cho chúng không được ăn no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480107,
					"content": "#Em muốn nhờ {F#chị}{M#anh} giúp tìm 3 phần tiểu mạch đến, cho bọn vịt ăn, em cũng sẽ ở trên cầu cho bồ câu ăn no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480108,
					"content": "Sau khi ăn no hết, bọn chúng nhất định sẽ thân thiện với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480109,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "Vậy làm phiền rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480112,
					"content": "#Nếu đối xử tốt với động vật, {F#chị}{M#anh} cũng có thể làm bạn với chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480110,
					"content": "#{F#Chị}{M#Anh} không muốn làm bạn với bồ câu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "#Bất kể có muốn làm bạn không... {F#chị}{M#anh} đều phải xin lỗi chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480114,
					"content": "Cho nên, mau đi tìm tiểu mạch đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
