					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480302
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480302,
					"content": "Lần sau khi đi qua, nhớ đừng dọa bồ câu nữa, chúng khó khăn lắm mới chịu quay lại.",
					"roleType": "TALK_ROLE_NPC",
