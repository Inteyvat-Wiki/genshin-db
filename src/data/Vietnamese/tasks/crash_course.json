			"dialogs": [
				{
					"id": 3071101,
					"content": "Đến rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071102,
					"content": "Này, đến gần chút. Ngửi thấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071103,
					"content": "...không ngửi thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "Trong <color=#00E1FFFF>Đền Thần</color> này xảy ra một số chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071106,
					"content": "Liên kết ma lực của Slime, Hilichurl... còn có... Phong Ma Long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071107,
					"content": "Haha, ở trong đó chắc rất náo nhiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071108,
					"content": "Sẽ rất nguy hiểm chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "Ừm... náo nhiệt thì náo nhiệt, nhưng không nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071112,
					"content": "Thật đáng tiếc, Đền Sói Bắc Phong nay lại bị thứ này làm phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071113,
					"content": "#Chúng ta đi thôi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071114,
					"content": "Tuy là đã không còn ai bái tế Tứ Phong Thủ Hộ, nhưng ngọn gió cổ xưa sẽ không biến mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071115,
					"content": "Đến lúc giúp Tứ Phong Thủ Hộ thanh tẩy môi trường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071110,
					"content": "Chỉ là một đám lóc nhóc thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "Ồ! Phát ngôn rất có khí phách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071104,
					"content": "Là mùi Slime Hỏa bị cháy khét.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				}
			]
		},
