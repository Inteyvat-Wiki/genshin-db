			"dialogs": [
				{
					"id": 3071501,
					"content": "Ồ! Thật là tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071502,
					"content": "Hóa ra các hạ là một chiến sĩ đã qua đào tạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071503,
					"content": "Lúc nãy ở trong đền, phong cách chiến đấu quả thật khiến người khác mở rộng tầm mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071504,
					"content": "Quá khen rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "Hahaha. Đến tính \"khiêm tốn\" của kỵ sĩ cũng đã trang bị đủ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071507,
					"content": "Sự anh dũng giải cứu Mondstadt của các hạ, trong tương lai sẽ được truyền khắp thành phố tự do này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071508,
					"content": "Sau này nếu có rảnh rỗi, hãy đến tổng bộ Đội Kỵ Sĩ nói chuyện nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071509,
					"content": "Ừm... hoặc là, tôi cũng biết một quán rượu khá ngon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071505,
