			"dialogs": [
				{
					"id": 718190301,
					"content": "Chuyện gì thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190302,
					"content": "Về quà Tết Hải Đăng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "Đây chắc là đồ tổng vụ tặng phải không. Cám ơn nhé, tôi sẽ nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190304,
					"content": "Nhưng tôi vẫn phải túc trực ở đây thêm một thời gian nữa, kẻo có cư dân đến lấy nước trong dịp Tết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190305,
					"content": "Haiz, không biết nước giếng này bị gì nữa...nhưng chắc chắn không uống được rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyi"
				}
			]
		},
		{
			"id": 7181904,
			"completionStepIds": [
				7181905
			],
