			"dialogs": [
				{
					"id": 718190701,
					"content": "Bạn về rồi à, việc phát quà như thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190702,
					"content": "Đã phát xong cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "Cám ơn nhé, thực sự quá bận rộn...không có bạn chắc tôi làm không kịp mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190704,
					"content": "Cả dịp lễ họ đều không nghỉ phép sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "Chuyện này...haiz, tuy tổng vụ cũng sẽ sắp xếp các Thiên Nham Quân thay phiên trực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190706,
					"content": "Nhưng Liyue rộng lớn quá, những nơi cần phải canh gác và đi tuần cũng quá nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190707,
					"content": "Ngay cả luân phiên trực thì vẫn không đủ người, nên vẫn sẽ có người bắt buộc phải trực vào dịp tết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190708,
					"content": "Vả lại, Tết Hải Đăng năm nào cũng hoành tráng, vì thế vào dịp này, áp lực công việc ở một số nơi lại lớn hơn, sắp xếp nhân lực như thế nào cũng không đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190709,
					"content": "Vậy thì cũng vất vả thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "Không đâu, đây là việc chúng tôi phải làm...chỉ cần Tết Hải Đăng diễn ra suôn sẻ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190712,
					"content": "Đúng rồi, trong Tết Hải Đăng thực ra có rất nhiều người cần giúp đỡ, nếu bạn đồng ý, có thể đi giúp họ thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190713,
					"content": "Nếu có thể giúp nhiều người tham gia Tết Hải Đăng hơn nữa, thì bầu không khí chắc chắn sẽ thêm phần sôi động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190714,
					"content": "Sở dĩ chúng tôi \"tặng Đèn Tiêu\" cũng vì hy vọng mỗi người đều có thể thả một chiếc Đèn Tiêu, ước nguyện cho chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190715,
					"content": "Nếu nói rộng hơn một chút... chính là đem \"Tết Hải Đăng\" đi khắp mọi nơi, để tất cả mọi người đều có thể cảm nhận được bầu không khí của Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190716,
					"content": "Dù sao Tết Hải Đăng cũng là ngày lễ của tất cả mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190717,
					"content": "Được rồi, tôi còn có việc phải làm nên đi trước đây, chúc bạn chơi Tết Hải Đăng vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190710,
					"content": "Vất vả cho các bạn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
