			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "Sao rồi, đã lấy được Đèn Tiêu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190602,
					"content": "Lấy được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "Để tôi xem thử...đúng là chiếc đèn này rồi, cám ơn bạn nhé, tôi sẽ mang về cho bọn trẻ ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190604,
					"content": "Lâu quá rồi, không biết hai đứa nó có còn chờ ở đó không nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190605,
					"content": "Về món quà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "Chắc đây là quà Tổng Vụ tặng phải không, tôi sẽ nhận, cám ơn bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190607,
					"content": "Đây cũng là trách nhiệm của Thiên Nham Quân sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "Ý bạn là việc giúp đỡ lấy Đèn Tiêu sao? Ha ha ha, đương nhiên cũng tính là trách nhiệm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190609,
					"content": "Bất luận là nhặt đèn hay đuổi người xấu, hay tiêu diệt ma vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190610,
					"content": "Giúp người cần giúp, đều là trách nhiệm của Thiên Nham Quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190611,
					"content": "Được rồi, cám ơn bạn lần nữa. Tôi phải mau chóng trở về đưa Đèn Tiêu cho bọn trẻ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190612,
					"content": "Rồi còn tiếp tục xử lý việc khác nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
