			"trigger": {
				"objectNames": [
					"Wang'ya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "Haiz...đúng là làm mãi không hết việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "Không có gì, tôi đang sắp xếp lại những chuyện cần xử lý trong thời gian Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190104,
					"content": "Chỉ là...càng sắp xếp thì càng nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190105,
					"content": "Tuy những đồng nghiệp khác đều giúp tôi một tay, nhưng năm nay đến lượt tôi dẫn đội đi tặng Đèn Tiêu, phải nhanh chóng chuẩn bị cho xong đồ đạc mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190106,
					"content": "Tặng Đèn Tiêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "Đúng rồi... Chắc bạn không biết, \"tặng Đèn Tiêu\" mà tôi nói không phải là việc tặng đèn cho người khác như bình thường đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190109,
					"content": "Nói cho dễ hiểu, thì giống như đi chúc tết, đi tạo không khí vậy đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190110,
					"content": "Ví dụ trong Tết Hải Đăng, tuy đa phần người ta đều về nhà ăn tết, hàng quán cũng nghỉ bán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190111,
					"content": "Nhưng để duy trì trật tự trong những ngày lễ tết, thì vẫn phải xử lý một số việc, và một số Thiên Nham Quân cũng phải trực xuyên suốt dịp lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190112,
					"content": "Tổng vụ cũng sẽ sắp xếp người đến tặng quà cho họ trong thời gian Tết Hải Đăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190113,
					"content": "Hôm nay tôi đang chẩn bị \"tặng Đèn Tiêu\" cho Thiên Nham Quân canh gác trong thành nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190114,
					"content": "Nhưng...người của tôi không đủ, một số món quà đã mang đi tặng rồi, nhưng vẫn còn một số món chưa kịp tặng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190115,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi tặng số quà này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190116,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "Bạn đồng ý giúp sao? Thật tốt quá, vậy thì nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190118,
					"content": "Phải tặng cho ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "Để tôi xem... Thiên Nham Quân chưa được tặng là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190120,
					"content": "Xiangming...Hongyi...và Cai Le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190121,
					"content": "Tôi đánh dấu vị trí của họ cho bạn nhé, nhờ vào bạn cả đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190107,
					"content": "Phải tặng cho rất nhiều người đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
		{
