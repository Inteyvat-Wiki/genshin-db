			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yi Xian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190401,
					"content": "Hu hu...em, em vẫn chưa viết xong nguyên vọng...hu hu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190402,
					"content": "Bé Xian ngoan, chú Thiên Nham Quân đã giúp em lấy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190403,
					"content": "Về Cai Le...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "#{F#Chị}{M#Anh} đang tìm chú Thiên Nham Quân phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190405,
					"content": "Ban nãy Bé Xian đang viết nguyện vọng lên Đèn Tiêu thì lỡ tay làm đèn bay mất, nó bay về hướng bên kia kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190406,
					"content": "Chú Thiên Nham Quân đó nói thấy Đèn Tiêu bị mắc trên cây, chú ấy đi lấy giúp chúng em rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190407,
					"content": "Ngọn Đèn Tiêu đó đặc biệt lắm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "Em cũng nói như thế với Bé Xian, nhưng em ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190410,
					"content": "Huhu...không...không chịu đâu, đó là anh trai đã làm cho em, phải làm lâu lắm mới xong đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190411,
					"content": "Bé Xian ngoan, chú Thiên Nham Quân sẽ về nhanh thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190412,
					"content": "#Xin lỗi, nếu {F#chị}{M#anh} tìm chú Thiên Nham Quân gấp thì cứ đến bên đó tìm thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
