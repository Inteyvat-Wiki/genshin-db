			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "Ơ? Có chuyện gì sao, tôi đang làm nhiệm vụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190202,
					"content": "Về quà Tết Hải Đăng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "Nhỏ tiếng một chút! Tôi đang làm nhiệm vụ, quà gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190204,
					"content": "Là do Tổng Vụ bảo bạn đem đến? Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190205,
					"content": "Haiz, lại là một cái Tết Hải Đăng, vốn dĩ năm nay tôi còn muốn về nhà sớm một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190206,
					"content": "Nhưng xem tình hình, chắc tôi không thể thảnh thơi rồi... lại phải về nhà muộn mấy ngày rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190207,
					"content": "Cảm ơn, phiền bạn rồi, hãy nhận lấy thứ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190208,
					"content": "Haiz, rốt cuộc tên đó khi nào mới đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangming"
				}
			]
		},
