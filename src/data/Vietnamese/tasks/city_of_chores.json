			"dialogs": [
				{
					"id": 718190501,
					"content": "Haiz...làm sao leo lên đó được đây, hừm...phải tìm cách khác thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190502
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190502,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "Nhà Lữ Hành? Ha ha, không sao không sao, tôi đang tìm cách leo lên để lấy chiếc Đèn Tiêu đó xuống thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190504,
					"content": "Nhưng cái cây này khó leo thật, tôi mặc giáp thế này, leo cứ bị tuột xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190505,
					"content": "Bạn có thể giúp tôi lên đó lấy Đèn Tiêu xuống không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190506,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "Được, nhờ bạn vậy, đứa bé đó sắp khóc quấy lên rồi, phải nhanh chóng mang đèn về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
