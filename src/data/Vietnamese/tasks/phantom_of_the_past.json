					"nextDialogs": [
						705120504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120504,
					"content": "Hừng hực khí thế! Không lẽ đây là trạng thái biến hình đầy đủ hỏa lực nhất của Diluc sao!",
					"roleType": "TALK_ROLE_NPC",
