			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "Chào hai vị, lâu rồi không gặp, trông vẫn phấn chấn thật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120202,
					"content": "Xin chào, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120203,
					"content": "Hai vị đến tìm lão gia Diluc để bàn công chuyện sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120204,
					"content": "Chỉ là vì nước ép nho thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "Đúng vậy, sẵn tiện rồi tôi nhờ tiểu thư Adelinde luôn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120207,
					"content": "Tiểu thư Adelinde, chúng tôi đã bỏ lỡ món nước ép nho đặc biệt của tửu trang rất nhiều lần rồi, nên lần này chúng tôi muốn đến sớm để đặt trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120208,
					"content": "Chúng tôi có thể trả thêm một chút tiền đặt cọc, hãy cho chúng tôi đặt trước một chai nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120209,
					"content": "Đương nhiên là được rồi, không cần cọc tiền đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120210,
					"content": "Có điều hai vị cần phải chờ chút. Nước ép nho đặc biệt của Tửu Trang Dawn cần khá nhiều thời gian để chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120211,
					"content": "Mùa hè hằng năm, lão gia Diluc đều sẽ đích thân lựa chọn hai thùng nho ngon nhất để làm nước ép nho với giá ưu đãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120212,
					"content": "Tại sao phải bán sản phẩm tốt với giá thấp chứ? \"Nho thượng hạng\", rõ ràng nghe rất quý giá mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120213,
					"content": "Lão gia chưa từng giải thích rõ bao giờ, tôi cũng chỉ có thể suy đoán về suy nghĩ của lão gia thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120214,
					"content": "Khuyến mãi chỉ là một chiêu trò, các mặt hàng được khuyến mãi luôn thu hút nhiều khách hàng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120215,
					"content": "Có lẽ lão gia muốn dùng cách này để làm cho nước trái cây trở nên phổ biến và đem đến cho mọi người một lựa chọn mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120216,
					"content": "Những con sâu rượu có thể dùng món này để thay thế, như vậy là sẽ không gặp rắc rối sau khi say rượu, và những người không thể uống rượu cũng sẽ có thể dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120217,
					"content": "Việc kinh doanh của tửu trang sẽ không bị ảnh hưởng chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "Lão gia không phải là người quan tâm đến số tiền ít ỏi đó. Có lẽ, thay vì cố gắng tăng trưởng doanh thu thì anh ấy muốn mọi người uống có chừng mực hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120220,
					"content": "Thưởng thức rượu ngon và cuộc sống trong khi vẫn tỉnh táo và không gây rắc rối cho người khác... thật tuyệt phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120221,
					"content": "Diluc đúng là có ý tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120222,
					"content": "Vậy là bây giờ Diluc đang lựa nho cho năm nay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120223,
					"content": "Tạm thời vẫn chưa. Đợi lão gia xử lý xong chút chuyện rắc rối rồi mới bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120224,
					"content": "Nếu hai vị có hứng thú, có lẽ lão gia cũng sẽ xin ý kiến từ chỗ hai vị đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120225,
					"content": "Chuyện rắc rối?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "Hai vị cũng biết đó, hễ lão gia nghe được tin là sẽ đi \"chiêu đãi\" bọn thô lỗ vô đạo đức đó ngay, và lần này cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120227,
					"content": "Hôm nay có lẽ lão gia sẽ đến chỗ Bờ Biển Falcon, hai vị đừng sốt ruột, cứ vào đây ngồi nghỉ một lát nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120228,
					"content": "Tôi còn phải ở đây đợi khách, Hillie và Moco sẽ tiếp đãi hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120229,
					"content": "Thô lỗ... vô đạo đức? Không hiểu ý của tiểu thư Adelinde cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120230,
					"content": "Tôi nghĩ, đó là \"việc làm thêm\" của Diluc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "Hả? Lẽ nào là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120232,
					"content": "Khụ khụ! Đối phó với Giáo Đoàn Vực Sâu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120233,
					"content": "Thân là đồng đội của Diluc, chúng ta không thể khoanh tay đứng nhìn được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120238,
					"content": "Nếu hai vị đồng ý giúp thì tốt quá, dù sao hai vị cũng là người có thực lực và được lão gia tin tưởng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120239,
					"content": "Cảm ơn hai vị đã chủ động giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120240,
					"content": "Không có gì! Diluc xong việc càng sớm thì chúng tôi cũng sẽ mua được nước ép nho sớm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120241,
					"content": "#Đi thôi, {NICKNAME}, chúng ta đến Bờ Biển Falcon xem xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120234,
					"content": "Vậy chúng ta vào chờ Diluc trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "Ừm, tôi thấy Diluc đang bận mà chúng ta lại ngồi không ở đây thì không hợp lý cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120236,
					"content": "Chúng ta đến Bờ Biển Falcon giúp Diluc giải quyết rắc rối vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120237,
					"content": "Mặc dù Diluc rất mạnh, nhưng nếu có thêm nhiều người giúp đỡ vẫn sẽ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120218,
					"content": "Vậy là mở rộng thêm ngành nghề sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "Hình như không được tính là chuyện quan trọng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "Có vẻ như không giống doanh trại của Diluc, không lẽ là của nhà mạo hiểm khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120402,
					"content": "Bên đó có một tờ giấy và một quyển nhật ký? Chúng ta đọc thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120403,
					"content": "Gửi \"Anh Hùng Bóng Đêm\", hiện tượng kỳ lạ năm đó đã xuất hiện trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 705120404,
					"content": "Vốn dĩ vấn đề đã được giải quyết, nhưng lần này địa mạch lại bị kích hoạt, và ma vật trong bản ghi chép lại được thả ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 705120405,
					"content": "Phải mau chóng đến đây để xử lý lũ ma vật đang hoành hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 705120406,
					"content": "Tôi đã tuân theo quy tắc hành động và thông báo trước cho những người cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "Điều tra"
				},
				{
					"id": 705120407,
					"content": "Ừm... cách nói trong tờ giấy này hình như là người quen của Diluc, tạm gọi là \"bạn của Diluc\" trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120408,
					"content": "Người này phát hiện ra điều gì đó không bình thường nên đã để lại mảnh giấy này cho Diluc và rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120409,
					"content": "Thật bất cẩn, nếu như mảnh giấy này bị người khác nhìn thấy thì phải làm sao đây? Cả nhật ký cũng không chịu mang đi luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120410,
					"content": "Nhưng nếu nói như vậy, địa mạch tắc nghẽn bất thường trên bãi biển kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120411,
					"content": "Là \"hiện tượng kỳ lạ\" mà anh ta nói nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "Xung quanh không có ma vật, cũng đâu có gì bất thường đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME} có muốn đọc thử nhật ký của người đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120414,
					"content": "Nếu không muốn đọc thì chúng ta đành phải thử tiếp cận bên kia vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
