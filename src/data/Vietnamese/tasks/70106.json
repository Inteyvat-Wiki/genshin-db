			"dialogs": [
				{
					"id": 701060201,
					"content": "Về Thịt Tươi Lạnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Số Thịt Tươi Lạnh này trông có vẻ rất ngon...ừm, vậy là chỉ còn thiếu một loại nguyên liệu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060203,
					"content": "Bạn có nghe nói về \"Vua Heo Tuyết\" chưa? Nghe nói đó là mãnh thú sống ở sâu trong núi tuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060204,
					"content": "Tôi thấy một số công thức chỉ ra rằng thịt của Vua Heo Tuyết ngon vô cùng, chiên xào hay nấu, hầm gì cũng ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060205,
					"content": "Nhà Lữ Hành, phiền bạn đi một chuyến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060206,
					"content": "Chuyện thù lao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "Đừng lo, tôi sẽ chuẩn bị thù lao hậu hĩnh cho bạn. Vậy thì trông cậy vào bạn nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
