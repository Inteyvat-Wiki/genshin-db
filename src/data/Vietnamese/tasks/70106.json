			"dialogs": [
				{
					"id": 701060101,
					"content": "Chỉ thiếu mấy nguyên liệu này nữa thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "A? Là Nhà Lữ Hành sao? Tôi đang suy xét đến một \"công thức cổ xưa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060104,
					"content": "Cách đây không lâu, có một đội thám hiểm đi vào núi tuyết, tôi có quen một Nhà Mạo Hiểm trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060105,
					"content": "Do thời tiết khắc nghiệt nên họ chẳng thám hiểm được bao xa, nhưng người đó nói, trong lúc họ nấp bão tuyết, thì vô tình đụng phải một di tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060106,
					"content": "Bên trong đều là sách, bọn họ còn phát hiện được một... công thức nấu ăn trong đó, không ngờ có thể lưu giữ nguyên vẹn như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060107,
					"content": "Nhà Mạo Hiểm đó giao công thức này cho tôi, nhờ tôi thử khôi phục lại \"món ngon thời cổ đại\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060108,
					"content": "Nói thật, rất nhiều nguyên liệu trong công thức ấy tôi chưa từng nghe nói đến, một số cách làm cũng là mới nghe lần đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060109,
					"content": "Vì vậy tôi đã tự sửa đổi công thức một chút, chỉ giữ lại vài nguyên liệu trọng tâm đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060118,
					"content": "Nếu bạn đồng ý, có thể giúp tôi tìm những nguyên liệu đặc biệt đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060110,
					"content": "Cứ giao cho tôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "Ồ, có khí thế ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060113,
					"content": "Nghe nói một số heo con đi lạc vào núi tuyết cũng bị đóng băng, tôi nghĩ... mùi vị của số thịt heo này, có lẽ sẽ rất mới lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060114,
					"content": "Vì thế tôi muốn nhờ bạn tìm heo con bị đóng băng, lấy 10 phần Thịt Tươi Lạnh về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060115,
					"content": "Thịt Tươi Lạnh là gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "À, là tên mà tôi đặt cho thịt của những con heo đó. Thịt heo tươi ngon được trữ đông trong băng tuyết, không phải là \"Thịt Tươi Lạnh\" sao? Ha ha ha, tên này hay lắm phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060117,
					"content": "Vậy trông cậy vào bạn đó, sau khi tìm đủ nguyên liệu hãy mang về cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060112,
					"content": "Cần nguyên liệu gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
