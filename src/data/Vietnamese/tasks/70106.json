				},
				{
					"id": 701060304,
					"content": "Tôi thấy một số công thức chỉ ra rằng thịt của Vua Heo Tuyết ngon vô cùng, chiên xào hay nấu, hầm gì cũng ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060305
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060305,
					"content": "Này... có phải miếng thịt này không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060306
					]
				},
				{
					"id": 701060306,
					"content": "A? Cái này... bạn lấy ở đâu thế? Trùng hợp vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060307
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060307,
					"content": "Nhưng như vậy thì... đã đủ nguyên liệu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060308
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060308,
					"content": "Tranh thủ lúc bạn đi tìm nguyên liệu, tôi cũng đã sắp xếp lại công thức. Nó khá là khác với \"công thưc cổ xưa\" đó...ha ha ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060309
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060309,
					"content": "Nhưng cho dù cách làm thế nào, chỉ cần ngon là được rồi. Tôi đặt tên món này là \"Thịt Hầm Sốt Rau Củ\", làm cũng tiện...bạn có muốn thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060310
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060310,
