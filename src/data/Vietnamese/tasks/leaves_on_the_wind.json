			"dialogs": [
				{
					"id": 207030501,
					"content": "Bạn có phát hiện ra gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030502,
					"content": "Tôi tìm thấy vài chiếc lá cây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "...Lá cây? Cho tôi xem nào, bạn còn đặt chúng vào trong chiếc hộp này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030504,
					"content": "Khi cầm những chiếc lá này trong tay, thực sự có thể cảm nhận được \"Phong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030505,
					"content": "Không ngờ cái cây đó lại có loại sức mạnh này... nếu tôi có Vision thì sẽ không cần lãng phí quá nhiều thời gian như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030506,
					"content": "Cảm ơn bạn, đây là những tư liệu rất quý giá, tôi sẽ sử dụng nó thật tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030507,
					"content": "Có điều tôi không có cách nào bảo quản những chiếc lá này, có lẽ \"Phong\" sẽ biến mất rất nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030508,
					"content": "Đây là thù lao của bạn, có lẽ lần tới lại phải nhờ bạn giúp tôi thu thập tư liệu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr.Edith"
				}
			]
		}
