					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030303,
					"content": "Bạn có thể nhìn thấy \"nguyên tố\" phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030304,
					"content": "Tôi nghĩ là chỉ cần theo dấu vết của \"Phong\" tìm kiếm là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030305,
					"content": "Tôi chờ bạn ở dưới gốc cây, nếu tìm thấy gì thì hãy mang xuống cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
