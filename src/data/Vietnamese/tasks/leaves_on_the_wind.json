			"trigger": {
				"objectNames": [
					"Dr.Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "...Thứ này không thể sử dụng làm tư liệu để sáng tác, thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "Tôi đang ở đây tìm cảm hứng để viết một cuốn sách mới với chủ đề về \"gió\", thuật lại lịch sử của Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030104,
					"content": "Ở đây không chỉ có Thất Thiên Thần Tượng tượng trưng cho gió, còn có gốc cây liên quan đến vị anh hùng vĩ đại Vennessa, ở nơi này thực sự rất phù hợp để tìm cảm hứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030105,
					"content": "Nhưng nói ra thật buồn cười, vì tôi không có Vision nên cho dù muốn tìm kiếm hay tập hợp gió lại cũng là điều thực sự khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030106,
					"content": "Cái gọi là tìm cảm hứng cũng chẳng qua là đứng ngây người ở chỗ này. Tư liệu tôi có được cũng chỉ là một số tài liệu được tổng kết từ sách vở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030107,
					"content": "Trên đại lục này, người không có Vision là như thế, làm việc gì cũng luôn mất nhiều công sức hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030108,
					"content": "Không có Vision, không thể dùng sức mạnh nguyên tố... cho dù là nghiên cứu hay sinh sống, đều trông giống như người ngoài cuộc trong cái thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030109,
					"content": "Hahaha, có lẽ trong mắt của Thần, những người có Vision mới là nhân vật chính của thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030110,
					"content": "Xin lỗi, tôi đã nói quá nhiều. Mặc dù là nói như vậy, nhưng tôi sẽ không từ bỏ việc nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030111,
					"content": "Tôi không có Vision, nhưng trình độ học vấn thì tuyệt đối không thể thua kém người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030112,
					"content": "Mà tôi nghe nói, bạn mặc dù không có Vision, nhưng vẫn có thể nhìn thấy nguyên tố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030113,
					"content": "Nếu có được thứ gì đó có Nguyên Tố Phong, chắc chắn sẽ giúp ích cho việc nghiên cứu của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030114,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi tìm kiếm trên cây đại thụ đó được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr.Edith"
				}
			]
		},
