			"dialogs": [
				{
					"id": 207030401,
					"content": "Phải nói rằng, người như bạn đây rõ ràng là phù hợp hơn với việc nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030402,
					"content": "Vừa có kinh nghiệm mạo hiểm, lại có thể lực tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030403,
					"content": "Quan trọng nhất là, tuy bạn không có Vision, nhưng bạn vẫn có thể điều khiển sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030404,
					"content": "Nguyên tố... trên vùng đất này không có việc nghiên cứu nào không cần dùng đến nguyên tố. Đối với học giả mà nói, có thể điều khiển nguyên tố thực sự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dr.Edith"
				},
				{
					"id": 207030405,
					"content": "À, tôi lại lẩm bẩm một mình rồi... xin lỗi, bạn đừng để ý nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
