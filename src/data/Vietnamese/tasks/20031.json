					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "Hì hì, vậy chúng tôi không khách sáo nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310502,
					"content": "Cứ nhận đi, đây là cách Hiệp Hội Nhà Mạo Hiểm thể hiện sự biết ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310503,
					"content": "Vì mỗi ngày hiệp hội đều nhận được rất nhiều ủy thác, nếu không phải được các Nhà Mạo Hiểm giúp đỡ, thì sẽ không có cách nào hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310504,
					"content": "Mỗi ngày khi bạn hoàn thành đủ số lần ủy thác, thì có thể đến chỗ tôi nhận thêm một phần quà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310505,
					"content": "Trong \"Bằng Chứng Mạo Hiểm\" sẽ ghi nhận số lần hoàn thành hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310506,
					"content": "Phải nhớ nhận thưởng trong ngày, vì số lượng có hạn, nếu bỏ lỡ sẽ không thể phát bổ sung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310507,
					"content": "Hiểu rồi, cảm ơn bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "Đừng khách sáo, tôi phải cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310512,
					"content": "Phải rồi, nếu bạn giúp bạn bè hoàn thành ủy thác, cũng vẫn được tính vào số lần để nhận quà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310513,
					"content": "Hãy hợp tác nhiều hơn với bạn bè! Hướng về những ngôi sao và vực sâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310509,
					"content": "Mỗi ngày chỉ có một phần quà sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "Bây giờ là như vậy... rất xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310511,
					"content": "Nhưng hãy yên tâm, về thù lao của Nhà Mạo Hiểm, chúng tôi vẫn đang cố gắng tranh thủ với tổng bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
