			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#Tôi có nghe nói rồi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310402,
					"content": "Bạn đã hoàn thành <color=#00E1FFFF>ủy thác</color> Hiệp Hội Nhà Mạo Hiểm nhận được, người ủy thác nhờ tôi cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310403,
					"content": "Ủy thác? Không có ấn tượng gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310404,
					"content": "Là những việc cần bạn giúp khi gặp trên đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310405,
					"content": "Kỳ thực bọn họ đều đã gửi ủy thác tại hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310408,
					"content": "Tóm lại, giới thiệu đơn giản với bạn trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310409,
					"content": "Hiệp Hội Nhà Mạo Hiểm mỗi ngày đều nhận được ủy thác từ khắp các nơi, rồi sau đó sắp xếp gửi cho các Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310410,
					"content": "Đây cũng là nguồn thu nhập chính của Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310411,
					"content": "Nói về thù lao, thì không thể không nhắc đến một bất ngờ hiệp hội đã chuẩn bị cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310406,
					"content": "Trên đường gặp nên tiện tay giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310407,
					"content": "Không hổ là ngôi sao mạo hiểm mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003105,
			"completionStepIds": [
				2003106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
