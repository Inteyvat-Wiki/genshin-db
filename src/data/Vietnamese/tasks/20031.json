			"dialogs": [
				{
					"id": 200310101,
					"content": "Chúng ta lại gặp mặt rồi, ngôi sao mạo hiểm mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310102,
					"content": "Thế nào, những cuộc mạo hiểm gần đây vẫn thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310103,
					"content": "Rất thuận lợi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "Khí thế rất tốt, hãy nhớ phải giữ vững nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310107,
					"content": "Xem ra bạn đã tích lũy được nhiều kinh nghiệm, đã đến lúc giới thiệu cho bạn công việc quan trọng của Hiệp Hội Nhà Mạo Hiểm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310108,
					"content": "Hiệp Hội Nhà Mạo Hiểm mỗi ngày đều nhận được <color=#00E1FFFF>ủy thác</color> từ khắp các nơi, rồi sau đó sắp xếp gửi cho các Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310109,
					"content": "Đây cũng là nguồn thu nhập chính của Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310110,
					"content": "Là những ủy thác như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "Loại nào cũng có thể có, từ giúp đỡ người dân đến thanh lý quái, có những việc vặt cũng có những việc nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310112,
					"content": "Tục ngữ nói trăm nghe không bằng một thấy, hãy làm thử sẽ hiểu rõ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310113,
					"content": "Đây chính là nội dung ủy thác hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310114,
					"content": "Phiền bạn sau khi hoàn thành hãy đến chỗ tôi báo cáo, tôi sẽ cho bạn một phần thưởng lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310115,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#Không hổ là {NICKNAME}, rất đáng tin cậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310119,
					"content": "#Vậy tôi sẽ đợi tin tốt của bạn ở đây, {NICKNAME}, hướng về những ngôi sao và vực sâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310117,
					"content": "Lớn cỡ nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "Đừng nóng vội như vậy, hãy giữ sự tò mò, sẽ không làm bạn thất vọng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310105,
					"content": "Có chút khó khăn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "Mới bắt đầu đều sẽ như vậy, chuẩn bị tốt trước khi mạo hiểm sẽ giúp bạn dễ dàng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
