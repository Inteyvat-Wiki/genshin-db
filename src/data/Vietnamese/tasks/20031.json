			"dialogs": [
				{
					"id": 200310201,
					"content": "#Làm rất tốt, {NICKNAME}, lần đầu làm được vậy coi như rất xuất sắc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310202,
					"content": "Người ủy thác còn nhờ tôi cảm ơn bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310203,
					"content": "Vậy thì bây giờ đến lượt tôi thực hiện lời hứa trước đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
