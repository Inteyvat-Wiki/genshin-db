			"dialogs": [
				{
					"id": 200380101,
					"content": "Í, không biết Thất Thiên Thần Tượng thế nào rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380102,
					"content": "Thất Thiên Thần Tượng sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "Là như vầy... trước đây mỗi tuần tôi đều đến cầu nguyện ở Thất Thiên Thần Tượng, cũng tiện tay quét dọn thần tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380104,
					"content": "Cũng nhờ thần linh, tôi mới có cuộc sống hạnh phúc hiện nay, làm như vậy, cũng là một cách báo đáp của tôi với Thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380105,
					"content": "Nhưng từ sau khi tôi có Lily, cơ hội ra ngoài cũng càng ngày càng ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380106,
					"content": "Thất Thiên Thần Tượng, nhất định là do không có người quét dọn nên bị đóng bụi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380107,
					"content": "Tuy là nói như vậy, có chút giống như trốn tránh trách nhiệm. Nhưng có thể nhờ bạn thay tôi quét dọn Thất Thiên Thần Tượng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380109,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "Cám ơn bạn, mong Phong Thần bảo vệ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380115,
					"content": "Phải rồi, Thất Thiên Thần Tượng có sức mạnh của Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380116,
					"content": "\"Bụi\" trên đó không thể dùng cách thông thường để xử lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380117,
					"content": "Nhưng bạn có sức mạnh Nguyên Tố, chắc là có thể giải quyết dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380118,
					"content": "Không như tôi, một bức tượng cũng phải quét dọn cả ngày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380110,
					"content": "Hãy để gió thổi bụi bay đi đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "Đại nhân Barbatos và gió của ngài ấy, nhất định mỗi ngày đều rất bận rộn,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380113,
					"content": "Hơn nữa, cũng không thể việc gì cũng nhờ vào thần, bản thân thì lười biếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380114,
					"content": "Xin bạn hãy cùng tôi, gánh vác chút việc với đại nhân Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				}
			]
		},
