				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "Tôi muốn so tài với tên to con này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "Tuyệt vời! Chủ nhân cũng cần thường xuyên thư giãn cơ thể, vậy thì những miếng nấm rơi xuống sẽ càng thơm ngon hơn! Hãy toàn lực đối đầu, đừng nương tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "Hỡi chủ nhân Maha Vasudev{RUBY#[D]Hậu Duệ Của Thần Ban Sự Sống Thế Gian}ayaputra, nguyện cho Jivit{RUBY#[D]Gốc Rễ Sinh Mệnh}indriya của người cắm sâu vào nền đá vững chắc, nguyện cho mĩ vị của người vượt qua mọi thần linh trên đời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "Đây là cái gì vậy...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "Hỏi hay lắm! Đây chính là Hậu Duệ Của Thần Ban{RUBY#[S]Bifrons} Sự Sống Thế Gian được tôn thờ, là loài nấm đã đạt đến hương vị hoàn hảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730303,
					"content": "Nagahvaya thường niệm Chủ Nhân Của Cỏ Cây và Chủ Nhân Của Vườn{RUBY#[D]Pushpavatika} Hoa, Makani Khagan luôn cầu nguyện với Thần Cát Đỏ, có thể hỏi họ, trong ba vị tôn thần đó, có ai ngon hơn chủ nhân của tôi hay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730304,
					"content": "Phải biết rằng không gây hại chính là việc đúng đắn. Nếu không có thần thể của chủ nhân, chúng tôi cũng phải lấy mạng của chim thú cỏ cây để sống... Ôi, thật đáng thương biết bao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730305,
					"content": "May thay, khi Chủ Nhân Không Gian đưa tôi rời khỏi mặt đất, ji{RUBY#[D]bào tử}va của chủ nhân cũng đi cùng tôi. Và nhìn xem, giờ đây chúng đã phát triển đến mức này, ban cho chúng tôi hương vị tuyệt hảo vô cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007304,
