				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "Ối! Đừng quấy rầy ta, ta đang suy nghĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450102,
					"content": "Ta đang suy nghĩ một chuyện quan trọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450103,
					"content": "Chuyện quan trọng? Đó là chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450104,
					"content": "Ngươi gặp được thứ có tên là Dainichi Mikoshi chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450105,
					"content": "Đó là kiến trúc cao nhất trong Vương Quốc Đêm Trắng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450106,
					"content": "Ta đang suy nghĩ, phải làm sao mới có thể xây dựng được một kiến trúc còn cao hơn cả Dainichi Mikoshi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450107,
					"content": "Ừm, nhưng mà Dainichi Mikoshi cao như vậy là để chiếu sáng cho Vương Quốc Đêm Trắng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450108,
					"content": "Nên em xây kiến trúc cao hơn để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450109,
					"content": "Đương nhiên là để tạo dựng danh tiếng cho Rikoru ta rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450110,
					"content": "Có như vậy thì ta mới có thể chứng minh được ta lợi hại hơn ông chú Aberaku đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450111,
					"content": "Em quen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "Đương nhiên rồi, người đã xây dựng nên Dainichi Mikoshi, cứu Vương Quốc Đêm Trắng Khỏi hiểm cảnh... Trước đây ta rất sùng bái ông ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450114,
					"content": "Nhưng mà ông ta lại mưu đoạt vương vị, nếu không nhờ những đại nhân anh minh đó thì không chừng ta đã mất mạng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450115,
					"content": "Hừ, ta nhất định sẽ xây dựng được một kiến trúc còn cao hơn cả Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450116,
					"content": "Vậy, vậy phải xây bao lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450117,
					"content": "Ta không cần biết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450118,
					"content": "Người dân Vương Quốc Đêm Trắng nên vui mừng vì ta đã đề nghị họ xây dựng một kỳ quan lịch sử như vậy cho ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450119,
					"content": "Được rồi, đừng làm phiền ta nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450120,
					"content": "Để suy nghĩ xem, nếu cao... như thế này, tải trọng và giá đỡ thì nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450112,
					"content": "Aberaku sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
