					"nextDialogs": [
						722450505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450505,
					"content": "(Hơn nữa, hình như trên bia mộ có viết...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450506,
					"content": "Ánh mắt nghi ngờ đó là sao chứ, được rồi được rồi, bình thường ta hay coi bói cho người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450507,
					"content": "Nhưng những công dân của Vương Quốc Đêm Trắng... hiếm ai có cái số vui vẻ hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450508,
					"content": "Vì vậy ta thường lừa họ, nói rằng họ gặp may.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450509,
					"content": "Ta nghĩ như vậy tốt xấu gì họ cũng có thể vui vẻ được một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450510,
					"content": "Kết quả họ lại nói ta không biết xem bói, nghiệt ngã thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450511,
					"content": "Thật vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450512,
					"content": "Thế nào, nhóc con kia, để ta bói cho một quẻ nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450513,
					"content": "Được, được thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450514,
					"content": "Ừm... để xem thử, ơ, sao liên can đến nhiều thứ thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450515,
					"content": "Ây da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450516,
					"content": "Sao, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450517,
					"content": "Bói không ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450518,
					"content": "Sao lại như thế được nhỉ, bình thường tuy ta bói không chuẩn, nhưng cũng đâu đến mức không bói ra được gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450519,
					"content": "Xem ra là không đủ trình rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450520,
					"content": "...Nói cũng đúng, chắc ta phải cố gắng học thêm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
