			"dialogs": [
				{
					"id": 722450301,
					"content": "#Lữ khách phương xa, khụ khụ, xem ra {F#chị}{M#anh} đã rất mệt mỏi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450302,
					"content": "Mệt mỏi là không tốt đâu, nhiều căn bệnh đều sẽ từ mệt mỏi mà ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450303,
					"content": "Mỗi ngày nên ngủ đủ giấc, mới có thể, khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450304,
					"content": "Khụ khụ khụ... mới có thể khỏe mạnh được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450305,
					"content": "Hình như em không được khỏe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450306,
					"content": "Haha, chỉ là bệnh cũ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450307,
					"content": "Nhà lữ hành, chỉ có cơ thể khỏe mạnh mới có thể chứa đựng một linh hồn khỏe mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450308,
					"content": "Ôi, nếu như có thêm chút thời gian thì tốt biết mấy, em nhất định sẽ trở thành bác sĩ giỏi nhất trên thế gian này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450309,
					"content": "Có như vậy thì dù với cơ thể này, em cũng sẽ có thể chạy ra khỏi phòng để chơi đùa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surepio"
				}
			]
		},
