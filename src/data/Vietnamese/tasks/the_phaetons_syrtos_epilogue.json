					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450605,
					"content": "Bạn mô tả sơ lược phong cảnh của Mondstadt cho Pirarumon...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "Chưa từng nghe nói về thành phố này, hay thật, không ngờ lại có một nơi như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450607,
					"content": "Ha ha ha, em đã nói thế giới này làm gì chỉ có mỗi Vương Quốc Đêm Trắng này thôi cơ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450608,
					"content": "Nếu trên thế giới chỉ có Vương Quốc Đêm Trắng thì chẳng phải sẽ cô đơn chết hay sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450609,
					"content": "Sách cổ cũng kể về những câu chuyện xảy ra trước khi Vương Quốc Đêm Trắng được lập nên, lúc đó em cảm thấy cuộc sống này đúng là vô tận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450610,
					"content": "Nhưng mà, em rất sợ, sợ rằng thực sự không còn gì khác bên ngoài Vương Quốc Đêm Trắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450611,
					"content": "#Nhà lữ hành, sự có mặt của {F#chị}{M#anh} đã khiến em yên tâm hơn nhiều rồi. Ừm, thì ra trên thế gian này vẫn còn nhiều nơi thú vị như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450612,
					"content": "Đáng tiếc là bây giờ em còn phải hoàn thành một điển lễ có tên là Tế Lễ Trở Về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450613,
					"content": "#Hay là thế này vậy, {F#chị}{M#anh} hãy nói cho em biết đường vào nơi này đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450614,
					"content": "Chờ khi hoàn thành Tế Lễ Trở Về, em sẽ tìm cơ hội lẻn ra khỏi Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Pirarumon"
				},
				{
					"id": 722450615,
					"content": "Đến lúc đó cùng uống với nhau một ly nước ép vậy! Ha ha ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pirarumon"
				}
			]
