			"trigger": {
				"objectNames": [
					"Isumenasu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "Ấy? Trước giờ chưa thấy qua người nào ăn mặc giống ngươi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450202,
					"content": "Không lẽ ngươi từ bên ngoài đến đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450203,
					"content": "Thì ra trên thế gian này không chỉ có Vương Quốc Đêm Trắng. Vậy, có thể đưa bản đồ của ngươi cho ta xem thử không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450204,
					"content": "(Đưa bản đồ ra...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "Chà, thật là chi tiết, địa hình không chỉ được vẽ chính xác mà còn có thể nhìn thấy đường đi của núi và sông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450206,
					"content": "Vậy thì diện tích của vương quốc \"Teyvat\" này so với Vương Quốc Đêm Trắng sẽ như thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450207,
					"content": "Teyvat là tên của cả vùng đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450208,
					"content": "Còn nữa, Enkanomiya, ừm, cũng chính là Vương Quốc Đêm Trắng đó, chỉ là một phần nhỏ ở phía nam bản đồ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450209,
					"content": "Nói láo! Lãnh thổ của Vương Quốc Đêm Trắng rộng lớn, làm sao có thể chỉ có bấy nhiêu chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450210,
					"content": "Bản đồ này thoạt nhìn thấy tinh xảo, nhưng thực ra cũng chỉ là vẽ bừa mà thôi, mang đi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450211,
					"content": "Ta vốn còn có ý định nể phục, giờ thành ra lại làm dơ bẩn đôi mắt của ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450212,
					"content": "Hứ, tin hay không tùy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
