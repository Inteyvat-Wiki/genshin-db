					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "#{F#Chị}{M#Anh} đang tìm gì sao, dáng đi của {F#chị}{M#anh} thực sự khiến người ta cảm thấy thương cảm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
