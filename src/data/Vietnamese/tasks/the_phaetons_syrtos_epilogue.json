					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "Chuyến hành trình này có lẽ khá lãng mạn với một ai đó, nhưng với bản thân nhà lữ hành có lẽ lại là một nỗi đau khó nói thành lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "#Nếu là trước đây, em sẽ hát cho {F#chị}{M#anh} nghe ngay tại nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
