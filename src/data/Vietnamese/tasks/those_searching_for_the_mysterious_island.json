			"dialogs": [
				{
					"id": 150050201,
					"content": "Phong cảnh ở đây khá đẹp đó, thỉnh thoảng còn thấy được Koholasaur nữa! Chúng ta tìm vài con Koholasaur hoang dã để chụp ảnh chung nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050202,
					"content": "Hoang dã lỡ như chúng cắn người thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "Chuyện này... Dù sao tôi cũng cảm thấy Koholasaur khá dễ thương mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050204,
					"content": "Ơ? Kia là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050205,
					"content": "Cứu với! Ai đó hãy giúp chúng tôi với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050206,
					"content": "Woa, Koholasaur hoang dã cắn người thật kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050207,
					"content": "Ra tay giúp đỡ nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#Đúng, hai người họ đang gặp nguy hiểm! {NICKNAME} nổi tiếng cùng bạn đồng hành của mình chắc chắn sẽ không khoanh tay đứng nhìn đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050209,
					"content": "Chỉ đành tạm gác lại việc chụp hình chung vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "Đúng vậy, không có thời gian nói chuyện này nữa. Có người đang kêu cứu, chúng ta đâu thể khoanh tay đứng nhìn được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
