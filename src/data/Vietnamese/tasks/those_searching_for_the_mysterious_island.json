			"dialogs": [
				{
					"id": 150050101,
					"content": "Koholasaur bị đánh bại đã chạy tán loạn.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "Nhìn cách ăn mặc này, chẳng lẽ là học giả đến từ Sumeru sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050103,
					"content": "Ừm, tôi là Karya, vị này là Viramdra, tiền bối của tôi. Thật sự rất cảm ơn các vị, ban nãy nguy hiểm quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050104,
					"content": "#Không có gì, đối với chúng tôi thì đây chỉ là chuyện nhỏ mà thôi. Tôi là Paimon, đây là {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050105,
					"content": "Haiz... Koholasaur chạy hết rồi... Ít ra cũng phải bắt sống một con chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050106,
					"content": "Bắt sống?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050107,
					"content": "À phải rồi. Tôi thấy thân thủ của hai vị khá tốt, hay để tôi làm mồi nhử thu hút những con Koholasaur đó, rồi các vị giúp tôi bắt sống một con nhé? Tôi sẽ trả thù lao cho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050108,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050109,
					"content": "Thật xin lỗi, Viramdra chỉ đang quá tập trung vào nghiên cứu của mình mà thôi. Xin đừng để tâm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050110,
					"content": "Không sao không sao! Kể ra thì tại sao các vị lại muốn động đến Koholasaur hoang dã vậy? Lại còn muốn bắt sống nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050111,
					"content": "Chẳng lẽ là muốn chụp hình chung sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "Chắc chắn không liên quan đến chuyện này rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050113,
					"content": "Để hai vị chê cười rồi. Thật ra tôi và Viramdra đang tìm kiếm đảo thần bí trong truyền thuyết. Nghe nói có một manh mối quan trọng ở trên người Koholasaur, cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050114,
					"content": "Tùy tiện đến tiếp xúc với chúng mà không có sự giúp đỡ của người dẫn đường từ Cư Dân Suối Nước, đúng là thất sách mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050115,
					"content": "Đảo thần bí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050116,
					"content": "Ừm, là một hòn đảo được nhắc đến trong truyền thuyết của Cư Dân Suối Nước. Viramdra tin rằng mục tiêu nghiên cứu của mình nằm trên hòn đảo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050117,
					"content": "Khụ... Các vị thật sự không xem xét đề nghị ban nãy của tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050118,
					"content": "Đề nghị ban nãy...? Chúng tôi sẽ không để một người sống sờ sờ ra làm mồi nhử đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050119,
					"content": "Vậy thì bàn tiếp cũng chỉ tốn thời gian thôi. Tôi phải nghĩ cách giải quyết khác rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050120,
					"content": "Tiền bối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050121,
					"content": "Được rồi... Các vị ban nãy quả thực đã cứu tôi và Karya, về tình về lý thì tôi nên cảm ơn các vị. Cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050122,
					"content": "Gượng gạo quá đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050123,
					"content": "Karya, chúng ta nên đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050124,
					"content": "Rất xin lỗi, Viramdra quả thực không giỏi xã giao cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050125,
					"content": "Không sao đâu, tạm biệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050126,
					"content": "Thật hiếm có đấy. Hai người như vậy mà lại có thể cùng đi thám hiểm chung sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050127,
					"content": "Nhưng nói đi cũng phải nói lại, đảo thần bí mà cô kia nhắc đến quả thực khiến tôi tò mò đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050128,
					"content": "Paimon cũng muốn đến đó à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "Ừm! Nói không chừng sẽ có kho báu đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050130,
					"content": "Trong chuyến hành trình thì chúng ta đã cùng thám hiểm nhiều nơi thần kỳ rồi, nên việc tìm thấy đảo thần bí đó chắc chắn không làm khó được chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050131,
					"content": "Nhưng chúng ta không có chút thông tin nào cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "Cũng phải... À đúng rồi, cô ấy nói đảo thần bí đó là một hòn đảo trong truyền thuyết của Cư Dân Suối Nước. Hay là chúng ta đến đó tìm người hỏi thử đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050133,
					"content": "Không chậm trễ nữa, bắt đầu ngay chuyến hành trình tiếp theo của chúng ta nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050134,
					"content": "Tuy chúng ta đã có kế hoạch rồi, nhưng vẫn chưa biết phải tìm ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050135,
					"content": "Hay tìm trực tiếp thủ lĩnh hỏi thử nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "Ừm... Cũng đúng, cô gái kia từng nhắc đảo thần bí này có liên quan đến một truyền thuyết của Cư Dân Suối Nước, vậy thì thủ lĩnh ở đó chắc chắn sẽ biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
