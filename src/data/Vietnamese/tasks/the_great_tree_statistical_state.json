			},
			"dialogs": [
				{
					"id": 230300201,
					"content": "Ồ! Nhìn cái rương kia kìa, bên trong chắc chắn là những lọ thuốc đó. Xem ra Yasmin đã từng đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300202,
					"content": "Ơ? Số thuốc trong rương còn chưa được mở nắp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300203,
					"content": "Đừng mở nắp ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300204,
					"content": "Ôi! Nhìn đằng sau kìa, có Nấm Quỷ chui ra rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230300205,
					"content": "Hả?! Trước đây cũng không có chuyện này mà? Rốt cuộc đã xảy ra chuyện gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300206,
					"content": "#Đừng nghe bọn họ lải nhải, {NICKNAME}, chúng ta mau lên thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303004",
							"2"
						],
						"stepId": 2303004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "Cũng may nước thuốc trong rương không bị vỡ, nếu không chúng ta lại phải nôn mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "Anh lại không chịu được mùi này sao? Toàn bộ đều do chính tay anh làm ra mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300403,
					"content": "Tôi đã giải thích với anh bao nhiêu lần rồi, thứ tôi thêm vào là thuốc gây nôn sinh lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "Chẳng liên quan tới việc quen hay không, chỉ cần người ta ngửi thấy mùi này thì cơ thể sẽ tự phản ứng nôn mửa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "Tại sao tôi phải nhắc lại lần nữa chứ, chắc anh cũng nghe không hiểu đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "Nhưng rốt cuộc Yasmin đã đi đâu rồi? Nước thuốc vẫn chưa tưới kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "Chắc hẳn cô ấy đã phát hiện ra loài thực vật quý hiếm nào đó nên đang bận thu thập mẫu vật chăng. Anh còn chưa rõ bản tính của học sinh Amurta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300408,
					"content": "Được rồi, trước tiên chúng ta cứ xem qua hũ thuốc này đã, cảm ơn bạn đã giúp đỡ. Nhà Lữ Hành, xin hãy nhận lấy những thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Đám người Amurta này... thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pharez"
				}
			]
		},
		{
			"id": 2303005,
			"completionStepIds": [
				2303005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303005",
							"2"
						],
						"stepId": 2303005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "Khụ khụ khụ, khụ khụ... chỗ này chắc ổn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "Ọe... Anh.. Thứ này là sản phẩm của anh! Thế mà anh cũng nôn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300503,
					"content": "Ọe... Khụ... Khụ khụ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "Tôi đã... giải thích với anh... bao nhiêu lần rồi, thứ tôi thêm vào chính là thuốc gây nôn sinh lý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "Chẳng liên quan tới việc quen hay không, chỉ cần người ta ngửi thấy mùi này thì cơ thể sẽ tự phản ứng nôn mửa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "Tại sao tôi phải nhắc lại lần nữa chứ, anh có nghe hiểu đâu... Ưm... Ọe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "Ơ? Ladep và Pharez, còn có Nhà Lữ Hành nữa? Sao mọi người lại tới đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300508,
					"content": "Hũ nước thuốc cũng bị vỡ rồi... Mọi người đã bị ma vật tấn công sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300509,
					"content": "...Đúng là thế, lúc cô đến không nhìn thấy ma vật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
					"content": "Không có, tôi còn tranh thủ thời gian đi qua bên kia thu thập chút thực vật làm mẫu vật nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300511
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300511,
					"content": "Điều này thực sự kỳ lạ... rất kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300512
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300512,
					"content": "Đừng suy nghĩ nữa! Đám ma vật đó đều bị hũ thuốc mà anh tạo ra dụ tới đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300513
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300513,
					"content": "Hả?! Nhưng điều này chưa bao giờ xảy ra trong những lần thử nghiệm thực địa trước đây mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300514
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300514,
					"content": "Bây giờ anh đã thấy rồi đấy, anh có thể thiết thực hơn chút được không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300515
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300515,
					"content": "Chúng ta sẽ thảo luận vấn đề này sau... Nhà Lữ Hành, cảm ơn bạn đã giúp đỡ, xin hãy nhận lấy khoản thù lao này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300516
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300516,
					"content": "Rốt cuộc xảy ra vấn đề ở đâu chứ...",
					"roleType": "TALK_ROLE_NPC",
