			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "Chúng ta cần nhiều số liệu hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300102,
					"content": "Những thiết bị của anh không có số liệu cụ thể thì sao có thể vận hành bình thường được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300103,
					"content": "Anh muốn thu thập đầy đủ tất cả số liệu rồi mới làm lại lần nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300104,
					"content": "Lúc anh bắt cá có cần nhìn chính xác từng cơn sóng không? Anh chỉ cần xem dưới kia có cá hay không là được rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300105,
					"content": "Đây là lý do mà anh không bao giờ bắt được cá đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300106,
					"content": "Anh chưa bao giờ theo học qua ở Haravatat nên đừng nhiều lời nữa, chúng ta phải hành động trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300107,
					"content": "Cứ kéo dài thế này, biết đâu chừng bài luận văn của chúng ta và Yasmin sẽ trễ hạn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300108,
					"content": "Các anh đang cãi nhau về chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "Bạn là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300110,
					"content": "Người này hẳn là Nhà Lữ Hành mà Yasmin từng nhắc tới, bạn đã giúp đỡ chúng tôi rất nhiều đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300111,
					"content": "Rất vui được gặp bạn! Nhà Lữ Hành, thật sự rất vui khi được quen biết bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300112,
					"content": "Tôi là Pharez, hiện đang theo học ở Học Viện Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300113,
					"content": "Tôi là Ladep, là học sinh của học viện Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300114,
					"content": "Nhà Lữ Hành, chúng tôi cũng muốn nhờ bạn giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300115,
					"content": "Bạn có biết dạo này Yasmin đang tưới nước thuốc quanh rễ của \"Cây Thánh\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300116,
					"content": "Nhưng mà... ừm... dạo này hình như thuốc mà Yasmin tưới có gì đó không ổn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300117,
					"content": "Xung quanh khu vực cô ấy tưới nước thuốc luôn xuất hiện đủ loại ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300118,
					"content": "Tôi xin thề, tôi tuyệt đối không thay đổi bất kỳ công thức hay tỷ lệ thuốc. Nhất định là... ừm, đã xảy ra tình huống ngoài ý muốn nào đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300119,
					"content": "Anh nói sao cũng được... Tóm lại, Nhà Lữ Hành, xin hãy cùng chúng tôi đến chỗ Yasmin tưới nước thuốc xem thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300120,
					"content": "Biết đâu chừng đằng kia lại xuất hiện một đám ma vật thì sao, chúng tôi không dám qua đó một mình... cần phải tìm người có võ nghệ cao cường đi cùng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300121,
					"content": "Quan trọng hơn, cho dù lũ Nấm Quỷ đó không quá nguy hiểm, nhưng nếu để thầy biết nước thuốc có vấn đề như vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300122,
					"content": "Báo cáo đề tài luận văn của chúng tôi chắc chắn sẽ bị trả về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300123,
					"content": "Nhất là ở Học Viện Spantamad chúng tôi, nếu như dữ liệu nộp lên có sai sót thì thầy sẽ mắng chúng tôi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300124,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "Lúc trước các anh làm thế nào để giải quyết vấn đề này thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "Chúng tôi thường thuê những nhà mạo hiểm, hoặc đi tìm thầy của chúng tôi, nhờ ông ấy đứng ra tìm vài thành viên Eremite đáng tin cậy giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300127,
					"content": "Nhưng sự kiên nhẫn của thầy cũng có hạn, tình huống hiện giờ, chúng tôi không dám đi tìm ông ấy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300128,
					"content": "Cho nên chỉ có thể nhờ bạn thôi, Nhà Lữ Hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		},
		{
