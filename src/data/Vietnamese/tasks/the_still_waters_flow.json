				{
					"id": 722330502,
					"content": "Về Vương Quốc Đêm Trắng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Trước đây Enkanomiya có tên là Vương Quốc Đêm Trắng. Bởi vì vương quốc dưới lòng đất không hề có mặt trời mặt trăng, chỉ có hai hiện tượng là đêm trắng và đêm đen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "Trong gia tộc của tôi từng có một pháp sư tên gọi là Eboshi, cũng được xem là một nhân vật lịch sử của Vương Quốc Đêm Trắng, cho nên mới để tôi phụ trách \"Tế Lễ Linh Hồn Watatsumi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
