						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Cái này gọi là \"Ấn Khóa\", nó đã từng là huy hiệu của Enkanomiya. Chỉ khi lối đi được mở ra, nó mới trồi lên trên mặt đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330202,
					"content": "Nghe nói đây là một bộ chìa khóa khác được gửi đến người dân đảo Watatsumi khi Enkanomiya thức tỉnh. Và theo ghi chép của Sangonomiya thì Ấn Khóa này có 5 loại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330203,
					"content": "Hiện giờ chúng tôi đã tìm được 3 loại ở Đảo Watatsumi. Sau khi tìm được đủ sẽ có thể mở phong ấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330204,
					"content": "Chúng tôi đã rút ba cái này ra khỏi ổ khóa và đặt chúng ở những vị trí khác trên Đảo Watatsumi. Bằng cách này, kết giới mới được khôi phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330205,
					"content": "Là để ngăn chặn bọn gấu con nghịch ngợm, gián điệp Fatui, người dân đảo Narukami và những người bên ngoài lẻn vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330206,
					"content": "À, người ngoài đương nhiên sẽ không bao gồm bạn. Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330207,
					"content": "Hiện giờ không thể liên lạc được với Hiệp Hội Nhà Mạo Hiểm, cho nên các nhà mạo hiểm khác không thể xuống được đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330208,
					"content": "Cô còn định thả nhà mạo hiểm xuống sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330209,
					"content": "Có ghi chép như vậy trong lịch sử mà, đôi bên cùng có lợi thôi. Dù sao thì thám hiểm cũng là thế mạnh của họ và bạn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330210,
					"content": "Hừm, cũng có nghĩa là lần này sẽ không có ai giành rương báu đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330211,
					"content": "Paimon, giữ ý tứ chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "Nói thế nào nhỉ... Loại rào chắn bảo vệ này không đáng tin cậy chút nào. Bởi vì thời gian điều tra vị trí ấn khóa đến khi lấy được ấn khóa quá dài, khoảng thời gian đó đủ để cho vài người lẻn xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330213,
					"content": "Dù sao thì cũng đang thiếu nhân lực mà... Vì vậy nếu bạn gặp Fatui, Đạo Bảo Đoàn hay Kairagi gì đó ở bên dưới cũng đừng bất ngờ, cứ giáo huấn chúng một trận đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330214,
					"content": "Nếu bọn chúng đi xuống dễ như vậy thì cái chìa khóa trăng gì gì đó mà chúng tôi lấy được là vì cái gì chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330215,
					"content": "Chỉ khi lấy đi Chìa Khóa Vực Tắm Trăng, Enkanomiya mới có thể tỉnh dậy. Và chỉ khi dùng Chìa Khóa Vực Tắm Trăng mở cửa, hệ thống thí luyện mới được vận hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330216,
					"content": "Hoặc nếu họ không cần thông qua Tế Lễ Linh Hồn Watatsumi để đi đến Enkanomiya... vậy chắc là họ đã vào bằng cách bàng môn tả đạo nào đó chăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330217,
					"content": "Vì vậy mong các bạn hãy mau chóng hành động, nhanh chóng lấy lại các \"Ấn Khóa\" khác trên Đảo Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330218,
					"content": "Ấn khóa được đặt ở Vây và Tim của Watatsumi. Và hai tế đàn nằm ở đường nối giữa chúng với Sangonomiya, nằm trên ngọn núi thứ hai của Vực Tắm Trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330219,
					"content": "Vậy tôi trở về chỗ cũ chờ tin tức của bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
