			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "Tiếp theo sẽ là thời khắc mở khóa, hãy cầm chắc Chìa Khóa Vực Tắm Trăng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330302,
					"content": "Cô hãy nói lại lần nữa xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330303,
					"content": "\"Chìa Khóa Vực Tắm Trăng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330304,
					"content": "Cô hãy nói lại ba lần đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330305,
					"content": "Chìa Khóa Vực Tắm Trăng, Chìa Khóa Vực Tắm Trăng, Chìa Khóa Vực Đá Trăng... Á, cắn trúng lưỡi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330306,
					"content": "Cái tên này chắc chắn có vấn đề. Đổi tên đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330307,
					"content": "Dù cho có đổi thì cũng là người của mấy trăm năm sau hưởng thôi. Ráng chịu đựng lần này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330308,
					"content": "E hèm, tóm, tóm lại, tôi sắp bắt đầu nghi thức rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330309,
					"content": "Thật đáng tiếc, chúng tôi không có nội dung chi tiết về thí luyện của Enkanomiya. Những việc tiếp theo, e là chỉ có thể tự thân vận động thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330310,
					"content": "Tôi ghét cái tục lệ phải giữ bí mật này quá. Cho nên tôi cũng chỉ có thể chúc bạn may mắn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330311,
					"content": "Ngoài ra, bạn tuyệt đối đừng lơ là quá. Sự an toàn của bạn là quan trọng nhất đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
