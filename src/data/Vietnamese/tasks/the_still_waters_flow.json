			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#Xin chào {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330102,
					"content": "Tiểu thư Tsuyuko, chuyện thu thập san hô đã chuẩn bị đến đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330103,
					"content": "Ây da, lại gặp phải khó khăn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330104,
					"content": "Mặc dù tiểu thư Tsuyuko trông có vẻ cúi đầu buồn bã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330105,
					"content": "Nhưng lại nháy mắt với chúng ta liên tục, có lộ liễu quá không vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330106,
					"content": "Ồ, vậy là các bạn cũng đoán ra là tình hình nguy cấp rồi sao, vậy tôi cũng không giấu gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330107,
					"content": "Căn bản là cô có định giấu chuyện này đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330108,
					"content": "Trước đó tuy đã lấy được \"Chìa Khóa Vực Tắm Trăng\", Enkanomiya cũng dần được đánh thức. Nhưng do nhân lực không đủ nên tiến độ điều tra đang rất chậm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330109,
					"content": "Dù sao thì hiện giờ cũng đang trong thời kỳ đặc biệt mà, mối quan hệ với Đảo Narukami cũng không biết có giữ vững được không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330110,
					"content": "Nhưng có thêm tôi thì cũng như muối bỏ bể thôi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "Đừng nói thế chứ, cần phải biết là kẻ mà lấy được nhánh san hô trong truyền thuyết thì chỉ có \"dũng sĩ\" mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330112,
					"content": "Đầu tiên cần phải gây dựng căn cứ, sau đó hỗ trợ \"dũng sĩ\" truy tìm vết tích tổ tiên, sau cùng sẽ nghênh chiến kẻ địch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330113,
					"content": "Kế hoạch cơ bản muôn thuở là vậy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330114,
					"content": "Nhưng mà do nhân lực không đủ, nên đã bị bế tắc ở khâu thăm dò rồi đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330115,
					"content": "Đúng vậy, \"dũng sĩ\" quan trọng nhất bây giờ ngay cả một sợi tóc cũng không thấy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330116,
					"content": "Mà bây giờ hình như nhìn thấy rồi đó. Hình như là một mái... một mái tóc vàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330117,
					"content": "Hic, nghe có vẻ rắc rối thật. Paimon không muốn đi chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330118,
					"content": "Nhưng mà thám hiểm thường sẽ phát hiện ra một số báu vật quý hiếm. Theo thông lệ, tất cả những thứ tìm được đều phải nộp cho nhà Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330119,
					"content": "Nếu lần này bạn xuống đó và tìm được gì đó, thì tôi mắt nhắm mắt mở coi như không thấy cũng không phải không được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330120,
					"content": "Hay là nhắm cả hai mắt đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "Anh hùng, đại hiệp, hảo hán, đấng cứu thế! Nói vậy là bạn đã đồng ý rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330123,
					"content": "Sao chúng tôi có thể làm ngơ khi Sangonomiya đang lâm nguy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330124,
					"content": "Bạn nói như vậy thật tốt quá. Xem ra cách Kokomi đại nhân đề xuất thực sự khá thuyết phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330125,
					"content": "Sangonomiya đại nhân đoán trước được cả việc các bạn sẽ quay lại đây tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330126,
					"content": "Cô nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330127,
					"content": "Không có gì không có gì. Hãy đi theo tôi, tôi sẽ cho bạn xem một thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330128,
					"content": "Chúng ta gặp nhau ở trước tế đàn nhé. Nếu như bạn không thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330129,
					"content": "Nếu như không thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330130,
					"content": "Thì ở phía đông nam đó, nheo mắt lại sẽ thấy ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330121,
					"content": "Tôi có mối quan hệ rất tốt với Kokomi đại nhân đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
