			"dialogs": [
				{
					"id": 230080101,
					"content": "Chắc cũng sắp thành công rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080102,
					"content": "Nhà Lữ Hành! Xin hãy dừng bước, Nhà Lữ Hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080103,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "Tôi muốn tìm Dịch Slime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080106,
					"content": "Chuyện là thế này, mấy hôm nay tôi luôn thử nghiệm, trộn lẫn những loại bùn đất mà bạn đã mang về theo nhiều tỷ lệ khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080107,
					"content": "Mặc dù thất bại rất nhiều lần... Nhưng cuối cùng tôi đã tìm thấy một tỷ lệ có thể dùng được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080108,
					"content": "\"Bê tông\" được trộn theo tỷ lệ này tuy không có tính dẻo trước khi đông đặc, nhưng sau khi đông lại rất chắc và bền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080109,
					"content": "Tôi đoán có lẽ do hơi ít bùn đất chứa Dịch Slime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080110,
					"content": "Nhà Lữ Hành, nhờ bạn mau chóng mang về ba phần Dịch Slime giúp tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080111,
					"content": "Có số Dịch Slime này, tôi chắc chắn sẽ làm ra loại bùn đất mình muốn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080104,
					"content": "Anh lại muốn kiếm cái gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
