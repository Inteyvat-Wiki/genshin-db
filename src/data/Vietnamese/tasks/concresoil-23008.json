				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "Tốt quá rồi! Chính là mấy thứ này, xin hãy đợi tôi một lát, sắp xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080302,
					"content": "Sau một thời gian chờ đợi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "Quả nhiên, suy đoán của tôi đã đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080304,
					"content": "Đất ướt có độ kết dính tốt, tuy nhiên sau khi đông kết rất dễ bị vỡ vụn, nhưng sau khi trộn với đất của Hoa Lừa Dối, bùn đất đông lại sẽ có độ dẻo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080305,
					"content": "Nhưng đất này trước khi đông lại thì có độ dẻo rất kém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080306,
					"content": "Nhưng sau khi thêm đất từ chỗ Slime sống thì độ dẻo trước khi đông đặc lại tốt hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080307,
					"content": "Tôi không biết tại sao, nhưng nếu phải mô tả nó thì loại bùn đất này đã trở nên giống Slime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080308,
					"content": "\"Đất Slime\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "Tôi đoán rằng có tính chất đặc biệt gì đó của Slime đã ảnh hưởng tới bùn đất, cho nên tôi đang nghĩ nếu thêm Dịch Slime vào trong thì không biết có hiệu quả hơn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080312,
					"content": "Kết quả tôi vừa thử nghiệm, tùy theo lượng Dịch Slime được thêm vào thì độ dẻo và độ bền của bùn đất cũng sẽ thay đổi tương ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080313,
					"content": "Nói cách khác, không chỉ là một vật liệu xây dựng, nó còn có thể được sử dụng để làm đồ gốm, và nhiều thứ khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080314,
					"content": "Chúc mừng anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "Cảm ơn, đây chính là câu người thông minh thường nói, \"có công mài sắt có ngày nên kim\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080317,
					"content": "Đừng thấy loại bùn đất này không bắt mắt, có thể xây được cả tòa tháp cao ngất trời đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080318,
					"content": "Tôi quyết định gọi loại bùn đất hỗn hợp này là \"Bê Tông\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080319,
					"content": "Tiếp theo, điều tôi muốn làm chính là kiểm tra xem loại \"Bê Tông\" này có thể sử dụng để làm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080320,
					"content": "Vấn đề nhà cửa làm mọi người phải đau đầu bao lâu nay, bây giờ cũng có hy vọng giải quyết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080321,
					"content": "Rất cảm ơn bạn, Nhà Lữ Hành, đây là thù lao, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080315,
					"content": "Cuối cùng cũng có thành quả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "Paimon có thích không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "Paimon không thích cạp đất đâu nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
