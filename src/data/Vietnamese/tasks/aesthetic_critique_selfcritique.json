				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "Phù... phù... cảm ơn bạn, vô cùng cảm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150602,
					"content": "Đáng ghét, tôi chỉ ở đây vẽ tranh, sao đột nhiên lại bị đám này vây lấy thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150603,
					"content": "Trông chúng như muốn nuốt luôn cả tranh, cứ tấn công giá vẽ liên tục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150604,
					"content": "Tất nhiên tôi không thể để chúng phá hỏng tác phẩm của mình, nên đã ôm bức tranh chạy mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150605,
					"content": "Nhưng tôi... chưa kịp chạy bao xa đã bị chúng đuổi tới. May mà có bạn tới ứng cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150606,
					"content": "Bức tranh có vấn đề gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "Tôi không biết! Tôi vẫn thường dùng Mật Hoa Lừa Dối làm màu vẽ, lần trước bạn còn đem về cho tôi một ít, nhớ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150609,
					"content": "Đợi đã, lẽ nào... đám này bị thu hút bởi mật hoa trong màu vẽ sao? Nhưng rõ ràng màu vẽ sau khi trộn mật đâu có mùi vị gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150610,
					"content": "Công thức tạo màu tôi cũng không dám tùy tiện thay đổi, phải nghĩ cách khác thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150611,
					"content": "Khụ, tôi còn tưởng, đến cả Hoa Lừa Dối cũng cảm nhận được vẻ đẹp trong bức tranh nên muốn đến thưởng thức chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150607,
					"content": "Anh đã làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}