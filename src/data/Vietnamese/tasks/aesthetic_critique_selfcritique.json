				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "Không đúng... Nếu loại bỏ hết tương phản, vậy chiều sâu hình ảnh phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150402,
					"content": "Biểu đạt màu chưa đủ mạnh... Sắc độ hình ảnh cũng chưa rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150403,
					"content": "Chậc! Chỉ là loại bỏ đi một vài yếu tố... thì cả bức tranh liền trở thành một mớ hỗn độn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150404,
					"content": "Anh ở đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "Là bạn đấy à, gặp được bạn thật tốt quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150407,
					"content": "Xin lỗi đã khiến bạn hiểu nhầm, khi nãy tôi chỉ đang suy nghĩ về vấn đề hình ảnh, nên cứ đi dạo khắp nơi trong vô thức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150408,
					"content": "Bạn có thể không hiểu, nhưng khi tôi suy nghĩ vấn đề, tuyệt đối sẽ không ngồi yên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150409,
					"content": "Nếu tôi cứ ở lì một chỗ để suy ngẫm thì càng lúc sẽ càng bực bội... Nên tôi đã quen với việc vừa đi dạo vừa ngẫm nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150410,
					"content": "Trong khi suy ngẫm sẽ để cho hai chân được tự do di chuyển, tùy chúng đi đâu cũng được, miễn là không đứng yên chỗ cũ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150411,
					"content": "Thế nên... tôi thường như vậy, khiến bạn lo lắng rồi, thật xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150412,
					"content": "Anh đã nghĩ ra kết quả chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "Không có tiến triển... không có manh mối gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150415,
					"content": "Loại bỏ đi tương phản ánh sáng, hình ảnh sẽ mất đi chiều sâu, tạo hình bị suy yếu, vật thể không thể giữ được bố cục hình ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150416,
					"content": "Chỉ là loại bỏ đi một vài yếu tố, toàn bộ hình ảnh bắt đầu sụp đổ, sau cùng trở thành một mớ rác lộn xộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150417,
					"content": "Đây chỉ là vài lời lẩm bẩm của tôi, bạn đừng để tâm. Tôi phải tiếp tục nghĩ cách giải quyết vấn đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150418,
					"content": "Tôi phải quay lại tìm giá vẽ đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150413,
					"content": "Vấn đề anh suy nghĩ đến đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "Chúng tôi còn tưởng anh gặp nguy hiểm chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
