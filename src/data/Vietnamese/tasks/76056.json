				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "Xin lỗi... Tôi làm mất mặt mọi người rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560402,
					"content": "Hah, chỉ là giết thời gian thôi mà, thua cũng không sao cả. Bielov, nghỉ ngơi một lát đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560403,
					"content": "Người bạn này thân thủ nhanh nhẹn đấy! Tôi tên Terho, hân hạnh được gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560404,
					"content": "#Tôi là {NICKNAME}, hân hạnh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "#{F#Cô}{M#Cậu} trông có vẻ là cao thủ có không ít kinh nghiệm thực chiến, vậy thì phải nghiêm túc hơn mới được. Trận vừa rồi không tính, đấu lại lần nữa nhé! Giờ đến lượt Incali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560406,
					"content": "Lần nào đại ca cũng chỉ nhớ đến tôi khi gặp rắc rối... Thật hết cách mà. Thôi được rồi, cao thủ, chúng ta bắt đầu thôi nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Incali"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
