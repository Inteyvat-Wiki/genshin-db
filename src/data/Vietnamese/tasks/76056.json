				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "Xin lỗi nhé, tôi còn có việc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "Không sao, dù sao chúng tôi cũng đang giết thời gian ở đây mà. Khi nào rảnh rỗi thì đến tìm chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
