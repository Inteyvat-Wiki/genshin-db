					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "Tôi mà lại thua sao... Bị một người qua đường đánh bại... Làm, làm sao có thể chứ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560502,
					"content": "Hmm, không ngờ lại thắng cả Incali... Xem ra tôi đã quá chủ quan rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560503,
					"content": "Không phải lỗi của đại ca đâu, dù sao thì ai mà ngờ được lại có đối thủ mạnh như vậy tình cờ đi ngang qua đây chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560504,
					"content": "Đại ca! Không thể để họ đi được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560505,
					"content": "Hmm? Lẽ nào không phải chỉ muốn so tài thôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "Đừng hiểu lầm, ý của Incali là không thể cứ thế mà chịu thua được. Dù sao chúng tôi cũng là những thợ săn kho báu có chút máu mặt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}, tôi chính thức thách đấu {F#cô}{M#cậu}. Lần này không phải là so chiêu nữa đâu, chúng ta hãy dùng thực lực của mình để đấu một trận nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560508,
					"content": "Vậy mời cả ba người cùng lên đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "Được, vậy chúng tôi không khách sáo đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
