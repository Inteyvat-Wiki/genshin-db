					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560101,
					"content": "#Người bạn này! Đến sân tập mà chỉ tập bắn bia thì chưa đã lắm phải không? Trông {F#cô}{M#cậu} cũng khá lắm, có muốn tỉ thí với chúng tôi đôi chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605602,
			"completionStepIds": [
				7605601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "Đôi chút à? Tôi đánh cả ngày cũng được đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "Haha, thẳng thắn lắm! Quả nhiên vẫn là đọ sức giữa người với người mới thú vị đúng không? Này Bielov, hay là thử vài chiêu với vị này xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560205,
					"content": "Được đấy! Tôi nhất định sẽ hạ gục đối thủ trong vòng ba chiêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bielov"
				}
			]
		},
		{
			"id": 7605603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
