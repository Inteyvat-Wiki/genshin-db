			"dialogs": [
				{
					"id": 760560601,
					"content": "Không thể tin được là lại thua một người qua đường... ba lần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "Không, chúng ta mỗi người thua hai lần, đại ca chỉ thua một lần thôi, vẫn còn may...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#Này! Thua là thua thôi, nghĩ nhiều cũng chẳng ích gì! {NICKNAME} quả thật là rất mạnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "Hai người thường ngày còn không đánh thắng được tôi, giờ đã thấy thế nào là cao thủ thực sự chưa? Hai người cần phải luyện tập nhiều hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "Còn tôi thì! Có lẽ phải cân nhắc nghỉ hưu sớm thôi, không biết khu huấn luyện của Vaino còn tuyển người không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
