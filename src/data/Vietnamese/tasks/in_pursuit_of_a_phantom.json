			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110501,
					"content": "Sao rồi, có cảm thấy lời nguyền đã bị xua tan hết không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110502
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110502,
					"content": "Đúng, tôi đã khỏe hơn rồi, tôi khỏi bệnh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110503
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110503,
					"content": "Thật sự rất cảm ơn bạn và Nhà Lữ Hành đây! Không thôi tôi sẽ không biết phải làm thế nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110504
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110504,
					"content": "Vậy, giờ tôi có thể nói với bạn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110505
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110505,
					"content": "Bạn đã bị lừa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110506
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110506,
					"content": "Sao, sao cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110507
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110507,
					"content": "Cái này chỉ là Địa Mạch Trấn Thạch bình thường thôi, nó rất dễ thu hút những quái vật xung quanh đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110508
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110508,
					"content": "Những đám quái vật đó cũng không phải là hiện thân của lời nguyền gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110509
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110509,
					"content": "Vậy thì thật kỳ lạ, rõ ràng là không có làm gì hết, vậy mà bạn lại cảm thấy hết bệnh, vậy là sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110510
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110510,
					"content": "Cái, cái này... không lẽ tôi không bị nguyền rủa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110511
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110511,
					"content": "Nhưng mà, sao tôi lại đột nhiên đổ bệnh vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110512
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110512,
					"content": "Bị cảm lạnh, hoặc ăn phải thứ gì đó, hoặc là tự mình dọa mình... Tôi nghĩ cái cuối cùng là hợp lý nhất đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110513
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110513,
					"content": "Không ngờ là như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110514
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110514,
					"content": "Tôi cũng không ngờ đến, nhưng mà... cảm ơn bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110515
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110515,
					"content": "Không cần phải cảm ơn, lần sau đừng nghi thần nghi quỷ nữa, tôi không phải lúc nào cũng có thể tìm được cách thích hợp để an ủi bạn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110516
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110516,
					"content": "Đời người rất ngắn, nhân cơ hội còn sống thì mau chóng hưởng thụ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110517,
					"content": "Câu này... nghe thật kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110518
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110518,
					"content": "Vậy, vậy tôi đi trước nhé, làm phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110519
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110519,
					"content": "Xem ra không phải do Big G làm, vậy tôi cũng an tâm rồi. Nhưng mà, không tìm được tung tích của bạn ấy thì sẽ không thể cản bạn ấy làm bậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110520
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110520,
					"content": "Nếu chuyện này giải quyết xong rồi, chúng ta tiếp tục đi tìm Big G chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110521
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110521,
					"content": "Tôi nghĩ không cần đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110522
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110522,
					"content": "Bởi vì người cần tìm đã tự đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110523
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110523,
					"content": "Big G?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110524
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110524,
					"content": "Xin lỗi... làm phiền các bạn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110525
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111110525,
					"content": "Đây là Big G sao? Sao lại là đứa trẻ thế?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110526,
					"content": "Bởi vì đây là linh hồn, cho nên mới có hình dạng như lúc xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110527
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110527,
					"content": "Chà, \"Big G\" này khác xa với suy nghĩ của mình quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110528,
					"content": "Dẫn anh ấy về Vãng Sinh Đường trước đi, còn nhiều chuyện cần phải làm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				}
			]
		},
