				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110101,
					"content": "Lão Meng, tôi về rồi! Thật xin lỗi, tôi vẫn chưa tìm được Big G",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110102,
					"content": "Vậy sao, vậy thì phiền phức rồi. Những nơi mà chúng ta đoán được đều đã đi hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110103
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110103,
					"content": "Big G rốt cuộc là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110104,
					"content": "Tôi giải thích từ đầu vậy. Quê của tôi ở Dốc Vô Vọng, lúc nhỏ tôi có vài đứa bạn thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110105
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110105,
					"content": "Big G chính là một trong số đó, chúng tôi thân nhau như hình với bóng. Nhưng mà bỗng một ngày bạn ấy lại đột ngột qua đời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110106
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110106,
					"content": "Tôi luôn không thể quên chuyện này, cho nên giờ tôi thường hay về Dốc Vô Vọng xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110107
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110107,
					"content": "Nhưng mà dạo trước khi tôi từ Dốc Vô Vọng về, tôi luôn cảm thấy không khỏe, ban đêm lại còn nằm mơ thấy Big G nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110108
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110108,
					"content": "Tôi nghĩ không biết có phải tôi làm kinh động đến bạn ấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110109,
						111110110
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110109,
					"content": "Nghe hơi hoang đường nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				},
				{
					"id": 111110111,
					"content": "Có thể chứ, tuy là tôi không có bằng chứng, nhưng tôi cứ luôn cảm thấy bất an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110112
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110112,
					"content": "Nghĩ đến chuyện người bạn thuở nhỏ có thể biến thành ác quỷ, làm sao có thể chấp nhận được chuyện này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110113
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110113,
					"content": "Vì lý do này nên anh ấy đã gia nhập Vãng Sinh Đường. Và cũng nhờ vào việc này nên tôi mới không cần trả tiền công cho anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110114,
					"content": "Nhưng mà chuyện của Lão Meng kể cũng không phải vô lý đâu, bởi vì đúng là thi thoảng sẽ có hồn ma lang thang ở trần gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110115
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110115,
					"content": "Nhưng còn ma quỷ thì chỉ là do bản thân tự dọa bản thân thôi, bản thân tôi cũng chưa gặp qua ác ma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110116,
					"content": "Nhưng mà, cũng không thể chứng minh chuyện của Big G là không nguy hiểm, tôi thật sự không muốn thấy bạn ấy đi hại người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110117
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110117,
					"content": "Vậy đấy, nếu không tìm được Big G thì nói gì Lão Meng cũng nghe không lọt tai cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110118
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110118,
					"content": "Những người tôi tìm ban nãy chính là bạn bè thuở nhỏ của Lão Meng, tôi cứ nghĩ Big G sẽ trốn ở chỗ họ, kết quả là dã tràng xe cát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110119
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110119,
					"content": "Những nơi gần Dốc Vô Vọng cũng tìm qua rồi, bạn bè trước đó cũng tìm rồi, không còn manh mối gì nữa cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110120
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110120,
					"content": "Xin lỗi, cho hỏi các bạn có phải là người của Vãng Sinh Đường không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110121
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110121,
					"content": "Tôi là Luocheng, dạo này tôi cảm thấy kỳ lạ lắm, như có thứ gì đó đang theo dõi tôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110122
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110122,
					"content": "Vài ngày trước tôi với bạn bè đến Dốc Vô Vọng thi gan, khi về thì trở bệnh, mỗi đêm đều thấy ác mộng, đi khám mấy lần cũng không khỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110123
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110123,
					"content": "Tôi nghĩ chắc tôi bị Ma Thần nguyền rủa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110124
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110124,
					"content": "Đúng vậy đúng vậy, bị Ma Thần nguyền rủa, nghiêm trọng lắm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110125
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110125,
					"content": "Bạn cũng biết đúng không! Đó chính là lời nguyền của Ma Thần giáng xuống nhân gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110126
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110126,
					"content": "Nếu không hóa giải lời nguyền thì lục phủ ngũ tạng sẽ bị thiêu cháy, chết không toàn thây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110127
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110127,
					"content": "Triệu chứng của tôi hiện giờ hoàn toàn giống với những gì được nhắc đến trong truyền thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110128
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110128,
					"content": "Dốc Vô Vọng, lời nguyền... Không đúng, có thể không phải lời nguyền, mà là Big G...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110129
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110129,
					"content": "Này này, ngừng lại đã, hai người đừng tự biên tự diễn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110130
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110130,
					"content": "Paimon mới là người thích tự biên tự diễn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110131,
					"content": "Sở trường của Vãng Sinh Đường là giải quyết những chuyện ma quỷ đúng không! Có thể giúp tôi không, tôi chưa muốn chết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110132
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110132,
					"content": "Được thôi, không vấn đề gì. Tìm tôi là tìm đúng người rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110133
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110133,
					"content": "Nhưng mà muốn giải lời nguyền thì cần có một nơi thích hợp, với cũng cần chuẩn bị trước nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110134,
					"content": "Này, người mới, tôi cần bạn giúp đó, đi theo tôi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110135,
					"content": "Vậy, vậy tôi cũng đi theo ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110136
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110136,
					"content": "Bạn chuẩn bị cho bạn ấy nhé. Chuyện đốt hương trừ tà tôi đã từng dạy bạn rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110137
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110137,
					"content": "Chuẩn bị xong thì đến tìm tôi nhé. Xong việc rồi chúng ta cùng thảo luận chuyện của Big G",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110138,
					"content": "Được rồi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110139
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110139,
					"content": "Vậy, chúng ta đi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110110,
					"content": "Chuyện này không thể xảy ra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				}
			]
		},
		{
			"id": 1111102,
			"completionStepIds": [
				1111102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111102",
							"2"
						],
						"stepId": 1111102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110201,
					"content": "Cứ tỏ ra thần bí, rốt cuộc muốn làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110202,
					"content": "Chẳng làm gì cả, cứ chờ ở đây là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110203
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110203,
					"content": "Sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110204,
					"content": "Bạn nghĩ chuyện lời nguyền là thật sao? Những chuyện này sớm đã không còn tồn tại nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110205
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110205,
					"content": "Vậy chúng ta tại sao phải đến đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110206
					]
				},
				{
					"id": 111110206,
					"content": "Một người cứ nghĩ bản thân bị nguyền rủa, một người cứ nghĩ bạn mình biến thành ác quỷ, không ai chịu nghe giải thích cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110207
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110207,
					"content": "Cho nên tôi mới nói, người thường tốt nhất là không nên biết gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110208
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110208,
					"content": "Tôi từng thấy nhiều người vì những chuyện này mà lo lắng rồi, cần phải để cho họ thấy thứ khiến họ phải tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110209
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110209,
					"content": "Đối với người tin vào ma quỷ, thì phải tiêu diệt ma quỷ ngay trước mặt họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110210
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110210,
					"content": "Hừm... trông có vẻ như làm chuyện dọa con nít vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110211,
						111110213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110211,
					"content": "Để người thường biết được tất cả không phải tốt hơn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110212
					]
				},
				{
					"id": 111110212,
					"content": "Đúng vậy, chúng ta chỉ sợ những gì chúng ta không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110216,
					"content": "Vì không có ai có thể đảm bảo được việc nói chân tướng cho kẻ vô tri thì tình hình sẽ có thể tốt hơn hiện giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110217
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110217,
					"content": "Tôi cần phải kéo những người đang ở gần \"ranh giới\" đó về lại. Nếu như đã là bệnh tâm lý thì phải chữa bằng tâm lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110218
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110218,
					"content": "Có vẻ hợp lý nhỉ... Vậy còn chuyện nguyền rủa thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110219,
					"content": "Cái này sao, bạn có từng nghe lịch sử của \"Dạ Xoa\" chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110220,
						111110221
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110220,
					"content": "Chưa từng nghe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110222,
					"content": "Họ từng chiến đấu với ma thần, tuy rằng ma thần đã bại trận, nhưng oán niệm của họ vẫn không tan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110223
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110223,
					"content": "Có những oán niệm hoá thành bệnh dịch, lan truyền đến nhân gian, những người sợ hãi đều cho rằng đó là \"lời nguyền của ma thần\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110224
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110224,
					"content": "Rất nhiều người đã bị bệnh dịch cướp đi mạng sống, và bệnh dịch lại tiếp tục lây lan từ người chết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110225
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110225,
					"content": "Sau này có người phát hiện ra cách chống bệnh dịch lây lan: Thanh tẩy không khí, hỏa thiêu xác. Những người đầu tiên làm việc này, chính là những người đã sáng lập ra \"Vãng Sinh Đường\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110226
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110226,
					"content": "Ra là vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110227,
					"content": "Ừm, sau đó vài năm, trận dịch đó đã hoàn toàn bị dập tắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110228
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110228,
					"content": "Những chuyện như vậy, \"Vãng Sinh Đường\" đã xử lý qua rất nhiều lần, kết quả cuối cùng đạt được là mang về sự cân bằng sinh tử cho Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110229
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110229,
					"content": "Nói gắn gọn, chúng tôi chính là \"người giữ cửa\", vừa giữ cửa cho người, vừa giữ cửa cho những thứ không phải người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110230,
						111110231
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110230,
					"content": "Đây chính là \"Duy trì ranh giới sinh tử\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110232,
					"content": "Cho nên, \"lời nguyền\" chỉ là do tâm lý tạo thành thôi, chuyện này tôi hiểu rất rõ. Nhưng những chuyện từng tồn tại trước đó, không nên nói cho người thường biết vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110233
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110233,
					"content": "Chúng ta đợi một lúc đã, rồi dùng Địa Mạch Trấn Thạch này để diễn một vở kịch hoành tráng nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110234
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110234,
					"content": "Cuối cùng cũng đã đến, chúng tôi chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110235
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110235,
					"content": "Nhìn xem, đây là bố trí đặc biệt cho công việc trừ tà, có thể dẫn dụ lời nguyền trong người bạn ra, khiến nó hiện hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110236
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110236,
					"content": "Đừng lo lắng quá, Nhà Lữ Hành đây là một chiến sĩ lão luyện đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110237,
						111110238
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110237,
					"content": "Lại là tôi sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110239,
					"content": "À à, đúng rồi, quên nói, nhưng cũng không có vấn đề gì mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110240
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110240,
					"content": "Có thật là không có vấn đề gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110241
					],
					"speakerTitle": "Luocheng"
				},
				{
					"id": 111110241,
					"content": "Tin tưởng vào đường chủ đi, tuy cô ấy trông hơi kỳ quái nhưng rất đáng tin cậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110242
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111110242,
					"content": "Này, sao lại dùng từ \"kỳ quái\" để mô tả tôi thế? Ít ra phải nói là ngây thơ trong sáng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110243
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110243,
					"content": "Thôi, nhanh vào việc nào! Người mới, khởi động thiết bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111110238,
					"content": "Đâu ai nói cho tôi biết là phải đánh nhau đâu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110231,
					"content": "Không ngờ lại có lịch sử lâu đời như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110221,
					"content": "Có biết một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110213,
					"content": "Paimon năm nay mấy tuổi rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110214
					]
				},
				{
					"id": 111110214,
					"content": "Sao lại đột nhiên hỏi câu này thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111110215,
					"content": "Tôi chỉ đang quan tâm tại sao không nói chân tướng cho mọi người biết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
