	"talks": [
		{
			"id": 1111101,
			"completionStepIds": [
				1111101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111101",
							"2"
						],
						"stepId": 1111101,
						"stateName": "QUEST_STATE_UNFINISHED"
