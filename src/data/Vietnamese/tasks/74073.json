						740732203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732203,
					"content": "Vậy thì Caterpillar, có thể nói cho chúng tôi biết rốt cuộc cần phải tìm thứ gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732204
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740732204,
					"content": "Chúng ta đang tìm kiếm nguyên liệu để rèn Thánh Kiếm Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732205
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732205,
					"content": "Hội Narzissenkreuz đã dựa vào triết học thần bí của vương quốc dưới lòng đất và Fontaine cổ đại, tái tạo ra bốn phi vật chất trong thế giới vật chất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732206
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732206,
					"content": "Không thể hiểu nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732207
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740732207,
					"content": "Bản thân những thứ thần bí thì chỉ dùng để trải nghiệm. Có thể nói, nó còn khó đoán hơn cả sức mạnh nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732208
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732208,
					"content": "Nhiều thập kỷ trước, tôi đã sao chép dữ liệu từ nhập môn đến trung cấp của Học Phái Spantamad từ Giáo Viện rồi, sức mạnh nguyên tố cũng không thần kỳ đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732209
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740732209,
					"content": "Phải không đấy? Dù sao thì trên kết luận mà nói, đây là sự giao thoa giữa kỹ thuật Fontaine cổ đại và vương quốc cổ dưới lòng đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732210
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732210,
					"content": "Trên thế giới xuất hiện bốn loại vật chất là \"Ký Ức\", \"Nguyện Vọng\", \"Linh Hồn\" và \"Nhân Cách\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732211
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732211,
					"content": "Để tránh bị lệch nghĩa, hãy gọi nó là mảnh \"Ký Ức\", mảnh \"Nguyện Vọng\", mảnh \"Linh Hồn\" và mảnh \"Nhân Cách\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732212
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732212,
					"content": "Tại sao lại dùng những thứ này để tạo ra Thánh Kiếm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732213,
					"content": "Theo triết học Hội Narzissenkreuz thần bí, điện thờ là hình ảnh thu nhỏ của vũ trụ, thành viên của hội đại diện cho các vị thần, còn dầu thánh là ý chí đã được tôi luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732214
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732214,
					"content": "Thánh Kiếm là thứ phá vỡ tất cả \"Lý Tính\", nó cần được tạo ra từ ý chí hoàn chỉnh của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732215
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732215,
					"content": "Thật khó hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732216
					]
				},
				{
					"id": 740732216,
					"content": "Triết học thần bí là vậy đó. Trông tương tự nhau là được, đến khi nó trở thành phép thuật thì giả sẽ biến thành thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732217
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732217,
					"content": "Tóm lại, chúng ta mau đến địa điểm tiếp theo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
