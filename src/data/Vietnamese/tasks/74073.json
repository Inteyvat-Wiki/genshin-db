			"dialogs": [
				{
					"id": 740730101,
					"content": "Đống lửa trên mặt đất vẫn còn cháy. Sao phải thắp lửa ở đây nhỉ? Đây là di tích mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730102,
					"content": "Để xem trên bia đá viết gì đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730103,
					"content": "\"Đây là nơi của Orthant Ký Ức, Sảnh Đường Ký Ức, Khoảng Không Ký Ức.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730104,
					"content": "\"Sinh ra trong khoảnh khắc\"... \"Thường hay mâu thuẫn, cùng nhau yên giấc, mãi không xa rời\"... \"Lửa khó lòng thiêu rụi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730105,
					"content": "Câu đố nhỉ? Nền văn minh cổ của Fontaine rất thích trò này, Hội Narzissenkreuz cũng thích. Không biết nó là quy chuẩn từ xưa hay là sở thích của ai đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730106,
					"content": "Đã kiểm tra các từ khóa, không có đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730107,
					"content": "Đây chỉ là một câu đố đã được giải, chắc đáp án có liên quan đến đống lửa này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730108,
					"content": "Ngồi nghiên cứu câu đố đã được giải liệu có ý nghĩa gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730109,
					"content": "Ý nghĩa thì vẫn có. Giống như cô và tôi đã biến thành như bây giờ, nhưng vẫn muốn tìm hiểu xem trong quá khứ đã xảy ra chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730110,
					"content": "Đúng vậy thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730111,
					"content": "#Vậy còn kỵ sĩ {NICKNAME} thì nghĩ đáp án là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
