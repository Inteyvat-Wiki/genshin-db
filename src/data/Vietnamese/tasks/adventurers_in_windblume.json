					],
					"speakerTitle": "Jose Sáu Ngón"
				},
				{
					"id": 700100404,
					"content": "Hơn nữa, trong Thành Mondstadt này, nếu muốn viết sử thi... thì lấy chủ đề là Đội Kỵ Sĩ là tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
