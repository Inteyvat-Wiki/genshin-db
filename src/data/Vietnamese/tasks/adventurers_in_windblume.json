			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "Về ủy thác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "Bạn thấy uỷ thác của tôi nên đến đây phải không? Ừm, tôi có một vài chuyện muốn nhờ bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100103,
					"content": "Cụ thể là tôi muốn nhờ bạn đến Tuyết Sơn và chụp ảnh hai địa điểm, địa điểm cụ thể tôi sẽ đánh dấu trên bản đồ cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100104,
					"content": "Chuyện thù lao thì đương nhiên cũng sẽ căn cứ theo quy định của Hiệp Hội Nhà Mạo Hiểm để trả cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100105,
					"content": "Thế nào? Bạn có ý kiến gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100106,
					"content": "Sao lại phải chụp ảnh ở hai nơi này thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "Ừm... Chuyện này nói cho cùng là có liên quan đến Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100108,
					"content": "Lần trước cậu ấy nhờ tôi mang cho cậu ấy chút đặc sản của Tuyết Sơn, cậu ấy muốn dùng nó làm quảng bá tuyển dụng cho hiệp hội trong Lễ Hội Hoa Gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100109,
					"content": "Đã đến Lễ Hội Hoa Gió rồi, nhưng không biết có phải Cyrus quá bận hay không mà không thấy liên lạc với tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100110,
					"content": "Ồ... vậy thì cậu ấy cũng đến cái tuổi đó rồi, cũng nên tận hưởng Lễ Hội Hoa Gió thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100111,
					"content": "Có lẽ anh ấy đã vượt quá độ tuổi đó rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "Vậy sao? Tôi không thấy gì cả, chỉ thấy... chậc, bỏ đi, không nói chuyện này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100113,
					"content": "Tôi đã thu thập một số khoáng thạch, cũng đã ghi chép lại địa hình và ma vật, còn muốn chụp hình lưu niệm Tuyết Sơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100114,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi đến Tuyết Sơn một chuyến không, chụp hình hai nơi đó lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100115,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "Ừm, vậy thì nhờ bạn. Tôi đã đánh dấu hai nơi đó trên bản đồ rồi, bạn cứ đi là được, xong việc hãy quay về tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100117,
					"content": "Bạn không về xem sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "Không khí trong thành quá náo nhiệt, tôi cảm thấy hơi khó chịu, đối với tôi mà nói thì ở đây còn dễ chịu hơn chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100119,
					"content": "Hơn nữa tôi còn có rất nhiều việc phải làm ở đây, tạm thời không thể về được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100120,
					"content": "Tôi đã đánh dấu nơi đẹp nhất cho bạn trên bản đồ, bạn cứ đến đó là được, xong việc hãy quay về tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
