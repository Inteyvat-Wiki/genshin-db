			"dialogs": [
				{
					"id": 700100201,
					"content": "Về ủy thác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "Thế nào, bạn làm xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100203,
					"content": "Xong hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "Vất vả rồi. Tôi đã gói xong món đồ để tặng cho đứa trẻ đó rồi, bạn hãy giúp tôi đi thêm một chuyến nhé, sau khi giao đồ qua đó thì nhớ quay lại. Tôi sẽ trả công cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100205,
					"content": "Mặc dù không biết những thứ này có đủ dùng hay không, nhưng nếu muốn tuyển người mới, lịch sử ma vật và khoáng thạch chắc chắn là hấp dẫn nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "Xem ra kế hoạch chiêu mộ này không có tác dụng gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100302,
					"content": "Về món đồ Iris gửi đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "Ơ, chị ấy gửi đồ cho tôi sao? À đúng rồi... lần trước tôi đã nhờ chị ấy mà quên mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100304,
					"content": "Bạn thực sự bận chơi Lễ Hội Hoa Gió sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "Lễ Hội Hoa Gió? Tôi không có thời gian, kế hoạch chiêu mộ lúc trước đã không có tác dụng gì rồi, tôi đang bận lên kế hoạch hoàn toàn mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100306,
					"content": "Để tôi xem Iris gửi gì cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100307,
					"content": "Khoáng thạch... không có tác dụng gì... bây giờ không có người trẻ nào thích cái này nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100308,
					"content": "Bản đồ địa hình, cái này đưa cho người trong hiệp hội dùng còn được, nếu dùng để chiêu mộ người mới thì sợ không có ai xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100309,
					"content": "Ghi chú điều tra ma vật... Cái này cho nhà mạo hiểm trong hiệp hội chép ra vài bản... Dùng để tuyển dụng thì thôi đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100310,
					"content": "Ồ? Còn có hai tấm hình này, nhìn có vẻ cũng ổn, phong cảnh đẹp, nhìn cũng khá an toàn, nhất định sẽ có người thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100311,
					"content": "Tại sao lại chọn cái này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "Tôi thấy những thứ liên quan đến nhà mạo hiểm là bị loại ra mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700100313,
					"content": "Bạn không biết hiện trạng của hiệp hội bây giờ rồi, giới trẻ hiện nay hầu như không quan tâm đến ma vật, khoáng thạch và bản đồ địa hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100314,
					"content": "Để thu hút sự chú ý của họ, bạn phải sử dụng thứ gì đó... \"thực tế\" hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100315,
					"content": "Hiện đang là thời điểm Lễ Hội Hoa Gió, những người trẻ nhất định sẽ nghĩ dùng một cách đặc biệt nhưng không quá nguy hiểm để thể hiện sức hút của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100316,
					"content": "Thám hiểm Tuyết Sơn chính là một cách, chỉ cần có người hứng thú với nó, là có thể đến hiệp hội để hỏi về những vấn đề liên quan và cũng có thể gia nhập hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100317,
					"content": "Ừm... Cho dù họ không muốn tham gia vào hiệp hội, thì... Thì cho chúng ta chút ủy thác cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100319,
					"content": "Hơn nữa bạn thấy đó, vị trí của hai bức tranh này đều ở cạnh đường lớn, chỉ cần cẩn thận sẽ không gặp nguy hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100320,
					"content": "Phải dùng đến cách này rồi sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "Nhưng tình hình bây giờ, nếu không thật sự hết cách thì tôi cũng không nghĩ đến ý này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100322,
					"content": "Ồ, nếu bạn còn không tin, vậy thì cứ cầm hai tấm hình này đi tìm người xung quanh để hỏi xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100323,
					"content": "Bạn nói với họ trước về việc tuyển dụng của Hiệp Hội Nhà Mạo Hiểm, sau đó lấy hai bức ảnh ra, cứ nói là tư liệu tuyển dụng.",
