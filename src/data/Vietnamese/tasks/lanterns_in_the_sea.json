					"nextDialogs": [
						400050508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050508,
					"content": "Chuyện này đến đây vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050509,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050510,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050511,
					"content": "Có điều, nếu các bạn gặp nạn ở Liyue này chỉ cần gọi tên tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050512,
					"content": "Cho dù là bạn hay là Liyue. Tất cả đèn lồng, tất cả cầu nguyện bình an, tôi đều nghe thấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050513,
					"content": "Vậy thì, chúc mừng năm mới.",
