					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "Tết Hải Đăng vốn là để kỷ niệm các vị anh hùng, trong đó cũng có bạn... Vì sao bạn lại không muốn xem chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050506,
					"content": "Tôi không muốn đến gần loài người. Họ quá vô tư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050507,
					"content": "Tháng ngày khổ luyện và tàn sát quá dài rồi... tôi đã quen với điều đó...",
