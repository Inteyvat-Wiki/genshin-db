						400050502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050502,
					"content": "Được rồi. Các bạn gọi tôi đến nơi có thể nhìn thấy Đèn Minh Tiêu là để làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
