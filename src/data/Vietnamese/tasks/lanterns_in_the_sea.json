			"dialogs": [
				{
					"id": 400050201,
					"content": "Hai vị đến từ Đạo Bảo Đoàn sao? Tôi đã ghi rõ trong mật thư là bản thân sẽ ngụy trang, vì vậy cũng mong hai vị cố gắng ngụy trang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050202,
					"content": "Vậy mà không ngờ hai vị lại không hề che giấu thân phận, thật là dũng cảm, tại hạ bái phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050203,
					"content": "Hừm. Bọn ta khác với kẻ làm chuyện mờ ám như ngươi, không cần dùng mặt nạ che dấu thân phận của mình!",
