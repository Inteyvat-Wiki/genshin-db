			"dialogs": [
				{
					"id": 400050401,
					"content": "Mau nói ra âm mưu của ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050402,
					"content": "Ta nói ta nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050403,
					"content": "Không nói, ta sẽ cho ngươi biết lễ độ! Ủa...Khai nhanh như vậy sao",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050404,
					"content": "Kỳ thực tôi... là đạo tặc mới hành nghề luôn ngưỡng mộ uy danh của Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050405,
					"content": "Tên đạo tặc mới hành nghề?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050406,
					"content": "Đối với kẻ mới vào nghề như tôi, lại cô đơn một mình... Đạo Bảo Đoàn chính là vùng đất hứa trong lòng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050407,
					"content": "Đợi một lát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050408,
					"content": "Vì thế tôi quyết định đánh liều một phen, lấy chút danh tiếng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050409,
					"content": "Đợi chút! Tôi hoàn toàn không hiểu gì hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050410,
					"content": "Hoàn toàn khác với tưởng tượng của chúng tôi về một hung thủ phóng hỏa vừa tàn độc, vừa gian xảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050411,
					"content": "Phóng hỏa, phóng hỏa gì cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050412,
					"content": "Ngươi luôn lởn vởn gần khu vực dễ cháy, không phải vì muốn phóng hỏa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050413,
					"content": "Á, bạn nói gì vậy. Tôi chỉ muốn khảo sát chút thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050414,
					"content": "Kế hoạch của tôi không hề liên quan gì đến đống nguyên liệu dễ cháy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050415,
					"content": "Không có liên quan gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050416,
					"content": "Tôi chỉ muốn... Trộm viên \"Phù Sinh Thạch\" khổng lồ hiếm thấy, hai mươi năm mới xuất hiện một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050417,
					"content": "Kế hoạch của tôi là, tranh thủ lúc trời tối chém đứt dây xích để nó bay về phía biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050418,
					"content": "Ồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050419,
					"content": "Sau đó lại tìm cách nhấn chìm nó ở vịnh nước nông Vân Lai Hải, đúng là một kế hoạch phạm tội hoàn hảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050420,
					"content": "Còn quá nhiều điểm thiếu sót! Ví dụ như làm sao có thể nhấn chìm Phù Sinh Thạch xuống đáy biển?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050421,
					"content": "Tôi cũng đang nghĩ đến vấn đề đó, vì vậy vẫn chưa bắt đầu kế hoạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050422,
					"content": "Người này đúng là đầu óc không bình thường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050423,
					"content": "#Được rồi, {NICKNAME}, dạy cho hắn một bài học đi.",
					"roleType": "TALK_ROLE_NPC",
