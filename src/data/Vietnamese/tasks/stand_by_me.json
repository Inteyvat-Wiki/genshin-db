			"dialogs": [
				{
					"id": 750711321,
					"content": "Các bạn đánh bại kẻ địch, mở chiếc lồng nhốt Thú Thồ Hàng nhỏ. Thú Thồ Hàng chạy từ trong lồng ra, phát ra tiếng kêu vui vẻ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750711301
					]
				},
				{
					"id": 750711301,
					"content": "Wow... Phù, cuối cùng cũng xong rồi! Thật nguy hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711302,
					"content": "Suỵt! Nhìn xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711303
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711303,
					"content": "Tách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711304
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711304,
					"content": "Hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711305
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711305,
					"content": "Ôi... Mối quan hệ của chúng thân thiết quá. Tôi còn tưởng Thú Thồ Hàng sẽ bị ăn mất hay gì đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711306,
					"content": "Hihi, đừng thấy Tepetlisaur hung dữ vậy mà hiểu lầm, thật ra tính cách của chúng rất ôn hòa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711307
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711307,
					"content": "Cuối cùng cũng chụp xong rồi, bản sao đây. Còn thù lao... thì đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711308
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711308,
					"content": "Haiz... Cứ tưởng có thể chụp được hình ảnh Tepetlisaur non và Tepetlisaur trưởng thành tương tác với nhau, nhưng không ngờ lại để một con Thú Thồ Hàng giành mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711309
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711309,
					"content": "Hihi, nhưng Thú Thồ Hàng cũng đâu đáng ghét. Anh cũng cảm thấy vậy mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711310,
					"content": "Tôi cảm thấy thế nào không quan trọng! Quan trọng là hội đồng giám khảo nhiếp ảnh cảm thấy như thế nào thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711311
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711311,
					"content": "Nhưng mà... Đứa nhóc này lang thang trong môi trường lạ lẫm như Natlan vẫn nguy hiểm quá. Tôi cũng vừa hay thiếu một trợ thủ thồ hàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711312
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711312,
					"content": "Hihi, tôi đành miễn cưỡng nhận nuôi nó vậy.",
