				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "Hừm? Quặng đá này, hình như khác quặng đá kia phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300102,
					"content": "Đương nhiên rồi, thứ được tạo ra bởi hai loại quặng này cũng có giá trị khác nhau đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300103,
					"content": "Ồ... nhưng mà, hai loại quặng này sao chỉ còn lại một ít vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300104,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300105,
					"content": "Mọi người đang làm gì đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#Chào {F#chị}{M#anh}, em đang kiểm tra vài món đồ sắt của bố em đặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300107,
					"content": "Chú thợ rèn tốt lắm, chú ấy hứa với em là sẽ rèn cho em một thanh kiếm nhỏ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300108,
					"content": "Nhưng mà, chú ấy nói nguyên liệu đang không đủ, cho nên món đồ mà bố em đặt cần phải dời lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300109,
					"content": "Còn thanh kiếm của em thì không biết khi nào mới được làm xong luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300110,
					"content": "Haiz, cũng hết cách rồi, gần đây trong tiệm nhiều khách nên khoáng sản có chút thiếu thốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300111,
					"content": "Những nơi có nhiều khoáng sản thì lại có nhiều ma vật, cho nên tôi cũng không dám đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300112,
					"content": "Cho nên tôi chỉ có thể chờ thêm một thời gian rồi nhờ một nhà mạo hiểm giúp tôi đi khai khoáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300113,
					"content": "Vậy, vậy phải chờ đến khi nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300114,
					"content": "#{F#Chị}{M#Anh}, em nghe mọi người nói {F#chị}{M#anh} rất giỏi đối phó với ma vật mà phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300115,
					"content": "#{F#Chị}{M#Anh} có thể giúp đỡ em không, cầu xin {F#chị}{M#anh} đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300116,
					"content": "#Cứ giao cho {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "Nhà lữ hành, bạn muốn đi thám thính tình hình sao? Vậy để tôi ký hiệu những mỏ khoáng thường gặp cho bạn nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300119,
					"content": "Ừm, được rồi đó, hãy cẩn thận nhé, gần đó nhiều ma vật lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300120,
					"content": "#Vậy thì nhờ {F#chị}{M#anh} giúp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300117,
					"content": "#Được rồi, để {F#chị}{M#anh} nghĩ cách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
