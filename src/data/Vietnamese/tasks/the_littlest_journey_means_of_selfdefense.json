			"dialogs": [
				{
					"id": 210300201,
					"content": "Nhà lữ hành, tình hình bên đó thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300202,
					"content": "Bên đó tạm thời an toàn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "#Không hổ danh là {F#chị}{M#anh}, lợi hại thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300204,
					"content": "Bố có nói là khi đi du lịch thì cũng cần phải thuê vài người để bảo vệ em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300205,
					"content": "#Hy vọng những người đó có thể giỏi được như {F#chị}{M#anh} vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300206,
					"content": "Chú thợ rèn, vậy giờ chú có thể tiếp tục đi khai khoáng để làm đồ cho bố em rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210300207,
					"content": "Hahaha, đương nhiên rồi, để chú chuẩn bị chút rồi đi ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Lão Zhang"
				},
				{
					"id": 210300208,
					"content": "Nhưng số lượng khoáng sản mà một mình đi khai thác cũng sẽ có giới hạn... hy vọng nơi đó không còn xuất hiện ma vật nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lão Zhang"
				}
			]
		},
