					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "Xin chào, nhà lữ hành. Thời điểm này tốt nhất nên ở lại trong thành, đừng đi ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "Chắc bạn cũng nhìn thấy những thiên thạch đang rơi bên ngoài kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230104,
					"content": "Không biết tại vì sao, thời gian này thiên thạch rơi càng ngày càng nhiều hơn, bên ngoài càng thêm nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230105,
					"content": "Công việc trong thành càng ngày càng nhiều, đội kỵ sĩ cũng bận tối tăm mặt mũi. Mà gần đây còn phát hiện ra tung tích của rất nhiều Đạo Bảo Đoàn gần thành phố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230106,
					"content": "Đám người sẵn sàng vì tiền mà làm mọi chuyện này, chỉ sợ là muốn thừa nước đục thả câu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230107,
					"content": "Nếu như bạn đồng ý, có thể giúp đánh đuổi đám Đạo Bảo Đoàn đi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230108,
					"content": "Đây vốn là trách nhiệm của đội kỵ sĩ, nhưng chúng tôi thực sự không thể rút ra bất cứ ai để giải quyết chuyện này, chỉ có thể nhờ vào bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230109,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "Vậy phiền bạn rồi, trong tình hình này còn nhờ bạn giúp, thực ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230111,
					"content": "Đạo Bảo Đoàn không sợ thiên thạch sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "Hừ, vì tiền đám người đó có lẽ chẳng sợ gì hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230113,
					"content": "Vậy phiền bạn rồi, trong tình hình này còn nhờ bạn giúp, thực ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
