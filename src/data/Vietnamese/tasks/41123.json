			"dialogs": [
				{
					"id": 411230401,
					"content": "Á á! Đừng, đừng qua đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 411230402,
					"content": "Í? Không phải ma vật... bạn, bạn là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 411230403,
					"content": "Về tình hình của ma vật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "Tình hình của ma vật... còn cần phải hỏi sao? Tôi vừa mới chạy ngang qua đám ma vật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 411230405,
					"content": "Đám ma vật đang tụ tập ngay bên đó, trông như thể chúng sắp tấn công vào trấn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 411230406,
					"content": "Nếu không phải tôi chạy nhanh, nói không chừng bạn không thể thấy tôi nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 411230407,
					"content": "Đám ma vật ấy ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "Ngay bên cạnh trấn, rất gần, chỉ đi vài bước là thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 411230409,
					"content": "Bạn cũng mau lánh đi, tôi ở đây nghỉ ngơi một lát... lát nữa sẽ quay trở lại báo tình hình cho mọi người trong trấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow Nhát Gan"
				}
			]
		},
		{
			"id": 4112308,
			"completionStepIds": [
				4112308
