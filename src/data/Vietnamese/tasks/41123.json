			"dialogs": [
				{
					"id": 411230801,
					"content": "Í? Tại sao lại là bạn, bạn đang làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 411230802,
					"content": "Đám ma vật đó bị tôi đã hạ hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
