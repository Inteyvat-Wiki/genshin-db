						411230805
					]
				},
				{
					"id": 411230805,
					"content": "Haiz... Tôi không dám đi một mình, nhỡ bị ma vật phát hiện ra thì chết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 411230806,
					"content": "Thôi bỏ đi, bất kể bạn nói là thật hay giả, tôi cũng phải trở về báo một tiếng.",
					"roleType": "TALK_ROLE_NPC",
