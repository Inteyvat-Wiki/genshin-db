					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "Bạn đuổi hết đám Đạo Bảo Đoàn đó đi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230302,
					"content": "Đuổi đi hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "Thật tốt quá, quả thực đã giúp một việc lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230304,
					"content": "Đám Đạo Bảo Đoàn nhận được bài học, có lẽ sẽ không dám thừa nước đục thả câu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230305,
					"content": "Nếu không còn việc gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "Này, xin dừng bước.... vẫn còn có một việc cần nhờ bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230307,
					"content": "Thực ra sau khi thiên thạch rơi, đội kỵ sĩ đã nhận được rất nhiều báo cáo về những ma vật bất thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230308,
					"content": "Những báo cáo này đề cập đến, đám ma vật dường như bị ảnh hưởng bởi thiên thạch và trở nên đặc biệt cáu kỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230309,
					"content": "Phòng thủ của thành Mondstadt khá toàn diện, không cần lo lắng, nhưng có một thiên thạch rơi xuống cạnh Thanh Tuyền Trấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230310,
					"content": "Trong Thanh Tuyền Trấn mặc dù có rất nhiều thợ săn, chúng tôi cũng đã phái kỵ sĩ đến giúp đỡ, nhưng địa hình ở đó rất khó để phòng thủ một cách toàn diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230311,
					"content": "Nếu nhỡ để ma vật lọt vào trong trấn thì nguy to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230312,
					"content": "Có thể nhờ bạn đến xung quanh Thanh Tuyền Trấn xem tình hình của đám ma vật đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230313,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "Vậy phiền bạn rồi, tôi sẽ cố gắng hết sức bố trí thêm một vài kỵ sĩ nữa đến hỗ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230315,
					"content": "Tình hình Thanh Tuyền Trấn sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "Nói thật là... không lạc quan lắm, ngoài việc phải giải quyết rất nhiều việc liên quan đến thiên thạch, còn phải đề phòng đám ma vật và Đạo Bảo Đoàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230317,
					"content": "Thật sự quá khó để giải quyết nhiều việc cùng một lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230318,
					"content": "Vậy chuyện này làm phiền bạn rồi, tôi sẽ cố gắng hết sức bố trí thêm một vài kỵ sĩ nữa đến hỗ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
