					"nextDialogs": [
						411231105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231105,
					"content": "Đám người sẵn sàng vì tiền mà làm mọi chuyện này, chỉ sợ là muốn thừa nước đục thả câu...",
