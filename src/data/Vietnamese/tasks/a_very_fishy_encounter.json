	"talks": [
		{
			"id": 7004601,
			"completionStepIds": [
				7004601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7004601",
							"2"
						],
						"stepId": 7004601,
						"stateName": "QUEST_STATE_UNFINISHED"
