			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "Tốt quá, chuẩn bị xong cả rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460102,
					"content": "Cố lên Jala, tranh thủ bắt hết chúng trong vài ngày thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460103,
					"content": "Bắt, bắt gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "Ối! Sao ở Fontaine cũng xuất hiện kẻ săn trộm thế này... Dạo này buôn bán động vật kiếm được nhiều tiền lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460106,
					"content": "Không được, phải bắt cô lại rồi áp giải đến Sảnh Chấp Pháp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460107,
					"content": "...Là hai vị sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460108,
					"content": "Tôi mới từ Sảnh Chấp Pháp qua đây, cần tôi dẫn đường cho hai vị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460109,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460110,
					"content": "Tốt quá, tôi thích những người thẳng thắn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "Đợi đã, có gì đó không đúng... Khi nghe nói bị bắt thì lại không hề sợ sệt, có thể là do tái phạm, hoặc là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460114,
					"content": "Tôi là người tốt luôn đứng về phía chính nghĩa mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460115,
					"content": "Nói chính xác hơn thì tôi là cố vấn môi trường của Sảnh Chấp Pháp, \"Thợ Săn Phóng Sinh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460116,
					"content": "Bởi vì thứ tôi muốn bắt chính là loài cá ngoại lai xâm nhập vào vùng nước Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460117,
					"content": "Loài... ngoại lai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460118,
					"content": "Nghe quen quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "À, đúng là có ấn tượng. Tôi đã từng nghe thấy chuyện tương tự như vậy ở Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460122,
					"content": "Chuyện đã qua không cần nhắc nữa, tình hình hiện tại quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460123,
					"content": "Những loài cá ngoại lai đó được các thương nhân theo tín ngưỡng kỳ lạ cố tình phóng sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460124,
					"content": "Có loài cực kỳ hung hãn, có loài sinh sản rất nhanh, có loài được nuôi bằng thức ăn đặc biệt. Đối với các sinh vật thủy sinh địa phương thì chúng đều là những rắc rối lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460125,
					"content": "Nếu bị chúng chiếm giữ lãnh địa, thay đổi kết cấu sinh thái thì chất lượng nước của Fontaine sẽ bị ảnh hưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460126,
					"content": "Không bàn đến vấn đề sức khỏe lâu dài của người Fontaine, đến cả vị của những loại nước uống như Fonta cũng sẽ thay đổi. Đến lúc đó, nền kinh tế của Fontaine cũng sẽ bị ảnh hưởng, chuyện lớn lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460127,
					"content": "Thương hiệu Fonta không được gục ngã!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "Càng nói giảm nói tránh thì tôi càng thấy vấn đề này nghiêm trọng. Chúng ta không thể khoanh tay đứng nhìn được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460130,
					"content": "Mấy chuyện bắt cá này thì chúng tôi cũng giỏi lắm, hay là để chúng tôi giúp một tay nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460131,
					"content": "Hay quá, tôi đợi câu này đấy. Đây mới là tác phong của hai vị chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460132,
					"content": "Tôi đã chuẩn bị xong một khu vực săn bắt, mồi nhử trong đó sẽ thu hút toàn bộ loài cá xâm nhập vào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460133,
					"content": "Hãy thể hiện khí thế thực thi chính nghĩa nào, Kỵ Sĩ Danh Dự và trợ thủ màu trắng, tôi sẽ ủng hộ hết mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460134,
					"content": "Sao cô ấy biết rất rõ về chúng ta nhỉ... Là do tôi bị ảo giác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460128,
					"content": "Tuy tôi không uống nhiều, nhưng Fonta rất quan trọng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "Là gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "Hình như có chút ấn tượng, chuyện tương tự như thế này hình như từ rất lâu trước đây đã từng nghe qua ở Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460112,
					"content": "Hình như... chúng ta hiểu lầm gì đó rồi thì phải?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "Đúng vậy, khi nghe nói bị bắt thì lại không hề sợ sệt, có thể là do tái phạm, hoặc là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460104,
					"content": "Săn, săn trộm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}