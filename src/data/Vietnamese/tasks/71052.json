			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "Về nham thạch kỳ quái...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "Chụp được ảnh nham thạch kỳ quái sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500603,
					"content": "Hãy cho tôi xem thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500604,
					"content": "Chính là cái này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "Ây da, tấm hình này! Thật không hổ danh là máy ảnh đời mới do Fontaine làm ra mà, chụp ảnh mới rõ nét làm sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500606,
					"content": "Hồi trước tôi có mua một lô máy thử nghiệm, chụp ra rất mờ, hơn nữa mỗi một chiếc máy cần có hai người khiêng mới được, cuối cùng chỉ đành để ở Giáo Viện đóng bụi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500607,
					"content": "Đóng bụi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "Phải đó, dù gì cũng là tiền một bữa cơm của tôi mà. Ừm... xem ra đến lúc phải mua máy mới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500610,
					"content": "Lạc đề quá rồi, để tôi xem, tảng đá này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500611,
					"content": "Ừm, đây là hóa thạch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500612,
					"content": "Hóa thạch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "Đúng vậy, hơn nữa còn có rất nhiều sinh vật biển... Thú vị! Liyue có một câu nói... \"Rừng rậm và đồng ruộng bị đại dương bao la nhấn chìm\"... chính là nói về cái này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500614,
					"content": "Vực Đá Sâu có thể xuất hiện hóa thạch, chứng tỏ rằng những sinh vật này từng bị chôn vùi xuống lòng đất một cách nhanh chóng, nên khung xương mới có thể giữ được hình dạng hoàn chỉnh như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500615,
					"content": "Nhắc mới nhớ, nghe nói ở đây cũng thường xảy ra động đất... vậy là rõ rồi, hoạt động địa chất sôi nổi là một trong những điều kiện bắt buộc để hình thành hóa thạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500616,
					"content": "Cái này rất có ích cho việc nghiên cứu sinh vật cổ ở khu vực này đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500617,
					"content": "Nhưng chỉ có một tấm thì không đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500619,
					"content": "Thế này đi, nếu như bạn còn thấy hóa thạch giống vậy thì hãy chụp lại cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500620,
					"content": "Phải chụp mấy tấm mới được?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "Để tôi nghĩ xem, để đưa vào báo cáo, thì ảnh dạng này cần 4 - 5 tấm chắc đủ rồi... Vậy thì 5 tấm nha, hãy cho tôi 5 tấm hình nham thạch tương tự vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500622,
					"content": "Tôi sẽ đưa ra mức giá hợp lý để mua chúng, đây đúng là một phát hiện lớn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500608,
					"content": "Có hơi lãng phí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
