			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "Được lắm được lắm, đúng là những tấm hình hiếm có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500903,
					"content": "Chỉ tiêu của đội thăm dò, chỉ cần những tấm hình này là đã đủ lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500904,
					"content": "Bạn xem, những thứ này đều là xương của sinh vật biển cổ đại, hình dạng cũng rất rõ rệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500905,
					"content": "Chứng tỏ rằng trước khi hình thành Vực Đá Sâu, nơi đây thật ra là môi trường đại dương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500906,
					"content": "Thật đáng tiếc, nếu như ở Sumeru phát hiện hóa thạch như vậy, thì đã có thể trực tiếp đem về Giáo Viện để tiến hành nghiên cứu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500907,
					"content": "Lần sau khi họp với Tổng Vụ phải bàn lại việc này mới được, phía chúng tôi ra tiền mời người đến bảo vệ cũng được, phải cẩn thận một chút, không thể để thợ mỏ làm hỏng số hóa thạch này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500908,
					"content": "Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500909,
					"content": "Nhưng mà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "Số hình này... miễn cưỡng cũng xem như đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500912,
					"content": "Trước đây cũng nói rồi nhỉ, hóa thạch có hình dáng hoàn hảo, kết cấu hoàn chỉnh như vậy, thì việc hình thành nó cũng phải có điều kiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500913,
					"content": "Chính là bị chôn vào đất một cách nhanh chóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500914,
					"content": "Hóa thạch của Vực Đá Sâu, cơ bản chỉ xuất hiện ở một số khu vực có độ cao cố định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500918,
					"content": "Độ cao cố định?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "Ây da, từ góc độ địa chất học thì sự chênh lệch ở cấp độ này có thể bỏ qua không tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500915,
					"content": "Tóm lại, điều này chứng minh rằng thời kỳ hình thành hóa thạch rất ngắn, hơn nữa đều tương đối gần nhau... chứng tỏ rằng trong thời gian ngắn đã xảy ra biến đổi sinh thái đặc biệt lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500916,
					"content": "Ví dụ như một xung kích cực lớn nào đó đã dẫn đến việc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500917,
					"content": "Ừm, Vực Đá Sâu rốt cuộc đã xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500919,
					"content": "Độ cao chênh lệch cũng lớn lắm mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "Chẳng lẽ chưa đủ hình sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
