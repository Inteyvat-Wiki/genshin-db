			"dialogs": [
				{
					"id": 750730301,
					"content": "Huhu, cuối cùng cũng được thả ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730302,
					"content": "Khinh khí cầu này cứ lắc lư suốt. Haiz, nói không chừng chỉ một cơn gió thổi tới là sẽ lật ngược mất...",
