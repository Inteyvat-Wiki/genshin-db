					"nextDialogs": [
						750730303
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730303,
					"content": "Khi đó e là ngay cả Bà Itztli cũng không có cách cứu tôi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730304,
					"content": "Cô là ai, tại sao lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "A, tôi còn chưa tự giới thiệu. Tôi tên Conulaf, là tư tế thực tập của Chủ Nhân Gió Đêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730306,
					"content": "Bây giờ đang trong quá trình tu tập... Trước đây tôi luôn ở trong bộ tộc, nên các trưởng bối nói rằng \"Con phải ra ngoài ngắm nhìn thế giới!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730307,
					"content": "Nên họ đã dùng danh nghĩa tu luyện để đá tôi ra khỏi cổng bộ tộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730308,
					"content": "Nhưng cái \"thế giới\" kiểu bị Hilichurl bắt nhốt như vậy vẫn không nên ngắm thì hơn, ân nhân thấy đúng không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730309,
					"content": "Đi thám hiểm một mình rất nguy hiểm đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "Đúng vậy! Nếu không gặp được ân nhân thì không biết tôi còn bị nhốt ở đây đến khi nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730313,
					"content": "Tóm lại là cảm ơn ân nhân đã cứu mạng... Hóng gió trên này lâu vậy rồi, tôi vẫn nên xuống dưới trước rồi tiếp tục nghĩ đến chuyện tu luyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730314,
					"content": "Trên người tôi không có nhiều Mora, nhưng người nhà tôi từng nói là mang ơn phải đền đáp, nên xin ân nhân hãy nhận lấy những thứ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
