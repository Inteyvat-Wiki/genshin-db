			"dialogs": [
				{
					"id": 747060101,
					"content": "...Còn con này thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747060102,
					"content": "Hình như vẫn còn thiếu một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "Columbina, còn cả Furina nữa? Hai cô đang làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "Đang cùng đạo diễn Furina... \"tuyển diễn viên\" đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747060105,
					"content": "Nói vậy cũng không sai. Chỉ có điều diễn viên chúng tôi chuẩn bị chọn, là cá trong bể này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "Cá cũng diễn được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Bây giờ diễn viên động vật cũng không hiếm mà. Chúng tôi muốn chọn một con cá phù hợp để quay một vài cảnh phụ, nhằm tăng thêm bầu không khí trong phim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "Chỉ là đã xem một vòng rồi mà vẫn chưa tìm được con nào thật sự phù hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#Hay là thử nhờ {NICKNAME} và Paimon đi? Nhiều vấn đề họ đều có thể giải quyết được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747060110,
					"content": "Rất vui khi cô tin tưởng chúng tôi đến vậy... nhưng về vấn đề này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "Chúng tôi có thể tìm thêm vài con cá nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "Đúng nhỉ! Thủy cung này do hai người quản lý mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "Có nghĩa là từ giờ chúng tôi xuống nước chỉ cần chú ý thêm một chút là được? Nghe có vẻ cũng không khó lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "Vậy thì quyết định thế nhé! Một lát nữa tôi sẽ chia sẻ với hai người kiểu cá phù hợp trong tưởng tượng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "Vậy bây giờ hai người trở thành \"người tìm kiếm tài năng\" rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 747060117,
					"content": "Cô đi theo Furina học được nhiều từ mới thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "Chúng tôi có thể xuống nước xem thử?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
