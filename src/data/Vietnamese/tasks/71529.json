						],
						"pointId": 7030
					}
				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "Vô lý... Có cách đấu bọ như vậy sao? Danh tiếng của bổn đại gia ta bị hủy hoại mất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "Cảm ơn các hạ đã chỉ giáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "Chất Hơn Vẻ Bề Ngoài"
				},
				{
					"id": 716665003,
					"content": "Không ngờ lại còn khách sáo như vậy nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Hừ! Tên T{RUBY#[S]Quỷ Vương Đấu Bọ Thiên Tài}hả Bò kia! Xem ra trong thời gian chúng tôi không có ở đây, anh vẫn thua sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "Không đâu, chỉ cần Quỷ Vương Đấu Bọ Thiên Tài chưa bỏ cuộc thì xem như anh ấy vẫn chưa thua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "Chất Hơn Vẻ Bề Ngoài"
				},
				{
					"id": 716665006,
					"content": "Bất luận trong trận đấu hay trong cuộc sống, tạm thời rơi vào thế bất lợi là chuyện thường tình, chỉ khi bản thân bỏ cuộc thì mới xem là \"thất bại\" thực sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "Chất Hơn Vẻ Bề Ngoài"
				},
				{
					"id": 716665007,
					"content": "Nói... nói hay lắm! Bổn đại gia vẫn chưa chịu thua đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "Nhưng cũng đừng tìm lý do nữa, bớt nói những lời hoa mỹ lại và tập trung chiến đấu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "Chất Hơn Vẻ Bề Ngoài"
				},
				{
					"id": 716665009,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "Quỷ Vương, hình như đại ca không giỏi đối phó với kiểu đối thủ này. Hay là đổi người khác ra trận, rồi quan sát kỹ cách chiến đấu của đôi bên đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 716665011,
					"content": "Trong quá trình tập huấn, quan sát chiến đấu cũng rất quan trọng, đồng thời cũng có thể học được kỹ năng mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 716665012,
					"content": "Có lý! Đúng lúc bạn thân của ta đến rồi! \"Cánh Tay Phải Của Quỷ Vương\", lần này đến lượt ngươi ra trận nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Hihi, {NICKNAME} cuối cùng cũng ra trận rồi. Phải thể hiện cho tốt đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "Đơn giản thôi mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#Không ngờ nhà mạo hiểm huyền thoại {NICKNAME} cũng đến tham gia à? Vậy thì tôi phải nghiêm túc chuẩn bị rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chất Hơn Vẻ Bề Ngoài"
				},
				{
					"id": 716665015,
					"content": "Woa! Sợ quá đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
