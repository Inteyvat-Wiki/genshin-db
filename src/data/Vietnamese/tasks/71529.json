			"dialogs": [
				{
					"id": 716665101,
					"content": "Hay lắm, tôi thua rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "Chất Hơn Vẻ Bề Ngoài"
				},
				{
					"id": 716665102,
					"content": "#Thua {NICKNAME} cũng là một niềm vinh hạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "Chất Hơn Vẻ Bề Ngoài"
				},
				{
					"id": 716665103,
					"content": "Thì ra là dùng cách này để đánh thắng sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "Không sai, đối mặt với kẻ địch linh hoạt thì phải thay đổi nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "#Khi một chiến thuật không hiệu quả thì nên thay đổi lối tư duy. Tôi và {NICKNAME} thường suy nghĩ linh hoạt khi đi đến những nơi khác đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "Nếu chỉ chăm chăm vào một phương pháp, thì dù cố gắng thế nào cũng không giải quyết được vấn đề đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "Ta nhớ đôi khi Shinobu cũng nói những lời tương tự, có vẻ rất hợp lý đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "Để sau này nghĩ tiếp vậy, bây giờ quan tâm chuyện chính trước, đấu bọ quan trọng hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
