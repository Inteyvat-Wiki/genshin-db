			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chất Hơn Vẻ Bề Ngoài"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-352.046,
							200.421,
