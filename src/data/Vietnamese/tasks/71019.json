			"dialogs": [
				{
					"id": 710190301,
					"content": "(Một chậu trông có vẻ như hòn non bộ dùng để trang trí, một ký hiệu lạ được đặt trên đỉnh của hòn non bộ.)",
					"roleType": "TALK_ROLE_NPC",
