			"dialogs": [
				{
					"id": 710190201,
					"content": "Trong chiếc bồn lớn này, có một tảng đá lớn... đây hẳn là \"hòn non bộ\" nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "Nhưng hòn non bộ không phải là thường được đặt trong sân vườn gì đó sao... lại đặt ở đây để làm gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "Í? Trên đỉnh hòn non bộ này còn đặt một thứ kỳ lạ, hình như để đánh dấu cái gì đó... hừm, thật khiến người ta quan tâm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Cái đó, dù sao chúng ta cũng đang trên hành trình... khi đến Liyue hãy để ý một chút những ngọn núi tương tự với hòn non bộ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
					"content": "Nếu thực sự phát hiện ra điều gì đó, vậy thì tốt quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
