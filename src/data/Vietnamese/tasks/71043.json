			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "\"...Thượng sĩ Anton tìm thấy một cái chuông lớn ở phía đông nam... trên tường đá có viết chữ 'chúng'...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "Nhật Ký Của Fatui"
				},
				{
					"id": 710430102,
					"content": "\"...Tương tự như chiếc chuông lớn mà đại úy đã nhìn thấy trong đống di tích ở phía tây bắc trước đây, có lẽ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "Nhật Ký Của Fatui"
				},
				{
					"id": 710430103,
					"content": "\"Phái hai người Snezhevna và Fadeyka, rung cả hai chuông ở cả hai địa điểm trong di tích...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "Nhật Ký Của Fatui"
				},
				{
					"id": 710430104,
					"content": "\"...Tiếng gào thét kinh hoàng vang vọng qua các bức tường đá, màn sương đen tan biến. Hiện tượng kỳ lạ không thể giải thích được... như thể đang thông báo có ai đó sẽ đến...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "Nhật Ký Của Fatui"
				},
				{
					"id": 710430105,
					"content": "\"...Mười người hy sinh, và cả hai đội tiên phong đều bị tổn thất nặng nề. Đại úy ra lệnh sơ tán ngay lập tức...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "Nhật Ký Của Fatui"
				},
				{
					"id": 710430106,
					"content": "(Một tấm bản đồ đơn giản trượt ra khỏi cuốn nhật ký, trên bản đồ đánh dấu vị trí hai quả chuông lớn ở phía tây bắc và đông nam, và vẽ hai hình đầu lâu nổi bật.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nhật Ký Của Fatui"
				}
			]
		},
