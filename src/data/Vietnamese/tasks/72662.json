			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "Tìm được nhanh vậy sao? Không hổ danh là Nhà Mạo Hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620202,
					"content": "Nhiêu đây đủ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "Ừm, tiếp theo để tôi, chỉ cần như vậy... như vậy... rồi như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620204,
					"content": "Làm tốt lắm, chính là những thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620205,
					"content": "Tiếp theo là phải quăng mồi câu xuống, sau đó đợi \"Ánh Trăng Biển\" xuất hiện đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620206,
					"content": "Ừm, tôi cố tình chọn nơi này, năm xưa chúng tôi đã lên bờ từ nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620207,
					"content": "\"Ánh Trăng Biển\" dẫn chúng tôi quay về, cũng đã biến mất từ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620208,
					"content": "Cho nên mọi người chuẩn bị xong chưa? Gặp được \"Ánh Trăng Biển\" thì đừng quên cầu nguyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620209,
					"content": "Nếu không thành công thì phải làm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620211,
					"content": "Đừng nói những điều nản chí vậy, sẽ thành công mà, \"Ánh Trăng Biển\" nhất định sẽ đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620212,
					"content": "Ừm! Sẽ thành công mà! Cá lớn, ngươi nhất định phải ngoan ngoãn cắn câu đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620213,
					"content": "Mọi người mau nhìn xem! Dưới nước đang phát sáng! Có gì đó đang qua đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620214,
					"content": "Thật sao! Đúng thật là \"Ánh Trăng Biển\" đến rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620215,
					"content": "Ối ối! Thủ Vệ Di Tích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620216,
					"content": "Tại sao lại là tên này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
