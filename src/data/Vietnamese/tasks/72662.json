			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "Sao... sao lại như vậy, ngay cả mồi câu của cha tôi cũng không có tác dụng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620302,
					"content": "Đừng đau lòng, cũng tại Thủ Vệ Di Tích đó! Nhất định là do nó đã dọa \"Ánh Trăng Biển\" chạy mất! Chúng ta thử lại nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620303,
					"content": "Ừm, hay là chúng ta thử lại lần nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620306,
					"content": "Thôi vậy, tôi có chút mệt, có lẽ Nantuck nói đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620307,
					"content": "Haiz... bây giờ tôi muốn ra ngoài đi dạo, tôi phải suy nghĩ những việc tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620308,
					"content": "Đây là thù lao, dù sao đi nữa, cũng rất cảm ơn sự giúp đỡ của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620309,
					"content": "Xem ra bây giờ tiểu thư Kujirai muốn yên tĩnh một mình, qua một khoảng thời gian chúng ta lại đến thăm cô ấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}