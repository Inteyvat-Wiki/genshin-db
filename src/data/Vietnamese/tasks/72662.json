			"trigger": {
				"objectNames": [
					"Kujirai Momiji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "Mọi người xem! Tôi vừa xem lại nhật ký hàng hải của cha tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620102,
					"content": "Bên trong có một phần phụ lục, đề cập họ từng nghiên cứu được cách làm mồi câu đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620103,
					"content": "Lần cha tôi gặp \"Ánh Trăng Biển\", đã sử dụng một loại mồi câu đặc biệt trộn lẫn giữa Rong Biển và Mỏ Ma Tinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620104,
					"content": "Nếu chúng ta cũng có thể làm được thứ này, có lẽ sẽ thu hút được \"Ánh Trăng Biển\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620105,
					"content": "Tôi có nhiều Rong Biển, nhưng còn Mỏ Ma Tinh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620106,
					"content": "Đừng lo, tôi có.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "Hả? Thật sao? Khai thác được từ Araumi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620108,
					"content": "Bên trong nhật ký của cha tôi có nhắc đến Mỏ Ma Tinh nhất định phải khai thác từ phế tích ở Araumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620109,
					"content": "Tuy không rõ có khác biệt gì so với Mỏ Ma Tinh thường, nhưng chúng ta đã quyết định làm điều này, thì nên khắt khe chút, tốt nhất là làm theo hướng dẫn trong sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620110,
					"content": "Ở bên Araumi có rất nhiều ma vật, rất nguy hiểm. Chúng ta đến Hiệp Hội Nhà Mạo Hiểm treo ủy thác đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620111,
					"content": "Không cần, để tôi xử lý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "A... đúng rồi, tôi quên mất bạn vốn là Nhà Mạo Hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620113,
					"content": "Có bạn giúp đỡ thì thật là may mắn, vậy thì nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620114,
					"content": "Tôi quay về lấy dụng cụ làm mồi, một lát chúng ta tập hợp ở bãi cát phía tây Araumi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266202,
			"completionStepIds": [
				7266204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266204",
							"2"
						],
						"stepId": 7266204,
						"stateName": "QUEST_STATE_UNFINISHED"
