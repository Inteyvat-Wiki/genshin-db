			"dialogs": [
				{
					"id": 400230101,
					"content": "Nhà Lữ Hành, các bạn đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230102
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230102,
					"content": "Tôi đã giải thích tình hình cho Hiệp Hội Tenryou, cũng đã trình lên công văn của năm đó. Họ cuối cùng cũng tin tưởng sự trong sạch của tôi và \"Đền Âm Dương Quyết Lục\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230103
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230103,
					"content": "Tốt quá rồi, như vậy thì Shiki Taishou sẽ có thể chuyên tâm vào sứ mệnh của mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230104,
					"content": "Đúng vậy, giờ \"Đền Âm Dương Quyết Lục\" đã được tôi tu sửa để trở về với phiên bản nguyên sơ, là một bí cảnh để tu luyện võ nghệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230105
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230105,
					"content": "Tòa bí cảnh này mỗi khi vận hành một khoảng thời gian sẽ tiêu tốn hết sức mạnh bùa phép. Lúc đó tôi sẽ đóng cửa bí cảnh để nó hồi phục lại năng lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230109
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230109,
					"content": "Cơ hội hiếm có, bạn muốn khiêu chiến thử chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400230106,
						400230107
					],
					"speakerTitle": "Shiki Taishou"
				},
				{
					"id": 400230106,
					"content": "Tôi chuẩn bị xong rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				},
				{
					"id": 400230108,
					"content": "Ừm! Tôi cũng muốn mở mang tầm mắt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400230107,
					"content": "Tôi đang cảm thấy rất háo hức!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400230108
					]
				}
