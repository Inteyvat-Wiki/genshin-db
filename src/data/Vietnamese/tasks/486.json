				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "Có việc gì sao, tiểu thư Sara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "Xin lỗi, lúc nãy tôi đã ăn cơm rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "Cuối cùng cũng đợi được hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860205,
					"content": "Tôi không phải đang chào mời bán hàng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860206,
					"content": "Tôi cần ủy thác một việc cho Đội Kỵ Sĩ, muốn phiền hai vị gửi lời đến Đội Trưởng Đại Diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860207,
					"content": "Hóa ra là muốn tìm Jean à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860209,
					"content": "Là đồng đội tin cậy lẫn nhau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "Có gặp qua một lần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "Là người hầu trung thành của cô ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "Hử? Hai vị rất thân với đội trưởng Jean sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860210,
					"content": "Vậy sao? Ở cùng với tiểu thư Jean, nhất định là rất yên tâm nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860212,
					"content": "Tôi lại nghe nói cô ấy rất hài lòng với hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860214,
					"content": "Người...người hầu? Đội Kỵ Sĩ Tây Phong chẳng lẽ cũng muốn đi theo con đường của quý tộc cũ sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860215,
					"content": "#Xin lỗi, tính hài hước của {NICKNAME} có đôi lúc rất kỳ quái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860216,
					"content": "Tiểu thư Sara muốn chuyển lời gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860217,
					"content": "Ừm... thật ngại quá, hiện tôi không thể tự đi đến Đội Kỵ Sĩ, vì gần đây quán ăn rất bận rộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860218,
					"content": "Nhưng đúng lúc này, tuyến đường cung cấp thực phẩm của chúng tôi và Thanh Tuyền Trấn dường như đã bị bọn Hilichurl chiếm lĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860220,
					"content": "Nên muốn nhờ đội Kỵ Sĩ dọn đường giúp chứ gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "Hiểu rồi, phải dạy dỗ đám thợ săn một chút!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "Mà những người thợ săn của Thanh Tuyền Trấn lại chẳng mấy quan tâm, họ cho rằng chỉ cần phụ trách đi săn là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860221,
					"content": "Không sai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860223,
					"content": "Không phải chứ! Như vậy có thể giải quyết vấn đề không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860225,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "Xin hãy giúp tôi <color=#00E1FFFF>ủy thác cho đội trưởng Jean</color>, sắp xếp nhân sự, xử lý đám Hilichurl trên đường vận chuyển nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860226,
					"content": "Phù... được cứu rồi. Nếu có Jean đi xử lý, thì rất nhanh sẽ được giải quyết, cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860227,
					"content": "Jean thực sự rất được mọi người tin tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860228,
					"content": "A, phải rồi. <color=#00E1FFFF>Người pha chế rượu Charles</color> cũng nói gặp phải rắc rối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860229,
					"content": "Hay là mọi người tiện đường ghé chỗ anh ấy xem thử nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860230,
					"content": "Được thôi, giúp người giúp đến cùng cũng là tác phong của Paimon... ừm, tuy rằng cũng không phải tiện đường cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
