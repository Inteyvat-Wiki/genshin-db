					"nextDialogs": [
						4861007
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861007,
					"content": "Sắp xếp công việc cho chúng tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "Đúng vậy! Giữa chúng ta quả thật có sự đồng điệu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861009,
					"content": "Là tiết mục trao thưởng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "#Hahaha, tôi thích cách nói chuyện của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861011,
					"content": "#Nhưng trước khi nói những việc này, hy vọng {F#cô}{M#cậu} có thể giúp đội kỵ sĩ thêm một việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861012,
					"content": "Muốn chia sẻ công việc với Jean à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861013,
					"content": "Đúng vậy, tuy rằng những việc ủy thác cho Jean lúc trước đã sắp xếp người đi làm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861014,
					"content": "...Nhưng nếu không phải Jean tự làm, tôi vẫn lo sẽ bỏ sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861015,
					"content": "#Hy vọng {F#cô}{M#cậu} có thể đi xem xem có chỗ nào cần giúp không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861016,
					"content": "Nếu có Kỵ Sĩ Danh Dự của Mondstadt ra tay, tôi cũng có thể yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861017,
					"content": "#Cho dù anh khen {NICKNAME} thế nào, tôi vẫn phải hỏi: Sao anh không tự đi giúp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861018,
					"content": "Haha, tôi còn có nhiệm vụ quan trọng phải làm... có rất nhiều việc... ừm, cần \"chuẩn bị\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861019,
					"content": "Hừ, thôi được rồi. Tôi nhớ là... có <color=#00E1FFFF>tiểu thư Sara, ngài Charles còn có tiểu thư Margaret</color> cần giúp, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861020,
					"content": "Đúng vậy, nhờ vào hai vị nhé, gặp lại sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
