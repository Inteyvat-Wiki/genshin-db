					"content": "Cho nên, cho nên không phải là tình cảm cá nhân của tôi! Mà là suy nghĩ cho mọi người! Ừ, đúng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860811
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860811,
					"content": "Phản ứng của Barbara, có chút kỳ quái... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860812,
					"content": "#Phải rồi, {NICKNAME} là Kỵ Sĩ Danh Dự phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860813
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860813,
					"content": "Đội trưởng ngã bệnh rồi, về tình về lý cũng nên chia sẻ gánh nặng chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860814
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860814,
					"content": "Nói vậy cũng đúng, nhưng không phải vẫn còn kỵ sĩ Tây Phong danh chính ngôn thuận sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860815,
					"content": "Công việc của Jean nhiều như vậy, thêm một người giúp cũng là việc tốt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860816
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860816,
					"content": "Nhờ các bạn <color=#00E1FFFF>về đội kỵ sĩ</color> xem sao nhé, Jean có tôi ở đây là được, một mình tôi là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860817
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860817,
					"content": "Sao cứ có cảm giác muốn đuổi người thế nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860818,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860819
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860819,
					"content": "#Không sao, vậy thì không làm phiền nữa. Đi thôi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
