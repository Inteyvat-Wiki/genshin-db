						4861002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861002,
					"content": "Ồ, tôi đang đợi hai vị đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861003,
					"content": "Việc Jean bị bệnh tôi đã nghe nói rồi, tôi nên thay mặt đội Kỵ Sĩ cảm ơn hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861004,
					"content": "Kaeya đột nhiên nghiêm túc cảm ơn như vậy, có chút không quen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861005,
					"content": "Haha, dù gì cũng là việc liên quan đến Đội Trưởng Đại Diện chúng ta đều yêu quý mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861006,
					"content": "Phải rồi, ngoài việc cảm ơn, còn có...",
