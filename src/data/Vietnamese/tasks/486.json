			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "Coi chỗ tôi là quán nước ép trái cây sao? Các bạn nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860302,
					"content": "Hứ, thật thô lỗ, chúng tôi là đến giúp đỡ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860303,
					"content": "Giúp đỡ? Ồ phải rồi, hai vị là người được Đội Trưởng Đại Diện yêu thích phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860304,
					"content": "Hửm... cách nói thật kỳ quái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860305,
					"content": "Vậy phiền hai vị giúp tôi lấy báo cáo thuế kỳ này ở chỗ Jean nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860306,
					"content": "Cũng đến lúc phải kết toán với ngài Elzer rồi...nhắc đến thì thuế rượu ở Mondstadt thật cao quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860307,
