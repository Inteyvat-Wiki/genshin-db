			},
			"dialogs": [
				{
					"id": 111200101,
					"content": "Katheryne, chúng tôi đến rồi, có ủy thác gì mới không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200102,
					"content": "Ừm, có một công việc mới, tôi nghĩ các bạn có thể làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200103,
					"content": "Lão Dai là một trong những thợ chính tại Sảnh Huy Sơn của Cảng Liyue, ông ấy hy vọng Hiệp Hội Nhà Mạo Hiểm có thể cử vài người đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200104,
					"content": "Cụ thể là để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200105,
					"content": "Nghe nói là muốn tìm vài người công nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200106,
					"content": "Tìm người? Tuyệt vời, đây là sở trường của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200107,
					"content": "Đúng vậy, năng lực của Nhà Lữ Hành là điều không cần bàn cãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200108,
					"content": "Nội dung ủy thác cụ thể để gặp rồi bàn. Nếu các bạn đồng ý nhận việc, thì đến bến tàu tìm Lão Dai nói chuyện nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112002",
							"2"
						],
						"stepId": 1112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lão Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "Này! Xin hỏi là Lão Dai đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200202,
					"content": "Ồ, tìm tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200203,
					"content": "Ễ? Chờ chút, hai vị là nhà mạo hiểm do hiệp hội cử đến à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200204,
					"content": "Ồ, vậy cũng nhận ra sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200205,
					"content": "Nhìn cách ăn mặc và dáng vẻ của hai vị, có lẽ cũng không phải là tay mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200206,
					"content": "Đúng vậy đúng vậy, thật tinh tường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200207,
					"content": "Ha ha ha, làm nghề này phải biết nhận dạng. Xem đá cũng là xem, xem người cũng là xem. Người thế nào, Lão Dai tôi chỉ nhìn là biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200208,
					"content": "Hai vị chờ chút, trợ thủ của tôi đang trên đường đến, lát nữa sẽ tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200209,
					"content": "Khoan đã khoan đã, không phải đã tìm chúng tôi rồi sao? Không phải lại có người muốn chia tiền công chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200210,
					"content": "Haiz! Thật không giấu gì, việc lần này hơi phức tạp. Chỉ mỗi nhà mạo hiểm e là không đủ, cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200211,
					"content": "Đúng là còn có người khác, hừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200212,
					"content": "Chú à, có phải chú xem thường bọn tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200213,
					"content": "Paimon, đừng nói như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "Hai vị không biết đó thôi, chuyện lần này xảy ra ở khu mỏ, và có hơi ly kỳ. Khu mỏ thường xảy ra sự cố, để phòng hờ, tôi phải tìm chuyên gia đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200216,
					"content": "Nghề chính của nhà mạo hiểm không phải giám định khoáng thạch, phân tích địa chất đúng không? Dẫn theo một chuyên gia sẽ dễ làm việc hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200217,
					"content": "Hơn nữa người tôi tìm rất giỏi, bất kể là đá gì, anh ấy chỉ cần nhìn sơ qua là có thể phân biệt chính xác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200218,
					"content": "Theo tôi, người rành về đá nhất trên đời này chính là anh ấy! Gặp được chuyên gia như vậy, tôi còn không mau mời về sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200219,
					"content": "Không đúng không đúng, người rành về đá nhất trên đời sao có thể để chú tìm được dễ như thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200220,
					"content": "Sao lại không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200221,
					"content": "Đương nhiên là không, bởi vì người rành về đá nhất trên đời là bạn của chúng tôi mới đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200222,
					"content": "Người bạn nói chắc không phải là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "(Đúng lúc mình cũng có chuyện muốn hỏi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "Hừm, núi cao còn có núi cao hơn! Chú hãy đợi ở đây, tôi sẽ đưa người đó đến ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200214,
					"content": "Paimon, bắt đầu háo thắng rồi đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
