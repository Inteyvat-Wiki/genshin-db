				"points": []
			},
			"dialogs": [
				{
					"id": 111200301,
					"content": "Lần trước nói đến, Nham Vương Đế Quân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "Tian Miệng Sắt"
				},
				{
					"id": 111200302,
					"content": "Tìm được anh rồi, Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200303,
					"content": "Hử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200304,
					"content": "Tinh thần có vẻ không tệ, hai người cũng đến nghe kể chuyện à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200305,
					"content": "Không không, chúng tôi đến tìm anh, anh có rảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200306,
					"content": "Cũng có thể nói là rảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200307,
					"content": "Chúng tôi nhận được một ủy thác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "Công việc này cần người hiểu rõ về địa chất và khoáng thạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200310,
					"content": "Địa chất và khoáng thạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200311,
					"content": "Tìm khắp đại lục này, lẽ nào còn có người hiểu rõ hơn anh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200312,
					"content": "Người ủy thác đó tự xưng là đã tìm được chuyên gia hiểu rõ về đá nhất. Tôi muốn chứng minh cho chú ấy thấy, anh mới là người hiểu rõ những thứ đó nhất Đại Lục Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200313,
					"content": "Sự so sánh vô cớ này ở đâu ra vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200314,
					"content": "Không phải so sánh, là Lão Dai múa rìu qua mắt thợ thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200315,
					"content": "Tôi chỉ là... Muốn chú ấy hiểu biết thêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200316,
					"content": "Ha ha, thì ra là vậy, tôi sẽ đi cùng hai vị vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200317,
					"content": "Thật sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200318,
					"content": "Nói trước, tuy tôi có chút kiến thức, nhưng cũng chưa chắc là người giỏi nhất đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200319,
					"content": "Biển học vô bờ, tích lũy thêm kiến thức là điều tốt. Thứ nhất, có tôi thì hai vị cũng yên tâm hơn, thứ hai, nếu thật sự có chuyên gia, tôi cũng có thể học hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200320,
					"content": "Ừm... Tôi thấy Zhongli không cần phải khiêm tốn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200321,
					"content": "Nếu Zhongli đã đồng ý thì chúng ta đi thôi, quay lại tìm Lão Dai nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200308,
					"content": "Có một công việc đặc biệt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
			"completionStepIds": [
				1112004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112004",
							"2"
						],
						"stepId": 1112004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lão Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "Lão Dai, chúng tôi về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200402,
					"content": "Ồ! Vị này là bạn của hai người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200403,
					"content": "Đúng vậy! Tôi cho rằng đây mới là người hiểu rõ nhất về khoáng thạch và địa chất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200404,
					"content": "Quá khen. Chỉ là chút kinh nghiệm nhỏ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200405,
					"content": "Hừm, nếu nói như vậy thì người tôi tìm chắc chắn cũng không thua ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200406,
					"content": "Giới thiệu nhiều cũng vô ích, lát nữa anh ấy đến, các vị tự cảm nhận đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200407,
					"content": "Ơ... Là ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200408,
					"content": "Đến đúng lúc quá! Giới thiệu với các vị một chút, đây là trợ thủ của tôi, Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200409,
					"content": "Kun Jun, hai vị này là nhà mạo hiểm mà tôi tìm đến, ừm, còn ngài đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200410,
					"content": "Hửm...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200412,
					"content": "Là Zhongli, khách khanh của Vãng Sinh Đường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "Ngài Zhongli, khách khanh của Vãng Sinh Đường... Tôi cũng từng nghe tên, nghe nói học cao hiểu rộng, kiến thức phong phú. Không ngờ hôm nay lại được gặp ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200414,
					"content": "Hả? Trông cứ quen quen... Lẽ nào đã từng gặp nhau ở Vãng Sinh Đường? Nhưng tôi chưa từng đến Vãng Sinh Đường mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200415,
					"content": "Lão Dai, không muốn thử sao? Xem hai người họ ai mới là chuyên gia thật sự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200416,
					"content": "Thì ra là muốn thi đấu tại chỗ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "Hả? Chuyện này... Tôi, tôi cũng không biết phải so từ đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200418,
					"content": "Vậy mọi người nghĩ cách thi đi, nếu Zhongli thắng, thì nhờ anh ấy giúp, nếu Zhongli... Không, sao có thể thua được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200419,
					"content": "Thi? Được được, tôi đồng ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200420,
					"content": "Ngài đây có vẻ rất hứng thú nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200421,
					"content": "Ha ha, tôi vừa nhìn là biết anh chắc chắn là người trong nghề. Nhưng để so cao thấp với tôi thì vẫn chưa biết ai hơn ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200422,
					"content": "Người này cũng mạnh miệng quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200423,
					"content": "Có sao nói vậy thôi, ha ha ... Hơn nữa thứ tôi biết cũng chỉ có vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200424,
					"content": "Kun Jun là nhà giám định sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200425,
					"content": "Không, thật ra... Thật ra tôi cũng quên tôi đến Cảng Liyue để làm gì... Có một hôm đang đứng bên đường thì bị Lão Dai gọi đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200426,
					"content": "Lão Dai thấy tôi cầm hòn đá, hỏi han tôi vài câu rồi mời tôi đến đây gặp mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200427,
					"content": "Hả? Vậy cũng quên được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200428,
					"content": "Trên đường đến Cảng Liyue, tôi gặp người đàn ông này đang đứng nhìn chằm chằm những viên đá bên đường, anh ấy lẩm bẩm những lời như thể rất quen thuộc với những viên đá đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200429,
					"content": "Vì tò mò nên tôi hỏi vài câu, ai dè anh ấy còn biết rõ hơn thợ cả như tôi! Dù sao cũng không có việc gì, chi bằng tới giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200430,
					"content": "Người này trí nhớ không tốt lắm nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200431,
					"content": "Cũng không thể nói là trí nhớ không tốt... Nhưng mà chuyện về đá thì tôi chắc chắn giúp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200432,
					"content": "Ngài Zhongli, ngài thấy viên đá này thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200433,
					"content": "Hừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200434,
					"content": "Viên đá này vỏ ngoài trơn bóng, các vết nứt trên bề mặt là do núi lửa phun trào. Nếu tôi đoán không lầm, đây là phôi đá đến từ nước khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200435,
					"content": "Chà! Con mắt tinh tường đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200436,
					"content": "Nó không phải phôi đá bình thường. Vỏ mỏng, chỉ đen... Tôi đoán bên trong nó là pha lê chất lượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200437,
					"content": "Hoàn toàn chính xác, viên đá này đến từ vùng ngoài của núi lửa, tôi mua nó khi đang lang thang ở chợ. Người bán xem nó như phế liệu, nhưng lại không biết bí mật bên trong nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200438,
					"content": "Quặng pha lê không phải ở đâu cũng có sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "Màu sắc tinh khiết và chất lượng cao không đủ để được gọi là báu vật. Có một số pha lê hiếm hơn và cao cấp hơn, một số chứa nước bên trong, một số lại chứa cát vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200441,
					"content": "Pha lê ẩn dưới lớp vỏ đá này lúc mới hình thành bao bọc một khối nước, nước ẩn dưới đáy, tựa như trăng tròn trên núi, chuyển động hướng về bầu trời, quả là hiếm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200442,
					"content": "Quá chi tiết, gần như thể anh ấy đã được nhìn tận mắt vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200443,
					"content": "Không phải lừa chúng ta chứ? Dù sao thì tảng đá cũng chưa được mở ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200444,
					"content": "Không, cái anh ấy nói đều là thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200445,
					"content": "Đa phần pha lê được sinh ra trong môi trường nhiệt độ cao, nhiệt độ cao không tương thích với nước chảy nên pha lê mật nước rất quý. Bên trong pha lê này chứa nước hồ trên núi lại càng hiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200446,
					"content": "Ngay cả Zhongli cũng nói như vậy... Chắc có lẽ là thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200447,
					"content": "Nhãn quan của ngài Zhongli đây là lần đầu tiên tôi được thấy! Sao ngài biết được hình dạng dưới lớp vỏ đá vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200448,
					"content": "Tôi thấy nhiều rồi nên cũng có chút kinh nghiệm. Chút tài lẻ thôi, mong anh Kun Jun đây đừng bận tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200449,
					"content": "Không không, sao có thể chứ! Tôi thấy chúng ta rất hợp nhau, tôi thật lòng muốn kết bạn với anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200450,
					"content": "Lão Dai, dẫn theo ngài Zhongli đi cùng đi! Tin tôi không sai đâu, ngài ấy chắc chắn là một chuyên gia với tầm nhìn phi thường. Người như vậy, cả đời cũng không gặp được nhiều đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200451,
					"content": "Cũng được, thêm người thêm sức. Các vị, hãy cùng tôi đến Vực Đá Sâu, các anh em đang mất tích nhờ cả vào mọi người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111200439,
					"content": "Sao viên này lại là loại tốt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
		{
			"id": 1112022,
