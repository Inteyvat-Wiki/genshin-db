			"dialogs": [
				{
					"id": 740911701,
					"content": "Có người giúp đỡ những công việc bảo trì phiền phức đó thì sao phải tự mình tốn sức chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911702,
					"content": "Về bến tàu này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "Pháo Đài Meropide nhiều đường ống như vậy, cũng phải có người bảo trì chứ? Chúng tôi chính là những người làm việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911704,
					"content": "Nhưng phần lớn thời gian là sửa chữa lặt vặt thôi, nếu thực sự có vấn đề lớn thì tôi đâu có ích gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911705,
					"content": "Tốt nhất nên làm mấy việc trong khả năng của mình, ví dụ như tranh thủ nghỉ phép giúp người khác mang thư vào thành phố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911706,
					"content": "Không làm phiền nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "Dù sao tôi cũng rất rảnh, đâu có chuyện phiền hay không phiền chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				}
			]
		}
	]
