			"dialogs": [
				{
					"id": 740911001,
					"content": "Chúng tôi về rồi đây! Đúng là có chút vấn đề, nhưng đã xử lý xong hết theo cách anh chỉ, cứ yên tâm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "Thực sự cảm ơn hai vị, chút nguy cơ tiềm ẩn này nếu không loại bỏ kịp thời, đến khi gây họa lớn thì hối hận cũng không kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "...Vì thế, tôi không thể đồng tình với quan điểm của ngài Aigouy, dù tôi biết, ông ấy lo lắng cho tôi theo cách của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Dù sao cũng rất cảm ơn hai vị đã cứu mạng, còn giúp đỡ công việc nữa. Thù lao tôi đã chuẩn bị rồi, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Xin lỗi vì những phiền phức này đã làm chậm trễ hành trình của hai vị, chúc hai vị thuận buồm xuôi gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
