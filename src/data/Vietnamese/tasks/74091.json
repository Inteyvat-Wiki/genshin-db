				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "Tên nhóc đó, chắc không bị Hilichurl đem đi nấu canh đấy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910102,
					"content": "Ai bị bắt cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Bên đó, hai người nhìn xem, có thấy doanh trại Hilichurl trên mặt nước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910106,
					"content": "Cảm giác như chúng bất ngờ xuất hiện chỉ sau một đêm vậy. Đêm đến cần nghỉ thì không nghỉ, lại bán mạng làm việc, ây da, giống y cái tên Balent vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910107,
					"content": "Tôi thấy cậu ta may mắn đó, giờ vẫn chưa ở trong nồi, không chừng đang hào hứng trò chuyện với Hilichurl rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910108,
					"content": "Ơ? Ý anh là, người quen của anh đã bị Hilichurl ở đó bắt đi? Sao anh vẫn bình thản vậy, nếu là thật thì phải mau chóng đi cứu người chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910109,
					"content": "Cứu người? Cứu người gì chứ? Tôi đã nói với cậu ta rồi, công việc nguy hiểm không cần phải liều mạng, chờ khi nào Estienne kiểm tra định kỳ thì báo cáo một tiếng, để Estienne tìm người xử lý là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910110,
					"content": "Tôi tốt bụng chỉ cho cậu ta, mà cậu ta còn quay lại chỉ trích tôi làm việc không nghiêm túc, lơ là chức trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910111,
					"content": "Nếu cậu ta coi thường kinh nghiệm và kiến thức của người đi trước, thì đó là do cậu ta tự chọn thôi. Là thanh niên, thôi thì chịu khổ một chút mới trưởng thành được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910112,
					"content": "Chỉ nghe lời phiến diện thì khó mà đánh giá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Ừm, bây giờ cứu người quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910115,
					"content": "Nguy hiểm lắm! Hai người còn trẻ, lỡ bị thương thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910116,
					"content": "#Yên tâm đi, {NICKNAME} mạnh lắm! Anh cứ chờ ở đây, chúng tôi đi rồi về ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910113,
					"content": "Lỡ gặp nguy hiểm, thì mạng cũng chẳng còn chứ đừng nói trưởng thành.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "Nấu canh gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "Chuyện đó quan trọng sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
