						],
						"pointId": 5621
					}
				]
			},
			"dialogs": [
				{
					"id": 740911601,
					"content": "Ồ, không ngờ hai người trẻ tuổi đây lợi hại nhỉ. Balent thì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911602
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911602,
					"content": "Coi đó, tôi đã nói gì nhỉ? Nguy hiểm lắm, cậu không ứng phó nổi đâu. Cậu không chịu tin, giờ thì biết rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911603
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911603,
					"content": "Tôi... tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911604
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911604,
					"content": "Sao, còn muốn cãi? Để tôi nghe xem cậu có cao kiến gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911605
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911605,
					"content": "Cho tôi uống miếng nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911606
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911606,
					"content": "Balent tìm được bình nước, ực ực uống mấy ngụm, rồi cầm miếng bánh mì nhai ngấu nghiến.\\nTrong lúc đó, bất luận người trung niên có nói gì, anh ta đều như không nghe thấy, chỉ tập trung ăn.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740911607
					]
				},
				{
					"id": 740911607,
					"content": "Phù... xem như... sống rồi. Xin cảm ơn hai vị cứu giúp, không thì e rằng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911608
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911608,
					"content": "E rằng chỉ có thể để lại chút lương hưu cho cha mẹ cậu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911609
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911609,
					"content": "Hừ, vậy cũng đỡ hơn việc lơ là chức trách dẫn đến sự cố an toàn, rồi cuối cùng bị cách chức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911610
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911610,
					"content": "Tên nhóc này... Haiz, nói thế nào cũng không hiểu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911611
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911611,
					"content": "Hai vị, tuy nói ra hơi vô liêm sỉ... Nhưng tôi phải nói, đây cũng là vì sự an toàn của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911612
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911612,
					"content": "Hai vị chắc biết lặn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911613
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911613,
					"content": "Biết thì biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911614,
					"content": "Lúc tôi bị Hilichurl bắt thì đồ lặn cũng mất luôn, kiểm tra định kỳ lần trước phát hiện đồ dự phòng cũng hỏng rồi, tuy đã xin cấp lại, nhưng vẫn chưa giao đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911615
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911615,
					"content": "Nhưng việc bảo trì đường ống không thể chậm trễ được, nếu hai vị biết lặn... có thể nhờ hai vị thay tôi kiểm tra đường ống của Pháo Đài Meropide được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911616
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911616,
					"content": "Đương nhiên, thù lao tôi sẽ chuẩn bị, không bạc đãi hai vị đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911617
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911617,
					"content": "Nếu liên quan đến an toàn của mọi người thì giúp cũng được, nhưng kiểm tra đường ống là công việc khá chuyên môn, giao cho chúng tôi liệu có ổn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911618,
					"content": "Chỉ là kiểm tra định kỳ thôi, tôi đoán chắc có chút vấn đề nhỏ, lần trước tôi kiểm tra đã phát hiện bốn chỗ nguy hiểm... Nhưng xử lý cũng không khó, để tôi giải thích qua cho hai vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911619
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911619,
					"content": "Nếu phát hiện đường ống dưới nước <color=#00E1FFFF>có khí thoát ra ngoài</color>, vậy thì chắc là do sinh vật dưới nước... hoặc thứ gì đó đã va phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911620
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911620,
					"content": "Cách xử lý là <color=#00E1FFFF>điều khiển van điều tiết, tạm thời chặn khí thoát ra</color>. Các vị chỉ cần làm đến đó là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911624
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911624,
					"content": "Thao tác van điều tiết cần phải khéo léo, <color=#00E1FFFF>hãy quan sát lượng khí thoát ra khi xoay van, nếu lượng khí ít đi, vậy là đúng hướng rồi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911621
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911621,
					"content": "Ừm... Hình như hiểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911622,
					"content": "Trước khi hoàn thành kiểm tra, nếu còn bất cứ điều gì không hiểu thì có thể hỏi tôi, tôi sẽ giải đáp cho hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911623
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911623,
					"content": "Được, vậy chúng tôi cứ thử trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
