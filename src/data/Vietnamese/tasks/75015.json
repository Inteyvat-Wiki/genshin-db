			"dialogs": [
				{
					"id": 750150401,
					"content": "#Tada! Đúng là {NICKNAME} mà, con cá hung hăng đó đã bị tóm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150402,
					"content": "Kể ra thì, nếu rắc hết mồi xuống để đám cá ăn đến khi ngửa cả bụng rồi tự động nổi lên, vậy thì có được coi là một kiểu \"câu cá\" không?",
