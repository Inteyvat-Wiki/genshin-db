					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "Những lúc thế này thì lại bắt đầu giả ngơ rồi!",
