					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} cũng nghĩ là cách này được phải không? Ánh mắt đầy mong đợi đó! Hihi, lần sau chúng ta cùng thử nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150405,
					"content": "Rawrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#Này! Chưa nướng đâu, phải đợi {NICKNAME} làm xong đã rồi mới ăn được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150407,
					"content": "Nướng cá xong, mọi người cùng ăn một bữa no nê.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "Tôi cảm thấy bữa cá nướng này đặc biệt ngon đó. Đúng là con cá mà tôi câu được có khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150410,
					"content": "Đúng vậy đấy. Sau này việc câu cá giao cho Paimon nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "Hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150412,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#Đừng nghĩ đến việc ngồi mát ăn bát vàng nhé! Nếu muốn ăn cá thì lần sau {REALNAME[ID(2)|SHOWHOST(true)]} cũng phải giúp đỡ mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150414,
					"content": "Rrrawr?",
