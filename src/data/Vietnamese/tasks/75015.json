			"dialogs": [
				{
					"id": 750150501,
					"content": "Phù, cuối cùng cũng dọn xong. Vậy tôi bắt đầu câu cá nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150502,
					"content": "Hừm, tôi nhất định sẽ câu được một con cá thật lớn cho mọi người xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150503,
					"content": "Nhưng tiếc là mặt nước tĩnh lặng quá, chẳng có một gợn sóng nào.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150504
					]
				},
				{
					"id": 750150504,
					"content": "Hmm... Có phải là do chất lượng nước ở đây tuyệt quá nên cá không muốn rời khỏi đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150505,
						750150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150505,
					"content": "Sắp chiến thắng rồi, hihi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "Đúng là như vậy... Mà không đúng! Đây mới chỉ là khởi đầu thôi, vẫn còn xa lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150507,
					"content": "Đừng có khích lệ bừa bãi vào lúc này chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150511,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "Sắp thành công rồi, sắp thành công rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "Đừng có nói chuyện vào lúc này chứ... Đúng thật là!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150514,
					"content": "Ối?! Cần câu rung rồi, để tôi xem có gì hay ho nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150515,
					"content": "#Cái gì đây... Không phải là cá, chỉ là một cái chai thôi! Lại còn buộc dây vào tấm ván gỗ ở điểm câu cá nữa... Nhắc mới nhớ, {NICKNAME} cũng thường câu được những thứ kỳ lạ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150516,
					"content": "Cái gì cũng câu được, ngoại trừ cá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "#{NICKNAME} chẳng phải cũng thường câu được những thứ kỳ lạ sao! Dù sao cũng câu lên rồi, để tôi xem bên trong có gì nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150518,
					"content": "Người đam mê câu cá thật đáng sợ, lẽ nào đống lộn xộn vừa rồi là do hai người đó để lại à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150519,
					"content": "Chúng ta vứt cái chai này về lại chỗ cũ đi, xem ra đây chính là công cụ để họ liên lạc với nhau đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150520,
					"content": "Ừm, tôi có linh cảm rằng lần tới chắc chắn sẽ câu được cá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150521,
					"content": "Cần câu bất ngờ trĩu xuống và rung lắc dữ dội.\\nDưới nước có một con cá to đang cắn câu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "Cuối cùng cũng cắn câu rồi! Lần này chắc chắn là cá lớn... Lên đây cho ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150523,
					"content": "Lên đây cho ta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "R—Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#Paimon có vẻ rất chật vật.\\nBạn và {REALNAME[ID(2)|SHOWHOST(true)]} cùng ôm lấy Paimon...\\nTuy nhiên, có một lực kéo rất lớn từ phía dưới!",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "Một tiếng động vang lên, con cá đã thoát khỏi lưỡi câu...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "Huhu! Đây chắc chắn là một con cá lớn lắm nên mới chạy thoát được đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150528,
					"content": "Tức quá... Ối, nó lại còn bơi đi bơi lại trên mặt nước kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150529,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "Không được, dưới đó nguy hiểm lắm, nhóc cũng không bơi nhanh như cá được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150531
					],
