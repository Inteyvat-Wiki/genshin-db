			},
			"dialogs": [
				{
					"id": 752400101,
					"content": "Chào mừng mọi người đến với cuộc thi Cúp Anh Hùng Ayar, tôi là người dẫn chương trình của cuộc thi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400102,
					"content": "Hôm nay đã là ngày cuối cùng của cuộc thi, nếu muốn đoạt giải quán quân thì phải liên tục đánh bại ba dũng sĩ xếp hạng cao nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400107,
					"content": "Cúp Anh Hùng Ayar là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "Là trận đấu tranh giành vinh quang Ayar. Hãy dùng nắm đấm, vũ khí hoặc bất cứ cách gì để đánh bại đối thủ nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400109,
					"content": "Ayar là ai vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "Bạn thân mến, ở đây chỉ có quán quân mới có tư cách đặt câu hỏi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400111,
					"content": "#Bước lên sàn đấu nào, để tôi xem {F#cô}{M#cậu} có thực lực để được tôn kính không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahuatlalli"
				}
			]
		},
