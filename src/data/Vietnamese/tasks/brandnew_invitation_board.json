			"dialogs": [
				{
					"id": 706750101,
					"content": "Được rồi, \"Tiểu Hoàng Tử\" đã thực hiện một số thay đổi với bảng mời. Bây giờ, người nhận được thư mời đều có thể đến ngay căn phòng đặc biệt để đấu với bạn một cách dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750102
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750102,
					"content": "Không cần phải lặn lội từ xa đến nữa, cũng tránh được việc một số người không thể ở lại Quán Rượu Đuôi Mèo vì thân phận cá nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750103
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750103,
					"content": "Cái gì, bạn dám chất vấn \"Tiểu Hoàng Tử\" là một con mèo thì có thể làm được chuyện này không ư. Hừm, xem ra bạn hiểu biết quá ít về \"Tiểu Hoàng Tử\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750104
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750104,
					"content": "Không, có vẻ như bạn vẫn chưa biết những gì mèo có thể làm. Tóm lại, nếu có thể, hãy sử dụng bảng mời kiểu mới và vào căn phòng đặc biệt để thi đấu nhé!",
					"roleType": "TALK_ROLE_NPC",
