			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000902,
					"content": "Lâu rồi không gặp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000903,
					"content": "Là Mona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000901,
					"content": "#Có thể dễ dàng nhìn thấu bí mật này, lẽ nào lại không thể gợi lại ký ức của {F#cô}{M#cậu} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000902,
						105000903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000904,
					"content": "A, tôi nhớ rồi! Là nhà chiêm tinh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000905,
					"content": "Đúng vậy, chính là tôi, Astrologist Mona Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000906,
					"content": "Lần này đến đây là muốn hai người cùng tôi đến Mondstadt để lấy lại một chiếc rương của sư phụ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Đó là lời hứa của bà ấy với một người bạn từ 50 năm trước. Nhưng bây giờ bà ấy lớn tuổi rồi, đi lại không tiện, nên đành phải nhờ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Lấy rương... chuyện này có vẻ không liên quan đến chúng tôi? Tại sao lại kéo chúng tôi đi cùng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Chuyện này à... Bởi vì tôi muốn đọ sức với người bảo quản chiếc rương đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000911,
					"content": "Muốn chứng minh thực lực của bản thân sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000912
					]
				},
				{
					"id": 105000913,
					"content": "Tóm lại là thích sĩ diện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000914
					]
				},
				{
					"id": 105000112,
					"content": "Sư phụ và bạn của bà ấy đã đấu với nhau cả đời về huyền bí học, nhưng vẫn bất phân thắng bại. Nếu tôi thắng, vậy chẳng phải tôi giỏi hơn sư phụ sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000114,
					"content": "E hèm, nói đúng hơn là tôi muốn chứng minh thực lực và vị trí của \"thuật chiêm tinh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000116,
					"content": "Nói gì chứ! Chủ yếu là muốn mượn cơ hội, chứng minh thực lực và vị trí của \"thuật chiêm tinh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Nhưng mà, sau khi tôi chiêm tinh thì thấy bạn của sư phụ đã rời khỏi Mondstadt, người bảo quản chiếc rương là người thừa kế của bà ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Cũng giống như tôi, người kế thừa đó chắc chắn cũng là nhân tài, trò giỏi hơn thầy, không thể xem thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000918,
					"content": "Tôi... không biết chiêm tinh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000919
					]
				},
				{
					"id": 105000920,
					"content": "Sao đột nhiên lại chạy đến chỗ tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000921
					]
				},
				{
					"id": 105000119,
					"content": "#Trận này tôi nhất định phải thắng, sau khi suy nghĩ, tôi đã nghĩ đến {F#cô}{M#cậu}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000121,
					"content": "#Sao chủ đề lại đột ngột chuyển qua {NICKNAME} vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "Kiến thức kế thừa được từ sư phụ phải tiếp tục được lưu truyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "Ví dụ khi tôi đi gặp cô ấy và dẫn theo đệ tử, thì chẳng phải tôi đã chiếm ưu thế hơn cô ấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000924,
					"content": "Tôi từ chối.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000925,
					"content": "Tự nhiên sao tôi lại trở thành đệ tử của cô rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000125,
					"content": "#Mà {F#cô}{M#cậu} lại là anh hùng của Mondstadt, thân phận cũng xứng với tôi. Cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000128,
					"content": "#Ây da, không cần {F#cô}{M#cậu} phải làm đệ tử của tôi thật, chỉ cần {F#cô}{M#cậu} diễn một chút là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "#Hơn nữa, cùng tôi đi lấy rương cũng có lợi cho {F#cô}{M#cậu} mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "#Tôi gặp được người kế thừa đó, sẽ có cơ hội giao lưu học hỏi thêm kiến thức, và tôi sẽ thấy được rõ hơn vận mệnh của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "#Đến lúc đó, những chuyện xa hơn, mơ hồ hơn, ví dụ như thần linh, huyết thống... tôi đều có thể cho {F#cô}{M#cậu} đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000133,
					"content": "Điều kiện có vẻ hấp dẫn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000134,
					"content": "Vậy thì... cùng đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000132,
					"content": "Vậy, vậy thì so với việc chúng ta tìm kiếm ở từng nước đúng là nhanh hơn nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000135,
					"content": "Hì hì, sự lựa chọn sáng suốt, vậy chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Nhưng trước khi đi, tôi muốn đến một nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		}
	]
