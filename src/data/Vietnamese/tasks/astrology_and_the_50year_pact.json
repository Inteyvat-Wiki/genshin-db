				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000701,
					"content": "Tìm thấy rồi! Chính là chiếc nhẫn này nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000702,
					"content": "Đẹp như vậy, chắc chắn là rất đắt tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000703,
					"content": "À, tôi không hề có bất kỳ ý nghĩ gì không chính đáng! Chúng ta mau đem nó trả lại cho <color=#00E1FFFF>ông chủ Zhu</color> thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1050008,
			"completionStepIds": [
				1050003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050003",
							"2"
						],
						"stepId": 1050003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ông chủ Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(Mở khách sạn ở đây, việc kinh doanh đương nhiên sẽ không tốt...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, cô đến đúng lúc lắm! Trên đường đến đây, cô có nhìn thấy một chiếc nhẫn bằng ngọc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000203,
					"content": "Nhẫn ngọc? Hình như là không có ấn tượng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Phiền phức thật... Chiếc nhẫn yêu quý của tôi bị Slime cuỗm mất rồi, nhẫn đó là của mẹ tôi để lại cho tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000205,
					"content": "Hả? Chuyện này có Mona ở đây thì không cần phải lo nữa. Thuật chiêm tinh của cô ấy giỏi như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Không được, thuật chiêm tinh là kiến thức nghiêm túc được dùng để tìm hiểu thực tế và xem số mệnh, không phải để làm chuyện lặt vặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "Nhưng không phải trước đây cô từng nói, ông chủ rất tốt với cô sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "Đây là tôn nghiêm, cũng là vấn đề về tâm linh, nếu nhà chiêm tinh cho rằng thuật chiêm tinh có thể giải quyết tất cả, thì sẽ bị các vì sao từ bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Bói toán sẽ mất đi năng lực hướng dẫn, sẽ không còn thấy rõ sự việc phía sau màn sương mù, cho nên nguyên tắc là nguyên tắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Có khả năng lợi hại như vậy mà không biết dùng để kiếm tiền, thật đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "Ôi, vốn dĩ nếu mấy người đồng ý, tôi có thể trả thù lao hai mươi ngàn Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000213,
					"content": "Cô sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000214,
					"content": "Biểu cảm của cô hơi kỳ lạ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000212,
					"content": "Hai mươi ngàn...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Cô vừa mới nói tôn nghiêm của nhà chiêm tinh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000217,
					"content": "Cô vừa mới nói nguyên tắc là nguyên tắc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000215,
					"content": "Đâu, đâu có? Chỉ là, cảm thấy... người nhặt được chiếc nhẫn thật may mắn, có thể kiếm được hai mươi ngàn Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000218,
					"content": "Hơ hơ, đúng là như vậy, nhưng mà... ông chủ làm ăn vất vả mà lại đồng ý bỏ ra số tiền lớn để tìm nhẫn, thì chắc chắn chiếc nhẫn đó có ý nghĩa rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Cứ đi như vậy cũng không hay cho lắm, chúng ta cố gắng tìm đi. Dù không dùng thuật chiêm tinh, thì có lẽ vẫn còn cách khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Cô ấy và tôi có suy nghĩ giống nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000222,
					"content": "Thật hết cách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000223,
					"content": "Lại trở thành việc của tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, việc này giao cho {F#cô}{M#cậu} đấy! Đây là nhiệm vụ đầu tiên sư phụ giao cho {F#cô}{M#cậu}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000224,
					"content": "Ừm... Nếu đã bị Slime lấy đi, thì có thể dùng Mồi Nguyên Tố để thu hút toàn bộ Slime quanh đây đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000825,
					"content": "Bạn biết không? Khi Tửu Trang Dawn ủ rượu, vô tình luyện ra một thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000826,
					"content": "Tuy công thức được bảo mật, nhưng lại rất có sức hút với Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000227,
					"content": "Không hổ là bạn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000229,
					"content": "Chắc không phải là để lúc thèm ăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000226,
					"content": "Thật ra... Hihi, tôi có mang theo một ít!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000228,
					"content": "Tôi là một cộng sự rất đáng tin cậy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000230,
					"content": "Ôi, đừng để ý những chuyện nhỏ này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "Xem ra hai người nghĩ ra cách rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "Ừm, chúng tôi quay lại ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
