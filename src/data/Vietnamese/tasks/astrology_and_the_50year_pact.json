				{
					"id": 105000304,
					"content": "Đúng vậy, đúng vậy, nếu để mất chiếc nhẫn thứ 253 mà mẹ tôi tặng, tôi không biết về nhà phải ăn nói thế nào nữa.",
					"roleType": "TALK_ROLE_NPC",
