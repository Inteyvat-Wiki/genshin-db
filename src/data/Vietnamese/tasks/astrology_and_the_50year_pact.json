			},
			"dialogs": [
				{
					"id": 105000101,
					"content": "Sao... sao cô lại biết chuyện này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000102,
					"content": "Bởi vì thứ tôi có trong tay là \"thuật chiêm tinh\" thực sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000103,
					"content": "Nếu không có thắc mắc gì thì chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000104,
						105000105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000104,
					"content": "Tôi có rất nhiều thắc mắc!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				},
				{
					"id": 105000106,
					"content": "Ôi, thật phiền phức, vậy tôi giải thích một chút vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000107,
					"content": "Tên tôi là Astrologist Mona Megistus, nhưng vì sợ mọi người không nhớ được tên tôi, nên tôi cho phép mọi người gọi tôi là Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000108,
					"content": "Tôi là nhà chiêm tinh, tôi thay sư phụ của mình đến Mondstadt để lấy một chiếc rương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Đó là lời hứa của bà ấy với một người bạn từ 50 năm trước. Nhưng bây giờ bà ấy lớn tuổi rồi, đi lại không tiện, nên đành phải nhờ tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Lấy rương... chuyện này có vẻ không liên quan đến chúng tôi? Tại sao lại kéo chúng tôi đi cùng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Chuyện này à... Bởi vì tôi muốn đọ sức với người bảo quản chiếc rương đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000112,
					"content": "Sư phụ và bạn của bà ấy đã đấu với nhau cả đời về huyền bí học, nhưng vẫn bất phân thắng bại. Nếu tôi thắng, vậy chẳng phải tôi giỏi hơn sư phụ sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000113,
					"content": "Muốn chứng minh thực lực của bản thân sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000114
					]
				},
				{
					"id": 105000114,
					"content": "E hèm, nói đúng hơn là tôi muốn chứng minh thực lực và vị trí của \"thuật chiêm tinh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Nhưng mà, sau khi tôi chiêm tinh thì thấy bạn của sư phụ đã rời khỏi Mondstadt, người bảo quản chiếc rương là người thừa kế của bà ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Cũng giống như tôi, người kế thừa đó chắc chắn cũng là nhân tài, trò giỏi hơn thầy, không thể xem thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000119,
					"content": "#Trận này tôi nhất định phải thắng, sau khi suy nghĩ, tôi đã nghĩ đến {F#cô}{M#cậu}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000120,
					"content": "Tôi... không biết chiêm tinh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000121
					]
				},
				{
					"id": 105000121,
					"content": "#Sao chủ đề lại đột ngột chuyển qua {NICKNAME} vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "Kiến thức kế thừa được từ sư phụ phải tiếp tục được lưu truyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "Ví dụ khi tôi đi gặp cô ấy và dẫn theo đệ tử, thì chẳng phải tôi đã chiếm ưu thế hơn cô ấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000125,
					"content": "#Mà {F#cô}{M#cậu} lại là anh hùng của Mondstadt, thân phận cũng xứng với tôi. Cho nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000126,
					"content": "Tôi từ chối.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000128,
					"content": "#Ây da, không cần {F#cô}{M#cậu} phải làm đệ tử của tôi thật, chỉ cần {F#cô}{M#cậu} diễn một chút là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "#Hơn nữa, cùng tôi đi lấy rương cũng có lợi cho {F#cô}{M#cậu} mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "#Tôi gặp được người kế thừa đó, sẽ có cơ hội giao lưu học hỏi thêm kiến thức, và tôi sẽ thấy được rõ hơn vận mệnh của {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "#Đến lúc đó, những chuyện xa hơn, mơ hồ hơn, ví dụ như thần linh, huyết thống... tôi đều có thể cho {F#cô}{M#cậu} đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000132,
					"content": "Vậy, vậy thì so với việc chúng ta tìm kiếm ở từng nước đúng là nhanh hơn nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000133,
					"content": "Điều kiện có vẻ hấp dẫn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000135,
					"content": "Hì hì, sự lựa chọn sáng suốt, vậy chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Nhưng trước khi đi, tôi muốn đến một nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000134,
					"content": "Vậy thì... cùng đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000127,
					"content": "Tự nhiên sao tôi lại trở thành đệ tử của cô rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000122,
					"content": "Sao đột nhiên lại chạy đến chỗ tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000123
					]
				},
				{
					"id": 105000115,
					"content": "Tóm lại là thích sĩ diện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000116
					]
				},
				{
					"id": 105000116,
					"content": "Nói gì chứ! Chủ yếu là muốn mượn cơ hội, chứng minh thực lực và vị trí của \"thuật chiêm tinh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000105,
					"content": "Trước tiên, cho hỏi cô là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				}
			]
		},
		{
			"id": 1050002,
			"completionStepIds": [
				1050003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050003",
							"2"
						],
						"stepId": 1050003,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46622",
							"3"
						],
						"stepId": 46622,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ông chủ Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(Mở khách sạn ở đây, việc kinh doanh đương nhiên sẽ không tốt...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, cô đến đúng lúc lắm! Trên đường đến đây, cô có nhìn thấy một chiếc nhẫn bằng ngọc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000203,
					"content": "Nhẫn ngọc? Hình như là không có ấn tượng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Phiền phức thật... Chiếc nhẫn yêu quý của tôi bị Slime cuỗm mất rồi, nhẫn đó là của mẹ tôi để lại cho tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000205,
					"content": "Hả? Chuyện này có Mona ở đây thì không cần phải lo nữa. Thuật chiêm tinh của cô ấy giỏi như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Không được, thuật chiêm tinh là kiến thức nghiêm túc được dùng để tìm hiểu thực tế và xem số mệnh, không phải để làm chuyện lặt vặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "Nhưng không phải trước đây cô từng nói, ông chủ rất tốt với cô sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "Đây là tôn nghiêm, cũng là vấn đề về tâm linh, nếu nhà chiêm tinh cho rằng thuật chiêm tinh có thể giải quyết tất cả, thì sẽ bị các vì sao từ bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Bói toán sẽ mất đi năng lực hướng dẫn, sẽ không còn thấy rõ sự việc phía sau màn sương mù, cho nên nguyên tắc là nguyên tắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Có khả năng lợi hại như vậy mà không biết dùng để kiếm tiền, thật đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "Ôi, vốn dĩ nếu mấy người đồng ý, tôi có thể trả thù lao hai mươi ngàn Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000212,
					"content": "Hai mươi ngàn...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000213,
					"content": "Cô sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "Đâu, đâu có? Chỉ là, cảm thấy... người nhặt được chiếc nhẫn thật may mắn, có thể kiếm được hai mươi ngàn Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Cô vừa mới nói tôn nghiêm của nhà chiêm tinh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "Hơ hơ, đúng là như vậy, nhưng mà... ông chủ làm ăn vất vả mà lại đồng ý bỏ ra số tiền lớn để tìm nhẫn, thì chắc chắn chiếc nhẫn đó có ý nghĩa rất lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Cứ đi như vậy cũng không hay cho lắm, chúng ta cố gắng tìm đi. Dù không dùng thuật chiêm tinh, thì có lẽ vẫn còn cách khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Cô ấy và tôi có suy nghĩ giống nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, việc này giao cho {F#cô}{M#cậu} đấy! Đây là nhiệm vụ đầu tiên sư phụ giao cho {F#cô}{M#cậu}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000222,
					"content": "Thật hết cách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000224,
					"content": "Ừm... Nếu đã bị Slime lấy đi, thì có thể dùng Mồi Nguyên Tố để thu hút toàn bộ Slime quanh đây đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000225,
					"content": "Còn nhớ không? Chính là Mồi Nguyên Tố đã từng làm cho ngài Diluc ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000226,
					"content": "Thật ra... Hihi, tôi có mang theo một ít!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000227,
					"content": "Không hổ là bạn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000228,
					"content": "Tôi là một cộng sự rất đáng tin cậy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "Xem ra hai người nghĩ ra cách rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "Ừm, chúng tôi quay lại ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000229,
					"content": "Chắc không phải là để lúc thèm ăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000230,
					"content": "Ôi, đừng để ý những chuyện nhỏ này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000223,
					"content": "Lại trở thành việc của tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000217,
					"content": "Cô vừa mới nói nguyên tắc là nguyên tắc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000214,
					"content": "Biểu cảm của cô hơi kỳ lạ",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				}
			]
		},
