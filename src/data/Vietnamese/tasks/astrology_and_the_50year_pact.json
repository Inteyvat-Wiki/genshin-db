					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000308
					]
				},
				{
					"id": 105000308,
					"content": "Ồ, có lẽ là có chút hiểu lầm. Nhà tôi có 3 mỏ quặng bảo thạch, mẹ tôi vì muốn tìm cho tôi một người vợ tốt, nên đã chuẩn bị rất nhiều trang sức làm bảo vật gia truyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000309
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000309,
					"content": "Cộng lại có khoảng hơn 500 cái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000310
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000310,
					"content": "Vậy tại sao ông lại phải mở khách sạn ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000311,
					"content": "Kế thừa sản nghiệp quá sớm, khó tránh khỏi cảm thấy đơn điệu và nhàm chán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000312
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000312,
					"content": "Tóm lại rất cảm ơn mọi người, Mora đã hứa cho mọi người đây, hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000313
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000313,
					"content": "Vậy thì tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000314,
					"content": "Vậy thì tôi không khách sáo nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000315,
						105000316
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000315,
					"content": "Ra tay nhanh thật!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000317
					]
				},
				{
					"id": 105000317,
					"content": "Rõ ràng công lao và khổ lao đều là của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000318,
					"content": "Đệ tử phải ra dáng đệ tử, sao có thể tranh công với sư phụ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000319,
						105000321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000319,
					"content": "Nói cũng đúng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000320
					]
				},
				{
					"id": 105000320,
					"content": "#{NICKNAME}, không phải nói sư đồ chỉ là diễn kịch thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000323,
					"content": "Bây giờ bắt đầu tập luyện đi, nếu không đến Mondstadt lại bị lộ. Người kế thừa chắc cũng giống tôi, cũng là người rất thông minh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000324
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000324,
					"content": "Ọc ọc ọc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000325
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000325,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000326
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000326,
					"content": "Hình như có tiếng gì đó đang réo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000327,
					"content": "Ồ, đúng rồi, chắc một hai ngày rồi cô chưa ăn cơm đúng không? Bởi vì không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000328
					],
					"speakerTitle": "Ông chủ Zhu"
				},
				{
					"id": 105000328,
					"content": "Aaaaa! Suỵt! Suỵt! Không có chuyện đó đâu! Đừng quan tâm đến chuyện đó nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000329,
					"content": "Ừm! Đột nhiên tôi cảm thấy chuyện này đệ tử cũng có công, nên sẽ dùng số tiền này mời đệ tử ăn một bữa ngon có được không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000330
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000330,
					"content": "Đi về hướng bắc có <color=#00E1FFFF>Nhà Trọ Vọng Thư</color>, nghe nói đồ ăn ở đó rất ngon, chúng ta đến đó thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000331
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000331,
					"content": "Không cần cảm ơn tôi, đây là chuyện mà một người sư phụ đáng tin cậy nên làm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000332
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000332,
					"content": "Cô ấy nói muốn mời chúng ta ăn cơm?! Tôi không nghe nhầm chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000333,
						105000335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000333,
					"content": "\"Mau đuổi theo đi\", tôi nói thay bạn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000334
					]
				},
				{
					"id": 105000334,
					"content": "Mau đuổi theo đi! Có đồ ăn ngon rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000335,
					"content": "\"Cô ấy đúng là người tốt\", tôi nói thay bạn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000336
					]
				},
				{
					"id": 105000336,
					"content": "Cô ấy đúng là người tốt! Hihi, đi ăn ngon thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000321,
					"content": "Đâu có nói là làm đệ tử thật của cô đâu?",
