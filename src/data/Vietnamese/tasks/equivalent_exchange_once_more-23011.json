						230110608,
						230110610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110608,
					"content": "Vẫn khỏe lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "Vậy được, khụ... bạn đừng nhìn tôi như vậy, tôi chỉ quan tâm chút thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110614,
					"content": "Thôi không nói những chuyện này nữa. Bạn đếm lại thù lao đi Nhà Lữ Hành, tôi không đưa thiếu đồng nào đâu.",
