						230110303
					]
				},
				{
					"id": 230110303,
					"content": "Cháu đang nói đến tên Fatui đặt gỗ ở chỗ ta à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110304,
					"content": "Haiz, đừng nói nữa, ta đã bảo làm ăn với Fatui không may mắn gì mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110305,
					"content": "Chỗ gỗ kia mới chuyển được nửa đường thì bị một đám ma vật tập kích. Người thì chạy về hết rồi, nhưng gỗ lại ném ở giữa đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110306,
					"content": "Ôi, với tình hình bây giờ, ta không dám qua đó đâu, trong thời gian ngắn cũng không tìm được người đi đuổi đám ma vật đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110308,
					"content": "Cháu không phải Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "Cháu không phải Fatui sao? Vậy sao cháu lại làm việc giúp cậu ta? Kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110310,
					"content": "Bất luận thế nào, tạm thời ta không thể kéo chiếc xe đó về được, ta chỉ có thể đợi đến khi thuê được người rồi mới tính tiếp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110311,
					"content": "Nếu cần gỗ gấp thì ta đã đánh dấu vị trí đại khái của chiếc xe đó trên bản đồ rồi, cháu tự qua đó xem đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "Hamawi"
				},
				{
