			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Uầy... Chỗ này nên khắc thế nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110102,
					"content": "Haiz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Haiz, ai thế, đừng làm phiền tôi, tôi đang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110105,
					"content": "Ah?! Nhà Lữ Hành?! Sao cả bạn cũng đến Sumeru rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110106,
					"content": "Không phải là tên Rudolf kia sai bạn đến đánh tôi đấy chứ, tôi chỉ tặng chút quà cho Lily cách đây đã rất lâu rồi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110107,
					"content": "Tôi chỉ du lịch ngang qua đây thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "Bạn vẫn đang trong chuyến lữ hành à, đúng là tràn đầy năng lượng nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110112,
					"content": "Nhưng thật không ngờ rằng có thể gặp được bạn ở Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110113,
					"content": "Từ khi tôi bị điều chuyển khỏi Mondstadt, tôi đã được lệnh quay thẳng về Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110114,
					"content": "Nhưng giữa đường lại có một lệnh mới, bảo tôi đến Thành Sumeru để hỗ trợ công việc của ngài Vsevolod, còn báo cho tôi biết rằng, tôi đã bị điều đến dưới trướng của đại nhân \"Pulcinella\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110115,
					"content": "\"Pulcinella\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Đúng... Á, không được, tôi không thể tiếp tục nói nữa, nếu không ngài Vsevolod sẽ lại nói rằng tôi không nhạy bén với việc giữ bí mật mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110118,
					"content": "Haiz, tên của những Quan Chấp Hành này vốn chẳng phải bí mật gì, thật sự không biết tại sao anh ấy lại nhạy cảm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110119,
					"content": "Anh làm gì ở Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Ồ, tôi và ngài Vsevolod chịu trách nhiệm chính trong việc điều phối tiếp viện hậu cần. Nói một cách đơn giản là đi mua sắm khắp nơi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110121,
					"content": "Tuy nghe có vẻ không phải việc gì rất quan trọng, nhưng vẫn tốt hơn là cứ ngẩn người ở giáo đường Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110122,
					"content": "Haha, hơn nữa khi làm công việc này, lúc làm việc có rất nhiều thời gian rảnh rỗi, mà cũng không ai nhìn chằm chằm vào tôi suốt ngày cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110123,
					"content": "Tôi bèn quay lại với những bức tượng gỗ mình làm thuở nhỏ, dù sao gỗ ở Sumeru cũng rất nhiều, được dịp luyện tay nghề luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110124,
					"content": "Không ngờ mấy món đồ nhỏ mà tôi chạm khắc lại được đám trẻ yêu thích khá nhiều. Đám trẻ này suốt ngày đòi, nên tôi đã hứa với chúng, là sẽ khắc cho mỗi đứa một món đồ chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110125,
					"content": "Anh là Fatui đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "Đúng vậy, sao thế? Haiz... Ai quy định Fatui không được tặng đồ chơi cho trẻ em chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110127,
					"content": "Hơn nữa, bây giờ tôi chỉ lo việc hậu cần, những chuyện long trời lở đất đó cứ để các đại nhân ở trên lo liệu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110130,
					"content": "Tóm lại, tình hình hiện tại của tôi là như vậy, tuy vẫn chưa thể trở về Snezhnaya, nhưng tôi vẫn khá thích Sumeru, có đồ ăn và niềm vui, môi trường cũng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110131,
					"content": "Sau khi xong việc, tôi sẽ đi mua chút đồ ăn, sau đó tìm một chỗ nắng đẹp để khắc gỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110132,
					"content": "Tuy rằng... Haha, mọi người đều nhìn tôi với vẻ ngờ vực, giống y như lần đầu tiên bạn nói chuyện với tôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110133,
					"content": "Nhưng cũng đành chịu thôi, ai bảo tôi là Fatui chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110134,
					"content": "Bây giờ tôi cũng không thể tin anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Được rồi... Nói chung, tôi khá hài lòng với cuộc sống hiện tại, hơn nữa trong tay còn có một số tiền tiết kiệm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110137,
					"content": "Qua vài năm nữa, có lẽ tôi sẽ định cư ở Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110138,
					"content": "Khụ, không nói nữa không nói nữa. Nhà Lữ Hành, nếu bạn đã đến Sumeru, nếu có hứng thú thì hai chúng ta hãy tiếp tục \"trao đổi bình đẳng\" đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110139,
					"content": "Nhưng lần này tôi không có chuyện để kể cho bạn nghe, chỉ có thể cho bạn thù lao bằng tiền thật thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110140,
					"content": "Thế thì còn tốt hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Được rồi, hãy để tôi nói rõ về nội dung ủy thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110144,
					"content": "Mấy hôm trước tôi có đặt một lô gỗ từ Hamawi, nhưng đến giờ anh ấy vẫn chưa giao hàng cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110145,
					"content": "Bây giờ tôi vẫn đang trong thời gian làm việc, không dám trực tiếp đi gặp anh ấy, nếu không ngài Vsevolod sẽ lại giáo huấn tôi một trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110146,
					"content": "Nhà Lữ Hành, bạn hãy tìm Hamawi hỏi giúp tôi, khi nào thì lô gỗ tôi cần sẽ đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110147,
					"content": "Hãy chuẩn bị sẵn thù lao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Bạn cứ yên tâm đi, chắc chắn đã chuẩn bị xong cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110151,
					"content": "Tóm lại chuyện này giao cho bạn đấy nhé, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110149,
					"content": "Anh thật sự không có âm mưu gì đấy chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Mấy lần trao đổi trước đó với bạn có lần nào tôi toan tính gì đâu, bạn cứ yên tâm đi, tôi lười làm những việc phiền phức như vậy lắm, sống thoải mái yên bình không phải tốt hơn sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110141,
					"content": "Đây là ủy thác của \"Fatui\" à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Dĩ nhiên không phải, đây chỉ là ủy thác của \"Viktor\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110135,
					"content": "Ai mà tin anh chứ, đừng có làm thân!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "Anh sẽ không cố moi thông tin từ miệng mấy đứa trẻ đó chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Này! Tôi sẽ không làm chuyện như vậy, rốt cuộc bạn đã có định kiến đáng sợ về Fatui đến mức nào thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110116,
					"content": "Là một Quan Chấp Hành khác à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "Đúng vậy, cùng tôi về Mondstadt đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Hahaha, được thôi. Vậy bạn có cần còng tay tôi về không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110111,
					"content": "Được rồi, không đùa với bạn nữa, tôi còn việc chính phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
