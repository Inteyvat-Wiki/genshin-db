					"nextDialogs": [
						751480606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480606,
					"content": "Xem ra phải tìm cách xuống dưới đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480607,
					"content": "Hmm, kể ra thì đó là gì vậy? Trông có vẻ như là một bức tượng kỳ lạ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
