				]
			},
			"dialogs": [
				{
					"id": 751480201,
					"content": "Ấy, ban nãy đó là, Q-Qucusaur? Đúng thật là Qucusaur đã lấy trộm bức tượng rồi mang đến đây này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Khoan đã, có phải nó đã mang theo bức tượng rồi bay thẳng xuống miệng núi lửa không!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480203,
					"content": "Bên đó chính là miệng núi lửa sao...? Hoành tráng thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480204,
					"content": "Hừm, trước đó khi hỏi đường, không phải nói là miệng núi lửa tập trung lượng lớn Phlogiston Thể Khí sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480205,
					"content": "Đúng rồi! <color=#00E1FFFF>Cách để đi qua Phlogiston Thể Khí</color>, cũng giống như... con Qucusaur lúc nãy vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480206,
					"content": "Nhưng mà... Ối, cao quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480207,
					"content": "Không sao, tôi sẽ ôm lấy Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "Hả, nhóc cũng muốn nhảy xuống à? Hmm... Được, được rồi, nếu vậy thì hình như cũng không còn đáng sợ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480214,
					"content": "Hơn nữa, nơi này không chỉ cao thôi đâu, đừng quên mớ Phlogiston Thể Khí đó đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480215,
					"content": "Chậc, khi nào chuẩn bị xong thì chúng ta xuất phát nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480210,
					"content": "Chỉ cần lúc gần tiếp đất nắm chặt lấy Paimon là được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "Tôi không giữ nổi đâu! Với lại khoảnh khắc gần tiếp đất đó cũng khó canh lắm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480212,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "Nhóc cũng vậy, không được hùa theo. Haiz... Bị hai người tung hứng như vậy tôi cũng không còn thấy căng thẳng nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				}
			]
		},
