			},
			"dialogs": [
				{
					"id": 751480101,
					"content": "Hỡi người được rồng chọn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480102,
					"content": "Hãy bước lên đỉnh cao nhất và nhảy vào ngọn lửa của Núi Thánh đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480103,
					"content": "Hãy đi hé lộ, vạch trần ấn vàng, hóa giải ánh sáng của vô số ngọn lửa còn sót lại nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480104,
					"content": "Rrrawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "Sao vậy, không lẽ lại nhìn thấy gì đó kỳ lạ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480106,
					"content": "Cảm giác... rõ ràng hơn rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "Ồ, là vì đã đến gần núi lửa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480109,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "...Xem ra người luôn nói chuyện với chúng ta đang ở ngay trong ngọn núi lửa này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480111,
					"content": "Đến gần núi lửa mà lại thấy những thứ đó như vậy, cũng có nghĩa là chúng ta đã đi đúng hướng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480112,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "Cảm giác... đã gần hơn rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
