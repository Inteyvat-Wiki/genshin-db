			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 210202001,
					"content": "\"...Làm gì có ngọn lửa nào có thể hiện thực hóa điều ước cơ chứ, toàn là lời nói dối! Nhưng mà những báu vật được chôn phía dưới ngọn lửa lại là thật... Chị đại nói rồi, chỉ cần để tờ giấy đặt đúng chỗ ban đầu, sau đó ngồi đợi ở bên cạnh ắt có kẻ tự đâm đầu vào rọ, ngọn lửa cháy thêm lần nữa hí hí hí lại là một món hời lớn...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210202002
					],
					"speakerTitle": "Bút Ký Nét Chữ Nguệch Ngoạc"
				},
				{
					"id": 210202002,
					"content": "\"... Nhiều báu vật như vậy một lần không thể đem đi được hết, nghe lời chị đại ta chôn ở <color=#00E1FFFF>đỉnh núi cao nhất của Dốc Phỉ Thúy</color>, trên ngọn núi có gốc cây cổ thụ đã già héo, chị đại chắc chắn dễ dàng nhìn thấy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bút Ký Nét Chữ Nguệch Ngoạc"
