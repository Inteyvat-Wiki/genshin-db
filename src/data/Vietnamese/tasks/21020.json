			"dialogs": [
				{
					"id": 210200001,
					"content": "\"...Đây là cái gọi là \"lòng tham không đáy\" rồi. Nếu chỉ muốn lấy kho báu trong tầng hầm này mà không muốn đi đến lửa trại cầu nguyện chết tiệt đó, tôi sẽ chẳng bao giờ chạm vào cơ quan, bị cái tên to lớn ấy chặn lại, bị mắc kệt ở đây... không ra được\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210200002
					],
					"speakerTitle": "Một bức thư rách nát"
				},
				{
					"id": 210200002,
					"content": "\"Nếu bất cứ ai có khả năng đánh bại tên to lớn đó, thì đi tìm lửa trại cầu điều ước nào đó đi, tôi sẽ cố gắng... cầu nguyện cho bạn!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Một bức thư rách nát"
				}
			]
		},
