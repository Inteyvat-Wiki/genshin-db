			"dialogs": [
				{
					"id": 755060101,
					"content": "Xin chào, đến rồi à! Đây là địa điểm cuối cùng mà đám Bọ Vực Sâu xuất hiện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060102,
					"content": "Bắt gọn lũ bọ ở đây là xong rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060103,
					"content": "Ừm. Cho dù có vài con lọt lưới thì cũng không phải vấn đề lớn, tôi sẽ dành thời gian ra để xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060104,
					"content": "Trong bộ tộc cũng có thông tin gửi đến, rằng bệnh tình của mọi người mấy hôm nay cơ bản cũng chuyển biến tốt lên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060105,
					"content": "Tin tốt đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060106,
					"content": "Nhưng vẫn có một chuyện hơi đáng tiếc, về âm mưu mà Paimon cảnh giác đã không xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060107,
					"content": "Loại quả đó có vẻ là thực vật sinh trưởng tự nhiên ở địa điểm lũ bọ tập trung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060108,
					"content": "Hmm... Tôi cũng không có dự đoán là sẽ xuất hiện Fatui hay Đạo Bảo Đoàn gì đó mà... Tôi chỉ muốn thể hiện sự cảnh giác mà một người dẫn đường xuất sắc nên có thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060109,
					"content": "Tôi tin là Paimon sẽ tiếp tục duy trì tính tốt này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "Hihi, đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060111,
					"content": "Được rồi, vậy chúng ta mau chóng giải quyết nhiệm vụ cuối cùng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060112,
					"content": "Được! Tiểu đội bắt bọ, xuất phát lần cuối nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
