			},
			"dialogs": [
				{
					"id": 755060201,
					"content": "#Xilonen? Cả {NICKNAME} và Paimon nữa, xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060202
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060202,
					"content": "Ororon? Sao anh lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060203,
					"content": "Sức khỏe của anh thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060204
					]
				},
				{
					"id": 755060204,
					"content": "Cảm ơn đã quan tâm. Bà đã cho tôi uống thứ nước đắng chát, rồi bắt tôi đi nghỉ ngơi mấy hôm. Giờ tôi đã khỏe lên nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060205,
					"content": "À, Ororon! Anh cũng đến đây giúp Xilonen bắt bọ à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060206,
					"content": "Bắt bọ? Ồ! Thì ra sự ngọt ngào đó đã bị các vị bắt đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060207
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060207,
					"content": "Chẳng trách sao Ngọt Cực Hạn và Ngọt Bất Thường đã không thấy đâu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060208,
					"content": "Hmm... Đó là tên của lũ bọ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060209
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060209,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060210,
					"content": "Đó là để tiện cho việc phân biệt thôi. Tôi sẽ không đánh giá chúng, dù chúng không tạo ra mật thì vẫn rất tuyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060211
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060211,
					"content": "Vậy thì... Đám bọ đó là do anh nuôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060212,
					"content": "Thực ra thì tôi không can dự nhiều đến cuộc sống của chúng. Chúng tôi chỉ đang chung sống trên cùng một khu vực, nên mối quan hệ khá hòa thuận thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060213
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060213,
					"content": "Ừm... Xin lỗi, tôi không biết chuyện này. Vì chúng đã bị ô nhiễm bởi Vực Sâu, ảnh hưởng đến bộ tộc, nên không thể không xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060214,
					"content": "Đúng đó... Chúng tôi cũng không có làm hại đến tính mạng của chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060215,
					"content": "Vậy thì được... Không sao, không cần bận tâm vậy đâu, vốn dĩ tôi đến đây cũng là để xử lý chuyện này mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060216
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060216,
					"content": "Chỉ là, có một chuyện cần phải đính chính. Loài bọ này là sinh vật rất thông minh, không phải chúng bị ô nhiễm bởi Vực Sâu, mà là chúng chủ động hấp thụ năng lượng Vực Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060217
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060217,
					"content": "Hả? Chủ động hấp thụ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060218,
					"content": "Chính xác là vậy. Mỗi lần chúng đều hấp thụ một lượng rất nhỏ và khiến cơ thể trở nên to lớn, nhưng chúng lại không chết vì điều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060219
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060219,
					"content": "Sau đó chúng sẽ bay đến nơi rất xa, rồi tạo ra những viên Ngọc Mật Phlogiston bao bọc lấy sự ô nhiễm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060220
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060220,
					"content": "Lớp vỏ mật bên ngoài có thể ngăn cách sự ô nhiễm, làm như vậy sẽ bóc tách năng lượng Vực Sâu ra khỏi mái nhà của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060221
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060221,
					"content": "Tuy phải làm đi làm lại rất nhiều lần, nhưng chúng vẫn rất kiên nhẫn. Dù có vất vả như cách loài kiến di dời tổ cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060222
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060222,
					"content": "Ồ... Thì ra chúng đang bảo vệ quê nhà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060223,
					"content": "Quả là lần đầu tiên được nghe đấy... Thì ra chúng cũng biết mảnh đất này đang bị xâm hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060224
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060224,
					"content": "Ừm, thứ nhỏ bé ngọt ngào đó vẫn đang không ngừng nỗ lực chiến đấu! Tất cả những con bọ đều rất năng nổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060225
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060225,
					"content": "Natlan không hổ danh là vùng đất của chiến tranh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060226
					]
				},
				{
					"id": 755060226,
					"content": "Nhưng mà Ororon, sao anh biết mà tìm đến đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060227
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060227,
					"content": "À, vì tôi đã cho đám bọ ăn hạt giống của một loại quả gây tê. Chúng sẽ không tiêu hóa được, nên sẽ thải ra nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060228
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060228,
					"content": "Sau khi hạt giống rơi xuống đất thì sẽ nảy nở, mọc thành bụi cây nhỏ. Tôi lần theo và tìm ra nơi mà chúng thường xuyên lui tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060229
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060229,
					"content": "Sau đó tôi sẽ thu gom và xử lý những viên ngọc mật mà chúng tạo ra, và dùng quả gây tê để đưa chúng về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060230
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060230,
					"content": "Nhưng xem ra mọi người đã thay tôi xử lý chuyện này rồi, cũng không làm hại đến tính mạng của chúng. Thực sự cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060231
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060231,
					"content": "Thì ra đây là nguồn gốc của Quả Gây Tê à... Tôi còn vắt óc suy nghĩ xem liệu có âm mưu gì không chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060232,
					"content": "Sao vậy? Đã gây phiền phức cho mọi người à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060233
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060233,
					"content": "Không có không có! Yên tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060234,
					"content": "Ororon, chúng tôi sẽ thay anh đưa lũ bọ đã được xử lý về nhà, cứ yên tâm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060235
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060235,
					"content": "Như vậy thì tốt quá! Chúng đều là những sinh linh rất quan trọng, nhất định phải đối xử tốt với chúng.",
