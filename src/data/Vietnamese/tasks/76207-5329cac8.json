			"dialogs": [
				{
					"id": 762070201,
					"content": "Ah... Tôi từng là ngôn ngữ, nhưng giờ đã trở thành chủ thể của ảo giác tan vỡ, một lần nữa quay trở lại với \"biểu tượng\" không hoàn hảo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "Ơ! Một người kỳ lạ nói những điều kỳ lạ từ một cuốn sách kỳ lạ xuất hiện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "\"Kỳ lạ\" là cách diễn đạt thiếu chính xác. Nó chỉ những chủ thể đặc biệt không thể được mô tả, không thể được ghi chép, không thể được biểu trưng. Còn tôi, rõ ràng là không phù hợp với định nghĩa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "Tôi chỉ đang muốn tìm kiếm lối vào \"thực tại\" giữa những trang sách, nhưng lại vô tình trượt vào vòng xoáy ẩn dụ trì hoãn vô tận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "#Tôi đã trở thành phần dư thừa không thể biểu tượng hóa. May nhờ có {F#cô}{M#cậu}, tôi mới có thể thoát khỏi chế độ độc tài của ngôn ngữ, bắt đầu nhìn nhận lại chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "Nói cái gì cho người ta hiểu được đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "#...Tôi chẳng may bị rơi vào trang sách rồi không ra được, cảm ơn {F#cô}{M#cậu} đã kéo tôi ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
