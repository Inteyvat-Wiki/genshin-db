				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Tuyệt quá... Như vậy là những phế liệu chính dưới nước đã được trục vớt gần hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160102,
					"content": "#Hai người vất vả rồi, {NICKNAME} và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160103,
					"content": "Không có gì đâu. Thay vì nói là mệt mỏi thì tôi thấy nên nói lần này thu hoạch được rất nhiều mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "Vừa giúp khôi phục môi trường dưới nước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Cảm ơn hai người... Nhờ hai người mà tôi đã có khoảng thời gian vui vẻ và ý nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160107,
					"content": "Không có gì đâu, đây là thành quả chung của mọi người mà! Hơn nữa, tôi thấy Freminet cũng tiến bộ rất nhiều đấy, dù dưới nước hay trên mặt nước đều rất đáng tin cậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "Đừng ngại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "Được... Được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160111,
					"content": "Xin lỗi, ngoài lời cảm ơn ra thì tôi vẫn không biết nên nói gì lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160112,
					"content": "Có lẽ... tôi vẫn cần phải luyện tập thêm một thời gian nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160113,
					"content": "Cứ bình tĩnh thôi, đừng vội. Dù chỉ là luyện tập, cũng cứ theo tiết tấu của bản thân để từ từ cố gắng là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "Sau này có cơ hội, chúng ta vẫn có thể hợp tác như thế này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Ừm, chắc chắn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160117,
					"content": "...Ban đầu tôi nghĩ, sau khi hoàn thành nhiệm vụ, tôi sẽ cần xuống dưới nước ở một mình một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160118,
					"content": "Nhưng thật kỳ diệu, sau khi trò chuyện với hai người... ngay cả bầu trời cũng trở nên vô cùng yên bình. Và tôi muốn chia sẻ với hai người... về tâm trạng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160119,
					"content": "Vậy... hôm nay tôi về gặp anh Lyney và mọi người trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160120,
					"content": "Thông tin thăm dò dưới nước còn lại phải nhờ hai người rồi. Chúc hai người sẽ có những thu hoạch như ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160121,
					"content": "Ồ, ở trên lầu tôi đã nghe thấy mọi người ăn mừng rồi. Có chuyện gì vui vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160122,
					"content": "Ừm! Chúng tôi đã vớt gần hết rác thải ảnh hưởng đến cuộc sống của các loài cá rồi, còn tìm được cả những phần còn lại của cây đàn piano nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "Thật sao? Tôi xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160124,
					"content": "...Đúng thế thật. Có những thứ này rồi, tôi có thể sửa lại cây đàn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160125,
					"content": "Tuy không thể khôi phục y nguyên, nhưng cũng có thể khiến nó lại vang lên những giai điệu tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160126,
					"content": "Giọng điệu của cô nghe có vẻ vui nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "Có... có à? Thôi kệ, tôi sẽ đi sửa nó ngay, không mất nhiều thời gian đâu. Hai người hãy giúp tôi trang trí chỗ này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160128,
					"content": "Chỉ có sân khấu đẹp đẽ mới xứng với âm nhạc của ngươi, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160129,
					"content": "Cô ấy quả nhiên rất vui nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "Woa! Cây đàn piano đẹp quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "Thật thanh lịch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Hừm, tất nhiên rồi, xem thử là ai sửa đi chứ. Tôi còn gia cố lại cả cơ cấu liên kết máy móc và tân trang lại lớp vỏ bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160134,
					"content": "Hai người cũng làm tốt lắm, sân khấu này cũng xứng đáng với nó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160135,
					"content": "Ây dà, chuyện nhỏ thôi mà. Thôi đừng nói nhiều nữa, cô không đàn một bài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "...Hả? Bây giờ á?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160137,
					"content": "Chứ sao nữa? Cô sửa nó chẳng lẽ không phải để đàn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "Hôm nay... thì tạm thôi vậy! Sau này có cơ hội rồi đàn cũng không muộn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160139,
					"content": "Quên nhạc phổ rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Hmph... Phiền phức quá...! Tôi chỉ muốn ở yên với nó một lúc, để hoài niệm lại khoảng thời gian đã qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160142,
					"content": "Đừng tưởng khiêu khích vài câu là tôi sẽ đồng ý. Hừ, về luyện thêm đi rồi hãy quay lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747160140,
					"content": "Hay xấu hổ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "Lung linh quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "Lần sau có chuyện gì thì cứ tìm chúng tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "Lại vừa tìm được nhiều kho báu đẹp nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}