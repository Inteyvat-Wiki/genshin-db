			"dialogs": [
				{
					"id": 761290101,
					"content": "Một lần nữa cảm ơn vì đã giúp đỡ hiệp hội, cô chủ Nefer và tiểu thư Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761290102,
					"content": "Hợp tác thôi mà, không cần khách sáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290103,
					"content": "Nói thì nói vậy, nhưng tôi vẫn phải cảm ơn cô chủ Nefer đã đồng ý giúp đỡ hiệp hội một số... việc điều tra phức tạp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290104,
					"content": "Hiệp Hội Nhà Mạo Hiểm cũng đã cử rất nhiều nhân lực đến hỗ trợ công việc của chúng tôi, xem như hợp tác đôi bên cùng có lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290105,
					"content": "Hy vọng sau này chúng ta sẽ tiếp tục được hợp tác vui vẻ như vậy, anh Sarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290106,
					"content": "Cô chủ Nefer xin cứ yên tâm, Hiệp Hội Nhà Mạo Hiểm chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290107,
					"content": "Ồ, tôi phải thận trọng hơn. Hiệp Hội Nhà Mạo Hiểm phân hội Nod-Krai chúng tôi, tuyệt đối là một đối tác đáng tin cậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290108,
					"content": "Haha, tôi thấy được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290109,
					"content": "(Được, được! Nói như vậy, sếp Nef à, sếp Nef thân yêu, đừng nhìn em, xin đừng nhìn em...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, sao em không nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290111,
					"content": "(Vẫn cứ là nhìn em! Vậy thì đừng nhìn bảng ủy thác, đừng mà sếp ơi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "Hả? Em... em có gì để nói đâu! Cảm ơn... vì đã giao ủy thác...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Chậc, cũng phải cảm ơn tiểu thư Jahoda đã giúp đỡ. Nếu không có cô, e là công việc của hiệp hội đã chất thành núi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290114,
					"content": "Đừng khách sáo... Tôi đã nhận tiền rồi, chắc chắn sẽ làm cho đàng hoàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(Haiz... Mấy lời mình dạy lúc trước, chắc là lại quên sạch rồi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290116,
					"content": "Đúng rồi. Dù gì cũng đã đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290117,
					"content": "(ĐỪNG! Bầu không khí đang tốt như vậy, tha cho em đi sếp ơi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Phiền anh Sarin đưa số ủy thác mới nhất cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, chọn một ủy thác đi, cái nào em muốn làm nhất ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290120,
					"content": "Nghĩ thật kỹ, từ từ chọn, được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290121,
					"content": "Dạ được... sếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(Aaaa... HỎNG, BÉT, RỒI!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
}