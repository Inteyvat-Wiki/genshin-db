			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "Khụ khụ... phù... chờ đã, xin hãy ngừng tay...! Ngươi là ai? Tại sao lại ở đây...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580102,
					"content": "Và... tại sao lại tấn công ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580103,
					"content": "Bọn tôi còn tính hỏi cô đó! Ai bảo cô lén la lén lút ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580104,
					"content": "Cô là người xấu, cô nói trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "Katarina, Katarina Snezhevna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580106,
					"content": "Tên là thứ tình báo không đáng để giữ bí mật nhất, tôi chỉ có thể nói bấy nhiêu thôi, xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580107,
					"content": "Ừm... Chúng tôi chỉ hỏi tình hình thôi, không có ý định chất vấn đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580108,
					"content": "Xin lỗi, xin lỗi, đây là tất cả tình báo mà tôi có thể tiết lộ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580109,
					"content": "Tại sao Fatui lại hoạt động ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "Bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580111,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "Gì chứ! Những kẻ bí ẩn các người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580113,
					"content": "Haha, đúng vậy, chúng tôi chính là những kẻ xấu như vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580114,
					"content": "Thôi được rồi, hết thời gian để hiếu kỳ rồi nhé... chúng ta gặp rắc rối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105804",
							"2"
						],
						"stepId": 7105804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "Cám ơn... Dù thế nào thì tôi cũng rất vui vì các người đã không thừa cơ đâm sau lưng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580202,
					"content": "Câu này phải là tôi nói mới đúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "Xía... Tuy rằng không biết các người có thành kiến thế nào với Fatui, nhưng bắt chuyện ở nơi thế này thì không lãng mạn chút nào... có muốn nói gì thì hãy đến nơi tôi trú ẩn rồi nói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580207,
					"content": "Katarina rời đi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "Ơ? Cô ấy là Fatui đó, chúng ta cứ thế mà thả đi sao? Không giao cô ấy cho Thiên Nham Quân à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580206,
					"content": "Hừ... Tôi biết rồi, bỏ đi, dù sao cô ấy cũng không làm gì tụi mình, xem như tha cho cô ấy một lần vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580203,
					"content": "Fatui luôn nghi ngờ người khác như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "Hai người quả nhiên đã đến rồi, xin hãy tìm một nơi nghỉ ngơi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580502,
					"content": "Ở đây có, ừm... hồng trà, hết rồi... đường, cũng hết rồi... ưm, sữa, sặc... bị chua rồi, lát nữa tôi đem đổ vậy... Thật ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580503,
					"content": "Nhưng mà Hỏa Thủy thì còn nhiều lắm... còn có bánh quy nữa, và còn một ít mứt chua nữa... ừm, cũng đủ làm bữa tiệc trà rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580504,
					"content": "Wao...! Các người dùng Hỏa Thủy làm tiệc trà sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580505,
					"content": "Đúng vậy, lạ lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580506,
					"content": "Ừm... thôi khỏi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "Sao vậy? Hihi, ở đây không ai quản việc uống rượu đâu. Không cần câu nệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580510,
					"content": "Cô đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "\"Chia sẻ tình báo và thức ăn một cách hợp lý, có thể chặn họng người hỏi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580513,
					"content": "...Sổ tay của chúng tôi nói vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580514,
					"content": "Vậy tình báo đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "Ừm? Thì vừa nãy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580516,
					"content": "Gì chứ... vừa nãy cô có nói gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580517,
					"content": "\"Phụ lục 4-4 của \"Sổ tay huấn luyện đội tiên phong Fatui\", điều thứ 32: Chia sẻ tình báo và thức ăn một cách hợp lý, có thể chặn họng người hỏi.\" nè?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580518,
					"content": "Để đền ơn cứu mạng, thật ra tôi đã tiết lộ nội dung sổ tay huấn luyện bí mật rồi đó! Hì hì, rất có thành ý phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580519,
					"content": "Nói với chúng tôi điều đó có ích gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580520,
					"content": "Haha, không đùa với các bạn nữa... Nói thật lòng, cám ơn các bạn đã giúp đỡ, xin đừng cố gắng lý giải ý tốt của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580521,
					"content": "Ơ... dựa trên những chuyện xấu mà trước đây các người từng làm, thật không dám tin Fatui sẽ có ý tốt đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580522,
					"content": "Cô có mưu đồ gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "Người ngoài không thể nào hiểu được lý tưởng của Fatui, điều này cũng không nằm ngoài suy đoán. Nhưng những lúc không nói đến lý tưởng và lập trường, thì chúng tôi cũng chỉ là những người bình thường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580524,
					"content": "...Hơn nữa, mọi hành vi của chúng tôi, bất luận mục đích là gì, đều là để chuẩn bị cho trận quyết chiến cuối cùng mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580525,
					"content": "Quyết chiến cuối cùng...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "Ừm, cuối cùng rồi chúng ta sẽ phải đối mặt với kẻ thù chung, và không thể nào trốn thoát đêm dài... quốc dân của Snezhnaya đều đã nhận được lời cảnh báo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580527,
					"content": "Cho nên, vì thế giới lạnh lẽo này, mỗi một giọt nước mắt hay máu tươi mà con người đổ xuống... đều không phải là vô nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580528,
					"content": "Cạn ly? Ơ, được rồi, được rồi, để tự tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580529,
					"content": "Cô đang thanh minh cho hành vi xấu xa của mình sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "Cũng có thể... Không biết, không quan tâm. Bạn muốn giải thích, tôi cho bạn lý do... Chỉ là phiên bản của tôi, chưa chắc hợp khẩu vị của bạn. Chỉ đơn giản vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580534,
					"content": "Ơ... Sao đột nhiên lại nói chuyện nghiêm túc vậy...",
