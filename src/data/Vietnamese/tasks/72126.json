						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Cảm ơn bạn, vậy là tôi có thể tiếp tục trồng hoa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260304,
					"content": "À, đúng rồi, những thứ này bạn hãy nhận lấy, tôi cũng không có gì quý giá để cho bạn...dù sao thì cũng cảm ơn bạn đã đồng ý giúp tôi!",
					"roleType": "TALK_ROLE_NPC",
