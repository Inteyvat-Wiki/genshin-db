			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "Không ổn rồi...phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260102,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "Bạn...may quá, bạn đến rồi...là thế này, hạt giống bạn đưa cho tôi, tôi đã trồng nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260104,
					"content": "Nhưng chưa trồng được bao nhiêu thì đột nhiên có một lũ ma vật xuất hiện ở chỗ tôi chuẩn bị trồng hoa, tôi không dám đến đó trồng hoa nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260105,
					"content": "Cứ để bọn chúng tung hoành như vậy, nói không chừng nơi trồng hoa sẽ bị bọn chúng phá hỏng mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260106,
					"content": "Bạn có thể giúp tôi đuổi lũ ma vật đó đi không? Tôi, tôi chỉ muốn trồng hoa thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260107,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "Bạn đồng ý rồi sao! Cảm ơn bạn! Vậy thì nhờ cả vào bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260109,
					"content": "Tại sao cứ phải trồng hoa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "Tôi nghĩ mọi người không muốn trở về Tatarasuna có lẽ là vì sợ sau khi trải qua chuyện Lò Luyện Mikage, nơi này không còn thích hợp để sinh sống nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260111,
					"content": "Tôi không còn cách nào khách đành phải thuyết phục từng người, nhưng mà nếu như tôi có thể trồng lại thật nhiều hoa đẹp ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260112,
					"content": "Như vậy có thể sẽ thuyết phục được người ta rằng Tatarasuna là một nơi an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260113,
					"content": "Vả lại...hihi, ngoài trồng hoa ra, tôi cũng không còn cách nào để thuyết phục mọi người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260114,
					"content": "Cho nên, làm ơn hãy giúp tôi đuổi lũ ma vật kia đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
