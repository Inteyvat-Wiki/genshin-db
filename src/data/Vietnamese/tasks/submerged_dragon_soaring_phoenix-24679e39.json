			"dialogs": [
				{
					"id": 762100617,
					"content": "Người trong tranh chợt nhảy vút lên, đến trước mặt hai người...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762100601
					]
				},
				{
					"id": 762100601,
					"content": "#Tại hạ Zhangsun Jijing, xin chào {M#thiếu hiệp}{F#nữ hiệp}. Chẳng hay {M#thiếu hiệp}{F#nữ hiệp} gọi tại hạ lại là có việc gì quan trọng cần bàn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100602
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100602,
					"content": "À, cũng không có chuyện gì quan trọng lắm đâu. Chỉ là thấy anh nhảy nhót trong tranh nên hơi tò mò thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100603,
					"content": "Ra là thế. Vừa rồi tại hạ đang luyện khinh công, nhưng mà kỹ thuật vụng về, khiến hai vị chê cười rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
