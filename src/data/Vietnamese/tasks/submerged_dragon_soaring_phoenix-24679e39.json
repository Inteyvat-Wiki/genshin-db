						762100614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100614,
					"content": "Cảm ơn. Vậy mời hai vị xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100611,
					"content": "Paimon là chưởng môn phái Paimon mà, để Paimon đi đi.",
