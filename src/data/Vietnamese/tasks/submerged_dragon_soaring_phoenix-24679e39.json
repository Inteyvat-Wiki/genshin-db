			"dialogs": [
				{
					"id": 762100101,
					"content": "#{M#Thiếu hiệp}{F#Nữ hiệp} thân thủ tốt thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Hihi, đương nhiên rồi! {NICKNAME} mạnh lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "#Tiếp theo, không biết {M#thiếu hiệp}{F#nữ hiệp} có thể cho tại hạ chiêm ngưỡng tinh hoa của <color=#00E1FFFF>Tung Bộ Pháp</color> không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "Theo ghi chép trong sách, tông sư Cổ Hoa có thể nhảy tường vượt thành như đi trên đất bằng, thực sự có khả năng vượt nóc băng tường, đó chính là Tung Bộ Pháp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "Lợi hại quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Ừm... Vậy thử xem sao? Dù sao {NICKNAME} cũng từng tìm rương báu khắp nơi, trèo qua nhiều chỗ lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "Nghe như kẻ trộm vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#Haha, {M#thiếu hiệp}{F#nữ hiệp} nghĩ xem, nếu bọn trộm có thể trèo tường, mà những người trừ gian diệt ác như chúng ta lại không thể, chẳng phải sẽ để kẻ gian dễ dàng tẩu thoát sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
