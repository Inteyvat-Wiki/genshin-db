					"nextDialogs": [
						762100610
					]
				},
				{
					"id": 762100610,
					"content": "Woa, giọng điệu đột nhiên trở nên kỳ lạ thế! Vậy chúng ta phải làm gì bây giờ?",
					"roleType": "TALK_ROLE_NPC",
