			},
			"dialogs": [
				{
					"id": 762100201,
					"content": "Thật đáng ngưỡng mộ. Tại hạ khâm phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "#Nếu vậy thì... tại hạ còn có một chuyện muốn nhờ. Chẳng hay {M#thiếu hiệp}{F#nữ hiệp} đã từng nghe nói về <color=#00E1FFFF>Tung Vân Pháp</color> chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Nghe đồn sư tổ Phái Cổ Hoa từng bay lên trời trong ánh hào quang màu tím, bước đi trên không như đi trên đất bằng, chính là nhờ bí pháp trong truyền thuyết này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Nghe hơi khó tin nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "Đúng vậy, nghe như là giả ấy... Nhưng nói vậy, nếu có thể dùng Phong Chi Dực, không chừng cũng có thể làm được chuyện tương tự?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "#Ồ? Vậy thì xin {M#thiếu hiệp}{F#nữ hiệp} chỉ giáo vài chiêu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "Nếu có thể dùng Phong Chi Dực...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
