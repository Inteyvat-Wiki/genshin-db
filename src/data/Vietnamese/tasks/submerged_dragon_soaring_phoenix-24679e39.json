			"dialogs": [
				{
					"id": 762100301,
					"content": "Hai vị xem này. Đây chính là Vọng Mai Trận của Cổ Hoa Đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "#Trong thời gian quy định, {M#thiếu hiệp}{F#nữ hiệp} hãy lần lượt nhảy lên những cây cột đá mà tại hạ chỉ ra, thể hiện thân pháp cho tại hạ chiêm ngưỡng, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "Chuyện nhỏ như con thỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Dù thực ra có rất rất nhiều cột... Uhm, không có gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "#Vậy thì, xin mời {M#thiếu hiệp}{F#nữ hiệp} thể hiện tài năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "Thật ra Paimon, chưởng môn của phái Paimon cũng làm được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "Không làm được đâu! Nghĩ thế nào cũng... Ơ? Nghĩ kỹ lại thì hình như cũng làm được thật đấy... Nhưng mà, bay thì chắc là phạm quy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
		},
