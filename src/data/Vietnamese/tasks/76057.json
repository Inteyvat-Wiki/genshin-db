			"trigger": {
				"objectNames": [
					"Vaino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "Lần sau thiết kế thêm trận đấu theo đội được không nhỉ? Có lẽ đấu đối kháng cũng là một ý tưởng không tồi! Ồ, là hai người à, chào mừng đến với sân tập!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "Về sân tập...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "Khách đến càng lúc càng đông, cũng là nhờ công của hai người đấy. Đương nhiên, còn có công sức của bọn trẻ và Địa Ẩn Hội nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "Tôi phát hiện ra sân tập là một nơi rất thích hợp để tụ tập. Gặp lại bạn bè sau nhiều năm không gặp, chắc hẳn sẽ không biết phải nói gì đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "Về Địa Ẩn Hội...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "À... Tạm thời vẫn chưa tìm được nguyên liệu nào phù hợp hơn bia tập bắn để lót ổ cho chuột chũi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "Tôi và bọn trẻ đã thử mấy loại rồi, nhưng chúng đặc biệt thích bia tập bắn. Đến giờ vẫn phải đi giao dịch với chúng để đổi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "Nhưng mà chúng tôi cũng dần nắm được tỷ giá kho báu của chúng rồi, nên kiếm lời không ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "Lần sau tôi lại đến tìm anh nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "Ừm, cứ ghé qua bất cứ lúc nào! Nhớ nhé, chỉ cần là hai người thì sẽ luôn miễn phí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
		{
			"id": 7605719,
