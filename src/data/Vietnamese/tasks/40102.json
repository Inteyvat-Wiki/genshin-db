			"dialogs": [
				{
					"id": 401020501,
					"content": "Nhiều chữ quá, ngồi đọc tới nhức đầu luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020502,
					"content": "Nói chung là Sachin mang sản nghiệp của mình ủy thác cho Giáo Viện quản lý, sau đó bản thân thì đi ra ngoài nghiên cứu đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020503,
					"content": "Ông ấy còn nói nếu thừa nhận một tuyển thủ tham gia thì không chỉ là phần thưởng, đến cả sản nghiệp của mình cũng sẽ giao cho người đó... Vậy là rất rất nhiều tiền rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020504,
					"content": "Sao?! Có chuyện ngon ăn như vậy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020505
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020505,
					"content": "Tài sản của Sachin... chắc nhiều đến nỗi cả đời này tôi cũng tiêu không hết. Nếu như tôi lấy được thì không những trả được hết nợ, đến việc mua luôn căn nhà mới cũng sẽ còn thừa rất nhiều tiền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020506
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020506,
					"content": "Đến lúc đó tôi sẽ xây thêm một cái Cung Điện Alcazarzaray to hơn bây giờ gấp mười lần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020507
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020507,
					"content": "Còn cả dự án mới bên Cảng Ormos nữa, cải tạo cầu đường, nếu muốn làm cho tốt thì e là phải tốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020508
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020508,
					"content": "Mau tỉnh lại đi, giờ tính đến bước này có hơi sớm quá không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020509,
					"content": "Cũng phải. Trước mắt là phải đoạt được quán quân để sớm dọn ra ngoài đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020510
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020510,
					"content": "Hửm? Đợi đã, trong đống tài liệu hình như có kẹp một mảnh giấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020511,
					"content": "Đây là của Alhaitham viết sao? Hình như là tờ giấy chú thích khi anh ta suy nghĩ nhỉ... Để xem thử, có hai câu bị khoanh lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020512,
					"content": "Câu đầu tiên là \"Sachin chưa rõ sống chết\", câu thứ hai là... \"Vương Miện Trí Tuệ\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020513,
					"content": "Còn có một số câu đọc không hiểu, là ngôn ngữ nào đó khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020514,
					"content": "Để tôi xem... Ừm? Văn tự kiểu này... Ừm, để suy nghĩ thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020515
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020515,
					"content": "\"Lý tưởng cao cả chưa chắc có thể chống lại hư vô, nhưng sự lựa chọn nhỏ thì có thể\". Không đảm bảo đúng hết nhé, nhưng ý đại khái là thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020516
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020516,
					"content": "...Hm? Bên dưới còn có hàng chữ nhỏ... Hửm...Như vậy là có ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020517
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020517,
					"content": "Không ngờ anh lại đọc hiểu được loại chữ kỳ lạ này, thật lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020518,
					"content": "Thời còn là học sinh thì tôi có hợp tác với anh ta để làm một đề án, tựa đề là \"Giải Mã Cổ Ngữ Và Triết Lý Kiến Trúc Của Tàn Tích Nền Văn Minh Vua Deshret\". Lúc đó tôi cũng tham khảo và học được một số văn tự cổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020519
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020519,
					"content": "Thì ra là vậy! Nhưng mà... Alhaitham viết những thứ này là có ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020520,
					"content": "Ai mà biết chứ? Lối suy nghĩ của tên đó người bình thường không hiểu được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020521
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020521,
					"content": "Được rồi, xem ra ở đây không còn manh mối nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020522,
					"content": "Hy vọng bên phía Aarav có tiến triển.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020523
					]
				},
				{
					"id": 401020523,
					"content": "Đúng vậy, hy vọng sớm ngày bắt được đám người xấu đó. Nhưng trước hết... Ừm... Chúng ta đến chỗ khác dạo đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
