			"dialogs": [
				{
					"id": 401025001,
					"content": "Không ngờ lại có người dám động thủ trong Đại Hội Học Viện, xem ra tài sản của Sachin có sức hút thật nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025002
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025002,
					"content": "Nếu như đột nhiên có một đống tiền thì cô sẽ làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025003
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025003,
					"content": "Tôi không biết, tôi chưa nghĩ qua bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025004
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401025004,
					"content": "Vậy thì giờ nghĩ xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025005
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025005,
					"content": "Ừm... Chắc là làm mấy chuyện như mua đồ ăn, tìm nguồn nước nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
