			"dialogs": [
				{
					"id": 401020301,
					"content": "Phù... Nilou, cô có thấy Alhaitham không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020302,
					"content": "Anh Alhaitham sao? Có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020303
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020303,
					"content": "Chúng tôi đang điều tra một người, cho nên cần nhờ anh ấy giúp đỡ xem hồ sơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020304,
					"content": "Vậy sao... Xin lỗi, tôi cũng không rõ là anh ấy đang ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020305
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020305,
					"content": "Thông thường thì khi kết thúc vòng thi, anh ấy sẽ là người rời đi đầu tiên. Với lại anh Alhaitham cũng không có nói cho người khác nghe về hành trình của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020306
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020306,
					"content": "Được rồi. Nghĩ lại thì thường ngày anh ta cũng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020307,
					"content": "Để tôi nghĩ xem... Anh Alhaitham có vẻ như không có hứng thú với Đại Hội Học Viện lắm, nên chắc sẽ không có ở quanh đây đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020308
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020308,
					"content": "Đối với anh ấy mà nói thì bình luận viên khách mời chỉ là một công việc được giao phó thôi. Hai bạn biết thường ngày anh ấy sẽ đi đâu sau khi tan làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020309,
						401020312
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020309,
					"content": "Quán rượu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020310
					]
				},
				{
					"id": 401020310,
					"content": "Ừm... Nhưng dẫu sao thì vẫn còn một vòng thi mà, anh Alhaitham sẽ đi uống rượu trong quãng thời gian này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020311
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020311,
					"content": "A! Tôi nghĩ ra rồi, hay là anh ấy đã về nhà rồi chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020314,
					"content": "Tôi nhớ nhà của Alhaitham cách đây không xa, chúng ta qua đó xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020312,
					"content": "Về nhà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020313
					]
				},
				{
					"id": 401020313,
					"content": "Đúng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
