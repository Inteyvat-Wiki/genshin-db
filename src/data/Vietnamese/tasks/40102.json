				{
					"id": 401020604,
					"content": "Vậy nếu như có người đến tìm Alhaitham mà chỉ có anh ở nhà thôi thì phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020605,
					"content": "Tôi ở yên trong phòng tôi là được rồi. Hơn nữa, sẽ không có ai đến nhà tìm Alhaitham đâu, thường thì không có ai muốn làm thế cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020606
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020606,
					"content": "Được rồi, vậy anh có biết Alhaitham đi đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020607,
					"content": "Tên đó à? Ai mà biết chứ, muốn đi đâu thì đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020608
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020608,
					"content": "Cãi lộn rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020609
					]
				},
				{
					"id": 401020609,
					"content": "Cãi gì đâu, chỉ là anh ta nói chuyện khó nghe quá thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020610
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020610,
					"content": "Tôi kể cho anh ta nghe về quá trình thi đấu vòng hai. Cuối cùng thì tôi cũng rút trúng mà đúng không? Chứng tỏ tôi ở hiền gặp lành, bây giờ vận may cũng trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020611
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020611,
					"content": "Nhưng mà tên đó... hai người không biết được là hắn đã nói gì sau khi nghe đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020641
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020641,
					"content": "\"Anh luôn nhấn mạnh bản thân là học trưởng, nhưng xử lý vấn đề lại chẳng ra dáng học trưởng tí nào. Vậy thì cái gọi là tôn nghiêm của học trưởng có tác dụng gì chứ?\" Cái gì mà tôn nghiêm của học trưởng chứ! Học trưởng thì chính là học trưởng thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020642
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020642,
					"content": "Còn nữa này! Hắn còn nói là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020612
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020612,
					"content": "\"Tôi khuyên anh tự suy nghĩ lấy đi, tại sao mỗi vòng đều phải đọ may mắn chứ? Anh sống đến từng tuổi này mà vẫn không thấy được vấn đề lớn nhất của mình sao, đúng là khó tin mà.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020613
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020613,
					"content": "Haha... Đúng là lời mà Alhaitham sẽ nói thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020614,
					"content": "Đúng là không thể nhịn nổi mà! Không chỉ là lần này, mà còn lần trước, lần trước nữa! Nói chuyện với tên đó đúng là tức chết mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020615
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020615,
					"content": "Dẫu sao thì chúng tôi cũng không vừa mắt nhau rồi, tôi sẽ sớm ngày dọn ra khỏi đây. Giờ tôi sẽ đi dọn hành lý, sẽ không còn ai giúp tên đó quét dọn nhà cửa nữa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020616
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020616,
					"content": "Đến bức tranh trên tường tôi cũng sẽ tháo xuống mang đi! Từ nay về sau tên Alhaitham đó sẽ sống ở một nơi hoàn toàn không có tính nghệ thuật nữa. Hứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020617
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020617,
					"content": "Đợi đã, anh dọn đi thật à? Cuộc thi vẫn chưa kết thúc mà, anh đã có tiền đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020618,
					"content": "Giờ thì đương nhiên là chưa có, cho nên tôi chỉ thu dọn hành lý để chuẩn bị trước thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020619
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020619,
					"content": "Tôi đã chọn xong căn nhà mới cho mình rồi, đợi khi có được tiền thưởng thì tôi sẽ đi mua ngay. Sau đó sẽ chuyển hành lý qua đó, cùng lắm ba ngày là sẽ rời khỏi đây ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020620
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020620,
					"content": "Để thực hiện được mục tiêu này thì tôi đã hạ quyết tâm rồi. Dù cho vòng đấu thứ ba có xảy ra chuyện gì đi nữa thì tôi cũng sẽ dốc hết sức ra để giành quán quân! Hãy đợi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020621
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020621,
					"content": "Được rồi, chúng tôi sẽ cổ vũ cho anh. Nhưng mà... anh không sao thật đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020622,
					"content": "Hm? Tôi thì có làm sao đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020623
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020623,
					"content": "Layla nói với chúng tôi là cô ấy cho rằng anh hay \"tự mâu thuẫn với chính mình\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020624,
					"content": "Ý là sao, không lẽ hai người cũng cảm thấy tính cách của tôi có vấn đề à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020625
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020625,
					"content": "Chúng tôi không có nói thế! Nhưng anh nghĩ xem, anh nói là anh muốn tiền thưởng, nhưng cũng tự mình từ chối điểm số của Faruzan tặng cho, rồi cũng tự mình không nỡ bỏ rơi đám Cáo Sa Mạc đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020626,
					"content": "Đợi đã, đây đều là chuyện bình thường mà. Lý do thì trước đó tôi đã nói rồi, không làm vậy thì tôi sẽ thấy áy náy đó... Đâu ra mâu thuẫn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020627
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020627,
					"content": "Tại sao anh lại thấy áy náy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020628
					]
				},
				{
					"id": 401020628,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020629
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020629,
					"content": "Sao lại đột nhiên hỏi thế... Mà đúng, tại sao nhỉ? Có lẽ tính cách của tôi là vậy. Hơn nữa nếu không làm, lỡ như xảy ra hậu quả gì thì tôi cũng ân hận lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020630
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020630,
					"content": "Nhưng nếu như vậy mãi thì cuộc sống sẽ rất mệt mỏi đó. Hơn nữa những chuyện anh làm không phải là không có nguy hiểm gì... Ví dụ như ngất xỉu trong sa mạc vậy, anh thấy đáng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020631,
					"content": "...Hai ba câu thì nói không rõ được đâu, để chuyện của tôi qua một bên trước đi. Hai người tìm Alhaitham có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020632
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020632,
					"content": "Chúng tôi muốn nhờ anh ta tìm hồ sơ của Sachin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020633
					]
				},
				{
					"id": 401020633,
					"content": "Sachin? Mấy ngày nay hình như tôi có nghe tên đó lẩm bẩm cái tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020634
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020634,
					"content": "Lúc đó Alhaitham mang một ít tài liệu về, vừa lẩm bẩm vừa viết vẽ trên giấy, còn bảo tôi có thời gian thì ngó qua chút, nhưng tôi không có xem. Chờ chút nhé, để tôi đi tìm thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020635
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020635,
					"content": "...Chính là quyển này đây, cầm lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020636
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020636,
					"content": "Hả... Như vậy có ổn không đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020637,
					"content": "Có gì đâu? Tên đó lấy bia từ chỗ tôi cũng tiện tay như thế mà, có bao giờ khách sáo với tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020638
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020638,
					"content": "Hơn nữa mấy hôm trước hắn hỏi tôi có muốn xem không, lúc đó tôi thấy không cần nên hắn đã để qua một bên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020639
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020639,
					"content": "Theo thói quen của hắn thì nếu tài liệu không cất đi thì có nghĩa là người khác có thể xem, hai người đừng lo lắng quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020640
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020640,
					"content": "Vậy thì tôi yên tâm rồi. Để tôi xem thử xem hồ sơ của Sachin đã viết gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
