					{
						"sceneId": 3,
						"position": [
							-418.421,
							281.227,
							2772.651
						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401020201,
					"content": "Hai vị, lâu rồi không gặp. Tìm tôi có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020202
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020202,
					"content": "Kể chuyện của Dehya và Candace cho Aarav nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401020203
					]
				},
				{
					"id": 401020203,
					"content": "Âm mưu bắt cóc Sachin sao? Không ngờ lại âm mưu làm chuyện này, nhưng nghĩ lại thì cũng không có gì lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020204
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020204,
					"content": "Sachin tài trợ cho Đại Hội Học Viện, giờ đây đại hội này nổi tiếng nên có nhiều người nghe đến danh Sachin, từ đó xem ông ấy như phú hào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020205
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020205,
					"content": "Nếu như vậy thì có nên phái người đi bảo vệ ông ấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020206,
					"content": "Thật không giấu gì, chúng tôi cũng từng nghĩ đến chuyện này. Nhưng mà Sachin thích ra ngoài nghiên cứu, thường xuyên không có mặt trong Thành Sumeru, không ai có thể liên hệ được với ông ấy cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020207
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020207,
					"content": "Manh mối duy nhất chính là ông ấy từng nói \"mỗi lần tổ chức Học Viện Tranh Bá thì tôi đều sẽ quan sát ở nơi gần nhất, chọn ra người thích hợp nhất để kế thừa sản nghiệp của tôi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020208
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020208,
					"content": "Nếu như Sachin tuân thủ lời hứa của mình, vậy thì chắc bây giờ ông ấy đang ở trong Thành Sumeru rồi. Đám người Eremite chắc đã nghe thấy thông tin này nên mới đến đây thử vận may.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020209
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020209,
					"content": "Xem ra thì đám xấu xa đó không biết Sachin đang ở đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020210,
					"content": "Chắc là vậy. Tiền bối Cyno vẫn còn đang nghỉ phép, vậy thì chuyện này để tôi xử lý vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020211
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020211,
					"content": "Yên tâm, giờ đây đám người xấu đó sẽ không gây hại được gì trong Thành Sumeru đâu, tôi sẽ có cách khiến chúng lộ diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020212
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020212,
					"content": "Nhưng mà, nếu hai vị có hứng thú với Sachin thì có thể đi tìm ông ấy thử mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020213
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020213,
					"content": "Sớm tìm được vị trí của Sachin thì chúng tôi sẽ sớm bảo vệ được ông ấy hơn. Dẫu sao thì dù Matra và Lữ Đoàn 30 có lợi hại đến đâu thì cũng không thể bảo vệ được một người không chịu xuất hiện mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020214
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020214,
					"content": "Được rồi, vậy chúng tôi thử đi tìm xem sao. Nhưng mà phải bắt đầu tìm từ đâu đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020215,
					"content": "Phía Matra có tài liệu gì của Sachin không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020216
					]
				},
				{
					"id": 401020216,
					"content": "Không có. Sachin chưa từng có tiền án tiền sự qua, nên Matra cũng không có nhiều thông tin của ông ấy lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020217
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020217,
					"content": "Tôi nghe nói Alhaitham đã từ chức hiền giả đại diện để quay về làm Quan Thư Ký rồi, hay là hai vị đi hỏi anh ấy thử xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020218
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020218,
					"content": "Cũng có lý. Vậy chúng ta đi tìm Alhaitham thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
