			},
			"dialogs": [
				{
					"id": 401020101,
					"content": "#{NICKNAME}, hình như bạn có tâm sự đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020102,
						401020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020102,
					"content": "(Trước cuộc thi, mình gặp được một người tóc trắng kỳ lạ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				},
				{
					"id": 401020104,
					"content": "#{NICKNAME}, Paimon, cuối cùng cũng tìm được hai vị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020105
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020105,
					"content": "Hửm, đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020106,
					"content": "Hai người có cảm thấy lần Đại Hội Học Viện này có gì đó kỳ lạ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020107
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020107,
					"content": "Ban nãy tôi và Candace đến quán cà phê thì thấy có lính đánh thuê đang làm việc ở đây. Họ còn cải trang thành du khách đi dạo nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020108
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020108,
					"content": "Nhưng có cải trang thế nào thì cũng không giấu được mùi máu tanh của chúng. Trông bộ dạng lấm lét đó không phải bắt cóc thì là ám sát rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020109
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020109,
					"content": "Chúng tôi nghe một hồi thì thấy mục tiêu của chúng có thể là một người tên \"Sachin\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020110,
					"content": "Sachin? Đó không phải là người được Kareena đề cập trong lúc khai mạc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020111,
					"content": "Nghe nói \"Vương Miện Trí Tuệ\" là của người đó tài trợ mà. Nhưng hình như người này vẫn chưa lộ diện qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020112,
					"content": "Trông có vẻ như là người có tiền nhỉ, vậy thì không có gì kỳ lạ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020113
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020113,
					"content": "Mấy năm nay cuộc sống của Eremite khó khăn, có nhiều người đã nhận \"mối riêng\", mục tiêu nhắm đến đều là những nhân vật lớn có tiền có quyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020114
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020114,
					"content": "Giống như họ nói là làm phát ăn nửa năm, chỉ cần hoàn thành một vụ thì thù lao đủ cho họ sống yên ổn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020115
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020115,
					"content": "Vì trong kỳ Đại Hội Học Viện này, Thành Sumeru có nhiều du khách ghé thăm, có lẽ chúng cũng nhân cơ hội này để trà trộn vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020116
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020116,
					"content": "Tôi cùng Dehya muốn bắt chúng rồi, nhưng chúng cảnh giác lắm, tìm vài lý do rồi trốn mất tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020117
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020117,
					"content": "Nếu không phải vì không muốn ra tay trong thành thì tôi đã trói chúng lại trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020118
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020118,
					"content": "Theo quy định thì vụ này ai quản nhỉ? Matra? Hay là Lữ Đoàn 30?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020119
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020119,
					"content": "Ừm... Nếu như có Cyno ở đây thì là do anh ấy quản. Hay là chúng ta về Giáo Viện báo cho Matra trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020120,
					"content": "Cảm ơn nhé Dehya, Candace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020121,
					"content": "Không có chi, cũng chỉ là tiện đường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020122
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020122,
					"content": "Đúng vậy, đừng để tâm nhé. Nếu lỡ như chúng thành công thì danh tiếng của Eremite lại xấu đi nữa mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020123
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020123,
					"content": "Nơi này dù sao cũng là Thành Sumeru, tôi và Candace không tiện ra tay, vậy thì giao cho hai người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020124
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020124,
					"content": "Nếu cần giúp đỡ thì đến tiệm cà phê tìm chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020125
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020125,
					"content": "Ban nãy vừa nói bạn có tâm sự, không lẽ là đang suy nghĩ về chuyện Đại Hội Học Viện sao? Nhưng sau khi nghe Dehya và Candace nói xong thì tôi cũng cảm thấy đằng sau có gì đó khúc mắc thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020126,
					"content": "Ừm... Giờ chỉ nghĩ thôi thì không phải là cách. Đi nào, chúng ta đi tìm Matra thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020103,
					"content": "(Vòng đầu tiên kết thúc còn nghe được lời nói bí ẩn nữa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				}
			]
		},
		{
			"id": 4010202,
