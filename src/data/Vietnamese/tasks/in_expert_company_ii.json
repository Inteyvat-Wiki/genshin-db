			"dialogs": [
				{
					"id": 741140101,
					"content": "Không sao, cái rương kia của chúng ta chống nước. Bây giờ chỉ cần lặn xuống vớt nó lên thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140102,
					"content": "Cô chủ à, ba chúng ta chẳng ai biết lặn cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "Tôi thì biết bơi, nhưng mà lặn thì mù tịt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "Nhiệm vụ lần trước chúng ta đăng ở Hiệp Hội Nhà Mạo Hiểm không biết còn treo trên bảng ủy thác không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140105,
					"content": "Cô chủ, không phải lần trước cô muốn chúng tôi hủy bỏ nhiệm vụ đó hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "Hôm qua chúng tôi hủy xong rồi, bên hiệp hội nói hôm nay là có thể rút phí ủy thác đã trả trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Ừm... Nếu chúng ta muốn đăng ủy thác lần nữa thì có phải nộp thêm phí thủ tục không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140108,
					"content": "Mọi người quay phim xong chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#Nhà Mạo Hiểm... {NICKNAME}, bạn đúng là vị cứu tinh của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140111,
					"content": "Bạn biết lặn không? Hoặc bạn có thể tìm giúp một người thợ lặn đến giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140112,
					"content": "Mọi người định... xuống nước quay phim à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "Chúng tôi không có năng lực đó, cũng không mua nổi thiết bị quay phim chống nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "Chỉ là rương đựng phim của chúng tôi rơi xuống nước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#Được rồi, hai người nói ít thôi! {NICKNAME}, xin bạn giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140116,
					"content": "Bạn không cần lo chuyện thù lao, tôi sẽ thanh toán ngay tại chỗ như lần trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140109,
					"content": "Tại sao lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
