			"dialogs": [
				{
					"id": 741140301,
					"content": "#Ái chà, bạn vẫn luôn uy tín đấy {NICKNAME} à. Thật đáng tin cậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140302,
					"content": "Nếu không có bạn hỗ trợ thì nguyên một rương phim bị ngâm nước hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140303,
					"content": "Chúng ta về thành giao đống phim này cho anh Geisert đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140304,
					"content": "#Sau đó... tiện thể ăn bữa cơm. {NICKNAME}, nếu bạn có hứng thì đi cùng luôn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140305,
					"content": "Đợi ăn xong rồi tôi thanh toán thù lao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140306,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Được! Quyết định vậy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, lát nữa cậu mang rương phim này đến cho anh Geisert đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, cậu... đi mua ít nguyên liệu tươi ngon về đây. Gần đây tôi đang nghiên cứu món Súp Hải Sản Poisson, vừa hay hôm nay thể hiện cho anh Geisert thưởng thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140311,
					"content": "Cô chủ, chúng ta đã đến quán ăn rồi, tại sao cô còn phải tự tay làm chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "Chẳng phải sẽ... rẻ hơn sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140313,
					"content": "Khụ! Cứ quyết định vậy đi, mau chóng xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, bạn đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
