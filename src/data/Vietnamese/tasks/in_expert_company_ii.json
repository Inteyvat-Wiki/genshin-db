			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, giới thiệu với bạn, đây là chuyên gia phim ảnh, anh Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140602,
					"content": "#Anh Geisert, đây là {NICKNAME}, một Nhà Mạo Hiểm bản lĩnh cao cường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140603,
					"content": "#Nếu sau này có ý định quay thể loại phim hành động thì {NICKNAME} chắc chắn sẽ là diễn viên số một!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140604,
					"content": "Haha, cô chủ Qiu quá lời rồi, tôi không phải chuyên gia phim ảnh gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140605,
					"content": "Chỉ là tôi từng nghiên cứu về cách vận dụng ánh sáng trong phim mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140606,
					"content": "Ôi, anh khiêm tốn quá. Ánh sáng trong phim của anh có thể cất tiếng nói được luôn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140607,
					"content": "Cách vận dụng ánh sáng trong phim ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "Đúng thế. Trong lý luận phim ảnh của tôi, vận dụng ánh sáng chính là vận dụng cảm xúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140611,
					"content": "Nhưng mà... nói thế nào nhỉ, bây giờ trong giới làm phim của Fontaine, loại lý luận này của tôi tạm thời chưa được coi trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140612,
					"content": "Phần lớn đạo diễn vẫn thích dùng động tác trực tiếp hoặc khung cảnh để diễn tả câu chuyện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140613,
					"content": "Tôi đã quay mấy bộ phim hoàn toàn dùng sự thay đổi ánh sáng để tự sự, nhưng không mấy ai hứng thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140614,
					"content": "Nhưng cuối cùng cũng đã có một vị đạo diễn cho rằng lý luận ánh sáng của tôi là có giá trị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140615,
					"content": "Đạo diễn? Tôi á? Hahaha, anh đừng nói đùa, trước đây tôi chỉ là người bán trà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140616,
					"content": "Ai nói thương nhân bán trà thì không thể làm đạo diễn được? Hồi trước tôi cũng chỉ là một phóng viên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140617,
					"content": "Phóng viên à... Vậy chắc anh rất giỏi viết bản tin nhỉ? Chính là loại tin tức trên báo ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140618,
					"content": "Coi là thế đi. Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140619,
					"content": "Hmm... Cũng đúng lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140620,
					"content": "À! Không có gì! Không có gì! Sau này chúng ta sẽ còn hợp tác lâu dài, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Cô Chủ Qiu"
				},
				{
					"id": 741140621,
					"content": "Mọi người ngồi vào bàn trong tiếng cười vui vẻ của cô chủ Qiu.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Sau khi ăn xong, cô chủ Qiu lại làm thêm một suất đồ ăn, đóng gói rồi nhét vào túi bạn...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "Ánh sáng trong phim rất quan trọng à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Đương nhiên. Trong lý luận phim ảnh của tôi, ánh sáng chính là phương thức quan trọng để biểu đạt cảm xúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				}
			]
