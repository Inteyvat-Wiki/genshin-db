			"dialogs": [
				{
					"id": 752430101,
					"content": "#Ây da! Quý khách, may nhờ có {F#cô}{M#cậu} đuổi những tên Fatui không nói lý lẽ đó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430102,
					"content": "Đám người đó không biết từ đâu đến, không nói không rằng đã đưa tay vào trong túi tôi! Đúng là cướp mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430103,
					"content": "#May mà có {F#cô}{M#cậu} cản họ lại! Nếu không hôm nay chắc chắn sẽ tổn thất nặng nề mất... Xin hãy nhận lời cảm ơn của tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430104,
					"content": "À, suýt nữa quên giới thiệu, đây là Vườn Alpaca Ngũ Sắc, dùng để cho khách xem những con Alpaca ngoan ngoãn. Đương nhiên, còn có rất nhiều món đồ chơi liên quan nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430105,
					"content": "Nhưng mấy kẻ đó đã dọa nhân viên và khách hàng của tôi chạy hết rồi, tôi phải nhanh chóng xử lý đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430106,
					"content": "#Nếu {F#cô}{M#cậu} cũng muốn xem Khu Vườn Alpaca thì ngày mai hãy quay lại nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
