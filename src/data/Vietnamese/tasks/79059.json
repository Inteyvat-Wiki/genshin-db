			"dialogs": [
				{
					"id": 790590101,
					"content": "Đây là một cảnh bị bỏ đi trong vở \"Hành Trình Về Phương Đông\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790590102,
					"content": "Ý tưởng ban đầu xoay quanh câu chuyện nhà lữ hành và cuộc hành trình đi về phía đông. Xuất phát từ Fontaine đến Thành Sumeru để tìm kiếm trí tuệ chưa biết trong Cung Điện Daena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790590103,
					"content": "Cảnh này là tình tiết khi anh ấy giải cứu \"đại sư biến hình\" khỏi tảng đá lớn đè lên người, và họ cùng nhau bắt đầu chuyến hành trình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790590104,
					"content": "Nhưng mà, cả Eidolon Thủy đóng vai nhà lữ hành và Eidolon Thủy đóng vai đại sư biến hình đều không thấy đâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				},
				{
					"id": 790590105,
					"content": "Nếu <color=#00E1FFFF>tìm được chúng</color>, và ghi lại cảnh tập luyện bên tảng đá khổng lồ thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "Ghi Chú Phim Trường"
				}
			]
		},
