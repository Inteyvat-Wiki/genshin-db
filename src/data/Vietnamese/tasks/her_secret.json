			"dialogs": [
				{
					"id": 120220101,
					"content": "Ủa, Kokomi vẫn chưa đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220102,
					"content": "Thật kì lạ, cảm giác Kokomi không phải là người trễ hẹn... chúng ta thử đợi thêm chút xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220103,
					"content": "Kokomi vẫn chưa đến nhỉ, không lẽ xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220104,
					"content": "Chúng ta đi hỏi các binh lính xem thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220701,
					"content": "Bạn muốn gặp đại nhân Kokomi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Xin lỗi, đại nhân Kokomi không ở đây, không biết cô ấy đã đi đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Vậy chúng ta chỉ còn cách quay về sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Cũng không hẳn, tôi nhớ đại nhân Kokomi có để lại túi gấm dùng để giải quyết các tình huống khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Để tôi xem, dòng thứ 98... <color=#00E1FFFF>\"Nếu có khách đến mà không thấy tôi, hãy đi về phía nam, trước tán cây lá tím\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "Trên ghi chú có viết là chỉ dùng túi gấm này trong trường hợp đại nhân không có dặn dò gì, và thân phận của vị khách này phải rất đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Hai vị là khách từ phương xa đến, có lẽ túi gấm này sẽ không dùng sai đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi quả nhiên đã tính được hết mọi tình huống, vậy chúng ta đến chỗ cô ấy nói xem thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "Kokomi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "Thì ra bạn đang ở đây! Không phải mình đã hẹn trước là hôm nay tổ chức tiệc ăn mừng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "Ồ... là các bạn sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "Xin lỗi, trạng thái hôm nay của tôi... không tốt lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "Bạn bị bệnh rồi sao? Để chúng tôi đi tìm bác sĩ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "Không phải, chỉ là \"năng lượng\" của tôi đã hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "Năng lượng... không lẽ, Kokomi không phải là con người sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "Không, chỉ là một kiểu ví dụ mà thôi. Tuy có chút xấu hổ, nhưng tôi không thể luôn duy trì trạng thái tốt nhất được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "Vậy câu nói hôm qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "Bạn cũng để ý sao? Xem ra khả năng che giấu của tôi chưa thuần thục rồi, cần phải tập luyện thêm mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "Thực ra, tôi không phải là một người rất sở trường làm thứ gì đó. Ngày xưa, ước mơ của tôi chỉ là đọc binh thư, làm một người bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "Theo cách người ta nói, để ý đến cảm xúc người khác, quan sát sắc mặt, đánh giá hơn thua... tôi đều cảm thấy rất phiền phức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "Vừa để người khác cảm thấy thoải mái, vừa để người ta cảm thấy nể sợ, đó không phải là sở trường của tôi, hoặc cũng có thể nói đây không phải là điều mà tôi hướng tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "Nhưng do vấn đề huyết thống, cho nên vị trí \"Thánh Pháp Sư\" đã được truyền lại cho tôi, vui mừng cũng được, không vui cũng được, cũng đã không còn cách nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "Cho nên, khi tôi cảm thấy bản thân không chịu nổi nữa thì tôi sẽ đến đây để đọc sách thư giãn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "Đừng lo lắng, chuyện này sẽ không ảnh hưởng đến công việc đâu. Chuyện chuẩn bị tiệc ăn mừng tôi đã sắp xếp cho người khác làm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "Tối nay còn có một buổi diễn thuyết, không thể để các binh sĩ thấy được mặt xấu của tôi... Khó khăn lắm mới giành được hòa bình, hy vọng họ có thể buông lỏng bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220222,
					"content": "Chúng tôi có thể giúp được gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220223,
					"content": "Thực ra nếu như để mặc thì năng lượng của tôi cũng sẽ dần dần hồi phục. Nhưng nếu như có thể nghe được binh thư mà tôi có hứng thú thì tôi sẽ phấn chấn hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220224,
					"content": "Tôi nhớ lần trước có quyển sách đã đọc qua một nửa, không nhớ đã để đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220225,
					"content": "Để tôi tìm giúp cho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220226,
					"content": "Sau đó chúng tôi sẽ đọc cho Kokomi nghe, để bạn lấy lại tinh thần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220227,
					"content": "Thật sao? Cảm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220228,
					"content": "Haha... quả nhiên, thật tốt khi các bạn quay về đảo Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220213,
					"content": "Cảm thấy Kokomi đang rất phiền não.",
