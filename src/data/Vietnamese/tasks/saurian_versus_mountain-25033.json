			"dialogs": [
				{
					"id": 250330201,
					"content": "#{M#Anh}{F#Chị} giỏi quá! Leo núi nhanh như Mayta vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330202,
						250330203
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330202,
					"content": "Có vài sai sót...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				},
				{
					"id": 250330204,
					"content": "#Tốc độ leo núi này đã rất đỉnh rồi. Em và Qica đều không bằng {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330205
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330205,
					"content": "#Haiz, muốn đuổi kịp {F#chị}{M#anh}, chắc hẳn phải luyện tập rất lâu nữa nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330206
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330206,
					"content": "Grào... Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330207,
						250330208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330207,
					"content": "Cố lên, Qica!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330209,
					"content": "Grào?! Grừ, grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330210
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330210,
					"content": "Ngoan nào, Qica. Chú Yawar đã nói rồi, chỉ cần chúng ta cố gắng, nhất định sẽ trở nên tài giỏi hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330211
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330211,
					"content": "Grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330212,
					"content": "#Cảm ơn {M#anh}{F#chị} đã giúp đỡ, tặng {M#anh}{F#chị} mấy quả này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330213,
					"content": "Qica vừa mới hái được đó, động tác nhanh hơn trước nhiều lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330214,
					"content": "#Hì hì, tất cả là nhờ có {F#chị}{M#anh} làm mẫu cho Qica, Qica mới giỏi được như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330215
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330215,
					"content": "Grào, grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330216
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330216,
					"content": "Được rồi, chúng ta về bộ tộc tìm Mayta trước đã. Hừm... bây giờ chắc cậu ấy đang ở trong bộ tộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330208,
					"content": "Hai đứa nhất định sẽ làm được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330203,
					"content": "Chưa phải tốt nhất đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				}
			]
		},
