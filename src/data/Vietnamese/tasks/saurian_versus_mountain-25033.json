			"dialogs": [
				{
					"id": 250330101,
					"content": "Ngoan nào, hôm nay ăn no chưa? Có sức tập luyện không đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330102,
					"content": "Grừ, grừ, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330103,
					"content": "Ồ, hăng hái thế à? Tốt! Vậy thì hôm nay phải cố gắng hơn nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330104,
					"content": "Cùng cố gắng nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "#Ôi chào {M#anh}{F#chị}! Chúng em đang tập leo núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330107,
					"content": "Grào, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330108,
					"content": "Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330109,
					"content": "Tập luyện thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "Ừm... ít nhất có thể nói là \"có tiến bộ\". Lần này Qica leo cao hơn hẳn lần trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330111,
					"content": "Chỉ là lúc leo núi, động tác leo trèo của Qica không được thuần thục lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330116,
					"content": "#{M#Anh}{F#Chị} có thể làm mẫu lại cho bọn em một lần được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330117,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "#Cảm ơn {M#anh}{F#chị}! Lần này em nhất định sẽ nhìn rõ động tác của {M#anh}{F#chị}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330119,
					"content": "Qica, cậu cũng phải nhìn cho kỹ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330120,
					"content": "Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330123,
					"content": "#Vậy thì nhờ {F#chị}{M#anh} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330124,
					"content": "#Chúng em sẽ ở dưới đất nhìn theo {M#anh}{F#chị}, và tính thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330125,
					"content": "Grào... Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330121,
					"content": "#Lần này nhất định phải nhìn rõ động tác của {M#anh}{F#chị} đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "Đương nhiên rồi. Em và Qica sẽ mở to mắt nhìn kỹ, lần này nhất định sẽ nhìn rõ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330112,
					"content": "Xem ra đã hồi phục tốt rồi nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "Đương nhiên rồi. Mẹ em bảo em rất giỏi chăm sóc Qica mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330114,
					"content": "Qica tiến bộ nhiều lắm, leo lên cao hơn hẳn so với lần trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330115,
					"content": "Chỉ là lúc leo núi, động tác của Qica không được thuần thục lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlatem"
				}
			]
