			"dialogs": [
				{
					"id": 150250101,
					"content": "Hai vị chính là người được Trưởng Lão Tlapo lựa chọn phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "Anh là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250103,
					"content": "Tôi là người dẫn đường mà thủ lĩnh nhắc đến, cứ gọi tôi Toltec là được. Người đưa tin của thủ lĩnh đã nói rõ tình hình cho tôi rồi. Hãy đi theo tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
