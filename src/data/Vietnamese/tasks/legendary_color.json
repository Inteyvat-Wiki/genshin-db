					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "Nhìn xem, tấm vải dệt này là một trong những tác phẩm mà tổ tiên bộ tộc để lại. Thứ chúng tôi muốn hoàn thành chính là một tác phẩm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250702,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250703,
					"content": "Nhân vật trong tranh là shaman Huitzilin huyền thoại của bộ tộc chúng tôi. Bà ấy sống ở thời đại hơn hai trăm năm trước, từng là người được Đại Trưởng Lão Iktomisaur lựa chọn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250704,
					"content": "Bà ấy rất giỏi điều khiển bí thuật màu sắc, và đã hoàn thành sứ mệnh của mình một cách xuất sắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250705,
					"content": "Những tấm vải dệt trước mặt hai vị chính là ghi chép về sự tích của bà, và rất có thể là tác phẩm của chính tay bà ấy. Chất lượng của nó thật sự nổi bật so với những tấm cùng loại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250706,
					"content": "Nhưng rất tiếc, sau khi bà ấy qua đời, những người được chọn chỉ có thể gửi gắm hy vọng vào \"món quà của linh hồn\" mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250707,
					"content": "Giờ đây anh muốn khôi phục lại truyền thống cũ đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "Ừm. Nhưng có một điểm tôi muốn đính chính lại, là không phải chỉ có tôi, mà là \"chúng ta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250709,
					"content": "Chà! Đột nhiên có chút xúc động ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250710,
					"content": "Đưa mẫu thử nghiệm đến đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250711,
					"content": "Thành viên Chủ Nhân Gió Đêm mang mẫu vải thử nghiệm đến.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "#{NICKNAME}, tuy cách nhuộm khá phức tạp, nhưng tôi tin là {F#cô}{M#cậu} sẽ nắm bắt được. Chỉ cần nghiêm túc nghe theo hướng dẫn của tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250713,
					"content": "Không thành vấn đề, chúng ta bắt đầu nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "Trên mẫu vật đã có sẵn hoa văn, căn cứ theo đó để phân biệt các mảng màu. Thuốc nhuộm pha chế xong sẽ cần thời gian ngâm vào vải, hãy kiên nhẫn chờ đợi để tránh bị lẫn màu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250715,
					"content": "(Nhuộm màu theo hướng dẫn.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "Ừm, nhuộm khá tốt đấy, hoa văn cũng rất rõ ràng. Tiếp theo là dùng loại thuốc nhuộm đặc biệt còn lại. Chắc sẽ có thể tái hiện lại màu sắc đặc biệt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250717,
					"content": "Được thôi, bước cuối cùng nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250718,
					"content": "(Dùng hết số màu nhuộm còn lại.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "Hmm... Bây giờ xem như thành công rồi sao? Tôi chẳng nhìn ra gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250720,
					"content": "Màu sắc đó không được tái hiện... Lần nhuộm này thất bại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250721,
					"content": "Chẳng lẽ là do cách làm của tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "#Không. {F#Cô}{M#Cậu} rất giỏi, nắm bắt kỹ thuật nhuộm rất nhanh. Dù là tôi có đích thân làm thì cũng không có gì khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250723,
					"content": "Vậy chuyện này là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250724,
					"content": "Có thể là do kỹ thuật dệt, hoặc thuốc nhuộm phải được áp dụng theo một cách khác... Dù trường hợp nào đi nữa thì tôi cũng chưa giải được bí ẩn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250725,
					"content": "Xin lỗi, chúng tôi không giúp được gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250726,
					"content": "Người nên xin lỗi là tôi, để hai vị phải đi không công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Thủ Lĩnh Chủ Nhân Gió Đêm"
				},
				{
					"id": 150250727,
					"content": "Tôi vẫn sẽ trả phần thù lao như đã hứa trước đó, nhưng tôi cũng hy vọng hai vị sẽ không từ bỏ sứ mệnh này. Tôi sẽ tiếp tục điều tra, chỉ cần có manh mối mới thì tôi sẽ liên hệ với hai vị ngay.",
