					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250303
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250303,
					"content": "Theo bà ấy nói, những tác phẩm graffiti đó kể về câu chuyện của một vị anh hùng tên Kuntur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250304
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250304,
					"content": "À, xin lỗi, tôi rất thích nghệ thuật graffiti, nên vừa nãy hơi lạc đề chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250305
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250305,
					"content": "Anh không đi cùng chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250306,
					"content": "Không. Trước kia tôi từng thử vào sâu trong đó rồi, nhưng lại bị phong ấn chặn đường. Dù có mượn sức mạnh của Iktomisaur cũng không thể giải được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250307
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250307,
					"content": "Lệnh cấm đó có lẽ là thử thách của tổ tiên. Không thể vượt qua thì chứng tỏ là không có tư cách thưởng thức tác phẩm của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250308
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250308,
					"content": "Chậc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250309,
					"content": "Hai vị không cần lo cho tôi. Dù không phải chuyện này thì tôi cũng không thể đi theo hai vị vào trong được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250310
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250310,
					"content": "Tôi không có dũng khí để thách thức truyền thống như thủ lĩnh. Nếu như chỉ có người do Đại Trưởng Lão Iktomisaur chỉ định mới có thể hoàn thành sứ mệnh này, thì tôi đi theo sẽ hỏng việc đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250311
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250311,
					"content": "Được rồi... Vậy chúng tôi đi nhanh rồi quay về ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
