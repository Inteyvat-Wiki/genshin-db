			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Toltec"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "#{NICKNAME}, tôi nhớ trước đây chúng ta đã từng vào đó rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "Chúng ta là người được chọn mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "Điều kỳ lạ là, sau khi hoàn thành tác phẩm, những vị tổ tiên đó cũng không hề gỡ bỏ phong ấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Sau khi hang động này bị phong tỏa, chỉ có vị shaman tên Huitzilin của hai trăm năm trước mới vào lại được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "Theo bà ấy nói, những tác phẩm graffiti đó kể về câu chuyện của một vị anh hùng tên Kuntur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "À, xin lỗi, tôi rất thích nghệ thuật graffiti, nên vừa nãy hơi lạc đề chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "Anh không đi cùng chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "Không. Trước kia tôi từng thử vào sâu trong đó rồi, nhưng lại bị phong ấn chặn đường. Dù có mượn sức mạnh của Iktomisaur cũng không thể giải được nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "Lệnh cấm đó có lẽ là thử thách của tổ tiên. Không thể vượt qua thì chứng tỏ là không có tư cách thưởng thức tác phẩm của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Chậc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "Hai vị không cần lo cho tôi. Dù không phải chuyện này thì tôi cũng không thể đi theo hai vị vào trong được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "Tôi không có dũng khí để thách thức truyền thống như thủ lĩnh. Nếu như chỉ có người do Đại Trưởng Lão Iktomisaur chỉ định mới có thể hoàn thành sứ mệnh này, thì tôi đi theo sẽ hỏng việc đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "Được rồi... Vậy chúng tôi đi nhanh rồi quay về ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
