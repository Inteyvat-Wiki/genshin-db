			},
			"dialogs": [
				{
					"id": 223040201,
					"content": "Này bạn có lấy hàng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040202,
					"content": "Lấy Bản Đồ Kho Báu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040203
					]
				},
				{
					"id": 223040203,
					"content": "Bản đồ kho báu?...À, bạn đang nói về mấy thứ Zhangshun thế chấp ở chỗ tôi hả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040204,
					"content": "Ồ, bạn thật là muốn đi xem trong kho tàng là bảo bối gì hả? Tôi vẫn có quyền thu về chơi chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040205,
					"content": "Thoạt nhìn bạn chính là nhà mạo hiểm thực sự, nghe được hai chữ kho báu mắt đều phát sáng",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040206,
					"content": "Dù sao mấy tấm Bản Đồ Kho Báu này tôi giữ cũng vô dụng, cho bạn cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040207,
					"content": "Nếu bạn tìm thấy báu vật, chúng ta phải chia đều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040208,
					"content": "Dẫu sao Bản Đồ Kho Báu để ở chỗ tôi lâu như vậy, cũng nên trả một chút phí lưu trữ nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
