			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhangshun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223040101,
					"content": "Vậy phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040102
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040103
					]
				},
				{
					"id": 223040103,
					"content": "Trước đây tôi là thủy thủ của Nam Thập Tự, nhưng có lần không may, đã bị thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040104
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040104,
					"content": "Sau khi ra khỏi đội thuyền, vì kiếm tiền mưu sinh, tôi đem mấy tấm Bản Đồ Kho Báu đó thế chấp cho người buôn bán tên Bolai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040105
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040105,
					"content": "Nếu quả thực có kho báu, anh ta sẽ chia cho tôi một phần, nhưng trước giờ chưa có tin tức gì, tôi nghĩ anh ta vốn dĩ chưa đi tìm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040106
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040106,
					"content": "Cứ như thế này không phải là giải pháp, bạn có đồng ý giúp tôi đi tìm kho báu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040109,
						223040116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040107,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040108
					]
				},
				{
					"id": 223040108,
					"content": "Vậy phiền bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040120,
					"content": "Bạn hãy đến chỗ của <color=#00E1FFFF>Bolai</color> lấy <color=#00E1FFFF>Bản Đồ Kho Báu</color>, sau đó đem <color=#00E1FFFF>kho báu </color>mang trở về <color=#00E1FFFF>cho anh ta</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040121
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040121,
					"content": "Tôi đã nói với anh ấy rồi, anh ấy sẽ giữ lại phần của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040109,
					"content": "Tại sao lại ra khỏi đội thuyền?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040110
					]
				},
				{
					"id": 223040110,
					"content": "Tôi biết tình trạng của mình, vết thương cũ có thể tái phát bất cứ lúc nào, tôi không muốn làm gánh nặng cho đội thuyền, nên tự ra khỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040111
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040111,
					"content": "Sau đó, tôi dùng chút đồ vặt vãnh do chính tôi thu thập được trước kia, buôn bán nhỏ mưu sinh ở đây. Nhưng buôn bán cũng không dễ dàng, đồ cũng sắp bán hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040112
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040112,
					"content": "Ban đầu tôi còn vài tấm Bản Đồ Kho Báu, là chiến lợi phẩm trước đây cùng đội thuyền lấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040113
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040113,
					"content": "Nhưng cái thân tàn này của tôi, đến đi bộ còn vất vả, làm sao có sức thám hiểm chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040114
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040114,
					"content": "Tôi bèn đem mấy tấm Bản Đồ Kho Báu đó thế chấp cho kẻ gọi là Bolai, đổi lấy mấy đồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040115
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040115,
					"content": "Nhưng mà hắn có lẽ cũng không có cách nào tự mình đi tìm kho báu, dẫu sao cũng chỉ là 1 thương nhân... Cho nên, kho báu phải nhờ bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040116
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040116,
					"content": "Thật sự có kho báu sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040117
					]
				},
				{
					"id": 223040117,
					"content": "Ha ha ha, không thể nào, những tấm Bản Đồ Kho Báu này cũng là chiến lợi phẩm do đội thuyền phân phát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040118
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040118,
					"content": "Nếu như thật sự có kho báu, những thủy thủ giỏi trong đội thuyền đã sớm giải đáp các manh mối, đem kho báu về thuyền rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040119
					],
					"speakerTitle": "Zhangshun"
				},
				{
					"id": 223040119,
					"content": "Nhưng cho dù không phải là kho báu lớn, cũng đáng giá chút tiền, ít nhất cũng đủ chia cho ba người... vậy nên, chuyện kho báu nhờ cả vào bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "Zhangshun"
				}
			]
		},
