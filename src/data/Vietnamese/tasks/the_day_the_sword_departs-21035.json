			"dialogs": [
				{
					"id": 210350201,
					"content": "Phù... phù... Đúng là khó đối phó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350202,
					"content": "Xin lỗi, để bạn chê cười rồi. Không ngờ khi đối đầu thì tôi lại căng thẳng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350203,
					"content": "Tóm lại... Tôi vẫn phải tập luyện nhiều hơn. Cảm ơn Nhà Lữ Hành, đây là thù lao của bạn, hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350204,
					"content": "Anh thực sự phải rời khỏi Liyue sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "Tôi vẫn chưa quyết định, vẫn còn đang suy nghĩ, với tiện thể... thử thuyết phục sư muội lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		}
	]
