					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "Haiz, sư muội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350102,
					"content": "Ơ? Sun Yu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "Nhà Lữ Hành? Thật trùng hợp, không ngờ có thể gặp bạn ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350105,
					"content": "Tôi... đang tập luyện ở đây, một thời gian nữa tôi sẽ rời Liyue đi du lịch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350106,
					"content": "Sao đột nhiên lại phải rời khỏi Liyue vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "E hèm, nói ra thì xấu hổ. Lúc trước mặc dù tôi luôn nói muốn phục hưng phái Cổ Hoa, nhưng hoạt động thường ngày... nói là thăm tiên nhân, thật ra cũng chỉ là đi dạo quanh Tuyệt Vân Gián thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350109,
					"content": "Mặc dù sư muội không chê, nhưng trong thâm tâm tôi biết rất rõ, việc làm này không có ý nghĩa trong việc phục hưng phái Cổ Hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350110,
					"content": "Thời gian trước, khi tôi trở về thành tìm mua vật tư, tôi tình cờ trò chuyện với một thương nhân đến từ Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350111,
					"content": "Người đó nói với tôi là: \"Anh không thể tìm cách giải quyết vấn đề ngay tại nơi xảy ra vấn đề được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350112,
					"content": "Tôi đã suy nghĩ rất lâu... Có lẽ vị thương nhân người Fontaine đó đã gợi ý tôi đi du lịch đến những nơi khác ngoài Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350113,
					"content": "Đi xem thử cũng được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "Tôi cũng nghĩ vậy, nhưng... nhưng sư muội lại không chịu rời xa Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350116,
					"content": "Bình thường khi cô ấy nóng giận, tôi biết cô ấy chỉ đang đùa thôi, dỗ dành một chút là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350117,
					"content": "Nhưng lần này có vẻ như cô ấy thật sự tức giận, dù thế nào cũng không chịu nghe tôi nói, còn một mình chạy về thành nữa. Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350118,
					"content": "Không nói mấy chuyện này nữa, chuyện nhỏ nhặt nghe cũng chỉ làm bạn thêm khó chịu... Nhà Lữ Hành, tôi có thể nhờ bạn một chuyện không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350119,
					"content": "Mặc dù tôi biết một chút võ phòng thân, nhưng bình thường gần như không dùng tới. Sau này đi ra bên ngoài khó tránh khỏi va chạm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350120,
					"content": "Nhà Lữ Hành, tôi đã nghe nhiều câu chuyện về việc mạo hiểm của bạn ở bên ngoài, chắc chắn bạn biết không ít cách để đối phó với ma vật nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350121,
					"content": "Bạn có thể cùng tôi đi xung quanh tìm ma vật để luyện tay, tiện thể hướng dẫn thêm cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350122,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "Để tôi xem... Gần đây có một chỗ ma vật tụ tập, chúng ta đến đó trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350123,
					"content": "Hmm, chỉ sợ anh nhìn không rõ động tác của tôi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "Võ... võ nghệ của bạn cao cường vậy sao? Hahaha, vậy thì đành phải nhờ bạn thực hiện động tác chậm một chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350114,
					"content": "Xem như là giải khuây cũng được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "Không phải anh muốn phục hưng phái Cổ Hoa sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "Anh đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
