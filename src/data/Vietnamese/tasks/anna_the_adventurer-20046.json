			"dialogs": [
				{
					"id": 200460201,
					"content": "Đã hoàn thành! Cám ơn Nhà Lữ Hành, nhiệm vụ hộ tống lần này rất thuận lợi nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460202,
					"content": "Nhưng mà, những ủy thác Nhà Mạo Hiểm thường làm đều là những việc như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460203,
						200460205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460203,
					"content": "Sẽ có những ủy thác khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460204
					]
				},
				{
					"id": 200460204,
					"content": "Sao giọng điệu của bạn nghe bất lực vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460207,
					"content": "Vậy sao...được rồi! Vậy thì tôi sẽ tiếp tục cố gắng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460208,
					"content": "Đợi tôi kiếm đủ tiền, tôi sẽ đưa anh trai và bố mẹ cùng đi du lịch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460209,
					"content": "Anh trai tôi luôn muốn đi du lịch, nhưng...vì tôi bị bệnh, nên anh ấy buộc phải ở lại chăm sóc tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460210,
					"content": "Bây giờ tôi khỏi bệnh rồi, cũng đã trở thành nhà mạo hiểm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460211,
					"content": "Hì hì, đã đến lúc giúp anh trai tôi thực hiện ước mơ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460205,
					"content": "Từ từ cô sẽ biết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460206
					]
				},
				{
					"id": 200460206,
					"content": "Này, đừng có ủ rũ vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				}
			]
