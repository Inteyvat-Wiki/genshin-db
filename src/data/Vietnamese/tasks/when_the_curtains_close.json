					}
				]
			},
			"dialogs": [
				{
					"id": 401060101,
					"content": "Hai mươi năm trước, khi Giáo Viện vừa nhận được tài sản của Sachin. Giống như để ăn mừng cho quỹ đầu tư lớn này mà Đại Hội Học Viện năm đó được tổ chức rất long trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060102
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060102,
					"content": "Lúc đó tôi còn nhỏ, thấy được bảng quảng cáo của Học Viện Tranh Bá nên đã nói với cha chuyện này. Tôi còn nói là chiếc vương miện đó rất đẹp, rất đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060103
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060103,
					"content": "Cha hỏi tôi: \"Có muốn cha đoạt lấy quán quân và đưa vương miện cho con đội vài hôm không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060104
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060104,
					"content": "Tôi vui lắm, gật đầu không ngừng. Không ngờ năm đó cha không giành được quán quân, lại còn trông rất chán nản khi về đến nhà nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060105
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060105,
					"content": "Sau đó cha nói là muốn đến sa mạc để khảo sát, nhưng sau khi rời khỏi nhà không lâu thì gặp phải cát lún...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060106
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060106,
					"content": "...Trong nhiều năm qua tôi không thể đối diện với chuyện này. Nếu như năm đó tôi không nhiều chuyện thì tất cả những sự việc này sẽ không xảy ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		},
		{
			"id": 7352402,
			"completionStepIds": [
				7352403
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352403",
							"2"
						],
						"stepId": 7352403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060107,
					"content": "Cha anh năm đó có thể đã gặp Sachin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060108
					]
				},
				{
					"id": 401060108,
					"content": "Hả? Vậy người đi vào sa mạc hai mươi năm trước mà chúng ta điều tra không lẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401060109,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060110
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060110,
					"content": "Haha, cho nên Sachin khi thấy tôi mới cảm thấy tôi quen mặt đúng không? Thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060111
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060111,
					"content": "...Cha là một người quá đỗi hiền lành, nghe được lý luận của Sachin chắc hẳn rất đau lòng. Cho nên ông ấy mới đến sa mạc để tìm kiếm những người còn đang chịu khổ... Tôi có thể hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060112
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060113
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060113,
					"content": "Tôi từng tự nói với mình là có thể cha không phải vì không đoạt được quán quân mà chán nản. Nhưng mà... gốc rễ vấn đề vẫn là do tôi nhắc đến cuộc thi này mà ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060114
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060114,
					"content": "Kaveh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401060115,
					"content": "Đừng lo lắng. Tôi... tôi đã đập vỡ chiếc vương miện đó rồi. Từ nay về sau sẽ không xảy ra bi kịch như vậy nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		},
		{
			"id": 7352403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352403",
							"2"
						],
						"stepId": 7352403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060116,
					"content": "(Che giấu những gì mình điều tra trước đó.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060117
					]
				},
				{
					"id": 401060117,
					"content": "Xin lỗi, tôi vẫn còn đang suy nghĩ về chuyện của Học Viện Tranh Bá nên đã nói lạc đi đâu mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060118
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060118,
					"content": "Trông anh ủ rũ thật... có thật là ổn không đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401060119,
					"content": "Không sao. Đã là chuyện của quá khứ rồi, con người sẽ luôn hướng về tương lai mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		},
		{
			"id": 7352404,
			"completionStepIds": [
				7352406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352406",
							"2"
						],
						"stepId": 7352406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh",
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060201,
					"content": "Lúc tụ tập anh lại trốn đi đâu thế hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060202
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060202,
					"content": "Tôi nhớ hình như tôi đâu có nghĩa vụ phải báo cáo với anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060203,
					"content": "Chắc lại trốn đi đâu đó để đọc sách rồi đúng không? Anh lo mà sửa đổi tác phong của anh đi, con người không thể cứ dựa vào đọc sách mà sống đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060204
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060204,
					"content": "Dựa vào bữa ăn do anh mời chắc còn khó hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060205,
					"content": "Anh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060206
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060206,
					"content": "Hứ, cũng không khó đoán đâu. Anh đi điều tra Sachin đúng không? Nhìn những đoạn ghi chép đó là biết rồi. Nhưng tôi không nghĩ là nghiên cứu của Sachin sẽ làm anh thấy hứng thú đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060207
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060207,
					"content": "Cách làm của ông ta khiến người khác thấy khó chịu. Anh đấy... tôi đúng là rất ghét quan niệm của anh, nhưng anh và Sachin là hai kiểu người. Chủ nghĩa vị kỷ và chủ nghĩa hư vô không có điểm giao nhau nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060208
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060208,
					"content": "Bỏ qua sở thích cá nhân thì thí nghiệm với quy mô lớn và di sản của Sachin không hoàn toàn vô nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060209
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060209,
					"content": "Ngoài ra, cảm ơn vì đã khen. Nhưng tôi chỉ là đi ngang qua thôi, không có ý định đứng nghe anh nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060210
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060210,
					"content": "Bộ còn có chủ đề nào cao hơn cả việc thảo luận triết lý giữa các học giả sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060211
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060211,
					"content": "Theo như tôi biết thì Sachin mà anh thấy khó chịu có thể đã gặp qua cha anh vào hai mươi năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060212
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060212,
					"content": "...Anh nói sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060213
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060213,
					"content": "Không lẽ... Không, thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060214
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060214,
					"content": "Hừ, cho nên Sachin mới thấy tôi quen mặt đúng không. Chuyện cha tôi vào sa mạc thì ra là do bị ông ta ảnh hưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060215
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060215,
					"content": "Tôi e là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060216
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060216,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060217
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060217,
					"content": "Cũng may tôi đã đập vỡ chiếc vương miện đó. Sau này... có lẽ sẽ không còn những chuyện đau lòng như vậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060218
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060218,
					"content": "Giới hạn của tri thức luôn được mở rộng, trong tương lai chắc chắn sẽ có người nghiên cứu lại vấn đề này. Đối với Học Phái Vahumana mà nói thì đây là phương hướng nghiên cứu hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060219
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060219,
					"content": "Lại bắt đầu rồi đấy... Cho dù con người có rơi vào những cái bẫy trí tuệ khác nhau như anh nói đi nữa, thì sự việc cũng chưa chắc sẽ trở nên như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060220
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060220,
					"content": "Hơn nữa anh phải thừa nhận là hành vi của một cá nhân không phải lúc nào cũng dự đoán được hành vi của cả nhóm và ngược lại. Sachin là một ví dụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060221
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060221,
					"content": "Và anh, người đã ngăn ông ta cũng như thế. Loại xung đột này vốn rất đặc thù, rồi nó sẽ xảy ra một lần nữa trong tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060222
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060222,
					"content": "Cũng như anh nói đấy, \"một số cá thể\". Trong lòng anh cũng rất rõ là không phải mỗi một người đều sẽ đưa ra sự lựa chọn như anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060223
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060224
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060224,
					"content": "...Cho dù như vậy thì tôi cũng sẽ không từ bỏ quan điểm của mình. Đừng hòng thuyết phục tôi.",
