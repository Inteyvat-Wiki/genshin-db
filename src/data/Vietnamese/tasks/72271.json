			"dialogs": [
				{
					"id": 722710102,
					"content": "Tôi có kho báu cần bán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "Bạn lại tìm được đồ quý gì vậy? Đưa tôi xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710104,
					"content": "Kể chuyện Ngọc Long Cốt cho Linlang nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "Theo những gì bạn nói, đây chính là một cổ vật tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710106,
					"content": "Có điều tôi đã xem qua và không cảm thấy có gì đặc biệt, có lẽ phải sử dụng lâu dài mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710107,
					"content": "Theo tôi thấy, công dụng thần kỳ mà bạn nghe được có thể hơi phóng đại, hoặc...nói không chừng chỉ là lời bào chữa của kẻ thất bại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710108,
					"content": "Haha, bạn đừng quan tâm, tôi chỉ nói bừa thôi, bạn nghe thôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710122,
					"content": "Điều này rất thường thấy trong nghề kinh doanh đồ cổ của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710109,
					"content": "Ngoài ra, bạn dường như không giữ kín nó, và thoạt nhìn, có vẻ như bề mặt của nó đã bị hao mòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710110,
					"content": "Vậy thì giá của nó lại phải giảm đi một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710123,
					"content": "80.000 Mora thì thế nào? Ngoài ra, còn thêm 5 phần Phúc Lộc Tràn Đầy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710111,
					"content": "Tôi tin đây là một cái giá không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710112,
					"content": "Bạn sẽ làm gì với nó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "Thực ra, so với hiệu quả của nó, tôi nghĩ câu chuyện đằng sau nó đáng giá hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710114,
					"content": "Tôi đoán những người kể chuyện, những đoàn kịch, hoặc những quý tộc của Ngọc Kinh Đài sẽ hứng thú với nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710115,
					"content": "Ngay cả khi nó chỉ được trưng bày trên quầy của tiệm chúng tôi, thì cũng có thể được coi là một món đồ cổ quý hiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710116,
					"content": "Giá cả công bằng, chốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "Nhanh gọn thật, đây là Mora của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710118,
					"content": "Nếu sau này có bảo vật tương tự, cửa tiệm nhỏ của chúng tôi luôn hoan nghênh bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710119,
					"content": "Để tôi suy nghĩ thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "Ừm, đối với loại bảo vật quý hiếm này, so hàng các nơi...à không phải, so giá các nơi cũng đúng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710121,
					"content": "Nếu bạn suy nghĩ xong rồi thì quay lại đây tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
