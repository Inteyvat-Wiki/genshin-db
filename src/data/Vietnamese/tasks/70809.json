			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(Trong tổ chim có rất nhiều mảnh giấy rải rác, dường như còn có những nét chữ lộn xộn...)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "Những mảnh giấy này... chẳng lẽ chúng cố xé ra để làm tổ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090303,
					"content": "Trên đó hình như còn có chữ, hay là ghép lại xem viết gì nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090304,
					"content": "Mất công cả buổi cuối cùng vẫn phải tự ghép...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "#{NICKNAME} không tò mò sao? Nói không chừng là bản đồ kho báu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090306,
					"content": "Dưới sự thúc giục liên tục của Paimon, cuối cùng cũng ghép xong mảnh giấy...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "Để tôi xem nào... Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090308,
					"content": "Đây... Đây chẳng lẽ là... \"bản kế hoạch phạm tội\" sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090309,
					"content": "Kế hoạch phạm tội thì ai mà lại để bị chim tha đi chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "Nhưng... nhưng mà trong tiểu thuyết hay có tình tiết kiểu này mà! Kế hoạch hoàn hảo, nhưng lại gặp sơ hở ở chỗ không ai ngờ tới nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090313,
					"content": "Chúng ta đến quán rượu gần đây hỏi thăm xem sao nhé? Xem có ai nghe nói \"gần đây có người định phạm tội!\" gì đó không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090311,
					"content": "Thà tin có còn hơn là không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "Đúng... đúng vậy, cẩn thận vẫn hơn... nếu thật sự có người đang định phạm tội thì lúc đó hối hận cũng đã muộn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7080904,
			"completionStepIds": [
				7080907
