				"objectNames": [
					"Uchida Kotaro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "Đây... đây là... \"thủ đoạn gây án\" của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}! Anh ta thừa nhận luôn rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090403,
					"content": "À! Xin đừng hiểu lầm, đây là kế hoạch mà tôi định dùng trong tiểu thuyết tiếp theo, là thứ trước đây tôi nghĩ ra khi uống rượu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090404,
					"content": "Không ngờ khi tỉnh rượu thì tờ giấy này lại biến mất... Suýt nữa tôi đã tưởng mình đang nằm mơ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090405,
					"content": "#Dù sao cũng cảm ơn {F#cô}{M#cậu} đã giúp tôi tìm lại nó. Lần này tiểu thuyết của tôi chắc sẽ thuận lợi ra mắt, đến lúc đó tôi sẽ tặng {F#cô}{M#cậu} một cuốn trước! Có kèm cả chữ ký!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uchida Kotaro"
				}
			]
		},
		{
			"id": 7080905,
