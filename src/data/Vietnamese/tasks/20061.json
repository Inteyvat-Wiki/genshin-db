				},
				{
					"id": 200610502,
					"content": "Hừm! Bạn đã làm gì, đám bồ câu được dùng để gửi thư!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "Draff"
				},
				{
