			"dialogs": [
				{
					"id": 200610101,
					"content": "Về chim bồ câu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610102,
					"content": "Đám bồ câu này, biết thế nấu thành canh hầm cho rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610103,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "Tôi vốn nuôi một đàn bồ câu ở đây để đưa tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610105,
					"content": "Thế nhưng không biết tại sao, đàn bồ câu ngày càng không đáng tin rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610106,
					"content": "Không phải làm mất thư thì thời gian đưa thư cũng rất lâu, đứng im trên mặt đất, phải đợi người đuổi đi mới chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610111,
					"content": "Nếu như bạn có thời gian thì giúp tôi theo dõi đàn bồ câu mới được thả vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610107,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "Vậy nhờ cả vào bạn rồi, nếu như thấy đàn bồ câu làm biếng thì hãy theo sát chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610109,
					"content": "Sẽ bị đàn bồ câu ghét...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "Không sao, trí nhớ của bồ câu rất ngắn, chỉ một lát sau là chúng quên hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610112,
					"content": "Không nhận ra được, bạn lại thích bồ câu như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
