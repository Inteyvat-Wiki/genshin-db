						200610505
					]
				},
				{
					"id": 200610505,
					"content": "Chỉ xin lỗi thì có tác dụng gì, thế thì cần đến Đội Kỵ Sĩ Tây Phong làm gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610508,
					"content": "Làm sai thì phải chịu trừng phạt, bạn thay đàn bồ câu đi đưa thư đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610506,
					"content": "Đuổi đàn bồ câu thật là mất sức...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "Đuổi bồ câu? Bạn cầm thìa đi đuổi chúng sao!",
					"roleType": "TALK_ROLE_NPC",
