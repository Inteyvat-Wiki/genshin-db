					"nextDialogs": [
						205140203
					]
				},
				{
					"id": 205140203,
					"content": "Hả! Bạn lên đây bằng cách nào, sao chẳng có chút động tĩnh nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140204,
					"content": "Còn nữa, sao bạn tìm được tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140205,
					"content": "Tôi? Tôi bò lên đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140206,
					"content": "Anh trai đang tìm tôi? Í, trễ vậy rồi sao, tôi chẳng để ý gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140207,
					"content": "Tôi biết rồi, tôi về ngay, ở thêm một chút nữa thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
