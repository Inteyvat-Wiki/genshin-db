					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "Cô bé? Ồ, bạn nói Anna sao? Tôi có thấy, lúc nãy cô ấy đi về phía Cối Xay Gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140404,
					"content": "Tôi vẫn đang thắc mắc, không phải cô bé ấy không được khỏe sao, sao đột nhiên lại khỏe mạnh vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140405,
					"content": "Chào hỏi tôi xong là chạy đi ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140406,
					"content": "Con bé khỏi bệnh từ khi nào vậy... Bạn biết không?",
					"roleType": "TALK_ROLE_NPC",
