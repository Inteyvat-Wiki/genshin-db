					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140603
					]
				},
				{
					"id": 205140603,
					"content": "Cối Xay Gió?! Con bé này sao lại ở trên đó! Tôi phải đi...",
