				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "Gọi là gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "Là bạn sao, đến đúng lúc lắm... Từ khi uống thuốc của vị thần y đó, bệnh của Anna đã dần ổn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140104,
					"content": "Trước đây con bé không khỏe, cần phải tịnh dưỡng, phải ở trong nhà quá lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140105,
					"content": "Bây giờ con bé khỏe lại rồi, ngày nào cũng đòi ra ngoài chơi, tôi không từ chối được, nên đã đồng ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140106,
					"content": "Nhưng... bây giờ tôi không thể tìm được con bé. Rốt cuộc con bé đã đi đâu, bạn mau tìm giúp tôi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140107,
					"content": "Tôi, tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "Tôi đợi ở đây, bạn mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140109,
					"content": "Con bé này, sức khỏe vừa mới ổn đã đi lung tung, lỡ lại xảy ra chuyện gì thì biết làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140116,
					"content": "Tôi đã tìm rất lâu ở trong thành phố... chỉ còn chỗ Hiệp Hội Nhà Mạo Hiểm là chưa tìm, nhưng tôi thật sự không còn sức nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140117,
					"content": "Bạn đến Hiệp Hội Nhà Mạo Hiểm tìm trước xem sao. Còn nữa, nói không chừng ngài Cyrus sẽ chú ý đến gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140118,
					"content": "Hy vọng là tìm được, nếu không tôi vẫn sẽ tiếp tục tìm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140110,
					"content": "Hình như bạn rất vui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "Vui? Đừng, đừng đùa nữa, con bé đó vừa khỏe một chút, đã ham chơi như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140112,
					"content": "Con bé mà về, tôi sẽ cho biết tay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140113,
					"content": "Đói rồi sẽ về thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "Bạn tưởng em gái tôi là mèo sao... Hơn nữa con bé vừa khỏi bệnh, sao có thể đói được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140115,
					"content": "Được rồi được rồi, mau tìm giúp tôi đi, tôi sẽ ở đây đợi bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				}
			]
		},
