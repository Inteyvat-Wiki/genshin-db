						205140303
					]
				},
				{
					"id": 205140303,
					"content": "Cối Xay Gió?! Con bé lên đó bằng cách nào! Tôi phải đi tìm Kỵ Sĩ Tây Phong ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140304,
					"content": "Cô ấy nói lát nữa sẽ về...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "Vậy, vậy sao, không sao là tốt rồi, dọa chết tôi, tôi còn tưởng con bé bị kẹt trên Cối Xay Gió không xuống được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140306,
					"content": "Cám ơn bạn, tôi đi tìm con bé ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140307,
					"content": "Bệnh vừa khỏi đã đi lung tung, tôi phải dạy dỗ con bé một trận mới được...",
					"roleType": "TALK_ROLE_NPC",
