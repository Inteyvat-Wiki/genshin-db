			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280801,
					"content": "Không được, ta phải đi xem lại lần nữa. Ta là Arataki Duy Ngã Độc Tôn kia mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280802,
					"content": "Đại ca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280803,
					"content": "Hừ! Sao tự nhiên lại nghiêm túc thế chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280804,
					"content": "Nướng Dưa Tím đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280805,
					"content": "Hả? Đã xảy ra chuyện lớn như vậy mà ngươi còn kêu ta đi nướng Dưa Tím sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280806,
					"content": "Moo! Moo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280807,
					"content": "Nghe thấy chưa, cả Ushi cũng nói ngươi nói rất đúng kìa... Khoan đã, Ushi, ngươi đang giúp bên nào đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280808,
					"content": "Moo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280809,
					"content": "Chuyện hậu cần rất quan trọng đấy. Duy trì thể lực dồi dào và trạng thái tinh thần ổn định thì mới có thể đối phó với những điều chưa biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280810,
					"content": "Ushi cũng biết điều này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280811,
					"content": "Được rồi, này hai ngươi... đang chuẩn bị ăn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280812,
					"content": "Chờ đã, chín rồi sao? Cũng thơm đấy... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280813,
					"content": "Thôi được rồi, cứ ăn no trước rồi nghĩ cách sau. Này, đừng ăn hết Dưa Tím chứ, chừa hai quả cho ta với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 102702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
