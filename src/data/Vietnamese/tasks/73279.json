				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "Suỵt! Nhìn xem... bên đó có người...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790402,
					"content": "#Ồ... Chủ nhân của ta, những kẻ này... chính là \"Fangtui\" mà trước đây {F#cô}{M#cậu} nhắc đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790403,
					"content": "Là Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "Thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790405,
					"content": "Nhỏ tiếng thôi! Lỡ như bị phát hiện thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790406,
					"content": "Không sao, chúng không nghe được lời ta nói đâu. Không tin thì nhìn đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790407,
					"content": "Ê! Tên mập kia! Ta ở đây này! Ăn cơm thôi, ăn cơm thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790408,
					"content": "Này...? Có nghe thấy gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "Thành Viên Đội Tiên Phong Fatui 1"
				},
				{
					"id": 732790409,
					"content": "Không, sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "Thành Viên Đội Tiên Phong Fatui 2"
				},
				{
					"id": 732790410,
					"content": "Ừm... Tôi còn tưởng là đến giờ ăn rồi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "Thành Viên Đội Tiên Phong Fatui 1"
				},
				{
					"id": 732790411,
					"content": "Haha, thấy chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790412,
					"content": "Liloupar cũng biết trêu ghẹo sao... Hihi, dễ thương đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790413,
					"content": "Nhìn xem... Bên đó! Người mà chúng nhốt có phải là Tadhla không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790414,
					"content": "Hmm... Tôi nhớ là cô ấy... cao ráo, da ngăm đen, tóc dài màu nhạt... chắc là cô ấy rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790415,
					"content": "Trí nhớ khá đấy, nhóc con. Chúng ta động thủ thôi, chủ nhân của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790416,
					"content": "#Được, {NICKNAME}, chúng ta ra tay thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
