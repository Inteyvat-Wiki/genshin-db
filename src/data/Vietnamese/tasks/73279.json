			"dialogs": [
				{
					"id": 732790201,
					"content": "Thế nào, có tìm được con bé không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790202,
					"content": "À, vẫn cần thêm thời gian phải không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790203,
					"content": "Vậy xin hãy nhanh chóng cứu Tadhla nhé... thời gian không chờ đợi ai cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				}
			]
		},
		{
			"id": 7327904,
			"completionStepIds": [
				7327904
