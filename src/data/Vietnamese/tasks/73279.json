			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#A, {NICKNAME}, \"Chủ Nhân Trấn Linh\" cao quý đại giá quang lâm, làm tôi thật kinh ngạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "#Hay nhỉ, lại là một nô tài của sa mạc. Chủ nhân của ta... Haiz, thôi {F#cô}{M#cậu} chắc sẽ có phán đoán của mình, ta tin {F#cô}{M#cậu} đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790103,
					"content": "#Không biết {F#cô}{M#cậu} có thời gian ghé đến hay không... Tôi đã mong chờ {F#cô}{M#cậu} đến như chờ mong trăng sáng và sương đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "Nhiệt tình một cách vô cớ, ắt không có ý tốt, thôi thì ngươi cứ nói rõ ra đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790105,
					"content": "Tốt lắm, Trấn Linh đại nhân... Quả thực là tôi có việc cần nhờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "Haha, cũng không phải chuyện gì to tát... Chỉ là chim ưng của tôi, Tadhla... Chắc nó đã gặp nguy hiểm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "#Haiz... Nếu không phải do chân tôi yếu thì cũng không phải làm phiền đến {F#cô}{M#cậu} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "Tôi hiểu rồi, vậy là chúng tôi phải đi cứu chim ưng, sau đó anh sẽ cám ơn chúng tôi, và cho chúng tôi thật nhiều Mora, rồi chúng ta sẽ đi ăn mừng một bữa hoành tráng! Đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "Chậc... Đúng, đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "Nếu là vậy thì cứ giao cho chúng tôi là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "Những lúc thế này thì Paimon lại làm việc nhanh gọn ghê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "Haiz... Cứ vậy đi, để cho cái tên nhóc tham lam này được ăn một bữa ngon cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790113,
					"content": "#Vô cùng cảm ơn... Vậy việc này xin nhờ vào {F#cô}{M#cậu} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "#À, địa điểm xuất hiện cuối cùng của chim ưng là ở đây, để tôi đánh dấu cho {F#cô}{M#cậu}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "Người tôi cần tìm là chim ưng Tadhla... Con bé khá cao, nước da ngăm đen, để mái tóc dài màu nhạt, tay cầm cung dài... Ừm, những thông tin này chắc là đủ rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "Thế nào, mọi người đã nhớ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "Ừm, cô gái cao ráo, nước da ngăm, tóc dài màu nhạt, cầm cung dài! Hihi, tôi nhớ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "#Ừm... Nguyện cơn gió sẽ dẫn đường cho {F#cô}{M#cậu} xuyên qua sa mạc, tránh được muôn trùng hiểm nguy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "Được rồi, chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
