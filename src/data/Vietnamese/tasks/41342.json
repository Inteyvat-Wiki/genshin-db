			"dialogs": [
				{
					"id": 413420401,
					"content": "Ừm? Nhà Lữ Hành, bạn tìm tôi có việc gì ư? Bây giờ tôi đang bận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420402
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420402,
					"content": "Về chuyện Đèn Tiêu của Siyu tặng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4134205,
			"completionStepIds": [
				4134205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
