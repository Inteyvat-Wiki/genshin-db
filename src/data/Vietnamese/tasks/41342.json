					"Li Cầm Búa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "Đèn Tiêu đó là Siyu tặng cho anh ấy, đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420603,
					"content": "Ban nãy bạn nghe thấy rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "Chút chuyện cỏn con như vậy, tôi chẳng cần đoán cũng biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420606,
					"content": "Năm ngoái anh ấy cũng như vậy, sau khi ra ngoài một chuyến trở về là một mình ngây ra cạnh thuyền gõ gõ cái đinh cả buổi tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420607,
					"content": "Tôi biết tại sao anh ấy làm như vậy, nhưng, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420608,
					"content": "Nhà Lữ Hành, có thể phiền bạn đi giúp anh ấy một chút không? Ngày lễ tết mà cứ làm khổ mình như vậy cũng không ổn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420609,
					"content": "Được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "Haiz... phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420611,
					"content": "Chắc là lúc này anh ấy đã lên thuyền làm việc rồi... Bạn mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420612,
					"content": "Lát nữa tôi đi mua chút đồ ăn, sau khi các bạn xong việc thì qua đây nhé, chúng ta cùng ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420604,
					"content": "Sao bạn biết?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				}
			]
		},
