			"dialogs": [
				{
					"id": 413420901,
					"content": "Chờ lâu rồi nhỉ, tôi sắp xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420902,
					"content": "Sao, đã làm xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420903,
					"content": "Xong rồi, chút chuyện cỏn con, lại có thêm Nhà Lữ Hành giúp đỡ, giải quyết rất nhẹ nhàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420904,
					"content": "Cái anh này... Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420905,
					"content": "Được rồi được rồi, ngày lễ ngày tết, đừng bày ra bộ mặt đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420906,
					"content": "Được, bạn nói thế nào thì là thế ấy, Đèn Tiêu bạn đã chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420907,
					"content": "Đèn Tiêu... ui da! Tôi quên mất rồi, đầu óc của tôi thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420908,
					"content": "Không sao không sao, chỉ là cái Đèn Tiêu thôi mà, không thả nữa cũng không sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420909,
					"content": "Bạn đừng nói vậy, ngày lễ tết không thả Đèn Tiêu còn ra thể thống gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420910,
					"content": "Nhà Lữ Hành, có thể phiền bạn giúp người anh em này của tôi kiếm chiếc Đèn Tiêu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "Li Cầm Búa"
				},
				{
					"id": 413420911,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "Cảm ơn, chúng tôi chờ bạn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Cầm Búa"
				}
			]
		},
