			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Banzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "Siyu? Là... Đèn Tiêu cô ấy tặng tôi? Tôi... tôi xem xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420502,
					"content": "Ha ha ha, điều ước này là cô ấy viết giúp tôi, hồi nhỏ tôi đúng là muốn thực hiện ước nguyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420503,
					"content": "Chớp mắt đã bao nhiêu năm trôi qua rồi, thời gian trôi thật là nhanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420504,
					"content": "Nhưng, tại sao cô ấy lại bảo bạn mang chiếc Đèn Tiêu này qua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420505,
					"content": "Cô ấy còn đang bận việc nhà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "Vậy sao, ra là vậy... cũng tốt, cũng tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420508,
					"content": "Cuộc sống hiện giờ của Siyu có lẽ đang rất ổn, vậy là tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420509,
					"content": "À... xin thứ lỗi... tôi còn có chút việc phải làm, đi trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413420506,
					"content": "Cô ấy nói phải về nhà giúp chồng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
		{
