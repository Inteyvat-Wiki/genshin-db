			"trigger": {
				"objectNames": [
					"Siyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "Quả nhiên, vẫn cứ giao Đèn Tiêu tới nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420102,
					"content": "Tặng Đèn Tiêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "Là Nhà Lữ Hành à, là thế này. Từ nhỏ anh Banzi đã luôn chăm sóc tôi, bình thường cũng giúp đỡ tôi rất nhiều, anh ấy giống như anh trai ruột của tôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420104,
					"content": "Nhưng ngày lễ tết mà hình như anh ấy vẫn đang làm việc không ngừng nghỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420105,
					"content": "Tôi muốn tặng cho anh ấy một chiếc Đèn Tiêu, hi hi, hai chúng tôi là bạn thanh mai trúc mã, thuở nhỏ anh ấy thích nhất là ngắm Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420106,
					"content": "Nếu bây giờ đem một chiếc Đèn Tiêu qua đó, chắc chắn anh ấy sẽ rất vui. Nhà Lữ Hành, có thể phiền bạn giúp tôi mang Đèn Tiêu tặng cho anh ấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420107,
					"content": "Bạn không tự mang đi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "Tôi cũng muốn tự đi tặng, nhưng trong nhà còn có rất nhiều việc phải làm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420110,
					"content": "Bây giờ tôi ra ngoài mua đồ, việc trong nhà đều do một mình ông xã tôi lo liệu, tôi phải mau chóng trở về giúp đỡ anh ấy mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420111,
					"content": "Cho nên chuyện Đèn Tiêu phiền bạn rồi, lát nữa rảnh rỗi tôi sẽ cùng ông xã đi thăm anh Banzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420112,
					"content": "Mong là lúc đó anh Banzi cũng có chút thời gian rảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420108,
					"content": "Bạn tự đi sẽ tốt hơn một chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
			"id": 4134202,
			"completionStepIds": [
				4134202
