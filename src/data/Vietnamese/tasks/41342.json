			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "Ừm, như vậy là được rồi, cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413421203,
					"content": "Còn có chút việc vặt... có thể phiền bạn giúp tôi đến bến cảng kiểm tra vật tư mới đến một chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413421204,
					"content": "Chắc là 3 thùng, đã xếp ở bến cảng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Wang Banzi"
				},
				{
					"id": 413421205,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "Vậy thì phiền bạn rồi, tôi phải nhanh chóng làm xong việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Banzi"
				}
			]
		},
