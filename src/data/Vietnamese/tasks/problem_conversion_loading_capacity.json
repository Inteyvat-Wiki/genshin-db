			"dialogs": [
				{
					"id": 230210801,
					"content": "Tuyệt quá, rất thành công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "Kết cấu thân thuyền không có vấn đề gì... Mực nước cũng rất ổn định, không bị nghiêng đổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "Qishan, nhìn này, thiết kế và tính toán của tôi thật hoàn hảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "Đây mới là giai đoạn đầu tiên của thí nghiệm tải trọng thôi, đừng vui mừng quá sớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210805,
					"content": "Hơn nữa anh vẫn chưa tính đến vấn đề thời tiết và trọng tâm của thân tàu lúc hàng hóa dịch chuyển...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210806,
					"content": "Ừm... Ừm, tôi sẽ xem xét vấn đề này, cô cứ để tôi vui chút đi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "Phải rồi Nhà Lữ Hành, đây là thù lao của bạn, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Qishan à, cô không thể động viên tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
					"content": "Nhưng trong chuyện đóng thuyền thì động viên người khác cũng chẳng có tác dụng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210810,
					"content": "Tốt hơn là anh nên nghĩ xem làm sao để động viên ví tiền của mình đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
