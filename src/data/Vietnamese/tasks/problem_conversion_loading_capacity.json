			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "Nhà Lữ Hành! Bạn tới đúng lúc lắm, thuyền vừa hạ thủy, rất ổn định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210102,
					"content": "Quả nhiên tính toán của tôi không có vấn đề gì hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210103,
					"content": "Vậy thì thí nghiệm tải trọng khi nào mới bắt đầu đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210104,
					"content": "Đừng gấp, Nhà Lữ Hành đã tới rồi, chúng ta sắp bắt đầu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210105,
					"content": "Thí nghiệm tải trọng là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "Nói một cách dễ hiểu thì đó là dùng vật nặng để thử khả năng chịu tải của thuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210107,
					"content": "Ừm... Cũng có nghĩa là cần có người đi cùng tôi để chuyển vật nặng lên thuyền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210108,
					"content": "Nhà Lữ Hành, lần trước tôi thấy cơ thể bạn khỏe mạnh, sức lực dồi dào, rất giỏi trong mấy việc này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210109,
					"content": "Thì ra đây mới là lý do gọi tôi tới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "Không, không đâu, một mình tôi thật sự không thể giải quyết việc này, chỉ có thể nhờ bạn giúp đỡ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210112,
					"content": "Hơn nữa thù lao chắc chắn không ít! Yên tâm đi, mấy hôm trước tôi vừa giúp người ta sửa một con thuyền lớn, kiếm được rất nhiều tiền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210113,
					"content": "Ồ... Rất nhiều tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210114,
					"content": "Ơ? Chuyện đó, tôi gần như dồn hết tiền vào việc đóng thuyền rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210115,
					"content": "Toàn bộ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210116,
					"content": "Vẫn còn một ít! Haiz, tôi sẽ mời bạn uống cà phê nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210117,
					"content": "Nhà Lữ Hành, chúng ta mau bắt đầu thôi, mau lên nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210110,
					"content": "Giận đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
