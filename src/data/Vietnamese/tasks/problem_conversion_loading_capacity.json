				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "Được... Rồi! Ổn rồi, để xem sẽ xảy ra chuyện gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210601,
					"content": "Ôi! Bên kia bị rỉ nước kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210615,
					"content": "Cái gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210602,
					"content": "Thuyền, thuyền nghiêng rồi! Sao lại thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210603,
					"content": "Mau, mau chuyển hết đồ xuống, chắc chắn là có vấn đề rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210604,
					"content": "Nhanh chóng cùng Rafiq chuyển hết đồ nặng xuống thuyền...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "Phù... phù... Cũng may không nhiều đồ lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210606,
					"content": "Rốt cuộc... đã xảy ra vấn đề ở chỗ nào nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210607,
					"content": "Lúc trước tôi đã nói thế nào? Những số liệu mà anh tính quá lý tưởng, như vậy không đáng tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210608,
					"content": "Híc... tôi... tôi... được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210609,
					"content": "Không thể như vậy được, tôi đã tính chính xác đến như vậy rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210610,
					"content": "Nhà Lữ Hành, cảm ơn bạn đã giúp. Đây là thù lao, xin bạn hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210611,
					"content": "Tôi muốn quay về tính toán lại... Qishan, có thể giúp tôi một chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210612,
					"content": "...Nói cứ như tôi chẳng giúp gì ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210613,
					"content": "Cứ giao cho tôi, sau khi tính xong nhớ mời tôi ly cà phê là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
