			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "Nhà Lữ Hành! À không, đứa con của tài lộc, người mang đến may mắn! cháu đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030202,
					"content": "Lần trước ăn \"Món Ăn Vàng\" do cháu chuẩn bị, quả nhiên ta đã thắng lớn trong sở giao dịch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030203,
					"content": "Dù mua Hàng Mong Chờ nào thì hôm nay chỉ cần lướt mắt qua thôi cũng đã thấy lãi to rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030204,
					"content": "Đi thôi, đến Quán Rượu Lambad, cứ gọi món thoải mái, hôm nay ta mời, ta phải cảm ơn các cháu thật tốt mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "May mà có sự giúp đỡ của các cháu, hôm nay muốn ăn gì cứ thoải mái gọi! Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030402,
					"content": "Xem ra ông đã kiếm được rất nhiều tiền nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030403,
					"content": "Đối với người bình thường mà nói thì cũng chỉ xem là tạm được, so với tài sản của Hatim ta thì cũng chẳng thấm vào đâu cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030404,
					"content": "Dù sao ta cũng là một chuyên gia mấy chục năm mà. Nếu các cháu có hứng thú với Hàng Mong Chờ thì ta có thể chia sẻ cho các cháu vài điều tâm đắc của riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030405,
					"content": "Như lần trước đã hứa, sẽ có lợi ích thêm vào cho cháu, các cháu đừng khách sáo với ta nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030406,
					"content": "Thì ra lợi ích là cái này sao, cảm giác cũng chẳng khác gì mấy so với không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030407,
					"content": "Dù sao chúng ta cũng không quan tâm Hàng Mong Chờ mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "Sao lại nói thế, Mora đương nhiên không thể thiếu phần của các cháu rồi, nhưng so với điều đó thì những lời chỉ dẫn từ Hatim ta đây mới thực sự là thứ đáng giá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030409,
					"content": "Vậy cháu có một câu hỏi... Thật sự sẽ có Hàng Mong Chờ là Slime à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030410,
					"content": "Không phải cháu muốn kiếm tiền! Chỉ là muốn hỏi một câu thế thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030411,
					"content": "Chỉ những hàng hóa đang lưu thông mới trở thành Hàng Mong Chờ, cũng có nghĩa là, nếu Dịch Slime trên thị trường nhiều như bột mì, nhiều như sữa tươi thì mới có thể trở thành Hàng Mong Chờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030412,
					"content": "Giống như những gì ta đã nói trước đây, nếu Dịch Slime trở thành Hàng Mong Chờ thì e rằng Slime ngoài tự nhiên đều bị bắt sạch mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030413,
					"content": "Hơn nữa, nói không chừng sẽ có các cá nhân hoặc tổ chức chuyên nuôi dưỡng Slime, duy trì sản xuất Dịch Slime liên tục với số lượng lớn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030414,
					"content": "Đến lúc đó, giá cả của Dịch Slime có lẽ cũng sẽ tăng theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030415,
					"content": "Ồ! Chẳng qua chỉ là mua một ít Dịch Slime thôi mà, sao lại phức tạp như thế chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030416,
					"content": "#Tốt hơn hết là cứ để {NICKNAME} tiêu diệt Slime trực tiếp thì hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030417,
					"content": "Đứa con của tài lộc, còn cháu, cháu có muốn hỏi gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030418,
					"content": "Ông làm thế nào để nghiên cứu ra \"Món Ăn Vàng\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "Haha! Quả nhiên không hổ danh là đứa con của tài lộc, một phát đã hỏi ngay đến chìa khóa để làm giàu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030420,
					"content": "Không thể nói là \"nghiên cứu\" ra, chỉ có thể nói là... những \"Món Ăn Vàng\" này đều do ta \"đúc kết\" lại trong sự nghiệp giao dịch Hàng Mong Chờ của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030421,
					"content": "Tuy rằng thị trường giao dịch Hàng Mong Chờ rất nhiều sóng gió... Nhưng chỉ cần có \"Món Ăn Vàng\" thì ta nhất định sẽ nắm chắc được bánh lái của con tàu đầu tư!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030422,
					"content": "Quả nhiên là chẳng có căn cứ nào cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "Đừng nói nữa, nào! Ăn đi ăn đi! Ăn nhiều một chút, ăn nhiều một chút, sau này ta còn phải nhờ cháu giúp nhiều hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030425,
					"content": "Nào! Thử món Cuốn Shawarma này đi, là đặc sản của Sumeru đấy, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030426,
					"content": "Thưởng thức món ngon cùng Hatim...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "Vậy đây chỉ là \"giải pháp tâm lý\" rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "Đây rõ ràng là \"Món Ăn Vàng\" ăn tại \"Vùng Đất Giàu Có\" kia mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030702,
					"content": "Tại sao lại rớt giá thế này... Thật vô lý! Trên thị trường này vẫn còn có quy luật nào khác sao, công bằng ở đâu chứ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030703,
					"content": "Hatim, chúng cháu đã tìm ông rất lâu đấy, ông không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030704,
					"content": "Là các cháu à... Ta... không sao cả, ta vẫn ổn... Các cháu nhìn này, tay chân ta vẫn lành lặn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030705,
					"content": "Chẳng qua chỉ là mất đi chút tiền cọc mà thôi... Khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030706,
					"content": "Xin, xin lỗi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "Không! Đây không phải là vấn đề của cháu, không cần để trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030708,
					"content": "Tất nhiên, đây chắc chắn cũng không phải là vấn đề của ta, chỉ trách thị trường này đã quá nát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030709,
					"content": "Không lý nào! Chẳng có quy tắc gì cả! Nói rớt là rớt, nói tăng là... nó cũng chẳng thèm tăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030710,
					"content": "Đúng là... haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030711,
					"content": "Thôi bỏ đi, tốt hơn hết là ta không nên tin nữa... Phú ông Hatim siêu phàm của Kalimi không thể chinh phục được Hàng Mong Chờ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030712,
					"content": "Ông đã lỗ sạch rồi sao...",
