					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "Ừm... trông giống như bia mộ của Người Giữ Đèn. Chẳng lẽ là của những Ratnik mà chúng ta đã thấy trong hẻm núi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650102,
					"content": "Họ chập chờn lúc ẩn lúc hiện, bất chợt xuất hiện rồi lại biến mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650103,
					"content": "Ừm, thật sự không hiểu nổi. Lần sau chúng ta đến Thành Piramida hỏi thử nhé! Biết đâu ở đó có người biết chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patolichev"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "#Ồ, xin chào, tôi là Patolichev, nhân viên phụ trách vật tư của Người Giữ Đèn. {F#Cô}{M#Cậu} cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650202,
					"content": "Patolichev của \"Ngựa Gió Lạnh\" phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "\"Ngựa Gió Lạnh\"... A, chính là những cái bóng kỳ lạ mà chúng ta thấy lúc trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650204,
					"content": "#Đúng vậy, đó là đội của tôi trước đây. \"Ngựa Gió Lạnh\", cái tên thật khiến người ta hoài niệm, không ngờ lại được nghe từ miệng của {F#cô}{M#cậu}... Sao {F#cô}{M#cậu}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650205,
					"content": "Chúng tôi đã từng đến dưới chân Vách Đá Kipumaki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "Đúng rồi đúng rồi, chúng tôi đã xử lý Cuộc Săn Hoang Dã xuất hiện ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650207,
					"content": "Với lại chúng tôi còn thấy bóng dáng các Ratnik của \"Ngựa Gió Lạnh\" sót lại sau trận chiến với Cuộc Săn Hoang Dã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650210,
					"content": "Không ngờ lại là thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650211,
					"content": "Đương nhiên là thật rồi, chính mắt tôi nhìn thấy mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650212,
					"content": "À... Mấy năm qua, thỉnh thoảng có người nói với tôi rằng họ nhìn thấy bóng dáng những đồng đội đã hy sinh của tôi ở Vách Đá Kipumaki. Nên cho đến giờ, tôi vẫn thường đến đó... tiện thể dọn mộ cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650213,
					"content": "Nhưng tôi chưa từng... chưa từng thấy họ dù chỉ một lần. Đã lâu lắm rồi, tôi cứ nghĩ đó chỉ là những lời nói dối để an ủi tôi mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650214,
					"content": "Không ngờ hai người thật sự nhìn thấy họ... Nhưng sao khi tôi đến, họ lại không chịu ra gặp tôi vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650215,
					"content": "Có lẽ là chưa đến lúc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "Có lẽ vậy... Nhưng tôi biết họ thực sự đang ở đó, dù chỉ là một chút ký ức, một thoáng hư ảnh, thế là đã đủ với tôi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650219,
					"content": "#Dù sao thì, cảm ơn {M#cậu}{F#cô} rất nhiều, cảm ơn vì đã kể cho tôi nghe, điều này thực sự rất quan trọng đối với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650220,
					"content": "Nhờ họ mà tôi mới có thể đứng ở đây, nhưng tôi rất mong được cùng họ sát cánh chiến đấu dưới chân Vách Đá Kipumaki một lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650221,
					"content": "...Rồi sẽ có ngày, chắc chắn sẽ có ngày tôi gặp lại họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650217,
					"content": "Có lẽ là không muốn anh nhớ lại những nỗi đau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "Haiz... Khoảng thời gian cùng họ sát cánh chiến đấu đến những giây phút cuối cùng, sao có thể là nỗi đau được chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650208,
					"content": "Chúng tôi đã thấy các Ratnik của \"Ngựa Gió Lạnh\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "Đúng vậy, dù họ chỉ để lại vài cái bóng... nhưng vẫn còn nguyên dáng vẻ khi chiến đấu với Cuộc Săn Hoang Dã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}