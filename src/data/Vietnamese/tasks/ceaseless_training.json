			"dialogs": [
				{
					"id": 220310301,
					"content": "Ban nãy bạn phân tâm sao? Di chuyển lúng túng, lực tấn công thì quá yếu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310302,
					"content": "Như vậy không được, bạn hãy chuẩn bị lại rồi chúng ta tiếp tục nhé...",
					"roleType": "TALK_ROLE_NPC",
