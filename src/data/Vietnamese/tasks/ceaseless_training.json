			"dialogs": [
				{
					"id": 220310401,
					"content": "Phù phù...võ nghệ của các hạ đúng là vượt xa tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310402,
					"content": "Lần sau tôi sẽ nhẹ tay hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "Không! Các hạ phải dốc toàn lực mới được, như vậy thì tôi mới mạnh mẽ hơn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310404,
					"content": "Sở dĩ bạn mạnh mẽ như vậy, cũng là do đã trải qua vô số lần tập luyện đúng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310405,
					"content": "Thứ lỗi cho sự hiếu kỳ của tôi, bạn...tự tập luyện như thế nào vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310406,
					"content": "Tôi thường xuyên tập luyện với một con rồng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "Rồng mà bạn cũng lấy ra để tập luyện sao, thật không ngờ đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310410,
					"content": "Chỉ là...qua loa mà thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "Ha ha, vậy sao? Vậy chắc bạn là một nhân tài hiếm có rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310412,
					"content": "Cảm ơn đã luyện tập cùng tôi, tôi sẽ luôn ghi nhớ trong lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310408,
					"content": "Tôi thường xuyên tập luyện với một con sói lớn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "Nghe hoành tráng nhỉ. Tôi cũng muốn thử sức với nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				}
			]
