			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "Hây a!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310102,
					"content": "Để tôi luyện tập với bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "Ấy! Là các hạ sao, các hạ lại nhận ủy thác của tôi sao? Rất cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310104,
					"content": "Có người võ nghệ cao như bạn đồng ý tập luyện chung với tôi thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310105,
					"content": "Thương pháp tiến bộ hơn lúc trước rồi đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "Ha ha...đừng tâng bốc tôi thế chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310107,
					"content": "Tôi nghe nói, một trong những mục đích mà thương được phát minh, chính là để dành cho những người không thông thạo võ nghệ như tôi sử dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310108,
					"content": "Dẫu sao thì loại vũ khí này vừa dài vừa nhọn, cho dù không biết thương thuật đi nữa, cầm lấy đâm đâm múa múa cũng rất có khí thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310109,
					"content": "Nhưng mà, theo nguyên tắc này, tôi cảm thấy loại thương có ba mũi nhọn sẽ có uy lực hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310110,
					"content": "Bạn đã đoạt lại được vũ khí chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "Vũ khí tuy đã đoạt lại được, nhưng không nói lên quá trình luyện tập sẽ kết thúc tại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310112,
					"content": "Lần này chỉ là gặp đám Kairagi, không chừng sau này sẽ còn gặp những kẻ địch mạnh mẽ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310113,
					"content": "Tôi sẽ không để cho vũ khí của mình lại rơi vào tay kẻ địch nữa đâu, không thể để vinh quang của một võ sĩ bị chà đạp, đây chính là đạo của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
