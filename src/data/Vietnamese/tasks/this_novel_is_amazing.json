				{
					"id": 223020201,
					"content": "Phía trước chính là <color=#00E1FFFF>Thương Hội Phi Vân</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020202,
					"content": "Đưa sách cho <color=#00E1FFFF>người đứng ở cửa</color>, chắc là xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020203,
					"content": "Nhưng...thật là muốn biết...cuốn tiểu thuyết này viết gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020204,
					"content": "Sao cơ? Muốn xem cuốn tiểu thuyết này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
