			"dialogs": [
				{
					"id": 223020101,
					"content": "Lần này nhất định thành công...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020102,
					"content": "Thành công gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "Bạn biết thành Inazuma thường tổ chức cuộc thi kể chuyện không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020104,
					"content": "Dường như là nói... \"Quyển tiểu thuyết này thật lợi hại!\", còn được xuất bản bởi nhà xuất bản Yae nổi tiếng khắp thành Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020105,
					"content": "Để tham gia cuộc thi này, tôi đã chuẩn bị rất lâu rồi, còn xem rất nhiều tiểu thuyết mà người Inazuma yêu thích để tham khảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020106,
					"content": "Lại kết hợp thêm những cuốn sách đã được đọc từ lâu... kết hợp văn hóa của Liyue và Inazuma, tôi viết thành cuốn tiểu thuyết này, nhất định sẽ giành được giải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020107,
					"content": "Tôi đã hẹn với Thương Hội Phi Vân, họ giúp tôi đem tiểu thuyết gửi đi tham gia, nhưng người lấy sách mãi không đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020108,
					"content": "Nếu bạn có thời gian, có thể giúp tôi đem bản thảo đến <color=#00E1FFFF>Thương Hội Phi Vân</color> được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020109,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "Vậy thì nhờ bạn rồi, lần này ắt sẽ được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020111,
					"content": "Đề tài của tiểu thuyết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "Không được tiết lộ, đây là tác phẩm quan trọng tham gia thi đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 223020113,
					"content": "Chỉ cần thành công, mọi thứ sẽ trở nên tốt đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thường Cửu Gia"
				}
			]
		},
