			"dialogs": [
				{
					"id": 223020301,
					"content": "Thiếu gia đi đâu mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020302,
					"content": "Về sách của Thường Cửu Gia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "Hả? Anh ấy... vẫn còn đang viết sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020304,
					"content": "Ồ đúng vậy, lần trước anh ấy nói sẽ viết một cuốn tiểu thuyết đi tham dự kỳ thi ở Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020305,
					"content": "Lần này lại nói gì vậy? Lần trước anh ta cũng đã viết sách về Thất Tinh, một mực muốn chúng ta giúp anh ta xuất bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020306,
					"content": "Cuốn sách vẫn chưa kịp xuất bản, mà suýt chút nữa gọi cả Thiên Nham Quân đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020307,
					"content": "Có điều, lần này là đi tham gia kỳ thi ở Inazuma, có đến cũng khó mà đuổi kịp được chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020308,
					"content": "Bạn đưa sách cho tôi, tôi nhờ thương hội đi bằng thuyền gửi đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020309,
					"content": "Có điều, Thường Cửu Gia xem ra lần này cũng không có hy vọng, tôi nghe nói Inazuma thời gian gần đây đang thịnh hành cuốn sách tên là \"Trầm Thu Thập Kiếm Lục\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020310,
					"content": "Là người Liyue chúng ta viết, chỉ không biết là ai..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020311,
					"content": "Đúng rồi, bạn vất vả mang sách đến đây, ban đầu Thường Cửu Gia để chúng tôi đến lấy, cũng trả tiền rồi. Nếu bạn đã mang đến đây rồi, chỗ này cho bạn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				}
			]
		},
