			"dialogs": [
				{
					"id": 409110301,
					"content": "Bạn đến rồi sao, đây chính là <color=#00E1FFFF>Lò Luyện Nguyên Tố</color> của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110302,
					"content": "Không nói nhiều nữa, chúng ta hãy mau bắt đầu thử nghiệm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
