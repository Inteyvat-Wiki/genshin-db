					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "Chỉ cần khởi động thêm vài lần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110402,
					"content": "Nhà Lữ Hành! Bạn đến thật đúng lúc, vẫn nhớ Lò Luyện Nguyên Tố chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110403,
					"content": "Sau khi bạn khởi động Lò Luyện Nguyên Tố, tôi ở bên cạnh thu thập được không ít số liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110404,
					"content": "Hơn nữa quan trọng nhất là, tôi đã xác định được độ tin cậy của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110405,
					"content": "Có một thứ lợi hại như vậy, sau này có thể tiến hành nhiều thí nghiệm hơn nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110406,
					"content": "Nhà Lữ Hành, nếu bạn đồng ý, có thể giúp tôi đi khởi động Lò Luyện Nguyên Tố không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110407,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "Vậy phiền bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110409,
					"content": "Cần thí nghiệm bao nhiêu lần?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "Đương nhiên càng nhiều càng tốt, giống như Nhà luyện kim chưa có Vision, chỉ có thể dùng cách làm ngốc nghếch này để nghiên cứu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110411,
					"content": "Vậy thì phiền bạn rồi, Nhà Lữ Hành, giúp tôi đi khởi động Lò Luyện Nguyên Tố nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}