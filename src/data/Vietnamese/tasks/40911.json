			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "Haiz, Nhà Lữ Hành, xin hãy đợi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110103,
					"content": "Nói ra thì... cũng thật là ngại quá... có một việc cần nhờ bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110104,
					"content": "Bạn cũng biết đó, tôi vẫn luôn nghiên cứu thuật giả kim, nhưng không có đột phá gì mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110105,
					"content": "Nếu cứ nghiên cứu rập khuôn mãi như vậy, trình độ giả kim của tôi chắc chắn cũng không thể có tiến bộ gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110107,
					"content": "Bạn muốn nghiên cứu giả kim trên động vật?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "Bạn muốn nghiên cứu thuật giả kim cổ đại?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "Cho nên, tôi đã tìm ra một cách khác biệt, muốn bắt đầu một nghiên cứu mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110108,
					"content": "Cái đó thì... đã có người nghiên cứu rồi, cũng không phải là việc gì khác biệt cho lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110110,
					"content": "Giả kim cổ đại? Khụ, đó vẫn chưa phải lĩnh vực tôi có thể bước vào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110111,
					"content": "Ừm... Bạn biết thứ quan trọng nhất trong thuật giả kim là gì không? Đó chính là \"Nguyên Tố\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110112,
					"content": "Trong quá trình giả kim, vì nhiều nguyên nhân ảnh hưởng nên nguyên liệu dùng đến thường có nguyên tố đính kèm, chứ không phải là sức mạnh nguyên tố thuần túy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110113,
					"content": "Dùng loại nguyên liệu này sẽ sản sinh ra tạp chất trong quá trình giả kim. Tạp chất sẽ ảnh hưởng đến hiệu suất của phản ứng nguyên tố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110114,
					"content": "Không những phải tăng lượng nguyên liệu nguyên tố, mà còn phải thường xuyên quan sát, tránh để những tạp chất này ảnh hưởng đến quá trình giả kim dẫn đến giả kim thất bại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110115,
					"content": "Nhưng đối với người không có Vision mà nói, muốn tiến hành giả kim không thể không bỏ ra thêm vốn liếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110116,
					"content": "Mà vấn đề lớn nhất chính là, chi phí mua những nguyên liệu nguyên tố thật sự rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110117,
					"content": "Kết thúc một buổi giả kim, hóa đơn còn khiến người khác chú ý hơn cả thành quả giả kim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110119,
					"content": "Tôi cũng không có Vision.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "Vậy bạn tìm tôi làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "Haiz, có lẽ cũng chính vì như vậy, thuật giả kim của tôi mới chả có chút tiến bộ nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110120,
					"content": "Đúng vậy... nhưng tôi có nghe nói bạn có thể điều khiển nguyên tố, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110122,
					"content": "Tuy bạn không có Vision, nhưng tôi nghe nói bán có thể điều khiển sức mạnh nguyên tố, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110123,
					"content": "Là như vầy, tôi nghiên cứu ra một loại lò giả kim mới, tôi gọi nó là <color=#00E1FFFF>Lò Luyện Nguyên Tố</color>, nguyên tắc hoạt động là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110124,
					"content": "Hừm, nói đơn giản là một vật chứa có thể đựng được nguyên tố thuần khiết, và còn có thể khiến chúng phản ứng qua lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110125,
					"content": "Thành quả giả kim đạt được khi dùng Lò Luyện Nguyên Tố này nói không chừng có thể giúp trình độ giả kim của tôi có tiến bộ đột phá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110126,
					"content": "Hiện nay mọi thứ đã được chuẩn bị hết, chỉ còn thiếu một người có thể tự do điều khiển sức mạnh nguyên tố giúp tôi \"vận chuyển\" nguyên tố thuần khiết mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110127,
					"content": "Nếu bạn đồng ý, hãy đến <color=#00E1FFFF>Thiên Phong Thần Điện</color> tìm tôi, tôi đã nhờ người lắp đặt thiết bị xong hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110128,
					"content": "Hy vọng lần này trình độ giả kim của tôi được đột phá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
