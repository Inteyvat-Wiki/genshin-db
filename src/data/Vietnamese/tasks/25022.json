			"dialogs": [
				{
					"id": 250220501,
					"content": "Ồ, loại hoa này cũng không tệ đấy. Có một mùi thơm dịu dàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220504,
					"content": "Hora? Ngươi... Chà, đã ăn hết rồi sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220505,
					"content": "(Hora nuốt trọn Thanh Tâm, rồi chớp mắt nhìn các bạn...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220506,
					"content": "Hora đột ngột xoay người, trong nháy mắt đã ăn sạch nửa mâm trái cây bên cạnh.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "Sao Hora lại đột nhiên ăn khỏe thế nhỉ? Bông hoa tên Thanh Tâm này có hiệu quả tốt đến vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220508,
					"content": "Tôi, tôi phải đi hỏi ý kiến của bác sĩ xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
