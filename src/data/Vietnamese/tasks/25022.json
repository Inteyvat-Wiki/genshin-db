			"dialogs": [
				{
					"id": 250220301,
					"content": "Bông hoa này đẹp quá. Tên cũng rất hay... Hora, ngươi có muốn ăn thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220304,
					"content": "Grào, grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220305,
					"content": "(Hora nhai kỹ từng chút một, nhấm nháp hương vị của cánh hoa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220306,
					"content": "G-Grào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220307,
					"content": "Ồ! Nhìn vẻ mặt của Hora kìa, có vẻ nó rất thích ăn cái này đấy. Nhưng ăn hoa thì không thể no được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220308,
					"content": "Hơn nữa, loại hoa này trông có vẻ không rẻ lắm... Tóm lại, tôi ghi lại trước vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220309,
					"content": "Làm thế nào để chế biến bông hoa thành món ăn đây? Ừm, hay là... bọc hoa vào trong bánh được không nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
