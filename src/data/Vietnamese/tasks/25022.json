			"dialogs": [
				{
					"id": 250220401,
					"content": "Ồ! Loại quả này cũng không nhỏ, nhìn là đủ no rồi. Hora có muốn thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220404
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220404,
					"content": "Grào, grừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220405,
					"content": "(Hora ngoạm một miếng Dưa Tím to, trong chốc lát đã ăn hết sạch.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220406,
					"content": "Grào, gràoooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220407,
					"content": "Hahaha, ăn hết nhanh thật đấy. Ngươi thích món này lắm sao, Hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220408,
					"content": "Grào, gràooo! Gràooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220409,
					"content": "Được rồi! Vậy lát nữa ta sẽ đi tìm người hỏi thử xem có thương nhân nào từ Inazuma đến đây không. Phải mua thêm Dưa Tím mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
		{
			"id": 2502205,
			"completionStepIds": [],
