			"dialogs": [
				{
					"id": 250220101,
					"content": "Ừm... Xem ra phải đổi công thức khác rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220102,
					"content": "Grào, gràoooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220103,
					"content": "Anh lại có ý tưởng gì rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "G-Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220107,
					"content": "Bình thường nó có thể ăn hết cả một khay trái cây, sau khi ăn xong còn có thể quậy nguyên ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220108,
					"content": "Nhưng bây giờ nó chỉ ăn được hơn một nửa khay thôi, mà sau khi ăn xong nó lại chỉ ngồi im không nhúc nhích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220109,
					"content": "Tôi cứ tưởng nó bị ốm, nên hoảng hốt đi tìm bác sĩ giúp ngay trong đêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220110,
					"content": "Hai chúng tôi loay hoay cả đêm, cuối cùng cũng xác định được là Hora không bị bệnh gì cả, nó chỉ... kén ăn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220111,
					"content": "Bác sĩ nói giải pháp tốt nhất là đổi thực đơn mới cho Hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220112,
					"content": "Anh ta còn nói, tôi có thể thử chơi nhạc vào lúc Hora đang ăn, như vậy sẽ giúp ích cho việc kích thích sự thèm ăn của Hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220113,
					"content": "Nghe ổn đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Hahaha... Đúng vậy, lúc đó tôi đúng là đã tìm được một đĩa nhạc, Hora cũng rất thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220116,
					"content": "Tuy nhiên, sau khi Hora nhảy dựng lên và cắn bể một nửa đĩa nhạc thì... Tôi buộc phải từ bỏ kế hoạch này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220117,
					"content": "Dù sao thì đối với Tepetlisaurus mà nói, đĩa nhạc làm từ Đá Obsidian và Phlogiston đã đủ ngon rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220118,
					"content": "Bây giờ tôi chỉ còn cách đến \"Dòng Dõi Vườn Treo\" để tìm sự trợ giúp, xem liệu có thể tìm được một số nguyên liệu mới lạ hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220119,
					"content": "Tôi sẽ đi tìm nguyên liệu giúp anh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "#{F#Cô}{M#Cậu} sẵn lòng giúp đỡ ư? Vậy thì còn gì bằng! Bạn của tôi ở \"Dòng Dõi Vườn Treo\" chỉ có thể tìm kiếm nguyên liệu ở Natlan, nhưng {F#cô}{M#cậu} thì có thể ra ngoài Natlan đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220124,
					"content": "Đợi chút, để tôi xem thử danh sách nguyên liệu mà bác sĩ đã đưa cho tôi. Anh ta quả là hiểu biết sâu rộng, hiểu cả những chuyện ở bên ngoài Natlan luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220125,
					"content": "Ừm... Ở đây viết là có thể thử <color=#00E1FFFF>Tường Vi Cầu Vồng, Dưa Tím</color> và <color=#00E1FFFF>Thanh Tâm</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220122,
					"content": "#Vậy trông cậy vào {F#cô}{M#cậu} đó, sau khi tìm đủ nguyên liệu thì hãy mang về đây cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220123,
					"content": "Grào, grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220120,
					"content": "Tôi rất giỏi trong việc tìm nguyên liệu đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "Còn có loại đĩa nhạc này nữa à.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Vuốt ve Hora.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "G-Grào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "Hora"
				}
			]
		},
