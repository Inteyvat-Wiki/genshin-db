			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bresson"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746690101,
					"content": "Bresson, phải tin vào chính mình... Tin tưởng bản thân, tất cả dụng cụ đều chuẩn bị xong rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690102
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690102,
					"content": "Chỉ cần... phù... chỉ cần xuống nước... xuống nước chứng minh độ tin cậy của dụng cụ, thì mọi chuyện sẽ thành công...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690103
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690103,
					"content": "Anh đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690104
					]
				},
				{
					"id": 746690104,
					"content": "Ây da! Từ đâu chui ra vậy, một chút tiếng động cũng không có?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690105
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690105,
					"content": "Tôi sợ đến suýt té xuống nước luôn... Nếu không định thần kịp là coi như mất đi tương lai nhiếp ảnh Fontaine rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690106,
						746690107
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690106,
					"content": "Xin lỗi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				},
				{
					"id": 746690108,
					"content": "Nhưng mà, anh không biết bơi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746690109,
					"content": "Hình như anh cũng là người Fontaine mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690110
					]
				},
				{
					"id": 746690110,
					"content": "Ai nói là người Fontaine thì phải biết bơi chứ? Đâu phải tất cả người Liyue đều biết nấu ăn, hay người Mondstadt đều biết làm thơ, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690111
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690111,
					"content": "Không nói chuyện này nữa. Khó khăn lắm mới mượn được thiết bị lặn đến đây, hôm nay nhất định phải xuống nước chụp ảnh một chuyến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690112
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690112,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746690113,
					"content": "Máy ảnh này có gì đặc biệt không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690114
					]
				},
				{
					"id": 746690114,
					"content": "Đặc biệt? Chiếc máy ảnh này do chính tay Bresson Cartier tôi cải tiến, đây chính là \"điểm đặc biệt\" của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690115
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690115,
					"content": "Phương pháp cải tiến của tôi tinh vi khéo léo, vận dụng kỹ thuật tối tân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690131
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690131,
					"content": "Ống kính tốt gấp mấy lần máy ảnh khác, khi chụp ảnh dưới nước thì chất lượng ảnh cũng không hề bị tổn hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690116
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690116,
					"content": "Nhưng đám người trong hiệp hội... không thèm để ý đến công nghệ mới này. Nói rằng chụp ảnh thì chủ yếu là dựa vào tay nghề của người chụp, thiết bị không quan trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690117
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690117,
					"content": "Đợi tôi chụp được vài tấm ảnh đẹp, nhất định sẽ khiến đám người không hiểu gì về tầm quan trọng của thiết bị đó phải câm nín!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690118
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690118,
					"content": "Phù... Bresson, phải tin tưởng bản thân... tin tưởng bản thân... nhiệt độ nước rất thích hợp, dưới nước cũng không có thứ cá ăn thịt người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690119
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690119,
					"content": "Tôi... tôi... Chậc! Thứ đồ lặn này có thực sự hiệu quả không? Lỡ bị hỏng dưới nước thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690120
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690120,
					"content": "Sau đó tôi sẽ bị cuốn theo dòng nước xuống tận đáy biển mà không ai phát hiện. Ôi trời, ôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690121,
						746690122
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690121,
					"content": "Nếu không được thì tôi có thể giúp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690123,
					"content": "Thật sao?! Bạn sẵn lòng giúp tôi sao? Thật là hào hiệp, bạn quả thực là vị cứu tinh của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690124,
						746690125
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690124,
					"content": "Nhưng phải trả thù lao đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690126,
					"content": "Tất nhiên tôi sẽ không để bạn giúp không công rồi. Bạn sẽ nhận được một khoản thù lao hậu hĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690127
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690127,
					"content": "Phải rồi, để tôi đánh dấu vị trí phong cảnh dưới nước cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690128
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690128,
					"content": "Còn có... những thiết bị hoàn toàn mới này, phải tìm vài nơi để thử nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690129
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690129,
					"content": "Như vậy là ổn rồi, tương lai của kỹ thuật nhiếp ảnh Fontaine, còn có sự nghiệp thiết bị máy ảnh của tôi, tất cả đều trông cậy vào bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690130
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690130,
					"content": "Tôi... hmm... sẽ đợi bạn ở trên bờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690125,
					"content": "Thù lao phải căn cứ theo quy định của hiệp hội đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690122,
					"content": "Hay là... để tôi chụp ảnh giúp anh nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690107,
					"content": "Không ngờ anh phản ứng mạnh như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				}
			]
		}
	]
}