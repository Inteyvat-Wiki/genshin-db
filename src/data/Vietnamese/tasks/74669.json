	"talks": [
		{
			"id": 7466901,
			"completionStepIds": [
				7466902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7466902",
							"2"
						],
						"stepId": 7466902,
						"stateName": "QUEST_STATE_UNFINISHED"
