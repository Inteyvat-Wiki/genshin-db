			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tanjiyy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733380101,
					"content": "Xin chào! Người bạn lạ mặt! Bạn là lữ khách đi ngang qua đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380102
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380102,
					"content": "Xin lỗi vì đã cản đường... Ừm, ở đây đã xảy ra chuyện gì... có thể nói cho tôi biết được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380103
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380103,
					"content": "#Tôi là {NICKNAME}, hân hạnh được làm quen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380104
					]
				},
				{
					"id": 733380104,
					"content": "Dastur của Học Phái Vahumana, Tanjiyy. Tôi đến đây để... ừm, đúng, bộ tộc Tanit... chi viện công tác giáo dục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380105
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380105,
					"content": "Thật kỳ lạ, lẽ ra phải là ở đây mới đúng chứ... Nhưng tại sao lại thành ra như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380106,
						733380108
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380106,
					"content": "Chuyện này... nói ra dài dòng lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380107
					]
				},
				{
					"id": 733380107,
					"content": "Chiến tranh bộ lạc hay đấu đá nội bộ? Ừm? Thú vị đấy, không có một cuộc xung đột nào có thể tiêu diệt cả một bộ lạc ở sa mạc hàng trăm năm nay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380110,
					"content": "Hơn nữa... Tôi cũng đã phát hiện ra dấu vết đáng ngại... E hèm, tôi khuyên bạn không nên nhìn vào nó thì hơn. Ừm... nó không tốt cho dạ dày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380111
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380111,
					"content": "Có lẽ một số người sống sót đã quay lại và thu thập hầu hết... những gì còn lại. Tôi không chắc nữa... thật đáng lo ngại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380112
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380113
					]
				},
				{
					"id": 733380113,
					"content": "Haiz... Sao lại gặp phải chuyện thế này chứ. Cảm giác giống như... chứng kiến một sự kiện lịch sử vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380114
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380114,
					"content": "À, đúng rồi, tiện thể... ừm, bạn có muốn chơi bài không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380115
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380115,
					"content": "Ở trong những túp lều kia tôi tìm được mấy bộ bài, lau chùi một chút cũng sạch sẽ lắm. Nếu bạn có hứng thú thì chúng ta có thể chơi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380108,
					"content": "Có lẽ họ... đã di cư rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380109
					]
				},
				{
					"id": 733380109,
					"content": "Di cư? Không... hãy nhìn xem, hàng hóa và lều trại vẫn ở chỗ cũ. Tro củi và nhà cửa vẫn còn dấu vết của sự sống... Hừm, nó giống như một tai họa bất ngờ làm gián đoạn cuộc sống của mọi người thì đúng hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Tanjiyy"
				}
			]
		},
