				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "Bên trong này, một nửa là muối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230302,
					"content": "Chẳng qua chỉ là một hũ muối mà thôi, xem ra \"Ma Thần Muối\" là một ma thần nghèo kiết xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230303,
					"content": "Theo tôi hiểu, thì nó không bình thường đâu. Mặc dù chỉ có một nửa, nhưng vĩnh viễn là một nửa... Nói cách khác, thì chính là vô tận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230304,
					"content": "Cái gì? Cho dù có đổ ra ngoài, thì muối bên trong cũng sẽ không giảm đi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230305,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230306,
					"content": "Có thể sản sinh ra lượng muối vô tận, quả nhiên quyền năng của \"Ma Thần Muối\" thật quá mạnh mẽ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230307,
					"content": "Vật vã lâu như vậy, cuối cùng tôi cũng gặp được bảo bối rồi! Thứ này thuộc về tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230308,
					"content": "Tôi chỉ cần lấy muối ra, đóng thành vài ngàn bao đem bán thì cũng đủ để phát tài rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230309,
					"content": "Này! Di sản của \"Ma Thần Muối\" sao có thể dùng vào những chuyện tầm thường như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230310,
					"content": "Nếu ngài Kliment đã muốn hũ muối này, vậy thì dựa theo khế ước, món kế tiếp sẽ thuộc về quý cô Wanyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230311,
					"content": "Không vấn đề gì, làm gì có thứ gì giá trị hơn món đồ này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230312,
					"content": "Vì đã có \"khế ước\", nên tôi sẽ không tranh giành với anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230313,
					"content": "Vậy thì chúng ta đi tiếp nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "Hừ, chỉ là một cây thước mà thôi, xem ra chẳng có tác dụng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230502,
					"content": "Đây là... Nếu tôi nhớ không lầm, thì đây là một loại thiết bị đo lường?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230503,
					"content": "Đúng là vậy, nhưng quyền năng của \"Ma Thần Muối\" cũng có ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230504,
					"content": "Một khi cây thước này được cắm xuống đất, thì mặt đất sẽ giống như nước dâng lên, được bao phủ bởi muối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230505,
					"content": "Cắm càng sâu, thì muối càng nhiều, nói cách khác, thì đây chính là \"mùa bội thu\" của muối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230506,
					"content": "Cái này... Không phải là còn lợi hại hơn cả hũ muối sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230507,
					"content": "Vậy thì, dựa theo khế ước, cây thước này thuộc về quý cô Wanyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230508,
					"content": "Không được! Tôi không đồng ý! Tiền là do tôi chi, đợt thăm dò này là do tôi tổ chức, dựa vào đâu mà tôi phải chịu thiệt chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230509,
					"content": "Hơn nữa cô gái này cũng chẳng cần dùng đến, tại sao lại đưa cho cô ấy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230510,
					"content": "Anh ta quả nhiên sẽ làm như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230511,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "Nói như vậy nghĩa là giờ anh muốn phá bỏ \"khế ước\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230514,
					"content": "Phá bỏ thì đã sao chứ? Các cơ quan trong di tích này tôi cũng gần như hiểu hết rồi, cho nên anh không còn tác dụng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230515,
					"content": "Nói cho cùng thì tôi chính là người thuê anh, dựa vào đâu mà tôi phải làm theo quy tắc của anh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230516,
					"content": "Bởi vì anh đã lập khế ước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230517,
					"content": "Nham Vương Đế Quân từng nói, \"Đã ký khế ước, kẻ nuốt lời phải chịu hình phạt của Nham.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230518,
					"content": "Đó là thần của Liyue các người, tôi đến từ Snezhnaya, tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230519,
					"content": "\"Hình phạt của Nham\", anh tự mình cảm nhận đi... Không dễ chịu mấy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230512,
					"content": "Nếu đã nói những lời này thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "Món anh thu hoạch được, tôi sẽ tịch thu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230702,
					"content": "Anh không còn tư cách đi tiếp nữa, hãy rời khỏi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230703,
					"content": "Đáng ghét... Hãy chờ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230705,
					"content": "Nói là thăm dò khảo cổ, nhưng cuối cùng vẫn không thể tiếp tục giả vờ được nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230706,
					"content": "May mà sớm đã đề phòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "Đúng vậy, may mà khứu giác của tôi nhạy bén.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230710,
					"content": "Sai lầm của Kliment đó chính là lòng tham, nhưng ngoài lòng tham ra, còn có rất nhiều thứ khác khiến người ta phản bội khế ước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230711,
					"content": "Đối mặt với những \"thứ khao khát\", rốt cuộc có bao nhiêu người có thể khắc chế được dục vọng, tuân thủ giao ước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230712,
					"content": "Chi bằng nhân cơ hội này nói rõ đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230713,
					"content": "Hả? Nói gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230714,
					"content": "Đây là đội khảo cổ tạm thời, nhưng thật ra không có ai đến để \"khảo cổ\" cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230715,
					"content": "Tại... Tại sao lại nói vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230716,
					"content": "Cô tuy thiếu kiến thức cơ bản về khảo cổ, văn vật cũng không hiểu được mấy món, nhưng kiến thức về \"Ma Thần Muối\" lại vô cùng tinh thông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230717,
					"content": "So với khảo cổ và văn vật, thì \"Ma Thần Muối\" mới là thứ khiến cô hứng thú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230718,
					"content": "Lúc ở Châu Điền Phường cô nhắc về những truyền thuyết liên quan đến Ma Thần Muối, theo tôi biết, thì ở \"Ngân Nguyên Sảnh\" lưu truyền nhiều nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230719,
					"content": "Đừng... Đừng nói nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230720,
					"content": "Ngài quả nhiên học rộng biết nhiều, tôi lấy hết dũng khí để đưa ra câu hỏi cho ngài, xem ra là một lựa chọn đúng đắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230721,
					"content": "Đúng vậy, tôi không phải là nhà khảo cổ gì cả. Tôi đến từ một phái trong \"Thất Tinh Bát Môn\", quản lý sản nghiệp muối \"Ngân Nguyên Sảnh\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230722,
					"content": "Tổ tiên của chúng tôi chính là những con dân được \"Ma Thần Muối\" bảo hộ trong thời kỳ đầy gian khổ khi cuộc chiến ma thần quét qua đại lục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230723,
					"content": "Nghĩ lại, chưa từng nghe cô gọi \"đế quân\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "Đúng ha, nói mới để ý, quả thật rất ít người Liyue gọi \"Morax\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230726,
					"content": "Trong trận chiến đó, Morax đã ám sát vị thần của chúng tôi! Hắn đố kỵ với quyền năng của \"Ma Thần Muối\", khiến chúng tôi không còn chốn nương thân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230727,
					"content": "Chúng tôi... Hận hắn! Nhưng Liyue là Liyue của Morax, lịch sử nhất định là do hắn tự mình tô vẽ nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230728,
					"content": "Cho nên tôi muốn chứng minh! Morax cũng có tội ác! Bàn tay hắn cũng không hề sạch sẽ, hắn cũng có mặt tàn nhẫn vô tình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230729,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230730,
					"content": "Chúng ta đã có \"khế ước\", phải nhìn thẳng vào sự thật, đúng không ngài Zhongli! Chuyện này ngài phải phán xét thật công bằng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230731,
					"content": "Điều này là đương nhiên. Nhưng Liyue cũng không còn là Liyue của Morax nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230732,
					"content": "Đi theo tôi nào, tất cả đáp án đều ở phía trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230724,
					"content": "Nghĩ lại, chưa từng nghe cô gọi \"Nham Vương Gia\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "Sau này, Paimon đừng giống vậy nha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "Tôi thích Mora, nhưng tôi sẽ không làm chuyện xấu đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "Đây là... Thanh kiếm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230902,
					"content": "A! Là thanh kiếm gãy! Đây chính là chứng cứ! Chứng minh \"Ma Thần Muối\" đã từng phản kháng nhưng không thể chống lại thủ đoạn tàn ác của Morax!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230903,
					"content": "So với \"Hũ Muối\" và \"Thước Muối\" thì sức mạnh của thanh \"kiếm\" này nhất định vượt xa chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230904,
					"content": "Nếu có thể sửa lại thanh kiếm này, thì có thể cho mọi người thấy được quyền năng của \"Ma Thần Muối\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230905,
					"content": "Có vẻ như đúng là món đồ còn sót lại sau khi thua trận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230906,
					"content": "Hai đoạn kiếm gãy này, nếu nhìn từ góc độ khảo cổ thì chính là hai món văn vật. Dựa theo khế ước \"Lần lượt nhặt đồ, mỗi lần 1 món\", cô chỉ có thể lấy 1 trong 2.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230907,
					"content": "Tại sao vậy? Tuy nói là lần lượt nhặt đồ, nhưng mà... Kliment đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230908,
					"content": "Đúng vậy, nhưng \"mỗi lần 1 món\" vẫn có hiệu lực. Không thể cùng lúc nhặt lấy 2 món văn vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230909,
					"content": "Chuyện này..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230910,
					"content": "Ừm... Zhongli, cô ấy không có ác ý, cũng không tranh đoạt, có thể châm chước một chút không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230911,
					"content": "\"Khế ước\" không thể châm chước, nếu không tuân thủ thì chính là phá bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230912,
					"content": "Không được! Nếu chỉ có thể mang một nửa theo, thì sẽ không thể sửa lại được, không thể tái hiện quyền năng của \"Ma Thần Muối\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230913,
					"content": "Bất luận thế nào đi nữa, vì tín ngưỡng của tôi đối với ma thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230914,
					"content": "Dù cho có phải phá bỏ khế ước, tôi cũng không hối tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230915,
					"content": "Cô đã quyết định rồi sao? Vậy thì đây chính là cái giá của nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230916,
					"content": "Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230917,
					"content": "Điều này có nghĩa là, cô phải chịu \"Hình phạt của Nham\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230918,
					"content": "Cũng... không sao. \"Ma Thần Muối\" vì bảo vệ tín đồ của cô ấy, ngay cả sinh mạng mình cũng nguyện ý trả giá. Sự hy sinh của tôi không đáng là gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230919,
					"content": "Ngài muốn trừng phạt thế nào cũng được, chỉ cần để cho tôi mang chúng về... minh chứng cho tín ngưỡng của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230920,
					"content": "Không, không thể đánh phụ nữ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230921,
					"content": "...Nếu như vậy có thể nhận được sự giải thoát, biết đâu đó lại là cách nhẹ nhàng hơn. Nhưng....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230922,
					"content": "Như một \"hình phạt\", tôi sẽ nói cho cô biết \"chân tướng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230923,
					"content": "Sao cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230924,
					"content": "Chân tướng? Ngài nói chân tướng... Chính là hình phạt của tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230925,
					"content": "Đúng vậy. Sau đây cô sẽ nghe về sự thật, cũng chính là cái giá cho việc phá bỏ \"khế ước\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230926,
					"content": "Rất tiếc, Ma Thần Muối Havria, không phải là ma thần đầy quyền năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230927,
					"content": "Mà ngược lại, do cô ấy quá yếu ớt, quá mong manh, nên không thể đạt được vị trí của bảy vị thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230928,
					"content": "Ngài nói sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230929,
					"content": "Trong cuộc chiến ma thần, các vị ma thần trên thế gian vì tranh đoạt đại lục mà đã dốc hết tất cả sức mạnh và trí tuệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230930,
					"content": "Nhưng Havria đã chọn lựa bỏ trốn. Cô ấy cho rằng chỉ cần bỏ đi trước khi cuộc chiến diễn ra, thì chiến tranh sẽ không thể nào lan đến được chỗ cô ấy và con dân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230931,
					"content": "Nhưng trong những năm tháng dài lê thê của chiến tranh, thì \"rút lui\" sẽ vĩnh viễn không có điểm dừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230932,
					"content": "Và trong quá trình rút lui không có điểm dừng đó, Havria đã mất đi tất cả lãnh thổ, chỉ còn lại chốn nương thân cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230933,
					"content": "Không... Không thể nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230934,
					"content": "Vào thời khắc cuối cùng của mình, ngay cả một thanh kiếm để bảo vệ con dân của mình, cô ấy cũng không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230935,
					"content": "Ngay cả một thanh kiếm cũng không có? Nhưng mà, thanh kiếm này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230936,
					"content": "Đúng vậy, thanh kiếm gãy này không phải là di vật của \"Ma Thần Muối\", mà là hung khí của kẻ đã ra tay với cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230937,
					"content": "Hung khí...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230938,
					"content": "Không! Đây đều là giả dối, những thứ này đều là giả, ngài đang muốn mê hoặc lòng tin của tôi đối với thần linh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230939,
					"content": "Tôi nói rồi, tôi chỉ trần thuật lại sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230940,
					"content": "Không lý nào lại như vậy! Ngài... Ngài cũng là tín đồ của Morax, đừng hòng lừa tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230942,
					"content": "Này! Này, đừng chạy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230943,
					"content": "Đối với cô ấy mà nói, thì đây là một đả kích quá lớn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "Dù sao thì đây cũng là trừng phạt. Nếu không thì tôi cũng không muốn nói ra sự thật tàn khốc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230947,
					"content": "Chúng ta tiếp tục đi vào trong nào. Bên trong... E rằng sẽ có thứ \"chân tướng\" khiến cô ấy không thể nào tiếp nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230945,
					"content": "Những lời Zhongli nói, thật sự là \"chân tướng\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "Ừm, nếu không thì đã không dùng \"chân tướng\" làm hình phạt. Tôi cũng không muốn nói ra chuyện tàn khốc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102310,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102310",
							"2"
						],
						"stepId": 1102310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231131,
					"content": "...Trên đường là thứ gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231132,
					"content": "Bọn họ... nhìn thấy gì vậy... Họ đang làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231133,
					"content": "Sau đó... đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231134,
					"content": "Nếu cô đã không tin tôi, thì chúng ta cứ tiếp tục đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231135,
					"content": "Tất cả những chuyện xảy ra lúc đó, vết tích để lại sau cánh cửa này, đều đã ghi lại một cách chân thực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102311,
			"completionStepIds": [
				1102311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102311",
							"2"
						],
						"stepId": 1102311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "Đây chính là hiện trường, hình hài Havria đã tiêu tán chỉ còn lưu lại vết muối. Khung cảnh lúc lâm chung cũng dừng lại tại nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231103,
					"content": "Diễn biến tiếp theo của câu chuyện là: Trong số những con dân của cô ấy, có người cuối cùng cũng ý thức được, vị ma thần lương thiện nhưng yếu ớt này không đủ sức bảo vệ bất kỳ người nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231104,
					"content": "Chiến tranh ma thần vô cùng tàn khốc, so với việc để cô ấy chịu sự giày vò sau khi bị đánh bại, chi bằng để cô ấy được giải thoát một cách nhẹ nhàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231105,
					"content": "Nhưng những \"bức tượng\" này... là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231106,
					"content": "Ma thần dù cho có yếu ớt thế nào, thì sức mạnh mất đi khi chết cũng không phải là thứ mà cơ thể người phàm có thể chịu đựng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231107,
					"content": "Những người không chạy thoát được, đều biến thành những bức tượng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231108,
					"content": "Những con dân không gánh chịu thảm họa này đã rời khỏi lãnh địa của cô ấy, đến Liyue, cầu xin sự bảo hộ của Nham Vương Đế Quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231109,
					"content": "Hậu duệ của họ sợ tàn tích ma thần Havria để lại, sợ lời nguyền vĩnh hằng của cô ấy dành cho họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231110,
					"content": "Thế nên họ đã mạo hiểm trở lại nơi này, bẻ gãy kiếm và thờ cúng, hy vọng có thể làm nguôi lửa giận của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231111,
					"content": "Nhưng thật ra hành động của họ đều là dư thừa. Vị ma thần đến phút cuối còn không phản kháng lại kia, làm sao có thể nổi giận với con dân của chính mình chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231112,
					"content": "Tôi... Tôi... Cho dù là vậy, tôi cũng không thể chấp nhận được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231113,
					"content": "Lừa dối... Lịch sử lừa dối... Tất cả... đều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231114,
					"content": "Đừng hòng làm lung lay tính ngưỡng của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231116,
					"content": "Lần này, Zhongli quả thật là không lưu tình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231117,
					"content": "Đây là cái giá mà cô ấy cần phải trả... Nhưng vẫn có thể xem như là chuyện tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231118,
					"content": "Nhìn dáng vẻ của cô ấy, e là không thể chịu đựng thêm nữa... Tuy là không thể giải thoát ngay lập tức, nhưng có thể nhìn rõ được hiện thực thì cũng không tệ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231119,
					"content": "Anh thật sự hiểu rất rõ chuyện của Ma Thần Muối.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "Ừ, rất lâu trước đây, câu chuyện của Havria đối với tôi mà nói cũng là một lời cảnh tỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231123,
					"content": "Tôn thờ một vị thần đã mất, thật ra không có gì tốt cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231124,
					"content": "...Dù là tín ngưỡng đối với Havria, hay đối với Morax thì cũng đều giống nhau cả thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231125,
					"content": "Đến một ngày, rồi người Liyue cũng sẽ hiểu ra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "Được rồi! Tiếp theo cùng tôi đi đến \"Cô Vân Các\" nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231127,
					"content": "Hả? Zhongli muốn làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231128,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231129,
					"content": "Về lại chốn cũ, lại kể những câu chuyện xưa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231130,
					"content": "Khó tránh sinh lòng hoài niệm với người xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231121,
					"content": "Cách giải phong ấn cũng không chỉ là lời đồn đại đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "Thật nhạy bén, nhưng... cũng chỉ là do tôi sống lâu hơn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}