				{
					"id": 402461101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461102,
					"content": "Ừm, Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461103,
					"content": "Im đi. Tôi đã nói rồi, không được tùy tiện dịch chuyển tôi đến những nơi kỳ quặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461104,
					"content": "Nhưng... nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461105,
					"content": "Ồ! Tuyệt vời quá! Quá tuyệt vời luôn! Đây chính là cái kết mà tôi muốn! Khung cảnh mà tôi mong đợi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461106
					],
					"speakerTitle": "Xavier",
					"speakerSubtitle": "Nhà Làm Phim"
				},
				{
					"id": 402461106,
					"content": "...Hả?!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461107,
					"content": "Cô vừa đi đâu thế, Columbina? Sao vừa quay đi một cái đã biến mất khỏi phim trường, rồi đột nhiên... ừm, lại xuất hiện cùng cô gái này và còn ôm lấy nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461108,
					"content": "Mấy... mấy người vừa nãy... đang quay... quay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461109,
					"content": "Mọi chuyện xảy ra quá đột ngột, máy ghi hình vẫn đang chạy, nên cảnh vừa rồi cũng đã được ghi lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402461110,
					"content": "Vị này chẳng lẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461111,
					"content": "Ừm, cô ấy chính là người bạn thân nhất của tôi đấy. Không ngờ thực sự có thể gặp lại cô ấy. Tôi vui quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461112,
					"content": "Có vẻ như bộ phim này có một cái kết thật đẹp nhỉ, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461113,
					"content": "...Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402461114,
					"content": "Quả nhiên... Quả nhiên tôi vẫn thấy cô thật phiền phức!! Co-lum-bi-na!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
