							3538.825,
							452.648,
							4179.689
						],
						"pointId": 16573
					}
				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Hôm qua Citlali uống nhiều quá, không biết giờ cô ấy tỉnh chưa nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460202,
					"content": "Chào buổi sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460203,
					"content": "Ối! Columbina! Cô... Sao cô lại ở đây thế? Không đúng, sao cô cứ thích xuất hiện sau lưng người khác thế hả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460204,
					"content": "Sáng nay tôi đến đây cùng mọi người để quay bù vài cảnh, vừa mới quay xong. Thế nên tôi ra boong thuyền hít thở không khí trong lành trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460205,
					"content": "Mọi người có vẻ vẫn đang ở dưới bàn luận về chuyện \"màn cuối cùng\" ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460206,
					"content": "Màn cuối cùng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460207,
					"content": "Ừm, chính là phần kết của bộ phim. Mọi người đang băn khoăn không biết nữ chính trong câu chuyện cuối cùng có tìm được người bạn ngày xưa của mình hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460208,
					"content": "À... Mấy ngày nay bận việc khác nên quên mất, bộ phim nghệ thuật này đúng là lấy bối cảnh nhân vật chính phát hiện bạn mình mất tích, nên đã quay về quê nhà của người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460209,
					"content": "Ừm, đạo diễn Furina và tiểu thư Chiori cho rằng, xét về mặt dư vị câu chuyện, kết thúc bi kịch khi hai người cuối cùng không gặp được nhau sẽ khiến người ta tiếc nuối hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460210,
					"content": "Còn đạo diễn Xavier thì cho rằng, cái kết gặp lại nhau sẽ khiến người ta cảm động và chữa lành hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460211,
					"content": "Columbina nghĩ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "Tôi á? Tôi... tôi không biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460213,
					"content": "Nếu là \"tôi\" thì tất nhiên tôi muốn gặp lại cô ấy... Ước gì chúng tôi thật sự có thể gặp lại nhau... Dù là trong phim đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460214,
					"content": "Nhưng nghĩ đến việc như vậy cũng đồng nghĩa là phải để người khác diễn vai cô ấy, trong lòng tôi lại có chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460216,
					"content": "Đừng lo về những chuyện đó vội.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460218,
					"content": "Đúng vậy, đừng vì chuyện này mà nhăn nhó như vậy. Quay phim phải tận hưởng mới đúng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460219,
					"content": "Hơn nữa... Tôi, tôi dám đảm bảo với Columbina! Mọi chuyện chắc chắn sẽ thuận lợi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460220,
					"content": "Thuận lợi? Ý là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460221,
					"content": "Ừm, thì... thì là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460222,
					"content": "Chắc chắn sẽ là một cái kết tốt đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "Ừm! Chính là ý này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460224,
					"content": "Ha... được rồi. Tôi tin mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460225,
					"content": "Vậy thì cứ như mọi người nói, trước tiên cứ tận hưởng quá trình quay phim đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460226,
					"content": "#Ồ? Chẳng phải {NICKNAME} và Paimon đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460227,
					"content": "Ồ? Đây chẳng phải là chuyên viên ánh sáng và thư ký trường quay hay trốn việc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460228,
					"content": "Chậc... Xin lỗi... Lần quay này chúng tôi xin nghỉ hơi nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460229,
					"content": "Haha, đùa thôi, đừng để bụng nhé. Lần quay này của chúng ta khá suôn sẻ, hai người cứ yên tâm lo việc của mình trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460230,
					"content": "Cảm ơn mọi người đã thông cảm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "Ơ? Tâm trạng của tiểu thư Columbina có vẻ tốt hơn nhiều rồi. A, xin lỗi, chắc là vừa rồi chúng tôi bàn về kết cục đã khiến cô khó xử rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460233,
					"content": "#Không sao, giờ tôi không sao rồi. {NICKNAME} và Paimon đã giúp tôi nghĩ thông rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460234,
					"content": "Ồ? Vậy cô muốn quay cái kết gặp lại, hay là không gặp lại?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460235,
					"content": "Quay cái kết tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 402460236,
					"content": "...Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460231,
					"content": "Sau này nhất định sẽ bù đắp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
