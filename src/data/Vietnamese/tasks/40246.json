						402461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461004,
					"content": "Hừ, chuyện này khó nói lắm. Sau này tôi sẽ quay về Fatui, mọi người tin tưởng người khác như vậy liệu có thật sự ổn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461005
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461005,
					"content": "Ít nhất thì Sandrone có thể tin tưởng được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "Hừ, đến lúc nếm mùi cực khổ thì đừng trách tôi không nhắc trước đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461007,
					"content": "Tiếp theo chúng ta đi đâu? Quay về thuyền à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461008,
					"content": "Đúng vậy, chuyện của bản thân Sandrone cũng đã giải quyết xong rồi, chuyện quá khứ cũng đã xong xuôi. Đã đến lúc để bạn bè biết cô vẫn ổn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461009,
					"content": "Mọi người thấy cô quay về, chắc chắn sẽ rất vui đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461010,
					"content": "Ha... Nếu là trước đây, có lẽ tôi tuyệt đối sẽ không thừa nhận, nhưng mà... ừm, tôi cũng thật sự nhớ mọi người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461011,
					"content": "Nhưng Columbina là ngoại lệ! Lần này tôi nhất định phải trả đũa việc cô ấy cứ hay đến làm phiền tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
		{
			"id": 4024611,
			"completionStepIds": [
				4024611
