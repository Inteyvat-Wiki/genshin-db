			"dialogs": [
				{
					"id": 402460901,
					"content": "Vậy là... kết thúc rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Kết thúc rồi. Đã nói là chuyện rất đơn giản mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460903,
					"content": "Sao cô làm được vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460904,
					"content": "Tập hợp oán niệm kia chẳng qua chỉ là sản phẩm của vô số linh hồn không chốn nương thân hội tụ lại. Trong đó lẫn lộn rất nhiều uế khí và tà niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460905,
					"content": "Tôi chỉ đơn giản là tách linh hồn nguyên bản của chúng ra khỏi những thứ ô uế, để chúng có thể được dung nạp bởi quy tắc của thế giới hiện tại mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460906,
					"content": "Nguyên lý của \"mô thức thế giới\" là \"phân tán\". Xuất phát từ một điểm khởi đầu, phân giải và tái tổ hợp tính khả thi của thế giới, từ đó tìm ra đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460907,
					"content": "Còn khi sử dụng \"mảng ẩn số\" để tính ngược lại \"mô thức thế giới\", sẽ có thể đạt được chức năng quy nạp củng cố và hoàn nguyên. Tức là đảo ngược thuật thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460908,
					"content": "Điều này tương tự như quy giản đồng điều trong toán học. Dưới điều kiện không thay đổi bản chất tập thể, đưa họ trở về dạng tồn tại đơn giản và thực chất hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460909,
					"content": "Vậy nên... hmm, thôi bỏ đi. Nhìn vẻ mặt mọi người cũng không giống như thật sự muốn tìm hiểu những điều này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460910,
					"content": "Hình như tôi đã hiểu được cảm giác của người ngoài khi nghe Shaman của Chủ Nhân Gió Đêm giảng giải mọi thứ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460911,
					"content": "Nói... nói chung tôi chỉ cần biết chuyện đó rất ghê gớm là được! Quả nhiên cô rất lợi hại đấy, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Nực cười, tôi vẫn luôn rất lợi hại mà! Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460913,
					"content": "Không hổ là chuyên gia tháo gỡ mọi nguyên lý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Cái này thì thôi đi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460915,
					"content": "Đến... Đến lúc phải đi rồi! Để tôi khôi phục lại cơ quan bên trong Tháp Mô Thức đã. Gặp nhau trên bờ nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
