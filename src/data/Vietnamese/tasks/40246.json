				},
				{
					"id": 402461003,
					"content": "Cô cũng đã giúp đỡ rất nhiều cho bạn bè ở Nod-Krai, rõ ràng là vẫn luôn rất tốt mà!",
					"roleType": "TALK_ROLE_NPC",
