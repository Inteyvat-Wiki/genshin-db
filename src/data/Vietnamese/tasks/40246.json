					}
				]
			},
			"dialogs": [
				{
					"id": 402461201,
					"content": "Citlali, chúng tôi đến rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Ồ, đúng giờ đấy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461203,
					"content": "Còn cô thì sao... Hôm qua uống nhiều vậy vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "Hả? Coi thường bà đây rồi à? Chút rượu đó làm sao mà tôi say được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461205,
					"content": "Nhưng sau đó cô đã bắt đầu nói lung tung rồi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "Có... có sao? Sao tôi không nhớ gì vậy? Tôi không nói gì... quá đáng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461207,
					"content": "Mắng cháu trai hết nửa tiếng, than phiền về công việc của Chủ Nhân Gió Đêm thêm nửa tiếng, rồi chia sẻ về tiểu thuyết hết một tiếng... Sau đó... à, hình như sau đó tôi cũng ngủ thiếp đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "...Họ đi rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461209,
					"content": "Họ? À, ý là đoàn làm phim à? Họ đi rồi, chúng tôi vừa gặp nhau trên boong thuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Nhưng nếu đã giải quyết xong vấn đề của bản thân rồi, sao cô vẫn chưa đi gặp Columbina? Cô ấy rất muốn gặp cô mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "Tôi... tôi muốn giải quyết xong đống lộn xộn này trước rồi mới đi gặp cô ấy. Hơn nữa, một cơ hội tốt để hù cô ấy như vậy, tôi phải lên kế hoạch kỹ lưỡng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461212,
					"content": "Thôi không nói chuyện này nữa. Đã tìm được vị trí của tập hợp ô uế chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461213,
					"content": "Tất nhiên rồi, Bà Itztli đây đã nói làm được là sẽ làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461214,
					"content": "Vất vả rồi. Để tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461215,
					"content": "Khu Morte... Hửm? Đây chẳng phải là Tháp Mô Thức sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461216,
					"content": "Quả nhiên vẫn là oán niệm sâu sắc nhất với nơi linh hồn mình bị cắt đi nhỉ? Hay đây là oán hận đối với Narzissenkreuz...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461217,
					"content": "Để tôi đi cùng mọi người vậy. Địa điểm xuất hiện của thứ này thực ra không cố định lắm, nếu nó không ở đó thì tôi cũng có cách dùng nghi thức để triệu hồi nó đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461218,
					"content": "Thật sao? Nhưng chuyện này đã làm phiền cô nhiều rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461219,
					"content": "Đừng khách sáo, bộ xương cốt già này dù sao cũng rảnh rỗi, giúp lớp trẻ gọi hồn gì đó cũng không nặng nhọc gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461220,
					"content": "(Nếu tôi không đi thì biết đâu mấy người lại nảy sinh thêm chủ đề nào mà tôi không tham gia được thì sao?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461221,
					"content": "Được rồi, vậy thì vất vả cho cô rồi. Cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402461222,
					"content": "Hihi, vậy thì đừng chậm trễ nữa, chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
