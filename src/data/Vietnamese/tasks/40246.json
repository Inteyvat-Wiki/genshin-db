			"dialogs": [
				{
					"id": 402460701,
					"content": "Chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460702,
					"content": "Ừm. Tôi sẽ thử nói chuyện với họ trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460703,
					"content": "Nhưng tập hợp của những linh hồn này có lẽ đã mất đi lý trí, nếu không thể giao tiếp được, tình hình rất có thể sẽ biến thành một trận chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460704,
					"content": "Được, nếu xảy ra tình huống xấu nhất, tôi sẽ tìm chỗ trốn thật kỹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "Ừm, nếu thật sự phải đánh nhau, đòn cuối cùng hãy để tôi ra tay, mọi người đừng động thủ. Cứ tin tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460706,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "Được rồi, mọi người im lặng một chút đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "...Những linh hồn lạc lối trôi dạt theo thủy triều, ta gọi các ngươi. Hỡi những mảnh hồn bị chia lìa, bị ruồng bỏ, bị buộc phải im lặng, hãy theo hơi thở của ngày xưa mà trở về đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "...Hãy để những oán hận vô danh nhận ra nhau, hãy để những uế khí bị phong ấn thu hút lẫn nhau, tại đây, một lần nữa hội tụ thành hình hài!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(...Rồi sao nữa? Vậy là kết thúc rồi sao?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460713,
					"content": "(A... Vậy nên mình mới không xử lý nổi mấy thứ bí thuật ma pháp này... Hoàn toàn không biết phép toán tiến triển đến bước nào, logic của thuật thức cũng không thể nhìn thấu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460714,
					"content": "(Hoàn toàn khác với khoa học cơ khí mà mình thông thạo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460715,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460716,
					"content": "Cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460717,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Oán Niệm Của Linh Hồn Lang Thang"
				},
				{
					"id": 402460718,
					"content": "Người ở bên kia, hay nói đúng hơn là người ở bên trong, có nghe hiểu tôi nói gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460719,
					"content": "Tôi là hậu duệ của Bậc Thầy Cơ Khí Fontaine, Alain Guillotin. Tôi có cách giúp các người khôi phục dáng vẻ ban đầu, trở về với Địa Mạch. Chỉ cần các người phối hợp một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460720,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Oán Niệm Của Linh Hồn Lang Thang"
				},
				{
					"id": 402460721,
					"content": "Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "Chậc... tình hình này, xem ra khuyên thế nào cũng vô ích thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460723,
					"content": "Được rồi. Vậy thì tôi sẽ cùng mấy người giải tỏa tâm trạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
