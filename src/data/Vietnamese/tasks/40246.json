			"dialogs": [
				{
					"id": 402460501,
					"content": "Hình như không có ở đây nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460502,
					"content": "Có cần tôi bắt đầu nghi thức ngay bây giờ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460503,
					"content": "Khoan đã, chúng ta hãy xả cạn nước ở tầng Tháp Mô Thức này trước. Như vậy sẽ dễ di chuyển hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460504,
					"content": "Nước này còn có thể xả được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Tất nhiên là được. Sau khi Alain và Rene tình cờ cùng quan sát vận mệnh của Fontaine, hai người họ đã từng chia sẻ một số phương pháp chống nước cho kiến trúc. Nguyên lý là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 402460506,
					"content": "Khụ khụ, lạc đề rồi. Tóm lại cứ làm theo lời tôi, lần lượt mở các cơ quan theo thứ tự là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				}
			]
		},
