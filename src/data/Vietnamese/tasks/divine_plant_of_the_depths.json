				{
					"id": 721500405,
					"content": "Ơ, bói quẻ con đường phía trước...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500406,
						721500407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500406,
					"content": "Bói quẻ con đường phía trước...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500408,
					"content": "Ha ha, hai cháu không cần lo lắng. Xin lỗi, bà đường đột quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500409
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500409,
					"content": "Ý của bà là miếu thờ Watatsumi của Làng Bourou này rất linh, nên mới mời hai cháu rút một quẻ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500410
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500410,
					"content": "Không có ý nói rằng con đường phía trước của hai cháu sẽ gặp nhiều trắc trở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500411
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500411,
					"content": "À...đương nhiên, tương lai của bà và cháu như thế nào, sao có thể dự đoán được chỉ trong vài từ chứ...ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500412
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500412,
					"content": "Thì ra chỉ là bói toán thôi...hú hồn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500413,
					"content": "Có tốn tiền không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500414
					]
				},
				{
					"id": 721500414,
					"content": "Ha ha, không đâu. Mấy chuyện này thì lấy tiền sao được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500415
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500415,
					"content": "Người trông coi miếu thờ, nếu thu tiền người qua đường trong việc \"cầu nguyện\" thì sẽ khiến linh hồn Omikami bất an đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500416
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500416,
					"content": "Nếu đã cùng là người trần mắt thịt thì chúng tôi có tư cách gì lợi dụng \"nguyện vọng\" của người khác để trục lợi cho bản thân chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500417
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500417,
					"content": "Ừm...đúng là đạo lý này đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500418,
					"content": "Cho nên hai cháu, có vui lòng bói một quẻ không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500419
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500419,
					"content": "Được, thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500420
					]
				},
				{
					"id": 721500420,
					"content": "Ha ha, cám ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500421
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500421,
					"content": "Gần đây khắp nơi đều không được yên bình, hầu hết các thanh niên trong làng đều bận bịu làm việc kiếm sống. Vì thế có thể nhìn thấy các bạn trẻ đến, bà đây cũng rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500422
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500422,
					"content": "Đáng quý ở chỗ, các cháu là người nước ngoài mà lại một lòng tôn trọng truyền thống của đảo Watatsumi, thật giỏi, ha ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500423
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500423,
					"content": "Thôi không lảm nhảm nữa. Nói đến quẻ bói thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500424
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500424,
					"content": "Trước khi bói, nếu hai cháu không ngại, có thể giúp bà một việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500425
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500425,
					"content": "Hử, vẫn phải ra tiền à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500426,
					"content": "Ha ha, không cần tiền...nghe bà nói đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500427
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500427,
					"content": "Miếu thờ ở Làng Bourou linh nghiệm là nhờ thờ cúng \"Tảo Thần Biển Sâu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500428
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500428,
					"content": "Đúng như tên gọi, loài thực vật này ban đầu sinh trưởng ở nơi biển cả sâu thẳm...cũng chính là cội nguồn của tổ tiên chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500429
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500429,
					"content": "Mấy nghìn năm trước, tổ tiên của làng đã chiết rễ của nó từ biển sâu mang về đất liền, chăm bón cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500430
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500430,
					"content": "Dưới sự chăm sóc của nhiều thế hệ...cho dù là chiến tranh hay thiên tai, hay trải qua nỗi đau vì sự ra đi của Omikami...\"tảo thần\" trường thọ này cũng chưa từng héo tàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500431
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500431,
					"content": "Vì là loài thực vật sống dưới nước nên phải tưới nước liên tục mới sống được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500432
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500432,
					"content": "Và cũng là loài sinh vật từng sống trong môi trường tăm tối, vì vậy lúc nào cũng tỏa ra ánh sáng yếu ớt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500433
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500433,
					"content": "Cho nên, chúng tôi phán đoán nguyện vọng có thành hiện thực được hay không bằng quy luật chớp tắt lập lòe của tia sáng này, còn về điều bí ẩn trong nó, đều nằm ở nguồn nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500434
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500434,
					"content": "Ha ha, những pháp sư trẻ tuổi thường sẽ nghi ngờ về tính đáng tin của việc bói toán này, họ cảm thấy những nghi thức dân gian này đang truyền bá mê tín dị đoan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500435
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500435,
					"content": "Họ thích những lý thuyết rõ ràng dễ hiểu, không thích những câu chuyện truyền miệng của các lão tiền bối, vì thế những truyền thuyết dần dần bị lãng quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500436
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500436,
					"content": "Nhưng...trí tuệ của người già, trí tuệ của bao nhiêu đời nối tiếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500437
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500437,
					"content": "Có lẽ không thể nào quy thành những triết lý rõ ràng trong một sớm một chiều được, ẩn trong đó ít nhiều đều là những chân lý không thể xem nhẹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500438
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500438,
					"content": "Về nguồn nước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500439
					]
				},
				{
					"id": 721500439,
					"content": "Nguồn nước...? À! Ha ha...xin lỗi, đến tuổi này rồi, nói chuyện cứ quên trước quên sau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500440
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500440,
					"content": "Muốn cúng tế \"tảo thần\" cần phải lấy nước từ Hồ Công Đức ở ngôi đền mới được. Vì nước ở đó có chứa \"nguyện vọng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500441
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500441,
					"content": "\"Nguyện vọng\"...trong nước cũng có thứ này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500442,
					"content": "Ha ha, có chứ. \"Nguyện vọng\" của mỗi người gửi gắm sẽ tích tụ trong Hồ Công Đức rồi tan vào nước, giống như đường vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500443
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500443,
					"content": "Không ai nhìn tận mắt được...nhưng có thể cảm nhận nó bằng màu sắc đậm nhạt cũng như vị ngọt của nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500444
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500444,
					"content": "Ký ức cũng được, tín ngưỡng cũng được...đều là đạo lý này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500445
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500445,
					"content": "À, nếu muốn đi lấy nước thì phải cẩn thận...hiệu lực của \"nguyện vọng\" rất dễ bốc hơi trong không khí nếu rời khỏi Hồ Công Đức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500446
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500446,
					"content": "Giống như giấc mơ không ngừng tan biến khi trải qua bao nhiêu năm tháng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500447
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500447,
					"content": "Thông qua sự thay đổi của xúc giác và phân lượng, sẽ rất dễ cảm nhận được sự suy yếu dần của loại \"nguyện vọng\" này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500448
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500448,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500449,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500450
					]
				},
				{
					"id": 721500450,
					"content": "Ha ha, xin lỗi xin lỗi, lại lạc đề rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500451
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500451,
					"content": "Tóm lại, sau khi lấy nước, hãy nhanh chóng quay về đây, đừng nán lại quá lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500452
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500452,
					"content": "Nếu không hiệu lực của \"nguyện vọng\" sẽ tan biến hết, \"tảo thần\" cũng khó hấp thụ đủ chất dinh dưỡng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500453
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500453,
					"content": "Sau đó, lúc đó nhớ nhắc bà...còn một bước là nuôi dưỡng \"tảo thần\", thì quẻ bói mới linh nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500454
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500454,
					"content": "Phiền phức vậy! Không có pháp sư nào giúp bà sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500455,
					"content": "Haiz...pháp sư trẻ tuổi bây giờ toàn chê phiền, còn không thì khinh thường truyền thống cổ xưa này, không chịu giúp bà đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500456
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500456,
					"content": "Bà nói Tsuyuko sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500457
					]
				},
				{
					"id": 721500457,
					"content": "Đúng rồi, pháp sư ở Sangonomiya đó luôn tỏ ra xem thường người già!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500458,
					"content": "A, các cháu đã gặp cô gái đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500459
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500459,
					"content": "Ha ha, cô gái đó...tài giỏi đấy, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500460
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500460,
					"content": "Ha ha...thôi không nói nhiều làm gì, người trẻ mà, rồi cũng sẽ có ngày học được cách tôn trọng những câu chuyện truyền thuyết thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500461
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500461,
					"content": "Ừm...gì thế...không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500462,
					"content": "Nhìn ánh sáng của \"tảo thần\" ngày một ảm đạm...bà là người thất vọng hơn ai hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500463
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500463,
					"content": "Nhưng vẫn có cảm giác phiền phức quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500464
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500464,
					"content": "Có vẻ hiểu được cảm giác của các pháp sư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500465
					]
				},
				{
					"id": 721500465,
					"content": "Không biết hai cháu có hứng thú giúp bà lấy nước không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500466
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500466,
					"content": "Chúng cháu sẽ giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500467
					]
				},
				{
