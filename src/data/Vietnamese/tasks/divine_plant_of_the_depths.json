					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500306
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500306,
					"content": "Theo ánh sáng của \"tảo thần\" thì...năm sau chắc chắn sẽ là một năm sung túc an lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500307,
					"content": "Ơ...sao nhìn ra được thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500308,
					"content": "Ánh sáng rực rỡ của \"tảo thần\" nằm ở sắc trong của nước và sự nuôi dưỡng từ \"nguyện vọng\" của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500309,
					"content": "Ánh sáng thần thánh này chính là biểu trưng cho nguyện vọng của mọi người. Nguyện vọng tốt đẹp thì ánh sáng cũng sẽ tươi tắn hơn, tương lai cũng sẽ có nhiều hi vọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500310,
					"content": "Dẫu sao thì...nguyện vọng của mọi người cũng đều hướng về ngày mai tốt đẹp hơn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500311,
					"content": "Chỉ cần ai cũng có nguyện vọng muốn làm gì đó để cải thiện cuộc sống hiện tại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500312,
					"content": "Thì có lẽ những khó khăn do chiến tranh gây ra cũng không đáng là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500313,
					"content": "Ừm...vậy thì chuyện này có liên quan gì với việc nó có linh nghiệm hay không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500314,
					"content": "Đây chính là trí tuệ của người già chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500315,
					"content": "\"Nguyện vọng\" sẽ thôi thúc và khích lệ người ta hành động, còn kết quả của hành động sẽ nghiệm chứng cho \"nguyện vọng\" của con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500316,
					"content": "Chỉ cần chúng ta tiếp tục giữ gìn hòa bình, chỉ cần bảo vệ niềm hi vọng trong cuộc sống giữa chuỗi ngày đen tối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500317,
					"content": "Thì quẻ bói của \"tảo thần\" sẽ mãi mãi linh nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500318,
					"content": "Có vẻ như đang giải thích qua quýt cho việc mê tín...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "Ha ha, cháu hiểu vấn đề đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500321,
					"content": "À, hiệu lực của \"nguyện vọng\" trong nước vẫn còn được vài ngày nữa, nếu các cháu muốn thì bất cứ lúc nào cũng có thể đến tìm bà để xem bói đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500319,
					"content": "Nhưng cũng không phải không có lý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
