			"dialogs": [
				{
					"id": 721500201,
					"content": "Các cháu về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500202,
					"content": "Chúng cháu đã lấy được thứ bà cần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "Là nước trong Hồ Công Đức, rất trong đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500204,
					"content": "Thật sự cảm ơn các cháu, bà sẽ thêm nước cho \"tảo thần\" ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500205,
					"content": "Nói đến đâu rồi nhỉ...à đúng rồi, còn một bước nữa thì \"tảo thần\" mới phát sáng mạnh mẽ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500206,
					"content": "Chỉ khi ở trong môi trường giàu nguyên tố của vùng nước dưới biển sâu thì lá của \"tảo thần\" mới có thể xòe rộng, và ánh sáng mới có thể hiện lên màu của \"nguyện vọng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500207,
					"content": "Trong một hang động ở phía Bắc có tồn tại nguyên tố thủy có chất nước gần giống với môi trường sinh trưởng của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500208,
					"content": "Hơn nữa ở mỗi khu vực khác nhau trong động thì nồng độ cũng khác nhau...trong đó, nguyên tố thủy có nồng độ lý tưởng nhất sẽ là thứ trong suốt lấp lánh nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500209,
					"content": "Nhưng lỡ như bị vẩn đục...ví dụ như bị các sinh vật khác làm bẩn, thì cũng rất khó xử lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500210,
					"content": "Haiz, bà già rồi, không biết phải giải thích như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500211,
					"content": "Đến lúc đó các cháu tận mắt nhìn thấy thì sẽ hiểu thôi, ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500212,
					"content": "Hang động đó có quan hệ mật thiết với tổ tiên của Làng Bourou...đáng tiếc do chiến tranh nên bây giờ rất ít có thanh niên nào đến đó lấy nước về nuôi dưỡng \"tảo thần\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500213,
					"content": "Haiz...nói đến các thanh niên, hi vọng chúng nó có thể bình an trở về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500214,
					"content": "À, nếu các cháu muốn đến đó lấy nước thì hãy cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500215,
					"content": "Bà Komaki cứ yên tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500216,
					"content": "Chúng cháu sẽ chú ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "Vậy thì tốt...vô cùng cảm ơn các cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
