			},
			"dialogs": [
				{
					"id": 721300101,
					"content": "Chiếc đèn đá có hình dạng đặc biệt, dường như tản ra năng lượng khiến người khác bất an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721300102,
					"content": "Chiếc đèn lồng đá này thật quỷ dị...nó tản ra một mùi đã từng gặp trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300103,
					"content": "Í, hình như có người viết gì đó lên cột đèn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300104,
					"content": "\"Binh sĩ canh giữ, nếu có thắc mắc gì về vật trấn giữ này, hãy đến Hẻm Núi Musoujin nói chuyện với ngài Kaji.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721300105,
					"content": "Nét chữ còn rất mới, nhưng có dấu vết bị ướt mưa. Bên dưới có vài dòng chữ nhỏ nhìn rõ hơn",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721300106,
					"content": "\"Ghi chép của người lạ, đừng tin. Hành quân quan trọng phải thần tốc, đây chắc chắc là kế hoãn binh của kẻ cướp.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721300107,
					"content": "\"Kẻ tự ý rời khỏi đội, sẽ bị phạt nặng!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721300108,
					"content": "Kaji dường như có vẻ rất quan tâm đến đèn lồng đá, chi bằng chúng ta đến Hẻm Núi Musoujin hỏi anh ta đi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
