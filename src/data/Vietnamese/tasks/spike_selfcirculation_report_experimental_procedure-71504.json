			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#Này, {NICKNAME}, chúng tôi vừa đóng gói xong thì bạn tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040202,
					"content": "Gã Sumeru kia chắc đã nói với bạn rồi nhỉ, phải sử dụng khinh khí cầu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040203,
					"content": "\"Gã Sumeru\" gì chứ, Hosseini ở đây giúp chúng ta đối phó với số bùn đen này, là đại học giả của Sumeru, anh không thể tôn trọng người khác chút à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040204,
					"content": "Anh, anh thì biết gì chứ, cách gọi này cũng là cách thể hiện sự thân thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040205,
					"content": "Được rồi, khinh khí cầu chắc chắn có thể sử dụng, và thiết bị làm sạch bùn đen cũng đã sẵn sàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}, nếu bạn cần sự giúp đỡ từ ngôi sao đào khoáng tôi... khụ khụ... khụ khụ... Thôi bỏ đi, có lẽ tôi không giúp được gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040207,
					"content": "Biết là tốt rồi, anh nên nghỉ ngơi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040208,
					"content": "Chậc, tóm lại, nếu bạn bắt đầu vận chuyển thì khởi động khinh khí cầu là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tu"
				}
			]
		},
