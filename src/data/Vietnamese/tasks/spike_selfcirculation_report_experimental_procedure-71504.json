				"points": []
			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "Khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040102,
					"content": "Hosseini, anh làm sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040103,
					"content": "Lúc trước vì tìm cách vận chuyển \"Gai Pursina\" tới chỗ lỗ thông hơi của Địa Mạch trong hầm mỏ, tôi đã ở trong đó quá lâu, nên chịu một chút ảnh hưởng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040104,
					"content": "Nhưng không có gì nghiêm trọng cả, nghỉ ngơi một lát, tôi đã khỏe hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040105,
					"content": "Đồng thời, tôi cũng đã nghĩ ra một giải pháp, chỉ là tìm cách vận chuyển \"Gai Pursina\", sao khó bằng việc kiếm cớ trì hoãn nộp báo cáo nghiên cứu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040106,
					"content": "Bùn đen đã bao phủ khắp mặt đất, vậy chỉ cần lơ lửng một chút, dùng khinh khí cầu đưa vào hầm mỏ để tiến hành vận chuyển là xong ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040107,
					"content": "Nói như vậy, khinh khí cầu thực sự là một phương pháp tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040108,
					"content": "Tất nhiên, mặc dù cách này có thể giải quyết vấn đề của bùn đen ở một mức độ nhất định, nhưng khi có quá nhiều bùn đen chặn lối đi thì vẫn sẽ ảnh hưởng đến tiến độ của khinh khí cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040109,
					"content": "Cộng thêm những con quái vật bị thu hút bởi bùn đen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040110,
					"content": "E rằng chuyện này phải giao lại cho bạn giải quyết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040111,
					"content": "#Yên tâm đi, tôi và {NICKNAME} hợp sức, nhất định sẽ xua đuổi tất cả những con quái vật tới gần khinh khí cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040112,
					"content": "Vậy lát nữa trông cậy vào Paimon rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "Tôi, tôi sẽ cổ vũ bạn là chính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040115,
					"content": "Hahaha khụ khụ, khụ khụ... khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040116,
					"content": "Mới cười một chút mà đã ho đến mức này rồi... Nói chung thì Tu và Hao đang phụ đóng gói \"Gai Pursina\" và chuẩn bị sẵn khinh khí cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040117,
					"content": "Vốn dĩ tôi muốn tự đóng gói \"Gai Pursina\", nhưng mới đứng một lúc thì đã ho khan tới mức run hết cả tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040118,
					"content": "Xấu hổ quá, có vẻ như sau này tôi không chỉ nên nghiên cứu học thuật, mà còn phải chú ý đến việc tập thể dục rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040119,
					"content": "Bạn mau đi tìm họ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040113,
					"content": "Tôi sẽ cho Paimon mượn thanh kiếm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
