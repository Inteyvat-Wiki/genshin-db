				"points": []
			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "Hai bạn dừng lại trên kệ sách bên cạnh...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "Ở đây rất an toàn. Người bạn tóc vàng có chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120305,
					"content": "Không có gì đâu, tôi chỉ hơi tò mò thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "Ở đây, giàn gỗ rất cao, tầm nhìn thoáng đãng, là nơi ẩn náu tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120309,
					"content": "Ở ngôi{RUBY#[D]bộ tộc} nhà lớn của tôi, việc ở trên mặt đất là rất nguy hiểm. Cho dù chúa{RUBY#[S]Lãnh Chúa Tối Cao} tể ở trên đầu chúng tôi không đột nhiên nổi hứng giết chóc, thì những kẻ cướp bóc từ các ngôi{RUBY#[D]bộ tộc} nhà lớn khác cũng sẽ đến cướp phá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120310,
					"content": "Chỉ còn cách sống như loài chim đuôi seo, trú ngụ trên vách đá và tán cây, mới có thể trốn thoát và sống sót khi tai họa ập đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120311,
					"content": "Hơn nữa, Vindia nói muốn xem tôi bay. Vì cô ấy muốn h{RUBY#[D]viết}át về câu chuyện mạo hiểm cưỡi trên lưng chú chim khổng lồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120312,
					"content": "Thật sự không phải bị cô ấy lừa đấy chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "Không phải đâu. Vindia là người tốt. Chắc là tốt như Chủ Nhân Ngã Tư Đường vậy. Đều rất dịu dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120314,
					"content": "Nhưng mà hai người bay rất cao. Rất giỏi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120315,
					"content": "Cái này tặng cho hai người, là minh chứng cho tình bạn. Tôi phải nghĩ xem làm sao để bay cao hơn, để không bị đuổi kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120316,
					"content": "Tuy ở đây không có những chúa{RUBY#[S]Lãnh Chúa Tối Cao} tể cao quý, cũng không có kẻ chinh phục thích lột da, rất an toàn, nhưng tôi đã quen với việc tìm đường lui trước rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120306,
					"content": "Tôi lo cô bị mắc kẹt trên đó không xuống được thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "Cảm ơn nhé. Nhưng mà, tôi không bị mắc kẹt đâu. Ở nơi cao, rất an toàn, sẽ không bị sát hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "Quiauhquetzal"
				}
			]
		}
	]
}