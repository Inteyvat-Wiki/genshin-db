				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "Chào Nhà Lữ Hành, nhìn mặt của bạn... chắc là đến đây để tham dự Hội Chợ Trí Tuệ đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960102,
					"content": "Nếu có hứng thú thì hãy trải nghiệm thử sự kiện của Học Phái Haravatat chúng tôi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960103,
					"content": "Tôi nhớ ngành mà Haravatat nghiên cứu là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "Nói tóm lại cho dễ hiểu thì là... \"ngôn ngữ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960105,
					"content": "Đây chính là thứ mà Học Phái Haravatat chúng tôi nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960106,
					"content": "Thế nào? Có phải mới nghe là thấy rất hợp với bầu không khí của Hội Chợ Trí Tuệ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960107,
					"content": "Rất nhiều bạn học trong học viện đều nghĩ thế, mọi người đều chơi rất nhiệt tình, nên chúng tôi không thể chỉ tổ chức giải đố được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960108,
					"content": "Hơn nữa kiểu trò chơi giải đố này thì không thể khiến người ta thấy hứng thú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960109,
					"content": "Sau những ngày thảo luận... ôn hòa, chúng tôi đã nghiên cứu ra một trò chơi nhỏ có tên là \"Truy Tìm Chân Tướng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960110,
					"content": "Loại trò chơi nhỏ này không cần nhiều đạo cụ, chỉ cần suy nghĩ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960111,
					"content": "Khi bắt đầu trò chơi, tôi sẽ kể cho bạn nghe một câu chuyện. Câu chuyện này nghe sẽ không đầu không đuôi, có nhiều chỗ còn khá phi lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960112,
					"content": "Bạn có thể \"Đặt Câu Hỏi\" cho tôi, và tôi sẽ trả lời là <color=#00E1FFFF>\"Đúng\"</color>, <color=#00E1FFFF>\"Không\"</color> và <color=#00E1FFFF>\"Không Liên Quan\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960113,
					"content": "Việc mà bạn cần làm, chính là \"Đặt Câu Hỏi\" để tìm ra \"Chân Tướng\" của câu chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960114,
					"content": "Nhưng cũng đừng căng thẳng quá, câu chuyện này sẽ không quá phức tạp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960115,
					"content": "Thế nào? Nếu như có hứng thú thì chúng ta bắt đầu nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960116,
					"content": "Vậy thì bắt đầu đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "Được thôi, mời bạn lắng nghe câu chuyện thứ nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960118,
					"content": "Còn bận việc khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "Trong thời gian này tôi sẽ luôn ở đây, bạn có thể đến bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				}
			]
		}
	]
}