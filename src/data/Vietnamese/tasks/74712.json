			"dialogs": [
				{
					"id": 747120101,
					"content": "#Chia sẻ tin tốt nhất với {NICKNAME} và Paimon đây, mọi vấn đề đều được giải quyết xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120102,
					"content": "Chiến dịch giải cứu cá hung hăng đã thành công rực rỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120103,
					"content": "Đợi khi bên thợ lặn xử lý xong hết đồ lặt vặt dưới nước, và những con cá bị bệnh bình tĩnh thêm một chút nữa, thì chúng ta có thể cho chúng trở về môi trường ban đầu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120104,
					"content": "Mọi người vất vả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "Hihi, đây là thành quả mà chúng tôi và Sigewinne cùng nỗ lực đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120106,
					"content": "Tôi đã viết báo cáo về sự kiện lần này và nộp cho Palais Mermonia. Chắc sẽ có chuyên viên soạn thảo các quy định liên quan và thông báo cho các cơ quan tương ứng sớm thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120107,
					"content": "Ngoài ra, tôi nghe nói còn có vài phóng viên và đạo diễn cũng rất quan tâm đến chủ đề liên quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120108,
					"content": "Biết đâu sau này chúng ta còn được xem những bộ phim với chủ đề bảo vệ môi trường nước nữa thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120109,
					"content": "Ừm, nếu chỉ giảng đạo lý bình thường thì mấy tên cứng đầu... hoặc lơ đãng sẽ chẳng nghe lọt tai đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120110,
					"content": "Quay kiểu thật đáng sợ vào... Nói rằng khi môi trường bị phá hoại nghiêm trọng... đàn cá sẽ bị đột biến thành quái vật siêu to khổng lồ phá phách khắp nơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120111,
					"content": "Để những người có thói quen vứt rác xuống nước gặp ác mộng, hiệu quả giáo dục chắc chắn sẽ rất tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120112,
					"content": "Vậy thì tuyệt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		}
	]
}