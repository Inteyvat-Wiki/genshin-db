			"dialogs": [
				{
					"id": 715070101,
					"content": "Hiệu quả này tốt hơn tôi tưởng, tất cả các hiện tượng và dữ liệu đã được ghi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070102,
					"content": "Hơn hết, bùn đen ở đây thật sự đã được dọn sạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070103,
					"content": "Có điều, ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070104,
					"content": "Sao vẫn có vẻ không vui thế, chẳng lẽ khu mỏ được dọn sạch không phải chuyện tốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715070105,
					"content": "Để tôi nghĩ lại đã, lúc trước, tôi và Khedive phân tích đã cho rằng lỗ thông Địa Mạch tràn ra bùn đen hẳn là ở khu mỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070106,
					"content": "Lỗ thông Địa Mạch không thể dọn dẹp dễ dàng như vậy, nên thật ra nó ở một nơi khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070107,
					"content": "Trừ khu mỏ ra, khu vực bị bùn đen lan ra ảnh hưởng chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070108,
					"content": "Đường mỏ phía trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "Đúng vậy... Cho thấy rằng lỗ thông Địa Mạch có bùn đen tràn ra nằm ở khu vực đường mỏ, đường mỏ ở đây lại càng hẹp hơn, khiến bùn đen dễ tích tụ và thu hút quái vật hơn, tạo thành vấn đề nghiêm trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070110,
					"content": "Nhưng tôi tin \"Gai Pursina\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070111,
					"content": "Đây là dụng cụ vĩ đại do tiền bối Pursina chế tạo ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070112,
					"content": "Có điều tôi phải sửa chữa trước, sau đó chờ những công nhân hầm mỏ kia xuống chuyển Gai vào đường mỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
