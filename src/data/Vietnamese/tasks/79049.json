			"dialogs": [
				{
					"id": 790490101,
					"content": "Không ngờ nhật ký lại được cất giấu ở một nơi kín đáo thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790490102,
					"content": "Hóa ra phiến đá khổng lồ ở bên ngoài chính là bảng vẽ mà Idyia dành cho vị họa sĩ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790490103,
					"content": "Xem ra anh ấy đã tìm thấy cảnh đẹp trong Ảo Cảnh Veluriyam rồi, lại còn bầu bạn với Giọt Nước Nhỏ và có cảm hứng sáng tác mới nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790490104,
					"content": "Cuộc gặp gỡ này thật là may mắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "Ừm! Đúng là có một số người cố chấp, khi bị đả kích liền điên cuồng gượng ép bản thân. Sau cùng lại trở nên không bình thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "Đọc"
				},
				{
					"id": 790490107,
					"content": "May nhờ có những Giọt Nước Nhỏ ở bên cạnh vị họa sĩ và Idiya cung cấp dụng cụ, nên anh ấy đã không lạc lối!",
					"roleType": "TALK_ROLE_NPC",
