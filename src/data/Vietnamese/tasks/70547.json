					"Valerina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "Woa, là Cứu Tinh Mèo và Phù Thủy Mèo Trắng! Không ngờ hai người cũng đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "Ủa? Cô vừa gọi chúng tôi là gì cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "Nghe quen quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "Ưm... Tôi cứ cảm thấy hình như chúng ta đã từng gặp nhau ở đâu rồi thì phải?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "Haha! Phù Thủy Mèo Trắng vẫn còn ấn tượng về tôi à. Tôi là Valerina đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "Chuyện cũ có thể để sau hẵng nói. Bây giờ có muốn thử trò chơi mới mà tôi tài trợ không? Nó khiến tôi vui vẻ cả tuần đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "Dodoco Đại Loạn Đấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "Woa! Có nhiều Dodoco quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "Hơn nữa mỗi loại cũng đều rất quen mắt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "Nhìn xem, Cứu Tinh Mèo... Khụ, phải nói là, Kỵ Sĩ Danh Dự đáng kính tỏa sáng lấp lánh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "#Con búp bê Dodoco này đã được thiết kế theo hình tượng của {F#cô}{M#cậu} đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#Đúng nhỉ. Màu sắc và hoa văn đều là phong cách của {NICKNAME} mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "Trong trò chơi, Dodoco Tia Lửa, Dodoco Lấp Lánh, Dodoco Kỵ Binh và Dodoco Phép Thuật phải hợp tác ăn ý, dùng bom để chiến thắng những kẻ địch chưa từng thấy trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "Tôi chỉ phụ trách tài trợ và vận hành trò chơi thôi, không hiểu chi tiết việc phát triển, cũng không biết nguyên mẫu của những kẻ địch này trông như thế nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "Nhưng tôi tin rằng, dù ngày nào đó thật sự gặp phải, thì Dodoco tuyệt vời nhất định sẽ đánh bại được chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "Đương nhiên rồi! Bất kỳ ma vật nào cũng không ngăn được Klee và Dodoco mà. Chúng tôi cũng cảm thấy như vậy đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "Vậy thì thử xem sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Hihi, hai người chắc chắn cũng sẽ cảm nhận được là nó rất vui thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "Trò chơi Dodoco mới!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Nguyên mẫu thì rõ ràng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "Biệt danh mới mẻ thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
