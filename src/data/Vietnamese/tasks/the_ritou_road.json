			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harrison"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "Cảm ơn, cảm ơn bạn nhiều lắm, Nhà Lữ Hành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090205,
					"content": "Nếu không có bạn giúp đỡ, hôm nay tôi kiểu gì cũng gục ở đây mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090206,
					"content": "Doanh trại này là của bạn xây dựng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "Ừm...có thể xem là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090210,
					"content": "Các bạn cũng biết đấy, làm ăn buôn bán trên đảo Ritou không dễ dàng, doanh trại này...xem như là một bí quyết nhỏ để tôi kinh doanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090211,
					"content": "Dạo trước tôi nhờ một...người bạn, mang một lô nguyên liệu ủ rượu từ Mondstadt tới đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090212,
					"content": "Trước đó không lâu anh ấy nhờ một người bạn lấy một lô hàng mới thử nghiệm từ chỗ Tửu Trang Dawn, mấy ngày nay vừa chuyển qua đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090213,
					"content": "Nhưng tên đó tay chân vụng về, làm hư hỏng hết rồi, nắp của một bình nguyên liệu ủ rượu xếp bên trong cũng rời ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090214,
					"content": "Tôi định mở nắp ra rồi đóng gói lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090215,
					"content": "Không ngờ tôi vừa mở nắp ra thì một đống Slime xông tới, chẳng hiểu tại sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090216,
					"content": "Nguyên liệu ủ rượu của Tửu Trang Dawn sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "Thôi bỏ đi, tạm gác lại đã, chuyện nguyên liệu ủ rượu chờ lần sau tên đó tới đây tôi sẽ tính sổ với hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090218,
					"content": "Các bạn đã cứu tôi, tôi phải tặng các bạn món quà cảm ơn mới phải...Những thứ này các bạn nhận giúp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090219,
					"content": "Ngoài những thứ này ra, các bạn có nhìn thấy con thuyền nhỏ bên kia chứ? Đó là...một bí quyết khác của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090220,
					"content": "Dùng con thuyền đó, các bạn sẽ có thể âm thầm tới đảo Narukami, hi hi, có phải rất tiện không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090221,
					"content": "Tại sao tôi phải \"âm thầm\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "Haiz, tóm lại là...để chuẩn bị cho lúc cần mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090223,
					"content": "Được rồi, tôi còn phải về kiểm kê hàng hoá, không ở đây thêm nữa, cảm ơn bạn lần nữa nhé, Nhà Lữ hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090224,
					"content": "Xem ra tôi phải đổi nơi nhận hàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090208,
					"content": "Bạn ở đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "Tôi...tôi đang chuyển hàng, ha ha ha, chuyển hàng ấy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				}
			]
		}
	]
