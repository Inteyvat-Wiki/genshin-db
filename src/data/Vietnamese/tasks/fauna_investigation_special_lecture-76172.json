			"dialogs": [
				{
					"id": 761720101,
					"content": "Sáng lấp lánh như Mora vậy, đúng là vua cá chạch vàng trong giới cá chạch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720102
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720102,
					"content": "Mora? Ở đâu có Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720103
					]
				},
				{
					"id": 761720103,
					"content": "Tôi hình như còn nghe thấy vàng gì đó nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720104,
					"content": "Ừm! Thực ra đợt trước lúc điều tra ở phía Bắc, tôi phát hiện ra một con Cá Chạch Kim có màu sắc khác biệt, ở khu vực đó chỉ có một con có màu khác biệt như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720105,
					"content": "Hiện tại trạng thái của nó khá tốt, tôi cũng đã tìm bác sĩ am hiểu về sinh thái động vật để kiểm tra rồi, có lẽ không phải là sự thay đổi màu sắc do bệnh lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720106
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720106,
					"content": "Vậy tại sao màu sắc của nó lại khác biệt như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720107,
					"content": "Nguyên nhân có thể có rất nhiều, ví dụ như môi trường sống, bao gồm nguồn nước và khí hậu... À đúng rồi, còn cả loại thức ăn mà chúng nạp vào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720108
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720108,
					"content": "Nhưng nếu hỏi rốt cuộc là nguyên nhân đặc biệt gì thì tôi cũng không trả lời được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720109,
					"content": "Linnea cũng có lúc không tìm hiểu đến tận cùng à.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720110
					]
				},
				{
					"id": 761720110,
					"content": "Vì đây là hiện tượng rất ngẫu nhiên mà! Chỉ riêng việc gặp được thôi cũng đã rất may mắn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720111,
					"content": "Chỉ cần được ghi chép lại phát hiện này, rồi đưa ra vài suy luận và giả thuyết, tôi đã thấy thỏa mãn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720112,
					"content": "Giống như Cá Voi Vây Sương màu hồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720113,
					"content": "Mọi người đều nói rằng nếu có cơ hội được nhìn thấy Cá Voi Vây Sương màu hồng, thì điều ước sẽ thành hiện thực, nhưng thực sự rất khó để gặp được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720114
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720114,
					"content": "Nhưng chúng em đã từng nhìn thấy, cùng với chị Linnea. Em nghĩ có lẽ là chị Linnea đã mang lại may mắn cho chúng em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720115
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720115,
					"content": "#Woa, {NICKNAME}, có cơ hội chúng ta cũng tìm thử xem! Tôi có rất nhiều điều ước luôn, không biết nên ước điều nào trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720116,
					"content": "Chỉ khác màu thôi mà lại có năng lực thần kỳ vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720117
					]
				},
				{
					"id": 761720117,
					"content": "Chỉ là một loại mong ước tốt đẹp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720118
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720118,
					"content": "Vậy là không có năng lực thần kỳ gì à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720119,
					"content": "Đúng là có những trường hợp như vậy, cá thể với màu sắc đặc biệt thường sở hữu năng lực khác biệt, nhưng con Cá Voi Vây Sương kia có lẽ không phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720120
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720120,
					"content": "Nếu chỉ cầu nguyện với nó thì không sao... Chỉ sợ có người vì thế mà làm tổn thương nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720121,
					"content": "Hả? Có cả chuyện này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720122,
					"content": "Em biết! Trước đây nghe cô Katya kể, có một số thợ săn kho báu xấu xa sẽ săn bắt những con vật có màu sắc đặc biệt để bán cho các nhà sưu tập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720123
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720123,
					"content": "Ừm, có một thời gian động vật ở Natlan rất được săn đón ở chợ đen, không chỉ động vật sống, xương và da lông cũng rất được ưa chuộng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720124,
					"content": "Một số thương nhân để bán được hàng buôn lậu với giá cao, thậm chí không ngại gia công và cải tạo, biến chúng thành một loại \"ảo tưởng\" rồi bán cho khách hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720125,
					"content": "Từng xảy ra chuyện như thế này, những kẻ săn trộm đã loại bỏ chân của Qucusaur khi làm tiêu bản để trông đẹp mắt và dễ dàng vận chuyển hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720126
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720126,
					"content": "Mà nhà sưu tập chưa từng thấy Qucusaur thật sự lại nghĩ rằng loài này sinh ra đã không có chân, chúng bay lượn trên không suốt đời, sống nhờ gió và sương, và xem đó như một điều thần kỳ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720127,
					"content": "Sự săn đón dồn dập của họ lại vô tình tiếp tay cho hành vi tội ác của bọn săn trộm, một chuỗi buôn lậu sinh ra từ lòng tham và dối trá đã gây ra biết bao tổn thương và đau khổ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720128
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720128,
					"content": "Ya-ho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720129
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761720129,
					"content": "Trong vô số hành vi xấu xa, dù chỉ là việc nhuộm màu tưởng chừng nhẹ nhàng nhất, suy cho cùng vẫn là điều không tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720130
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720130,
					"content": "Vậy... vậy chúng ta cần tắm cho nó không? Con Capybara màu bạc kia, nó cũng bị bọn xấu nhuộm thành màu này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720131
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720131,
					"content": "Không cần đâu, lúc phát hiện ra nó thì nó đang ngâm mình trong nồi của đám Hilichurl, chắc nó tưởng đang ngâm suối nước nóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720132
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720132,
					"content": "Nó chắc là cá thể rất hiếm, bẩm sinh đã có màu lông này, cũng có lẽ vì thế nên mới bị đám buôn lậu bắt cóc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720133
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720133,
					"content": "Cảm giác như... hoàn toàn có thể tưởng tượng ra hình ảnh Capybara nằm ngâm mình trong nồi nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720134,
					"content": "Đúng không? Tuy màu sắc khá đặc biệt, nhưng bản tính thì vẫn giống các Capybara khác thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720135
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720135,
					"content": "Nói ra thì, trước đây chúng em cũng từng bắt được Chồn Đạo Bảo màu trắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720136
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720136,
					"content": "Đó là tên trộm Mora! Phải rồi, bây giờ nó thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720137,
					"content": "Đã thả về rồi. Hy vọng nó cũng học được bài học, đừng đến gần cơ sở nghiên cứu của Fatui nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720138
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720138,
					"content": "Khác với Capybara, sự thay đổi màu lông của nó có lẽ do yếu tố bên ngoài, rất có thể là do tiếp xúc với môi trường có nồng độ Kuuvahki quá cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720139
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720139,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720140,
					"content": "Xem ra \"đặc biệt\" cũng không hoàn toàn là điều tốt nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720141,
					"content": "Nghĩ đến việc vài cá thể trong số chúng có thể gặp phải bất hạnh vì quá \"đặc biệt\", hoặc chính vì những điều bất hạnh mà trở nên \"đặc biệt\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720142,
					"content": "Mặc dù nói thế này có vẻ hơi ích kỷ, nhưng nếu không phải vì Lumi cũng là Sương Linh \"đặc biệt\", thì có lẽ chúng tôi đã không thể trở thành đồng đội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720143
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720143,
					"content": "Ya-ho! Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720144
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761720144,
					"content": "Nhưng mà trông nó hình như chẳng có ý kiến gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720145
					]
				},
				{
					"id": 761720145,
					"content": "Vậy cũng không hẳn là chuyện xấu phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720146
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720146,
					"content": "Nếu \"đặc biệt\" mang lại những cuộc gặp gỡ tuyệt vời, đương nhiên là điều tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720147,
					"content": "Hơn nữa, em nhớ trong lá thư Helka gửi về có nhắc đến, Liyue có một câu tục ngữ gì đó, phúc gì họa gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720148
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720148,
					"content": "Là \"trong họa có phúc, trong phúc có họa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720149
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720149,
					"content": "Ồ, đúng là câu này! Nói chứ, chị là giáo viên mà, sao lại có thể ủ rũ trong giờ học được, hãy lấy lại tinh thần nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720150
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720150,
					"content": "Không ngờ cũng có ngày được Mikko động viên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720151
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720151,
					"content": "Thì, thì là vì nể tình trước đây chị cũng là thành viên Bang Ốc Biển đó! Thôi, mấy đạo lý phức tạp đó để sau, giờ hãy kể cho chúng em nghe về Volkodlak đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720152
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720152,
					"content": "Họ thực sự mạnh đến vậy sao? So với Snegovik và Leshy thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720153
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720153,
					"content": "Ừm, Volkodlak cũng có rất nhiều câu chuyện thú vị để kể đấy, nhưng mà... để dành lần sau vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720154
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720154,
					"content": "Lại là lần sau nữa à? Vậy lần sau nhất định phải kể nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikko"
				}
			]
