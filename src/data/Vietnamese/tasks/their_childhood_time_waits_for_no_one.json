			"dialogs": [
				{
					"id": 240040401,
					"content": "#Lại bị tìm ra rồi... Ấy? {M#Anh}{F#Chị} là ai vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040402,
					"content": "Là bạn của Aurele và Verut đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "#Ồ! Em có nghe mọi người nhắc về {M#anh}{F#chị}, Verut còn nói {M#anh}{F#chị} chơi trốn tìm rất giỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040404,
					"content": "#Hôm nay coi như đã tận mắt chứng kiến, {M#anh}{F#chị} quả nhiên rất lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040405,
