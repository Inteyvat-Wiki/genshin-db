					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Verut trèo tường rất nhanh, lại khỏe nữa, có nhiều chỗ là cậu ấy đã kéo em lên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
