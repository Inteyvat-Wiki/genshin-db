			"dialogs": [
				{
					"id": 240040201,
					"content": "...Trang này hình như mình từng xem rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040202,
					"content": "Em đang... đọc sách à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "#Không ngờ {M#anh}{F#chị} đến nhanh thế, em mới chỉ vừa mở cuốn sách này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040205,
					"content": "Cuốn sách này là bố của Lovi nhờ Lovi cầm đến cho em, còn nói nếu em có chỗ nào không hiểu thì có thể đi hỏi chú ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040206,
					"content": "Nhưng mà... haha, thú thật quyển sách này em hầu như không thể hiểu nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040207,
					"content": "#Không nói chuyện này nữa, em sẽ về điểm tập trung. Dù sao thì em cũng bị {M#anh}{F#chị} bắt được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040203,
					"content": "Đúng là em rất thích học nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
