			"dialogs": [
				{
					"id": 240040501,
					"content": "Cả hai... sao lại nhìn anh như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040502,
					"content": "Anh Aurele... Không phải anh lại trốn ở đâu để lén đọc sách chứ? Không nghiêm túc chơi với tụi em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "Đúng đó, nghiêm túc đi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Vị trí đẹp đều bị cả hai chiếm hết rồi, anh lại không giỏi chơi trốn tìm... nên đành phải đọc sách giết thời gian thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040505,
					"content": "Hứ! Anh Aurele lừa đảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "Hừ! Chỉ thích đọc sách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "Cả hai tha cho anh đi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
