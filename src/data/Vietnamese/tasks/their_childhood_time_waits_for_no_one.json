					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Anh! Chúng ta trốn ở bên kia đi, chắc chắn sẽ có chỗ tốt hơn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "Đừng chạy lung tung, Verut! Nếu em chạy lạc thì anh không có cách tìm em về đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040103,
					"content": "Sao em lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "#Woa! {M#Anh trai}{F#Chị gái}! {M#Anh}{F#Chị} có rảnh không? Mau đi trốn với tụi em đi, Lovi chắc đã trốn xong từ lâu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "Về Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "Không kịp nói đâu, mau mau, bạn ấy rất rành về nơi này... Chúng ta phải tìm một chỗ tốt hơn để trốn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut chớp mắt đã biến mất...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "Haiz, Verut không biết khi nào mới chịu nghe lời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040110,
					"content": "#Xin lỗi, phiền {M#anh}{F#chị} chơi với tụi em nhé. Không biết sao Verut lại đột nhiên có hứng thú vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040111,
					"content": "Chắc do tìm được bạn mới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "Em cũng thấy vậy, nhưng mà... Verut vui là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040113,
					"content": "Mà không biết có khi nào vui quá mà cùng Lovi trốn ở những nơi kỳ lạ không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040118,
					"content": "#{M#Anh trai}{F#Chị gái}, đành phải nhờ {M#anh}{F#chị} chơi thêm một lượt nữa với tụi em rồi. Phiền {M#anh}{F#chị} quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040119,
					"content": "Vậy em cũng phải đi tìm chỗ trốn, nếu không Verut sẽ không vui. Nếu em ấy mà khóc ngay trên đường thì em cũng hết cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040120,
					"content": "Aurele đã rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "Về Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "Là một bạn nữ mới quen. Thấy tụi em chơi trốn tìm cũng đòi tới chơi cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040116,
					"content": "Tính cách của bạn ấy và Verut khá giống nhau, cho nên cả hai chơi rất thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040117,
					"content": "Có điều, bố của Lovi hầu như không có thời gian chơi với bạn ấy, chuyện này thì cũng giống hai đứa bọn em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040104,
					"content": "Mấy đứa vẫn đang chơi trốn tìm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
