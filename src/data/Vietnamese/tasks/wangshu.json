			"dialogs": [
				{
					"id": 10030401,
					"content": "Về tiên nhân kia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "Ồ? Các bạn đã gặp Xiao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030403,
					"content": "Không tồi, hiếm khi cậu ấy có tâm trạng tốt, lại đồng ý ra gặp người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030404,
					"content": "Hóa ra thái độ như vậy đã là \"tâm trạng tốt\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030405,
					"content": "Đúng vậy, tiên duyên khó cầu, rất nhiều người thật lòng đến thăm viếng tiên nhân, cho đến cuối đời vẫn chưa 1 lần được gặp tiên nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030406,
					"content": "Khi Nham Thần kiến lập Liyue, đã nhờ đến sức mạnh của tiên nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030407,
					"content": "Nhưng bởi vì đại đa số tiên nhân đều không biết chiến đấu để bảo vệ Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030408,
					"content": "Do đó hàng ngàn năm nay, con người vẫn nắm giữ việc vận hành thủ đô thương mại, còn tiên nhân ẩn cư đứng ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030409,
					"content": "Bà chủ thật hiểu rộng biết nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030410,
					"content": "Không phải \"vợ ông chủ\", là \"chủ quán\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030411,
					"content": "Tóm lại, các bạn đã có tiên duyên như vậy thì sự việc dễ giải quyết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030412,
					"content": "Muốn hỏi ý kiến của tôi hả... ừm, thực ra chỉ cần thử dỗ Xiao vui vẻ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030413,
					"content": "Vui...? Rất khó để tưởng tượng vị \"Hộ Pháp Dạ Xoa\" đại nhân đó vui lên sẽ như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030414,
					"content": "Hừm, thật mong đợi ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030415,
					"content": "(Thực sự tôi cũng chưa từng thấy cậu ta cười...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030416,
					"content": "Thế này đi, đi tìm đầu bếp lấy một phần đậu hũ hạnh nhân trước, thêm một món sở trường của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030417,
					"content": "Đậu hũ hạnh nhân là món nhân gian mà Xiao yêu thích, món sở trường thì dựa vào sự cố gắng của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030418,
					"content": "#Ừm, tự cố gắng... {NICKNAME}, sở trường của bạn là món gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030419,
					"content": "Gỏi Mãn Nguyện",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "Là loại thực phẩm khó xảy ra sai sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030423,
					"content": "Nhưng, để tặng quà cho tiên nhân vẫn nên bảo thủ một chút, dùng Gỏi Mãn Nguyện được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030421,
					"content": "Đại Hồng Liên Tê Cay Slime Hỏa",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "Oa, nghe có vẻ rất mới lạ, muốn ăn thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				}
			]
		},
