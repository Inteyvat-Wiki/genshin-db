			"dialogs": [
				{
					"id": 10030601,
					"content": "Đại gia ta đang nghỉ ngơi, xin đừng làm phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030602,
					"content": "Xin hỏi, đậu hũ hạnh nhân...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Xin đừng làm phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030604,
					"content": "Ồ... Sự nhiệt tình của vị đầu bếp này, với thợ sắt Wagner ở Mondstadt không kém là bao nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030605,
					"content": "Món ăn do bà chủ Goldet gọi đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030607,
					"content": "Hóa ra là thế. Việc mà bà chủ căn dặn, vậy thì không có cách nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030608,
					"content": "Nhưng rất tiếc, tôi có tâm mà không có lực, không thể làm ra món đậu hũ hạnh nhân ngọt ngào tinh tế",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030609,
					"content": "Vì sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030610,
					"content": "Tay của kiếm khách nhất định phải ổn định, đầu bếp chúng tôi cũng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030611,
					"content": "Mà tay của tôi bây giờ, thật xin lỗi... có chút không ổn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030612,
					"content": "Lý do... là bởi có khách đồn đại, ở quán trọ... có ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 10030613,
