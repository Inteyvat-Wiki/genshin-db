			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "Hay quá, vậy là đủ rồi, cảm ơn nhé. Nếu không có bạn giúp thì tôi phải tự mình đi giải quyết đám ma vật đó mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260302,
					"content": "Nếu như vậy thì tôi không biết đến khi nào mới nhớ được chuyện phải đi thu thập \"Tú Cầu Anh Đào\" nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260303,
					"content": "Cảm ơn bạn đã giúp tôi, phần \"Xiên Thịt Gà Nấm\" này tặng bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260304,
					"content": "Giờ tôi sẽ mang \"Tú Cầu Anh Đào\" này về cho Xudong. Không biết anh ấy sẽ làm món gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		}
