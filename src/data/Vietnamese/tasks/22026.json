				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "Hừm...phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "Julie? Sao bạn lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "Ấy! Nhà lữ hành, không ngờ lại gặp bạn ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "Tôi đến đây để tìm thức ăn, Xudong lại nghiên cứu ra được món ăn mới rồi, Parvaneh thì đang góp ý bên cạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong nói, anh ta muốn kết hợp món \"Dango Ba Màu\" của Inazuma để làm thành một loại thức ăn mềm và ngọt, nhưng cần vài nguyên liệu đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "Chú Munehisa thì vào thành để mua Dưa Tím rồi, tôi đến đây để thu thập một số \"Tú Cầu Anh Đào\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "Tuy tôi tìm được một ít rồi nhưng vẫn chưa đủ, tôi muốn qua kia tìm thêm thì bên đó toàn là ma vật thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "Nhà lữ hành, bạn có thể giúp tôi thu thập 3 \"Tú Cầu Anh Đào\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "Cảm ơn bạn! Đợi bạn quay về tôi sẽ mời bạn ăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "Đám ma vật đó chắc đâu làm khó được bạn đâu nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "Thông thường mà nói thì là như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "Nhưng nói sao nhỉ, nếu tôi giao đấu với chúng thì tôi sẽ quên mất bản thân cần phải làm gì mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "Ở Mondstadt cũng vậy, dù cho nhận ủy thác gì, khi giao đấu với ma vật xong là tôi đều quên sạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "Cho đến khi tiêu diệt hết chúng một thời gian sau tôi mới nhớ ra...nhưng lúc đó không thể giao ủy thác nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "Bạn ghét ma vật nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "Ghét ma vật? Đó không phải là nguyên nhân chủ yếu, thực ra...thực ra tôi cảm thấy khá thú vị khi chiến đấu với chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "Cái cảm giác quên đi tất cả để đánh bại chúng rất thú vị, bạn cũng từng trải qua chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "Ấy, không nói nữa, chuyện thu thập \"Tú Cầu Anh Đào\" tôi trông cậy vào bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "Đợi bạn quay về tôi sẽ mời bạn ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
