			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "Các bạn đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320102,
					"content": "Tìm được manh mối chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "Ừm. Lần này may nhờ có hội trưởng Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320104,
					"content": "Theo \"suy diễn logic\" của cô ấy, cơ bản đã xác định được vài địa điểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320105,
					"content": "Hiện giờ, có một doanh trại do con \"Chó Đội Nón\" hôm qua canh giữ, phải ứng phó hết sức thận trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320106,
					"content": "Có vẻ như biệt danh này là do Paimon đặt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "Này! Paimon không thèm đặt biệt danh như vậy đâu. Nếu là tôi đặt, thì sẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320108,
					"content": "Ừm... gọi là \"Chó Ngoạm Kiếm\" đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320109,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320110,
					"content": "Tóm lại, tôi đã đặt một số cơ quan tương tự ở đó. Hy vọng lần này cũng hiệu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320111,
					"content": "Ơ! Bị bơ luôn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320112,
					"content": "Vậy thì nhờ các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320113,
					"content": "Còn vấn đề gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320114,
					"content": "Địa điểm đáng tin cậy không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "Tuyệt đối đáng tin cậy. Dù sao tôi cũng từng đi khảo sát thực địa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320116,
					"content": "Sao lần này Ryuuji không đi cùng vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320117,
					"content": "Mặc dù tôi cũng rất muốn đi cùng các bạn, nhưng không may hôm nay hội trưởng Sango lại sắp xếp cho tôi nhiệm vụ khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320118,
					"content": "Nói chung, cô ấy cũng có một vài suy nghĩ về lai lịch của con \"Chó Đội Nón\" đó. Nên nhờ tôi đi điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320119,
					"content": "\"Chó Ngoạm Kiếm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320120,
					"content": "\"Chó Đội Nón\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320121,
					"content": "\"Chó Ngoạm Kiếm Đội Nón\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "Kỳ cục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320123,
					"content": "Đây là biệt danh gì vậy, kỳ cục quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320125,
					"content": "...Bỏ đi, cứ gọi nó là \"bóng đen\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320126,
					"content": "Dù thế nào đi nữa, bọn thú nhỏ nhờ cả vào bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320124,
					"content": "Đừng tranh cãi nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "Vất vả cho các bạn rồi. Để tôi xem...số lượng vẫn chưa đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320302,
					"content": "Bọn thú nhỏ bị mất nhiều như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320303,
					"content": "Đúng vậy. Theo ủy thác mới nhận, chúng ta đã tìm được khoảng một nửa số thú nhỏ bị mất tích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320304,
					"content": "Chỉ tiếc là bây giờ cũng không có thêm manh mối gì. Nhưng không sao, vật sống vẫn dễ điều tra hơn những vật vô tri vô giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320305,
					"content": "Lúc trước tôi từng giúp các gia đình lớn tìm lại đồ bị trộm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320306,
					"content": "Từng nhiều lần mất manh mối, may nhờ có suy luận của hội trưởng Sango, cuối cùng mới tìm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320307,
					"content": "Có thể nói cụ thể hơn không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "Có vẻ rất thú vị, mau nói đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320309,
					"content": "Không ngờ các bạn cũng có hứng thú với việc điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320310,
					"content": "Thật ra lúc đó chúng tôi đã xác định được nghi phạm. Nhưng lại không tìm được tang vật ở nhà hắn, và cũng không có manh mối khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320311,
					"content": "Sau đó, khi tôi đang thăm dò bên ngoài thì vô tình nghe được, một ngày trước nghi phạm có bán Cỏ Naku. Tôi đến nhà người mua xem và thấy Cỏ Naku còn tươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320312,
					"content": "Sau khi hội trưởng Sango nghe nói thì lập tức bảo tôi đến khu vực chân núi Yougou điều tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320313,
					"content": "Ơ? Tại sao lại là Núi Yougou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320314,
					"content": "\"Trước hết, nghi phạm sống trên Đảo Narukami. Mặc dù rất nhiều nơi ở Inazuma đều có Cỏ Naku, nhưng nếu người bình thường muốn đến đảo khác thì phải đi bằng thuyền, nhưng chúng ta không tìm thấy chiếc thuyền nào.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320315,
					"content": "\"Hơn nữa, Hiệp Hội Tenryou rất nhạy cảm với tàu thuyền do lệnh bế quan tỏa cảng, nếu hắn có ý định phạm tội, chắc chắn sẽ không lộ mặt trước Hiệp Hội Tenryou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320316,
					"content": "\"Vì vậy cơ bản có thể loại bỏ những đảo khác.\" Hội trưởng Sango nói vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320317,
					"content": "Nhưng gần Đền Narukami cũng có Cỏ Naku mà nhỉ? Tại sao lại là chân Núi Yougou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320318,
					"content": "Chuyện này hội trưởng Sango cũng có nghĩ đến. \"Mặc dù gần Đền Narukami cũng có Cỏ Naku, nhưng Đền Narukami có pháp sư, và có những tín đồ đến bái tế.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320319,
					"content": "\"Nếu có gì bất thường, mọi người qua lại nơi đó sẽ rất dễ phát hiện.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320320,
					"content": "Thì ra là vậy! Bây giờ thì tôi tin cô ấy là người chơi hệ não rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320321,
					"content": "Sau đó đúng là phát hiện một đống đất ở chân Núi Yougou, có dấu vết đào bới không lâu. Nghi phạm chôn tang vật ở đó, đợi đến khi sóng yên biển lặng sẽ đến lấy đi bán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320322,
					"content": "Nhưng hắn cảm thấy đeo giỏ đi và trở về tay không sẽ bị nghi ngờ, thế là đã hái Cỏ Naku bên đường về bán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320323,
					"content": "Nhưng chính Cỏ Naku lại vạch trần hắn ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400320324,
					"content": "Chính xác. Vì vậy chắc chắn vẫn còn manh mối gì đó ở chỗ chúng ta không để ý đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320327,
					"content": "Tôi thấy chúng ta hợp tác như vậy cũng không tệ. Dù sao sở trường của tôi cũng là chạy việc vặt, chứ không phải lén lút và đánh nhau. Việc này giao cho bạn là hợp lý nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320328,
					"content": "Thế nào? Có hứng thú đến \"Bantan Sango\" làm việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320329,
					"content": "Hội trưởng Sango...cô ấy có vẻ khó gần, và sẽ nói những câu \"lương tri là gánh nặng của trí tuệ\", nhưng thật ra trong thâm tâm cô ấy là một người rất ấm áp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320330,
					"content": "Bỏ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "Thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320333,
					"content": "Nhưng mà nói cũng phải, nếu bên cạnh hội trưởng Sango có một người giỏi như bạn, chắc tôi sẽ thất nghiệp mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320334,
					"content": "Tôi sẽ tiếp tục điều tra. Nếu các bạn có việc gì cần làm thì cứ đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320335
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320335,
					"content": "Chúng ta sẽ gặp nhau ở trụ sở thám tử sau. Dù sao thì cũng vất vả cho các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400320331,
					"content": "Cảm ơn, nhưng mà bỏ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320325,
					"content": "Hy vọng lần này chúng ta cũng có thể thuận lợi như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320326
					]
				},
				{
					"id": 400320326,
					"content": "Ừm ừm, những thôn dân bị mất bọn thú nhỏ chắc đang lo lắng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "Paimon"
				}
			]
