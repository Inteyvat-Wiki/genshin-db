			"dialogs": [
				{
					"id": 761480101,
					"content": "Ối, mọi người vừa đi đâu vậy?! Làm tôi hết hồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480102,
					"content": "Làm tôi gọi tên suốt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480103,
					"content": "Tại sao cô nhóc Paimon này lại không bị kéo vào Quãng Vô Tưởng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480104,
					"content": "Có lẽ ngoài ăn và ngủ ra thì Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "...Không nghĩ gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "Có lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480107,
					"content": "Có vẻ như Melanta thực sự tức giận rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480108,
					"content": "#Việc đưa {NICKNAME} lên đối mặt trực tiếp với Melanta đã là chuyện cấp bách rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480109,
					"content": "Chuyển chỗ khác nói chuyện đi. Ở đây cũng không an toàn lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480110,
					"content": "Này! Dù không ai để ý, nhưng mà... Xin chào mọi người, tôi là Alara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alara"
				}
			]
		},
