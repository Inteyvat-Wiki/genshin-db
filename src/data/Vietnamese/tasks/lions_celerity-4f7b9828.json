						],
						"pointId": 119
					}
				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "Lại quay về chỗ này rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "Lần trước đến đây, nếu tính theo tuổi thọ con người thì đã là chuyện của kiếp trước trước trước... trước trước trước... rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "Xem ra chúng ta đều bị ném vào Quãng Vô Tưởng lần nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "Vậy chúng ta phải làm sao để thoát ra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "Cách thông thường là học thiền định, kiểm soát tâm trí và suy nghĩ. Sau đó vứt bỏ mọi ý niệm khao khát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "Giữ trạng thái không nghĩ gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "Nói thì đơn giản vậy thôi. Nhưng tùy thuộc vào tố chất và mức độ khao khát của mỗi người, việc làm được điều này có thể mất từ vài năm đến vài trăm năm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "#Với người gánh vác vận mệnh thế giới như {F#cô}{M#cậu}, khát vọng e rằng không thể tự mình buông bỏ được. Huống hồ nó cũng không nên bị buông bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "Vậy phải làm sao đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Tìm Zeitlind trước rồi tính tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761480712,
					"content": "Vừa nhặt được thứ gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Khoan đã, Dex cũng bị kéo vào luôn à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "Vậy thì có lẽ mọi chuyện vẫn còn chút hy vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Dex cũng là người canh gác, chắc sẽ có thể tận dụng sức mạnh trong những mảnh này để mở ra một lối thoát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "Những mảnh này chắc cũng cần có tên để gọi cho tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "Tôi cũng từng nghe đến những chiếc quan tài khoa trương quá mức này, là do một người chị em nào đó của chủ nhân thần điện đã bố trí. Hình như được gọi là \"Quan Tài Tử Niệm\".",
