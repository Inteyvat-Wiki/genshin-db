			"dialogs": [
				{
					"id": 733560101,
					"content": "Thật không thể tin được, có ngày tôi lại được uống trà do cô pha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560102
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560102,
					"content": "Lạ đến thế cơ à? Tôi chỉ muốn cảm ơn anh đã cung cấp lõi tính toán cho \"mảng ẩn số\" thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560103,
					"content": "Mà sao anh cứ nói như thể hiểu rõ chúng tôi lắm vậy? Trông như thân thiết lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560104,
					"content": "Tôi nói rồi mà, tôi chỉ là giỏi nhìn người thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560105
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560105,
					"content": "Nhưng mà... Ha, cô nói đúng. Tôi không nên cứ tự cho rằng mình hiểu rõ các cô như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560106,
					"content": "Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560107,
					"content": "Chỉ tính từ lần gặp trước thôi, cô đã thay đổi rất nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560108,
					"content": "Không thì anh định tính từ bao lâu trước kia nữa? Hừm, tôi chẳng qua chỉ chấp nhận \"sai sót\" trong lõi của mình và nhìn rõ vài chuyện mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560109,
					"content": "Còn anh thì sao? Cũng là một loại \"con rối\" nào đó, liệu có khi nào trong lòng cũng xuất hiện sai sót khi tính toán không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560110,
					"content": "Ha... Đâu chỉ là \"sai sót\" chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560111
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560111,
					"content": "Nói nghe xem nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560112,
					"content": "Chúng ta chưa thân đến mức đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560113,
					"content": "Ha, cũng đúng. Tôi cũng chỉ hỏi theo phép lịch sự mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560114,
					"content": "Dù sao thì trong việc tìm kiếm \"trái tim\", con rối có lẽ sẽ phải đi khá nhiều đường vòng. Ít nhất thì với tôi là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560115,
					"content": "Cô có vẻ khá thân với người đã tạo ra mình nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560116
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560116,
					"content": "Ừm, ông ấy đã giúp đỡ và chỉ dẫn tôi rất nhiều, dù khi còn sống hay sau khi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560117,
					"content": "Chỉ với điểm này thì tôi và cô đã có sự khác biệt cơ bản rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560118
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560118,
					"content": "...Ồ, thế à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560119,
					"content": "Xin lỗi, tuy đều là con rối như nhau, nhưng tôi cũng không nên vì thế mà nghĩ rằng mình hiểu anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560120,
					"content": "Không, đừng bận tâm. Theo cách nói của cô, tôi cũng đã chấp nhận \"sai sót\" trong quá khứ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560121,
					"content": "Chỉ là tôi đi quá nhiều đường vòng thôi. Bù đắp nó thì phải đi một con đường còn dài hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560122,
					"content": "Thế thì... cố lên nhé? Như cách anh nói thì tôi cũng chưa thân đến mức có thể đưa ra nhiều lời khuyên hơn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560123,
					"content": "Ha... Như nhau cả thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
