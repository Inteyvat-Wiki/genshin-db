				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "Mỗi người đều có con đường riêng của mình, không cần nói nhiều đâu. Ngược lại thì trà này khá ngon đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Nón Tròn"
				},
				{
					"id": 733560202,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 733560204,
					"content": "Được, tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nón Tròn"
				},
				{
					"id": 733560203,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Sandrone"
				}
			]
		}
	]
