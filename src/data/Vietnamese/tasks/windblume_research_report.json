			"dialogs": [
				{
					"id": 700000401,
					"content": "Chào mừng đến với Hoa Ngữ, bạn có cần tìm hiểu gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000402,
					"content": "Về bức cảnh của Sayid...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "Thật ra, Lễ Hội Hoa Gió là ngày lễ của riêng Mondstadt, còn người Sumeru, chắc sẽ không ăn mừng Lễ Hội Hoa Gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000404,
					"content": "Có muốn chụp ảnh bạn và hoa của tôi không? Không sao đâu, ý tưởng của ngài Sayid rất đặc biệt, học giả là vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
