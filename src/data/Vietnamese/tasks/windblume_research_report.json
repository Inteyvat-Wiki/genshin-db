			"dialogs": [
				{
					"id": 700000601,
					"content": "Các bạn chụp ảnh xong rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000602,
					"content": "Chụp xong hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "Ừm, bạn chụp đẹp lắm, nghiên cứu của tôi chắc chắn sẽ dùng đến những bức ảnh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000604,
					"content": "Nhìn thấy phong cảnh đẹp thế này... tôi liền nghĩ tới ngày lễ ở Sumeru quê tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000605,
					"content": "Sumeru có ngày lễ nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "Ừm chắc bạn không biết, mỗi năm chúng tôi đều tổ chức \"Lễ Hội Sabzeruz\", để kỷ niệm ngày ra đời của \"Tiểu Vương Kusanali\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000607,
					"content": "Nhưng nếu nói về bầu không khí, thì hơi khác với Lễ Hội Hoa Gió của Thành Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000608,
					"content": "Nhắc đến thì...tôi cũng không thể tham gia Pushpa Janma năm nay. Haiz, đã quá lâu rồi, không biết bây giờ tình hình Giáo Viện như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000609,
					"content": "Lại nói lan man rồi, tóm lại cám ơn bạn đã giúp đỡ, hãy nhận lấy số thù lao này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				}
			]
		}
