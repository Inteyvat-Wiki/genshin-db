			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "Phong tục lãng mạn như vậy, đây mới là thứ thực sự đáng để nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "Ồ, là Nhà Lữ Hành, bạn cũng hứng thú với bài ca dao lãng mạn của Mondstadt nên mới đến thư viện đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000104,
					"content": "Nhưng, chúng ta có thể đọc tất cả ghi chép bằng văn bản bất cứ lúc nào, chỉ cần lơ là một chút là có thể bỏ lỡ thời khắc lịch sử xảy ra ngay bên cạnh ta đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000105,
					"content": "Trong Lễ Hội Hoa Gió lãng mạn này, người Mondstadt có rất nhiều phong tục đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000106,
					"content": "Hình thức của những phong tục này như thế nào, lịch sử đằng sau chúng ra sao? Đó đều là hướng nghiên cứu rất hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000107,
					"content": "Tôi đang viết báo cáo nghiên cứu, chỉ miêu tả bằng chữ thôi thì không được, bạn có thể chụp lại bức ảnh quang cảnh Lễ Hội Hoa Gió được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000108,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "Cám ơn bạn đã hỗ trợ việc nghiên cứu học thuật của tôi, tôi sẽ để tên của bạn trong báo cáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000113,
					"content": "<color=#00E1FFFF>Dây hoa trang trí ở quảng trường đài phun nước</color>, <color=#00E1FFFF>tượng thần dùng hoa trang trí trước giáo đường</color>, còn có <color=#00E1FFFF>chủ tiệm hoa bận rộn buôn bán</color>, tất cả những điều này đều đáng để ghi lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000115,
					"content": "Vậy phiền bạn chụp lại những cảnh vật này cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000110,
					"content": "Bạn tự đi sẽ tốt hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "Không không không, bây giờ tôi không đi được. Tôi vừa nghĩ ra dàn ý của báo cáo, nếu bây giờ mà đi thì sẽ gián đoạn mạch suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000112,
					"content": "Thôi thì nhờ bạn vậy, Nhà Lữ Hành, tuy là không nhiều, nhưng tôi sẽ chuẩn bị thù lao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				}
			]
		},
