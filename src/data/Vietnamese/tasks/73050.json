			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "Lễ Hội Utsava... Một cảm giác hoài niệm... Ồ? Bông Trắng... còn có cả Nara Vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "Là bạn Nara, với bạn của bạn Nara, mong các bạn sẽ có một khoảng thời gian vui vẻ tại Lễ Hội Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "Bạn của bạn cũng là bạn! Nara Vàng, và Bông Trắng Bay Bay đều là bạn của Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
