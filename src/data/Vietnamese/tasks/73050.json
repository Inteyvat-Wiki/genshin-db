					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#Nara {NICKNAME} và Paimon! Kẻ xấu đã khiến Vana \"bị bệnh\" đã không quay lại nữa, bây giờ có thể yên tâm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#Nhờ sự giúp đỡ của Nara {NICKNAME} và Paimon, Ararycan mới có thể bảo vệ được Vana... Cho nên Ararycan sẽ tặng hoa cho Nara {NICKNAME} và Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "Nhận hoa đi, bạn tốt của Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
