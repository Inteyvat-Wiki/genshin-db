			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#Nara {NICKNAME} và Paimon! May nhờ có sự giúp đỡ của các bạn, hiện giờ Cỗ Máy Varuna rất tốt, Lãnh Địa Ashavan cũng rất tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500102,
					"content": "Aranara đều trở về Vanarana, đón mừng Lễ Hội Utsava như chim bay về tổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500103,
					"content": "Cơn mưa giận dữ đã biến thành cơn mưa dịu dàng, Aranakula cũng có thể yên tâm chăm sóc vườn ươm, nuôi dưỡng Viparyas, Viparyas vui vẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500104,
					"content": "Viparyas vui vẻ sẽ làm thành đèn lồng vui vẻ, đèn lồng vui vẻ sẽ tô điểm cho Lễ Hội Utsava vui vẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500105,
					"content": "#Nara {NICKNAME} và Paimon, bây giờ vườn ươm rất tốt, Lễ Hội Utsava cũng rất vui, cảm ơn sự giúp đỡ của các bạn, chữa trị cho Cỗ Máy Varuna, đưa Aranakula trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500106,
					"content": "Vậy thì tốt! Hì hì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730500107,
					"content": "Nói như thế thì có một chuyện rất đáng chú ý...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "Tại sao Nara Varuna lại gọi là Nara Varuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "Ừm ừm. Tại Nara đó chính là Nara đã giúp chúng tôi sửa lại Cỗ Máy Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500110,
					"content": "#Vậy tên {M#cô ấy}{F#anh ấy} là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "À... Không biết nữa, Nara Varuna chưa từng nói tên mình ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#Nara {NICKNAME} cũng đã giúp đỡ rất nhiều, Nara dũng cảm vượt qua muôn vàn khó khăn. Chúng ta cùng nhau đón mừng Lễ Hội Utsava, vui lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500115,
					"content": "#Chúng ta có một thứ muốn đưa cho Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500116,
					"content": "Là thứ để bày tỏ lòng biết ơn của Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500117,
					"content": "#Nara {NICKNAME} chắc chắn sẽ thích nó, Paimon cũng thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500118,
					"content": "Hoa của Aranara, tặng cho Nara dũng cảm, và Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500119,
					"content": "#Arakara cũng có hoa nhỏ, không phải là Viparyas, nhưng tôi tặng cho Nara {NICKNAME} và Paimon đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500120,
					"content": "#Cảm ơn Nara {NICKNAME} và Paimon về tất cả những gì các bạn đã làm cho Vana, Aranara sẽ không quên các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500113,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
