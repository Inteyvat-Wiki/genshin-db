					}
				]
			},
			"dialogs": [
				{
					"id": 760690401,
					"content": "Cảm giác này... có vẻ là hóa thân từ những mảnh vỡ Linh Hồn Sói chưa được tìm ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690402
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690402,
					"content": "Vậy ai đã để lại ở đây? Là để canh giữ thứ gì? Bây giờ... hãy nói ra hết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690403
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690404,
					"content": "...Tôi đã nhắc đi nhắc lại nhiều lần rồi, con đường nhuốm máu này, chỉ cần một mình tôi là đủ, không cần người khác đi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690405
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690405,
					"content": "Ha, vậy thì cứ xem như chúng ta chỉ đang cùng đường thôi nhé? Tình cờ cùng đường từ Mondstadt đến Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690406
					]
				},
				{
					"id": 760690406,
					"content": "Lại tình cờ được một kỵ sĩ nào đó cứu vô số lần, rồi nảy sinh khát khao được như kỵ sĩ đó... Nên không kìm lòng được mà bước lên con đường tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690407
					]
				},
				{
					"id": 760690407,
					"content": "Dù không thể hiểu được, nhưng ít nhất cũng muốn ở bên cạnh chứng kiến... dù cho trên con đường này, chỉ còn lại mỗi chúng ta mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690408
					]
				},
				{
					"id": 760690408,
					"content": "À húuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690409
					]
				},
				{
					"id": 760690409,
					"content": "Nếu đó là những gì mọi người xem là đạo kỵ sĩ... Thì tôi không có quyền phủ nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690410
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690410,
					"content": "...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760690411
					]
				},
				{
					"id": 760690411,
					"content": "Đám ma vật chết tiệt đó... đều bị tiêu diệt rồi sao? Dân cư xung quanh... không sao rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690412
					]
				},
				{
					"id": 760690412,
					"content": "Khụ... Tốt quá... Thật đáng tiếc, chúng tôi không còn sức lực để chứng kiến ngài đi đến cuối con đường nữa... Thật không cam lòng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690413
					]
				},
				{
					"id": 760690413,
					"content": "Từ nay về sau, sẽ chỉ còn mình ngài thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690414
					]
				},
				{
					"id": 760690414,
					"content": "...Cuối cùng, thanh kiếm của ta vẫn không thể bảo vệ được tất cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690415
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690415,
					"content": "...Cuối cùng, con đường này chỉ còn lại một mình... Có lẽ ngay từ đầu, vốn đã nên như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690416
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690416,
					"content": "Ít nhất hãy để những thanh kiếm này cùng Linh Hồn Sói nơi đây canh giữ mộ phần mọi người... không được để những thứ tà ác đen tối quấy nhiễu giấc ngủ bình yên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690417
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690417,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690418
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690418,
					"content": "Hoá ra là vậy... Trong Đội Kỵ Sĩ từng ghi chép rằng, khi Kỵ Sĩ Nhuốm Máu ra đi, từng có kỵ sĩ tự nguyện đi theo, nhưng sau đó không còn ghi chép gì thêm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690419
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690419,
					"content": "Không ngờ cuối cùng lại vì thảo phạt ma vật mà nằm xuống nơi đây... Thật không hổ danh kỵ sĩ của Đội Kỵ Sĩ Tây Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690420,
					"content": "Nhưng \"nguyện vọng\" của mọi người, liệu có thực sự dừng lại ở đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690421
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690421,
					"content": "Ngọn lửa chiến đấu chưa tắt, nỗi nhớ gửi gắm trong thanh kiếm... Hãy cho tôi biết quyết tâm của các \"kỵ sĩ\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690422
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690422,
					"content": "Tôi sẽ dùng sức mạnh mà Boreas để lại nơi đây để phong tỏa chiến trường này... Chú sói nhỏ kia cũng sẽ ở bên ngoài canh giữ linh hồn mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690423
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690423,
					"content": "Mọi người xứng đáng được bảo vệ như vậy... Vĩnh viễn không bị quấy rầy, vĩnh viễn được yên nghỉ, và sẽ mãi... không phải chứng kiến sự bất công của thế gian này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690424
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690424,
					"content": "Vĩnh biệt... những chiến hữu cuối cùng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690425
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690425,
					"content": "...Không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690426
					]
				},
				{
					"id": 760690426,
					"content": "...Đừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690427
					]
				},
				{
					"id": 760690427,
					"content": "...Hãy để chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690428
					]
				},
				{
					"id": 760690428,
					"content": "...Một lần nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690429
					]
				},
				{
					"id": 760690429,
					"content": "Quả nhiên... \"nguyện vọng\" của mọi người... không phải lặng lẽ điêu tàn trong nơi tối tăm không thấy ánh mặt trời này phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690430
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690430,
					"content": "Vậy thì hãy đến đây! Cùng tôi, một lần nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690431
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690431,
					"content": "Xông lên chiến trường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		}
	]
}