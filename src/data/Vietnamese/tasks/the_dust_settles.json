			"dialogs": [
				{
					"id": 761150201,
					"content": "...Tôi chưa từng gây sự với mấy người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150202,
					"content": "Xem ra ngươi biết rất rõ tại sao chúng tôi đến nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150203,
					"content": "...Đó đều là chuyện đã qua, bây giờ ta chỉ muốn sống một cuộc sống bình yên thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150204,
					"content": "Bằng cách cướp đoạt danh tính của người khác sao? Đầu tiên là Juhani, nhưng không thành công, sau đó lại là Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150205,
					"content": "Nhưng vở kịch vụng về này sớm muộn cũng sẽ bị vạch trần, và sẽ không còn ai bị hại nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150206,
					"content": "...Juhani? Ta muốn cướp đoạt thân phận của hắn ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150207,
					"content": "Đó không phải của hắn ta... Vậy sao hắn ta có thể sở hữu chứ? Chỉ vì hắn ta trông dễ gần hơn, giỏi xu nịnh hơn ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150208,
					"content": "Rõ ràng bọn ta đều giống nhau! ...Những thứ bị hắn ta lấy đi vốn thuộc về ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150209,
					"content": "Thế ngài Derwent và thương nhân thì sao? Họ đã làm gì ngươi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150210,
					"content": "...Họ? Họ đã hỏi những câu không nên hỏi, giống như các người vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150211,
					"content": "Chịu chết đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Derwent"
				}
			]
		},
