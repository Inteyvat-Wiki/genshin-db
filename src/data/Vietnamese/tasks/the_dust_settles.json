			"dialogs": [
				{
					"id": 761150301,
					"content": "Đúng như dự đoán, một kẻ đáng thương chỉ biết lặp lại lỗi lầm của bản thân ngày trước, phải nói là có hơi nhàm chán rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Nefer"
				},
