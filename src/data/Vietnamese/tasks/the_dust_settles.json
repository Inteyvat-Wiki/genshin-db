			"dialogs": [
				{
					"id": 761150101,
					"content": "Ơ? Nefer và Jahoda! Sao hai người lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150102,
					"content": "Tất nhiên là để làm việc rồi. Mục tiêu treo thưởng mà trước giờ không có manh mối đã bị chúng tôi tìm thấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150103,
					"content": "Nghe Jahoda giới thiệu sơ lược về mục tiêu treo thưởng Hark \"Hàm Nứt\", và cả những thông tin trước đây mà Hội Đồng Bí Mật điều tra được...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761150104
					]
				},
				{
					"id": 761150104,
					"content": "Nói kết luận trước vậy. Ẩn sĩ Derwent thực sự rất có thể đã bị hại rồi, còn người đang chiếm lấy ngôi nhà của ẩn sĩ chính là mục tiêu treo thưởng Hark \"Hàm Nứt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150105,
					"content": "Mảnh nhật ký mà Jahoda tìm được cũng có thể làm bằng chứng, Derwent dù biết mọi chuyện nhưng vẫn để hắn ở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150106,
					"content": "Không hề bất ngờ, Hark vẫn chứng nào tật nấy, sau khi giải quyết Derwent đã cướp luôn thân phận đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150107,
					"content": "Tuy trước đó đi điều tra chưa thấy mặt, nhưng người trong ngôi nhà đó dù thế nào cũng không thể nào là ngài Derwent được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150108,
					"content": "Hơn nữa chỉ cần tự xưng là ẩn sĩ thì dù có làm chuyện kỳ lạ gì cũng sẽ không bị nghi ngờ. Chiếc mặt nạ đó không phải để tu hành, mà là để che vết sẹo dưới cằm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150109,
					"content": "Còn về thương nhân không rõ tung tích, suy đoán xấu nhất thì có lẽ cũng đã bị hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150110,
					"content": "Đã làm nhiều chuyện xấu như vậy, lại còn lấy oán báo ơn hai lần, rốt cuộc kẻ đó xấu xa đến mức nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150111,
					"content": "Tôi đoán, vụ án mất trộm của Vòng Du Hành thật ra không liên quan gì đến Hark. Hắn không đủ động cơ gây án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150112,
					"content": "Trong suốt mười năm qua, hắn đều tuân thủ quy tắc, giá trị của hàng hóa bị mất cắp có đủ lớn để hắn đánh đổi bằng tất cả nỗ lực trước đó không? Tôi nghĩ là không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150113
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150113,
					"content": "Vậy chúng ta hãy đưa ra vài giả thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150114
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150114,
					"content": "Được biết sau khi sự việc xảy ra, hắn đã trở về gần xác tàu Atlas, tấn công những người thợ săn kho báu đến tìm kho báu. Trong lúc bế tắc, thì việc quay trở lại điểm khởi đầu là một loại bản năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150115,
					"content": "Khi vẫn còn là người lái tàu của Atlas, thanh danh, tiền tài đều trong tầm tay. Nhưng sau khi gia nhập Vòng Du Hành thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150116,
					"content": "Dù nghiêm khắc tuân thủ quy tắc trong suốt mười năm, nhưng khi xảy ra vụ trộm, thì những lời nói và ánh mắt nghi ngờ vẫn đổ dồn về phía hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150117,
					"content": "Mà điều khiến hắn khó chấp nhận hơn có lẽ là Juhani, người có xuất thân tương tự, trước kia chỉ là kẻ vô danh nhưng giờ lại như diều gặp gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150118,
					"content": "Ngay cả khi hắn trực tiếp chỉ trích Juhani thì cũng không ai tin lời hắn nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150119,
					"content": "Bị nhấn chìm trong thất vọng và phẫn nộ, hắn đã phạm phải sai lầm đầu tiên trong đời. Sự việc lần này chính là bước ngoặt của cuộc đời hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150120,
					"content": "Chuyện xảy ra tiếp theo ở nhà của ẩn sĩ có lẽ cũng tương tự... Dù là mâu thuẫn nhỏ cũng sẽ dẫn đến xung đột chí mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150121,
					"content": "#{NICKNAME}, tên này nguy hiểm quá, chúng ta cũng đâu thể bỏ mặc được đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150122,
						761150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150122,
					"content": "Cho tôi một cơ hội trừ hại nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				},
				{
					"id": 761150124,
					"content": "#Nếu {NICKNAME} đã chủ động thì để Jahoda nghỉ ngơi một chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150125,
					"content": "Trước đây cũng đã tốn rất nhiều công sức để điều tra rồi! Xem như nghỉ ngơi một lúc vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150126
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150126,
					"content": "Còn việc giả thiết đưa ra có đúng không, thì chờ khi gặp được hắn sẽ rõ ràng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150123,
					"content": "Dù có tiền thưởng hay không thì vẫn cứ giao cho tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				}
			]
		},
