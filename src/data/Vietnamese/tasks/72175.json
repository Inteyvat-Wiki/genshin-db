					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750605,
					"content": "Òa! Thì ra anh đang chọc tôi! Phép lịch sự của anh mất đâu rồi hả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750606,
					"content": "#Hừm, {NICKNAME}, mau đưa thứ nấm quỷ yêu kia cho anh ta đi, tôi không thèm nói chuyện với anh ta nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "Paimon"
