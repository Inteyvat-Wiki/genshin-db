			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Không ngờ các bạn vẫn còn ở trên đảo, thật tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750102,
					"content": "Dạo này thế nào? Có phát hiện gì bất ngờ không? Nói cho tôi nghe xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750103,
					"content": "Không có gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "Khó tránh, khó tránh! Một hòn đảo như vậy không bao giờ thiếu những bí mật, tôi tin rồi bạn sẽ có phát hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750107,
					"content": "À mà, Roald ở đây làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750108,
					"content": "Hở? Tôi vừa thu dọn hành lý ở trại và chuẩn bị đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750109,
					"content": "Sương mù trên đảo quá dày...cứ hễ vào sâu được một đoạn là mất phương hướng. Sau đó bất giác quay lại nơi bắt đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750110,
					"content": "Con đường lúc trước Kama chỉ cho tôi, tôi đã quên sạch sành sanh...Kết quả là tôi muốn quay lại tìm kiếm những người thổ dân ở đó, nhưng cũng không thể tìm thấy đường đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750111,
					"content": "Cả la bàn trên người tôi với cái bóng trên mặt đất cũng không thể chỉ ra phương hướng...Thậm chí cả giày tôi cũng thử rồi, nhưng cuối cùng cũng không thể đi thêm một bước nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750112,
					"content": "Giày á...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750113,
					"content": "Ý anh ta là vứt giày chỉ đường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "Hở!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750115,
					"content": "#Hì! Chút kỹ năng của một nhà mạo hiểm giàu kinh nghiệm đúng là không làm khó được {NICKNAME}! Paimon cần phải học hỏi thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750116,
					"content": "Paimon vẫn cần phải học hỏi thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Hên thôi! Những thứ này có gì mà phải học chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750118,
					"content": "Tóm lại là thế này, hành trình của tôi đang giậm chân tại chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750119,
					"content": "Haiz...nếu cột một sợi dây vào một cái cây gần đó, rồi nắm đầu dây còn lại đi về phía trước, vốn dĩ vẫn có thể thử thêm vài lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750120,
					"content": "Vậy tại sao lại không thử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750121,
					"content": "Giày dự phòng dùng để xác định phương hướng ném hết trơn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750122,
					"content": "Giày dự phòng chỉ dùng được một lần thôi sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "Hihi, vốn dĩ không phải vậy. Chỉ là ném nhiều quá rồi quên nhặt lại nên dần dần...hết sạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750126,
					"content": "A! Đúng rồi, tôi nhớ ra mình có việc gì cần nhờ các bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750127,
					"content": "Này, giật cả mình! Tôi còn tưởng bạn muốn cắn người chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750128,
					"content": "Xin lỗi, xin lỗi, hì hì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750129,
					"content": "Như bạn biết đó, tôi có một cái tật rất mất mặt...là làm gì cũng quên trước quên sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750130,
					"content": "Bẩm sinh trí nhớ kém gây ra cho tôi rất nhiều bất tiện, nhất là đối với một nhà mạo hiểm thì rất dễ vì nó mà rơi vào nguy hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750131,
					"content": "Và một trong những lý do tôi đến Tsurumi lần này là thu thập một loại nấm có tên là \"Nấm U Ám\". Nghe tiểu thư Sango nói, loại nấm này có tác dụng tăng cường trí nhớ, giảm căng thẳng và tốt cho thị lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750132,
					"content": "Lần trước cùng Kama đến đây, vì quá bận tâm chuyện \"gặp thổ dân\"...nên quên hái nấm...haiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750133,
					"content": "Không ngờ lại gặp phải khó khăn như vậy khi lên đảo một mình...Thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750134,
					"content": "Nếu các bạn còn đến đó mạo hiểm, không biết có thể giúp tôi hái một ít \"Nấm U Ám\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750135,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Rất cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750137,
					"content": "Đến lúc đó đừng quên tìm tôi để lấy là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Haha, sẽ không quên đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750124,
					"content": "Thật đáng tiếc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "Haiz, nói cũng phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750105,
					"content": "Chúng tôi vẫn đang khám phá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Vậy à, haha, vậy thì đừng để tôi trì hoãn cuộc hành trình của các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				}
			]
		},
