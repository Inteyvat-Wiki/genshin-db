				},
				{
					"id": 721750404,
					"content": "Tiện thể cảm ơn \"Nấm U Ám\" của bạn. Rất tươi ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750407,
					"content": "Nói nghe nhẹ nhàng ghê, nấm bạn ăn chẳng phải là chúng tôi hái về sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750408,
					"content": "Haha, đừng quan tâm nhiều quá, tôi vẫn luôn ăn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
