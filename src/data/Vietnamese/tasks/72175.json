					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "Không cần phải vội, tôi vẫn luôn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
