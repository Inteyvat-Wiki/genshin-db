			"dialogs": [
				{
					"id": 721750301,
					"content": "Ừm...vậy là đủ rồi, cảm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750302,
					"content": "Tiện thể nếu có phát hiện gì ở gần \"Tế Đàn\" thì cho tôi biết luôn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750303,
					"content": "À...đúng rồi, các bạn có mang theo \"máy ảnh\" hàng Fontaine đúng không? Thứ đó mắc tiền lắm...nếu có dư, tôi cũng sẽ mua cho mình một cái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750304,
					"content": "Nghe tác giả lịch sử địa phương nói, các thổ dân cổ đại của Tsurumi đã dùng sơn để vẽ lại lịch sử cổ đại trên các bức tường đá trong hang động, thường tồn tại hơn một nghìn năm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750305,
					"content": "Trong lần tìm kiếm trước, hình như tôi cũng có thấy một số hoa văn qua ánh lửa của tế lễ... Kể từ đó nó cứ ám ảnh tôi, mất ngủ hết mấy ngày trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750306,
					"content": "Những bức bích họa này, theo như tôi biết thì chưa từng có ai nhìn thấy...Nếu hai bạn có thể chứng thực lời mình kể, chúng sẽ mang lại một bước đột phá nữa cho \"Hiệp Hội Nhà Mạo Hiểm\" trong lĩnh vực lịch sử và học thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750307,
					"content": "Vì vậy, tôi mong rằng hai bạn có thể tìm thấy bức bích họa trong truyền thuyết đó và chụp nó lại một cách đầy đủ và rõ ràng nhất có thể. Tôi sẽ mua lại bức ảnh của các bạn để làm tư liệu ghi chép và trả cho các bạn số tiền xứng đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750308,
					"content": "Hai bạn thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750309,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Cám ơn rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750311,
					"content": "Chỉ cần bạn đừng làm mất nhật ký nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "Tôi...Tôi sẽ cố gắng hết sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				}
			]
		},
