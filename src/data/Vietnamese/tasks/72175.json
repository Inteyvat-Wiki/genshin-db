			"dialogs": [
				{
					"id": 721751801,
					"content": "#Lại gặp nhau rồi, {NICKNAME}! Với cả... gì ấy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "Tiện thể cho hỏi, nhóc tì bay tới bay lui kia bán thế nào? Trông thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "Bạn vẫn ổn chứ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "Rõ ràng là không ổn lắm! Tên này sao đột nhiên lại mất trí nhớ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "Hai người đang nói gì vậy...khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "Khụ...ha ha ha ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Hahaha...khụ khụ...Hahaha! Nhìn kìa...Nhìn biểu cảm của hai người kìa! Phụt hahahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "Tiêu rồi...Tôi cười hết hơi luôn rồi...xin...xin lỗi nha...đây là...hahahaha...đây là \"trò đùa đãng trí\" mà tôi thích nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "Chẳng buồn cười xíu nào!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "Không hiểu khiếu hài hước của bạn cho lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "...Được rồi, được rồi, không đùa nữa, xin lỗi xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "Thiệt tình, tôi còn tưởng anh là một nhà mạo hiểm lớn, là một người rất nghiêm túc nữa chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Haha, đừng có định kiến như vậy chứ, Hiệp Hội Nhà Mạo Hiểm là một tổ chức nổi tiếng kỳ quặc. Tôi là người khá bình thường trong số đó đó nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "...Cũng không bình thường cho lắm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Vẫn rất cảm ơn nấm của bạn. Đến bây giờ hiệu quả của nó vẫn chưa rõ ràng lắm...có lẽ cần phải dùng lâu dài, cũng có thể nó vốn dĩ không phải là thuốc...tóm lại ngon là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "Nhưng cũng không được ăn hết, tôi phải để lại một ít cho người bạn ở Sumeru để nghiên cứu giá trị y học của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "Tôi đoán anh sẽ quên ngay chuyện này thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "E hèm, quay về chuyện chính nào. Hai bạn có đi tìm bức bích họa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "Đây là ảnh bạn cần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Ôi ôi, không biết phải nói sao cho hết lời cảm ơn đây! Đất nước này bày tỏ lời cảm ơn như vậy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Ồ...thú vị, rất thú vị. Có điều...các bạn không phát hiện thêm bức bích họa nào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "Đây là tất cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Vậy thì càng thú vị hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "Hở...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "Thổ dân Tsurumi từng tín ngưỡng Ma Điểu nguyên tố Lôi, xây dựng nền văn minh của riêng mình với các nghi lễ hiến tế. Những người biết một chút về lịch sử sẽ không có ý kiến về chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "Nhưng trên bức bích họa của các bạn...lại không có vết tích của Lôi Điểu. Thứ những người đó cúng bái là những thứ khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "Mặt trăng mặt trời và những vì sao...và...những ký hiệu kỳ lạ. Có lẽ...trước khi Lôi Điểu xuất hiện, tổ tiên của người dân Tsurumi đã có một trình độ văn minh nhất định...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "Ngoài ra...sương mù và mặt trăng, các vì sao và bóng tối...ừm, điều đó chẳng có ý nghĩa gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "Thôi đừng sử dụng bộ não nhiều quá...trí nhớ của anh tệ lắm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "...À, xin lỗi. Suy nghĩ nhập tâm quá, quên là các bạn vẫn còn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Một lần nữa cám ơn các bạn, tôi có đủ tư liệu để viết tiếp nhật ký rồi...Nếu may mắn được các nhà sử học xem trọng, tôi sẽ không bao giờ quên ghi tên của hai bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "Được rồi, tôi cũng phải đến Hiệp Hội Nhà Mạo Hiểm báo cáo đây. Thật sự xin lỗi vì đã quấy rầy bạn lâu như vậy, hy vọng còn có dịp gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "Đúng là một người bận rộn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "À, tiện thể...còn một chuyện nữa. Mặc dù không phải chuyện to tát gì, nhưng mong là các bạn có thể để ý giúp tôi. Đứa trẻ hôm trước nhắc đến...tên...tên gì ấy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "\"Ruu\"...Đúng, là cái tên này. Lần này tôi có đem theo chút đồ ăn cho nó...hy vọng vẫn còn tươi ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751844,
					"content": "Từ lần trước, tôi vẫn luôn suy nghĩ về chuyện có một đứa trẻ trên đảo... Sống trên một hòn đảo nguy hiểm như vậy chắc chắn không dễ dàng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751845,
					"content": "#Được rồi, không làm mất thời gian của bạn nữa, {NICKNAME}. Hẹn gặp lại ở trạm tiếp theo, hướng tới những ngôi sao và vực sâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751830,
					"content": "Chúng tôi chỉ tìm được nhiêu đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "Đây là cách để \"người đãng trí\" thích nghi với thế giới này sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "\"Nấm U Ám\" hôm trước có hiệu quả không...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "Đúng vậy, đúng vậy! Sao lại tệ hơn nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}