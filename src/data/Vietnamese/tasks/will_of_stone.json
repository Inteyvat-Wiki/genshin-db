			"dialogs": [
				{
					"id": 708150701,
					"content": "#{F#Chị}{M#Anh} đến bắt em về Khinh Sách Trang à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150702,
					"content": "Bà Ruoxin đang rất lo lắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "Hứ, quả nhiên là đến bắt em về, em không về đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150706,
					"content": "#{F#Chị}{M#Anh} về nói với người trong thôn rằng, em sẽ đến cảng Liyue tìm bố mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150707,
					"content": "Sau khi tìm được, em sẽ nói chuyện với bố và trở về, bảo họ không cần lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150704,
					"content": "Chúng tôi có đồ cho em...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "Em không thèm, lại là mấy thứ dỗ trẻ con chứ gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Bé Liu"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
