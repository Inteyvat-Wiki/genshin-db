				"points": []
			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "Haiz, vốn dĩ tôi đã nhẩm tính ngày, trực thêm hai ba hôm nữa là có thể trở về rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150402,
					"content": "Cộng thêm ngày nghỉ phép tôi để dành được, lần này trở về ít nhất có thể ở bên bé Liu hơn một tuần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150403,
					"content": "Kết quả là có lệnh toàn thể Thiên Nham Quân huỷ hết nghỉ phép, ai đang nghỉ phép cũng bị gọi về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150404,
					"content": "Theo kinh nghiệm của tôi, ít nhất trong vòng một tháng tôi cũng không thể về Khinh Sách Trang. Chuyện này đúng là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
