					"nextDialogs": [
						708150904
					]
				},
				{
					"id": 708150904,
					"content": "#{F#Chị}{M#Anh} muốn giúp em mang quà đi ư? Được... tuy {F#chị}{M#anh} không có Vision, nhưng trông cách {F#chị}{M#anh} đối phó với những ma vật ban nãy, hình như cũng rất dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150905
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150905,
					"content": "#Cũng chỉ còn cách này, vậy thì nhờ {F#chị}{M#anh} rồi.",
