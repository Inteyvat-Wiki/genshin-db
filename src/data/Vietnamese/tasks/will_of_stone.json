			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Đứa bé này, chạy đi đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150502,
					"content": "Về bé Liu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Các cháu đến tìm bé Liu à? Haiz, các cháu đến vừa khéo, đứa bé này không biết chạy đi đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150504,
					"content": "Mấy hôm trước, bố con bé nhờ người gửi thư từ cảng Liyue về, nói rất nhanh sẽ có thể trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150505,
					"content": "Bé Liu vui lắm, nói là phải chuẩn bị quà cho bố, bèn kéo mấy đứa trẻ đi hái hoa hái quả dại khắp nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150506,
					"content": "Kết quả là mấy ngày trước, bố con bé lại nói bất chợt phải trực ban, không thể về nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150507,
					"content": "Nó giận lắm, khuyên thế nào cũng không được, cứ nói nếu bố không về, con bé sẽ tự đến cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150508,
					"content": "Chúng tôi còn tưởng nó nói đùa, kết quả là hôm nay vừa dậy, đã không thấy bé Liu đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150509,
					"content": "Haiz, người có thể đi tìm con bé đều đã đi tìm nó cả rồi, nếu các cháu đồng ý, vậy cũng đi tìm nó thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150510,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "Vậy thì phiền cháu rồi, haiz, đứa bé này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150512,
					"content": "Con bé sẽ đi đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "Đứa bé này cũng không chạy quá xa, chắc là ở gần đây thôi, nhưng bên ngoài rừng hoang cây dại rất nguy hiểm... Các cháu mau đi tìm con bé đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				}
			]
		},
