			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bé Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "#{F#Chị}{M#Anh} đi theo em rốt cuộc có việc gì? Em nói rồi em phải đến Cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150802,
					"content": "Em sẽ đi đường vòng tránh những ma vật này, chúng không phát hiện ra em đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150803,
					"content": "Đừng mãi xem em như con nít, em đã lớn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150804,
					"content": "Đây là thứ bố em gửi cho em...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "#Bố em gửi ư? Là ông ấy nhờ {F#chị}{M#anh} đem đến ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150806,
					"content": "Chắc chắn lại là đồ chơi trẻ con... Không phải diều thì lại là búp bê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150807,
					"content": "Em không thích à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "...Thích chứ, thứ mà bố em tặng, em làm sao có thể không thích chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150809,
					"content": "Nhưng nếu em cứ thích những thứ này, chẳng phải mãi là đứa bé con sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150810,
					"content": "Cứ chơi mấy thứ này, khi nào em mới có thể trở thành Nhà Mạo Hiểm, lấy được Vision chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150811,
					"content": "Em muốn Vision để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "Có Vision rồi, em có thể làm được rất nhiều việc, từ kiếm tiền cho đến việc khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150813,
					"content": "Sau đó, bố sẽ không cần ngày ngày làm việc ở cảng Liyue nữa, có thể trở về bên em rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150814,
					"content": "#{F#Chị}{M#Anh} xem, bây giờ em không có Vision... ngay cả việc tự mình đến cảng Liyue cũng không làm nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150815,
					"content": "#Nhưng, bố đã nhờ {F#chị}{M#anh} mang quà ra đây rồi, em đi tìm ông ấy, chưa biết chừng còn gây thêm phiền phức cho ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>Em vốn dĩ cũng chuẩn bị quà cho ông ấy</color>, muốn gây bất ngờ... nhưng hiện giờ tự em không đem đi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Bé Liu"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>Nếu có người đồng ý giúp em đem đi thì...</color>Thôi bỏ đi, em về đây. Đừng theo em nữa, tự em biết đường về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bé Liu"
				}
			]
		},
