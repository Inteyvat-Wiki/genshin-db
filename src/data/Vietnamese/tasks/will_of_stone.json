			"dialogs": [
				{
					"id": 708150601,
					"content": "Jiayi cũng thật là, sao nói không về là không về luôn thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150602,
					"content": "Đứa bé này một năm chẳng gặp bố được mấy lần, thiên hạ này có ai làm bố như hắn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150603,
					"content": "Anh ấy cũng là vì cảng Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "Jiayi năm nào cũng nói vậy, tôi cũng không nhớ hắn từng nói bao nhiêu lần rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150605,
					"content": "Ấy cũng là vì công việc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Dù vậy thì hắn cũng nên quan tâm con gái mình chứ, bé Liu cứ ngóng trông bố nó từ nhỏ tới lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150607,
					"content": "Đừng để đến lúc mà hắn không làm việc nữa rồi trở về nhà, lại đến lượt bé Liu phải đi làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Ruoxin"
				},
				{
					"id": 708150608,
					"content": "Hai bố con này, cứ mãi không thể đoàn tụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin"
				}
			]
		},
