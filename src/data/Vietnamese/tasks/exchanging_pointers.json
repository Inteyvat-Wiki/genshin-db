			"dialogs": [
				{
					"id": 191079801,
					"content": "Connor, làm tốt lắm, cứ giữ phong độ như vậy, chúng ta nhất định sẽ mời được Diona làm người pha chế thường trực ở Tửu Trang Dawn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "Hy vọng sẽ thực sự thành công, tôi đã ngồi chờ suốt mấy tuần liền, mới đổi được cuộc gặp gỡ tình cờ này...phải nắm chắc cơ hội mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "Vất vả cho bạn rồi, Connor. Nhưng chỉ cần mời được Diona, thì tất cả những gì chúng ta đã bỏ công bỏ sức đều rất xứng đáng, hiện giờ chúng ta mới chỉ ở bước thứ nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "Hãy nhớ, nhất định phải để Diona cảm nhận được thành ý của chúng ta, sự nhiệt tình của chúng ta! Nhưng đừng quên, tuyệt đối không được làm lố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "Không thành vấn đề, thưa ngài Elzer, hai chúng ta đã luyện tập rất nhiều lần rồi, lần này chắc chắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "Các bạn đang nói gì đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "A?! Không, không có gì, chúng tôi đang...thảo luận một số việc làm ăn của tửu trang, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "Phải...đúng thế, chúng tôi đang thảo luận về việc kinh doanh của tửu trang, ngài Elzer, chúng ta bàn tiếp về các mục chi tiêu gần đây của tửu trang đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
