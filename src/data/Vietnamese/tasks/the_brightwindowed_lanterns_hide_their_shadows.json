						400400102
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400102,
					"content": "\"Tàng Ảnh Đăng\"? Chưa từng nghe qua thứ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400400103,
					"content": "Đây đây, các vị có hứng thú với \"Tàng Ảnh Đăng\" đúng không? Đây là thiết bị rất thú vị đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400104
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400104,
					"content": "Chỉ cần xoay chuyển \"Tàng Ảnh Đăng\" sao cho bóng của chúng ăn khớp với nhau là sẽ thấy được những cảnh tượng bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400106
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400106,
					"content": "Nếu bạn có hứng thú thì chơi thử một lần nhé. Thiết bị tôi để ở đây, dùng thử là hiểu ngay ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400107
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400107,
					"content": "Hy vọng \"Tàng Ảnh Đăng\" sẽ mang đến cho bạn những trải nghiệm kỳ diệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400108
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400108,
					"content": "Nghe thú vị ghê, chúng ta chơi thử xem sao nhé!",
