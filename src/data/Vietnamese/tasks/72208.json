				},
				{
					"id": 722080202,
					"content": "Con thuyền đó sẽ đi về đâu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "Vùng đất vàng, vùng đất mộng mơ. Một đất nước không có sương mù...chúng ta sẽ gặp lại nhau trong giấc mơ nhé, người bạn tốt!",
