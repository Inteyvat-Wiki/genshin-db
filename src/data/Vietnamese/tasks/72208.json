					"Ipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "Ha ha, tuy kỹ năng câu cá cũng khá nhưng vẫn cần phải nâng cao thêm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080102,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "Ây da, xin lỗi xin lỗi...lần nào cũng quên chào hỏi trước, làm người khác bị giật mình hoài...ha ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080105,
					"content": "Vẫn là dáng vẻ vui tươi phơi phới này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "Chịu thôi, thỉnh thoảng hù dọa trẻ nhỏ một chút cũng vui lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080107,
					"content": "Khụ khụ, chúng ta đang nói về chuyện câu cá nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080108,
					"content": "Là chuyện chính sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "Nói ra có hơi xấu hổ, chuyện là vầy...trước đây khi đang câu cá, tôi đã vô tình làm rơi mất bùa hộ mệnh mà Makiri đã tặng...trong đó là lời chúc phúc của Lôi Điểu và linh hồn tổ tiên của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080111,
					"content": "Nếu khi lên thuyền mà để cô ấy biết được tôi đã làm mất vật quan trọng như vậy thì không xong đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080112,
					"content": "Người lái thuyền màu vàng đã hứa sẽ tìm người đến giúp tôi đi tìm...nhưng đến bây giờ vẫn chưa thấy bóng dáng...tôi nghĩ, nếu bạn đã đến thì chi bằng giúp tôi một chút nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080113,
					"content": "Tôi còn tưởng bạn đáng tin đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "Tôi thường hay câu cá bên kia kìa...nhưng trí nhớ càng lúc càng kém đi rồi, có lẽ bạn phải tìm đi tìm lại mới thấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080116,
					"content": "Nếu là nơi trong ký ức xưa kia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "Ô...bạn nói gì? Đó là cách mà người bên ngoài dùng để tìm chỗ sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080119,
					"content": "Haiz...nói chung, nếu xác định đúng nơi đó thì đến thẳng đó tìm là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080120,
					"content": "Tôi phải tìm thế nào đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "Ơ...thì dùng cần câu thôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080122,
					"content": "...OK",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "Cầu cho Lôi Điểu đại nhân và tổ tiên phù hộ cho bạn! Nhờ vào bạn cả đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080117,
					"content": "Thì dùng \"Lông Vũ\" chắc sẽ nhìn thấy nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "Đúng là hết cách với bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "Hòn đảo đối diện với thác nước ba tầng ở phía tây Lãnh Địa Autake...ở ngay vùng biển phía tây của hòn đảo đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080109,
					"content": "Người này sao vẫn nghĩ đến việc câu cá nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "Này, làm lại đi, chào hỏi đã rồi hẵng xuất hiện chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
