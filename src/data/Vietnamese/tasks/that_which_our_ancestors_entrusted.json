			"dialogs": [
				{
					"id": 400610101,
					"content": "Hôm nay gió thổi từ phía nam, dấu hiệu cho thấy sẽ có bạn bè sẽ đến thăm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610102,
					"content": "#Mỗi lần bạn nói như vậy, tôi và {NICKNAME} lại phải chạy đôn chạy đáo cả ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610103,
					"content": "Đừng nói vậy mà, chúng ta không phải là đối tác tốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610104,
					"content": "Nhưng mà hôm nay, tôi quả thực có việc muốn nhờ hai bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610105,
					"content": "Nghe nói, ngoài Tế Lễ Linh Hồn Watatsumi ở Sangonomiya ra, thì tổ tiên chúng tôi còn thêm vào một loạt thí luyện khác nữa. Nó không liên quan gì đến sự sống còn của Watatsumi, mà là sự thật đằng sau đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610106,
					"content": "Một loạt... thí luyện?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610107,
					"content": "Hiện tại, nguy cơ của Đảo Watatsumi đã được giải quyết. Xuất phát từ nghĩa vụ và trách nhiệm tổ tiên truyền lại, tôi sẽ gợi ý cho các bạn một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610108,
					"content": "Các bạn có thể đến nơi được gọi là Trái Tim Mãng Xà, để tìm manh mối của thí luyện thứ hai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610109,
					"content": "Ôi, nhẹ nhõm quá! Trách nhiệm nặng nề này có thể được chuyển cho con gái tương lai của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610110,
					"content": "Nhiệm vụ của tổ tiên mà chỉ nói một câu đơn giản như vậy sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610111,
					"content": "...Tôi vẫn không thể theo kịp suy nghĩ của Tsuyuko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
