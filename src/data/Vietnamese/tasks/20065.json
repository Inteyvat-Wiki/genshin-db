			"dialogs": [
				{
					"id": 200650101,
					"content": "Thật nhức đầu... ở đây phải giải quyết như thế nào chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "Vì đợt tuyển chọn kỵ sĩ sắp tới, tôi đang phải huấn luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650104,
					"content": "Ừm... nhưng mà, tôi không có sức mạnh như đại nhân Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650105,
					"content": "So với việc tập luyện \"sức mạnh\", tôi cảm thấy việc học \"kỹ năng\" thích hợp với tôi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650106,
					"content": "Ví dụ, cách làm sao để phá hủy các cột gỗ này cùng lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650107,
					"content": "Những cọc gỗ này rất chắc chăn, không được xem thường... Vất vả cho bố rồi, cũng không biết ông ấy kiếm từ đâu ra nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
