			"trigger": {
				"objectNames": [
					"Tiến Sĩ Trà Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015401,
					"content": "...Lại nghe nói, sóng lớn trên biển ầm ầm, mây đen cuồn cuộn. Cho dù thành viên của Nam Thập Tự đều là người lái thuyền tài giỏi, thuyền cũng thuộc loại tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015402
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015402,
					"content": "Thế nhưng trong lúc nguy cấp thế này, thuyền có to đến đâu cũng bị cuốn đi, còn những chiếc thuyền bé thì cứ sóng đánh dồn dập cho đến khi chìm xuống đáy thì thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015403
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015403,
					"content": "Nhìn hướng mặt biển, trong con sóng lớn, dường như ẩn chứa một vật gì đó khổng lồ, hai mắt đỏ hửng, kẻ yếu bóng vía chắc hẳn nhắm tịt mắt, miệng lẩm bẩm cầu Nham Vương Gia bảo vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015404
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015404,
					"content": "Thế nhưng thuyền trưởng đứng đầu thuyền vẫn hiên mang cầm kiếm. Nhìn thẳng về phía con sóng, nơi có quái thú khổng lồ to như núi, vị anh hùng này chỉ cười: \"Được lắm, được lắm, cuối cùng ta cũng tìm được người!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015405
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015405,
					"content": "Vị anh hùng ấy là ai, quái vật khổng lồ ấy là vật gi, hai người có ân oán gì đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				}
			]
		},
