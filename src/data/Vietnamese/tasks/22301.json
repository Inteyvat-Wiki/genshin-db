				},
				{
					"id": 223011402,
					"content": "Xin hỏi, có nghe Liu Su kể chuyện không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011403
					]
				},
				{
					"id": 223011403,
					"content": "Tất nhiên là có rồi, có điều tiến sỹ Liu Su thật là khiến người khác bực mình. Lần trước nghe kể chuyện <color=#00E1FFFF>[Tài Vũ Thanh]</color> ở Hòa Dụ Trà Quán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011404
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 223011404,
					"content": "Vừa mới kể đến kiếp nạn môn phái Cổ Hoa, kẻ đến khiêu chiến nhiều vô kể, đệ tử rời môn phái cũng không ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011405
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 223011405,
					"content": "Những đệ tử còn ở lại quyết tâm bảo vệ núi, cho đến khi các tấm biển môn phái Cổ Hoa bị đập nát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011406
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 223011406,
					"content": "Khi chưởng môn phái Cổ Hoa vô cùng thất vọng, đuổi mọi người rời khỏi đây và quy ẩn, thì xuất hiện một thanh niên trẻ với kiếm thuật vô song tiến vào môn phái thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011407
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 223011407,
					"content": "Sau đó ông ta không kể nữa! Ai da, nói cái gì mà hồi sau sẽ rõ, hồi sau bao nhiêu ngày rồi, hoa đợi cũng héo luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011408
					],
					"speakerTitle": "Mậu Tài Công"
				},
				{
					"id": 223011408,
					"content": "Nếu lần sau còn thấy ông ta, phải bắt ông ta kể đến hết thì thôi!",
