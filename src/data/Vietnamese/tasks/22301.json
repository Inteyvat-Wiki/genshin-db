			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "Bạn quay trở lại rồi ư, vất vả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010202,
					"content": "Những chuyện này càng kể càng nhiều, mà quên cũng không ít, đó là chuyện khó tránh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010203,
					"content": "Bạn hỏi được chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				}
			]
		},
		{
			"id": 2230104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
