			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiến Sĩ Trà Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "Hết rồi đó, tôi kể đến đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010102,
					"content": "Kể gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "Xin chào, bạn là đến nghe kể chuyện sao? Hay là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010104,
					"content": "Tôi? Tôi ở đây là kể chuyện, kiếm chút tiền uống trà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010105,
					"content": "Chỉ có điều là chuyện tôi kể khá nhiều, lại vụn vặt vì vậy dễ nhớ nhầm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010106,
					"content": "Vài ngày trước đây một nhóm khách muốn nghe \"Hải Sơn Lục Vân Ký\" về đội thuyền Nam Thập Tự, một nhóm khác lại đòi nghe \"Tài Vũ Thanh\" về phái Cổ Hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010107,
					"content": "Tôi cũng vì là kiếm tiền, chọn ra vài đoạn trong sách mà mình còn nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010108,
					"content": "Chẳng ngờ khách nghe quá thích thú, nằng nặc đòi nghe tiếp, không kể tiếp thì phá phách, bạn nói xem thế thì....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010109,
					"content": "Hai cuốn sách này tôi vài năm trước kể qua rồi, lần này trở về dùng nửa ngày để xem lại, nhưng khi chuẩn bị mở sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010110,
					"content": "Lại quên mất hai cuốn sách lần trước kể đến đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010111,
					"content": "Bạn đi hỏi giúp tôi lần trước tôi kể đến đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010112,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "Vậy thì phiền bạn rồi. Tôi tự đi hỏi thì khác nào tự đập vỡ bảng hiệu của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010118,
					"content": "Sau một hồi suy nghĩ, bạn có thể hỏi ba người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010119,
					"content": "Một người là <color=#00E1FFFF>Mậu Tài Công</color>, đây là người không đọc sách bao giờ. Một người là <color=#00E1FFFF>Phạm Nhị Gia</color> cũng là chủ quán trà này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010120,
					"content": "Còn một người nữa là tiểu thư <color=#00E1FFFF>Jiangzhou</color>, lần trước kể chuyện, thấy cô ấy có dừng lại một chút để nghe, nhưng mà không lâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010114,
					"content": "Bạn kể lại từ đầu xem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "Tôi cũng muốn lắm, một câu chuyện kiếm hai lần tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010116,
					"content": "Thế nhưng Phạm Nhị Gia chắc hẳn sẽ đuổi tôi ra khỏi đây mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010117,
					"content": "Bạn vất vả rồi, giúp tôi đi hỏi một chút đi, hỏi được rồi thì về nói với tôi, tôi xem lại sách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				}
			]
		},
