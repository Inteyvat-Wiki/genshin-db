					"Tiến Sĩ Trà Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "Ngài vẫn ở đây, ha ha, quyển sách này... ngài thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010402,
					"content": "Còn gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "Ngài nhìn xem, [Tài Vũ Thanh] và [Hải Sơn Lục Vân Ký] đều là những tác phẩm vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010404,
					"content": "Vài ba câu không thể kể hết, ngài nếu muốn nghe sau này có thời gian đến là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010407,
					"content": "Cuốn sách này, thật cảm ơn ngài đã giúp đỡ, chỗ này ngài hãy nhận lấy, sau này mong ngài hãy giúp đỡ nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223010405,
					"content": "Chỉ cần ghi nhớ, hồi sau sẽ rõ...",
