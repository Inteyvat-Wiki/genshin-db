			"dialogs": [
				{
					"id": 223011701,
					"content": "Í, rảnh như vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011702
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011702,
					"content": "Xin hỏi bạn nghe Liu Su kể chuyện không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011703
					]
				},
				{
					"id": 223011703,
					"content": "Liu Su... kể chuyện?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011704
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011704,
					"content": "Ồ, tôi nhớ rồi, lần trước ngang qua đấy có dừng lại nghe một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011705
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011705,
					"content": "Có điều tôi không nhớ rõ, để tôi nghĩ... kể đến chuyện hình như là <color=#00E1FFFF>[Tài Vũ Thanh]</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011706
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011706,
					"content": "Hình như vì những lý do gì đó, tình hình phái Cổ Hoa không được tốt lắm, sau đó có một người rất lợi hại đến khiêu chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011707
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011707,
					"content": "Nhưng tôi đi quá muộn, khi đến nơi phần đầu đã kể xong rồi, phần sau hình như nói đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011708
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011708,
					"content": "Hình như là nhân vật chính đã sắp thắng nhưng đột nhiên bị đánh lén, bỗng chốc rơi vào tình thế bất lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011709
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011709,
					"content": "Nhưng, khi đó tôi lại bị gọi đi làm việc, thật muốn biết sau đó diễn biến ra sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangzhou"
				}
			]
		},
