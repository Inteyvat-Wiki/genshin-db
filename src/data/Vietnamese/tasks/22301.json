			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiến Sĩ Trà Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015101,
					"content": "...Chỉ thấy kiếm khách trẻ tuổi của phái Cổ Hoa tay cầm kiếm tiến đến, nhanh như gió, lẹ như mưa thu rơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015102
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015102,
					"content": "Người cầm kiếm đối diện tay đột nhiên đau nhói, thanh kiếm trong tay đã bị người kiếm khách trẻ tuổi đánh văng sang một bên từ lúc nào, thế nhưng người cầm kiếm tâm vẫn không phục, nào có dễ từ bỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015103
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015103,
					"content": "Nắm bắt thời cơ khi kiếm khách trẻ tuổi tung tuyệt chiêu thất kiếm, sức đã tận, ám khí trong tay vung lên bay vút qua một dây tơ xanh đậm, khi cổ tay hơi run, ba chiếc phi tiêu bay thẳng về phía khuôn mặt của kiếm khách trẻ tuổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015104
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015104,
					"content": "Sao lại xuống tay ác độc như vậy, kiếm khách trẻ tuổi sẽ ra sao, phái Cổ Hoa sẽ đi đâu về đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				}
			]
		},
		{
			"id": 2230152,
			"completionStepIds": [
				2230152
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
