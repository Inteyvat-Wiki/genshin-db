			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiến Sĩ Trà Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015201,
					"content": "...Kiếm sĩ trẻ tuổi thực sự rất giỏi. Mặc dù kiếm thế đã mất, anh ta vẫn nhấc chuôi kiếm lên, lảo đảo lùi lại hai bước, phóng ra ba đạo ám khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015202
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015202,
					"content": "Anh đang đứng nghỉ, thì đột nhiên người đàn ông to lớn trước mặt với vũ khí đã bị đá bay, vùng dậy, tay đặt vào eo, lấy ra một thanh kiếm mỏng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015203
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015203,
					"content": "Nhìn thấy kiếm khách trẻ tuổi giật về phía sau, người đàn ông to lớn tỏ ra đắc ý xông lên, kiếm khách trẻ không kịp đỡ đòn, nhất thời không biết phải xử lý ra sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015204
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015204,
					"content": "Đao kiếm va vào nhau, người kiếm khách trẻ tuổi đã thấm mệt, chân lại tiếp tục lùi bước, chỉ nghe thấy tiếng leng keng, kiếm của anh bị người đàn ông to lớn hất sang một bên, chưa để anh định thần, một quyền đấm ngay vào ngực anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015205
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015205,
					"content": "Kiếm khách trẻ tuổi tiếp tục lùi sâu vài bước, thanh kiếm cũng vang lên leng keng rồi rơi xuống đất, người đàn ông to lớn đắc chí, giơ kiếm lên định kết thúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015206
					],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				},
				{
					"id": 223015206,
					"content": "Thế nhưng lúc này, hiệp khách trẻ tuổi ngẩng đầu chỉ về phía người đàn ông to lớn và cười rằng: \"Đến đúng lúc lắm, thật đúng lúc, ngươi, sẽ thua ở đây.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiến Sĩ Trà Liu Su"
				}
			]
		},
