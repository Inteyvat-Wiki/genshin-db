			"dialogs": [
				{
					"id": 715380301,
					"content": "#Ồ, quả nhiên rất đẹp. Nhưng cũng không thể để {F#cô}{M#cậu} tặng không công cho tôi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "#Hãy cầm lấy chỗ điểm tâm này nhé, cảm ơn {F#cô}{M#cậu} rất nhiều. Có món quà này thì chuyến đi của tôi cũng đáng giá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "...Nhưng tôi rời Fontaine lâu thế rồi, không biết liệu mọi người trong đội có tập luyện đúng giờ hay không nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "Tóm lại, trước tiên cứ lập kế hoạch kiểm tra thể chất đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
