			"dialogs": [
				{
					"id": 715380101,
					"content": "#Xin chào {NICKNAME}, Tết Hải Đăng vui vẻ nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380102,
					"content": "Cô... đến đây để phá án sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "Tôi bị bắt nghỉ phép ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380105,
					"content": "Bị bắt... nghỉ phép á?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "Theo quy định của Sảnh Chấp Pháp, đến cuối năm thì mọi người đều phải nghỉ hết phép.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380107,
					"content": "Tuy nhiên sau khi kiểm kê cuối năm, đội đã phát hiện ra tôi chưa hề nghỉ một ngày nào cả. Cho nên là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380108,
					"content": "Đội Tuần Tra Đặc Biệt vất vả thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "Không, Đội Tuần Tra Đặc Biệt có chế độ nghỉ phép luân phiên, nhưng với tư cách là đội trưởng thì tôi phải thường trực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380111,
					"content": "Hơn nữa, thỉnh thoảng có một số tình huống bất ngờ mà tôi phải giải quyết. Lâu dần... tôi đã quên luôn cả các kỳ nghỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380112,
					"content": "Năm nay tôi vẫn ổn khi không cần nghỉ phép, nhưng các thành viên trong đội lại không đồng ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380113,
					"content": "Họ hét lên: \"Đội trưởng, quy tắc được ghi rõ đấy, đội trưởng sao có thể vi phạm chứ?\" Và cứ nhất quyết bắt tôi nghỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380114,
					"content": "Ngoài ra, còn có một kiểm sát viên hay đến đội của chúng tôi làm việc cũng ở bên cạnh ủng hộ. Anh ta thậm chí còn nói Liyue đang tổ chức Tết Hải Đăng, dúi vé vào tay và bảo đây là nơi tốt nhất để nghỉ dưỡng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380115,
					"content": "Nhưng đúng là Liyue rất thú vị đấy. Tôi vừa từ Làng Kiều Anh trở về, những món điểm tâm làm từ lá trà ở đó đều rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380116,
					"content": "Tôi đã mua rất nhiều điểm tâm, định mang về cho các thành viên trong đội nếm thử. Tôi cũng muốn làm một vài tấm thiệp chúc mừng theo phong tục của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380117,
					"content": "Chỉ là... tôi không giỏi làm những việc như thế này cho lắm. Làm thế nào thì cũng cảm thấy rất kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380118,
					"content": "#{NICKNAME}, {F#cô}{M#cậu} có biết cách làm những thứ này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380119,
					"content": "Tôi có vài gợi ý đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "Mọi người ở Đội Tuần Tra Đặc Biệt đều như thế à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "Cô... trông không giống như đến đây làm việc nhỉ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
