			"dialogs": [
				{
					"id": 750100201,
					"content": "Có thứ gì đó lông lá đang chặn bạn lại...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100202
					]
				},
				{
					"id": 750100202,
					"content": "Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100203
					],
					"speakerTitle": "Alpaca Hoạt Bát"
				},
				{
					"id": 750100203,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100204
					],
					"speakerTitle": "\"Trứng Lòng Đào\""
				},
				{
					"id": 750100204,
					"content": "Mmmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100205
					],
					"speakerTitle": "Alpaca Hoạt Bát"
				},
				{
					"id": 750100205,
					"content": "Ấy? Thì ra hai ngươi là bạn bè sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100206,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100207,
					"content": "Người trông coi Alpaca ở gần đây đã đến an ủi Yumkasaur...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100208
					]
				},
				{
					"id": 750100208,
					"content": "Bình tĩnh nào, Trứng Lòng Đào. Chính vì cứ lỗ mãng như thế này suốt nên mới có tên là Trứng Lòng Đào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100209
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100209,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100210
					],
					"speakerTitle": "\"Trứng Lòng Đào\""
				},
				{
					"id": 750100210,
					"content": "Xin lỗi nhé, nó chỉ là có tinh thần trách nhiệm quá thôi. Hễ thấy người lạ đến gần là sẽ rất căng thẳng. Nhưng nhờ nó chăm chỉ trông coi Alpaca mà tôi có thể sống một cuộc sống nhàn nhã qua ngày đấy, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100211,
					"content": "Vậy các vị tới đây có việc gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100212,
						750100214
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100212,
					"content": "Chỉ là đi thám hiểm khắp nơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100213,
					"content": "#À, thì ra là nhà mạo hiểm! Không chừng trong mắt Trứng Lòng Đào, {F#cô}{M#cậu} chính là nhân vật nguy hiểm toàn thân tỏa ra sát khí đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100216,
					"content": "Không ngờ Yumkasaur còn có thể trông coi Alpaca nữa đó. Trước đây nhìn thấy chúng từ xa, còn tưởng là Alpaca sắp bị tấn công rồi chứ. Thì ra là tôi hiểu lầm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100217,
					"content": "Haha, chuyện đó xảy ra hoài à. Mặc dù có vẻ ngoài hung dữ, nhưng thực chất nó rất thân với Alpaca đấy. Nói là bạn bè cũng không quá đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100218
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100218,
					"content": "Rrrooo... Rawr! Rawr! Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100219,
					"content": "Sao thế, nhóc cũng muốn kết bạn với chúng hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100220
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100220,
					"content": "Rawr rawr! Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100221,
					"content": "#Woa, háo hức thế, xem ra thật sự rất muốn làm bạn với chúng đấy. Nhưng cũng phải, thường ngày nó chỉ ở với tôi và {NICKNAME}, nếu có thể làm quen với các bạn khác thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100222,
					"content": "Vậy hẳn là khung cảnh đáng yêu lắm. Tepetlisaur nhỏ bị Alpaca vây quanh, nhìn thế thôi là tôi có thể ăn được ba bát Thịt Hầm Hỏa Diệm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100223
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100223,
					"content": "À, nhưng cũng phải xem Alpaca có đồng ý không đã. Dù sao thì tình bạn cũng không cưỡng ép được mà. Đúng không, Trứng Lòng Đào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100224
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100224,
					"content": "Mrrmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100225,
						750100228
					],
					"speakerTitle": "\"Trứng Lòng Đào\""
				},
				{
					"id": 750100225,
					"content": "#Kẻ nào lại dám không thích {REALNAME[ID(2)|SHOWHOST(true)]} nhà tôi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100226
					]
				},
				{
					"id": 750100226,
					"content": "#Đừng ra vẻ người giám hộ thế chứ! Cứ cho {REALNAME[ID(2)|SHOWHOST(true)]} tự thử sức xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100227,
					"content": "Trẻ con cũng phải tự mình cố gắng thì mới trưởng thành được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100231,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100232
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100232,
					"content": "Nhìn vẻ tự tin của nó chắc là không cần lo lắng quá đâu, vậy tôi về nghỉ ngơi trước đây. Có vấn đề gì thì tới tìm tôi nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100233
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100233,
					"content": "À, nhưng mà tìm tôi thì thà tìm Trứng Lòng Đào còn hơn. Nói đến Alpaca thì nó hiểu rõ nhất đó. Haha, đùa thôi. Chúc mọi việc thuận lợi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100228,
					"content": "Không sao đâu, chúng không muốn thì còn có tụi này mà.",
