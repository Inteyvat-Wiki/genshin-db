			"dialogs": [
				{
					"id": 200430301,
					"content": "Tại sao còn chưa giao tới, nguy to rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430302,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "A... quả nhật lạc trong sạp bán hết rồi, tôi vừa đi đặt thêm vài thùng quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430304,
					"content": "Nhưng tới giờ vẫn chưa giao tới... rất nhiều khách còn đang đợi mua kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430305,
					"content": "Riêng cô Eury đã đến 3 lần rồi, cô ấy chỉ cần <color=#00E1FFFF>3 quả nhật lạc</color>, tôi không muốn mất khách quen này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430306,
					"content": "Tôi còn phải trông sạp... nếu có ai có thể ra ngoài thành tìm giúp tôi ít quả nhật lạc thì thật tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430307,
					"content": "Nếu gấp, tôi có thể giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "Bạn đồng ý giúp đỡ sao? Thật tốt quá, vậy thì nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430309,
					"content": "Cô Michelle sẽ đến ngay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "Đợi một chút! Cô Michelle như vậy rồi làm sao ra ngoài thành hái trái cây được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430311,
					"content": "Chúng ta đến giúp đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
