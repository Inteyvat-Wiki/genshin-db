			"dialogs": [
				{
					"id": 200430101,
					"content": "Sao đau lưng như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430102,
					"content": "Bạn sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "Tôi đang chuẩn bị đi làm việc, nhưng đột nhiên đau lưng quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430104,
					"content": "Tôi đã hẹn với Quinn đến sạp trái cây của anh ấy giúp đỡ, bây giờ chỉ có thể nghỉ ngơi chút rồi đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430105,
					"content": "Í, nhưng cứ ở đây cũng chỉ làm lỡ việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430106,
					"content": "Bạn có thể giúp tôi đi hỏi Quinn, anh ấy cần tôi làm gì không? Để tôi chuẩn bị trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430107,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "Vậy thì phiền bạn rồi, tôi nghỉ ngơi một chút là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430109,
					"content": "Nhìn cũng không xa lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "Này, việc nhỏ như vậy, giúp chút cũng không có gì mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
