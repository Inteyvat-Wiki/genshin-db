						200430504
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430504,
					"content": "Ây, nhưng có nhiều khách đi mất rồi, đúng là một người thì không làm kịp thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430505,
					"content": "À phải rồi, cảm ơn sự giúp đỡ của bạn, phải tặng bạn quà cảm ơn mới được, xin đợi một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430506,
					"content": "Quà cảm ơn thì không cần đâu, chúng tôi có việc cần bạn giúp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430507,
					"content": "Về tiểu thư Michelle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "Cô Michelle... các bạn gặp cô ấy rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430509,
					"content": "Hy vọng tôi giao cho cô ấy một công việc nhẹ nhàng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430510,
					"content": "Nhưng ban đầu tôi chỉ muốn để cô ấy trông tiệm giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430511,
					"content": "Là, là vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430512,
					"content": "Nhưng hiện nay khách đều đi hết rồi, xem ra không cần người trông coi tiệm nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430513,
					"content": "Phiền các bạn nói với tiểu thư Michelle, bảo cô ấy đi về nghỉ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430514,
					"content": "Lát nữa tôi đi xem lô hàng ấy như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
