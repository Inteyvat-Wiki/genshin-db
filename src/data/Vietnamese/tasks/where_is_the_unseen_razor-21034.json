			"dialogs": [
				{
					"id": 210340401,
					"content": "Thế nào? Bạn đã hạ gục hết lũ ma vật đó chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340402,
					"content": "Cô đã dọn dẹp hết ma vật ở đây rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "Hửm? Đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340404,
					"content": "Dù sao thì tôi cũng là hội trưởng của Hiệp Hội Nhà Mạo Hiểm Liyue mà. Đối phó với lũ ma vật tầm thường này cũng không tốn bao nhiêu sức lực đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
