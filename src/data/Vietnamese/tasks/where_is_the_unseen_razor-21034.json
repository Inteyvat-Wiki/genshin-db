			"dialogs": [
				{
					"id": 210340101,
					"content": "Hmm, có vẻ như là đang ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340102,
					"content": "Lan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "Nhà Lữ Hành? Không ngờ lại gặp bạn ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340105,
					"content": "Bạn còn nhớ chuôi kiếm lần trước các bạn tìm giúp tôi không? Nó đúng là một phần của Tàng Phong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340106,
					"content": "Nói ra thật buồn cười, tôi có thể nhận ra nó là vì khi còn nhỏ tôi đã lén lấy dao khắc ký hiệu lên nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340107,
					"content": "Khi đó tôi nói với anh của tôi, rằng nếu sau này anh ấy đổi cây kiếm khác thì nhất định phải tặng Tàng Phong cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340108,
					"content": "Haha, khi đó có lẽ cả hai chúng tôi đều không ngờ... tôi lại có được Tàng Phong bằng cách này. Có vẻ như thanh kiếm này hỏng thật rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340109,
					"content": "Được rồi, không nói chuyện phiếm nữa. Gặp bạn ở đây rồi thì tôi lại phải nhờ bạn giúp tôi thêm một việc vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340110,
					"content": "Phía trước là hai nơi ma vật tụ tập, lũ ma vật này đã thu thập rất nhiều vũ khí hỏng để trong doanh trại, không biết để làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340111,
					"content": "Hiệp hội lo lắng chúng sẽ làm náo động khu vực xung quanh, vốn dĩ định treo ủy thác, nhưng sau khi nhìn thấy thì tôi đã tự gỡ xuống... Có lẽ, tôi sẽ tìm thấy một số mảnh vỡ của Tàng Phong ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340112,
					"content": "Nhà Lữ Hành, chúng ta mỗi người dọn sạch một doanh trại đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340113,
					"content": "Doanh trại bên trái có một lũ Hilichurl tụ tập, mặc dù đối với bạn thì một con Hilichurl không khó đối phó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340114,
					"content": "Nhưng số lượng Hilichurl ở đây không ít, nếu chúng cùng xông lên thì e là bạn cũng phải tốn chút sức lực đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340115,
					"content": "Bên phải là một con Vua Mũ Đá Hilichurl, mức độ nguy hiểm của nó... có lẽ tôi cũng không cần phải giải thích nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340116,
					"content": "Tôi nhờ bạn giúp, nên bạn chọn trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340103,
					"content": "Sao cô lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
