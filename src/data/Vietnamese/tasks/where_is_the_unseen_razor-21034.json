			"dialogs": [
				{
					"id": 210340501,
					"content": "Nhà Lữ Hành, bạn đã giải quyết hết lũ ma vật trong doanh trại chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340502,
					"content": "Đã giải quyết xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "Chỉ là một lũ ma vật tầm thường, không tốn nhiều sức lực. Hơn nữa vận may của tôi cũng không tệ, tôi còn tìm được một mảnh trường kiếm có giá trị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340505,
					"content": "Tôi không phát hiện được gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "Đừng lo lắng, bạn đã giúp tôi loại bỏ một điểm sai rồi, cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340507,
					"content": "Đây là thù lao của bạn, hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340508,
					"content": "Nếu tìm được tất cả các mảnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "Chuyện tôi muốn làm rất đơn giản, đó là... đúc lại Tàng Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340511,
					"content": "Mặc dù bản vẽ dùng để đúc Tàng Phong đã mất, tôi cũng không biết dùng nguyên liệu gì để đúc... nhưng rồi sẽ có cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340512,
					"content": "Nếu thật sự có thể đúc lại Tàng Phong, vậy thì anh trai chắc chắn cũng... haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340509,
					"content": "Cô tìm những mảnh vụn đó để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "Bên cô thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				}
			]
		},
