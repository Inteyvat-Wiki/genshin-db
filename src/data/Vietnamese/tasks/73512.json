					}
				]
			},
			"dialogs": [
				{
					"id": 735120101,
					"content": "Ừm! Cảm ơn bạn nhé! Nhà mạo hiểm dũng cảm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120102,
					"content": "Tốt quá, linh kiện vẫn chưa bị sao... sửa chữa một chút là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120103,
					"content": "Vinayak bắt đầu mày mò linh kiện...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735120104
					]
				},
				{
					"id": 735120104,
					"content": "...Vinayak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120105,
					"content": "Ừm ừm, sắp xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120106,
					"content": "Vi-na-yak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120107,
					"content": "Ối! Shriya? Cô đến đây từ lúc nào thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120108,
					"content": "Trong lúc anh đang mày mò đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120109
					]
				},
				{
					"id": 735120109,
					"content": "Không phải cô nói là ở đây có ma vật, rất nguy hiểm sao? Sao cô lại một mình đến đây rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120110,
					"content": "Tôi chỉ lo lắng cho số linh kiện của chúng ta thôi, mắc công có chuyện gì thì đến tôi cũng không thể quay về Giáo Viện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120111
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120111,
					"content": "Hờ, linh kiện đều ở đây hết rồi. Đợi lát nữa quay về chỉnh sửa lại đôi chút là sẽ có thể bắt đầu lắp ráp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120112,
					"content": "Nói chứ, những thứ này là linh kiện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120113,
					"content": "À, tôi quên giới thiệu... Đây là \"Pháo Diệt Wenut\", là đồ án thiết kế tốt nghiệp của chúng tôi năm xưa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120114,
					"content": "...Sao lại chọn một chủ đề khó nhằn đến vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120115,
					"content": "Nếu bạn đã từng làm qua những đồ án tốt nghiệp thì sẽ hiểu được thôi... Khụ, những chuyện này không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120116,
					"content": "Để tôi tự mình giới thiệu lại đã, tôi là Shriya thuộc Học Viện Amurta, hướng học chủ đạo là nghiên cứu môi trường và sinh vật sa mạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120117
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120117,
					"content": "...Còn tên ngốc này thuộc Học Viện Kshahrewar, chủ yếu nghiên cứu ứng dụng cơ quan học.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120118
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120118,
					"content": "Tôi tên là Vinayak, trước đó cảm ơn các bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120119
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120119,
					"content": "Phương hướng nghiên cứu khác nhau hoàn toàn... liệu có thể hợp tác được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120120,
					"content": "Đừng nhắc nữa... Dính vào tên này chính là sai lầm lớn nhất trong cuộc đời học sinh của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120121
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120121,
					"content": "Đừng nói thế chứ, thì hai chúng ta cũng đã tốt nghiệp đấy thôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120122
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120122,
					"content": "Đúng thế! Rồi anh tính xem đã trễ hơn những người cùng trang lứa bao nhiêu năm rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120123
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120123,
					"content": "Thì không phải cũng là tốt nghiệp rồi đó sao? Tôi nghe nói nhiều người năm ngoái mới được thông qua đồ án thôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120124
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120124,
					"content": "Haiz... Đủ rồi! Tranh luận như vậy thời học sinh tôi đã chịu quá đủ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120125
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120125,
					"content": "Thì mỗi lần đều do cô bắt đầu cả mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120126
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120126,
					"content": "Làm gì có chứ? Như hồi lần đầu tiên chúng ta chế tạo bản mẫu ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120127,
						735120128
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120127,
					"content": "Ngừng lại!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				},
				{
					"id": 735120129,
					"content": "Ừm... như nước với lửa, mà không hiểu sao Giáo Viện lại để hai người xử lý vấn đề chung với nhau nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120130,
					"content": "Haiz, cũng không thể nói là Giáo Viện phái chúng tôi đến... Có một người tên Kunar được cho là sẽ lo liệu vấn đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120160
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120160,
					"content": "Ông ấy được xem là người hướng dẫn của người hướng dẫn tôi, ông ấy đã dự thính khi chúng tôi bảo vệ luận án tốt nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120161
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120161,
					"content": "Cũng vào khoảng thời gian đó mà để lại cho ông ấy ấn tượng là \"có người trẻ tuổi nào đó đã làm ra Pháo Diệt Wenut\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120162
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120162,
					"content": "Cho nên lần này ông ấy nói cái gì mà \"cho người trẻ tuổi cơ hội\", sau đó phái chúng tôi đi giải quyết chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120163
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120163,
					"content": "Rõ ràng là sau khi tốt nghiệp thì chúng tôi đã không mấy qua lại nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120131
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120131,
					"content": "Đến cả người hướng dẫn của tôi cũng đã bị thuyết phục... Khụ, nhưng cũng nhờ cơ hội này mà tôi mới có thể để cho Pháo Diệt Wenut có ngày được tái xuất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120132
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120132,
					"content": "Đợi khi nào lắp ráp xong thì sẽ có thể để đám Wenut đó biết thế nào là lợi hại rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120133
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120133,
					"content": "Tên ngốc này lại bắt đầu rồi đấy... Nhưng từ góc độ của tôi mà nói, cũng muốn nghiên cứu về nguyên nhân số Wenut này làm loạn, để duy trì sự cân bằng sinh thái cho sa mạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120134
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120134,
					"content": "Nhà mạo hiểm đây thân thủ rất khá. Xin hỏi có thể mời bạn bảo vệ cho sự an toàn của chúng tôi trong thời gian chúng tôi ở trong sa mạc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120135,
						735120136
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120135,
					"content": "Có Mora thì dễ nói chuyện thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120137,
					"content": "Xin yên tâm, chuyến này Giáo Viện những mặt khác hỗ trợ không nhiều, nhưng kinh phí thì lại rất dư dả... Tuy rằng ai đó đã tiêu hết hơn một nửa để mà nâng cấp máy móc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120138
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120138,
					"content": "Đều... đều là những nâng cấp cần thiết mà! ...Mà nói chứ, không phải cô vẫn có thể nói chuyện đàng hoàng sao, sao cứ đụng tới tôi là phải đâm chọt vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120139
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120139,
					"content": "Vậy thì phải xem đối tượng nói chuyện có xứng để tôi phải nói chuyện đàng hoàng không đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120140
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120140,
					"content": "Haiz, hai người này lại bắt đầu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120141,
						735120142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120141,
					"content": "Muốn cãi nhau thì để sau này hai người cãi thoải mái...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120143,
					"content": "Haiz... Xin lỗi, bệnh cũ từ thời đi học rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120144
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120144,
					"content": "Lô linh kiện này còn phải kéo về Làng Aaru để điều chỉnh thêm. Tính ra, dù gì thì cũng phải tới mai mới có thể bắt đầu lắp ráp phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120145
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120145,
					"content": "Lúc trước chúng tôi định sẽ lắp đặt Pháo Diệt Wenut ở nơi có Wenut xuất hiện gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120146
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120146,
					"content": "Đến lúc đó, có thể sẽ có ma vật khác cũng bị tiếng động do chúng tôi gây ra thu hút đến... Vậy phải nhờ bạn ra tay rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120147,
						735120148
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120147,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120149,
					"content": "Vậy bây giờ, Shriya, chúng ta có thể tiếp tục tranh luận rồi. Kinh phí mà tôi đã tiêu tuyệt đối có lý do chính đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120150
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120150,
					"content": "Anh...! Được thôi! Thích tính sổ phải không? Tôi theo đến cùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120148,
					"content": "Mai gặp nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120142,
					"content": "Bây giờ có thể nói trước về chuyện công việc không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120136,
					"content": "Chuyện nhỏ không đáng phải nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120128,
