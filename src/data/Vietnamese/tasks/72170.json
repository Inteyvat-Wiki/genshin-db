					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700304,
					"content": "Quả đúng là...đơn giản...Tôi lấy cái này được rồi, cảm giác là ăn không hết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700305,
					"content": "Chỉ cần ngon miệng là được rồi, tôi chọn cái này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700306,
					"content": "Đây là của bạn, Nhà Lữ Hành. Và cách làm món Cơm Nắm này, tôi cũng đã chép một bản cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700307,
					"content": "Tuy cách làm Cơm Nắm nhìn rất đơn giản, nhưng muốn ngon thì vẫn cần chút kỹ thuật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700308,
					"content": "Khà...Được rồi, không nói nhiều nữa, bận rộn cả buổi rồi, tôi cũng phải đi ăn một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700309,
					"content": "Này! Parvaneh, không phải nói cô ăn không hết sao? Nhớ chừa phần tôi!",
					"roleType": "TALK_ROLE_NPC",
