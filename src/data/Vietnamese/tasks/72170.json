			"dialogs": [
				{
					"id": 721700101,
					"content": "Vậy cũng không được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700102,
					"content": "Sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "Nhà Lữ Hành, chúng ta lại gặp mặt rồi. Chúng tôi đang nghĩ cách...lặn xuống nước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700104,
					"content": "Sau đó, lấy một ít Rong Biển Tươi để làm món Cơm Nắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700105,
					"content": "Cái này lấy ở bờ biển là được mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "Rong biển ở bờ biển thì không được tươi lắm, lấy làm thức ăn cảm thấy hơi có mùi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700109,
					"content": "Tôi đã hỏi thăm người trong thành rồi, ở bên dưới đây có loại Rong Biển chất lượng rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700110,
					"content": "Nhưng hôm nay đến...mới thấy là nơi này đã bị nước biển nhấn chìm hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700111,
					"content": "Mà ba chúng tôi...đều không biết lặn, nên chỉ có thể đứng đây nhìn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700112,
					"content": "Ở xung quanh có cơ quan gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "Ở kia có một cơ quan! Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700114,
					"content": "Nhưng cơ quan đó bị rào lại rồi, không vào trong được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700115,
					"content": "Haizz, để chúng tôi tiếp tục nghiên cứu xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700116,
					"content": "Nhà Lữ Hành, nếu bạn biết cách giải quyết thì hãy nhanh chóng nói với chúng tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700117,
					"content": "Mà đương nhiên, nếu bạn có thể lấy giúp Rong Biển lên thì càng tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700118,
					"content": "Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700119,
					"content": "À! Nếu bạn có thể lấy Rong Biển lên giúp, thì nhất định không thiếu phần thù lao của bạn đâu, và còn thêm một bữa Cơm Nắm thịnh soạn dâng lên mời bạn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700120,
					"content": "Cơm Nắm thì làm sao gọi là bữa ăn \"thịnh soạn\" được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700121,
					"content": "Ây da, chỉ cần đủ số lượng là được... Hừm, để chúng ta tiếp tục nghĩ cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700107,
					"content": "Nhất định phải lặn xuống sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "Rong biển lấy được từ bờ biển thì không được tươi lắm, lấy làm thức ăn cảm thấy hơi có mùi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				}
			]
		},
