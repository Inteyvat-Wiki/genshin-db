			"dialogs": [
				{
					"id": 721700701,
					"content": "Ở bên dưới, hình như bị ngập rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700702
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700702,
					"content": "Ừm, vết nước trông rất rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700703
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700703,
					"content": "Nhưng tại sao nước lại đột nhiên rút hết chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700704
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700704,
					"content": "Chẹp...xung quanh đây đều chèm nhẹp, giày cũng ướt hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700705
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700705,
					"content": "Thôi mặc kệ, mau xuống đó hái Rong Biển trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700706,
					"content": "Các bạn đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "Ấy? Không ngờ gặp được bạn ở đây, chúng ta cũng có duyên lắm, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700708,
					"content": "Chúng tôi vừa xuống hái Rong Biển để chuẩn bị làm món \"Cơm Nắm\", con đường dưới đó khó đi thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700709,
					"content": "Không nói mấy chuyện này nữa, Nhà Lữ Hành, bạn có thể giúp chúng tôi hái thêm một ít Rong Biển ở dưới kia không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700710,
					"content": "Ở dưới đó hình như từng bị ngập nước qua, tuy giờ nước đã rút rồi, nhưng... không biết nước có lại đột nhiên ngập nữa không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700711,
					"content": "Tôi cảm thấy phải nhanh nhanh hái Rong Biển mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700712,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "Vậy nhờ bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700714,
					"content": "Sau khi hái được thì hãy đưa cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700715,
					"content": "Tại sao không hái ở quanh bờ biển?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "Rong Biển ở bờ biển thì không được tươi lắm, lấy làm thức ăn cảm thấy hơi có mùi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700717,
					"content": "Rong Biển ở đây chắc sẽ rất tốt. Tóm lại, việc hái Rong Biển xin nhờ bạn rồi, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
