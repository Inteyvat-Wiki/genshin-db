					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700203,
					"content": "Tôi sẽ bắt đầu làm món...Cơm Nắm, nghe nói làm cũng khá đơn giản...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700204,
					"content": "Ôi, tôi cần chút thời gian để xử lý nguyên liệu, bạn đợi một lát nhé.",
					"roleType": "TALK_ROLE_NPC",
