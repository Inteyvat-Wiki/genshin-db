					"speakerTitle": "Anthony"
				},
				{
					"id": 200520304,
					"content": "Tôi tôn trọng ước mơ của Anna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200520305,
					"content": "Khó khăn lắm Anna mới khỏi bệnh và có cơ hội theo đuổi ước mơ của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200520306,
					"content": "Người làm anh như tôi...sẽ ủng hộ hết mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520307
					],
					"speakerTitle": "Anthony"
				},
