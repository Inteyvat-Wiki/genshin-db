					"speakerTitle": "Arakara"
				}
			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "Là Aranakula! Aranakula đã về Vanarana rồi kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680302,
					"content": "#Nara {NICKNAME}, cả Paimon nữa! Cỗ Máy Varuna đã sửa xong rồi, thế thì Aranakula có thể tập trung chăm sóc vườn ươm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680303,
					"content": "Đây là vườn ươm mà Aranakula luôn nhắc đến sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680304,
					"content": "Đúng thế, đó là vườn ươm mà Aranakula và Arakara cùng nhau chăm sóc. Đất ở đây vốn thích hợp để sinh trưởng, có thể trồng được Viparyas vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680305,
					"content": "Còn có cả Viparyas buồn bã sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680306,
					"content": "Không phải buồn bã, chẳng qua là không vui vẻ quá thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680307,
					"content": "...Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680308,
					"content": "Giống như có thổ nhưỡng thích hợp để sinh trưởng, cũng không thiếu mưa nắng, không có trở ngại trong quá trình phát triển... Giống như không có chuyện buồn, nhưng cũng không vui vẻ quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680309,
					"content": "Ồ... Tức là cảm thấy bình thường thôi ư? Thế thì chỗ này có gì khác với những nơi khác?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680310,
					"content": "Đất ở Vanarana đều tốt, nhưng nơi này đặc biệt tốt. Ngoài ra còn điều quan trọng hơn đó là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680311,
					"content": "Arakara và Aranakula, sẽ chăm sóc chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680312,
					"content": "Chăm sóc... Cụ thể về mặt nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680313,
					"content": "Sẽ diễn tấu âm nhạc cho chúng nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680314,
					"content": "Còn khen chúng trông thật đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680315,
					"content": "Đây là sự khác biệt giữa tự nhiên và nuôi trồng sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "Hình như cũng không khó hiểu lắm... Nếu mỗi ngày đều được nghe nhạc êm tai, còn được khen xinh đẹp thì thật khó để buồn bã nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680317,
					"content": "#Phải rồi, giống như tôi, trước khi bị {NICKNAME} câu lên thì không buồn, nhưng cũng không vui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680318,
					"content": "#Sau khi cùng {NICKNAME} du ngoạn, tuy có lúc gặp khó khăn nhưng những lúc vui vẻ cũng vui gấp mấy lần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680319,
					"content": "Paimon nói đúng lắm, Arakara sẽ dùng Viparyas vui vẻ để làm những chiếc đèn xinh đẹp, dành cho Lễ Hội Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680320,
					"content": "Hì hì, nếu Aranakula đã về rồi, vậy chúng ta mau bắt đầu thôi! Hạt giống Viparyas... Viparyas cũng có hạt à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680321,
					"content": "Viparyas là lời nói mớ của mặt đất, là điều mà mặt đất nhớ đến trong giấc mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680322,
					"content": "Vậy hạt giống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680323,
					"content": "Viparyas không có hạt giống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680324,
					"content": "Hả? Nếu không có hạt giống thì làm sao trồng trong vườn ươm được... Chẳng lẽ Aranakula có Ararakalari nào đó có thể trồng được Viparyas từ không khí sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680325,
					"content": "Không phải, Paimon sai rồi... Để trồng Viparyas trong vườn cần có Vasmrti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680326,
					"content": "Van...Van gì cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680327,
					"content": "\"Vasmrti\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "Vana sẽ nhớ hết mọi thứ, vì vậy, nếu có Vasmrti, mặt đất sẽ nhớ lại lần nữa trong mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680329,
					"content": "Vườn ươm cũng sẽ mọc ra những cây Viparyas vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680330,
					"content": "#Ơ... Vậy, vậy \"Vasmrti\" này chỉ có Aranara mới lấy được thôi sao? Có phải tôi và {NICKNAME} không có cơ hội trồng Viparyas rồi không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680331,
					"content": "#Nara Vàng từng giúp đỡ Aranakula, cũng như các Aranara khác, là bạn của Aranara, vì thế Aranakula sẽ cùng {NICKNAME} trồng Viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680332,
					"content": "#Chôn Vasmrti sâu dưới đất sẽ có thể trồng được Viparyas, Nara {NICKNAME}, hãy thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680333,
					"content": "Làm theo lời Aranakula, chôn \"Vasmrti\" xuống đất.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "Thế này thì được rồi à? Có vẻ không khác gì trồng mấy loại cây khác! Chôn hạt giống xuống đất, sau đó đợi hạt nảy mầm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680335,
					"content": "Vasmrti không phải là hạt giống. Cũng giống như Paimon không phải là mèo biết bay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680336,
					"content": "Ừm... Được, được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680337,
					"content": "Kể ra thì, trong vườn ươm vẫn còn rất nhiều đất trống, một, hai, ba... Còn những mười hai thửa trông có vẻ có thể trồng được Viparyas đấy. Aranakula vẫn còn có nhiều Vasmrti mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680338,
					"content": "Trước kia có, nhưng bây giờ không còn bao nhiêu, phải thu thập lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680339,
					"content": "Ngoài mộng cảnh, vẫn còn mười hai vườn ươm có thể ngưng tụ ra Vasmrti. Nếu có chúng thì vườn ươm của Vanarana có thể mọc đầy Viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680340,
					"content": "#Lễ Hội Utsava cần rất nhiều Viparyas, Vanarana đã có rất nhiều, nhưng nếu có nhiều Viparyas vui vẻ hơn thì Aranara sẽ rất vui, {NICKNAME} và Paimon cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680341,
					"content": "Nếu vậy, chúng tôi cũng tới phụ các bạn thu thập Vasmrti! Nhưng nên thu thập nó bằng cách nào? Arakara vừa nói ở vườn ươm ngoài mộng cảnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680342,
					"content": "Nara Vàng, cần đi ngang qua đất của vườn ươm, nhưng chỉ cần một lần thôi, đi quá nhiều, không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680343,
					"content": "Chỉ cần đi qua một lần... đất của vườn ươm sẽ ngưng tụ ra Vasmrti, như mưa rơi rả rích đêm trước, khi trời tờ mờ sáng sẽ ngưng tụ thành sương trên phiến lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680344,
					"content": "Ơ... nghe không hiểu gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680345,
					"content": "Nhưng dựa trên kinh nghiệm trước đây khi giao tiếp với Aranara... Là chờ tới khi chúng ta tìm thấy vườn ươm ngoài mộng cảnh thì tự khắc sẽ biết Aranakula đang nói gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680346,
					"content": "Sau này nếu tìm thấy vườn ươm, thì vào xem thử nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
