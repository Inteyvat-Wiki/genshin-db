			"dialogs": [
				{
					"id": 730680401,
					"content": "Là Aranakula! Aranakula đã thuận lợi về Vanarana rồi kìa. Còn có... Aranara lạ mặt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680402,
					"content": "#Nara {NICKNAME}, cả Paimon nữa! Cỗ Máy Varuna đã sửa xong rồi, thế thì Aranakula có thể tập trung chăm sóc vườn ươm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680403
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680403,
					"content": "Đây là Arakara, Aranakula và Arakara cùng chăm sóc vườn ươm ở Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680404
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680404,
					"content": "Đây là vườn ươm mà Aranakula luôn nhắc đến sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680405,
					"content": "Đúng thế, đất ở đây vốn thích hợp để sinh trưởng, có thể trồng được Viparyas vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680406
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680406,
					"content": "Còn có cả Viparyas buồn bã sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680407,
					"content": "Không phải buồn bã, chẳng qua là không vui vẻ quá thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680408
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680408,
					"content": "...Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680409,
					"content": "Giống như có thổ nhưỡng thích hợp để sinh trưởng, cũng không thiếu mưa nắng, không có trở ngại trong quá trình phát triển... Giống như không có chuyện buồn, nhưng cũng không vui vẻ quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680410
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680410,
					"content": "Ồ... Tức là cảm thấy bình thường thôi ư? Thế thì chỗ này có gì khác với những nơi khác?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680411,
					"content": "Đất ở Vanarana đều tốt, nhưng nơi này đặc biệt tốt. Ngoài ra còn điều quan trọng hơn đó là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680412
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680412,
					"content": "Arakara và Aranakula, sẽ chăm sóc chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680413
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680413,
					"content": "Chăm sóc... Cụ thể về mặt nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680414,
					"content": "Sẽ diễn tấu âm nhạc cho chúng nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680415
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680415,
					"content": "Còn khen chúng trông thật đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680416
					],
					"speakerTitle": "Arakara"
