			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "Xin chào! Đất ở đây trông khác với những nơi khác, có tác dụng đặc biệt gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680103,
					"content": "Hửm? Sao không có phản ứng? Không nghe thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680104,
					"content": "Xin! Chào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "...Ơ? Na, Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680108,
					"content": "Sao, sao lại? Sao Vanarana lại có Nara? Đến để bắt tôi đem đi nướng ư? Arakara không ngon bằng nấm đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680109,
					"content": "Sao chúng tôi có thể làm một điều khủng khiếp như vậy chứ, chúng tôi là \"bạn tốt của Aranara\", được mọi người công nhận đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680110,
					"content": "Chưa từng có ai nói thế cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "Tuy mọi người không nói ra, nhưng hẳn trong lòng nghĩ như thế, tôi không cần hỏi cũng biết mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680114,
					"content": "#Tóm lại, tôi là Paimon, người màu vàng bên này là {NICKNAME}, là một Nara tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680115,
					"content": "Bạn là Arakara, phải không? Một Aranara như bạn đang làm gì ở đây thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680116,
					"content": "Paimon hỏi cái này để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680117,
					"content": "Chà... Tôi chỉ tò mò thôi! Giống như khi nhìn thấy bướm hay thằn lằn thì muốn bắt chúng vậy, gần như là bản năng ấy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680118,
					"content": "Paimon là mèo biết bay à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680119,
					"content": "Không phải đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680120,
					"content": "À... Nếu là đại loại như bí mật khó nói của Aranara thì thôi, chúng tôi cũng không phải là người không biết điều, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680121,
					"content": "Mặc dù cũng khá tò mò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "Nói thì nói như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680123,
					"content": "\"Bí mật\"? Arakara không có \"bí mật\". Arakara không làm gì hết, Arakara đang chờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680124,
					"content": "Đang chờ? Ý là chờ Aranara khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680125,
					"content": "Aranakula cùng Arapandu đến Lãnh Địa Ashavan rồi, không biết khi nào mới về. Cỗ Máy Varuna không ổn, không phải lúc để chăm sóc vườn ươm, ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680126,
					"content": "#Nara {NICKNAME} thích trồng trọt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680127,
					"content": "Trồng trọt rất phiền phức.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "Trồng trọt ở Valuka mới phiền, còn ở Vana thì không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680131,
					"content": "Tại sao lại không hỏi tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680132,
					"content": "Paimon không bắt bướm thì cũng đi vồ thằn lằn, trông chẳng giống người thích trồng trọt gì cả, có hỏi cũng như không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680133,
					"content": "Tuy rất muốn phản bác lại... nhưng dù sao tôi cũng quan tâm đến kết quả hơn quá trình mà! Vậy, vườn này đang trồng cây gì thế? Có ngon không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680134,
					"content": "Ngon, nhưng cũng có tác dụng khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680135,
					"content": "Nhưng bây giờ, nếu Paimon đói rồi cũng đừng đến vườn ươm ăn, hãy ăn nấm đi. Nấm ở Vana nhiều quá rồi, ăn bớt sẽ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680136,
					"content": "Tóm lại, Aranakula vẫn chưa về, cho nên không thể bắt đầu làm gì được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680137,
					"content": "#Chà, xem ra chỉ đành chờ Aranakula quay lại... Chúng ta đi trước thôi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680129,
					"content": "Thích trồng trọt nhất!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "Tuyệt quá, Arakara cũng thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680112,
					"content": "Paimon nói đúng lắm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "Hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680106,
					"content": "Ăn cơm thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "Nấm rất ngon! ...Nara? Rất ngon? Không đúng, Nara không ăn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				}
			]
		},
		{
