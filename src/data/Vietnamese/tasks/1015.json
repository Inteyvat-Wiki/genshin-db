			"dialogs": [
				{
					"id": 10150901,
					"content": "Thì ra là ở đây! Còn thấp hơn cả quầy hàng nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150902,
					"content": "Cô ta là... \"Cương thi\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "Cái gì cơ.... Hình như là thật đó! Trên đầu còn dán tấm bùa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150908,
					"content": "Chào mừng quý khách đến với \"nhà Thuốc Bubu\", tôi là Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150909,
					"content": "Qiqi đã chết một lần rồi. Có điều được tiên nhân cứu chữa, cho nên, bây giờ trở thành cương thi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150910,
					"content": "Chuyện kỳ quái như vậy lại nói ra một cách hết sức bình thản...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "Điều này ở Mondstadt là không thể tưởng tượng nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150913,
					"content": "Người bạn nhỏ... Xin hỏi cửa tiệm có bán \"Hương Bất Tử\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150914,
					"content": "Cho hỏi... Đơn thuốc. Có cầm theo đơn thuốc không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150915,
					"content": "Mua... \"Hương Bất Tử\" còn cần đến đơn thuốc sao? Việc này không liên quan gì đến chữa bệnh mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150916,
					"content": "Nếu có đơn thuốc, Qiqi có thể, giúp đỡ việc bốc thuốc. Đây là, \"mệnh lệnh\" mà Qiqi đặt ra cho bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150917,
					"content": "\"Mệnh lệnh\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Cương thi muốn hành động, phải có mệnh lệnh. Thế nhưng không biết làm thế nào cô bé ấy lại có thể tự ra lệnh cho mình được cơ chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150921,
					"content": "Bạn nhỏ Qiqi, chúng tôi không có đơn thuốc thế nhưng rất muốn nhờ em tìm giúp Hương Bất Tử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150922,
					"content": "Được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150923,
					"content": "Hả? Tự nhiên lại trả lời có thể rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150924,
					"content": "Có điều, mọi người cũng phải giúp Qiqi, như vậy mới công bằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150925,
					"content": "Nhân viên phải chăm sóc khách hàng lại là chuyện không công bằng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150926,
					"content": "Haha... Không sao hết, như vậy cũng được. Nghệ thuật giao dịch ở Liyue chính là đứng ở vị trí của người khác mà suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150927,
					"content": "#Vậy thì, {F#chị}{M#anh} hãy đến Thiên Hoành Sơn. Sử dụng \"Máy Guizhong\" giúp em bắt \"Dê Dừa\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150928,
					"content": "Tôi không hiểu lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "Máy Guizhong... Thứ cô bé nhắc đến tôi có nghe qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150932,
					"content": "\"Máy Guizhong\" là một vũ khí dạng cơ khí, có hình cung được tiên nhân cổ xưa xây dựng trên Thiên Hoành Sơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150933,
					"content": "Vị trí nằm giữa \"tường thành cổ Thiên Hoành Sơn\", có thể di chuyển và đánh bại những ma vật lớn, chống lại những nguy hiểm đến từ thế giới bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150934,
					"content": "Ngài Zhongli rất hiểu về Liyue đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150935,
					"content": "Cũng không hẳn là vậy... Ví dụ như tôi cũng chưa từng nghe qua Dê Dừa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150936,
					"content": "Dê Dừa là quái thú có nửa dòng máu của tiên trong truyền thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150937,
					"content": "Í? Chỉ có vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150938,
					"content": "Ừm. Dê Dừa là quái thú có nửa dòng máu của tiên trong truyền thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150939,
					"content": "Không biết nó trông như thế nào. Có thể kiếm được ở đâu cũng không rành. Nó đến từ đâu lại càng là một bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150940,
					"content": "Đây là \"hỏi gì cũng không biết\" nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Thôi vậy... Cứ đến gần <color=#00E1FFFF>\"máy Guizhong\"</color> xem trước đã, biết đâu lại có manh mối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150943,
					"content": "Dê Dừa... Rốt cuộc là sinh vật như thế nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150941,
					"content": "Vậy thì khó giải quyết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "Chẳng lẽ lại muốn chơi chúng ta một vố sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "Không phải đâu, thứ cô bé nhắc đến tôi từng nghe qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150918,
					"content": "Cảm thấy giao tiếp với nhau có chút khó khăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "Có lẽ giống như lời cô ấy nói, là do liên quan đến \"mệnh lệnh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150911,
					"content": "Không hổ là \"vùng đất có thần\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "Thật ra nếu xét theo chiều cao thì Paimon còn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "Ê! Tôi biết bay đó, thế nên chiều cao đối với tôi không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150906,
					"content": "Có điều, cô ta hình như có chút kỳ quái, phía trên đầu còn dán lá bùa nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150907,
					"content": "Chẳng lẽ là... \"Cương thi\" sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
