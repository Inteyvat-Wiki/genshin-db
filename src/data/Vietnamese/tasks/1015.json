			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "Thật không thể ngờ được nó lại lớn như vậy, không hổ danh là vật mà tiên nhân tạo ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150302,
					"content": "Nhưng mà thứ như thế này sao mà dùng được nhỉ, phải có sức mạnh lớn cỡ nào mới có thể điều khiển được cơ chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150303,
					"content": "Giờ không thể dùng được là do nó bị hư rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150304,
					"content": "Hư rồi sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150305,
					"content": "Cho dù là cơ quan do tiên gia tạo ra, trải qua cả nghìn năm sương gió như vậy cũng khó có thể giữ được nguyên dạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150306,
					"content": "Vậy thì chúng ta phải làm sao nhỉ? Ngài Zhongli mau sử dụng tất cả \"tri thức của giới thượng lưu\" để tìm cách đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150307,
					"content": "Í. Sao nghe có cảm giác như đang nói tôi chả khác gì lũ quan liêu chỉ biết ngồi nghe kịch và nuôi chim vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150308,
					"content": "Để tôi nghĩ chút... Hừm, kỳ thực \"Máy Guizhong\" dùng trong những trận đấu khốc liệt, cũng có chuẩn bị những phụ kiện thay thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150309,
					"content": "Nếu không lầm thì ở ngay trong \"Tường Thành Cổ\", chắc chắn sẽ tìm được phòng dự trữ chiến tranh năm xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150310,
					"content": "Lấy được phụ kiện thay thế trong phòng dự trữ chiến tranh rồi, chỉ cần tìm hiểu được nguyên lý sử dụng \"Máy Guizhong\" thì việc sửa chữa sẽ không khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150311,
					"content": "Vậy thì... Ngài Zhongli biết nguyên lý hoạt động của nó rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150312,
					"content": "Biết chút ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150313,
					"content": "Chỉ cần tìm <color=#00E1FFFF>đủ nguyên liệu</color> tôi sẽ thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "Ừm, những linh kiện này đã đến lúc được dùng đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150602,
					"content": "Hai vị đợi chút, để tôi thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150603,
					"content": "Hoàn thành rồi. Kết cấu của \"Máy Guizhong\" khó hơn tôi tưởng tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150604,
					"content": "Woa, tiếp theo phải làm thế nào nó mới có thể di chuyển được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150605,
					"content": "Đơn giản thôi, chỉ cần như vậy... Bạn xem, cơ quan của tiên gia còn trang bị cả \"ống nhòm\" sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150617,
					"content": "Ở đây... Không có... Ở kia cũng không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150606,
					"content": "Ê! Các người đang tìm gì vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "Huang Tàn Nhang"
				},
				{
					"id": 10150607,
					"content": "Cây cung lớn này bị các người động tay động chân à? Các người chạm vào thứ này để làm gì?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "Huang Tàn Nhang"
				},
				{
					"id": 10150608,
					"content": "Không phải cung lớn, mà là \"máy Guizhong\". Còn nữa, trước khi nói chuyện, hãy xưng danh tính. Đây là phép lịch sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150609,
					"content": "Không nhận ra sao? Hừm, bọn ta chính là Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "Huang Tàn Nhang"
				},
				{
					"id": 10150610,
					"content": "Tương truyền cả vùng đất này có rất nhiều báu vật, cây cung này tuy chỉ là một thứ vũ khí, nhưng nó lại giống như người canh gác, khó mà tiếp cận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "Huang Tàn Nhang"
				},
				{
					"id": 10150611,
					"content": "Trước kia, mấy huynh đệ của ta xém chút nữa là bị nó xuyên thành que thịt viên rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "Huang Tàn Nhang"
				},
				{
					"id": 10150612,
					"content": "Sau đó bọn ta phải mạo hiểm cả tính mạng mới phá hỏng được nó, các người lại sửa nó!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "Huang Tàn Nhang"
				},
				{
					"id": 10150613,
					"content": "Ta thấy hôm nay phải dạy cho các người một bài học.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "Huang Tàn Nhang"
				},
				{
					"id": 10150614,
					"content": "Hừm. Đúng là đồ phàm phu tục tử, vì lòng tham mà phá hỏng cả di vật mà tiên nhân để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150615,
					"content": "Phải dạy cho các ngươi một bài học.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150616,
					"content": "#Nói rất đúng! {NICKNAME}, chúng ta xông lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Rất xin lỗi vì không thể hoàn thành đúng như \"khế ước\". Không tìm thấy quái vật nửa tiên tên Dê Dừa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150702,
					"content": "Hả. Buồn quá đi. Tuy không có sao, nhưng vẫn buồn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150703,
					"content": "Haizz, thấy Qiqi như vậy tự nhiên tôi cảm thấy áy náy quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150704,
					"content": "Qiqi còn có manh mối nào nữa không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Thật ra... Là do sữa của Dê Dừa rất ngon. Ngon hơn nhiều so với sữa dê bình thường, ngon vị rất riêng đó. Vì vậy chúng nhất định phải là quái vật nửa tiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150707,
					"content": "Em xin lỗi. Trí nhớ của em không được tốt. Để em viết lại tên loại sữa này, tìm xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150708,
					"content": "Ồ, đúng rồi, chính là nó, thứ sữa ngon ấy được gọi là... \"sữa dừa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150709,
					"content": "Hửm?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150711,
					"content": "Xin lỗi hai vị. Trước kia vì muốn công bằng cho Qiqi mà tôi đã không suy nghĩ kỹ, nhận lời quá dễ dàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150712,
					"content": "Ừm, không sao hết Zhongli. Nói theo cách của người Liyue thì \"Sự đời vô thường, hỷ nộ khó đoán\", ai mà lường trước được sự thật lại hoang đường đến thế cơ chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150713,
					"content": "Í... Qiqi nói sai, điều gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150714,
					"content": "#{NICKNAME}, xem ra việc phá hỏng giấc mộng của trẻ con có thể giao cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150715,
					"content": "Sữa dừa không phải lấy từ Dê Dừa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150718,
					"content": "Qiqi dường như chết lặng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150719,
					"content": "Chúng ta đừng quấy rầy cô bé nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Haha quả là một bài học đầy ý nghĩa của cuộc đời, rất cảm ơn các bạn đã chăm sóc cho Qiqi nhà tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150722,
					"content": "Các hạ là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150723,
					"content": "Thất lễ rồi. Tôi là chủ của Nhà Thuốc Bubu - Baizhu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150724,
					"content": "Thì ra làm chủ lại không phải là Qiqi sao. Mà lại là dị nhân đeo thuốc trên cổ sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150725,
					"content": "Thật tôi nghiệp. Qiqi cũng quá ngây thơ rồi, nhưng điều bất ngờ hơn đó là người bị hại còn ngây thơ hơn cả Qiqi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150726,
					"content": "Hả! Vị thuốc đó... Con rắn đó, biết... biết nói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150727,
					"content": "Rắn có thể cất tiếng nói!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "Hừm tôi thực sự không muốn nói. Khách quen còn đỡ, chứ khách mới đến e rằng sẽ sợ chết khiếp. Nhưng nếu không lên tiếng thì mọi người sẽ coi tôi giống như mấy con rắn khô trong ngăn kéo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150730,
					"content": "Haha... Vị này là Changsheng, cô ấy không có ác ý gì đâu. Xin hỏi các vị ngoài việc đến chơi với Qiqi còn có chuyện gì khác không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150731,
					"content": "Xin hỏi cửa hàng có \"Hương Bất Tử\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150732,
					"content": "Ồ, \"Hương Bất Tử\" ư, đương nhiên là có rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150733,
					"content": "Vậy thì tốt quá, vậy là không phí công vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150734,
					"content": "300 vạn Mora, loại thượng đẳng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150735,
					"content": "300 vạn?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "Anh đi cướp Hoàng Kim Ốc đi! Nhưng mà Hoàng Kim Ốc hiện giờ đang được Thất Tinh quản lý, có lẽ sẽ khó hơn nơi khác một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150739,
					"content": "Hửm... 300 vạn thôi... Nhưng theo lý thường tình mà nói, thì cũng có chút khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150740,
					"content": "Nhiều Mora như vậy! Sao mà chúng tôi trả nổi! Ngay cả ngài Zhongli cũng vậy thôi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150741,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150742,
					"content": "Thật thẳng thắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "Phải làm sao... Lần này chỉ có thể nhờ Childe trợ giúp rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150744,
					"content": "Hahahahha-!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150745,
					"content": "Dê Dừa... Dê Dừa sao! Buồn cười quá đi, không ngờ mọi người lại bị một vố đau như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150746,
					"content": "Không được cười trên nỗi đau của người khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150747,
					"content": "Haizz, đúng là cười ra nước mắt mà. Được rồi để cảm ơn mọi người đã khiến tôi vui như vậy, tôi sẽ giúp đỡ giải quyết tất cả khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150748,
					"content": "Vị này... là ông chủ Baizhu phải không? Tôi là Quan Chấp Hành Fatui - Childe. Hy vọng chúng ta về sau có nhiều cơ hội hợp tác với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150749,
					"content": "Nếu như Nhà Thuốc Bubu có cần gì, Fatui có thể thiết lập đội ngũ giao sữa dừa nhanh chóng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150750,
					"content": "Hửm? Trước giờ đều nghe nói người Fatui thích lôi kéo những \"kẻ cùng chí hướng\", còn với Nhà Thuốc Bubu thì chỉ dùng sữa dừa là có thể mua chuộc được sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150751,
					"content": "Sữa dừa, sữa dừa. Ngài Baizhu, con muốn sữa dừa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150752,
					"content": "Được rồi được rồi... Vậy thì đa tạ ngài Childe, chúc hợp tác vui vẻ. Hương Bất Tử này cũng giảm giá cho các bạn, giá mới là 299 vạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150753,
					"content": "Ủa, vậy 300 vạn với 299 vạn có gì khác nhau đâu chứ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150754,
					"content": "Đúng vậy... 299 vạn... nghe thì cũng không khác biệt lắm, nhưng sự thật là có rẻ hơn 1 vạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150755,
					"content": "Được rồi, mọi việc đều đã được giải quyết, chúng tôi cũng nên quay trở lại Ngọc Kinh Đài. Hẹn gặp lại ngài Childe, ông chủ Baizhu và người bạn nhỏ Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150756,
					"content": "Đúng là đám người thú vị, lâu lắm mới cảm thấy vui như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150757,
					"content": "Vậy thì trước khi ta đến... Ngươi mai phục ở đây có \"nghe ngóng\" được gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150758,
					"content": "Vâng thưa đại nhân Childe. Bọn họ nhắc đến Hoàng Kim Ốc bị Thất Tinh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10150759,
					"content": "Hoá ra là như vậy. He he, Ningguang, Thất Tinh. Thứ các ngươi muốn che giấu trong Hoàng Kim Ốc... Còn gì khác ngoài \"Tiên Tổ Pháp Thoái\" chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150760,
					"content": "#Rất xin lỗi {NICKNAME}. Nhưng tôi từng cảnh báo cho {F#cô}{M#cậu} rồi phải không? Ngạn ngữ cổ Liyue có nói: \"Tai vách mạch rừng\" mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150737,
					"content": "Anh đi cướp Hoàng Kim Ốc đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Nhưng mà Hoàng Kim Ốc hiện giờ đang được Thất Tinh quản lý, có lẽ sẽ khó hơn nơi khác một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150728,
					"content": "Đây là Liyue, không có gì kỳ lạ cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "Sự trưởng thành của trẻ chính là nhờ những khoảnh khắc như vậy chăng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "Sữa dừa được lấy từ quả dừa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "Qiqi muốn Dê Dừa để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
