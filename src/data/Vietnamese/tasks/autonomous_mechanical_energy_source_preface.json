			"dialogs": [
				{
					"id": 700270101,
					"content": "Bạn đến thật đúng lúc, công việc sửa chữa Gai Pursina diễn ra khá suôn sẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270102,
					"content": "Chỉ cần có số linh kiện này, tôi sẽ sửa xong với tốc độ nhanh nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270103,
					"content": "Tôi đã thu thập một ít.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "Thật tốt quá, nó thật sự giúp ích rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270105,
					"content": "Chỉ cần có những linh kiện này, tôi chắc chắn rất nhanh sẽ sửa xong",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270106,
					"content": "Nhưng có một vấn đề nhỏ, tôi nghĩ nên thảo luận với bạn trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270107,
					"content": "Trong những ngày bạn đi thu thập linh kiện, tôi đã nghiên cứu kỹ kết cấu bên trong của Gai Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270108,
					"content": "Kết cấu của nó rất phức tạp, không hổ là một thiết bị tinh xảo do tiền bối Priscina chế tạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270109,
					"content": "Mọi điều chỉnh đều có thể ảnh hưởng đến chức năng tổng thể nên tôi hơi lo lắng không biết liệu điều chỉnh có đạt được hiệu quả như mong đợi không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270110,
					"content": "Để an toàn, tôi hy vọng có thể nhờ bạn thử vài lần trước và tôi sẽ hiệu chỉnh lại dựa trên dữ liệu trong thời gian bạn dùng thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270111,
					"content": "Như vậy mới có thể đảm bảo hiệu quả cuối cùng của Gai Pursina, nếu không, khi bạn đang giao đấu với mô hình di tích, lỡ như nó xảy ra sự cố thì tiêu tùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270112,
					"content": "Đúng là thận trọng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "Đây cũng là lần đầu tiên tôi thao tác thực tế với Gai Pursina, thận trọng một chút vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270115,
					"content": "Vậy thì phải nhờ bạn dùng thử nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270113,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
