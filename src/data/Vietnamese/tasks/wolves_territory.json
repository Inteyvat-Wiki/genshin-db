				},
				{
					"id": 4510602,
					"content": "Cám ơn các bạn. Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510603,
					"content": "Nhưng mà nếu chúng tôi tự làm, có thể bắt 5,6 con. Có sói tối nay bị đói rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510604,
					"content": "À há...",
