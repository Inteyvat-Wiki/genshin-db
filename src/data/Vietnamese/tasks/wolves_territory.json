					"nextDialogs": [
						4510605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510605,
					"content": "Đừng để ý, cảm ơn các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510606,
					"content": "Các bạn so với cô gái màu đỏ của Đội Kỵ Sĩ, trông có vẽ rất nóng ấy, lợi hại hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510607,
					"content": "Nếu cô ấy ra tay, có thể ngọn núi sẽ cháy lên. Heo, một con cũng không bắt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510608,
					"content": "Tôi phải đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510609,
					"content": "Gần đây nơi đây không an toàn. Các bạn phải cẩn thận, tự bảo vệ bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510610,
					"content": "Thật là một người đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510611,
					"content": "Anh ấy nhắc đến người bạn trong Đội Kỵ Sĩ. Màu đỏ, cô gái rất nóng...",
					"roleType": "TALK_ROLE_NPC",
