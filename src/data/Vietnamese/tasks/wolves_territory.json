			"dialogs": [
				{
					"id": 4510101,
					"content": "Đây gọi là Lang Lãnh, nghe nói người dân Mondstadt rất ít khi đến đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510102,
					"content": "Tuy rằng ở gần Mondstadt, nhưng nơi đây là rừng nguyên sinh, là một nơi tuân theo luật rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510103,
					"content": "Đến Slime cũng to lớn như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510104,
					"content": "Nhìn xem, lớn... đùng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510105,
					"content": "...Chúng nó tấn công rồi! Hãy chuẩn bị!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
