				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "Cám... Cám ơn bạn. Bầy sói của Lang Lãnh đến rồi! Mau trốn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510303,
					"content": "Đừng sợ. Sói là bạn. Nhưng, các bạn là ai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510304,
					"content": "Chúng tôi chỉ là nhà lữ hành thông thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510305,
					"content": "Không thông thường, các bạn. Nhưng, có mùi quen thuộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510306,
					"content": "Mùi quen thuộc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510307,
					"content": "Đội Kỵ Sĩ, phải không? Trong Đội Kỵ Sĩ có bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510308,
					"content": "Bạn tên là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "Tôi là Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510311,
					"content": "Bạn cũng là người của Đội Kỵ Sĩ Tây Phong à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510312,
					"content": "Không có quan hệ gì với Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510314,
					"content": "À há...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510315,
					"content": "Bầy sói... là thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "A... bầy sói, là người nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510317,
					"content": "Người nhà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510318,
					"content": "Người nhà. Nuôi tôi lớn, là gia đình cùng tôi lớn lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510319,
					"content": "Hình như trong này có câu chuyện rất phức tạp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510320,
					"content": "Họ đang trách tôi. Vì để giúp các bạn, mai phục bị bại lộ. Không bắt được heo rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510321,
					"content": "#Vậy thì... Để {NICKNAME} bắt heo rừng giúp đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME} cũng lợi hại lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510323,
					"content": "Tôi, tôi thấy không cần đâu. Mỗi lần Đội Kỵ Sĩ ra tay, đàn sói đều bị đói bụng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510324,
					"content": "Đừng khách sáo. Các bạn cứ đợi tin tốt của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510309,
					"content": "Bạn cũng là người của Đội Kỵ Sĩ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "Tôi là Razor. Không có quan hệ với Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
