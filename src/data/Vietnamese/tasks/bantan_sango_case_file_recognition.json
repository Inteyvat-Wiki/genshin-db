				{
					"id": 400340901,
					"content": "#Phù, cuối cùng cũng xong. Tôi thật sự không hiểu, sao đột nhiên lại đánh nhau, rõ ràng lúc trước Kageroumaru thân thiện lắm mà, may mà có {NICKNAME} ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340902,
					"content": "#Ơ, tại sao Kageroumaru lại đi theo {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340903,
					"content": "Gâu gâu gâu gâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340904,
					"content": "Tiếng sủa này nghe như rất vui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "Sao bạn nghe ra vậy! Tôi còn đang chẳng hiểu chuyện gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340906,
					"content": "#Nếu tôi đoán không sai, Kageroumaru có lẽ đã trở thành ninken của {NICKNAME} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340907,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340908,
					"content": "Hở?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "Về cách lập khế ước với ninken, tôi cũng chỉ nghe qua đôi chút mà thôi. Nghe nói rằng ninja sau khi chọn được ninken, thì cần phải đánh bại nó, mới được ninken công nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340910,
					"content": "Ninja mong muốn có một đồng đội mạnh, thì ninken cũng thế, chỉ khi công nhận lẫn nhau mới hoàn thành khế ước. Xem ra đúng là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340911,
					"content": "#Nhưng mà {NICKNAME} không phải ninja...Hơn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340912,
					"content": "Hic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340913,
					"content": "Paimon sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#{NICKNAME}, bạn hãy đồng ý với tôi một chuyện trước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340915,
					"content": "Chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "Bạn phải đồng ý trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340917,
					"content": "Được thôi, tôi đồng ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "Cho dù bạn đã có khế ước với Kageroumaru, thì bạn cũng không được quên rằng Paimon mới là bạn đồng hành tốt nhất nhất nhất của bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340919,
					"content": "Ừm, Paimon là đồng hành tốt nhất của tôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "Tuyệt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340921,
					"content": "So với chó mèo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "Ahihi. Chúng ta mãi mãi là đồng đội tốt nhất của nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340924,
					"content": "Haha, tình cảm của hai bạn tốt thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340925,
					"content": "Nhưng nói chứ, Kageroumaru đã có thực lực như vậy, tại sao người đó vẫn phải để lại lá thư, nhờ người khác chăm sóc nó nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340926,
					"content": "#Điều này tôi biết nè! {NICKNAME} cũng rất mạnh đúng chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340927,
					"content": "Quả thực là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340928,
					"content": "#Nhưng nếu như có một ngày, lỡ như xảy ra bất trắc gì đó, tôi bắt buộc phải rời xa {NICKNAME}, tôi cũng sẽ rất lo lắng. Điều này chẳng có quan hệ gì với việc {NICKNAME} có mạnh mẽ hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340929,
					"content": "#Xùy xùy, tôi đang nói mấy chuyện xui xẻo gì thế này! Tóm lại chỉ là một cách ví dụ thôi! Tôi và {NICKNAME} là đồng đội tốt, chúng tôi sẽ không chia lìa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340930,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "Cách nói của Paimon rất hợp lý. Vậy vấn đề duy nhất còn lại là, tại sao con chó này lại trộm các động vật nhỏ của mọi người, rồi canh giữ chúng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340932,
					"content": "À...chẹp...chuyện này thì Paimon thông minh cũng không nghĩ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340933,
					"content": "#Đáng tiếc, Kageroumaru không thể nói chuyện, nếu không {NICKNAME} chỉ cần hỏi nó là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340934,
					"content": "Chúng ta đi tìm Sango thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "À đúng, còn có Sango nữa! Lúc này đã đến lượt người chơi hệ não ra tay rồi, chúng ta đi tìm cô ấy thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340936,
					"content": "Ừm, chúng ta đem bọn thú nhỏ trả về trước đã, sau đó tập hợp ở trụ sở thám tử nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340922,
					"content": "Thì Paimon vẫn đáng tin cậy hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
