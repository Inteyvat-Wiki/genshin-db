				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "Hội trưởng Sango, chúng tôi về rồi, chuyện là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341002,
					"content": "Thì ra là vậy. Tôi biết tại sao Kageroumaru lại canh chừng bọn thú nhỏ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341003,
					"content": "Nó muốn huấn luyện cho những con thú nhỏ khác trở nên mạnh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341004,
					"content": "Lúc nhỏ nó rất yếu, sau đó lại mạnh lên, đúng không. Cho nên nó muốn huấn luyện để những con thú nhỏ khác mạnh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341005,
					"content": "Sau đó, khi nhìn thấy Nhà Lữ Hành muốn bảo vệ kẻ yếu, nên đã nhận Nhà Lữ Hành làm chủ nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341006,
					"content": "Điều này cũng xuất phát từ sự thông cảm của nó đối với kẻ yếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341007,
					"content": "Nhưng mà đây cũng chỉ là suy đoán của tôi thông qua những manh mối đã có thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341008,
					"content": "Còn về tình hình thực tế có lẽ cũng gần như là vậy. Nhưng vì Kageroumaru không biết nói chuyện, nên chúng ta cũng không thể nào có được một đáp án chắc chắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341009,
					"content": "Sango nói cũng rất có lý! Không hổ danh là người chơi hệ não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341010,
					"content": "Gấu gấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400341011,
					"content": "Ồ, mày cũng đang đồng ý với cách nói của Sango sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341012,
					"content": "Đừng tưởng khen ngợi tôi thì lần sau có ủy thác tôi sẽ giảm giá cho nhé. Nhưng mà, vụ án này xem như đã khép lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341013,
					"content": "#Cám ơn {NICKNAME} và Paimon, nhờ có hai bạn mà vụ án này mới giải quyết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400341014,
					"content": "À, xém chút quên mất, \"Lưới Bắt Thú\" các bạn sử dụng thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341015,
					"content": "Rất tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "Ừm, tôi ghi nhận rồi. Tôi sẽ nói với người bạn của tôi, cám ơn nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341018,
					"content": "#Đừng khách sáo! Sau này có việc gì khó khăn thì cứ tìm chúng tôi nha! {NICKNAME} lợi hại lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400341019,
					"content": "Nhà Lữ Hành quả thật năng lực xuất chúng, nhưng không cần phải nói những lời khách sáo như vậy với tôi đâu, dù sao thì tình cảm là kẻ thù của chân tướng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 400341016,
					"content": "Cứ sợ nó sẽ bị rách...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
