				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "À, các bạn đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340103,
					"content": "Theo những manh mối thu thập được và suy luận của tôi, tôi đã phái Ryuuji đến Đảo Yashiori điều tra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340104,
					"content": "Tôi đã đánh dấu vị trí trên bản đồ của bạn, nếu bạn tranh thủ đi thì có lẽ sẽ gặp được anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340105,
					"content": "Sao lại đi vội vậy, không phải anh ta sẽ ở trụ sở thám tử đợi chúng tôi đi cùng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340106,
					"content": "Bởi vì sắp đến hồi kết rồi. Các bạn cũng mau đi đi, để cùng nhau chứng kiến sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340107,
					"content": "#Nói vậy thì tôi cũng không thể chờ đợi được nữa. Chúng ta mau đi thôi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "Ryuuji! Chúng tôi đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340202,
					"content": "À, là các bạn. Hội trưởng Sango kêu tôi đến trước để điều tra, nói các bạn sẽ đến sau. Đúng là như vậy thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340203,
					"content": "May mà cô ấy nói với chúng tôi là anh đang ở đây! Ryuuji điều tra đến đâu rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340204,
					"content": "Ơ, sao ở đây toàn là lồng của bọn thú nhỏ vậy, không có người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340205,
					"content": "Vừa mới đi rồi, là Đạo Bảo Đoàn. Hội trưởng Sango nói với tôi, bọn họ định trộm chó để huấn luyện thành \"Chó Tầm Bảo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340206,
					"content": "Giống như Chồn Đạo Bảo sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "Đúng vậy, giống Chồn Đạo Bảo. Chỉ vì những con chồn quá nghịch ngợm, khó dạy bảo nên đã thất bại. Lần này, bọn chúng nhắm đến những chú chó trung thành hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340210,
					"content": "Lúc trước từng xử lý không ít ủy thác liên quan đến Đạo Bảo Đoàn. Nghĩ lại thì hội trưởng Sango nói quả nhiên không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340211,
					"content": "Giống như người có dấu chân, tổ chức cũng sẽ để lại dấu vết riêng của mình. Trong sự việc này, mặc dù có bọn thú nhỏ bị nhốt, bị mất tích, nhưng dấu vết cuối cùng vẫn chỉ ra là Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340212,
					"content": "Tôi đã tham khảo cách giải quyết lúc đó, sau đó điều tra đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340213,
					"content": "Nhưng bọn chúng không cử người ở lại, so với vụ án lúc trước, kẻ gây án lần này quá bất cẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340214,
					"content": "#Ừm, đúng là một lũ xấu xa tự mãn! Nhưng mà, {NICKNAME}, bạn đánh nhau nhiều ngày như vậy cũng mệt rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340215,
					"content": "Cho nên nhân lúc bọn họ không ở đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "Ừm, cứ làm vậy đi! Hihi, chúng ta thật hiểu ý nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340216,
					"content": "Chúng ta lén cứu bọn chúng ra đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "Giống Paimon sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
