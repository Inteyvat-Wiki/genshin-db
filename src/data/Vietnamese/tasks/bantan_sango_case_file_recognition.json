					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340605
					]
				},
				{
					"id": 400340605,
					"content": "Không phải! Đây mà là biệt danh gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340609,
					"content": "Dù sao thì, hình như nó không có ý định tấn công chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340610,
					"content": "Gâu gâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340611
					],
					"speakerTitle": "Kageroumaru"
				},
				{
					"id": 400340611,
					"content": "Ôi ôi, nó chạy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340612,
					"content": "Vừa chạy vừa quay đầu nhìn chúng ta, hay là nó muốn mình chạy theo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340613
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340613,
					"content": "Chúng ta mau chạy theo đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340614
					]
				},
				{
					"id": 400340614,
					"content": "Ừm, nói không chừng chân tướng ở ngay phía trước...Cũng có thể giống như Sango đã dự đoán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340606,
