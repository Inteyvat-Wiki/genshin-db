			"trigger": {
				"objectNames": [
					"Anthony",
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Anna, em suy nghĩ kỹ lại đi, anh thấy chuyện này phải tính toán lâu dài mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140102,
					"content": "Ôi, anh đừng lo cho em, em chắc chắn không sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140103,
					"content": "Anna, cô vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "Nhà Lữ Hành! Bạn đến thật đúng lúc, mau giúp tôi khuyên Anna đi, Anna muốn làm nhà mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140106,
					"content": "Tại sao em lại không thể làm nhà mạo hiểm? Sức khỏe của em hiện giờ rất tốt, chú Cyrus cũng nói em rất thông minh, rất thích hợp làm nhà mạo hiểm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140107,
					"content": "Em mới khỏi bệnh được bao lâu chứ? Nếu đi làm nhà mạo hiểm lại đổ bệnh thì phải làm thế nào? Hơn nữa, bố mẹ cũng sẽ không đồng ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140108,
					"content": "Em nói với bố mẹ rồi, bố mẹ nói chỉ cần em qua được buổi sát hạch của Hiệp Hội Nhà Mạo Hiểm thì bố mẹ sẽ đồng ý cho em làm nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140109,
					"content": "Hả...hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140110,
					"content": "Bình tĩnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "Mấy hôm trước chú Cyrus vừa giúp tôi lên kế hoạch tập luyện, tôi đã tập luyện được mấy ngày rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140113,
					"content": "Nhưng mà những kế hoạch đó đều xoay quanh việc trinh sát, tìm kiếm thức ăn khẩn cấp, sinh tồn ở bên ngoài, v.v.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140114,
					"content": "Nhưng tôi nghe nói, nhà mạo hiểm thường chiến đấu với ma vật ở bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140115,
					"content": "Tôi rất muốn học những thứ này, nhưng lại không tìm được người dạy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140116,
					"content": "Hơn nữa, anh trai tôi cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140117,
					"content": "Đương nhiên không được! Những ma vật đó rất nguy hiểm, dù có đi, em cũng phải tìm một nhà mạo hiểm kinh nghiệm phong phú đi cùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140118,
					"content": "Không phải trước đây em từng tìm Jack sao? Jack đã đồng ý với em rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140119,
					"content": "Đừng nghĩ là anh không biết nhóc Jack đó... Jack còn không thể tự chăm sóc bản thân thì làm sao có thể chăm sóc được cho em chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140120,
					"content": "Trong hiệp hội không thể tìm ngay được một nhà mạo hiểm có kinh nghiệm, em cũng không có tiền để treo ủy thác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140121,
					"content": "Hay là tôi đi cùng cô nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "Hả? Bạn đồng ý giúp tôi sao? Tuyệt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140124,
					"content": "Anh! Giờ thì anh yên tâm rồi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140125,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140126,
					"content": "#Phù...thôi được, thực lực của Nhà Lữ Hành anh cũng biết, có {M#anh ấy}{F#cô ấy} đi cùng em, anh cũng có thể yên tâm hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140127,
					"content": "Nhưng mà! Đi ra bên ngoài em cũng phải chú ý an toàn vào nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140128,
					"content": "...Em nhớ những gì anh nói chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140129,
					"content": "Biết rồi, khổ lắm, nói mãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140130,
					"content": "Nhà Lữ Hành, chúng ta mau xuất phát đi, vị trí doanh trại đó tôi đã nhờ Jack thăm dò rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140122,
					"content": "Tôi cũng có chút kinh nghiệm trong chiến đấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "Việc tập luyện của cô thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "Anthony, mọi người đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
