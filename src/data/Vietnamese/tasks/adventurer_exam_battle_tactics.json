			"dialogs": [
				{
					"id": 200140201,
					"content": "Đám ma vật đều đã bị đánh bại rồi, bạn thật lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "Sổ tay mạo hiểm viết không sai chút nào, có thể dùng nhiều cách để đánh bại ma vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Nhưng mà...nói thật, ở gần ma vật như vậy tôi cũng hơi sợ...may mà có bạn đi cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "Cô phải tập luyện nhiều hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Ừm, tôi biết. Muốn trở thành nhà mạo hiểm không phải chuyện dễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "Cảm ơn bạn, Nhà Lữ Hành. Tôi về thành trước đây. Đi lâu như vậy rồi, chắc anh trai tôi cũng lo lắng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "Sau này tôi phải cố gắng tập luyện thêm một chút mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
