				"objectNames": [
					"Tizlo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "#Này! {F#Cô}{M#Cậu} gì ơi, bên ngoài nguy hiểm lắm, mau vào trong đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790402,
					"content": "#Ây da, {F#cô}{M#cậu} không thấy thảm cảnh dọc đường đi sao? Núi lửa phun trào, lại có cả ma vật chặn đường, không nên đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790403,
					"content": "Này, nghe lời tôi đi. Cứ đợi ở đây thêm đã, rồi đi chung với thương đội của chúng tôi, như thế cũng có người tiếp ứng. Nếu không thì đi một mình nguy hiểm lắm đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790404,
					"content": "Ma vật?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "Là một đám Tepetlisaur màu tím đó! Nhìn là biết bị Vực Sâu làm vấy bẩn rồi! Sức phá hoại cực kỳ mạnh, nói thật, tôi chưa từng thấy Tepetlisaur nào đáng sợ như vậy cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790406,
					"content": "Tôi nói này, chúng gạt đuôi thôi là đã làm hỏng cả xe của chúng tôi rồi, còn mạnh hơn cả Tatankasaur nữa. Đây chắc chắn không phải đối thủ mà người thường có thể đối phó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790407,
					"content": "Cứ nghe tôi nói đi, tuyệt đối đừng đâm đầu chạy đi đánh với chúng, nhìn thấy chúng thì nên đi đường vòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790408,
					"content": "Không sao, tôi làm được mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "#{F#Cô}{M#Cậu}... Haiz... Thôi được, vậy thì đi đường cẩn thận nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				}
			]
		},
