			},
			"dialogs": [
				{
					"id": 751791101,
					"content": "Phải làm sao đây? Phải làm sao đây? Chờ khi nào về thì sếp thế nào cũng sẽ đánh mình một trận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "Haiz... Chuyến hàng của chúng tôi vốn đang đi rất tốt, rồi đột nhiên gặp núi lửa phun trào, dưới đất còn chui ra mấy con Tepetlisaur màu tím.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "Tôi không cẩn thận làm cho đồng đội Saurian của mình sợ hãi mà rời đội. Kết quả giờ quay lại thì đường bị chặn rồi, không thể tập hợp với mọi người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "Haiz... Cũng không biết mọi người thế nào rồi. Tôi tự ý rời đội như vậy, sếp chắc chắn giận lắm. Tiêu rồi, lần này tôi tiêu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "Đổi lại thì tôi sẽ chạy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "Chạy? Không được, không được, sếp giống như Vương Quốc Dạ Thần ấy, ở nơi nào cũng thấy. Tôi có chạy đi đâu cũng sẽ bị bắt về thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "Tôi phải quay về xin lỗi mới được. Nhưng mà... phải làm sao đây... Con đường này bị chặn mất rồi... Haiz, lần này chết chắc rồi...",
					"roleType": "TALK_ROLE_NPC",
