						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "Bên kia, dừng, dừng tay! Những thứ này đều là của chúng tôi! Không được nhúc nhích! Nói cho mà biết này, tôi, tôi đủ sức tham gia Trận Chiến Người Gác Đêm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790102,
					"content": "Nếu dám cướp đồ của chúng tôi thì tôi sẽ không để yên đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790103,
					"content": "Haiz... Hôm nay sao thế nhỉ? Vừa có núi lửa phun trào, vừa có Tepetlisaur màu tím... Bây giờ lại có một đám cướp xuất hiện, thật là xui xẻo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790104,
					"content": "#Masose, trông {M#cậu ta}{F#cô ta} có vẻ rất lợi hại, đánh không lại đâu, hay là bỏ qua đi... Hơn nữa, chúng ta chỉ đến xem thi đấu thôi, chắc sẽ không tính là có tham gia đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790105,
					"content": "#Itsaho, cái tên này! Sao có thể như vậy hả, đây là đồ của mọi người đấy! Hơn, hơn nữa, hai, hai chúng ta cùng đánh một mình {F#cô ta}{M#cậu ta}, chưa chắc đã đánh không lại đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790106,
					"content": "Ai nói là hai chứ? Muốn đánh thì đánh một mình đi, đừng có tính tôi vào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790107,
					"content": "#{M#Anh trai}{F#Chị gái} à, chúng tôi không cần đồ nữa rồi, muốn thì cứ lấy đi nhé. Chỉ cần đừng động thủ là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790108,
					"content": "Chắc chắn là hiểu lầm rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "Mọi người hiểu lầm rồi! Chúng tôi là những nhà mạo hiểm tốt bụng, chứ không phải là loại người xấu xa không biết điều đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790112,
					"content": "Dựa, dựa vào đâu mà tôi phải tin các người! Á! Đau quá, Itsaho, sao lại đánh tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790113,
					"content": "Người ta mà không có ý tốt thì đã đánh anh từ lâu rồi, còn cần đứng đây phí lời vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790114,
					"content": "Thực không giấu gì hai vị, thương đội của chúng tôi vừa bị đánh tan tác. Nếu hai vị là nhà mạo hiểm, chẳng hay có thể giúp chúng tôi thông báo đến đại ca là chúng tôi đang chờ ở đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790115,
					"content": "Đồ trong rương này, cứ xem như là quà cảm ơn của chúng tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790116,
					"content": "Chuyện này đơn giản, cứ giao cho chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790109,
					"content": "Cũng biết điều đấy nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "Này! Nói gì thế! Đừng có làm như chúng tôi là người xấu thế chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
