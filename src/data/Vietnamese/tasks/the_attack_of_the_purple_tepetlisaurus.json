			"dialogs": [
				{
					"id": 751790901,
					"content": "Itsaho, đồ, đồ trong danh sách vẫn còn nhiều thứ lắm. Phải, phải giúp tôi đi tìm đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "Haiz... Đừng tốn sức nữa, tôi đã xem rồi. Căn bản đều là những thứ dễ hỏng. Lúc trước vừa gặp núi lửa vừa bị lật xe, thử nghĩ xem còn thừa được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Tiết kiệm sức lực, nghỉ ngơi cho tốt đi đã. Đợi mấy chị quay lại là còn chặng đường dài phải đi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
					"content": "Không, không được! Bỏ, bỏ đi, không đi thì tôi đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masose"
