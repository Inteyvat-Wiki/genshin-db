			"dialogs": [
				{
					"id": 751790701,
					"content": "Kể ra thì nhờ sự giúp đỡ của ba vị này mà đại tỷ mới bình an vô sự nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "Haha, đúng đúng! Mấy người này lợi hại lắm, chỉ vài chiêu thôi là đã hạ hết mấy con ma vật rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "Các vị đã cứu đội trưởng, tôi không có gì để báo đáp. Chút quà này xem như tỏ chút lòng thành, xin hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "Keo kiệt, Tizlo, anh vẫn cứ nhỏ mọn như vậy à? Sao có thể cho ân nhân cứu mạng một chút quà cảm ơn như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				}
			]
