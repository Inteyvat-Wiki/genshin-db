			"dialogs": [
				{
					"id": 751790301,
					"content": "Đương nhiên, chút quà nhỏ này là quà cảm ơn đã cứu mạng, chắc cũng chưa đủ hào phóng lắm nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "Đúng là chưa đủ lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "#Hahaha, nói đúng lắm! Tôi thích những người thẳng thắn như {F#cô}{M#cậu} đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "Khụ, tóm lại, đây là quà cảm ơn của cá nhân tôi, hai người cứ nhận lấy đi! Cứ xem như là mua thêm ít đồ ăn cho nhóc Tepetlisaur, không cần khách sáo với tôi đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Được rồi, chúng tôi còn phải nhặt lại đồ đạc thất lạc trên đường đi đây! Có duyên sẽ gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "Không, như vậy là đủ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "#Chậc, con người {F#cô}{M#cậu} cũng không thẳng thắn lắm nhỉ. Cho {F#cô}{M#cậu} thì cứ nhận lấy đi, nếu không lời đồn đi rồi, người khác sẽ chê tôi keo kiệt mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
		{
			"id": 7517904,
			"completionStepIds": [
				7517915
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7517915",
