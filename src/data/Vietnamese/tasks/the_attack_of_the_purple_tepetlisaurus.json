				{
					"id": 751790201,
					"content": "Hộc hộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790202,
					"content": "Vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "Vẫn, vẫn ổn, chỉ là vừa rồi chạy hơi vội. Nhịp, nhịp tim đập hơi nhanh, nhưng một lát nữa là không sao thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790204,
					"content": "Nghỉ ngơi cho khỏe nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "Ừm, cảm, cảm ơn đã quan tâm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				}
			]
		},
