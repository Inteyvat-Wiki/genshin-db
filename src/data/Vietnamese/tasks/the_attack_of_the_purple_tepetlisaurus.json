			"dialogs": [
				{
					"id": 751790601,
					"content": "Phù... Khó nhằn thật chứ. Đáng ghét! Suýt chút nữa đã bị mấy con Tepetlisaur đánh ngã, tức quá đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790602
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790602,
					"content": "Mấy người nhầm rồi, đó rõ ràng là ma vật do Vực Sâu biến thành! Chúng hung ác hơn Tepetlisaur nhiều, mấy người coi chúng là Tepetlisaur thì chẳng trách sao lại chịu tổn thất như vậy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790603
					]
				},
				{
					"id": 751790603,
					"content": "Haha, thì ra là như vậy à? Chẳng trách. Lần này tôi phải cảm ơn đàng hoàng, không nhờ hai người thì lần này tôi chết chắc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790604
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790604,
					"content": "#Nói thì nói vậy, nhưng {F#cô}{M#cậu} phải đợi ở đây chút đã. Tôi phải lôi hết mấy tên vô dụng đó về, xác nhận không sao rồi mới cảm ơn {F#cô}{M#cậu} được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790605
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790605,
					"content": "Nhờ sự giúp đỡ của bạn, người trong thương đội đã lần lượt tập trung lại.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
