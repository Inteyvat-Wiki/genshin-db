			"dialogs": [
				{
					"id": 210360201,
					"content": "Tiêu diệt kẻ địch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "Được! Từ lâu tôi đã muốn đưa kiếm thuật mà tôi học được vào thực tế rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360203,
					"content": "Chỉ sợ anh nhìn không rõ động tác của tôi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "Võ... võ nghệ của bạn cao cường vậy sao? Hahaha, vậy thì đành phải nhờ bạn thực hiện động tác chậm một chút rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360205,
					"content": "Để tôi xem... Gần đây có một chỗ ma vật tụ tập, chúng ta đến đó trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
