			"dialogs": [
				{
					"id": 210360101,
					"content": "Nhà Lữ Hành, chúng ta lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "Anh vẫn đang tập luyện sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "Đúng vậy, có điều... thật sự có hơi vất vả. Không biết do thực lực của tôi không đủ hay là do tập luyện sai cách nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Khoan nói những chuyện này đi. Lần trước đồng hành cùng bạn, chiêu thức và động tác của bạn đã truyền cảm hứng cho tôi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "Nhà Lữ Hành, hôm nay đi cùng tôi tập luyện thêm một lần nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "Vẫn như lần trước, \"tiêu diệt kẻ địch\" và \"huấn luyện ngoài thành\", bạn chọn cái nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "Sư muội của anh vẫn phớt lờ anh à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "E hèm... Sư muội... dạo này hay nói là phải xử lý việc trong thành, cũng không đến đây nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "Tôi có đi tìm cô ấy vài lần, nhưng cô ấy chỉ nhờ Zhiruo ra cản tôi, nhất định không chịu gặp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "Haiz, tôi cũng không biết làm thế nào để thuyết phục cô ấy đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
