			"dialogs": [
				{
					"id": 210360301,
					"content": "Huấn luyện ngoài thành.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "Tốt quá, có người đã giúp tôi chọn một lộ trình... Haiz, nếu tôi có thể vào đó luyện tập thì hay rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360303,
					"content": "Cô ấy nói chỉ cần tôi đến đích càng sớm càng tốt... nhưng lần nào tôi cũng mất quá nhiều thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360304,
					"content": "Vì vậy, tôi muốn nhờ bạn thị phạm giúp tôi, xem làm thế nào để chạy được nhanh hơn, tôi sẽ cố gắng đuổi theo sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360305,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "Vậy thì nhờ bạn nhé, chúng ta đến chỗ huấn luyện trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360306,
					"content": "Đừng để bị tôi bỏ xa quá đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "E hèm... Tôi... Tôi sẽ cố gắng đuổi theo, nhưng thành thật mà nói, lực chân của tôi cũng có giới hạn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
