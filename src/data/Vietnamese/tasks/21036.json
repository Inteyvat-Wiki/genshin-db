			"dialogs": [
				{
					"id": 210360601,
					"content": "Nhà Lữ Hành, chúng ta lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360602,
						210360604
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360602,
					"content": "Anh vẫn đang tập luyện sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360603
					]
				},
				{
					"id": 210360603,
					"content": "Đúng vậy, có điều... thật sự có hơi vất vả. Không biết do thực lực của tôi không đủ hay là do tập luyện sai cách nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360608
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360608,
					"content": "Khoan nói những chuyện này đi. Lần trước đồng hành cùng bạn, chiêu thức và động tác của bạn đã truyền cảm hứng cho tôi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360609
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360609,
					"content": "Nhà Lữ Hành, hôm nay đi cùng tôi tập luyện thêm một lần nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360610,
						210360611
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360610,
					"content": "Lúc trước anh từng tập luyện ở đây sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360613
					]
				},
				{
					"id": 210360613,
					"content": "Cũng may tôi có gặp được một nhà mạo hiểm tốt bụng, cô ấy đồng ý giúp tôi, dùng lý do \"chấp hành ủy thác\" để đưa tôi vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360614
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360614,
					"content": "Cô ấy còn giúp tôi xây dựng kế hoạch rèn luyện mới, cho tôi đủ lời đề nghị... Nhưng đồng thời tôi cũng phải xử lý ủy thác Hiệp Hội Nhà Mạo Hiểm cùng cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360615,
					"content": "Khụ khụ... Chúng ta nói chuyện chính trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360616
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360616,
					"content": "Là thế này, ban đầu tôi đã vạch ra một kế hoạch huấn luyện cho bản thân, trong đó bao gồm tiêu diệt kẻ địch và huấn luyện ngoài thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360617
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360617,
					"content": "Nhà Lữ Hành, bạn xem có thể cùng tôi tập luyện cái nào nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360611,
					"content": "Không ngờ anh lại đến đây tập luyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360612
					]
				},
				{
					"id": 210360612,
					"content": "Haiz, nói ra thì hơi xấu hổ, tôi nghe nói ở đây địa thế hiểm trở, nhiều ma vật, rất thích hợp để làm nơi tập luyện. Nhưng không ngờ là khó vào như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360613
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360604,
					"content": "Sư muội của anh vẫn phớt lờ anh à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360605
					]
				},
				{
					"id": 210360605,
					"content": "E hèm... Sư muội... dạo này hay nói là phải xử lý việc trong thành, cũng không đến đây nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360606,
					"content": "Tôi có đi tìm cô ấy vài lần, nhưng cô ấy chỉ nhờ Zhiruo ra cản tôi, nhất định không chịu gặp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360607
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360607,
					"content": "Haiz, tôi cũng không biết làm thế nào để thuyết phục cô ấy đây...",
