			"dialogs": [
				{
					"id": 210360401,
					"content": "Phù... phù... Đúng là khó thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360402,
					"content": "Xin lỗi, để bạn chê cười rồi. Xem ra tôi cũng chưa tiến bộ lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360403,
					"content": "Tôi còn phải tập luyện nhiều... Cảm ơn nhé, Nhà Lữ Hành, đây là thù lao của bạn, hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360404,
					"content": "Anh định rời Liyue bằng cách nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Ừm... Tôi định đi thuyền của thương gia và du ngoạn bằng đường thủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360406,
					"content": "Điểm dừng đầu tiên... Tôi muốn đến Fontaine trước, và ở đó một thời gian rồi tính tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360407,
					"content": "Haiz, không biết tôi có thể thuyết phục được sư muội và bạn đồng hành của mình không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
