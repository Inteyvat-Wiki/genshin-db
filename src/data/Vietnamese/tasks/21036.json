			"dialogs": [
				{
					"id": 210360501,
					"content": "Phù... Phù... Phù... Sao bạn... sao bạn có thể chạy nhanh như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360502,
					"content": "Do anh chạy quá chậm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "Bái phục... Bái phục...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360506,
					"content": "Cảm ơn bạn đã thị phạm cho tôi, Nhà Lữ Hành, hãy nhận lấy số thù lao này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360507,
					"content": "Về Que'er...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "Sư muội... Haiz, vẫn không thèm ngó ngàng đến tôi. Tôi, tôi cũng không biết làm thế nào để thuyết phục cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360509,
					"content": "Haiz... Chuyện này, sao lại khó giải quyết êm thấm vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360510,
					"content": "Về nhà mạo hiểm đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "Cô ấy? Ừm... tôi gặp cô ấy ở Hiệp Hội Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360512,
					"content": "Cô ấy nói mình đã nhận ủy thác của hiệp hội, đến Vực Đá Sâu làm việc, nghe nói tôi muốn vào đây nên tiện thể đưa tôi theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360513,
					"content": "Nhưng để trao đổi... Tôi phải cùng cô ấy thực hiện ủy thác, nhưng hầu hết đều là ủy thác tìm đồ vật, không có gì khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360514,
					"content": "Chỉ là cô ấy... thật sự nói quá nhiều, tôi lại không giỏi ứng phó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360504,
					"content": "Anh phải tập luyện nhiều hơn.",
