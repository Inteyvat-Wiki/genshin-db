						730560729
					]
				},
				{
					"id": 730560721,
					"content": "Nói ra thì dài lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560708,
					"content": "Chúng ta là bạn bè.",
