					"nextDialogs": [
						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "Nhưng xin đừng nán lại, ở nơi này. Hãy mau chóng rời đi, các bạn. Vẫn đang hồi phục, rừng sâu... Cho nên, không nên nán lại, khách mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560712,
					"content": "Khụ... đợi đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560713,
					"content": "Chúng tôi có một món đồ muốn cho bạn!",
