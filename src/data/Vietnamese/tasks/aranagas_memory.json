				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560201,
					"content": "Nơi ta muốn điều tra, chủ yếu là ba địa điểm. Haha, ký ức ba mươi năm trước đến đây hẳn là vẫn chưa quên sạch sẽ... Ta vẫn có thể chỉ đường cho các cháu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560202
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560202,
					"content": "Tóm lại, cám ơn các cháu đã đi cùng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560203
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560203,
					"content": "Không cần khách sáo, ông Khayyam! Đây đều là những việc mà \"Javan\" chúng cháu nên làm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305603,
			"completionStepIds": [
				7305609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
