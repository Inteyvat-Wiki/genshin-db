			},
			"dialogs": [
				{
					"id": 730560601,
					"content": "Cảm ơn hai cháu, hai vị \"Javan\". Vất vả cho hai đứa đã đi một chuyến với lão già này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560602,
					"content": "Đúng rồi, nếu không ngại... Tuy đây chẳng phải thứ quý trọng gì. Cái này cho mấy đứa, giữ làm kỷ niệm nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560603,
					"content": "Woa... là gì thế? Là gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560604,
					"content": "Có lẽ các cháu cũng đã từng thấy qua, đóa hoa khô nhỏ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560605,
					"content": "Ủa...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560606,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "Không sai. Nếu ta đoán không sai... chắc hẳn họ cũng đã tặng cháu món quà tương tự, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560609,
					"content": "Haha... Ta biết mà, cuộc gặp gỡ của chúng ta không chỉ là ngẫu nhiên... Ta không bao giờ tin vào sự trùng hợp cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560610,
					"content": "Đóa hoa này tặng cho cháu. Nhờ cháu hãy trao nó cho những người bạn chung của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560611,
					"content": "Vâng, chắc là được đó, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560612,
					"content": "Có lẽ họ sẽ không còn nhớ cháu đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560615
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560615,
					"content": "Ta cũng không thể nhìn thấy họ nữa... Thậm chí ta còn không thể tin rằng họ thật sự tồn tại, hay... đó chỉ là những tưởng tượng thời thơ ấu của ta mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560616,
					"content": "Nhưng ta vẫn kiên trì, các bạn nhỏ, hãy đưa cái này cho họ... Nhân lúc cháu còn có thể gặp được họ, nhân lúc phép màu vẫn còn có thể xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560614,
					"content": "Có thể họ đã không còn nhớ ông.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560615
					]
				},
