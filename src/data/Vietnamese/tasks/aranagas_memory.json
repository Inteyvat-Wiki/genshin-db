						],
						"stepId": 7305610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Huh! Cháu nhìn kìa! Nhìn cái này đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560402,
					"content": "Ủa? Là loài thực vật mới sao? Sao đột nhiên lại hưng phấn như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "Không phải, không phải là loài thực vật mới, nhưng lại càng khiến người ta vui vẻ hơn!... Hãy nhìn đi, \"tòa thành bí mật\" của ta kìa! Đã đổ nát đến thế này rồi cơ à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560404,
					"content": "Hả...? \"Tòa thành bí mật\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "Haha! Học sĩ Omar đã quay về! Anh ấy đã mang bí mật của các chòm sao trở về! Irfan, Siman, mọi người ở đâu thế! Còn không ra đón tôi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "Khụ... khụ khụ, xin lỗi nhé, các bạn nhỏ. Ta... ta có hơi hưng phấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560409,
					"content": "Già rồi hay như vậy, càng là việc ở hiện tại thì càng hồ đồ; càng là việc từ thuở nhỏ thì lại càng hoài niệm, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560410,
					"content": "Irfan, Siman, họ là bạn của ta, cả ba đã cùng nhau xây dựng \"tòa thành\" này, cả ba đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560411,
					"content": "Lúc đó, Irfan là một nhạc sĩ, Siman là nguyên soái, ta là học sĩ chiêm tinh. Ba người thỉnh thoảng cũng sẽ đổi vai cho nhau, trẻ con mà... Chơi chán rồi thì lại đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560412,
					"content": "Irfan chơi đàn rất hay; Siman cô ấy rất cao, cánh tay khỏe mạnh, không ai có thể đánh lại; còn ta thì sao? Haha, đọc sách nhiều hơn họ, trong nhà có nhiều Mora hơn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560413,
					"content": "Đây là nơi ông chơi đùa khi còn bé à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "Không, đây là vương quốc bí mật của cả ba, ta nghiêm túc đấy. Ta và bọn họ đã hẹn không được quên nhau, sau khi lớn lên sẽ gây dựng \"đội quân phục quốc\", trở về đây khôi phục tòa thành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560418,
					"content": "Haha, đã hai mươi năm trôi qua, có lẽ bọn họ đã quên... Nơi này từng là một căn cứ nhỏ để ta nghiên cứu về rừng sâu, nó đã hoạt động đến tận ba mươi năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560419,
					"content": "Sau đó, \"Marana\" đã đến, nhưng \"đội quân phục quốc\" vẫn chẳng thấy đâu. Haha, cũng đúng thôi... ước hẹn của trẻ con sao có thể ngăn cản cái chết được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560420,
					"content": "Nhưng mà... nếu ông vẫn còn nhớ đến họ, vậy họ chắc chắn cũng sẽ nhớ đến ông! Đừng nản lòng, ông Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "Nản lòng? Không đâu. Ký ức tuổi thơ, \"người bạn tưởng tượng\" của chung, một thế giới không dành cho người lớn. Có thể sẽ hơi tiếc nuối, nhưng mà... thời gian chẳng thể quay lại được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560422,
					"content": "\"Người bạn tưởng tượng\"... Ý ông là Aranara sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "Paimon...! Suỵt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560426,
					"content": "Haha... Suýt nữa thì quên mất, ta mời các cháu đến đây để giúp ta lấy mẫu thực vật mới kia mà, không phải là để tán gẫu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560427,
					"content": "Thứ lỗi cho lão già này đã quá lắm lời, chúng ta tiếp tục thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560424,
					"content": "Paimon nhiều lời quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Đây là những gì mà ông và những người bạn để lại sao...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "Không, không phải tất cả. Ban đầu cả ba người còn ước hẹn, đợi sau này lớn lên sẽ cử \"đội quân phục quốc\" về khôi phục nơi đây... Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560417,
					"content": "Sau đó ta đã nghiên cứu thực vật học tại Giáo Viện, tình cờ trở lại cải tạo nơi đây, dọn đi dọn lại cũng được kha khá rác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
