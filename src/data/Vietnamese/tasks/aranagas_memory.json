			"dialogs": [
				{
					"id": 730560501,
					"content": "Nhìn đi, nhìn đi... thực vật ở đây đang phát triển rất tốt! Thổ nhưỡng bị \"Marana\" tàn phá vẫn có thể sinh ra những loài thực vật đầy sức sống thế kia mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560502
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560502,
					"content": "Haha, \"Mawtiyima\" ơi là \"Mawtiyima\", người bạn già này! Sức lực cũng dư dả đấy chứ nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560503
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560503,
					"content": "Woa, trông ông Khayyam đột nhiên như trẻ ra vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560504,
					"content": "Paimon cũng đột nhiên biết cách nói chuyện rồi đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "Vậy là có ý gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560508,
					"content": "Ừm... Cháu hái thế là đủ rồi đấy, vất vả cho các cháu đã đi chuyến này với ta rồi. Nếu không còn việc gì khác, chúng ta rời khỏi đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560509,
					"content": "Haha, tốt quá rồi... Có được những mẫu vật này, có lẽ việc nghiên cứu bí mật và điểm yếu của \"Tử Vực\" sẽ có nhiều tiến triển hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560510,
					"content": "Vất vả cho hai cháu rồi, chúng ta cứ theo con đường cũ mà về... Ta có thứ này cho các cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560511,
					"content": "Tuyệt quá, là quà cảm ơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560512,
					"content": "Haha, cứ xem như là vậy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560506,
					"content": "Tuyệt quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "Tuy không rõ nguyên do, nhưng rất tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				}
			]
