	"talks": [
		{
			"id": 7305601,
			"completionStepIds": [
				7305601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305601",
							"2"
						],
						"stepId": 7305601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "Haha, thật là thú vị... thật là hay ho. Khỏe hơn rồi, khu rừng này... đang dần khỏe lại rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560102,
					"content": "Xin chào! Ông ơi, ông bị lạc à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560103,
					"content": "Ừm.. hửm? Rạc...? À, các cháu đang gọi ta à? Haha, ý cháu là lạc, đúng không? Không có chuyện đó, không có chuyện đó đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560104,
					"content": "Xin chào, các bạn nhỏ. Ta là Dastur của Học Phái{RUBY#[S]Luận Về Sinh Học} Amurta, Giyath Khayyam, haha... cứ gọi ta Khayyam là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560105,
					"content": "Ồ... Xin chào ông Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560106,
					"content": "Không... giống như vậy, ấn đầu lưỡi xuống, nâng thân lưỡi lên... Khay... sau đó miệng mở tròn...ya... cuối cùng mím môi một cách tự nhiên...m...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560107,
					"content": "Ừm... Khay...ya...m...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560108,
					"content": "Đúng rồi! Giỏi quá! Tốt đấy, cháu bé tóc vàng, làm lại một lần nữa xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560109,
					"content": "Khay...ya...m...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "Haha, tốt lắm! Giỏi hơn nhóc con màu trắng kia nhiều! Cháu xem, ta đã nói từ lâu rằng mình có thể dạy ngữ âm mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560113,
					"content": "Thế nhưng ông Khayyam... Nếu ông không lạc đường, vậy ông đến nơi này làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560114,
					"content": "Tại sao à? Haha... Ta là học giả rừng sâu. Đối với các học giả rừng sâu thì đây giống như nhà vậy. Sao ta có thể lạc trong ngôi nhà lâu nay của mình chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560115,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560116,
					"content": "Khu rừng sâu này đã bị \"Tử Vực\" quấy nhiễu. Ba mươi năm nay, cả các chủng loại và số lượng thực vật đều suy giảm nhanh chóng, trong khi đó các loại nấm gây hại lại ngày càng nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560117,
					"content": "Nhưng trong khoảng thời gian gần đây, \"Tử Vực\" đã biến mất, nhiều loài thực vật đã từng biến mất nay lại mọc lên, việc sinh sôi của nấm cũng giảm bớt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560118,
					"content": "Tình trạng thế này ta chỉ gặp một lần vào sáu mươi năm trước... Thế nên vì để nghiệm chứng ý tưởng non nớt của mình, ta đã đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560119,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560120,
					"content": "Về việc nghiệm chứng ý tưởng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "Haha, chuyện đã xảy ra cách đây sáu mươi năm rồi... đừng mong đợi lão già này sẽ nhớ rõ. Nhưng ta tin rằng, việc loại bỏ \"Tử Vực\" có liên quan đến chuyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560122,
					"content": "Vì thế tiếp theo, ta sẽ vào hang động này để thu thập vài mẫu vật để kiểm tra phỏng đoán của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560126,
					"content": "Vậy à... Tuy \"Marana\" trong hang đã biến mất, nhưng vẫn rất nguy hiểm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560127,
					"content": "Haha, với ta mà nói thì chẳng sao cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560128,
					"content": "Ồ, khoan đã... Cháu vừa nói gì? Trong hang có...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560129,
					"content": "\"Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "Ừm... Nghĩ lại thì có thể ta thật sự cần đến sự giúp đỡ của các cháu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560132,
					"content": "Đấy thấy chưa, đã nói mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560133,
					"content": "Haha, thứ lỗi vì đã mạo muội... hai bạn nhỏ có thể cho ta biết tên không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560134,
					"content": "#Gọi cháu {NICKNAME} là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "Còn cháu là Paimon! Pai... mon...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560136,
					"content": "Paimon? Paimon... haha, một cái tên thú vị... Đây là lần đầu ta nghe người... hay là tiểu tinh linh nhỉ, có cái tên này đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560137,
					"content": "À, xin lỗi, xin lỗi. Ta không có ý xúc phạm ... Ý ta là nhóc con này ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560138,
					"content": "Nhóc con gì chứ! Xúc phạm lắm rồi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560139,
					"content": "Được rồi, không nói nhảm nữa, mời hai vị \"Javan\" đi cùng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560140,
					"content": "\"Javan\"...? Đó là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560141,
					"content": "Đó là một ngôn ngữ cổ ở quê hương của ta, có nghĩa là \"người thanh niên dũng cảm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560142,
					"content": "Nói một cách chính xác thì đó là... \"những người trẻ tuổi đối mặt với sự tà ác khổng lồ nhưng không nhắm mắt làm ngơ, đối diện với sự bất công nhưng không lùi bước cầu hòa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560143,
					"content": "Hừm, đó chẳng phải là chúng cháu sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560144,
					"content": "Ồ? Tự giác vậy sao? Haha, vậy đi theo ta nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560145,
					"content": "Ơ? Ông Khayyam, ông có thật sự theo kịp được bọn cháu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560146,
					"content": "Haha, ta có ba mươi năm kinh nghiệm khảo sát rừng rậm rồi, đừng coi thường thể chất của người già! Các cháu cứ đi đi, ta đuổi kịp nhanh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560130,
					"content": "\"Tử Vực\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "Cần sự giúp đỡ của chúng cháu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "Haha... Cảm ơn các cháu, những đứa trẻ nhiệt tình, tuy xương cốt ta không còn linh hoạt nhưng não vẫn còn dùng được, đừng xem thường ta đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560125,
					"content": "Dù sao ta cũng biết nên làm thế nào để khiến rừng sâu vui vẻ mà, nên rừng sâu sẽ không làm hại ta đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560111,
					"content": "Ông Khayyam, ông làm gì ở đây thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "Hmm... Cháu phát âm quá nhanh, quá gấp. Nhưng không sao... chậm một chút là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
