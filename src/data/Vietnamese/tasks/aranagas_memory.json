					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560301,
					"content": "Thú vị đấy... Thực vật ở đây có vẻ... như được sống lại lần nữa. \"Mawtiyima\" lại phát huy tác dụng... quả thật rất thần kì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560302,
					"content": "Ơ... Ông Khayyam cũng biết đến \"Mawtiyima\" sao? Cháu cứ tưởng chỉ có Aranara mới biết chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560303,
					"content": "Paimon, suỵt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "\"Aranara\", phải không? Các cháu cũng đã thấy họ phải không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560306,
					"content": "Hả...? Ừm... vâng, vâng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560307,
					"content": "Sao thế, ông Khayyam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "\"Iram biến mất cùng tường vi, chén thánh của vị vua bên ngoài đang ở nơi đâu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560310,
					"content": "Chúng ta tiếp tục thôi, đến địa điểm tiếp theo nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560308,
					"content": "Ông cũng từng nhìn thấy Aranara à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "Paimon...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
			"id": 7305604,
			"completionStepIds": [
				7305610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305610",
