					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560704,
					"content": "Vì thế... tại sao lại ở đây, các bạn?",
