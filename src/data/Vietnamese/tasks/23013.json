					"nextDialogs": [
						230135203
					]
				},
				{
					"id": 230135203,
					"content": "Tốt lắm, nhiêu đây là đủ rồi. Lutong, bạn có thể trả trước thù lao cho Nhà Lữ Hành không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135204
					],
