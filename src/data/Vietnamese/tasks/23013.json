					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "Ngài Garcia, tôi thật lòng khuyên ngài thêm một lần nữa. Chúng ta có thể bán đi mấy bộ sách kiếm tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131102,
					"content": "Không! Tuyệt đối không! Ôi Lutong thân mến, anh đang bảo tôi bán đi linh hồn mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131103,
					"content": "Thưa ngài, vấn đề ở chỗ là không ai muốn ra giá cho linh hồn cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131104,
					"content": "Sao anh còn ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "Nhà Lữ Hành? Sao bạn lại tới đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131107,
					"content": "À... Thí nghiệm lần trước của tôi thất bại rồi. Phương pháp làm loãng dịch Slime của tôi có vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131108,
					"content": "Chất Bôi Trơn làm ra không những không bôi trơn cho \"Máy Đánh Số\", mà ngược lại còn khiến chúng dễ kẹt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131109,
					"content": "Vậy nên, tôi cần rất nhiều dịch Slime hơn để làm thí nghiệm. Bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131110,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "Xin bạn hãy giúp tôi tìm dịch Slime nhé Nhà Lữ Hành, tôi sẽ chuẩn bị thù lao đầy đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131111,
					"content": "Các anh không có cách kiếm tiền à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Không phải không có cách kiếm tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131113,
					"content": "Mà là không có năng lực kiếm tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131114,
					"content": "Vô cùng cảm ơn sự bổ sung của anh, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131115,
					"content": "Haiz, thật xấu hổ... Tuy tôi nói tôi đã chế tạo ra \"Máy Đánh Số\", nhưng công năng của nó quá đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131116,
					"content": "Nói thế nào nhỉ, ngay cả chuyện \"giải toán\" cũng không thể tự làm được, cần tôi phải thao tác thủ công giúp nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131117,
					"content": "Nhưng... tôi nhất định sẽ hoàn thiện nó! Tôi có đầy đủ cơ sở tin tưởng, \"Máy Đánh Số\" của tôi sẽ là một phát minh vĩ đại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131118,
					"content": "Một... một phát minh tuyên bố chuyển giao giữa thời đại cũ và thời đại mới! Sau đó tôi nhất định sẽ tìm ra được cách kiếm tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131119,
					"content": "Nhưng, nhưng trước đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131105,
					"content": "Anh vẫn cần Dịch Slime à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
