			"dialogs": [
				{
					"id": 230135001,
					"content": "Thưa ngài, xem ra đây chính là nơi chúng ta cần tìm rồi, tiếp theo chỉ cần thuê một số người đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135002,
					"content": "Thưa ngài? Ngài Garcia, ngài có đang nghe tôi nói không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135003,
					"content": "Hở? Ờ... Tất nhiên rồi, tôi đang nghe, vậy chúng ta về thuê người thôi, không mất bao nhiêu thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135004,
					"content": "Anh... vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "Nhà Lữ Hành, hahaha... Không sao hết, tôi ổn, sao bạn lại cho rằng tôi không ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135006,
					"content": "Giờ tôi đang dốc hết công sức vào việc nghiên cứu \"Máy Đánh Số\". Tôi thấy mình chỉ còn một bước nữa là thành công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135007,
					"content": "Nếu bạn bằng lòng, có thể lấy một ít Dịch Slime giúp tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135008,
					"content": "Nếu có bạn ở đây, tôi cũng chẳng cần phí sức về thành thuê người nữa. Vừa hay tôi cũng kiếm được một ít tiền, có thể trả giá cao hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135009,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "Thế thì giao lại cho bạn đấy, Nhà Lữ Hành. Tôi còn phải nghĩ nên sửa đổi kết cấu cơ quan như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135010,
					"content": "Chuyện này không thành vấn đề...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
