			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "Lutong, tài chính của chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130202,
					"content": "Chúng ta sẽ tìm được cách sống sót thôi, thưa ngài Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130203,
					"content": "Người Liyue chúng tôi có câu \"Xe đến trước núi ắt có đường\". Tôi cho rằng rất thích hợp áp dụng vào hoàn cảnh của chúng ta bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130204,
					"content": "Những lời này có nghĩa là, khi con đường chúng ta đi bị một ngọn núi cao ngăn lại, kiểu gì cũng tìm được cách vượt qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130205,
					"content": "Haha, đúng là một phép so sánh khéo léo, xem ra tình hình của chúng ta vẫn ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130206,
					"content": "Thưa ngài Garcia, ngài nghĩ khi người kia viết những lời này, có tìm được cách qua núi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130207,
					"content": "Hở? Uầy, đừng làm mất hứng chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
			],
