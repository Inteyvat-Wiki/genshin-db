				"objectNames": [
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "Nhà Lữ Hành, bạn đã lấy được Dịch Slime chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130302,
					"content": "Đã lấy được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "Quá tuyệt vời! Nhiêu đây chắc là đủ rồi, tôi về sẽ bắt đầu làm thí nghiệm, có Chất Bôi Trơn này, \"Máy Đánh Số\" của tôi nhất định sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130304,
					"content": "Tôi phải nghiên cứu chút đã. Lutong, chuyện còn lại nhờ anh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130305,
					"content": "Vâng thưa ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130306,
					"content": "Đây là thù lao của bạn, Nhà Lữ Hành, vô cùng cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130307,
					"content": "Ừm... Với con mắt nhìn xa trông rộng của tôi, chắc sau này vẫn sẽ cần bạn giúp đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130308,
					"content": "Xin cứ yên tâm, chỉ cần sổ sách vẫn do tôi quản lý thì bạn chắc chắn sẽ nhận được mức thù lao phù hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130309,
					"content": "...Haiz, lý do tôi lên đường cùng ngài Garcia, là vì không muốn giống cha mẹ mình, cả đời tính toán sổ sách trong một cơ quan nào đó ở Tổng Vụ Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130310,
					"content": "Nhưng bây giờ... ngoài việc tính toán cùng ngài Garcia ra, tôi còn cần phải chỉnh sửa lại sổ sách chi tiêu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130311,
					"content": "Có lẽ đây là \"vận mệnh an bài\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301311,
