					"nextDialogs": [
						230135104
					]
				},
				{
					"id": 230135104,
					"content": "Đương nhiên, vẫn vì chuyện của cô Kaia. Dù ngài Garcia không nói ra, nhưng càng ngày ngài ấy càng hay mất tập trung trong khi làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135105,
					"content": "Hơn nữa ngài ấy cũng không ghé qua tiệm cà phê kia nữa, chỉ bảo tôi mua về giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135106
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135106,
					"content": "Đến cả ngài Ahangar cũng đến nói với tôi, nếu cần thiết, ngài ấy có thể nói chuyện với ngài Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135107,
					"content": "Tôi cũng không biết phải làm sao để ngài Garcia hiểu, dù gì tôi cũng không có kinh nghiệm ở mặt này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135108,
					"content": "Ôi, xem ra trước mặt tôi và ngài Garcia lại có thêm một đường ranh ngăn cách không thể vượt qua được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135103,
					"content": "Anh ta vẫn vì...",
					"roleType": "TALK_ROLE_PLAYER",
