					"nextDialogs": [
						230135205
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135205,
					"content": "Đây là thù lao của bạn, cảm ơn sự trợ giúp của bạn một lần nữa, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135206
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135206,
					"content": "Sau này nếu rảnh, mong bạn thường xuyên ghé thăm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135207,
					"content": "Nếu như tinh thần của ngài Garcia quá bất ổn, có lẽ tôi cần bạn giúp một tay.",
