				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "Lutong thân mến của tôi, anh... có chắc là nơi này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130102,
					"content": "Không nhầm đâu, ngài Garcia, đây là nơi Slime thường qua lại nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130103,
					"content": "Tôi không hề nghi ngờ nơi Slime tụ tập, vấn đề của tôi là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130104,
					"content": "Số Slime này có nhiều quá không vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130105,
					"content": "Ngài Garcia, đây chính là hậu quả khi chúng ta thiếu tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130106,
					"content": "Anh là... Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "Nhà Lữ Hành! Trùng hợp thật, bạn cũng đến Sumeru rồi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130109,
					"content": "Anh ở đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "Hahaha, tôi ở đây vì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130111,
					"content": "Tự chuốc khổ vào thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130112,
					"content": "Dũng cảm mạo hiểm. Cảm ơn, Lutong, anh có thể hơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130113,
					"content": "Như ngài mong muốn, thưa ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130114,
					"content": "Quay lại vấn đề chính, tôi ở đây vì muốn tìm \"Dịch Slime\" để chế tạo Chất Bôi Trơn cho \"Máy Đánh Số\" của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130115,
					"content": "Nhưng, một mặt vì \"Dịch Slime\" bán trên thị trường đã qua thời gian lâu rồi, chất lượng không cao, mặt khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130116,
					"content": "Là vì ngài Garcia mua quá nhiều sách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130117,
					"content": "...Là vì, chúng tôi bị buộc phải trả rất nhiều... chi phí cần thiết! Dẫn đến thiếu hụt nguồn vốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130118,
					"content": "Nên chúng tôi mới đến đây, muốn lấy trực tiếp một ít Dịch Slime tươi mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130119,
					"content": "Nhưng như bạn thấy đấy, Lutong thân yêu của tôi là một người Liyue, vừa không biết võ vừa không biết nấu ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130120,
					"content": "May mắn là tôi có tài xử lý sổ sách... điều này phải nhờ quy tắc thuế phức tạp ở Tổng Vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130121,
					"content": "...Mà tôi lại không thể lấy linh kiện \"Máy Đánh Số\" để đánh nhau được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130122,
					"content": "Anh cần tôi giúp ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "Ở một mặt nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130124,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130125,
					"content": "Lutong, chúng ta... ừm, chúng ta còn tiền không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130126,
					"content": "Sau khi trả thù lao cho Nhà Lữ Hành xong, tôi tin chúng ta sẽ tìm được phương pháp sống sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130127,
					"content": "Vậy được rồi! Xin nhờ cả vào bạn, Nhà Lữ Hành, xin hãy lấy Dịch Slime về cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130107,
					"content": "Sao anh lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
