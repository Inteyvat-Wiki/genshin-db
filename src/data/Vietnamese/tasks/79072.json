			"dialogs": [
				{
					"id": 790720101,
					"content": "#Ôi, thật vinh dự. Đây hẳn là {NICKNAME} phải không? Còn người bên cạnh đây chắc là bạn đồng hành Paimon rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720102,
					"content": "Hihi, đúng vậy. Chính là chúng tôi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "Chúng tôi nổi tiếng đến vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "Thông tin ở trong Vương Thành Tinh Cầu lúc nào cũng nhanh hơn những nơi khác mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720105,
					"content": "Phải công nhận là hai vị đến thật đúng lúc, tôi vừa mới làm xong trò chơi mang tên \"Mũ Bay\" này luôn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720106,
					"content": "Mặc dù tôi không thể giúp mọi người sở hữu được một chiếc mũ đẹp giống như thợ mũ trong câu chuyện \"Thợ Mũ Bay\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720107,
					"content": "Nhưng tôi tin rằng trò chơi \"Mũ Bay\" này chắc chắn sẽ mang đến niềm vui cho tất cả những ai chơi nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720108,
					"content": "Tôi đã thiết kế ba cách chơi hoàn toàn khác nhau cho trò chơi này... Tất nhiên, quy tắc cũng không có gì phức tạp cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720109,
					"content": "Tôi tin chỉ cần hai vị chơi một ván thôi là sẽ hiểu rõ quy tắc ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720110,
					"content": "Để thử xem sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Không thành vấn đề, mời qua bên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720112,
					"content": "Tôi chưa có thời gian rảnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Không sao, khi nào có thời gian thì hãy quay lại tìm tôi. Tôi sẽ ở đây trong suốt quãng thời gian sắp tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				}
			]
		}
	]
