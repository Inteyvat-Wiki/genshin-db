			"dialogs": [
				{
					"id": 705330101,
					"content": "Không ngờ phát minh của mình còn có công dụng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330102,
					"content": "Ồ! Xin chào, Nhà Lữ Hành, không ngờ chúng ta lại gặp nhau rồi... khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330103,
					"content": "Tôi còn tưởng anh đã rời khỏi Mondstadt rồi chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "Tôi cũng định như thế, nhưng mà... mọi thứ luôn thay đổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330108,
					"content": "E hèm, tạm không nhắc chuyện này nữa, chúng ta nói chuyện chính đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330109,
					"content": "Lần này tôi nhận lời mời của Hiệp Hội Nhà Mạo Hiểm Thành Mondstadt, sử dụng các bánh răng và cơ quan tạo ra một số Tranh Máy Móc mô phỏng theo thẻ bài, có thể tháo rời và lắp ráp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330110,
					"content": "Thẻ bài đó gọi là gì nhỉ... Đúng rồi! Thất Thánh Triệu Hồi, chính là cái tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330111,
					"content": "Nghe họ nói là những bức Tranh Máy Móc sẽ được đưa đến khu vực tổ chức giải đấu Thất Thánh Triệu Hồi lần này, rồi làm sự kiện nhỏ gì đó cho náo nhiệt thêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330112,
					"content": "Haiz, chuyện này thật sự quá phức tạp. Tôi chỉ nên tập trung vào phát minh của mình thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330113,
					"content": "Đúng rồi, Tranh Máy Móc của Mondstadt đang ở chỗ tôi, nếu bạn muốn thử ghép nó thì cứ trải nghiệm đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330105,
					"content": "Phát minh của anh lại có vấn đề rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "Không có! Lần này không có, ừm... phải nói là ngay từ đầu đã không có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330107,
					"content": "Lần trước tôi nhờ bạn giúp, đơn giản là vì vấn đề ma vật, không liên quan gì đến phát minh của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				}
			]
		}
	]
