				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "Capitano không chỉ võ thuật siêu phàm mà còn từng nghiên cứu ra thuốc đặc trị chống lại Vực Sâu! Chuyện này anh không biết đúng không? Còn dám nói tôi là học giả dỏm không biết gì ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960202,
					"content": "Vậy anh có biết tốc độ của Đại Đội Trưởng chúng tôi nhanh cỡ nào không! Chỉ trong chớp mắt, ngài ấy đã chạy dọc theo địa mạch từ Nod-Krai về tận Mondstadt đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leifhelm"
				}
			]
		},
