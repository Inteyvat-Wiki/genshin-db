			"dialogs": [
				{
					"id": 700960301,
					"content": "Ineffa, Ineffa! Nhìn cái cối xay gió kia kìa! Mau ghi lại kết cấu của nó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "Đã rõ... Đang chuẩn bị chụp ảnh cối xay gió. Lần này có muốn chụp chung không, Aino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#Ơ? {NICKNAME}? Paimon... còn có cả Lohen nữa! Xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "\"Rồng cổ hùng mạnh\" đến từ Nod-Krai... lẽ ra tôi phải sớm đoán ra là ai mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Đang tổng kết tình hình... Vậy nên Lohen muốn tìm tôi để huấn luyện chiến đấu à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "Bỏ qua ngọn ngành câu chuyện thì tóm lại đúng là như vậy. Lúc còn viễn chinh ở Nod-Krai, tôi thật không ngờ cô lại có lai lịch phức tạp như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "Nhưng cũng không quan trọng, trước đây tôi đã muốn lĩnh giáo thân thủ của cô rồi, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "Hừ hừ! Ineffa! Cho anh ta biết tay đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "Rất tiếc... theo lịch trình hôm nay, chúng tôi còn phải đi thu thập linh kiện đặc biệt ở Mondstadt. Theo đánh giá, nếu tiến hành giao chiến, có lẽ sẽ ảnh hưởng đến hoạt động tiếp theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Đúng nhỉ... Suýt nữa thì quên mất chuyện này. Rõ ràng là nghe nói Mondstadt có người máy khổng lồ nên mới đến đây... nhưng không cẩn thận chơi quên lối về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "Được... tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen... lại bỏ cuộc dễ thế sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "...Chỉ cần giúp hai người xử lý mấy con Thủ Vệ Di Tích đó, thì cô sẽ sắp xếp được lịch trình nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
