			"dialogs": [
				{
					"id": 700960101,
					"content": "...Nói đến chiến binh mạnh nhất thì phải kể đến Capitano của chúng tôi! Chỉ dựa vào sức mạnh cơ thể cũng có thể chống lại Vực Sâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960102
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960102,
					"content": "Đây là kiểu phát ngôn điển hình của người chưa từng gặp kẻ địch mạnh, cũng chẳng hiểu gì về chiến đấu! Anh nghĩ tất cả kẻ mạnh biết đứng đánh cọc gỗ thôi sao? Hơn nữa chỉ nói về sức mạnh thì Đại Đội Trưởng của chúng tôi cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960103
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960103,
					"content": "...Đủ rồi. Tôi gọi hai người đến đây không phải để nghe những tranh luận vô vị như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960104
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960104,
					"content": "Lohen? Còn cả hai người nữa? Tổ hợp hiếm thấy đấy... Bình thường không phải mọi người đều ở Nod-Krai sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960105,
					"content": "Ha... Tôi nghe nói ở Nod-Krai có hai chuyên gia về \"sức mạnh chiến đấu\", định mời họ qua biên soạn một cuốn \"Cẩm Nang Về Kẻ Địch Mạnh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960106
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960106,
					"content": "Ai ngờ họ mới nói vài câu đã tranh cãi không ngừng, xem ra... tôi phải nghĩ cách để hai người nghiêm túc hơn một chút rồi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960107
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960107,
					"content": "Ừm... tôi... tôi bắt đầu biên soạn ngay đây! Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960108
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960108,
					"content": "Đội... đội trưởng Lohen! Tôi cũng không muốn thế đâu, nhưng định nghĩa \"kẻ địch mạnh\" thực sự quá mơ hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960109
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960109,
					"content": "Đừng nói ma vật thường, ngay cả giữa các Ma Thần cũng có sự chênh lệch một trời một vực. Nếu không tìm được tiêu chuẩn phù hợp thì e rằng vẫn khó để có kết luận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960110
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960110,
					"content": "Nếu, nếu muốn nói đến tiêu chuẩn mà mọi người đều cho là \"mạnh mẽ\"... thì chắc là \"rồng\" nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960111
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960111,
					"content": "...Rồng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960112
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960112,
					"content": "Thật sao, sao tôi lại thấy khoảng cách giữa rồng, có lẽ cũng lớn như khoảng cách giữa Ma Thần với Ma Thần vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960113,
						700960114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960113,
					"content": "Sao anh lại muốn biên soạn \"Cẩm Nang Về Kẻ Địch Mạnh\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960115
					]
				},
				{
					"id": 700960115,
					"content": "Chuyện này à... Sau khoảng thời gian suy ngẫm lúc trước, tôi cảm thấy cách tốt nhất để tiếp tục trở nên mạnh hơn... là khiêu chiến với kẻ địch mạnh của các quốc gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960116
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960116,
					"content": "(Nghe cũng chẳng khác gì trước khi suy ngẫm...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960117
					]
				},
				{
					"id": 700960117,
					"content": "Nhưng sáng nay khi tôi chuẩn bị ra ngoài... có một thứ trông kỳ quái xuất hiện và nói với tôi những lời không đầu không đuôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960118
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960118,
					"content": "\"Hỡi con người lạc lối kia, cậu sẽ ba lần đối mặt với uy lực của rồng, sau đó sẽ hiểu được ý nghĩa của sức mạnh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 700960119,
					"content": "(Miêu tả này... nghe sao cũng thấy giống Barbeloth!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960120
					]
				},
				{
					"id": 700960120,
					"content": "Tôi thì chẳng để tâm đến lời tiên tri gì đó, nhưng cục diện hiện tại... Hừm, cảm giác như mọi thứ đều nằm trong tay kẻ khác, thật khiến người ta khó chịu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960121
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960121,
					"content": "Rồng à... Nói đến rồng ở Mondstadt thì có Đông Phong Thủ Hộ, ma long Ursa, cùng với truyền thuyết trên núi tuyết... Còn gì nữa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960122
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960122,
					"content": "Hừ, cái này thì anh không biết rồi! Căn cứ vào tình báo tuyệt mật mà tôi nắm được ở Nod-Krai, một con rồng cổ xưa cực kỳ hùng mạnh đã lặng lẽ đến Cảng Dornman rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960123
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960123,
					"content": "Có chuyện này sao? Thật hay giả vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960124,
					"content": "Ha, thật hay giả thì đi gặp một lần là biết ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960114,
					"content": "Anh có vẻ khá quan tâm đến rồng nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960115
					]
				}
			]
		},
		{
