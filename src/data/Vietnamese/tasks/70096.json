				{
					"id": 700960701,
					"content": "Haiz, lần đầu đích thân ra tay, không ngờ lại thành ra thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960702,
						700960704
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960702,
					"content": "Vạn sự khởi đầu nan mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "Hơn nữa, kết quả cũng không tệ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960704,
					"content": "Lần đầu đích thân ra tay làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "Ừm... là Bài Tập Của Ma Nữ, để lát tôi giải thích sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
