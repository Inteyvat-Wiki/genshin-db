			"dialogs": [
				{
					"id": 700960501,
					"content": "...Người theo đuổi sức mạnh, đi theo chỉ dẫn của vận mệnh, cuối cùng đã đến được nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "Quả nhiên là Durin... Sao tôi chẳng thấy bất ngờ chút nào nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "Nhưng giọng điệu có vẻ hơi khác?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "Lãnh chúa tối cao, tạo vật của ma nữ, hậu duệ thiên sứ... Sử dụng những sức mạnh hoàn toàn khác nhau, nhưng đều mang cái tên \"rồng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "...Chỉ vì rồng là biểu tượng của sức mạnh tuyệt đối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "Cho nên \"chiến đấu với rồng\" cũng trở thành minh chứng cho sức mạnh?... Tôi có phần hiểu được tâm trạng của Đại Đội Trưởng lúc đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "...Hửm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "Tuy cậu có vẻ như còn muốn nói gì đó, nhưng tiếp theo hãy dùng vũ khí giao lưu đi? Như vậy sẽ dễ hiểu hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "Khoan đã! Nhân... nhân loại trẻ tuổi, thí luyện anh muốn tìm không ở đây, hãy tới Phế Tích Phong Long để đối mặt với lời tiên tri cuối cùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "Nói nhanh quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "Không sao chứ, Durin? Sao tôi thấy hôm nay cậu nói chuyện lạ lạ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Ha... Chắc đã đọc hết những gì cần đọc rồi... Tuy rằng đã bỏ qua rất nhiều!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Chuyện đó, anh Albedo gọi tôi đi giúp anh ấy làm thí nghiệm, tôi phải về trước đây. Xin lỗi các vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Bay mất rồi sao? ...Thật đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "Hử? Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Hmm... Vậy rốt cuộc Durin đến đây để làm gì? Ngoài câu cuối \"hãy tới Phế Tích Phong Long\" ra thì hình như không có thông tin gì hữu ích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "Tôi có một linh cảm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "Thú vị đấy, bây giờ tôi cũng muốn xem thử \"lời tiên tri\" này sẽ được thực hiện thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "Là để gom đủ số \"ba\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "Như diễn viên đang vội rời khỏi sân khấu vậy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
