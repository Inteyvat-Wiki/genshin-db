					"nextDialogs": [
						700960602
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960602,
					"content": "Lời thoại mở màn... nhớ rồi. Hiệu ứng xuất hiện... đã kiểm tra xong. Ừm, lần này chắc chắn không có gì sai sót!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960603,
					"content": "Mọi người nói xem... Lời tiên tri cuối cùng, tại sao lại muốn Lohen đến đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960604,
					"content": "Sao đã tới rồi? Chẳng lẽ Durin chưa đọc hết lời thoại? Không được... phải nói nhỏ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960605,
					"content": "Lẽ nào lần cuối cùng \"đối mặt với uy lực của rồng\"... là nói về Dvalin? Nhưng hôm nay có vẻ nó không có ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960606,
					"content": "Nói chính xác thì trước đây tôi đã gặp Đông Phong Thủ Hộ rồi. Khi tôi vừa từ Nod-Krai trở về, ngay bên cạnh hai người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960607,
					"content": "Ồ đúng nhỉ, là lần giúp Varka đưa thư đến Lang Lãnh! Tính ra thì \"lời tiên tri\" của anh thật ra đã kết thúc rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960608,
					"content": "Ít nhất thì \"ba lần đối mặt với uy lực của rồng\", tính ra đã có thể kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960609,
					"content": "Còn \"hiểu được ý nghĩa của sức mạnh\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "Ừm, có lẽ đây mới là lý do \"lời tiên tri\" dẫn tôi đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960611,
					"content": "Nơi này trước khi được gọi là Phế Tích Phong Long, từng là lãnh địa của Ma Thần Rồng Cuộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960612,
					"content": "Ma Thần hùng mạnh có thể cuốn lên cuồng phong che chở vạn vật, lại không thể ngăn được khát vọng tự do trong bức tường gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960613,
					"content": "Ma Thần Bắc Phong từng tranh giành ngai thần với nó, nhưng sau khi từ bỏ sức mạnh lại tìm thấy đáp án mà mình luôn tìm kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960614,
					"content": "Hả? Đứa trẻ này... hình như cũng không cố chấp như Varka nói?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960615,
					"content": "Tấm Gương Bình Minh, ma long Durin... đều từng rơi vào sự hoang mang và mơ hồ, nhưng điều dẫn dắt họ trở lên mạnh mẽ không chỉ là sức mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960616,
					"content": "Ừm... ngộ tính khá đấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960617,
					"content": "Còn có cả Ursa, thiên sứ ngày xưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960618,
					"content": "...Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960619,
					"content": "Tuy nói rất có lý... nhưng đây thực sự là lời mà Lohen sẽ nói ra sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960620,
					"content": "Đầu tiên là Durin... giờ lại đến Lohen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "\"Thiên sứ đã chọn sức mạnh, vẫn khao khát đến gần con người, đến nỗi sa ngã thành ma vật đáng thương...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960623,
					"content": "\"Con người đã chứng kiến tất cả những điều này, vẫn còn cố chấp với sức mạnh sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960624,
					"content": "...Đây đều là thoại của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960625,
					"content": "Ối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960626,
					"content": "A... không cẩn thận đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960627,
					"content": "Hân hạnh được gặp, quý cô Nicole. Kịch bản mà cô viết, tôi đã xem qua rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960628,
					"content": "Haiz... Là nhặt được từ chỗ Durin đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960629,
					"content": "Ồ? Hay đây cũng là lời tiên tri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960630,
					"content": "Chỉ là suy đoán của tôi thôi. Nếu như cái này cũng có thể tiên tri được thì ban nãy tôi cũng sẽ không... khụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960631,
					"content": "Tóm lại, kịch bản này viết khá hay, coi như truyện cổ tích đọc cũng thú vị đấy. Nhưng tôi không thích bị thuyết giáo cho lắm... dù là thiên sứ cũng không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960632,
					"content": "...Tôi sẽ coi như đây là đang nói về người đồng nghiệp cũ đã chọn sức mạnh của tôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960633,
					"content": "Nếu đã nhặt được kịch bản, thì chắc cũng đã đọc được hết những gì tôi muốn nói rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960634,
					"content": "Ừm, tôi sẽ ghi lại những lời thoại này xem như lời khuyên quý giá. Nếu không có việc gì khác, thì tôi quay về tiếp tục biên soạn Cẩm Nang Về Kẻ Địch Mạnh đây nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960635,
					"content": "(Không nói là sẽ nghe theo lời khuyên này...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "Nhưng hôm nay đúng là tôi đã thu hoạch được không ít, ừm... chắc là mạnh hơn một chút rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960638,
					"content": "Cảm ơn nhé, các vị... cũng thay tôi gửi lời chào đến những \"nhân viên hậu trường\" nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960639,
					"content": "Haiz... Quả nhiên lại là một con người khó đối phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960640,
					"content": "Vậy rốt cuộc chuyện này là sao? Ai đó giúp tôi tổng kết lại đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960641,
					"content": "Không phải trước đó mọi người đã giải quyết Dottore và tàn dư mà Ursa để lại ở Mondstadt sao? Nghe nói lúc đó Lohen cũng chịu không ít khổ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960642,
					"content": "Đã là tai họa do thiên sứ ngày xưa để lại, thì đương nhiên phải dựa vào thiên sứ hiện tại khắc phục... Mặc dù có hơi khác so với dự đoán ban đầu của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960643,
					"content": "Sau này vận mệnh của con người e rằng sẽ càng trở nên khó dự đoán hơn? Sự chỉ dẫn của thiên sứ đối với con người cũng không còn là cách duy nhất dẫn đến tương lai nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960644,
					"content": "Nhưng những khả năng vô hạn này... có lẽ lại chính là điểm \"mạnh mẽ\" của con người nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960636,
					"content": "(Vẫn muốn tiếp tục biên soạn cẩm nang...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "Sao đều bắt đầu đọc kịch bản hết vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
