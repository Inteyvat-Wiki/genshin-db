			"dialogs": [
				{
					"id": 700960401,
					"content": "Động tác rất mượt mà, hoàn toàn không giống máy móc chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960402,
					"content": "Đòn tấn công của Lohen cũng rất chính xác, giống như máy móc vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960403,
					"content": "Tuyệt vời! Là linh kiện mới! Có thể mang về làm mô đun mới rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960404,
					"content": "Ồ? Vậy bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960405,
					"content": "Ineffa! Đi tìm thêm vài cái nữa! Càng nhiều mẫu càng tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960406,
					"content": "Ừm... Xin lỗi, chúng ta nói chuyện sau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960407,
					"content": "Sau một hồi thám hiểm...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960409,
					"content": "Ngủ mất rồi... Có phải vì trước đó chơi ở Cảng Dornman mệt quá không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960410,
					"content": "Aino thường như vậy, tinh thần đến nhanh mà cũng tan nhanh. Xin lỗi Lohen, hiện tại tôi không thể di chuyển được, cần đợi Aino ngủ say hơn một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960411,
					"content": "...Thôi bỏ đi, sức mạnh của cô, tôi đã thấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960412,
					"content": "...Hy vọng dữ liệu chiến đấu của tôi sẽ giúp ích cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960413,
					"content": "Đúng rồi, người cung cấp thông tin về máy móc đặc biệt cho chúng tôi còn nhắc đến núi tuyết, có lẽ các vị có thể đến đó xem thử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		},
