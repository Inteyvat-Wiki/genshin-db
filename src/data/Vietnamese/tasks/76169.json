			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}, Paimon, hai vị cũng đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690102,
					"content": "Chúng tôi cũng đến thăm anh ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "Nếu như anh ấy biết được, thì dù không nói ra nhưng trong lòng anh ấy chắc chắn sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690104,
					"content": "Đứng trước mộ một lúc cùng Illuga...\\nIlluga kể lại những chuyện lớn nhỏ gần đây ở Thành Piramida cho người đồng đội đã đi trước một bước...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "Chắc anh ấy sẽ yên lòng khi biết mọi người và Thành Piramida đều ổn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761690106,
					"content": "Ừm, anh ấy đã hoàn thành nhiệm vụ của anh ấy rồi, còn chúng tôi cũng sẽ tiếp tục hoàn thành nhiệm vụ của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690107,
					"content": "Và sau chúng tôi, sẽ có những người khác tiếp tục bảo vệ vùng đất này, giống như Cỏ Đông Lăng vậy, dù trải qua bão tố và giá rét, vẫn không ngừng sinh sôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
