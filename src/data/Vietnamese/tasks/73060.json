			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika quả nhiên đã thuận lợi, nhưng vẫn lo cho Aranakula đang ở Ảo Cảnh Yasna và Arakunti ở Khoảnh Rừng Mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Aranakula... Nhiều nấm xấu quá, lỡ như Aranakula lại bị nấm xấu bắt được thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "Lo nhiều cũng chẳng có tác dụng gì. Nara Vàng rất mạnh, đánh ngã khối sắt to như gió lớn quật ngã gỗ mục vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "Chỉ cần sửa chữa xong Cỗ Máy Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
