			"dialogs": [
				{
					"id": 730600401,
					"content": "Khoảnh Rừng Mơ... Giai điệu êm đềm, tiếng nước chảy, tiếng chim vỗ cánh, tiếng bước trên cành cây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "Nói chuyện với Nara và Paimon... Paimon rất vui. Nhưng tiếc thay, Paimon không muốn trở thành hạt giống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "Vì Paimon không phải là Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "Khoảnh Rừng Mơ đã không còn vấn đề gì nữa, Arabalika ở Phế Tích Dahri, nhưng không cần lo, \"Nấm Quỷ\" ở Ảo Cảnh Yasna rất nhiều, lo cho Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
