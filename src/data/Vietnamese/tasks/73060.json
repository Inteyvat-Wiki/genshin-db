			"dialogs": [
				{
					"id": 730600201,
					"content": "Dường như Nara Vàng chẳng sợ gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "Nara Vàng là Nara dũng cảm, giống như Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "Mặc dù lo lắng cho Arabalika ở Phế Tích Dahri và Arakunti ở Khoảnh Rừng Mơ, nhưng có sự giúp đỡ của Nara Vàng, nhất định sẽ không có vấn đề gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "#Một khi sửa chữa được Cỗ Máy Varuna, sẽ không có kẻ xấu đến quấy nhiễu vườn ươm nữa, muốn tặng hoa của vườn ươm cho {F#cô ấy}{M#anh ấy}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
