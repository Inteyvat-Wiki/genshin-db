			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "Việc làm ăn ngày càng khó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "Ừm? Ồ ý tôi là nói việc làm ăn ở quán rượu ngày càng khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030104,
					"content": "Mở các quán ăn uống như chúng ta, làm thời gian dài rồi có cái tốt và xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030105,
					"content": "Tốt đó là làm lâu rồi sẽ có danh tiếng, danh tiếng đủ lớn ắt sẽ kiếm bộn tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030106,
					"content": "Xấu chính là ăn nhiều sẽ chán, nếu như quán to thì sẽ có nhiều lựa chọn, sẽ không ảnh hưởng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030107,
					"content": "Còn quán rượu của tôi không phải là quán lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030108,
					"content": "Khách hàng ăn thời gian dài sẽ thấy chán, người lui tới cũng ngày càng ít...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030109,
					"content": "Tôi nghe nói, ngành rượu Thành Mondstadt vô cùng phát triển. Họ sử dụng bồ công anh chế ra loại rượu bồ công anh nổi tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030110,
					"content": "Tuy không biết được là bồ công anh có ủ được thành rượu hay không, nhưng tôi cũng có thể thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030111,
					"content": "Bạn có thể đến Mondstadt mang bồ công anh về cho tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030112,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "Vậy nhờ vào bạn rồi, tôi sẽ trả công cho bạn. Người Liyue chúng tôi nói là làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030114,
					"content": "Rượu bồ công anh sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "Sao thế? Là vị rượu rất khác sao? Tôi nghe nói, loại rượu này rất được yêu thích ở Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030116,
					"content": "Có điều, chỉ sao chép cách nấu rượu bồ công anh chắc chắn không bán được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030117,
					"content": "Bạn trước hết cứ mang <color=#00E1FFFF>bồ công anh</color> về đây, tôi sẽ xem xét dùng cách nấu rượu của Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		},
