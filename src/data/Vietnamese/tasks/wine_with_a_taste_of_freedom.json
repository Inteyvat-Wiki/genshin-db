				{
					"id": 223030301,
					"content": "Tôi cứ thử trước đã xem có thể dùng cách nấu rượu của Liyue pha chế bồ công anh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Ồ, đây là cho bạn đó, nhận đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "Lấy bồ công anh nấu rượu chắc chắn sẽ thất bại nhiều lần, bồ công anh dùng hết rồi thì lại nhờ bạn giúp vậy, mong bạn giúp đỡ nhiều nhiều.",
					"roleType": "TALK_ROLE_NPC",
