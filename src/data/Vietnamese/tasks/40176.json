			"dialogs": [
				{
					"id": 401730501,
					"content": "#{NICKNAME}, có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730502,
					"content": "Lát nữa tôi sẽ đến gặp thủ lĩnh để trả lại thanh kiếm nghi lễ, còn những thứ khác trong doanh trại thì tạm thời để lại đây. Nếu có hứng thú thì cứ sử dụng thoải mái nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730503,
					"content": "Tôi có cuốn \"Chiến Ký Huyền Ảo\" tập mới nhất đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730505,
					"content": "Còn có cuốn \"Sổ Ghi Chép Của Tiểu Thư Orith\" ngoại truyện nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "Haaaaaả!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730507,
					"content": "Có muốn xem chung không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730509,
					"content": "#(Sao lại thế này chứ? Chuyện gì đây? Sao {F#cô ấy}{M#cậu ấy} biết mình thích những thứ này? Chẳng lẽ {F#cô ấy}{M#cậu ấy} cũng quan tâm đến mình à?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730510,
					"content": "(Không, sao mình lại có những suy nghĩ phi thực tế thế này chứ... Chắc chắn là tên nhóc Ororon đó đã bán đứng mình rồi. Tức thật...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730511,
					"content": "#(Nhưng mà... {F#Cô ấy}{M#Cậu ấy} nhớ sở thích của mình sao? Chậc? Thật ra thì không nhớ cũng chẳng sao cả, cũng chẳng phải chuyện gì to tát lắm...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730512,
					"content": "#(Nhưng mà... {F#Cô ấy}{M#Cậu ấy} đang mời mình mà! Làm thế nào, làm thế nào đây! Phải trả lời thế nào đây??)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730513,
					"content": "Khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730514,
					"content": "Được thôi. Đợi tôi xong việc đã nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
