			"dialogs": [
				{
					"id": 220270401,
					"content": "Cúng tế \"Dango Ba Màu\" đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Vậy sao...Cũng may em có mang theo \"Dango Ba Màu\", cái này là của mẹ em cho, em còn chưa nỡ ăn nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270403,
					"content": "Vậy em cúng tế cho thần đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270601,
					"content": "Hy vọng thần sẽ phù hộ cho ước nguyện của em thành hiện thực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270602,
					"content": "#Cảm ơn {F#chị}{M#anh} đã giúp đỡ em, vật này xem như em tặng {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270603,
					"content": "Để ngày mai em xem thử xem thần có đáp ứng nguyện vọng của em không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
