					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "Đồ sơn mài...không biết phải làm thế nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270102,
					"content": "Em làm đồ sơn mài để làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "#Là {F#chị}{M#anh} sao? Là vầy, {F#chị}{M#anh} đã nghe qua sự linh thiêng của Miếu Thờ chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270104,
					"content": "Em nghe nói nếu như hiến tế vật quý giá cho Miếu Thờ thì sẽ có thể đạt được ước nguyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270105,
					"content": "Em nghĩ, đồ sơn mài quý giá như vậy, nếu dâng cho Miếu Thờ thì nhất định sẽ nhận được hồi đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270106,
					"content": "Nhưng em không có tiền để mua, vì vậy nên em muốn tự mình làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270107,
					"content": "Nghe nói chị Nanatsuki làm đồ sơn mài rất giỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270108,
					"content": "#{F#Chị}{M#Anh} có thể dẫn em đi hỏi chị Nanatsuki về chuyện đồ sơn mài không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270109,
					"content": "Không thành vấn đề, chúng ta đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#Cảm ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270111,
					"content": "Sao em không tự mình đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "Chị Nanatsuki thường ngày...nghiêm túc lắm, em không dám hỏi chị ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270113,
					"content": "#Có {F#chị}{M#anh} ở bên thì chắc sẽ dễ nói chuyện hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
