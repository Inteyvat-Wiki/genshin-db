			"dialogs": [
				{
					"id": 220270301,
					"content": "Haiz, tuy là chị Nanatsuki nói vậy, nhưng em vẫn chưa biết được nên cúng tế cái gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "Nói về thứ em thích, thì nhất định là \"Dango Ba Màu\" rồi, món đó là món em thích nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "Nhưng mà dùng \"Dango Ba Màu\" để làm vật cúng tế thì có vẻ không nghiêm túc cho lắm đúng không? Hơn nữa lần trước em dùng Kenpeito để cúng tế cũng không được thần đáp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "Em còn nghe nói, có vài người dùng hoa tươi để làm Bánh Bao Thơm, dùng món này để cúng tế có lẽ sẽ nghiêm túc hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "#Phải làm sao đây? {F#Chị}{M#Anh} cảm thấy em nên cúng tế cái gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
