			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Chào em, tìm chị có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270202,
					"content": "Cái, cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270203,
					"content": "Về chuyện đồ sơn mài...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "...Muốn dâng đồ sơn mài cho Miếu Thờ, cho nên bản thân muốn làm một cái sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270205,
					"content": "Năn nỉ chị Nanatsuki đó, em có một nguyện vọng rất muốn thành hiện thực! Em sẽ không nói công thức của chị cho ai nghe cả đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270206,
					"content": "Cái này không liên quan đến công thức. Muốn làm ra một món đồ sơn mài tinh xảo thì cần phải có tay nghề lâu năm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270207,
					"content": "Cái này không những là vấn đề thời gian, còn là vấn đề...về tiền bạc nữa. Nghề gia truyền này truyền đến đời của chị đã là đời thứ tư rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270208,
					"content": "Vì để nghiên cứu đồ sơn mài, chị thậm chí còn đi đến Sumeru để học hỏi. Cho nên, em muốn học nhanh trong phút chốc...thì không thể được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270209,
					"content": "Là...là vậy sao? Em cũng không nghĩ được phải cúng tế thứ gì khác cho Miếu Thờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270210,
					"content": "Chị cảm thấy việc cúng tế cho Miếu Thờ, cái quan trọng không phải là giá trị của hiện vật, mà quan trọng nhất là \"tâm ý\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270211,
					"content": "Chỉ cần có thành ý và dâng lên thứ quan trọng nhất của mình thì hẳn sẽ được thần đáp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270212,
					"content": "Thành ý...thứ mà em thích nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270213,
					"content": "Em hình như hiểu...cũng hình như chưa hiểu. Nhưng dù sao thì cũng cảm ơn chị Nanatsuki nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270214,
					"content": "#{F#Chị}{M#Anh} ơi, chúng ta quay về chỗ Miếu Thờ trước nhé, để em suy nghĩ xem nên cúng tế cái gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
