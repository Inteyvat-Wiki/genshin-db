			"dialogs": [
				{
					"id": 710750101,
					"content": "Ha, đây rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750102,
					"content": "Tên Erge gì đó tìm cả nửa ngày rồi không thấy, ngươi quen thuộc địa hình như vậy chắc là tìm thấy rồi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750103,
					"content": "Hứ! Chỉ cần đợi ngươi tìm ra, sau đó ép ngươi giao hàng ra là xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750104,
					"content": "Tên giang hồ của ta là \"Tiểu Khinh Sách\", chút chuyện nhỏ này cũng làm không xong thì sau này còn mặt mũi nào hành tẩu giang hồ chứ, mau giao hàng ra đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750105,
					"content": "Kho báu của Thiên Nham Quân chỉ có thể thuộc về Đạo Bảo Đoàn bọn ta thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750106,
					"content": "Dù cho ngươi muốn gì đi nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "Ngươi nói không có là không có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750109,
					"content": "...Hừ, ta còn nghĩ ngươi chạy lên chạy xuống mỗi ngày như vậy thì cơ thể sẽ rắn chắc hơn chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750110,
					"content": "Chọn đi, một là bị ta đánh đến hao gầy, hai là hai tay dâng \"Nón Phù Hộ\" cho ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750111,
					"content": "Ta cảm thấy ngươi không muốn đánh với ta đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "Chà, khẩu khí lớn đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750113,
					"content": "Rượu mời không uống đi uống rượu phạt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
