			"trigger": {
				"objectNames": [
					"Huixin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "Woa, là các bạn sao, cám ơn các bạn đã đóng góp vật tư cho Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020202,
					"content": "Phải nói là, ngày hôm nay ngoài việc \"quyên tặng\"...Thì, nói đến \"thu mua\", các bạn có hứng thú không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020203,
					"content": "Í? Lần này chẳng phải không có tiền công sao? Vậy tôi rất hứng thú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020204,
					"content": "Haha, vậy nhờ các bạn rồi, sự việc là như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020205,
					"content": "Chúng tôi vì đốc thúc việc ngày tết, cần hai loại \"Phù Sinh Thạch\" đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020206,
					"content": "Một loại là \"Lam Sinh Thạch\", thi thoảng được tìm thấy ở phía bắc Thiên Hoành Sơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020207,
					"content": "Phía dưới gốc rễ của các lùm cây, Lam Sinh Thạch được chôn sâu trong lòng đất, thi thoảng sẽ biến thành \"Quả Bồng Bồng\", khiến hạt của chúng bay lơ lửng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020208,
					"content": "Một loại khác gọi là \"Hà Sinh Thạch\", khá nguy hiểm với người thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020209,
					"content": "Ở Quy Li Nguyên, \"Thợ Săn Di Tích\" cổ xưa sau khi mất đi khả năng bay lượn, sẽ dựa vào \"Hà Sinh Thạch\" để giúp bản thân có thể di chuyển trên không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020210,
					"content": "Hiểu rồi! Là \"Lam Sinh Thạch\" và \"Hà Sinh Thạch\" phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020211,
					"content": "(Thật ra chỉ là Phù Sinh Thạch màu đỏ với màu xanh thôi mà... Tên mỹ miều như vậy cũng chỉ là do đám thương nhân buôn bán bảo thạch nghĩ ra...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020212,
					"content": "Uhm đúng vậy, nhờ bạn tìm chúng đem về đây. Cố gắng lên nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixin"
				}
			]
		},
