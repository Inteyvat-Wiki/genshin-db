			"dialogs": [
				{
					"id": 400021001,
					"content": "Ngày cuối cùng Tết Hải Đăng sẽ có nhiều người đến xem thả \"Đèn Minh Tiêu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021002,
					"content": "Nơi nguy hiểm lại xuất hiện kẻ khả nghi như vậy, tôi nghĩ sẽ có chuyện chẳng lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021003,
					"content": "Nếu như hắn có ý đồ gì với đám nguyên liệu dễ cháy này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021401,
					"content": "Xem ra phải nhờ đến sự giúp đỡ của chính quyền rồi! Mau đến Tổng Vụ ở Liyue báo cáo tình hình đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021406,
					"content": "Sao tự nhiên Paimon lại quan tâm đến chuyện này vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "Là, là bởi vì... là thành quả chung của mọi người Liyue mà! Không thể tha thứ cho bất kỳ hành vi làm loạn nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021408,
					"content": "Nói thật xem nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "Món \"Vụn Trung Nguyên\" gần bến cảng quả thực ngon quá đi, ăn một lần mà nhớ mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021410,
					"content": "Bạn đang nhắc lại lời rao bán của ông chủ quán đó sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "Í hí hí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
