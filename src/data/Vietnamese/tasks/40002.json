			"dialogs": [
				{
					"id": 400021501,
					"content": "Mau dừng bước, trước mặt là tổng vụ Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021502,
					"content": "Chúng tôi đến báo cáo hành tung của kẻ lạ mặt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "Chúng tôi nhìn thấy kẻ khả nghi xuất hiện gần kho nguyên liệu dễ cháy của Đèn Minh Tiêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021504,
					"content": "Tuyệt đối không thể đánh mất món \"Vụn Trung Nguyên\" được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021505,
					"content": "Hả, đây là chuyện lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021506,
					"content": "Đúng vậy, đúng vậy. Món ngon của Liyue là tinh túy của thành phố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "Paimon"
				},
