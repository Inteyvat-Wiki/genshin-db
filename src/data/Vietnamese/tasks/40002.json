			"dialogs": [
				{
					"id": 400020501,
					"content": "Á, Đây là ... \"Lam Sinh Thạch\" và \"Hà Sinh Thạch\", chất lượng cũng không tệ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020502,
					"content": "Rất cảm ơn các bạn! Đây là thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020503,
					"content": "Mỗi một cố gắng của các bạn, đều giúp cho Tết Hải Đăng thêm phần rực rỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020504,
					"content": "Đúng rồi, đến Liyue du lịch đúng vào mùa Tết Hải Đăng, vậy thì chi bằng theo dõi sự thay đổi của Đèn Minh Tiêu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020505,
					"content": "Theo tiến độ, kiến trúc tại bến cảng sẽ rất xứng đáng đến chơi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020506,
					"content": "#Nghe cũng không tệ, {NICKNAME} chúng mình qua đó xem đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
