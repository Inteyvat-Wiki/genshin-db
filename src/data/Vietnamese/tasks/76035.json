			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "(Columbina... không ở đây sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "Đang tìm tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350103,
					"content": "Waaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350104,
					"content": "Làm tôi hết hồn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "#Tôi cảm nhận được là {F#cô}{M#cậu} đến, nên muốn thử xem có thể tiếp cận {F#cô}{M#cậu} từ sau lưng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350107,
					"content": "Trông cô có vẻ rảnh rỗi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350108,
					"content": "Vậy sao? Vẫn như lúc trước, hồi còn ở Fatui tôi cũng không có việc gì đặc biệt để làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350109,
					"content": "Nữ Hoàng chỉ cần sức mạnh của Nguyệt Thần, cũng không cử tôi đi cướp Gnosis gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350110,
					"content": "Vậy thường ngày cô làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Đi dạo, ngắm trăng, thỉnh thoảng ca hát. Nhưng về sau Sandrone không cho tôi hát nữa, nên tôi ít hát hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350112,
					"content": "Hmm? Cô ấy không thích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350113,
					"content": "Không phải. Cô ấy nói tôi hát rất hay, nhưng lúc đó tôi gia nhập Fatui chưa lâu, cô ấy nói những người khác khi nghe thấy tôi hát thỉnh thoảng sẽ hơi căng thẳng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350114,
					"content": "Còn nói gì mà... Từ góc độ của người khác, tôi giống như đang... sử dụng năng lực gì đó vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350115,
					"content": "Ra là vậy... Tôi hiểu được đại khái rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350116,
					"content": "À, còn một lý do khác. Cô ấy nói buổi tối cơ bản đều dành cho nghiên cứu, nên nếu buổi sáng tôi hát thì đúng vào thời gian cô ấy ngủ bù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350117,
					"content": "(Đây là lý do chính đúng không!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Nên là về sau tôi chỉ đến trước cửa chỗ Sandrone để hát vào ban đêm. Nhưng vẫn bị đuổi đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350120,
					"content": "Mối quan hệ giữa cô với mọi người có tốt không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "Hmm... Lúc mới quen, Arlecchino hình như rất muốn \"giao tiếp\" với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350122,
					"content": "Cô ấy luôn âm thầm xuất hiện sau lưng tôi, giống như lúc nãy vậy. Nói là muốn... \"thăm dò\" một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350123,
					"content": "Tôi cũng thử chơi trò đó với cô ấy, nhưng Arlecchino luôn quay đầu lại khi tôi còn chưa kịp lại gần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350124,
					"content": "Cho đến một lần tôi buộc phải dùng Kuuvahki, thì mới có thể đến sau lưng và hù cô ấy một cái. Nhưng sau đó thì Arlecchino không còn chơi trò này với tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350125,
					"content": "(Có lẽ ngay từ đầu Arlecchino đã không nghĩ đây là \"trò chơi\"...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350126,
					"content": "Dottore cũng thường bảo tôi phối hợp với anh ta đi nghiên cứu Lãnh Địa Ánh Sáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350127,
					"content": "Tôi cũng đi vài lần, nhưng cũng chỉ toàn là dùng Kuuvahki đánh cái này, điều khiển cái kia. Rất nhàm chán, nên sau đó tôi không đi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350128,
					"content": "Xem ra tâm trạng hôm nay của cô khá tốt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Ừm. Tuy là \"bỏ nhà ra đi\", nhưng trong quá khứ cũng có những hồi ức vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350131,
					"content": "Arlecchino và Sandrone đều rất tốt với tôi, còn có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350133,
					"content": "(Biểu cảm của cô ấy... hình như đang nhớ đến ai đó...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Đưa tay đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350135,
					"content": "...Hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Tôi nhớ Rosalyne từng dạy tôi... phải biết cảm ơn người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350138,
					"content": "#Cảm ơn {F#cô}{M#cậu} hôm nay đã nghe tôi kể những chuyện này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350139,
					"content": "Không có gì đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Đây là... chúc phúc của Nguyệt Thần?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "Hôm nay nói đến đây thôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760350142,
					"content": "Kết thúc đột ngột thật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350143,
					"content": "Suỵt... Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "#Thôi được, {NICKNAME} nói đúng. Vậy hôm nay không làm phiền cô ấy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350144,
					"content": "Có lẽ cô ấy đã nhớ lại vài chuyện xưa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "...Tại sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Cô trò chuyện rất nhiều về những chuyện trước đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "Sao lại xuất hiện từ phía sau thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}