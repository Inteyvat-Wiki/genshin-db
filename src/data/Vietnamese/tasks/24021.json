				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "Ái, đau... Chiếc rương này sao nặng thế nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "Cô không sao chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "Nhà Nghiên Cứu Danh Dự Cấp Cao, lại gặp nhau rồi. Thật ngại quá... tôi... hình như tôi trật khớp lưng rồi, đau quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "Lúc trước tôi định chuyển một chiếc rương tới đây, sau đó sắp xếp lại tài liệu bên trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "Tôi... tôi không ngờ là nó nặng như vậy. Khi nhấc nó lên tôi đứng không vững, nên toàn bộ lực đã dồn hết vào phần hông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "Bây giờ thì... tôi thấy đau hông quá, ây da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "Cần tôi cõng đến bệnh viện không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "Không, không cần đâu... Trước đó tôi cũng bị như vậy rồi, chỉ cần nghỉ ngơi chút là đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "Rốt cuộc đã chứa bao nhiêu hồ sơ mới nặng như vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "Chắc là... rất nhiều tài liệu. Trước đó trong viện từng phổ biến \"lưu dấu làm việc\" một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "Nói đơn giản, tất cả công việc nghiên cứu của viện đều phải được lưu trữ chứng nhận giải quyết bản giấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "Sau khi quy định này được phổ biến, lượng tiêu thụ giấy của viện lập tức tăng lên gấp năm lần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "Vì tài liệu quá nhiều, mỗi văn phòng thậm chí còn phải tức tốc thành lập vị trí nhân sự \"sắp xếp tài liệu\", dành riêng cho việc phân loại giấy tờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "Vậy có nghĩa là tất cả mọi việc đều phải được ghi chép lên giấy à? Nghe thật phiền phức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "Đúng vậy. Về sau thì phương pháp này dần ít được chú ý, chỉ còn một bộ phận nhỏ thực hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "Tạm gác chuyện này lại đã... Nhà Nghiên Cứu Danh Dự Cấp Cao có thể giúp tôi xử lý rương tài liệu không? Mặc dù đau hông, nhưng tôi vẫn phải sắp xếp chỗ tài liệu trong đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "Được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "Cô nghỉ ngơi cho khỏe đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "Không sao, sắp xếp giấy tờ chỉ cần tay thôi. Hãy yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "Tôi có thể gọi người tới giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
