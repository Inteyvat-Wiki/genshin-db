			"dialogs": [
				{
					"id": 240210501,
					"content": "Tốt quá, chính là rương tài liệu này, bạn vừa giúp tôi một việc lớn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210502
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210502,
					"content": "Xin hãy nhận lấy những thứ này. Đợi tôi... Ây da! Đợi tôi đỡ hơn sẽ... sẽ tiếp tục làm việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210503
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210503,
					"content": "Haiz, khi nào viện mới cử người đến hỗ trợ tôi đây...",
