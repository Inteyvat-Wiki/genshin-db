			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "Bé Yumkasaur đáng thương... Đám độc ác đó! Nhất định phải cho chúng một bài học mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260102,
					"content": "Đám độc ác kia có thể trốn chạy, nhưng sẽ không có nơi nào ẩn náu đâu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260103,
					"content": "Đã xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "#{F#Cô}{M#Cậu} là... nhà lữ hành từ nơi khác đến sao? Xin chào nhé, nhưng xin lỗi, lúc này tôi không tiếp đón được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260105,
					"content": "Đám Đạo Bảo Đoàn độc ác kia lại muốn bắt bé Yumkasaur đó đi. May mà tôi đến kịp lúc để đánh đuổi bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260106,
					"content": "Bé Yumkasaur đó hẳn là sợ lắm, tôi có gọi thế nào cũng không chịu đến gần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260107,
					"content": "Nhưng tôi đã tìm ra chỗ của đám Đạo Bảo Đoàn ấy rồi. Lát nữa tôi sẽ đi giáo huấn chúng và trói lên cây, lấy dây leo quất cho chúng một trận tơi bời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260108,
					"content": "Hơn nữa, còn phải tìm chút đồ ăn ngon để an ủi bé Yumkasaur đó mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
