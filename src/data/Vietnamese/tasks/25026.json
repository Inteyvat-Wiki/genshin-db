				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "Nhóc ấy thường nghỉ ngơi ở đây. Nhưng sao hôm nay không thấy dấu vết gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260302,
					"content": "Chắc là sợ quá nên cố tình trốn đi mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260303,
					"content": "Chúng ta có nên đi tìm nó không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "...Không cần đâu. Để nhóc ấy yên tĩnh một lúc vậy. Chúng ta cứ để Nấm Dù Nến ở đây là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260305,
					"content": "Anh cũng thành thạo đó chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "Tôi đã chăm sóc nó được một thời gian rồi. Tính cách của nó rất nhạy cảm, kể cả khi gặp người lạ cũng sẽ giật mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260307,
					"content": "Tôi cho nó ăn rất lâu rồi nó mới chịu lại gần tôi đấy... Haiz, thế mà đám độc ác kia dám làm loạn, chắc chắn là nó lại không chịu ra ngoài nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260308,
					"content": "Đành để cho nó tự bình tĩnh lại vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260309,
					"content": "#Cảm ơn {F#cô}{M#cậu} đã đi cùng tôi. Đây là thù lao, hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260310,
					"content": "Không gặp được nó thì tôi cũng hơi tiếc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "Yên tâm, nó sẽ nhớ mặt những người tốt với nó thôi. Chờ lúc thích hợp thì nó nhất định sẽ tới gặp chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260311,
					"content": "Tôi vẫn muốn gặp nhóc Yumkasaur đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
