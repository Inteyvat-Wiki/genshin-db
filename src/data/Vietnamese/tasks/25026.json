					"nextDialogs": [
						250261617
					]
				},
				{
					"id": 250261617,
					"content": "#Đúng rồi, số thù lao này cho {F#cô}{M#cậu}, coi như là quà cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250261618
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250261618,
					"content": "Mong là nhóc ấy sẽ mau chóng lớn lên. Như vậy... Nó sẽ có thể đích thân giáo huấn đám Đạo Bảo Đoàn đó rồi, haha!",
					"roleType": "TALK_ROLE_NPC",
