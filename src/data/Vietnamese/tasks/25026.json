			"dialogs": [
				{
					"id": 250260401,
					"content": "Chúng ta cùng đi giáo huấn đám Đạo Bảo Đoàn đó đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "#{F#Cô}{M#Cậu} sẵn lòng đi cùng tôi sao? Vậy thì tốt quá, nhìn {F#cô}{M#cậu} thế này... Chắc hẳn cũng là nhà mạo hiểm dày dặn kinh nghiệm rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260403,
					"content": "Tôi sẽ chuẩn bị thù lao theo quy tắc của nhà mạo hiểm. Vậy xuất phát ngay thôi, dạy cho đám xấu xa đó một bài học nào.",
