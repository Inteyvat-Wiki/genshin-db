			"dialogs": [
				{
					"id": 250260501,
					"content": "Hừ, để xem chúng còn dám tùy tiện bắt nạt bé Yumkasaur nữa không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260502,
					"content": "Tôi cứ cảm thấy là có sự hiểu lầm gì đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "Đừng nghe chúng khua môi múa mép. Chính mắt tôi nhìn thấy chúng định buộc dây vào đuôi Yumkasaur mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260504,
					"content": "Nếu tôi mà không tới kịp thì không biết sẽ xảy ra chuyện gì nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Tlamot"
				},
