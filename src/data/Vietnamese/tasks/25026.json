				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "Vẫn nên đi an ủi nhóc Yumkasaur đó trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "Hmm... Nói cũng phải, nhóc ấy chắc bị dọa cho sợ rồi. Vẫn nên đi an ủi nó trước thì hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260203,
					"content": "#Vậy cứ đi theo tôi, trông {F#cô}{M#cậu} có vẻ là một nhà mạo hiểm giàu kinh nghiệm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260204,
					"content": "Hai chúng ta cùng qua đó thôi, mấy kẻ có ác ý đó chắc chắn sẽ không dám quay lại nữa đâu. Đừng lo lắng về thù lao, tôi sẽ chuẩn bị nó theo quy tắc của nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260206,
					"content": "#Tôi nghĩ xem nào, nhóc ấy rất thích ăn Nấm Dù Nến tươi... Tôi nhớ là dưới gốc cây bên đó mọc rất nhiều, {F#cô}{M#cậu} hãy hái một ít trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260205,
					"content": "#Tôi sẽ sang bên kia để hái Nấm Dù Nến. Chờ {F#cô}{M#cậu} hái xong rồi chúng ta sẽ gặp nhau ở vách núi phía bên kia đấu trường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260207,
					"content": "Nhóc ấy thường nghỉ ngơi ở đó. Chúng ta có thể đến đó tìm nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
