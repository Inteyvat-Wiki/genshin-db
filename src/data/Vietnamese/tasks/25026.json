					"nextDialogs": [
						250261608
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250261608,
					"content": "Dù sao thì chỉ cần nó sống vui vẻ là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250261614
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250261614,
					"content": "Này, bọn ta đi nhé!",
