				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "...Các hạ có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "Xin lỗi, chú là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "Tôi là Kamei Munehisa, chỉ là một người đi ngang qua mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "Ồ...cách ăn mặc của ông chú này cảm giác giống hệt như samurai vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000205,
					"content": "Sa...samurai sao? Lẽ nào là samurai kia của Shogunate...Tôi nghe nói, thái độ của Shogunate đối với người ngoại quốc rất...tế nhị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "Đừng lo. Tôi đã rời khỏi Shogunate, không còn là samurai nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "Tôi thường đến đây tìm thứ có thể ăn được, nhưng hôm nay lúc đến lại phát hiện có ma vật lượn lờ ở gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "Hơn nữa nguyên liệu xung quanh hình như cũng bị chúng vơ vét sạch rồi, tôi đánh phải đánh bại toàn bộ bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "Chú thường xuyên tới đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "Nơi này bình thường chẳng có ma vật mấy, tôi thường xuyên đến đây hái một ít hoa quả, hoặc săn một số động vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "Nói đến đây thôi nhỉ, sau khi tôi đánh bại những ma vật này, ma vật xung quanh chắc cũng tạm thời không dám bén mảng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "Nếu các hạ cũng đến tìm thực phẩm thì có thể đi xung quanh tìm thử, tôi chỉ lấy phần của một mình tôi thôi, chắc vẫn còn không ít nguyên liệu sót lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "Vậy thì, tại hạ xin cáo từ trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "Cứ...cứ vậy là đi rồi. Cảm giác tác phong của ông chú này cũng giống hệt với samurai mà tôi nghe nói trước kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000221,
					"content": "Nhưng chú ấy nói mình đã rời khỏi Shogunate là có ý gì? Hơn nữa samurai rời khỏi Shogunate, chẳng phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000222,
					"content": "Giống với kẻ địch từng chạm trán trước kia à.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Đúng, trước kia tôi cũng nghe nói, có một số samurai rời khỏi Shogunate lang bạt tứ phương, vì kiếm kế sinh nhai nên đã đi cướp bóc khắp nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000225,
					"content": "Mặc dù ông chú đó trông không giống những kẻ độc ác kia, nhưng chúng ta vẫn nên đề cao cảnh giác thì tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000226,
					"content": "Được rồi được rồi. Chúng ta tới đây không phải để tìm nguyên liệu sao? Nhưng xem thử tình hình xung quanh, hay là chúng ta đừng tiếp tục đi sâu thêm nữa, tránh gặp phải điều gì nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000227,
					"content": "Nhà Lữ Hành này đã hộ tống chúng ta lâu như vậy, chắc cũng mệt rồi, chúng ta hãy nấu ít đồ ăn ở đây và nghỉ ngơi một lát, sau đó quay về thành đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000228,
					"content": "Ông chú đó nói, xung quanh còn có nguyên liệu sót lại nhỉ? Chúng ta đi tìm thử xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000223,
					"content": "Giống như Kairagi vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "Những ma vật này đều do chú đánh bại?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Đúng vậy, đều chỉ là một số ma vật bình thường mà thôi, rất dễ đối phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "Tại sao chú lại tìm thực phẩm ở nơi hoang dã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "Tôi có nguyên nhân của riêng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
