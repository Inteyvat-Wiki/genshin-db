				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "Vốn dĩ muốn tìm chút nguyên liệu tươi...Thôi bỏ đi, bấy nhiêu chắc cũng dùng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000302,
					"content": "Xin lỗi, vốn dĩ muốn nấu ít món ngon cho bạn, bây giờ xem ra chỉ có thể nhặt nhạnh để nấu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000303,
					"content": "Không sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "Bạn hộ tống chúng tôi vất vả như vậy, không thể một câu \"không sao\" mà bỏ qua được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000305,
					"content": "Bữa cơm này tôi đã ghi nhớ rồi, lần sau nhất định sẽ mời bạn một bữa no nê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000308,
					"content": "Julie, canh hầm xong rồi nhỉ? Nhớ đừng để Parvaneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000309,
					"content": "Ơ ưm, không, không cần nữa, chỉ cần để canh yên ổn hầm ở đó là được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000310,
					"content": "Không sao, tôi đang nêm món canh này theo công thức cải tiến của mình, chỉ cần một chút gia vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000311,
					"content": "Tôi thậm chí còn không hiểu công thức cô đã cải tiến, mau dừng lại! Xudong, Xudong nhanh tới đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000312,
					"content": "Parvaneh! Này! Cô lại bỏ gia vị kỳ quái gì vào trong đó thế!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000313,
					"content": "Gia vị kỳ quái? Đó là gia vị đặc biệt do tôi điều chế! Đây là thành quả nghiên cứu mà tôi trình bày bằng luận văn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000314,
					"content": "Khỏi đi! Hôm nay chúng ta ăn món bình thường là được rồi! Julie, giữ lấy cô ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000315,
					"content": "Hừ, đúng là không biết xem hàng tốt mà...Bỏ đi, chờ tôi hoàn thiện thêm vậy, tôi nhất định sẽ làm ra gia vị vạn năng chỉ cần bỏ vào món ăn thì dù là món nào cũng đều trở nên ngon tuyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000316,
					"content": "Gia vị vạn năng...thật sự có thể tạo ra thứ này chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000317,
					"content": "Chính vì chưa ai tạo ra, tôi mới cần tạo ra. Sau đó, tôi sẽ có thể khiến đám đầu đất ở Viện Sắc Lệnh phải kinh ngạc một phen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
