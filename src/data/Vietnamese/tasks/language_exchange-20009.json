					"nextDialogs": [
						200090603
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200090603,
					"content": "Buka... mita nye, guru-guru... yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090604
					],
					"speakerTitle": "Ella Musk"
				},
				{
