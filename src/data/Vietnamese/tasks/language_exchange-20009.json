			"dialogs": [
				{
					"id": 200090201,
					"content": "Ở đây có tên Hilichurl đang tỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090202,
					"content": "Tên này vậy, chúng ta mau đi qua đó đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090203,
					"content": "Cẩn thận chút, khi đi qua đừng làm những tên Hilichurl khác tỉnh dậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090204,
					"content": "Nếu không bọn chúng sẽ hiểu lầm, cho rằng ta đến tấn công chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090205,
					"content": "Nếu như vậy, thì không thể nói chuyện đàng hoàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
