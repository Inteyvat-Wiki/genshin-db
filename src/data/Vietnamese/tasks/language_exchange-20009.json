			"dialogs": [
				{
					"id": 200090101,
					"content": "Nhà Lữ Hành, bên này, mau qua đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090102,
					"content": "#Đừng kinh động đám Hilichurl đó, sao {F#chị}{M#anh} cứ xông thẳng vào doanh trại thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090103,
					"content": "Được rồi, không để ý chuyện này nữa, em thường nghiên cứu ngôn ngữ Hilichurl, nhưng so với ghi chép thì em thích nghiên cứu khẩu ngữ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090104,
					"content": "Khó khăn lắm mới gặp được một doanh trại Hilichurl hoàn chỉnh, không thể bỏ qua cơ hội này được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090105,
					"content": "Cho nên, Nhà Lữ Hành, có thể đi cùng em vào trong, tìm một tên Hilichurl để luyện khẩu ngữ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
