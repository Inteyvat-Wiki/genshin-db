					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200090607,
					"content": "Hì hì, xem động tác của tên Hilichurl này, hình như đang rất vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090608
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090608,
					"content": "Xem ra lần giao lưu này thành công rồi, khẩu ngữ tiếng Hilichurl của mình quả nhiên rất tốt.",
					"roleType": "TALK_ROLE_NPC",
