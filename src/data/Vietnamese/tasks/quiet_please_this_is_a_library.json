				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "Thật là câu chuyện cảm động, tiếc là cuối cùng không có được kết cục tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "Thanh niên đang yêu"
				},
				{
					"id": 700070202,
					"content": "Chúng ta sau này sẽ không thành ra như vậy chứ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "Thiếu nữ đang yêu"
				},
				{
					"id": 700070203,
					"content": "Đó là điều đương nhiên, cho dù chúng ta xa cách, anh cũng sẽ nghĩ cách đưa em trở về bên anh",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "Thanh niên đang yêu"
				},
				{
					"id": 700070204,
					"content": "Trong thư viện phải giữ im lặng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "Ấy? Em nên kìm giọng mình lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "Thiếu nữ đang yêu"
				},
				{
					"id": 700070207,
					"content": "Haiz, có lẽ đây cũng là trở ngại của tình yêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "Thanh niên đang yêu"
				},
				{
					"id": 700070208,
					"content": "Truyện xem xong, cũng nên đặt lại đúng chỗ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070209,
					"content": "Để lung tung như bây giờ thì chắc người phụ trách sắp xếp kệ sách sẽ rất đau đầu đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070210,
					"content": "Biết rồi, biết rồi, làm ơn đừng quấy rầy chúng tôi, đang lúc quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "Thanh niên đang yêu"
				},
				{
					"id": 700070211,
					"content": "Lúc quan trọng...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070212,
					"content": "Dù có bao nhiêu trở ngại, chúng ta cũng sẽ như bây giờ, không bao giờ thay đổi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "Thiếu nữ đang yêu"
				},
				{
					"id": 700070213,
					"content": "Phải, xin thề trước mạng sống của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "Thanh niên đang yêu"
				},
				{
					"id": 700070214,
					"content": "Không cần làm quá lên như vậy... cái gì mà mạng sống, em sẽ đau lòng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "Thiếu nữ đang yêu"
				},
				{
					"id": 700070215,
					"content": "A, thật dịu dàng, thích quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "Thanh niên đang yêu"
				},
				{
					"id": 700070216,
					"content": "Tôi cảm thấy, họ hoàn toàn không nghe đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070205,
					"content": "Có người nói mấy người ồn ào quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
