				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "\"Tâm trạng không ổn định sẽ ảnh hưởng đến sự chính xác trong nghiên cứu phân tích\", vẫn chưa có căn cứ chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "Người phụ nữ lý trí"
				},
				{
					"id": 700070402,
					"content": "Ồ, hiểu rồi, có thể hiện tại đã rơi vào một trở ngại kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "Người đàn ông lý trí"
				},
				{
					"id": 700070403,
					"content": "Mọi người đến thật đúng lúc, tôi có một khó khăn cần nghe ý kiến của người ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "Người đàn ông lý trí"
				},
				{
					"id": 700070404,
					"content": "Nếu tôi muốn chứng minh tính chính xác của lý luận của tôi, thì tôi phải bảo đảm tâm trạng mình không bị dao động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "Người đàn ông lý trí"
				},
				{
					"id": 700070405,
					"content": "Nhưng tôi luôn không làm được điều này, nhất là khi thảo luận với cô ấy, tôi luôn không thể bình tĩnh để suy nghĩ được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "Người đàn ông lý trí"
				},
				{
					"id": 700070406,
					"content": "Tôi cũng cảm thấy hơi lạ, lẽ nào là ngủ không đủ giấc sao? Hay là hôm qua uống quá nhiều rượu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "Người phụ nữ lý trí"
				},
				{
					"id": 700070407,
					"content": "Tóm lại, thư viện là nơi không được nói chuyện lớn tiếng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "Nói chung là nhỏ giọng lại trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "Xin lỗi, nhưng trước khi làm rõ chuyện này, tôi không cam lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "Người đàn ông lý trí"
				},
				{
					"id": 700070410,
					"content": "Nghe, nghe không hiểu gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070411,
					"content": "Ờ, tóm lại, không thể quấy rầy người khác, còn nữa, sách xem xong không được nhét lung tung vào kệ sách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070412,
					"content": "Được rồi...Bọn họ hình như không để ý đến chúng ta rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
