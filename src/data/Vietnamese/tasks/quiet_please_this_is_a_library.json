				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070102,
					"content": "Cảm giác tâm trạng không tốt lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "Ngại quá, vì gần đây thư viện quá ồn ào, nên em khó mà yên tĩnh nghiên cứu ngôn ngữ Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070105,
					"content": "Sau khi Lễ Hội Hoa Gió bắt đầu, có rất nhiều người đến đây hẹn hò. Lúc đầu họ có thể yên lặng đọc sách, sau đó sẽ trò chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070106,
					"content": "Hơn nữa... hơn nữa họ còn làm đủ thứ chuyện đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070107,
					"content": "Gấp góc sách lại... Nhét đủ thứ đồ kỳ lạ vào trang sách... Thậm chí, thậm chí họ còn nhét ngược sách vào kệ sách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070108,
					"content": "Thư viện không phải nơi để tỏ tình! Như vậy sẽ làm phiền những người đang ở đây đọc sách và nghiên cứu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070109,
					"content": "Wyratt chắc là đến để duy trì trật tự.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "Anh ấy cũng không làm gì được, đuổi người ta đi cũng chỉ trị ngọn mà không trị được gốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070113,
					"content": "#Tóm lại, phiền {F#chị}{M#anh} giúp đỡ nhé, để những người ở đây yên tĩnh chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070114,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "#Cám ơn {F#chị}{M#anh}, ồn ào nhất là ba cặp đằng kia, chỉ cần bảo họ đừng làm ảnh hưởng đến người xung quanh thì em sẽ có thể tiếp tục nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070117,
					"content": "Nhưng cẩn thận, họ không dễ chịu lắm đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070115,
					"content": "Để tôi thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "Có thể tìm Lisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "Nhưng em nghe nói, chị ấy hiện đang cùng đội trưởng đi tuần tra, tạm thời không có ở đây. Nếu có chị ấy ở đây thì những cặp tình nhân này sẽ bớt thể hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070103,
					"content": "Giọng nói dữ hơn bình thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
		{
