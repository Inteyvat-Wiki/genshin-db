			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "Hở? Cho hỏi có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "Cô gái rơi vào lưới tình"
				},
				{
					"id": 700070302,
					"content": "Trong thư viện phải giữ im lặng",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "Xin lỗi, tôi sẽ để ý, nhưng đôi khi không kiềm chế được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "Cô gái rơi vào lưới tình"
				},
				{
					"id": 700070305,
					"content": "Chẳng hạn như, khi em không chú ý đến, anh sẽ lấy ra một bông hoa hồng phía sau trang sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "Thanh niên ảo thuật"
				},
				{
					"id": 700070306,
					"content": "Hoa hồng được sinh ra từ trang sách, cũng giống như em, mang đầy vẻ dịu dàng và trí tuệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "Thanh niên ảo thuật"
				},
				{
					"id": 700070307,
					"content": "Woa?! Lợi hại quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "Cô gái rơi vào lưới tình"
				},
				{
					"id": 700070308,
					"content": "Giọng to quá! Còn nữa, không thể lấy sách làm ảo thuật được! Sẽ làm hư sách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070309,
					"content": "Giọng của Paimon cũng to lên kìa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "Ồi, xin lỗi, bất cẩn nên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070311,
					"content": "Cũng hiểu rồi sao? Đôi khi đây cũng là chuyện bất khả kháng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "Cô gái rơi vào lưới tình"
				},
				{
					"id": 700070312,
