				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "Hướng về những ngôi sao và vực sâu, chào mừng đến với Hiệp Hội Nhà Mạo Hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610102,
					"content": "Gần đây chúng tôi nhận được ủy thác của Hội Câu Cá, bọn họ nói hoạt động của các loài cá ở vực nước gần đó xuất hiện tình trạng bất thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610103,
					"content": "Nhưng cụ thể như thế nào thì không nói rõ, bạn có thể đi kiểm tra thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610104,
					"content": "Tôi nghĩ cho dù là chuyện gì đi nữa thì chỉ cần có bạn, chắc chắn sẽ có thể ứng phó dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610105,
					"content": "Hội Câu Cá? Là câu cá đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "Ơ? Câu cá đó? Tôi không hiểu lắm...câu cá mà bạn nói là câu cá như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610107,
					"content": "Ây da, hội câu cá hội câu cá, vừa nghe là biết đó chính là hội câu được nhiều cá ngon rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610108,
					"content": "Đừng phí thời gian nữa, chúng ta mau đi xem thử đi! Hihi, ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
