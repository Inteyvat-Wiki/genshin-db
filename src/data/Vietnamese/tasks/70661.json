			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "Dạo này đàn cá hoạt động sôi nổi ghê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610202,
					"content": "Có việc gì cần giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "A, cuối cùng cũng có người giúp đỡ rồi, xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610204,
					"content": "Tôi là Nantuck, người câu cá có thâm niên trong hội câu cá Mondstadt, khụ khụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610205,
					"content": "Vùng nước gần đây đột nhiên xuất hiện rất nhiều loài cá mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610206,
					"content": "Tôi đã liên hệ ngay với bạn bè của mình ở các khu vực khác, quả nhiên, tình trạng này đang xảy ra ở khắp mọi nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610207,
					"content": "Có người còn nói đây là thời kỳ bùng phát về giống loài cá ở Teyvat, trăm năm mới thấy một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610208,
					"content": "Thực ra vẫn chưa điều tra được nguyên nhân, nhưng tôi đoán ít nhiều gì cũng có liên quan đến việc thay đổi môi trường sinh thái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610209,
					"content": "Ồ! Chắc là bọn cá này nhiều quá nên đã gây rắc rối cho mọi người phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610210,
					"content": "Đừng lo, cứ giao chuyện này cho Paimon! Chỉ cần thịt của chúng không quá dở là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610211,
					"content": "Ha ha, cũng không rắc rối gì đâu, đối với hội câu cá, đương nhiên có càng nhiều cá càng tốt, nhưng vấn đề là không đủ nhân lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610212,
					"content": "Nhưng thực ra, với nhân lực hiện giờ của chúng tôi thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610213,
					"content": "Muốn câu hết tất cả giống cá mới trong thời gian ngắn để nghiên cứu...thực sự hơi áp lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610214,
					"content": "Nhưng nhìn lại thì đây không phải là cơ hội tuyệt vời để phát triển hội câu cá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610215,
					"content": "Vì vậy tôi đã treo ủy thác ở Hiệp Hội Nhà Mạo Hiểm. Thế nào? Có hứng thú nhập hội với chúng tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610216,
					"content": "Câu cá rất thú vị đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610217,
					"content": "Không thành vấn đề, sở trường của tôi chính là câu cá mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "Tốt, đúng là nhiệt huyết tuổi trẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610223,
					"content": "Vậy thì bây giờ, hãy theo tôi sang bờ bên kia của Hồ Rượu Trái Cây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610224,
					"content": "Ở đó có chỗ câu cá mà chúng tôi chuẩn bị sẵn cho người mới, tôi sẽ dạy bạn trước một số kỹ thuật cơ bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610219,
					"content": "Tôi có thể xuống bắt trực tiếp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "Nhảy thẳng xuống dưới thì nguy hiểm lắm! Nhà Mạo Hiểm như các bạn quả thật dũng cảm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610221,
					"content": "Tiếc là mấy con cá đó không dũng cảm như các bạn, thấy người nhảy xuống như vậy, chúng chắc chắn sẽ hoảng sợ chạy hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610222,
					"content": "Tốt nhất đừng nên làm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				}
			]
		},
