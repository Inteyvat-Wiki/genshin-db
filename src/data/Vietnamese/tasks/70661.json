		{
			"id": 7066104,
			"completionStepIds": [
				7066103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066103",
							"2"
						],
						"stepId": 7066103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "Chính là ở đây! Nhìn thấy mấy con cá dưới nước không? Thật là đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "Đây là công cụ đã chuẩn bị cho bạn, có cần câu, mồi câu, và cả công thức chế tạo mồi câu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "Đầu tiên là móc mồi câu vào lưỡi câu rồi nhắm vào nơi đàn cá đang tụ tập để thả câu! Sau đó kiên nhẫn chờ chúng mắc câu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "Nghe nói người mới ai cũng có hiệu ứng \"may mắn tân thủ\" trong truyền thuyết đấy, năm xưa tôi cũng câu được một con cá dài hơn nửa mét đó! Bạn cũng đến thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "Hi vọng câu được thêm một đứa Paimon nữa ha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "Thứ lăng nhăng, có một mình tôi rồi còn chưa đủ sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "Paimon? Cái tên nghe lạ quá, cũng là một loài cá sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "Là một loài \"hải sản phàm ăn thần kỳ\" tôi đã câu được trước đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "Ê này! Từ \"thực phẩm dự trữ\" biến thành \"hải sản thần kỳ\" rồi hả?",
