			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "Cảm ơn bạn, chỗ Hoa Ngọt này đủ rồi, lát nữa tôi sẽ làm hoa khô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270302,
					"content": "Đúng rồi, tôi có một món quà nhỏ tặng bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270303,
					"content": "Hì, hãy cầm lấy bông hoa khô này, tuy hơi khô...nhưng đây là một bông hoa rất quý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270304,
					"content": "Cám ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "Đây là bông hoa đầu tiên nở trong biển hoa này, bạn đã giúp tôi tìm hạt giống, vì vậy tôi muốn tặng bông hoa này cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270308,
					"content": "Tuy cũng không phải đồ có giá trị gì, nhưng thật sự...rất cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270309,
					"content": "Mọi người đều trở về rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "Ừm! Cho nên tôi phải trồng thêm hoa, như vậy khi mọi người trở về sẽ thấy được nhiều hoa hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270305,
					"content": "Có gì đặc biệt sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "Đương nhiên rồi, nếu không tôi sẽ không tặng nó cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "Hanayama Kaoru"
				}
