					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "Bạn đến rồi à, bạn có thấy xung quanh có rất nhiều hoa nở rồi không, thế nào, đẹp chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270102,
					"content": "Rất đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "Hihi...đương nhiên rồi. Tôi chăm sóc chúng rất cẩn thận đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270106,
					"content": "Đúng rồi, tôi có thể nhờ bạn giúp thêm một chuyện không? Bây giờ hoa đã nở rất đẹp rồi, tôi muốn hái một ít hoa làm hoa khô, gửi kèm theo thư cho những người chưa quay về Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270107,
					"content": "Nhưng mà...không biết có phải do ngủ ít quá không, lúc nãy vừa hai được mấy bông thì đã thấm mệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270108,
					"content": "Bạn có thể giúp tôi hái một ít Hoa Ngọt ở xung quanh không? Chỉ cần 3 bông thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270109,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "Vậy thì nhờ bạn nhé, tôi ở đây nghỉ ngơi một lát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270112,
					"content": "Tôi chỉ cần mùi thơm hấp dẫn của Hoa Ngọt, trong thư cũng sẽ kèm một số hoa khô khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270113,
					"content": "Tôi nghĩ, khi đọc thư mà có hương thơm của hoa vây quanh thì tâm trạng cũng sẽ thoải mái hơn chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270114,
					"content": "Vậy thì nhờ bạn nhé, tôi ở đây nghỉ ngơi một lát...Bạn hái hoa xong thì đưa cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270111,
					"content": "Hình như ở đâu cũng có Hoa Ngọt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "Bạn trồng mất bao lâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "Cũng không lâu lắm, chỉ là...chỉ là ngủ ít hơn một chút thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
