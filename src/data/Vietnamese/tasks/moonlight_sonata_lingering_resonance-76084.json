					"nextDialogs": [
						760840102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760840102,
					"content": "Tôi cũng đang muốn nghe vài giai điệu khác lạ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760840103,
					"content": "(Hmm, đàn gì được nhỉ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
