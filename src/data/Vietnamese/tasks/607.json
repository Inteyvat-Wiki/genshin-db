			"dialogs": [
				{
					"id": 6070201,
					"content": "Các ngươi không cần phải hoảng loạn, ma vật đã bị tiêu diệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070202,
					"content": "Ý của tiểu thư là, đừng tùy tiện ra ngoài, cứ ở trong nhà là được. Chúng tôi sẽ cố gắng hết sức để đảm bảo an toàn cho người dân ở khu vực này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070203,
					"content": "Cảm ơn rất nhiều! Cảm ơn rất nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070204,
					"content": "Nhưng mà, con... con chim lớn này biết nói chuyện sao? Có hơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070205,
					"content": "Ồ, không cần lo lắng, tôi chỉ là người hầu của tiểu thư thôi, không phải ma vật hoang dã, càng không gây ra bất kỳ mối đe dọa nào cho các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070206,
					"content": "Hai vị này đều là người tốt, cứ yên tâm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "À, đương nhiên rồi, ý tôi không phải vậy! Xin lỗi, đều tại tôi không biết lựa lời mà nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070208,
					"content": "Hmm, không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070209,
					"content": "Tùy tùng của ta, còn việc gì quan trọng không? Cứ yên tâm diệt trừ tàn dư đi, công chúa ánh sáng sẽ chúc phúc cho chặng đường phía trước của ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fischl"
				}
			]
