				"points": []
			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "Woa. Biển ở đây, đẹp quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620102,
					"content": "Hử? Địch Hoa Châu có phải là biển đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620103,
					"content": "Nhưng mà nước ở Địch Hoa Châu đúng là có tiếp giáp với biển...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "Ừm, nói cũng phải... Nhưng mà nói Địch Hoa Châu là biển thì có cảm giác không đúng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620105,
					"content": "Mm... Không hiểu lắm. \"Biển\" và \"không phải biển\" có khác biệt gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620106,
					"content": "Vị của nước?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "Đúng ha! Nước suối trong rừng có vị ngọt, nên không phải là biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620108,
					"content": "Nhưng mà, nếu như bên trong Hồ Rượu Trái Cây toàn là rượu trái cây thì gọi là gì nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620109,
					"content": "Như vậy chắc là Venti thích lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "Bỏ vấn đề này qua một bên trước đi, hình như Kichiboushi càng ngày càng biết cách nói chuyện hơn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620121,
					"content": "Dựa theo cách nói của Ioroi thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "Ioroi nói gì nhỉ? \"Ta là Bake-Danuki danh chấn thiên hạ\"... không đúng, không phải câu này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620124,
					"content": "\"Muốn gãi bụng, mm-mm.\"... \"Oh!\"... cũng không phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620125,
					"content": "Mmhaha, Paimon bắt chước giống lắm, cười chết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620126,
					"content": "\"Thích nghi với mùi của Kichiboushi...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "A, đúng rồi! Chúng ta càng ngày càng thích nghi với mùi của Kichiboushi rồi, cho nên mới nghe hiểu lời của Kichiboushi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620128,
					"content": "#Còn có tu luyện nữa! Mm, đi chung với Paimon và {NICKNAME}, Kichiboushi học được nhiều thứ lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620129,
					"content": "Paimon là hướng dẫn viên giỏi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "Hứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620131,
					"content": "#Chuyện cũ như vậy mà {NICKNAME} vẫn còn nhớ sao. Vui ghê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620132,
					"content": "#Mm! Cảm ơn Paimon và {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620136,
					"content": "Cái \"không biết có phải là biển không\" này rất đẹp, phía kia còn có một căn nhà cao ơi là cao nữa. Chụp hình cho Kichiboushi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620137,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "Đồng đội cùng đi mạo hiểm, cùng nhau trưởng thành.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "Mm! Đồng đội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620135,
					"content": "Đồng đội tốt nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620122,
					"content": "Trước khi xuất phát, Ioroi hình như có nói qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "Vùng nước lớn ở bên ngoài đất liền là biển?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "Woa, đáp án này nghe nghiêm túc thật! Nhưng mà, nếu như vậy thì vấn đề lại là \"ranh giới\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME} vừa nói, nước của Địch Hoa Châu nối liền với biển. Vậy \"đất liền\" và không phải \"đất liền\" khác nhau chỗ nào chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620113,
					"content": "...Mặc dù nghe có vẻ nghiêm trọng, nhưng nó không giải quyết được vấn đề gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620114,
					"content": "Đây chỉ là khái niệm do con người tạo ra thôi, không có ý nghĩa gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "Địch Hoa Châu nếu cảm thấy bản thân là biển thì nó sẽ là biển.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "Kichiboushi cảm thấy bản thân là tiên nhân, thì sẽ là tiên nhân, Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620117,
					"content": "#Này! Kichiboushi đừng nghe {NICKNAME}, toàn nói cái gì đâu không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620118,
					"content": "...Nhưng mà cũng không phải là không có lý. Kichiboushi muốn trở thành bake-danuki thế nào thì sẽ trở thành bake-danuki thế đó! Nói không chừng sau này sẽ trở thành tiên nhân tanuki luôn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620119,
					"content": "Tiên nhân tanuki! Yey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
		{
