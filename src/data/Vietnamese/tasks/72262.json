			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Kichiboushi\"",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "Mmhuhu... tại sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620302,
					"content": "Kichiboushi thật là! Sao lại chạy vào căn cứ của Hilichurl vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620303,
					"content": "Nghĩ là... có thể chơi với Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620304,
					"content": "Hả? Tại sao lại có suy nghĩ này chứ? Hilichurl là ma vật nguy hiểm mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620305,
					"content": "Hilichurl cũng có nguy hiểm lắm đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
