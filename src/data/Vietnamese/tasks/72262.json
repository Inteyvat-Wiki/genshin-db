				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620201,
					"content": "Chụp xong rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620202,
					"content": "Tiếp theo thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620203,
					"content": "Ừm, làm gì đây nhỉ! À Kichiboushi đã câu cá qua chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620204,
					"content": "Câu cá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620205,
					"content": "Chắc là chưa câu qua rồi! Đến đây, chúng ta qua vùng nước bên kia đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620206,
					"content": "Được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
		{
			"id": 7226203,
			"completionStepIds": [
				7226207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
