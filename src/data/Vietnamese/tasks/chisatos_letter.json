					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070418,
					"content": "Đây là thư tay của bạn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "Đúng vậy, tôi đã chọn lọc từ ngữ mà tôi cảm thấy...thích hợp nhất, hy vọng tiểu thư Hiiragi sẽ không cảm thấy khó chịu khi đọc nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070420,
					"content": "Phiền bạn gửi kèm bức thư này với điểm tâm đến cho tiểu thư Hiiragi nhé.",
					"roleType": "TALK_ROLE_NPC",
