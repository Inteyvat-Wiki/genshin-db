				},
				{
					"id": 728070402,
					"content": "Về điểm tâm mà Kamaji đã đặt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "Ồ, tôi đã chuẩn bị xong điểm tâm mà thiếu gia Kamaji đặt rồi, bây giờ sẽ đi lấy cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070404,
					"content": "Nhưng không biết thiếu gia Kamaji định tặng điểm tâm này cho ai nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070405,
					"content": "Chỉ là quan hệ xã hội thôi, Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070406,
					"content": "Dạo trước, đại nhân Hiiragi Shinsuke từng tặng cho gia phụ một mẻ trà ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070407,
					"content": "Gia phụ biết ái nữ của đại nhân Hiiragi Shinsuke - tiểu thư Hiiragi Chisato rất thích điểm tâm, bèn dặn dò tôi chuẩn bị một ít điểm tâm gửi qua đó, coi như quà đáp lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070408,
					"content": "Tôi lo rằng việc gửi đi sẽ mất thời gian quá lâu, trên đường lại không tránh khỏi bị va đập...nên đặc biệt phiền Nhà Lữ Hành đây giúp tôi mang điểm tâm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070409,
					"content": "Kiminami, hãy lấy chỗ điểm tâm đó cho tôi xem nhé, tôi muốn kiểm tra lại một chút để tránh thiếu sót.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070410,
					"content": "À...được thôi, đây là điểm tâm, thiếu gia xem thử nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070411,
					"content": "Đúng là rất đầy đủ, cảm ơn cô, Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070412,
					"content": "Chúng ta qua bên kia đi, Nhà Lữ Hành, không nên đứng trước cửa tiệm, tôi còn có lời muốn nói với bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070413,
					"content": "Đây chính là giấy thông hành, bạn giữ cẩn thận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070414,
					"content": "Có giấy thông hành này chắc bạn sẽ có thể tự do ra vào đảo Ritou rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070415,
					"content": "Cám ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "Không cần cảm ơn, sau khi có giấy thông hành, bạn giúp tôi đưa điểm tâm cũng sẽ thuận tiện hơn một chút.",
