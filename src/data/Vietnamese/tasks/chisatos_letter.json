			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "Bạn là...à, là Nhà Lữ Hành ngoại quốc nhỉ, tìm tôi có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "Về thư tay của Hiiragi Chisato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "Bức thư này là tiểu thư Hiiragi nhờ bạn đưa tới sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "Nét chữ này, quả nhiên là cô ấy...tốt quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "Cảm ơn bạn đã đi một chuyến, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "Chuyện về giấy thông hành...Nếu là tiểu thư Hiiragi đích thân ủy thác, tôi đương nhiên sẽ xử lý chu toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "Nhưng, tôi vẫn phải về chuẩn bị giấy thông hành này một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "Thế này đi, bạn qua Nhà Hàng Kiminami bên kia chờ tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "Tại sao phải qua đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Chuyện này...vì tôi muốn nhờ bạn giúp tôi một việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Thực ra...trước kia tôi cũng muốn gửi một số đồ cho tiểu thư Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "Tôi vốn đã viết bức thư, còn tìm Kiminami đặt ít điểm tâm để gửi đến cho tiểu thư Hiiragi làm quà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "Nhưng nếu cha phát hiện tôi gửi thư cho tiểu thư Hiiragi, chắc sẽ không vui lắm...tôi đang nghĩ làm thế nào để gửi thư đây thì vừa khéo bạn tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "Chỉ là một món quà thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Cha không đồng ý cho tôi và tiểu thư Hiiragi trao đổi thư từ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "Tôi cũng hiểu nỗi lo lắng của cha, tôi là người của nhà Kujou, lại là một trong những người chấp hành của Hiệp Hội Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "Còn tiểu thư Hiiragi lại là đại tiểu thư của nhà Hiiragi thuộc Hiệp Hội Kanjou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "Nếu tôi và cô ấy quá thân thiết, khó tránh sẽ bị kẻ có dã tâm bắt thóp và lợi dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Tuy đây thực sự chỉ là một món quà, nhưng trong mắt một số người lại không chỉ đơn giản là một món quà như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Ha ha, tốt hơn tôi không nên nói những chuyện vụn vặt này ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "Nhà Lữ Hành, bạn tới Nhà Hàng Kiminami chờ tôi nhé, tôi phê duyệt xong giấy thông hành sẽ cầm đến cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "Cha bạn rất nghiêm khắc sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Cha...đương nhiên là rất nghiêm khắc. Tôi cũng có thể hiểu tại sao ông ấy không đồng ý cho tôi và tiểu thư Hiiragi trao đổi thư từ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070322,
					"content": "Tôi là người của nhà Kujou, lại là một trong những người chấp hành của Hiệp Hội Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070323,
					"content": "Còn tiểu thư Hiiragi lại là đại tiểu thư của nhà Hiiragi thuộc Hiệp Hội Kanjou.",
					"roleType": "TALK_ROLE_NPC",
