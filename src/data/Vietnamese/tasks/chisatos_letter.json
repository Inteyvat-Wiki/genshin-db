			"dialogs": [
				{
					"id": 728070201,
					"content": "Haiz, đúng là đau đầu...chào bạn, có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070202
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070202,
					"content": "Về Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Bạn nói thiếu gia Kamaji ư? Bạn tìm thiếu gia có việc gì à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070204,
					"content": "(Lấy lá thư tay ra)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "Bạn nói đây là thư tay của tiểu thư Hiiragi Chisato sao? Cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "Nhưng nếu lá thư này thật sự là thư tay của tiểu thư Hiiragi Chisato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "Chuyện này... hay là đi hỏi trực tiếp thiếu gia Kamaji đi, dạo gần đây thiếu gia thường xuyên tản bộ trên cây cầu ở đằng kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sanada"
				}
			]
		},
		{
			"id": 7280703,
			"completionStepIds": [
				7280703
