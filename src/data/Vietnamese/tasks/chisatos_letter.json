					"nextDialogs": [
						728070423
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070423,
					"content": "Vậy thì phiền bạn rồi, Nhà Lữ Hành. Tôi cũng phải về xử lý công vụ rồi.",
