					"nextDialogs": [
						221071908
					]
				},
				{
					"id": 221071908,
					"content": "Ý gì vậy? Không lẽ... Bạn đuổi chúng đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071909
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071909,
					"content": "Vậy, như vậy không biết chừng lại tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071910
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071910,
					"content": "Có thể mượn sức lực bên ngoài để giải thoát bản thân khỏi hỗn loạn, đi tìm chân ái cuộc đời mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071911
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071911,
					"content": "Rất cảm ơn bạn! Tôi đã hiểu dấu hiệu đó là gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071912
					],
					"speakerTitle": "Zhihua"
				},
				{
