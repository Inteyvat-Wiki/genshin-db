				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "Trên mái nhà có chim thành đôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "Uhm...! Tốt, cái này tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071003,
					"content": "Hai chú chim bồ câu thương yêu nhau rời khỏi đàn, trong mắt chỉ có đối phương, chỉ muốn cùng đối phương sát cánh bay đến cùng trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071004,
					"content": "Dấu hiệu này đang ám chỉ rằng... nhất định tôi sẽ gặp được vị hôn thê định mệnh của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071005,
					"content": "Sau đó cùng cô vượt qua hiểm nguy, thoát khỏi khó khăn, cùng nhau đi khắp đất trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071006,
					"content": "Í, vậy vất vả cho các bạn rồi... Nếu có thời gian, tôi đi tìm chị Qiming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
