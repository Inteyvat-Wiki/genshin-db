			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "Tôi thấy hôm hay chủ quán làm ăn rất tốt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "Ừm, tốt thật, tiền vào như nước? Cái này không tệ, không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071103,
					"content": "Chỉ cần nhẫn nại, chăm chỉ làm ăn là sẽ có thu hoạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071104,
					"content": "Dấu hiệu này chắc chắn đang nói cho tôi biết, cho dù là đường đời hay đường tình duyên đều vậy cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071105,
					"content": "Khụ! Khụ khụ...Vậy cảm ơn các bạn, tôi sẽ suy nghĩ kỹ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071106,
					"content": "Chị Qiming! Sẽ có một ngày em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
