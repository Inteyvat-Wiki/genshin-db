						221071904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071904,
					"content": "Những chú chó con, tôi biết chúng có mối quan hệ tốt và chơi với nhau qua nhiều năm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071905
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071905,
					"content": "Trông có vẻ là điều tốt, nhưng trên thực tế... không ai trong số chúng tìm thấy một nửa của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071906
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071906,
					"content": "Hơn nữa vì có bạn cùng chơi, chúng vốn không để ý đến chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071907
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071907,
					"content": "Chúng giờ có cơ hội đi tìm một nửa còn lại rồi.",
