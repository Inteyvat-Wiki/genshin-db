					"content": "Một con mèo và một con cá trở thành bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071802
					]
				},
				{
					"id": 221071802,
					"content": "Có thể tìm thấy dấu hiệu như vậy, bạn thật có tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071803
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071803,
					"content": "Trong tình bạn tuyệt vời này, cho dù đó là mèo hay cá, đều rất vĩ đại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071804
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071804,
					"content": "Giống như tình yêu! Sức mạnh của tình yêu có thể vượt qua mọi thứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071805
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071805,
					"content": "Nếu có thể, tôi thực sự muốn vinh danh chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071806
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071806,
					"content": "Đặc biệt như con cá kia, biết đối phương là mèo, nhưng vẫn hết có gắng tỏ tình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071807
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071807,
					"content": "Bạn bây giờ có thể bày tỏ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071808
					]
				},
				{
					"id": 221071808,
					"content": "Ý gì? Bạn mang con cá đó ra đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071809
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071809,
					"content": "Bạn... bạn không lẽ đích thân xuống đấy, bắt nó lên chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071810
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071810,
					"content": "Thứ tình bạn vượt qua cả vật chất! Không phải càng cần bảo vệ sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071811,
					"content": "Hơn nữa không dễ dàng gì tìm được dấu hiệu tốt như vậy, bạn, bạn rốt cuộc đang làm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071812,
					"content": "Thôi vậy, bạn đừng làm phiền tôi suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
