			"trigger": {
				"objectNames": [
					"Hiiragi Shinsuke",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130201,
					"content": "Ta là Hiiragi Shinsuke, là gia chủ của nhà Hiiragi thuộc Hiệp Hội Kanjou, hân hạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130202,
						20130203
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130202,
					"content": "Cháu cũng rất hân hạnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				},
				{
					"id": 20130204,
					"content": "Rất hân hạnh được gặp ông!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130205,
					"content": "Chúng cháu đến tìm ông, là muốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130206,
					"content": "Đừng gấp, hai nhà lữ hành nổi tiếng, sao lại vội vàng nói công chuyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130207
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130207,
					"content": "Hì hì, chúng cháu nổi tiếng thế sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130208,
					"content": "Đương nhiên, có thể đánh bại Phong Ma Long, trấn áp Ma Thần Lốc Xoáy, trên đời này còn có mấy ai chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130209
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130209,
					"content": "Ông nói đúng lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130210,
					"content": "Lại còn...phá hủy kế hoạch của Fatui ở Liyue, chiến thắng quan chấp hành của chúng, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130211
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130211,
					"content": "Ồ! Đến chuyện này ông cũng biết sao, tất nhiên là thật rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130212,
					"content": "Ừm...quả nhiên là thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130213
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130213,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130214,
					"content": "À à, không sao không sao, lão phu rất kính phục hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130215,
						20130216
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130215,
					"content": "Quá khen rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130217,
					"content": "...Được hai vị đến thăm Đảo Ritou, đúng là một sự vinh hạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130218
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130218,
					"content": "Tuy đã chứng kiến được sự nhiệt huyết của hai vị, nhưng có thể cho tại hạ nhờ hai vị làm chút việc cho Hiệp Hội Kanjou được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130219
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130219,
					"content": "#Ông cứ nói đi, đừng khách sáo! Đúng không {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130220,
						20130221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130220,
					"content": "Lại đến lúc giúp đỡ rồi đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130222,
					"content": "Ha ha, vậy thì tốt. Chuyện là vầy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130223
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130223,
					"content": "Cháu biết Thanh Tâm chứ? Đó là loại thực vật thường thấy ở đỉnh núi Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130224
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130224,
					"content": "Biết chứ, cháu có hái qua. Không lẽ ông định bảo cháu quay về Liyue sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130225,
					"content": "Ừm, giúp ta hái 300 đóa Thanh Tâm nhé! Loại vừa mới hái ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130226
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130226,
					"content": "Có nhầm lẫn không vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130227,
						20130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130227,
					"content": "Số lượng có vẻ gì đó không đúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130229,
					"content": "À vậy sao, vậy thì thế này nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130230
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130230,
					"content": "Ta có chút thư cần gửi đi, có thể giúp đỡ được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130231
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130231,
					"content": "Vậy còn tạm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130232,
					"content": "Tổng cộng 709 lá thư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130233
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130233,
					"content": "Này! Ông có thực sự muốn nhờ chúng tôi làm việc không đấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130234,
					"content": "Ha ha, thật ngại quá, nhân lực trên đảo đúng là hơi thiếu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130235
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130235,
					"content": "Lý do gì mà đơn giản vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130236,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130237
					]
				},
				{
					"id": 20130237,
					"content": "Vậy làm sao đây, chúng ta thực sự phải giúp ông ấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130238,
						20130239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130238,
					"content": "Để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130240,
					"content": "Không hổ danh là các hạ, vậy tôi sẽ đợi ở đây nhé, ha ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130239,
					"content": "Để tôi đi tìm hiểu xung quanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130228,
					"content": "Hái xong đến đây là đã không còn tươi rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130221,
					"content": "Đây là sở trường rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130216,
					"content": "Tiếc là sau đó vẫn không cản được chúng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130203,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
