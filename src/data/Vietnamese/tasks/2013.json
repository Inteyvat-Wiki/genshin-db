						20131008
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131008,
					"content": "Không đâu, tiểu thư nhất định có dụng ý riêng, đúng không? Còn \"Kamaji\" mà tiểu thư nói là ai...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "Shinnojou"
				},
