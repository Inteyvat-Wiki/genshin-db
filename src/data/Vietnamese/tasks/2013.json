			"dialogs": [
				{
					"id": 20130101,
					"content": "Đợi đã! Hãy xuất trình giấy thông hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130102,
					"content": "Xin lỗi, tôi có việc gấp cần đến Đảo Narukami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130103,
					"content": "Không có giấy thông hành thì không được phép qua, đây là luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130104,
					"content": "Chậc...quả nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130105,
					"content": "Nhà lữ hành, mau nghĩ cách đi, giờ phải làm sao đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130106,
					"content": "Nếu như Hiệp Hội Yashiro đã nghe danh của chúng ta qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "Ý bạn là muốn đi gặp người của Hiệp Hội Kanjou sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130109,
					"content": "...Dù là vừa đắc tội với Hiệp Hội Kanjou, nhưng chúng ta cũng đành phải thử xem vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130110,
					"content": "Lỡ như họ chuyển hướng sang sùng bái chúng ta thì sao? Hi hi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130107,
					"content": "Hiệp Hội Kanjou giờ có lẽ đã biết chúng ta rồi đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
