					"nextDialogs": [
						20130408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130408,
					"content": "Vậy có nghĩa là...chúng ta cần phải lén lén đi gặp cô ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130409
					],
					"speakerTitle": "Paimon"
				},
