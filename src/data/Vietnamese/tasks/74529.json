			"dialogs": [
				{
					"id": 745290401,
					"content": "#Ồ, {NICKNAME} đến rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290402,
					"content": "Citlali, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "Nói gì vậy? Thỉnh thoảng bà đây cũng đi dạo chứ bộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290405,
					"content": "Hơn nữa, tối qua tôi xem bói vận may, dự đoán nếu hôm nay ra ngoài thì sẽ gặp chuyện tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290406,
					"content": "Thấy không, vừa bước ra khỏi nhà là chuyện tốt đã tìm đến tận cửa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290407,
					"content": "Vậy thì để niềm vui nhân đôi đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Cũng không phải là không được... Có điều, hai hôm trước tôi đã thức trắng đêm để đọc hết cuốn tiểu thuyết mới nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290410,
					"content": "Mau giúp tôi xem xem hiện tại trông tôi thế nào? Chắc hết quầng thâm rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290411,
					"content": "Trông vẫn tươi tắn như bình thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "Thật không đấy? Không được lừa tôi đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290414,
					"content": "Nói trước, nếu chụp không đẹp thì tấm hình đó sẽ thuộc về tôi... Nếu muốn giữ thì chỉ được giữ tấm đẹp nhất thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290412,
					"content": "Trông rất rạng rỡ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "Hãy để tôi chụp cho cô một bức hình!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "Thật hiếm khi thấy cô không nằm dài ở nhà ngủ nướng đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
