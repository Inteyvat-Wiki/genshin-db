					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120040101,
					"content": "Ừm, vậy tiếp theo chúng ta cần phải làm gì đây...mau nghĩ xem có kế hoạch gì không đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040102,
					"content": "Nhà lữ hành, Paimon, xin hãy dừng bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040103
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040103,
					"content": "Huh? Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040104,
					"content": "Có chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040105
					]
				},
				{
					"id": 120040105,
					"content": "Tôi có việc cần bạn giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040106,
					"content": "Tuy nói là vậy, nhưng cũng đừng căng thẳng quá. Lần này không phải là ủy thác của Hiệp Hội Yashiro hay nhà Kamisato đâu, mà chính là tôi tự yêu cầu dưới danh nghĩa của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040107,
					"content": "Danh nghĩa cá nhân, vậy có nghĩa là việc riêng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040108,
					"content": "Đúng vậy, là một chuyện liên quan đến mẹ của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040109,
					"content": "Có thể hơi đường đột thật...nhưng chuyện này tôi thấy chỉ có thể nhờ vào bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040110,
					"content": "Có thể nói chi tiết không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040111
					]
				},
				{
					"id": 120040111,
					"content": "Mấy ngày trước, tôi có tìm được một quyển sổ tay trong đống vật dụng cũ của mẹ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040112,
					"content": "Bên trong có ghi lại rất nhiều thứ, trong đó có xuất hiện một cái tên mà tôi chưa từng nghe qua, cái tên này lại còn được lặp lại rất nhiều lần nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040113,
					"content": "Có thể là bạn bè của mẹ tiểu thư chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040114,
					"content": "Đến bạn cũng chưa nghe qua sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040115
					]
				},
				{
					"id": 120040115,
					"content": "Đúng vậy. Tuy cha mẹ tôi qua đời đã lâu, nhưng những người quen của họ, tôi và anh trai đều biết rất rõ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040116,
					"content": "Vì vậy...tôi rất tò mò về người này, muốn đi gặp mặt thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040117,
					"content": "Trên sổ tay viết người này tên là \"Tsubaki\", có vẻ như rất được mẹ tôi coi trọng, cũng là người tương đối có cá tính, thích vui đùa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040118
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040118,
					"content": "Nghe có vẻ như là tên của phụ nữ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040119,
					"content": "Ừm, tôi muốn gặp cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040120,
					"content": "Vậy bạn cần chúng tôi làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040121,
					"content": "Bạn muốn tôi giúp bạn tìm người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040122,
					"content": "Không không, trên sổ tay có viết nơi ở của cô ấy, chúng ta trực tiếp đến đó là được. Tôi chỉ muốn nhà lữ hành cùng đi chọn quà gặp mặt với tôi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040123
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040123,
					"content": "Chuyện ban nãy tôi nói, phiền hai bạn giữ bí mật giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040124
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040124,
					"content": "Thực ra chuyện này tôi nên đi cùng với anh trai, nhưng dạo gần đây anh trai tôi bận quá, tôi lại không muốn người bản địa xen vào chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040125
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040125,
					"content": "Cho nên bạn mới nhờ một người ngoại quốc như tôi sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040126
					]
				},
				{
					"id": 120040126,
					"content": "Đúng vậy, bạn hiểu lễ tiết, lại rất đáng tin cậy, nên tôi rất yên tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040127
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040127,
					"content": "Ừm ừm! Chúng tôi có thể chọn quà gặp mặt giùm bạn, nhưng thù lao thì phải là món ngon nào đó đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040128,
					"content": "Vậy thì tốt quá! Tôi cũng muốn nhân cơ hội này đi dạo với bạn luôn. Vậy không phiền thì đi theo tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040129
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040129,
					"content": "#Không phiền đâu! Đúng không {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040130,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040131
					]
				},
				{
					"id": 120040131,
					"content": "Tôi rất cảm kích. Vậy chúng ta đến Tiệm Vải Ogura trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040132
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040132,
					"content": "Được thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}