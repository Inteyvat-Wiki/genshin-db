				"points": []
			},
			"dialogs": [
				{
					"id": 726700101,
					"content": "Khụ, khụ khụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700102,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700103
					]
				},
				{
					"id": 726700103,
					"content": "Xin chào xin chào, cuối cùng cũng đợi được một người thích hợp, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700104,
					"content": "Huống hồ còn là người quen, lần này không phải lo không đủ mẫu nữa rồi, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700105,
					"content": "Đợi cả ngày trời, không phải người già thì là con nít, không đủ dùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700106,
						726700109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700106,
					"content": "Anh là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700107
					]
				},
				{
					"id": 726700107,
					"content": "Ơ, quên nhanh vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700108,
					"content": "Tôi không phải là kẻ ác độc mưu mô gì, đừng tỏ ra không quen biết như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700111,
					"content": "Nhìn cho kỹ đi, là tôi, chúng ta từng gặp nhau trên Đảo Ritou Inazuma, khụ khụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700112
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700112,
					"content": "Rất đáng nghi ngờ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700113
					]
				},
				{
					"id": 726700113,
					"content": "Xem ra bạn quên tôi thật rồi, haiz, vậy thì để tôi tự giới thiệu lại vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700114,
					"content": "Tôi là Hosseini, học giả của \"Giáo Viện\" Sumeru, để thực hiện các dự án nghiên cứu ở Inazuma, khó khăn lắm mới đến được Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700115,
					"content": "Tiếc là...e hèm...tiến hành nghiên cứu ở Inazuma thật sự quá hạn chế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700116,
					"content": "Mặc dù cuối cùng không đến nỗi trắng tay, nhưng so với những trắc trở suốt quãng đường này, thì đúng là được một mất mười.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700117,
					"content": "Kinh phí nghiên cứu sắp hết, tôi đành phải trở về \"Giáo Viện\" theo đường Liyue, nhưng tôi vẫn hy vọng có thể tận dụng thời gian của chuyến hành trình trở về để cứu vãn chút ít...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700118
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700118,
					"content": "Tôi nghĩ tốt hơn hết là tôi nên tiếp tục với dự án \"Đĩa Dẫn Năng Lượng\" đã từng được \"Giáo Viện\" đề cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700119,
					"content": "Không biết bạn có nhớ \"Đĩa Dẫn Năng Lượng\" không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700120
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700120,
					"content": "Nó là một di vật cổ quý giá, có thể tận dụng địa mạch ở khắp nơi để tăng sức mạnh cho người dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700121
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700121,
					"content": "E hèm, hạng mục nghiên cứu này vẫn đang ở giai đoạn đầu, báo cáo điều tra hôm trước tôi nộp lên cũng chỉ tương đương với phần giới thiệu của nghiên cứu hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700122
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700122,
					"content": "Để hiểu được nguyên lý hoạt động và khả năng ứng dụng của toàn bộ \"Đĩa Dẫn Năng Lượng\" thì vẫn còn rất nhiều việc phải làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700123
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700123,
					"content": "Cho nên tôi ở đây để tìm kiếm tình nguyện viên, mời họ sử dụng \"Đĩa Dẫn Năng Lượng\" để có thêm nhiều dữ liệu hỗ trợ cho việc nghiên cứu của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700124
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700124,
					"content": "Tôi...khụ khụ...không phải là người đáng ngờ, bạn đừng hiểu lầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700125
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700125,
					"content": "Thì ra là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700126
					]
				},
				{
					"id": 726700126,
					"content": "Đúng vậy...khụ khụ...vậy bây giờ tôi có thể hỏi rồi nhỉ, Nhà Lữ Hành, bạn có đồng ý làm tình nguyện viên, giúp tôi thử \"Đĩa Dẫn Năng Lượng\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700127
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700127,
					"content": "Có thể thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700128
					]
				},
				{
					"id": 726700128,
					"content": "Xin cho phép tôi bày tỏ lòng biết ơn, vì bạn luôn sẵn sàng cống hiến cho sự nghiệp theo đuổi trí tuệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700129
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700129,
					"content": "Nhưng trước khi tôi chính thức đưa \"Đĩa Dẫn Năng Lượng\" cho bạn bảo quản thì chúng ta khởi động một chút trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700130
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700130,
					"content": "Điều này cũng là để xác nhận xem các tình nguyện viên có khả năng tự bảo vệ mình hay không...khụ khụ...hạng mục học thuật có trách nhiệm sẽ không lấy an toàn tính mạng của tình nguyện viên ra để mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700131
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700131,
					"content": "Nếu bạn đã sẵn sàng, hãy đến địa điểm được chỉ định và thử xử lý doanh trại ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700132
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700132,
					"content": "Tôi sẽ ở đây chờ bạn trở về, nhất định phải chú ý an toàn nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700109,
					"content": "...Anh có ý đồ gì!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700110
					]
				},
				{
					"id": 726700110,
					"content": "Trông tôi có giống loại học giả điên rồ bắt cóc người qua đường để làm thí nghiệm không? Đừng nói chuyện kiểu đề phòng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700111
					],
					"speakerTitle": "Hosseini"
				}
			]
		},
		{
			"id": 7267002,
			"completionStepIds": [
				7267003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267003",
							"2"
						],
						"stepId": 7267003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726700201,
					"content": "Các bạn về rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700202
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700202,
					"content": "Bình an vô sự.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700203
					]
				},
				{
					"id": 726700203,
					"content": "Haha...e hèm, là do tôi suy nghĩ nhiều quá rồi, quả thật bạn rất mạnh, tôi có thể yên tâm giao \"Đĩa Dẫn Năng Lượng\" cho bạn bảo quản rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700204
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700204,
					"content": "Cách sử dụng \"Đĩa Dẫn Năng Lượng\" rất đơn giản và dễ hiểu, bạn nhìn là sẽ biết ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700205
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700205,
					"content": "Nhưng khi sử dụng phải thật cẩn thận đó, đây là di vật cổ, nếu để mất hoặc làm hỏng thì tội nghiệp tôi lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700206
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700206,
					"content": "Bạn có thể làm quen với \"Đĩa Dẫn Năng Lượng\" trước, sau đó hẵng thử kiểm tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700301
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700301,
					"content": "Thế nào, hiểu được cách dùng \"Đĩa Dẫn Năng Lượng\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700302,
						726700304
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700302,
					"content": "Không phức tạp lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700303
					]
				},
				{
					"id": 726700303,
					"content": "Đúng vậy, so với máy móc trong Giáo Viện, thì \"Đĩa Dẫn Năng Lượng\" dễ dùng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700306
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700306,
					"content": "Với trình độ của bạn, nếu mở rộng quy mô thử nghiệm, có lẽ không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700307
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700307,
					"content": "Tôi nghe nhà mạo hiểm qua đường nói, họ mới phát hiện một bí cảnh đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700308
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700308,
					"content": "Bởi vì dường như chưa từng có ai phát hiện ra nơi này, nên có rất nhiều ma vật tụ tập trong đó, năng lực của bọn chúng cũng mạnh hơn ma vật lang thang bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700309
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700309,
					"content": "Nếu lấy đó làm nơi thử nghiệm, chắc chắn sẽ có được dữ liệu toàn diện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700310
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700310,
					"content": "Dù sao thì biểu hiện của bạn lúc nãy...e hèm...thật sự rất xuất sắc, ngược lại phần ghi chép trong \"Đĩa Dẫn Năng Lượng\" lại khá hạn chế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700311
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700311,
					"content": "Nếu là bạn, ra vào loại bí cảnh đó chắc không phải chuyện khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726700312
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 726700312,
					"content": "Còn phải nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726700313
					]
				},
				{
					"id": 726700313,
