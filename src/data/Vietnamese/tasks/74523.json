				"points": []
			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "Trong gió... mang theo vị mặn của thủy triều, hương gỗ của thuyền buôn phương xa, và... hơi thở của cố nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230402,
					"content": "#{NICKNAME}, vẫn khỏe chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230403,
					"content": "Kazuha, lâu rồi không gặp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "Đội thuyền Nam Thập Tự cập bến Inazuma để tiếp tế. Hiếm khi thăm lại chốn cũ, tôi muốn đi dạo quanh đây, ngắm nhìn thêm cảnh sắc quê hương, lắng nghe thêm tiếng gió nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230406,
					"content": "Gió ở Đảo Ritou luôn ồn ào hơn những nơi khác, hòa quyện giữa những cuộc chia ly và hội ngộ, giữa hy vọng và hoang mang... Đây quả là nơi có thể lắng nghe được nhiều câu chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230407,
					"content": "Tôi chụp cho anh một tấm được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Haha, vạn vật đều có hình hài, gió cũng vậy. Chỉ là hình dáng của gió chỉ có thể nhìn thấy trong khoảnh khắc lá rụng, sóng trào, hay vạt áo lữ khách tung bay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230410,
					"content": "Hy vọng thông qua bóng dáng của tôi, cậu có thể nắm bắt được \"bóng hình của gió\" thoảng qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230411,
					"content": "Vậy tôi bắt đầu đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "#Vậy thì, mời {F#cô}{M#cậu} thu thập những vần thơ thuộc về khoảnh khắc này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230412,
					"content": "Hãy cảm nhận làn gió như vừa rồi là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Tôi cũng muốn ghi lại cơn gió lúc này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "Sao anh lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
