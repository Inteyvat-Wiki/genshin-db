			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "Ôi...đói quá...khó chịu quá",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250102,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "Tôi, tôi cũng không rõ nữa...tôi thấy cả người không còn sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250104,
					"content": "Tối qua sau khi ăn xong thức ăn mà bạn đưa, tôi đã trở về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250105,
					"content": "Tuy món bạn đưa \"rất đặc biệt\"...nhưng cũng xem như no bụng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250106,
					"content": "Sau đó tôi định đi ngủ để qua giấc, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250107,
					"content": "Cứ mỗi lần tôi vào giấc là mùi vị của món đó lại xốc lên khiến tôi tỉnh giấc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250108,
					"content": "Sau đó cứ liên tục như vậy, nửa tỉnh nửa mơ tới sáng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250109,
					"content": "Nếu như chỉ là thiếu ngủ thôi thì không phải vấn đề gì lớn, nhiều khi đi làm thêm tôi cũng hay bị vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250110,
					"content": "Nhưng quan trọng là hôm nay! Tôi tưởng ăn chút thức ăn vào sẽ không sao, nhưng không ngờ khi tôi ăn vào thì lại toàn nghe mùi của món ăn hôm qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250111,
					"content": "Món đó có uy lực mạnh vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "Haiz, dù sao thì tôi cảm thấy...bây giờ chỉ có món ngon có hương vị đặc biệt mới có thể giải thoát cho tôi khỏi cái mùi vị đó thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250113,
					"content": "Món ngon có hương vị đặc biệt? Hay là để chúng tôi đi hỏi người khác xem làm sao để làm ra món này nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250114,
					"content": "Sau đó sẽ làm cho Tang Wen một phần...nói không chừng sẽ giải quyết được vấn đề này đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250115,
					"content": "Thật sao? Vậy thì tốt quá! Nếu như tiện thì các bạn có thể đến Đảo Ritou hỏi thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250116,
					"content": "Tôi nhớ Li Xiao ở Đảo Ritou nghiên cứu sâu về ẩm thực, còn có Qiuyue ở Thương Hội Sở Du, cũng có thể coi là một nửa nhà ẩm thực!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
