				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "Có chuyện gì vậy? À...bạn nhắc đến Tang Wen sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250207,
					"content": "Ăn uống không ngon...miệng có vị lạ...món nào có thể giúp được đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250202,
					"content": "Cô ấy gặp phải vấn đề này sao, khó khăn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250203,
					"content": "Nhưng theo tôi thấy thì không cần phải làm món gì quý giá cả, chỉ cần món có vị đặc biệt và kích thích vị giác một chút là đủ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250204,
					"content": "Vì vậy tôi kiến nghị làm món Cơm Cháy Tuyệt Vân đi! Vừa có vị lạ, vừa có vị cay kích thích vị giác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250205,
					"content": "Năm đó tôi ở Khinh Sách Trang lần đầu tiên nếm thử Cơm Cháy Tuyệt Vân, đến nay đã mười mấy năm rồi! Giờ tôi vẫn thường hay nhớ lại hương vị đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250206,
					"content": "Tôi nghĩ nếu là món Cơm Cháy Tuyệt Vân thì nhất định sẽ giải quyết được các vấn đề hiện tại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Xiao"
				}
			]
		},
		{
			"id": 2202503,
