			"dialogs": [
				{
					"id": 220250401,
					"content": "Hừm, hai người cho hai cách khác nhau, Cơm Cháy Tuyệt Vân và Măng Chua Tươi đều rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250402,
					"content": "Vậy phải làm sao đây? Phân vân quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250403,
					"content": "Paimon cảm thấy nên chọn món nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "Hử? Tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250405,
					"content": "Vậy nếu là Paimon thì sẽ đề nghị món gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250406,
					"content": "Tôi chọn Cá Hổ Nướng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250407,
					"content": "Vừa nghe tên Cá Hổ Nướng là thấy có khí chất rồi đúng không, Tang Wen mà ăn được món đầy khí chất như vậy nhất định sẽ giải quyết được vấn đề!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250408,
					"content": "Paimon cũng có hiểu biết về ăn uống thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "Bởi vậy nên tôi mới nói bạn quyết định đi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250411,
					"content": "Vậy tôi chọn...Cơm Cháy Tuyệt Vân!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250414,
					"content": "Vậy chúng ta mau chế biến rồi mang về cho Tang Wen đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250412,
					"content": "Vậy tôi chọn...Măng Chua Tươi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250413,
