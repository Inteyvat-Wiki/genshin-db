			},
			"dialogs": [
				{
					"id": 220250301,
					"content": "Chuyện gì vậy? Hử...Tang Wen có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250307,
					"content": "Miệng có vị lạ, ăn không ngon miệng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250302,
					"content": "Ăn phải món ăn kỳ lạ gì đó sao? Có phải không vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250303,
					"content": "Nghe thế nào cũng giống như bệnh ăn không tiêu vậy. Hừm, để tôi suy nghĩ thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250304,
					"content": "Kệ vậy, nếu như không kết luận được thì có một món có thể giúp được, đó là Măng Chua Tươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250305,
					"content": "Vị mặn và tươi, thịt giòn, tạo cảm giác sảng khoái, ngon miệng, cuối cùng là một nồi canh hỗ trợ tiêu hóa. Vừa nói vừa cảm thấy thèm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250306,
					"content": "Tin tôi đi, Tang Wen đang cần món Măng Chua Tươi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiuyue"
				}
			]
		},
		{
