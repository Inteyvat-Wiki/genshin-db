	"talks": [
		{
			"id": 7422402,
			"completionStepIds": [
				7422402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422402",
							"2"
						],
						"stepId": 7422402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "Ơ? Đây chẳng phải là Tailleferre sao? Không ngờ lại gặp nhau ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "Úi, là hai vị sao! Nhà mạo hiểm và trợ thủ, lần trước tôi quên hỏi tên hai vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#Tôi là Paimon, đây là {NICKNAME}. Lần trước may nhờ có cô mà chúng tôi mới sử dụng được Đàn Ốc Biển để biểu diễn nhạc phổ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "Nhưng sao Tailleferre lại đến Thị Trấn Petrichor vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "Chuyện này tôi cũng muốn hỏi hai vị đây. Tôi vừa nghe tin là chạy đến đây ngay, nhưng nếu là nhà mạo hiểm như hai vị thì việc biết trước cũng là lẽ đương nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "Nghe tin? Cô đang nói đến tin gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "Tin tức lớn nhất của Thị Trấn Petrichor không phải là tin đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "Là chúng tôi không cẩn thận giải cứu thế giới sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "Hả? Nói gì vậy, đương nhiên là chuyện Lâu Đài Phai Màu trong truyền thuyết được phát hiện ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "Lần ghi chép mới nhất về Lâu Đài Phai Màu đã là chuyện của mấy trăm năm trước rồi. Tôi còn tưởng hai vị đến vì chuyện này chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "Chuyện này, cũng có chút liên quan đến chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "Chắc hai vị cũng biết nhỉ? Lâu Đài Phai Màu từng thuộc về nhạc sĩ nổi tiếng nhất trong lịch sử Fontaine là Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "Dù là vở kịch do Boethius sáng tác, hay là nhạc phổ của Remuria cổ xưa cũng đều có vị trí đặc biệt trong lịch sử âm nhạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "Nếu đã là lâu đài mà ông ấy từng ở, vậy thì nhất định là có rất nhiều tài liệu. Đây là tài liệu quan trọng đối với Hiệp Hội Nhạc Sĩ chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "Cho nên khi nghe được tin này là tôi liền vội chạy đến đây ngay. Tôi muốn kịp thời đến trước những nhà mạo hiểm khác để bảo quản các tư liệu quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "Nhưng không ngờ lại để hai vị đến trước một bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(Làm sao đây? Có nên nói với cô ấy rằng cái tên Boethius đó thật ra là một kẻ xấu xa, còn lợi dụng âm nhạc để làm ra cả đống chuyện xấu nữa không...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(Nếu cô ấy biết được sự thật, chắc sẽ không đau lòng đâu nhỉ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "\"Bản nhạc\" đã không thể làm chuyện xấu nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "Hửm? Hai vị đang thì thầm gì vậy, không lẽ là đã phát hiện bản nhạc cổ xưa gì đó rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "Ừm, giả sử... Tôi chỉ nói là giả sử thôi nhé. Giả sử Boethius là một người rất xấu xa thì cô có còn muốn lấy nhạc phổ của ông ta để lại không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "#Ừm... Mặc dù không hiểu ý của {F#cô}{M#cậu} là gì, nhưng Boethius ngoài âm nhạc ra thì trong lịch sử cũng không có chút danh tiếng tốt nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "Từ vở kịch chủ nghĩa lãng mạn \"Người Phương Xa Phiêu Bạt\" của ông ấy cũng có thể thấy rồi. Tận đến trước khi qua đời, ông ấy vẫn không từ bỏ việc xây dựng lại Remuria, vì vậy mà đối đầu với Fontaine vừa mới thành lập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "Hơn nữa, theo các nhà sử học thì trận chiến khi Fontaine mới thành lập cũng có liên quan đến ông ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "Nhưng thành tựu về âm nhạc lại là chuyện khác. Dù những bản nhạc mà ông ấy sáng tác có lịch sử sai lầm thì cũng không thể phủ nhận giá trị nghệ thuật của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "Mà theo tôi thấy, đây vốn dĩ cũng là một phần của lịch sử mà. Cho dù là nghệ thuật thuần túy thì cũng có thể bị dùng để làm chuyện xấu. Thân là một nhạc sĩ thì cũng phải ghi nhớ điều này mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "Nếu là cô thì chắc chắn sẽ không dùng nó để làm chuyện xấu nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Haha, tôi chỉ là một nhà nghiên cứu thôi mà. Được lắng nghe những giai điệu cổ xưa này chính là nguyện vọng lớn nhất của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "Nói đi cũng phải nói lại, nếu đã tình cờ gặp được hai vị thế này, có thể nhờ hai vị giúp tôi một việc được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "Cũng coi như báo đáp chuyện lần trước tôi đã giúp hai vị nhé, có qua có lại mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "Lần trước không phải đã nói là không cần thù lao sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "Hihi, vậy thì cứ xem như là giúp tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "Tóm lại thì như tôi vừa nói đó. Tôi đến đây để tìm nhạc phổ thất lạc của vở kịch nổi tiếng \"Người Phương Xa Phiêu Bạt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "Theo ghi chép của một người tên là Ruggiero mấy trăm năm trước, chắc nó được giấu ở đâu đó trong Lâu Đài Phai Màu. Nếu hai vị có thể giúp tôi tìm ra thì tốt quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "Dù sao thì việc thám hiểm di tích chắc là hai vị cũng đầy kinh nghiệm rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#{NICKNAME}, nếu cô ấy đã nói vậy rồi thì chúng ta giúp cô ấy đi. Dù sao thì những nhạc phổ đó cũng không còn \"sức mạnh đó\" nữa rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "Ừm, vậy tôi sẽ xem như hai vị đã nhận lời rồi nhé. Hihi, thật tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "Nhờ cả vào hai vị đó. Trước khi hai vị trở về, tôi sẽ ở trong thị trấn chờ tin tốt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "Tôi phải nhận thù lao đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "Đương nhiên là tôi sẽ trả thù lao cho hai vị rồi. Hiệp Hội Nhạc Sĩ chúng tôi không phải tổ chức nghèo nàn gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "Tôi đã đoán được là sẽ như vậy rồi...",
