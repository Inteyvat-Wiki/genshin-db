					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "Đây là... Ừm, quả nhiên là nhạc phổ của \"Người Phương Xa Phiêu Bạt\", không ngờ hai vị lại tìm được thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "Chắc phải tốn rất nhiều công sức nhỉ. Không hổ danh là nhà mạo hiểm tài ba, tin tưởng hai vị quả nhiên không sai mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Hihi, nhưng mà Tailleferre muốn dùng nhạc phổ này để làm gì nhỉ? Chắc không phải là muốn biểu diễn ở Viện Ca Kịch Epiclese để kiếm một khoản lớn đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Hmm... Tuy việc kiếm tiền cũng rất quan trọng, nhưng tôi không định giấu nhạc phổ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "Những nghệ thuật cổ xưa này nên là tài sản chung của toàn nhân loại. Khi nào hoàn thành nghiên cứu cả bộ \"Người Phương Xa Phiêu Bạt\", tôi sẽ công khai chúng cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "Khôi phục lại vở kịch đã thất truyền, viết lại một trang còn thiếu trong lịch sử nghệ thuật, chẳng phải là một việc rất tuyệt vời sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "Cố lên!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "Vậy tôi cũng nên mau chóng quay về nghiên cứu nhạc phổ này thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Đây là thù lao của hai vị, chúng ta có duyên ắt sẽ gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240908,
					"content": "Đừng quên sự cống hiến của tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "Đương nhiên rồi. Tôi sẽ viết tên hai vị lên trang tiêu đề sau khi xuất bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240910
					],
					"speakerTitle": "Tailleferre"
				}
			]
