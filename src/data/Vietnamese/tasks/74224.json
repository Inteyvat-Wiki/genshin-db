			},
			"dialogs": [
				{
					"id": 742240801,
					"content": "Phong cảnh ở đây đẹp thật. Tuy mỗi năm chúng tôi đều phải đặt mua rất nhiều nhạc cụ trong thị trấn, nhưng đây là lần đầu tiên tôi đến đây với thân phận là khách du lịch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240802,
					"content": "Về nhạc phổ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "Không có gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "Nhờ cả vào hai vị đó. Trước khi hai vị trở về, tôi sẽ ở trong thị trấn chờ tin tốt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
