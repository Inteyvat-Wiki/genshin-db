			"trigger": {
				"objectNames": [
					"Verut",
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "Lần này em sẽ trốn ở một nơi chắc chắn anh không thể tìm được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "Nếu em trốn ở mấy chỗ đó thì người đi tìm em sẽ không phải anh, mà là bố mẹ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030103,
					"content": "Hai em đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "Em đang chơi trốn tìm với anh trai! Nhưng mà... em trốn ở đâu anh ấy cũng đều biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut... Chúng ta chơi ở đây bao lâu rồi, tất cả những góc có thể trốn em đều trốn cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030106,
					"content": "Còn mấy chỗ không được trốn... anh đã nói với em rất nhiều lần về lý do không nên trốn ở đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030107,
					"content": "Mấy chỗ đó đâu có gì nguy hiểm chứ, bố mẹ cứ làm quá lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "Nhưng em trốn ở mấy chỗ đó sẽ làm bẩn hoặc rách quần áo. Bố mẹ làm việc đã rất vất vả rồi, đừng khiến họ phải lo lắng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030109,
					"content": "Ừm... Thôi được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "#Hay là... để {M#anh}{F#chị} chơi với hai em nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "#Thật sao?! {M#Anh}{F#Chị} đồng ý chơi với em à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "Verut, đừng có làm phiền người ta! Xin lỗi, em trai của em trong đầu chỉ nghĩ đến chơi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030114,
					"content": "#Không sao, đúng lúc {M#anh}{F#chị} đang rảnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "Anh thấy không, người ta đồng ý rồi kìa! Nhất định em sẽ trốn giỏi hơn anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "#Được thôi... vậy thì phiền {M#anh}{F#chị} rồi ạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030118,
					"content": "Verut, không được trốn ở mấy nơi anh vừa nói nhé. Tối nay bố mẹ về muộn, nếu lỡ làm rách quần áo thì không có ai sửa cho đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030119,
					"content": "Em biết rồi... Em trốn trước đây, anh cũng mau chơi cùng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "Em trốn trước đi, anh biết mình sẽ trốn ở đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030121,
					"content": "#Thật à? Anh lại khoác lác... chắc chắn sẽ bị {M#anh ấy}{F#chị ấy} tìm ra đầu tiên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurele và Verut đã chia nhau đi trốn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "Không sao, không phiền phức gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "#Chắc {M#anh}{F#chị} sẽ không tìm được em đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
