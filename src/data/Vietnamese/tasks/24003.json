			"dialogs": [
				{
					"id": 240030701,
					"content": "Verut khi nào mới hiểu chuyện hơn đây, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030702,
					"content": "Em không trốn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "Vốn dĩ em không muốn chơi lắm. Nếu không phải Verut đòi ra ngoài chơi trốn tìm thì em còn đang muốn đọc thêm sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030704,
					"content": "Bố mẹ làm việc rất vất vả, em phải mau chóng trưởng thành... Như vậy mới có thể chia sẻ gánh nặng với họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030705,
					"content": "Nhưng Verut luôn nói rất nhớ mẹ... Em phải cùng em ấy chơi thì em ấy mới không khóc nhè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030706,
					"content": "Xin lỗi, em nói nhiều quá, em đến điểm tập trung đợi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030707,
					"content": "Hy vọng Verut không làm bẩn quần áo...",
					"roleType": "TALK_ROLE_NPC",
