			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "Nơi này lớn quá, nhưng mà... cảm thấy, hơi hoang vắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780102,
					"content": "#Trước đây, Paimon và {NICKNAME}, cùng với nhiều chiến hữu đã chiến đấu với \"Phong Ma Long\" ở nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780103,
					"content": "Đó là loài rồng to to, cánh dài dài, răng nhọn nhọn đáng sợ đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780104,
					"content": "Thực ra cũng không đáng sợ lắm",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "Kichiboushi có còn nhớ tượng Phong Thần trong thành Mondstadt chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780107,
					"content": "Tượng Phong Thần...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780108,
					"content": "Chính là cái tượng đá cao ơi là cao đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780109,
					"content": "Mm! Nhớ rồi, cánh tay của Phong Thần to lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780110,
					"content": "\"Phong Ma Long\" chính là bạn thân của Phong Thần đó! Trước đây Phong Thần cũng đến từ \"thành phố\" này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780111,
					"content": "Wow!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780112,
					"content": "Nhưng mà Phong Phong Long to như vậy thì sao chui vừa cái cổng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780113,
					"content": "Hình như trước giờ chưa gặp qua câu hỏi này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "A, cái này Paimon biết! Là do nó không đi bộ giống chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780116,
					"content": "Kichiboushi hiểu rồi, Phong Phong Long biết bay, nên không cần phải chạy vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780117,
					"content": "Đáng, đáng ghét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780118,
					"content": "Mm? Paimon, hình như không được vui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780119,
					"content": "Hừm... cái này nói sau đi, giờ chụp hình kỷ niệm đã! Kichiboushi, đừng nhúc nhích nha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780120,
					"content": "Kichiboushi sẽ đứng yên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780114,
					"content": "Là \"Phong Ma Long\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "Thực ra trông cũng rất đẹp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
