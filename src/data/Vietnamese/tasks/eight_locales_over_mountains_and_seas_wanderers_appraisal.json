					"nextDialogs": [
						726780302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780302,
					"content": "Kichiboushi sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780303,
					"content": "Nơi này hoang vắng quá, cảm giác hơi khó chịu, không biết tại sao nữa. Kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780304,
					"content": "Tôi cũng cảm thấy vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "Tiếp theo thì chúng ta đi đến trung tâm \"thành phố\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780305,
					"content": "Kichiboushi thật kỳ lạ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
