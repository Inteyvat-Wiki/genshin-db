			"dialogs": [
				{
					"id": 726780401,
					"content": "Mmhuhu... gió lớn quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780402,
					"content": "Chúng ta không vượt qua được tường gió ở đây đâu! Đi đường vòng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780403,
					"content": "Kichiboushi, đi vòng theo mọi người nhé.",
