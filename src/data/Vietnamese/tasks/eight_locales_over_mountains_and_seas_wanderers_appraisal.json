			"dialogs": [
				{
					"id": 726780501,
					"content": "Cuối cùng cũng lên được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780502,
					"content": "Cảnh quan ở đây đẹp hơn ở dưới nhiều. Nhìn xem, bên kia chính là nơi mà chúng ta đến đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780503,
					"content": "Paimon thích chỗ cao lắm đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780504,
					"content": "Chỗ cao thì phong cảnh đẹp, bay cũng tiện.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "Phong Phong Long ngủ ở trên tòa tháp này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780508,
					"content": "Ừm, đã ngủ ở đây rất lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780509,
					"content": "#Tuy {NICKNAME} chiến đấu với \"Phong Ma Long\" nhưng nó không phải là một con rồng hư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780510,
					"content": "Nó chỉ là bị thương, bị kẻ xấu lừa gạt nên mới nghĩ rằng Phong Thần sẽ rời bỏ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780511,
					"content": "Mm... sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780512,
					"content": "#Sau đó thì... {NICKNAME} có nhớ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780513,
					"content": "Chúng ta đã chiến đấu với nó, thanh tẩy \"máu độc\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "Nhưng mà, chỗ chiến đấu cũng đã sụp đổ, vốn dĩ mọi người và Phong Thần cũng sẽ rớt xuống chỗ rất sâu rất tăm tối rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780515,
					"content": "#Mm! Đáng sợ quá... vậy Paimon và {NICKNAME} phải làm sao? Bay ra hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780516,
					"content": "Là Dvalin đã cứu mọi người, dẫn mọi người bay ra ngoài.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "D...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780518,
					"content": "Là \"Phong Ma Long\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780520,
					"content": "#\"Phong Ma Long\" cũng có tên của mình, giống như Kichiboushi, Paimon và {NICKNAME} vậy. Nó tên là Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780521,
					"content": "Ban đầu, Dvalin bị thương, bị kẻ xấu lừa gạt, nên rất tức giận, lại còn đến làm loạn Mondstadt nữa. Mọi người đều cảm thấy nó là một con rồng hư, nên mới gọi nó là \"Phong Ma Long\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780522,
					"content": "Sau đó, mọi người tiêu diệt kẻ xấu, thanh tẩy máu độc cho nó, nó mới hiểu rằng, Phong Thần không có bỏ rơi nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780523,
					"content": "Ồ! D... Phong Phong Long là rồng ngoan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780524,
					"content": "Đúng vậy! Cho nên hôm nay Paimon đưa Kichiboushi đến đây là để kể cho Kichiboushi nghe về chuyện của Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780525,
					"content": "Sau khi Kichiboushi trưởng thành, có thể sẽ bị hiểu lầm, chịu tổn thương, gặp phải những chuyện khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780526,
					"content": "Nhưng mà, tuyệt đối không được trở thành người xấu. Bởi vì, \"hướng gió rồi sẽ thay đổi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780527,
					"content": "Rồi sẽ có ngày, gió sẽ thổi về ánh bình minh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780529,
					"content": "Hình như hơi khó hiểu với Kichiboushi đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "Hình như hiểu rồi, nhưng cũng hình như chưa hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780531,
					"content": "#Nhưng mà quan trọng là, Kichiboushi sẽ không quên câu chuyện mà Paimon và {NICKNAME} kể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780532,
					"content": "Ừm! Vậy thì không tốn công Paimon ngồi kể chuyện nãy giờ rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780533,
					"content": "Nhưng mà, Kichiboushi cũng không nên quá ham chơi, quá tinh nghịch, nếu không sẽ bị phong ấn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780534,
					"content": "Chuyến tu luyện lần này của Kichiboushi cũng sắp kết thúc rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "Mmhuhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780537,
					"content": "Đừng buồn quá! Phải cười lên chứ, như vậy thì Ioroi mới vui được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780538,
					"content": "#Được rồi, Paimon và {NICKNAME} cũng nên hoàn thành trách nhiệm cuối cùng của mình thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780539,
					"content": "Đó là, dẫn Kichiboushi về chỗ của Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780540,
					"content": "Chúng ta đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "Mm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780541,
					"content": "Chúng ta đi thôi, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "Ủy thác của Ioroi xem như đã hoàn thành rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "Phong Ma Long đã cứu mọi người, dẫn mọi người bay ra ngoài.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "\"Ngốc nghếch...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "Ê! Có phải thế đâu, chỗ cao thì phong cảnh đẹp, khi bay cũng sẽ dễ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
