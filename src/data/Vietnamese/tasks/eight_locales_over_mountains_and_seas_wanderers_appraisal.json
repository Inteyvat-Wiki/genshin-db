			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "Ioroi, chúng tôi về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790102,
					"content": "Về rồi sao! Kichiboushi, hành trình tu luyện thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790103,
					"content": "Kacha kacha, bum bum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790104,
					"content": "Mmhahaha, không tệ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790105,
					"content": "Ối, lại nghe không hiểu Kichiboushi nói gì rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790106,
					"content": "Chúng tôi đã chụp rất nhiều hình này. Ioroi, xem thử đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790107,
					"content": "Đưa từng bức hình trong chuyến hành trình dài cho Ioroi xem\\nĐồng thời kể những chuyện xảy ra trên đường cho Ioroi nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "...Như vậy là chúng tôi đã hoàn thành yêu cầu \"dẫn Kichiboushi đi 8 nơi tu luyện\" của Ioroi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790109,
					"content": "Ừm! Không hổ danh là người mà ta chọn, không tệ đấy. Nếu như các ngươi là tanuki thì nhất định sẽ trở thành Bake-Danuki danh chấn thiên hạ. Cộng lại chắc cũng mạnh bằng một nửa ta đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790110,
					"content": "(Nghe thấy chả mạnh gì cả...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790111,
					"content": "Giờ nhiệm vụ cũng đã hoàn thành rồi, chúng tôi đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790112,
					"content": "Mmhuhu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790113,
					"content": "Được rồi, đừng vậy mà. Paimon sẽ dạy cho Kichiboushi thêm một chuyện nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790114,
					"content": "Phải nở nụ cười khi tạm biệt bạn bè! Có như vậy thì sau này gặp lại sẽ càng vui mừng hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790115,
					"content": "...Ừm? Được rồi, chuyện này cứ giao cho ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790116,
					"content": "Kichiboushi nói là, \"Biết rồi, lông trắng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790117,
					"content": "Hả? Không lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790118,
					"content": "Kichiboushi lại không thể nói chuyện rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "Thời gian dài như vậy, có lẽ cơm Bake-Danuki cũng đã hết tác dụng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790121,
					"content": "Hứ, nếu như ta không bị phong ấn vào trong tảng đá, thì việc khiến cho các ngươi luôn nghe hiểu ngôn ngữ tanuki cũng dễ như...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790122,
					"content": "...Ừm? Được rồi, ta sẽ giúp ngươi truyền đạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790123,
					"content": "\"Kichiboushi muốn cố gắng tu luyện.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790124,
					"content": "\"Biến thành Bake-Danuki mạnh mẽ như Ioroi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790125,
					"content": "...Mm? Tên nhóc này khẩu khí lớn đấy. Hmhaha, rất có khí chất năm xưa của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790126,
					"content": "\"Như vậy thì, lông trắng, lông vàng sẽ không cần phải ăn cơm Bake-Danuki cũng sẽ có thể hiểu được lời Kichiboushi nói.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790127,
					"content": "...Ừm! Paimon sẽ đợi, lần sau nhất định sẽ đi tu luyện với Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790128,
					"content": "Kichiboushi cố lên nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "Đừng để bị người ta phong ấn đó nha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "Mm?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790131,
					"content": "Mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790132,
					"content": "Kệ vậy, niệm tình các ngươi dẫn Kichiboushi đi tu luyện, ta không tính toán với các ngươi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790133,
					"content": "Đúng rồi, trước đây có một người tên Utamarou, hắn đến Rừng Chinju để vẽ hình tanuki bị phong ấn, lại còn để lại một bức tranh nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790134,
					"content": "Giao cho các ngươi đó, nếu muốn ngắm những con tanuki thông minh lanh lợi thì cứ mang bức tranh này ra ngắm nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790135,
					"content": "Haiz, nếu như các ngươi là tanuki thì tốt biết mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790136,
					"content": "...Nếu là vậy thì chúng tôi cũng sẽ bị phong ấn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "Hứ, cũng đúng. Thôi không có chuyện gì nữa thì đi đi, ta còn phải dạy pháp thuật cho Kichiboushi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790119,
					"content": "Chúng ta lại nghe không hiểu Kichiboushi nói rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
