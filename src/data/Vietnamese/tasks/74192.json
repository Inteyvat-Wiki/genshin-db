			"dialogs": [
				{
					"id": 741920301,
					"content": "Nếu như ký ức có thể tạo thành sách, vậy thì ngược lại, nội dung trong sách, chắc cũng có thể trực tiếp viết vào trong ký ức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#À, là người kỳ quái {NICKNAME} hả? Tìm tôi có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "Cô đang nói gì thế...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Chà, dù sao thì việc biến \"ký ức\" thành sách là điều không thể tưởng nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "Người tạo ra quyển sách này, hẳn đã coi tâm trạng trong \"hồi{RUBY#[D]vọng tưởng} ức\" là điều quý giá nhất, mới có thể tạo ra được một quyển sách giống như thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "Chỉ là loại sách như thế này, thật sự rất khó hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "Hơn nữa, sẽ tạo thành ảnh hưởng thế nào đối với \"người đọc\", cũng không biết chắc được. Thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
