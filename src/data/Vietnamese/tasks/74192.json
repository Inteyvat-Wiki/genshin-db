			"dialogs": [
				{
					"id": 741920101,
					"content": "Tôi nhìn thấy: Ngọn lửa trên ngai vàng đã tắt, tro tàn cháy lại biến thành cây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "Những bông hoa nở rộ theo từng bước chân, bạn sẽ mang lại sự thay đổi cho một tương lai chắc chắn sẽ suy tàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Ấy... Sao {NICKNAME} lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "À, đúng rồi! Bươm bướm vàng đã trở về rồi, phải nhanh chóng đi xem mới được! Tạm biệt nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
