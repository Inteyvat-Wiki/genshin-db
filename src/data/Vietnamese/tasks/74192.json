			"dialogs": [
				{
					"id": 741920201,
					"content": "Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920202,
					"content": "Canotila...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "Ấy? Ai thế? Tôi còn tưởng là ngoài tôi ra sẽ không ai vào được đây chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920204,
					"content": "Sao lại biết tên tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920205,
					"content": "Chúng ta quen biết nhau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "Nói dối! Giống như những con quái vật kia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920207,
					"content": "(Nói dối) Serene bảo tôi tới tìm cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "Vậy hả... Tôi lúc nào cũng làm cô ấy lo lắng, tôi đúng là đứa trẻ hư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920209,
					"content": "#Tôi là {NICKNAME}, cô có còn nhớ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#{NICKNAME}, tôi nhớ ra rồi... Tuy là một con quái vật khổng lồ có thể nuốt chửng cả thế giới, nhưng lại rất lương thiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920211,
					"content": "Thật bất lịch sự.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "Xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920214,
					"content": "Đã xảy ra chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "Tôi thấy có vài người, bọn họ dần tan chảy ra, rồi biến thành quái vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920216,
					"content": "Á á! Thật đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920213,
					"content": "Cảm ơn nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
		{
