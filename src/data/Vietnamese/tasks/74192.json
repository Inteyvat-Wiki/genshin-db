				},
				{
					"id": 741920402,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "#Ấy? {NICKNAME} cuối cùng cũng trở lại rồi! Hu hu, tôi lo lắm đó, nhỡ {NICKNAME} không quay lại nữa thì phải làm sao đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920404,
					"content": "#Sau khi {NICKNAME} vào đó, tôi vẫn luôn đợi ở đây, đợi rất lâu đó. Tôi thử đi tìm Melusine khác giúp đỡ, nhưng mọi người đều không biết phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920405,
					"content": "(...Cỏ vẻ như mình đã lưu lại đây đã lâu quá rồi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "Tôi phải đi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#Hả? {NICKNAME} định đi đâu thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920408,
					"content": "Đừng lo lắng. Tôi tìm được Canotila sẽ trở về thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "Đợi tôi thêm chút nữa nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "Tuy biết nói điều này cũng vô ích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "Nhưng mà, hãy tin tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920412,
					"content": "Không cần lo lắng.",
					"roleType": "TALK_ROLE_PLAYER",
