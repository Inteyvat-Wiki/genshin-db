			"dialogs": [
				{
					"id": 761000701,
					"content": "Tránh đường ra, cút đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Haha... Ngươi vội cái gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000703,
					"content": "Dù sao... các ngươi sớm muộn gì cũng phải chết thôi... chỉ là... có người phải đi trước một bước rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000704,
					"content": "Hắn chẳng phải đang oán hận... rằng ba năm trước hắn chưa chết sao... Giờ thì... ta sẽ giúp hắn toại nguyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000705,
					"content": "...Bjorn? Ngươi đã làm gì anh ấy vậy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "Là do hắn quá yếu... Kẻ yếu... Phế vật... Sâu bọ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000707,
					"content": "...Chết thì có gì là lạ đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000708,
					"content": "Không được phép sỉ nhục anh ấy! Anh ấy không hề yếu đuối chút nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Ồ... Thì ra trong mắt ngươi... hắn ta là kẻ mạnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000710,
					"content": "Nhưng... kẻ mạnh thì cũng phải chết thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000711,
					"content": "Ta còn tưởng... ngươi hiểu rõ điều này lắm chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000712,
					"content": "Những kẻ mạnh hơn ngươi... chẳng phải đều đã chết rồi sao... dù là ba năm trước... hay mười năm trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000713,
					"content": "...Câm cái miệng thối của ngươi lại đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Đúng đó... Hóa ra kẻ yếu đuối... chỉ có mình ngươi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000715,
					"content": "Nếu không thì... tại sao... tại sao lần nào cũng chỉ có mình ngươi sống sót?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000716,
					"content": "...Là ngươi đã đào tẩu khỏi chiến trường đúng không? Kẻ hèn nhát tham sống sợ chết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Âm Thanh Từ Ma Vật"
				},
				{
					"id": 761000717,
					"content": "Illuga! Đừng nghe những lời nói bậy bạ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "Đừng nhiều lời nữa, nộp mạng đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#...{NICKNAME}! Chúng ta tốc chiến tốc quyết thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
