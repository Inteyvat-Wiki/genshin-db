			},
			"dialogs": [
				{
					"id": 761001601,
					"content": "...Bjorn thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001602,
					"content": "...Bị thương rất nặng. Đòn tấn công đến quá đột ngột, anh ấy vì bảo vệ chúng tôi... Hu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001603,
					"content": "...Môi trường chiến trường quá nguy hiểm, anh ấy cũng không chịu nổi việc di chuyển nữa, chúng tôi chỉ có thể xử lý khẩn cấp tại chỗ, nhưng với khả năng hiện tại của chúng tôi, thực sự là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001604,
					"content": "...Đội Trưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001605,
					"content": "Bjorn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001606,
					"content": "...Xin lỗi... tôi đã không thể hoàn thành nhiệm vụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001607,
					"content": "Anh đã làm rất tốt! Chúng ta đã giữ vững được trận địa, và mọi người đều bình an vô sự...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001608,
					"content": "Vậy sao... hóa ra tôi làm được rồi... tốt quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001609,
					"content": "Đừng nói gì nữa, tập trung dưỡng thương đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001610,
					"content": "Bây giờ không nói... sau này sẽ không còn cơ hội nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001611,
					"content": "...Đây là mệnh lệnh của Đội Trưởng! Tôi không cho phép anh nói những lời như vậy nữa! Anh sẽ không sao đâu... nhất định sẽ không sao đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001612,
					"content": "Hơ... được... tuân lệnh... tôi sẽ không nói nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001613,
					"content": "Nhưng mà... đợi tôi gặp được Veyde... cũng coi như có thể ngẩng cao đầu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001614,
					"content": "Cậu ấy trước đây thường nói... những Người Giữ Đèn chúng ta giống như Cỏ Đông Lăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001615,
					"content": "Đối mặt với Cuộc Săn Hoang Dã... mỗi người chúng ta đều rất mong manh... giống như hoa Cỏ Đông Lăng vậy... sẽ dễ dàng tàn lụi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001616,
					"content": "Nhưng mà... chỉ cần lá vẫn còn... chỉ cần rễ vẫn bám chặt trong lòng đất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001617,
					"content": "Đến mùa sau... mùa sau nữa... sẽ luôn có những đóa hoa mới nở rộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001618,
					"content": "Chúng ta sẽ không thất bại đâu... đúng không... Đội Trưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001619,
					"content": "...Ừm! Chúng ta tuyệt đối sẽ không thất bại! Tôi nhất định sẽ đích thân, chôn vùi triệt để ma vật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001620,
					"content": "...Cậu là người mạnh nhất trong số chúng tôi... Tôi tin cậu... Đội Trưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001621,
					"content": "...Yên tâm đi, Bjorn, tôi nhất định sẽ giữ lời hứa. Anh nên nghỉ ngơi đi... đợi vết thương của anh lành rồi, mọi chuyện sẽ ổn thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001622,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001623,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001624,
					"content": "#...{NICKNAME}, Paimon, chúng ta phải đi thôi. Nhiệm vụ vẫn chưa kết thúc, chúng ta không thể chậm trễ ở đây được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "Illuga"
				},
				{
