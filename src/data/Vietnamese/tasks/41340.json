			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "Phiền bạn rồi, thuốc đã được gửi đi hết rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400402,
					"content": "Có cảm giác họ sẽ bị bệnh tiếp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "Hết cách rồi, nếu không chú ý thói quen sinh hoạt thì rất khó để trị dứt, nên chỉ có thể bệnh lần nào chữa lần nấy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400405,
					"content": "Nhưng giờ tôi có thể thở phào nhẹ nhõm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400406,
					"content": "Về chuyện Đèn Tiêu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "Thả Đèn Tiêu? Chúng tôi... thường sẽ không thả. Thả Đèn Tiêu là phải cầu nguyện, \"Nhà Thuốc Bubu\" thì có thể cầu cái gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400408,
					"content": "Thương nhân thì có thể cầu làm ăn phát đạt, nhưng chữa bệnh cứu người thì không thể mong có thêm nhiều người bệnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400409,
					"content": "Gui đúng là một người tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "Nhưng bản thân tôi vẫn muốn thả đèn, dù sao thì đây vẫn là ngày lễ lớn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400412,
					"content": "Nhưng bữa giờ tôi bận quá, vẫn chưa làm xong Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
