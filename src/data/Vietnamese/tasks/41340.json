			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "Không biết có phải đã ăn trúng thứ gì đó không sạch sẽ không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400202,
					"content": "Về thuốc của Gui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "A! Cảm ơn, đây chính là thuốc của Gui chuyển đến sao? Tôi đúng là có chút vấn đề về tiêu hóa, bụng cứ thấy khó chịu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400204,
					"content": "Thực ra tôi cũng chỉ đi dạo xung quanh, vừa đi vừa ăn, không để ý nên đã ăn hơi quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400205,
					"content": "Bạn đã ăn cái gì rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "Ừm... cơm chiên, sushi, trái cây, một thau tôm, với uống chục chai rượu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400207,
					"content": "Bị vậy cũng đúng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "Vậy nên mới phải uống thuốc đó. Nhưng bạn nghĩ xem, nếu cả ngày lễ mà cái này cái kia cũng không được ăn thì còn gì là không khí lễ hội nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400210,
					"content": "Dù sao thì cũng cảm ơn thuốc của bạn, tôi sẽ chú ý sức khỏe hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400208,
					"content": "Dù là ngày lễ cũng không nên buông thả như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
