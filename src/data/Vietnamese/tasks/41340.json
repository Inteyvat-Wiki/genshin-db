				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "Xin lỗi, làm phiền bạn trong dịp lễ này quá, người bệnh của Nhà Thuốc Bubu đang tăng mạnh, tôi thực sự đang rất thiếu nhân lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400102,
					"content": "Tại sao lại như vậy ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "Ngày lễ lớn như vậy, mọi người đều gác lại công việc để đi thăm người nhà, đương nhiên sẽ không thể thiếu những bữa tiệc, thức ăn ngập tràn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400104,
					"content": "Mà như vậy thì sẽ gây ảnh hưởng xấu cho hệ tiêu hóa, cũng sẽ có thể gây ra một số loại bệnh khác ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400105,
					"content": "Tuy tôi hay khuyên mọi người \"đừng nên ăn uống quá độ\", nhưng trong ngày lễ như vậy có lẽ không có mấy tác dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400106,
					"content": "Vừa nãy lại có người nhà liên lạc với tôi, bảo tôi đi giao thuốc dạ dày, chữa bệnh khó tiêu. Nhưng cũng không thể mặc kệ công việc của Nhà Thuốc Bubu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "Gui"
				},
				{
					"id": 413400107,
					"content": "Nhà Lữ Hành, nếu có thể thì phiền bạn đi giao thuốc giúp tôi được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gui"
				}
			]
		},
		{
			"id": 4134002,
			"completionStepIds": [
				4134003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134003",
							"2"
