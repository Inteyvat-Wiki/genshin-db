			"trigger": {
				"objectNames": [
					"Guanhai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "Chậc... thật khó chịu... có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400302,
					"content": "Về thuốc của Gui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "À à, cảm ơn bạn. Là của tôi đặt đó, thật là đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400304,
					"content": "Có thuốc uống thì tốt rồi, tôi nghĩ tôi bị trúng gió khi đi hóng gió biển...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400305,
					"content": "Không phải là có vấn đề về tiêu hóa sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "Bậy! Hệ tiêu hóa của tôi tốt lắm, nói cho bạn biết, ban nãy tôi còn ăn hết ba con cá nướng nữa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400307,
					"content": "Ngay cả bây giờ, tính về chuyện ăn uống, bạn bè xung quanh không ai là đối thủ của tôi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400308,
					"content": "Được rồi, không nói nữa, tôi phải uống thuốc mới được, lát nữa còn có chầu nhậu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400309,
					"content": "Nói chung thì cứ giữ gìn sức khỏe nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "Ha ha, không sao, tôi vẫn còn trẻ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400312,
					"content": "Nhưng cũng cảm ơn ý tốt của bạn, tôi sẽ để ý hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400310,
					"content": "Đến khi bệnh trở nặng thì sẽ phiền phức đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
