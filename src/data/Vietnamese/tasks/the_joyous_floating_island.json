					"nextDialogs": [
						762020906
					],
					"speakerTitle": "Nicole",
					"speakerSubtitle": "Nicole"
				},
				{
					"id": 762020906,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020907,
					"content": "Cụ thể phải nói từ khi thiên sứ được sinh ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020908
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020908,
					"content": "Thiên sứ được giao cho sứ mệnh yêu thương muôn loài trên thế gian, nhưng khác với ma thần sau này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020909
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020909,
					"content": "Cảm nhận về tình cảm của chúng tôi không được phong phú lắm, phần lớn là chấp hành mệnh lệnh của bầu trời một cách máy móc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020910
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020910,
					"content": "Ngoài \"giáo hóa\", thì \"chỉ dẫn\" là nhiệm vụ quan trọng nhất của chúng tôi, nó cũng trở thành một trong số ít bản năng còn sót lại sau khi những đồng nghiệp trước đây mất đi trí tuệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020911
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020911,
					"content": "Khi nhiệm vụ này được hoàn thành, chúng tôi sẽ cảm nhận được niềm vui nhẹ nhõm nào đó, đây đã là trải nghiệm cảm xúc mãnh liệt nhất mà chúng tôi có thể tìm thấy trong cuộc sống thường ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020912
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020912,
					"content": "Vậy chẳng phải... hơi đáng thương sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020913,
					"content": "Có lẽ vậy, nhưng tôi không muốn coi đó là việc đáng thương hại, dù sao thì, ngay cả chúa tể trời cao cũng không thể phủ nhận sự chân thực của cảm xúc trong lòng tôi lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020914
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020914,
					"content": "Dù thế nào, chúng tôi cũng đã hoàn thành một việc tốt, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
