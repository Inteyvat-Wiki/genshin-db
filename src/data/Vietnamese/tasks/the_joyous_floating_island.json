			"dialogs": [
				{
					"id": 762020901,
					"content": "Nói chứ, rõ ràng là tặng đồ cho chúng ta, sao Nicole lại hào hứng như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020902,
					"content": "#Ý tôi là, khi tôi tặng quà cho {NICKNAME} thì tôi cũng sẽ mong chờ phản ứng của {M#cậu ấy}{F#cô ấy}, nhưng trạng thái của Nicole có vẻ hơi khác một chút nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020903,
					"content": "Chuyện này có thể hỏi không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020904
					]
				},
				{
					"id": 762020904,
					"content": "Không sao, tôi không ngại đâu. Cùng lắm là khiến mọi người có chút vỡ mộng về tộc thiên sứ, từ việc nghĩ rằng thiên sứ đều là người tốt đến hiểu ra sự thật thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020905
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020905,
					"content": "Điều mà Paimon nhắc đến, thực chất không phải vì chúng tôi có thể đồng cảm với đối tượng được dẫn dắt, mà là do nhiệm vụ và mệnh lệnh mà chúng tôi phải gánh vác.",
