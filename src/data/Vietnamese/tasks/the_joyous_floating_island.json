			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "Một làn gió lướt qua.\\nThật kỳ lạ, nó có hương vị của Cuộn Quả Mọng, Bánh Torte Sồi Hè, Thịt Nướng Giòn Rụm và Kẹo Hoa Quả Thảo Mộc.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "Ối! Đột nhiên có một làn gió rất ngọt vụt qua cổ họng, khụ khụ khụ... Ơ? Chúng ta đang ở đâu vậy? Ấm trà và tách trông to quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020303,
					"content": "Hay là... chúng ta bị thu nhỏ lại rồi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020304,
					"content": "Có vẻ như là phép thuật của Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "Rất tiếc, tôi không mời được diễn viên động vật tương ứng, bình thường tôi chỉ tiếp xúc với diễn viên bằng đá thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020306,
					"content": "Hả? Nicole cũng biến nhỏ rồi à, tôi tưởng cô sẽ biến lớn lên chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020307,
					"content": "Nicole, ma nữ vĩ đại ngồi xổm mà vẫn có thể chạm tới bầu trời? Thôi bỏ đi, tôi đã rất hài lòng với hình dáng hiện tại của mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
