					"speakerTitle": "Nicole"
				},
				{
					"id": 762020308,
					"content": "Tóm lại, chào mừng gia nhập tiệc trà của ma nữ vĩ đại! Bây giờ, rót thêm trà đi!",
					"roleType": "TALK_ROLE_NPC",
