			"dialogs": [
				{
					"id": 762020201,
					"content": "Rất hân hạnh được đón tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020202,
					"content": "Xin chào, Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "Woa, căn nhà thật lộng lẫy và sang trọng, cô trang trí đẹp quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020205,
					"content": "Haha, đúng là có mắt nhìn, không uổng công tôi giành thời gian để tỉ mỉ thiết kế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020206,
					"content": "...Cụ thể thì phải kể từ ngày căn nhà bí mật này được xây dựng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020207,
					"content": "Tôi vốn định tranh thủ lúc đang tiện tay xây thêm vài căn nhà ma nữ, nhưng không ai giúp tôi mang đến cảm hứng mới, lâu dần lại thấy chán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020208,
					"content": "\"Chẳng lẽ không có cách nào vừa thú vị vừa vui, mà còn mang lại cảm giác thành tựu sao?\" Câu trả lời chợt lóe lên trong tâm trí tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020209,
					"content": "Đợi đã, trực tiếp nhảy đến câu trả lời rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020210,
					"content": "Nói là làm. Đây, nó ở ngay trước mắt hai người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020211,
					"content": "Sau cánh cửa này ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020212,
					"content": "Thật ra không chỉ có cánh cửa này, nhưng cũng không sai, dù sao cũng phải có thứ tự trước sau. Vậy thì bắt đầu từ nó nhé, chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020213,
					"content": "Đ... Đợi đã, cô nói nhanh quá, tôi có chút không theo kịp... Cô muốn chúng tôi chuẩn bị gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020214,
					"content": "Ừm, đừng căng thẳng, không cần chuẩn bị gì đâu. Tôi chỉ hỏi cho có thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020215,
					"content": "Theo quan sát và hiểu biết của tôi về hai người... so với việc giải thích phức tạp từ trước, thì hai người thích tìm kiếm niềm vui từ quá trình khám phá hơn đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020216,
					"content": "Cũng không sai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "Haha, câu này tôi thích nghe, vậy tôi sẽ không khách sáo nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020219,
					"content": "#{NICKNAME} đúng là hiểu thiên sứ chúng tôi mà, luôn không thể cưỡng lại cảm giác thỏa mãn khi dẫn dắt người khác tìm kiếm kho báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020220,
					"content": "Đều là giúp đỡ người khác, làm điều tốt, sao có thể không nghĩ cho bạn bè của mình trước chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020221,
					"content": "Vì thế tôi nảy ra một ý tưởng, biến căn nhà nhỏ này thành nơi vui chơi giải trí cho mọi người, còn giấu báu vật vào trong mỗi căn phòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020222,
					"content": "Không giấu gì, nhưng trong vô vàn thiên sứ, thì tôi cũng được tính là một cao thủ giấu đồ đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020223,
					"content": "Nếu tôi thực sự nghiêm túc đi chôn rương báu mà không dẫn đường cho hai người, e rằng mất mấy tháng thì hai người cũng không tìm ra được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020224,
					"content": "Khụ khụ, lạc đề rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020225,
					"content": "Tóm lại, tôi sẽ không cố tình làm khó mọi người, cũng không cần mọi người phải vì sở thích nho nhỏ của tôi mà chạy ngược chạy xuôi ở mấy nơi hoang vu hẻo lánh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020226,
					"content": "Chỉ cần tìm được ba chiếc lông vũ tượng trưng cho báu vật trong phòng là có thể qua ải! Đến lúc đó, hì hì, nhớ mở rương báu trước mặt tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020227,
					"content": "Giờ thì tôi hiểu hết rồi! Kho báu, tôi không chờ nổi nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020228,
					"content": "Kho báu, tôi cũng không chờ nổi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020217,
					"content": "Nhưng mà vẫn muốn nghe Nicole giải thích thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "Rất vinh hạnh được làm khách ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
