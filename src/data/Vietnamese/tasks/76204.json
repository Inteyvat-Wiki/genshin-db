			"dialogs": [
				{
					"id": 762040201,
					"content": "Nicole... Kỳ lạ, ở đây cũng không có ai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040202,
					"content": "Hai người đã đến phòng làm việc của tôi chưa, có thấy hoa cỏ mà tôi thu thập từ khắp nơi về và vun trồng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040203,
					"content": "Haiz, thật không may lúc này tôi không thể qua được, tôi đang bày sạp bán tượng điêu khắc ở Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040204,
					"content": "À... Có cần chúng tôi giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "Đừng, đây là cơ hội duy nhất để tôi cầm bút lên viết, mặc dù đa phần là viết những con số...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040206,
					"content": "Hiếm khi mọi người đến đây, chi bằng cứ chơi trước đi đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040207,
					"content": "Tôi nhớ đã để lại một cuộn giấy bên cạnh bức tượng điêu khắc chim sẻ ở phía tây, mọi người có thấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040208,
					"content": "Nhìn thấy rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040209,
					"content": "Vậy hãy để người dẫn đường lặng im này hỗ trợ nhé, cố lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
