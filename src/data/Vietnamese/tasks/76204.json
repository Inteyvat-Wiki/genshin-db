			"dialogs": [
				{
					"id": 762040301,
					"content": "Chúc mừng mọi người. Để tôi xem... như thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Khác với Khu Vườn Ma Nữ bây giờ, đây là thần điện tôi từng ở thời còn là thiên sứ, tôi đã sống ở đó một thời gian rất dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "Nhiều thiên sứ quá, hơn nữa Nicole trông rất được yêu thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "Không phải tôi khoe đâu, nhưng bạn bè rất thích nghe tôi kể chuyện, nhất là những câu chuyện về việc đồng hành cùng con người, gieo rắc điềm báo, dẫn dắt họ xây dựng nền văn minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Mỗi lần kể đến đoạn gay cấn, các thiên sứ ở đó đều nín thở lắng nghe, ngay cả dây đàn cũng ngừng rung, cọ vẽ cũng thôi chuyển động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "Sau đó, những màu sắc đan xen nở rộ. Hòa cùng tiếng nhạc, ánh sáng vàng óng bao trùm vạn vật, đó chính là khúc ca hân hoan và niềm vui của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "Nghe có vẻ rất tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Đúng là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "Mặc dù những điều tốt đẹp xưa kia đã hoàn toàn biến mất, nhưng cuộc sống hiện tại luôn đầy những bất ngờ thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Có kẻ nào đó thấy tôi đang đọc báo mà muốn trộm tác phẩm điêu khắc của tôi? Hắn tiêu đời rồi! Hôm nay tôi sẽ chỉ dẫn cho hắn đường đến Pháo Đài Meropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Có kẻ nào đó thấy tôi đang đọc báo mà muốn trộm tác phẩm điêu khắc của tôi?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "Hắn tiêu đời rồi!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "Hôm nay tôi sẽ chỉ dẫn cho hắn đường đến Pháo Đài Meropide!",
					"roleType": "TALK_ROLE_NONE",
