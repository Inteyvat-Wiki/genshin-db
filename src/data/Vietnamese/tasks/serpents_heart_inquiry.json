			"dialogs": [
				{
					"id": 722490201,
					"content": "Tốt! Ngươi chắc chắn sẽ làm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490202,
					"content": "Cầu xin ngươi, hãy mang những cống phẩm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490203,
					"content": "...Hãy mang những cống phẩm đó đi, mang đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490204,
					"content": "Mang đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490205,
					"content": "Chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490206,
					"content": "Giọng của ông chú linh hồn càng ngày càng mơ hồ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490207,
					"content": "Mang đến... nơi cúng tế... hồn phách quay về, như vậy mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490208,
					"content": "Ông chú linh hồn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490209,
					"content": "Mới có thể... mới có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490210,
					"content": "Như vậy mới thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490211,
					"content": "Như vậy mới có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490212,
					"content": "Hừm, không rõ ràng gì cả, nhưng mà ban nãy ý của ông chú linh hồn hình như là mang những cống phẩm này đến đâu đó thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490213,
					"content": "Nhưng cống phẩm này đặt ở đây lâu quá rồi, không biết còn thứ gì đó ăn được không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490214,
					"content": "Đừng ăn vụng đó nha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "Tôi, tôi có phải cái gì cũng ăn đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490216,
					"content": "#Được rồi, {NICKNAME}, lấy những cống phẩm này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
