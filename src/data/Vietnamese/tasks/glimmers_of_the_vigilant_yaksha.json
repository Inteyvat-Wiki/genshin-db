			"dialogs": [
				{
					"id": 111010701,
					"content": "Làm sao có thể... Bách Vô Cấm Kỵ Lục sao lại không có hiệu quả chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111010702,
					"content": "Tà khí trên người những Hilichurl lại mạnh hơn rồi ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111010703,
					"content": "Bách Vô Cấm Kỵ Lục... hình như nghe hơi quen quen nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "Có thể tự do ra vào Tuyệt Vân Gián...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "Đúng rồi, là thứ đó! Tín vật của Tiên nhân, bên trên nhất định còn sót sức mạnh của Tiên nhân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "Chẳng trách lần trước anh ta có thể dùng thứ này đuổi quái vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "#{F#Cô}{M#Cậu}... hai người đang thì thầm cái gì, đây chẳng qua vì bổn tiên chưa ngủ đủ giấc... Tiên lực chưa thể thông suốt lục mạch mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111010709,
					"content": "Nếu lại cho ta một cơ hội nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111010710,
					"content": "Lại có Hilichurl đi về phía đó, lần này có thể giao cho ngài không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "Ta... bổn, bổn tiên bỗng thấy không khoẻ, chắc chắn do vừa nãy bổn tiên hao tổn quá nhiều sức mạnh, nếu không thì cũng dư sức tiêu diệt đám yêu tà này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Tinh Nguyệt Thiên Quân"
				},
				{
					"id": 111010712,
					"content": "Haiz... quả nhiên là vua chém gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
