				"points": []
			},
			"dialogs": [
				{
					"id": 735190101,
					"content": "Thật là khó hiểu... Rõ ràng cô ấy nói muốn đến quán cà phê viết báo cáo mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190102,
					"content": "Sao lại ở đây một mình?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "Haiz, thôi đừng nhắc, cô ấy đi viết báo cáo một mình rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190105,
					"content": "Hôm qua chúng tôi hẹn gặp nhau ở quán cà phê, nhưng đợi rất lâu cô ấy mới xuất hiện, thậm chí là tài liệu và giấy bút để viết báo cáo cũng không đem theo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190106,
					"content": "Tôi đã phê bình cô ấy không nên lãng phí thời gian viết báo cáo, kết quả là đột nhiên cô ấy nổi giận! Nói cái gì mà báo cáo một mình cô ấy viết là được rồi, xong còn đuổi tôi đi nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190107,
					"content": "Thật là vô lý! Bạn nói có đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190108,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "Haiz, nhưng mà cái tính giận tới giận lui này của cô ấy tôi cũng quen từ lâu rồi, qua vài ngày sẽ bình thường lại thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190110,
					"content": "Nếu tâm trạng của cô ấy cũng đơn giản như cơ quan thì tốt biết mấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190111,
					"content": "Chúc may mắn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "Hử? Sao cả bạn cũng nói chuyện kiểu kỳ lạ thế... Thôi bỏ đi, mà nói chứ, số Wenut bị ảnh hưởng ở xung quanh đây, tuy rằng cứ bỏ mặc thì cũng từ từ giảm bớt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190114,
					"content": "Nhưng vì để ngăn chúng gây uy hiếp đến người đi đường ở khu vực này, nếu có thời gian bạn hãy giúp đỡ giải quyết chúng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190115,
					"content": "Sẵn tiện nhắc luôn, bây giờ môi trường nguyên tố và thiết bị nạp năng lượng đều đã khôi phục bình thường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190116,
					"content": "Nếu muốn trải nghiệm công suất tối đa của Pháo Diệt Wenut thì bây giờ là cơ hội tốt nhất đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190112,
					"content": "Hãy cầu may đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "Shriya đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
