			"dialogs": [
				{
					"id": 766580101,
					"content": "Chào Ginette, những con robot tìm về lần trước đều đã sửa lỗi xong rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580102,
					"content": "Ừm, may nhờ có các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580103,
					"content": "Nói mới nhớ, chúng tôi quả thực có vài phát hiện mới đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580104,
					"content": "Thật sao? Kể cho tôi nghe đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580105,
					"content": "Bạn và Paimon kể lại cho Ginette những gì đã thấy không lâu trước đó.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "Biểu hiện này... Những con robot đó dường như rất thích các vị, và đã gửi lời mời \"cùng chơi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580107,
					"content": "Thật sao? Thú vị quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580108,
					"content": "Hmm... Quả nhiên là vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580109,
					"content": "Ginette, lại phát hiện ra gì nữa à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580110,
					"content": "Bây giờ tôi có thể chắc chắn rồi, ý tưởng của tôi cần được thực hiện thông qua sự tương tác giữa các robot. Càng tìm nhiều robot về thì càng gần với ý tưởng ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580111,
					"content": "Bây giờ chúng đã có khả năng giao tiếp với người khác, chỉ cần tìm đủ những con robot còn lại thì... ý tưởng của tôi vẫn khả thi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580112,
					"content": "Chà, nghe hay thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580113,
					"content": "Ah, ngại quá, vẫn phải nhờ cậy các vị rồi. Khu vực tiếp theo tôi cũng đã đánh dấu trên bản đồ rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580114,
					"content": "Vậy thì mau xuất phát thôi. Tôi bắt đầu tò mò không biết cuối cùng những con robot này sẽ trở thành như thế nào rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}