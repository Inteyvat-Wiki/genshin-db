			"dialogs": [
				{
					"id": 747050101,
					"content": "...Tôi nghĩ là con này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050102,
					"content": "Có lý đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050103,
					"content": "Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050104,
					"content": "Nhìn màu sắc ở phần đuôi đi, cả bể không có con nào thời thượng hơn nó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050105,
					"content": "Tuy màu sắc hơi chói, nhưng thôi được, coi như cô đang khen tôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050106,
					"content": "Woa! Đông người quá! Mọi người đều đến đây tham quan thủy cung à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050107,
					"content": "Ừm, vừa mới quay xong một cảnh, tranh thủ giờ nghỉ tới đây thưởng thức chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050108,
					"content": "Mọi người đang nói chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050109,
					"content": "Chúng tôi đang xem con cá nào giống Chiori nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050110,
					"content": "Sao mọi người cũng...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050111,
					"content": "À... Haha, hình như lúc trò chuyện có nghe cô Columbina nhắc đến chủ đề tương tự, thấy khá thú vị nên chúng tôi cũng bất giác hòa nhập theo luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050112,
					"content": "Hóa ra cái này còn lan truyền được nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050113,
					"content": "Ồ! Con đó giống cô đấy, Chevreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050114,
					"content": "Tại sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050115,
					"content": "Cứ rảnh rỗi là bơi quanh bể, đang tập luyện đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050116,
					"content": "...Trong mắt cô, tôi là người như vậy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
