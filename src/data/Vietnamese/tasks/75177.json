			"dialogs": [
				{
					"id": 751770101,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770102,
					"content": "#Chà, {REALNAME[ID(2)|SHOWHOST(true)]} lấy được cái máy ảnh này từ đâu thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770103,
					"content": "Chẳng lẽ là nhân lúc người khác không chú ý à... Như vậy là không được đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770104,
					"content": "Rrooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770105,
					"content": "Mrrraa... Rawr! Rawr! Groooah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770106,
						751770108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770106,
					"content": "Động tác quen quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770107
					]
				},
				{
					"id": 751770107,
					"content": "Ồ, đây không phải là \"Ngọn Lửa Thịt Hầm\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770110,
					"content": "Hihi, là lúc ở Con Của Tiếng Vang, có một người trong bộ tộc muốn làm đạo diễn nhưng lại để máy ảnh bị ngược... A! Máy ảnh này là mượn từ chỗ anh ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770111,
					"content": "Rawr! Ehrr... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770112,
					"content": "Muốn chụp chung à? Hihi, là ý như vậy đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770113,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770114,
					"content": "Đúng vậy, cùng mạo hiểm lâu như vậy rồi mà chưa chụp chung tấm ảnh nào để lưu niệm cả, lời nguyền trên người nhóc cũng đã được xóa bỏ, có thể lớn lên khỏe mạnh rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770115,
					"content": "#Không biết phải mất bao lâu để lớn lên thành Tepetlisaur trưởng thành đây... Nếu mai sau trở thành một con Tepetlisaur lớn, vậy chẳng phải sẽ không còn thấy được {REALNAME[ID(2)|SHOWHOST(true)]} với dáng vẻ nhỏ xinh nữa sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770116,
						751770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770116,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770117
					]
				},
				{
					"id": 751770117,
					"content": "Hihi, chụp một tấm thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770119,
					"content": "Điều chỉnh xong rồi, đại khái như vầy. Kiểm tra xong rồi, tôi không có để ngược đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770120,
					"content": "Ừm, vậy thì kết thúc đếm ngược thì hét lớn \"Ngọn Lửa Thịt Hầm\" nhé! 3, 2, 1!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770121,
					"content": "\"Ngọn Lửa Thịt Hầm\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770122
					]
				},
				{
					"id": 751770122,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770123,
					"content": "#Như vậy là chụp xong rồi. Nhìn xem, {REALNAME[ID(2)|SHOWHOST(true)]} cũng rất khí thế đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770124,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770125
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770125,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} cầm lấy một trong số những tấm ảnh đó và quay người đi, cẩn thận đặt nó vào trong phần lưng mềm mại, bên dưới lớp vỏ cứng.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770126
					]
				},
				{
					"id": 751770126,
					"content": "#Nhưng mà, {REALNAME[ID(2)|SHOWHOST(true)]} sao đột nhiên lại muốn chụp ảnh thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770127,
					"content": "Groooah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770128,
					"content": "Wroooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770129
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770129,
					"content": "Wroooh... Roooah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770130
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770130,
					"content": "#Ối, sao vậy {REALNAME[ID(2)|SHOWHOST(true)]}? Có chỗ nào không khỏe sao, trông có vẻ không được vui nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770131,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770132
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770132,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770133
					]
				},
				{
					"id": 751770133,
					"content": "Nhóc muốn bắt đầu chuyến phiêu lưu của riêng mình rồi phải không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770134
					]
				},
				{
					"id": 751770134,
					"content": "Ơ, cái gì, chuyến phiêu lưu của riêng mình... Không muốn đi cùng nữa sao? Hic, có phải tôi đã nói gì khiến nhóc giận không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770135,
					"content": "Sau này tôi sẽ không nói nhóc ăn nhiều nữa! Đừng rời đi mà, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770136,
					"content": "Wroooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770137
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770137,
					"content": "...Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770138
					]
				},
				{
					"id": 751770138,
					"content": "Hic... Tôi biết, tôi biết rồi... Rồi sẽ có một ngày nhóc phải trưởng thành, nhóc cũng có nơi mà mình muốn đi đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770139,
					"content": "Nhưng dù là vậy, nói muốn rời đi một cách đột ngột như vậy, tôi vẫn sẽ cảm thấy cô đơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770140,
					"content": "Không sao, sau này vẫn còn gặp lại mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770141
					]
				},
				{
					"id": 751770141,
					"content": "#Thật sao? Sau này, ừm, sau này nếu chúng tôi cần giúp đỡ thì {REALNAME[ID(2)|SHOWHOST(true)]} phải nhanh chóng đến đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770142,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770143
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770143,
					"content": "#Vậy sau này, nếu {REALNAME[ID(2)|SHOWHOST(true)]} gặp phải khó khăn trong chuyến phiêu lưu thì phải tìm chúng tôi ngay, không được liều lĩnh đâu nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770144,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770145
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770145,
					"content": "Còn nữa, không nên ăn nhiều, khi đánh không lại kẻ to xác hơn thì phải kịp thời bỏ chạy. Tuy không nên ăn quá nhiều, nhưng thịt hầm thì vẫn phải ăn đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770146,
					"content": "Sau đó, điều quan trọng nhất, nhất, nhất chính là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770147,
					"content": "Phải lớn lên thật khỏe mạnh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770148
					]
				},
				{
					"id": 751770148,
					"content": "Đúng, phải lớn lên thật khỏe mạnh! Ít nhất cũng phải cao như ba ngọn núi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770149,
					"content": "Rawr! Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770150
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770150,
					"content": "Đúng... Hic, phải có khí thế như vậy! Nhất định, nhất định không được quên chúng tôi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770151,
					"content": "Trong khu rừng yên tĩnh, các bạn cùng nhau thưởng thức Thịt Hầm Hỏa Diệm, rồi sau đó thu dọn doanh trại thỉnh thoảng hay đến này.\\nBạn chuẩn bị một vài đồ lưu niệm cho người bạn sắp một mình bước vào chuyến hành trình. Các bạn nhớ lại tất cả mọi chuyện đã xảy ra trong chuyến đi này, con Yumkasaur nhỏ đã chặn cửa hang, Hải Thú Bồng Bềnh bên bờ biển, và rất nhiều những người có cá tính khác nhau mà các bạn đã gặp ở Natlan...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770152
					]
				},
				{
					"id": 751770152,
					"content": "Còn có... người dùng hoa văn màu vàng kỳ lạ để nói chuyện...\\nPaimon nói: \"Tên đó muốn lợi dụng chúng ta, từ đầu đến cuối cũng chưa từng lộ diện.\"\\nĐiều này khiến bạn nhớ đến cảm xúc phức tạp trong mắt của chú Saurian con khi ở dưới chân Núi Thánh Tollan.\\n...Bây giờ nó vẫn còn nhỏ, nhưng rồi sẽ có ngày trở thành một con Saurian to lớn mạnh mẽ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770153
					]
				},
				{
					"id": 751770153,
					"content": "Sau cùng, nó nhẹ nhàng dùng sừng chạm vào trán Paimon, rồi lại dụi vào lòng bàn tay đang đưa ra của bạn.\\nSau đó, như để khuyên bản thân mình phải kiên định...",
