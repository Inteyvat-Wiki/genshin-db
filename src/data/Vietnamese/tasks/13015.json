			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "Tốt quá, mọi người đã tỉnh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150102,
					"content": "Mọi người đã lần lượt tỉnh lại rồi, khắp nơi trong thành đều báo tin như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150103,
					"content": "Xem ra sự việc đã được giải quyết thuận lợi rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150104,
					"content": "Ừm, tuy là cũng có chút trục trặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150105,
					"content": "Một lát sau chắc sẽ có rất nhiều người vây quanh đây, phiền anh giữ trật tự cho hiện trường nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150106,
					"content": "Tôi cùng họ sẽ đến Giáo Viện, sau đó quay về đây ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
