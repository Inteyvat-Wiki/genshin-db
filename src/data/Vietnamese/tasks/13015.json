				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sitt",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "Là Thảo Thần đại nhân sao, cho hỏi có chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150202,
					"content": "Tôi muốn tra tài liệu học tịch, có phải trong đây đang có một học giả của học viện Kshahrewar đang hôn mê bất tỉnh không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150203,
					"content": "Để tôi xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150204,
					"content": "Một lúc sau.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Thảo Thần đại nhân đợi lâu rồi, đúng là có một vị học giả tên là Benoni đã hôn mê do sử dụng thiết bị Akasha không đúng cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150206,
					"content": "Cho đến giờ thì anh ta vẫn chưa khôi phục được ý thức, nên đã được chuyển đến Bimarstan để điều trị rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150207,
					"content": "Sao? Hắn ta không phải tên là Moseis sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150208,
					"content": "Chắc là không muốn bị người khác nhận ra thôi, hắn không muốn bị bất cứ ai quấy rầy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150209,
					"content": "Trong đây có chứa tri thức, phiền cô giao nó cho Matra để họ chuyển chúng vào trong não của Benoni nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150210,
					"content": "Được thôi, nhưng vì lý do an toàn, tôi cũng cần phải hiểu rõ nguyên nhân, thưa Thảo Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150211,
					"content": "Trong đây có chứa ý thức của hắn, trước đó hắn đã bị nhốt trong giấc mơ nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150212,
					"content": "Hắn ta trong giấc mơ đã làm ra vài chuyện ảnh hưởng đến trị an của Sumeru. Sau khi hắn tỉnh lại thì tôi sẽ kể rõ sự tình cho Tổng Quản Mahamatra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150213,
					"content": "Tôi hiểu rồi, tôi sẽ đi làm ngay, cảm ơn Thảo Thần đại nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150214,
					"content": "À ừm, không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150215,
					"content": "Chắc là những người tham gia \"Khoảnh Khắc Mơ Mộng\" đều đã tập hợp đầy đủ rồi, chúng ta quay về đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Chúng ta yên lặng làm khán giả là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "Không biết cô ấy định nói gì nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "Xin chào, các cư dân vừa mới tỉnh lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "Tôi rất xin lỗi khi đã quấy nhiễu giấc mơ của mọi người, cách xử lý vấn đề của tôi ở trong giấc mơ có phần lạnh lùng, tôi cũng cảm thấy rất áy náy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "Giấc mơ có sức mạnh rất kỳ diệu, đối với những ai có tâm chí kiên cường thì nó sẽ cổ vũ cho lòng người, chắp cánh cho lý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "Nhưng nó cũng sẽ lợi dụng sơ hở để làm rối loạn nhận thức, đảo lộn tốt xấu... Rất không may, các vị đã bị chọn làm con mồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "Như tôi đã nói trước đó, tôi vẫn đang không ngừng học tập, nên không dám nói là hiểu được nỗi khổ của sự chia ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "Nhưng nếu nhìn khắp xung quanh, những người gặp phải quá khứ tương tự cũng không hề ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "Mọi người nên tự hào rằng chúng ta có thể tụ họp ở đây và cùng nhau hướng về tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "Đường đời rất dài, chúng ta đều rất khó để thấy được đích đến, vì vậy mà cũng sẽ xảy ra rất nhiều vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "\"Tôi sống có ý nghĩa gì? Mục tiêu của tôi là gì? Tại sao tôi lại không ngừng đau khổ như vậy?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "Tất nhiên, việc dừng lại, từ bỏ suy nghĩ và lặp lại những điều bản thân thấy quen thuộc sẽ là lựa chọn tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "Mỗi khi sản sinh ra suy nghĩ này thì phải nghĩ đến người và việc xung quanh bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "Có người vất vả lao động cả ngày để cho bữa cơm mỗi ngày của gia đình có thể phong phú hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "Có người đi khắp nam bắc để tạo ra tác phẩm nghệ thuật chấn động toàn Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "Có người đi tìm bí mật của thế giới để đề phòng những thảm họa chưa từng được biết tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "Bản thân mình không phải là toàn bộ cuộc sống, mỗi một hành động của chúng ta đều sẽ xây dựng cho bản thân và thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "Thân thích bằng hữu sẽ ghi nhớ tất cả những gì chúng ta làm, người xa lạ cũng sẽ từ đó mà cảm thấy biết ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "Chính vì vậy, có rất nhiều người cho dù chịu đựng đau khổ, nhưng vẫn sẽ muốn đi khai phá con đường mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "Khi các bạn cùng đi trên con đường đó, vậy thì đáp án cuối cùng của vấn đề sẽ dần được hé lộ, và cũng trở nên không còn quan trọng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "Nếu mọi người cảm thấy sinh mệnh chính là hư vô, vậy thì nó cũng sẽ dần đi vào hư vô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "Mọi người chọn cách sống một cuộc sống của mình. Thân là thần, tôi cần phải cảnh tỉnh các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "Vẫn từ bỏ giá trị hiện thực để chạy theo giấc mơ đẹp hay không, quyền quyết định nằm trong tay mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "Nahida lợi hại quá, trong giấc mơ tôi còn thấy tôi có phần nói không lại tên học giả đó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "Hắn rất giỏi lợi dụng điểm yếu của người khác, hoặc có lẽ chính hắn cũng đã bị cuốn vào đó rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "Giấc mơ đó có một sức hấp dẫn khó tả, nó ngọt ngào đến mê hồn, người bình thường khó có thể phán đoán rõ ràng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "Nhưng chỉ cần có thể tỉnh lại, dù là khi nào thì cũng không bao giờ là muộn cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "Cô cũng tiến bộ hơn rất nhiều rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "Hả? Sao đột nhiên lại nói vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "Thực ra cô vẫn rất thấu hiểu họ đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "Đúng vậy! Tuy cô nói là cô không hiểu cảm nhận của con người lắm, nhưng chúng tôi lại thấy sự do dự trong ánh mắt của cô đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "Bài diễn thuyết vừa rồi cũng là đứng trên lập trường của họ để nói, rất tốt đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "Cảm ơn các bạn, trên đường tôi có nghe thấy rất nhiều câu chuyện bi thương, nên trong lòng cảm thấy xúc động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "Hành vi của những người bị hại không phải là sai, thứ mà họ muốn có cũng không phải quá đáng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "Cho nên khi họ phản kháng lại chúng ta để bảo vệ cho giấc mơ thì tôi cũng hiểu được sự lựa chọn của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "Nhưng tất cả sự hiểu biết và cảm xúc của tôi có lẽ thậm chí không thể chiếm được dù chỉ một phần trăm nỗi đau mà họ đã trải qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "\"Một phần trăm này\", tôi không dám tự nhận là thấu hiểu hay đồng cảm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "Yêu cầu của Nahida cao thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "Sẽ không thể nào thấu hiểu tuyệt đối cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Hì hì. Được rồi, đúng là phải nên đi đây đi đó thì mới có thể trưởng thành được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "Tình cảm và tri thức hoàn toàn khác nhau, tôi rất khó để dùng ngôn ngữ rõ ràng để miêu tả nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Benoni... hoặc Moseis nói tôi chưa từng trải qua sinh ly tử biệt, nhưng tôi có một loại cảm giác rất mơ hồ nói cho tôi nghe không phải là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "Khi tôi mới vào trong giấc mơ, tôi đã cảm nhận được một luồng hơi ấm êm dịu quấn quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "Tôi có cảm giác như quay về với trạng thái ban sơ của sự sống, và không muốn tỉnh dậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(Không lẽ cô ấy đã thấy gì đó sao?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "Nhưng khi tôi mở mắt ra, cảm giác đó lại biến mất, không hề để lại dấu tích gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "Ví dụ ra thì giống như vết tích được viết bởi bút vậy, tôi không thấy được chữ, nhưng lờ mờ thấy được vết tích trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "Nhưng sau khi trải qua giấc mơ này, tôi đã nghĩ thông suốt rồi, cho dù là hơi ấm đó ám chỉ điều gì đi nữa cũng không còn quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "Điều mà tôi có thể xác định là, tôi từng được sức mạnh của hơi ấm đó bảo vệ mới có thể có được ngày hôm nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "Nếu như quá để ý đến hơi ấm đó đến từ đâu thì cũng như lẫn lộn đầu đuôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "Vừa nãy nói nhiều đạo lý như vậy với người dân, nhưng bản thân lại không làm được, vậy thì không phải mất mặt lắm sao, hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(Đại Vương Rukkhadevata đã dùng hành động của mình để tạo ra Nahida.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Cho dù thế giới đã lãng quên cô ấy, nhưng suy nghĩ và ý chí của Nahida chính là bằng chứng cho thấy cô ấy \"đã từng tồn tại\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(Thay vì nói ra chân tướng, có lẽ mình nên tôn trọng cách nghĩ của họ thì hơn.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Sao rồi? Sao đột nhiên lại trầm tư vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "Tôi thấy bạn đã trầm tư thế này vài lần rồi? Bạn có điều gì muốn nói với tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "Tôi quên mất là mình phải nói gì rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Haha, vậy sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "Vậy thì sau khi ngủ dậy thì hãy vươn vai một cái nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "Một ngày mới đã bắt đầu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "Không quan trọng đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "Nahida nên tự tin hơn chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
