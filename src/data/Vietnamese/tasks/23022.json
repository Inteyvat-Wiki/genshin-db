			"dialogs": [
				{
					"id": 230220101,
					"content": "Nếu tăng thêm sức bền ở đây nữa thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220102,
					"content": "Nếu anh áp dụng thiết kế này thì có khác biệt gì so với trước kia đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220103,
					"content": "Mọi người vẫn đang thiết kế thuyền sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "Là bạn à, Nhà Lữ Hành. Đúng, sau đợt thử thuyền lần trước kết thúc, tôi và Qishan đã bàn bạc lại... điểm mấu chốt trong thiết kế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220105,
					"content": "Sau khi chúng tôi... trao đổi xong, giờ đang chuẩn bị thử nghiệm phương án thiết kế mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220106,
					"content": "Nhưng chúng tôi lại có ý kiến khác nhau về vật liệu sử dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220107,
					"content": "Nhưng lần này! Tôi đã nghe theo ý kiến của Qishan, bỏ ra số tiền lớn để mua vật liệu tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220108,
					"content": "Nhà Lữ Hành, bạn xem, một mình tôi mang không hết, sức của Qishan cũng yếu, bạn hãy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220109,
					"content": "Chúng ta cùng nhau dọn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Thật đáng tin cậy, vậy chúng ta mau lên đường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220112,
					"content": "Vật liệu lần này tự tay Qishan chọn đấy, chắc sẽ không có vấn đề gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220113,
					"content": "Hơn nữa, lần này tôi định trả thù lao cho bạn cao hơn, thật sự cảm ơn bạn đã hỗ trợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220110,
					"content": "Đừng nói nữa, đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
