					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411402,
					"content": "Hình như không có ai cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
					]
				},
				{
					"id": 740411404,
					"content": "Ừ đấy, không có Fatui thì chắc chỗ này cũng không cần chúng ta đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411405,
					"content": "Việc này... chưa thể khẳng định ngay được, ngộ nhỡ bên trong có mấy quý ông Snezhnaya thì chắc tôi sẽ không bao giờ được thấy Bánh Ốc Pha Lê nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411406
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411406,
					"content": "#Khụ, ý tôi là, không thể làm nghiên cứu thủy văn được nữa! Xin nhờ hai {M#vị}{F#quý cô} tốt bụng cùng tôi vào trong xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411407
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411407,
					"content": "Haiz, đành vậy, mở cửa đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411403,
					"content": "Tôi quay về được chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
