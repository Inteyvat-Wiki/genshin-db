			"dialogs": [
				{
					"id": 740411301,
					"content": "Đừng đánh nữa! Tôi đầu hàng! Đầu hàng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411302,
					"content": "Mấy... mấy người đến vì những cuộn băng giấy này à? Của các người hết đấy! Đừng đánh nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411303,
					"content": "Quan Chỉ Huy Fatui đã ngoan ngoãn giao ra tất cả dữ liệu nghiên cứu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "Thế nào, Broglie, toàn bộ đây à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411305,
					"content": "Ừm, cái này... chắc vậy? Ừm, đúng rồi, chắc là tất cả đây rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411306,
					"content": "Thôi, coi như tôi chưa hỏi đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411307,
					"content": "Mục đích của các ngươi là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "Đúng vậy, hãy thành thật khai báo! Rốt cuộc các ngươi chiếm những trạm quan trắc này để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411310,
					"content": "Là... để lười biếng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411311,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411312,
					"content": "Tên tôi là Malinovskyi, Đội trưởng Đội Trinh Sát độc lập thứ 34.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411313,
					"content": "Ban đầu khi được điều đến Fontaine, mọi người đều sống rất vui vẻ, cũng không có nhiệm vụ gì quá khó khăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411315,
					"content": "E hèm... Vậy điều này liên quan gì đến việc ngươi chiếm lĩnh trạm quan trắc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411316,
					"content": "Mấy tháng trước, do biến động nhân sự, bên Snezhnaya đã bất ngờ phân công một kẻ tên là Shumilov làm cấp phó mới của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411317,
					"content": "Shumilov? À, là tên tiểu đội trưởng ở Trạm Crepes Suzette lúc trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411318,
					"content": "Đúng vậy! Tôi thực sự chịu không nổi tên đó, nhưng lại không thể \"xử lý\" hắn, đành phải mượn cớ chủ động ra ngoài thi hành nhiệm vụ để tránh mặt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411319,
					"content": "Khoan đã, ngươi nói làm ta rối quá... Tên Shumilov kia là cấp phó của ngươi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411320,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411321,
					"content": "Vậy chẳng phải hắn là cấp dưới của ngươi sao, tại sao cấp trên phải nghe lời cấp dưới!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411322,
					"content": "Cái tên đáng ghét đó, rõ là cấp dưới của tôi, nhưng lúc nào cũng tỏ vẻ nghiêm túc, yêu cầu người khác nỗ lực làm việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411323,
					"content": "Hắn toàn nói những lời hợp lý rất khó phản bác... Tôi cũng đâu thể công khai với hắn ngay trước mặt người khác rằng thực ra mọi người đều không muốn làm việc chứ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411324,
					"content": "Vừa hay, tôi thấy quanh đây có vài tòa tháp kỳ lạ, nên dứt khoát nói chúng tôi muốn điều tra bên này, sau đó làm giả thư của Sảnh Phúc Luật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411325,
					"content": "Hừ, quả nhiên là các ngươi làm giả! Nghĩ lại cũng phải, sao Sảnh Phúc Luật có thể giao trạm quan trắc thủy văn cho các ngươi quản lý được chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411326,
					"content": "Broglie, anh còn muốn hỏi gì hắn nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411327,
					"content": "Hừm... ra là vậy, ngươi chiếm giữ trạm quan trắc của chúng ta chỉ vì muốn trốn việc... Không, là muốn có được giây phút bình yên trong thế giới xô bồ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411328,
					"content": "Rồi sao? Cảm thấy nghỉ ngơi ở đây thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411329,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411330,
					"content": "Khụ... Cực kỳ thoải mái? Phong cảnh xung quanh cũng rất đẹp, ngủ trưa một lát thôi đã cảm thấy tâm trạng khoan khoái rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411331,
					"content": "Đúng nhỉ? Đặc biệt là khi thức dậy và nhận ra mình không có việc gì gấp cần làm, không có những người đáng ghét săm soi, chỉ cần an tâm tận hưởng ánh nắng và gió nhẹ buổi chiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411332,
					"content": "Giống như tỉnh lại từ một giấc mơ, rồi lại đi vào giấc mơ khác mà không cần lo lắng bất cứ điều gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411333,
					"content": "Ôi quý ông à, thế mới là sống! Đáng tiếc, anh chưa được nếm thử loại hồng trà bán giới hạn ở Phố Vasari phải không? Nếu có cơ hội thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411334,
					"content": "Này này, sao đột nhiên hai người lại nói chủ đề quái quỷ gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411335,
					"content": "Được rồi, tên kia, ngoan ngoãn đi theo chúng ta một chuyến mau! Đến lúc xem xét tội của ngươi với Viện Khoa Học Fontaine rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411336,
					"content": "Ưm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411337,
					"content": "Xin... xin đợi một lát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411338,
					"content": "Hai vị ân nhân! Thực ra người này cũng chưa gây ra bất kỳ thiệt hại gì cho nghiên cứu thủy văn của chúng tôi, phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411339,
					"content": "Về mặt khách quan, thậm chí quý ông đây còn giúp chúng ta thu thập một phần dữ liệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411340,
					"content": "Hơn nữa, chỉ là anh ta không muốn làm việc, muốn sống cuộc sống tươi đẹp, hạnh phúc và an nhàn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411341,
					"content": "Phải, phải đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411342,
					"content": "Không, dù hai người có ăn nói hùng hồn như thế thì đây cũng đâu phải chuyện gì đáng để tự hào chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411343,
					"content": "#Làm ơn đi, {M#quý ngài}{F#quý cô} tốt bụng! Nể mặt khoa học, xin hãy khoan dung độ lượng, tha cho anh ta lần này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411344,
					"content": "Mặc dù có vẻ không liên quan gì đến khoa học...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "Xin... xin cảm ơn quý ngài, và hai vị đây nữa! Tôi thề, tuyệt đối sẽ không làm chuyện như vậy nữa! Từ nay về sau, tôi nhất định sẽ dốc hết sức, chỉ lười biếng bằng thực lực của mình thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411347,
					"content": "Tốt lắm! Quan trọng nhất chính là quyết tâm như thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411348,
					"content": "Đừng khơi gợi ý chí chiến đấu kỳ lạ đó ở những nơi thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411349,
					"content": "Quan Chỉ Huy Fatui đội ơn rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "Được rồi! Vấn đề đã được giải quyết xong xuôi, tôi cũng nên quay về sắp xếp dữ liệu thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411351
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411351,
					"content": "Vô cùng cảm ơn hai vị! Xin hãy nhận lấy những thứ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411352
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411352,
					"content": "Giải... giải quyết xong xuôi thật chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411353,
					"content": "Hmm, thôi vậy... Trạm quan trắc đã hoạt động trở lại, đám tiểu đội Fatui cũng rút lui rồi, chuyện này coi như kết thúc nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411345,
					"content": "Nếu người trong cuộc đã nói vậy rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				}
			]
		},
