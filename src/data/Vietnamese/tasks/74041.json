			"dialogs": [
				{
					"id": 740410601,
					"content": "Ừm, để tôi xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410602,
					"content": "Nếu có thể tổng hợp các dữ liệu được thu thập trước đó thì chắc chắn sẽ thu được kết quả tốt... Việc khôi phục quan trắc thủy văn đang rất gần, rất gần rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410603,
					"content": "Ồ, vậy thì tốt quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410604,
					"content": "Hửm? Hình như thiếu một phần dữ liệu... Lẽ nào là ảo giác?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410605,
					"content": "Sao lại thiếu chắc chắn như vậy! Đây chẳng phải dữ liệu do chính anh phụ trách sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
