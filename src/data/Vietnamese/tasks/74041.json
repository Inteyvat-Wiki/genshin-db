				},
				{
					"id": 740410608,
					"content": "...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "...Khụ, xin lỗi, đi nhầm phòng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410610,
					"content": "Quan Chỉ Huy Fatui lẩn đi mất với sự nhanh nhẹn hoàn toàn không tương xứng với hình thể...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "Khoan... Khoan đã, vừa nãy có thứ gì lướt qua vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410612,
					"content": "Nhanh quá, còn nhanh hơn cả Rồng Đất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "Không không, hình như giờ không phải lúc quan tâm chuyện này! Tên kia là Fatui đấy! Sao hắn lại xuất hiện ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}, chúng ta mau đuổi theo, phải tra hỏi cho thật kỹ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410613,
					"content": "Quả là một tên nhanh nhẹn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
