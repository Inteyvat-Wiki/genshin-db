			"dialogs": [
				{
					"id": 740410101,
					"content": "Broglie, chúng tôi đã lấy được dữ liệu từ hai trạm quan trắc mà anh nói rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410102,
					"content": "Thật sao?! Vậy thì tốt quá rồi! Làm ơn, mau đưa tôi xem đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410103,
					"content": "Này, của anh đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "Đưa Broglie cuộn băng đã thu thập được...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "Ahh, đúng rồi, chính là thứ này, chính là nó! Hai vị quả thực là thiên sứ trời cao phái xuống cứu tôi thoát khỏi bể khổ, để được sống cuộc sống tươi đẹp, hạnh phúc, an nhàn một lần nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410109,
					"content": "Không đến mức lố như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410110,
					"content": "#Tóm lại, việc không thể chậm trễ, {M#quý ngài}{F#quý cô} tốt bụng, giờ tôi sẽ đi gặp trưởng phòng để xin lấy chìa khóa của trạm xử lý trung tâm, đợi tôi một lát nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410111,
					"content": "Haiz, thật là... nhanh lên đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410112,
					"content": "Một lát sau, Broglie quay về với vẻ phấn chấn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#{M#Quý ngài}{F#Quý cô} tốt bụng à, tôi lấy được chìa khóa rồi! Tiếp theo chỉ cần đến trạm xử lý trung tâm, hoàn thành việc phân loại dữ liệu là có thể khôi phục công việc quan trắc thủy văn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410114,
					"content": "Ồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "Xem xét tình hình của Trạm Kẹo Dẻo Trái Cây và Trạm Crepes Suzette, biết đâu trạm xử lý trung tâm cũng có những quý ông đến từ Snezhnaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410117,
					"content": "Cho nên... Làm ơn, hai người đi cùng tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410118,
					"content": "Hừm, anh đừng quên trả công cho chúng tôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410115,
					"content": "Chuyện này cũng cần chúng tôi đi cùng à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "Thù lao của chúng tôi đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "Chuyện này... Xin đừng lo lắng, chỉ cần cấp trên phê duyệt khôi phục nghiên cứu thủy văn ban đầu thì chắc chắn sẽ không thiếu thù lao của bạn đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410106,
					"content": "Hì hì, vậy thì tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
