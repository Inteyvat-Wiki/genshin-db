			"dialogs": [
				{
					"id": 701430201,
					"content": "Chào nhà lữ hành, những chuyếm mạo hiểm của bạn vẫn thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430202,
					"content": "Cũng coi như khá thuận lợi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "Ừm, tôi cũng có nghe nhiều chuyện về bạn, cứ tiếp tục thế này thì chẳng mấy chốc bạn sẽ trở thành nhà mạo hiểm ưu tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430204,
					"content": "Sau đó... Về chuyện mạo hiểm, ở đây tôi có \"Tình báo mạo hiểm\", không biết bạn có hứng thú không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430205,
					"content": "Lại có ủy thác gì sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "Xem ra bạn đã rất rành về công việc ở đây nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430207,
					"content": "Nhưng mà, lần này không phải là ủy thác, mà là \"Tình báo mạo hiểm\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430208,
					"content": "Tình báo mạo hiểm này liên quan đến Long Tích Tuyết Sơn bên cạnh Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430209,
					"content": "Hiệp hội đã bố trí doanh trại ở đó để cho các nhà mạo hiểm dừng chân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430210,
					"content": "Tôi đã đánh dấu địa điểm trên bản đồ của bạn rồi. Sau khi đến đó thì bạn có thể tìm Iris để tìm hiểu tình hình xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430211,
					"content": "Vậy, bạn tiếp tục mạo hiểm đi nhé, hướng về những ngôi sao và vực sâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
