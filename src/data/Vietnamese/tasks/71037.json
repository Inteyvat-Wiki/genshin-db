			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Phù, đã lâu rồi không xuống dưới này... vẫn là không khí quen thuộc bên dưới hầm mỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370102,
					"content": "Nhưng đừng có lơ là quá, Qiong. Sao chị lại ngửi thấy mùi gì đó rất lạ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370103,
					"content": "Dù sao thì chúng ta cũng không thể cứ thế mà nhảy xuống dưới... cái cần cẩu cứ lắc qua lắc lại khiến em hơi mất tập trung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370104,
					"content": "Cô đấy... ở trên mặt đất lâu quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370105,
					"content": "Sao tôi chẳng ngửi thấy mùi gì vậy nhỉ... mũi của thợ mỏ đều nhạy như thế à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370106,
					"content": "Haha, xuống đây mà mũi không nhạy thì có ngày sẽ mất mạng đấy. Dù sao bây giờ vẫn đang ổn, những chú chim sẻ vẫn còn sung sức lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370107,
					"content": "Nhìn bên kia xem, Lưu Minh Tinh Thạch cũng đã xuất hiện ở đây rồi... lần trước vẫn chưa lan tới nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370108,
					"content": "Đúng thật! Chúng ta qua đó xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370109,
					"content": "Hừm... cứ có cảm giác như có người đang cướp lời thoại của tôi vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "Không ngờ Lưu Minh Tinh Thạch lại xuất hiện ở nơi cách mặt đất gần như vậy... tôi cứ tưởng rằng những thứ này sẽ không phát triển ở những vị trí có cấu trúc đất yếu chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370202,
					"content": "Chúng là những mảnh vỡ của \"thứ đó\", nằm bên dưới mặt đất, di chuyển men theo mạch đá, cuối cùng là tới chỗ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370203,
					"content": "Đừng nói bừa. Chúng chỉ là loại đá thông thường ở nơi đây, biến thành như vậy có lẽ là do trải qua quá trình chuyển hoá nào đó mà hình thành kết tinh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370204,
					"content": "\"Thất Tinh\" đã từng giao cho chúng tôi phân tích... Phần lớn thành phần vẫn là khoáng sản trong Vực Đá Sâu, chẳng qua là... bị ngoại lực tác động, nên đã cấu thành những tinh thể kỳ lạ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370205,
					"content": "#Nhìn kìa, mảnh tinh thạch kia so với \"Chất Xúc Tác\" trên người {NICKNAME} cũng không khác nhau là mấy nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370231,
					"content": "#{NICKNAME} mau lấy \"Chất Xúc Tác\" Lưu Minh Thạch ra xem nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370232,
					"content": "Đúng vậy, \"Chất Xúc Tác\" Lưu Minh Thạch thật sự rất giống với loại tinh thạch này. Cấu trúc của chúng tương đồng nên đã cộng hưởng với nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370206,
					"content": "Thật là quái dị...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "Này, bạn chỉ biết nói vậy thôi à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370209,
					"content": "Mọi người đừng có cãi nhau nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370210,
					"content": "Chúng tôi không hề cãi nhau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "#{NICKNAME} có cãi nhau với tôi đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370212,
					"content": "Ý tôi là, tôi không quan tâm hai người có đang cãi nhau hay không, Zhiqiong và tôi cần dựng trại nghỉ chân ở phía trước, trong lúc này hai người không nên chạy lung tung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370213,
					"content": "Kết tinh mà chúng ta vừa phát hiện rất có ích cho việc thám hiểm sau này, nếu có phát hiện gì mới thì hãy báo cho tôi biết nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370214,
					"content": "Tay nghề của tôi vẫn chưa mai một, tôi sẽ giúp hai người tinh chế loại tinh thạch thô này... để nó trở nên hữu ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370215,
					"content": "Uhm, còn nữa... đừng có cãi nhau đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370216,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370217,
					"content": "Biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "Ngoan lắm, lát nữa sẽ phát kẹo cho hai người. Phải rồi, nếu phát hiện xung quanh có thứ gì kì lạ thì phải mau chóng báo lại cho tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370219,
					"content": "Đúng rồi, lần trước chị Jinwu có nhắc tới chuyện của Chú Hà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370220,
					"content": "#Chị vẫn nhớ mà. {NICKNAME} cũng ở đây, vậy thì làm phiền {F#cô}{M#cậu} giúp tôi thêm một việc nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370221,
					"content": "Chú Hà là một tiền bối trong khu mỏ, vài năm trước khi Vực Đá Sâu sơ tán thợ mỏ, chú ấy không may bị mất tích... Chú ấy bị lãng tai, và có lẽ đã không nghe thấy cảnh báo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370222,
					"content": "Cứu trợ của Huy Sơn Đình và Thịnh Lộ Đình cũng đã đến, việc ma chay cho ông ấy cũng đã làm xong... có điều tôi vẫn cảm thấy chú ấy vẫn còn sống ở đâu đó dưới khu hầm mỏ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370223,
					"content": "Chú Hà cũng là thợ mỏ lâu năm... Làm sao để tránh khỏi tai nạn, làm sao để thoát thân, phải chờ đợi cứu viện thế nào... chú ấy đều rất am hiểu, và cũng đã dạy cho tôi rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370224,
					"content": "Vì vậy tôi tin rằng chú ấy vẫn còn sống sót ở đâu đó... chúng ta không thể từ bỏ việc tìm kiếm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370225,
					"content": "Chút nữa tôi sẽ chỉ cho mọi người vài chỗ, là nơi Chú Hà từng làm việc trước khi các thợ mỏ bị sơ tán... biết đâu chúng ta có thể tìm được một số manh mối ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370226,
					"content": "Còn tôi, tôi sẽ đi sâu vào khu mỏ để thăm dò trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370233,
					"content": "Phải rồi, đừng quên lấy kẹo nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370227,
					"content": "Cô không xuống cùng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "Cô ấy cần làm bản đồ cho chúng ta, kết cấu của Vực Đá Sâu rất phức tạp, không có bản đồ sẽ không đi được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370229,
					"content": "Chú ý an toàn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "Không sao đâu, dù sao tôi cũng không phải tay mơ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370207,
					"content": "Thật thần kỳ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
