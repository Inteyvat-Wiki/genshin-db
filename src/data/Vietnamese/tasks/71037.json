			"dialogs": [
				{
					"id": 710370501,
					"content": "#A, {NICKNAME}, các bạn đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370502,
					"content": "Jinwu có chuyện dặn dò...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "Lại là dặn dò về an toàn ấy hả? Ôi... Tôi nghe tới phát chán rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370504,
					"content": "Từ nhỏ tôi đã lớn lên ở mỏ khoáng, có nguy hiểm nào mà tôi không biết cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370505,
					"content": "Còn về những thứ chưa biết đó, các trưởng bối thường hay dựa vào kinh nghiệm để phán đoán xem là có nguy hiểm hay không... Sau đó sẽ dùng kết quả để chứng minh kinh nghiệm của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370506,
					"content": "Tôi đã chán ngấy cái kiểu tự cao tự đại đó của họ rồi... Tôi tin là bạn cũng sẽ như vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370507,
					"content": "Nếu như chị Iris một mực cảnh báo về sự nguy hiểm của núi tuyết, rồi tiền bối cũng nghe vậy mà chùn bước, chẳng phải đã bỏ qua rất nhiều cuộc mạo hiểm thú vị sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370508,
					"content": "Được rồi... Đừng khuyên tôi nữa, tôi cũng không muốn tranh cãi thêm với tiền bối về những chuyện nhỏ nhặt này... Ừm, chúng ta đổi chủ đề đi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370509,
					"content": "Tiền bối xem này, hiện giờ tôi đang khám phá địa hình ở đây để tiện vẽ bản đồ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370512,
					"content": "Chỉ là... trước đây khi thám hiểm hầm mỏ, con đường phía trước đã bị chặn bởi một số điểm dị biến kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370513,
					"content": "Nếu có thể lấy mẫu hoặc chụp ảnh lại, Tổng Vụ và Hiệp Hội Nhà Mạo Hiểm chắc sẽ rất hài lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370514,
					"content": "Nói ra thì thật xấu hổ... Lúc xuống khu mỏ, máy ảnh của tôi không cẩn thận bị rơi vỡ mất rồi, cho nên chỉ có thể dựa vào kỹ thuật chụp ảnh của tiền bối thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370515,
					"content": "Vẫn còn một vài điểm nữa... Ừm, ở đây và ở đây có dấu vết của Đạo Bảo Đoàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370516,
					"content": "Gì thế này... hoàn toàn không nhìn ra đâu với đâu luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "Chỉ là mấy dấu x và mấy đường gạch...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Haha, thật xin lỗi... là thói quen ấy mà, tôi quên mất là không phải ai cũng có trực giác của người vẽ bản đồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370519,
					"content": "Nhưng mà không sao, tôi sẽ đi cùng tiền bối, dẫn đường cho các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370520,
