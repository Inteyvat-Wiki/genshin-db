				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "Chính là chỗ này... kì lạ, Zhiqiong đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370402,
					"content": "Zhiqiong, Zhiqiong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370403,
					"content": "Àh... đúng rồi, con bé lại tự mình chạy xuống chỗ sâu trong khu mỏ để vẽ bản đồ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370404,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "Lúc nãy khi mọi người rời đi, Zhiqiong đã vẽ tấm bản đồ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370408,
					"content": "Chắc con bé lại chạy đi thám hiểm chỗ sâu rồi. Giúp tôi chuyển lời với nó, phía trước rất nguy hiểm, đừng có liều lĩnh bỏ lại mọi người mà chạy lung tung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370409,
					"content": "...Nếu như lại gây ra phiền phức gì liên lụy tới mọi người thì nắm đấm của Jinwu này sẽ không nương tay đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370410,
					"content": "Chậc... Hung dữ quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370411,
					"content": "Hung dữ quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "Được rồi, hai người cũng đừng ở không nữa. Một là giúp tôi bố trí lều trại, hai là đến phía trước dò đường đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370413,
					"content": "Xin lỗi, tôi không giỏi nói lời khách sáo... tóm lại, chí ít cũng nên làm gì đó có ích đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370414,
					"content": "À nhân tiện, trên đường nếu hai người nhìn thấy kết tinh thô của Lưu Minh Thạch thì hãy đem về cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370415,
					"content": "Tôi sẽ nghĩ cách đem chúng gia công thành \"Chất Xúc Tác\" có hiệu quả hơn. Theo kinh nghiệm của tôi... những thứ này ở dưới hầm mỏ rất có tác dụng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370405,
					"content": "Zhiqiong gặp nguy hiểm chăng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "Bây giờ thì chưa... hừm, nhưng nếu con bé còn chạy lung tung mà không báo cho tôi biết thì cái mông của nó sẽ nguy hiểm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Jinwu"
				}
			]
		},
