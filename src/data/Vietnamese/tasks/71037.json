			"dialogs": [
				{
					"id": 710370301,
					"content": "A, hai người về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370302,
					"content": "Chú Hà đã để lại một số thông tin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "Ô? Chú ấy thật sự để lại thứ gì đó sao! Lại đây, nói tôi nghe xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370306,
					"content": "Các bạn nói cho Jinwu biết những thông tin đã tìm thấy trước đó.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "Hmm... dung nham màu đen... Lưu Minh Thạch... nấm rơm...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370305,
					"content": "Hừm... thật là quái dị, dường như tôi đã gặp điều quái dị này ở đâu đó. Chúng ta cũng đừng đứng lâu ở đây nữa, cùng nhau quay về doanh trại thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
