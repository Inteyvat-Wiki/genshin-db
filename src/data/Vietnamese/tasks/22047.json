				},
				{
					"id": 220470102,
					"content": "Bạn đang tập bắn cung sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "Bạn là... lần trước cảm ơn bạn đã thị phạm bắn cung cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470104,
					"content": "Nhờ bạn mà tôi đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470105,
					"content": "Bách phát bách trúng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "À, vẫn chưa đạt đến mức đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470108,
					"content": "Nhưng bây giờ trong mười mũi tên tôi bắn, đã có năm mũi trên bia rồi... cũng nhờ vào thị phạm của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470109,
					"content": "Tuy vẫn chưa đạt yêu cầu của giáo quan, nhưng tôi vẫn sẽ tiếp tục cố gắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470110,
					"content": "Đúng rồi, bạn ở đây vậy thị phạm một lần nữa cho tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470111,
					"content": "Có thị phạm của bạn rồi, tôi nhất định sẽ tiến bộ nhanh hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470112,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "Cảm ơn bạn, tôi nhất định sẽ nghiêm túc học hỏi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470120,
					"content": "Nhờ bạn thị phạm nhé, tôi nhất định sẽ nghiêm túc học hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470114,
					"content": "Vấn đề lần trước đã giải quyết chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "Bạn nói... tư thế của tôi chưa chuẩn, hơi thở không đều, tay cầm cung không vững... những vấn đề đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470116,
					"content": "Nói thật là tôi đang từng bước giải quyết chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470117,
					"content": "Nhưng ngoại trừ những vấn đề đó, điều tôi lo lắng hơn là... là nếu lên chiến trường, tôi có thể phát huy tài nghệ đã học được không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470118,
					"content": "Khụ, nhưng trước khi lo lắng những vấn đề này, tôi vẫn phải rèn luyện tốt tài nghệ của tôi đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470119,
					"content": "Nhờ bạn thị phạm nhé, tôi nhất định sẽ nghiêm túc học hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
