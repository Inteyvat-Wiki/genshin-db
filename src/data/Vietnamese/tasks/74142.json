			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#A! Là {NICKNAME}. Ơ, Paimon không đi cùng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420702,
					"content": "Vết nứt kia... Cô đang nhìn gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "Hả? Vết nứt gì? Đây không phải tấm gương à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420704,
					"content": "Nhưng đúng là tôi có thứ đang tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420705,
					"content": "Tôi vẫn luôn tìm manh mối của \"tấm kính\"... Chắc là thứ giống như bức tranh, tương tự như Sách Khải Huyền vậy, cũng có thể khiến người ta thiền định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420706,
					"content": "Về bốn Orthant và bức tranh trong Tháp Mô Thức...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#...Ừm? Hóa ra là đang ở nơi như vậy sao? Ừm! Cảm ơn {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
