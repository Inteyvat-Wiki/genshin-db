					"nextDialogs": [
						741421418
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421418,
					"content": "Có kế hoạch gì cho sau này không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "Không biết, nhưng tôi không muốn đọc sách tiếp nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421420,
					"content": "...Canotila, như vậy có phải hơi cực đoan không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421421,
					"content": "Ừm, nhưng mà Sách Khải Huyền thực sự rất đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421422,
					"content": "(Vậy rốt cuộc đã xảy ra chuyện gì?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421423,
					"content": "(Rất khó giải thích...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "(Phải đi mới biết được.)",
