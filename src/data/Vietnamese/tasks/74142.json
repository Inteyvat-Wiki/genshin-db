					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(Sao cơ! Bực mình thật...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421427,
					"content": "...Tóm lại, tôi không muốn ở đây nữa. Tôi muốn quay về Làng Merusea sống cùng mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
