			"dialogs": [
				{
					"id": 741421301,
					"content": "#Cảm ơn {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421302,
					"content": "Đã xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "Tôi không biết... Tôi chỉ muốn đến xem hoa hướng dương nở và cả chó nhỏ đáng yêu thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421304,
					"content": "Nhưng trên đường có một con quái vật xuất hiện đuổi theo tôi. Lúc đó trời càng ngày càng tối, còn có rất nhiều âm thanh khác nhau, nói ra những điều mà tôi không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421305,
					"content": "Tôi rất sợ hãi, liền chạy một mạch về phía trước theo ánh sáng vàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421306,
					"content": "Mỗi khi quái vật đến gần tôi, cả thế giới sẽ tối đi một chút... Vườn hoa, cung điện, cổ thụ và hoa lá đều không thấy nữa. Nó trở nên vô cùng u ám, chỉ còn lại đống đổ nát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421307,
					"content": "Sau đó, thì bị quái vật đuổi kịp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421308,
					"content": "Không cần lo lắng nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "Chó nhỏ, đưa cô ấy về đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "Đừng đến đây nữa, tiểu thư. Nơi này chẳng có gì cả, mà bên ngoài còn có cả một thế giới thuộc về cô kia mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "A? Là chó nhỏ sao... Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421312,
					"content": "...Chúng ta còn có thể gặp lại không? Thế giới này còn có thể trở thành vườn hoa tươi đẹp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421313,
					"content": "Sẽ không đâu. Tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "#Cả {F#cô}{M#cậu} nữa. Tôi hỏi lại, trong mắt {F#cô}{M#cậu}, rốt cuộc tôi là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "Một chú chó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "#Ừm, vậy thì tốt. {F#Cô}{M#Cậu} đã đuổi những nhân vật không nên đến đây. Nhờ có {F#cô}{M#cậu} mà sự sụp đổ của thế giới này đã chấm dứt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "Nhưng tiếp tục ở lại đây sẽ không khôn ngoan đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "Tôi cũng nghĩ vậy. Hãy đưa tôi về nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "Rất sáng suốt. Vậy thì tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "Rốt cuộc đã xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "Vốn dĩ nơi này sắp sụp đổ hoàn toàn. Những người không nên đến đã đến đây, làm rung chuyển nền móng của thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "Hiện tượng mà tôi nhìn thấy là do điều đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "#Tôi không thể biết được {F#cô}{M#cậu} đã trải qua điều gì. Suy cho cùng tôi không phải là {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "Vậy bạn là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "...Tôi là ai không quan trọng. Quan trọng là chủ nhân của thế giới ảo tưởng này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "Họ tin rằng họ có thể giải cứu thế giới, nhưng lại không biết liệu thế giới có cần được cứu hay không. Có lẽ thế giới trong ký ức của họ chỉ là một buổi chiều với hoa hướng dương nở rộ vĩnh viễn mất đi mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "Nhưng đó là câu chuyện của họ, không phải của tôi. Tôi chỉ là ký ức của họ về một người bạn. Họ tin rằng họ có thể cứu được tôi, nhưng cuối cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "Bướm hóa kén, ấu trùng phá kén mà ra. Cuối cùng ấu trùng đi về hư vô chưa từng xuất hiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "Nhưng điều đó không quan trọng, vì giờ đây tôi chẳng còn lại gì cả. Tôi chỉ là cái bóng còn sót lại trong ký ức của họ bởi nỗi ám ảnh \"cứu tôi\" thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "Nhưng tôi sẽ không hận họ vì điều này. Bởi cho dù họ thay đổi khi từ bỏ tôi, thì tôi trong thế giới đầy ký ức và ảo tưởng này vẫn chứng minh được sự cố chấp của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "Với tư cách là một người bạn cũ, tôi rất hài lòng. Dù có trở thành ai đi chăng nữa, tôi sẽ luôn biết ơn tình bạn đã có với nhau trong quá khứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "#Được rồi, nói đến đây thôi. {F#Cô}{M#Cậu} cũng cảm nhận được sự ảnh hưởng của nơi này đối với {F#cô}{M#cậu} đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "Tạm biệt. Và không hẹn gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
