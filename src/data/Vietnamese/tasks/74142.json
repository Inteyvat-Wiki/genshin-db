					"nextDialogs": [
						741421415
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421415,
					"content": "Woa, hương vị lạ quá. Đây là món ăn của con người sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421416,
					"content": "Này! Không ăn thì trả lại cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421417,
					"content": "#Nhưng mà... Cảm ơn Paimon. Cảm ơn cả {NICKNAME} vì đã cứu tôi nữa.",
