					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#Ơ, {NICKNAME}...? Chẳng phải chúng ta vừa mới gặp nhau sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420402,
					"content": "Là chuyện khi nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "Hmm, tôi không nói chính xác được... Dù sao ở đây cũng không thể biết được thời gian mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420404,
					"content": "Canotila, đi cùng tôi nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "Nơi này rất bất thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "Nhưng không phải bình thường và bất thường đều là do chúng ta quy định sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420407,
					"content": "Tôi không có ý gì đâu. Đối với tôi thì nơi này thật sự rất tốt. Tràn đầy sức sống và màu sắc, tôi chưa bao giờ thấy khung cảnh như vậy ở thế giới bên kia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420408,
					"content": "Tôi chỉ thấy một bông hoa hướng dương thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "Thật không? Ở đâu vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420410,
					"content": "Ở chỗ lúc trước chúng ta gặp chú chó nhỏ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "Ồ! Vậy tôi qua đó trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420412,
					"content": "Khoan đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
