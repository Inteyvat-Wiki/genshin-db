					"content": "Tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421407,
					"content": "Hic, tôi xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421408,
					"content": "Ơ? Không phải tôi đang trách Canotila. Đừng khóc mà, ăn đồ ăn ngon này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421409,
					"content": "(Đã xảy ra chuyện gì vậy?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421410,
					"content": "(Gặp phải chút nguy hiểm bên trong.)",
