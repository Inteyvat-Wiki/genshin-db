					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "Cái này... trông giống như bưu kiện gửi cho Acat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110202,
					"content": "...Bao bì bên ngoài đã rách, nếu gửi lại thì có thể cả bưu kiện sẽ hỏng mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110203,
					"content": "#Tôi còn phải sắp xếp bưu kiện trong cửa hàng, {F#cô}{M#cậu} có thể giúp tôi đưa bưu kiện này cho Acat được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110204,
					"content": "Cô ấy là chủ cửa hàng \"Bảng Màu Của Frida\" trong Đấu Trường Lửa Thánh. Biển hiệu của cửa hàng rất nổi bật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
