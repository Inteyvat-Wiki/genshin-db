					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111502
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111502,
					"content": "Để tôi viết lại hóa đơn đặt hàng khác sau vậy. Chuyện này cũng không vội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111503
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111503,
					"content": "#Cảm ơn {F#cô}{M#cậu} đã giúp tôi mang thư về. Nhìn {F#cô}{M#cậu} đổ mồ hôi này, lại đây, uống chút gì đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chanca"
				}
