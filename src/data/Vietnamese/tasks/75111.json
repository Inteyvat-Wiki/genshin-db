			"dialogs": [
				{
					"id": 751110101,
					"content": "Trước đây tôi đã nhặt được cái này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "Ồ? Lại là tên ngu ngốc nào đó làm mất ư? Mau đưa cho tôi xem nào.",
