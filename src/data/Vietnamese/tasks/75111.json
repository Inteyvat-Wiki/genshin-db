					"content": "Vì vậy, tôi đã gửi bưu kiện chứa một số mẫu màu nhỏ cho anh ta, để anh ta mang theo mẫu màu mình thích cho lần mua sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "Tôi phải nhanh chóng gửi lại một bưu kiện khác, kẻo anh ta lại mang theo mẫu màu kỳ quặc nào đó đến nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "#Đúng rồi, đây là thù lao cho {F#cô}{M#cậu}, cảm ơn vì đã giúp tôi mang bưu kiện về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
		},
