					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "Lá thư này... có vẻ như là nét chữ của Chanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110302,
					"content": "Tôi đoán đây hẳn là một hóa đơn đặt hàng khác. Bao bì bên ngoài đã rách, lá thư này không thể tiếp tục gửi đi, phải đi trả lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110303,
					"content": "#Tôi còn phải sắp xếp bưu kiện trong cửa hàng, {F#cô}{M#cậu} có thể giúp tôi trả lại lá thư này cho Chanca được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110304,
					"content": "Cô ấy là chủ \"Nhà Trọ Mệt Mỏi\" trong Đấu Trường Lửa Thánh, rất dễ tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
