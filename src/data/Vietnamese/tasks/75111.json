			},
			"dialogs": [
				{
					"id": 751110401,
					"content": "\"Tiệm Đá Quý Muhuru\"... Imix? Hỏng rồi, không phải là hóa đơn đặt hàng gửi đi đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110402,
					"content": "Nếu bưu kiện này bị mất thì đứa bé đó sẽ bị Cheven mắng cho mà xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110403,
					"content": "#Tôi còn phải sắp xếp bưu kiện trong cửa hàng, {F#cô}{M#cậu} có thể giúp tôi trả lại bưu kiện này cho Imix được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110404,
					"content": "Tiệm Đá Quý Muhuru của họ ở \"Con Của Tiếng Vang\", rất dễ tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
