				},
				{
					"id": 751111602,
					"content": "May quá, em còn tưởng mình đã gửi nhầm địa chỉ... Nếu vậy thì tiêu em rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111603
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111603,
					"content": "Cảm ơn, xin hãy nhận những thứ này nhé.",
