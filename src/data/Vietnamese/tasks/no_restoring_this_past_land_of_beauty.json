				},
				{
					"id": 710220211,
					"content": "Về việc ma vật xuất hiện, nếu quy mô thật sự lớn, chắc chắn chúng ta không thể bỏ mặc làm ngơ, phải nhanh chóng tìm đối sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220212
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220212,
					"content": "Đương nhiên đây cũng xem là công việc chính thức của hiệp hội. Sau khi hoàn thành sẽ có tiền thưởng, ý bạn thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220213
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220213,
					"content": "Sao rồi? Có phát hiện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220214
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220214,
					"content": "Trước đó tôi đã đi qua nơi này rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220215
					]
				},
				{
					"id": 710220215,
					"content": "Đã đi qua rồi sao? Không hổ danh là nhà mạo hiểm ưu tú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220216
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220216,
					"content": "Về tình hình Thiên Tù Cốc và Rồng Đất Cổ - Nham...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220217
					]
				},
				{
					"id": 710220217,
					"content": "...Một hang di tích khổng lồ, còn có cả Rồng Đất Cổ - Nham nữa",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220218
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220218,
					"content": "Đã hiểu. Cám ơn bạn đã đưa tin, sau khi tôi soạn thành tài liệu giấy, sẽ làm báo cáo chính thức cho hiệp hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220219
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220219,
					"content": "Bên đó có chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220220
					]
				},
				{
					"id": 710220220,
					"content": "Ừm...theo ghi chép của một số sách, di tích ở Thiên Tù Cốc đã từng là một thị trấn phồn vinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220221
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220221,
					"content": "Nguyên do dẫn đến tình cảnh như hiện tại hình như có liên quan đến việc làm loạn của một vị Long Vương nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220222
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220222,
					"content": "Tuy trận náo loạn đó không được ghi chép cụ thể, nhưng theo truyền thuyết, thì cuối cùng Đế Quân và tiên gia đã cùng giam cầm nó trong hang động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220223
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220223,
					"content": "Thân thích của nó thì trốn xuống lòng đất, rơi vào giấc ngủ triền miên, chờ ngày vị Long Vương đó tỉnh dậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220224
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220224,
					"content": "Những ma vật đó, chẳng lẽ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220225
					]
				},
				{
					"id": 710220225,
					"content": "Ha ha ha, những chuyện lưu truyền trong dân gian, ai mà biết được có mấy phần thật mấy phần giả chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220226
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220226,
					"content": "Nhưng cho dù nói thế nào, thì đều phải nhanh chóng tìm đối sách để giải quyết những trận động đất liên tiếp, rồi ma vật đột nhiên xuất hiện mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220227
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220227,
					"content": "Đúng rồi, bạn hãy nhận lấy tiền thưởng này, cám ơn vì đã đưa tin đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
