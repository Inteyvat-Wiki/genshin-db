				},
				{
					"id": 710220402,
					"content": "Về tình hình Thiên Tù Cốc và Rồng Đất Cổ - Nham...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220403
					]
				},
				{
					"id": 710220403,
					"content": "...Một hang di tích khổng lồ, trong đó có cả Rồng Đất Cổ - Nham nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220404
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220404,
					"content": "Đã hiểu. Cám ơn bạn đã đưa tin, sau khi tôi soạn thành tài liệu giấy, sẽ làm báo cáo chính thức cho hiệp hội.",
