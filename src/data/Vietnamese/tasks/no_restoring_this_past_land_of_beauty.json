			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "Lần này xảy ra ở Thiên Tù Cốc sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#Là {NICKNAME} à, không ngờ hôm nay lại được gặp bạn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220104,
					"content": "À... gần đây bạn có đến khu vực Thiên Tù Cốc, Nam Thiên Môn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220107,
					"content": "Gần đây hiệp hội liên tiếp nhận được báo cáo về động đất từ vùng Nam Thiên Môn đến Thiên Tù Cốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220108,
					"content": "Ban đầu chỉ là sự rung chuyển nhẹ, nhưng gần đây có vẻ ngày càng nghiêm trọng hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220109,
					"content": "Không lâu trước đây, hiệp hội lại nhận được báo cáo, sau một trận động đất cực mạnh, một số ngọn núi và di tích đã bị sụp đổ, để lộ ra một hang động khổng lồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220110,
					"content": "Trong báo cáo còn nói đã nhìn thấy một loài ma vật chưa xác định ở bên đó. Theo miêu tả, có thể đó là \"Rồng Đất Nham\" và \"Rồng Đất Cổ - Nham\" đã từng quấy nhiễu khắp nơi trong quá khứ gây ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220111,
					"content": "Cần tôi làm gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "Tôi muốn nhờ bạn đến hang động lớn ở Thiên Tù Cốc thăm dò, xem thử ảnh hưởng của trận động đất đến môi trường xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220113,
					"content": "Về việc ma vật xuất hiện, nếu quy mô thật sự lớn, chắc chắn chúng ta không thể bỏ mặc làm ngơ, phải nhanh chóng tìm đối sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220114,
					"content": "Đương nhiên đây cũng xem là công việc chính thức của hiệp hội. Sau khi hoàn thành sẽ có tiền thưởng, ý bạn thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220115,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "Vậy phiền bạn nhé, hãy bảo trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
