						400721302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721302,
					"content": "Vừa rồi chúng ta dường như đã vô tình nhìn thoáng qua được bộ mặt thật của Ác Long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721303,
					"content": "Haiz, tôi hiểu mấy chuyện này mà, sẽ luôn có người cho rằng sở thích của chúng tôi là lãng phí thời gian.",
					"roleType": "TALK_ROLE_NPC",
