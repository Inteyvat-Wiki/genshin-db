					"nextDialogs": [
						400721305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721305,
					"content": "Tôi là \"Arnold Mong Muốn Được Hỏi Đường\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721306,
					"content": "Ý tôi là, sao anh lại ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721307,
					"content": "Ố, ồ, tôi đoán là các bạn sẽ muốn tìm quyển thứ ba của \"Bài Ca Thánh Quốc\" mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721308,
					"content": "Anh đoán đúng rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721309,
					"content": "Quý cô thân mến, cô không cần làm gì cho tôi cả. Vẻ đẹp của cô chính là lời khen tốt nhất dành cho tôi rồi. Tôi xin dâng hiến đáp án mà cô đang tìm kiếm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721310,
					"content": "Quyển thánh điển thứ ba nằm ở tầng cao nhất của vương thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721311,
					"content": "Có hệ thống bảo vệ gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721312,
					"content": "Ố, ồ, đương nhiên rồi thưa ngài, sao ngài lại hỏi ngớ ngẩn thế chứ? Bất kỳ quốc gia nào cũng sẽ không để quyển sách quan trọng nhất của mình ở nơi nguy hiểm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721313,
					"content": "Tức là bên đó cũng sẽ có quạ đêm bảo vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721314,
					"content": "Bảo vệ thánh điển chính là vinh quang tối thượng của thần dân. Nhưng không sao, tôi tin là quý cô này chỉ muốn đọc thánh điển mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721315,
					"content": "Cô vừa xinh đẹp lại có trí tuệ cao như thế. Đồng đội của cô cũng là anh hùng, nếu là các vị thì mới có thể hiểu được câu chuyện trong thánh điển của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721316,
					"content": "Nhờ Lục Sự Oz thuật lại, sự tích của điện hạ đã trở thành báu vật của Vương Đô U Ám. Mỗi lần tôi đọc quyển sách này, đều sẽ hy vọng điện hạ được hạnh phúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "Xin lỗi vì để các vị nhiều lần nhìn thấy vẻ chật vật của tôi. Quả nhiên, với bản lĩnh của tôi bây giờ, vẫn còn quá sớm để sắm vai Kỵ Sĩ Quạ Đêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721802,
					"content": "Sắm vai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721803,
					"content": "Nói ra thật xấu hổ, tôi không phải kỵ sĩ chính thức, mà chỉ là một diễn viên mới vừa nhận việc để sắm vai kỵ sĩ dự bị trong đoàn kịch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721804,
					"content": "Chuyện này thì có gì mà tự hào chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721805,
					"content": "Không không, các vị không biết rồi. Ở Vương Đô U Ám, diễn kịch là một nét văn hóa rất quan trọng. Diễn xuất tốt chính là báo đáp tốt nhất dành cho công chúa điện hạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721806,
					"content": "Ừm, vậy ra đây là văn hóa bản địa của các anh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721807,
					"content": "Đúng vậy! Nên tôi rất vui khi có thể diễn vai kỵ sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721808,
					"content": "Tại sao công chúa điện hạ của các anh lại thích diễn kịch như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721809,
					"content": "Công chúa điện hạ từng nói: \"Hãy dâng lễ mừng lên cho bổn công chúa, diễn kịch giữa cánh đồng bát ngát kia. Hãy quỳ lạy ta, dâng lên giấc mộng thuần khiết để đổi lấy vinh quang của Vương Đô U Ám.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721810,
					"content": "Tôi nghĩ, chắc chắn là do công chúa điện hạ thấu hiểu được nghệ thuật thật sự, lại có thể nhìn thấu cảm xúc hỉ nộ ái ố ẩn sâu trong nhân tính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721811,
					"content": "Linh hồn của vở kịch nằm ở sự tập trung và để cảm xúc thăng hoa. Người hiểu và thích kịch đều có một trái tim tuyệt vời và giàu tình cảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721812,
					"content": "...Hóa ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721813,
					"content": "Cảm ơn câu trả lời của anh, kỵ sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721814,
					"content": "Ơ, ơ ơ! Ngài... ngài chấp nhận gọi tôi là kỵ sĩ ư, rất cảm ơn ngài!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721815,
					"content": "Vậy thì, tôi sẽ mang theo phần vinh quang này xông pha trên chiến trường của mình. Các vị, có duyên sẽ gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721816,
					"content": "Đừng gặp lại thì hay hơn, lần sau chú ý an toàn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721817,
					"content": "À đúng rồi, hãy ghi nhớ khẩu lệnh mở cửa nhé: \"Nghe theo lệnh ta, vỗ cánh xuất phát.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leon"
				}
			]
		}
	]
}