					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "\"Tuy nhiên, Vương Đô U Ám lại liên tục đón nhận những đám mây mù như một cơn ác mộng. Ác Long Tasraque lao xuống đất, băng qua đáy biển, lao lên thành trì.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "Dẫn Truyện"
				},
				{
					"id": 400720402,
					"content": "Hả? Có rồng sao? Tôi chỉ nghĩ là trời bị tối thôi chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400720403,
					"content": "Rồng... Có khi nào là ẩn dụ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720404,
					"content": "Vậy là... tất cả những gì không thừa nhận cô ấy, phản bác suy nghĩ của cô ấy đã dung hợp thành kẻ thù, \"Ác Long Tasraque\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007210,
