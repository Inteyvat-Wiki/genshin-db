			"trigger": {
				"objectNames": [
					"Quạ Đêm Biểu Cảm Nghiêm Túc",
					"Quạ Đêm Ánh Mắt Lạnh Lùng",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "Dừng lại, ai đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "Quạ Đêm Biểu Cảm Nghiêm Túc"
				},
				{
					"id": 400720202,
					"content": "Xem bộ dạng của ngươi, không phải là thần dân của Vương Đô U Ám đúng không? Nói mau! Đến đây làm gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "Quạ Đêm Ánh Mắt Lạnh Lùng"
				},
				{
					"id": 400720203,
					"content": "Có cả lính canh nữa sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720204,
					"content": "Đừng hoảng sợ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "Hử? Bạn làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720206,
					"content": "Chúng tôi là gia thần của công chúa điện hạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "Người đã xuyên qua biển sao để đến đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "Ngươi làm thế nào để chứng minh mình là gia thần của công chúa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "Quạ Đêm Biểu Cảm Nghiêm Túc"
				},
				{
					"id": 400720209,
					"content": "Hừ, thái độ ngạo mạn đến vậy à, vậy thì chỉ chứng tỏ tầm nhìn của các ngươi quá nông cạn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720210,
					"content": "\"Cầu mong người dân được giải phóng khỏi gông cùm của những sắc lệnh cổ xưa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720211,
					"content": "Là khẩu lệnh của Vương Đô U Ám! Họ đúng là gia thần của điện hạ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "Quạ Đêm Ánh Mắt Lạnh Lùng"
				},
				{
					"id": 400720212,
					"content": "Ôi trời, tôi, tôi đã đi quá giới hạn của mình! Các vị xin hãy tha thứ cho chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "Quạ Đêm Biểu Cảm Nghiêm Túc"
				},
				{
					"id": 400720213,
					"content": "Biết sai rồi còn không mau lui xuống?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720214,
					"content": "Vâng vâng, thuộc hạ sẽ rời khỏi đây ngay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "Quạ Đêm Biểu Cảm Nghiêm Túc"
				},
				{
					"id": 400720215,
					"content": "Họ đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720216,
					"content": "Đây là tập hai của \"Bài Ca Thánh Quốc\". Mọi người, đã chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720217,
					"content": "Lên đường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
