			"dialogs": [
				{
					"id": 700890101,
					"content": "Ủa, sao ở đây lại có người?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890102,
					"content": "Cũng không phải tượng Phong Thần này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890103,
					"content": "Này, anh đang làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890104,
					"content": "Tôi đang tìm đường về. Tôi chỉ nhớ là phải tìm tượng Phong Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890105,
					"content": "Còn lại thì tôi chẳng nhớ gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890106,
					"content": "Đường về?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890107,
					"content": "Một nỗi nhớ quê hương mơ hồ, nhưng tôi chẳng nhớ gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890108,
					"content": "Khi tôi tỉnh lại, trong tay chỉ có một mảnh giấy ghi dòng chữ \"Anh là 'Maukie'\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890109,
					"content": "Nên tôi nghĩ tên mình chắc là \"Maukie\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890110,
					"content": "Không làm phiền các vị nữa, tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890111,
					"content": "Thật là một người kỳ lạ. Nhưng chắc không phải là người xấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890112,
					"content": "#{NICKNAME} sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890113,
					"content": "Tôi thấy một cảnh tượng kỳ lạ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "Cảnh tượng kỳ lạ? Chẳng lẽ là vì người vừa rồi đã chạm vào tượng thần?",
