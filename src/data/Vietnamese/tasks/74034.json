			"dialogs": [
				{
					"id": 740340901,
					"content": "Đây là việc liên quan đến bảo mật, vốn thuộc thẩm quyền bên ngài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340902
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340902,
					"content": "Nếu nói vậy thì sau này việc do chúng tôi xử lý, dù có liên quan đến nhân sự đi nữa, thì cũng không cần cho bên ngài biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340903
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340903,
					"content": "Đừng có đánh tráo khái niệm, đó là hai chuyện hoàn toàn khác nhau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340904
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340904,
					"content": "Hai việc này có phải là một hay không chưa đến lượt chúng ta quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340905
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340905,
					"content": "Xem ra... tôi lại làm hỏng việc rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340906,
						740340907
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340906,
					"content": "Thật đáng sợ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340908
					]
				},
				{
					"id": 740340908,
					"content": "#{NICKNAME}, hay là... hay là chúng ta ra ngoài trước đi, bọn họ cãi nhau đáng sợ quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340909,
					"content": "Các vị! Bình tĩnh đã nào! Đừng vì chuyện nhỏ mà mất hòa khí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340910
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340910,
					"content": "Đây không phải chuyện nhỏ đâu ngài Roialte, đây là chuyện lớn liên quan đến cả Sảnh Phúc Luật đấy. Chuyện này tôi không dám tùy tiện quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340911
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340911,
					"content": "Thực vậy, dù sao bảo mật không phải chuyện nhỏ. Tôi thấy cả Sảnh Phúc Luật ngoại trừ Gattineo ra thì cũng không còn ai thích hợp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340912
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340912,
					"content": "Bình tĩnh, sao hai vị cứ phải tranh luận về việc này nhỉ? Theo tôi thấy, việc này vốn không cần ai chịu trách nhiệm cả, cũng chẳng cần hỗ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340913
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340913,
					"content": "Gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340914
					]
				},
				{
					"id": 740340914,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340915
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340915,
					"content": "Tôi không hiểu ý của ngài, ngài Roialte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340916
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340916,
					"content": "Tôi không theo kịp ý của ngài, ngài Roialte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340917
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340917,
					"content": "Hai vị đều là người có kinh nghiệm, đối với một sự việc phức tạp, thì trước hết cứ chia nó thành những chuyện nhỏ đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340918
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340918,
					"content": "Để tránh việc người khác dùng máy ảnh rò rỉ thông tin, thì theo lý nên để ngài Gattineo phụ trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340946
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340946,
					"content": "Nhưng anh không cần làm thêm gì cả, chỉ cần bắt những kẻ rò rỉ thông tin mật như mọi khi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340919
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340919,
					"content": "Việc để mọi người biết không được mang máy ảnh vào Sảnh Phúc Luật là một việc phiền phức, tôi nghĩ chắc chỉ có ngài Difor xử lý được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340920
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340920,
					"content": "Chúng tôi không có khả năng cưỡng chế vậy đâu, không ai nghe chúng tôi cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340921
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340921,
					"content": "Ôi, chuyện này ngài không cần lo, việc cưỡng chế này hãy giao cho ngài Gattineo, còn trách nhiệm của ngài không phải \"thông báo\" mà là \"kiến nghị\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340922
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340922,
					"content": "\"Kiến nghị\" này in càng to càng tốt, cứ dán ở cửa Sảnh Phúc Luật, bên dưới còn kèm theo ví dụ của việc dùng máy ảnh rò rỉ bảo mật, vậy là đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340923
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340923,
					"content": "Nghe có vẻ y hệt những gì đã nói trước đây mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340924,
						740340925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340924,
					"content": "Tôi không hiểu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340926
					]
				},
				{
					"id": 740340926,
					"content": "Tôi... tôi không hiểu, ngài Roialte, nếu làm vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340927
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340927,
					"content": "Tôi đồng ý phương án này, tốt lắm, rõ ràng rành mạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340928
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340928,
					"content": "Gì, gì cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340929
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340929,
					"content": "Thư kiến nghị? Ha, chuyện này cũng không khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340930
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340930,
					"content": "Vậy là chúng ta đã có nhận thức chung rồi, đợi sau khi Iaune soạn xong bản thảo, sẽ mang đến nhờ hai vị xem lại lần nữa. Còn bây giờ thì... chúng ta ai làm việc người nấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340931
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340931,
					"content": "Gattineo và Difor nhìn nhau rồi quay người rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340932
					]
				},
				{
					"id": 740340932,
					"content": "Thật xin lỗi, ngài Roialte, tôi làm hỏng chuyện này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340933
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340933,
					"content": "Đừng tự trách, đây không phải là lỗi của cậu, Iaune. Chí ít thì không phải đều là lỗi ở cậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340934
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340934,
					"content": "Sao họ lại đột nhiên chấp nhận phương án này vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340935
					]
				},
				{
					"id": 740340935,
					"content": "Tôi không hiểu... hoàn toàn không hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340936
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340936,
					"content": "Đúng vậy, tại sao họ đột nhiên không cãi nhau nữa vậy? Rõ ràng vừa nãy như muốn đánh nhau đến nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340937,
					"content": "Đó là vì mọi người không biết rốt cuộc hai ngài ấy quan tâm điều gì nhất. Chẳng lẽ họ thật sự chỉ không muốn gánh thêm việc sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340938
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340938,
					"content": "Đương nhiên không phải, họ chỉ không muốn để bộ phận khác nhúng tay vào công việc của mình, mà mình còn phải chịu trách nhiệm chính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340939
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340939,
					"content": "Chỉ cần giải quyết được vấn đề này, họ sẽ không bất mãn vậy nữa và cũng đồng ý bắt đầu làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340940
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340940,
					"content": "Nhưng... với phương án mà ngài nói ban nãy thì họ vẫn phải chịu trách nhiệm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340941
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340941,
					"content": "Gattineo và Difor là hai viên chức giàu kinh nghiệm, họ biết rõ một sự thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340942
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340942,
					"content": "Ở Sảnh Phúc Luật, mỗi người đều phải gánh vác trách nhiệm của mình, vậy thì mọi việc mới có thể tiếp tục vận hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340943
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340943,
					"content": "Trách nhiệm to nhỏ ra sao có thể thảo luận lại sau, nhưng mỗi người đều phải tham gia. Nếu như có người từ chối làm việc... vậy người đó tốt nhất nên cầu nguyện tương lai mình sẽ không gặp phải phiền phức nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340944
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340944,
					"content": "Đừng nghĩ nhiều vậy, Iaune, sau này cậu sẽ hiểu thôi. Bây giờ điều cậu phải làm chính là nhanh chóng viết lại một bản \"kiến nghị\", sau đó đưa cho tôi xem, được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340945
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740340945,
					"content": "Vâng, ngài Roialte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340947
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340947,
					"content": "Roialte vội vã rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340948
					]
				},
				{
					"id": 740340948,
					"content": "Haiz, lại phải thức khuya rồi, tôi phải đi mua một ly cà phê đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340949,
						740340952
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340949,
					"content": "Anh hay thức khuya sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340950
					]
				},
				{
					"id": 740340950,
					"content": "Nói thường xuyên thức khuya thì không phải, chỉ là... tôi đã quen hẳn với việc thức khuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340951
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340951,
					"content": "Nhưng dù thế nào, chỉ cần hoàn thành công việc là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340954
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340954,
					"content": "Haiz, đôi lúc tôi cũng nghĩ, tôi làm những việc này thực sự có ý nghĩa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340955
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340955,
					"content": "Cả ngày chỉ loay hoay với máy đánh chữ, soạn văn bản, nghe cằn nhằn, nhận lệnh cấp trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340956
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340956,
					"content": "#{NICKNAME}, dưới tư cách là một... người ngoài khách quan, bạn có suy nghĩ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340957,
						740340958
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340957,
					"content": "Tôi cũng không biết...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340959
					]
				},
				{
					"id": 740340959,
					"content": "Thôi được. Sau khi bạn quan sát thêm, có lẽ sẽ cho tôi được đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340960
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340960,
					"content": "Nếu có hứng thú, ngày mai có thể tới đây tìm tôi nói chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340961
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340961,
					"content": "Là một Kiểm Sát Viên, tôi đã hoàn toàn chìm sâu vào biển cả công việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340962
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340962,
					"content": "Là người ngoài cuộc khách quan mà nói, có thể nói cho tôi biết... ý nghĩa của công việc này nằm ở đâu không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340958,
					"content": "Phải xem xét thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340959
					]
				},
				{
					"id": 740340952,
					"content": "Sức khỏe vẫn quan trọng hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340953
					]
				},
				{
					"id": 740340953,
					"content": "Tôi cũng biết, nhưng... thôi bỏ đi, không có gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340954
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340925,
					"content": "Làm vậy thì khác gì so với lúc trước?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340926
					]
				},
				{
					"id": 740340907,
					"content": "Cãi nhau rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340947
					]
				}
			]
		}
	]
}