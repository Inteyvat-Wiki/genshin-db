			"dialogs": [
				{
					"id": 740340501,
					"content": "Iaune, thật trùng hợp. Tan làm cùng uống cà phê nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340502
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340502,
					"content": "Cảm ơn, nhưng tôi có chuyện về bảo mật nhờ ngài xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340503,
					"content": "Chuyện bảo mật? Là chuyện tôi biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340504
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340504,
					"content": "Tôi nghĩ là không. Sáng nay tôi mới nhận được tài liệu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340505
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340505,
					"content": "Thật hiếm thấy, có lẽ do hôm nay tôi chưa đọc báo Chim Hơi Nước, nên cập nhật tin tức chậm hơn cậu một bước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340506
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340506,
					"content": "Là chuyện bảo mật, thì tại sao lại thấy trên báo Chim Hơi Nước chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340507,
					"content": "Hahaha, tốc độ đưa tin của đám phóng viên kia nhanh hơn Sảnh Phúc Luật của chúng tôi nhiều lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340508
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340508,
					"content": "Nhưng cũng có thể hiểu, dù sao thì họ sẽ nhận được thù lao khi đưa tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340509
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340509,
					"content": "Paimon không thể hiểu được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340510,
					"content": "Không nói chuyện bên lề nữa. Thưa ngài, chuyện là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340511
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340511,
					"content": "Iaune kể chi tiết vấn đề...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340512
					]
				},
				{
					"id": 740340512,
					"content": "Đúng vậy, ban hành văn bản như vậy thật sự rất cần thiết. Trước đó, một tên ngốc đã chụp lại bàn làm việc của mình để khoe khoang cách trang trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340513
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340513,
					"content": "Anh ta là thành viên của \"Hội Đam Mê Máy Ảnh\", còn mang tấm ảnh đó cho những người khác xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340534
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340534,
					"content": "Nhưng một phóng viên tinh mắt đã phát hiện tài liệu nghi là thông tin nội bộ của Sảnh Phúc Luật trong bức ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340514
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340514,
					"content": "Sau đó, bản tin phàn nàn rằng bữa tối trong Sảnh Phúc Luật không có gì ngoài cá, chình ình trên mặt báo Chim Hơi Nước vào ngày hôm sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340515
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340515,
					"content": "Việc này cũng cần giữ kín sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340516,
					"content": "Nghe có vẻ không nghiêm trọng cho lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340517
					]
				},
				{
					"id": 740340517,
					"content": "Dù sao thì đây cũng là chuyện nội bộ, về tình về lý cũng không nên tiết lộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340518
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340518,
					"content": "Người của Đại Sảnh Fontaine sẽ không bao giờ bỏ lỡ cơ hội để cười nhạo Sảnh Phúc Luật, chúng ta phải cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340519
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340519,
					"content": "Mặc dù họ không thực sự quan tâm chúng tôi đang làm gì. Họ chỉ muốn... ừm, cười nhạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340520
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340520,
					"content": "Ừm, tóm lại... tài liệu này sẽ do văn phòng của ngài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340521
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340521,
					"content": "Nhưng liên quan đến vấn đề nhân sự... Văn phòng của Difor rõ ràng là thích hợp hơn để ký tài liệu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340522
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340522,
					"content": "Trong tài liệu này, tuy có nhắc nhở mọi người về tầm quan trọng của việc bảo mật, nhưng quan trọng hơn là làm thế nào để họ biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340523
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340523,
					"content": "Theo tôi, việc này nên do Difor phụ trách và văn phòng của chúng tôi sẽ hỗ trợ. Như vậy vừa hiệu quả, vừa có thể bảo mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340524
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340524,
					"content": "Gattineo nhanh chóng ký tên vào vị trí hỗ trợ trên tài liệu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340525
					]
				},
				{
					"id": 740340525,
					"content": "Nhưng mà, ngài Gattineo! Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340526
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340526,
					"content": "Được rồi, chuyện không thể trì hoãn. Mau đi tìm Difor, nếu không sự kiên nhẫn của anh ấy sẽ sớm tan biến vì công việc thường ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340527
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340527,
					"content": "Tôi cũng sẽ giúp mọi người tìm nguyên tắc bảo mật có sẵn, khi văn bản chính thức được ban hành, văn phòng chúng tôi nhất định sẽ ủng hộ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340535
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340535,
					"content": "Mau tìm anh ấy đi! Tôi còn phải đi... Hmm, xử lý công việc khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340536
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340536,
					"content": "Gattineo vội vã rời đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340528
					]
				},
				{
					"id": 740340528,
					"content": "Sao cơ? Ngài Gattineo, khoan đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340529,
						740340530
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340529,
					"content": "Đi mất rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340531
					]
				},
				{
					"id": 740340531,
					"content": "Bạn thấy năng lực của ngài Gattineo chưa? Bí quyết để mọi thứ trở nên thỏa đáng chính là không bao giờ làm việc rủi ro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340532
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340532,
					"content": "Thì ra là khả năng trốn tránh trách nhiệm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340533,
					"content": "Hết cách... Đành phải đi tìm ngài Difor thôi. Đi bên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340530,
					"content": "Đi nhanh thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340535
					]
				}
			]
		},
