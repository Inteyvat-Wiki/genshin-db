			"dialogs": [
				{
					"id": 740340601,
					"content": "Iaune. Cậu tìm tôi có việc gì không? Hớt ha hớt hải thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340602
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340602,
					"content": "Chuyện là thế này, thưa ngài Difor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340603
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340603,
					"content": "Iaune kể chi tiết vấn đề...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340604
					]
				},
				{
					"id": 740340604,
					"content": "Cậu tìm sai người rồi, Iaune. Lẽ nào cậu không thấy trọng điểm của tài liệu này là \"bảo mật\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340605
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340605,
					"content": "Tôi còn tưởng chủ đề là \"tài liệu này\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340606
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340606,
					"content": "Ngữ pháp đúng là như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340607
					]
				},
				{
					"id": 740340607,
					"content": "Này, vấn đề bây giờ không phải chuyện này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340608,
					"content": "Tôi đánh giá cao sự nghiêm túc của cậu. Nhưng tôi sẽ không ký đâu, đáng lẽ Gattineo phải là người phụ trách vấn đề này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340609
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340609,
					"content": "Ngài Gattineo nói nên để ngài phụ trách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340610
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340610,
					"content": "Ha! Tôi sao? Phải làm thế nào, tôi phải cầm loa và hét vào mặt từng người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340611
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340611,
					"content": "\"Thưa các vị, đừng mang máy ảnh đến văn phòng, vì như vậy sẽ dẫn đến rò rỉ thông tin! Tuyệt đối đừng làm những việc như thế này nhé!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340612
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340612,
					"content": "Hay là tôi phải in vài trăm tờ nội quy, đặt lên bàn từng nhân viên của Sảnh Phúc Luật, để họ mang đi uống cà phê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340613
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340613,
					"content": "Chúng tôi không giống Gattineo, có thể bắt những kẻ rò rỉ thông tin và cho họ một bài học. Việc duy nhất chúng tôi có thể làm là phát thông báo, sẽ chẳng ai quan tâm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340614
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340614,
					"content": "Nhưng anh ấy đã ký vào tài liệu rồi, ngài xem ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340615
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340615,
					"content": "Chàng trai, cậu có biết \"bên hỗ trợ\" là ý gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340616
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340616,
					"content": "Ừm... Nghe theo bên điều phối?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340617
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340617,
					"content": "Ý là \"ít nhất trách nhiệm chính không thuộc về tôi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340618
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340618,
					"content": "Tôi sẽ không ký đâu. Nếu muốn văn phòng chúng tôi xử lý, thì hãy để Maneval đích thân lên tiếng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340619
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340619,
					"content": "Difor tức giận bỏ đi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340620
					]
				},
				{
					"id": 740340620,
					"content": "Anh ta, anh ta lớn tiếng quá, tôi không dám ngắt lời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340621,
					"content": "Bạn xem, tính tình của vị này nóng nảy vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340622
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340622,
					"content": "Làm sao bây giờ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340623
					]
				},
				{
					"id": 740340623,
					"content": "Đừng lo... Chúng ta quay về tìm ngài Roialte thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
