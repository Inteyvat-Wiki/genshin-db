			"dialogs": [
				{
					"id": 740340701,
					"content": "Iaune, tôi đoán là cậu sẽ không mang tin tốt gì cho tôi đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340702
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340702,
					"content": "Thưa ngài, đúng là không phải tin vui. Nói đúng hơn, đây là về thông tin \"bảo mật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340703
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340703,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340704
					]
				},
				{
					"id": 740340704,
					"content": "Rất hài hước, Iaune. Vậy thông tin \"bảo mật\" này rốt cuộc là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340705
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340705,
					"content": "Iaune kể chi tiết vấn đề...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340706
					]
				},
				{
					"id": 740340706,
					"content": "Tình huống này quả thực có thể xảy ra, dù sao nhân viên ở Sảnh Phúc Luật cũng không nhạy cảm với mức độ phân loại của một tập tài liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340707,
						740340708
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340707,
					"content": "Vấn đề này cũng bỏ qua sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340709
					]
				},
				{
					"id": 740340709,
					"content": "Tất cả là nhờ bọn người Gattineo cả đó. Toàn bộ tài liệu ra vào của Sảnh Phúc Luật sẽ được giao cho họ duyệt rồi đánh dấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340710
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340710,
					"content": "Nghe có vẻ khá ổn. Nhưng để đỡ rắc rối, thì dù là tài liệu gì, nhóm thẩm định cũng sẽ đánh giá là \"bảo mật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340711
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340711,
					"content": "Tuần trước Carsix đã có một bài phát biểu tại Viện Ca Kịch Epiclese, nói về vở kịch mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340712
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340712,
					"content": "Tôi nhớ rồi, bài phát biểu không dài, nhưng có rất nhiều người nghe, thậm chí còn được đăng báo nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340713
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340713,
					"content": "Đã từng phát biểu, vậy thì ai cũng biết rồi, sao còn gọi là bí mật chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340714,
					"content": "Mặc dù vậy, Gattineo cũng nhất quyết xem nó là \"bảo mật\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340715,
						740340716
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340715,
					"content": "Biết đâu trong đó có nội dung quan trọng thật?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340717
					]
				},
				{
					"id": 740340717,
					"content": "Có mới lạ đó. Anh ta đưa bài phát biểu này thành \"bảo mật\", nhưng lại mặc kệ bản thảo gốc trước đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340718
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340718,
					"content": "Carsix mới không tự viết bản thảo, cả bài này đều nhờ người khác viết hộ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340742
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340742,
					"content": "Chỗ duy nhất mà anh ta điều chỉnh, chính là ký tên trên đó, rồi sửa thêm một số câu từ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340719
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340719,
					"content": "Nhưng những bản thảo gốc trước đó thì chất đống trên bàn làm việc của Carsix không ai xử lý cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340720
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340720,
					"content": "Nếu như đây chính là bí mật của Gattineo, vậy tại sao lại không bảo mật cả những tài liệu này đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340721,
						740340722
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340721,
					"content": "Đây cũng là một cách bảo mật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340723
					]
				},
				{
					"id": 740340723,
					"content": "Đủ rồi đó! Họ chẳng qua muốn đỡ việc thôi. Theo Gattineo thì cách tốt nhất để giữ bí mật, chính là biến mọi việc thành bảo mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340724
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340724,
					"content": "Nếu vậy sẽ không ai biết được đâu mới là bí mật cần cất giấu. Ngay cả bản thân họ cũng không biết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340725
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340725,
					"content": "Nếu muốn cất giấu một ly nước, thì cách tốt nhất chính là đổ nó xuống hồ. Cách làm này cũng không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340726
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340726,
					"content": "Nhưng nếu muốn giấu một ly Fonta thì sao? Là muốn biến cả hồ nước thành hồ Fonta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340727
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340727,
					"content": "#Cả một hồ Fonta... hihi, muốn được bơi trong đó quá. Fonta ngon lắm, đúng không, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340728,
						740340729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340728,
					"content": "Paimon, trọng tâm câu chuyện không phải nằm ở đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340731
					]
				},
				{
					"id": 740340731,
					"content": "Vậy thì... tài liệu này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340732
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340732,
					"content": "Iaune, việc này có liên quan đến nhân sự, cậu đến tìm tôi là đúng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340733
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340733,
					"content": "Nhưng trước hết, cần phải để Gattineo thẩm định cấp độ cơ mật của việc này. Cũng giống như đã nói trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340743
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340743,
					"content": "Trước khi chính thức làm việc, chúng ta phải biết thứ đang cất giấu rốt cuộc là một ly nước hay là một ly Fonta đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340734
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340734,
					"content": "Chúng ta là đồng nghiệp, tôi sẽ không làm khó dễ đâu. Phòng làm việc của chúng tôi chắc chắn sẽ cố gắng hỗ trợ xử lý chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340735
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340735,
					"content": "Difor cầm lấy tài liệu, chậm rãi ký tên vào bên hỗ trợ..",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340736
					]
				},
				{
					"id": 740340736,
					"content": "Được rồi, mau đi tìm Gattineo đi! Vấn đề nhân sự lớn như vậy, tôi phải đi báo trước với một số người mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340737
					],
					"speakerTitle": "Difor"
				},
				{
					"id": 740340737,
					"content": "Nhưng mà ngài Difor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340744
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340744,
					"content": "Difor rời đi mà không thèm ngoảnh lại...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340738,
						740340739
					]
				},
				{
					"id": 740340738,
					"content": "Đi mất rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340740
					]
				},
				{
					"id": 740340740,
					"content": "Haiz, đúng là ngài Difor, nóng nảy lại anh minh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340741
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340741,
					"content": "Hết cách rồi, chúng ta đi tìm Gattineo thôi, đi bên này nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340739,
					"content": "Đi nhanh thật đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340740
					]
				},
				{
					"id": 740340729,
					"content": "Đợi lát chúng ta đi uống một ly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340730
					]
				},
				{
					"id": 740340730,
					"content": "Thật sao? Phải giữ lời đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740340722,
					"content": "Biết đâu là... để cho chắc chắn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340723
					]
				},
				{
					"id": 740340716,
					"content": "Ưm... Có lẽ có lý do để anh ấy làm như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340717
					]
				},
				{
					"id": 740340708,
					"content": "Không ai nói với họ điều... \"tuyệt mật\" này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340744
					]
				}
