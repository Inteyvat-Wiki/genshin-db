			"dialogs": [
				{
					"id": 740340801,
					"content": "Iaune, không ngờ lại gặp nhau ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340802
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340802,
					"content": "Ngài Gattineo, tôi đang muốn tìm ngài. Tôi cần báo với ngài một tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340803
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340803,
					"content": "Tin gì thế? Tôi vừa đọc xong tờ báo Chim Hơi Nước hôm nay, trong đó đâu có nhắc đến Sảnh Phúc Luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340804
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340804,
					"content": "Vâng, đây là tin bảo mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340805
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340805,
					"content": "À, vậy đúng là hiếm gặp. Ngoài ký giả ra, còn có người có thể phân biệt được một việc có phải bảo mật hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340806
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340806,
					"content": "Iaune kể lại chi tiết mọi chuyện...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340807
					]
				},
				{
					"id": 740340807,
					"content": "Ai da, ngài Difor quả là một ký giả chăm chỉ, thiếu chút đã xông thẳng đến chỗ tôi để hỏi về tính bảo mật của tài liệu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340808
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340808,
					"content": "Tôi hoàn toàn đồng tình với quan điểm của ngài ấy, nhưng chuyện \"Máy ảnh rò rỉ thông tin\" khá nghiêm trọng, có thể sẽ liên quan đến cả Sảnh Phúc Luật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340809
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340809,
					"content": "Mình tôi không thể để quyết định được, buộc phải đưa đến chỗ những vị khác thẩm định, phải để họ biết hết mới được. Ví dụ như... ngài Carsix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340810
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340810,
					"content": "Ơ? Nhưng tài liệu này là do chính ngài Carsix gửi xuống mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340811
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740340811,
					"content": "Vậy thì càng nên để ngài ấy biết phương án xử lý của chúng ta. Nào, chúng ta đi tìm Roialte trước, rồi tìm ngài Carsix sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340812
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740340812,
					"content": "Sao cơ? Đợi đã! Ngài Gattineo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
