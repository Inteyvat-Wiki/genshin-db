			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thứ Tự Xưng Là \"Enjou\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510301,
					"content": "Nên nói đây là bất ngờ thú vị, hay là chẳng có gì bất ngờ nhỉ. Trong bóng tối, vẫn kiên cường bước đi, xé tan màn sương đen để đến gặp ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510302
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510302,
					"content": "Người có thể làm điều này, e rằng không một ai khác ngoài ngươi. Nhưng không thể tin rằng ngươi lại đi hợp tác với chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510303
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510303,
					"content": "Ngươi lại muốn tám chuyện để kéo dài thời gian chứ gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510304,
					"content": "...Xem ra, các ngươi chẳng biết gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510305
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510305,
					"content": "Nhìn thấy ta khiến ngươi khí huyết sôi sục thì vẫn có thể hiểu được, nhưng chạy lâu như vậy mà vẫn tràn đầy năng lượng thì quả là phiền phức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510306
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510306,
					"content": "Để ta cùng các ngươi vận động một chút vậy. Đến bao giờ ngươi chịu nghe ta nói thì thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				}
			]
		},
