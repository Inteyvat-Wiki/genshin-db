				"points": []
			},
			"dialogs": [
				{
					"id": 400510101,
					"content": "Tsumi, chúng tôi làm được rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510102,
					"content": "Tôi đã thấy rồi, cả ba tòa tháp đều đã được xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510103
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510103,
					"content": "Những người bị thương và các binh sĩ đã tăng tốc sơ tán do môi trường của Enkanomiya đã được phục hồi. Ừm, hầu hết đều đã rời đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510104
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510104,
					"content": "Nhưng có vẻ đã xảy ra một số chuyện ngoài dự tính, mời hai vị theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsumi"
				}
			]
		},
		{
			"id": 4005102,
			"completionStepIds": [
				4005102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
