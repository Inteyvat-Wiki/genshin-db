			"dialogs": [
				{
					"id": 400511701,
					"content": "Có vẻ như Tsumi đã đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511702,
					"content": "Trên đường tới đây, chúng ta không bỏ lỡ cô ấy đó chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511703,
					"content": "...Lại là kịch bản kiểu này sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511704
					]
				},
				{
					"id": 400511704,
					"content": "Hm, thôi đừng buồn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511705,
					"content": "Hãy suy nghĩ tích cực lên, dù sao thì đại đa số binh sĩ Đảo Watatsumi đều đã rời đi rồi. Nếu ban nãy thực sự có tộc rồng đi qua thì chí ít cũng không có ai bị thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511706,
					"content": "Mặc dù chỉ nghĩ đến cái tên kia thôi là đã thấy bực mình, nhưng cũng không còn cách nào khác, chúng ta thử dẫn ánh sáng vào đây xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005119,
			"completionStepIds": [
				4005119
