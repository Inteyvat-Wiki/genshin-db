					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511901,
					"content": "Đếm kỹ thì những con rồng nhỏ đã không còn ở đây nữa. Chắc là đã được cứu ra ngoài rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511902,
					"content": "Dưới này quả thực có Rồng Biển Sâu, tên đó không lừa chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511903,
					"content": "Lẽ nào Tsumi thực sự là rồng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511904,
					"content": "Nhưng chúng ta đã tìm khắp nơi vẫn chưa thấy cô ấy, cô ấy rốt cuộc đang ở đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511905
					],
					"speakerTitle": "Paimon"
				},
				{
