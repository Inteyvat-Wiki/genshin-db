			"dialogs": [
				{
					"id": 400511101,
					"content": "Vấn đề đã được giải quyết thật rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511102,
					"content": "Lần này tên đó không hề lừa chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511103,
					"content": "Nói một cách chính xác thì hắn chưa từng lừa dối chúng ta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "Nhìn cái bộ dạng xảo quyệt của hắn như vậy mà bạn vẫn có thể tin hắn được sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511105,
					"content": "Đường vào Dainichi Mikoshi có lẽ đã mở lại rồi. Chúng ta hãy xuống đó xem thử thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005115,
			"completionStepIds": [
				4005115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005115",
							"2"
						],
						"stepId": 4005115,
						"stateName": "QUEST_STATE_UNFINISHED"
