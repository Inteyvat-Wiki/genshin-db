			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511501,
					"content": "Là, là Tsumi! Cô ấy đứng trước Dainichi Mikoshi làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511502,
					"content": "Các người đã quay trở lại đây rồi, vậy xin hỏi cuộc giải cứu của chúng ta đã thành công chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511503
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511503,
					"content": "Những con rồng nhỏ đã được giải cứu. Còn đám rồng già yếu đã trốn lại vào trong nước sau khi chúng tôi đánh bại lũ tinh anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511504,
					"content": "Tsumi, cô thực sự là rồng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511505,
					"content": "Tôi không có ý định giải thích bất cứ điều gì. Mặc dù tôi có thể giao tiếp với bạn, nhưng tôi hiểu rằng, giao tiếp với con người thì chỉ có thể kết thúc bằng sự phản bội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511506
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511506,
					"content": "Xung đột giữa hai chủng tộc sẽ cứ tiếp diễn mãi mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511507
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511507,
					"content": "Trước khi rời khỏi đây, tôi cần phá hủy tháp đèn này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511508
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511508,
					"content": "Một mình cô làm được sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511509
					]
				},
				{
					"id": 400511509,
					"content": "Đừng có đến gần, cũng đừng có mưu đồ đánh lén tôi một cách vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511510
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511510,
					"content": "Ngọn tháp này... dường như có thể nghe thấy nguyện vọng của tôi. Chỉ cần tôi muốn, nó sẽ thay đổi ánh sáng và bóng tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511511
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511511,
					"content": "Thậm chí, chỉ cần tôi muốn, nó cũng có thể sụp đổ trước mặt tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511512
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511512,
					"content": "Chỉ cần có một tia suy nghĩ là tôi sẽ có thể phá hủy thứ mang đến sự thống khổ cho loài rồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511513
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511513,
					"content": "Nhưng, tại sao... tại sao tôi lại không làm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511514
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511514,
					"content": "#Úi, làm sao bây giờ {NICKNAME}, việc này còn tệ hơn cả việc mất đi San Hô Máu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511515,
						400511516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511515,
					"content": "Tsumi cô có nhận ra cái này không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				},
				{
					"id": 400511517,
					"content": "Đây là...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511518
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511518,
					"content": "Tsumi rút ra mặt dây chuyền mà cô ấy có và ghép chúng lại với nhau.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511519
					]
				},
				{
					"id": 400511519,
					"content": "Mặt dây chuyền này có hình ba con rắn quấn lấy nhau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511520,
					"content": "Mặt dây chuyền này đã ở bên cạnh tôi kể từ khi còn bé. Tại sao nó lại khớp với hai mảnh của các người nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511521
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511521,
					"content": "Cô hẳn đã tự có câu trả lời rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511522
					]
				},
				{
					"id": 400511522,
					"content": "Nực cười, ý các người muốn nói... muốn nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511523
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511523,
					"content": "Tôi không hiểu lắm... mảnh này là của Kokomi, mảnh này là từ Dainichi Mikoshi, và mảnh của Tsumi thì đã ở bên cô ấy từ nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511524,
					"content": "Cô thuộc về đảo Watatsumi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511525
					]
				},
				{
					"id": 400511525,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511526
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511526,
					"content": "Từ nhỏ tôi đã sống chung với rồng. Ngoài mặt dây chuyền này ra, còn có một vài rương sách. Tôi đã học ngôn ngữ và chữ viết của loài người từ chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511527
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511527,
					"content": "Nhưng không lâu sau đó, Enkanomiya đã không còn một bóng người. Nó trở nên hoàn toàn trống rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511528
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511528,
					"content": "Cho đến gần đây tôi mới có cơ hội tiếp xúc với con người. Tôi mới hiểu được nội dung và ý nghĩa của những cuốn sách đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511529
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511529,
					"content": "Tsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511530,
					"content": "Có một câu nói trong sách của loài người mà cho đến bây giờ tôi mới hiểu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511531
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511531,
					"content": "\"Con người thuộc về nơi họ được sinh ra, còn động vật thì thuộc về nơi chúng được ăn no.\" Tôi là rồng, không phải người, nên tôi phải quay trở về đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511532
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511532,
					"content": "Dainichi Mikoshi cứ để vậy đi. Một ngày nào đó, chúng tôi sẽ trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511534
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511534,
					"content": "Tsumi đi mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511535,
					"content": "Rốt cuộc tại sao cô ấy lại đột nhiên thay đổi quyết định nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511536,
					"content": "Có lẽ Kokomi biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511537
					]
				},
				{
					"id": 400511537,
					"content": "Ừm, đúng vậy. Chắc chắn là Kokomi đã đoán trước được khả năng này nên mới đưa mảnh mặt dây chuyền đó cho chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511538,
					"content": "Vấn đề ở đây cũng coi như đã được giải quyết. Chúng ta quay lại nói cho cô ấy biết đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511516,
					"content": "Tsumi hãy nhận lấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				}
			]
		},
		{
			"id": 4005116,
			"completionStepIds": [
				4005116
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
