			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511601,
					"content": "Này, Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511602,
					"content": "Các bạn trở lại rồi à. Những binh sĩ trở về đã kể sơ lược cho tôi về những gì đã xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511603
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511603,
					"content": "Bạn đã hợp tác với pháp sư tên Tsumi và thành công xua tan màn sương đen, nhưng Dainichi Mikoshi lại phát sinh bất thường, phải vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511604,
					"content": "Đúng là vậy, sau đó còn xảy ra một số chuyện kỳ lạ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511605,
					"content": "Kể lại những chuyện đã xảy ra sau đó cho Kokomi nghe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511606
					]
				},
				{
					"id": 400511606,
					"content": "Vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511607
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511607,
					"content": "Ừm, xin lỗi Kokomi, chúng tôi đã lấy mặt dây chuyền của bạn tặng cho cô ấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511608,
					"content": "Đừng để tâm. Như tôi đã nói đó, Đảo Watatsumi không cần đến nó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511609
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511609,
					"content": "Nó là thứ còn sót lại sau khi Watatsumi Omikami chỉnh đốn lại triều chính và cải cách chế độ ở Enkanomiya. Ba mảnh được phân cho Dainichi Mikoshi, Sangonomiya và Ngự Sử Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511610
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511610,
					"content": "Ý định ban đầu là để cho người dân, Jibashiri và các ngự sử giám sát lẫn nhau. Nhưng giờ đây chỉ có người dân là sinh sôi nảy nở, hai dòng kia lại đang suy tàn. Mặt dây chuyền này cũng trở nên vô dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511611
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511611,
					"content": "Ngự Sử Watatsumi... Hình như cũng có binh sĩ cho rằng Tsumi là sứ giả của Watatsumi thì phải? Đáng tiếc đôi mắt của cô ấy lại là đặc điểm của loài rồng, cô ấy đã đánh lừa tất cả chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511612,
					"content": "Không hẳn vậy. Tạo hình của tượng Ngự Sử Watatsumi thường là nửa người nửa rắn, để tượng trưng rằng họ là thân quyến của xà thần. Tuy nhiên theo thời gian, các đời sau của Ngự Sử Watatsumi ngoại trừ đôi mắt ra thì không khác gì con người cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511613
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511613,
					"content": "Ngược lại, những câu chuyện về Long Nhân và tộc Long Nhân sống dưới lòng đất... hoàn toàn là hư cấu. Không có bằng chứng nào về sự tồn tại của họ trong các tài liệu mật của Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511614
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511614,
					"content": "Ồ, như vậy thì Tsumi không phải là rồng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511615,
					"content": "Sau khi Watatsumi Omikami sử dụng toàn bộ sức mạnh để tạo ra đảo Watatsumi, sức mạnh của ngài đã dần dần suy kiệt. Vì vậy, Ngự Sử Watatsumi đã không còn được sinh ra nữa. Vị Ngự Sử Watatsumi cuối cùng được ghi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511616
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511616,
					"content": "Là vị Ngự Sử được đặt nhiều kỳ vọng, có thể giao tiếp với rồng và con người. Khi cô ấy còn là một đứa trẻ sơ sinh, cô ấy đã bị rồng tập kích ở biên giới Enkanomiya cùng với pháp sư giám hộ của mình, từ đó không một ai biết được tung tích của cô ấy ở đâu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511617
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511617,
					"content": "Nhiều người cho rằng cô ấy đã chết, nhưng cũng có người cho rằng cô ấy đã được nuôi dưỡng bởi rồng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511618
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511618,
					"content": "Tộc Ngự Sử đối với Watatsumi ân trọng như núi. Giờ đây, loài rồng và Đảo Watatsumi đã không còn tranh chấp lãnh thổ sinh tồn nữa, tôi thực lòng cầu mong cô ấy có thể tìm thấy nơi mình thuộc về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511619
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511619,
					"content": "Hóa ra đây mới là thân thế thực sự của Tsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511620,
					"content": "Có điều, bây giờ tôi đã hiểu nguyên lý của San Hô Máu, với tư cách là Thánh Pháp Sư đương nhiệm của Sangonomiya, tôi cần phải nghĩ ra cách mới để chống lại việc \"hóa đất thánh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511621
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511621,
					"content": "Lần này nhờ có bạn mà vấn đề \"hóa đất thánh\" mới được giải quyết. Đảo Watatsumi sẽ được bình yên trong nhiều thập kỷ tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511622
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 400511622,
					"content": "Rất cảm ơn bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
