					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510201,
					"content": "Có bóng tối bao trùm bên trong Dainichi Mikoshi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510202,
					"content": "Theo lẽ thường thì bây giờ mọi thứ ở Enkanomiya đều phải trở lại bình thường mới đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510203
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510203,
					"content": "Đáng tiếc, nơi này hiện đã trở thành nơi nguy hiểm nhất. Tôi cũng không biết chuyện gì đã xảy ra nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510204
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510204,
					"content": "Nhưng tôi có thể cho bạn biết kẻ đứng sau tất cả đang ở đâu. Chỉ có thể phiền bạn đi xử lý hắn, để bắt hắn khai ra toàn bộ kế hoạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510205
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510205,
					"content": "Nhưng sao cô lại biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510206,
					"content": "Tôi vẫn luôn quan sát chuyển động của màn sương đen, và đã nhận thấy một số điểm bất thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510207
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510207,
					"content": "Có một vòng xoáy mờ nhạt liên tục hấp thụ bóng tối. Tôi nghĩ đó chắc hẳn là dòng chảy yếu ớt xuất hiện bởi nhu cầu sức mạnh Vực Sâu của hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510208
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510208,
					"content": "Tên đó rất nguy hiểm, ngay cả rồng cũng không phải là đối thủ của hắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510209,
						400510210
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510209,
					"content": "Yên tâm đi, tôi cũng đang muốn cho hắn một trận đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				},
				{
					"id": 400510211,
					"content": "Vậy làm phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510212
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510212,
					"content": "Nếu đoán không nhầm, thì hắn đang ở khu vực <color=#00E1FFFF>Thư Viện</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510210,
					"content": "Đừng lo, tên đó rất thích ăn đòn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				}
			]
		},
		{
			"id": 4005103,
			"completionStepIds": [
				4005103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
