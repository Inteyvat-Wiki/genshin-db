				"points": []
			},
			"dialogs": [
				{
					"id": 400510501,
					"content": "Khoan khoan! Còn đánh nữa ta sẽ chết thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510502
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510502,
					"content": "Thì đây là mục đích của ta mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510503
					]
				},
				{
					"id": 400510503,
					"content": "Cô gái có con ngươi dài mảnh đó, cô ta tự xưng là gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510504
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510504,
					"content": "Hử, sao ngươi biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510505,
					"content": "Cô ta tên là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510506
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510506,
					"content": "Cô ấy tự xưng là Tsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510507,
					"content": "Hừ, rõ ràng đó chỉ là một con rồng đang bắt chước theo con người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510508
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510508,
					"content": "Rồng sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510509
					]
				},
				{
					"id": 400510509,
					"content": "Ngươi đoán ra rồi đúng không? Rồng Biển Sâu là một loài rất thông minh, hơn nữa còn là chủng tộc tiến hóa rất nhanh. Từ hơn ngàn năm trước đã có truyền thuyết này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510510
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510510,
					"content": "Đó chính là Long Nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510511
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510511,
					"content": "Long... Nhân? Nghe có vẻ giống với mấy kiểu biệt danh mà Paimon hay đặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510512,
					"content": "Rất lâu về trước, Enkanomiya đã có truyền thuyết này rồi. Sau khi đám Rồng Biển Sâu bị đánh bại, chúng bắt đầu tiến hóa để tồn tại. Có nghĩa là, chúng đã mô phỏng những kẻ chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510513
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510513,
					"content": "Cuối cùng ngoại trừ con ngươi ra thì Long Nhân của tộc rồng đã có được hình dạng y hệt con người. Nghe nói chúng đã xâm nhập vào Enkanomiya, và thay thế những vị trí quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510514
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510514,
					"content": "Thế nào, nhớ ra ai chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510515
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510515,
					"content": "Con ngươi của Tsumi hình như thẳng đứng thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510516,
					"content": "Con ngươi của loài rồng khi ở dưới ánh sáng sẽ là một đường dọc mảnh mai. Đây là bằng chứng cho thấy cô ta đã lừa các ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510517
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510517,
					"content": "Nhưng cô ấy vẫn luôn giúp đỡ chúng tôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510518,
					"content": "Cô ta chỉ đang lợi dụng các ngươi để trả thù ta mà thôi, dù sao thì ta cũng đã phản bội bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510519
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510519,
					"content": "Trước đây ta và rồng đã kết thành đồng minh. Ta có thể dùng màn sương đen bao trùm toàn bộ Enkanomiya để tiện cho bọn chúng trà trộn vào Dainichi Mikoshi giải cứu đồng loại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510520
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510520,
					"content": "Ngược lại, chúng sẽ cho phép Giáo Đoàn Vực Sâu đi qua lãnh thổ, và góp sức giúp ta cải tạo lại ba tòa tháp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510521
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510521,
					"content": "Nhưng chúng không ngờ rằng sương mù của Vực Sâu lại là chất độc khủng khiếp đối với các sinh vật nguyên tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510522
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510522,
					"content": "Cho nên đám rồng đó mới cho rằng ngươi đã phản bội bọn họ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510523,
					"content": "Bản thân ta cũng nghĩ đây là sự phản bội. Dù sao thì nếu mấy con rồng đó cứ phè phỡn dưới sức mạnh của Vực Sâu thì bọn ta còn mặt mũi gì nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510524
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510524,
					"content": "Cái tên này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510525,
					"content": "Bây giờ các ngươi đã hết giá trị lợi dụng đối với cô ta rồi. Sau đó, cô ta sẽ sử dụng sức mạnh của Dainichi Mikoshi để trấn áp quần thể san hô và tạo ra bóng tối để che chắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510526
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510526,
					"content": "Bây giờ, có lẽ chúng đang lặn xuống bên dưới để giải cứu đồng bọn đang bị giam cầm. Cứ như vậy, không lâu nữa nguồn gốc của San Hô Máu cũng sẽ bị cắt đứt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510527
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510527,
					"content": "Mặc dù đám Rồng Biển Sâu cũng rất tội nghiệp, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510528,
					"content": "Nếu như ngươi vẫn có ý định bảo vệ tương lai của Đảo Watatsumi, thì ngươi phải nhanh chân lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510529
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510529,
					"content": "Sử dụng cơ quan mà ta để lại trước đó, sẽ dẫn ánh sáng xua tan bóng tối ở Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510530
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510530,
					"content": "Bọn ta sẽ không bao giờ tin những gì ngươi nói đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510531,
					"content": "Các ngươi bây giờ còn có thể lựa chọn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510532
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510532,
					"content": "Dù sao thì lần này ta vẫn chẳng có thu hoạch được gì cả. Nhưng không sao, ta cũng chỉ là nhân vật phụ trong giáo đoàn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510533
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510533,
					"content": "Không giống như những kẻ vây quanh điện hạ, ta quan tâm đến những thứ vụn vặt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510534
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510534,
					"content": "Ah, ta phải đi đây, chúng ta có lẽ sẽ không gặp lại nhau nữa. Thứ này tặng cho ngươi coi như món quà chia tay. Ta đã tìm thấy nó ở Dainichi Mikoshi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510535
					],
					"speakerTitle": "Thứ Tự Xưng Là \"Enjou\""
				},
				{
					"id": 400510535,
					"content": "Thứ này có vẻ như cùng một bộ với thứ mà Kokomi đã đưa cho chúng ta... A, không được, bây giờ không phải là lúc nghĩ đến chuyện đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510536,
					"content": "Tức thật, hắn lại chạy mất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510537,
					"content": "Dù hắn có nói gì đi nữa thì chúng ta cũng không thể tin hắn, mau quay về hỏi Tsumi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
