			"dialogs": [
				{
					"id": 761680101,
					"content": "Quả nhiên, vẫn phải mang theo bánh mì thơm phức mới có động lực đi tuần tra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680102
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680102,
					"content": "Đang làm gì ở đây vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680103
					]
				},
				{
					"id": 761680103,
					"content": "Tôi đang chuẩn bị đồ cần thiết cho việc tuần tra, nhưng có vẻ trong kho hết mất Nấm Kỳ Ảo mà tôi thích nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680104
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680104,
					"content": "Đó là loại bánh mì mới mà cô Beryna làm gần đây. Mọi người đều rất thích nên trong kho chẳng còn gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680105
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680105,
					"content": "Hầy, chỉ nghĩ đến việc không được ăn Nấm Kỳ Ảo thôi là tôi đã chẳng còn chút động lực nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680106
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680106,
					"content": "Hình như tôi biết cách làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680107
					]
				},
				{
					"id": 761680107,
					"content": "Thật không vậy, quá tuyệt rồi, bạn tôi ơi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680108
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680108,
					"content": "#Đã vậy thì, {F#cô}{M#cậu} có thể làm cho tôi một ít Nấm Kỳ Ảo được không? Yên tâm, tôi sẽ không để {F#cô}{M#cậu} làm không công đâu.",
					"roleType": "TALK_ROLE_NPC",
