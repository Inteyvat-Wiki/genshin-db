			"dialogs": [
				{
					"id": 761360301,
					"content": "(Có lẽ <color=#FFCC33FF>Jahoda</color> muốn xem tình trạng của chiếc rương...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "Hihi... Để xem dạo này kiếm được bao nhiêu tiền nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360303,
					"content": "Lần trước sếp nói sẽ thưởng thêm cho mình, hay là bây giờ mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360304,
					"content": "Sao trong này không có tiền vậy? Chỉ có mỗi một tờ giấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360305,
					"content": "\"Jahoda thân mến, đóng hộp lại đi. Tiền thưởng của em không nằm trong này.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360306,
					"content": "Hừm, sếp lại đang dọa người ta rồi. Không biết có ngăn bí mật nào không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360307,
					"content": "Không có ngăn bí mật nào đâu, tiền thưởng của em ở đây này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360308,
					"content": "Ồ, cảm ơn sếp, em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360309,
					"content": "Ah ah!! Ốiiiii! Sếp!!!! E-Em... chỉ đang kiểm đếm thôi!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360310,
					"content": "Em đi làm việc ngay đây, đi ngay đây ạ!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360311,
					"content": "Dừng lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360312,
					"content": "Dạ rõ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360313,
					"content": "Khóa hộp cho chắc vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360314,
					"content": "Dạ vâng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360315,
					"content": "Rồi đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360316,
					"content": "Tuân lệnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
