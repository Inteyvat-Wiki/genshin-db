				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "Đâu rồi? Thật là xui xẻo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020102,
					"content": "Chết thật, mình đâu thể viết thêm một bản được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020103,
					"content": "Cô làm mất thứ gì à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "Đúng vậy, do tôi là người lạc quan, nên hy vọng thứ đó thực sự là do tôi làm mất thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020105,
					"content": "Cái này... cũng tính là suy nghĩ lạc quan sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "Haha... Dù sao thì thứ tôi cần tìm là giấy tờ kiểm toán chi phí công vụ nửa năm của văn phòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020108,
					"content": "Giấy tờ này sắp phải gửi lên cho cô Keiser nhập liệu, nhưng tôi đột nhiên phát hiện bị thiếu mất năm trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020109,
					"content": "Hơn nữa, năm trang này là của năm tháng khác nhau, bao gồm rất nhiều hạng mục chi phí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020110,
					"content": "Khi nãy tôi duyệt lại lần cuối thì phát hiện giấy tờ của mấy tháng này mất tiêu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020111,
					"content": "Nếu không phải do tôi sơ ý làm mất, mà thực sự chưa được lên sổ sách thì... tổng chi phí công vụ làm sao tôi tính toán được đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020112,
					"content": "Hic... Nếu do tôi làm thiếu, chắc chắn cô Cadme sẽ bắt tôi lục lại toàn bộ sổ sách trong mười năm nay để đối chiếu lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020113,
					"content": "Nghe có vẻ nghiêm trọng nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "Đúng vậy. Nếu thực sự sót đơn, thì khả năng tháng sau sẽ có rất nhiều văn phòng xảy ra vấn đề về giải chi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020115,
					"content": "Thật xui xẻo... Tôi chỉ nhớ đêm qua thức trắng để làm xong sổ sách, sáng nay mang theo tới Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020116,
					"content": "Lúc vừa tới đây gặp phải một đám hải âu, tôi bị dọa cho một phen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020117,
					"content": "Haiz, không chừng lúc đó đã làm rơi tài liệu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020118,
					"content": "Để tôi tìm giúp cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "Tốt quá, vậy chúng ta cùng nhau tìm dọc theo đường này xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020121,
					"content": "Số liệu này không có nội dung gì tuyệt mật, nên người khác có nhặt được thì cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020122,
					"content": "Đúng rồi! Lúc tôi đến đây còn gặp được sĩ quan Muirne! Cô ấy đã giúp tôi đuổi lũ hải âu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020123,
					"content": "Để tôi đi hỏi cô ấy xem có nhìn thấy giấy tờ không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020119,
					"content": "Chúng ta cùng nhau đi tìm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "Làm mất đồ đâu phải chuyện tốt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
