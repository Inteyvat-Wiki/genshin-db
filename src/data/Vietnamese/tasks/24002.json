			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "Đây chính là tài liệu mà tôi cần tìm! Tất cả đều ở đây, tốt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020402,
					"content": "Sao cô lại làm sổ sách ở quán cà phê chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "Bởi vì... tôi phải uống thật nhiều cà phê mới có thể tính toán rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020404,
					"content": "Đây là sổ sách chi phí công vụ của tất cả văn phòng ở Palais Mermonia, vốn dĩ phải có năm người cùng nhau làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020405,
					"content": "Nhưng ngoài tôi ra, những người khác đều bị điều sang văn phòng khác, đi công tác bên ngoài hoặc đi phỏng vấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020406,
					"content": "Nên tới lúc kiểm toán, cả văn phòng chỉ có mình tôi xử lý, phải mấy ngày nay tôi không ngủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020407,
					"content": "Không chỉ mỗi tính toán, đến việc đối soát cũng giao cho tôi làm, mắt tôi sắp mờ hết cả rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020408,
					"content": "Tóm lại, tìm được giấy tờ là tốt rồi. Cô Isadora, tôi cùng cô về Palais Mermonia nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020409,
					"content": "Cảm ơn. Haiz, sĩ quan Muirne, trong ba tháng qua, tôi chỉ gặp đúng hai người tốt là cô và Nhà Lữ Hành đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
