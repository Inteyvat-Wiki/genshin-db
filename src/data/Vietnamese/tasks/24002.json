			"dialogs": [
				{
					"id": 240020201,
					"content": "Cô Isadora, cần tôi giúp chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020202
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020202,
					"content": "Sĩ quan Muirne, cô còn nhớ hồi sáng tôi có ôm theo một xấp giấy tờ đến văn phòng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020203
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020203,
					"content": "Có nhớ, còn bị lũ Hải Âu Tử Kim tấn công đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020204
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020204,
					"content": "Đúng vậy! Sau khi lũ Hải Âu Tử Kim đó bay đi mất, tôi liền vội vàng chạy tới văn phòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020205
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020205,
					"content": "Phiền cô nhớ lại xem, sau khi tôi đi thì có giấy tờ nào bị rơi dưới đất không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020206
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020206,
					"content": "Hmm... Tôi nhớ không rõ, lúc đó tôi cũng phải xử lý công việc khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020207
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020207,
					"content": "Nếu cần thì chúng ta có thể tái hiện lại hiện trường, có nghĩa là đi lại một lần con đường đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020208
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020208,
					"content": "Hả? Được sao? Vậy thì phiền cô quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020209
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020209,
					"content": "Chỉ là tìm đồ thôi mà, so với mấy chuyện ở Palais Mermonia thì dễ dàng hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020210
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020210,
					"content": "Cô Isadora, tôi nhớ là đống hồ sơ cô ôm theo đều được buộc thành từng tệp, phải vậy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020211
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020211,
					"content": "Đúng thế! Quan sát của cô tốt thật. Trong lúc kiểm toán chi phí, các khoản khai báo cần phải cực kỳ chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020212
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020212,
					"content": "Nhỏ thì thay khóa ngăn kéo bàn làm việc, lớn thì mời thợ đến sửa tường trong Palais Mermonia, đều phải liệt kê ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020213
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020213,
					"content": "Vậy nên sổ sách mỗi tháng đều rất dày, cần phải dùng dây thừng buộc lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020214
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020214,
					"content": "Vì vậy, không thể có hiện tượng \"vài trang bị rơi ra\" như vậy. Dù có rơi thì cũng phải là tệp tài liệu rất dày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020215
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020215,
					"content": "Thời gian cô tới văn phòng cũng chưa phải quá lâu... chúng ta mau xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				}
			]
		},
