			"dialogs": [
				{
					"id": 200500101,
					"content": "Thật nhức đầu... ở đây phải giải quyết như thế nào chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "Vì đợt tuyển chọn kỵ sĩ sắp tới, tôi đang phải huấn luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500104,
					"content": "Ừm... nhưng mà, tôi không có sức mạnh như đại nhân Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500105,
					"content": "So với việc tập luyện \"sức mạnh\", tôi cảm thấy việc học \"kỹ năng\" thích hợp với tôi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500106,
					"content": "Ví dụ, cách làm sao để phá hủy các cột gỗ này cùng lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500107,
					"content": "Nếu bạn rảnh, hãy cùng suy nghĩ với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500108,
					"content": "Để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "Không sao, cứ từ từ nghĩ, cột gỗ không tự chạy đi mất được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500111,
					"content": "Thứ duy nhất chạy đi mất chỉ có thời gian và sinh mệnh bị tiêu phí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500114,
					"content": "Tôi nghe người khác nói, Nguyên Tố có thể tác động lẫn nhau, nếu có thể khiến cho lửa trong chậu lửa này hơi nổ một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500115,
					"content": "Nhưng mà, trong chậu lửa này, cũng cần phải có lửa mới được chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500109,
					"content": "Hai người chúng ta cùng xông lên...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "Bạn có quen với việc tác chiến tập thể không? Thật là ngưỡng mộ... lúc nào cũng có thể gọi được người giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500113,
					"content": "Giống như tôi, chỉ có thể học cách chiến đấu một mình thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
