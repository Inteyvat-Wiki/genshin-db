				},
				{
					"id": 200500202,
					"content": "Vẫn chưa nghĩ ra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500203
					]
				},
				{
					"id": 200500203,
					"content": "Ừm... những Nhà Mạo Hiểm tôi gặp trước đây, cũng thỉnh thoảng như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500204
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500204,
					"content": "Khi đối diện với quái vật có thể dũng cảm chiến đấu, đánh cột gỗ thì lại lúng túng tay chân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500205
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500205,
					"content": "Mà còn dùng mọi cách để gia cố cột gỗ, giống như sợ có thể bị đánh gãy dễ dàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500206
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500206,
					"content": "Nếu thích tìm sự khiêu chiến như thế, ra bên ngoài tìm ma vật không phải là được sao?",
					"roleType": "TALK_ROLE_NPC",
