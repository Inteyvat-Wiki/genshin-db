			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000101,
					"content": "Mới đó mà cuộc huấn luyện cũng đã đi đến nửa sau. Tiến triển thuận lợi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000102,
						737000103
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000102,
					"content": "Có thể nói là đang dần tốt hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				},
				{
					"id": 737000104,
					"content": "Nhưng mà Sorush có thể tự mình suy ngẫm lại trong lúc kể chuyện cho chúng tôi nghe sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000105,
					"content": "Đối thoại là một phương pháp học tập tuyệt vời đối với Sorush. Đặc biệt là khi đối tượng trò chuyện không phải là đám người nhàm chán của Hội Nghi Hoặc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000106
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000106,
					"content": "#Tiền bối nói chuyện hơi độc đoán quá rồi... {NICKNAME} là một Yasnapati xuất chúng, nhưng người của Hội Nghi Hoặc cũng không hoàn toàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000107
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000107,
					"content": "Có lẽ bên cạnh thói xu nịnh và dối trá thì còn có vài đức tính lặt vặt khác bị sót mất sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000108
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000108,
					"content": "Ơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000109
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000109,
					"content": "#Nhìn bộ dạng không phục của ngươi kìa, lát nữa cứ để hai nhân chứng {NICKNAME} và Paimon đánh giá. Tất nhiên là sau khi nghe ngươi kể xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000103,
					"content": "Vẫn còn có thể tiến bộ hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				}
			]
		},
		{
			"id": 7370006,
			"completionStepIds": [
				7370006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370006",
							"2"
						],
						"stepId": 7370006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000601,
					"content": "Yên tĩnh quá, không có ai ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000602,
					"content": "Cho dù Rashnu có ở đây thì có lẽ cũng sẽ rất yên tĩnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000603
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000603,
					"content": "Ừm, nhưng nếu cô ấy ở đây, chúng ta sẽ phải nhỏ giọng lại. Trông cô ấy lúc nào cũng như đang buồn ngủ, lúc trước chúng ta dùng Trống Kory đánh thức cô ấy, cô ấy cũng có vẻ không vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000604,
					"content": "Nghe nói những người càng im lặng thì khi họ tức giận sẽ càng đáng sợ. Không biết khi Rashnu nổi trận lôi đình sẽ trông như thế nào nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000605,
					"content": "Nói như vậy, Yasnapati của ta sẽ là người đáng sợ nhất nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000606
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000606,
					"content": "#Hả? Tôi hiểu {NICKNAME} nhất, mặc dù rất ít nói, nhưng thật ra lại rất dịu dàng. Đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000607,
						737000609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000607,
					"content": "Tôi sắp tức giận thật rồi, hừ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000608
					]
				},
				{
					"id": 737000608,
					"content": "Nhìn kìa, chẳng đáng sợ chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000611,
					"content": "Được rồi, quay lại chuyện chính đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000612,
					"content": "Như đã thấy, cái cây này được gọi là Barsom, và Rashnu là thân quyến của Barsom, nhưng bây giờ cô ấy không có ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000613
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000613,
					"content": "Sau đó thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000614,
					"content": "Sau đó à? Không có sau đó, về Rashnu và Barsom, không còn gì để nói thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000615
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000615,
					"content": "Có vẻ như Sorush đang che giấu điều gì đó... Đúng rồi, về Trống Kory...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000616,
					"content": "Che, che giấu? Không có chuyện đó. Còn về Trống Kory... không phải mọi người đã từng thấy qua rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000617
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000617,
					"content": "Đúng rồi, còn nhớ lúc đó Rashnu nói Trống Kory bị cô ấy vứt ở nhiều nơi khác nhau, Nasejuna còn rất bất ngờ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000618,
					"content": "Nếu tôi nhớ không lầm thì Sorush lúc đó rất hoang mang, cũng không trả lời câu hỏi của Nasejuna nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000619,
					"content": "Nói như vậy thì văn hiến của Hội Nghi Hoặc sai quá sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000620,
					"content": "Mặc dù diễn tấu theo nhạc phổ đúng là có thể đánh thức Rashnu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000621
					]
				},
				{
					"id": 737000621,
					"content": "Hình như tôi đã biết tại sao Zurvan không chịu tin Hội Nghi Hoặc rồi. Nghĩ kỹ lại, họ thật sự đã giúp được gì sao? Manh mối biết được từ Hội Nghi Hoặc đều là nửa thật nửa giả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000622,
					"content": "Ơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000623
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000623,
					"content": "Hội Nghi Hoặc giờ đây có một số thành viên không đáng tin cậy cho lắm, nhưng cũng giống như một cái cây to, dù có sum suê đến đâu thì cũng sẽ có vài cành khô lá héo mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000624
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000624,
					"content": "Chỉ cần bỏ hết những cành khô lá héo đó, số còn lại... số còn lại chắc chắn đáng tin cậy... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000625
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000625,
					"content": "...Tại sao Hội Nghi Hoặc lại thành ra như bây giờ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000626
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000626,
					"content": "Tôi cũng muốn biết đáp án đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000627
					]
				},
				{
					"id": 737000627,
					"content": "Chính bởi vì ở cùng người của Hội Nghi Hoặc suốt thời gian dài, nên khó mà phát hiện ra sự thay đổi của họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000628
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000628,
					"content": "Chỉ khi nói chuyện với người ngoài mới phát hiện, thì ra Hội Nghi Hoặc từ lâu đã không còn như trước đây nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000629
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000629,
					"content": "Dù sao cũng đã qua mấy trăm năm rồi, ngoài cái tên Hội Nghi Hoặc vẫn còn như cũ, các thành viên của hội chắc chắn đều đã trải qua mấy đời người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000630,
					"content": "Lẽ nào danh vọng mà ta tìm kiếm, danh vọng mà ta mong muốn được Yasnapati ca tụng cuối cùng cũng sẽ như vậy sao... Mọi thứ đều đã thay đổi, chỉ còn lại một danh hiệu trống rỗng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000631
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000631,
					"content": "Tiền bối muốn ta hiểu chuyện này sao? Không nên như vậy... nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000632
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000632,
					"content": "Sorush cũng đừng buồn! Nói không chừng... nói không chừng Zurvan không có ý đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000633,
					"content": "Nhìn bộ dạng thất thểu của Sorush, cứ cảm thấy như mình đã làm chuyện gì đó xấu xa vậy... Cứ để cho Zurvan khuyên cô ấy thôi vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000610
					]
				},
				{
					"id": 737000610,
					"content": "#...{NICKNAME}, nói gì đi! Cứ im im vậy trông thật đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}