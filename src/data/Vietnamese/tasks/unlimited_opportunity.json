			"dialogs": [
				{
					"id": 411310201,
					"content": "Ở đó có rất nhiều ma vật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "Đó cũng là lý do tại sao tôi muốn thuê bạn đó, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113103,
			"completionStepIds": [
				4113103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
