					"content": "Khi các bạn hái hoa, đột nhiên bị hoa tấn công... hoa biết tấn công người?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311308,
					"content": "À há, đây chắc chắn là ảnh hưởng của thiên thạch! Chỉ có thiên thạch mới có thể khiến những bông hoa này trở nên đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311309,
					"content": "Chắc sẽ không sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311310
					]
				},
				{
					"id": 411311310,
					"content": "Đúng vậy, thiên thạch và hoa... hoàn toàn không liên quan đến nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411311311,
					"content": "Không, không, không, hãy tin tôi, bông hoa ngọt này chắc chắn có chỗ đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311312
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311312,
					"content": "Bông hoa này chẳng có gì đặc biệt cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311313
					]
				},
				{
					"id": 411311313,
					"content": "Không, không, nó từng ở bên cạnh thiên thạch, chắc chắn nó có điểm gì đó đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311314
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311314,
					"content": "Nhưng, bất kể là nhìn, sờ hay ngửi, thì bông hoa ngọt này cũng chẳng khác gì những bông hoa ngọt thông thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411311315,
					"content": "Cái này... các bạn không cần phải lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311316
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311316,
					"content": "Đây là thù lao, bạn nhận lấy, hợp tác vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311317
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311317,
					"content": "Đoá hoa ngọt này... hửm... nước hoa? Đánh dấu trang? Hoa khô? Đều không tồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
