				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "Người khác cũng sẽ nghĩ đến việc làm ăn này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "Ừm, tất nhiên, vì vậy chúng ta phải mau chóng qua bên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310303,
					"content": "Nhà Lữ Hành, nếu bạn đồng ý, chúng ta hãy mau chóng xuất phát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310304,
					"content": "Chúng ta cứ ở đây tranh luận thêm một giây, nói không chừng tôi lại kiếm ít hơn 1 mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310305,
					"content": "...Ui da... cứ như vậy có lẽ không thể thuyết phục được anh ây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310306,
					"content": "Nếu có thể cho anh ấy biết việc làm ăn này không kiếm được tiền, hoặc... thiên thạch thực sự rất nguy hiểm là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113104,
