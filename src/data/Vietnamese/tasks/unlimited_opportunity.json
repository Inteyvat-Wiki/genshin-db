			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "Chạm vào thiên thạch sẽ bị hôn mê...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "Hư? A... tôi đã nghe nói về tin đồn này, đây là một vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
