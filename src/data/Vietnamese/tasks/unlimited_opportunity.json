	"talks": [
		{
			"id": 4113101,
			"completionStepIds": [
				4113122
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "Ừm, không tồi, việc làm ăn này chắc chắn sẽ kiếm được rất nhiều tiền, nhưng có một vấn đề nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310102,
					"content": "Có vấn đề gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "Hả? Ồ... Nhà Lữ Hành, là bạn à. Bạn đến thật đúng lúc, bạn có hứng thú muốn tham gia một vụ... một vụ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310107,
					"content": "Một vụ... kinh doanh vĩ đại... trước giờ chưa từng có, chắc chắn có thể kiếm được rất nhiều tiền?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310108,
					"content": "Chỉ cần bạn giúp tôi một chuyện nhỏ. Hai chúng ta chắc chắn đều có thể kiếm được rất nhiều tiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310104,
					"content": "Ngân hàng Bắc Quốc được bảo vệ rất nghiêm ngặt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "A, đó là đương nhiên, ngay cả bảo vệ cũng đều là người Snezhnaya, tôi... Không! không, bạn đang nghĩ gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310106,
					"content": "Có vẻ như việc đi khắp đó đây thực sự đã khiến bạn mở mang đầu óc ra rất nhiều, những suy nghĩ của bạn rất giàu trí tưởng tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310112,
					"content": "Nhưng kế hoạch làm ăn lần này của tôi, chắc chắn sẽ là một kế hoạch thực tế đầy triển vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310113,
					"content": "Bạn có biết gần đây có thiên thạch từ trên trời rơi xuống không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310114,
					"content": "Tôi muốn tìm một khối thiên thạch, đập ra thành vài miếng rồi mang về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310115,
					"content": "Sau đó, tìm một thợ khéo léo, chạm khắc và đánh bóng nó tạo thành đồ trang sức...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310116,
					"content": "Món trang sức được làm từ thiên thạch... bất kể là nhẫn, vòng cổ, lắc tay hay là hoa tai thì chắc chắn đều sẽ khiến những người giàu có vui vẻ bỏ tiền ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310117,
					"content": "Nhà lữ hành, việc bạn cần làm rất đơn giản, chỉ cần bảo đảm tôi không bị quái vật quấy rầy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310118,
					"content": "Thế nào, chúng ta thống nhất thoả thuận?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310119,
					"content": "Tuyệt đối không được đến gần thiên thạch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "Cái gì? Tại sao chứ, tôi tuyệt đối sẽ không bỏ qua vụ kinh doanh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310109,
					"content": "Có phát hiện gì mới trong bộ luật hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "Ừm, thành thật mà nói, bộ luật của Liyue khá nghiêm ngặt, hầu như không có sơ hở gì, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310111,
					"content": "Ôi, không! Không! Tôi tuyệt đối không làm chuyện phi pháp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				}
			]
		},
