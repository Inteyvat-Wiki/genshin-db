			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#Là {F#cô}{M#cậu} à, {NICKNAME}. Không ngờ lại gặp {F#cô}{M#cậu} ở một nơi thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200402,
					"content": "Lâu rồi không gặp, Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "Coi như là tuần tra định kỳ đi. Có điều, đối với tôi mà nói, đây là hoạt động cần thiết để duy trì trạng thái chiến đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200405,
					"content": "Gần đây Mondstadt khá yên bình, hầu như không có mối đe dọa nào đáng để toàn Đội Du Kích phải ra quân. Mọi người trong đội... tinh thần có phần nhẹ nhõm đi nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200406,
					"content": "Kết hợp làm việc và nghỉ ngơi cũng là chuyện tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "Tuy nói vậy, nhưng với tư cách đội trưởng, tôi phải luôn duy trì sức chiến đấu của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200408,
					"content": "Dù sao thì, lưỡi kiếm của kẻ thù cũng không vì hòa bình mà mòn đi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200409,
					"content": "Vì vậy, tôi có thói quen tìm một nơi yên tĩnh để luyện kiếm thuật trong lúc giải lao giữa những lần tuần tra, để đảm bảo tư thế không bị gượng gạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200410,
					"content": "Đúng lúc lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "Ồ? Yêu cầu thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200413,
					"content": "#Có điều, động tác của tôi rất nhanh, máy ảnh của {F#cô}{M#cậu} có theo kịp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200414,
					"content": "Cứ theo tốc độ bình thường của cô là được!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "#Được. {F#Cô}{M#Cậu} đã tự tin như vậy thì tôi cũng sẽ dốc toàn lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200417,
					"content": "Nhìn cho kỹ nhé, khoảnh khắc cơn sóng cuộn trào chỉ thoáng qua thôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200415,
					"content": "Ống kính của tôi sẽ cố gắng theo kịp!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "Để tôi chụp ảnh cho cô!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "Cô đang làm nhiệm vụ ở đây sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
}