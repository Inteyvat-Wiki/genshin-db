				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "Để đồ tiếp tế xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730202,
					"content": "Đặt xong cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "Tốt quá, lần này tôi có thể yên tâm hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730204,
					"content": "Nhưng tôi vẫn mong rằng tất cả những ai lên núi tuyết đều phải chuẩn bị chu đáo, đừng động đến số thực phẩm ứng cứu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730205,
					"content": "Mà, quần áo của bạn hơi phong phanh đó, chẳng lẽ đây là mốt mới nhất của Mondstadt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730206,
					"content": "Hãy lấy số thù lao này, mau trở về mặc thêm ít quần áo đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				}
			]
		},
