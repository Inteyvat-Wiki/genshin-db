	"talks": [
		{
			"id": 2007301,
			"completionStepIds": [
				2007301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2007301",
							"2"
						],
						"stepId": 2007301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "Nhà Lữ Hành! Bạn đến đúng lúc đó, có thể giúp tôi một việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "Bạn cũng thấy đó, núi tuyết rất khắc nghiệt, ngay cả nhà mạo hiểm dày dạn kinh nghiệm cũng không dám nói mình có thể hoàn toàn ứng phó được với tất cả tình huống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730104,
					"content": "Tôi được lệnh của Đội Trưởng Đại Diện canh gác ở đây, cảnh báo cư dân Mondstadt không được lên núi tuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730105,
					"content": "Tôi đã khuyên ngăn rất nhiều cư dân Mondstadt không lên núi nữa, nhưng còn những Nhà Mạo Hiểm thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730106,
					"content": "Bạn cũng biết đó, tuy là khuyên họ đừng tùy tiện lên núi, nhưng có ai nghe đâu, cứ khăng khăng đi vào núi tuyết mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730107,
					"content": "Tôi chẳng biết đã xử lý bao nhiêu việc liên quan đến Nhà Mạo Hiểm rồi... thế mà số lượng Nhà Mạo Hiểm muốn lên núi tuyết chỉ có tăng chứ không hề suy giảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730108,
					"content": "Tôi không thể quản lý tất cả Nhà Mạo Hiểm được... vì thế, chúng tôi dự tính sẽ đặt đồ tiếp tế ở một số nơi trên núi tuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730109,
					"content": "Như vậy thì những Nhà Mạo Hiểm đã biết mùi khổ cực, muốn quay trở về sẽ có thêm nhiều cơ hội để rời khỏi núi tuyết hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730110,
					"content": "Nhưng... nếu Nhà Mạo Hiểm nào may mắn đi được quá sâu vào trong núi, thì họ chỉ có thể dựa vào bản thân họ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730111,
					"content": "Nói chung là bạn có thể giúp tôi đặt những đồ tiếp tế này lên núi tuyết được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730112,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "Vậy thì nhờ cả vào bạn nhé. Haiz, nếu mấy Nhà Mạo Hiểm đó cũng giống bạn, vừa giỏi vừa biết chừng mực, thì tốt biết mấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730117,
					"content": "Tôi đã đánh dấu ba vị trí lên bản đồ của bạn rồi, mỗi nơi đặt <color=#00E1FFFF>1 phần Giăm Bông</color> là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730118,
					"content": "Haiz, hy vọng những Nhà Mạo Hiểm đó tự biết thân biết phận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730114,
					"content": "Như vậy có ích không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "Có ích cũng chẳng có lợi gì... nói chung là có thì vẫn hơn không mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730116,
					"content": "Trong môi trường khắc nghiệt này, đồ tiếp tế nhiều thêm chút cũng là một chuyện tốt, trông cậy vào bạn đấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
