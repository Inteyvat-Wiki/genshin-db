			"dialogs": [
				{
					"id": 402390301,
					"content": "Vừa hay mọi người đều ở đây rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402390302,
					"content": "Mọi chuyện cuối cùng cũng đã kết thúc rồi, tốt nhất mọi người nên nói rõ những gì cần nói. Sau khi rời khỏi hội trường mà có tranh chấp gì thì Thương Hội Voynich không chịu trách nhiệm đâu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390303
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390303,
					"content": "Ừm... Liyue không bị tổn thất gì nghiêm trọng, việc triệt phá đường dây buôn bán cũng đã đạt được mục đích chuyến đi này rồi, vậy tôi xin giao hết những người này cho phía Fontaine xử lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390304
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402390304,
					"content": "Cảm ơn vì đã thông cảm, do phải sắp xếp hồ sơ nên tôi thực sự cần bắt bọn họ về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390305
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390305,
					"content": "Còn đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390306
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390306,
					"content": "Dù sao cũng là người của Thương Hội Voynich, nếu tôi tùy tiện đưa đi, chủ nhân của Hội Đồng Bí Mật chắc cũng sẽ không đồng ý đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390307
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390307,
					"content": "Vậy cô có đề xuất gì không? Cô Chevreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390308,
					"content": "Ừm... Cách đây không lâu, vì cần truy bắt tội phạm, tôi đã phá hủy biển quảng cáo của triển lãm đặt tại Thị Trấn Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390309
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390309,
					"content": "Đây là hành động tự thú của thám tử sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390310
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390310,
					"content": "Ý tôi là, tôi sẽ không đưa anh ta đi nữa, để đổi lại, thì chuyện biển quảng cáo kia xem như xí xóa, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390311
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390311,
					"content": "Quyết định vậy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390312
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390312,
					"content": "Tôi cứ tưởng chuyện này khó giải quyết lắm, ai ngờ lại như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402390313,
					"content": "Chú ơi, chúng cháu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390314
					],
					"speakerTitle": "Ati"
				},
				{
					"id": 402390314,
					"content": "Chuyện của chú, các chị đã kể cho chúng cháu nghe rồi, nhưng mà... chúng cháu vẫn muốn chú là chú của chúng cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390315
					],
					"speakerTitle": "Raya"
				},
				{
					"id": 402390315,
					"content": "Nhưng mà chú...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390316
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390316,
					"content": "Nếu năm đó anh không nhẹ dạ cả tin lời hứa của bọn họ, và cũng để lại cho đội thu nhận anh ít vũ khí để tự vệ, thì có lẽ đã không dẫn đến hậu quả như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390317
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390317,
					"content": "Nên theo tôi thấy, lỗi lầm thực sự của anh không phải là nghiên cứu vũ khí, mà là không dùng tri thức của mình để bảo vệ những người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390318
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390318,
					"content": "Cô... nói đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390319
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390319,
					"content": "Vậy thì, cơ hội chuộc tội thật sự đã đặt ngay trước mắt, mà anh vẫn còn do dự sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390320
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390320,
					"content": "Tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390321
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390321,
					"content": "Hãy để chú chuộc tội cho đàng hoàng nhé, các cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390322
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390322,
					"content": "#{NICKNAME}, còn có tiểu thư Yelan của Liyue, lần hợp tác này rất vui vẻ, vậy tôi xin phép cáo từ trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390323
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402390323,
					"content": "#{NICKNAME}, tôi cũng còn nhiều công việc phải xử lý, xin thứ lỗi không ở lại lâu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390324
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402390324,
					"content": "Xem ra anh tự do rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390325
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390325,
					"content": "Dù họ không bắt tôi... Nhưng tôi đã gia nhập thương hội vì mục đích cá nhân, suýt nữa làm hỏng danh tiếng của mọi người, cô thật sự không định xử lý tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390326
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390326,
					"content": "Khi anh mới gia nhập thương hội, tôi đã biết anh nói rất nhiều lời dối trá. Nhưng khi anh khẳng định sa mạc là \"quê hương\" của mình, tôi lại phát hiện anh không hề nói dối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390327
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390327,
					"content": "Thật không giấu gì, tôi cũng là người sẵn sàng gọi sa mạc là \"quê hương\", nên tôi rất hứng thú với câu chuyện đằng sau anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390328
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390328,
					"content": "#Nhờ {NICKNAME} nên tôi đã nhận được câu chuyện rồi. Câu chuyện này cũng không tệ, nên những rắc rối anh mang đến cứ coi như là phần quà kèm theo của câu chuyện vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390329
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390329,
					"content": "Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390330
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390330,
					"content": "Có điều, dù sao anh cũng đã phạm phải nhiều điều cấm kỵ của thương hội, tôi không thể để anh tiếp tục ở lại thương hội nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390331
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390331,
					"content": "Tôi hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390332
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390332,
					"content": "Tôi khuyên anh nên đưa những đứa trẻ này trở về sa mạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390333
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390333,
					"content": "Tại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390334
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390334,
					"content": "Từ khi tôi có nhận thức, những cuộc tranh đấu trong sa mạc dường như chưa bao giờ ngừng lại, nhưng sau khi hiểu về câu chuyện của anh, tôi cảm thấy rằng những người ở sa mạc cũng có thể có một cách sống khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390335
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390335,
					"content": "Sumeru bây giờ đã khác xưa rất nhiều, dưới sự trị vì của Tiểu Vương Kusanali, anh giúp ba đứa trẻ này xây dựng lại quê hương cũng không phải chuyện không thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390336
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390336,
					"content": "Cảm ơn ý tốt của cô, nhưng đã qua nhiều năm như vậy, ốc đảo đó chắc chắn đã bị gió cát chôn vùi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390337
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390337,
					"content": "Cho dù dựng lại vài cái lều thì sẽ làm được gì? Dù sao thì hiện thực cũng rất tàn khốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390338
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390338,
					"content": "Quý khách có muốn xem thử không? Chỉ cần giá cả phải chăng, cái gì cũng có thể mua được ở chỗ chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390339
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390339,
					"content": "Chỉ cần có Mora là có thể mua được mọi thứ ư? Hừm... Vậy tôi có thể mua lại cho những đứa trẻ này một \"quê hương\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390340
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390340,
					"content": "Phong cách rao bán hàng của Dori là như vậy đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402390341,
					"content": "Được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390342
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390342,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402390343,
					"content": "Tada! Hãy nhìn viên đá quý đầy ma lực này, kiệt tác của ma nữ lừng danh Alice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390344
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390344,
					"content": "Chỉ cần chôn nó xuống đất, dù là nơi cát vàng cuồn cuộn, cũng có thể mọc lên một suối nước, tạo nên một ốc đảo xanh tươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390345
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390345,
					"content": "Cái gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390346
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390346,
					"content": "Ừm... là hàng thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390347
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 402390347,
					"content": "Triển lãm thương mại Nod-Krai quả thực đúng như quảng cáo, cái gì cũng có thể mua được... Chỉ có điều món bảo vật như thế này chắc chắn có giá trên trời, chúng tôi không đủ khả năng mua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390348
					],
					"speakerTitle": "Ashvapati"
				},
				{
					"id": 402390348,
					"content": "Nói sao nhỉ, ma nữ ủy thác tôi bán viên đá quý này đã đặc biệt dặn dò rằng, giá của nó phải là \"niềm vui của bọn trẻ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390349
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390349,
					"content": "Haiz... Rõ ràng có cách bán kiếm được nhiều tiền hơn, nhưng yêu cầu của vị ma nữ này thật khó từ chối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390350
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390350,
					"content": "\"Niềm vui của bọn trẻ\"? Vậy là bao nhiêu Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390351
					],
					"speakerTitle": "Ati"
				},
				{
					"id": 402390351,
					"content": "Ừm... Có rồi! Tôi chỉ lấy số tiền ba đứa nhỏ này kiếm được ở triển lãm, như vậy có thể coi là chúng đã dùng công sức của mình mua lại \"quê hương\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390352
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390352,
					"content": "Đây chắc chắn là một chuyện vô cùng vui vẻ, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390353
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390353,
					"content": "Chốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390354
					],
					"speakerTitle": "Ati"
				},
				{
					"id": 402390354,
					"content": "Được được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390355
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 402390355,
					"content": "Không ngờ cuối cùng lại gặp được bất ngờ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402390356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402390356,
					"content": "Không hổ danh là Dori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402390357
					]
				},
				{
					"id": 402390357,
					"content": "Triển lãm năm nay đúng là thú vị hơn những năm trước khá nhiều đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		},
