			"dialogs": [
				{
					"id": 710480201,
					"content": "Bạn về rồi sao, Hiệp Hội Nhà Mạo Hiểm chào đón bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480202,
						710480206,
						710480208,
						710480211
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480202,
					"content": "Về Vực Đá Sâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480203
					]
				},
				{
					"id": 710480203,
					"content": "Bạn muốn hỏi ở đó có gì sao? Haha, ai biết được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480204,
					"content": "Có người nói thợ mỏ đào được Đá Cầu Nguyện, sau khi cầu nguyện thì nhận được kết quả trái ngược; cũng có người nói rằng đào được đuôi của long vương... đều là những tin đồn tức cười mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480205,
					"content": "Được rồi, không cần tìm tôi để hỏi chuyện của Vực Đá Sâu, tôi cũng không rõ ở đó đã xảy ra chuyện gì. Cứ đi nói với Muning là được. Đây là yêu cầu của Tổng Vụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480206,
					"content": "Về ủy thác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480207
					]
				},
				{
					"id": 710480207,
					"content": "Haha... Khắp nơi đều là thương nhân sống dựa vào Vực Đá Sâu, bạn không sợ phiền phức, nhưng tôi thì phải nuôi Hiệp Hội Nhà Mạo Hiểm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480208,
					"content": "Về Muning...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480209
					]
				},
				{
					"id": 710480209,
					"content": "À, anh ta sao... Hừm, điều anh ta đến Vực Đá Sâu chắc cũng là do Tổng Vụ muốn rèn luyện anh ta thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480210
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480210,
					"content": "Những tên tiểu tử có xuất thân tốt như vậy rất dễ tự đắc ý, nhân viên công vụ mà cứ bay bổng như thế là không được... Vực Đá Sâu sẽ giúp cho anh ta trưởng thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 710480211,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480212
					]
				},
				{
					"id": 710480212,
					"content": "Ừm, à... hướng về những ngôi sao và vực sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
