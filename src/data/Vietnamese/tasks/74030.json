					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "Hai người rất thông thạo đấy. Nếu ở bên ngoài thì tôi đã thuê làm trợ lý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300402,
					"content": "Chuyện nhỏ này sao có thể làm khó chúng tôi chứ? Mà thiết bị này rốt cuộc dùng để làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300403,
					"content": "Ở đây có một vết nứt dẫn ra bên ngoài cần được canh gác, giờ dùng thiết bị chặn lại là sẽ tiết kiệm được nhân lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300404,
					"content": "Kỹ thuật này cũng không có gì mới ở Viện Khoa Học Fontaine, nhưng tại rảnh quá nên tôi đã tiến hành cải tạo đôi chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300405,
					"content": "Thứ này hiện tại vẫn chưa phải bản hoàn thiện, phiên bản hoàn thiện đang được dùng trong Đường Hầm Mỏ Tinh Thể... Khụ, nói hơi nhiều rồi, hai người coi như chưa nghe thấy là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300406,
					"content": "Đường Hầm Mỏ Tinh Thể cũng có đường đi ra ngoài sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "Haiz, đúng vậy! Thông minh quá rồi đó. Nhưng thông minh thì cũng phải biết giữ miệng đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300411,
					"content": "Được rồi, vấn đề này coi như đã xong. Galvana không cần phải thường xuyên đến đây canh gác nữa, tôi cũng có thể nghỉ ngơi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300412,
					"content": "...Suýt quên, đây là thù lao, cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300408,
					"content": "Phiên bản hoàn thiện lợi hại hơn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "Tất nhiên rồi, bản hoàn thiện còn có thiết bị phụ... Mà hỏi nhiều thế để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300410,
					"content": "Nếu muốn biết thì có thể đi xem thử... Nếu lỡ bị bắt thì đừng bảo tôi xúi dại là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				}
			]
		}
	]
