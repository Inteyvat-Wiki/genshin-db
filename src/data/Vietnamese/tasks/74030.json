			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "Hai người đến thật đúng lúc, mau giúp một tay với.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300202,
					"content": "Anh đọc được suy nghĩ sao? Ghê thật!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "Galvaryet vừa bảo chúng tôi tới giúp... Mà sao anh lại biết được thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300204,
					"content": "Vì ở đây chỉ có hai người mới giúp được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300205,
					"content": "...Cũng đúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300210,
					"content": "Dù sao cũng không phải chuyện gì khó khăn, thiết bị nghiên cứu này cần phải hai người cùng thao tác. Chỉ lệnh thì tôi đã nhập xong rồi, hai người chỉ cần qua đó kéo cần gạt là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300211,
					"content": "Suýt quên... Thiết Bị Trữ Năng Lượng ở gần đó, lắp nó vào trước rồi hẵng khởi động nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300212,
					"content": "Và còn... Để tôi xác nhận đã, hai người không phải là kẻ hay hủy diệt máy móc đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300213,
					"content": "Cái này còn phải phụ thuộc vào khái niệm của anh nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "Sao lại hỏi chuyện này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300216,
					"content": "Lúc trước tôi có nhờ Galvana giúp, tôi vừa nhìn sang chỗ khác thì máy đã báo hỏng. Hỏi là chuyện gì thì cô ấy cũng không nói được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300217,
					"content": "Sau đó, từ miệng cô em gái tôi mới biết là không có thứ máy móc nào trụ được quá nửa ngày trước cô ấy. Đến Alain Guillotin mà gặp cô ấy chắc cũng phải thở dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300218,
					"content": "Lúc đó phí sửa chữa còn trừ thẳng vào tiền thù lao của tôi... Hai người mà cũng thế thì tôi lại phải bỏ tiền túi ra mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300219,
					"content": "Không ngờ lại có chuyện này... Chúng tôi sẽ không giống cô ấy đâu, cứ yên tâm nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300220,
					"content": "Vậy nhờ cả vào hai người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300214,
					"content": "Nếu như thiết bị nghiên cứu tấn công tôi, thì đúng rồi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "Chuyện này không giúp không công được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "Lát nữa Galvaryet sẽ đăng ký thù lao cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300208,
					"content": "Hả? Nhưng cô ấy bảo chúng tôi tìm anh để lấy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300209,
					"content": "Cô ấy nói vậy à? Thôi được rồi. Xin chút kinh phí ở đây còn khó hơn ở Viện Khoa Học Fontaine nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Clynes"
				}
			]
		},
