					"Wang Ping'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Đúng là một đại công trình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300202,
					"content": "Anh thật sự đã tu sửa ngôi miếu sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Là bạn sao. Còn phải nói, tôi đã nói tôi là người đàng hoàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300204,
					"content": "Nhưng mà, tôi không ngờ rằng công trình sẽ lớn như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300205,
					"content": "Vị sư phụ thiết kế căn miếu vừa nghe nói đến thờ tự \"Dạ Xoa\" bèn vô cùng xông xáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300206,
					"content": "Không những vẽ thật nhiều bản thiết kế, còn lôi theo tôi đi khắp nơi tìm mua nguyên vật liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300207,
					"content": "Nhìn bộ ông ấy, nếu mà trẻ lại mấy chục tuổi, chắc sẽ đích thân đến sửa luôn quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300208,
					"content": "Không gặp chuyện gì nguy hiểm chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "Nguy hiểm? À, ý bạn nói về ma vật và Đạo Bảo Đoàn phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300212,
					"content": "Chuyện này bạn không cần lo, nghe nói tôi muốn sửa miếu Dạ Xoa, Tổng Vụ đã phái mấy vị Thiên Nham Quân đi theo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300213,
					"content": "Ma vật ở quanh đây cơ bản đã bị mấy vị Thiên Nham Quân đó đuổi đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300214,
					"content": "Còn về Đạo Bảo Đoàn...Chúng thấy Thiên Nham Quân ở đây nên chắc không dám lộ diện nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300215,
					"content": "Nhưng mà, công trình tu sửa ngôi miếu này đã vượt quá tưởng tượng của tôi, nguyên liệu chuẩn bị cũng không đủ dùng, chúng tôi chỉ đành phải vận chuyển thêm một ít từ trong thành đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300216,
					"content": "Tôi cảm thấy...Đám Đạo Bảo Đoàn đó tuy không dám động đến công trình, nhưng có lẽ chúng sẽ mai phục trên đường để cướp số nguyên liệu đang vận chuyển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300217,
					"content": "Tuy có Thiên Nham Quân canh giữ ở công trình, nhưng mà những người vận chuyển vật liệu trên đường, nếu bị Đạo Bảo Đoàn tấn công thì Thiên Nham Quân cũng không cứu kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300218,
					"content": "Anh hùng, có thể giúp tôi một việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300219,
					"content": "Tôi biết thân thủ của bạn rất giỏi, đối phó với Đạo Bảo Đoàn nhất định không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300220,
					"content": "Có thể phiền bạn đến xung quanh đây dạy dỗ đám Đạo Bảo Đoàn một trận, để chúng không dám làm càn được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300221,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Vậy xin phiền anh hùng rồi, thật là cảm kích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300223,
					"content": "Tại sao không nhờ Thiên Nham Quân?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Họ phải canh giữ công trình bất kể ngày đêm, đã đủ mệt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300225,
					"content": "Chuyện này xin nhờ cả vào bạn đó, anh hùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300210,
					"content": "Tôi nhớ rằng xung quanh đây không được an toàn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "Ý bạn là, ma vật và Đạo Bảo Đoàn xung quanh đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
