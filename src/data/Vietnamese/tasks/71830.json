			"dialogs": [
				{
					"id": 718300601,
					"content": "Tuyệt, vậy số <color=#00E1FFFF>Gỗ Khước Sa</color> tôi nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
