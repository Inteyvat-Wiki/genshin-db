			},
			"dialogs": [
				{
					"id": 718300701,
					"content": "Bạn trở về rồi, xung quanh có Đạo Bảo Đoàn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300702,
					"content": "Đi rồi là tốt, đi rồi là tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300703,
					"content": "Còn có việc gì chúng tôi có thể giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "Ha ha ha, xin cám ơn lòng tốt của bạn, nhưng bạn đã giúp tôi nhiều việc như thế, tôi đâu thể để bạn phải chạy tới chạy lui thế được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300705,
					"content": "Nhưng nếu bạn đồng ý, vậy có thể tìm một ít <color=#00E1FFFF>Gỗ Khước Sa</color> giúp tôi, như vậy thì xem như bạn đã thật sự tham gia xây dựng ngôi miếu này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300706,
					"content": "Sửa miếu là việc tích đức, nếu bạn đích thân tham gia, nói không chừng sẽ gặp nhiều may mắn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300707,
					"content": "Tôi sẽ đi tìm Gỗ Khước Sa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "Hahaha. Được. Sau khi bạn tìm được <color=#00E1FFFF>Gỗ Khước Sa</color>, hãy trực tiếp giao cho tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300709,
					"content": "Có ai khác quyên góp vật tư sửa miếu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "Ừm...Nói thật thì, thật ra không có mấy người. Dù sao thì nơi này quá hoang vu, đa số người đều không biết ở đây còn có ngôi miếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300711,
					"content": "Hơn nữa, vị Đồng Tước tiên sư này đến hiện nay cũng chẳng còn mấy người nhớ đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300712,
					"content": "Được rồi, không nói những chuyện này nữa. Bạn tìm được <color=#00E1FFFF>Gỗ Khước Sa</color> thì hãy giao cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
