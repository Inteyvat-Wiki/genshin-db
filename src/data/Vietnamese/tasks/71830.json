			"trigger": {
				"objectNames": [
					"Đại Ca Đạo Bảo Đoàn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "Anh hùng xin dừng tay! Chúng tôi chịu thua, chịu thua rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300402,
					"content": "Mau thu dọn và cút đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "Dạ, dạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300405,
					"content": "Nhưng không biết...Anh em bọn tôi đã mạo phạm gì đến vị anh hùng đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300406,
					"content": "Chẳng lẽ anh hùng phát hiện ra kho báu gì xung quanh đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300407,
					"content": "Chúng tôi đang sửa miếu ở gần đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "Sửa, sửa miếu? Nơi hoang sơn cùng cốc này, sao anh hùng lại đi sửa miếu ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300409,
					"content": "Xung...xung quanh đây có miếu thờ tiên nhân sao? Chờ đã, chẳng lẽ là ngôi nhà tồi tàn đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300410,
					"content": "Đại ca, lần trước lúc chúng ta nghỉ ngơi ở đó, tôi chỉ thấy một pho tượng hình chim điểu, chẳng lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Tiểu Đệ Đạo Bảo Đoàn"
				},
				{
					"id": 718300411,
					"content": "Đó là Dạ Xoa \"Đồng Tước\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "Hả?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300413,
					"content": "Đại, đại ca! Chúng ta có phải đã mạo phạm đến thần tiên rồi không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Tiểu Đệ Đạo Bảo Đoàn"
				},
				{
					"id": 718300414,
					"content": "Đừng, đừng nói bậy! Hồi trước chúng ta không biết, xem như... xem như không biết thì không có tội! Tiên sư chắc... chắc cũng không trách tội đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300415,
					"content": "Anh hùng! Việc sửa miếu này chúng tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300416,
					"content": "Trước đây chúng tôi có mắt không tròng, bất kính với tiên sư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300417,
					"content": "Chúng tôi sẽ quay về, thông báo các anh em tránh xa ngôi miếu đó ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Đại Ca Đạo Bảo Đoàn"
				},
				{
					"id": 718300418,
					"content": "Đại ca, hay là chúng ta cũng tranh thủ thời gian đến đó thắp nén hương đi, tạ tội với tiên sư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Tiểu Đệ Đạo Bảo Đoàn"
				},
				{
					"id": 718300419,
					"content": "Nói nhiều thế nhỉ, mau đi đi!",
					"roleType": "TALK_ROLE_NPC",
