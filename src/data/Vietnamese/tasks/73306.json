				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "Xin lỗi... vẫn không thể kiềm chế được tâm trạng của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552602,
					"content": "Đừng xin lỗi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "Đúng vậy... Jeht rất buồn, chúng ta đều biết mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730552604,
					"content": "Cảm ơn các bạn... chúc con đường sau này của mọi người đều thuận lợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552605,
					"content": "Ừm... cũng mong mọi thứ sau này của Jeht được thuận lợi... nhất định là vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
