				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "Là hai người sao, còn muốn nói điều gì nữa không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552502,
					"content": "Về Jebrael.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "...Không ngờ đến cuối cùng tôi lại vẫn nghi ngờ ông ấy. Tôi đúng là một tên khốn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552504,
					"content": "Bây giờ tôi chỉ biết nói cảm ơn ông ấy thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552505,
					"content": "Trước đây tôi cứ luôn thiếu quyết đoán, cho dù là trong học thuật hay trong cuộc sống thường ngày... Nhưng từ nay trở đi, tôi sẽ không bao giờ do dự nữa. Tôi sẽ kiên định đi trên con đường mà mình tin tưởng, cho dù nó có khó khăn tới đâu đi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552506,
					"content": "Cho dù là để an ủi Jebrael...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552507,
					"content": "Về Vua Deshret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "Tôi đã bắt đầu hoài nghi về độ đáng tin của những tài liệu lịch sử mà tôi đọc trước đó rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552509,
					"content": "Cái bài \"văn khấn\" đó... có một cảm giác kỳ lạ không thể tả thành lời, và cả những lời... mà Samail đã từng nói... Sau khi quay về nhất định phải nghiên cứu sâu hơn mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552510,
					"content": "Đương nhiên, nhiệm vụ hàng đầu đó chính là hoàn thành luận văn theo như kế hoạch ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552511,
					"content": "Về Jeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "Tôi ước gì mình cũng có thể làm điều gì đó cho cô ấy, thế nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552513,
					"content": "Tôi chẳng thể làm được gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552514,
					"content": "Cô ấy không chịu nói gì, nhưng nếu cô ấy nói ra bất kỳ nguyện vọng nào, chỉ cần trong khả năng cho phép của tôi thì tôi sẽ sẵn sàng làm cho cô ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				}
			]
		},
