				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "Sao không thấy Omid và Mirsad vậy? Không lẽ bọn họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Họ không sao, chẳng qua đều có dự tính riêng của mình, không buôn bán Thú Thồ Hàng chung với chúng ta nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "Hả? Phải làm sao đây, chỉ dựa vào hai chúng ta, đâu có đủ nhân lực, phải tuyển thêm người mới được... Nhưng cũng không có mấy ai chịu đến Làng Aaru cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Bỏ đi, chuyện này để sau hẵng nói, Cyrus bình an trở về là được rồi. Lần sau không được để nó đi đến nơi nguy hiểm như vậy nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "Anh đang nói gì vậy? Chúng ta là thương nhân Thú Thồ Hàng, không cho Thú Thồ Hàng ra ngoài kiếm sống thì chúng ta lấy cái gì mà ăn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "Chỉ hít thở thôi thì đâu thể no bụng được, hơn nữa, thử hít một hơi ở đây xem, đảm bảo chỉ toàn cát mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "Vậy cũng không thể để Cyrus đi vào chỗ nguy hiểm được. Tôi thấy anh cũng khá cường tráng đó chứ, hay là anh thồ hàng hóa đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Bonifaz"
				},
