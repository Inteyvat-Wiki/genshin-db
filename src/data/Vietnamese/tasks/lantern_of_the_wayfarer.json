			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Francis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "Đây là... hàng mà tôi đặt, trời ơi, cuối cùng đã tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160402,
					"content": "Nhìn cách ăn mặc của bạn, người vận chuyển hàng như bạn đây, cũng không phải người bản địa ở Liyue nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160403,
					"content": "Bạn thân mến, không biết bạn từng nếm thử món ăn của Liyue chưa, đó quả thực quá tuyệt vời, tin tôi đi, bạn thật sự nên thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160404,
					"content": "Được rồi, hiện lô hàng này cũng đã tới, tôi có thể yên tâm đi thưởng thức món ngon rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181605,
