			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "Nơi này chính là nơi trữ hàng, dù sao cũng phiền bạn giúp đỡ, chỉ cần bạn áp tải một Khí Cầu Vận Chuyển này là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160202,
					"content": "Nhưng tôi phải nhắc nhở bạn, số hàng này đều là nguyên liệu làm Đèn Tiêu, rất dễ bị hư hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160203,
					"content": "Nếu như làm hư thì sẽ rắc rối đấy, trên đường nhớ phải cẩn thận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160204,
					"content": "Con đường này nhiều khi có ma vật hoặc Đạo Bảo Đoàn xuất hiện, phải cẩn thận đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160205,
					"content": "Vậy bạn áp tải chuyến hàng này nhé, an toàn đưa hàng đến tận tay Francis là ổn, sau khi hoàn thành chúng ta sẽ gặp ở ngoài cây cầu phía nam Ngật Hổ Nham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				}
			]
		},
