			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "Tôi đã liên lạc với Francis, anh ấy đã nhận được lô hàng đó, may mà có bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160502,
					"content": "Liên lạc hồi nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "Ha ha, không cần bận tâm, tai mắt của người áp tải chúng tôi rất nhiều, việc giao nhận mà... đương nhiên phải nhiều tai mắt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160504,
					"content": "Lần này may mà có bạn giúp đỡ, làm việc nhận thù lao là lẽ bất di bất dịch, tôi sẽ không thiếu của bạn. Bạn chờ một lát nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160505,
					"content": "Tết Hải Đăng cũng không nghỉ ngơi ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "Làm ngành này của chúng tôi, việc buôn bán lúc có lúc không, Tết Hải Đăng cũng không về nhà nổi, chẳng còn cách nào khác mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160507,
					"content": "Bạn đi du lịch khắp nơi nhỉ, mọi người đều sẽ thả Đèn Tiêu trong Tết Hải Đăng, bạn cũng có thể trải nghiệm một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160508,
					"content": "Còn bạn thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "Năm nào cũng bôn ba bên ngoài, hình như tôi chưa từng có thời gian đi thả Đèn Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160512,
					"content": "Nếu có đồ làm sẵn, thả một chiếc cầu may cũng không tồi, đáng tiếc tôi chẳng có thời gian làm Đèn Tiêu...",
