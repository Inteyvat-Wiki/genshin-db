			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "Cái này làm sao đem qua được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "Nhà Lữ Hành, lúc này tới Liyue vừa khéo đón Tết Hải Đăng, bạn may mắn như vậy, nhưng tôi chẳng thể vui nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160104,
					"content": "Người Liyue chúng tôi có truyền thống thả Đèn Tiêu vào Tết Hải Đăng, cho nên hằng năm vào thời gian này lượng hàng hoá vận chuyển là nguyên liệu Đèn Tiêu đều rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160105,
					"content": "Không biết có phải ảo giác của tôi không, hàng hóa năm nay có vẻ nhiều hơn năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160106,
					"content": "Một mình tôi đúng là bận không kịp thở, thương nhân này còn là thương nhân Fontaine không hiểu rõ phong tục tập quán ở Liyue, suốt ngày thúc giục tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160107,
					"content": "Tôi có lòng mời người tới giúp một tay, mà mãi chưa tìm được ai thích hợp, bạn có đồng ý giúp tôi áp tải một chuyến không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160108,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "Được! Tôi thích người thẳng thắn như bạn, nếu người nhận hàng cũng nhanh nhẹn như bạn thì tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160110,
					"content": "Tên của người đó là gì ấy nhỉ, hình như là Francis thì phải, tên người ngoại quốc tôi thực sự không đọc nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160115,
					"content": "Nếu bạn đồng ý giúp đỡ, vậy hãy đến nơi để hàng gặp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160116,
					"content": "Địa điểm cụ thể tôi đã đánh dấu trên bản đồ giúp bạn rồi, vậy tôi đi trước đây, lát nữa gặp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160111,
					"content": "Thương nhân Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "Đúng vậy, gọi là... Fra...Francis, tên của người ngoại quốc khó đọc thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160113,
					"content": "Cũng không biết anh ấy đặt một lô nguyên liệu Đèn Tiêu lớn như vậy để làm gì, nhưng... người ta bỏ tiền, tôi bỏ sức mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160114,
					"content": "Yên tâm, sau khi bạn giúp đỡ, chắc chắn sẽ không thiếu thù lao của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
