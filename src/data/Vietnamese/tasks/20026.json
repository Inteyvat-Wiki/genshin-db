				},
				{
					"id": 200260302,
					"content": "Ồ! Đây là món <color=#00E1FFFF>Củ Cải Viên Chiên</color> làm theo yêu cầu của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260303
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260303,
					"content": "Quả nhiên, sau khi thêm trứng vào, mùi vị và hương thơm đều tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260304
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260304,
					"content": "Hahaha, phẩm vị của tôi quả nhiên là tốt nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260305
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260305,
					"content": "Phải rồi, đây là tiền cơm, vất vả cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
