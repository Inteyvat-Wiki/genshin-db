			"dialogs": [
				{
					"id": 200260101,
					"content": "Đơn Giao Hàng Món Ăn",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260102,
					"content": "Nhà Lữ Hành, bạn đến thật đúng lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260103,
					"content": "Hở? Bạn nói bạn chỉ đến để ăn cơm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260104,
					"content": "Tôi, tôi biết rồi, nhưng bạn hãy giúp tôi một việc, tôi nhất định sẽ cho bạn món ngon nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260105,
					"content": "Ngài Ernest của Tửu Trang Dawn thường đặt món ở chỗ tôi, mà còn thường đưa ra những yêu cầu thêm gia vị kỳ quái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260106,
					"content": "Ừ... Lần này tuy là ngài ấy đặt <color=#00E1FFFF>Củ Cải Viên Chiên</color>, nhưng lại kêu chúng tôi nhất định phải thêm trứng, nhưng nguyên liệu món dùng trứng thì hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260107,
					"content": "Cho nên, bạn hãy giúp chúng tôi tìm 2 quả trứng chim về đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260108,
					"content": "Được thôi, nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "Ở Phong Khởi Địa, có thể tìm thấy rất nhiều trứng chim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260110,
					"content": "Vậy thì, nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260111,
					"content": "Đói quá rồi, tôi chỉ đến để ăn cơm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "Ở Phong Khởi Địa, có thể tìm thấy rất nhiều trứng chim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260113,
					"content": "Sau khi bạn giúp xong, tôi...tôi sẽ mời bạn đặc sản của quán Người Săn Hươu, nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
