					"nextDialogs": [
						200260203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260203,
					"content": "Được rồi, phiền bạn đem món <color=#00E1FFFF>Củ Cải Viên Chiên</color> đặc biệt này đến cho ngài Ernest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260204,
					"content": "Đừng nhìn tôi như vậy, tôi biết bạn rất đói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260205,
					"content": "Khi quay lại, tôi sẽ dùng đặc sản của quán Người Săn Hươu để cảm tạ bạn!",
					"roleType": "TALK_ROLE_NPC",
