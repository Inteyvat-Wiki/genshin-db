					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251004,
					"content": "Tôi cũng không ngờ là lại tạo thêm phiền phức cho bạn rồi... xin hãy nhận lấy số thù lao này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251005,
