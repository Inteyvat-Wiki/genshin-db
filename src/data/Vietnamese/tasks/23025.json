					"Farghani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "Hì... bạn này, tôi có thể xin một ít thời gian của bạn được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250202,
					"content": "Có chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "Bạn có từng nghĩ đến vấn đề như vậy không. Nếu trời sập thì phải làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250209,
					"content": "Tôi thấy anh lo lắng hơi quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "Có lẽ là thế, nhưng sao trời lại không sập? Tại sao đất đai không lún xuống? Nếu như không đo đạc chính xác thì những câu hỏi này sẽ mãi mãi không có đáp án.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250213,
					"content": "Thật ra tôi đã có một mô hình hoàn hảo để giải thích những câu hỏi này, chỉ là cần nhiều số liệu đo đạc để chắc chắn thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250214,
					"content": "Cần tôi hỗ trợ không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "Vậy có nghĩa là bạn đồng ý hỗ trợ tôi rồi đúng không, cảm ơn nhiều!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250224,
					"content": "Thật ra tôi đã chọn một địa điểm đo đạc rất tuyệt, chỉ là ở đó có nhiều ma vật quá thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250225,
					"content": "Nhờ bạn xua đuổi số ma vật đó nhé, rồi tôi mới yên tâm tiến hành ghi chép đo đạc được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250226,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "Cảm ơn, giờ chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250228,
					"content": "Anh cũng phải đến hiện trường sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "Dù gì thì tôi cũng phải tận mắt kiểm chứng một vài số liệu thì mới có thể phát hiện nguyên nhân sai số mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250230,
					"content": "Miệt mài tính toán trên giấy chỉ càng xa đáp án. Chúng ta nhanh chóng xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250215,
					"content": "Chúc anh may mắn, tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "Đợi đã nào! Bạn nghĩ thêm đi, chỉ cần thành quả của tôi được công bố thì đây sẽ là chuyện lớn từ xưa đến nay đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250217,
					"content": "Đến lúc đó, bạn sẽ là người hỗ trợ cho lý luận vĩ đại này, tôi có thể nêu tên bạn ở cuối bài diễn văn cảm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250218,
					"content": "Ừm... không thì vị trí tác giả thứ hai cũng được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250219,
					"content": "Nôn nóng vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "Nếu cứ không có được kết quả thì kinh phí nghiên cứu của tôi sẽ có chuyện đấy... còn khủng khiếp hơn cả trời sập nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250221,
					"content": "\"Tác giả thứ hai\" được đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "Thù lao hợp lý là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "Trời sẽ không sập đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "Tôi bận lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "Ấy! Đừng nói thế, có chuyện gì nghiêm trọng hơn chỗ ở của mình sắp sụp đổ đâu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250205,
					"content": "Nhà anh... sắp sụp đổ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "Khụ khụ, đương nhiên là không rồi. Nhưng nếu bạn ở trong một ngôi nhà mà lại chưa từng thấy toàn cảnh của nó, cũng không ai đảm bảo cường độ kết cấu của ngôi nhà đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250207,
					"content": "Thế thì mỗi ngày sống trong ngôi nhà đó luôn bất an đúng không? Vậy nên, sống trên thế giới này cũng như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "Farghani"
				}
			]
		},
		{
