					"content": "Thật ra tôi có đặt làm một bộ thiết bị thu tín hiệu, có thể tự động gom số liệu gốc cần thiết cho nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250525
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250525,
					"content": "Để tránh bị nhiễu sóng địa hình, tốt nhất nên đặt ở chỗ cao như vách đá hay đỉnh núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250526
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250526,
					"content": "Nhưng cái thân này của tôi nhìn là biết không thể leo lên leo xuống rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250527,
						230250529
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250527,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250528
					]
				},
				{
					"id": 230250528,
					"content": "Cảm ơn nhé! Địa điểm lấy số liệu ở gần đây, đặt xong báo lại cho tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250529,
					"content": "Lúc đặt làm anh không cân nhắc đến chuyện này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250530
					]
				},
				{
					"id": 230250530,
					"content": "Khụ... lúc đó phải ưu tiên độ nhạy của máy, phạm vi sử dụng phù hợp nên đương nhiên cần phải có chút hi sinh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250531
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250531,
					"content": "Dù gì nếu số liệu gốc có sai số thì kết quả tính toán sẽ bị lệch mà... tóm lại nhờ cả vào bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250515,
					"content": "Chúc anh may mắn, tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250516
					]
				},
				{
					"id": 230250516,
					"content": "Đợi đã nào! Bạn nghĩ thêm đi, chỉ cần thành quả của tôi được công bố thì đây sẽ là chuyện lớn từ xưa đến nay đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250517
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250517,
					"content": "Đến lúc đó, bạn sẽ là người hỗ trợ cho lý luận vĩ đại này, tôi có thể nêu tên bạn ở cuối bài diễn văn cảm ơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250518
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250518,
					"content": "Ừm... không thì vị trí tác giả thứ hai cũng được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250519
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250519,
					"content": "Nôn nóng vậy sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250520
					]
				},
				{
					"id": 230250520,
					"content": "Nếu cứ không có được kết quả thì kinh phí nghiên cứu của tôi sẽ có chuyện đấy... còn khủng khiếp hơn cả trời sập nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250521,
						230250522
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250521,
					"content": "\"Tác giả thứ hai\" được đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250522,
					"content": "Thù lao hợp lý là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250510,
					"content": "Trời sẽ không sập đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250512
					]
				},
				{
					"id": 230250503,
					"content": "Tôi bận lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250504
					]
				},
				{
					"id": 230250504,
					"content": "Ấy! Đừng nói thế, có chuyện gì nghiêm trọng hơn chỗ ở của mình sắp sụp đổ đâu chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250505
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250505,
					"content": "Nhà anh... sắp sụp đổ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250506
					]
				},
				{
					"id": 230250506,
					"content": "Khụ khụ, đương nhiên là không rồi. Nhưng nếu bạn ở trong một ngôi nhà mà lại chưa từng thấy toàn cảnh của nó, cũng không ai đảm bảo cường độ kết cấu của ngôi nhà đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250507
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250507,
					"content": "Thế thì mỗi ngày sống trong ngôi nhà đó luôn bất an đúng không? Vậy nên, sống trên thế giới này cũng như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250508
					],
					"speakerTitle": "Farghani"
				}
			]
		},
