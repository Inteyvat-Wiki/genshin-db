			"dialogs": [
				{
					"id": 230250401,
					"content": "Ừm... hóa ra là thế này sao? Chỉ cần nhập đại lượng biến thiên là có thể giải thích được sai số trước đó rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250402,
					"content": "Nhưng như vậy liệu suy luận khác có biến đổi theo luôn không đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250403,
					"content": "Có tiến triển gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "A, xin lỗi, quên mất là bạn vẫn còn ở đây... đây, thù lao như đã hứa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250405,
					"content": "Còn về tiến triển thì... dù giải quyết được một vài vấn đề, nhưng hình như lại xuất hiện thêm một số vấn đề khác... cần phải tiến hành nghiên cứu tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250406,
					"content": "Trước khi đưa ra kết luận cuối cùng, chắc vẫn phải tiếp tục làm phiền bạn rồi, Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
