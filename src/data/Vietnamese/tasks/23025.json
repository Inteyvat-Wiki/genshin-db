			"dialogs": [
				{
					"id": 230250701,
					"content": "Ủa? Bố trí thiết bị thu tín hiệu xong cả chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250702
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250702,
					"content": "Bố trí ổn cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "Thật sự rất cảm ơn, nào, đây là thù lao như đã hứa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250704,
					"content": "Giờ thì chỉ cần chờ chúng thu số liệu là sẽ có thể chứng thực suy luận trước đó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250705,
					"content": "Nhưng nói đi thì phải nói lại, tôi phải làm sao để lên đó thu hồi thiết bị đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
