			"dialogs": [
				{
					"id": 230250801,
					"content": "A! Nhà Lữ Hành, cuối cùng thì bạn cũng đã đến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250802,
					"content": "Việc nghiên cứu vẫn thuận lợi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Nhờ có bạn nên việc nghiên cứu thuận lợi lắm, số thiết bị kia vẫn đang thu thập số liệu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250804,
					"content": "Giờ chỉ cần thu gom những số liệu đó là sẽ có thể nghiệm chứng những phỏng đoán mới trong mấy ngày nay rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250805,
					"content": "Mấy ngày nay cũng chỉ là phỏng đoán thôi sao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "Khụ khụ, thì tôi cũng có tối ưu công thức tính toán, hiệu chỉnh máy đo... dù sao thì bạn nhìn xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250808,
					"content": "Với thể hình này của tôi, đâu thể leo lên chỗ bạn bố trí để thu gom đâu phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250809,
					"content": "Giờ e là vẫn phải phiền bạn đi thu gom số thiết bị đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250810,
					"content": "Thôi được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "Nhờ bạn đấy, Nhà Lữ Hành, tôi sẽ chuẩn bị thù lao hậu hĩnh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250812,
					"content": "Lần sau nên cân nhắc kỹ làm sao để thu hồi nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "Không phải là tôi không nghĩ đến, tôi cũng định gắn thêm trang bị thu hồi hay mở rộng phạm vi sử dụng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250814,
					"content": "Nhưng một là cần kinh phí nhiều hơn, hai là không biết có ảnh hưởng đến độ chính xác của số liệu hay không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250815,
					"content": "Tóm... tóm lại vẫn phải nhờ bạn đấy, Nhà Lữ Hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250806,
					"content": "Thế chẳng phải không có tiến triển gì à!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
