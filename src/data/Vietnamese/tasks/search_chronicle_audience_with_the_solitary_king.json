				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "Cuối cùng cũng đi đến bước này rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820102,
					"content": "Ước mơ thuở bé thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "Sau khi lớn lên, cuối cùng cũng hiểu lý do tại sao Đội Trưởng Kiểm Lâm lại tỏ ra bối rối rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820104,
					"content": "Khụ, dù sao đi nữa thì ít ra tôi cũng đã từng thử qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820105,
					"content": "Hơn nữa cũng biết là không được mang Quả Cây Nổ chưa qua xử lý đến gần Nấm Thúy Linh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820106,
					"content": "Khi ngửi thấy mùi khét thì mọi chuyện đã muộn, suýt chút là bị nhấn chìm trong số bào tử mà nó phát tán rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820107,
					"content": "Tôi quên mất Nấm Quỷ dù sao cũng không phải Heo Nấm, chúng là hai loài hoàn toàn khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820108,
					"content": "Đúng vậy, kể ra thì Nấm Quỷ chắc được xem là nấm nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820109,
					"content": "Đúng vậy, nấu canh thì ngon lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820110,
					"content": "Này, hay là chúng ta nói về đối tượng khiêu chiến hôm nay đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820111,
					"content": "#Tôi vẫn chưa nghĩ ra cách nấu thế nào... À ừm! Ý {F#cô}{M#cậu} là đang nói đến việc \"giao lưu\" sao, xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820112,
					"content": "Không biết hai vị đã từng nghe câu chuyện về hai bá chủ của Dị Chủng Biển Sâu chưa? Trong đó khi mô tả Cá Ngựa Ngọc Trai Ngàn Năm đều dùng những từ như cô độc và cao quý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820113,
					"content": "So sánh thì Hoàng Đế Thép Lửa nghe có vẻ như là một nhân vật tàn nhẫn không nên dây vào, mạnh mẽ nhưng hung bạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820114,
					"content": "Tôi tưởng là sẽ chọn thử thách nào đó khó nhằn hơn cơ. Dù sao trước đó cũng đã nói là muốn tìm đối thủ càng mạnh càng tốt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820115,
					"content": "Hoàng Đế Thép Lửa quả thực rất mạnh, nhưng đó dù sao cũng là Cua Giáp Nặng mà thôi... So ra thì Cá Ngựa Ngọc Trai Ngàn Năm là con cá ngựa biết bay đấy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820116,
					"content": "Cá ngựa biết bay thì có nên gọi là ngựa trời không nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "Cái này không phải trọng tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820119,
					"content": "Dù thế nào thì chỉ cần cho tôi cưỡi một lần thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820120,
					"content": "Được rồi. Xem ra anh muốn kiên trì tới cùng nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820121,
					"content": "Đến thì cũng đã đến rồi, cũng không thể về tay không được! Nếu đã chuẩn bị xong rồi thì chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820122,
					"content": "Chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "Tôi còn bận việc khác, chờ một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "Không sao, tôi sẽ đợi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820118,
					"content": "Theo tôi thì không có gì khác nhau cả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}