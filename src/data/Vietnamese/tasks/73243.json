						"rawParams": [
							"7324301",
							"2"
						],
						"stepId": 7324301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "Thông báo pháp lệnh trong và ngoài thành cùng với thông báo liên quan của Giáo Viện đã được chuyển vào Akasha, bảng thông báo này được lưu giữ để thầy trò trong học viện giao lưu ngoại khóa, những người ngoài học viện xin đừng để lại lời nhắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "\"Để có bầu không khí học tập thoải mái hơn, và để trao đổi học thuật dễ dàng hơn, để mọi người có thể vui vẻ viết luận văn!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430202,
					"content": "\"Chúng tôi ủng hộ Vikram trở thành Thủ Thư nhiệm kỳ tiếp theo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430203,
					"content": "\"Hoan nghênh gia nhập \"Hội ái hữu của Vikram\", chúng ta sẽ cùng chứng kiến sự ra đời của một Thủ Thư trẻ tuổi, yêu dân và thú vị.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "\"Không được quên ba điều thiện, sáu tội lỗi của Giáo Viện.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430302,
					"content": "\"Khuyên nhủ, tinh tế, thực hành là đức tính tốt mà mỗi học giả đều nên học hỏi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430303,
					"content": "\"Còn Rifaet, trong mười mấy năm nay, vẫn luôn thực hiện ba đức tính này.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430304,
					"content": "\"Hoan nghênh gia nhập \"Hội Đọc Sách Fravashi\", đồng hành cùng trí tuệ và với Thủ Thư tương lai.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "\"Các thành viên \"Hội Đọc Sách Fravashi\", tôi kính phục việc theo đuổi đức tính tốt đẹp của các bạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430402,
					"content": "\"Nhưng tôi nghe nói, luận văn của Rifaet có hơn một nửa là viết thay.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430403,
					"content": "\"Đây cũng là lý do tại sao thành quả học thuật của anh ta nhiều đến thế nhưng vẫn khiêm tốn như vậy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430404,
					"content": "\"Mặc dù bảng tin nhắn không cần đầy đủ luận cứ như luận văn, nhưng cũng không thể cố ý công kích người khác.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430405,
					"content": "\"Những lời nhắn trên đó đa phần chỉ vì ghen tị mà thôi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430406,
					"content": "\"Hơn nữa, tôi cũng nghe nói rằng Vikram đã chiếm được cảm tình của rất nhiều cô gái bằng tài ăn nói của mình.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430407,
					"content": "\"Những cô gái này đều không biết anh ta đã có gia đình. Sao nào, có phải anh cũng ghen tị với diễm phúc của anh ta lắm không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430408,
					"content": "\"Nghiêm cấm ác ý công kích học giả Giáo Viện vô căn cứ, nếu còn tái phạm, Matra sẽ tra xét ngọn nguồn tin đồn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "\"Bảng tin nhắn này chưa được quản lý bởi hệ thống quyền hạn Akasha, có thể xem trực tiếp không cần thông qua Akasha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430502,
					"content": "\"Mong mọi người hãy nâng cao nhận thức về bảo mật tri thức, nghiêm cấm việc dùng bảng tin này để truyền tải cộng đồng và trao đổi các nguồn tri thức ngoài lĩnh vực.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "\"Xin hãy lưu ý, ngoài giờ học ở bên ngoài học viện thì các bạn học cũng đừng quên tuân thủ kỷ luật nghiêm ngặt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430602,
					"content": "\"Sự quản lý thống nhất về tri thức là nền tảng cho sự tồn tại của \"vương quốc trí tuệ\", đừng vì những sai lầm vô ý mà đánh mất cơ hội học tập ở Giáo Viện.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
