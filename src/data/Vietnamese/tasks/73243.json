			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "\"Dạo này liên tục phát sinh mấy vụ án buôn lậu Hũ Tri Thức. Thông tin chi tiết sẽ chờ hoàn thành cuộc điều tra sẽ công bố cho thầy trò trong học viện liên quan thông qua Akasha trước Ngày Jnagarbha tiếp theo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430702,
					"content": "\"Yêu cầu các giáo viên hướng dẫn gia tăng giao lưu với học viên, tránh cho học viên vì áp lực luận văn mà bí quá hóa liều.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "\"Hiện giờ học viện đối với việc phổ cập ứng dụng của Akasha, thay vì nói quá cấp tiến, tôi thấy nên nói là quá bảo thủ thì đúng hơn. Hầu hết công việc của Mahamata rườm rà lại kém hiệu quả, thậm chí một số phương diện còn không bằng trước kia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430802,
					"content": "\"Thử nghĩ xem, nếu như chúng ta có thể sử dụng Akasha trực tiếp phân công công việc cho mọi người, và cũng để Akasha quản lý trao đổi hàng hóa ở Sở Giao Dịch.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430803,
					"content": "\"Đến lúc đó, chí ít chúng ta có thể cắt giảm được phân nửa Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430804,
					"content": "\"Anh nói rất có lý, thế nên tôi nghĩ có lẽ đây chính là nguyên nhân chúng ta không thể làm thế.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "\"Như chúng ta đã biết, nghĩa vụ của học giả là tìm tòi trí tuệ thâm sâu. Nhưng hiện nay Giáo Viện lại tham gia quá nhiều đến công việc hành chính.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430902,
					"content": "\"Ngày nay, có rất nhiều bạn học sau khi vội vàng hoàn thành việc học thì không thể không ngừng việc nghiên cứu trong tay, bị cử đi khắp nơi để đảm nhận công việc của Mahamata, thế khác nào đi ngược lại với mục đích ban đầu của Giáo Viện?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430903,
					"content": "\"Vấn đề này chẳng phải sớm đã có kết luận trong Akasha rồi sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732430904,
					"content": "\"Khi muôn dân vẫn còn mê tín dị đoan, chỉ có chúng ta là gần ánh sáng chân lý nhất. Sao chúng ta có thể từ bỏ trọng trách soi sáng người đời được. Nếu chúng ta mặc kệ, không biết Sumeru sẽ loạn đến mức nào!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "\"Là một du học sinh, mỗi ngày học tập ở Giáo Viện đều khiến tôi càng cảm nhận được sự vĩ đại của Đại Vương Rukkhadevata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431002,
					"content": "\"Khi ở Mondstadt, phải lật hàng tá cuốn sách chỉ để tổng hợp ra những cách giải thích khác nhau cho một câu hỏi đơn giản.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431003,
					"content": "\"Nhưng sau khi có \"Trạm Cuối Akasha\", chỉ cần suy nghĩ về nội dung cụ thể là có thể nhận được kiến thức chính xác. Tôi nghĩ trên đời không có phát minh nào vĩ đại hơn Akasha nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "\"Kể từ sau Pir Kavikavus, Giáo Viện đã không tăng kinh phí cho Học Viện Kshahrewar nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431102,
					"content": "\"Người phía trên chỉ biết nói rằng để mọi người có cuộc sống ổn định, việc nghiên cứu phát triển và thúc đẩy công nghệ cơ khí phải được kiểm soát chặt chẽ. Nếu thật sự như vậy, tôi thấy tắt luôn Akasha cho rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431103,
					"content": "\"Nếu không có sự đầu tư lâu dài của thương nhân có đôi mắt tinh tường như Đại Nhân Sangemah Bay thì Học Phái Kshahrewar của chúng ta đã sớm đóng cửa rồi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "\"Mặc dù tôi hoàn toàn tin tưởng vào sự phán xét của các hiền giả và giáo viên hướng dẫn, nhưng có phải hiện nay Giáo Viện đã quá lệ thuộc vào Akasha rồi không.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431202,
					"content": "\"Sau khi quen với việc tiếp thu kiến thức thông qua Akasha, mọi người đều thấy được sự suy giảm rõ rệt về năng lực học thuật của những học giả được phái ra ngoài. Tôi cho rằng cần ra lệnh hạn chế quyền sử dụng Akasha đối với học viên mới.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431203,
					"content": "\"Sao có thể nói thế được, anh không biết những học phái ẩn mình trong sa mạc, không tiếp nhận được chỉ dẫn từ Akasha đã dốt nát và điên cuồng từ lâu rồi à? Thậm chí còn dùng cách thức ngu dốt như nuốt sống rắn độc để tiếp cận trí tuệ sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431204,
					"content": "\"Ở phía sau Đại Vương Rukkhadevata là kiến thức thuần khiết mà Akasha đảm bảo cho chúng ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "Tuần này, \"hội thảo về thực vật học\" do Đội Trưởng Kiểm Lâm - Tighnari đại nhân trình bày sẽ tổ chức như thường lệ ở Pardis Dhyai, hoan nghênh mọi người ghi danh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431302,
					"content": "Bất cứ ai có hứng thú với thực vật đều có thể đến tham gia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431303,
					"content": "Thật sự xin lỗi, do có quá nhiều người đăng ký tham gia buổi hội thảo lần này, để tiện cho việc quản lý kiến thức, thông qua thảo luận, Giáo Viện đã quyết định chỉ cho học viên Học Phái Amurta và nhân viên kiểm lâm tham gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "\"Có ai đọc tiểu thuyết mới nhất của Nhà Xuất Bản Yae chưa? Lần này có tác giả của Sumeru chúng ta đấy, hình như tên là... Pursina gì đó, nhìn là biết người của Học Phái Amurta rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431402,
					"content": "\"Ôi... Nếu lúc trước tôi cũng thi đậu Học Viện Amurta thì tốt quá rồi, chẳng những ngày ngày được du sơn ngoạn thủy, còn rảnh rỗi viết tiểu thuyết nữa. Ngờ đâu vào Haravatat này, mỗi ngày không phải là đọc văn hiến thì là viết luận văn, đến cả cơ hội ra ngoài khảo sát cũng chẳng có.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431403,
					"content": "\"Cái gì, có người đã xuất bản tiểu thuyết ở Nhà Xuất Bản Yae trước tôi sao? Như vậy danh hiệu quyền uy về việc nghiên cứu tiểu thuyết của tôi chẳng phải sẽ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "\"Quả nhiên kinh doanh và sách là hai thứ khác nhau, giá như ban đầu ở lại Đại Khu Bazaar làm ăn đàng hoàng thì tốt rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431502,
					"content": "\"Kết quả là bây giờ luận văn thì viết không xong mà tiền thì cũng không còn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431503,
					"content": "\"Nếu thật sự không ổn thì nghỉ học rồi đến Eremite vậy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "\"Không phải tôi có ý kiến gì với người sa mạc, nhưng tôi thấy Tổng Quản Mahamatra phải do học giả đức cao vọng trọng đảm nhiệm mới đúng, đặc biệt là vấn đề học thuật đâu phải dựa vào đánh nhau là giải quyết được đâu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431602,
					"content": "\"Haha, tôi thấy vẫn tốt hơn nhiều so với khi người của Học Phái Rtawahist quản lý, chí ít sẽ không thiên vị học viện nào. Hay anh thực sự nghĩ rằng không ai biết sự thật đằng sau về tần suất phát biểu hằng năm của các người sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431603,
					"content": "\"Này! Cái tên Học Phái Kshahrewar, anh nói gì cũng phải có chứng cứ, nếu không tôi sẽ tìm Matra phân xử đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "\"Chào đón người nước ngoài đến du học thì đã đành, bây giờ ngay cả Akasha cũng mở cho người nước ngoài...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431702,
					"content": "\"Khoan hẵn nói đến người nước ngoài có gây ra ảnh hưởng gì xấu đến Akasha hay không, nhưng chắc chắn không thể tránh khỏi vấn đề tuồn kiến thức ra ngoài, không biết sẽ gây nên ảnh hưởng lớn thế nào đến nền kinh tế ngoại thương của Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431703,
					"content": "\"Thật hiếm thấy khi có học giả quan tâm đến vấn đề kinh tế...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431704,
					"content": "\"Thế nên mới nói Học Phái Haravatat các người không hiểu sự đời, nếu không phải vì muốn tạo ra loại màu sơn tốt hơn, tôi sẽ không thi vào Giáo Viện đâu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "\"Dạo này không thấy tên lùn sa mạc nữa, cuối cùng cũng có thể thư giãn một chút rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431802,
					"content": "\"Không biết đám Matra này bị gì mà lại tích cực như vậy, làm tôi không vượt qua được cuộc sát hạch của năm học trước.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431803,
					"content": "\"Tôi nhớ sát hạch đó chẳng phải chỉ cần chuyên cần là qua rồi sao, tự anh không lo học hành đàng hoàng mà còn đổ lỗi cho người khác. Hơn nữa mặc dù gần đây nhân lực Matra thiếu hụt, nhưng anh ăn nói lung tung như vậy cẩn thận bị tìm đến tận nhà đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431804,
					"content": "\"Matra gì chứ, nói trắng ra chỉ là người phía trên làm màu chút thôi. Đợi đã, Akasha gửi tin cho tôi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431805,
					"content": "\"Xem ra mọi người cẩn thận vẫn hơn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324319",
							"2"
						],
						"stepId": 7324319,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "\"...Kết quả điều tra liên quan đến \"Zandik\"... Dastur... Nguyên nhân tử vong... có thể là mưu hại...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431902,
					"content": "\"...\"Zandik\"... sau khi gạch tên... đối với Eleazar... nhưng thiếu chứng cứ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431903,
					"content": "\"...Ghi chép đột ngột biến mất... không rõ thời gian... Eleazar bắt đầu phát tán...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431904,
					"content": "\"...Trước khi mất tích... \"truyền thuyết Varuna\"... cố chấp với...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732431905,
					"content": "(Nội dung sau đây bị hủy hoại hoàn toàn, không thấy được chữ viết có ý nghĩa gì nữa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324320",
							"2"
						],
						"stepId": 7324320,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "\"Sau khi đọc \"biểu đồ sao\" do hiền giả Tabari vĩ đại biên soạn, cuối cùng tôi nhận ra rằng cho dù là chiến tranh ma thần hay là sự sụp đổ của vương quốc cổ, đó chẳng qua chỉ là ảnh xạ chuyển động của các vì sao trên đại lục mà thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432002,
					"content": "\"Điều vĩnh hằng duy nhất chính là bầu trời trên đầu chúng ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432003,
					"content": "\"Ừ... Gạt bỏ thứ tình cảm vớ vẩn trong nghiên cứu học thuật nghiêm túc, hóa ra nghiên cứu của Học Phái Rtawahist chính là gộp những chuyện trước và sau hơn nghìn năm lại làm một sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432004,
					"content": "\"Thật mong các người có thể học được cách nhìn nhận vấn đề từ góc độ lịch sử, chứ không phải suốt ngày lẩm bẩm chăm chú vào các vì sao đó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432005,
					"content": "\"Anh thì biết gì! Đây là nghiên cứu về quy luật thế giới, chẳng trách Vahumana các người chỉ toàn là mọt sách.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324321,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"302821",
							"3"
						],
						"stepId": 302821,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "\"Là một du học sinh, mỗi ngày học tập ở Giáo Viện đều khiến tôi càng cảm nhận được sự vĩ đại của Thảo Thần đại nhân.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432102,
					"content": "\"Khi ở Mondstadt, phải lật hàng tá cuốn sách chỉ để tổng hợp ra những cách giải thích khác nhau cho một câu hỏi đơn giản.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432103,
					"content": "\"Nhưng sau khi có \"Trạm Cuối Akasha\", chỉ cần suy nghĩ về nội dung cụ thể là có thể nhận được kiến thức chính xác. Tôi nghĩ trên đời không có phát minh nào vĩ đại hơn Akasha nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324322,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"302821",
							"3"
						],
						"stepId": 302821,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432201,
					"content": "\"Mặc dù tôi hoàn toàn tin tưởng vào sự phán xét của các hiền giả và giáo viên hướng dẫn, nhưng có phải hiện nay Giáo Viện đã quá lệ thuộc vào Akasha rồi không.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432202
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432202,
					"content": "\"Sau khi quen với việc tiếp thu kiến thức thông qua Akasha, mọi người đều thấy được sự suy giảm rõ rệt về năng lực học thuật của những học giả được phái ra ngoài. Tôi cho rằng cần ra lệnh hạn chế quyền sử dụng Akasha đối với học viên mới.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432203
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432203,
					"content": "\"Sao có thể nói thế được, anh không biết những học phái ẩn mình trong sa mạc, không tiếp nhận được chỉ dẫn từ Akasha đã dốt nát và điên cuồng từ lâu rồi à? Thậm chí còn dùng cách thức ngu dốt như nuốt sống rắn độc để tiếp cận trí tuệ sao?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432204
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432204,
					"content": "\"Điều mà mọi người không nhận ra được, chính là kiến thức thuần khiết mà Akasha đảm bảo cho chúng ta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324323,
			"completionStepIds": [
				7324301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324301",
							"2"
						],
						"stepId": 7324301,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"302812",
							"3"
						],
						"stepId": 302812,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432301,
					"content": "Do hệ thống \"Akasha\" đã ngưng sử dụng, nên bảng thông báo này hiện đã được kích hoạt lại. Thông báo liên quan của Giáo Viện và thông báo pháp lệnh trong và ngoài thành đều được cập nhật tại đây, những người ngoài học viện xin đừng để lại lời nhắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		},
		{
			"id": 7324324,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"302812",
							"3"
						],
						"stepId": 302812,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432401,
					"content": "\"Bảng nhắn tin này dùng cho việc liên lạc nội bộ của Giáo Viện, nghiêm cấm truyền bá thông tin sai sự thật và bất hợp pháp tại đây.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432402
					],
					"speakerTitle": "Bảng Tin Nhắn"
				},
				{
					"id": 732432402,
					"content": "\"Matra sẽ tiếp tục nhắc nhở mọi người chú ý đến quy tắc ứng xử của một học giả!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Tin Nhắn"
				}
			]
		}
	]
}