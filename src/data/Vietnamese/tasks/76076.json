			"dialogs": [
				{
					"id": 760761101,
					"content": "#Xin chào, rất vui được gặp lại {F#cô}{M#cậu} trong mộ phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761102,
					"content": "Kể cho Flins nghe về \"Đèn Lời Thề\" và những câu nói không rõ nghĩa trên đèn mà bạn nhìn thấy.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "\"Gió đã tỉnh lại, lá rụng bay lượn\"... Đây là lời thề mà mọi người đã lập khi gia nhập Người Giữ Đèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761104,
					"content": "Bình thường thì mỗi Người Giữ Đèn đều mang theo đèn của mình, trường hợp bất đắc dĩ nhất, họ mới từ bỏ việc chăm sóc ngọn đèn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761105,
					"content": "Mỗi một ngọn đèn vô chủ đều mang ý nghĩa của một sự bất hạnh, tôi rất tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761106,
					"content": "Nhưng từ khi lập ra lời thề, họ hiểu rằng, số phận này là điều không thể tránh khỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761107,
					"content": "Nếu còn có chuyện gì chúng ta có thể làm cho họ, thì chỉ là ghi nhớ thật kỹ lời thề của họ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761108,
					"content": "\"Giữ niềm hy vọng cháy bất diệt\"... Đây là nguyện vọng lớn nhất của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		}
	]
