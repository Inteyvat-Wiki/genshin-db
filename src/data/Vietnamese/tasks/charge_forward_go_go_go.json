					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290604,
					"content": "#Chỉ cần {F#chị}{M#anh} còn dũng khí thì hãy quay lại! Luyện tập cho đến khi vượt qua em mới thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
