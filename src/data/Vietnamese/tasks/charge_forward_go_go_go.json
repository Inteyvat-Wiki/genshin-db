			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "#Rất tốt! {F#Chị}{M#Anh} đã vượt qua em rồi, thật đáng mừng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290202,
					"content": "Em ở đây tự mình luyện tập cũng là mong muốn một ngày nào đó vượt qua được thành tích do chính mình tạo ra. Tiếc là đến tận hôm nay em vẫn chưa làm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290203,
					"content": "#Nhưng {F#chị}{M#anh} đã làm được, điều đó chứng tỏ đã đến lúc em ra ngoài khám phá rồi. Bên ngoài còn có rất nhiều dũng sĩ giỏi hơn em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290204,
					"content": "Nếu em được giao lưu, học hỏi cùng họ, thì trình độ của em chắc chắn sẽ được nâng cao. Một ngày nào đó, em nhất định sẽ nhận được sự công nhận từ cha và chị gái!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290205,
					"content": "Còn Acomitl thì kệ vậy, anh ấy chẳng có chút chí khí nào cả, mà lại còn là anh em ruột với em, thật đáng xấu hổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290206,
					"content": "Acomitl...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "Không, không có gì đâu. Tán gẫu đến đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290208,
					"content": "Dũng sĩ, sau này cũng phải kiên trì rèn luyện bản thân nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290209,
					"content": "#Nếu muốn trở thành huyền thoại thì phải nỗ lực tiến về phía trước! Tiến lên! Tiến lên! Đó là lời nhắn nhủ trước khi chia tay của em dành cho {F#chị}{M#anh}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
