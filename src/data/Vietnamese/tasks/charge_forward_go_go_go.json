				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "Dũng sĩ! Luyện tập thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290502,
					"content": "Có tiến bộ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "Nhu nhược! Không tiến bộ thì đồng nghĩa với thụt lùi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290506,
					"content": "Nói sao nhỉ, trong từ điển của Matahga hình như chỉ có những từ như \"tiến lên\" hay \"cố gắng hết sức\" thôi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290507,
					"content": "Cũng đúng, từ điển của em mỏng hơn người khác! Bởi vì ngoài phấn đấu và nỗ lực ra thì em không công nhận bất cứ thứ gì khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290508,
					"content": "Mọi người cần luyện tập, em cũng vậy. Chỉ luyện tập với Saurian thôi thì em chưa phải là một dũng sĩ toàn năng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290509,
					"content": "Em phải đến sân khấu lớn hơn để rèn luyện bản thân! Nói cách khác, em sẽ rời khỏi đây một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290510,
					"content": "#{F#Hai chị}{M#Anh chị} yên tâm! Em sẽ giữ lại con đường tập luyện ở đây, nhưng ngôi nhà bay này em sẽ dỡ ra và mang theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290511,
					"content": "Em định đi đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "Ừm... Đi thăm cha và chị gái của em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290515,
					"content": "Hả? Sao khí thế của Matahga lại yếu đi thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290516,
					"content": "Có gì không đúng chứ? Yêu thương, tôn trọng gia đình cũng là đức tính mà một dũng sĩ nên có mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290517,
					"content": "Cha em là bậc thầy huấn luyện chuyên nghiệp nhất của Hội Hoa Vũ, chị gái em là người điều khiển Saurian giỏi nhất! Em rất tự hào về họ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290518,
					"content": "Được rồi, không ai có ý lấy họ ra để đùa cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290519,
					"content": "Hiểu rồi, chúc em thành công.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "#{F#Chị}{M#Anh} cũng vậy! Dũng sĩ! Lời tạm biệt lần này là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290521,
					"content": "Để em nghĩ xem nào... Không bao giờ từ bỏ, không màng máu và nước mắt, quyết trở thành anh hùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290513,
					"content": "Em định tập luyện như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "Hmm... Có lẽ em sẽ hỏi ý kiến cha và chị gái trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290504,
					"content": "Dạo này không có thời gian để luyện tập.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "#Lười biếng! {F#Chị}{M#Anh} đang lãng phí cuộc đời vào những cuộc đi chơi vô nghĩa đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				}
			]
