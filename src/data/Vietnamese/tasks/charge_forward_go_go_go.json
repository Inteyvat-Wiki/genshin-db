			"dialogs": [
				{
					"id": 750290101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290102,
					"content": "Chào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "Hahahahahaha!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290105,
					"content": "Ôi trời, giật cả mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290106,
					"content": "Mọi người đến đây, chắc cũng muốn tham gia khóa huấn luyện đặc biệt đúng không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290107,
					"content": "Quả nhiên, dù là người hay Saurian, những dũng sĩ có tinh thần cầu tiến thì sẽ luôn thu hút lẫn nhau!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290108,
					"content": "Đừng lãng phí thời gian nữa, chúng ta bắt đầu huấn luyện đặc biệt ngay thôi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290109,
					"content": "Quả nhiên ở đây cũng có...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "Chúng tôi còn chưa nói gì cả, sao tự nhiên lại thành đi tham gia huấn luyện đặc biệt rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290112,
					"content": "Nhưng nghe giọng điệu này, chẳng lẽ em là bậc thầy huấn luyện gì đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290113,
					"content": "Không phải ai cũng làm được bậc thầy huấn luyện đâu. Em cũng không phải người tài giỏi như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290114,
					"content": "#Nhưng {F#hai chị}{M#anh chị} bay một mạch từ dưới lên đây, chẳng lẽ không phải để tham gia khóa huấn luyện dũng sĩ của em, Matahga sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "Matahga",
					"speakerSubtitle": "Dũng Sĩ Dự Bị Hội Hoa Vũ"
				},
				{
					"id": 750290115,
					"content": "#{F#Hai chị}{M#Anh chị} chỉ đi ngang qua xem thử thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "Rõ ràng đã có nền tảng cơ bản để điều khiển Saurian bay lượn, vậy mà lại không có chí tiến thủ, thật lãng phí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290118,
					"content": "Ban đầu em cứ tưởng là dũng sĩ chung chí hướng chứ... Đáng tiếc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290119,
					"content": "Không ngờ em đã phán đoán sai... Thật xấu hổ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290120,
					"content": "Nên nói Natlan là đất nước của những anh hùng, hay là người dân Natlan ai cũng tràn đầy nhiệt huyết nhỉ? Ngay cả trẻ con cũng nhiệt tình đến vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290121,
					"content": "Không đến nỗi vậy đâu nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "Sai rồi! Đã quyết tâm trở thành dũng sĩ thì không thể lười biếng được! Người không có khí phách, can đảm hay hoài bão thì sẽ không thể thành công!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290124,
					"content": "#Hơn nữa, em đã mười hai tuổi rồi! Từ ngày tròn mười tuổi, em đã không còn là cậu bé nữa... Nhưng mà em sẽ tha thứ cho {F#hai chị}{M#anh chị}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290125,
					"content": "Cái mà dù có uống sữa cũng không cao lên được chỉ là chiều cao của em thôi! Còn cái không thể gãy, không thể cong, có thể chặt đứt mọi trở ngại chính là ý chí của em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290126,
					"content": "#Huống hồ, em sẽ còn lớn nữa, {F#hai chị}{M#anh chị} cũng chẳng cao hơn em là bao đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290127,
					"content": "Tốt! Nói năng thật nhiệt huyết, nhưng sao tự nhiên bẻ lái sang chúng ta vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290128,
					"content": "Hừm, dù phải thừa nhận sức mạnh thể chất bị ảnh hưởng bởi hình thể, nhưng một dũng sĩ thì làm sao có thể bị giới hạn bởi thể xác chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290129,
					"content": "Tinh thần cao thượng vượt xa thể xác cao lớn, vì vậy phải có đủ niềm tin, phải tin vào bản thân đang ấp ủ những ước mơ vĩ đại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290130,
					"content": "Một nhà mạo hiểm chắc cũng có thể hiểu được lý lẽ đơn giản này chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290131,
					"content": "Nói thì đúng rồi, nhưng có phải vừa rồi... em ấy đá xoáy chúng ta không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290132,
					"content": "Đúng thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "#Em đang giải thích cho {F#hai chị}{M#anh chị} về sự cần thiết của ý chí đó! Nhàn rỗi và lười biếng thì làm sao có thể trở thành anh hùng chứ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290135,
					"content": "Là một dũng sĩ... Không, là một con người, nếu không có chí hướng cao cả, không từng đổ mồ hôi trên sân tập thì chính là thất bại!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290136,
					"content": "Không thể oai phong bay lượn trên bầu trời, không được các bậc thầy huấn luyện công nhận, chính là thất bại!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290137,
					"content": "#Vậy nên phải luyện tập thật chăm chỉ! {F#Hai chị}{M#Anh chị} hiểu chưa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290138,
					"content": "Hiểu, hiểu rồi! Làm sao đây? Tuy to tiếng nhưng có lý quá, không thể phản bác được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290139,
					"content": "Tốt lắm, sẵn sàng để rèn luyện rồi thì đến gặp em nhé! Mục tiêu là: Cố gắng hết sức điều khiển Saurian bay theo đường đua cố định và đạt điểm số cao nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290140,
					"content": "Em sẽ quan sát màn thể hiện của người tham gia và chấm điểm. Thành tích cuối cùng sẽ được chia thành bốn mức độ dựa trên điểm số cao thấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290141,
					"content": "Nỗ lực bay nào! Dù không đạt điểm cao nhất thì ít nhất cũng phải đạt mốc đánh giá tốt thứ nhì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290142,
					"content": "Đốt cháy ý chí và đuổi theo em nào! Tiến lên! Tiến lên! Tiến lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290143,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290144,
					"content": "#Dũng sĩ, em đang chờ câu trả lời của {F#chị}{M#anh}!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290145,
					"content": "Hiểu, hiểu rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "Nói to lên nữa nào!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290147,
					"content": "HIỂU RỒI!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "Đây là nơi các dũng sĩ tương lai đầy khát vọng rèn luyện bản thân, hãy thể hiện dũng khí và không ngừng khiêu chiến thế giới này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290149,
					"content": "Sẵn sàng rồi thì đến gặp em để huấn luyện nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290150,
					"content": "#Hiểu rồi! Nhưng {F#chị}{M#anh} không muốn huấn luyện!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "Cái gì? Đã nói đến mức này rồi mà vẫn không thể bỏ được thói lười biếng sao!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290152,
					"content": "#Tệ thật! Nhưng không sao, rồi một ngày nào đó {F#hai chị}{M#anh chị} sẽ không chịu nổi sự thất bại của mình đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290153,
					"content": "Mãi trốn tránh, mãi lùi bước thì sẽ không có được gì cả! Chỉ có tiến lên mới vững bước cười vang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290154,
					"content": "Hừm, nhớ lấy lời em. Đến lúc đó, quay lại đây rèn luyện bản thân cũng không muộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290133,
					"content": "Sao lại chửi chúng ta nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "Em hơi cực đoan rồi đấy, cậu bé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "Đừng coi thường lòng hiếu kỳ của một nhà mạo hiểm nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "Huấn luyện gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
			"id": 7502902,
			"completionStepIds": [
				7502904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
