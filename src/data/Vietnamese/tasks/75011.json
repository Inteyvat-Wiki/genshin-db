				{
					"id": 750110501,
					"content": "Mặt nước đã dâng lên một chút... Hơn nữa trong đó cũng tràn đầy Phlogiston.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110503
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110503,
					"content": "Nước ngang bắp chân rất ấm áp, có thể cảm nhận được hơi ấm truyền qua cơ thể... Đây đều là những thứ rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110504
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110504,
					"content": "Cho nên món quà của Hiền Giả Trộm Lửa, vốn không phải \"vị thuốc chữa khỏi mọi tổn thương\", mà là dòng suối nước nóng ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110505,
					"content": "Quả đúng là Cư Dân Suối Nước mà, cuối cùng thì vẫn có liên quan đến suối nước nóng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110506,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110507
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110507,
					"content": "#Hihi, nhưng {REALNAME[ID(2)|SHOWHOST(true)]} thì lại rất thoải mái nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110508
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110508,
					"content": "Đây không phải suối nước nóng bình thường đâu, Paimon. Nếu là dũng sĩ được lựa chọn thì sau khi ngâm suối nước nóng này sẽ có được sức mạnh để sử dụng Phlogiston đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110509
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110509,
					"content": "Ối, vậy sao? Vậy nếu tôi ngâm suối nước nóng này thì sẽ như thế nào nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110510,
					"content": "Hmm, để nghĩ xem nào... Sẽ trở thành Paimon ướt nhẹp chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110511
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110511,
					"content": "Gì chứ... Tôi còn tưởng là mình cũng sẽ có thể sử dụng Phlogiston, biến thành Hỏa Paimon siêu lợi hại chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110512,
					"content": "Chắc là không được rồi, vì có phải là người được chọn đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110513
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110513,
					"content": "Mà không đúng, Chikya rõ ràng biết món quà là dòng suối nước nóng, thế mà vẫn nói là tìm vị thuốc thần bí, còn muốn chia cho chúng tôi nữa sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110514,
					"content": "Hihi, trên thế giới có nhiều tổn thương như vậy, sao có thể chỉ dựa vào một vị thuốc để chữa trị mọi tổn thương chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110515
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110515,
					"content": "Nhưng trí tuệ có thể giải quyết mọi phiền não. Paimon lần này bị chị lừa nên đã có được một bài học, thế là lại tiến gần hơn đến cảnh giới giải quyết mọi phiền não rồi... Không phải cũng tốt sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110516
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110516,
					"content": "Là vậy sao, ưm... hình như cũng có lý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110517,
						750110519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110517,
					"content": "Vậy thì tổn thương của chị Chikya đây đã được giải quyết chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110518
					]
				},
				{
					"id": 750110518,
					"content": "Vẫn chưa. Các tổn thương của chị vẫn âm ỉ trong lòng. Về điểm này thì chị cũng bị lừa, bị chính bản thân chị lừa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110520
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110520,
					"content": "Dù có ngâm trong dòng suối tràn đầy Phlogiston này thì chị vẫn không thể sử dụng. Trên cuộn vải cổ nói rằng người trong bộ tộc không biết sử dụng Phlogiston trước đây đều sẽ học được cách sử dụng thông qua thí luyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110521
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110521,
					"content": "Vậy chẳng phải không có chút hiệu quả nào sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110522
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110522,
					"content": "...Khoan, Chikya rõ ràng là người Natlan, nhưng lại không thể sử dụng Phlogiston sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110523,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110524
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110524,
					"content": "Sự chậm hiểu của Paimon trong những thời khắc quan trọng này làm người ta tổn thương đấy! Đúng vậy, ở Natlan nơi ai cũng biết sử dụng Phlogiston, thì cũng sẽ có một số ít người không thể dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110525
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110525,
					"content": "Lúc chị còn rất nhỏ từng có một lần bị thương nặng, có liên quan đến Vực Sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110526
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110526,
					"content": "Có thể sống sót đã là kỳ tích rồi, nên cơ thể chị không khỏe chút nào. Chị nói có thể cõng Iktomisaur chạy thật ra là lừa mọi người đấy, vì Iktomisaur có thể bay nên sẽ không có sức nặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110527
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110527,
					"content": "Có thể vì tổn thương này nên chị không thể sử dụng Phlogiston. Dù có thử thế nào, tốn bao tâm tư, xem các cuộn vải khác nhau cũng không có cách sử dụng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110528
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110528,
					"content": "Chị cũng nắm rõ cả cách thông qua việc phân tích Chữ Khắc Phlogiston mà người bây giờ đã từ bỏ. Chị rất cố gắng để học thuộc những từ ngữ đó, nên có được trí nhớ tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110529
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110529,
					"content": "Chị đi dạy những đứa trẻ trong bộ tộc về điều cơ bản của Phlogiston, cũng vì mong có thể nhờ cơ hội này mà quan sát những đứa trẻ thức tỉnh cách sử dụng nó. Kể ra thì, chị cũng khá được đám trẻ yêu thích đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110530
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110530,
					"content": "Mọi thứ liên quan đến Phlogiston chị đều biết, càng tìm hiểu thì càng cảm thấy nó rất tuyệt vời. Nhưng càng như vậy thì càng thấy tiếc nuối vì bản thân không thể sử dụng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110531
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110531,
					"content": "#Haiz, thí luyện trên suốt đoạn đường hầu như đều là {NICKNAME} cố gắng làm, chị cũng biết muốn học được kỹ năng như tổ tiên thì phải có sự hy sinh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110532
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110532,
					"content": "Nhưng chị không có lòng dũng cảm như vậy. Có lẽ đây chính là nguyên nhân mà chị không thể sử dụng Phlogiston nhỉ, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110533
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110533,
					"content": "Chikya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110534,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110535
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110535,
					"content": "Không sao đâu, chị đã sớm nhìn thoáng hơn rồi. Lần này không được thì còn có lần sau, rồi cũng sẽ tìm ra cách thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110536
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110536,
					"content": "#Ừm, chị cảm ơn nhé... Thật sự rất cảm ơn {NICKNAME}, cưng quả thực rất mạnh mẽ, cũng rất dịu dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110537
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110537,
					"content": "Không giống như chị đây, cảm giác như cuộc sống đã đóng khung rồi... Sau này cưng sẽ còn trải nghiệm thêm những chuyến thám hiểm tuyệt vời khác nữa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110538
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110538,
					"content": "Thật tuyệt quá, chị có hơi ganh tị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110539
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110539,
					"content": "#{NICKNAME} tiền đồ rộng mở, hành trình sau này nhất định phải thật thuận lợi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110540
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110540,
					"content": "Chikya cũng vậy nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110541
					]
				},
				{
					"id": 750110541,
					"content": "Chắc chắn Chikya sẽ đạt được nguyện vọng của mình!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110542
					]
				},
				{
					"id": 750110542,
					"content": "Có lẽ \"vị thuốc chữa khỏi mọi tổn thương\" không tồn tại, nhưng chắc chắn Chikya sẽ tìm được vị thuốc của riêng mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110543,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110544
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110544,
					"content": "#Haha, cảm ơn Paimon và {NICKNAME}... cả {REALNAME[ID(2)|SHOWHOST(true)]} nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110545
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110545,
					"content": "#...Ừm, câu mà {NICKNAME} nói thật khiến người ta cảm động. Lần này chị đây đúng là có hơi cảm động đó, vì cưng rất đáng tin cậy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110546
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110546,
					"content": "Được rồi, để chị nghỉ ngơi ở đây thêm một lúc nhé, dù gì suối nước nóng cũng rất ấm áp mà. Ngâm thêm một lúc rồi tiếp tục nghĩ xem làm sao để tìm thêm cách khác thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110547
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110547,
					"content": "Haiz, nói không chừng chị sẽ bị mắng cho một trận vì bỏ nhà ra đi mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110548
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110548,
					"content": "#Nhưng như lời {NICKNAME} nói đó, phải cố gắng để đạt được nguyện vọng của mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110519,
					"content": "Cô đã học được cách sử dụng Phlogiston chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110520
					]
				}
			]
		}
	]
}