							8548.529
						],
						"pointId": 8671
					}
				]
			},
			"dialogs": [
				{
					"id": 750110101,
					"content": "Thì ra nơi đây chính là Thánh Địa Nổi. Từ dưới nhìn lên còn tưởng phía trên sẽ xám xịt không có gì cả chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110102,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110103,
					"content": "Không ngờ lại trông như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110104,
					"content": "Ừm. Nghe nói bản thân phần đất lơ lửng ở đây được giữ lại với nhau bằng sức mạnh của Phlogiston, bản thân nó là một nguồn năng lượng cực kỳ mạnh mẽ.... Nguồn năng lượng có hơi kỳ lạ, cứ tạm hiểu như vậy trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110105
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110105,
					"content": "Cũng vì vậy mà trên đây cũng có thể mọc ra hoa và cỏ, có thể để mặt đất lạnh lẽo trở nên ấm áp trở lại, có thể thiêu đốt linh hồn thắp sáng ngọn lửa trong bóng tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110106
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110106,
					"content": "Đây chính là Phlogiston... Là do Hiền Giả Trộm Lửa đã cướp từ tay con rồng khổng lồ và giao cho mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110107
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110107,
					"content": "Nói đến chuyện này lại nhớ ra một chuyện hơi đáng giận... Hừ, có vài người trong bộ tộc khi nhìn thấy Thánh Địa Nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110108
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110108,
					"content": "...Liền nói nếu con người dùng Phlogiston thì sẽ không đạt được đến trình độ tạo ra đảo nổi, Hiền Giả Trộm Lửa được nhắc đến thật ra cũng là một loài rồng khổng lồ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110109
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110109,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110110,
						750110111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110110,
					"content": "Còn có cả quan điểm như vậy à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110113
					]
				},
				{
					"id": 750110113,
					"content": "Bản thân không làm được liền nói người làm được không phải con người. Quả đúng là không có chí hướng, chị đây mới không muốn làm bạn với bọn họ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110114
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110114,
					"content": "À, kể ra thì kho báu và thuốc thần bí đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110115,
					"content": "Xét về mặt này thì nơi đây hình như chẳng có gì cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110116,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110117,
					"content": "Hihi, đây là thí luyện của Hiền Giả Trộm Lửa bị gọi là kẻ điên đấy. Sao mà đơn giản như vậy được chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110118
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110118,
					"content": "Theo ghi chép thì bây giờ chúng ta cần mở một số cơ quan, hoàn thành thí luyện cuối cùng, sẽ có thể đến được trung tâm của Thánh Địa Nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110119
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110119,
					"content": "Nhưng chị cũng không biết trung tâm của Thánh Địa Nổi sẽ trông như thế nào. Cứ cảm thấy hình ảnh đảo nổi từng xuất hiện trong ký ức có chút khác so với bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110120
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110120,
					"content": "Nhưng cũng có thể là sau khi có tuổi rồi thì đến cả trí nhớ vốn luôn tự hào cũng đã trở nên không đáng tin cậy nữa. Nhưng không sao, cũng đã đến đây rồi thì cứ dựa vào trực giác thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110121
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110121,
					"content": "Vậy thì cơ quan phải mở như thế nào đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110122
					]
				},
				{
					"id": 750110122,
					"content": "Hmm... Có lẽ cũng giống như Chữ Khắc Phlogiston, chỉ cần dùng Phlogiston là có thể mở được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110123
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110123,
					"content": "Ít ra thì trên cuộn vải dệt đã vẽ như vậy. Nghe nói Bia Khắc Ấn Phlogiston ở khắp Natlan thật ra được chế tạo dựa trên hình mẫu cơ quan ở nơi đây... Cơ quan cũng là một cổ vật phi thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110124
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110124,
					"content": "#Nào, {F#cô nàng}{M#chàng trai} tiền đồ rộng mở, hihi. Mau đi thử xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110111,
					"content": "Ai cũng có quan điểm của riêng mình mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110112
					]
				},
				{
					"id": 750110112,
					"content": "Ừm. Nhận định của người khác về thế giới thật ra là điều rất khó lay chuyển, nhưng chị đây vẫn rất tức giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110113
					],
					"speakerTitle": "Chikya"
				}
			]
