			"dialogs": [
				{
					"id": 750110201,
					"content": "Phù, đây là cơ quan cuối cùng rồi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110202,
					"content": "Nhìn cũng không khác so với những cơ quan khác mà. Chẳng lẽ Chikya bị lừa rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110203,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110204,
					"content": "Sao có thể chứ. Về việc giải mã cuộn vải dệt thì chị đây rất tự tin... à ừm, hơi tự tin... Chậc, có một chút tự tin đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110205
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110205,
					"content": "Sự tự tin càng nói càng ít đi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110206,
					"content": "Nhưng đây chắc không phải là cơ quan cuối cùng đâu. Trong ấn tượng của chị thì hình dạng cơ quan lẽ ra phải lớn hơn, và cũng... hoàn chỉnh hơn nữa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110207
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110207,
					"content": "\"Hòn đảo trên không\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110208
					]
				},
				{
					"id": 750110208,
					"content": "#Không hiểu lắm, {F#cô nàng}{M#chàng trai} tiền đồ rộng mở à, chỉ nói ra một cái tên như vậy thì người khác không thể nào hiểu được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110209
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110209,
					"content": "...Có kho báu, vị thuốc thần bí hay không thì chỉ cần thử là biết ngay mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110210
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110210,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110211,
					"content": "Lần này không được thì có lần sau, chỗ này không được thì có chỗ khác. Chỉ cần tiếp tục thử thì rồi cũng sẽ xuất hiện kỳ tích thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110212,
						750110214
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110212,
					"content": "Đúng là sự lạc quan không ai đọ lại đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110213
					]
				},
				{
					"id": 750110213,
					"content": "Chị sẽ xem như là cưng đang khen chị nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110216,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110217,
					"content": "#Hihi, {REALNAME[ID(2)|SHOWHOST(true)]} cũng rất phấn khích nhỉ. Nào, {NICKNAME}, hãy dùng Phlogiston khởi động cơ quan đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110214,
					"content": "Có thể tiếp tục thử mới là kỳ tích lớn nhất đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110215
					]
				},
				{
					"id": 750110215,
					"content": "Không được dội gáo nước lạnh vào chị nhé!",
