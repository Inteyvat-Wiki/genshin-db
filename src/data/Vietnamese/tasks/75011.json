			"dialogs": [
				{
					"id": 750110301,
					"content": "Không ngờ trung tâm của Thánh Địa Nổi lại là một hòn đảo bị ẩn giấu... Haiz, hèn chi trông khác với trong hình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110302
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110302,
					"content": "Điều này chứng minh trí nhớ của chị đây vẫn đáng tin cậy đấy. Dù sao thì thường ngày chị cũng đảm nhận việc sắp xếp các món đồ dệt cổ mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110303
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110303,
					"content": "Nhưng ở đây ngoại trừ việc có một tảng đá to thì không có gì khác nữa... Chẳng lẽ tảng đá này chính là món quà mà Hiền Giả Trộm Lửa để lại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110304,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110305,
					"content": "...Đến đây thì chị cũng không biết nữa. Vì tất cả cuộn vải đều vẽ rằng các dũng sĩ vượt qua thí luyện đến được nơi đây sẽ có thể cảm nhận được tinh thần của Hiền Giả Trộm Lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110306
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110306,
					"content": "Chỉ cần vượt qua thí luyện và đến được nơi đây, thì sẽ có thể cảm nhận được một sự triệu hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110307
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110307,
					"content": "Nhưng hình thức cụ thể ra sao thì chị cũng không biết. Vốn dĩ chị tưởng sau khi đến được nơi đây thì sẽ biết... Nhưng bây giờ xem ra là không được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110308
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110308,
					"content": "Rawr... Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110309,
					"content": "#Hửm, {REALNAME[ID(2)|SHOWHOST(true)]} thấy được gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110310
					]
				},
				{
					"id": 750110310,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110311,
					"content": "Vậy... nhóc hiểu được sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110312
					]
				},
				{
					"id": 750110312,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110313
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110313,
					"content": "#Cưng... có thấy gì không? Thật không ngờ người có tư cách nhận món quà lại là {NICKNAME} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110314
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110314,
					"content": "Ối, tôi cũng không thấy gì cả... Thật kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110315,
					"content": "Tôi nhìn thấy hoa văn màu vàng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110316
					]
				},
				{
					"id": 750110316,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110317,
					"content": "#Hoa văn màu vàng? Ý là cái mà {NICKNAME} thấy được ở chỗ lần đầu gặp {REALNAME[ID(2)|SHOWHOST(true)]} sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110318,
					"content": "Mà khoan đã, cái đó không phải ảo giác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110319,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110320,
					"content": "#Cho dù {REALNAME[ID(2)|SHOWHOST(true)]} có ra hiệu ngước lên nhìn thì cũng thế thôi, căn bản là không nhìn thấy mà. Nhưng nếu đã nói như thế thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110321,
						750110322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110321,
					"content": "Giọng điệu cũng rất quen thuộc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110323
					]
				},
				{
					"id": 750110323,
					"content": "Cho nên người để lại hoa văn màu vàng khi đó, có lẽ chính là Hiền Giả Trộm Lửa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110324,
					"content": "Hả? Thì ra trước đây hai người đã từng nhận được chỉ dẫn của Hiền Giả Trộm Lửa à...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110325
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110325,
					"content": "#Vậy thì {F#cô nàng}{M#chàng trai} đây quả nhiên rất có tiền đồ đấy. Dù sao thì cũng là người được chị chọn mà, vậy thì cưng có cách tìm ra món quà không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110326
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110326,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110327,
						750110328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110327,
					"content": "Ừm, chỉ cần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110329
					]
				},
				{
					"id": 750110329,
					"content": "Bia đá phát ra âm thanh lớn.\\nCùng với sự rung chuyển của mặt đất, tảng đá to đã lộ ra hình dạng thật...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750110328,
					"content": "(Đưa tay hướng về phía bia đá to...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110329
					]
				},
				{
					"id": 750110322,
					"content": "Hoa văn màu vàng này với cái trước kia là của cùng một người để lại...",
					"roleType": "TALK_ROLE_PLAYER",
