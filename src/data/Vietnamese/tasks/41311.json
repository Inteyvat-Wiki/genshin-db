			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110601,
					"content": "#{NICKNAME}, mau xem kìa! Viên đá trôi nổi giữa không trung, hơn nữa sợi dây kết nối còn bị kéo thẳng ra nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110602,
					"content": "Nếu không bị buộc lại, chả biết nó sẽ bay đi đâu mất nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110603,
					"content": "Đó là Phù Sinh Thạch được dùng để chế tạo Đèn Minh Tiêu. Toàn bộ Chợ Đèn Tiêu đều được bố trí xung quanh nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110604
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110604,
					"content": "Cho hỏi bạn là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110605,
					"content": "Tôi là Jiangzhou, thời gian gần đây phụ trách thống kê tiến độ xây dựng đèn Minh Tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110606
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110606,
					"content": "Chắc các bạn lần đầu tiên đến Liyue đón tết Hải Đăng phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110607
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110607,
					"content": "Đúng vậy... Sao bạn biết được?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110608,
					"content": "Năm ngoái tôi không nhớ có Nhà Lữ Hành đem theo vật may mắn kỳ quái đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110609
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110609,
					"content": "Vì thế Đèn Minh Tiêu mà bạn nói chính là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110610
					]
				},
				{
					"id": 413110610,
					"content": "Trong ngày tết, đèn được bay lên trời gọi là \"đèn tiêu\". Hơn nữa người Liyue cùng làm một chiếc đèn khổng lồ, chính là \"Đèn Minh Tiêu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110611
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110611,
					"content": "Các hàng quán trong \"Chợ Đèn Tiêu\", là các thương nhân khắp Liyue mở mỗi năm một lần, cũng chẳng phải vì kiếm lời, mà là đóng góp cho việc xây dựng Đèn Minh Tiêu mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110612
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110612,
					"content": "Chợ Đèn Tiêu có đồ ăn ngon không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110613,
					"content": "Đương nhiên có, vả lại, Tết Hải Đăng còn là dịp thích hợp nhất để thưởng thức món ngon của Liyue đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110614
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110614,
					"content": "Đây là lễ hội trọng đại nhất năm của Liyue, nếu có thể phô diễn tài nghệ của mình trong Tết Hải Đăng này, chắc chắn sẽ giành được rất nhiều lời khen ngợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110615
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110615,
					"content": "Vì vậy, tuy không phải vì tiền, nhưng các thương nhân đều ngấm ngầm nỗ lực hết sức để tranh cao thấp trong Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110616
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110616,
					"content": "Phương diện nào người dân Liyue cũng đều giỏi hết ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110617,
					"content": "Nếu các bạn vẫn còn thắc mắc cứ đến tìm tiểu thư <color=#00E1FFFF>Wang'ya</color>, cô ấy là người phụ trách Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110618
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110618,
					"content": "Cô ấy thường ở nơi nào đó trong Chợ Đèn Tiêu, có thắc mắc gì cứ đến hỏi cô ấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110619
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110619,
					"content": "Cô ấy biết tiệm nào bán đồ ăn ngon nhất chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110620,
					"content": "Đương nhiên rồi, tiểu thư Wang'ya biết tất cả mọi việc về Tết Hải Đăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110621
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 413110621,
					"content": "#Biết rồi, {NICKNAME}, chúng ta mau đến Chợ Đèn Tiêu tìm tiểu thư <color=#00E1FFFF>Wang'ya</color> đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110622,
					"content": "Rồi... đến cửa tiệm bán đồ ăn ngon nhất ăn tới khi nào no căng bụng thì thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
