			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "Tạo hình của Đèn Minh Tiêu năm nay chính là tưởng niệm \"Di Tiêu Đạo Thiên Chân Quân\" ư, kẻ thích ra oai như vậy ắt hẳn phải vui lắm đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010602,
					"content": "Về \"Di Tiêu Đạo Thiên Chân Quân\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "Tạo hình Đèn Minh Tiêu của Tết Hải Đăng năm nay chính là hình mẫu \"Di Tiêu Đạo Thiên Chân Quân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010604,
					"content": "Hy vọng mọi người có thể làm chiếc sừng to một chút, vì đó cũng là bộ phận đáng tự hào nhất của vị tiên nhân này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010605,
					"content": "Tương truyền, sừng của ngài hấp thu thần lực của Nham Vương Đế Quân, từng là thứ cứng nhất Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010606,
					"content": "Trong trận quyết chiến đó, núi đá rung chuyển, vì lo nghĩ cho thôn trang dưới núi, ngài chủ động nhờ người bạn của mình chặt hạ sừng xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010607,
					"content": "Đem sừng lấm lem vết máu làm trụ, giúp cho cả ngọn núi đứng vững, còn ngài quyết chiến đến giọt máu cuối cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010608,
					"content": "Cho đến nay, ngọn núi Thiên Hoành Sơn từng được ngài chống đỡ vẫn đứng vững như xưa, còn dòng máu chảy ra khi ngài chết tích tụ thành Sông Bích Thủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010609,
					"content": "Haha... Cho dù có tin hay không, có người lắng nghe những chuyện cũ cũng có chút an ủi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010610,
					"content": "Tết Hải Đăng có thể tồn tại đến nay cũng là do một vài \"người bạn cũ\" không cam chịu cô độc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 400010611,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "Tạm biệt. Lửa Thiêng Truyền Mãi, Mỹ Đức Bất Diệt",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				}
			]
		},
