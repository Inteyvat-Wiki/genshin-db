					"nextDialogs": [
						413110809
					],
					"speakerTitle": "Yi'nian"
				},
				{
					"id": 413110809,
					"content": "Thôi, đưa tài liệu cho tôi đi, để tôi cho nó vào lò luôn",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110810
					],
					"speakerTitle": "Yi'nian"
				},
				{
					"id": 413110810,
					"content": "Chọn món đi nào, không phải các bạn đến ăn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110811
					],
					"speakerTitle": "Yi'nian"
				},
				{
					"id": 413110811,
					"content": "Nhiều đồ ngon quá, cái này trông ngon nè, cái này cũng ngon nữa...",
