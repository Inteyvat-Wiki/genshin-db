			},
			"dialogs": [
				{
					"id": 413110701,
					"content": "Xin chào, có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110702
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110702,
					"content": "Trông bạn có vẻ không phải người Liyue, là Nhà Lữ Hành phải không? Rất hân hạnh chào đón bạn đến Chợ Đèn Tiêu vui chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110703
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110703,
					"content": "Cho hỏi bạn là người phụ trách Tết Hải Đăng phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110704
					]
				},
				{
					"id": 413110704,
					"content": "...Không, Tết Hải Đăng là ngày lễ chung của toàn Liyue, nó không được phụ trách bởi cá nhân nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110705
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110705,
					"content": "Tôi cũng chỉ hỗ trợ vài việc vặt để làm cho không khí ngày lễ thêm phần sôi động thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110706
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110706,
					"content": "Tôi có một số chuyện muốn hỏi ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110707
					]
				},
				{
					"id": 413110707,
					"content": "Chúng tôi muốn hỏi, sạp nào trong Chợ Đèn Tiêu bán đồ ăn ngon nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110708,
					"content": "Ngon nhất ư? Ở đâu cũng có điểm đặc sắc, tôi cũng không thể đánh giá chung được. Nhưng mà theo tôi thấy thì sạp đông người nhất là <color=#00E1FFFF>Yi'nian</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110709
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110709,
					"content": "Nếu ở đó đông người thêm chút nữa thì tôi phải nhờ đến Thiên Nham Quân để giữ trật tự rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110710
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110710,
					"content": "Các bạn muốn đi thì nhanh chân nhé, lúc này khách vẫn chưa đông lắm",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110711
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110711,
					"content": "Đúng rồi, nếu các bạn đến chỗ Yi'nian thì tiện thể mang giúp tôi tài liệu này qua đó nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110712
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110712,
					"content": "Đây là bản kiến nghị kinh doanh dựa vào số liệu tổng hợp của Tết Hải Đăng năm ngoái. Nếu bạn đến đó thì tiện thể mang giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110713
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 413110713,
					"content": "Sau khi xong việc thì tôi sẽ tặng bạn phần quà để trả công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				}
			]
		},
