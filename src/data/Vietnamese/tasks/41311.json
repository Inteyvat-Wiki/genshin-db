					],
					"speakerTitle": "Changchang"
				},
				{
					"id": 400010903,
					"content": "Vì thế em đã tặng nó cho chị gái ở chỗ Đèn Đại Lộc, chắc nguyện vọng của búp bê sắp thành hiện thực rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010904
					],
					"speakerTitle": "Changchang"
				},
				{
					"id": 400010904,
					"content": "Có phải Changchang đã làm được một việc tốt không? Tết Hải Đăng là ngày để thực hiện nguyện vọng của mọi người phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changchang"
				}
			]
		},
