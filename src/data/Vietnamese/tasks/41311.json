			"dialogs": [
				{
					"id": 400010203,
					"content": "Bao nhiêu tiền cũng không bán!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010205,
					"content": "Tin tôi đi, bạn trả không nổi đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010202,
					"content": "Xin hỏi thứ đồ bay bay bên cạnh bạn, bán bao nhiêu tiền vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010204,
					"content": "Bao nhiêu tiền cũng không bán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010206,
					"content": "Lời nói thật kỳ quặc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010207,
					"content": "Thực sự tôi vẫn còn thắc mắc...rốt cuộc là bao nhiêu tiền thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010208,
					"content": "Thôi vậy, tôi nói thẳng \"bao nhiêu tiền cũng không bán\" vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010209,
					"content": "Haha, thời gian gần đây tiền vốn không đủ, khó mà trả giá được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010210,
					"content": "Dù sao tôi cũng chỉ là một người buôn bán nhỏ, cũng không buôn bán bảo vật quý hiếm gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010211,
					"content": "Cảm thấy đáng nghi ngờ quá à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010212,
					"content": "Đừng nói như vậy chứ. Người bạn nhỏ, có muốn ăn kẹo không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010220,
					"content": "Không hổ danh là Paimon mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}, tôi thấy người này có thể tin được đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010214,
					"content": "Đúng rồi, các bạn đến Liyue là vì Tết Hải Đăng phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010215,
					"content": "Đèn Minh Tiêu năm nay rất đáng trông đợi. Viên Phù Sinh Thạch để làm chiếc đèn khổng lồ bay lên là loại to nhất trong 20 năm gần đây đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010216,
					"content": "To đến mức khó tin, thành phố trên mây trong thần thoại nếu có thật thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010217,
					"content": "Chắc cũng đặt một viên Phù Sinh Thạch to như vậy ở dưới chăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010218,
					"content": "Thật là kỳ thú quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010219,
					"content": "Haha, có duyên gặp lại. Chào mừng các bạn đến Liyue, tuy không thể đại diện cho <color=#00E1FFFF>Cảng Liyue</color>, thế nhưng cửa tiệm nhỏ của tôi luôn hoan nghênh các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
