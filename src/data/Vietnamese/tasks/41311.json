					"nextDialogs": [
						413110806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110806,
					"content": "Đương nhiên rồi, bạn mau đặt món đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110807
					],
					"speakerTitle": "Yi'nian"
				},
				{
