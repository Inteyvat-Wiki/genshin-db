			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110101,
					"content": "Sắp đến Tết Hải Đăng rồi, năm nay có nên trang trí nhà trọ không nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110102,
					"content": "Tết Hải Đăng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110103
					]
				},
				{
					"id": 413110103,
					"content": "Bạn không biết sao? Đêm trăng tròn đầu tiên của mỗi năm chính là Tết Hải Đăng của Liyue đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110104,
					"content": "Đây là ngày lễ kỷ niệm anh hùng, trong đêm ấy, mọi người sẽ thả \"Đèn Tiêu\" và \"Đèn Minh Tiêu\" lên trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110105,
					"content": "Ý nghĩa của những chiếc đèn đó là \"Lửa Thiêng Truyền Mãi, Mỹ Đức Bất Diệt\". Chúng tôi tin rằng ánh đèn trên biển đêm sẽ chỉ đường cho người anh hùng quay trở lại quê nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110106,
					"content": "Ồ, có vẻ đây là một lễ hội rất trọng đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110107,
					"content": "Không chừng... còn có nhiều đồ ăn ngon nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110108,
					"content": "#{NICKNAME}, bạn hiểu ý tôi mà phải không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110109,
					"content": "Các bạn muốn tham dự Tết Hải Đăng không? Vừa hay, khoảng thời gian trước đêm \"Tết Hải Đăng\" cũng được xem là ngày lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110110
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110110,
					"content": "Trong thời gian này có thể cầu bình an, xua đuổi tai ương. Theo cách nói của người Liyue, đó là \"Tống Cựu Nghênh Tân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110111,
					"content": "Nếu các bạn muốn tham gia, thì bây giờ đi cũng không muộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110112,
					"content": "Còn có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110113,
					"content": "Còn có?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110114
					]
				},
				{
					"id": 413110114,
					"content": "Nếu được...ừm...các bạn có muốn thử mời Xiao cùng đi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110115
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110115,
					"content": "Anh ấy không thân với chúng tôi, tôi cũng không tiện mời. Nhưng các bạn có vẻ khá thân với anh ấy, hay là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110116
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110116,
					"content": "Nhưng, tâm trạng của Xiao bây giờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110117
					]
				},
				{
					"id": 413110117,
					"content": "Ừm, làm phiền anh ấy trong thời gian này có vẻ không ổn lắm nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110118,
					"content": "Vậy à... không sao! Tôi chỉ buột miệng nói thế thôi. Các bạn mau đến <color=#00E1FFFF>Liyue</color> đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110119
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110119,
					"content": "Nếu đến quá muộn thì trong thành sẽ đông nghịt người đó, muốn dạo phố chơi cũng khó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110120
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413110120,
					"content": "Nhanh lên, chúc các bạn chơi lễ vui vẻ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
