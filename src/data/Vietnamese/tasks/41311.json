					"nextDialogs": [
						413110803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110803,
					"content": "Là khách sao? Bên đây có ghi lại thực đơn này, các bạn muốn ăn gì thì cứ đặt nhé.",
					"roleType": "TALK_ROLE_NPC",
