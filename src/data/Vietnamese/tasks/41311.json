					"nextDialogs": [
						413110812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110812,
					"content": "Í, \"Cá Hổ Nướng\"? Tôi nhớ đây là món mà Đồng Tước rất thích ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110813,
					"content": "Ừm... nếu Tết Hải Đăng là ngày tưởng niệm anh hùng, vậy chúng ta cứ chọn món này, xem như dùng cách này để tưởng niệm anh ấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110814,
						413110815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110814,
					"content": "Tôi thấy bạn muốn ăn thì đúng hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110816
					]
				},
				{
					"id": 413110816,
					"content": "Người bạn nhỏ này sành ăn ghê, chọn trúng món đặc biệt nhất của chúng tôi luôn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110817
					],
					"speakerTitle": "Yi'nian"
				},
				{
					"id": 413110817,
					"content": "Các bạn chờ chút nhé, thức ăn sẽ lên ngay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110819
					],
					"speakerTitle": "Yi'nian"
				},
				{
					"id": 413110819,
					"content": "Xong rồi, đây là món Cá Hổ Nướng mà các bạn đã gọi, ăn thử xem mùi vị thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110820
					],
					"speakerTitle": "Yi'nian"
				},
				{
					"id": 413110820,
					"content": "Đồ ăn rất ngon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110821,
					"content": "Paimon là chuyên gia trong lĩnh vực ăn uống mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110822
					]
				},
				{
					"id": 413110822,
					"content": "Đương nhiên rồi, tôi là người hướng dẫn giỏi nhất của bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413110823,
					"content": "Hahaha, vậy các bạn cứ từ từ ăn nhé, tôi phải đi tiếp đãi những khách hàng khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110824
					],
					"speakerTitle": "Yi'nian"
				},
				{
					"id": 413110824,
					"content": "Nếu muốn ăn nữa thì cứ gọi, tôi sẽ phục vụ ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
