				"points": []
			},
			"dialogs": [
				{
					"id": 210270201,
					"content": "Nhà Lữ Hành, cả Meng nữa? Có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 210270202,
					"content": "#Hả? Ừm...chuyện là...chuyện là... {F#chị}{M#anh}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270203,
					"content": "Chúng cháu muốn mượn bếp của chú một lát.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Mượn bếp thì không thành vấn đề, nhưng sao đột nhiên các cháu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 210270205,
					"content": "Thì ra là vậy...được rồi, các cháu cứ dùng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 210270206,
					"content": "Meng, đi du lịch bên ngoài là cháu không được kén ăn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 210270207,
					"content": "Cháu, cháu biết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270208,
					"content": "#Vậy thì nhờ {F#chị}{M#anh} rồi, dạy em làm một món thật ngon đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270209,
					"content": "Để khi em và bố đi du lịch, em nhất định phải làm cho bố bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270210,
					"content": "Cứ giao cho chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}, chúng ta nên làm món gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
