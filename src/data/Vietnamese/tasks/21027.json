	"talks": [
		{
			"id": 2102701,
			"completionStepIds": [
				2102701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102701",
							"2"
						],
						"stepId": 2102701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"A Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#{F#Chị}{M#Anh} đến đúng lúc lắm, em đang định đi tìm {F#chị}{M#anh} đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270102,
					"content": "Hở? Có việc gì sao Meng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "#Không phải lần trước em nhờ {F#chị}{M#anh} cùng em đi thả bình trôi chứa những muộn phiền của em sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270104,
					"content": "Vốn dĩ em cũng không còn hy vọng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270105,
					"content": "Nhưng cách đây vài ngày, bố em nói rằng một trong những đối tác làm ăn của bố đột nhiên đến tìm bố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270106,
					"content": "Chú đó nói họ đang lên kế hoạch kinh doanh liên quan đến nấm rơm, một thời gian nữa sẽ đến Sumeru khảo sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270107,
					"content": "Họ hỏi bố có muốn đi cùng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270108,
					"content": "Còn nói...có thể đưa em theo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270109,
					"content": "Ban đầu bố không đồng ý, nhưng mà chú đó đột nhiên lấy ra một bức thư, nói muốn nói chuyện riêng với bố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270110,
					"content": "Sau khi họ nói chuyện xong thì bố đã đồng ý dẫn em đến Sumeru rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270111,
					"content": "Ừm, tuy không biết tại sao bố lại đổi ý, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270112,
					"content": "#Em được đến Sumeru rồi! {F#Chị}{M#Anh} ơi! Em được đến Sumeru rồi! Tuyệt quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270113,
					"content": "Chúc mừng em!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#Chắc là chiếc bình trôi đó phát huy tác dụng rồi, cảm ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270117,
					"content": "Bố nói là sau khi đến Sumeru thì sẽ còn đến một chỗ tên là \"Làng Kiều Anh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270118,
					"content": "Làng Kiều Anh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Ừm, bố nói đó là một ngôi làng trồng rất nhiều cây trà, lá trà ở đó đều là thượng phẩm. Nhưng mà tên của nó thì hơi khó nhớ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270120,
					"content": "Thôi khoan nói chuyện này đã! Trước khi đến được đó thì em phải đi qua Sumeru đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270121,
					"content": "Sumeru cách đây cũng xa lắm, nên có lẽ cũng tốn không ít thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270122,
					"content": "Nhưng mà, em nghe nói mọi người khi đi du lịch thì cần phải chuẩn bị nhiều thứ lắm. Bởi vì thời gian đi du lịch càng dài thì sẽ càng gặp phải nhiều thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270123,
					"content": "#{F#Chị}{M#Anh} thường đi du lịch bên ngoài, {F#chị}{M#anh} có thể chỉ cho em một số mẹo khi đi du lịch bên ngoài được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270124,
					"content": "Ví dụ như...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270125,
					"content": "Khi đi ra ngoài thường sẽ ăn gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270126,
					"content": "Bố nói với em, họ đều tự nấu ăn. Nhưng em chỉ biết mấy món đơn giản, cũng không biết nấu có ngon hay không nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270127,
					"content": "#Hì hì, nấu nướng là sở trường của chúng ta mà, đúng không? {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "#Để {F#chị}{M#anh} dạy em.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "Vậy thì chúng ta phải tìm một cái bếp trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "Paimon nghĩ... hay là chúng ta đến chỗ Thầy Mao mượn bếp đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "Thầy Mao? Òa, chú đó bình thường đáng sợ lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270133,
					"content": "Thầy Mao mà đáng sợ gì chứ? Thầy Mao rất tốt bụng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "Vậy, vậy sao? Nhưng mỗi lần cùng bố đến đó dùng cơm, chỉ cần em lựa Thanh Tâm ra không ăn là chú ấy lại chau mày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A Meng"
				},
				{
					"id": 210270129,
					"content": "#Cứ giao cho {F#chị}{M#anh}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "#Nói không chừng {F#chị}{M#anh} cũng sẽ đến Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "Thật sao? Vậy chúng ta gặp nhau ở Sumeru nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "A Meng"
				}
			]
		},
