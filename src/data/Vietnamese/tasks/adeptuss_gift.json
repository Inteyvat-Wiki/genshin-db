			},
			"dialogs": [
				{
					"id": 711630301,
					"content": "Chuyện gì vậy? Sao chúng ta lại đến đây thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630302,
					"content": "Thế nào? Có thích món đồ nhỏ mà tôi chuẩn bị cho hai vị không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630303,
					"content": "Zibai, cô ở đây à?! Cái ô này là sao vậy? Vèo một cái đã đưa chúng tôi đến đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630304,
					"content": "Có vẻ trí nhớ của hai vị cũng không được tốt nhỉ? Chưa gì đã quên mất trước đây từng ngồi cùng tôi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630305,
					"content": "Giờ đã nhớ ra chưa nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630306,
					"content": "Ồ! Là... là Cỗ Xe Cung Trăng! Chẳng trách vừa rồi thấy quen mắt như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630307,
					"content": "Haha, đây chỉ là bản sao mà tôi mô phỏng theo trí nhớ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630308,
					"content": "#Cũng nhờ có mảnh ngọc mà {NICKNAME} mang đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630309,
					"content": "#Ồ! Thì ra món đồ nhỏ mà lúc trước cô nói muốn làm tặng {NICKNAME}, chính là thứ này à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630310,
					"content": "Đúng vậy. Cỗ xe chế tác từ ngọc này có thể nhanh chóng đưa hai vị đến nơi mình muốn, chắc hẳn sẽ giúp hành trình thuận tiện hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630311,
					"content": "Hai người dẫn đường hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630312,
					"content": "Thật lợi hại... Tôi cứ tưởng cô chỉ nói chơi thôi, không ngờ hoàn thành nhanh như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630313,
					"content": "Tôi còn tưởng sẽ mất chút công sức, vì dù sao mảnh ngọc cũng bị hư hại nặng, linh khí đã sớm tiêu tan hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630314,
					"content": "Nhưng may mắn thay, nơi đây là Trầm Ngọc Cốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630315,
					"content": "Ồ? Trầm Ngọc Cốc thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630316,
					"content": "Cô có biết chúng ta đang ở đâu trong Trầm Ngọc Cốc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630317,
					"content": "Ừm... Bến Tàu Di Lung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630318,
					"content": "Haha, vậy là cô vẫn chưa hiểu hết về nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630319,
					"content": "Mảnh đất dưới chân chúng ta, thực chất là một trong tám nút giao quan trọng của Địa Mạch Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630320,
					"content": "Sinh, tử, hưu, đỗ, khai, cảnh, kinh, thương.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "#{F#Cô}{M#Cậu} có vẻ quen thuộc với nơi này hơn tôi tưởng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630322,
					"content": "Ồ! Tôi cũng nhớ ra rồi, đó là Bát Môn trong Địa Mạch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630323,
					"content": "Đúng vậy, đây chính là khu vực trung tâm của cửa Sinh, cánh cửa cực kỳ may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630324,
					"content": "Cửa Sinh quản lý việc sinh sôi phát triển, vạn vật tái sinh, vì thế tôi mới có thể bổ sung linh khí cho mảnh ngọc trong thời gian ngắn và chế tạo ra cỗ xe này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630325,
					"content": "Chà, hóa ra hiệu quả đến vậy sao? Có vẻ Trầm Ngọc Cốc đúng là một vùng đất phong thủy tốt nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630326,
					"content": "Ừm... Đây mới đúng là nơi mà mọi người nên an cư lạc nghiệp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630327,
					"content": "Mọi người...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630328,
					"content": "Không có gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630329,
					"content": "Thôi được rồi, tôi cũng không còn việc gì khác nữa, hai vị cứ đi làm việc của mình đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630330,
					"content": "Tôi định đi dạo trên núi thêm một lúc, vậy tạm biệt ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630331,
					"content": "Cảm ơn Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "#Không cần khách sáo. {F#Cô}{M#Cậu} đã đánh thức tôi, là tôi nợ {F#cô}{M#cậu} mới đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630333,
					"content": "Chủ yếu là công lao của Zhongli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "Tôi cũng từng nói với anh ấy những lời tương tự rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630335,
					"content": "#Anh ấy còn cho tôi biết, việc {F#cô}{M#cậu} đang trên một hành trình dài...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630336,
					"content": "#Điểm dừng chân tiếp theo của {F#cô}{M#cậu}, chính là vương quốc tuyết xa xôi kia phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630337,
					"content": "Đúng vậy, nơi đó là Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "Snezhnaya... Dù tôi không rõ đó là một quốc gia thế nào, nhưng con đường phủ đầy băng tuyết, hẳn sẽ đầy gian nan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630339,
					"content": "#{NICKNAME}, sau này nếu cần giúp đỡ, {F#cô}{M#cậu} biết tìm tôi ở đâu rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630340,
					"content": "Chắc chắn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
