			"dialogs": [
				{
					"id": 711630201,
					"content": "Zibai có vẻ không có ở đây, không phải cô ấy bảo chúng ta đến đây sao? Chạy đi đâu rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630202,
					"content": "Ơ! Cái ô này trông quen quen... Hình như đã từng thấy nó ở đâu rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630203,
					"content": "Có lẽ là đồ của Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "Tôi cũng nghĩ vậy... Nhưng sao cô ấy lại để ô ở trước cửa nhà trọ thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630205,
					"content": "Trí nhớ của cô ấy không được tốt lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "Phải làm sao đây? Nếu cứ thế này, tôi có cảm giác một ngày nào đó cô ấy sẽ vừa ăn cơm vừa quên mất để đũa ở đâu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630207,
					"content": "Haiz, chúng ta mau đi tìm cô ấy nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630208,
					"content": "Khoan đã... cái này hình như không phải là ô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "Không phải ô thì là gì? Hửm... để tôi xem kỹ nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630210,
					"content": "Ối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7116303,
