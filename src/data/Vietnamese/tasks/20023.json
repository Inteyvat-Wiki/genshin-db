					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "Ông ấy đã uống gần nửa ngày rồi, bạn xem, đây là hóa đơn tiền rượu của ông ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230304,
					"content": "Cứ như thế này, chỉ có cách gọi Eury đến đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230305,
					"content": "Có thể mượn chút không? Cũng được, thế nhưng bạn định làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
