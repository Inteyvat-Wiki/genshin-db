				{
					"id": 200230201,
					"content": "Haha, ta mỗi ngày chỉ 1 ly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230202,
					"content": "Không phải cai rượu rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "Á?! Làm giật mình... Cứ tưởng là vợ của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230204,
					"content": "Thi thoảng uống một chút không vấn đề gì mà, ta đã vất vả làm việc cả một ngày rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230205,
					"content": "Ok Ok, ta uống thêm một chút rồi sẽ về... Eury chắc cũng sắp mua đủ đồ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
