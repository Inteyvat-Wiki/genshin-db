			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "Anh ta cuối cùng có hối cải không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230102,
					"content": "Hối cải gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "Mỗi ngày đều có rất nhiều người đến đây, họ ăn năn sám hối cho tội lỗi của mình và cầu xin sự tha thứ của thần linh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230104,
					"content": "Thế nhưng nếu chỉ là lời nói suông, không được chứng mình bằng hành động, thì đó chẳng phải là việc lãng phí thời gian hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230105,
					"content": "Cũng như ngài Nimrod, từng nhiều lần ăn năn về hành động uống rượu của mình, thế nhưng không chút thay đổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230106,
					"content": "Nếu như bạn có thời gian rảnh, thì giúp tôi đi xem tình hình hiện tại của ông ấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230107,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "À, nếu ông ấy vẫn tiếp tục uống rượu, hãy mang một vài chứng cớ về đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230109,
					"content": "Đối với loại người không biết ăn năn hối cải, thì phải cần những bài \"bài học\" nhớ đời",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230110,
					"content": "Uống rượu cũng tính là \"tội lỗi\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "Uống rượu không phải là \"tội lỗi\", nhưng uống rượu mà khiến người khác chìm trong đau khổ thì đó là \"tội lỗi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230112,
					"content": "Nếu như ai cũng ngông cuồng, thì Thành Mondstadt này sẽ có ngày rơi vào bể khổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230113,
					"content": "Chính vì vậy, phải ngăn chặn những \"tội lỗi\" vừa nảy mầm, bạn hãy mau đi xem tình hình của Nimrod.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
