					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230906,
					"content": "Trước khi có bằng chứng, tôi vẫn luôn tin rằng, con người ta đều vô tội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230907,
					"content": "Thế nhưng... Luôn có đủ thứ chứng cứ, chứng minh \"tội lỗi\" của họ... thật nực cười.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
