			"dialogs": [
				{
					"id": 790290101,
					"content": "Ở đây có một bức tượng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290102,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "Thuyền Trưởng Quạ Đêm"
				},
				{
					"id": 790290103,
					"content": "Xin chào, sao anh lại thở dài trước cửa hang thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290112,
					"content": "Tôi ấy hả, gần đây tôi sống trong hang động này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "Thuyền Trưởng Quạ Đêm"
				},
				{
					"id": 790290113,
					"content": "Sao lại sống trong hang thế này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290114,
					"content": "Tôi cũng hết cách rồi! Ai bảo trên đảo đột nhiên có nhóm diễn viên đoàn kịch đến, ngày nào cũng gióng trống khua chiêng, ồn đến mức chẳng ai ngủ được... Thế nên tôi mới tìm đến đây để yên tĩnh hơn một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "Thuyền Trưởng Quạ Đêm"
				},
				{
					"id": 790290104,
					"content": "Nhưng không biết tại sao lại có một đám Hilichurl từ đâu đến chiếm chỗ nghỉ ngơi của tôi, tôi giờ chỉ có thể đứng bên ngoài hứng gió lạnh thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "Thuyền Trưởng Quạ Đêm"
				},
				{
					"id": 790290105,
					"content": "Haiz... Tôi đã thề với lòng mình rằng, nếu ai đó có thể giúp tôi, tôi sẽ nói với người đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "Thuyền Trưởng Quạ Đêm"
				},
				{
					"id": 790290106,
					"content": "Nói với người đó cái gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290107,
					"content": "Nói cho người giúp tôi biết manh mối để tìm ra kho báu bí mật trong truyền thuyết của hải tặc! Tuy tôi cũng chỉ biết được một phần tư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "Thuyền Trưởng Quạ Đêm"
				},
				{
					"id": 790290108,
					"content": "Một phần tư manh mối sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290109,
					"content": "Xem ra các bạn cũng là người tìm kho báu bí mật, hãy giúp tôi giải quyết đám Hilichurl bên trong, rồi tôi sẽ nói cho bạn biết vị trí manh mối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "Thuyền Trưởng Quạ Đêm"
				},
				{
					"id": 790290110,
					"content": "Nghe nói rằng nếu có được hết bốn phần manh mối thì sẽ có thể tìm thấy kho báu do những hải tặc từng phiêu bạt ở đây để lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "Thuyền Trưởng Quạ Đêm"
				},
				{
					"id": 790290111,
					"content": "Nhất trí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
