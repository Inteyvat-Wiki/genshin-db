			"dialogs": [
				{
					"id": 100070101,
					"content": "...Vậy thì coi như là đã đồng ý rồi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070102,
					"content": "Venti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070103
					]
				},
				{
					"id": 100070103,
					"content": "#Ah, {NICKNAME}, cuối cùng {F#cô}{M#cậu} cũng đến, có ai nhắn gửi gì cho tôi phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070104,
						100070105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070104,
					"content": "Nhắn gửi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				},
				{
					"id": 100070106,
					"content": "\"Không hề thấy bất kỳ lời tiên tri nào về anh trong cuốn từ điển đó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070107,
					"content": "Đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070108,
						100070109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070108,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070110,
					"content": "#Ồ? {NICKNAME}, đợi chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070111,
					"content": "Hmm... Sự khao khát tri thức của Barbeloth vẫn mạnh mẽ như vậy. Tiếc thay, \"tương lai\" của tôi e rằng không thể được ghi vào trong từ điển của cô ấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070112,
					"content": "Dù sao thì, dẫu gió có sẵn lòng để bồ công anh phác họa hình dáng, rồi để những nhà thơ ngợi ca, thì cũng chẳng thực sự muốn dừng chân trên tay ai đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070113,
					"content": "Vì vậy, thưa quý cô Barbeloth, xin hãy đặt bút xuống. Những câu chữ được truyền tụng trong gió không thích hợp để tô viết thành văn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070114,
					"content": "Nếu cô thực sự hứng thú với câu chuyện thần thoại này, xin hãy để tôi chỉnh sửa bài thơ này một chút. Đến buổi tiệc trà lần sau, tôi sẽ ngâm nga cho các quý cô nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070115,
					"content": "Barbeloth? Cô ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070116
					]
				},
				{
					"id": 100070116,
					"content": "Hahaha, Barbeloth vốn là người thấu tình đạt lý, có vẻ như đã nghe được lời thỉnh cầu của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070117,
					"content": "Giờ thì sẽ không còn ai làm phiền cuộc trò chuyện của chúng ta nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070118
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070118,
					"content": "Vừa rồi Barbeloth đã nghe lén sao? Nhưng chúng tôi có thấy gì đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070119,
					"content": "Dù sao thì Barbeloth cũng là thành viên của Hội Ma Nữ mà, lợi hại lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070120,
					"content": "Nhưng anh lại phát hiện ra ngay và còn mời cô ấy rời đi nữa. Này tên hát rong, vậy chẳng phải anh còn lợi hại hơn cả Barbeloth sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070121,
					"content": "Ừm... Xét đến nhiều yếu tố thực tế thì tôi cũng chỉ được coi là lợi hại có giới hạn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070122,
					"content": "Lại cái điệu bộ thần bí này! Nói trước cho anh biết, trong cuốn từ điển của ma nữ đó, chúng tôi chẳng tìm thấy chuyện gì liên quan đến anh cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070123,
						100070124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070123,
					"content": "Chỉ là cô ấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070125,
					"content": "Thế là đủ rồi. Phải nói rằng, lời tiên tri của Barbeloth về tôi tuy không hoàn chỉnh, nhưng cũng không thể nói là sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070126,
					"content": "#Việc mà tôi cần làm, quả thật cần có sự hỗ trợ của {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070127,
						100070128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070127,
					"content": "Có chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070129,
					"content": "Chà, thật đáng tin cậy mà, vậy thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070130,
					"content": "#{NICKNAME}, lát nữa cùng tôi chơi một bản nhạc được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070131,
						100070132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070131,
					"content": "Hả? Được thì cũng được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070133,
					"content": "Đúng vậy, chỉ thế thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070134,
					"content": "Yên tâm, lời mời hòa tấu lần này không phải xuất phát từ áp lực của vận mệnh hay một nhân duyên xa xôi nào đâu... Nó đơn thuần chỉ là vì tình bạn giữa chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070135
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070135,
					"content": "Lần trước, khi tôi tự tay chơi khúc nhạc này, khán giả duy nhất chỉ là những cơn gió điên cuồng gào thét. Chúng cuốn đi giai điệu, chỉ để lại những nốt rời rạc vang vọng sau cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070136,
					"content": "#Giờ đây, đã có một người bạn như {F#cô}{M#cậu}, vậy thì sao phải để ngọn gió ngồi đơn độc nơi khán đài chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070137,
					"content": "#Hơn nữa, có người bạn như {F#cô}{M#cậu} ở bên, có lẽ tay tôi sẽ chơi nhạc một cách ổn định hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070138
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070138,
					"content": "Tôi sẽ diễn tấu thật nghiêm túc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070139
					]
				},
				{
					"id": 100070139,
					"content": "Được, vậy chúng ta đến khu biểu diễn trước nhé. Cứ đi theo gió là sẽ đến ngay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070132,
					"content": "Nhưng mà anh chỉ cần tôi giúp việc này thôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070128,
					"content": "Cứ để tôi lo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070124,
					"content": "Bảo tôi đến đây đợi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070109,
					"content": "Nhưng ma nữ vẫn bảo tôi phải đi tìm anh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070105,
					"content": "Thật ra tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				}
			]
		},
		{
			"id": 1000702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
