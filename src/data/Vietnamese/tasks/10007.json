			"dialogs": [
				{
					"id": 100070701,
					"content": "#Được rồi, dừng ở đây thôi. Thật là một màn hợp tấu tuyệt đẹp, cảm ơn nhé, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
