						100070702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070702,
					"content": "Sức mạnh mà anh vừa dùng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "#Đừng lo. Sức mạnh mà {F#cô}{M#cậu} vừa thấy hoàn toàn xuất phát từ bản thân tôi, không phải từ người khác, cũng không cần mượn bất kỳ vật ngoài thân nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070704,
					"content": "Nếu phải lấy ví dụ thì giống như... lên dây cho một nhạc cụ vậy, để nó có thể chơi được những giai điệu hay hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070705,
					"content": "Ồ, quả nhiên là giấu nghề! Khoan đã, đừng nói là anh còn giấu nhiều nghề hơn nữa nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070706,
					"content": "Haiz, Paimon à... Tôi thực sự chỉ có bấy nhiêu thôi, cứ tin tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070707,
					"content": "Đúng là tên hát rong mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070708,
					"content": "Hahahaha, hôm nay có vẻ gió sẽ rất lớn đấy. Chúng ta mau quay về Thành Mondstadt nhắc nhở mọi người cất quần áo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
