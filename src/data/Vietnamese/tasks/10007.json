			},
			"dialogs": [
				{
					"id": 100071101,
					"content": "Lúc trước tôi cũng từng nói rồi, tôi đã tình cờ gặp \"Thời Gian\" tại Thiên Phong Thần Điện và nhận được sự trợ giúp, còn nhớ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071102,
					"content": "Chính vì có sự trợ giúp của Thời Gian, nên ngọn gió tự do ban sơ ấy mới có thể bùng lên mạnh mẽ đến vậy.",
					"roleType": "TALK_ROLE_NPC",
