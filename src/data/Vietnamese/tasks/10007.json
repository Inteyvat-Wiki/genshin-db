			"dialogs": [
				{
					"id": 100070401,
					"content": "Hòn đảo này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "Có gì đặc biệt sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "Bản thân hòn đảo này không có gì đặc biệt cả. Nó cũng giống như các hòn đảo khác, chỉ là một tập hợp của cát và đá thông thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070404,
					"content": "Cho đến khi gió mang theo hạt giống của câu chuyện, và thời gian đã khiến nó nảy mầm trên hòn đảo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070405,
					"content": "Sau đó, gió mang đến những câu chuyện mới, thời gian khiến nó trở thành thần thoại bên ngoài hòn đảo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070406,
					"content": "#{NICKNAME}, chào mừng {F#cô}{M#cậu} đã đặt chân đến hòn đảo nhỏ được \"thời gian\" ưu ái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070407,
					"content": "Trong quá khứ xa xôi, thời gian và gió đã từng giao thoa tại nơi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070408,
					"content": "Khoan đã, tên hát rong... Sao bỗng dưng anh nghiêm túc thế? Nói năng cũng khó hiểu quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070409,
					"content": "Ấy, đừng vội vàng thế Paimon, một câu chuyện hay luôn phải có mở đầu cao trào và giữ lại chút huyền bí thấp thỏm chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
