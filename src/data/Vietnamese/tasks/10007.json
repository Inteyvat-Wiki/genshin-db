					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000712,
			"completionStepIds": [
				1000703
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071201,
					"content": "Tuy nhiên, ngọn gió mãnh liệt chỉ thích hợp để quét sạch căn nhà, chứ không phải để vun đắp cho vạn vật sinh sôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071202,
					"content": "Sau khi xử lý một vài cuộc khủng hoảng cho Thành Mondstadt, tôi đã khiến ngọn gió dịu nhẹ hơn chút, đủ để thổi bùng lòng can đảm của người dân Mondstadt, nhưng không đến mức khiến họ phải chao đảo trong gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071203,
						100071204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071203,
					"content": "Vậy lần này anh đến...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				},
				{
					"id": 100071205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071206,
					"content": "#Bóng tối đang dần hội tụ ở phương xa. Hẳn là {F#cô}{M#cậu} cũng cảm nhận được điều đó rồi, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071207,
					"content": "Hỏa Thần đối đầu trực diện với Chấp Chính Của Cái Chết, Ronova... Tôi cũng đã nghe được chuyện về Quan Chấp Hành Capitano của Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071208,
					"content": "Hơn nữa, phạm vi hoạt động của Vực Sâu đã tiến đến gần Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071209,
					"content": "Nguy cơ sắp đến này, có lẽ không phải là thứ sức người có thể ngăn cản... Tôi cũng phải chuẩn bị trước một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071210,
					"content": "Khi cần thiết, với tư cách là Barbatos, Phong Thần của Thành Mondstadt, tôi sẽ dựng lên những cơn gió đủ sức thổi tan mọi màn sương u ám cho Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071211,
					"content": "Tuy nhiên, nếu tôi bất ngờ gây ra cuồng phong trong Thành Mondstadt, e rằng sẽ thổi bay quần áo, mũ nón của mọi người, và cả những chậu hoa trên ban công nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071212,
					"content": "Vì vậy, lần này tôi đã chọn hòn đảo này làm \"vùng đất nổi gió\". Tại đây, tôi đã từng ngân vang khúc ca dâng tặng Thời Gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071213,
					"content": "Có lẽ vì giai điệu tôi chơi quá hay, nên hòn đảo nhỏ này dường như được Thời Gian đặc biệt ưu ái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071214,
					"content": "Thật sao? Hòn đảo này đặc biệt đến vậy à? Nhưng lúc trước chúng tôi nhìn thấy nó thì lại thấy chẳng có gì đặc biệt cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071215,
					"content": "Có lúc thì bị nước thủy triều dâng lên nhấn chìm, có lúc thì có nhiều chim đậu... Nhìn thế nào cũng thấy rất bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071216,
					"content": "Ảnh hưởng của Thời Gian đến vạn vật không chỉ dừng lại ở vẻ bề ngoài. Ừm... Giống như Quả Nhật Lạc đã chín mọng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071217,
					"content": "Khi phần vỏ ngoài còn nguyên vẹn, nếu không phải chuyên gia thì hầu như không thể biết được phần quả bên trong đã chín nẫu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071218,
					"content": "Tuy nhiên, nếu chọc một lỗ trên vỏ của nó, Quả Nhật Lạc đã quá chín này sẽ bắt đầu thối rữa nhanh chóng thông qua lỗ thủng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071219,
					"content": "Dưới bàn tay của Thời Gian, \"vỏ ngoài\" của hòn đảo này không có bất kỳ lỗ thủng nào, không ai có thể nhận ra ảnh hưởng của Thời Gian lên bản chất của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071220,
					"content": "Nhưng xét về bản chất, bất kỳ dấu vết nào không được Thời Gian ưa thích cũng đều sẽ bị xóa nhòa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071221,
					"content": "Vì vậy, tôi sẽ mượn sức mạnh còn sót lại ở nơi này, dùng Thời Gian để vạch ra giới hạn cho ngọn gió.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071222,
					"content": "Như vậy, cho dù tôi có gây ra những cơn gió mạnh đến đâu trên hòn đảo này, thì thế giới bên ngoài cũng sẽ không hề hay biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071223
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071223,
					"content": "#Đương nhiên, khi nhờ người khác giúp đỡ thì phải chuẩn bị quà cảm ơn. {NICKNAME}, chúng ta hãy cùng hòa tấu một bản nhạc để dâng tặng Thời Gian nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071224
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071224,
					"content": "#{NICKNAME}, khi nào sẵn sàng hòa tấu thì bảo tôi nhé. Nếu không có nhạc cụ thì tôi sẽ cho mượn một cái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071204,
					"content": "Là muốn làm gì...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				}
			]
		},
