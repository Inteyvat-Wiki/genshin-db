	"talks": [
		{
			"id": 7211001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "Tại sao tôi lại rời khỏi đạo quán và trở thành người hướng dẫn Kujou đại nhân nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100102,
					"content": "Yanagiha và Okazaki, cả Mifune nữa...Tại sao lại rời bỏ tôi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "...Bây giờ, chỉ còn thiếu thanh kiếm của Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "Nó có phải là tổ tiên \"Hakuen Michimitsu Amenoma\" của gia đình Iwakura? Khi bạn và Kuhihiko lần đầu được nhận nuôi, đã nhân lúc người tiền nhiệm Nagatane không chú ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "Chúng tôi đã phá cửa rồi. Không cần gọi đại nhân nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "Nhưng mà, Okazaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "\"Đem \"Tình\" và \"Nghĩa\" đặt lên bàn cân, một kiếm sĩ thực thụ chỉ có thể đi trên con đường của chính nghĩa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Sư phụ nói như vậy, có nghĩa là người bất đắc dĩ phải trục xuất chúng ta khỏi sư môn, nhưng lại không có lựa chọn nào khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "Dĩ nhiên là không muốn rồi. Nhưng vì người đã quyết định trở thành lưỡi đao của Shogun và thực hiện lệnh truy lùng Vision, nên chúng ta chỉ có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "Chúng ta chỉ có thể lựa chọn đạo nghĩa của chính mình. Dù sao thì \"Một kiếm khách chân chính chỉ có\" chính nghĩa \"để đi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "Tuy nhiên, đạo nghĩa của sư phụ đã bị đánh bại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "Đúng vậy. Không chỉ là mối thù của Kunihiko, mà còn bao người khác, bao gồm cả Iwakura Kouin, chúng ta phải báo thù cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Đây là đạo lý của đệ tử Iwakura phái chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "Đây cũng là sự bảo hộ của sư phụ. Kẻ thù đầu tiên đã tự dâng đến cửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#Phải rồi, bạn là {NICKNAME} phải không. Tôi đã được nghe rất nhiều câu chuyện về bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "Trong thế giới kiếm sĩ nợ máu phải trả bằng \"máu\". Để sẵn sàng đối mặt với \"Menkyo Kaiden\" của trường phái Iwakura, bạn đã sẵn sàng rồi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
