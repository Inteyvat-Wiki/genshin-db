					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "Tại sao tôi lại rời khỏi đạo quán và trở thành người hướng dẫn Kujou đại nhân nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100302,
					"content": "Yanagiha và Okazaki, cả Mifune nữa...Tại sao lại rời bỏ tôi nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100303,
					"content": "Tôi đã gặp qua đệ tử của Trường Phái Iwakura rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "Vậy sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100305,
					"content": "Bây giờ vẫn còn có người tự nhận mình là Trường Phái Iwakura sao. Tông chủ rõ ràng là một kẻ tầm thường như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100306,
					"content": "Tôi là Iwakura Kouzou, và sẽ đảm nhận việc hướng dẫn kiếm đạo trong thời gian này. Các hạ là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100307,
					"content": "#Tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tanba...Bạn đã từng gặp họ chưa? Còn có người anh em Okazaki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100309,
					"content": "Và đây là Katayama. Anh ấy thích đặt tên cho mỗi trận đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100310,
					"content": "Bởi vì, \"Nếu tôi trở thành một kiếm khách thực sự trong tương lai, thì những trận quyết đầu này đều có thể viết thành truyện.\" Hahaha, thật là vớ vẩn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100311,
					"content": "Đúng rồi, còn có Shimada, người từ thời đại Nagatane đến thời đại Kouin, vẫn không thể đột phá Shoden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100312,
					"content": "Họ phải chạy trốn vì không thể hiểu được sự uy nghiêm của Shogun khi ban hành lệnh \"Truy Lùng Vision\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100313,
					"content": "Những năm tháng chỉ dạy họ cầm đao và múa kiếm thật là hoài niệm. Tại sao tôi đóng đạo quán và gia nhập quân đội ấy hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, bản lĩnh của họ như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100315,
					"content": "Đáng tiếc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100318,
					"content": "#Vậy {NICKNAME}, ai là sư phụ của các hạ? Là Domon? Hay Shousen? Lẽ nào là đích thân Narukami truyền dạy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100319,
					"content": "Có thể xem là \"phái của riêng tôi\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Thì ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100321,
					"content": "Có vẻ như Trường Phái Iwakura đã suy tàn dưới bàn tay của tôi. Những đệ tử đích thân tôi dạy dỗ lại không thể đánh bại một tiểu tử không có sự phụ dìu dắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "Vậy sao, tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100324,
					"content": "Bất kể bạn thuộc phái gì, cũng không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100325,
					"content": "Có vẻ như Trường Phái Iwakura đã suy tàn dưới bàn tay của tôi. Những đệ tử tôi đích thân dạy dỗ lại không thể đánh bại một người không muốn báo tên gia tộc của mình.",
					"roleType": "TALK_ROLE_NPC",
