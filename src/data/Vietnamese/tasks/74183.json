				"objectNames": [
					"Ngài Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "Tóm lại, ác long Scylla là bạn của Sebastos, nhưng hắn đã nổi loạn vào thời khắc then chốt trong cuộc chiến của người Remuria và... người Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832302,
					"content": "Khi đó, ác long dẫn theo hậu duệ của mình hành quân thẳng đến Machimos, đồng thời có ý đồ tấn công vào nội thành Capitolium của Sebastos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832303,
					"content": "Machimos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "Ừm, lúc ở trong thị trấn thì những người dân tại đó cứ nhắc đến Machimos và cả tháp chuông gì đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832306,
					"content": "Đúng vậy, Machimos là bên ngoài của vương thành, nhưng ác long nếu muốn vào nội thành thì phải đi qua Initium Iani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832307,
					"content": "Đó là nơi ngăn cách trong và ngoài vương thành, bản nhạc được dệt nên bởi Sebastos và các nhạc sĩ, cũng được đưa đến toàn bộ Remuria bằng đường thủy hoàng kim thông qua Initium Iani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832308,
					"content": "Boethius và quân đoàn của hắn đã lợi dụng điều này để cố gắng đóng Initium Iani lại, nên mới phong ấn được ác long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832309,
					"content": "Có lẽ Scylla muốn đến trước mặt Sebastos, nhưng đã không còn cơ hội như thế nữa. Sau đó, cả ác long cùng Remuria đều chìm xuống nước sâu, Sebastos cũng không rõ tung tích cho đến tận ngày nay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832310,
					"content": "(Hình như có gì đó không đúng...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#{NICKNAME} lại nhớ ra gì rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832314,
					"content": "Cảm thấy hơi hỗn loạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "Ừm... Những chuyện này tôi cũng chỉ nghe được sau này thôi. Dù sao thì tôi cũng không ở trong vương thành khi thảm họa xảy ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832316,
					"content": "Khi đó, không ai biết bên cạnh Sebastos đã xảy ra chuyện gì, e rằng chỉ có tiến về phía trước mới có thể tìm thêm được nhiều manh mối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832317,
					"content": "Con cá lớn phát sáng mà chúng ta đã thấy trong lâu đài, có lẽ là những suy nghĩ của Scylla rò rỉ ra từ vết nứt trên ngục tù bằng đá đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832318,
					"content": "E rằng hắn đã sớm để ý đến chúng ta rồi. Bị phong ấn ở đây lâu như vậy, khó khăn lắm mới có người từ bên ngoài đến, tất nhiên phải tìm cách để thu hút sự chú ý của chúng ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832319,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832320,
					"content": "Khoan đã, anh nói muốn đến Domus Aurea thì phải đi qua cánh cổng lớn gì đó, nhưng cánh cổng đó đã bị Boethius đóng lại rồi mà nhỉ? Vậy chẳng phải là không thể đi được à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832321,
					"content": "Đây đúng là một vấn đề nan giải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832322,
					"content": "Chậc, bất lịch sự quả nhiên là bất lịch sự. Giả bộ nói là \"đợi ngươi ở Domus Aurea\"... Nhưng đến cánh cửa cũng không để lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832323,
					"content": "Theo tôi thấy thì chúng ta nên giải trừ phong ấn cho ác long, để bại tướng năm xưa của hắn phá cổng đi vào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832324,
					"content": "Vậy cũng được sao?! Dù sao thì đó cũng là kẻ thù của Remuria mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832325,
						741832326
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832325,
					"content": "Kẻ thù của kẻ thù chính là bạn bè!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832327,
					"content": "Đúng vậy. Hơn nữa đã lâu như vậy rồi, nói không chừng hắn ta sẽ thay đổi suy nghĩ, trở thành một con rồng tốt thì sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832328,
					"content": "Nhưng đó dù sao cũng là rồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832329
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832329,
					"content": "#Gì chứ, cho dù là rồng, nhưng chưa biết chừng lại hiểu lý lẽ đấy. Chúng tôi cũng có kinh nghiệm nói chuyện với rồng mà. Đúng chứ {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832326,
					"content": "Nhưng Remuria từ lâu đã không còn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832311,
					"content": "(Trong giấc mơ trước đó...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832312,
					"content": "(Scylla chắc đã từng đến gặp Remus...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832304,
					"content": "Tôi có nghe qua cái tên này từ người dân trong thị trấn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				}
			]
		},
