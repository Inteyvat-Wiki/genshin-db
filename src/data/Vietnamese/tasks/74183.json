				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "Kể ra thì, không phải Neuvillette cũng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "Đúng nhỉ, Neuvillette là Thủy Long mà nhỉ? Vậy thì tính ra không lẽ tên này còn lớn tuổi hơn cả Neuvillette sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832203,
					"content": "Đã có Thủy Long mới được sinh ra rồi sao? Cũng đúng, dù sao thì chủ nhân của muôn dòng nước trước đây cũng đã qua đời từ lâu rồi... Đã quá lâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ngài Os"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
