						741832803
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832803,
					"content": "Dù có nhìn chúng tôi bằng ánh mắt nghi ngờ như vậy thì bây giờ cũng không còn cách nào khác tốt hơn và nhanh hơn nữa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832804,
					"content": "Haiz, nói cũng đúng. Vậy thì thử xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832805
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741832805,
					"content": "Phong ấn trói buộc ác long hình như liên kết với ba nơi. Chúng ta bắt đầu từ việc mở khóa xiềng xích ở ba nơi trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ngài Os"
				}
			]
