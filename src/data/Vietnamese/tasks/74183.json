			},
			"dialogs": [
				{
					"id": 741830401,
					"content": "Woa... Rất giống với con cá phát sáng kỳ lạ mà chúng ta đã từng thấy trước đây nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830402,
					"content": "Xung quanh có những thứ kỳ quái quấn quanh... Rốt cuộc đã xảy ra chuyện gì vậy? Càng ngày càng khó hiểu rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830403,
					"content": "Âm thanh này, trước đây trong mơ cũng từng nghe thấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "#Ừm, {F#cô}{M#cậu} chắc đã gặp được hắn ta trong ký ức của Sebastos rồi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830406,
					"content": "Scylla, từng là ác long phục tùng Sebastos. Hắn ta bị Boethius trấn áp và phong ấn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830407,
					"content": "Hả!? Trấn áp ác long? Không ngờ là tên thô lỗ đó lại có thể làm được chuyện lợi hại như vậy đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830408,
					"content": "Tuy nói là ác long, nhưng thực ra cũng chỉ là một con rồng đất mạnh mẽ hơn chút mà thôi. Suy cho cùng thì khi chủ nhân của muôn dòng nước còn ẩn cư dưới biển sâu, thì sẽ không có Thủy Long mới được sinh ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830404,
					"content": "Nhưng tên thì tôi không nhớ nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scylla",
					"Ngài Os"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "Ahhh! Dòng hải lưu thật ấm áp! Ta cuối cùng cũng được tự do rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830602,
					"content": "Những tên nhỏ bé, các ngươi từ trên mặt đất đến đây sao? Tuy rằng ta không biết các ngươi tới hầm ngục dưới biển sâu vì lý do gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830603,
					"content": "Chúng tôi không phải những tên nhỏ bé gì cả nhé, chỉ là ông quá to xác mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830604,
					"content": "Haha, được! Dù sao thì các ngươi cũng đã giải trừ xiềng xích trói buộc ta cả ngàn năm nay, cũng xem như có ơn với ta rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830605,
					"content": "Nếu có việc gì ta có thể giúp được thì cứ nói, đó xem như là quà cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830606,
					"content": "#Hihi, tôi biết ngay ông là một gã to xác thấu hiểu lý lẽ mà! À, tôi là Paimon, đây là {NICKNAME}, còn kia là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830607,
					"content": "Ừm... Tôi cũng không biết ông quen thuộc với cái tên nào của anh ấy hơn, nhưng chúng tôi gọi anh ấy là Ngài Os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830608,
					"content": "À, Cassiodor, là cậu sao. Lâu rồi không gặp, không ngờ cậu lại trở về, nhưng đã quá trễ rồi... Trễ tận cả ngàn năm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830609,
					"content": "Ồ! Xem ra ông rất quen Ngài Os nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830610,
					"content": "Ta không có lời gì để nói với kẻ phản bội vô sỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830611,
					"content": "Cẩn thận lời nói đấy, người phàm! Khác với dòng tộc tự cao tự đại như các ngươi, hậu duệ tộc rồng bọn ta tuân thủ lời hứa và tuyệt đối không phản bội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830612,
					"content": "Giá trị của lời nói này còn mỏng manh hơn cả phù du trong nước. Chuyện ngươi phản bội là không thể chối cãi. Cũng chính vì sự phản bội của ngươi mà bọn ta mới thua trận chiến đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830613,
					"content": "Nếu không vì bọn ta đã thua trận chiến đó... Mất đi quốc gia thì Sebastos sẽ không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830614,
					"content": "Cậu đã rời đi quá lâu rồi, Cassiodor! Sự thật không phải như cậu tưởng tượng. Nhưng cũng khó trách, vốn dĩ là kế hoạch bí mật thì sao những chi tiết đó lại lọt vào tai cậu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830615,
					"content": "...Kế hoạch bí mật?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830616,
					"content": "Để ta dẫn đội quân rồng đất tấn công vào vương thành, chính là một phần trong kế hoạch bí mật cuối cùng của Remus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830617,
					"content": "Tất cả những chuyện này đều vì muốn cứu quốc gia và người dân của mình. Quả đúng là một người có khí phách vĩ đại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830618,
					"content": "Nghe có vẻ hơi khó tin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "Quá kỳ lạ rồi đó! Tại sao vị vua của một quốc gia lại bảo kẻ khác tấn công vào quốc gia mình chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830621,
					"content": "Thứ nhỏ bé, suy nghĩ của Remus thì sao ngươi và ta có thể đoán được chứ? Dù sao đi nữa thì cứ nhìn thứ này đi, Cassiodor. Cho dù là cậu thì cũng sẽ hiểu được hàm ý trong đó thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830623,
					"content": "Là ong vàng... Ong vàng dẫn đường vận mệnh chỉ nghe theo lời triệu hồi của bản nhạc, tại sao Sebastos lại mang sức mạnh này giao cho tộc rồng hoang dã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830624,
					"content": "Vì họ đã từng có giao ước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "Ồ? Ngươi biết được không ít đấy! Ngươi tìm được thông tin này từ đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830626,
					"content": "Từ trong những ký ức rải rác dưới đáy biển...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "Không sai. Đúng là giữa hai ta có hẹn ước, nhưng ta đã phụ lòng người đó, phụ sự hy sinh cao quý của người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830628,
					"content": "Ta không kịp đến Domus Aurea! Thế là những con sóng cuồn cuộn đã nuốt chửng cả thành phố, còn hậu duệ của ta cũng không thể thoát khỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830629,
					"content": "Sao lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830630,
					"content": "Hừ, nói đến phản bội, thì Boethius mới là kẻ phản bội thật sự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830631,
					"content": "Nếu không phải tên quái vật dối trá đó dùng những lời ngọt ngào để lừa gạt bọn ta, thì làm sao mà một thân vương thống lĩnh hậu duệ tộc rồng của loài rồng cổ xưa lại có thể bị đánh bại dễ dàng như vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830632,
					"content": "Đầu tiên tên quái vật đó nói dối rằng mình đã nghe theo mệnh lệnh của Remus, đã ra lệnh cho đội quân từ bỏ quyền phản kháng. Khi bọn ta đến nơi này thì hắn lại đột nhiên ra tay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830633,
					"content": "Bây giờ nghĩ lại thì, e rằng hắn đã biết trước kế hoạch của Remus, vì vậy mới có thể từng bước dụ dỗ ta, và dựng lên một kế hoạch tỉ mỉ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830634,
					"content": "Thế là máu thịt của ta hóa thành nham thạch, cho đến hôm nay của ngàn năm sau lại được các ngươi cứu giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830635,
					"content": "Boethius biết rõ hành động của hắn sẽ dẫn đến một thảm họa to lớn, nhưng hắn vẫn... Chẳng lẽ vì muốn cướp lấy quyền kiểm soát Phobos nên mới gây ra tội ác như vậy sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830636,
					"content": "Cảm giác như vẫn chưa hiểu được hết toàn bộ sự việc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "Vậy thì tên đó nói người khác là kẻ phản bội, trong khi chính bản thân mới là kẻ phản bội sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830638,
					"content": "Nhưng tại sao hắn lại làm vậy? Chẳng lẽ chỉ có thể đi tìm hắn để hỏi cho rõ sao? Tôi cứ cảm thấy hắn sẽ không ngoan ngoãn khai hết ra đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830639,
					"content": "Ồ? Tên quái vật cố chấp vô sỉ đó vẫn chưa tan biến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830640,
					"content": "Đúng vậy! Hơn nữa hắn còn cướp đi linh hồn của rất nhiều người dân Fontaine! Chúng tôi đến đây chính là để giải cứu những người này đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830641,
					"content": "Hắn nói hắn sẽ đợi chúng tôi ở Domus Aurea... À không đúng, hắn chỉ nói là đợi Ngài Os, còn chúng tôi là những người không được mời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830699,
					"content": "Cả cửa cũng không để lại, quả là một tên bất lịch sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830642,
					"content": "Initium Iani sao...? Hừ, tuy đã dùng ảo ảnh che mắt, nhưng đó chẳng qua chỉ là cánh cổng đá ra vẻ huyền bí mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830643,
					"content": "Cho dù ta đã mất đi cơ thể, nhưng để đưa các ngươi qua đó thì vẫn là chuyện dễ như trở bàn tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830648,
					"content": "Những kẻ bé nhỏ, hãy chiêm ngưỡng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830644,
					"content": "Ồ! Ông thật đáng tin cậy đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830649,
					"content": "Tiếp theo chỉ cần phá vỡ những phong ấn này là được. Chuẩn bị xong thì chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830645,
					"content": "Ngài Os đã chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830646,
					"content": "Chuyện tới nước này thì cũng chỉ còn cách tiến về phía trước thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "Ngài Os"
				},
				{
					"id": 741830647,
					"content": "#À, còn {NICKNAME} thì sao? Đã chuẩn bị xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830619,
					"content": "Ông ta cũng điên rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
