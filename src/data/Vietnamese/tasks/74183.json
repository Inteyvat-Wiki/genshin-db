			"dialogs": [
				{
					"id": 741832101,
					"content": "Không ngờ rồng đất lại có thể to lớn như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "Hừ, dù gì cũng là chủng tộc thiếu giáo dục, sinh trưởng một cách hoang dã. Dù có trông kỳ lạ hơn nữa cũng không có gì bất ngờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ngài Os"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
