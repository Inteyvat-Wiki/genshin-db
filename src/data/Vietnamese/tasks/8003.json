			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "Chính là cái này sao? Được, dùng góc nhìn nguyên tố xem thử xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030302,
					"content": "Này này...Thế nào, có phát hiện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030303,
					"content": "Sao? Bạn nói không có gì xảy ra? Tôi còn trông đợi như vậy mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030304,
					"content": "Sao thế được, có phải đã nhầm lẫn gì rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030305,
					"content": "Là phương pháp có vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030306,
					"content": "Dùng góc nhìn nguyên tố với \"máy cày\" là không thể, bởi vì nguồn năng lượng khởi động nó vốn không phải là \"nguyên tố\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030307,
					"content": "Hãy giao cho tôi, tôi thử xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030308,
					"content": "...Được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030309,
					"content": "Wa, đây chính là...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030310,
					"content": "Thứ mấu chốt mà Sứ Đồ Vực Sâu vẫn luôn tìm kiếm, \"con mắt của máy cày đầu tiên của thế giới\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030311,
					"content": "Tất cả các thủ vệ di tích còn lại, đều là hàng nhái của chiếc máy này. Là một chiếc \"máy nguyên bản\", sức mạnh chiến đấu của nó sẽ không bị khống chế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030312,
					"content": "\"Máy nguyên bản\"...một từ khó hiểu, là thuật ngữ của người Khaenri'ah sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030313,
					"content": "Giống như Giáo Đoàn Vực Sâu đã nghĩ, nếu như có thể đặt \"mắt\" lên tay \"Tượng Thần Ô Uế\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030314,
					"content": "Dùng đây làm nền tảng, tích hợp với cơ thể \"Ma Thần\" Osial, chế tạo ra Ma Thần Cơ Khí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030315,
					"content": "Vậy là có thể sinh ra một Ma Thần Ô Uế mới, ban sức mạnh \"lay chuyển thần tọa trên Đảo Thiên Không\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030316,
					"content": "Hành vi cực đoan và nguy hiểm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030319,
					"content": "Vậy vậy vậy, \"mắt\" này phải xử lý như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030320,
					"content": "Tìm một nơi bí mật để cất giấu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "Không. Để tôi cất giữ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030323,
					"content": "Hừm?! Bạn? Dainsleif...Bạn sẽ không dùng nó làm những chuyện kỳ lạ chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030324,
					"content": "Bạn cứ thoải mái nghi ngờ lập trường của tôi đi, nhưng tôi bắt buộc phải đảm bảo không để người khác lợi dụng sức mạnh của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030325,
					"content": "Vùng đất bí ẩn bị khai quật, và giáo hội...trong mắt ta không đáng tin cậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030326,
					"content": "Chà...ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030327,
					"content": "Không chỉ như vậy, để tránh hậu hoạn, chúng ta phải \"xử lý\" \"Tượng Thần Ô Uế\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030328,
					"content": "Xử lý như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "Không thể để giáo hội nhúng tay vào, chúng ta phải tự xử lý. Ý của ta \"xử lý\"...có nghĩa là tiêu hủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030331,
					"content": "Tiêu..tiêu hủy? Đó là Thất Thiên Thần Tượng đó! Không chỉ là văn vật có ý nghĩa, mà nó thực sự là...của thần linh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030332,
					"content": "May mà trước đây đã giấu Barbara, nếu không cô ấy sẽ phát điên mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030333,
					"content": "Hơ...vật của Thất Thần, chẳng lẽ còn muốn tôi thay họ yêu quý và bảo vệ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030334,
					"content": "Đi thôi, quay lại <color=#00E1FFFF>di tích đó</color>. Chúng ta đi phá hủy tượng Thần đó, hơn nữa, nếu may mắn thì còn gặp được \"Sứ Đồ Vực Sâu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030335,
					"content": "Có tôi ở đây, nó sẽ không thể biến mất trước mặt bạn một lần nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030329,
					"content": "Có thể giao cho giáo hội làm không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "Hãy giao cho tôi cất giữ đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "Nhất định phải ngăn cản Giáo Đoàn Vực Sâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
