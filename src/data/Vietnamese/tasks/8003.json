			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "Này, Dainsleif ở đây. Bạn có gặp đội trưởng Jean không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030102,
					"content": "Tôi có thấy cô ấy, nhưng đã cố tình tránh mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030103,
					"content": "Cô ấy là \"Kỵ Sĩ Nanh Sư Tử\", lại là Đội Trưởng Đại Diện, ắt hẳn sẽ đề phòng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030104,
					"content": "Nếu tôi không cẩn thận, rồi sẽ có ngày trở thành đối tượng điều tra của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030105,
					"content": "Quay lại vấn đề chính, tôi chỉ giải quyết được một số ma vật, không tìm được tình báo gì. Bên các bạn thì sao, có thu hoạch không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030106,
					"content": "Hóa ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030107,
					"content": "Vậy thì, đại khái đã có đủ thông tin về động thái của \"máy cày đầu tiên của thế giới\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030108,
					"content": "Ừm? Thật sao? Chỉ dựa vào lời nói của \"Vua Sói\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030109,
					"content": "Không phải chỉ dựa vào thông tin này, mà là tổng hợp các suy đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030110,
					"content": "Ví dụ, trước đây các bạn đã nói với tôi, về \"chuyện cũ\" mà giáo hội truyền bá đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030111,
					"content": "\"Oán hận của bạo quân\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "Đúng vậy. Chính là chuyện mà tu nữ bạn nói đã nhắc đến, chuyện kỳ lạ đã từng bị hiểu nhầm là oán hận của bạo quân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030113,
					"content": "Nếu như cầu lửa trên trời rơi xuống đúng là đạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "A, tôi hiểu rồi! Cho nên \"oán hận của bạo quân\", thực ra chính là cỗ máy chạy ra từ Lang Lãnh, tự động bắn đạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030116,
					"content": "Từ sau khi nó bị hư hỏng trong \"thử thách của sói\", đã di chuyển đến phế tích \"Mondstadt cũ\", và ở lại đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030117,
					"content": "Chỉ cần có người đến gần, là sẽ đùng đùng đùng...bắn liên tục. Mãi cho đến một ngày nó thực sự hư hỏng, nên cầu lửa cũng không còn rơi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030118,
					"content": "Những người Mondstadt lúc đó hầu như rất ít người từng tiếp xúc với \"Thủ Vệ Di Tích\", cho nên chỉ có thể lý giải là \"oán hận của bạo quân\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030119,
					"content": "Xem ra, chúng ta nên đến nơi được gọi là <color=#00E1FFFF>Phế Tích Phong Long</color>, bắt đầu điều tra cuốn chiếu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030120,
					"content": "Không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "Sao? Ý của bạn là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030123,
					"content": "Tôi đã...có sẵn \"ký ức\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "Ồ...Ý bạn là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030125,
					"content": "À! Tôi cũng hiểu rồi! Đúng vậy đúng vậy, <color=#00E1FFFF>\"thủ vệ ngồi trên tháp cao\"</color> đó, đúng là khiến cho người ta có ấn tượng sâu sắc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030121,
					"content": "Không cần nữa. Không cần đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "Lúc đó người Mondstadt không nghĩ ra được cầu lửa là gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "Thực ra Barbara là mục sư tế lễ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
