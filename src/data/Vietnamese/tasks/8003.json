			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030601,
					"content": "Họ đi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030602,
					"content": "#Này...{NICKNAME}, đừng quá đau lòng như vậy...Chúng ta sẽ tìm thấy họ mà! Hãy nghĩ theo hướng tích cực nào! Lần này chí ít đã tìm thấy manh mối rất hữu ích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030603,
					"content": "Tôi...không đau lòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "Ừm? Thật sao?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030607,
					"content": "Tóm lại, theo tình hình trước mắt mà nói, điểm mấu chốt để tìm người thân, ngoài Thất Thần ra, thì bây giờ lại thêm \"Dainsleif\" đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030608,
					"content": "Chúng ta đến Inazuma cũng phải chú ý hơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "Không sai. Đúng rồi, những gì họ nói lúc nãy thật khó hiểu, bạn có hiểu được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030611,
					"content": "Đại khái đã hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "Ừm...Vậy chúng ta hãy sắp xếp lại xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030614,
					"content": "#Đầu tiên là Sứ Đồ Vực Sâu đó, hắn gọi {M#em gái}{F#anh trai} của bạn là {M#công chúa}{F#hoàng tử} điện hạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030615,
					"content": "#Xem ra {M#em gái}{F#anh trai} của bạn đang thống lĩnh Giáo Đoàn Vực Sâu, mà địa vị còn cao hơn Sứ Đồ Vực Sâu...Tuy rằng không biết có phải người thống trị cao nhất hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030616,
					"content": "#Còn nữa, {M#em gái}{F#anh trai} của bạn nói mục tiêu của {M#em ấy}{F#anh ấy} là \"nhấn chìm thần tọa, chiến đấu với Thiên Lý\". Như vậy là có ý gì? Nghe như...có phải muốn hủy diệt bảy quốc gia của bảy vị Thần không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030617,
					"content": "Rồi còn, quái vật Giáo Đoàn Vực Sâu, chính là dân chúng của vương quốc Khaenri'ah đã diệt vong...đã biến thành quái vật. Đây đúng là một câu chuyện đáng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030618,
					"content": "Dainsleif cũng là người Khaenri'ah, 500 năm trước cũng đã trải qua mọi việc. Nhưng anh ấy không biến thành quái vật, mà hiện tại sau 500 năm, đang đối đầu với Giáo Đoàn Vực Sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030619,
					"content": "#Cũng có nghĩa là, {M#em gái}{F#anh trai} của bạn nói rằng, \"Dain đang đối địch với {M#em ấy}{F#anh ấy}\" phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030620,
					"content": "Nhưng, nếu như quái vật của Giáo Đoàn Vực Sâu, là dân chúng mà Dainsleif bảo vệ vào năm xưa, vậy tại sao Dainsleif lại phải đối địch với Giáo Đoàn Vực Sâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030621,
					"content": "Ngoài ra, tại sao...người thân mà tôi đã cùng bạn tìm kiếm bấy lâu, nay lại đang ở cùng với quái vật của Giáo Đoàn Vực Sâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030622,
					"content": "Thông tin vẫn chưa nhiều lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Ừm, đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030625,
					"content": "#Vậy...{NICKNAME}, hãy phấn chấn lên nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030626,
					"content": "Chuyến du hành của chúng ta sẽ không kết thúc, đã đến lúc phải tiếp tục rồi! Rời khỏi nơi đáng ghét này, hãy lên mặt đất có ánh mặt trời chiếu rọi đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030627,
					"content": "#Nếu {M#em gái}{F#anh trai} của bạn muốn bạn \"đến đích\"... Được, vậy bạn hãy đến đích cho {M#em gái}{F#anh trai} của bạn xem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030628,
					"content": "\"Nhà Lữ Hành\", chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030623,
					"content": "Có nghĩ thêm cũng không có ý nghĩa gì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#Mọi sự chú ý đều dồn vào {M#em gái}{F#anh trai}, không chú ý nghe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "Lại có thêm một mục tiêu \"lữ hành\" nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "Paimon nói không sai, đã có hy vọng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "Ừm, đúng vậy đúng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
