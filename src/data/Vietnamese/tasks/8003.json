			"dialogs": [
				{
					"id": 80030501,
					"content": "Xem ra, chúng ta đã đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030502,
					"content": "Căn phòng...quái dị, khô héo, khiến người ta cảm thấy khó chịu. Tôi đã hiểu được cái tà khí mà các bạn nói rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030503,
					"content": "Hu hu hu...vẫn là cảnh khủng khiếp này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030504,
					"content": "Cẩn thận, đừng để bị sức mạnh của \"Tượng Thần Ô Uế\" áp đảo...\"Sứ Đồ Vực Sâu\" ở ngay đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030505,
					"content": "Hehehe...khứu giác nhạy bén lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030506
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80030506,
					"content": "Ngươi vẫn đáng ghét như vậy, kẻ địch của giáo đoàn, Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80030507,
					"content": "Ta có thể cảm nhận được, trên người ngươi có mùi máu tanh rất đáng sợ. Là từ ác mộng đen tối, hay là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80030508,
					"content": "Chà chà...Thật nguy hiểm. Ngươi cũng có mùi \"thối rữa\" đó, làm ta thấy rất quen thuộc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80030509,
					"content": "Ngươi cũng giống như bọn ta, đều là thứ nguy hiểm. Nhưng, những thứ nguy hiểm ngoài \"giáo đoàn\" ra, thì đều nên bị nhốt trong lồng mới đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "Sứ Đồ Vực Sâu"
				},
				{
					"id": 80030510,
					"content": "Chậc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030511,
					"content": "Lưỡi của ngươi, e rằng cũng \"thối rữa\" quá lâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030512
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030512,
					"content": "Nên cắt đi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800306,
			"completionStepIds": [
				800311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800311",
