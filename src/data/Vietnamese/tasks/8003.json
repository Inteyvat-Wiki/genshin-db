			"dialogs": [
				{
					"id": 80030201,
					"content": "Người, người đó, chẳng lẽ là...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030202,
					"content": "#{M#Em}{F#Anh}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{F#Em}{M#Anh}...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "Cuối cùng đã tìm thấy rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "#Đợi...đợi đã, {NICKNAME}, {F#anh ấy}{M#cô ấy} lúc nãy đã đỡ giúp cho Sứ Đồ Vực Sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030207,
					"content": "#{F#Anh trai}{M#Em gái} của bạn, và \"Vực sâu\" hình như...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030208,
					"content": "#{F#Em}{M#Anh}, tại sao đi cùng với Dain?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "...Cái gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "(Chúng ta chia ly lâu như vậy...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030214,
					"content": "#{NICKNAME}, {F#anh trai}{M#em gái} của bạn... biết Dainsleif ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030216,
					"content": "#{F#Aether}{M#Lumine}. Chúng ta lại gặp mặt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030217,
					"content": "#Việc...việc này rốt cuộc là sao?! Dain cũng biết tên {M#cô ấy}{F#anh ấy}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030218,
					"content": "#{F#Em}{M#Anh} không nên đi cùng với người này",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "#Người này...là \"kẻ thù\" của {M#em}{F#anh}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{F#Aether}{M#Lumine}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030221,
					"content": "Đợi một lát!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "#Nhưng đây là những lời bắt buộc phải nói. Đừng theo Dain ngăn cản {M#em}{F#anh}. Đừng ngăn cản \"Vực Sâu\".",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "Người đó... Dainsleif. Hắn là \"Kiếm Sĩ Hoàng Hôn\" của đội hộ vệ cung đình Khaenri'ah đời cuối. Năm trăm năm trước, hắn không thể ngăn chặn được sự diệt vong của Khaenri'ah.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "Lúc đó hắn đã trúng phải lời nguyền bất tử, lưu lạc khắp nơi...Chỉ có thể giương mắt nhìn thấy dân chúng mà hắn muốn bảo vệ, trở thành quái vật Vực Sâu.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "Bạn nói...Dainsleif là người Khaenri'ah?! Là người Khaenri'ah đã trải qua nạn diệt vong vào 500 năm trước?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030228,
					"content": "Còn nói rằng \"dân chúng hóa thành quái vật\"...nghĩa là Giáo Đoàn Vực Sâu hiện tại, không chỉ là \"có liên quan với Khaenri'ah\", mà vốn dĩ là \"dân chúng\" Khaenri'ah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030229,
					"content": "#À...Còn nói \"Dainsleif là kẻ thù của {F#anh}{M#cô}\", tôi không thể hiểu được chuyện gì đang xảy ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030230,
					"content": "#Hãy theo {M#anh}{F#em} trước đã! Chúng ta về nhà thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "Nhà...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "#Đương nhiên, nơi nào có {M#anh}{F#em} thì nơi đó là nhà.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "#Nhưng {F#anh}{M#em} vẫn chưa thể cùng {F#em}{M#anh} đến thế giới mới, tìm ngôi nhà mới...chí ít là hiện tại chưa thể.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "#Trước khi \"Vực Sâu\" nhấn chìm thần tọa, {F#anh}{M#em} và \"Thiên Lý\" vẫn còn một trận chiến chưa hoàn thành...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "Thiên...lý?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#Hãy nghe {M#em}{F#anh}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "#{F#Anh}{M#Em} đã từng có một chuyến du hành. Cho nên, {F#em}{M#anh} cũng phải đến được điểm đích, thì mới lưu giữ được những tinh hoa của thế giới này trong mắt của mình.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "Những chuyện này chúng ta nói sau, chúng ta hãy về nhà thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#{M#Em gái}{F#Anh trai}, đừng nói những chuyện khó hiểu nữa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "(Sao lại nói về chuyện...không liên quan vậy chứ?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "...Dainsleif?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "#Mau đi theo {F#em}{M#anh}! Ở đây nguy hiểm lắm!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
		{
			"id": 800303,
			"completionStepIds": [
				800307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800307",
							"2"
