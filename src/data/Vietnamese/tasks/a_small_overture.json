				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860103,
					"content": "...Dòng Dõi Sương Nguyệt, gần đây vẫn ổn chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860104,
					"content": "Cũng tạm ổn, sự trở lại của Nguyệt Thần cũng giúp chúng tôi kiên định hơn với con đường mình cần đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "Vậy sao? Vậy thì tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Ha... Quả nhiên chúng ta vẫn chẳng có gì để nói với nhau nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860109,
					"content": "Chuyện này... chắc là vì giữa Dòng Dõi Sương Nguyệt và Fatui đã có quá nhiều quá khứ không vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Về phần tôi, tôi đương nhiên rất biết ơn tiểu thư Sandrone vì những đóng góp của cô trong việc bảo vệ Nod-Krai và đón Nguyệt Thần trở về. Nhưng những người khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "Tôi hiểu. Nhiều lý do trong quá khứ khiến chúng ta không thể xây dựng tình bạn tốt đẹp, thậm chí là cả mối quan hệ đôi bên cùng có lợi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860112,
					"content": "Nhưng giờ Fatui không còn khao khát điều gì từ Dòng Dõi Sương Nguyệt nữa, tôi cũng đã nhắc nhở cấp dưới không được gây khó dễ cho Dòng Dõi Sương Nguyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860113,
					"content": "Từ góc nhìn cá nhân của tôi, vì mọi người đều là hàng xóm, dù không thể chung sống hòa thuận, cũng nên đối xử với nhau bằng thái độ tôn trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860114,
					"content": "Điều này e rằng vẫn cần thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Tất nhiên, nhưng chi bằng cứ thử bắt đầu từ từ đi. Nếm thử trà thảo mộc tôi pha nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860116,
					"content": "Trà thảo mộc? Ha..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Ừm... Không ngờ lại có thể pha được đậm đà như thế, đây là cách pha của Dòng Dõi Sương Nguyệt à? Tôi nhớ người bên ngoài không thích cách uống này, cô đã làm thế nào vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "Học hỏi. Và tôn trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860119,
					"content": "Ha... Xem ra đây quả thực là một lần thử nghiệm không tồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "Hy vọng hợp khẩu vị của cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860121,
					"content": "Ừm, tôi thích lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Giao lưu thân thiện trong tiệc trà vốn luôn là khởi đầu tốt đẹp cho quan hệ thân thiện giữa hàng xóm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "Tôi nghĩ lần này cũng không ngoại lệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
