			"dialogs": [
				{
					"id": 761860201,
					"content": "Trà thảo mộc rất ngon đấy Sandrone. Tôi đã cảm nhận được tấm lòng của cô trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(Ngồi thêm một lúc nữa vậy.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 761860204,
					"content": "Được, lần sau để tôi mời cô đến Dòng Dõi Sương Nguyệt thưởng trà nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "Tiệc trà cũng nên kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Sandrone"
				}
			]
