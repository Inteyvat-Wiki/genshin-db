			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Anton",
					"Danila",
					"Temur",
					"Radomir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "Bọn này quá yếu, ba cú đấm hai cú đá là giải quyết xong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620702,
					"content": "Dừng lại đi! Làm ơn đừng đánh nữa! Chỉ cần cho chúng tôi chút thức ăn, chúng tôi sẽ nghe theo các người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620703,
					"content": "Hừm... Có vẻ như những tên này đói đến không chịu nổi nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620704,
					"content": "Nói cho tôi biết mục đích của các anh trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "Nói thế này đi, cho dù các người có nghi ngờ thế nào... thì nhiệm vụ của chúng tôi cũng chỉ là điều tra nguồn gốc của thảm họa ở Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620707,
					"content": "Thảm họa gì chứ... Chẳng phải Vực Đá Sâu vẫn đang yên ổn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620708,
					"content": "Thảm họa năm trăm năm trước chỉ là khúc dạo đầu của chiến tranh. Cuộc chiến chống lại kẻ địch trong bóng tối vẫn đang tiếp diễn, và một trong những chiến trường đó đang ở ngay dưới chân chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620709,
					"content": "Haiz, thượng sĩ chỉ huy của chúng ta đói đến bốc phét luôn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620710,
					"content": "Anh ta luôn bốc phét mà... nhưng nói những điều vô nghĩa thì đây là lần đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620711,
					"content": "Bỏ đi, bỏ đi... Antoha nói cũng có lý, các người và người Liyue, không phải kẻ địch của bọn tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620712,
					"content": "Ít ra cũng không phải là kẻ thù của đội chúng tôi... Nhưng mà, với những anh em khác thì không chắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620713,
					"content": "Được rồi... Tôi sẽ giúp anh, nhưng sẽ không có lần sau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "Tôi phải làm sao để tin các anh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Danila",
					"Temur",
					"Radomir",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "Haiz... thật xin lỗi. Mạng lưới chỉ huy của chúng tôi xảy ra chút... sự cố nhỏ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620902,
					"content": "\"Sự cố\"! \"Nhỏ\"?! Chúng ta đang huynh đệ tương tàn! Chúng ta đang giương mắt nhìn người ngoài đánh đuổi chiến hữu của mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620903,
					"content": "Nếu không thì sao? Chúng ta sẽ để họ đuổi chúng ta đi và lấy thức ăn của chúng ta sao? Tôi đề nghị anh nuốt mọi thứ vào miệng trước khi nói chuyện nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620904,
					"content": "Antoha, đừng hời hợt nữa... Mạng lưới chỉ huy của chúng ta đã bị phá hủy rồi, tiêu tùng rồi. Tất cả quan quân hiệu úy trở lên đều đã hy sinh hoặc mất tích... Ngoài rút lui ra thì không còn lựa chọn nào khác đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620905,
					"content": "Nhưng rất nhiều người vẫn không đồng ý rút lui... Họ thà giữ lấy di vật của trưởng quan và chiến đấu đến khi người cuối cùng ngã xuống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620906,
					"content": "Là đói đến người cuối cùng... Theo thỏa thuận hợp tác, bên trên chuyển cho chúng ta thức ăn và mệnh lệnh, nhưng rất lâu rồi chúng ta chưa nhận được thông tin ở trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620907,
					"content": "Đúng là không thể nghi ngờ lòng trung thành của chúng ta đối với Fatui và Quan Chấp Hành Đại Nhân, nhưng chúng ta cũng không phải kẻ ngốc... Với tình huống hiện tại, chỉ có rút lui mới là thượng sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620908,
					"content": "Vậy các người dự định thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "#Ừm... Tôi biết, chuyện này có thể không liên quan đến {F#cô}{M#cậu}. Nếu {F#cô}{M#cậu} muốn quay đầu rời đi cũng không sao, nhưng chúng tôi thật sự cùng đường rồi, chúng tôi rất cần sự giúp đỡ của {F#cô}{M#cậu}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620910,
					"content": "Tôi cần phải suy nghĩ thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "Được rồi... con đường phía trước hãy chú ý an toàn. Những chiến hữu còn lại ở xung quanh đây chưa chắc đã thân thiện như chúng tôi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620913,
					"content": "Mặc dù không thích hợp để nói, nhưng mà... ở nơi gần mặt đất có một trạm tiếp tế. Phụ trách vận chuyển vật tư cho chúng tôi, thỉnh thoảng cũng phụ trách truyền lệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620914,
					"content": "Một số đồng đội được cử lên bên trên xin thức ăn, nhưng họ đã không quay trở lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620915,
					"content": "#Trạm tiếp tế cũng rất lâu rồi không xuống đây... Chúng tôi mong {F#cô}{M#cậu} có thể giúp chúng tôi thăm dò tình hình của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620916,
					"content": "Để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "#Nhờ {F#cô}{M#cậu} chuyện này thật sự rất ngại, nhưng chúng tôi cần tìm hiểu tình hình trên đó... Nếu không sẽ không thể tự ý hành động được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620919,
					"content": "Được rồi! Đừng nói những lời khó hiểu như vậy nữa! Lúc đi ngang chúng tôi sẽ để ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620917,
					"content": "Tôi sẽ giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "Có cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
