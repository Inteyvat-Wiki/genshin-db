			"dialogs": [
				{
					"id": 710620137,
					"content": "Nói cho tôi biết mục đích của các anh trước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "Nói thế này đi, cho dù các người có nghi ngờ thế nào... thì nhiệm vụ của chúng tôi cũng chỉ là điều tra nguồn gốc của thảm họa ở Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620141,
					"content": "Thảm họa gì chứ... Chẳng phải Vực Đá Sâu vẫn đang yên ổn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "Thảm họa năm trăm năm trước chỉ là khúc dạo đầu của chiến tranh. Cuộc chiến chống lại kẻ địch trong bóng tối vẫn đang tiếp diễn, và một trong những chiến trường đó đang ở ngay dưới chân chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620143,
					"content": "Haiz, thượng sĩ chỉ huy của chúng ta đói đến bốc phét luôn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620144,
					"content": "Anh ta luôn bốc phét mà... nhưng nói những điều vô nghĩa thì đây là lần đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "Bỏ đi, bỏ đi... Antoha nói cũng có lý. Nói một cách đơn giản... các người và người Liyue, không phải kẻ địch của bọn tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "Ít ra cũng không phải là kẻ thù của đại đội 9 chúng tôi trong lần hành động này... Nhưng mà, với những anh em khác thì không chắc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620147,
					"content": "Tôi sẽ giúp anh vì nhân đạo, nhưng sẽ không có lần sau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "Cảm ơn... cảm ơn, chúng tôi sẽ không quên ơn đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
