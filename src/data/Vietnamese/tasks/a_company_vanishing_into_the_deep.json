			"dialogs": [
				{
					"id": 710620202,
					"content": "Hãy thử xem xét thỉnh cầu của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620201
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620201,
					"content": "Đây là đồ ăn các người cần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106207,
