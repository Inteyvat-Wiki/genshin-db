	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "Phù... Xin lỗi vì đã làm phiền nếu mọi người đang vội, tôi là thượng sĩ Anton Melnikov, đội trưởng đại diện đại đội 9. Gọi tôi là Anton là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620102,
					"content": "Còn đây là Danila, Temur, Radomir và... ừm, Romanski không có ở đây, anh ấy đang ở... trại vệ sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620103,
					"content": "Không còn Romanski, cũng không còn trại vệ sinh nữa. Antoha, Romanski... đã không qua khỏi sáng nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620104,
					"content": "Danila, Danila... Ta đã nói bao nhiêu lần rồi, ta là đội trưởng, gọi ta là thượng sĩ Anton!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620105,
					"content": "Hơ! Đội trưởng! Thượng sĩ! Cái tên Antoha này... từ khi đại úy mất tích, anh cáo mượn oai hùm cũng chịu lòi đuôi rồi à! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "Đủ rồi, Temur... anh đói quá hóa điên sao. Tiết kiệm chút sức lực đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "Là \"đội trưởng đại diện\", Antoha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620149,
					"content": "\"Đội trưởng đại diện\"! \"Đội trưởng đại diện\"! Chúng ta còn phải đi theo cái tên tốt mã giẻ cùi làm màu làm mè này đến bao giờ đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Tôi nói này, Temur anh đói đến hỏng hết đầu óc rồi, sao không ăn vài cú đấm cho tỉnh táo đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "Được, nhào vô! Để tôi cũng cho anh vài cước!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "Hay lắm, bây giờ thì nuốt cả lý trí và kiên nhẫn xuống bụng và tiêu hóa hết luôn rồi... Quá tốt rồi. Sau khi dốc cạn năng lượng này, chúng ta thực sự không còn nhiều năng lượng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620108,
					"content": "E hèm...! Bình tĩnh nào! Muốn đánh nhau sao? Muốn đánh thì xuống dưới kia mà đánh! Đánh với những thứ chui lên từ dưới bùn đen kia ấy! Nhịn đói mà đánh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620109,
					"content": "Nếu chúng ta muốn sống, muốn thoát khỏi đây thì phải đoàn kết lại! Đừng, để ta, nhắc lại, hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620110,
					"content": "Một, hai, khẩu hiệu! Không Ai, Ngoài Chúng Ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620111,
					"content": "Không Ai, Ngoài Chúng Ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620112,
					"content": "Không Ai, Ngoài Chúng Ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620114,
					"content": "#Ừm, haha... {F#cô}{M#cậu} cũng thấy rồi đó, chúng tôi có chút... e hèm, không sẵn sàng chiến đấu cho lắm. Dù sao thì... gần đây cũng gặp chút trở ngại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620115,
					"content": "Hừm... \"chút trở ngại\"! Bắt chước đại úy cũng giống đấy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "Đại úy không có ở đây, ta chính là đội trưởng! Tiết kiệm chút sức lực đi, im miệng cho ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620117,
					"content": "Xin lỗi nhé... bạn của tôi, chúng tôi rất cần sự giúp đỡ của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
