				{
					"id": 710620128,
					"content": "Sau đó thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "Chúng tôi sẽ rời khỏi đây, không làm gì cả, tôi đảm bảo. Tôi... xin lấy danh dự của đội trưởng đại đội đặc chủng số 9, lấy danh dự của tổ tiên Snezhnaya ra đảm bảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620132,
					"content": "Haiz... Thật đáng thương, đói đến nông nỗi này... đáng thương quá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620133,
					"content": "Đừng nói nữa, anh cũng không tốt lành gì đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620134,
					"content": "Lúc chúng tôi vào đây là 64 người, 64 người đó! Bây giờ chỉ còn lại bốn con ma đói thì còn có thể có âm mưu gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620135,
					"content": "Woa... sao mà thảm quá vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620136,
					"content": "Đó là một câu chuyện khác... Nhưng nếu không có thức ăn, thành viên cuối cùng của đại đội 9 không biết sẽ sống chết lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
