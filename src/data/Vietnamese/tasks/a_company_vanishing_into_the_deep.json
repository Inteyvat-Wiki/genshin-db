			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "Chúng ta là \"bạn\" từ khi nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "#Vật tư, vũ khí, tình báo hay Mora? Chúng tôi đều không thiếu. Chỉ cần {F#cô}{M#cậu} đồng ý giúp, những thứ này đều có thể xem như thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "Nhìn kìa, đội trưởng đại nhân ăn mày của chúng ta tự mình nhận lấy công việc mất mặt nhất này... Đúng là quá tốt rồi, vậy thì chúng ta cũng còn chút mặt mũi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "Bớt nói mấy câu châm chọc đi, mỉa mai cũng không thể lấp đầy bụng đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "\"Hãy gia nhập với bọn ta, hãy để bước chân tựa như sấm sét rung chuyển đất trời. Người muốn cùng ta hướng đến Ngôi Sao Đêm Trắng, ta tuyệt đối sẽ không bỏ rơi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Ai đó bắt hắn im miệng đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Hừm... Mặc dù họ đều là những kẻ không ra gì, nhưng trông cũng đáng thương. Đói đến như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "#Nói ra thì mất mặt... Nhưng như {F#cô}{M#cậu} thấy đó, chúng tôi đã mất khả năng chiến đấu, chỉ là muốn kiếm đồ ăn thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
