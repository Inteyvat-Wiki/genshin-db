			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Radomir",
					"Danila",
					"Temur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "Mọi người về rồi à, thế nào, có thông tin gì mới không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621102,
					"content": "Trạm tiếp tế đã bị bỏ hoang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "Vậy sao... Vậy thì, có tìm được thứ gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621104,
					"content": "Cảng Liyue không còn chào đón các người nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621106,
					"content": "Ngoài chuyện này ra, còn thông tin gì không...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621107,
					"content": "Ừm... Bọn tôi còn tìm được một bức thư, hình như là để lại cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710621108,
					"content": "Ở đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "Bức thư được các Fatui truyền tay nhau đọc...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "À, là của Yanbo. Tôi hiểu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621111,
					"content": "Sao? Thiên Nham Quân rút đi hết rồi sao? Đưa tôi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621112,
					"content": "Haiz, tên này làm sao vậy... Chúng ta đang chiến đấu vì bọn họ! Lẽ ra phải là đồng minh mới phải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621113,
					"content": "Bây giờ không còn là \"đồng minh\" nữa! Chúng ta đã tuyệt giao rồi... Nói một cách chính xác thì Fatui đã cắt đứt liên lạc với Liyue rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621131,
					"content": "Chúng ta đã bị người Liyue phản bội rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621132,
					"content": "Biết đâu người Liyue lại nghĩ ngược lại thì sao? Là chúng ta, là Fatui chúng ta phản bội họ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621114,
					"content": "Đùa kiểu gì vậy... Chúng ta đến để bảo vệ người Liyue mà! Còn nhớ những lời đại úy nói trước khi xuất phát không? Lần viễn chinh này không liên quan đến bất kỳ toan tính và mưu đồ nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621115,
					"content": "Nhưng không thể ngăn cản những tính toán và mưu mô tấn công chúng ta... Nó nằm ngoài tầm kiểm soát của chúng ta, Danila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621116,
					"content": "Được rồi, tôi hiểu rồi. Phù... tôi quyết định rồi, chúng ta cần rút khỏi đây, càng nhanh càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621117,
					"content": "Không sao, tôi sẽ chịu trách nhiệm hoàn toàn. Nếu có kẻ đào ngũ trong số chúng ta... Nếu kẻ đào ngũ khiến đại đội 9 mất mặt, thì kẻ đào ngũ đó chính là tôi, chỉ một mình tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621118,
					"content": "Danila nói đúng đó, chúng ta đến để bảo vệ người Liyue khỏi thảm họa đen, chúng ta không thể bỏ đi như vậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621119,
					"content": "Bây giờ có phải là lúc để nói về lòng tự trọng cá nhân không, Mirka? Anh vẫn chưa nhìn ra sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621120,
					"content": "Người Liyue không cần chúng ta bảo vệ, người Liyue cũng không hoan nghênh chúng ta! Thậm chí họ còn tiêu diệt những đồng đội của chúng ta nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621121,
					"content": "Đúng vậy, chính các người đã phụ lòng tin của Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "Chúng tôi chuẩn bị rút khỏi đây rồi, nhất định phải rời đi càng lặng lẽ càng tốt, để không kinh động đến Thiên Nham Quân ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621124,
					"content": "Đại úy nói chúng ta đến đây với tâm thế sẽ không bao giờ trở về nhà nữa. Ít nhất chúng ta cũng phải...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621125,
					"content": "Đại úy cũng từng nói, anh ấy sẽ không để bất cứ ai hy sinh vô nghĩa! Đại úy cũng từng nói, anh ấy không mong tôi dẫn đội vào chỗ chết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621126,
					"content": "Ít ra thì chúng ta vẫn còn sống, nghĩa là đại đội 9 vẫn còn, hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621127,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621128,
					"content": "Đã hiểu thưa đội trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621129,
					"content": "Được rồi, còn ai có thắc mắc gì không? Tôi không muốn nghe thấy bất kỳ ý kiến phản đối nào. Giải tán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621130,
					"content": "#Dù sao thì cũng cảm ơn {F#cô}{M#cậu} đã giúp đỡ, {NICKNAME}. Hãy nhận lấy số Mora và vật tư này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621122,
					"content": "Các người hãy suy nghĩ về con đường sau này của mình đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
