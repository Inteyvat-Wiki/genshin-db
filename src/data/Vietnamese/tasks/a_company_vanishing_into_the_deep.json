			"dialogs": [
				{
					"id": 710621001,
					"content": "#Dù sao thì cũng cảm ơn thức ăn {F#cô}{M#anh} chia sẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621002,
					"content": "Chúng tôi sẽ nghĩ cách để rời khỏi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
