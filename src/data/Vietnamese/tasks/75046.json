					"content": "Tôi phải đi xem xét chúng ngay mới được, Saurian bé bỏng của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460604
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460604,
					"content": "Như vậy tôi có thể yên tâm làm công tác huấn luyện rồi, nếu có hứng thú với Khiêu Chiến Dũng Sĩ thì tới bục nhận thưởng tìm tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
