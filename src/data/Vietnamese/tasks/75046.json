			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "Yoohoo... Mau trở lại đi! Yooohoooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "Yoooohoooo... Haiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "Tôi không ổn, đau lòng quá, không thể khỏe lên được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "Tôi chỉ đi mua cỏ khô thôi, tám nhóc Tatankasaur mà tôi nuôi không biết đã chạy đi đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "Chúng còn nhỏ như vậy, nếu ở bên ngoài bị Hilichurl bắt nạt thì sao? Lạc đường thì sao? Bị bắt nhốt thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "#Người tốt bụng, {F#cô}{M#cậu} có từng thấy Tatankasaur nhỏ mà tôi nuôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "Chúng trông như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "Mẹ của tám nhóc Tatankasaur này do tôi một tay nuôi lớn, không khác gì con gái của tôi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "Con bé là một trong những Saurian đẹp nhất Cộng Đồng Trù Phú, còn giành giải đặc biệt trong cuộc thi hoa hậu của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "Tám đứa nhóc nghịch ngợm của tôi được thừa hưởng vẻ đẹp từ mẹ chúng, làn da trắng trẻo hồng hào, có vệt tím trên cặp sừng hình quạt đối xứng hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "#Nếu nhìn thấy chúng, hãy tìm cách đưa chúng về chỗ tôi nhé, nhờ cả vào {F#cô}{M#cậu} đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "Ôi đám nhóc Saurian của ta... Ông sẽ không tức giận với các cháu nữa đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "Tôi sẽ chú ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "#Cảm ơn người tốt bụng. Hôm nay {F#cô}{M#cậu} chắc chắn sẽ phá kỷ lục đẩy tạ, đu xà không bị chuột rút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
