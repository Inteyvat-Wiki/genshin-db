				},
				{
					"id": 750460413,
					"content": "Ôi đám nhóc Saurian của ta... Ông sẽ không tức giận với các cháu nữa đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460414
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460414,
					"content": "Chúng đã trở về hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460415
					]
				},
				{
					"id": 750460415,
					"content": "#Là {F#cô}{M#cậu} đưa chúng về sao? Thật sự cảm ơn {F#cô}{M#cậu}! Hãy nhận lấy thù lao trong những chiếc rương này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460416
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460416,
					"content": "Lát nữa tôi sẽ đi thăm chúng sau, Saurian bé bỏng, Saurian bé bỏng của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460417
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460417,
					"content": "Như vậy tôi có thể yên tâm làm công tác huấn luyện rồi, nếu có hứng thú với Khiêu Chiến Dũng Sĩ thì lại tới tìm tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
