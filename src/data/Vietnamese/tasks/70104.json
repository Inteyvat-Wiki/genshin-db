				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "Bạn tìm được đèn hiệu của tôi chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040202,
					"content": "Tìm được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "Cho tôi xem thử, đúng rồi, đây đúng là đèn hiệu của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040204,
					"content": "Tình trạng này... chắc chắn chúng đã bị bọn ma vật quăng quật, nhưng cũng may là không bị hỏng hoàn toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040205,
					"content": "Haiz, nhưng số đèn hiệu này tạm thời không thể sử dụng nữa... bỏ đi, không thể thăm dò triệt để thì thôi vậy, được chút nào hay chút đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040206,
					"content": "Tôi vẫn còn vài cái đèn hiệu, bạn có thể giúp tôi đặt chúng lên núi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040207,
					"content": "Cụ thể phải đặt ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "Bạn hứa rồi nhé! Cám ơn bạn, tôi sẽ đánh dấu địa điểm lên bản đồ cho bạn ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040215,
					"content": "Xong, tôi đã đánh dấu địa điểm xong, bạn đặt đèn hiệu ở gần đó là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040216,
					"content": "Khi bạn đặt đèn hiệu, hãy nhớ để ở chỗ cao nhé, vậy thì mới đạt được hiệu quả thăm dò tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040209,
					"content": "Sao bạn không tự mình đem lên?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "Tôi không dám đi... ngay cả đội thám hiểm cũng bị quái vật tấn công như thế, một mình tôi làm gì dám lên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040211,
					"content": "Vả lại tôi cũng không tìm được đội nào khác muốn lên núi, cứ tiếp tục trì hoãn không biết sẽ hoãn đến bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040212,
					"content": "Vì vậy chỉ có thể nhờ bạn, trước đó bạn giúp tôi thu hồi số đèn hiệu suôn sẻ như vậy, chắc chắn rất bản lĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040213,
					"content": "Việc này phải trông cậy vào bạn rồi, tôi nhất định sẽ chuẩn bị đủ thù lao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040214,
					"content": "Đúng rồi, để tôi đánh dấu địa điểm đặt đèn hiệu lên bản đồ cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				}
			]
		},
