					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "\"Đền Narukami\"... là nơi này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500202,
					"content": "Có thật nhiều cửa màu đỏ. Loài người rất thích cửa màu đỏ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500203,
					"content": "Đây gọi là \"Cổng Torii\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "Đền Asase cũng có mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500205,
					"content": "Ta hiểu rồi, thì ra đó là \"Cổng Torii\". Cũng là nơi chim sinh sống sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500206,
					"content": "Cho nên cổng Torii càng nhiều thì càng nhiều chim đúng không. Loài người thật thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500207,
					"content": "Các ngươi có gặp Hibiki không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500208,
					"content": "Không phát hiện dấu vết của người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "Xung quanh đây có vẻ như không có người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500210,
					"content": "Hay là chúng ta đến Đền Narukami, hỏi các nữ pháp sư ở trong đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500211,
					"content": "Hibiki đó có lẽ cũng là pháp sư... không chừng, bọn họ biết được gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "Meo meo, đền thần này thật lớn, có thật nhiều người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500302,
					"content": "Ồ! Hòm Công Đức và giá đỡ cũng thật khí thế, thảo nào có nhiều người đến đây như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500303,
					"content": "Các ngươi hãy học hỏi. Sau này, đền Asase cũng phải trở thành như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500304,
					"content": "Chắc không phải nguyên nhân này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "Nhưng vẫn không thấy Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500307,
					"content": "Tóm lại, chúng ta tìm người hỏi về Hibiki xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500305,
					"content": "Tại sao lại là tôi học hỏi?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inagi Hotomi",
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "Xin chào, du khách đến từ phương xa, chào mừng bạn đến với Đền Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500402,
					"content": "Nếu có buồn phiền hoặc tâm nguyện, có thể đến đây rút quẻ, Lôi Thần sẽ phù hộ cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500403,
					"content": "Chúng tôi không phải đến để rút quẻ, nhưng có điều muốn hỏi bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500404,
					"content": "Hỏi tôi? Ừm...Vậy thì nói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500405,
					"content": "Là thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "Hibiki... của Đền Asase? Không lẽ là \"Asase Hibiki\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500407,
					"content": "Đúng! Hibiki chính là \"Asase Hibiki\"! Ngươi biết Hibiki sao? Có biết cô ấy ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500408,
					"content": "Ừm... ủa?! Con mèo này biết nói chuyện, tôi có nghe nhầm không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500409,
					"content": "Đừng ngạc nhiên vậy... Ta biết nói chuyện thì rất kỳ lạ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500410,
					"content": "Ngươi biết Hibiki đúng không? Có biết cô ấy ở đâu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500411,
					"content": "Bị một con mèo truy hỏi, cảm thấy thật kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500412,
					"content": "Nhưng nếu các bạn muốn hỏi về vị \"Asase Hibiki\" đó, thì các bạn đến sai chỗ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500413,
					"content": "Ơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500414,
					"content": "Sai... sai chỗ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "Tôi từng thấy tên của cô ấy trong vài quyển sách được bảo quản tốt trong đền thần. Cô ấy là thế hệ sau cùng của Đền Asase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500416,
					"content": "Vào khoảng bốn đến năm trăm năm trước, từng có tương truyền về \"Nhóm Yougou\". Asase Hibiki, Kamuna Harunosuke, Mikoshi Nagamasa từng theo học Tengu ở núi Yougou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500417,
					"content": "Lúc đó Asase đã từng làm tập sự ở đền thần chúng tôi, và đã kết giao với Saiguu đại nhân. Nhưng, sau đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500418,
					"content": "Cả ba cuối cùng mỗi người một ngả sau một \"thảm họa\" không rõ. Nghe nói Kamuna Harunosuke đã đến Liyue, muốn học hỏi \"Đạo pháp tiên gia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500419,
					"content": "Mokoshi quay về Thành Inazuma làm việc cho Shogunate. Còn Asase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500420,
					"content": "Quay về Đảo Seirai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "Ừm, không sai. Nhưng sử sách quá ít, cho nên không rõ tình hình chi tiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500423,
					"content": "Đợi một lát...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "Hả... cô ấy nói bốn đến năm trăm năm trước, vậy là Hibiki là người của rất lâu về trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500425,
					"content": "Vậy Neko cũng là con mèo bốn đến năm trăm tuổi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500426,
					"content": "Meo meo? Ta không rõ \"Bốn đến năm trăm năm tuổi\" là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500427,
					"content": "Ta đâu phải là người. Không có quá nhiều thứ phải lo lắng, chỉ biết mặt trời mọc lên, mặt trăng mọc lên. Nếu tâm trạng không tốt, thì ngủ một giấc là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500428,
					"content": "Thật ngưỡng mộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500429,
					"content": "Paimon cũng gần giống vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "#Này! Paimon ngày nào cũng lo lắng cho {NICKNAME} đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500433,
					"content": "Các ngươi nói nhiều thứ mà ta không hiểu. Vậy còn Hibiki thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500434,
					"content": "Thứ lỗi tôi nói thẳng, Asase Hibiki có lẽ đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500435,
					"content": "Hibiki không có ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "Đúng vậy, Hibiki có lẽ đã đi nơi khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500437,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500438,
					"content": "Cũng đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500439,
					"content": "Thật là, sao Hibiki lại chạy lung tung như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500440,
					"content": "Dù sao đi nữa, cảm ơn nữ pháp sư!",
