			"dialogs": [
				{
					"id": 761530101,
					"content": "Ngành xuất bản cũng chẳng kiếm được tiền, hay là chỉ đầu tư thôi vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530102,
					"content": "Muốn xem thử vé đầu tư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530103
					]
				},
				{
					"id": 761530103,
					"content": "Được rồi, 2000 Mora một vé đầu tư, mỗi tuần tổng kết một lần, hihi, trong chiếc túi nhỏ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530104,
					"content": "...Ối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530105,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530106
					]
				},
				{
					"id": 761530106,
					"content": "Jahoda, sao cô lại đến đây? Có phải cô chủ Nefer lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530107,
					"content": "Không có gì đâu, tôi chỉ đi cùng bạn bè tới đây dạo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530108,
					"content": "Haha, trông như việc kinh doanh đầu tư của ông chủ Dhabit đang làm ăn rất tốt nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530109,
					"content": "Bình thường thôi mà, hahaha... Kinh doanh nhỏ, kiếm sống qua ngày thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530110,
					"content": "(Cô ta... có ẩn ý! Chắc chắn là do Nefer phái đến... Hừ.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530111
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530111,
					"content": "Thật sự có thể kiếm được tiền sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530112
					]
				},
				{
					"id": 761530112,
					"content": "Tất nhiên rồi! Sếp đã nói ông chủ Dhabit là thương nhân có uy tín và năng lực nhất đấy. Đầu tư theo thì chắc chắn không sai đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530113,
					"content": "Đúng... đúng... hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530114
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530114,
					"content": "(Quả nhiên là Nefer...!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530115,
					"content": "Vậy khi nào mới có thể tổng kết khoản đầu tư...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530116
					]
				},
				{
					"id": 761530116,
					"content": "#Hôm nay! Chính là hôm nay, thứ {F#cô}{M#cậu} vừa mua là... vé đầu tư ngắn hạn mà chúng tôi vừa ra mắt! Tổng kết lời lỗ ngay tức thì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530117,
					"content": "Sao cảm thấy như anh vừa mới bịa ra những điều này vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530118,
					"content": "#À... ừm, tóm lại, cảm ơn {F#cô}{M#cậu} đã mua vé đầu tư ngắn hạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530119,
					"content": "#Đây là lợi nhuận đầu tư của {F#cô}{M#cậu}, chúc {F#cô}{M#cậu} một ngày tốt lành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530120,
						761530121
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530120,
					"content": "Nói chung kiếm tiền là chuyện tốt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				},
				{
					"id": 761530122,
					"content": "Thật sao? Hihi, vậy mua cho tôi điêu khắc đường hình chú chim nhỏ nhé, tôi thích hình đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530123,
					"content": "Hửm? Để tôi đi cùng nhé, tôi mua về cho sếp một cái luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530124
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530124,
					"content": "J-Jahoda, đợi một chút!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530125
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530125,
					"content": "À... Không biết cô chủ Nefer còn dặn dò cô điều gì không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530126
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530126,
					"content": "À. Sếp nói: \"Đồ đã được tìm thấy rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530127,
					"content": "\"Đừng vội. Mọi thứ phải thực hiện từng bước một mới ổn thỏa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530128,
					"content": "Cô chủ Nefer nói đúng... Vậy thì làm phiền rồi, tôi chỉ còn hy vọng vào hai vị thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530121,
					"content": "Đi thôi Paimon, chúng ta đi mua điêu khắc đường nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				}
