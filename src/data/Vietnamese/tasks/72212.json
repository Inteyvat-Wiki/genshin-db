			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "Xin chào, hôm nay bạn bận gì đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120202,
					"content": "Giúp Neko tạc tượng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Hả? Tạc tượng, ở đây? Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120204,
					"content": "Tôi, tôi sẽ đi học điêu khắc ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120205,
					"content": "Không kịp đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "Lại là Neko nhờ vả bạn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120207,
					"content": "Nói chứ, vì vấn đề ở bên phía Tatarasuna, rất nhiều thợ thủ công đang tìm việc làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120208,
					"content": "Trước đó bên hiệp hội có tiếp nhận không ít ủy thác liên quan, theo tôi biết thì có người dường như vẫn ở gần Tatarasuna, vẫn đang tìm việc làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120209,
					"content": "Trước đó tôi đi chấp hành ủy thác của hiệp hội, cũng gặp được một doanh trại tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120210,
					"content": "Nếu các bạn muốn, có thể đến bên đó thử thử vận may.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120211,
					"content": "Cám ơn bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Ha ha... đừng bận tâm, chỉ tiện tay mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120215,
					"content": "Tôi cũng muốn xem thử nếu ngôi đền thần này thật sự trở nên náo nhiệt... sẽ như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120216,
					"content": "Đặc biệt là vị Hibiki đó... rốt cuộc là người như thế nào, mà lại khiến Neko bận tâm như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120217,
					"content": "Được rồi, bạn cũng đừng ở đây nghe tôi lẩm bẩm nữa, mau đi tìm thợ thủ công đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120218,
					"content": "Còn việc liệu thợ thủ công mà các bạn tìm thấy có thể điêu khắc hay không... ha ha, thì phải xem vận may của các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120219,
					"content": "Tiểu thư Etsuko, thật ra cô cũng muốn giúp Neko đại nhân mà phải không? Ha ha, cô thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120220,
					"content": "Taisuke, đã làm xong kế hoạch điều tra chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120221,
					"content": "À! Sắp, sắp xong rồi, thật xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120212,
					"content": "Cảm giác tiểu thư Etsuko có gì đó không giống bình thường...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "Sao vậy? Tôi chủ động cung cấp thông tin như vậy, bạn có chút không quen sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Etsuko"
				}
			]
		},
