			"dialogs": [
				{
					"id": 722120301,
					"content": "Haiz... rốt cuộc khi nào mới tìm được việc làm đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120302,
					"content": "Các bạn... đến tìm tôi sao? Có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120303,
					"content": "Bạn biết điêu khắc không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "Hả? Vậy... thì tốt quá rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120306,
					"content": "Tôi quên mất tự giới thiệu... Tôi là Ooshima Junpei, trước đó làm việc ở Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120307,
					"content": "Sau khi xảy ra tai nạn, tôi và những người khác đã bị sơ tán ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120308,
					"content": "Nhưng đến bây giờ tôi vẫn chưa nhận được tin làm việc trở lại, nên cứ luôn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120309,
					"content": "Các bạn đang tìm người biết điêu khắc đúng không? Tôi có chút tài nghệ điêu khắc, tuy không chuyên nghiệp lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120310,
					"content": "Các bạn muốn làm bức tượng như thế nào? Có thể nói với tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120311,
					"content": "Là thế này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "Hả, mèo biết nói chuyện, muốn các bạn tìm thợ thủ công, để giúp nó tạc tượng đá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120313,
					"content": "Không, không phải là tôi không tin, chỉ là việc này có chút hơi... khó tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120314,
					"content": "Cho dù tôi đồng ý giúp các bạn, vậy ngài Guuji Đại Diện đó sẽ thanh toán thù lao như thế nào? Tôi không thể làm không công được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120315,
					"content": "Yên tâm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(Có thật là có thể yên tâm không...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120317,
					"content": "Như vầy, tôi cứ cảm thấy các bạn đang lừa tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120318,
					"content": "Nhưng mà... thôi vậy, dù sao cũng nhàn rỗi, tôi đi cùng các bạn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120319,
					"content": "Mong rằng đối phương sẽ thanh toán thù lao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 722120304,
					"content": "Chúng tôi đang tìm thợ thủ công biết điêu khắc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
