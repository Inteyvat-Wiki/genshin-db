			"dialogs": [
				{
					"id": 726550201,
					"content": "Ha ha, đúng là ở đây rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550202,
					"content": "Thì ra ở đây cũng có di tích ngầm...ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550203,
					"content": "Sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "Không, không có gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550206,
					"content": "Ơ, không khỏe à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550207,
					"content": "Ha ha, bình thường tôi ít khi xuống thuyền, cho nên nhìn thấy cổng vào di tích lớn thế này, tôi hơi ớn lạnh thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550208,
					"content": "Vậy mà lớn gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550209,
					"content": "Được rồi, đơn hàng của chị đại đang chờ, chắc bạn cũng rất tò mò xem di tích đang ẩn giấu bí mật gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550210,
					"content": "Cho nên, mời Nhà Lữ Hành dày dặn kinh nghiệm xung phong đi trước nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550211,
					"content": "Đúng là hết cách với bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "Đúng là hết cách với bạn, chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550204,
					"content": "Có phát hiện gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
