				},
				{
					"id": 726550302,
					"content": "Về di tích...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "Dù sao thì tôi chỉ là nhân viên kỹ thuật trên thuyền, không hiểu nhiều về lịch sử trên đất liền, xin lỗi nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550305,
					"content": "Nhưng tôi nghĩ những di tích này chắc có liên quan đến trận đại họa xảy ra vào 500 năm trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550306,
					"content": "Từ nhỏ tôi đã nghe các thủy thủ già kể về thảm họa này, nghe nói cả đất liền và biển cả đều không thoát khỏi sự xâm lược của vực sâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550307,
					"content": "Nhưng tôi thấy cũng chỉ như truyện ma hù dọa con nít thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550308,
					"content": "Dù sao thì nỗi sợ tận mắt chứng kiến mới thật sự đáng sợ!",
					"roleType": "TALK_ROLE_NPC",
