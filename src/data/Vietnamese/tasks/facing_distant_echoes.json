			"dialogs": [
				{
					"id": 726550101,
					"content": "Cuối cùng chúng ta cũng tìm được vị trí của mục tiêu rồi! Xong, có thể về thuyền đánh một giấc rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550102,
					"content": "Hả? Bạn bỏ ngang vậy hả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550103,
					"content": "Sao có thể thế được, chỉ còn một bước nữa là đạt được thứ chúng ta muốn rồi, bây giờ hãy xuất phát đi bắt máy móc di tích nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550104,
					"content": "Vừa nãy còn tưởng bạn muốn về thuyền chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550105,
					"content": "Haiz, bỏ đi, chúng ta cùng đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
