			"dialogs": [
				{
					"id": 733480401,
					"content": "Ấy, sao lại về rồi? Đã tìm được người của Purbiruni chưa? Không tốn nhiều công sức đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "Tìm thì tìm được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "Hả? Sao lại ngập ngừng thế, không bị người ta làm khó đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "Thuật lại chuyện về Sadife cho Khedive nghe...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "À, Sadife... Anh ta nổi tiếng cứng đầu, có lúc ngay cả giáo viên cũng không đối phó nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "Hơn nữa còn từ chối mọi nguồn tài trợ và khăng khăng làm việc một mình. Nói là muốn giữ tính thuần khiết trong nghiên cứu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "Đây chính là \"Tiền bạc không thể làm thù lao của trí tuệ\" sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Đây là nguyên tắc của học giả Purbiruni... Haha, Pursina chúng tôi không cổ hủ như vậy là đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Hoặc cũng không thể nói như vậy, chỉ là tôi có khá nhiều tiền mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "Anh kiếm tiền như thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "Sao lại tỏ vẻ nghi ngờ thế? Tôi cũng vất vả lắm mới kiếm được đó... đầu tư giao dịch Hàng Mong Chờ phiền phức lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "Giao dịch Hàng Mong Chờ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "Giao dịch Hàng Mong Chờ... vừa phải chú ý lượng giao dịch, vừa phải chú ý xu hướng thị trường, còn phải cân bằng hướng đầu tư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "Ban đầu tôi chỉ đầu tư một chút tiền chơi thôi, không muốn ảnh hưởng tới việc nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Nhưng ai ngờ tôi càng kiếm càng nhiều, số tiền bỏ vào cũng càng ngày càng nhiều lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "Tôi là học giả, tôi muốn nghiên cứu! Thứ tôi muốn là thành quả học thuật, không phải là Mora! Tôi vẫn luôn răn đe bản thân như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "Nhưng khi đến thành Sumeru thì tôi lại đến sở giao dịch, đầu tư Hàng Mong Chờ hết khoản này tới khoản khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "Số tiền tôi kiếm được ngày càng nhiều, nhưng việc nghiên cứu thì chẳng tiến triển bao nhiêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "Nên tôi mới mời nhiều người vào Vực Đá Sâu khảo sát là vậy. Chỉ có ở nơi không có sở giao dịch thì tôi mới chuyên tâm nghiên cứu được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Nếu nghiên cứu không ra thành quả thì tôi sẽ không rời khỏi Vực Đá Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "Anh giao dịch Hàng Mong Chờ để kiếm tiền sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "Tại sao anh lại có nhiều tiền thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "Nhưng đã xảy ra chút chuyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
