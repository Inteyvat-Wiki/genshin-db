			"dialogs": [
				{
					"id": 733480101,
					"content": "Nếu như không có những mẫu đó thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "Về Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Đúng vậy. Tôi là Herbad hiện tại của Purbiruni, có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "Hỏi về học thuật sao? Nhưng trông bạn không giống như học giả của Giáo Viện nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "Về thư tiến cử của Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "Đây là thư của Khedive tự tay viết sao? Để tôi xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Ừm, xem ra việc nghiên cứu của anh ta ở Vực Đá Sâu thuận lợi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "Nghiên cứu nấm... môi trường thủy sinh... hóa thạch cổ đại... địa chất đặc biệt... bản mẫu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "Tốt lắm! Khedive vẫn rất sắc sảo và khả năng nghiên cứu vẫn rất tuyệt, quả nhiên không khiến tôi thất vọng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "Hừm... Tuy không muốn thừa nhận trước mặt người ngoài lắm, nhưng năng lực của học giả Pursina rất tốt đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "Hơn nữa, Khedive cũng có nhắc đến sự giúp đỡ của bạn nhiều lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "Nhờ bạn mà việc nghiên cứu của anh ấy đã như \"hổ mọc thêm cánh\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "Không cần lặp lại đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Vậy à? Khụ, xin lỗi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Đợi anh ta quay về Giáo Viện thì sử sách học thuật của Pursina sẽ lại có thêm một giai thoại huy hoàng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "À còn nữa, tình bạn ngàn năm giữa hai sư môn cũng sẽ có sự thăng tiến lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "Tôi xin thay mặt Purbiruni và Pursina, lần nữa tỏ lòng cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "Đúng rồi, trong thư thì Khedive còn bảo tôi chuẩn bị chút quà cho bạn... Đợi một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "Chắc không phải lại là một phong thư nữa chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "Đương nhiên là không! Bạn giúp đỡ Khedive quá nhiều, trả chút Mora cho bạn là chuyện quá hiển nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "Nhưng mà... hôm nay tôi ra ngoài vội, nên không có mang nhiều Mora. Hãy đứng đây đợi tôi một lát nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Tuy đều là học giả đáng tự hào của môn phái mình... Nhưng trông anh ta khác với Khedive nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "Trông có vẻ như... không có nhiều tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "Sao lại vậy chứ? Purbiruni chúng tôi nhiều đời là học giả, nên sẽ không có khó khăn về tiền bạc đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "Chẳng qua phần lớn tiền bạc của chúng tôi đều đầu tư vào nghiên cứu, nên sẽ... hơi túng thiếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "Nhưng điều này không gây trở ngại cho nghiên cứu của chúng tôi. Cũng có thể nói là vì không bị vật chất làm mờ mắt, nên mới có thể nhìn rõ con đường trí tuệ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "Giờ tôi sẽ quay về lấy thù lao. Nhưng trước đó thì tôi có một chuyện cần giúp đỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "Trong thư Khedive có viết là... bạn vô cùng lợi hại, là một người xuất chúng, là nhà thám hiểm hiếm có khó tìm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "Vậy có thể giúp tôi một việc không? Dạo trước vì để điều tra môi trường địa chất, mà tôi đã một mình đi vào sa mạc làm khảo sát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "Do tôi không có nhiều tiền, nên đã không thuê vệ sĩ. Tôi nghĩ nếu đi nhanh về nhanh thì sẽ không có nguy hiểm gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "Nhưng xui xẻo thay, sau khi khảo sát xong thì tôi bị Đạo Bảo Đoàn tập kích trên đường về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "Tuy tôi đã chạy thoát, cũng không bị thương, nhưng cái rương đựng mẫu địa chất và ghi chép thì lại bị lấy mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "Trong mắt thương nhân và Đạo Bảo Đoàn thì cái rương đó không có giá trị... Nhưng với tôi thì nó là vô giá đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "Nhất thời tôi không tìm được người chịu giúp đỡ... Nhà Lữ Hành, có thể giúp tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "Tôi sẽ giúp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "Thật cảm ơn! Không có bạn thì tôi cũng không biết phải làm sao nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "Giờ tôi đánh dấu địa điểm bị tập kích trên bản đồ, cái rương chắc ở gần đó thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "Tôi đã nghe Khedive nói qua rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "Anh là học giả của Purbiruni phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
