					"id": 733480902,
					"content": "Xin lỗi, làm phiền chút...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "Học giả của Purbiruni? À, là đang tìm Sadife đúng không? Không ngờ anh ta cũng có người đi tìm cơ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "Dạo này anh ta ở trong Giáo Viện làm việc, nên chắc ở gần đây thôi... Tìm anh ta có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "Về thư tiến cử của Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "Khedive? Anh ta kết thúc nghiên cứu rồi sao? Có tiền đúng là tốt mà, mời được cả đội ngũ cùng đi khảo sát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "Còn tôi thì thậm chí không được trợ cấp cho một chuyến đi thực địa nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "Cô biết Khedive sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Đương nhiên, những học giả đau đầu vì kinh phí và không kiếm ra tiền như chúng tôi, sớm đã nghe danh của anh ấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "Chà, vậy thì Khedive... và các học giả trong phái của anh ta đều rất giàu có phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "Vậy là sẽ được nhận rất nhiều thù lao phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "Không đâu, Khedive là trường hợp đặc biệt thôi. Đừng hiểu sai về học giả Purbiruni và Pursina nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480914,
					"content": "Đặc biệt là những người học chiêm tinh, bổ túc lịch sử hay sinh học... Nếu xui xẻo thậm chí còn bị từ chối đơn xin tài trợ nữa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480915,
					"content": "Hơn nữa họ còn nói gì mà \"tiền bạc không thể làm thù lao của trí tuệ\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480916
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480916,
					"content": "Khụ, tôi nói hơi nhiều rồi... Sadife ở bên kia, hai vị có thể đi hỏi thăm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480903,
					"content": "Về chuyện học giả của Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				}
			]
		},
