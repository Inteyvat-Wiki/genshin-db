			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "Đợi chút! Đợi chút đã! Dừng tay! Đừng đánh nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480202,
					"content": "Hộc... Chỉ là một rương sách thôi, không cần phải mạnh tay như vậy! Cứ lấy đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480203,
					"content": "Chỉ có mấy thứ này thôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "Tôi thề là chúng tôi chỉ đào được cái rương này thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480206,
					"content": "Ngoài sách thì chúng tôi có tìm thấy một số đá và bùn được đựng trong chai... Cũng có một vài viên đá quý rất đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480207,
					"content": "Các người đã lấy số đá quý này đi rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "Này! Trả lại những thứ đó đây! Đều là mẫu địa chất quý giá đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480209,
					"content": "Mẫu... địa chất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480210,
					"content": "Trả lại đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "Trả! Tôi trả mà! Mau chóng bỏ hết đồ vào trong rương đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480213,
					"content": "Đồ đều để trong rương hết rồi, chúng tôi đi trước đây... Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480214,
					"content": "Thứ mà Sadife muốn tìm có lẽ đều ở đây, chúng ta đem về thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480215,
					"content": "Một mình đi vào sa mạc lấy mẫu vật, còn ghi nhiều bút ký như vậy... Đúng là một học giả lợi hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480211,
					"content": "Một, hai, hai rưỡi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "Còn thứ gì khác không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
