			"dialogs": [
				{
					"id": 733480301,
					"content": "Nhà Lữ Hành quay lại rồi, xin hỏi cái rương của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480302,
					"content": "Ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "Tốt quá! Vô cùng cảm ơn... Chậc, vốn dĩ là cầm thư tiến cử tới mà tôi lại làm phiền bạn rồi. Hãy nhận lấy số Mora này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480305,
					"content": "Nhưng các anh hay nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "Ủa? Ngay cả câu này mà cũng biết sao? Trong Purbiruni của chúng tôi quả thực có lời răn dạy này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480307,
					"content": "Nhưng câu này chỉ dùng để khuyên răn thôi. Bất cứ lúc nào cũng không nên vì tiền tài hoặc nguyên nhân khác mà lung lay nguyên tắc nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480308,
					"content": "Dù sao thì nếu đặt lợi ích lên hàng đầu... thì người đó không xứng để làm một nhà nghiên cứu nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480309,
					"content": "Nhưng bạn đã vất vả trợ giúp tôi, nên đương nhiên phải nhận được một phần thù lao hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480310,
					"content": "Lần nữa xin cảm ơn. Nếu sau này có gì cần thì cứ đến tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480311,
					"content": "\"Tiền bạc không thể làm thù lao của trí tuệ\" mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "Đã lấy về rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
