					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "Ái chà, không phải cưng đấy sao? Chẳng lẽ nghe ngóng được lịch trình hôm nay của tôi nên đặc biệt đến gặp tôi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240402,
					"content": "Miko vừa đi gặp Shogun về à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "Haha, mũi thính thật đấy. Tôi mang chút điểm tâm và mấy cuốn tiểu thuyết đang rầm rộ nhất hiện nay cho... một người bạn không thích ra ngoài mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240405,
					"content": "Ei cũng bắt đầu quan tâm rồi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "Theo cách nói của cô ấy thì, muốn nhân cơ hội này tìm hiểu đời sống giải trí và những thay đổi trong sở thích của người dân Inazuma dạo gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240407,
					"content": "Vừa nãy cô ấy còn thảo luận với tôi một hồi đấy. Ban đầu còn nghiêm túc phân tích sở thích độc giả được thể hiện qua nội dung câu chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240408,
					"content": "...Nhưng nói một hồi, cô ấy đột nhiên hỏi tôi với vẻ rất quan tâm: \"Vậy thì, kết cục cuối cùng của nhân vật đó rốt cuộc là thế nào?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240409,
					"content": "Haha, xem ra... cho dù là Ei thì cũng khó mà cưỡng lại sức hút của một câu chuyện hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240410,
					"content": "Biểu cảm vừa rồi của Miko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "Ồ? Vậy nên đây mới là mục đích thực sự hôm nay cưng đến đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240413,
					"content": "Tôi biết rồi. Chắc chắn cưng thường xuyên nhớ nhung tôi trong suốt cuộc hành trình, nên muốn chụp vài tấm hình làm kỷ niệm chứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240414,
					"content": "Vậy giao cho cưng đấy. Phải chọn góc cho có tâm vào nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240411,
					"content": "Rất đáng để ghi lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "Tôi ngửi thấy mùi hương ngọt ngào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
