			"dialogs": [
				{
					"id": 200110301,
					"content": "Như vậy có thể đi được rồi... Cảm ơn Nhà Lữ Hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110302,
					"content": "Do thiếu tiền nên bệnh của Anna vẫn chưa thể chữa khỏi, tôi thường đến đây để hái thuốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110303,
					"content": "Tuy là hái được cây thuốc rồi, nhưng không ngờ lại bị bọn này tập kích, cũng may có bạn đến kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110304,
					"content": "Cho bạn cái này, tôi thường dùng cái này để pha trà cho Anna uống, như vậy thì bệnh ho của nó mới đỡ được chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110305,
					"content": "Bạn cũng hay đi ra ngoài nhỉ, phải tự biết cách chăm sóc bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
