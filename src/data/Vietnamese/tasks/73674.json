			"dialogs": [
				{
					"id": 736740301,
					"content": "Này, chẳng phải nhóc dẫn tôi tới đây sao? Biểu diễn chút tác dụng đi, cử động đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740302
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740302,
					"content": "Ôi, được rồi, cứ đứng đó đừng nhúc nhích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740303,
						736740304
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740303,
					"content": "Ulman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				},
				{
					"id": 736740305,
					"content": "Nhà Lữ Hành? Chao ôi, đúng là lâu quá không gặp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740306
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740306,
					"content": "Sao rồi? Bạn vẫn đi đây đó trên khắp thế giới à? Tôi đã nghe nói về những chuyện về bạn rồi, bạn thật sự rất tài giỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740307
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740307,
					"content": "Haha, lần này bạn tới Sumeru tính giải quyết chuyện gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740308,
						736740310
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740308,
					"content": "Đừng nói gở thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740309
					]
				},
				{
					"id": 736740309,
					"content": "Được rồi được, nói chuyện nghiêm túc nào. Nhà Lữ Hành, lần này chúng ta lại hợp tác với nhau nhé, thấy sao hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740313,
					"content": "Bạn thấy đấy, vùng đất Sumeru đầy kho báu, và Mora ở khắp mọi nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740314
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740314,
					"content": "Thể chất này của tôi... cũng phát huy như thường lệ, thu hút khá nhiều Tiên Linh tới, trong đó còn có \"Tiên Linh Tầm Bảo\" mà hai ta đều quen thuộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740315
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740315,
					"content": "Vẫn giống như lần trước, bạn phụ trách tìm kho báu với Tiên Linh, tôi phụ trách chuẩn bị thù lao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740316
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740316,
					"content": "Chỉ cần chúng ta hợp tác với nhau, chắc chắn có thể kiếm được rất nhiều tiền!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740317,
						736740321
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740317,
					"content": "Lần này lại muốn tìm \"Tiền Xu\" ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740318
					]
				},
				{
					"id": 736740318,
					"content": "Không đâu, lần này tôi muốn tìm \"Tiền Sắt Cổ\" đáng giá hơn \"Tiền Xu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740319
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740319,
					"content": "Chỉ tăng thêm một chữ thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740320
					]
				},
				{
					"id": 736740320,
					"content": "Bạn chớ xem thường một chữ này, thêm một chữ, có thể bán được rất nhiều Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740326,
					"content": "Vậy chuyện này cứ quyết định như thế đi, chúng ta cứ chung sức như trước, kiếm thêm một khoản lớn nữa nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
