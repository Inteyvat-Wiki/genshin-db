			"dialogs": [
				{
					"id": 736740101,
					"content": "Này, chẳng phải nhóc dẫn tôi tới đây sao? Biểu diễn chút tác dụng đi, cử động đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740102,
					"content": "Ôi, được rồi, cứ đứng đó đừng nhúc nhích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740103,
					"content": "Anh đang làm gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "Ôi, lần này xem như tôi lại bị nó lừa rồi... Để tôi tóm gọn đầu đuôi sự việc cho bạn nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740107,
					"content": "Nói ra thì có thể bạn sẽ không tin, nhưng bản thân tôi cũng không biết tại sao mình lại dễ thu hút tiên linh đến thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740108,
					"content": "Trong số các tiên linh đi theo tôi, tôi đã phát hiện ra một tiên linh rất quan tâm tới tầm bảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740109,
					"content": "Tôi cũng không biết đặt tên, bèn gọi chúng là \"Tiên Linh Tầm Bảo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740110,
					"content": "Chúng rất giỏi trong việc săn tìm kho báu, với sự giúp đỡ của chúng, tôi cũng đã đào được rất nhiều kho báu, kiếm được một số tiền không nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740111,
					"content": "Nhưng đôi khi bọn chúng đột nhiên phớt lờ tôi, tôi không biết do tìm kho báu mệt rồi hay cảm thấy tôi không thú vị nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740112,
					"content": "Lúc này, tôi thường tìm một cộng sự có thể làm tiên linh yêu thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740113,
					"content": "Người đó phụ trách dẫn \"Tiên Linh Tầm Bảo\" tìm kho báu, còn tôi thì phụ trách bán số kho báu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740114,
					"content": "Lúc trước tôi nghe nói, ở Sumeru có đầy di tích và đồ cổ, cho nên tôi muốn tới đây kiếm một khoản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740115,
					"content": "Sau khi tới đây, quả nhiên tôi lại thu hút một đám tiên linh, vài \"Tiên Linh Tầm Bảo\" trong số chúng đã đưa tôi đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740116,
					"content": "Nhưng tôi mới đào vài cái thì chúng lại phớt lờ tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740117,
					"content": "Ơ? Sao nó đột nhiên di chuyển thế? Chẳng lẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740118,
					"content": "Nhà Lữ Hành, bạn có hứng thú với chuyện tìm kho báu với tiên linh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740119,
					"content": "Tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "Không cần nói chuyện với nó, chỉ cần đi theo nó, thấy nó dừng lại thì đào xuống, đơn giản vậy thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740122,
					"content": "Thế nào? Bạn cứ thử xem, ừm... Nếu như bạn thật sự tìm được kho báu, tôi chỉ cần \"Tiền Sắt Cổ\" ở trong đó thôi, những thứ khác đều thuộc về bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740123,
					"content": "Hơn nữa, nếu bạn thật sự có thể tìm ít \"Tiền Sắt Cổ\" giúp tôi, tôi sẽ trả thù lao tương ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740124,
					"content": "Tôi sẽ thử xem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "Thẳng thắn đấy! Tôi thích những người như bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740130,
					"content": "Tóm lại, hiện giờ chúng ta đang trong quan hệ hợp tác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740131,
					"content": "Bạn cầm cuốn sổ này trước đi, đây là những nơi chứa kho báu mà tôi tìm thấy lúc trước, vẫn chưa kịp đào lên nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740132,
					"content": "Vậy nhờ bạn đấy, Nhà Lữ Hành. Nếu như tìm thấy \"Tiền Sắt Cổ\" thì nhớ mang về cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740126,
					"content": "\"Tiền Sắt Cổ\" là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "Nói đơn giản thì là một loại đồ cổ khác thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740128,
					"content": "Chỉ cần tìm được bí quyết, tôi có thể dùng số \"Tiền Sắt Cổ\" này đổi lấy nhiều thứ tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740129,
					"content": "Mặc dù... bây giờ tôi vẫn chưa tìm ra cách...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740120,
					"content": "Tôi không biết nói chuyện với tiên linh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "Đây là... tiên linh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "Bạn nói nhóc này à? Chà... cứ xem là phải đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "Ulman"
				}
			]
		},
