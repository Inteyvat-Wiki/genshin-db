				"points": []
			},
			"dialogs": [
				{
					"id": 727270201,
					"content": "Đến rồi, ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270202,
					"content": "Vẫn là quy tắc cũ, chỉ cần bạn bước vào cánh cửa vô cùng khả nghi này là sẽ có thể bước vào đấu trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270203,
						727270204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270203,
					"content": "...Lần này cũng vô cùng khả nghi đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270207
					]
				},
				{
					"id": 727270207,
					"content": "Tóm lại, lần này tôi cũng sẽ ghi lại tư thế anh hùng lúc chiến đấu của bạn, cổ vũ thật lớn cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270208,
						727270209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270208,
					"content": "Được, tôi không thể đợi được nữa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270210,
					"content": "Ừm, lần này xin hãy để tôi lại được chứng kiến màn múa kiếm rực rỡ của bạn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270209,
					"content": "Luôn cảm thấy thật phiền phức...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270204,
					"content": "Quy tắc của \"Hyakunin Ikki\" là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270205
					]
				},
				{
					"id": 727270205,
					"content": "Quy tắc lần này cũng không khác lần trước là bao. Ma vật, nhà mạo hiểm và võ sĩ khao khát chiến đấu sẽ đến từ khắp nơi trên Teyvat để thỏa sức chiến đấu trên võ đài của buổi lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270206,
					"content": "Tất nhiên, cũng như trước đây, bạn sẽ có thể tham gia cuộc chiến với bạn đồng hành hoặc chiến hữu cùng chí hướng. Dù sao thì cũng là \"trăm người\" mà, đương nhiên là nhân số càng nhiều càng tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270207
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		}
	]
}