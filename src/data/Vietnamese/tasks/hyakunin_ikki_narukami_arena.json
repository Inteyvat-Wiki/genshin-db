					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727270101,
					"content": "Này! Võ sĩ nước ngoài kia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270102,
						727270104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270102,
					"content": "Lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270103
					]
				},
				{
					"id": 727270103,
					"content": "Đúng vậy, lại gặp nhau rồi! Dáng vẻ của bạn quả nhiên vẫn ngời ngời như ngày nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270106,
					"content": "...Khụ, tóm lại, mấy ngày nay hình như có ai đó lại đang bí mật tổ chức \"Hyakunin Ikki\" thì phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270107,
						727270112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270107,
					"content": "Hyakunin Ikki là gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270108
					]
				},
				{
					"id": 727270108,
					"content": "Ban đầu \"Hyakunin Ikki\" vốn là một buổi lễ được \"Hội Tengu\" cử hành, thông qua những trận đánh nhau thỏa thích để kỷ niệm những sự kiện đáng nhớ, hoặc để giải tỏa những cảm xúc mất mát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270109,
					"content": "Trong buổi lễ, dù là võ sĩ hay ma vật, đều có thể từ bỏ định kiến, bất chấp thân phận, hỗn chiến chỉ vì lòng nhiệt huyết thuần khiết mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270110,
					"content": "Nghe nói, những võ sĩ bộc lộ tài năng nổi bật trong buổi lễ còn có thể giành được nhiều kho báu khác nhau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270111,
					"content": "...Tuy nói là vậy, nhưng khi \"Hội Tengu\" bị cấm, rốt cuộc là ai đang tổ chức buổi lễ chứ. Phần thưởng của người thắng cuộc từ đâu mà có thì tôi cũng không rõ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270115,
					"content": "Tóm lại, ở đây đông người, không thích hợp lắm để bàn những chuyện này. Vẫn như cũ nhé, đi theo tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270116,
					"content": "Kayabuki Ikkei dẫn bạn đến một hòn đảo nhỏ bên ngoài Thành Inazuma...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727270112,
					"content": "...Lại nữa à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270113
					]
				},
				{
					"id": 727270113,
					"content": "Đúng vậy, có lẽ là tư thế anh hùng lúc chiến đấu của bạn đã thu hút nhiều người hơn, thậm chí khán giả cũng thấy nhiệt huyết sôi trào, nóng lòng muốn thử, ai cũng muốn trực tiếp tham gia vào buổi lễ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270114
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270114,
					"content": "Nói thật, tôi cũng không ngờ là \"Hyakunin Ikki\" lần này lại đến nhanh như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 727270104,
					"content": "...Anh là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270105
					]
				},
				{
					"id": 727270105,
					"content": "Không nhớ tôi sao? ...À, xin lỗi, thời điểm \"Hyakunin Ikki\" lần trước có thể do tôi chỉ mải ghi nhớ tư thế anh hùng lúc chiến đấu của bạn nên không hò reo cổ vũ gì nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7272702,
			"completionStepIds": [
				7272702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
