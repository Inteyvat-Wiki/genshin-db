			"dialogs": [
				{
					"id": 414010101,
					"content": "Kỳ lạ thật, \"máy ảnh\" này bị gì vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010102,
					"content": "Cái máy ảnh này sao rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "Hình như hư rồi... hoặc là bị chập mạch ở đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010104,
					"content": "Trước đó tôi đã đặt máy ảnh từ Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010105,
					"content": "Người bán máy ảnh nói đây là công nghệ tân tiến nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010106,
					"content": "Nói là có thể in ra những bức ảnh có màu sắc đặc biệt, cho nên tôi đã mua một cái để thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010107,
					"content": "Kết quả là không biết tôi đã thao tác thế nào hay là bản thân máy ảnh này có vấn đề, giờ đã không còn hoạt động bình thường được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010108,
					"content": "Không lẽ là tôi dùng không đúng cách sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010109,
					"content": "Đúng rồi, bạn có hiểu gì về máy ảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010110,
					"content": "Cũng có tí hiểu biết.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "Vậy tốt quá, bạn có thể giúp tôi một chuyện không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010114,
					"content": "Nhìn bộ dạng của bạn, chắc là Nhà Lữ Hành phải không? Hẳn là bạn đã đi qua nhiều chỗ rồi, hiểu biết chắc phải sâu rộng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010115,
					"content": "Tôi muốn bạn dùng \"máy ảnh\" này giúp tôi chụp một số thứ có màu sắc mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010116,
					"content": "Sau khi chụp xong hãy gửi ảnh đã in lại cho tôi, tôi muốn xem thử \"máy ảnh\" này gặp trục trặc ở chỗ nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010117,
					"content": "Nếu không ổn, tôi sẽ mang số ảnh này đi tìm người đó hỏi xem. Có ảnh chụp làm chứng cứ, tôi cũng không sợ anh ta không thừa nhận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010118,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "Vậy phiền bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010120,
					"content": "Đồ có màu sắc mạnh là gì nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "Ừm...là loại...có màu đặc biệt nổi bật, ví dụ Ớt Tuyệt Vân màu đỏ nè, Băng Vụ Hoa màu xanh nè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010122,
					"content": "Sau khi chụp xong hãy gửi ảnh đã in lại cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010112,
					"content": "Chưa tìm hiểu qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "Không sao, thứ này thao tác đơn giản lắm... bạn có thể giúp tôi một chuyện được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				}
			]
		}
	]
