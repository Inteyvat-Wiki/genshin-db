				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "Ôi, trong nồi đang hầm gì thế, thơm quá. Chỉ ngửi thôi mà nước miếng chảy không ngừng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210102,
					"content": "Hình như là một loại canh nào đó, ừm... Cũng không biết được làm từ nguyên liệu gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210103,
					"content": "#Ai da, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210104,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "Bạn xem bây giờ người nấu không có ở đây, canh này thơm như thế, hay chúng ta lén nếm thử một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210106,
					"content": "Vậy chúng ta lén nếm một chút nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "Được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210112,
					"content": "Sức chứa trong nồi ít hơn vẻ bề ngoài.\\nThứ bên trong đã hết sạch.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "Phù... Hửm? Món canh này rất thơm, nhưng sao không nếm được vị gì thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210114,
					"content": "Aramuhukunda tại thượng! Nara các bạn làm gì thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210115,
					"content": "Aranara? Từ đâu chui ra thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210116,
					"content": "Từ dưới đất đấy! Khoan nói chuyện này, sao các bạn có thể lén uống canh tôi nấu thế, đó là món canh mà Arapas tôi đây tốn công nấu đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210117,
					"content": "Xin lỗi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "Xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210119,
					"content": "Hừ, đã lén uống canh của tôi thì chỉ nói xin lỗi là đủ sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210123,
					"content": "Các bạn có biết nấu canh ở đây khó thế nào không? Lúc thì mưa, lúc thì nắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210124,
					"content": "Khó khăn lắm tôi mới nấu được một nồi, không ngờ trong lúc tôi đang hái Quả Harra tươi thì bị các bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210125,
					"content": "Chúng tôi cũng vì nó quá thơm nên mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210126,
					"content": "Nhưng nếu đã khó khăn như thế, sao lại nấu canh ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210127,
					"content": "Hừ, có một thứ quan trọng trong việc nấu ăn cần được thu hoạch mỗi ngày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210128,
					"content": "Có phải tự trọng của đầu bếp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "Là nước! Là nước đó! Nước ảnh hưởng rất nhiều tới mùi vị của canh, đương nhiên phải dùng loại nước tốt nhất để nấu canh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210131,
					"content": "Dọc đường, tôi lấy nước từ nhiều nơi khác nhau trong Rừng Apam để nấu canh. Sau khi thu thập rất nhiều mẫu nước trên lá cây, tôi mới tìm được \"suối nguồn\" tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210132,
					"content": "Thế mới xứng với \"Món Ăn Quý Nhất\" trong Lễ Hội Utsava! Cho dù có nói với các bạn thì chưa chắc các bạn đã hiểu... Chỉ có Nara trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210133,
					"content": "Nói tới chuyện này, thật ra chúng tôi đến từ chỗ Arapacati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210134,
					"content": "Nói cho Arapas biết chuyện đã xảy ra.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "À, hóa ra là bạn Nara của \"em gái\"! Hơn nữa, Lễ Hội Utsava sắp diễn ra rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210136,
					"content": "Nhưng không sao hết, tôi đã lấy được \"Suối Nguồn\", \"Món Ăn Quý Nhất\" của tôi đã hoàn thành rồi. Ở trong nồi này... nhưng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210138,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "Ấy ấy. Đừng buồn, canh thật sự rất thơm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210140,
					"content": "A, \"Suối Nguồn\" của tôi! \"Apshvaana\" sống ở đầu nguồn, khó khăn lắm mới đợi bọn chúng rời khỏi nguồn nước, để lấy được một nồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210141,
					"content": "Không được, các bạn phải lấy một nồi \"Suối Nguồn\" khác đền cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210142,
					"content": "\"Apshvaana\"...? Đó là thứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210143,
					"content": "Hừ, Nara chẳng hiểu gì về rừng sâu cả. Đó là một thứ sống dưới nước, có 4 chân, có đuôi và có thể cắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210144,
					"content": "...Chó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210145,
					"content": "Chó không sống trong nước mà nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "À, cũng đúng. Vậy \"Apshvaana\" là gì thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210148,
					"content": "Quên \"Apshvaana\" đi! Tôi muốn nước! Hơn nữa chỉ muốn \"Suối Nguồn\" ở nơi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210149,
					"content": "#Được rồi, được rồi... {NICKNAME}, hết cách rồi, chúng ta đi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210150,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "Nhất định phải là \"Suối Nguồn\", những loại nước khác đều không được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210151,
					"content": "Đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "Chó nước ở đâu ra. Là ảo ảnh nước hình chó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "Hay là ý chí không quên ước nguyện thuở ban đầu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "Đều, đều tại Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#Này! {NICKNAME}, không ngờ bạn lại phản bội tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210122,
					"content": "Tôi không cần biết ai uống, dù sao canh của tôi cũng đã hết sạch rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210108,
					"content": "Không ổn lắm đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "Tôi tò mò thôi, huhu, tôi chỉ nếm một miếng, một miếng thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210110,
					"content": "Lỡ đau bụng thì phiền lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "Hứ, đừng xem thường Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
