				{
					"id": 730210202,
					"content": "Hình như là một loại canh nào đó, ừm... Cũng không biết được làm từ nguyên liệu gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210203,
					"content": "#Ai da, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210204,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210205
					]
				},
				{
					"id": 730210205,
					"content": "Bạn xem bây giờ người nấu không có ở đây, canh này thơm như thế, hay chúng ta lén nếm thử một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210206,
						730210208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210206,
					"content": "Vậy chúng ta lén nếm một chút nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210207
					]
				},
				{
					"id": 730210207,
					"content": "Được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210212,
					"content": "Sức chứa trong nồi ít hơn vẻ bề ngoài.\\nThứ bên trong đã hết sạch.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210213
					]
				},
				{
					"id": 730210213,
					"content": "Phù... Hửm? Món canh này rất thơm, nhưng sao không nếm được vị gì thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210214,
					"content": "Aramuhukunda tại thượng! Nara các bạn làm gì thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210215
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210215,
					"content": "Aranara? Từ đâu chui ra thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210216,
					"content": "Từ dưới đất đấy! Khoan nói chuyện này, sao các bạn có thể lén uống canh tôi nấu thế, đó là món canh mà Arapas tôi đây tốn công nấu đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210217,
						730210220
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210217,
					"content": "Xin lỗi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210218
					]
				},
				{
					"id": 730210218,
					"content": "Xin lỗi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210219,
					"content": "Hừ, đã lén uống canh của tôi thì chỉ nói xin lỗi là được sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210223
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210223,
					"content": "Các bạn có biết nấu canh ở đây khó thế nào không? Lúc thì mưa, lúc thì nắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210224
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210224,
					"content": "Hửm? Nghe nói dạo này \"Cỗ Máy Varuna\" ổn định hơn nhiều, thời tiết cũng bình thường rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210225
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210225,
					"content": "Thật ra chính là nhờ chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210226,
					"content": "Hừ, người sửa được \"Cỗ Máy Varuna\" nhất định là một Nara tốt, chứ không phải là \"Kẻ Trộm Canh\" như mấy bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210227
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210227,
					"content": "Trộm gì chứ, đừng nói khó nghe như thế! Chúng tôi cũng vì nó quá thơm nên mới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210228,
					"content": "Nhưng nếu đã khó khăn như thế, sao lại nấu canh ở đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210229,
					"content": "Hừ, có một thứ quan trọng trong việc nấu ăn cần được thu hoạch mỗi ngày...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210230,
						730210231
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210230,
					"content": "Có phải tự trọng của đầu bếp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210232
					]
				},
				{
					"id": 730210232,
					"content": "Là nước! Là nước đó! Nước ảnh hưởng rất nhiều tới mùi vị của canh, đương nhiên phải dùng loại nước tốt nhất để nấu canh rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210233
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210233,
					"content": "Dọc đường, tôi lấy nước từ nhiều nơi khác nhau trong Rừng Apam để nấu canh. Sau khi thu thập rất nhiều mẫu nước trên lá cây, tôi mới tìm được \"suối nguồn\" tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210234
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210234,
					"content": "Thế mới xứng với \"Món Ăn Quý Nhất\" trong Lễ Hội Utsava! Cho dù có nói với các bạn thì chưa chắc các bạn đã hiểu... Chỉ có Nara trước đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210235
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210235,
					"content": "Nói tới chuyện này, thật ra chúng tôi đến từ chỗ Arapacati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210236,
					"content": "Nói cho Arapas biết chuyện đã xảy ra.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210237
					]
				},
				{
					"id": 730210237,
					"content": "À, hóa ra là bạn Nara của \"em gái\"! Hơn nữa, Lễ Hội Utsava sắp diễn ra rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210238
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210238,
					"content": "Nhưng không sao hết, tôi đã lấy được \"Suối Nguồn\", \"Món Ăn Quý Nhất\" của tôi đã hoàn thành rồi. Ở trong nồi này... nhưng rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210239
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210239,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210240
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210240,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210241
					]
				},
				{
					"id": 730210241,
					"content": "Ấy ấy. Đừng buồn, canh thật sự rất thơm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210242,
					"content": "A, \"Suối Nguồn\" của tôi! \"Apshvaana\" sống ở đầu nguồn, khó khăn lắm mới đợi bọn chúng rời khỏi nguồn nước, để lấy được một nồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210243
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210243,
					"content": "Không được, các bạn phải lấy một nồi \"Suối Nguồn\" khác đền cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210244
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210244,
					"content": "\"Apshvaana\"...? Đó là thứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210245,
					"content": "Hừ, Nara chẳng hiểu gì về rừng sâu cả. Đó là một thứ sống dưới nước, có 4 chân, có đuôi và có thể cắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210246
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210246,
					"content": "...Chó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210247,
						730210248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210247,
					"content": "Chó không sống trong nước mà nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210249
					]
				},
				{
					"id": 730210249,
					"content": "À, cũng đúng. Vậy \"Apshvaana\" là gì thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210250,
					"content": "Quên \"Apshvaana\" đi! Tôi muốn nước! Hơn nữa chỉ muốn \"Suối Nguồn\" ở nơi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210251
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210251,
					"content": "#Được rồi, được rồi... {NICKNAME}, hết cách rồi, chúng ta đi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210252,
						730210253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210252,
					"content": "Ừm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210254
					]
				},
				{
					"id": 730210254,
					"content": "Nhất định phải là \"Suối Nguồn\", những loại nước khác đều không được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210253,
					"content": "Đi thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210254
					]
				},
				{
					"id": 730210248,
					"content": "Chó nước ở đâu ra. Là chó nước trong sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210249
					]
				},
				{
					"id": 730210231,
					"content": "Hay là ý chí không quên ước nguyện thuở ban đầu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210232
					]
				},
				{
					"id": 730210220,
					"content": "Đều, đều tại Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210221
					]
				},
				{
					"id": 730210221,
					"content": "#Này! {NICKNAME}, không ngờ bạn lại phản bội tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210222,
					"content": "Tôi không cần biết ai uống, dù sao canh của tôi cũng đã hết sạch rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210223
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210208,
					"content": "Không ổn lắm đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210209
					]
				},
				{
					"id": 730210209,
					"content": "Tôi tò mò thôi, huhu, tôi chỉ nếm một miếng, một miếng thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210210,
					"content": "Lỡ đau bụng thì phiền lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210211
					]
				},
				{
					"id": 730210211,
					"content": "Hứ, đừng xem thường Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210212
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302103,
