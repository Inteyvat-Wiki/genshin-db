			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapas",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210401,
					"content": "...Chà, đúng là nước đầu nguồn, \"Suối Nguồn\" trong lành, mát lạnh như ánh trăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210402
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210402,
					"content": "Nếu như Arachatora, Arasaka và Araphala uống nước này lớn lên, nhất định sẽ không trở thành tên ngốc như bây giờ. Chỉ có em gái tôi, Arapacati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210403
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210403,
					"content": "E hèm, tiếp theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210404,
					"content": "Hửm? Phải rồi, sau đó các bạn phải nấu một nồi canh đền cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210405
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210405,
					"content": "Dưới sự hướng dẫn của Arapas, thêm ít rau quả vào trong nước, bắt đầu nấu.\\nTrong nồi dần dần tỏa ra một mùi thơm.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210406
					]
				},
				{
					"id": 730210406,
					"content": "Sau khi hoàn thành, cùng nhau nếm thử món \"canh\" vừa nấu.\\n... Phải nói là đúng như mong đợi, tuy có hương thơm từ nguyên liệu...\\nNhưng nước canh không có chút gia vị gì cả nên vẫn nguyên chất quá.\\nChẳng có mùi vị gì.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210407
					]
				},
				{
					"id": 730210407,
					"content": "Ừm ừm, \"Món Ăn Quý Nhất\" tất nhiên là phải có mùi thơm như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210408
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210408,
					"content": "#Ừm... Bạn thấy thế nào, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210409,
						730210410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210409,
					"content": "Xét ở góc độ món canh thì đúng là có thể giải khát.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				},
				{
					"id": 730210411,
					"content": "Tôi nghĩ rằng nó sẽ ngon hơn nếu thêm một chút muối và tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210412,
					"content": "Món gì thêm muối và tiêu đều trở nên rất ngon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210413
					]
				},
				{
					"id": 730210413,
					"content": "Aramuhukunda tại thượng! Không ngờ lại thêm muối vào... muối là thứ rất đáng sợ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210414
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210414,
					"content": "Muối trên đất không có sự sống! Aranara chỉ có thể biến thành hạt giống... Không ngờ Nara lại thêm muối vào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210415
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210415,
					"content": "Canh nhạt nhẽo là chuyện tất nhiên! Nara mấy bạn lại không hiểu điều này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210416
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210416,
					"content": "Nara trước đây uống canh xong, đã nói một đạo lý với chúng tôi:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210417
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210417,
					"content": "\"Nara chúng tôi, lúc bọn trẻ sắp về nhà, trong nhà sẽ truyền ra mùi thơm của canh. Vì thế, canh chỉ cần có mùi thơm thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210418
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210418,
					"content": "#Sau đó, {M#cô ấy}{F#anh ấy} đã khen món canh của Arapas tôi nấu rất ngon, rất thơm. Tôi luôn nhớ điều đó. Cho nên tôi không tin lời bạn nói đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210419
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210419,
					"content": "Chỉ có hương thơm thôi cũng không được đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210420,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210421
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210421,
					"content": "Hừ, nếu các bạn là Nara của Lễ Hội Utsava lần này, nhất định phải được Araja, Arapacati bọn họ đồng ý. Hết cách rồi, nghĩ cách nấu một món canh ngon thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210422
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210422,
					"content": "Lần sau tìm loại nước tốt hơn để nấu canh, nhất định sẽ nấu được món canh ngon hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210423
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210423,
					"content": "... Tôi lại thấy không liên quan tới chất nước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210424
					]
				},
				{
					"id": 730210424,
					"content": "Thế ư... Nhưng \"Luyện Nấu Ăn\" lần này đã kết thúc tốt đẹp rồi. Được rồi, mọi chuyện cứ chờ tới Lễ Hội Utsava hẵng nói nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210425
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210425,
					"content": "Cách nấu canh cũng đã dạy cho các bạn rồi. Đây là hương vị đã được Nara vĩ đại công nhận, các bạn nếm thử thêm đi. Nhưng nhớ kỹ: nhất định phải dùng nước tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210426
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210426,
					"content": "#({NICKNAME}, lần sau chúng ta thêm ít gia vị vào thử xem. Chắc sẽ ngon lắm...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210410,
					"content": "Đối với tôi thì nó rất tốt cho sức khỏe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				}
			]
		},
