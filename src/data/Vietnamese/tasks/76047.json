			"dialogs": [
				{
					"id": 760470201,
					"content": "Ồ, là khách quen đây mà. Hôm nay cũng đến mua vé đầu tư đấy à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470202,
					"content": "Nghe nói vé đầu tư của anh là lừa đảo, phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "#Xem {F#cô}{M#cậu} nói kìa, chắc không phải vì dạo này cứ lỗ vốn liên tục nên mới nghĩ ngợi lung tung đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470204,
					"content": "Đời này làm gì có chuyện làm ăn chỉ lời không lỗ chứ, có người thắng thì sẽ có người thua. Nhớ hồi xưa tôi ở Thành Sumeru... Khụ, chỉ là lần này không may mắn thôi mà. Chuyện may rủi thì cũng khó nói lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470205,
					"content": "\"Hy vọng\" ấy mà, chính là phải kiên trì mới nắm bắt được. Chỉ cần tiếp tục đầu tư thì chắc chắn sẽ có ngày được đền đáp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470206,
					"content": "Được rồi. Tôi sẽ còn quay lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "Này! Sao lại dễ bị thuyết phục vậy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470209,
					"content": "#Lừa đảo thì không có kết cục tốt đâu! Chúng tôi... Đúng rồi, chúng tôi là {NICKNAME} và Paimon tiếng tăm lừng lẫy đấy nhé! Ở Thị Trấn Nasha chúng tôi cũng có không ít bạn bè đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470210,
					"content": "\"Bạn bè\" á? Bạn bè gì cơ... Chẳng lẽ là loại \"bạn bè\" đó sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470211,
					"content": "...Hửm? À, đúng! Chính là kiểu \"bạn bè\" đó. Không chỉ có, mà còn có rất nhiều đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470212,
					"content": "Trời ơi! Sao không nói sớm, đúng là không dây vào được mà. Chỗ này cho hai người hết đó, tôi không bán vé đầu tư cho hai người nữa. Hai người mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470208,
					"content": "Đừng hòng lừa được tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
