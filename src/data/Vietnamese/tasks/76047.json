			"dialogs": [
				{
					"id": 760470101,
					"content": "Ừm... Hai vị, tôi đã ở đây quan sát hai vị rất lâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "Cô theo dõi chúng tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "Không, tôi chỉ thường xuyên đến tìm sách, vô tình phát hiện hai vị rất quan tâm đến việc tham gia đầu tư. Đây không phải chuyện tốt, hai vị nên từ bỏ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "Đúng là chúng tôi chưa kiếm được một khoản lớn... Nhưng mà sao lại nói là không phải chuyện tốt chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Vì tôi đoán vốn là không có lợi nhuận cao. Ông chủ đó còn nhiều khoản nợ chưa trả hết, chắc sẽ không để làm ăn lỗ vốn nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "Bạn tôi cũng từng bị lừa bởi chiêu trò thế này rồi, hai vị đừng tiếp tục nữa thì hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#Chẳng lẽ thật sự là lừa đảo sao...? {NICKNAME}, chúng ta phải đi tìm anh ta hỏi cho ra lẽ mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7604702,
