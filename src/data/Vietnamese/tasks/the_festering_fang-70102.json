			"dialogs": [
				{
					"id": 701020102,
					"content": "Về \"Chiếc Răng\" này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "Răng? Cho tôi xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020104,
					"content": "Ừm... hình dáng và kích cỡ này đúng là hơi khác thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020105,
					"content": "Tôi không biết nhiều về nguyên liệu này... nhưng Orban đã xử lý qua rất nhiều nguyên liệu để rèn vũ khí, có lẽ anh ấy sẽ biết gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020106,
					"content": "Bạn có thể đi hỏi anh ấy, anh ấy ở cạnh đây thôi, rất dễ tìm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
