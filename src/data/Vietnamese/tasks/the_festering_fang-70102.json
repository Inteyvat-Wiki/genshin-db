			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "Về \"Chiếc Răng\" này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "Răng sao? Răng gì, cháu nhặt được mấy thứ tạp nham gì trên núi tuyết rồi ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020203,
					"content": "Ơ? Chiếc răng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020204,
					"content": "Sao sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "Kết cấu của chiếc răng này rất tốt, độ cứng cũng vừa đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020206,
					"content": "Và mặt cắt này... trông như \"răng rồng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020207,
					"content": "Răng rồng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "Chính là răng của rồng. Nghe nói vũ khí làm từ răng rồng sẽ vô cùng sắc bén cứng cáp... lại còn có sức mạnh kỳ dị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020209,
					"content": "Nhưng răng rồng không phải là thứ có thể nhặt bừa bãi, trong truyền thuyết, những người lấy được răng rồng và dùng nó để đúc thành vũ khí, đều là những đại anh hùng tiếng tăm lẫy lừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020210,
					"content": "Ha ha ha, như câu nói đó, nếu không có vũ khí có thể đánh bại được rồng, thì làm sao có thể đánh bại nó để lấy răng rồng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020211,
					"content": "Chiếc răng đó là răng rồng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "Thành thật mà nói, chú chưa bao giờ xử lý răng rồng, nên không thể nào phán đoán được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020213,
					"content": "Chú cảm thấy đây là răng của một con thú khổng lồ nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020214,
					"content": "Nhưng vì cháu đã tốn không ít công sức để mang chiếc răng này đến đây, chúng ta có quyền xem nó là một chiếc \"răng rồng\" quý giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020215,
					"content": "Ừm... nhưng một chiếc thì không đủ để rèn vũ khí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020216,
					"content": "Cháu hãy đi thu thập khoảng 3 chiếc \"răng rồng\" như vậy về đây, chú cũng về tìm tư liệu, xem thử cách xử lý chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020217,
					"content": "Đúng rồi, ngoài số <color=#00E1FFFF>răng rồng</color> này ra, còn phải tìm một ít khoáng thạch để hỗ trợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020218
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020218,
					"content": "À, lúc lên núi sẵn tiện thu thập 5 <color=#00E1FFFF>\"Quặng Tinh Ngân\"</color> về nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020220
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020220,
					"content": "Ngoài ra, chú còn cần một <color=#00E1FFFF>\"Phôi Vũ Khí Cán Dài Bắc Lục\"</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020219
