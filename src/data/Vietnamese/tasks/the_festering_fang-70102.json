					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020306,
					"content": "Sau đó dùng răng rồng đã hấp thu sức mạnh để xử lý những chiếc răng còn lại.",
