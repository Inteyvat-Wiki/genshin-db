					"content": "Tìm được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "#Cám ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020304,
					"content": "Meng, Fei mau đến ăn đài sen đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020305,
					"content": "Ê...ê chúng ta vẫn phải cướp chứ nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Ồ, quên mất. Mau đưa tiền và đồ ra đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020307,
					"content": "Thật tuyệt vời khi là một tên cướp biển, có thể ăn cắp rất nhiều thứ như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020308,
					"content": "Cảm thấy đứa trẻ này... nói có ẩn ý gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "#Lần này vất vả rồi, lần tới {F#chị}{M#anh} cũng tới chơi với chúng em nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				}
