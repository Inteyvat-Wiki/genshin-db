			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "Chuẩn bị xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Vậy chúng ta bắt đầu thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020203,
					"content": "#Vậy mời {F#chị}{M#anh} bắt đầu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020204,
					"content": "Xin chào, ta là cướp đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Hừm, thanh thiên bạch nhật dám đến cướp, các chú Thiên Nham Quân đang ở ngoài kia kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220020206,
					"content": "Lulu, mau qua đây, chúng ta cùng chạy trốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220020207,
					"content": "Xin hỏi, bạn đến cướp gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020208,
					"content": "Ờ, thì chắc là tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Nhưng tôi không xu dính túi để cướp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020213,
					"content": "Bố tôi nói, trên thuyền thứ đáng giá nhất đó chính là hàng hóa của đám thương nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020214,
					"content": "#Cứ như vậy đi. {F#Chị}{M#Anh} có thể giúp em tìm thấy một cái gì đó có giá trị và đem nó mang lại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020215,
					"content": "Vậy thì tôi sẽ lấy đồ đi vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020216,
					"content": "#Để tôi nghĩ... vậy thì {F#chị}{M#anh} đi tìm ít Đài Sen về đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020217,
					"content": "#Cả ba chúng em đều thích ăn Đài Sen, {F#chị}{M#anh} làm một tên cướp biển xấu xa, cướp Đài Sen là không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020209,
					"content": "Đến cướp của bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Mặc dù đang chơi trò chơi, nhưng cũng cần chú ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020211,
					"content": "Ngươi xem, các chú Thiên Nham Quân bên kia đang quay sang nhìn bên này đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Lulu"
				}
			]
		},
