			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Lulu, sao lại cho tôi làm thuyền trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "A Meng"
				},
				{
					"id": 220020102,
					"content": "Bởi vì khi A Meng làm thuyền trưởng, bọn mình mới chơi vui vẻ nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020103,
					"content": "Lulu thấy không có vấn đề, thì... tôi cũng không thấy vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 220020104,
					"content": "Các em đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "Chúng em đang chuẩn bị để chơi trò chơi nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020106,
					"content": "Meng là thuyền trưởng, Fei là nhân viên phục vụ, em là thương nhân giàu có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020107,
					"content": "Chỉ thiếu người làm hải tặc đến cướp thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020108,
					"content": "#{F#Chị}{M#Anh} muốn làm hải tặc, chơi cùng chúng em không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020109,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "#Cám ơn {F#chị}{M#anh}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020113,
					"content": "#Được rồi, khi {F#chị}{M#anh} đã sẵn sàng, hãy đến chỗ em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lulu"
				},
				{
					"id": 220020111,
					"content": "Tôi muốn làm người tốt",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "#Chỉ cần chơi một trò chơi, em biết {F#chị}{M#anh} là một người tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Lulu"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
