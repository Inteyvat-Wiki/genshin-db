					"nextDialogs": [
						413370605
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370605,
					"content": "Lúc đến đây tôi thấy xung quanh không có ai, cũng thấy hơi khó chịu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370606,
					"content": "Nhưng bây giờ biết được còn có người của phái Cổ Hoa nhớ đến nơi này, trong lòng lại cảm thấy dễ chịu nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370607,
					"content": "Ngày trước phái Cổ Hoa sẽ thả đèn ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "Ừm... Hồi đó sau khi làm xong Đèn Tiêu, sư phụ đi phía trước, chúng tôi cầm Đèn Tiêu đi theo sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370609,
					"content": "Hồi đó, trên núi dưới núi, Đèn Tiêu dệt thành một mảng, đẹp lắm luôn.",
