				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "Cảm ơn bạn, vậy là tôi có thể làm đèn tiêu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370402,
					"content": "Làm xong đèn tiêu rồi, sư muội, lát nữa hãy viết nguyện vọng lên đây, chữ của sư muội rất đẹp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370403,
					"content": "Viết thì viết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 413370404,
					"content": "Sư muội... không vui à? Sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370405,
					"content": "Làm gì có, có thể giúp sư huynh thả đèn tiêu là muội vui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 413370406,
					"content": "Các bạn đi đâu thả đèn vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "Đúng, người bạn này nói phải, chúng ta nên chuẩn bị đi thả đèn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370409,
					"content": "Vậy sư huynh đi một mình nhé, muội không đi nữa, leo núi mệt lắm... muội không có sức đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 413370410,
					"content": "Việc này... chúng ta vừa mới nghỉ ngơi ở đây một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370411,
					"content": "Muội hơi đau đầu, không biết có phải vì vừa nãy gió núi thổi qua không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 413370412,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370413,
					"content": "Tôi... tôi giúp các bạn đi thả vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "Việc này... haiz, vậy thì phiền bạn rồi. Tôi vốn định chuẩn bị đến một nơi đặc biệt thả Đèn Tiêu kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370416,
					"content": "Ngày trước khi phái Cổ Hoa vẫn... còn, mỗi khi đến Tết Hải Đăng, sư phụ đều sẽ đưa chúng tôi tới đó thả đèn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370417,
					"content": "Đáng tiếc nay sơn môn lụn bại, nơi đó cũng đã lâu chưa có người của phái Cổ Hoa tới thả Đèn Tiêu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370418,
					"content": "Bây giờ nếu bạn đã đồng ý giúp đỡ, vậy thì phiền bạn đưa tôi tới đó thả Đèn Tiêu này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370419,
					"content": "Tôi đánh dấu cho bạn rồi, tôi đi chăm sóc cho sư muội mình trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370414,
					"content": "Để tôi giúp!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "Các bạn nên đi thả đèn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
