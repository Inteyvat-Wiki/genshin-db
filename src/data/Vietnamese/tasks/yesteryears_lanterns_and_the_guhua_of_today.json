					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "Thả đèn ở gần đây có lẽ sẽ có tiên nhân nhìn thấy nhỉ? Nhưng nguyên liệu này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370202,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "Ôi xin lỗi, tôi và sư muội đang bàn luận chuyện thả đèn tiêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370204,
					"content": "Nhưng tôi không có đủ nguyên liệu để làm đèn tiêu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370205,
					"content": "Nếu người bạn này đồng ý thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370206,
					"content": "Lại là phái Cổ Hoa, phái Cổ Hoa phái Cổ Hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 413370207,
					"content": "Chẳng dễ dàng gì mới có một Tết Hải Đăng, ước nguyện vẫn là phái Cổ Hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 413370208,
					"content": "Sư muội, hai ta đều là người của phái Cổ Hoa, chấn hưng phái Cổ Hoa đương nhiên là trách nhiệm của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370209,
					"content": "Phải phải phải, sư huynh nói cái gì thì là cái đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 413370210,
					"content": "Haiz... người bạn này, nếu bạn đồng ý, có thể tìm một ít nguyên liệu Đèn Tiêu về cho tôi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370211,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "Vô cùng cảm ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370216,
					"content": "Khụ, tôi đếm lại một chút, hình như còn thiếu một đoá Thanh Tâm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370217,
					"content": "Số hoa hái trước đó đã quá lâu nên đã hỏng mất rồi, không thể dùng nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370218,
					"content": "Thanh Tâm cũng có thể dùng để làm Đèn Tiêu à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "Haha, trước kia khi ở phái Cổ Hoa, tôi và các sư đệ sư muội thường đùa giỡn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370220,
					"content": "Để Đèn Tiêu mang theo hương hoa, kể ra cũng khá thú vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370221,
					"content": "Tôi ở đây chờ bạn, tìm thấy nguyên liệu xong hãy mang về cho tôi nhé, phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370213,
					"content": "Sư muội của bạn hình như có lời muốn nói...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "Không có gì, không có gì, sư huynh nói cái gì thì là cái đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "Bé Que'er"
				},
				{
					"id": 413370215,
					"content": "Haiz, sư muội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
