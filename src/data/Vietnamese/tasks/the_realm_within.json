			"dialogs": [
				{
					"id": 10140201,
					"content": "Các cháu chẳng phải đang sốt sắng tìm chiếc chuông sao? Còn không mau đi tìm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140202,
					"content": "Có điều chiếc ấm này ta cũng lâu rồi không cọ rửa, các cháu phải cẩn thận đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140203,
					"content": "Ăn mặc đẹp như vậy mà bị lấm bẩn thì sẽ mất nhiều công sức giặt giũ lắm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				}
			]
		},
		{
