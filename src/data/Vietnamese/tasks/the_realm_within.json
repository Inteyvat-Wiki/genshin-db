					"speakerTitle": "Paimon"
				},
				{
					"id": 10140408,
					"content": "Đúng rồi, bà ấy nhờ chúng tôi chuyển lời cho anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140409,
					"content": "\"Nếu rảnh thì có thể ghé qua uống trà. Bà lão ta không có tài sản gì nhưng trà thì luôn sẵn sàng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140410,
					"content": "Ha ha ha, giọng điệu này không hợp với bạn. Có điều cái ấm bà ấy dùng để pha trà thật sự rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140411,
					"content": "Đợi thời cơ thích hợp, tôi sẽ mang trà ngon đi gặp bà ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140412,
					"content": "Vậy việc tiếp theo cần chuẩn bị cho nghi thức là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140413,
					"content": "Ừm... Thứ tiếp theo chúng ta phải đi mua là <color=#00E1FFFF>diều gió</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140414,
					"content": "Diều! Zhongli muốn đưa bọn tôi đi chơi sao? Có lẽ là... xả hơi một chút?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140415,
					"content": "Haha, không phải như vậy. Diều là món đồ chơi của con nít, thế nhưng trong các nghi thức tại Liyue, nó lại có ý nghĩa tượng trưng khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140416,
					"content": "Tôi sẽ giải thích cho các bạn sau. Việc cần làm là mua được diều gió rồi tính tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140417,
					"content": "Ồ... Ra là vậy, thật là khó hiểu mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140405,
					"content": "Anh cũng là Tiên Nhân?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
