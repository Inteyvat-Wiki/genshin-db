			"trigger": {
				"objectNames": [
					"Bình Lão Lão"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "Người trẻ tuổi chân tay nhanh nhẹn, chỉ một lúc đã lấy được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140302,
					"content": "Bà là Tiên Nhân?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "Hai chữ... Tiên Nhân, đã rất lâu bà lão ta mới nghe có người nhắc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140304,
					"content": "Còn việc ta có phải là tiên nhân hay không, chẳng lẽ các cháu thật sự không biết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140312,
					"content": "Ựm... Có vẻ như hiểu được, lại có vẻ không hiểu hết. Nhưng mà bà, bà... Cứ thế đưa chuông cho tụi con sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140313,
					"content": "Bà không thấy kỳ lạ sao? Nham Vương Đế Quân vừa xảy ra chuyện, tụi con đã vội vàng tìm bà lấy chuông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140314,
					"content": "Đứa trẻ ngốc, cảng Liyue từ xưa đến nay đã không biết có bao nhiêu tiên nhân rời đi, cũng không biết đã trải qua bao nhiêu giông bão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140315,
					"content": "Nhưng bất kể thời nào đều phải làm \"Điển Lễ Tiễn Tiên\" cho thật vẻ vang theo đúng quy tắc, rồi mới đi an bài việc khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140316,
					"content": "Cứ hô hào \"bắt lấy hung thủ\", nhưng lại trì hoãn \"Điển Lễ Tiễn Tiên\", theo ta thấy đó mới là đầu đuôi lẫn lộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140317,
					"content": "Bây giờ, các cháu đến mượn chiếc chuông, ta đoán có lẽ người bạn cũ kia cuối cùng đã không thể khoanh tay đứng nhìn được nữa, bước ra chủ trì đại cuộc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140318,
					"content": "Vì vậy, sao ta có thể từ chối cho các cháu mượn chuông chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140319,
					"content": "Nếu như \"người bạn cũ\" của bà mượn rồi không trả thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "Không trả? Hahaha, nếu bọn họ thật sự làm vậy, thì bà lão ta nói không chừng là phải đi một chuyến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140321,
					"content": "Đã lâu không gặp, đúng lúc có thể đi tìm họ uống trà, nói chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140326,
					"content": "Được rồi, đã lấy được đồ rồi thì mau trở về đi, đừng làm lỡ việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140327,
					"content": "Giúp ta gửi một câu đến người phái các cháu đến đây, nhắn là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140328,
					"content": "Nếu rảnh thì có thể ghé qua uống trà. Bà lão ta không có tài sản gì nhưng trà thì luôn sẵn sàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140329,
					"content": "Vâng, tụi con nhớ rồi, cảm ơn bà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140322,
					"content": "Chiếc chuông này có thể tặng cho con không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "Này! Bạn thật là, đây là đồ của bà mà! Dùng xong chúng ta phải mang trả lại cho bà chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140324,
					"content": "Tặng cho cháu? Đứa trẻ này thật là thẳng thắn, hahaha, cháu thích thì cứ cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140325,
					"content": "Nhưng chiếc chuông này rất nhớ nhà, không biết khi nào nó sẽ tự trở lại với bà lão ta đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140305,
					"content": "Bà là người của Thất Tinh Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "Thất Tinh Liyue... Những đứa trẻ đó từ lâu đã không muốn bà lão ta cùng những đồng nghiệp già... đi giúp việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140307,
					"content": "Có điều, những năm gần đây họ đã làm rất tốt. Những người già chúng ta cũng nhàn nhã vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140308,
					"content": "Lẽ nào bà là người Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "Fatui? Hahaha, đứa trẻ này, cả ngày cứ nghĩ đến những chuyện không chính đáng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140310,
					"content": "Bà lão ta đã già rồi, không muốn đôi co nhiều với người ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140311,
					"content": "Có điều tay của họ nếu mà vươn dài thêm một chút, nên vất vả thì vẫn phải vất vả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Bình Lão Lão"
				}
			]
