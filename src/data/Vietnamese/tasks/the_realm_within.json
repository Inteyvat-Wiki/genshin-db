			"trigger": {
				"objectNames": [
					"Bình Lão Lão"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "Thế sự vô thường, thế sự vô thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140102,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "Này? Người trẻ tuổi, các cháu đến ngắm hoa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140104,
					"content": "Thật đáng tiếc, các cháu đến thật không đúng lúc, hoa Bách Hợp Lưu Ly sắp rụng hết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140107,
					"content": "Những đoá hoa này... Tại sao lại tàn hết rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140108,
					"content": "Vào thời của ta, mọi người nói rằng Bách Hợp Lưu Ly có thể hiểu được lòng người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140109,
					"content": "Nếu chúng nghe thấy những âm thanh đẹp đẽ như tiếng cười, tiếng hát... Chúng sẽ rất vui vẻ và nở thật nhiều hoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140110,
					"content": "Ngược lại, nếu nghe thấy quá nhiều những âm thanh không hay... như những tin đồn lộn xộn chúng sẽ khô héo rất nhanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140111,
					"content": "Vì vậy, những bông hoa này cũng cảm thấy được tình hình hiện tại của cảng Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140112,
					"content": "Đúng vậy, tin đồn về cái chết của Nham Vương Đế Quân không phải là chuyện nhỏ. Từ phố lớn đến hẻm nhỏ, tin đồn gì cũng có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140113,
					"content": "Có người nói rằng đó là âm mưu của Fatui, có người lại nói \"thứ ở dưới biển\" không giữ được nữa, còn có người nói tất cả đều do Thất Tinh tự biên tự diễn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140114,
					"content": "Bến cảng này giống như đống củi khô vậy. Chỉ cần một tia lửa là sẽ bùng cháy không thể dập tắt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140115,
					"content": "Ôi, dừng câu chuyện ở đây thôi, bà lão ta đã lớn tuổi rồi không thích lải nhải... Người trẻ tuổi, các cháu tìm ta có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140116,
					"content": "Muốn mượn \"Chuông Tẩy Trần\" của bà",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "Ừm, món đồ cũ đó à... Ta nhớ rồi. Đúng là có để ở chỗ ta đây, nhưng bà lão ta không còn nhớ rõ là đã để ở đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140118,
					"content": "Đó là món đồ vật đeo bên người của một người bạn của ta, khi ta còn trẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140119,
					"content": "Ông ấy thấy ta cứ nhìn chằm chằm vào nó nên đã tháo chiếc chuông và đưa cho ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140120,
					"content": "Năm đó ông ấy nói với ta rằng, nếu sau này có người đến mượn chiếc chuông này thì ta không được luyến tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140127,
					"content": "Nhiều năm qua đi, chiếc chuông này cũng không rõ đã được mượn bao nhiêu lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140128,
					"content": "Nhưng, không biết từ bao giờ đã rất lâu không có ai đến mượn chuông rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140129,
					"content": "Ôi, bộ xương già này của ta, tìm đồ đạc rất lâu, sợ là các cháu đợi không nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140130,
					"content": "Tụi con tự tìm là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "Đúng rồi, bà ơi, tụi con đi cùng bà về nhà, sau đó tụi con tự tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140132,
					"content": "Còn có thể giúp bà thu dọn nhà nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140135,
					"content": "Được rồi, các cháu đừng lo, chiếc chuông đó ta chỉ để đâu đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140136,
					"content": "Ấy? Bà ơi, bà sống ở gần đây sao? Oa... Đây là Ngọc Kinh Đài mà, thật là giàu có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140137,
					"content": "Ha ha, bà lão ta mua không nổi nhà trong thành phố, nhìn cái ấm này đi, tất cả tài sản của ta đều đặt trong nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140138,
					"content": "Tất cả tài sản...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140139,
					"content": "Ý của bà là đã để chìa khoá nhà trong đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "Ha ha ha... Tóm lại chiếc chuông nằm trong ấm này, các cháu hãy tự mình tìm xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140140,
					"content": "Tài sản của bà chỉ có một cái chuông thôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "Nói vậy thật là bất lịch sự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140142,
					"content": "Ngay cả như vậy, thì... Thì đó cũng là chiếc chuông quý giá! Phải không bà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140143,
					"content": "Paimon vào trong ấm xem xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "Không vào được! Làm cách nào tôi cũng không thể vào?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140145,
					"content": "Mà sao bạn lại muốn tôi vào trong đó, mở nắp ra xem không phải là được rồi sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140133,
					"content": "Con đã học tìm đồ vật với Đội Trưởng Đội Kỵ Sĩ Tây Phong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "Ừm... Đột nhiên lại bất ngờ cảm thấy tự hào nhỉ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140121,
					"content": "Muốn tìm bà để mượn một món đồ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "Cái gì? Ồ... các cháu muốn mượn Chuông Tẩy Trần phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140123,
					"content": "Ngoài món đồ cũ này ra, ta cũng chẳng còn thứ gì đáng để người trẻ tuổi các cháu đến thỉnh cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140124,
					"content": "Có điều chiếc chuông này vốn là đồ vật đeo bên người của một người bạn, chứ không phải là của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140125,
					"content": "Khi ta còn trẻ luôn ưa thích cái đẹp, thích cái chuông đó, nên đã bám lấy ông ấy cầu khẩn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140126,
					"content": "Ông ấy không thể chịu được, nên đã mang chuông tặng cho ta. Có điều ông ấy nói, nếu sau này có người đến mượn chiếc chuông này thì ta không được luyến tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 10140105,
					"content": "Bà sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "Không sao, chỉ là ta thấy Bách Hợp Lưu Ly rụng quá nhiều nên cảm thấy rất đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Bình Lão Lão"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
