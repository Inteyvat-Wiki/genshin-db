						10140404
					]
				},
				{
					"id": 10140404,
					"content": "Tất nhiên là quen rồi, không thì sao tôi biết được cái chuông đó đang ở chỗ bà ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140407,
					"content": "Hừm... Rất nhiều điểm đáng ngờ! Nhưng nếu anh không muốn nói, chúng tôi cũng không gặng hỏi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
