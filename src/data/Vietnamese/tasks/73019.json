			"dialogs": [
				{
					"id": 730190101,
					"content": "Phải hấp thụ thật nhiều nước nhé, mau lớn mới tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190102,
					"content": "Xin chào! Bạn là Ara...Ara gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190103,
					"content": "Bạn là anh trai của Arapacati sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "Ồ, chiêu này được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190107,
					"content": "...Lớn lên, lớn lên rồi trở thành món ăn ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190108,
					"content": "Hoàn toàn không nghe hiểu chữ nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190105,
					"content": "Arasaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "Arasaka! Bạn là Arasaka sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "Á! Là Nara... Cao quá, đáng sợ quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190202,
					"content": "Xin bạn đấy... Đừng hái mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190203,
					"content": "Được thôi, chúng tôi sẽ không hái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190204,
					"content": "Vậy thì tốt, hộc hộc... Số Đào Zaytun này đều do tôi trồng từng chút một, từ khi chúng vẫn còn là hạt giống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190205,
					"content": "Không, không phải, Nara xấu xa! Sao có thể tùy tiện hái Đào Zaytun do người khác trồng chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190206,
					"content": "Tại sao Nara lại, lại có thói quen đáng sợ như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190207,
					"content": "Chúng tôi chưa làm gì cả, còn chưa kịp hái mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190208,
					"content": "Chưa làm gì mà đã đáng sợ thế rồi, nếu các bạn làm gì thật thì tôi sẽ sợ chết mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190209,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190210,
					"content": "Không được, để Arasaka... nghĩ xem, vì số Đào Zaytun mình đã tốn công vun trồng, vì \"Luyện Nấu Ăn\"... Không thể chùn bước ở đây, nhất định không thể sợ hãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190211,
					"content": "Quả nhiên, bạn chính là Arasaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190212,
					"content": "Ôi, sao, sao các bạn lại biết tên tôi... Các bạn là Nara từ đâu tới thế... Sao, sao vừa thấy mặt đã biết tên tôi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190213,
					"content": "Chính bạn nói mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "Đúng là họa từ miệng mà ra. Toi rồi, tên tôi phải chịu lời nguyền đáng sợ rồi... Xin các bạn đó, tha cho tôi đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190215,
					"content": "Tôi sẽ làm bất cứ chuyện gì ngoại trừ việc đưa Đào Zaytun cho các bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190219,
					"content": "Không cần phải hốt hoảng như vậy đâu, thật ra chúng tôi được Arapacati ủy thác tới tìm bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190220,
					"content": "Ara, Arapacati? Người \"em gái\" thân yêu, ánh mặt trời giữa rừng sâu của tôi ư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190221,
					"content": "Kể lại những chuyện đã trải qua cho Arasaka nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "Ồ wow, sao, sao Lễ Hội Utsava Ơ, các bạn là Nara tới tham gia Lễ Hội Utsava lần này ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190223,
					"content": "Xin lỗi vì đã nói các bạn là Nara xấu. Các bạn chắc chắn là Nara tốt, vì chỉ Nara tốt mới được bước vào Vanarana, tham gia Lễ Hội Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190224,
					"content": "Lễ Hội Utsava sắp tới rồi, nếu chưa hoàn thành \"Luyện Nấu Ăn\" đã quay về Vanarana... Không được... Nhưng cũng không thể không tham gia Lễ Hội Utsava được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190225,
					"content": "Tại sao lại căng thẳng hơn rồi... Chẳng phải bạn vẫn còn Đào Zaytun bạn trồng à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190226,
					"content": "...Chỉ, chỉ có Đào Zaytun tôi trồng thì không đủ đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190227,
					"content": "Nhất định phải có được \"Hương Vị Hạnh Phúc\". Nếu không có \"Hương Vị Hạnh Phúc\", Đào Zaytun cũng chỉ là Đào Zaytun mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190228,
					"content": "Arachatora, Arapas và Araphala đều không tin có \"Hương Vị Hạnh Phúc\" tồn tại trên thế giới này. Tôi phải làm ra được cho họ thấy và cho cả Nara nếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190229,
					"content": "Hương Vị Hạnh Phúc?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "He he, \"Hương Vị Hạnh Phúc\", trước đây tôi từng được nếm thử một lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190232,
					"content": "\"Hương Vị Hạnh Phúc\" có màu trăng trắng, xoa nhẹ là vỡ... biến thành Valuka màu trắng, nhưng lại không vừa cứng vừa đau như Valuka. Nó chứa trong quả bóng cứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190233,
					"content": "...Valuka màu trắng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "Valuka màu trắng chính là cát màu trắng... nhỉ? Nhưng quả bóng cứng là cái gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190236,
					"content": "Ầy, không thể hiểu nổi. \"Hương Vị Hạnh Phúc\" ở đâu thế nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190237,
					"content": "Bạn, bạn hỏi cái này để làm gì. Chẳng lẽ bạn định cướp \"Hương Vị Hạnh Phúc\" đi trước tôi sao? Thật đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190238,
					"content": "Chúng tôi muốn giúp bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "Giúp tôi? Giúp tôi cái gì? Tự, tự tôi cũng tìm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190242,
					"content": "Chẳng qua ở đó có rất nhiều Nara qua lại. Hơn nữa, có một trong số đó, có mùi của Nara Valuka. Ôi... Tôi sợ lắm... nếu ít Nara một chút thì tôi cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190243,
					"content": "...Haiz, được rồi. Tôi không lấy được, tôi... không dám bước vào Làng Gandharva, ở đó có nhiều Nara quá. Hơn nữa còn toàn là cây đã chết, tôi sợ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190244,
					"content": "Tôi có một người bạn Nara ở trong đó, nhưng đã qua lâu lắm rồi. Bây giờ anh ấy đã thay đổi, không còn nghe được tiếng tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190245,
					"content": "Vậy à, vậy \"Hương Vị Hạnh Phúc\" mà bạn nói thật ra đang ở trong Làng Gandharva đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190246,
					"content": "Hương Vị Hạnh Phúc không phải mọc ra từ đất, mà do Nara tạo ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190247,
					"content": "Tôi rất muốn nếm lại một lần nữa. Tôi vẫn nhớ lần đầu tiên khi nếm thử hương vị ấy, lòng tôi vui vẻ thế nào. Đó là hương vị cực kì, cực kì lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190248,
					"content": "Ở trong rừng cùng người bạn Nara kia, đếm từng tia nắng rọi xuyên qua khe lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190249,
					"content": "Cùng nhau ca hát, cùng nhau nhấm nháp \"Hương Vị Hạnh Phúc\". Mỗi lần nhìn tia nắng rọi qua khe lá, tôi lại nhớ đến anh ấy. Mỗi lần nghĩ đến anh ấy, tôi lại nhớ về \"Hương Vị Hạnh Phúc\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190250,
					"content": "Vì thế tôi muốn cho Arapacati nếm thử hương vị này. Hơn nữa chờ đến khi Lễ Hội Utsava bắt đầu, tôi cũng muốn cho Nara nếm thử hương vị này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190251,
					"content": "#Tôi hiểu rồi, cứ giao cho tôi và {NICKNAME} đi! Đúng không, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190252,
					"content": "Tôi cũng muốn được vui vẻ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "Thật ư? Các bạn không lừa tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190255,
					"content": "Không hề!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190256,
					"content": "Nhưng trong Làng Gandharva nhiều người như thế, nên đi đâu tìm đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190257,
					"content": "Tôi biết rồi. Cách đây không lâu, tôi thấy một Nara đi ngang qua chỗ này, <color=#00E1FFFF>đến Làng Gandharva</color>. Anh ta có mang theo nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190258,
					"content": "Trên lưng anh ta đeo một thứ phồng phồng, là thứ mà Nara dùng để đựng đồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190259,
					"content": "Trên lưng đeo một thứ phồng phồng... Hừm, <color=#00E1FFFF>chắc là bọc hành lý hay sọt đựng đồ</color> gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190260,
					"content": "Biết rồi, chúng tôi đi tìm \"Hương Vị Hạnh Phúc\" giúp bạn ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190253,
					"content": "Nếu đã đồng ý với Arapacati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "Ồ! Paimon, bạn thật đáng sợ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "Này! Tôi chỉ định giúp Arasaka thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190234,
					"content": "...Quả bóng cứng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "\"Hương Vị Hạnh Phúc\" mà bạn nói là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "Chúng tôi đã biết từ lâu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "Cái gì! Biết từ lâu rồi? Hóa ra các bạn theo dõi tôi từ lâu rồi ư... Chẳng, chẳng lẽ các bạn định cướp thứ gì từ tôi à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190218,
					"content": "Chẳng lẽ là Đào Zaytun? Không, không được, nếu là thứ khác thì tôi chắc chắn sẽ đưa cho các bạn... Nhưng, nhưng Đào Zaytun thì không, bất kể thế nào cũng không được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				}
			]
		},
