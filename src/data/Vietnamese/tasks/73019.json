			"dialogs": [
				{
					"id": 730190401,
					"content": "Xin chào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190402,
					"content": "Ưm, chào các bạn... sao vậy, muốn mua gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190403,
					"content": "Đúng vậy, thật ra chúng tôi muốn một thứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190404,
					"content": "Haha, tất nhiên rồi, ai tới đây chẳng muốn \"một thứ\". Nhưng chỉ nói \"một thứ\" thì tôi không biết các bạn muốn \"thứ gì\" đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190405,
					"content": "Ừm... Tôi biết rồi. Nói thế nào nhỉ, chúng tôi muốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190406,
					"content": "Trắng trắng vuông vuông...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "Trắng trắng vuông vuông?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190408,
					"content": "Đúng, xoa nhẹ thì vỡ thành cát, lại còn đựng trong quả bóng cứng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190409,
					"content": "Miêu tả nghe kỳ lạ thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190410,
					"content": "Nghe các bạn nói thế tôi cũng không rõ là gì nữa. Thứ trắng trắng vuông vuông mà các bạn nói dùng để làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190411,
					"content": "Công dụng, công dụng chắc phải biết đấy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190412,
					"content": "Có thể ăn được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "Ăn được, trắng trắng vuông vuông...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190416,
					"content": "A! Tôi biết rồi, tôi biết các bạn muốn thứ gì rồi... Hahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190417,
					"content": "Buồn cười thế à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190418,
					"content": "Ôi trời, há há há há há, tôi bảo này, trắng trắng vuông vuông, xoa nhẹ là vỡ thành cát... lại còn ăn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190419,
					"content": "Đó chẳng phải là \"đường\" à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190420,
					"content": "Quả bóng cứng, đừng bảo là bình thủy tinh đựng đường đấy nhé. Ôi trời ơi, quả bóng cứng, hahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190421,
					"content": "Gì chứ, hóa ra là đường à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190422,
					"content": "Thấy hơi ngại...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "Ôi trời, tôi cười chảy nước mắt mất. Mấy năm nay bôn ba làm ăn, không biết lần cuối tôi cười thế này là từ khi nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190425,
					"content": "Kể ra cũng hoài niệm, tôi vẫn nhớ hồi xưa... lúc tôi vẫn còn là đứa trẻ. Khi ấy tôi có người bạn, lần đầu tiên được ăn đường, cũng nói giống như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190426,
					"content": "\"Cái thứ trắng trắng vuông vuông này ăn ngon thật! Lợi hại ghê! Hương Vị Hạnh Phúc.\" cậu ấy ngạc nhiên dữ lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190427,
					"content": "Haha... Chuyện này không biết đã bao nhiêu năm về trước rồi. Giờ nghĩ lại, tôi cũng không nhớ nổi người bạn ấy trông như thế nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190428,
					"content": "Ôi, coi như món quà đáp lễ vì các bạn khiến tôi cười vui như thế, lọ đường này các bạn cầm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190429,
					"content": "Cảm ơn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "Phải chú ý, cầm cho cẩn thận đấy, tuy Bong Bóng Cứng rất cứng nhưng nó vẫn sẽ bị vỡ nếu làm rớt xuống đất. \"Bong Bóng Cứng\", hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190423,
					"content": "Thấy hơi xấu hổ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "Dùng để nấu nướng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "Dùng để nấu nướng, trắng trắng vuông vuông, chẳng lẽ là gia vị?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
