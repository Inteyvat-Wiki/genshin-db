			"dialogs": [
				{
					"id": 730190501,
					"content": "Gia đình tôi vẫn luôn buôn bán trên con đường này, từ Vực Đá Sâu tới Sumeru. Nhập khẩu quặng đá quý thô từ Liyue, rồi vận chuyển hương liệu đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Có một lần, vì chuyện gì đó... tôi không nhớ nữa. Dù sao thì cha tôi đã bỏ tôi lại Làng Gandharva một khoảng thời gian rất lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "Tôi nhớ khi ấy tôi quen một người bạn trong rừng. Chúng tôi cùng nhau chạy khắp nơi, về sau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "Chuyện sau đấy, tôi không nhớ rõ nữa. Anh ấy tên gì, hình dáng ra sao đều không nhớ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "Tôi chỉ nhớ khi ấy hình như rất vui. Về sau cha tôi quay lại đón tôi đi. Tôi luôn nghĩ phải quay về đó tìm anh ấy, nhưng không có cơ hội, sau này thì quên mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "Nếu bạn không hỏi tôi mua đường, chắc tôi đã sớm quên sạch những chuyện này. Sao lại vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301906,
			"completionStepIds": [
				7301906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301906",
							"2"
						],
						"stepId": 7301906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arasaka",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "Chính là cái này! Không ngờ các bạn mang về nhanh như thế... Là thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190602,
					"content": "Chắc không phải vì muốn gạt tôi, nên, nên các bạn đã làm giả ra đâu nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190603,
					"content": "Dựa vào những miêu tả của bạn, làm giả được mới là lạ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190604,
					"content": "Nếu bạn không yên tâm thì tự nếm thử đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190605,
					"content": "...Các bạn sẽ không bỏ mấy thứ kỳ lạ vào trong đâu nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190606,
					"content": "Tất nhiên là không rồi, hừ, thế bạn có ăn thử hay không đây, nếu không thì chúng tôi mang đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190607,
					"content": "Không, không được... Các bạn đừng mang đi, để tôi, để tôi nếm thử xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190608,
					"content": "Đừng mang đi mà, giờ tôi nếm thử ngay, nếm thử ngay... Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190609,
					"content": "A, là thật... Là \"Hương Vị Hạnh Phúc\", chính là mùi vị này... Hì hì... Được nếm lại lần nữa, vẫn thấy vui làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190610,
					"content": "Không ngờ lại có thể nếm được mùi vị này... Chà, nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190611,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "Chà... phải nói sao nhỉ... \"Hương Vị Hạnh Phúc\" vẫn giống như trước, nhưng không hiểu tại sao lại không thấy vui vẻ như lần đầu ăn nó nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190614,
					"content": "Chẳng lẽ anh ta đưa đường không ngọt cho chúng ta sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190615,
					"content": "Không phải, không phải là sự khác biệt về hương vị... Rõ ràng lúc trước tôi đi ăn với bạn... Đó là lần đầu tiên tôi nếm được \"Hương Vị Hạnh Phúc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190616,
					"content": "Tôi cảm thấy lúc đó vui vẻ hơn bây giờ rất nhiều, rốt cuộc tại sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190617,
					"content": "#Chẳng phải rất bình thường sao, cho dù cùng một món ăn nhưng hương vị {NICKNAME} làm ra mỗi lần mỗi khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190618,
					"content": "Lúc tôi ăn cũng thấy khác nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190619,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "... Không, không thể nào, phải có cách nào đó khiến tôi cảm thấy vui vẻ như lần đầu tiên được nếm \"Hương Vị Hạnh Phúc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190622,
					"content": "Tôi biết rồi, lúc đó tôi đã ăn với bạn. Cho nên, \"Hương Vị Hạnh Phúc\" trở nên ngon miệng hơn vì ăn cùng với bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190623,
					"content": "Nhất định là như thế. Các bạn là Nara tốt, hơn nữa còn tìm thấy \"Hương Vị Hạnh Phúc\". Các bạn là bạn bè. Tôi muốn nấu cho các bạn ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190624,
					"content": "Ừm, chúng ta là bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190625,
					"content": "Arasaka lập tức đi nấu ăn, cho Đào Zaytun và đường vào nồi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "Sau đó, Arasaka đưa thành phẩm cho bạn và Paimon.\\nQuả nhiên, không có vị gì khác ngoài \"vị ngọt\".\\nCó lẽ đây là \"Hương Vị Hạnh Phúc\" nhỉ.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "A, đúng là hương vị hạnh phúc. Ngon quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190628,
					"content": "Ừm, món này rất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190629,
					"content": "Rất \"hạnh phúc\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190630,
					"content": "Ngọt quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "Tôi cũng thấy nó ngọt quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190633,
					"content": "Thế, thế à, ôi, hình như tôi lỡ bỏ nhiều quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190634,
					"content": "Nhưng... hì hì, quả nhiên \"Hương Vị Hạnh Phúc\" sẽ hạnh phúc hơn nếu chia sẻ với bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190635,
					"content": "Tuy khác với cảm giác sung sướng khi lần đầu tiên được nếm \"Hương Vị Hạnh Phúc\", nhưng được ăn cùng các bạn... Tôi lại cảm thấy một loại hạnh phúc khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190636,
					"content": "Bạn thấy vui là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "Ban đầu tôi còn nghi ngờ các bạn có ý xấu, nhưng các bạn lại bỏ qua ân oán trước đây, còn giúp tôi tìm được \"Hương Vị Hạnh Phúc\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190639,
					"content": "Với sự giúp đỡ của các bạn, tôi mới có thể hoàn thành \"Món Ăn Quý Nhất\", hoàn thành \"Luyện Nấu Ăn\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190640,
					"content": "Có gì đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190641,
					"content": "Sao, sao lại nói thế, các bạn đã giúp tôi rất nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190642,
					"content": "Phải rồi. Tôi dạy các bạn cách làm món này nhé. Thế thì sau này các bạn có thể chia sẻ \"Hương Vị Hạnh Phúc\" với bạn bè rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190643,
					"content": "(Ừm... Nếu như thay đổi tỷ lệ nguyên liệu, lại thêm vài thứ khác, chắc hẳn có thể tạo ra một món ngon đó...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190637,
					"content": "Tôi muốn uống nước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "Tôi muốn uống nước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "Còn có thể như thế sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "Có vấn đề gì à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				}
			]
		},
