				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "Wow, lại ra ngoài rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750802,
					"content": "Mona, nhà mạo hiểm kia... thật sự đã chết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750803,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750804,
					"content": "Tôi chỉ mới gặp anh ta có một lần. Tới nay đã hơn ba năm rồi, nên... chắc là anh ta đã không còn trên đời này nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750805,
					"content": "Nhưng mà, không có một chút khả năng nào là anh ta vẫn còn sống, chỉ là Mona đã bói sai hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750806,
					"content": "Nhưng như vậy không công bằng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "Gặp chuyện xấu thì không tin, gặp chuyện tốt thì lại tin răm rắp. Như vậy không thể gọi là xem bói được, mà chỉ có thể xem là tự an ủi bản thân mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750808,
					"content": "Để giải trí mỗi ngày thì không sao, nhưng cái mà tôi học không phải là trò nói dối đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750809,
					"content": "Chối bỏ kết luận của mình là một điều sỉ nhục đối với thuật chiêm tinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750810,
					"content": "Tàn nhẫn, nhưng cũng chân thật. Số phận là thứ như vậy đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750811,
					"content": "Bình thường tôi sẽ không nói mấy lời này đâu, nhưng hy vọng mọi người đừng đánh đồng thuật chiêm tinh với mấy trò rút thăm của mấy quầy hàng lề đường làm một.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750812,
					"content": "Chúng tôi nghiên cứu tinh tượng, không phải là để nói tốt để cho người ta có một ngày vui vẻ, mà là để kiểm tra và xác minh sự thật của thế giới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750813,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750814,
					"content": "Ah...! Cho nên tôi mới nói, chiêm tinh là một nghề bị nhiều người ghét! Sự vĩ đại và khiến người ta chán ghét không liên quan gì đến nhau cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750815,
					"content": "Sao tự nhiên lại ồn ào như thế chứ? Ngươi cũng đâu phải là loại người không đáng để giao lưu đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750816,
					"content": "Ý của tiểu thư là, rất vui khi được làm bạn với cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750817,
					"content": "Không phải! Ta không có nói vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750818,
					"content": "Oz, ngươi sao thế? Càng ngày càng thích xuyên tạc lời nói của ta mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750819,
					"content": "Ơ, sao lại thế được nhỉ, hay do tôi quá lo lắng tiểu thư sẽ đắc tội với bạn bè nên cố tình nói giảm nói tránh sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750820,
					"content": "Kiến thức của tôi không rộng như thế, nên tôi chỉ biết một nhà chiêm tinh là Mona thôi. Mà ấn tượng của cô để lại cho tôi hoàn toàn không có sự chán ghét nào cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750821,
					"content": "Những người cứ thích nghe ngóng tương lai của mình, nhưng lại vứt bỏ những kết quả không vừa ý mới cần phải tự mình kiểm điểm lại. Số phận không phải là thứ rẻ tiền như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750822,
					"content": "Nếu số phận là thứ có thể bịa ra để lãng tránh, vậy thì trên thế gian này đã không còn khổ đau rồi. Mona, đừng để bụng chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750823,
					"content": "Cứ làm theo con tim mách bảo, luôn hướng về điều đúng đắn, như vậy là đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750824,
					"content": "Khụ khụ... cũng không cần phải quan tâm tôi kỹ như vậy, tôi kiên cường lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750825,
					"content": "Đôi tai của cô ửng đỏ hết luôn rồi kìa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "Hả, à ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750827,
					"content": "Được rồi, vậy... vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750828,
					"content": "Cảm ơn... mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750829,
					"content": "Nghe không rõ, hãy dõng dạc dâng lời chúc phúc thành kính của ngươi lên cho bổn công chúa nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750830,
					"content": "Được rồi, đừng đấu khẩu nữa, chúng ta nên đi thu hồi các mảnh vỡ khác ở địa điểm mới đi. Không có thứ đó thì chúng ta không thể vào ảo cảnh được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750831,
					"content": "Chỉ có đôi mắt tinh tường của tiểu thư mới có thể nhìn thấu bí mật thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750832,
					"content": "Nếu đã vậy thì được rồi, bổn công chúa sẽ đích thân đi tới bãi biển...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750833,
					"content": "Đi thôi, Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750834,
					"content": "À ừm! Tới ngay đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750835,
					"content": "...Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		}
	]
}