						221030302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030302,
					"content": "Xử lý xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "Tốt quá rồi... Tóm lại có thể an tâm làm ăn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030304,
					"content": "Đây là quà cho bạn, mau nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030305,
					"content": "\"Vị khách đó\" là ai? Ừm... Bạn chưa gặp anh ấy bao giờ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030306,
					"content": "Anh ấy có lúc lên trên nóc nhà trọ nghỉ ngơi, có lẽ bạn cũng gặp qua rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030307,
					"content": "Có điều, nếu bạn có gặp anh ấy, thì tốt nhất đừng có làm phiền anh ấy, anh ấy thích ở một mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
