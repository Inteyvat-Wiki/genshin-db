				{
					"id": 221030201,
					"content": "Xử lý xong hết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030202,
					"content": "Vẫn chưa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "Mong bạn nhanh xử lý, vị khách ấy đến và đi như cơn gió... Cũng không biết khi nào quay trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030204,
					"content": "Nếu anh ấy thực sự ra tay thì nhà trọ coi như đóng cửa luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
