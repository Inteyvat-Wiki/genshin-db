					}
				]
			},
			"dialogs": [
				{
					"id": 746870301,
					"content": "Tuyệt, người thay ca đến rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870302,
					"content": "Ơ? Sao lại là các vị?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870303,
					"content": "Là chúng tôi... thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "Hình như cô biết chúng tôi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870305,
					"content": "Không có vấn đề gì đâu. Rất tốt là đằng khác, vì các vị vốn nổi tiếng mạnh mẽ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870306,
					"content": "Khi ở trong đơn vị và sau khi về làng, mọi người đều nói việc gì cũng đều có thể yên tâm giao cho các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870311,
					"content": "So ra thì, hai đồng nghiệp bên kia tuy đều rất đáng tin cậy, nhưng luôn cảm thấy giữa hai người họ có chút gì đó gượng gạo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870312,
					"content": "Tình cảm của con người thật phức tạp... Có nên thúc đẩy họ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870313,
					"content": "Gượng gạo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "Thôi bỏ đi, chuyện chính vẫn quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870315,
					"content": "Tóm lại, hãy cố lên nhé. Khẩu pháo đó không khó điều khiển đâu, tin chắc các vị sẽ nhanh chóng diệt sạch mục tiêu thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870307,
					"content": "Hình như chúng ta đã từng gặp nhau rồi nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "#{F#Cô}{M#Cậu} vẫn còn nhớ tôi sao? Lúc trước \"Phim Trường Vui Vẻ Chevalmarin\" tuyển dụng nhân viên, tôi cũng từng gửi hồ sơ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870309,
					"content": "Hình như đúng là có chuyện này thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870310,
					"content": "Tôi biết các vị rất giỏi, chuyện gì cũng có thể yên tâm giao cho các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				}
			]
		}
	]
