			"dialogs": [
				{
					"id": 746870101,
					"content": "Sự việc kéo dài hơn nửa ngày rồi mà ma vật vẫn chưa có dấu hiệu giảm bớt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870102,
					"content": "Hay là tôi đi gọi viện trợ nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870103,
					"content": "Đừng lo lắng, hãy tin vào khẩu pháo của tôi và vị đồng nghiệp mặc thường phục kia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870104,
					"content": "Ngoài ra, nhà mạo hiểm có khả năng đánh hơi nguy hiểm, hay thậm chí là vị chỉ huy nào đó... chắc cũng sẽ đến ngay thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870105,
					"content": "Lại có nguy hiểm gì à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "Xuất hiện rồi... Đội phó đã dẫn theo cả trợ thủ nhỏ đến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870108,
					"content": "Xin chào hai vị, để tôi nói sơ qua về tình hình nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870109,
					"content": "Hihi, tiền bối nghỉ ngơi chút đi, việc này cứ để tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870110,
					"content": "Ahem! Muốn điều khiển pháo để càn quét sao? Sau khi hạm đội hải quân bị tiêu diệt hoàn toàn thì hiếm lắm mới có được cơ hội này đấy, nói là như được quay lại mấy trăm năm trước cũng không hề quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870111,
					"content": "Dùng đầu đạn đặc chế quét bay từng đợt ma vật, nghĩ thôi cũng thấy rất sảng khoái, hơn nữa còn nhận được tiền thưởng của Đội Hiến Binh nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870112,
					"content": "Dùng pháo để bắn ma vật à... Chuyện này thì đúng là sở trường của chúng ta đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870113,
					"content": "Nghe có vẻ đúng là không phức tạp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "Tiền bối, tôi hiểu tâm trạng vui mừng này. Nhưng tình hình hiện tại có phần nghiêm trọng, hãy để tôi giải thích cho đội phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870116,
					"content": "Dạo gần đây, các công nhân đã vô tình đào được một di tích dưới mặt đất, đánh thức ma vật ngủ say bên trong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870117,
					"content": "Để ma vật không thoát ra ngoài, Đội Hiến Binh đã thành lập trận địa phòng thủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870118,
					"content": "Có điều, nói là trận địa... Nhưng hiện tại chỉ có hai người chúng tôi và một đặc vụ Melusine đang trong kỳ nghỉ, cùng bệ pháo mà chúng tôi đã cải tiến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870119,
					"content": "Ối! Nghe hơi nguy hiểm đó! Vị đặc vụ Melusine đó không sao chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870120,
					"content": "Xin hãy yên tâm. Pháo ở lối vào di tích được điều khiển từ xa, vị Melusine đó không cần đích thân ra trận cũng có thể ngăn được phần lớn ma vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870121,
					"content": "Cô ấy đúng là rất đáng tin cậy, nhưng làm nhiệm vụ cường độ cao trong thời gian dài chắc chắn sẽ mệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870122,
					"content": "Đội phó có thể giúp chúng tôi không? Nếu tình hình còn tiếp tục bất ổn như vậy, tôi sẽ tìm thêm nhiều chi viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870123,
					"content": "#Chenee, cô cũng biết năng lực của đội phó mà, nên cứ dự tính theo chiều hướng tốt nhất đi... Là {F#cô}{M#cậu} ấy sẽ dùng bệ pháo của tôi để tiêu diệt tất cả ma vật!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870124,
					"content": "Đúng là tôi cũng có hứng thú dùng thử pháo đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "Dù sao thì nhắm mắt làm ngơ cũng không phải tác phong của chúng ta mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870127,
					"content": "Vậy thì tuyệt quá, cảm ơn mọi người đã giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870128,
					"content": "Sau lần thử nghiệm trước, tôi đã điều chỉnh lại phát minh của mình, hy vọng các vị dùng thuận tay hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870129,
					"content": "Haiz, nếu pháo có thể tự ngắm chuẩn rồi tự bắn thì tốt rồi... Tiền bối thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870130,
					"content": "Đúng vậy! Lần sau tôi sẽ thử lắp mô-đun nhận dạng của Robot Hiến Binh lên trên pháo, để chúng tự canh gác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870131,
					"content": "Không hổ danh là tiền bối, thật thông minh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870125,
					"content": "Dù tình hình ra sao thì tôi cũng muốn giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "Nhưng sao đột nhiên lại bắn ma vật vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "Chúng tôi đến vừa đúng lúc à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
