			"dialogs": [
				{
					"id": 750013301,
					"content": "Kỳ lạ... Tại sao những hoa văn màu vàng đó cũng bay qua như lúc trước... Nhưng phía dưới trụ lại không xuất hiện Chữ Khắc Lấp Lánh nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013302,
					"content": "Chứng tỏ Chữ Khắc Lấp Lánh ở đây không những bị ép ra ngoài, mà còn mất đi độ hoàn chỉnh nữa... Cứ thế này thì phiền phức đấy, còn phải tìm Chữ Khắc Lấp Lánh bị phân tán nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013303
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013303,
					"content": "Vậy Chữ Khắc Lấp Lánh bị phân tán đang ở đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013304,
					"content": "...Tôi cũng không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013305
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013305,
					"content": "Chậc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013306,
					"content": "Tuy bị phân tán, nhưng dù sao cũng bị ràng buộc bởi sức mạnh, nên chắc sẽ ở xung quanh đây thôi. Chúng ta tìm thử xem nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013307
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013307,
					"content": "Rawr, rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013308,
					"content": "#Sao vậy, muốn qua bên đó à? Hiện giờ {NICKNAME} đang có việc quan trọng hơn rồi. Đợi lát nữa chơi với nhóc nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013309,
					"content": "Mmm... Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013310,
					"content": "Ý là, chữ khắc đang ở bên đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013311
					]
				},
				{
					"id": 750013311,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013312,
					"content": "Hmm, tôi nghe nói vẫn còn có những Saurian cảm nhận được sức mạnh của Chữ Khắc Lấp Lánh. Lúc trước cứ tưởng là tin đồn, không ngờ là thật nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013313
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013313,
					"content": "#Quả nhiên {REALNAME[ID(2)|SHOWHOST(true)]} không phải loài Tepetlisaurus tầm thường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013314
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013314,
					"content": "Thì ra nhóc còn có năng lực này sao? Hmm... Nhưng so với người dẫn đường như ta thì vẫn còn kém xa lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013315,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013316,
						750013318
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013316,
					"content": "Paimon đang ghen tị đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013317
					]
				},
				{
					"id": 750013317,
					"content": "Còn lâu nhé. Tôi rộng lượng hơn mọi người nghĩ đấy! Cái này... chỉ là một cách để tôi khen ngợi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013320,
					"content": "Hmm... hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013321,
					"content": "Haiz, cậu nhóc này thật không hiểu gì cả... Nếu thông minh hơn chút nữa thì tốt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013322,
					"content": "Sẽ có lúc nó nghe hiểu được thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013323
					]
				},
				{
					"id": 750013323,
					"content": "Đúng đấy. Hơn nữa những người phụ trách chăm sóc Saurian trong tộc đều nói, muốn có được mối liên hệ cảm xúc với Saurian thì phải cần rất nhiều thời gian đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013324
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013324,
					"content": "Mà bí quyết để hòa nhập với Saurian là: Kiên nhẫn và không ngừng giao tiếp. Mối liên hệ này sẽ cần rất nhiều thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013325
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013325,
					"content": "#Phải đấy... Giống như lúc nãy tôi cũng không nhận ra {REALNAME[ID(2)|SHOWHOST(true)]} đang muốn nói gì đó với chúng ta vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013326,
					"content": "#Xin lỗi nhé, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013327,
					"content": "Mmm, Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013328,
					"content": "Đáp lại cũng nhanh đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013329,
					"content": "Được rồi, vậy hãy đi về hướng nhóc muốn nhé. Đi tìm xem có hoa văn màu vàng nào không đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013318,
					"content": "Paimon đang khen đó!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013319
					]
				},
				{
					"id": 750013319,
					"content": "Chính xác, đó chính là lời khen. Nhưng không được vì thế mà tự cao tự đại nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}