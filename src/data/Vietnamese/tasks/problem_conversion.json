			"dialogs": [
				{
					"id": 230190401,
					"content": "Sao rồi, bạn đã kiểm tra con thuyền đó xong rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190402,
					"content": "Đã kiểm tra xong rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Thuật lại tình trạng của con thuyền...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "Hóa ra là thế, những cấu trúc dùng thủ thuật để tiết kiệm tiền quả nhiên đã xảy ra vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190405,
					"content": "Nhưng sửa lại cấu trúc này tốn rất nhiều tiền, tôi nhớ chủ của con thuyền này túng thiếu lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190406,
					"content": "Ôi, tôi vẫn nên đi nói chuyện với anh ấy, mạng sống chắc chắn quan trọng hơn tiền bạc rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
