			"trigger": {
				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Quả nhiên, làm thế sẽ càng tốn nhiều tiền hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "Anh đang nói gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "À, xin chào, tôi đang nghiên cứu vấn đề thiết kế cho tàu, bây giờ... đang gặp chút khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "Nói một cách đơn giản, tôi muốn làm cho chiếc thuyền chứa được nhiều thứ hơn mà không phải tăng chi phí chế tạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "Một khi trọng lượng tăng, cấu trúc sẽ dễ bị vỡ, trong tình huống trọng lượng không đồng đều sẽ xảy ra vấn đề về cân bằng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "Cách tốt nhất để giải quyết những vấn đề này chính là sử dụng những vật liệu tốt hơn, nhưng thế thì... lại quay về vấn đề chi phí chế tạo rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "Ôi, nói thẳng ra là tôi không có tiền, nhưng lại muốn đóng ra một chiếc thuyền tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "Vì thế với những vấn đề có thể giải quyết bằng tiền, tôi chỉ có thể tìm cách vượt qua bằng một số phương tiện kỹ thuật thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "Thật sự có thể làm như thế sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Hahaha, nói ra có thể bạn không tin, nhưng thật sự có rất nhiều người đã làm như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "Dù sao những con thuyền chúng tôi đóng đều là thuyền đánh bắt gần bờ, sẽ không gặp phải bão tố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "Mọi người đều tuân thủ nguyên tắc tiết kiệm được thì tiết kiệm, có thể sửa được thì sửa lại... Cứ chắp vá lại, có thể sử dụng là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "Nhờ nguyên tắc này mà việc làm ăn sửa tàu của chúng tôi ngày nào cũng rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "Nhà Lữ Hành, nếu được thì bạn giúp tôi qua đó kiểm tra con tàu vừa cập cảng nhé, có vẻ nó đang xảy ra vấn đề vì thường xuyên chở đồ nặng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "Đúng lúc tôi đang nghiên cứu vấn đề này, biết đâu chừng tôi có thể tìm thấy chút cảm hứng từ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "Vậy nhờ bạn nhé! Tôi phải mau chóng đi sửa một chiếc thuyền khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "Anh không đi à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Tôi cũng muốn tự đi lắm, nhưng tôi được người ta nhờ đi sửa một con thuyền đang cần gấp để ra biển thu lưới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "Cho nên đành phải nhờ bạn rồi, Nhà Lữ Hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
