						120000622
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000622,
					"content": "Phái Đậu Hoa à, người cũng không có, mà bản lĩnh cũng chẳng thấy, chỉ có lá gan là không nhỏ nhỉ.",
