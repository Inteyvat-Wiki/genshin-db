				},
				{
					"id": 120001003,
					"content": "Không ngờ bạn có \"Vision\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "Ừm, chỉ là dùng Vision đánh địch có chút ỷ mạnh hiếp yếu, nên tôi không thích dùng cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001008,
					"content": "Bây giờ bọn họ đi rồi, nhưng nhất định sẽ quay lại kiếm chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001009,
					"content": "Tôi biết, tôi sẽ không hại ân nhân của tôi, buôn bán có quy luật, việc này tôi sẽ phụ trách đến cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001010,
					"content": "Fatui thông thường sẽ không đứng về phía thương nhân nào, nhưng thái độ hống hách của tên gia đinh đó, chắc là không phải nói dối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001011,
					"content": "Trong đây chắc là có ẩn tình riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001012,
					"content": "Lúc nãy họ nhắc đến Mậu Tài Công, cái tên này tôi có nghe qua, nhà của hắn ở cảng Liyue rất nổi bật, nhờ các bạn đi nghe ngóng chút manh mối vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001013,
					"content": "Cũng hợp lý... vậy thì bạn làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001014,
					"content": "Tôi? Tôi vẫn còn những việc khác muốn làm rõ, tôi nghĩ... chút nữa chúng ta gặp nhau ở Ngọc Kinh Đài ở cảng Liyue nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001015,
					"content": "Thật vậy sao? Không phải chỉ là muốn sai khiến chúng tôi chạy việc chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001016,
					"content": "Ừm ừm, không ngờ là xảy ra việc như vậy, đoạn này thật là hay, hay không tả nổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001017,
					"content": "Huhuhu! Tức chết mất! Tôi có thể đánh hắn không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001018,
					"content": "Giúp Thường Cửu Gia trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "Được rồi, nhưng những người chọc tôi tức giận tôi đều phải đặt cho hắn một biệt danh khó nghe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001021,
					"content": "Gọi hắn là \"tên mọt sách\" là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001019,
					"content": "Quân tử báo thù, mười năm chưa muộn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001005,
					"content": "Thực chất phái Cổ Hoa là nơi ngọa hổ tàng long?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001006
					]
				},
				{
					"id": 120001006,
					"content": "Không không không, bạn hiểu lầm rồi, lời lúc nãy tên đó nói mặc dù khó nghe, nhưng đánh giá về phái Cổ Hoa... cũng không sai... haiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001007
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001007,
					"content": "Tuy là tôi có nguyện vọng chấn hưng sư môn, nhưng cũng không phải là chuyện một sớm một chiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				}
			]
		},
