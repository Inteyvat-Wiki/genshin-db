					"nextDialogs": [
						120000626
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000626,
					"content": "Mời về cho, ép mua ép bán tôi không thể chấp nhận, huống hồ là Thường Cửu Gia có ơn với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000627,
					"content": "Tên tiểu tử, xem ra lại muốn ra mặt giúp lão Thường?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000628,
					"content": "Vậy thì ngươi đến không đúng lúc rồi, nhìn xem, hôm nay có đại nhân Fatui chống lưng cho ta, mấy chục phái Cổ Hoa cộng lại cũng không dám đắc tội!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000629,
					"content": "Tại hạ tuy nhỏ tuổi, cũng hành tẩu giang hồ nhiều năm, đối diện với kẻ ác có bao giờ sợ hãi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000630,
					"content": "Vậy thì cho ngươi chút giáo huấn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000618,
					"content": "Tôi không nghĩ bạn có cách...",
