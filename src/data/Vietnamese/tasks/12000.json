				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "Vạn Văn Tập... đây là tiệm sách ở cảng Liyue mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000202,
					"content": "Có muốn hỏi xem ở đây có chương Liyue trong [Hướng Dẫn Du Ngoạn Teyvat] hay không? Quyển đó hay lắm đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "A, cứ xem tự nhiên, không mua cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000302,
					"content": "Chúng tôi đến để tìm sách, ở đây có chương Liyue trong [Hướng Dẫn Du Ngoạn Teyvat] không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000303,
					"content": "Ồ, quyển sách đó đã ngưng bán từ lâu rồi, không được yêu thích lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000304,
					"content": "Hở?! Rõ ràng quyển Mondstadt thú vị như vậy... thật đáng tiếc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000305,
					"content": "Tác giả quyển sách này cũng thật có cá tính, nói là hướng dẫn, nhưng sự thật là không có tác dụng hướng dẫn gì cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000306,
					"content": "Không những bán không được, tôi còn từng bị khách hàng khiếu nại vì quyển sách này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000307,
					"content": "Phong cách cá nhân mạnh quá phải không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "Nhưng tôi vẫn cảm thấy rất tiếc, cứ coi quyển Mondstadt như là ký sự mạo hiểm để đọc cũng rất thú vị mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000310,
					"content": "Dù gì thì chỗ tôi cũng không có, nếu thật sự muốn xem, có thể đến chỗ Thường Cửu Gia thử vận may.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000311,
					"content": "Thường Cửu Gia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000312,
					"content": "Ngài ấy sống ở Khinh Sách Trang, sưu tập các loại sách. Tuy là tính khí thất thường, nhưng rất thích bàn luận về việc sưu tập sách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000313,
					"content": "Khi còn ở Liyue, ngài ấy là khách quen của tôi, còn hiện tại tôi thỉnh thoảng cũng gửi vài quyển sách đã ngừng xuất bản cho ngài ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000324,
					"content": "Nhưng chỗ ngài ấy ở rất khó tìm, phải men theo con đường nhỏ ở ngọn núi phía sau Khinh Sách Trang leo lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000314,
					"content": "Bạn bảo, tuyệt bản tàng thư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000315,
					"content": "Cuốn Thần Tiêu Trảm Kích Lục quyển thứ 6 đã ngưng xuất bản, cũng có khả năng ở trong bộ sưu tập của ngài ấy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000316,
					"content": "Bạn là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "Thất lễ rồi, tại hạ là Xingqiu, chỉ là một người yêu sách đi ngang qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000319,
					"content": "Nếu bạn và tôi đều đang tìm sách, vậy tại sao không cùng nhau đến Khinh Sách Sơn, bái kiến vị Thường Cửu Gia đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000320,
					"content": "Cũng có lý, vậy thì phiền bạn dẫn đường rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "Đều là những người yêu sách, không cần khách sáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000322,
					"content": "Thực ra tôi không muốn đi xa vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "Đừng nói như vậy mà, cảng Liyue quá náo nhiệt, thỉnh thoảng cũng cần đi một nơi yên tĩnh để nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000317,
					"content": "Lén la lén lút, dọa người ta sợ chết khiếp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "Có mục nào xúi giục phạm tội sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thường Cửu Gia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "Haiz, trời muốn diệt ta mà... trời muốn... diệt ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000502,
					"content": "Cho hỏi ngài là Thường Cửu Gia phải không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "Ừ, có việc gì sao? Có việc thì nói nhanh đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000504,
					"content": "Nghe nói ở chỗ ngài có rất nhiều sách hiếm, tôi muốn mượn chương Liyue trong \"Hướng Dẫn Du Ngoạn Teyvat\" để xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000505,
					"content": "Haiz, đừng nói chuyện sách với tôi nữa, tôi đang phiền chết đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000506,
					"content": "Sau khi Vực Đá Sâu bị phong tỏa, việc kinh doanh khoáng thạch nhà tôi rất khó khăn, bọn Fatui lại còn ra tay sau lưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000507,
					"content": "Vì để gom tiền hàng, tôi phải đem những quyển sách yêu quý đi cầm...!Bạn biết việc này có nghĩa là gì không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000508,
					"content": "...Không có sách đọc rất khó chịu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "Không phải! Là cuộc sống của tôi! Tôi dùng cả đời để sưu tập! Bảo vệ! Tàng thư của tôi, mất rồi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000511,
					"content": "Haiz... thôi bỏ đi, la hét với các bạn cũng không có ý nghĩa gì. Sớm gom tiền để chuộc sách về mới là việc nên làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000512,
					"content": "Nếu không có việc gì khác, tôi cũng không có tâm trạng nói chuyện. Đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000513,
					"content": "Chẳng lẽ, đến Thần Tiêu Trảm Kích Lục quyển thứ 6, cũng mang đi cầm rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000514,
					"content": "Hở? Không ngờ sẽ nghe được cái tên này... bạn cũng có phẩm vị lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000515,
					"content": "Ý là bọn tôi không có phẩm vị à?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000516,
					"content": "Đây là một quyển kỳ thư có ý nghĩa thời đại, lúc đầu khi vừa được bán ai cũng coi thường nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000517,
					"content": "Nhưng nó đã thay đổi ấn tượng của rất nhiều người về tiểu thuyết võ hiệp, sau này cũng xuất hiện thêm nhiều người bắt chước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000518,
					"content": "Bản đầu tiên số lượng rất ít, gần như ngay lập tức hết hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000519,
					"content": "Trong những lần tái bản sau này, quyển thứ 6 do tác giả bổ sung câu chuyện, không biết vì sao không có cơ hội tái bản lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000520,
					"content": "Đúng thế, chính là như vậy! Vì số lượng còn tồn tại cực ít, bất kể tôi thiếu bao nhiêu tiền, cũng không nỡ mang đi cầm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000521,
					"content": "Nói vậy thì, quyển sách đó vẫn còn nắm trong tay ngài?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000522,
					"content": "Ừ, đây là quyển sách cuối cùng còn sót lại của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000523,
					"content": "Này, lão Thường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000524,
					"content": "Lề mề vậy, lão gia nhà ta đã khách khí rồi đó? Lô Thạch Phách đó, rốt cuộc là bán hay không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000525,
					"content": "Làm Mậu Tài Công tức giận, cũng là làm Fatui tức giận, hiểu đạo lý này chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000526,
					"content": "A, lại là ngươi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000527,
					"content": "Nhưng tôi cũng không thể giảm giá bán rẻ lô Thạch Phách đó chứ, nếu như vậy thì... tôi chắc sẽ không thể chuộc lại sách của tôi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000528,
					"content": "Ta không quan tâm, ông muốn đọc sách hay là ăn cơm? Hay là muốn đem sách vào quan tài nằm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000529,
					"content": "Này, ngươi... haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000530,
					"content": "Không thể nói như vậy, vị huynh đài này. Kinh doanh là việc thuận mua vừa bán, làm gì có đạo lý ép mua ép bán như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000531,
					"content": "Ngươi từ đâu chui ra vậy? Liên quan gì đến ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000532,
					"content": "Tại hạ là người giữa đường thấy chuyện bất bình ra tay tương trợ, phái Cổ Hoa, Xingqiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000533,
					"content": "A-hahahahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000534,
					"content": "Phái Cổ Hoa, hắn nói phái Cổ Hoa! Hahaha! Nghe thấy chưa? Bây giờ còn có người nhắc phái Cổ Hoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000535,
					"content": "Chẳng qua chỉ là một môn phái nhỏ mất đi hương hỏa, đứng bên bờ vực thẳm sao? Có vậy mà đã dám hành hiệp trượng nghĩa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000536,
					"content": "Chính nghĩa không quan hệ gì tới thân phận, ngươi chỉ là tiểu gia đinh cáo mượn oai hùm, không phải cũng đang làm việc xấu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000537,
					"content": "Ngươi... ngươi! Được, ngươi hãy đợi đấy! Xem ta có bản lĩnh trừng trị ngươi hay không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000538,
					"content": "Còn ngươi, Lão Thường! Lô khoáng này ông không muốn bán cũng phải bán!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000539,
					"content": "Haiz, hổ lạc đồng bằng bị chó khinh. Những ngày tháng này thật khó sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000540,
					"content": "Tóm lại có thể cho tôi mượn sách không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000541,
					"content": "Bạn cũng thật không biết quan tâm mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "Thôi bỏ đi, tôi cũng không hy vọng người khác có thể lo lắng cho tôi. Coi như nể tình lúc nãy bạn nói giúp tôi, mau cầm sách biến đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000544,
					"content": "Thật cảm ơn! Tôi mong chờ quyển sách này lắm, ơn cho mượn sách, Xingqiu ắt phải báo đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000545,
					"content": "Được rồi được rồi, nhớ trả sách cho tôi là được. Tôi không có hy vọng gì với đệ tử phái Cổ Hoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "Thường Cửu Gia"
				},
				{
					"id": 120000546,
					"content": "Này! Bạn cứ đi như vậy sao? Còn chưa làm rõ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000542,
					"content": "Này, để ý đến bầu không khí hiện tại một chút đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "...Không có sách đọc rất nhàm chán?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
