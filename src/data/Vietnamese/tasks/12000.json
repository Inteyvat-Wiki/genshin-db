					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000613,
					"content": "Bạn không phải là nghe được chúng tôi nói chuyện chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000614,
					"content": "Mượn quyển sách này, chỉ là thấy Thường Cửu Gia đến bước đường cùng, rồi cũng đem nó đi cầm, vậy thì thật là đáng tiếc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000615,
					"content": "Những lời nói với Thường Cửu Gia không phải là nói chơi, nếu ngài ấy đã có ơn với tôi, vậy thì tôi nhất định báo đáp, đó là hiệp nghĩa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000616,
					"content": "Quyển sách này tôi sẽ bảo quản giúp, mà những tàng thư khác, tôi cũng sẽ chuộc lại cho ngài ấy.",
					"roleType": "TALK_ROLE_NPC",
