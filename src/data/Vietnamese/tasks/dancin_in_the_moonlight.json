			"dialogs": [
				{
					"id": 750640412,
					"content": "Tada! Nhìn kỳ tích của ánh sáng và bóng tối xem! Thành tựu công nghiệp mới nhất của Fontaine đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640413
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640413,
					"content": "Thứ này không còn mới mẻ với chúng tôi nữa! Anh vẫn chưa nói muốn chúng tôi giúp chuyện gì đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640414,
						750640416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640414,
					"content": "Cứ nói thẳng cần chúng tôi giúp chuyện gì là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640415
					]
				},
				{
					"id": 750640415,
					"content": "Nhìn thì chắc là nhờ chúng tôi chụp ảnh phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640418,
					"content": "À... Được rồi! Đây là tiền cọc của các vị, hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640419
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640419,
					"content": "Nhiều vậy sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640420,
					"content": "Wrraa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640421
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640421,
					"content": "Như các vị thấy đấy, tôi cần chụp vài tấm ảnh của Saurian nơi đây, không phải loại hình minh họa trong mấy quyển sách động vật đâu... Tôi muốn những hình ảnh có sức sống hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640422
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640422,
					"content": "À, ừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640423,
					"content": "Chẳng qua... Haiz, thứ có sức sống chưa chắc chịu nghe theo chỉ dẫn của tôi. Giả dụ nếu tiện, thì liệu nhà mạo hiểm như các vị đây có thể giúp tôi chụp được những hình ảnh như mong muốn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640424
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640424,
					"content": "À, ừm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640425,
					"content": "Đương nhiên, nếu vượt khỏi phạm vi khả năng của các vị thì không cần miễn cưỡng. Nhưng tôi mong ít ra các vị có thể bảo vệ tôi khỏi sự tấn công của sinh vật xung quanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640426
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640426,
					"content": "Cho nên cứ giữ lấy tiền cọc. Có giúp hay không đều phụ thuộc vào các vị rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640427
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640427,
					"content": "Woa... Nhiều như vậy, nặng trịch luôn... Chúng tôi có thể giữ lại thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640428,
					"content": "Tất nhiên rồi! Chút tiền này mà còn cần xác nhận lại với tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640429
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640429,
					"content": "Haha! Vậy là anh tìm đúng người rồi! Paimon tôi đây là bậc thầy thuần phục Saurian nổi danh khắp Natlan đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640430,
					"content": "#Đừng lo! Chỉ cần có tôi và {NICKNAME} ở đây, anh muốn Saurian nào thì chúng tôi đều sẽ giúp anh thuần phục!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640431,
					"content": "Tepetlisaur? Chuyện nhỏ! Qucusaur? Quá dễ dàng! Iktomisaur? Đơn giản! Còn có... À, Koholasaur, Yumkasaur, Tachankasaur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640432,
						750640433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640432,
					"content": "Tachankasaur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640434,
					"content": "Saurian đầu to, Saurian tay nhỏ, Saurian mắt to, Saurian đáng sợ, Saurian siêu đáng sợ, Saurian không mấy đáng sợ, Saurian kỳ lạ, Saurian bình thường, Saurian ốm yếu, Saurian tròn trịa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640435,
					"content": "Hoohroo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640436,
						750640437
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640436,
					"content": "Paimon đang nói gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640438,
					"content": "Còn nữa... Saurian gào rú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640439,
					"content": "Rawoo! Rawoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640440
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640440,
					"content": "Saurian gầm gừ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640441,
					"content": "Wraah! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640442
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640442,
					"content": "Chúng tôi đều sẽ giải quyết được! Cứ tin tôi, chúng tôi là bậc thầy thuần phục Saurian đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640443,
					"content": "Hrrm, hrmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640444,
						750640447
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640444,
					"content": "Haiz... Được rồi, chúng tôi sẽ giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640445
					]
				},
				{
					"id": 750640445,
					"content": "#Đã nhận nhiều tiền cọc như vậy, chúng tôi sẽ giúp đỡ mà! Đúng không {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640446,
					"content": "Tuyệt vời!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640447,
					"content": "Xin lỗi, tôi hiện không rảnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640448
					]
				},
				{
					"id": 750640448,
					"content": "Nhưng chúng ta đã nhận tiền cọc rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640449,
					"content": "Ha, không sao, đợi lần sau các vị rảnh vậy! Tôi cũng không tới mức nhất định phải có trợ thủ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640437,
					"content": "Dừng lại đã nào. Suy nghĩ rồi hẵng nói đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640433,
					"content": "Đợi đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640416,
					"content": "Hãy cho tôi Mora, tôi sẽ giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640417
					]
				},
				{
					"id": 750640417,
					"content": "Chúng tôi rất lạnh lùng đấy, nên hãy đưa Mora trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				}
			]
		},
