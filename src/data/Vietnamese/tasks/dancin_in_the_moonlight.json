						750641105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641105,
					"content": "Tốt lắm, tốt lắm... Vừa đúng lúc... Haha, kiệt tác của tôi sắp hoàn thành rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641106
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641106,
					"content": "Vậy anh phải chụp cho tốt nhé, giống như lúc chụp những cô gái Fontaine đó vậy! Hihi, lời thoại trong bộ phim đó là như vậy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641107,
					"content": "Hrooo, rroooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641108,
					"content": "Haha, các vị cứ yên tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641109
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641109,
					"content": "Ah! Góc độ này! Thật hoàn hảo! Chính là ánh trăng này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641110
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641110,
					"content": "Đợi đã... Để xem nào, tôi còn cần hai nguồn sáng khác... Một nguồn để chiếu sáng góc nghiêng của Iktomisaur, dùng ánh sáng ấm để tạo sự đối lập với ánh sáng đêm trong khung cảnh... Vậy mới có cảm giác thần bí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641111
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641111,
					"content": "Một nguồn sáng khác để chiếu sáng đường nét phần lưng của Iktomisaur... Tuy không có yêu cầu đặc biệt, nhưng vô cùng cần thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641112
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641112,
					"content": "Ừm... Đúng, chính là vậy... Ha! Đúng rồi! Giống như trong mơ vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641113
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641113,
					"content": "Hửm?! Đáng ghét!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641114
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641114,
					"content": "Xin lỗi, nồng độ nguyên tố trong không khí ở đây khác với Fontaine, chắc chắn là máy móc xảy ra vấn đề gì rồi... Mọi người đừng lo, để tôi kiểm tra xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641115
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641115,
					"content": "Hmm hmm... ừm... hmm hmm! Ối... Không phải chỗ này... Cũng không phải chỗ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641116
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641116,
					"content": "Đáng ghét! Tức quá đi! Aaa! Tức chết đi được! Cái thứ khó tính bị chiều hư này! Aaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641117
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641117,
