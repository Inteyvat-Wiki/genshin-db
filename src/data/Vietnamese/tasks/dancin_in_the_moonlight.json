				},
				{
					"id": 750641124,
					"content": "Này, đừng nhìn tôi vậy chứ, ít ra thì tâm trạng của tôi đã tốt lên nhiều rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641125
