			},
			"dialogs": [
				{
					"id": 750640601,
					"content": "Haha, tốt lắm! Mẫu nhí của chúng ta đừng cử động nhé... Thật thông minh. Ba, hai, một, tách!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640602,
					"content": "Mau xem nào, đúng là kiệt tác! Là ai chụp? Là tôi chụp đấy! Là ai chụp? Là Magnifico de la Magnificans đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640603,
					"content": "Cảm ơn các vị, thật sự rất cảm ơn! Haha! Đây là chi phí còn lại như đã hứa! Ah... Còn cái này nữa, nhìn xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640604,
					"content": "Ồ... Khoản tiền còn lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640605,
					"content": "Hả? Chỉ có một Mora thôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640606,
					"content": "Tốt quá... Tiếp theo đây, nhân vật chính thực sự của chúng ta sắp xuất hiện rồi! Đừng ngại! Hãy xuất hiện như một ngôi sao nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640607,
					"content": "Phù... Xong việc rồi! Bản sao này tặng các vị làm quà vậy. Các vị sẽ được sở hữu kiệt tác này trước tất cả những phòng tranh ở Fontaine đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640608,
					"content": "Cảm ơn, chúng tôi sẽ trân trọng nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "Nhưng mà, khoản Mora còn lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640613,
					"content": "#Tiếp theo đây tôi sẽ đến nơi này... Nào, để tôi đánh dấu trên bản đồ của {F#cô}{M#cậu}. Hihi, trong hành trình tiếp theo đây, nói không chừng chúng ta sẽ còn gặp lại đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640614,
					"content": "Nói không chừng lần sau, tôi sẽ tiếp tục nhờ các vị giúp đỡ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640615,
					"content": "Chậc, đừng nói kiểu như chuyện đương nhiên vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640616,
					"content": "Haha, đó không phải do tôi, mà là do vận mệnh quyết định! Là vận mệnh khiến chúng ta gặp nhau đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640617,
					"content": "Tạm biệt, chúc các vị may mắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640618,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "Magnifico thu dọn hành lý, nhanh chóng leo lên khinh khí cầu.\\nCác bạn nhìn khinh khí cầu lắc mạnh hai cái, khiến Magnifico cười to, sau đó nhanh chóng ổn định lại và bay về phương xa.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "Nhìn có vẻ không đáng giá lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "Wrooh? Wroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "Đúng vậy... Thật thất vọng... Tôi còn tưởng phần còn lại phải nhiều hơn tiền cọc một chút chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				}
			]
