			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Ây da... meo meo, chạy đâu mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100102,
					"content": "Sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "Là mọi người à. Có một vài tên nhóc không biết đã chạy đi đâu chơi rồi, thật là lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100104,
					"content": "Bên ngoài rất nguy hiểm. Tuy ta đã dạy bọn chúng rất nhiều lần rồi. Bên ngoài có người lông xù xù cầm gậy, lại có thứ lửa và nước hình tròn, rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100105,
					"content": "Nếu chạy vào vùng tê tái, còn khiến lông toàn thân dựng đứng. Cảm giác đó, ta không muốn chúng phải trải nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100106,
					"content": "Nhưng có vài tên nhóc không vâng lời chạy lung tung, mỗi lần thế ta đều rất vất vả mới tìm được bọn chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100107,
					"content": "Hôm nay lại có vài đứa không biết đã chạy đi đâu. Thật lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100108,
					"content": "Ngươi hãy giúp ta tìm \"Konbumaru\" và \"Hachihou\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100109,
					"content": "\"Konbumaru\" là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "Konbumaru thế hệ này rất thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100111,
					"content": "\"Thế hệ này\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "Hibiki đôi khi có nói về điều này. Ta cũng không rõ, nhưng nhìn biểu hiện của cô ấy lúc đó, chắc là thứ tốt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100113,
					"content": "Ta sẽ dùng thứ tốt để đặt tên cho tên nhóc. Đợi chúng lớn lên và rời khỏi, ta lại dùng những tên đó đặt cho các tên nhóc nhỏ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100114,
					"content": "\"Konbumaru\" thích ngủ ở chỗ cao. Hãy tìm ở những nơi thật cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100115,
					"content": "Vậy \"Hachihou\" là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "Là tên nhóc rất lanh lợi. Rất thích ăn cá. Cho nên đôi khi sẽ tìm cá trôi dạt lên bờ ở bờ biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100117,
					"content": "Nhưng rất nguy hiểm. Nước là thứ rất đáng sợ. Rất lâu về trước, có một tên \"tanuki\" đã rơi xuống nước, suýt chút không thể trở về được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100118,
					"content": "\"Hachihou\" chắc ở bờ biển xem có cá nhỏ hay cua rồi. Hãy đến nơi nước mặn để tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100119,
					"content": "Phạm vi rộng quá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "Nói chung là rất cao rất cao, với lại nước mặn",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100121,
					"content": "Tóm lại hãy đem bản đồ cho Neko xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100122,
					"content": "Ngươi đúng là không nhạy bén gì hết. Xem đi, chỗ này rất cao này, chỗ này là nước mặn này, chắc chắn chúng ở hai nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100123,
					"content": "Cứ giao cho chúng tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "Vậy phiền mọi người rồi, meo meo, mấy đứa này thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100125,
					"content": "Tôi không giỏi bắt mèo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Meo meo, không sao đâu, chúng đều không sợ con người... Chính vì không ai chơi với chúng nên chúng mới chạy lung tung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100127,
					"content": "Vậy phiền mọi người rồi, meo meo, mấy đứa này thật là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
