						722100307
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100307,
					"content": "Hi hi, tuy rằng rất hung dữ, những vẫn ngoan ngoãn để bạn ôm rồi nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
