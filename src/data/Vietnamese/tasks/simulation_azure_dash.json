				"points": []
			},
			"dialogs": [
				{
					"id": 745030101,
					"content": "Hai vị, lại gặp nhau rồi. Tuy mới chỉ chia tay một lúc, nhưng tôi bắt đầu thấy nhớ hai vị rồi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030102
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030102,
					"content": "Đúng là mồm mép mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745030103,
					"content": "Thật đau lòng, bị ghét rồi. Chắc tôi phải quay về làm việc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030104
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030104,
					"content": "Tôi nói rõ trước, dữ liệu thu thập lần này gồm hai phần. Tôi và Alberre mỗi người phụ trách một phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030105
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030105,
					"content": "Phần dữ liệu tôi là mô phỏng độ linh hoạt của Đấu Sĩ Đại Diện. Vì vậy cần hai vị hoàn thành giả lập xung kích dưới nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030106
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030106,
					"content": "Thì ra Đấu Sĩ Đại Diện phải luyện tập dưới nước sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745030107,
					"content": "Ai mà biết chứ? Tôi và ông chủ cũng không quen Đấu Sĩ Đại Diện nào, nhưng ông chủ thấy như vậy sẽ ngầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030108
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030108,
					"content": "Ông chủ vốn dĩ muốn đặt một động cơ xịt nước bên trong cánh tay của đồ chơi, xịt nước chíu chíu, có điều vốn cao quá nên bỏ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030109,
						745030110
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030109,
					"content": "Đúng là rất ngầu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				},
				{
					"id": 745030111,
					"content": "Fontaine dù sao cũng là vương quốc của nước. Muốn truyền bá ra nước ngoài thì phải có chút bản sắc của Fontaine chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030112
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030112,
					"content": "Tóm lại, tôi đã ghi vài lưu ý vào sổ tay rồi, hai vị lát nữa có thể xem sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030113
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030113,
					"content": "Thế nào? Nóng lòng muốn thử rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030114
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030114,
					"content": "Đợi tôi chuẩn bị một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030115
					]
				},
				{
					"id": 745030115,
					"content": "Không sao, khu vực đã được bố trí sẵn thiết bị thu thập dữ liệu, nên chỉ cần tập trung hoàn thành khiêu chiến là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030110,
					"content": "Trẻ con mới thấy ngầu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				}
			]
		}
	]
}