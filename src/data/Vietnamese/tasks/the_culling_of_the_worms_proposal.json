	"talks": [
		{
			"id": 7351101,
			"completionStepIds": [
				7351101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351101",
							"2"
						],
						"stepId": 7351101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shriya",
					"Fodil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110101,
					"content": "Tên ngốc đó... không ngờ lại một mình xông vào sa mạc! Fodil, cầu xin anh hãy cứu lấy anh ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110102
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110102,
					"content": "Xin lỗi, lực lượng canh giữ trong làng có hạn, lại còn phải canh chừng \"chúng nó\" nữa, nên không có dư người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110103
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110103,
					"content": "Nhưng tên ngốc đó liều mạng như vậy cũng là vì để đối phó với \"chúng nó\" đấy! Ít ra thì chúng ta cũng cùng chung mục tiêu mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110104
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110104,
					"content": "Haiz, cũng không phải là chúng tôi không muốn đi tìm. Nhưng các thủ vệ bây giờ đang phân tán khắp sa mạc để đề phòng động tĩnh của \"chúng nó\" rồi. Muốn triệu tập nhân lực cũng phải cần thời gian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110105
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110105,
					"content": "Sao lại như thế chứ... Bây giờ nếu quay về Dịch Trạm Lữ Khách thì e là không còn kịp nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110106,
						735110107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110106,
					"content": "Có ai gặp nguy hiểm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				},
				{
					"id": 735110108,
					"content": "Hử? Hai người là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110109
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110109,
					"content": "Nhà mạo hiểm qua đường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110110
					]
				},
				{
					"id": 735110110,
					"content": "Và người bạn đồng hành tốt nhất, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110111,
					"content": "Nhà mạo hiểm sao? Tốt quá! Cảm ơn trời đất, tên Vinayak đó cuối cùng cũng được cứu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110112
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110112,
					"content": "Nhà mạo hiểm thân mến! Xin bạn hãy cứu lấy Vinayak, thù lao không thành vấn đề!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110113
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110113,
					"content": "Cứ nói tình hình cho tôi nghe trước đã!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110114
					]
				},
				{
					"id": 735110114,
					"content": "Ừm, trong sa mạc có \"chúng nó\" làm loạn nên rất nguy hiểm, nghe hết tình hình rồi tính vẫn hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110115
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110115,
					"content": "Nói đúng lắm, là tôi hơi vội rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110116
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110116,
					"content": "Ban nãy cứ nghe mọi người nói là \"chúng nó\", đó là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110117,
					"content": "Là một đàn Wenut, không biết tại sao dạo này chúng lại trở nên hung bạo, luôn ẩn mình dưới cát để tấn công con mồi đi ngang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110118,
						735110119
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110118,
					"content": "Cũng chỉ là mấy con sâu thôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110120,
					"content": "...Nói là vậy, nhưng lần này số lượng lớn lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110121
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110121,
					"content": "Lại có bão cát yểm trợ nên khó đối phó với chúng hơn. Vừa thấy nguy hiểm là chúng sẽ chạy trốn ngay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110122
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110122,
					"content": "Ừm, đúng là khó khăn thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110123,
					"content": "Không chỉ có Làng Aaru, đến cả thương nhân đi qua cũng bị ảnh hưởng nữa. Cho nên Giáo Viện mới phái tôi và Vinayak đến đây để xử lý Wenut đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110124
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110124,
					"content": "Nhưng những linh kiện mà chúng tôi nhờ thương đội chuyển đến đã bị Wenut tập kích, lại còn bị bão cát cuốn đi khắp nơi nữa. Bây giờ... e là đã trở thành đồ chơi cho đám ma vật rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110125
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110125,
					"content": "Tôi vốn muốn quay về Dịch Trạm Lữ Khách tìm cứu viện, nhưng ai ngờ tên Vinayak đó bao năm nay vẫn cứ cứng nhắc như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110126
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110126,
					"content": "Anh ta nói phải lấy lại linh kiện, thế là tự mình đi vào trong sa mạc rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110127
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110127,
					"content": "Haiz... Để ma vật bắt anh ta đi cho xong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110128
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110128,
					"content": "#Chà... Sao giờ {NICKNAME}? Nếu như bỏ mặc thì học giả đó sẽ gặp nguy hiểm đó. Wenut không dễ đối phó đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110129,
						735110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110129,
					"content": "Đúng là không thể bỏ mặc được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110131,
					"content": "Ôi... Cảm ơn, cảm ơn nhiều! Ban nãy tôi giận quá nên lỡ lời... Bây giờ tôi sẽ đánh dấu vị trí bị tập kích trên bản đồ. Khụ, hy vọng mọi người có thể tìm được anh ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110132
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110132,
					"content": "Hy vọng anh ta sẽ không ngáo đến nỗi xông vào giữa đám ma vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110130,
					"content": "Việc cứu hộ cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110119,
					"content": "Tôi đã đối phó qua thứ to hơn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110107,
					"content": "Mọi người cần giúp gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				}
			]
		},
		{
			"id": 7351103,
			"completionStepIds": [
				7351103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351103",
							"2"
						],
						"stepId": 7351103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vinayak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110301,
					"content": "Đi vào từ góc này, và sử dụng địa hình để trú ẩn... Miễn là góc của ánh sáng mặt trời không cao hơn... Và tốc độ của mình không thấp hơn... Hừm, vẫn không ổn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110302
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110302,
					"content": "Anh đang tính toán gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110303
					]
				},
				{
					"id": 735110303,
					"content": "\"Lộ trình né tránh ma vật thu hồi linh kiện\"... Nhờ đám Wenut đó mà những linh kiện quý báu của tôi đã bị cuốn vào chỗ đám ma vật đó rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110304
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110304,
					"content": "Ối ối! Các người là ai? Tới từ khi nào thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110305
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110305,
					"content": "Đứng đây nghe anh lẩm bẩm lâu rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110306
					]
				},
				{
					"id": 735110306,
					"content": "Yên tâm, chúng tôi không phải là người xấu. Bạn của anh phái chúng tôi đi tìm anh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110307,
					"content": "Bạn? Không lẽ là Shriya sao? Không đúng, cô ta nói là dù tôi có làm sao thì cũng mặc kệ mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110308
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110308,
					"content": "À... Tôi hiểu rồi, cô ta phái hai người đến đây thu hồi linh kiện đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110309
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110309,
					"content": "Tôi có bị ma vật bắt hay không cũng chả sao, quan trọng là linh kiện phải thu hồi về... Ừm, đúng là cô ta sẽ nói như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110310
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110310,
					"content": "...Anh cứ cho là vậy đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110311
					]
				},
				{
					"id": 735110311,
					"content": "Nhưng dù sao cũng cảm ơn nhé, ban nãy tôi tính mãi không ra, nên định xông ra trước rồi mới tính tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110312
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110312,
					"content": "...Nếu như tôi tính sai thật thì sẽ bị ma vật bắt đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110313
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110313,
					"content": "Haiz, nếu không còn tôi, mà Shriya thì lại ngốc nghếch vụng về... còn ai có thể bảo quản được những máy móc này đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110314
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110314,
					"content": "Tôi hiểu Shriya lo lắng chuyện gì rồi... Trong đầu tên này đúng là chỉ toàn linh kiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110315,
					"content": "#{NICKNAME}, chúng ta mau thu thập linh kiện về thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
