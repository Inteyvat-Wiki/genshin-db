			"dialogs": [
				{
					"id": 716663101,
					"content": "Phù... Cũng may không có sơ suất gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "Sợ, sợ chết mất! Cũng khá hung hăng đó chứ, nếu là ta thì cũng ứng phó không nổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "Cao thủ đấu bọ của Liyue đều là thiên tài hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "Thì ra Onikabuto chơi đùa với nhau như vậy sao? Changchang hiểu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "Hoa Mao Lương Đáng Sợ"
				},
				{
					"id": 716663105,
					"content": "Nếu mọi người có thời gian, có thể chơi thêm vài trận với Changchang không? Em cũng sẽ tiếp tục xem mọi người chơi để học hỏi thêm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "Hoa Mao Lương Đáng Sợ"
				},
				{
					"id": 716663106,
					"content": "Xem ra... năng khiếu của Hoa Mao Lương Đáng Sợ rất lợi hại đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "Nếu Tên Thả Bò cũng có năng khiếu đó, nói không chừng chỉ cần nghe Guoba nói chuyện với Lốc Xoáy Pha Lê là đã hiểu được cách giao tiếp với sinh vật giáp xác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Haha... ha... ta cũng hy vọng mình giỏi như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
