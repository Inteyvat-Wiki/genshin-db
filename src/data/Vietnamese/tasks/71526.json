			"dialogs": [
				{
					"id": 716663001,
					"content": "Onikabuto... cũng có thể trở thành bạn bè như chó mèo vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "Hoa Mao Lương Đáng Sợ"
				},
				{
					"id": 716663002,
					"content": "Lần này lại tìm một đứa trẻ đến sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Hmm, nhưng Tướng Quân Hanakado cũng trẻ tuổi, tôi nhớ lần trước cũng có một bạn nhỏ. Xem ra kỹ năng đấu bọ không liên quan gì đến tuổi tác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "Tuy tuyển thủ đấu bọ... \"Hoa Mao Lương Đáng Sợ\" này không có kinh nghiệm đấu bọ, nhưng Onikabuto của tuyển thủ thì lại toát ra khí thế rất hùng hồn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Tướng Quân Hanakado"
				},
				{
					"id": 716663005,
					"content": "Changchang không hiểu mọi người đang nói gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "Hoa Mao Lương Đáng Sợ"
				},
				{
					"id": 716663006,
					"content": "Onikabuto của Changchang là món quà do cha mang về, là người bạn của cha đã tặng cho ông ấy trong chuyến du lịch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "Hoa Mao Lương Đáng Sợ"
				},
				{
					"id": 716663007,
					"content": "Chà, xem ra ông ấy cũng có hiểu biết về chuyên môn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Vậy phía chúng ta sẽ phái \"Dưa Tím Thép Trắng Kinh Thiên Động Địa\" xuất chiến, để tránh việc bị coi là đang bắt nạt người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "Hừm, sao lại nói như thể tôi là người yếu nhất thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Nhưng mà hai tên cuồng đấu bọ này chắc không biết phân nặng nhẹ, quả thật nên để tôi đấu với em ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "Đừng căng thẳng nhé bạn nhỏ, chỉ là trò chơi thôi, vui là chính!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
