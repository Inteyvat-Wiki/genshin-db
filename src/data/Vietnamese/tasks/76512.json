			},
			"dialogs": [
				{
					"id": 765120101,
					"content": "#Thi đấu đến giờ, {NICKNAME} chắc cũng đã có đáp án rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120102,
					"content": "Khụ khụ, để tôi nhớ lại lời thoại đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120103
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120103,
					"content": "Trận đấu tuyệt vời cuối cùng cũng đã hạ màn, giờ đây, đến phần công bố kết quả trận đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120104
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120104,
					"content": "#Mời {NICKNAME}, người thí luyện cuối cùng chọn ra nhà vô địch trong lòng mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120105
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120105,
					"content": "#Lần này {NICKNAME} sẽ chọn ra nhà vô địch sao? Ồ... Đúng là lần đầu tiên {NICKNAME} trở thành giám khảo quan trọng nhất đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120106,
						765120112,
						765120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120106,
					"content": "Tôi chọn chú cún ngầu Gaumaru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120107
					]
				},
				{
					"id": 765120107,
					"content": "Ừm ừm, tôi cũng thấy Gaumaru giỏi nhất, có phong thái của Taroumaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120108,
					"content": "Gâu gâu! Gâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120109
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120109,
					"content": "Giỏi lắm, Gaumaru! Nỗ lực của ngươi đã được đền đáp một cách tuyệt vời nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120110
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120110,
					"content": "Kết quả như trong dự đoán rồi, chúc mừng hai người bạn đến từ Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120111
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120111,
					"content": "Ngài Ninken oai phong lẫm liệt quả thực rất mạnh, tôi ủng hộ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Hợp Âm Giảm Bảy"
				},
				{
					"id": 765120125,
					"content": "Tuy không có mục trao giải hoành tráng, nhưng các vị đều coi trọng thực chiến, thường ngày cũng hành xử rất khiêm tốn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120126
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120126,
					"content": "#Sự công nhận của {NICKNAME} là vinh dự cao quý nhất ở Nod-Krai, vượt xa những chiếc cúp mạ vàng hay huân chương tầm thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120127
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120127,
					"content": "#Haha, mọi người có thể là những chiến binh đầu tiên ở toàn Teyvat được {NICKNAME} trao giải như thế này đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120128,
					"content": "Không cần thêm phần thưởng nào nữa, chúng tôi đã rất vui rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120129
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120129,
					"content": "Đúng không, Budanova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120130
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120130,
					"content": "Tất nhiên rồi, lần sau chi bằng để đội chúng tôi tài trợ, tổ chức giải đấu hoành tráng hơn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120131
					],
					"speakerTitle": "Hợp Âm Giảm Bảy"
				},
				{
					"id": 765120131,
					"content": "Tốt nhất là tổ chức vòng loại quy mô hàng trăm người, như vậy không chừng cuối cùng sẽ xuất hiện nhiều cao thủ chưa có thông tin và cũng chưa thuộc về tổ chức nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120132
					],
					"speakerTitle": "Hợp Âm Giảm Bảy"
				},
				{
					"id": 765120132,
					"content": "Hợp lý đó. Lính ném bom rất sẵn lòng tài trợ cho loại giải đấu này, tôi sẽ viết sẵn phương án gửi Thiếu Tá Valeriy trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120133
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120133,
					"content": "Shuumatsuban cũng... ừm... nếu kinh phí đạt mức hàng chục triệu Mora thì không cần bàn về chuyện chi tiền nữa, đội Ninken sẽ tích cực tham gia giải đấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120134
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120134,
					"content": "Coo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120135
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120135,
					"content": "Cảm ơn ý tốt của các vị. Nhưng theo tôi thì nếu cuộc thi này được tài trợ bởi một thế lực hùng mạnh, thì bản chất của nó có thể sẽ thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120136,
					"content": "Ba vị liệu có cưỡng lại được sự cám dỗ, không tìm cách chiêu mộ những tuyển thủ tự do đứng đầu bảng xếp hạng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120137
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120137,
					"content": "À, ý của Kazuha chẳng lẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120138,
					"content": "Chính vì thế, việc để Hiệp Hội Nhà Mạo Hiểm tương đối trung lập đứng ra tổ chức mới là lựa chọn tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120139,
						765120140
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120139,
					"content": "Bản chất của cuộc thi đúng là nên duy trì ở mức thuần túy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120141,
					"content": "Ừm... Paimon hình như cũng hiểu rồi! Vậy để Paimon nói lời khó nghe cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120142,
					"content": "Mặc dù lần này, hai thí sinh Fatui tham gia đều rất lịch sự, nhưng một số đồng nghiệp của các vị lại rất hung hãn, cứ gặp chúng tôi là động thủ ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120143,
					"content": "Nếu Fatui làm cổ đông của giải đấu, chắc chắn các vị sẽ chiêu mộ những tuyển thủ xếp hạng cao, vậy thì chẳng phải... chúng tôi giúp các vị tìm kiếm cao thủ, để đánh chúng tôi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120144,
					"content": "Haha, bị phát hiện rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120145
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120145,
					"content": "Tôi hiểu ý của các vị rồi, nhưng tôi cũng không thể thay người khác đưa ra cam kết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120146
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120146,
					"content": "Mỗi đội đều có nhiệm vụ và cách làm việc khác nhau, lời nói của một trung úy nhỏ bé như tôi chẳng là gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120147
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120147,
					"content": "#Lời của anh Kaedehara rất có lý, sự lo lắng của {NICKNAME} và người dẫn đường Paimon cũng rất thực tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120148
					],
					"speakerTitle": "Hợp Âm Giảm Bảy"
				},
				{
					"id": 765120148,
					"content": "Thôi được rồi, các vị đừng có nghĩ nhiều nữa, cứ như Gaumaru vậy, tận hưởng chiến đấu thuần túy là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120149
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120149,
					"content": "Áu áu! Áu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120150
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120150,
					"content": "Nói đúng lắm. Là chiến binh cấp thấp nhất, không cần nghĩ nhiều đến những vấn đề mà các chỉ huy phải lo lắng, quan trọng là chiến đấu thật sảng khoái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120151
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120151,
					"content": "Lần sau khi so tài, tôi nhất định sẽ dùng những kỹ năng mạnh hơn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120152
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120152,
					"content": "Còn tôi... sẽ mang đủ bánh cho mọi người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hợp Âm Giảm Bảy"
				},
				{
					"id": 765120140,
					"content": "Đúng là không nên pha lẫn những mục đích khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120112,
					"content": "Màn thể hiện của Mã Não Tối Màu nổi bật nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120113
					]
				},
				{
					"id": 765120113,
					"content": "Fatui cao to cầm đại kiếm... quả thực không dễ đối phó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120114,
					"content": "#Tôi ư? Cảm ơn {F#cô}{M#cậu} đã công nhận, đây là sự cổ vũ lớn nhất dành cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120115
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120115,
					"content": "#Mọi người đều đánh tốt lắm, có thể do tôi may mắn hơn nên bắt được nhịp của {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120116
					],
					"speakerTitle": "Mã Não Tối Màu"
				},
				{
					"id": 765120116,
					"content": "Gâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120117
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120117,
					"content": "Thấy chưa, Gaumaru? Phải học hỏi Mã Não Tối Màu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120118
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120118,
					"content": "Quả không hổ danh là Trung Úy Stepanyan, Thiếu Tá Valeriy chắc hẳn cũng sẽ tự hào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Hợp Âm Giảm Bảy"
				},
				{
					"id": 765120119,
					"content": "Tôi nghĩ nhà vô địch là Hợp Âm Giảm Bảy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120120
					]
				},
				{
					"id": 765120120,
					"content": "Hmm... nói ra thì, một số Fatui đội mũ đã giao đấu với chúng ta ở Fontaine là do cô ấy huấn luyện sao? Thế thì đúng là giỏi thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120121,
					"content": "#Ồ, thật vinh hạnh quá... Sau này phải chuẩn bị nhiều đồ ngọt cao cấp hơn cho {NICKNAME} mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120122
					],
					"speakerTitle": "Hợp Âm Giảm Bảy"
				},
