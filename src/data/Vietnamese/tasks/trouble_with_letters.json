						411260602
					]
				},
				{
					"id": 411260602,
					"content": "#{F#Chị}{M#Anh} hỏi Liu ạ, tụi em đã hẹn cùng nhau ngắm thiên thạch, nhưng bạn ấy nói phải tìm chỗ cao hơn để xem.",
					"roleType": "TALK_ROLE_NPC",
