			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "Ồ, vậy phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260102,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "Chắc bạn đã thấy những thiên thạch từ trên trời rơi xuống rồi chứ, mặc dù trong thành không bị ảnh hưởng, nhưng bên ngoài đã trở nên hỗn loạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260104,
					"content": "Hơn nữa, thiên thạch không chỉ chắn đường mà đám ma vật dường như bị ảnh hưởng bởi thiên thạch trở nên đặc biệt cáu kỉnh và nguy hiểm, tấn công người đi đường và thương đội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260105,
					"content": "Tổng vụ đã điều động gần như toàn bộ Thiên Nham Quân có thể điều động rồi, nhưng Liyue quá lớn, chúng tôi cũng chỉ có thể bảo vệ cho những tuyến đường chính và sự an toàn của thôn trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260106,
					"content": "Tôi vốn xin cấp trên cho phép được đóng quân ở Khinh Sách Trang, nhưng không biết tai sao, tôi vẫn bị phân đến đây chờ lệnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260107,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi mang lá thư này cho bé Liu ở Khinh Sách Trang không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260108,
					"content": "Con bé là con gái tôi, tôi đã hứa với con bé sẽ trở về ở cùng nó vài ngày, nhưng lần này có việc khẩn cấp, chắc chắn tôi sẽ không thể về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260109,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "Vậy thì phiền bạn rồi, haiz, chuyện này được gọi là gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260115,
					"content": "Có điều, nghe những người trở về từ đó nói, có vẻ như có rất nhiều ma vật đang tập trung gần Khinh Sách Trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260116,
					"content": "Cái đó... thực ngại quá, nhìn trang phục của bạn, bạn là nhà mạo hiểm phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260117,
					"content": "Khi gửi thư đi, bạn có thể xử lý một số ma vật ở một vài góc xung quanh Khinh Sách Trang không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260118,
					"content": "Thiên Nham Quân thường đóng quân trên đường lớn và trục đường chính... nếu những ma vật lẻ tẻ này lẻn vào Khinh Sách Trang thì sẽ rất nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260119,
					"content": "Được rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "Cảm ơn, vậy thì phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260121,
					"content": "Đây coi như là thêm uỷ thác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "Ừm, cái này... yên tâm đi, tôi nhất định sẽ chuẩn bị số tiền thưởng thích hợp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260123,
					"content": "Vậy thì nhờ bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260111,
					"content": "Đây là chuyện không có cách nào khác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "Tôi biết, nhưng... haiz, thật là kỳ lạ, mỗi lần tôi muốn xin nghỉ phép thì lại xảy ra chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260113,
					"content": "Thật trùng hợp, chuyện này được gọi là gì nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260114,
					"content": "Vậy thì nhờ bạn đưa bức thư này cho bé Liu ở Khinh Sách Trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				}
			]
		},
