						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "Tôi đến những nơi ngài Stanley từng mạo hiểm, nhưng thật không ngờ trên đường đi lại gặp đám người này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "Thực lực của tôi còn rất yếu, nếu là tiên sinh Stanley, nhất định có thể tiêu diệt toàn bộ những tên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "Nếu bạn đồng ý đi mạo hiểm cùng tôi... mà thôi, không thể việc nào cũng ỷ lại vào người khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "Tôi sẽ đi tiếp về phía trước, cho bạn cái này, tôi hái bên dọc đường rất nhiều để dành làm lương khô...",
