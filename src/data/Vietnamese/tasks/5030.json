			"dialogs": [
				{
					"id": 50300301,
					"content": "Lượng thuốc còn lại bao nhiêu? Đủ dùng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300302
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300302,
					"content": "Gần hết rồi. Dự trữ khẩn cấp vẫn còn một ít, dành cho bác sĩ và chiến binh. Những thứ này không thể động vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300303,
					"content": "Ừm, được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300304,
					"content": "Lấy luôn phần thuốc này để dùng nhé.",
