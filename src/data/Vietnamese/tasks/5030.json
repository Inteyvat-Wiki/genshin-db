				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "Là hai vị à, tuyệt quá! Cảm ơn vì đã luôn khích lệ tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300802,
					"content": "Natlan có rất nhiều người coi việc chống lại Vực Sâu là vinh dự, nhưng họ cũng bị sự nhiệt huyết làm mụ mị đầu óc, vô tình rơi vào nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300803,
					"content": "Hai vị nói rất đúng, chiến đấu rất quan trọng, mạng sống cũng vậy. Chúng ta chiến đấu vì người mình thương yêu, vậy thì chúng ta phải gặp lại họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300804,
					"content": "Sau khi tôi truyền đạt lại suy nghĩ của hai vị, các chiến hữu đều công nhận, khi chiến đấu cũng trở nên vững vàng hơn rất nhiều, và chúng tôi đã giành được kết quả rất tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Uturunku"
				},
				{
