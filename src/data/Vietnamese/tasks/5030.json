					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300505
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50301601,
					"content": "Thì ra là các vị, thật vui khi thấy các vị bình an vô sự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300506,
					"content": "Tình hình con trai của bà thế nào rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "Tôi không rõ, đường thư tín đang bị đứt rồi. Người đưa tin bị thương hết người này đến người khác, tôi phải tập trung chữa cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300508,
					"content": "Nhưng tôi tin con trai mình nhất định sẽ đưa ra phán đoán chính xác vào thời khắc quan trọng. Nó là con trai tôi, tôi vẫn luôn tự hào về nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
			]
		},
