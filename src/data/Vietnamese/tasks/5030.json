			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qhispe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "Ôi trời, nhân lực không đủ, đồ đạc cũng không đủ. Với kỹ thuật tầm thường này của tôi thì không xử lý được hết tất cả vết thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300102,
					"content": "Nếu có ai chuyên nghiệp hơn thì tốt biết mấy... Không ổn, không phải lúc để thở dài, phải phấn chấn lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awhina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "Tôi thấy các vị đưa Chuychu về... Tôi thực sự rất lấy làm tiếc, Chuychu thực sự là một bác sĩ tài năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300202,
					"content": "Chúng tôi từng hợp tác khá nhiều về mặt công việc. Cô ấy có yêu cầu rất cao về chất lượng thuốc, đôi khi vì chữa trị cho người khác mà tự bỏ tiền túi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300203,
					"content": "Cô ấy nói với tôi, so với kiếm tiền thì cô ấy coi trọng việc tích lũy kinh nghiệm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300204,
					"content": "Chỉ khi nắm được y thuật tinh thông nhất thì mới có thể cứu được nhiều người nhất. Đồng thời, cũng là để cô ấy không bỏ lỡ người mà cô muốn cứu giúp nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300205,
					"content": "Thật đáng tiếc... Bác sĩ lại không thể tự cứu chính mình, Natlan đã mất đi một vị anh tài xuất chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Awhina"
				}
			]
		},
