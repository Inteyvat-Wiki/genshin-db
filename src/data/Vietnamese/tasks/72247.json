			"dialogs": [
				{
					"id": 722470301,
					"content": "Có, có thứ gì đó xuất hiện kìa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470302,
					"content": "Hình như là một dư ảnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470303,
					"content": "Ta là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470304,
					"content": "Ta là người xây dựng Helios, tên là: Aberaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470305,
					"content": "Tôi hiểu câu này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470306,
					"content": "Câu này có nghĩa là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470307,
					"content": "Ông ta nói tên của ông ta là Helios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470308,
						722470309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470308,
					"content": "Rõ ràng là không hiểu kìa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				},
				{
					"id": 722470310,
					"content": "Vậy hả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470311,
					"content": "Tên của ông ta là Aberaku... cái tên kỳ lạ thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470312,
					"content": "Nhưng mà, nếu tên ông ta là Aberaku thì Helios lại là cái gì ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470313,
					"content": "Helios! Helios!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470314,
					"content": "Helios do ta đích thân tạo ra... ngày Helios được hoàn thành, ánh hào quang từ trên cao chiếu rọi khắp mọi nơi, mọi người đã không còn bị tộc rồng quấy nhiễu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470315,
					"content": "Đúng vào lúc đó, người dân ngước nhìn lên, rưng rưng ngấn lệ, khó nén nổi niềm kích động vui mừng... nhưng bây giờ sao lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470316
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470316,
					"content": "Không đúng, ta, vì sao ta lại ở đây... tại sao... tại sao linh hồn của ta lại lạc vào cõi mộng, không thể bình yên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470317,
					"content": "Paimon nghe hiểu chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470318
					]
				},
				{
					"id": 722470318,
					"content": "Hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470319,
					"content": "Đây chắc chắn là linh hồn đang có tâm lý bất ổn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470320,
					"content": "Ta nhớ ra rồi... hồn phách của ta không trọn vẹn, chờ khi hồn phách của ta quay về hết thì mới có thể tìm lại được sự yên bình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470321,
					"content": "Cơ hội xoay chuyển nằm ở ngươi, để ta nói ngươi biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470322,
					"content": "Hơ, Paimon nghe thấy mùi phiền phức rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470323,
					"content": "Nơi này vốn dĩ thờ phụng một phần di cốt của ta, nhưng nó đã sớm mục nát... xem như ta ủy thác cho ngươi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470324,
					"content": "Mang những vật hiến tế gửi gắm tâm niệm của ta đi... nhưng xung quanh sẽ có quái vật canh giữ linh hồn ta, một khi vật chứa hồn phách của ta rời khỏi đây... chúng sẽ ồ ạt xông lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470325
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470325,
					"content": "Việc này vô cùng nguy hiểm, nhà lữ hành, nếu ngươi đã chuẩn bị xong thì hãy nói với ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470309,
					"content": "Tên của ông ấy là Aberaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				}
			]
		},
