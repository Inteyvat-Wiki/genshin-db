			"dialogs": [
				{
					"id": 722470201,
					"content": "Xem ra ngươi hoàn toàn đủ sức để... hộ tống vật hiến tế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470202,
					"content": "Vậy thì ta cũng có thể yên tâm rồi... phải hộ tống đến nơi đến chốn, mới có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470203,
					"content": "Mới có thể thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470204,
					"content": "Mới có thể... mới có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470205,
					"content": "Tiêu rồi, ông ấy có vẻ không còn tỉnh táo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470206,
					"content": "Nhưng vật hiến tế mà ông ấy nói chắc là cái này đúng không... trông có vẻ cũng cũ nát hết cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224703,
