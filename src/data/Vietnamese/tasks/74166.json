					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660606,
					"content": "Bởi vì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "Bởi vì tôi không muốn làm việc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660608,
					"content": "Chỉ vì tôi không muốn làm việc, nên lúc đói quá đã lỡ trộm một miếng bánh mì, thế là bị kết tội rồi đưa vào đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660609,
					"content": "Nhưng tại sao đã vào đến Pháo Đài Meropide rồi mà vẫn phải làm việc chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660610,
					"content": "\"Bất kỳ công việc nào cũng có thể hạ gục tôi\", đây chính là phương châm sống của tôi.",
					"roleType": "TALK_ROLE_NPC",
