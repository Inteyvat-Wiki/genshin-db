			"dialogs": [
				{
					"id": 741660201,
					"content": "#Này, người đằng kia, chính là {M#cậu}{F#cô} đấy, mau lại đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660202,
					"content": "Hả? Đang gọi chúng tôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "Ừm, nhìn là biết hai người vừa mới đến, vẫn chưa quen với Pháo Đài Meropide phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660204,
					"content": "Chúc mừng hai người đã gặp được tôi, \"cư dân\" có tấm lòng lương thiện nhất Pháo Đài Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660205,
					"content": "Hôm nay để tôi dẫn hai người đi làm quen với nơi này nhé, đương nhiên là hoàn toàn \"miễn phí\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660206,
					"content": "Thật ra tôi rất quen thuộc nơi này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "Chà, đừng nói thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660208,
					"content": "#Có lẽ {M#cậu}{F#cô} thấy mình rất quen thuộc với nơi này, nhưng dưới sự chỉ dẫn của tôi, tôi tin là {M#cậu}{F#cô} sẽ nhận ra những khung cảnh hoàn toàn khác biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660209,
					"content": "Trên đời này có \"bữa trưa miễn phí\" như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Đương nhiên. Tôi nói rồi, tôi là \"công dân\" lương thiện nhất của Pháo Đài Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660211,
					"content": "Hmm, người này thật kỳ lạ, sao vừa gặp đã nhiệt tình thế nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "Haha, đừng nghĩ nhiều... Thế này đi, hai người cứ thương lượng trước, tôi ở đây đợi câu trả lời cuối cùng của hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660213,
					"content": "Thương lượng xong rồi đến tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Người Kỳ Lạ"
				}
			]
		},
