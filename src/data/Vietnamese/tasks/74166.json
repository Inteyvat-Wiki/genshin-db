			"dialogs": [
				{
					"id": 741660501,
					"content": "Đây là chỗ của Đoàn Kịch Ba Tấm Phiếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660502,
					"content": "Hả? Giới thiệu có thế thôi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "Lẽ nào không khiến hai người nghĩ đến thứ gì sao? Nói đến đoàn kịch thì chắc chắn là có kịch! Nói đến kịch thì phải có sự lãng mạn! Mà đã lãng mạn thì phải có tình yêu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660504,
					"content": "Nghe đồn là chỉ cần đến đây xem kịch mỗi ngày thì sẽ tìm thấy tình yêu đích thực của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660505,
					"content": "Có tin đồn như vậy sao? Vậy chẳng phải mọi người đều sẽ tập trung hết ở đây à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "Thì đúng là vậy, nhưng yêu cầu thì không được phép là tù nhân hoặc cai ngục trong Pháo Đài Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660507,
					"content": "Vậy căn bản là không ai có thể thỏa mãn điều kiện để gặp tình yêu đích thực cả!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "Có lẽ đây chính là vấn đề. Dù sao đi nữa, chúng ta đến địa điểm tiếp theo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Người Kỳ Lạ"
				}
			]
		},
