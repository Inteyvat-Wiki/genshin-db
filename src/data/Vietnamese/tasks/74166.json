				},
				{
					"id": 741660302,
					"content": "Xong rồi, chắc chắn là miễn phí đấy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "Đương nhiên, chắc chắn là \"miễn phí\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660304,
					"content": "Nào, bây giờ hãy theo tôi, chúng ta cùng nhau làm quen với Pháo Đài Meropide.",
					"roleType": "TALK_ROLE_NPC",
