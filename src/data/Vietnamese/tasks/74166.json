			},
			"dialogs": [
				{
					"id": 741660401,
					"content": "Đây là Nhà Ăn Đặc Cách của Pháo Đài Meropide, mỗi người có thể nhận một suất cơm phúc lợi miễn phí mỗi ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660402,
					"content": "Vấn đề là, được ăn món gì thì đều phải dựa vào may rủi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660403,
					"content": "Hmm, chuyện này ngày đầu tiên đến đây là biết được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Đừng vội, tôi còn một thông tin bí mật. Nghe nói, khi lấy cơm phúc lợi, chỉ cần nói ra câu ám hiệu với Bran là có thể nhận được món ngon thần bí trong truyền thuyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660405,
					"content": "Hả, thật sao? Ám hiệu là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Rất tiếc, tôi không biết. Nội dung liên quan đành phải đợi hai người đi tìm hiểu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Người Kỳ Lạ"
				},
				{
					"id": 741660407,
					"content": "Câu này để tôi nói mới phải!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "Đừng để tâm mấy chi tiết này nữa, điểm đến tiếp theo của chúng ta là Đoàn Kịch Ba Tấm Phiếu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Người Kỳ Lạ"
				}
			]
		},
