			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "Stanley... Hãy nói cho tôi biết tôi phải làm thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130302,
					"content": "Ơ? Sao bạn lại tự kêu tên của mình?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130303,
					"content": "Lẽ nào có nguyên nhân sâu xa gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "Không phải còn người nào khác tên Stanley đó chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130307,
					"content": "Huhu! Hức... Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130308,
					"content": "Tại sao người năm đó chết ở Vùng Biển Lặng... lại không phải là tôi chứ! Tại sao tôi mạo danh anh, linh hồn của anh cũng không đến ngăn cản tôi? Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130309,
					"content": "Nếu không vì bảo vệ một người mới như tôi, anh sẽ không chết ở nơi không có gió đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130310,
					"content": "Anh đã có danh hiệu của nhà mạo hiểm vĩ đại, nhưng chỉ vì thứ vô dụng như tôi mà anh đã không thể trở thành truyền thuyết nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130311,
					"content": "Chuyện này... rốt cuộc là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130312,
					"content": "...Tôi nghĩ, năm đó anh ấy thật sự đã tìm thấy Vùng Biển Lặng. Gặp nguy hiểm ở đó cũng là thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130313,
					"content": "Có điều, bạn đồng hành của anh ấy mới thật sự là \"nhà mạo hiểm vĩ đại Stanley\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130314,
					"content": "Stanley thật sự vì cứu \"Stanley\" mà chúng ta biết nên đã hi sinh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130315,
					"content": "A... \"Stanley\" đó tên Stanley là vì \"lấy cắp\" tên của người khác sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130316,
					"content": "E là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130317,
					"content": "Stanley... Tôi sợ hãi bao nhiêu năm nay, sợ người trong Thành Mondstadt sẽ quên đi anh, nên đã đi khắp nơi kể về câu chuyện mạo hiểm của anh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130318,
					"content": "Tôi muốn người dân Mondstadt phải ghi nhớ, Stanley đã từng đi vào trung tâm Vùng Biển Lặng... Anh ấy là nhà mạo hiểm vĩ đại nhất, anh ấy vẫn còn sống!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130319,
					"content": "Stanley sẽ không chết, bởi vì tôi chính là!... Bởi vì tôi chính là... Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130320,
					"content": "Xin lỗi, Stanley... cả tôi cũng già rồi, tôi cũng già rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130321,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130322,
					"content": "Các bạn còn muốn nghe lén đến khi nào nữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130323,
					"content": "Tiêu rồi! Bị phát hiện rồi...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130305,
					"content": "Còn có người nào khác tên Stanley sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "Không phải chứ, ngay cả tôi cũng chưa từng nghe nói có Stanley thứ hai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
