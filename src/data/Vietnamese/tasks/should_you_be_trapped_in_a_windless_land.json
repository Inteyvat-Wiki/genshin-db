			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "Đi đi, đừng hỏi gì cả, để tôi yên tĩnh một lát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130402,
					"content": "Nhưng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130403,
					"content": "Đi! Đừng để tôi nói lần thứ hai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130404,
					"content": "Kỵ Sĩ Danh Dự, Venti, cả Paimon nữa! Tuyệt quá, các bạn đều ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130405,
					"content": "Tôi tìm các bạn khắp nơi! Tôi đến để cảm ơn, may mà có các bạn giúp tôi tìm kiếm và khiên, ba mẹ tôi đồng ý rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130406,
					"content": "Hả? Thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130407,
					"content": "Đúng vậy! Họ còn nói sẽ bỏ tiền tìm người sửa lại \"kiếm dũng khí huy hoàng\" và \"khiên ý chí tỏa sáng\" để tôi đem theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130408,
					"content": "Vậy thì tốt quá. Jack, bạn muốn rời khỏi Mondstadt để đi vòng quanh lục địa Teyvat sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130409,
					"content": "Không, tạm thời vẫn chưa đi. Với năng lực của tôi bây giờ, sợ là không đi được bao xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130410,
					"content": "Vả lại tôi còn muốn nghe câu chuyện của ngài Stanley. Hihi... Anh ấy là điểm khởi đầu cho giấc mơ của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130411,
					"content": "Ngài Stanley... A, anh ấy lại uống say rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130412,
					"content": "Ngày mai gặp lại. Đợi anh tỉnh rượu rồi lại kể chuyện cho tôi nghe có được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130413,
					"content": "Tôi thấy Stanley rất thích đứa trẻ này, bạn thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130414,
					"content": "Jack? Jack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130415,
					"content": "Jack trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130416,
					"content": "Vậy sao... Cảm ơn các bạn đã không nói ra bí mật của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130417,
					"content": "Ơ? Chịu nhìn thẳng vào hiện thực rồi sao? Không giống với bạn trước đây nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130418,
					"content": "Lúc nãy tôi còn không dám nhìn thẳng vào mắt cậu ấy. Cậu ấy đam mê mạo hiểm không chút nghĩ ngợi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130419,
					"content": "Tôi là một kẻ lừa gạt vô dụng, nhưng đứa trẻ đó là một người mới sáng bừng ý chí, tôi không thể dập tắt ước mơ của cậu ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130420,
					"content": "Cũng không thể nói là kẻ lừa gạt được? Bởi câu chuyện mạo hiểm và trải nghiệm của Stanley đều là thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130421,
					"content": "Câu chuyện... Trải nghiệm, hơ, thôi bỏ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130422,
					"content": "Thật ra, đến lúc này, ký ức của tôi về mạo hiểm, về Stanley... cũng đã mờ nhạt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130423,
					"content": "Đó mới là bí mật lớn nhất, là nỗi sợ lớn nhất của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130424,
					"content": "Bao năm nay, tôi sống vì câu chuyện của anh ấy. Nhưng tính cách, cuộc sống của anh ấy, tôi không còn nhớ rõ nữa. Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130426,
					"content": "Cuộc sống của anh ấy đã bị tội lỗi nhấn chìm rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "Chỉ còn lại bạn bè trong ảo tưởng thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "Điều duy nhất tôi không thể quên, là anh ấy chết ở Vùng Biển Lặng không có gió, gió không thể mang linh hồn của anh ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130428,
					"content": "Đúng vậy... Stanley thật ở trong ký ức anh ấy, thậm chí còn không phải là một người bạn sống nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130429,
					"content": "Mà vĩnh viễn bị trói buộc trong hình dáng chiến sĩ, cũng trói buộc cả đời anh ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130430,
					"content": "Tôi già rồi... Dù cho không muốn buông tay cũng không thể giữ được nhiều thứ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130431,
					"content": "Tôi thật vô dụng! Vô dụng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130432,
					"content": "Nhưng nhà mạo hiểm không thể chết theo cách này được... không thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130433,
					"content": "Thật... không thể tin được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130434,
					"content": "Cảm ơn mọi người... cảm ơn đại nhân Barbatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130435,
					"content": "Xin lỗi, tôi cần chút thời gian để ổn định lại tinh thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130436,
					"content": "Nhưng tôi nghĩ tôi sẽ không sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130437,
					"content": "Rất tốt! Stanley đã tìm lại được chính mình, Jack cũng đã tự lập thành công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130438,
					"content": "Nhiều tin tốt liên tục đến như vậy, chúng ta phải cạn ly ăn mừng mới được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130439,
					"content": "Bạn muốn không say không về sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130440,
					"content": "Ha ha, rượu ở đây mắc quá. Thù lao mà Jack nợ tôi vẫn chưa trả nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130441,
					"content": "Tôi đi tìm anh ta để lấy rượu trước, một lát nữa tập trung ở <color=#00E1FFFF>\"chỗ cũ\"</color> nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130443,
					"content": "Vậy là chỉ còn cách đoán rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "Tôi nghĩ chắc là tôi biết rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "Ừm, <color=#00E1FFFF>\"chỗ cũ\"</color>, không gặp không về!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "Chỗ cũ nào, sao tôi không biết! Này, này, tên hát rong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130446,
					"content": "Này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
