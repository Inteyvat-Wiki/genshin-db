					"nextDialogs": [
						710740211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740211,
					"content": "Nghe nói loại chất lượng cao sẽ có hào quang bên trong, và màu sắc của nó giống như đường ranh giới giữa biển và trời lúc hoàng hôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740212
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740212,
					"content": "Vậy có nghĩ là anh đang tìm một \"viên đá có màu sắc lấp lánh\" sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740213,
					"content": "Cũng không phải là viên đá lấp lánh nào cũng được, mà là viên đá lấp lánh \"đó\" mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740214,
					"content": "#À đúng rồi, hay là {NICKNAME} giúp tôi để ý chút xem xem có tìm thấy viên đá như tôi miêu tả không nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740215,
					"content": "Nếu như tìm thấy thì tôi sẽ trả tiền để mua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740216
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740216,
					"content": "Hứ, anh có đủ tiền để mua \"Lão Thạch\" đâu.",
