			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "Lại là ba viên \"Lão Thạch\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740602,
					"content": "Hai vị nhiệt tình giao nộp \"Lão Thạch\" như vậy thì tôi xin phép được nhận lấy đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740603,
					"content": "Không ngờ tìm được hai viên nhanh như vậy, phẩm chất lại còn khá tốt nữa chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740604,
					"content": "Haiz... chuyện này làm tôi nhớ đến viên mà tôi từng có trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740605,
					"content": "Anh từng có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740606,
					"content": "Tự anh có mà còn bắt chúng tôi đi tìm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "Là \"trước đây\" thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740609,
					"content": "KHi ba tôi ở Thịnh Lộ Đình, viên \"Lão Thạch\" đó là một mẩu nguyên liệu thừa, phẩm chất cũng khá tốt, nên ông ấy tặng cho tôi như một món đồ chơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740610,
					"content": "Lúc đó tôi ngày nào cũng gây gổ với ông ấy, lông bông suốt ngày, lại còn nợ một khoản lớn nữa, lúc đó cùng đường mạt lộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740611,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740612,
					"content": "Kém nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "Ai cũng có một thời trẻ trâu mà, dù sao thì khi tôi cùng đường mạt lộ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740614,
					"content": "Có một người nhận ra \"Lão Thạch\" nên ra giá để mua nó, nhờ nó ma tôi có được chút Mora để xoay sở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740615,
					"content": "Kết quả là mấy ngày trước đó ba tôi có hỏi đến, nói là: \"Muning à, viên đá lúc trước sao lại không thấy đâu rồi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740616,
					"content": "Tôi chỉ có thể nói, \"chỉ một viên đá mà thôi, sao lại có thể giữ được đến giờ chứ?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740617,
					"content": "Miệng thì nói vậy, nhưng mà trong lòng nghĩ, nếu như lúc đó không bán viên đá, tôi sẽ có thể lấy lại ra cho ba xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740618,
					"content": "...Thôi vậy, giờ nghĩ lại chuyện này cũng vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740619,
					"content": "Giờ sửa lỗi vẫn còn kịp mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740620,
					"content": "Nói cũng hải... chỉ là tiền nợ trước đây vẫn phải từ từ trả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740621,
					"content": "Thôi không nói nữa, nếu như có \"Lão Thạch\" thì nhớ mang đến chỗ tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740622,
					"content": "Vẫn chưa đủ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "Để tôi nghĩ xem, chỉ cần thêm 3 viên nữa thôi là có lẽ đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740625,
					"content": "Lão Thạch vốn là khoáng sản hiếm có, Huy Sơn Đình nếu như vẫn cần thì nơi này chắc cũng không thể kiếm thêm được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740623,
					"content": "Rốt cuộc phải cần bao nhiêu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "Cứ giao nộp viên của anh trước đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
