			"trigger": {
				"objectNames": [
					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740101,
					"content": "\"Lão Thạch\"... Haiz, \"Lão Thạch\", tôi ở Vực Đá Sâu lâu như vậy cũng rất hiếm khi thấy các đại nhân của Huy Sơn Đình tới...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740102,
					"content": "Một ngày nào đó các người tự mình đi tìm những thứ này đi rồi mới biết chữ khổ viết như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740103
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740103,
					"content": "Muning!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740104,
					"content": "Ồ, là hai người sao, sao vẫn còn loanh quanh ở Vực Đá Sâu này vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740105,
					"content": "À... ý tôi không phải là không hoan nghênh mọi người! Ý tôi là... ừm, hai người không có việc gấp gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740106,
					"content": "Cái gì chứ, bọn tôi chỉ là vì thấy anh đang đau đầu nên mới đến hỏi thăm thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740107,
						710740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740107,
					"content": "Đã xảy ra chuyện gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				},
				{
					"id": 710740109,
					"content": "Haiz... Hai người biết \"Lão Thạch\" chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740110
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740110,
					"content": "Đây là loại khoáng sản cho dù ở trong hầm mỏ cũng rất hiếm khi thấy, tôi ở Vực Đá Sâu lâu như vậy mà chỉ thấy qua hai ba miếng. Đó giống như là bảo thạch siêu cấp quý hiếm vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740111
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740111,
					"content": "Nghe nói loại chất lượng cao sẽ có hào quang bên trong, và màu sắc của nó giống như đường ranh giới giữa biển và trời lúc hoàng hôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740112
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740112,
					"content": "Thứ anh nói là cái này sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740113
					]
				},
				{
					"id": 710740113,
					"content": "...Hả! Hai người có sao, lại còn là Lão Thạch phẩm chất hoàn mỹ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740114
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740114,
					"content": "#{NICKNAME} này, hay là bán viên \"Lão Thạch\" này cho tôi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740115,
						710740116
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740115,
					"content": "Không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740117,
					"content": "Đúng vậy, đây là món đồ của một người bạn tặng cho chúng tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740118,
					"content": "Với lại, anh có đủ tiền để mua \"Lão Thạch\" đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740119,
					"content": "Dù sao đây cũng là chuyện của các đại nhân mà, tiền không thành vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740120
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740120,
					"content": "Chuyện của các đại nhân?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740121,
					"content": "Đúng vậy, là chuyện của các đại nhân Huy Sơn Đình, dạo này không biết tại sao họ lại rất có hứng thú với Lão Thạch, nên đã yêu cầu chúng tôi ở Vực Đá Sâu tìm vài miếng cho họ nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740122
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740122,
					"content": "Nhưng mà mỗi ngày tôi đều phải ứng phó... khụ khụ, đều phải xử lý công vụ nên rất bận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740123
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740123,
					"content": "#Hay là thế này nhé, {NICKNAME}, nếu như bạn tìm được Lão Thạch thì cứ mang đến cho tôi, tôi sẽ đưa bạn tiền thưởng của Huy Sơn Đình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740124
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740124,
					"content": "Cũng không cần phải là loại cao cấp gì đâu, chỉ cần là \"Lão Thạch\" là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740125
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740125,
					"content": "Tiền thưởng của Huy Sơn Đình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740126,
					"content": "Theo lý mà nói thì tôi phải đích thân đi một chuyến, nhưng mà dạo này tôi bận khá nhiều việc liên quan đến Vực Đá Sâu, quả thực hết cách, đành phải phiền đến hai người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740127
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740127,
					"content": "Haiz, cũng không biết các vị đại nhân Huy Sơn Đình cần bao nhiêu, thôi thì cứ lấy 3 viên trước vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740128
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740128,
					"content": "Được rồi, chúng tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740116,
					"content": "Đừng hòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740108,
					"content": "Có chuyện gì khó khăn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				}
			]
		},
