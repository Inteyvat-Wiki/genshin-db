			"dialogs": [
				{
					"id": 710740301,
					"content": "Hai vị tìm được Lão Thạch chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740302
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740302,
					"content": "Ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107404,
			"completionStepIds": [
				7107403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107403",
							"2"
						],
						"stepId": 7107403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "Quả nhiên là Lão Thạch, cảm ơn hai người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740402,
					"content": "Nhờ hai người đúng là một quyết định đúng đắn, chứ nếu như ủy thác Hiệp Hội Nhà Mạo Hiểm thì không biết tới khi nào mới tìm được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740403,
					"content": "Chưa chắc, nói không chừng Hiệp Hội Nhà Mạo Hiểm cũng sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740404,
					"content": "Ủy thác cho chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740406,
					"content": "Nhà mạo hiểm... ừm... trước đây tôi cũng rất ngưỡng mộ nhà mạo hiểm. Mỗi ngày họ đều đi đây đi đó, hầu như không đó nơi nào là họ không dám đi cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740407,
					"content": "Chứ như tôi bị phái đến đây nhiều năm như vậy, ngay cả đỉnh Vực Đá Sâu... chính là Vực Đan Sa ấy, cũng chưa đi qua lần nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740408,
					"content": "Anh chưa đến đó qua sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740409,
					"content": "Vực Đan Sa, nói thế nào nhỉ, đó như kiểu là một nơi \"rất nổi tiếng, nhưng người bản địa lại không biết\" ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740410,
					"content": "Chắc tôi cứ nghĩ rằng, dù gì cũng gần nên sau này có thời gian đi ngang qua tham quan chút là được... nên đến giờ cũng chưa đi qua lần nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740411,
					"content": "Hay là giờ đi luôn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740412,
					"content": "Nghĩ xong làm liền là chuyện rất quan trọng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740413,
					"content": "Thôi đi, giờ tôi đang không có thời gian rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740414,
					"content": "Huống chi, những chuyện chạy vặt bên ngoài như vậy cứ giao cho nhà mạo hiểm là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740415,
					"content": "Họ chuyên đi đến những nơi nguy hiểm mà, nếu như là tôi thì chưa đi đến giữa đường là bị thương rồi... không ổn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740416,
					"content": "Đúng thật, bị thương cũng là chuyện rất nghiêm trọng đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740417,
					"content": "Nếu như tôi bị thương thì sẽ không có người giám sát công việc ở đây nữa, việc kiểm tra an toàn cho các thợ mỏ cũng sẽ không còn ai phụ trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740418,
					"content": "Lỡ như có chuyện gì ngoài ý muốn thì sẽ lớn chuyện mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740419,
					"content": "Thì ra vấn đề nằm ở đây sao... tôi còn tưởng Muning chỉ là sợ bị thương thôi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740420,
					"content": "Giống như những vực sâu xung quanh Vực Đá Sâu vậy, sâu đến không thấy đáy luôn... lại còn có chiến trường cổ xưa của Nham Vương Gia để lại nữa chứ, nơi nguy hiểm như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740421,
					"content": "Tôi không hề có ý định tiếp cận đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740422,
					"content": "Được rồi, đây là thù lao cho 3 viên Lão Thạch của các bạn. Nhu cầu về Lão Thạch của Huy Sơn Đình rất lớn, nếu các bạn có thêm, tôi sẽ thu một lần 3 viên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740423,
					"content": "Tìm thấy Lão Thạch thì nhớ đến tìm tôi nhé, tất nhiên, tôi cũng sẽ trả các bạn thù lao tương xứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740424,
					"content": "Được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
