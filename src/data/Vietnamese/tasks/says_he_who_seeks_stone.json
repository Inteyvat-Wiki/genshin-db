			"dialogs": [
				{
					"id": 710740801,
					"content": "Tính thêm lần này, tổng cộng là 9 viên \"Lão Thạch\", chắc là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740802
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740802,
					"content": "Có thể hoàn thành yêu cầu của Huy Sơn Đình nhanh như vậy... quả không hổ danh là hai người!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740803
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740803,
					"content": "Chỉ là tiện chân mà thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740804,
					"content": "Là tiện tay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740805
					]
				},
				{
					"id": 710740805,
					"content": "À ừm! Thì ý của tôi là... tìm những thứ này dễ như trở bàn chân thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740806,
					"content": "Vừa bướng vừa sai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740807
					]
				},
				{
					"id": 710740807,
					"content": "Haha... Paimon nói cũng đúng, chiến công của hai vị tôi cũng được chứng kiến rồi, cho nên những chuyện nhỏ này chắc chắn không làm khó được hai vị đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740808,
						710740809
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740808,
					"content": "Đúng là như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				},
				{
					"id": 710740810,
					"content": "Kể ra thì, không thể ngờ là sau khi vào Tổng Vụ rồi mà cũng còn phải phụ trách công việc tìm \"Lão Thạch\" nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740811
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740811,
					"content": "Đúng nhỉ, trước đó anh nói là gây gổ với ba mình mỗi ngày mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740812,
					"content": "Tại sao sau này lại có thể vào được Tổng Vụ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740813,
					"content": "Trước đó tôi đã nói là có nợ một khoản lớn, hết đường lẩn trốn, lại không muốn về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740814
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740814,
					"content": "Kết quả là chủ nợ trực tiếp đến Thịnh Lộ Đình tìm ba tôi... Tôi nghe xong liền nghĩ quả này ba chắc chắn sẽ đánh gãy chân tôi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740815
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740815,
					"content": "Nhưng chân của anh vẫn còn nguyên kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740816,
					"content": "Đúng vậy... nói ra thì thật xấu hổ, ba tôi đã trả nợ cho tôi, với cũng tìm được tôi đang lang thang trên đường, nói, \"nợ của mày tao đã trả rồi, giờ mày chính thức nợ tiền của tao\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740817
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740817,
					"content": "Rồi ông ấy vịn vào đó để ép tôi làm việc trả nợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740818
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740818,
					"content": "Thì ra bây giờ anh đang nợ ba anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740819,
					"content": "Đúng vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740820
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740820,
					"content": "Lúc đó tôi trốn nợ khắp nơi, lang thang mỗi ngày, nên sớm đã quyết định là nếu có cơ hội thì tôi sẽ quyết tâm làm lại từ đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740821
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740821,
					"content": "Nhưng không ngờ cơ hội này lại là của người ba hay gây gổ với tôi cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740822
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740822,
					"content": "Đó là lần đầu tiên ba không mắng chửi tôi nữa, mà thay vào đó là một buổi nói chuyện đàng hoàng... chuyện này đáng lẽ nên sớm xảy ra mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740823
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740823,
					"content": "Nhưng mà cho dù lúc đó ông ấy có lònng nói với tôi thì tôi lúc dó cũng không có ý định nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740824
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740824,
					"content": "Xem ra ba anh đối xử với anh cũng rất tốt đó chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740825,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740826
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740826,
					"content": "Nên cho dù thế nào thì tôi cũng sẽ làm tốt công việc của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740827
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740827,
					"content": "Cho dù là việc chính ở dưới này, hay là giúp đỡ Huy Sơn Đình tìm \"Lão Thạch\" đi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740828
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740828,
					"content": "Lần này rõ ràng là do chúng tôi giúp mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740829
					]
				},
				{
					"id": 710740829,
					"content": "Có thể tìm được người giúp cũng là một cách để hoàn thành công việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740830
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740830,
					"content": "Nhưng lần này cũng may nhờ có hai vị nên công việc mới thuận lợi như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740831
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740831,
					"content": "Biết là tốt rồi.",
