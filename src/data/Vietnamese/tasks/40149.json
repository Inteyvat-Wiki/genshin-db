					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "...Đều giống nhau cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "Cho nên nguyên liệu bí mật của món ăn này, chính là \"tâm ý\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490224,
					"content": "Mặc dù nghe giống như những luận điệu cũ rích... Nhưng tôi thừa nhận là nó đúng với món ăn này. Công thức của món này, tôi đã ghi nhớ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490225,
					"content": "Nhớ công thức thì cũng phải nhớ tên chứ nhỉ? Bây giờ món ăn này đã có tên chưa?",
					"roleType": "TALK_ROLE_NPC",
