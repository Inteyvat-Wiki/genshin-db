				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "...Thời gian trôi qua nhanh thật. Tay tôi cũng đỡ hơn nhiều rồi. Từ mai chắc có thể tự mình xuống bếp rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490102,
					"content": "#{NICKNAME}, thời gian này vất vả cho {F#cô}{M#cậu} rồi. Mong là ngày cuối cùng sẽ nhẹ nhàng trôi qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490103,
					"content": "Chậc, anh nói thế, tôi dự cảm lại sắp có chuyện rồi đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490104,
					"content": "Một ngày bình yên trôi qua...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "Phù... Đến tối rồi, đúng là không xảy ra sai sót gì... ừm, chắc chắn là do chúng ta đã thành thạo rồi nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490106,
					"content": "Nhớ ngày đầu làm, đến việc thêm muối thêm ớt cũng phải gắng nhớ cả ngày trời... bây giờ có xảy ra chuyện gì cũng là chuyện nhỏ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490107,
					"content": "Không nên tự mãn như vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "Đã muộn thế này rồi, sẽ không có ai đến nữa đâu nhỉ? Ờm... Không đúng, lần đầu Lyney bọn họ đến hình như cũng vào giờ này nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}? Paimon? Đã lâu không gặp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490111,
					"content": "Amber? Eula và cả Mika nữa! Mọi người đến dùng bữa à? Sao đến trễ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490112,
					"content": "Chúng tôi vừa hoàn thành nhiệm vụ hộ tống thương đội, đang trên đường về Cổng Đá. Vốn định ăn chút đồ mang theo rồi tiếp tục lên đường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490113,
					"content": "Nhưng đội trưởng Eula nói là đã lâu không ăn món Liyue rồi, nên tiện đường đến nhà trọ này xem còn có thể gọi món không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490114,
					"content": "Ồ, là đề nghị của Eula sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490115,
					"content": "...Khụ! Cả quãng đường đến đây đều là đồ ăn sẵn... Thi thoảng cũng nên thay đổi khẩu vị chứ! Không được sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490116,
					"content": "Chào mừng đến với Nhà Trọ Vọng Thư.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "#Ăn gì nhỉ... Hừm? Đợi đã, sao lại là {F#cô}{M#cậu} phục vụ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490119,
					"content": "#Chúng tôi hiện đang là đầu bếp của nhà trọ này! Mọi người đến thật đúng lúc, vừa hay ăn được bữa cuối cùng ở đây do {NICKNAME} nấu đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490120,
					"content": "Chà, thật vậy sao? May mà Eula đề xuất đến đây đó, nếu không thì đã bỏ lỡ mất bữa ăn này rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490121,
					"content": "Vậy gọi món gì được nhỉ... Tôi không rành món ăn Liyue lắm... Mika, Eula, hai người muốn ăn gì nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490122,
					"content": "Có thể nếm thử tay nghề của tiền bối Kỵ Sĩ Danh Dự thì đã là cơ hội tốt để học hỏi rồi, tôi ăn gì cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490123,
					"content": "...Tôi cũng thế, ăn xong còn phải tiếp tục lên đường nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490124,
					"content": "Không phải cô đề xuất đến đây sao? Sao lại ăn gì cũng được... Vậy thì dựa vào Amber rồi đó, cô chọn món đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490125,
					"content": "Ừm, vậy... vậy tôi cũng ăn gì cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490126,
					"content": "Này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490117,
					"content": "Mọi người muốn gọi món gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "Ngày hôm nay vẫn chưa kết thúc đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
