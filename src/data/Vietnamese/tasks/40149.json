						401490304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490304,
					"content": "Vui ghê! Cảm giác mệt mỏi mấy ngày nay đã đột nhiên tan biến rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "#Mới vài ngày mà {F#cô}{M#cậu} đã tiến bộ như vậy rồi, nếu làm tiếp e là tôi phải nhường gian bếp này cho {F#cô}{M#cậu} mất.",
