				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "...Thơm quá, vị mặn tươi ngon vừa đủ, mỗi hạt cơm đều có hương vị!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490202,
					"content": "Hơi nóng của món ăn vừa mới ra lò, thật khiến người ta hoài niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490203,
					"content": "Haha, có thể khiến \"quân lương ngon nhất đội kỵ sĩ\" cũng phải thua kém... Món này là món gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490204,
					"content": "Gọi... gọi là... Chắc không nên gọi là \"gì cũng được\" đâu nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490205,
					"content": "Ngay cả tên cũng không có, từ nguyên liệu đến cách làm cũng rất bình thường, cũng không biết phải giới thiệu thế nào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490206,
					"content": "Nguyên liệu và cách làm đều rất bình thường sao? Tôi còn tưởng là phải dùng nguyên liệu đặc biệt hoặc là công thức đặc biệt gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490207,
					"content": "Đây không phải món \"ngon nhất\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "Mà là món \"thích hợp nhất\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "Không phải ngon nhất, mà là thích hợp nhất... nghĩa là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490210,
					"content": "Mọi người đã đi một chặng đường dài...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "Lại ăn lương khô lâu ngày...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "Vì đói nên cảm thấy ngon sao? Hình như cũng không hẳn là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490213,
					"content": "...Cũng vì liên tục ăn đồ sẵn nguội lạnh, nên mới thèm hương vị của món nóng phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490214,
					"content": "À, đây được gọi là \"mùi chảo\" sao? Hình như tôi có nghe nói qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490215,
					"content": "Đúng vậy. Ngửi mùi thơm, giống như trở về quán Người Săn Hươu vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490216,
					"content": "Hm? Giống như trở về quán Người Săn Hươu, vậy thì chẳng phải việc đến ăn món Liyue không còn ý nghĩa gì nữa sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490217,
					"content": "Không phải là mùi vị, mà là... cảm giác an tâm. Giống như về nhà vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490218,
					"content": "Yên tâm... giống như về nhà... Chẳng lẽ chính là cảm giác ngon như nhà làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490219,
					"content": "Trên đời này không có món ngon tuyệt đối...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "Mỗi người đều có sở thích riêng của mình.",
