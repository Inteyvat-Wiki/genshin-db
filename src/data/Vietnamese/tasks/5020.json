			"dialogs": [
				{
					"id": 50202001,
					"content": "Atea... Đối với tôi mà nói thì dì ấy cũng là một bậc trưởng bối đáng kính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202002,
					"content": "Sau khi ông nội qua đời, tôi được nhiều trưởng bối đề cử trở thành thủ lĩnh bộ tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202003,
					"content": "Bởi vì tôi luôn có rất nhiều ý tưởng mới lạ, nên mọi người đều tin rằng tôi có thể đưa Cư Dân Suối Nước đến một tương lai khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202004,
					"content": "Tuy nhiên, trong một thời gian dài, tôi cũng không biết phải làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202005,
					"content": "Dì Atea thường xuyên khích lệ tôi. Dù tôi có phạm sai lầm thì dì ấy cũng không bao giờ nói với tôi rằng \"tại sao lại như vậy\". Dì ấy nghiêm túc cùng tôi phân tích xem vấn đề nằm ở đâu, để tôi có thể làm tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202006,
					"content": "Tôi rất tôn trọng dì ấy. Vì vậy... Tôi sẽ ghi nhớ tất cả những gì dì ấy dạy cho tôi, và cố gắng làm tốt những gì tôi nên làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amina"
				}
			]
		}
	]
