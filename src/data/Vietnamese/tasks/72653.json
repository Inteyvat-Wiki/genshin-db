			"dialogs": [
				{
					"id": 726530101,
					"content": "Nhà Lữ Hành, bạn về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530102,
					"content": "Số mảnh bạn mang về tôi đã nghiên cứu ở trên thuyền. Xem ra chúng còn rất...\"trẻ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530103,
					"content": "Điều này cho thấy chúng có từ những khối nguyên tố mới hình thành...ừm, ví dụ như những dấu chân trên tuyết cách đây không lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530104,
					"content": "Bây giờ thì tôi hy vọng bạn có thể giúp tôi điều tra những dấu chân \"nông\" hơn...Đi ngược hướng của nó và truy tìm nguồn gốc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530105,
					"content": "Cái gọi là \"dấu chân nông hơn\" là chỉ những thể tập hợp nguyên tố Lôi đã được cô đặc ở một mức độ nhất định và để lại dấu vết trên mặt đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530106,
					"content": "Nếu có thể lấy được một số mẫu để phân loại và so sánh, có lẽ sẽ có thể vẽ được một bản đồ đường đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530107,
					"content": "Cái gì...dấu chân nông sâu, bản đồ đường đi...không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726530108,
					"content": "Ừ...thật sự khó hiểu",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "Haha, ví dụ của tôi có thể không phù hợp cho lắm, nhưng bạn đến nơi báo cáo sẽ tự khắc biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530110,
					"content": "Được rồi, không dài dòng nữa, mau xuất phát đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				}
