			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "Đại nhân Guuji Yae, tôi đến rồi đây. Xin hãy yên tâm, tôi không có dẫn theo tùy tùng đến, chuyến đi này cũng sẽ không có ai biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180202,
					"content": "Tôi biết là cô sẽ giữ lời, tôi đoán thậm chí... mấy ngày nay cô cũng ăn ngủ không yên đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180203,
					"content": "Tôi... tôi không bao giờ có ý nghi ngờ gia chủ của tôi, cô suy nghĩ quá nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180204,
					"content": "Vậy bây giờ, cho tôi hỏi chứng cứ đang ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180205,
					"content": "Ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "Ồ! Thêm một người giữ chữ tín nữa quay về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180207,
					"content": "Chúng tôi vất vả lắm mới lấy được thứ này đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180208,
					"content": "Đưa cho Sara xem đi, rồi tự cô ấy sẽ có kết luận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180209,
					"content": "Đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180210,
					"content": "...Đây đúng là quan ấn của gia chủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180211,
					"content": "Quân kháng chiến, Sangonomiya, chuyện tiền tuyến, đúng là không hề nhắc đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180212,
					"content": "Những tướng sĩ đã ngã xuống, sự đau khổ của dân chúng, đều không đáng để nhắc đến sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180213,
					"content": "Thật là xem thường mạng người, tại sao gia chủ lại giấu chuyện này chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180214,
					"content": "Đương nhiên là vì để Lệnh Truy Lùng Vision được thi hành thuận lợi rồi, nếu như báo cáo chân thật quá lỡ Shogun rút lại mệnh lệnh thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180215,
					"content": "Hiệp Hội Tenryou... quả nhiên cố ý qua mặt Shogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180216,
					"content": "Đúng vậy, nghĩ thử xem, nếu Lệnh Truy Lùng Vision được thi hành thuận lợi... thì ai là người có lợi nhất?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180217,
					"content": "Ở đây còn có một lá thư mật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "Là thư trao đổi giữa Hiệp Hội Tenryou và Fatui, cũng là do gia chủ nhà Kujou cố tình che giấu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180220,
					"content": "Thế nào? Thứ mà cô muốn thấy và không muốn thấy đều đã được trình lên trước mặt cô rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180221,
					"content": "Cô còn có ý định... tránh né sự thật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180222,
					"content": "Tôi cố gắng đến tận bây giờ là vì cái gì chứ... bọn họ... đáng ghét!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180223,
					"content": "Tôi sẽ không tha thứ cho hành vi phản bội... tôi sẽ tìm gia chủ để đối chất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180224,
					"content": "Kujou Sara nổi giận rồi, xem ra kế hoạch thành công rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180225,
					"content": "Quân Shogunate sẽ tạm thời như rắn mất đầu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "Ừm, đuổi theo cô ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180228,
					"content": "Đợi đã, tôi còn có chuyện muốn nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180229,
					"content": "Hử?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180230,
					"content": "Lần đầu tiên bạn vào \"Nhất Tâm Tịnh Thổ\", là ở trước Tượng Trăm Mắt Nghìn Tay đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180231,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "Bạn cần phải nghĩ cách để tái hiện lại chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180233,
					"content": "Đến trước Tượng Trăm Mắt Nghìn Tay, để cho Raiden Shogun mở Tịnh Thổ một lần nữa, như vậy là sẽ có cơ hội...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180234,
					"content": "Tôi sẽ cố gắng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "Mang theo thứ này đi, xem như là quà tạm biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180236,
					"content": "Đây là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180237,
					"content": "Là bùa hộ mệnh của Đền Narukami, rất linh nghiệm, tôi đã làm cho bạn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180238,
					"content": "Cảm ơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "Nếu như gặp phải hiểm cảnh, có thể nó sẽ hóa dữ thành lành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180241,
					"content": "Đương nhiên là khi nhớ tôi thì cũng có thể lấy ra ngắm, biết đâu tôi sẽ xuất hiện ngay phía sau bạn thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180242,
					"content": "Sự việc đang nguy cấp mà tiểu thư hồ ly vẫn có hứng trêu đùa nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180243,
					"content": "Hahaha... vậy thì tôi giao cô bạn ngốc nghếch của tôi cho các bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180239,
					"content": "Tôi sẽ trân trọng nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "Đi theo cô ấy có lẽ sẽ có cơ hội gặp được Raiden Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
