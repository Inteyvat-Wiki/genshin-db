			"dialogs": [
				{
					"id": 20180301,
					"content": "Các người cũng đến rồi sao? Lá gan cũng khá to đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180302,
					"content": "Các người thân là nhân chứng, trước khi tôi đối chất xong với gia chủ thì các người có thể sẽ được an toàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180303,
					"content": "Nhưng mà... nếu như lời nói trước đây của các người có vấn đề gì, thì đừng trách tôi không khách sáo, hiểu rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180304,
					"content": "Cứ việc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "Hừ, rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
