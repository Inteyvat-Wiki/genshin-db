				},
				{
					"id": 20180406,
					"content": "Hừ... Đại nhân Takayuki, tôi đã xem qua công văn trình lên Shogunate và bức thư trao đổi với Fatui. Xin ngài... hãy cho tôi lời giải thích!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180407,
					"content": "Thì ra công văn là do ngươi trộm sao? Hừ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180408,
					"content": "Câu này tôi có thể hiểu là... Công văn và bức thư đó đều chính do ngài viết, không hề ngụy tạo đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180409,
					"content": "Gia chủ, ngài hãy trả lời tôi, Hiệp Hội Tenryou... có phải đã phản bội Shogunate không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180410,
					"content": "Hừ... Ta đích thực có qua lại với Fatui, công văn đó cũng chính là do ta viết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180411,
					"content": "Thừa nhận rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180412,
					"content": "Chỉ cần hỗ trợ Lệnh Truy Lùng Vision được thi hành thuận lợi, vậy là sẽ có được lợi ích như đã hứa từ sứ giả Snezhnaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180413,
					"content": "Từ trước đến giờ, có rất nhiều gia tộc đang manh nha thế chỗ nhà Kujou, tiềm lực của chúng cũng không nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180414,
					"content": "Nếu như có được sự ủng hộ của Snezhnaya, lại có thể mượn Lệnh Truy Lùng Vision để làm suy yếu thực lực của kẻ địch thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180415,
					"content": "Ta cho rằng đây là cuộc giao dịch đáng làm, chỉ là không việc gì phải nói cho ngươi nghe thôi Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180416,
					"content": "Ngài rõ ràng... rõ ràng rất tôn sùng Shogun, tại sao lại thản nhiên bàn chuyện phản bội vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180417,
					"content": "Phản bội? Đây xem như là phản bội sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180418,
					"content": "Đám Fatui đó chẳng qua cũng chỉ bị ta lợi dụng thôi, chúng thì làm được cái gì chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180419,
					"content": "Trên lãnh thổ của Inazuma, một khi sấm sét giáng xuống thì chúng cũng chỉ như đám tôm tép run rẩy sợ hãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180420,
					"content": "Dẫu sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180421,
					"content": "Chúng ta cũng có Raiden Shogun đại nhân thiên hạ vô song, còn có \"Lưỡi Đao Vô Tưởng\" nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180422,
					"content": "Không có ý định phản bội Raiden Shogun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "Có nghĩa cái mà hắn sùng bái không phải là Raiden Shogun, mà chỉ là sức mạnh của Raiden Shogun và \"Lưỡi Đao Vô Tưởng\" thôi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180425,
					"content": "Lòng trung nghĩa của ngài đâu rồi, gia chủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180426,
					"content": "Từ khi được nhà Kujou nhận nuôi, tôi đã luôn được dạy cho lòng trung nghĩa của một quan thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180427,
					"content": "Xem ra, cái mà ngài muốn chỉ là lòng trung thành của tôi đối với nhà Kujou, ngài lo sợ rằng có một ngày tôi sẽ phản bội sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180428,
					"content": "Những đạo lý này, chẳng qua chỉ là công cụ để che đậy bản tính ích kỷ thối nát của ngài!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180429,
					"content": "Ích kỷ? Ta cũng chỉ vì quan tâm đến sự vĩnh hằng của gia tộc Kujou, ta cũng tin rằng Shogun sẽ hiểu cho ta, gia chủ đời trước... cũng nhất định sẽ hiểu cho ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180430,
					"content": "Tuy là không nên nói, nhưng nhà Kujou đã quá tự cao rồi, Fatui không dễ đối phó thế đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180431,
					"content": "Tiếp tục tranh luận với hắn cũng đã không còn ý nghĩa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "Tôi cũng từng tự vấn, chấp hành Lệnh Truy Lùng Vision có thực sự đúng không? Có trái với đạo nghĩa trong lòng tôi hay không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180434,
					"content": "Nhưng tôi vẫn hạ quyết tâm rằng, chỉ cần đó là con đường mà Shogun dẫn lối, thì tôi sẽ luôn đi đến cùng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180435,
					"content": "Nhưng đến bây giờ tôi đã hiểu, con đường vĩnh hằng sẽ không có kết thúc, ngược lại trên con đường đó... sớm đã bị ô uế bởi sự ích kỷ của các người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180436,
					"content": "Tôi sẽ kháng lệnh, tôi sẽ tự mình đặt dấu chấm hết cho sự quyết tâm này của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180437,
					"content": "Ngu dốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180438,
					"content": "Ngươi muốn đi thì cứ việc, giờ đây không một ai có thể làm lung lay vị thế của nhà Kujou nữa, thế cục sẽ không vì các người mà thay đổi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180439,
					"content": "Shogun đang ở <color=#00E1FFFF>Thiên Thủ Các</color> tiếp kiến sứ giả của Snezhnaya - quan chấp hành \"Signora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180440,
					"content": "Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "Kẻ giật dây cho chiến loạn ở Inazuma là Signora sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180442,
					"content": "Lúc trước ở Đảo Ritou, tiểu thư Chisato cũng có nhắc đến việc Hiệp Hội Kanjou đang tiếp kiến một phụ nữ cao quý... lúc đó tôi đã lờ mờ đoán ra rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180443,
					"content": "Sứ giả Snezhnaya... Đúng lúc lắm, ả ta đừng hòng nghĩ rằng sẽ có thể toàn mạng trở về!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180444,
					"content": "Sara chạy đi rồi, cô ta đang muốn lao vào Thiên Thủ Các sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180445,
					"content": "Chúng ta cũng có món nợ cần tính sổ với \"Signora\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "Đúng vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180447,
					"content": "Vậy chúng ta đuổi theo thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180448,
					"content": "Chúng ta mau đến <color=#00E1FFFF>Thiên Thủ Các</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180432,
					"content": "Thái độ của Kujou Sara đã thay đổi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "Chỉ là quá tin tưởng vào Raiden Shogun thôi sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
