				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "Ừ... Để tôi xem nào... Hình như lại xuất hiện bản đồ kho báu mới rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980402,
					"content": "Chẳng phải nói muốn giúp \"Aranara gặp nguy hiểm\" sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#Khụ khụ! Đúng, lúc này chúng ta không tìm được chủ nhà, thật đáng lo! Thế nên, {NICKNAME}, tôi cảm thấy, chúng ta nên đến nơi được vẽ trong bức tranh này xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980404,
					"content": "Sau khi đến những nơi đó, chúng ta có thể dựa theo địa điểm được miêu tả trên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980405,
					"content": "Để tìm được nhiều kho báu hơn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "Đúng! A, không đúng! Là tìm được Aranara cần được giúp đỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980409,
					"content": "Ừm... Cảm thấy \"hộp thư\" này rất thần kỳ, biết đâu chừng sau này còn có tranh vẽ mới được gửi về. Sau này chúng ta để ý hơn chút nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980407,
					"content": "Để tìm được \"Aranara đang gặp nguy hiểm\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "Ừ! Hơn nữa, biết đâu chừng còn có thể có được kho báu nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
