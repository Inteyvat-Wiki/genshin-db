					"nextDialogs": [
						221120202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120202,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Tôi đã đặt tất cả các miếng gỗ ở dưới nhà trọ. Rất dễ tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120204,
					"content": "Bạn đi tìm đi, tôi sẽ đứng canh ở đây, phòng trường hợp có người chạy qua rồi rớt xuống dưới thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
