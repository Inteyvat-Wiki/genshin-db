			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "Xem ra vẫn phải cố gắng tu luyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "Ồ, là bạn sao. Mau xem, cầu thang của nhà trọ gẫy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120104,
					"content": "Lỗ hổng lớn như vậy rất dễ khiến người đi qua rớt xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120105,
					"content": "Làm thế nào nó lại bị gãy? Ồ, trước kia có một nhóm quái vật muốn xông vào nhà trọ, tôi đã xử lý chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120106,
					"content": "Kết quả không may là đã đánh nhau với một con quái vật khổng lồ, làm vỡ tan cầu thang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120107,
					"content": "Tuy phải được sửa chữa, nhưng không còn thời gian. Bây giờ ngày càng có nhiều khách, không sửa không được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120108,
					"content": "Đoạn này khá dễ sửa, tôi có thể làm một mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120109,
					"content": "Nếu bạn rảnh, có thể giúp tôi lấy vài tấm gỗ không? Tôi đang đứng trông ở đây, kẻo sẽ có người vấp ngã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120110,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "Xin lỗi vì đã làm phiền bạn, tôi đã mua một lô ván gỗ để sửa chữa, và đặt chúng phía dưới nhà trọ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120112,
					"content": "Mau đi xem sau đó lấy vài tấm cho tôi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120113,
					"content": "Nếu lại làm hỏng nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "Không, tôi không còn trẻ nữa... Nếu làm lại lần nữa, tôi chắc chắn có thể kiểm soát được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120115,
					"content": "Tuy nhiên, phải sửa nó trước đã. Để sửa chữa, tôi cũng đã mua một lô ván gỗ và đặt chúng dưới nhà trọ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120116,
					"content": "Làm phiền bạn, giúp tôi xuống lấy được một số.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
