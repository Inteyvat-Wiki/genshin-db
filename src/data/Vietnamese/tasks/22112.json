				"points": []
			},
			"dialogs": [
				{
					"id": 221120501,
					"content": "Như vậy là yên tâm rồi, sẽ không có ai rớt xuống dưới nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120502,
					"content": "Với cầu thang không hợp lắm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "Không hợp? Vậy hết cách rồi, tôi cũng không phải là thợ gỗ chuyên nghiệp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120504,
					"content": "Hả... Nhưng đây chỉ là miếng đầu tiên, và vẫn còn một khoảng trống phải sửa chữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120505,
					"content": "Ngày hôm nay làm đến đây vậy. Nhà trọ vẫn phải mở cửa và tôi phải đi tiếp khách",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120506,
					"content": "Cầu thang phải được sửa, việc kinh doanh phải làm... Thật khó cho bạn. Cầm lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
