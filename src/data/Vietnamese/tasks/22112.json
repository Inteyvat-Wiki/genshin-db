				},
				{
					"id": 221120302,
					"content": "Tìm được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120303
					]
				},
				{
					"id": 221120303,
					"content": "Để tôi xem... gần như đủ rồi, thật làm khó cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120304,
					"content": "Bây giờ thì bắt đầu làm việc, tôi phải sửa nó nhanh chóng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 2211205,
