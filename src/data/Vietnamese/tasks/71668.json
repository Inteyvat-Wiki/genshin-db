			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "Được, những món ăn này chúng tôi sẽ đóng hộp rồi gửi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680402,
					"content": "Mỗi loài động vật đều có tập tính riêng. Chúng tôi sẽ không nhốt chúng trong lồng, mà thuê nhân viên chuyên nghiệp để theo dõi sức khỏe của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680403,
					"content": "#Muốn tìm chúng không phải chuyện dễ, {F#cô}{M#cậu} cần phải có thiết bị đặc biệt là Kính Ghi Hình do Lamiya nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680404,
					"content": "#Về mặt này thì tôi không rành lắm, để cô ấy giải thích cho {F#cô}{M#cậu} nghe vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680405,
					"content": "Ừm, để tôi giải thích cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680406,
					"content": "Kỹ thuật cơ bản của Kính Ghi Hình có liên quan đến Akasha, logic vận hành cụ thể có hơi phức tạp. Nhưng hãy yên tâm, đây là thiết bị an toàn trong thử nghiệm thực tế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680407,
					"content": "Vì chúng tôi đã gắn thiết bị phát tín hiệu nhỏ trên người động vật, nên chỉ cần đọc được tín hiệu của thiết bị, thì trong kính sẽ hiện ra cảnh tượng trong góc nhìn của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680408,
					"content": "Mặc dù vẫn còn chỗ cần cải tiến, nhưng những hình ảnh này đã tạm đủ để chúng ta định vị các loài động vật đang hoạt động rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680409,
					"content": "#Nói chung là vậy đó. Nếu {F#cô}{M#cậu} đã chuẩn bị xong thì hoan nghênh gia nhập Lữ Đoàn Móng Vuốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680410,
					"content": "#Hãy dùng Kính Ghi Hình để tìm kiếm những người bạn động vật của chúng ta nào! Quà của người nhận nuôi và các loài động vật nhỏ đều đang chờ {F#cô}{M#cậu} đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				}
			]
		},
