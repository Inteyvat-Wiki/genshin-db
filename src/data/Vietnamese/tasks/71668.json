			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "Chào mừng mọi người gia nhập hiệp hội giải cứu động vật \"Lữ Đoàn Móng Vuốt\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680102,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#Là {NICKNAME} sao, xin chào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680105,
					"content": "#Thương hội chúng tôi đang tổ chức sự kiện, {F#cô}{M#cậu} có hứng thú đến xem thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680106,
					"content": "Là loại sự kiện như thế nào vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "Nói đơn giản là gia nhập hiệp hội giải cứu động vật \"Lữ Đoàn Móng Vuốt\" do Thương Hội Phi Vân tài trợ, cùng chúng tôi nhận nuôi những loài động vật bị bỏ hoang hoặc sắp tuyệt chủng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680108,
					"content": "Thương Hội Phi Vân luôn hợp tác với các tình nguyện viên từ khắp nơi trên thế giới, giải quyết vấn đề động vật hoang dã tràn lan thông qua hoạt động nhận nuôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680109,
					"content": "Mấy năm gần đây tổ chức cứu trợ ngày càng lớn, chúng tôi bắt đầu suy nghĩ về việc hợp tác với các học giả như Lamiya trong lĩnh vực bảo tồn động vật có nguy cơ tuyệt chủng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680110,
					"content": "Tôi cũng rất vui khi có thể áp dụng thành quả nghiên cứu vào việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680111,
					"content": "#Haha, có thể hợp tác với {F#cô}{M#cậu}, đối với chúng tôi mà nói cũng là niềm vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680112,
					"content": "Nhờ có nhóm tình nguyện viên như chúng tôi và nhà nghiên cứu có tầm nhìn như cô Lamiya đây, rất nhiều động vật lang thang đã có mái ấm, những động vật sắp tuyệt chủng đã được bảo vệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680113,
					"content": "Ngoại trừ Liyue ra thì còn có Mondstadt và Sumeru... Chỉ cần là quốc gia mà Thương Hội Phi Vân hoạt động thì sẽ có cơ sở chăm sóc động vật của Lữ Đoàn Móng Vuốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680114,
					"content": "Để cảm ơn các tình nguyện viên, cũng như để quảng bá Lữ Đoàn Móng Vuốt cho mọi người biết, chúng tôi đã tổ chức sự kiện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680115,
					"content": "#{F#Cô}{M#Cậu} có thể đến khu vực nơi các động vật nhỏ được nhận nuôi để kiểm tra tình trạng sống thực tế của chúng, tiện thể nhận một món quà nhỏ luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680116,
					"content": "#Phần quà này sẽ do nhân viên tổ cứu hộ cùng những người nhận nuôi khác chuẩn bị. Đương nhiên, trước khi nhận quà thì {F#cô}{M#cậu} cũng nên chuẩn bị chút quà trả lễ cho những người nhận nuôi khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680117,
					"content": "Quà sẽ được nhân viên thu hồi và gửi cho người nhận nuôi. Quà không cần quý giá, chỉ cần có thể truyền tải tâm ý là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680118,
					"content": "#Thế nào, {NICKNAME} có hứng thú không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680119,
					"content": "Để thử xem sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "#Tốt quá! Có người nổi tiếng như {F#cô}{M#cậu} tham gia, chúng tôi rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680122,
					"content": "#Nếu {F#cô}{M#cậu} đã chuẩn bị xong thì hãy đưa quà cho tôi nhé. Nhân viên của chúng tôi sau khi kết thúc sự kiện sẽ chia cho người nhận nuôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680123,
					"content": "À, theo kinh nghiệm của tôi thì có một số người nhận nuôi thích đặc sản khu vực, có người thì thích đồ ăn ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680120,
					"content": "Tôi muốn tham gia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
