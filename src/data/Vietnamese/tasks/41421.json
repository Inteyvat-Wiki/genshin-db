					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "Nhà Lữ Hành, xin chào. Gần đây thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210102,
					"content": "Lại xảy ra chuyện gì kỳ lạ sao, Katheryne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210103,
					"content": "So với những chuyện lớn trước đây thì chuyện này cũng không đủ kỳ lạ. Nhưng vì có liên quan đến kinh tế của Mondstadt nên hơi nhức đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210104,
					"content": "Là chuyện gì thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "Gần đây nguồn nước ở gần Tửu Trang đột nhiên bị đắng. Cứ như vậy, ngành sản xuất rượu sẽ sụp đổ trong vài năm tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210107,
					"content": "Cụ thể như thế nào, bạn hãy nói chuyện với Conner của Tửu Trang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 414210105,
					"content": "Kinh tế của Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4142102",
							"2"
						],
						"stepId": 4142102,
						"stateName": "QUEST_STATE_UNFINISHED"
