			"dialogs": [
				{
					"id": 414210501,
					"content": "Á, cái gì rớt xuống vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210502,
					"content": "Endora, không có nước, sắp chết rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210503,
					"content": "Endora, là tên của bạn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210504,
					"content": "Vị đắng, là kẻ địch. Sẽ giết chết Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210505,
					"content": "Không biết làm thế nào. Phải làm sao mới cứu được bạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210506,
					"content": "Cần nước, nước ngọt. Phải đến, nước suối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210507,
					"content": "Endora, vi khuẩn ký sinh. Không có nước. Endora, không thể sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210508,
					"content": "Chúng ta làm sao để đưa nó đến chỗ có nước ngọt đây",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210509,
					"content": "Ở đây có một bình nước.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "Nhưng bình nước này cũng đắng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210511,
					"content": "Endora, có thể chịu được. Nhưng mà, không được lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210512,
					"content": "Ồ ồ, vậy không thể chậm trễ. Hãy nhanh chóng đến nơi có suối đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210513,
					"content": "Nhưng mà tên này ký sinh trên Slime Thủy và đi xa như thế, khá giống mối quan hệ của tụi mình nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142106,
