			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "Nước ở đây có vị ngọt. Endora đã phát hiện rồi, đều cùng một loại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210602,
					"content": "Endora, đồng loại, biến nước thành ngọt. Còn biến thành đắng, là Rhodeia làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210603,
					"content": "Nói vậy nghĩa là, ở Thanh Tuyền Trấn đúng là có truyền thuyết về tinh linh suối sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210604,
					"content": "Nhưng mà chúng ta phải nhanh chóng đến chỗ nước suối để đổi nước trong bình đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4142107,
			"completionStepIds": [
				4142107
			],
