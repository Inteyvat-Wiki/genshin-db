				},
				{
					"id": 414211002,
					"content": "Ấy, tự nhiên nói năng lưu loát quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414211003,
					"content": "Kết hợp với động vật nước trong nhỏ, lượng từ vựng đã tăng lên. Đã hiểu được tin của Thanh Tuyền Trấn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211004
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211004,
					"content": "\"Dòng suối cuộc sống tuôn chảy\", có chút bi thương. Là câu thơ khó hiểu. Không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211005
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211005,
					"content": "Có lẽ sau này sẽ hiểu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414211006
					]
				},
				{
					"id": 414211006,
					"content": "Endora tôi vẫn cần học hỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211007
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211007,
					"content": "Rhodeia gần đây rất nóng nảy. Nếu gặp trực tiếp, có lẽ sẽ giải quyết được vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Endora"
				}
