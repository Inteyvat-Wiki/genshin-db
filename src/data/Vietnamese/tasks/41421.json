			},
			"dialogs": [
				{
					"id": 414210701,
					"content": "...Đây là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414210702,
					"content": "A, Endora, sao bạn lại một mình chạy ra đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210703,
					"content": "Tôi là Endora, tinh linh nước trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210704,
					"content": "Xem ra, ông lão này là người rất tin vào tự tồn tại của tinh linh suối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210705,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414210706,
					"content": "Cháu và cô ấy giống nhau. Nhưng mà cháu nhỏ hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414210707,
					"content": "Endora, còn nhỏ! Endora, đang học tập.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210708,
					"content": "Nhưng việc cháu xuất hiện trước mặt ông chí ít cũng chứng minh được rằng cuộc gặp gỡ đó không phải là giấc mơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414210709,
					"content": "Cô ấy vẫn còn. Tên, không biết, cũng không trả lời Endora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210710,
					"content": "Endora, sẽ liên hệ cô ấy. Endora, sẽ chuyển lời, ông cần nói gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210711,
					"content": "Cháu nói cô ấy vẫn còn sống sao? Cháu có thể chuyển lời cho cô ấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414210712,
					"content": "Đúng vậy",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210713,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414210714,
					"content": "Ông đã già quá rồi. Ông...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "Lão Finch"
				},
				{
					"id": 414210715,
					"content": "Hỏi thăm cô ấy giùm ông nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lão Finch"
				}
			]
		},
