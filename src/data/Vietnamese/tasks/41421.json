			"dialogs": [
				{
					"id": 414210801,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210802
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210802,
					"content": "Cô ấy nói mấy câu kỳ lạ, không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210803,
					"content": "Thèm... thuồng... gì đó, không hiểu. Hỏi cũng không trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210804,
					"content": "Có thể do vốn từ vựng không đủ thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "Nói chung là có lý do không thể gặp mọi người phải không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210806,
					"content": "Không hiểu. Tinh Linh Nước Trong, chúng tôi, thích dung hòa vào nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210807,
					"content": "Cô ấy, một ý thức, cô độc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210808,
					"content": "Tôi nghĩ là vì các sinh vật khác không thể dung hòa với các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210809,
					"content": "Haiz, không có cách nào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210810,
					"content": "Như thế sẽ chết chìm trong thân thể các bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210811,
					"content": "Các bạn cô đơn thật. Chúng tôi, tất cả mọi người, yêu tất cả mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210812,
					"content": "A!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210813,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210814,
					"content": "Gần Cổng Đá, tầm ngắm của Rhodeia! Động vật nhỏ trong nước. Phải, lính trinh sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210815,
					"content": "Đúng là gần đây có thấy động vật nước trong nhỏ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210816,
					"content": "Hình như đã từng thấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "Nước mạnh, ảo hóa, động vật nhỏ. Rất nguy hiểm. Nhưng, hòa hợp với chúng, có thể học được gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210819,
					"content": "Đưa tôi đi. Bên đó bên đó. Rhodeia rất bất an. Rhodeia làm nước bị đắng. Endora học nói, nói rõ với Rhodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210820,
					"content": "Ý bạn là bạn giúp được chúng tôi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "Đúng vậy",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}, tôi thấy đáng để thử, dù gì hiện giờ chúng ta cũng không có manh mối khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210817,
					"content": "Phải không, tôi không để ý.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
			]
		},
