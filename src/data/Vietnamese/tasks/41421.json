				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Connor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "Nhân viên hỗ trợ mà hiệp hội phái đến là các bạn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210202,
					"content": "Là chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210203,
					"content": "Vậy thì tôi yên tâm rồi. Đối với việc này, các bạn tự trải nghiệm sẽ tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210204,
					"content": "Bình nước này lấy từ vùng lân cận. Nó đã trải qua tất cả quy trình lọc nước, tuyệt đối vệ sinh. Bạn có thể yên tâm nếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210205,
					"content": "Tôi cũng muốn tôi cũng muốn! Tôi cũng muốn thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210206,
					"content": "(Nếm một ngụm...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "Hu a, khụ khụ khụ. Vị đắng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210208,
					"content": "Vị đắng này không thể loại bỏ bằng phương pháp lọc nước truyền thống, không phải vấn đề về thành phần. Có thể là hiện tượng do sức mạnh nguyên tố thần kỳ gây ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210209,
					"content": "Nước như thế này không thể nào ủ rượu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210210,
					"content": "Vậy thì cá ở đây chắc cũng khó sống rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210211,
					"content": "Chúng tôi đã thử rồi, những con cá bị đắng đến nỗi lật ngửa bụng, đến lúc làm thành món ăn cũng rất đắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 414210212,
					"content": "...Tôi không nghĩ xa như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210213,
					"content": "Tóm lại, sự việc là như vậy. Nếu bạn hỏi tôi có manh mối gì hay không, tôi nghĩ nên điều tra theo hướng bắc. Không biết bây giờ mùi vị của nước ở sông Bích Thủy và Khinh Sách Trang như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Connor"
				}
			]
		},
		{
			"id": 4142105,
