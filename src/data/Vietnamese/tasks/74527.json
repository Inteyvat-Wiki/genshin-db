				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#Là {F#cô}{M#cậu} à, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270402,
					"content": "Escoffier, đã lâu không gặp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "Hôm nay tôi không phụ trách nấu nướng, chỉ đơn thuần là nếm thử thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270405,
					"content": "Savanna muốn ra mắt món mới, nhờ tôi giúp cô ấy kiểm tra. Nhưng món này... đã làm lại đến lần thứ năm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270406,
					"content": "Lúc thì độ lửa chênh lệch vài giây, ảnh hưởng đến hương vị của nguyên liệu. Khi thì tỷ lệ gia vị hơi cao khiến mùi hương liệu lấn át mùi vị chính của món ăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270407,
					"content": "Escoffier vẫn khắt khe như vậy nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "Đương nhiên rồi! Nấu nướng là cả một môn khoa học, tôi sẽ không vì cô ấy là bạn mình mà thay đổi tiêu chuẩn hương vị. Nói đúng hơn, chính vì có trách nhiệm với cô ấy và khách hàng mà tôi càng phải nghiêm khắc hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270409,
					"content": "Thật ra, tôi có một thỉnh cầu nhỏ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "...Vào lúc này sao? Nếu chụp ảnh để trưng bày công khai thì tôi nghĩ chúng ta nên chọn thời điểm khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270412,
					"content": "Cần lựa chọn bối cảnh kỹ càng, điều chỉnh ánh sáng và góc độ cẩn thận để đạt được hiệu quả tốt nhất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270413,
					"content": "Chỉ là muốn chụp vài tấm kỷ niệm cho cô thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "...Thôi được. Dù sao cũng phải đợi cô ấy làm lại lần thứ sáu, hiện giờ vẫn còn chút thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270416,
					"content": "#Vậy để tôi xem thử, ống kính mới của {F#cô}{M#cậu} và món ăn mới kia, bên nào sẽ phát huy tốt hơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270414,
					"content": "Cũng để thử nghiệm tính năng của ống kính mới.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "Để tôi chụp một tấm nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "Đang nghiên cứu thực đơn mới à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
}