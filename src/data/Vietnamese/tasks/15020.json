					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "Lông vũ... nhuốm máu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "Đợt sóng gió này cuối cùng cũng đã lắng xuống, Hội Hoa Vũ đã bình yên trở lại.\\nTrong những ngày tháng yên bình đó, thí luyện bay lượn cũng đang được ráo riết chuẩn bị...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "Sẽ được khởi động lại sớm thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
