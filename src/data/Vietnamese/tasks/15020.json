					"content": "Ừm... Không có vấn đề gì lớn cả, chỉ cần đợi vài ngày nữa là có thể tiến hành thí luyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200604,
					"content": "Cứu... cứu với...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200605,
					"content": "Các vị... là người của Hội Hoa Vũ đúng không? Mau... mau đến giúp chúng tôi với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200606,
					"content": "Bình tĩnh nào, có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200607,
					"content": "Có... có một con Qucusaur đột nhiên tấn công chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200608,
					"content": "Những người bạn đồng hành và hàng hóa của tôi đều đang ở trên đường... Xin các vị mau đi cứu họ với!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200609,
					"content": "Hả? Có Qucusaur hung dữ đến vậy sao? Một con mà tấn công cả nhóm người à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200610,
					"content": "Về lý mà nói thì không có chuyện này... Nhưng mọi chuyện đều có ngoại lệ, qua đó xem xét đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
		},
