			"dialogs": [
				{
					"id": 150200101,
					"content": "Hả, Chasca? Là trưởng lão Allpa bảo cô đến à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200102,
					"content": "Ừm, dì ấy còn việc khác cần xử lý. Tình hình bên này sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200103,
					"content": "Hmm... Theo kết quả điều tra, có lẽ là do những lần Vực Sâu xâm nhập lúc trước đã làm rối loạn Địa Mạch, trong khu vực thí luyện cũng đã hình thành đủ loại tắc nghẽn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200104,
					"content": "Về mặt lý thuyết, chỉ cần loại bỏ những phần tắc nghẽn này là sẽ khiến Phlogiston Thể Khí dồi dào trở lại. Nhưng khi thao tác thực tế lại có những vấn đề khác...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200105,
					"content": "Tình hình cụ thể thì mọi người có thể trực tiếp xuống đó xem xét. Cũng có thể hỏi thăm nhân sự có mặt ở hiện trường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
