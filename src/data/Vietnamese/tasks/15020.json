			"dialogs": [
				{
					"id": 150200401,
					"content": "Trong thời gian ngắn như vậy mà đã dọn dẹp xong rồi... Thật không hổ danh là các vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200402,
					"content": "Tiếp theo chỉ cần đợi Phlogiston Thể Khí dồi dào trở lại, như vậy là thí luyện bay sẽ có thể tiến hành bình thường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200403,
					"content": "Hmm... Inkanak, tôi muốn thử bay một chút, xem còn bỏ sót chuyện gì không. Cô giúp tôi sắp xếp được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200404,
					"content": "Hả? Nhưng địa điểm mới được dọn dẹp xong, ngộ nhỡ còn nguy cơ tiềm ẩn nào đó thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200405,
					"content": "Vậy nên tôi càng phải kiểm tra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200406,
					"content": "À... Cũng phải! Với kỹ thuật bay lượn của cô, dù có bỏ sót chuyện gì thì cũng không đến mức nguy hiểm đến tính mạng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200407,
					"content": "Môi trường trong khu vực này vẫn chưa ổn định, nếu không đích thân bay thử thì rất khó phát hiện ra vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200408,
					"content": "Vậy tôi sẽ đi sắp xếp. Khi nào chuẩn bị xong thì cứ báo với tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
