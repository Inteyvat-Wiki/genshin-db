			"dialogs": [
				{
					"id": 150200801,
					"content": "#Hmm? Chasca, {NICKNAME}, mọi người cũng đến rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "Trưởng lão Allpa? Hửm? Con Qucusaur mà họ nói đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "Bay đi trước chúng ta một bước rồi. Xem ra là biết sắp có chi viện nên đã rút lui trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "Nhưng nó lại đột nhiên tập kích con người... Là do thực phẩm mà thương đội đang vận chuyển sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "Không, thương đội này không vận chuyển thực phẩm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "Ôi! Tạ ơn trời đất! \"Cánh Phlogiston\" vẫn không sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Thương Nhân Trẻ Tuổi"
				},
				{
					"id": 150200807,
					"content": "...\"Cánh Phlogiston\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "Ôi, thực sự cảm ơn. Số Cánh Phlogiston này là hàng hóa quan trọng nhất của chúng tôi, nếu xảy ra sự cố gì thì thật không biết phải làm sao nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200809,
					"content": "...Các cậu chính là thương đội định đến chỗ chúng tôi bàn chuyện hợp tác mà Warmi nhắc đến à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "A, đúng vậy! Vậy thì chắc quý cô đây là... trưởng lão Allpa nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200811,
					"content": "Là tôi đây. Các vị đi đường mệt mỏi rồi, lại còn bị dọa cho một phen kinh hãi nữa. Trước mắt hãy theo tôi về Hội Hoa Vũ nghỉ ngơi đã, có chuyện gì thì để nói sau nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "Trưởng lão Allpa, chuyện Qucusaur tấn công...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Hmm, có vẻ như mấy người bạn này cũng không bị thương nặng, hàng hóa cũng không tổn hại gì... Có lẽ chỉ là chú Qucusaur đó nhất thời bị thứ gì đó kích động thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "Quanh đây nhiều Qucusaur như vậy, xuất hiện một hai lần sơ suất thì cũng không có gì lạ, không cần mất công điều tra đâu... Còn chuyện thí luyện bay, bên đó tu sửa ra sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "Cũng khá ổn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "Ồ? Thí luyện bay à? Thật là trùng hợp! Trưởng lão Allpa này, Cánh Phlogiston của chúng tôi chắc chắn sẽ mang đến bất ngờ trong quá trình thí luyện đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200818,
					"content": "Vậy sao? Nghe có vẻ thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Haha, vậy chuyện Qucusaur tạm gác lại đã... Chúng ta mau quay về bàn chuyện Cánh Phlogiston nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200820,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "Hình như vấn đề đã được giải quyết xong rồi nhỉ? Cũng khá thuận lợi... Vậy chúng ta đi thôi... Ơ? Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "Đang nhìn gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
