					"speakerTitle": "Điều Tra Viên Gan Dạ"
				},
				{
					"id": 150201004,
					"content": "Chỉ cần có người đứng tại đây, <color=#00E1FFFF>canh đúng thời điểm đánh vào khí cầu để thuốc nổ rơi đúng vào lỗ thông...</color> Như vậy là vấn đề sẽ được giải quyết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201005
					],
					"speakerTitle": "Điều Tra Viên Gan Dạ"
				},
				{
					"id": 150201005,
					"content": "Sao? Rất đơn giản dễ hiểu phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201006
					],
					"speakerTitle": "Điều Tra Viên Gan Dạ"
				},
				{
					"id": 150201006,
					"content": "Quả thật rất dễ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201007
					]
				},
				{
					"id": 150201007,
					"content": "Vậy thì... Khí cầu bên trên kia là ai thả vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201008
					]
				},
				{
					"id": 150201008,
					"content": "#Hả? {F#Cô}{M#Cậu} nói cái đó à... Tôi cũng không biết là ai thả, không ngờ lại bay cao như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201009
					],
					"speakerTitle": "Điều Tra Viên Gan Dạ"
				},
				{
					"id": 150201009,
					"content": "Nếu có thể bay lên đó xem thử kỹ thuật mà nó sử dụng thì tốt quá... Nhưng hiện giờ việc tu sửa địa điểm vẫn quan trọng hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201010
					],
					"speakerTitle": "Điều Tra Viên Gan Dạ"
				},
				{
					"id": 150201010,
					"content": "Tôi sẽ đi bố trí ở phía đối diện. Mọi người chuẩn bị xong thì gọi tôi một tiếng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Điều Tra Viên Gan Dạ"
				}
