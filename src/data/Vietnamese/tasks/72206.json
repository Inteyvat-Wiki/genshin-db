				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "Này! Ta vẫn còn ở đây đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060102,
					"content": "Thanh niên bây giờ sao thế nhỉ, không có chút phép tắc gì luôn sao!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060103,
					"content": "Xin, xin lỗi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "Hừ...vậy còn được, biết nhận lỗi là tốt, số nấm đó xem như ta tặng đó...đừng có đụng chạm lung tung vào nấm của ta nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060105,
					"content": "Đây là nấm của ông sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "Rồi sao, có liên quan đến ai sao! Đừng có hái lung tung nữa đấy, cứ ngoan ngoãn rời khỏi đây đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		},
		{
