				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "Này! Ta đã cảnh cáo rồi mà! Các người bị lãng tai hay mắt để trên đầu thế?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060302,
					"content": "Woa, là ma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "Ối ối! Ma gì?! Ma ở đâu!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060304,
					"content": "Ngay ở đây nè.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "Á á! Đi, đi đi! Hồn ma xấu xa mau đi đi! Nhân danh Abe, ta ra lệnh cho ngươi mau đi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060307,
					"content": "Ây da, ta sống lâu như vậy rồi nhưng chưa từng thấy linh hồn nào hung ác như vậy!! Tại sao còn chưa chịu đi!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060308,
					"content": "Cháu từ nơi khác đến đảo này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "Là linh hồn tà ác ngoài biển sương mù sao...Hừ, ta không sợ đâu! Ngươi đứng đó đừng nhúc nhích, hãy chờ Lôi Điểu đại nhân đến đây đuổi đánh ngươi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060310,
					"content": "Lôi Điểu sẽ không đến nữa đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "Ngươi nói gì...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060313,
					"content": "Mọi người đã đi cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "Cái gì...ngươi đang nói gì thế...đừng nói mấy lời đáng sợ đó chứ, da gà da vịt nổi lên hết rồi nè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060316,
					"content": "Nhưng...người trên đảo này đúng là càng ngày càng ít đi...lúc trước đứa bé Kina nói, mọi người đều đã lên thuyền rồi...haiz, cũng không biết nhóc con đó chạy đi đâu chơi rồi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060317,
					"content": "Đúng rồi, hồn ma xấu xa đại nhân đến từ ngoài đảo ơi, ngươi không đi sao...? Đi lên con thuyền màu bạc đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060318,
					"content": "Cháu chẳng thấy chỗ nào có thuyền cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "Hừ...ta biết ngay mà, người ngoài đảo sẽ không nhìn thấy con thuyền đó đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060321,
					"content": "Hồn ma xấu xa đại nhân đến từ ngoài đảo kia, cám ơn đã hối thúc ta lên thuyền. Có điều...tuy sống bao nhiêu năm nay, nhưng ta vẫn còn một số thứ chưa được nhìn thấy, thật không nỡ rời khỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060322,
					"content": "Ông cần gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "Cần? Ha ha, cũng không hẳn là cần...chỉ là muốn nhìn cái gì mới lạ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060324,
					"content": "Khi ta còn nhỏ, rất nhỏ, đã từng cá cược với Una... ta nói ở ngoài hòn đảo này chắc chắn có rất nhiều loại nấm khác nhau, nhưng Una ấy không tin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060325,
					"content": "Sau này...chồng của chị ấy ra biển để đến vùng đất của người ngoài thì không thể nào trở về nữa...linh hồn của anh ấy cũng chỉ có thể bơ vơ lạc lõng nơi đất khách...thật đáng thương!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060326,
					"content": "Vì thế, chị Una vẫn luôn sống cô quạnh một mình đến giờ...vừa nghĩ đến thì ta đã...haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060327,
					"content": "Xin đừng nhớ nhung người khác nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "Ta đã từng xin tư tế đại nhân...tốt xấu gì cũng phải cho người ta một chốn dung thân...Ơ? À đúng đúng, nấm nấm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060330,
					"content": "Khụ khụ...sắp phải lên thuyền rồi, ta cũng chẳng có gì nuối tiếc nữa...ý ta là không nuối tiếc những thứ ngoài đảo nữa. Nhưng thứ mà ta quan tâm nhất...chính là số nấm mà ta đã chăm sóc mỗi ngày này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060331,
					"content": "Nhờ ngươi mang cho ta một số loại nấm ở ngoài biển sương mù...để ta mở mang tầm mắt nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060332,
					"content": "Nhờ ngươi đó, đại nhân linh hồn xấu xa ở bên ngoài đảo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060328,
					"content": "Về nấm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "Con thuyền đó không phải chuẩn bị cho cháu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "Đã đến lúc phải nói lời tạm biệt rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "\"Biển sương mù\" đã là quá khứ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "Là cháu nè.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
