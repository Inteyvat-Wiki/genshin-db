					],
					"speakerTitle": "Sổ Tay Bị Gió Xói Mòn"
				},
				{
					"id": 752750803,
					"content": "...Thời gian không còn nhiều... đặt suy nghĩ vào Lửa Thánh... người đời sau không được quên... - Cochanina",
					"roleType": "TALK_ROLE_NPC",
