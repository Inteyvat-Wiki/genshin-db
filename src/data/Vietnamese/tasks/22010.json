				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "Junkichi, ngày mai là tới hạn nộp bản thảo rồi đó, không thể nhây thêm nữa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100102,
					"content": "Anh hối tôi cũng vô ích, tôi đang chưa có ý tưởng để viết tiếp mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100103,
					"content": "Các bạn đang tranh cãi gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "Là...nhà lữ hành sao? Đến đúng lúc lắm, bạn đến phân xử cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100105,
					"content": "Tôi là Shigeru, biên tập viên của \"Nhà Xuất Bản Yae\". Vị này là Junkichi, tác giả do tôi phụ trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100106,
					"content": "Bộ tiểu thuyết \"Quỷ Võ Đạo\" của anh ta đang rất hot, nhưng anh ta cứ không giao chương mới theo đúng hạn, có khi lại còn dời lịch đến tận mấy tuần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100107,
					"content": "Lần này anh ta cũng giở chứng nữa, ngày mai không giao được bản thảo ra thì tháng này sẽ không kịp in chương mới mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100108,
					"content": "Nếu thật sự không được thì cứ dời lịch phát hành đi, dù sao thì độc giả trung thành cũng sẽ bỏ tiền ra mua thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100109,
					"content": "Đừng nói đùa thế chứ, nếu như không cập nhật tiến độ kịp thời thì độ hot của bộ tiểu thuyết sẽ rớt xuống đáy mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100110,
					"content": "Nhưng tôi đang chưa có ý tưởng, thay vì cứ phải viết những thứ vô vị thì tôi muốn tập trung cho một câu chuyện thú vị hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100111,
					"content": "Nhưng các tác giả khác cũng đã nộp đủ hết rồi, chỉ còn thiếu mỗi anh thôi đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100112,
					"content": "Có lẽ Junkichi cần phải tìm ý tưởng thật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "Đúng vậy! Nhà lữ hành này nói đúng đó, tôi đang cần ý tưởng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100114,
					"content": "Tôi cần phải đi dạo vài chỗ để tìm ý tưởng, có ý tưởng rồi tôi mới biết phải viết gì chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100115,
					"content": "Này, lần trước anh cũng dùng lý do này để biện hộ rồi, lần này lại dùng chiêu này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100116,
					"content": "Lần này tuyệt đối không phải, anh phải tin tôi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100117,
					"content": "Thật là...Được rồi, tôi tin anh thêm lần này đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100118,
					"content": "Không được dây dưa thêm nữa đâu đó biết chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100119,
					"content": "Biết rồi, khổ lắm, nói mãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100120,
					"content": "Phù...chuyện này đúng là không thể kéo dài được nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100121,
					"content": "Giờ chúng ta đi tìm thêm tài liệu nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "Giờ chúng ta đi tìm ý tưởng nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "Nhưng chuyện ý tưởng, có lúc không phải muốn tìm là sẽ ra đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100124,
					"content": "Nhưng giờ tôi mà không đi tìm ý tưởng nữa thì Shigeru đốt nhà của tôi luôn mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
