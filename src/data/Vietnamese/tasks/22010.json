						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "Tiểu thư Aoi luôn nói, \"những vật phẩm đặc biệt sẽ luôn được những thương nhân đặc biệt xem trọng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
