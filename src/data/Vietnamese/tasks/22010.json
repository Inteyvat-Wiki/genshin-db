					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Ừm! Ý này hay đấy, để nhân vật chính có được một thanh...vũ khí vô song được tạo ra từ thuật giả kim!",
					"roleType": "TALK_ROLE_NPC",
