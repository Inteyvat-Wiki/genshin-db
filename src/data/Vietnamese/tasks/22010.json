					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "Nhưng nếu viết như vậy thì phải tốn rất nhiều công sức để miêu tả chuyển biến tâm lý, không phù hợp với chủ đề của tiểu thuyết \"Quỷ Võ Đạo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "Hay là để nhân vật chính tự nhìn thấu vậy, như vậy sẽ có thể suy đoán được nhu cầu của mỗi thương nhân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "Đừng tự ý thêm thắt khái niệm như vậy chứ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "Đây là \"sự trưởng thành\" của nhân vật, không sao đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "Tôi có ý tưởng rồi, biết viết thế nào rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "Nhà lữ hành, chúng ta về thôi, tôi phải nói ý tưởng này cho Shigeru nghe.",
