			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721310101,
					"content": "Chiếc đèn đá có hình dạng đặc biệt, dường như tản ra năng lượng khiến người khác bất an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721310102,
					"content": "Đây là...đèn lồng đá? Tại sao ở đây lại có đèn lồng đá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Í, trên cột đèn có người viết gì đó, mau xem xem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "\"Các vị đồng nghiệp, nếu có thắc mắc gì về vật trấn giữ này, hãy đến Hẻm Núi Musoujin nói chuyện với ngài Kaji.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721310105,
					"content": "Nét chữ có vẻ rất mới. Bên dưới còn có vài dòng chữ nhỏ nghệch ngoạc:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721310106,
					"content": "\"Rất xin lỗi, chúng tôi cũng không thể giúp gì được, hôm qua vừa nhận được lệnh sơ tán khẩn cấp từ đại nhân của Hiệp Hội Tenryou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721310107,
					"content": "\"Hy vọng sau này có dịp gặp lại, cùng bàn về chuyện giải quyết Họa Thần tác loạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "Quan Sát"
				},
				{
					"id": 721310108,
					"content": "Kaji dường như có vẻ rất quan tâm đến đèn lồng đá, chi bằng chúng ta đến Hẻm Núi Musoujin hỏi anh ta đi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
