			"dialogs": [
				{
					"id": 760280301,
					"content": "#Waaah, cuối cùng cũng tìm thấy {NICKNAME} rồi! Lúc nãy khi hai thứ phát sáng đó va vào nhau, tôi bị sóng xung kích của vụ nổ thổi bay đi luôn! May mà không bị thương đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "#Tôi bay mãi mới về đến đây... May mà {NICKNAME} không sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "Thực ra thì tôi cũng bay một lúc lâu đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Thì ra là... Ơ? Khoan đã, sao lại là bay cơ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "Kể cho Paimon nghe về cảnh tượng bạn vừa chứng kiến...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Hmm, tôi chưa từng nghe nói ở Teyvat còn có một nơi như vậy đấy... {NICKNAME} có chắc là không gặp phải ảo giác chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "Nhưng miễn bình an vô sự là được rồi! Nơi này nhiều chuyện khó hiểu quá, chúng ta mau rời khỏi đây đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Không ngờ chúng lại là thứ nguy hiểm như vậy, hơn nữa cũng chẳng tìm thấy kho báu nào hết... Rốt cuộc tại sao lại xuất hiện ở đây nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "Hơn nữa, nếu hai thứ phát sáng đó không phải là tiên linh, vậy thì là cái gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280308,
					"content": "Hình như tôi bị thổi bay đến một nơi kỳ lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280309
