					"Sandrone"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Ồ? Hai người tới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180102,
					"content": "Xin chào! Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "Cảm ơn lời mời của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Ơ? Trong thư không phải nói là sẽ tổ chức tiệc trà sao? Sao ở đây chẳng có gì cả, chẳng lẽ cô chưa chuẩn bị xong trà bánh à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Ha, nực cười. Xem thường tôi quá đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180107,
					"content": "Waa! Cái... cái bàn này tự nhiên từ đâu ra vậy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Haha, lợi hại chưa? Đây là bàn trà di động tôi mới nghiên cứu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180109,
					"content": "Nó không chỉ dễ mang theo, dễ thu gọn, mà còn được trang bị thiết bị lơ lửng giống như Fagio nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180110,
					"content": "Lợi hại hơn là... à thôi, tôi không tự khen nữa, nghe cứ như đang quảng cáo ấy. Hai người tự trải nghiệm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180111,
					"content": "Nào, trà và điểm tâm tôi chuẩn bị đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180112,
					"content": "Vậy thì tôi không khách sáo nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Ừm...! Ngon quá! Tay nghề của cô đỉnh thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Đương nhiên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180115,
					"content": "Nhưng mà, sao cô lại nghĩ ra làm một thiết bị như thế này vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "Tất nhiên là để có thể cùng bạn bè tận hưởng những buổi tiệc trà thư giãn ở bất cứ nơi đâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180117,
					"content": "Trước đây tôi cũng đã nói rồi. Cách để giữ lại những thứ quý giá không chỉ là giữ khư khư những gì mình đã có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180118,
					"content": "Giờ thì tôi muốn đi ra ngoài nhiều hơn, gặp gỡ bạn bè nhiều hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180119,
					"content": "Nhưng để người được mời phải chuẩn bị trà bánh và dọn dẹp bàn trà thì thật không phù hợp với lễ nghi của một quý cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180120,
					"content": "Hihi, tôi nghĩ chắc mọi người sẽ không bận tâm đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "Nhưng tôi thì có. Hơn nữa phát minh đơn giản này chẳng tốn mấy công sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180122,
					"content": "Hai người thích thế thì tặng luôn cho hai người một cái vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180123,
					"content": "Ơ?! Thế sao mà được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "Có gì không được chứ. Tôi nói rồi, tôi rất giỏi làm mấy thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180125,
					"content": "Thế thì cảm ơn cô nhé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Không có gì đâu, hai người cũng đã giúp tôi rất nhiều trong Lễ Hội Fontinalia, coi như đây là quà đáp lễ của một quý cô đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 762180104,
					"content": "Hy vọng không để cô đợi lâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}