			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tisoc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750960201,
					"content": "Lựu Lửa Sơn Vương cuối cùng cũng chín rồi, thật là nhẹ nhõm cả người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960202
					],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960202,
					"content": "#Ơ, là {F#cô}{M#cậu} à? Có chuyện gì vậy? Nếu muốn đi thì đi nhanh về nhanh nhé, đừng để người trong bộ tộc phát hiện!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960203,
						750960208,
						750960212
					],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960203,
					"content": "Về Sơn Vương...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960204
					]
				},
				{
					"id": 750960204,
					"content": "À, là muốn hỏi chuyện Sơn Vương à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960205
					],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960205,
					"content": "Sơn Vương Kongamato là một Saurian vĩ đại đã từng cùng với anh hùng chiến đấu chống lại Vực Sâu. Mọi người trong bộ tộc đều rất kính trọng nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960206
					],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960206,
					"content": "Lựu Lửa Sơn Vương thật ra cũng có người chuyên phụ trách hái quả để dâng lên cho nó ăn. Nhưng cũng có người nói các Yumkasaur khác cũng sẽ lén cho Sơn Vương ăn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960207
					],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960207,
					"content": "Vì vậy mà Sơn Vương mới to lớn hơn nhiều so với các Yumkasaur khác... À, là khỏe mạnh hơn nhiều chứ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960208,
					"content": "Về Lựu Lửa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960209
					]
				},
				{
					"id": 750960209,
					"content": "Hỏi đúng người rồi. Lựu Lửa là loại thực vật Phlogiston tuyệt vời. Việc có thể thò rễ xuống Phlogiston Thể Lỏng là một hành động rất dũng cảm đối với thực vật nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960210
					],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960210,
					"content": "Hơn nữa, loại quả mà nó kết ra cũng chứa đầy Phlogiston, ăn nhiều cũng có lợi cho Yumkasaur... Miễn là chúng không ném đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960211
					],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960211,
					"content": "Vì nếu va đập mạnh, quả Lựu Lửa sẽ nổ tung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tisoc"
				},
				{
					"id": 750960212,
					"content": "Tôi chỉ đi ngang qua thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960213
					]
				},
				{
					"id": 750960213,
					"content": "Vậy à? Không vào xem Lựu Lửa Sơn Vương sao? Nhìn nó nhiều một chút thì tâm trạng cũng sẽ tốt hơn đấy... Nếu cảm thấy buồn thì hãy đến xem nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tisoc"
				}
			]
		}
	]
