			},
			"dialogs": [
				{
					"id": 750960101,
					"content": "Mọi người trở về rồi, đi lâu quá nhỉ. Thế nào, có gặp chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960102
					],
					"speakerTitle": "Poca"
				},
				{
					"id": 750960102,
					"content": "Chúng tôi đã làm rất nhiều việc ở dưới đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750960103,
					"content": "Nói với Poca về những gì xảy ra ở rễ Cây Lựu Lửa...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750960104
					]
				},
				{
					"id": 750960104,
					"content": "Thật sự đã được giải quyết rồi sao... Được rồi, có thể báo với thủ lĩnh Wayna, không cần phải cúi đầu đi tìm Chủ Nhân Gió Đêm hoặc Cộng Đồng Trù Phú nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960105
					],
					"speakerTitle": "Poca"
				},
				{
					"id": 750960105,
					"content": "Tôi đã nói là anh ấy có thể làm được mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960106
					],
					"speakerTitle": "Poca"
				},
				{
					"id": 750960106,
					"content": "Hả, thì ra thủ lĩnh Wayna đã sớm biết rễ Cây Lựu Lửa có vấn đề sao...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750960107,
					"content": "Đó là điều đương nhiên. Tình trạng của Cây Lựu Lửa Mẹ thì ai cũng biết, chỉ có Tisoc mới nghĩ là mọi người không phát hiện ra, còn cố chấp muốn tự mình giải quyết vấn đề...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960108
					],
					"speakerTitle": "Poca"
				},
				{
					"id": 750960108,
					"content": "Tuy đầu óc không linh hoạt lắm, nhưng tôi lại thấy tính cách này của anh ấy rất đáng yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960109
					],
					"speakerTitle": "Poca"
				},
				{
					"id": 750960109,
					"content": "#Lần này cũng nhờ {F#cô}{M#cậu} đó. Hihi, {NICKNAME} và Paimon, tên của hai vị thì tôi đã biết từ lâu rồi. Dù sao thì bưu tá cũng kiếm sống bằng thông tin mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960110
					],
					"speakerTitle": "Poca"
				},
				{
					"id": 750960110,
					"content": "#Vì vậy, tôi đã tiện tay giúp đỡ một chút... Đã làm giấy thông hành ở những nơi {F#cô}{M#cậu} có thể đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960111
					],
					"speakerTitle": "Poca"
				},
				{
					"id": 750960111,
					"content": "À, thì ra là do cô sắp xếp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750960112,
					"content": "Haha, được rồi, chắc là tên ngốc đó cũng đã trả thù lao cho hai vị rồi. Tôi không thể cho hai vị ít hơn anh ta được. Nào, nhận cái này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960113
					],
					"speakerTitle": "Poca"
				},
				{
					"id": 750960113,
					"content": "Nể tình thù lao, hai vị hãy bỏ qua chuyện cũ nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Poca"
				}
			]
		},
		{
			"id": 7509602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
