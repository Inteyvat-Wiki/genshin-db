			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270101,
					"content": "Xong rồi xong rồi... Lần này xong thật rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270102,
					"content": "Bạn sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270103
					]
				},
				{
					"id": 411270103,
					"content": "Haiz, bởi vì ngày ngày đều ở chỗ này cảm thấy quá nhàm chán, còn bị các tu nữ lườm nguýt nên tôi muốn ra ngoài đi dạo thư giãn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270104,
					"content": "Tôi vừa ra khỏi thành, nghĩ đến việc đi dạo quanh Thiên Phong Thần Điện, nhưng khi tôi còn chưa đến chỗ đó... bỗng rầm rầm thiên thạch bắt đầu từ trên trời rơi xuống...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270105,
					"content": "Tôi nào dám ở lại, vội vội vàng vàng chạy về, nhưng vừa nhìn lại thì... tôi đã đánh mất một chiếc hộp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270106,
					"content": "Hiện tại bên ngoài rất loạn, tôi cũng không dám ra ngoài tìm lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270107,
					"content": "Mà... trong thời điểm này một người Fatui như tôi không dám tuỳ tiện di chuyển, cũng không biết tôi sẽ lại bị nghi ngờ thành thứ gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270108
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270108,
					"content": "Được rồi, không nói nhảm nữa, bạn có thể giúp tôi tìm lại thứ đó được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270109,
					"content": "Mấy lần \"giao dịch\" trước chúng ta không phải rất vui vẻ sao, lần này tôi cũng chắc chắn không để bạn chịu thiệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270110,
					"content": "Đừng nói những lời đáng nghi như vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270111
					]
				},
				{
					"id": 411270111,
					"content": "Cái gì... sao lại đáng nghi? Tôi chỉ kể chuyện cho bạn nghe thôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270112,
					"content": "Được rồi được rồi, bạn chỉ cần nói đồng ý giúp tôi hay không thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
