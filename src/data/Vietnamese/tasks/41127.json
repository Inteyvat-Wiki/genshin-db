					"content": "Trong hộp chứa cái gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "Ách, bạn đừng để ý cái đó, chỉ là món đồ chơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270403,
					"content": "Này! Đừng có dùng ánh mắt nghi ngờ đó nhìn tôi chứ! Tôi đâu có phải người xấu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270404,
					"content": "Nhưng bạn là người Fatui à.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "Người Fatui... tất cả người Fatui đều là người đáng nghi sao? Bạn lấy đâu ra cái kết luận đó vậy!",
					"roleType": "TALK_ROLE_NPC",
