			"dialogs": [
				{
					"id": 411270301,
					"content": "Bạn ra bên ngoài làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "Này, bạn đừng có bộ mặt hoài nghi như vậy được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270303,
					"content": "Tôi chỉ là ra ngoài đi dạo thư giãn mà thôi! Sau khi thiên thạch rơi xuống, tôi liền vội vã trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270304,
					"content": "Được rồi, bạn mau đi tìm xem, <color=#00E1FFFF>nếu thực sự không tìm được thì có thể quay lại tìm tôi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270305,
					"content": "Tôi cố gắng nhớ lại xem có thể nhớ ra được gì không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
