			"dialogs": [
				{
					"id": 411270201,
					"content": "Sao vậy? Bạn còn có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270202,
					"content": "Không có manh mối thực sự rất khó tìm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "Ừm, thôi được, vậy bạn đợi chút, để tôi nghĩ lại xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270204,
					"content": "Tôi không nhớ nữa, hình như là cũng không có gì đặc biệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270205,
					"content": "Vậy tôi hỏi bạn vài vấn đề...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "Vấn đề? Cũng được, bạn muốn hỏi gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
