			"dialogs": [
				{
					"id": 401930101,
					"content": "Ồ! Bạn của ta, nghe nói tối qua ngươi đến Phòng Tắm Hơi Aisa rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930102,
					"content": "Ta đang định gọi hết mọi người cùng đến Phòng Tắm Hơi Aisa ăn mừng một bữa! Thế nào? Đi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930103,
					"content": "Ơ, nhưng tối qua vừa đi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930104,
					"content": "Hừm... Không phải tối qua vẫn có người chưa đi sao? Như Shinobu, Gorou, người anh em Ayato nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930105,
					"content": "Nói đơn giản thì, sau khi đại ca nghe nói về chuyện này thì vô cùng muốn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930106,
					"content": "Tóm... tóm lại! Khi nào đi dạo xong nhớ nói với ta một tiếng, mọi người sẽ cùng đi tắm, suối, nước, nóng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 4019302,
