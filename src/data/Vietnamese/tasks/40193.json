			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma",
					"Arataki Itto"
				],
				"points": [
					{
						"sceneId": 1202,
						"position": [
							-11.715,
							2.036,
							-12.211
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "Dưới sự thúc giục liên hồi từ Itto, mọi người lại một lần nữa kéo đến Phòng Tắm Hơi Aisa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "Hahaha! Chỗ này chắc là nóng nhất rồi! Hôm nay chúng ta sẽ so tài xem ai có thể chịu được lâu nhất dưới nước nóng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930203,
					"content": "Haha, người anh em Itto nhiệt tình như vậy, sao tôi có thể từ chối được chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 401930204,
					"content": "Nghe này... Có phải đi xông hơi đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930205,
					"content": "Nước... ấm quá... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 401930206,
					"content": "Không được ngủ trong bể tắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930207,
					"content": "Ôi... Lông nặng quá. Tôi hơi chóng mặt rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 401930208,
					"content": "Hahaha! Người anh em Gorou! Đừng bảo là không chịu nổi rồi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930209,
					"content": "Này! Trong khu vực tắm không được làm ồn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401930210,
					"content": "Cùng lúc đó, ở bên kia...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "Haha, Itto vẫn luôn hăng hái như vậy nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930212,
					"content": "Anh à, phân tâm trong trận đấu là không tốt đâu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930213,
					"content": "#E hèm... Trận đấu đã đến hồi cam go nhất! {NICKNAME} sẽ phải đối phó thế nào đây! Hai vị cảm thấy thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 401930214,
					"content": "Ừm... Nếu là tôi, tôi sẽ cân nhắc kỹ lưỡng từng bước, củng cố ưu thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401930215,
					"content": "Hmm, tấn công dồn dập, đoạt lấy chiến thắng trong tình thế nguy cấp... Đó cũng là một cách hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "Shikanoin Heizou"
				},
				{
					"id": 401930216,
					"content": "(Đánh chậm mà chắc...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "Ồ? Chiêu thức lợi hại vậy sao? Xem ra tôi nắm chắc phần thua rồi, không cần tiếp tục nữa. Theo thứ tự bốc thăm trước đó, tiếp theo sẽ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930219,
					"content": "Ayaka, chơi thật vui nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930220,
					"content": "#A... Vâng! {NICKNAME}, xin chỉ giáo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930221,
					"content": "(Ayato... hình như cố tình thua để Ayaka được chơi thêm. Thật là...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "(Cố gắng đánh nhanh!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
