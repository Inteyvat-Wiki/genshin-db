			"dialogs": [
				{
					"id": 401930301,
					"content": "Cô chủ! Lễ Hội Hoa Mikawa lần này thật tuyệt! Số lượng du khách ghé thăm chúng ta vài ngày qua đã tăng gấp ba lần so với bình thường!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930302,
					"content": "Doanh thu tháng này chắc là đủ để đạt đến... mức này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930303,
					"content": "Được lắm. Xem ra, nói không chừng tháng này sẽ đánh bại được Nhà Xuất Bản Yae đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930304,
					"content": "Có chuyện gì mà vui thế? Sao không gọi tôi với?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930305,
					"content": "Aha... Cũng không có gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930306,
					"content": "Ồ, tôi lại có một tin vui quên chia sẻ với cô đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930307,
					"content": "Khoảng 30% lợi nhuận từ Lễ Hội Hoa Mikawa sẽ được chuyển cho Nhà Xuất Bản Yae. Tháng này chắc tôi cũng phá kỷ lục đấy, mau chúc mừng tôi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930308,
					"content": "Cái gì...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930309,
					"content": "Vậy... vậy thì xin được chúc mừng cô chủ đã đạt thành tích á quân trong lần thứ 333 thử sức cạnh tranh doanh thu với Nhà Xuất Bản Yae!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930310,
					"content": "Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930311,
					"content": "...Chúc cho đêm nay, tất cả mọi người đều sẽ có một giấc mơ đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
