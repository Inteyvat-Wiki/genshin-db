			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#Là {NICKNAME} và Paimon à? Sao thế? Lẽ nào có ủy thác siêu lợi hại gì cần đến thiên tài máy móc này ra tay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020102,
					"content": "Hihi, người quen thì dễ nói chuyện, tôi giảm giá 20% cho! Chỉ cần hai người lén mang cho tôi ít đồ ăn vặt là được. Suỵt, đừng để Ineffa biết nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020103,
					"content": "Chúng tôi đang tham quan xung quanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "Vậy là tìm đúng chỗ rồi đó. Trong xưởng của Aino tôi đâu đâu cũng là những thứ lấp lánh cả, nơi khác tuyệt đối không tìm thấy đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020106,
					"content": "Mà này, lúc đi phải cẩn thận dưới chân đó, đừng để bị vấp vào mấy cái linh kiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020107,
					"content": "Hình dáng của con robot này lạ quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "Hihi, tất nhiên rồi. Nó tên là Vịt Nắm Đấm. Ban đầu tôi định biến nó thành một con robot phân loại rác để giúp tôi dọn dẹp sắt vụn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020110,
					"content": "Kết quả lỡ tay, tôi làm nó quá chắc chắn, cánh tay cũng rất linh hoạt. Thế là tôi nảy ra ý tưởng, trang bị thêm cho nó chức năng phòng thủ siêu mạnh luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020111,
					"content": "Như vậy, nếu có kẻ xấu nào muốn lẻn vào xưởng của tôi thì nó sẽ quét sạch tất cả thành \"rác không thể tái chế\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020112,
					"content": "Ý tưởng của Aino vẫn thật là bay bổng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765020113,
					"content": "Cơ hội hiếm có...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "Tôi, tôi á? Cùng với Vịt Nắm Đấm sao? Mọi người thường chỉ quan tâm đến phát minh của tôi thôi, ít ai muốn chụp ảnh tôi lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020116,
					"content": "Tuy nhiên, nếu hai người muốn ghi lại nhật ký công việc của thiên tài máy móc và cậu em trai vô địch thì cũng không phải là không được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020117,
					"content": "Nhưng mà... Tôi thường không hay chụp ảnh cho mình, cũng không biết phải tạo dáng thế nào cho ngầu nữa... Lỡ chụp ra không đẹp thì sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020118,
					"content": "Cứ như bình thường là được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "#Được thôi, vậy giao cho {F#cô}{M#cậu} đó. Nhớ chụp luôn vẻ oai phong của Vịt Nắm Đấm nữa nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020119,
					"content": "Tôi sẽ cố gắng chụp lại khoảnh khắc ngầu nhất.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "Tôi có thể chụp ảnh cho Aino không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "Nó cũng là \"đàn em\" của Aino sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "Nhân tiện tìm kiếm tư liệu chụp ảnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
