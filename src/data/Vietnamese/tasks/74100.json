		{
			"id": 7410025,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Al",
					"Petit Chou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002501,
					"content": "Nếu có thể lấy lại bảo vật của công chúa Lyris, thế lực của phe chính nghĩa cũng sẽ lớn mạnh theo thời gian. Ngày đánh bại Narcissus không còn xa nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002502
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002502,
					"content": "...Vì vậy chúng ta cũng không được quên sự hy sinh của Ney. Nếu không nhờ anh ấy cất giấu bảo vật thì Narcissus đã công phá tòa tháp của công chúa từ lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002503
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002503,
					"content": "Ừm, anh Ney rất lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002504
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002504,
					"content": "#Chúng ta không thể để những nỗ lực của Ney và {NICKNAME} trở nên vô ích. Lần này, có mọi người giúp sức, chúng ta chắc chắn sẽ cứu được công chúa Lyris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002505
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002505,
					"content": "Đúng, cứu công chúa Lyris, sau đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002506
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002506,
					"content": "Sau đó, Vương Quốc Narzissenkreuz sẽ được khôi phục lại hào quang rực rỡ trước đây. Công chúa cũng sẽ ôm em vào lòng, chải lông cho em, và vỗ nhẹ vào vầng trán nhỏ bé của em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002507
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002507,
					"content": "Những ký ức đã mất bên dòng nước ấy sẽ lại ùa về, bạn bè sẽ cười đùa vây quanh công chúa. Mọi việc sẽ luôn vui vẻ hạnh phúc, không còn tranh chấp hay phiền muộn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002508
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002508,
					"content": "Giống như trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002509
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002509,
					"content": "...Đúng, giống như trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Al"
				}
			]
		},
		{
			"id": 7410026,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#Là {NICKNAME} à. Sau khi lấy được bảo vật của công chúa Lyris, chúng ta đã nắm được chìa khóa để chiến thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002602,
					"content": "Cuối cùng cũng có cơ hội đánh bại những kẻ xâm lược, giải cứu công chúa Lyris. Và sau đó, Dàn Giao Hưởng Jak cũng sẽ vang lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002603,
					"content": "Tiết mục cuối cùng của phần mở màn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002604,
					"content": "Mới chỉ mở màn thôi sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "#Hả? Không phải {NICKNAME} nghĩ giải cứu công chúa Lyris và xây dựng lại vương quốc là mọi thứ kết thúc đó chứ? Thế giới thực không phải là câu chuyện cổ tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002607,
					"content": "Chính vì có quá nhiều người ngây thơ, nên lịch sử mới lặp đi lặp lại vết xe đổ. Bước tiếp theo là lật đổ thể chế giai cấp và các phương pháp phân phối trong xã hội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002608,
					"content": "Trong một thế giới bình đẳng, không cần phải nói nhiều. Bình đẳng đương nhiên là một trạng thái hợp lý, và đó hẳn là trạng thái mà công chúa Lyris hướng đến. Bây giờ, lý do chúng tôi đặt chúng lại với nhau là dựa trên những cân nhắc về tình hình hiện tại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002609,
					"content": "Tôi đi trước đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "Đầu tiên chúng ta nên thiết lập... rồi lật đổ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002605,
					"content": "Tôi nghĩ đó là cao trào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
		{
			"id": 7410031,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
