			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "(Khịt khịt)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003102,
					"content": "Gâu gâu, là người tốt. Vuốt ve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003103,
					"content": "Được, vuốt ve Mori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "Vuốt ve Mori.\\nVì Mori là \"chó\" làm từ nước nên nó khá ẩm ướt.\\nNhưng Mori có vẻ rất vui.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "Gâu gâu, cảm ơn người tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003106,
					"content": "Lần sau lại vuốt tiếp nhé, Mori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "Hic, Mori hư hỏng, nên không được vuốt nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003108,
					"content": "Chuyện này có liên quan gì đến ngoan hay hư hỏng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "Gâu gâu, chó ngoan sẽ được vuốt ve, hư hỏng sẽ bị... sửa chữa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003110,
					"content": "Hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003111,
					"content": "Thấy Mori đau lòng, bạn đưa tay ra vuốt ve Mori.\\nVì Mori là \"chó\" làm từ nước nên nó khá ẩm ướt.\\nÁnh mắt màu xanh của Mori lại rạng rỡ trở lại.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "Gâu gâu! Cảm ơn vì đã vuốt ve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				}
			]
		}
	]
}