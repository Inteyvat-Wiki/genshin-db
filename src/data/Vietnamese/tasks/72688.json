			},
			"dialogs": [
				{
					"id": 726880101,
					"content": "Chúng ta lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880102,
					"content": "Bóng Hoa Sân Đình lần trước rất thú vị, có vẻ như các bạn rất có năng khiếu, các bạn sẽ rất nhanh hiểu được tinh túy của nghệ thuật cắm hoa thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880103,
					"content": "Chủ đề hoa mới đang chờ bạn giải đáp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880104,
						726880110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880104,
					"content": "Bắt đầu thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880105
					]
				},
				{
					"id": 726880105,
					"content": "Ừ ừ, chúng tôi đã sẵn sàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726880106,
					"content": "Trong mắt của hai bạn chứa ánh sáng rực rỡ tuyệt đẹp, như thể phản chiếu cả biển hoa lộng lẫy, khiến người ta không khỏi cảm thán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880107,
					"content": "Vì vậy, chủ đề hoa hôm nay sẽ tăng độ khó lên một chút, để giúp cho các bạn trau dồi thêm kỹ năng của mình hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880108,
					"content": "\"Bàn Thạch Cẩm Tú, Đóa Sen Trong Hồ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880109,
					"content": "Hãy suy ngẫm về ý nghĩa của tiêu đề, và chọn các loại hoa một cách cẩn thận để tạo ra vườn hoa của mình nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880110,
					"content": "Tôi còn chuyện khác phải làm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880111
					]
				},
				{
					"id": 726880111,
					"content": "Không sao. Khi cắm hoa cần phải tâm bình khí lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880112
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880112,
					"content": "Đợi khi hai bạn hoàn thành công việc, loại bỏ tạp niệm. Chắc chắn sẽ tạo ra được một vườn hoa hoàn chỉnh như yêu cầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
