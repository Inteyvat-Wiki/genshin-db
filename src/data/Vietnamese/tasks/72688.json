			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "Những ngày sắp tới, tôi sẽ luôn túc trực ở đây, hướng dẫn quan khách đến Lễ Hội Irodori, giúp họ cảm nhận được điểm tuyệt vời của \"Bóng Hoa Sân Đình\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870202,
					"content": "Hai vị cũng đừng quên mở ra chủ đề hoa mỗi ngày nhé, tổng cộng có 4 chủ đề đang chờ các bạn giải đáp đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870203,
					"content": "Tất nhiên, nếu hai bạn còn thắc mắc gì khác, tôi cũng sẽ cố gắng giải đáp cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870204,
					"content": "Về hoa ở đây...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "Những nguyên liệu cắm hoa đang dùng, đều do \"Tiệm Hoa Sakuya\" cung cấp. Hoa của Tiệm Hoa Sakuya chất lượng rất tốt mà giá cả cũng rất phải chăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870206,
					"content": "Có lẽ các bạn đã từng gặp Sakuya rồi, chúng tôi đã học kỹ thuật cắm hoa từ cùng một người thầy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870207,
					"content": "Sự hiểu biết của Sakuya về cắm hoa cũng rất đáng nể, nhưng khi nghe nói lượng khách tại Lễ Hội Irodori khá đông, cô ấy như có vẻ luống cuống, cho rằng thật khó để bình tĩnh cắm hoa trong môi trường như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870208,
					"content": "Vì thế, tôi cũng sẽ giới thiệu đến quan khách về \"Tiệm Hoa Sakuya\" của cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870209,
					"content": "Nếu có cơ hội, chúng tôi cũng có thể giúp đỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870219,
					"content": "Vậy hai bạn còn vấn đề gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870220,
					"content": "Cảm ơn cô, tiểu thư Fushizome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "Đừng khách sáo. Nếu có thời gian rảnh, có thể đến tìm tôi bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870210,
					"content": "Về Hiệp Hội Yashiro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "Hiệp Hội Yashiro đã luôn ủng hộ rất nhiều cho nghệ thuật cắm hoa của Inazuma. Chính xác mà nói, người đã tài trợ cho sự kiện này chính là Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870212,
					"content": "Shirasagi Himegimi đã thể hiện tài năng cắm hoa tuyệt vời từ khi còn nhỏ. Tôi đã từng được xem màn trình diễn \"Cắm hoa\" của cô ấy, và có may mắn được cùng cô ấy chia sẻ kinh nghiệm của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870213,
					"content": "Mặc dù tôi lớn hơn cô ấy, nhưng về tài cắm hoa và hiểu biết về nghệ thuật cắm hoa thì tôi không thể nào so sánh được với cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870214,
					"content": "Khi có điều kiện, hàng năm Shirasagi Himegimi sẽ cấp kinh phí để quảng bá nghệ thuật cắm hoa. Nghe nói đôi khi cô ấy còn sử dụng hết tiền tiết kiệm của mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870215,
					"content": "Shirasagi Himegimi đã bày tỏ mong muốn của mình, cô ấy muốn có thêm nhiều người hiểu và hứng thú với nghệ thuật cắm hoa, từ đó sẽ có mong muốn nghiên cứu môn nghệ thuật này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870216,
					"content": "Hóa ra Ayaka đã cố gắng nhiều như vậy vì nghệ thuật cắm hoa của Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870217,
					"content": "Hy vọng mong muốn của cô ấy có thể thành hiện thực.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "Cảm ơn hai bạn, các bạn quả là thấu hiểu lòng người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870222,
					"content": "Tạm thời không có thời gian.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "Nếu bạn có thời gian rảnh, có thể đến tìm tôi bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		}
	]
}