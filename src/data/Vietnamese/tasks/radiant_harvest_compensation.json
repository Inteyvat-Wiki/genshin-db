				]
			},
			"dialogs": [
				{
					"id": 741380101,
					"content": "Ồ, xin chào hai vị! Hai vị vừa bỏ qua một màn hay đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380102
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380102,
					"content": "Xảy ra chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741380103,
					"content": "Vừa rồi tôi đem đám sứa được thu hồi đến đây chờ anh Augereau kiểm tra. Anh ấy chưa đến mà người mua lúc trước đã đến tận đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380104
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380104,
					"content": "Họ nói từ khi thả được mấy mẻ sứa thì đã hăng hái hơn, làm ăn cũng thuận lợi hơn. Chắc là đã làm được việc tốt và được thần linh phù hộ! Cho nên muốn tìm tôi mua thêm mẻ sứa nữa để thả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380105,
						741380106
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380105,
					"content": "Tôi thì đang bắt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				},
				{
					"id": 741380107,
					"content": "#Hmm... {NICKNAME} bắt, còn anh thì bán, người mua đem thả... Này! Anh định kiếm tiền bằng cách này à?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741380108,
					"content": "Không! Sao như vậy được chứ!? Tôi không muốn gặp rắc rối nữa đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380109
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380109,
					"content": "Khụ... Tôi đã giải thích với họ là việc thả sứa sẽ có hại chứ không có lợi, nhưng họ không nghe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380110
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380110,
					"content": "Cứ cảm thấy mình may mắn, là vì đã làm... chuyện mà họ tưởng là tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380111
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380111,
					"content": "Còn cảm thấy mình cứ gặp xui xẻo thì nghĩ là quả báo vì đã nhốt mấy con sứa. Ôi... Đám người này đang nghĩ gì vậy nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380112
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380112,
					"content": "Chúng tôi còn đang tranh cãi thì anh Augereau đến bắt đám người này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380113,
						741380114
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380113,
					"content": "Vậy là vận may đến rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380115,
					"content": "...Không tìm hiểu tập tính và hệ sinh thái của sinh vật mà đem thả bừa, mục đích là vì sinh vật hay là vì vận may của bản thân không biết?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380116
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380116,
					"content": "Lại còn bị đội hiến binh bắt... Xem ra cũng không may mắn được bao nhiêu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741380117,
					"content": "À, sẵn đây nói luôn, đội hiến binh không bắt giam tôi đều là nhờ hai vị giúp cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380118
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380118,
					"content": "Ngoài thù lao lúc trước đã nói, tôi còn chuẩn bị ít đồ lưu niệm, hai vị đừng khách sáo nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380119
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380119,
					"content": "Kesean lấy một quả bóng sứa ra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741380120
					]
				},
				{
					"id": 741380120,
					"content": "Ơ... Cái gì thế này? \"Sứa Huỳnh Quang Tím\" à? Nó trông nhỏ hơn nhiều so với trước...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741380121,
					"content": "Đúng vậy, hôm qua tôi đã chọn ra một số mẫu từ đám sứa giống trong kho. Sau khi đánh số hiệu thì dư ra vài mẫu. Tôi nghĩ... hay là tặng nó cho hai vị làm kỷ niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380122
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380122,
					"content": "Chỗ sứa còn lại tôi sẽ đem về tiếp tục nhân giống, xem xem có cách nào để thả chúng về với môi trường tự nhiên không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380123
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380123,
					"content": "Tôi cũng định để lại một số mẫu Sứa Huỳnh Quang Tím để nghiên cứu nguyên nhân của việc tụ tập và phát sáng này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741380124,
						741380125
					],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380124,
					"content": "Nhìn có vẻ rất đáng yêu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380126,
					"content": "Khoan, khoan đã! Đừng thả chúng nữa nhé!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kesean"
				},
				{
					"id": 741380125,
					"content": "Bơi trong nước liệu có đáng yêu hơn không nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380126
					]
				},
				{
					"id": 741380114,
					"content": "Tự làm tự chịu thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380115
					]
				},
				{
					"id": 741380106,
					"content": "Anh thì đang bán...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741380107
					]
				}
			]
		}
	]
}