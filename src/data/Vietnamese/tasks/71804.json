			"dialogs": [
				{
					"id": 718040201,
					"content": "Bảng thông báo tại Dốc Phi Vân ghi lại tin tức trong khu phố, thông tin quảng cáo và các câu chuyện khác. Vui lòng không đăng tải những tin tức không quan trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 718040202,
					"content": "Về việc tổng vụ điều động nhân sự...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "\"Thông báo điều động nhân sự của tổng vụ như sau...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 718040204,
					"content": "Khoan đã, việc điều động nhân sự của tổng vụ đâu liên quan gì đến giấy phép kinh doanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040205,
					"content": "Thông báo tình trạng ô nhiễm nguồn nước ở Dốc Phi Vân...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "\"Về chuyện ô nhiễm nguồn nước ở Dốc Phi Vân gần đây...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 718040207,
					"content": "Ivanovich đang vội, chúng tôi không có thời gian quan tâm chuyện ô nhiễm nguồn nước đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040208,
					"content": "Về việc xin giấy phép kinh doanh mới...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "\"Nếu muốn xin giấy phép kinh doanh mới, cần những thủ tục sau...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 718040210,
					"content": "Đây chắc là giấy phép kinh doanh mới mà Ivanovich muốn xin, chúng ta mau chép lại đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
