			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "Bạn tìm thấy thông báo về giấy phép kinh doanh mới chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040302,
					"content": "Chép được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "Tốt quá rồi, tôi sẽ xem thật kỹ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040304,
					"content": "Giấy phép đi biển, giấy chứng nhận cơ sở kinh doanh và giấy cam kết an toàn kinh doanh... cả giấy phép kinh doanh cũ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040305,
					"content": "May mà những giấy tờ này mấy hôm trước tôi đã đi ký hết rồi, vất vả vô cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040306,
					"content": "Nhà lữ hành, phiền bạn giúp tôi đi một chuyến nữa, để nộp số giấy tờ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040307,
					"content": "Khụ khụ... Có thể có khá nhiều người nộp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040308,
					"content": "Ừm, trước hết, <color=#00E1FFFF>giấy phép đi biển </color>giao cho Tiểu An, <color=#00E1FFFF>giấy chứng nhận cơ sở kinh doanh và giấy cam kết an toàn kinh doanh </color>giao cho Thiên Nham Quân Jiayi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040309,
					"content": "Còn <color=#00E1FFFF>giấy phép kinh doanh cũ</color>, giao cho Zhao là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040310,
					"content": "Nhà lữ hành, hãy giúp tôi, nhất định tôi sẽ chuẩn bị đủ thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040311,
					"content": "Thôi được, thôi được...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "Hy vọng sau khi chạy xong số thủ tục này thì sẽ không phải chạy thêm gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040313,
					"content": "Hy vọng không cần chạy thêm nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "Bạn thì không, nhưng tôi... làm ăn ở đây, sau này cũng không tránh khỏi phải chạy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040315,
					"content": "Ừm, tuy cách làm này thật sự rất yên tâm, nhưng nếu có thể đơn giản hóa một chút thì tốt hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
