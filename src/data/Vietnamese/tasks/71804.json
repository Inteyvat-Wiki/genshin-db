			},
			"dialogs": [
				{
					"id": 718040501,
					"content": "Vui lòng giữ trật tự, giữ trật tự!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040502,
						718040504
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040502,
					"content": "Về giấy phép kinh doanh mới của Ivanovich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "Ủa? Bạn đến làm thay người khác đúng không, vậy thì đưa giấy chứng nhận cơ sở kinh doanh... và cái gì nhỉ? À... giấy cam kết kinh doanh an toàn, đều đem đủ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040504,
					"content": "Bạn đang phụ trách việc giấy phép kinh doanh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "Không có, không có. Tôi chỉ đến phụ giúp tạm thời, Zhao không có thời gian sắp xếp giấy tờ, nên tôi đến giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040506,
					"content": "Ôi, làm công việc này thật chóng mặt... Được rồi, bạn có mang theo giấy chứng nhận cơ sở kinh doanh và giấy cam kết kinh doanh an toàn đến không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7180406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
