			"dialogs": [
				{
					"id": 718040401,
					"content": "Tại sao thủ tục của tài liệu này lại không đủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040402
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 718040402,
					"content": "Về giấy phép kinh doanh mới của Ivanovich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Ivanovich... Ừm, trước đây có đến vài lần, tôi có ấn tượng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 718040404,
					"content": "Bạn ấy đang chạy thủ tục của giấy phép kinh doanh mới đúng không? Haha... chắc cũng mệt mỏi lắm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "Tiểu An"
				},
				{
					"id": 718040405,
					"content": "Bạn đến làm giúp bạn ấy đúng không, có đem <color=#00E1FFFF>giấy phép đi biển</color> đến không? Lần trước tôi có nói thủ tục của bạn ấy không đủ, cần phải bổ sung...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiểu An"
				}
			]
		},
