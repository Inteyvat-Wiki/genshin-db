			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sakaw"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "Sương mù trên biển dạo gần đây ngày càng dày đặc... Thật đáng lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760404,
					"content": "Chẳng lẽ truyền thuyết đó là sự thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760405,
					"content": "Truyền thuyết gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "Hả... À ừm, vậy thì phải xem vị dũng sĩ ngoại quốc đây muốn nghe truyền thuyết như thế nào đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760407,
					"content": "Câu chuyện về hòn đảo nổi trên mặt biển và graffiti khổng lồ có hai nguồn gốc: Một cái giống câu chuyện hơn, một cái lại giống truyền thuyết chân thực hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760402,
					"content": "#Dũng sĩ xứ lạ, {F#cô}{M#cậu} muốn nghe gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760408,
					"content": "Nghe câu chuyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "Hmm, phần này thì sẽ lãng mạn hơn... Nguồn gốc của graffiti trên đảo nổi sương mù, là thuộc một phần trong \"Câu Chuyện Của Qoyllor Và Ukuku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760403,
					"content": "Nghe nói cô gái có tên là Qoyllor vì muốn liên lạc với người cha mặt trời của mình, nên đã để lại một bức graffiti khổng lồ bên bãi biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760410,
					"content": "Người cha mặt trời của cô nhìn thấy được graffiti từ trên bầu trời, nên đã đón cô rời khỏi mặt đất... Câu chuyện đại khái là như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760417,
					"content": "Màn sương trông có vẻ bất an đó, nghe nói là sự trừng phạt mà người cha mặt trời giáng xuống cư dân bộ tộc trên mặt đất, vì họ đã cướp đi sức mạnh của con gái ông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760415,
					"content": "Haiz, dù là truyền thuyết hay câu chuyện thì sương mù dày đặc trên mặt biển cũng không phải điềm lành gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760416,
					"content": "Dũng sĩ ngoại quốc à... Nơi đó bây giờ nói không chừng đang rất nguy hiểm, tốt nhất là đừng lại gần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760411,
					"content": "Nghe truyền thuyết chân thực...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "Nghe kể rằng rất lâu về trước, có một phù thủy vô cùng tà ác giả làm Wayob, mê hoặc dũng sĩ của bộ tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760413,
					"content": "Sau đó, các dũng sĩ của bộ tộc đã dùng graffiti khổng lồ để phong ấn phù thủy tà ác này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760414,
					"content": "Mặt biển trở nên như vậy, nghe nói là do điềm báo cho việc phù thủy tà ác sẽ phá vỡ phong ấn để thoát ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				}
			]
		},
