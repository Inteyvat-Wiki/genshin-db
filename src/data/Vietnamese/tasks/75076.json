				]
			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "#Cuối cùng thì... Dũng sĩ ngoại quốc, nếu không phải {F#cô}{M#cậu} giúp đỡ, thì e là nơi này đã sớm bị kẻ địch đen tối chiếm cứ rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Hóa Thân Wayob Yếu Ớt"
				},
				{
					"id": 750761202,
					"content": "...Rất lâu trước đây, dân cư bộ tộc nơi đây đã bị mê hoặc bởi hình dạng của kẻ địch đen tối hóa thành, nhiều Dạ Hồn đã bị Vực Sâu cuốn lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Hóa Thân Wayob Yếu Ớt"
				},
				{
					"id": 750761203,
					"content": "Khi bị phong ấn tại đây, dù là sức mạnh của màn đêm cũng sẽ bị nuốt chửng từng chút một... Phong ấn nơi đây đã ngăn cách thế giới bên ngoài, cũng ngăn cách nguồn gốc niềm tin của người trong bộ tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Hóa Thân Wayob Yếu Ớt"
				},
				{
					"id": 750761204,
					"content": "Chỉ khi giải trừ phong ấn, mới có được cơ hội chiến đấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Hóa Thân Wayob Yếu Ớt"
				},
				{
					"id": 750761205,
					"content": "Cảm ơn nhé, dũng sĩ ngoại quốc... Dạ Hồn được trở về với quê hương ảo mộng, ngăn chặn mầm mống ô uế xâm chiếm Vương Quốc Dạ Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Hóa Thân Wayob Yếu Ớt"
				},
				{
					"id": 750761206,
					"content": "Cuối cùng... cũng có thể quay về nơi tĩnh lặng của màn đêm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hóa Thân Wayob Yếu Ớt"
				}
			]
		}
	]
