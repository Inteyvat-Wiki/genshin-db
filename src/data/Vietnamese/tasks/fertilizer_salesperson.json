			"dialogs": [
				{
					"id": 728130801,
					"content": "Alrani, là em thật sao, sao em lại đến Inazuma? Không phải em đang ở Liyue sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130802,
					"content": "Hic...chuyện dài dòng lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130803,
					"content": "Kaushik, anh quen Alrani sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130804,
					"content": "Anh là...Ồ, anh là đại tướng Gorou đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130805,
					"content": "Chính xác, Alrani cũng giống tôi, đều là học giả của Giáo Viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130806,
					"content": "Chúng tôi rời Giáo Viện, mỗi người đi một nơi vì làm đề tài khác nhau. Không ngờ lại gặp nhau ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130807,
					"content": "Nhưng mà...Học giả có thể tự do rời khỏi Giáo Viện sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130808,
					"content": "Cũng không thể nói là có thể tự do rời khỏi. Tôi và Alrani đều thuộc Driyosh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130809,
					"content": "Đối với chúng tôi, học tập ở bên ngoài là một phần của nghiên cứu, cho nên rời khỏi Giáo Viện là hành động được phép.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130810,
					"content": "Đại tướng Gorou, tôi có thể đảm bảo cho Alrani, anh xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130811,
					"content": "Có anh đảm bảo thì không thành vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130812,
					"content": "Phù...được cứu rồi...cảm ơn mọi người...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130813,
					"content": "Hiroyuki, Ookubo, hai người cũng đi làm việc của mình đi, việc ở đây xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130814,
					"content": "Vâng, đại tướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130815,
					"content": "Vâng, đại tướng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130816,
					"content": "Xin lỗi tiểu thư Alrani vì đã nghi ngờ cô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130817,
					"content": "Ừm...mặc dù nghi ngờ đã được xóa bỏ, nhưng cô đã tự ý đột nhập vào Đảo Watatsumi, gây ra cho chúng tôi rất nhiều rắc rối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130818,
					"content": "Hở? Bị phạt sao? Tôi không có đem theo nhiều Mora, hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130819,
					"content": "Cô nói cô là một người bán phân bón...Mà còn là một học giả bán phân bón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130820,
					"content": "Đúng lúc chỗ chúng tôi có một người tên Iwata đang nghiên cứu về phân bón, tiểu thư Alrani, cô đến giúp anh ta nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130821,
					"content": "Nếu cô có thể giúp anh ta làm ra một loại phân bón không ảnh hưởng đến người khác, thì cô sẽ được tự do nghiên cứu quanh đây giống Kaushik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130822,
					"content": "Phân, phân bón? Không, chuyện đó, tôi chỉ là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130823,
					"content": "Cô ấy làm được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "Alrani, đây là cơ hội để thu thập tư liệu, em đã đến Inazuma, thì chứng minh, luận văn của em sẽ còn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130826,
					"content": "Ừm...Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130827,
					"content": "Em cũng biết tiêu chuẩn tốt nghiệp của Giáo Viện mà, nếu mấy năm liên tiếp không thể tốt nghiệp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130828,
					"content": "Tôi, tôi làm! Tôi làm là được chứ gì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130829,
					"content": "Tôi cũng đã tìm hiểu về phân bón ở chỗ Vahid...Xem tôi làm nó trong một nốt nhạc đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130830,
					"content": "Đúng là tốt nghiệp có thể thúc đẩy con người ta trưởng thành...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "Vậy thì chuyện này quyết định vậy nhé, chuyện phân bón nhờ cô đó, tiểu thư Alrani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130833,
					"content": "Đúng rồi, nhớ nói Iwata đem đống phân bón đi...xa một chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130834,
					"content": "Vậy tôi cũng đi nghiên cứu tiếp đây, Alrani, có vấn đề gì cứ đến tìm anh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130831,
					"content": "Tốt nghiệp đúng là động lực mạnh mẽ nhất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "Giao cho bạn đó, Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
