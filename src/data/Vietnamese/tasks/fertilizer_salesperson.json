				{
					"id": 728130701,
					"content": "Ý nghĩa của vật tổ... Hửm? Nhà Lữ Hành, bạn tìm tôi có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130702,
					"content": "Về chuyện của Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "Bạn nói Alrani đã đến Đảo Watatsumi? Kỳ lạ, sao lại đến đây nhỉ, không phải Alrani đến Liyue sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130704,
					"content": "Cô ấy bị binh sĩ bắt lại rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "Cái gì? Haiz... Đến đảo Watatsumi trong trường hợp này...đương nhiên sẽ bị nghi ngờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130706,
					"content": "Khoan hãy nói chuyện này, chúng ta mau đến đó đi, con bé này thật liều lĩnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				}
			]
		},
