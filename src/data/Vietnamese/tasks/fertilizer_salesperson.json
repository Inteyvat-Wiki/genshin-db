			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "Cảm ơn, cảm ơn bạn, Nhà Lữ Hành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130302,
					"content": "Tôi mới làm được một nửa thì những ma vật đó đột nhiên xông đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130303,
					"content": "Thật kỳ lạ...may mà bạn đã đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130304,
					"content": "Chắc là do đống phân bón kia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "Vậy, vậy sao? Nhưng mà tôi nghe nói, mùi này là dấu hiệu của sự thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130306,
					"content": "Không nói những chuyện này nữa, nào nào, đến xem thử phân bón tôi vừa làm đi, để tôi mở ra nói chi tiết cho bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130307,
					"content": "Chờ đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130308,
					"content": "Ơ? Ngài Gorou, sao hôm nay ngài lại rảnh rỗi đến đây vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130309,
					"content": "Đi tuần sao？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "Tôi đang...ừm...Khoan hãy nói chuyện này đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130311,
					"content": "Cái đống...này, là hai người làm sao？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130312,
					"content": "Hahaha, đúng vậy, đống phân bón này là tôi và Nhà Lữ Hành này làm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130313,
					"content": "Ngài Gorou, lẽ nào ngài đến đây cũng là vì muốn xem tình trạng của đống phân bón này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130314,
					"content": "Haha, ngài đến thật đúng lúc, bây giờ chúng tôi sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130315,
					"content": "Chờ đã! Không phải tôi đến để xem cái này, à không, tôi đến để xem cái này...tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130316,
					"content": "Mặt Gorou hình như không thể nhịn được nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130317,
					"content": "Chúng ta đứng xa đống phân bón một chút trước đi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "Được, chúng ta sang bên kia nói chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130319,
					"content": "Rốt cuộc ngài Gorou đến đây làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130320,
					"content": "Gần đây, rất nhiều cư dân cho biết họ ngửi thấy mùi hôi kinh khủng....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130321,
					"content": "Để đảm bảo an toàn, tôi quyết định đi điều tra, và lần theo mùi hôi đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130322,
					"content": "Sau đó, tôi tìm thấy hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130323,
					"content": "Iwata, tôi nghe nói bạn đang nghiên cứu phân bón, nhưng cách làm này thật sự quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130324,
					"content": "Làm phiền mọi người.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "Đúng vậy. Dù thế nào thì Iwata, hãy bỏ đống phân bón đó đi trước, về chuyện phân bón, tôi sẽ nghĩ cách khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130327,
					"content": "Đại tướng! Đại tướng Gorou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130328,
					"content": "Tôi đây, sao thế？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130329,
					"content": "Đại tướng, chúng tôi đã bắt được một người lén lút ở bên ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130330,
					"content": "Người đó lén lút và cứ nói mình là...người bán phân bón gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130331,
					"content": "Chúng tôi cảm thấy có điều không ổn, vì vậy đã giam người đó lại. Đại tướng hãy mau đến xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130332,
					"content": "Lại là phân bón, hôm nay tôi thật sự sống không nổi vì phân bón mất thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130333,
					"content": "Tôi biết rồi, tôi sẽ đến ngay, hãy đến đó giữ trật tự trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130334,
					"content": "Iwata, hãy xử lý đống phân bón này trước, mọi chuyện để nói sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130335,
					"content": "Nhà Lữ Hành, bạn cũng cùng làm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130336,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "Tôi cứ cảm thấy có một cảm giác quen thuộc...nhưng lại không thể nhớ ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130339,
					"content": "Bỏ đi, tóm lại cứ đi xem trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130337,
					"content": "Người Bán... Phân Bón?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "Kích thích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
