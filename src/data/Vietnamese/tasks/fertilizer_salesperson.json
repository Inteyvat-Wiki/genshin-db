			"dialogs": [
				{
					"id": 728130901,
					"content": "Bạn về rồi à, Nhà Lữ Hành, tôi đã xử lý xong đống phân bón rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130902
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130902,
					"content": "Haiz, tôi phải tìm nơi khác để thử lại thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130903
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130903,
					"content": "Í, đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130904,
					"content": "Đây là trợ thủ Gorou tìm cho bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "Xin chào, tôi là Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130909,
					"content": "Chuyện đó...Tóm lại, đại tướng Gorou bảo tôi đến đây giúp bạn nghiên cứu phân bón...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130910,
					"content": "Hợp tác vui vẻ nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130911,
					"content": "Vậy sao...Tuyệt quá! Nếu thật sự có thể làm được phân bón, thì có thể trồng thêm nhiều cây trên Đảo Watatsumi rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130912,
					"content": "Nhớ đặt phân bón xa xa một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "Hả? À...à, tôi biết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130914,
					"content": "Tóm lại, hợp tác vui vẻ nhé! Xin hãy chỉ bảo nhiều, tiểu thư Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130915,
					"content": "Được, tôi sẽ cố gắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130916,
					"content": "Vì luận văn, tôi sẽ cố gắng, hic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130906,
					"content": "Đây là chuyên gia phân bón đến từ Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "Xin chào, tôi là Alrani...chờ chút, ai là chuyên gia phân bón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130908
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130908,
					"content": "Tôi chỉ...tìm hiểu sơ sơ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
