			"dialogs": [
				{
					"id": 760290201,
					"content": "Aino! Có ở nhà không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290202,
					"content": "Woa! Là tiếng của Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290203,
					"content": "Xin chào! Hai người mang đồ ăn vặt đến thăm Aino sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290204,
					"content": "Biết ngay là cô sẽ nói vậy mà! Tôi đã chuẩn bị sẵn trên đường tới đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290205,
					"content": "Mau đưa đây nhanh! Không lát nữa Ineffa sẽ về đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290206,
					"content": "Vậy hôm nay chúng ta sẽ chơi gì đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290207,
					"content": "Hihi... Thực ra thì, chúng tôi có một việc cần nhờ Aino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290208,
					"content": "Waaah! Đem... đem nó đi! Mau đem thứ kỳ quái đó đi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290209,
					"content": "Kỳ quái? Là cây đàn này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290210,
					"content": "Nói rồi, tôi ghét những thứ không thể lý giải bằng khoa học và máy móc mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290211,
					"content": "Cây đàn đó cứ vài ngày lại xuất hiện trước cửa nhà tôi, mỗi lần sửa xong thì nó lại biến mất vô cùng kỳ lạ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290212,
					"content": "Tôi... tôi không tin là có thứ quỷ quái như vậy đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290213,
					"content": "Ah... Xem ra là có hiểu lầm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290214,
					"content": "Hiểu lầm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290215,
					"content": "Đây là cây đàn của một người bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "Ừm, thực ra cô ấy không có ác ý gì, cũng vì một số lý do nên mới lén mang tới thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290218,
					"content": "Thật sao? Không có lừa tôi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290219,
					"content": "Vậy... tôi tin hai người. Để tôi sửa lại lần nữa... lần này sẽ triệt để hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290220,
					"content": "Cứ đợi ở đây nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290221,
					"content": "Aino vẫn rất đáng tin cậy... Chỉ là khi bị dọa vì hành động lén lút đặt đồ đó cũng hơi đáng thương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290222,
					"content": "Đúng là nên trả ơn cô ấy một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290223,
					"content": "Aaargh!! Sao lại đột nhiên xuất hiện ở đây thế!? Làm tôi giật mình đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290224,
					"content": "Tôi đến đưa ít đồ rồi về ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290225,
					"content": "Hmm? Đây là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290226,
					"content": "Kuuhenki đã thu thập một số \"báu vật\" để cảm ơn cô thợ máy này. Nó cảm thấy cô ấy sẽ thích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290227,
					"content": "Ồ, nhiều linh kiện kỳ lạ quá! Được, lát nữa chúng tôi sẽ đưa cho Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290228,
					"content": "Trên đường về cô cũng phải cẩn thận đó, đừng để bị người khác nhìn thấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290229,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "Hả? Sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290232,
					"content": "Bên kia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290233
					]
				},
				{
					"id": 760290233,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290235
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290236,
					"content": "Đang so sánh mức độ tương đồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290237,
					"content": "So sánh gì vậy?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290238,
					"content": "Độ tương đồng với Tượng Nguyệt Thần Nod-Krai: 95%...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290239,
					"content": "Cô ấy là... diễn viên!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "#Phát hiện nhịp tim của {NICKNAME} đang tăng lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290243,
					"content": "Sửa xong rồi! Lần này chắc sẽ không hỏng nữa. À mà ban nãy chuyện đồ ăn... Ối... I... Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290244,
					"content": "\"Đồ ăn\", Aino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290245,
					"content": "À ừm, đồ ăn của robot... Tức là linh kiện ấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290246,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290247,
					"content": "Hmm? Người ở phía sau lưng là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290248,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290249,
					"content": "Là người ủy thác cây đàn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "(Cảm thấy quen quen... Mình gặp cô gái này ở đâu rồi nhỉ? Thôi kệ, đồ ăn vặt Paimon đưa cho mình chắc đã giấu kỹ rồi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290252,
					"content": "Đúng... Đúng đó! Số linh kiện đó cũng là cô ấy mang tới, nói là muốn cảm ơn Aino đã giúp sửa cây đàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290253,
					"content": "Hmm? Để xem nào... Ôi! Đều là những linh kiện cổ xưa hiếm có! Tôi có thể nhận thật sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290254,
					"content": "...Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290255,
					"content": "Cảm ơn nhé! Sau này có thứ gì cần sửa thì cứ đến tìm tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290256,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290257,
					"content": "Vậy, vậy chúng tôi cũng phải về đây. Aino, Ineffa, hẹn hôm khác lại đến chơi nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290258,
					"content": "(Phải mau đưa Columbina đi, nếu không Ineffa sẽ nhận ra mất!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290259,
					"content": "Được... Được thôi! Vậy hôm khác gặp lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290260,
					"content": "(Phải mau dọn dẹp mới được, nếu không Ineffa sẽ phát hiện ra vụn đồ ăn vặt mất!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290261,
					"content": "Được, tạm biệt hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290262,
					"content": "...Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290263,
					"content": "Sao... sao thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290264,
					"content": "Những linh kiện này có cần cất trữ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290265,
					"content": "Hả? Tại sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290266,
					"content": "Hình như chúng là \"quà tặng của Nguyệt Thần\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290267,
					"content": "Ineffa, cô đang nói gì vậy? Lát nữa tôi sẽ kiểm tra lại đường điện giúp cô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290250,
					"content": "Là vị khách hàng sợ người lạ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "Hệ thống so sánh này... có sai sót rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "Phạm vi sai lệch khá nhỏ. Kết luận này là đáng tin cậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290216,
					"content": "Người bạn đó hơi ngại người lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
			]
		},
