			"dialogs": [
				{
					"id": 760290101,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290102,
					"content": "Columbina, cô phải ra ngoài sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Ừm, tôi ra ngoài sửa đàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290104,
					"content": "...Gì cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "Có một cây đàn của Kuuhenki bị hỏng. Nó rất quý trọng cây đàn này, nên tôi muốn giúp nó sửa lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290106,
					"content": "Các Kuuhenki đúng là rất đa tài nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Ừm, nó thường chơi đàn ở đây, thỉnh thoảng tôi cũng hát theo tiếng đàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290108,
					"content": "Trước đó tôi đã cảm thấy rồi, cô thực sự rất yêu chiều Kuuhenki đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Chúng luôn bầu bạn với tôi, còn thường xuyên đem những thứ thú vị về cho tôi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290110,
					"content": "(Lauma từng nói, đây là do bản tính muốn khiến Nguyệt Thần vui vẻ của Kuuhenki.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Nhưng cho tôi hỏi một câu, cô định sửa cây đàn thế nào? Cô nói không muốn để người khác nhìn thấy mình mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Hmm... Lúc trước tôi sẽ nhờ động vật nhỏ hoặc Kuuhenki, để chúng đặt đồ cần sửa trước cửa nhà thợ thủ công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290113,
					"content": "Sau khi người thợ phát hiện thì thường sẽ tiện tay sửa lại. Nhưng đôi khi cũng không phát hiện ra, tôi phải đợi vài ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290114,
					"content": "Nghe cũng lằng nhằng phết nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "Hay là giao cho chúng tôi đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760290117,
					"content": "Yên tâm, nếu là chúng tôi đi thì nói không chừng trong hôm nay là sẽ sửa xong thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
