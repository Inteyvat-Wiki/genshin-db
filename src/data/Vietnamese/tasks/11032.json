			"trigger": {
				"objectNames": [
					"Huixin",
					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "Cảm ơn tiền bối Ganyu đã đến, cũng cảm ơn hai bạn luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320202,
					"content": "Chuyện nhỏ thôi mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320203,
					"content": "Phiền Huixin rồi, đừng khách sáo như vậy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320204,
					"content": "Thực ra... Tiền bối Ganyu, lần này ngoài việc cảm ơn ra, tôi còn có việc muốn nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320205,
					"content": "Còn có việc cần giúp sao? Vậy cứ nói thử xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320206,
					"content": "Không không... cũng không hẳn là giúp... Có thể từ từ nghe tôi nói không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320207,
					"content": "Rất sẵn lòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320208,
					"content": "Từ khi còn nhỏ, tôi đã từng nghe cha kể rất nhiều chuyện về tiền bối Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320209,
					"content": "Tuy tôi rất kính phục cha tôi, nhưng tôi vẫn luôn bị hấp dẫn bởi sự đáng tin cậy của tiền bối Ganyu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320210,
					"content": "Tôi lấy tiền bối làm gương, nên đã quyết định đến Nguyệt Hải Đình làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320211,
					"content": "Thì ra trong mắt bạn, tôi là như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320212,
					"content": "Nhưng thực ra, làm công việc trợ lý ở Nguyệt Hải Đình thực sự rất vất vả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320213,
					"content": "Tôi thì không có năng lực làm việc giống tiền bối, vì vậy tôi luôn nghi ngờ khả năng của bản thân mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320214,
					"content": "Không sao, Huixin đã làm rất tốt mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320215,
					"content": "Cảm ơn tiền bối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320216,
					"content": "Trong những năm qua, tôi cũng có một đứa con gái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320217,
					"content": "Ồ! Thì ra chú Tian đã lên chức ông rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320218,
					"content": "Dưới sự chỉ bảo của tôi, giờ đây con gái tôi cũng đã kế thừa lý tưởng, trở thành trợ lý của Nguyệt Hải Đình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320219,
					"content": "Ban đầu tôi có chút lo lắng, dù gì thì công việc này cũng không dễ dàng, lúc đó tôi lại không nhìn thấy được tư chất của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320220,
					"content": "Sau khi trải qua chuyện này... Tôi hiện giờ rất ủng hộ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320221,
					"content": "Tại sao lại cảm thấy như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320222,
					"content": "Vì sau này, nó cũng sẽ gặp được một vị tiền bối tên là Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320223,
					"content": "Tiền bối Ganyu sẽ giúp đỡ cho nó, và sẽ nói với nó, năm xưa mẹ của nó là như thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320224,
					"content": "Nghĩ đến tình cảnh lúc ấy, thật là tuyệt biết bao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320225,
					"content": "Cho nên... chuyện của hai mươi năm sau cũng trông cậy vào tiền bối nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320226,
					"content": "Huixin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320227,
					"content": "Tôi, tôi thực sự không nghĩ đến, sự tồn tại của tôi có ý nghĩa với bạn đến vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320228,
					"content": "Cũng giống như cách mà tiền bối cho tôi xem cách làm của cha vậy, có tiền bối đang \"chứng kiến\", thì sẽ khiến người khác được an tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320229,
					"content": "\"Chứng kiến\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320230,
					"content": "Đúng vậy, chứng kiến mấy ngàn năm lịch sử của Liyue. Cho dù là phát triển hay đổi thay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320231,
					"content": "Nhưng tôi từng nghĩ, chuyện này không mang lại ý nghĩa gì ngoài sự cô độc cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320232,
					"content": "Huixin, những lời nói ban nãy, rất quan trọng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320233,
					"content": "Khiến cho tôi cảm giác được, ngoài \"khế ước\" của tôi và Nham Vương Đế Quân ra, còn có mối quan hệ giữa tôi và biển người trong cảng Liyue này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320234,
					"content": "Trải nghiệm được cảm giác được nhờ vả, được thừa nhận, được khát vọng chứng kiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320235,
					"content": "Đương nhiên rồi, bạn chính là tiền bối Ganyu độc nhất vô nhị của chúng tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320236,
					"content": "Ha ha... Đúng vậy, cho nên phải phụng sự mọi người cho tốt mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320237,
					"content": "Vậy mới đúng chứ! Tiểu thư Ganyu cuối cùng cũng phấn chấn lên rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320238,
					"content": "Cho dù tôi có bị đào thải, tôi cũng hy vọng có thể tranh thủ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320239,
					"content": "Vì không muốn phụ lòng mong mỏi của các bạn, tôi vẫn muốn tiếp tục thực hiện \"khế ước\", trở thành trợ lý của \"Thất Tinh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320240,
					"content": "Haiz... Tôi đã bảo rồi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "Nói chung, giờ tôi sẽ về xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320243,
					"content": "Không có tôi ở đó, việc xử lý công việc chắc đã loạn lên hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320244,
					"content": "Công việc, công việc, không còn thời gian để mà lãng phí nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320245,
					"content": "Tiền bối Ganyu cố lên!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320246,
					"content": "Ấy, vậy là đi rồi sao, tôi còn chưa ăn no nữa mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320241,
					"content": "Việc Ganyu bị loại bỏ là hiểu lầm thôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
