			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baixiao",
					"Baishi",
					"Baiwen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "A...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320302,
					"content": "Này, có ổn không... không lẽ vừa đứng vừa ngủ à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320303,
					"content": "Nhìn xem... ai đến kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320304,
					"content": "Vẫn còn thời gian để lười biếng sao, xem ra các vị rất có năng lực để thay thế tôi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320305,
					"content": "Không có không có! Chúng tôi... làm việc quá sức, nếu không nghỉ ngơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320306,
					"content": "E rằng sẽ không còn được gặp lại tiểu thư Ganyu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320307,
					"content": "Tiểu thư Ganyu, chúng tôi nhớ tiểu thư quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320308,
					"content": "Này, tôi chỉ mới gặp hai vị một lần thôi, sao thân mật thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320309,
					"content": "Bởi vì chúng tôi ngày đêm trông ngóng tiểu thư trở về để tiếp quản lại công việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320310,
					"content": "Tiểu thư bây giờ đối với chúng tôi mà nói, giống như tiên nhân hạ phàm độ thế vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320311,
					"content": "Thái độ không phục ngày trước đã không còn quan trọng nữa, giờ tôi chỉ muốn được giải thoát khỏi đống việc này thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320312,
					"content": "Được rồi được rồi, tôi hiểu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320313,
					"content": "Hãy đi phân loại các công việc theo mục chính vụ, thương vụ, dân sự ra đi, ghi chú phần nào chưa bắt đầu, phần nào đang tiến hành...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320314,
					"content": "Còn lại cứ giao cho tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320315
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320315,
					"content": "Được! Chúng tôi đi làm ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320316
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320316,
					"content": "Cuối cùng cũng... được cứu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320317
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320317,
					"content": "A, đúng rồi, còn một chuyện nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320318
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320318,
					"content": "Nhà Lữ Hành, tôi trịnh trọng cảm ơn bạn, nếu không nhờ có khoảng thời gian ở bên bạn... có lẽ tôi vẫn còn đang dằn vặt trong nội tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320319,
						110320320
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320319,
					"content": "Tôi cũng cảm thấy rất vui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320321
					]
				},
				{
					"id": 110320321,
					"content": "Ha ha, ngoài công việc ra, có thể có được một người bạn như vậy, đúng là vui hơn dự định nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320322
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320322,
					"content": "Đợi tôi làm xong việc, hãy cho tôi... đi mạo hiểm cùng nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320323
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320323,
					"content": "Nhưng, nhưng mà... việc của Ganyu sẽ có lúc xong sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320324,
					"content": "Hừm....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320325
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320325,
					"content": "Ừm... chuyện của tương lai, thì để tương lai trả lời vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320320,
					"content": "Ganyu phấn chấn trở lại là mừng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320321
					]
				}
			]
		}
	]
