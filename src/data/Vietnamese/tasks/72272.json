			"dialogs": [
				{
					"id": 722720102,
					"content": "Tôi có kho báu cần bán.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "Hở? Thật ra cửa tiệm chúng tôi đã có nguồn nhập hàng cố định, bình thường cũng không thu mua lẻ tẻ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720104,
					"content": "Nhưng mà nhìn vẻ mặt của bạn... hình như là một thứ gì đó rất đặc biệt đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720105,
					"content": "Nếu là vậy... hay là đưa cho tôi xem thử trước nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720106,
					"content": "Kể chuyện Ngọc Long Cốt cho Mikoshi Genichirou nghe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720108,
					"content": "Thành thật mà nói... tuy câu chuyện này rất kỳ ảo... nhưng mà hơi bị ảo quá đáng rồi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720109,
					"content": "Cái thứ này đã vượt quá khả năng lý giải của tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720110,
					"content": "Nhưng dù gì thì tôi cũng chỉ là một kẻ hay làm đồ thủ công mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720120,
					"content": "Vậy đi, 80.000 Mora, tối đa thêm 5 phần Sashimi, món này không rẻ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720111,
					"content": "Nếu như bạn chấp nhận giá này thì tôi sẽ mua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720112,
					"content": "Anh sẽ làm gì với nó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "Tôi cũng chưa rõ, có lẽ tôi sẽ mang nó về nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720114,
					"content": "Nếu thuận lợi thì không chừng tôi có thể gia công nó thành thứ đặc biệt gì đó để bán kiếm lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720115,
					"content": "Giá cả công bằng, chốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "Vậy bạn nhận lấy số Mora này nhé, tôi sẽ mang nó về nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720117,
					"content": "Để tôi suy nghĩ thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "Ừm... vừa hay tôi cũng cần suy nghĩ lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720119,
					"content": "Nếu bạn suy nghĩ xong rồi thì đến tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
