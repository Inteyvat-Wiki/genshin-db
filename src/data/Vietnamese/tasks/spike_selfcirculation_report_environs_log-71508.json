			"dialogs": [
				{
					"id": 715080101,
					"content": "Không hổ danh là bạn mà... Xử lý được bùn đen và quái vật xung quanh trong tình trạng \"Gai Pursina\" không bị hư tổn gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715080102,
					"content": "Tôi cảm thấy may mắn vì người mà Khedive tìm để hỗ trợ là bạn, nếu như là người khác thì chưa chắc đã giải quyết được những vấn đề này đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715080103,
					"content": "Tôi lợi hại lắm đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715080104
					]
				},
				{
					"id": 715080104,
					"content": "Ừ, đúng là rất lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715080105,
					"content": "Hai vị công nhân hầm mỏ, chính là Tu và Hao đã về nghỉ ngơi rồi, có điều... Xem ra khó mà chuyển \"Gai\" vào trực tiếp được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715080106,
					"content": "Cứ dọn như thế cũng không phải cách hay, vì gần tới lỗ thông hơi thì tốc độ bùn đen tuôn ra lại càng cao, phải trực tiếp xử lý ngọn nguồn bùn đen mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715080107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715080107,
					"content": "...Xem ra phải nghĩ cách khác thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
