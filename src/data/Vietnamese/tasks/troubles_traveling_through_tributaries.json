			"dialogs": [
				{
					"id": 210261001,
					"content": "Thế nào, bạn đã thả bình trôi chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261002,
					"content": "Meng sẽ nhặt được thật sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Ừm...chắc là rất khó, thường thì sẽ không nhặt được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261004,
					"content": "Vậy thì chẳng phải chẳng còn ý nghĩa gì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210261005,
					"content": "Ây da, đừng nôn nóng. Tôi nói rồi, một người trưởng thành đáng tin cậy sẽ giúp cậu bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261006,
					"content": "Các bạn có biết Sumeru không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261007,
					"content": "Tôi tình cờ có một vài anh em làm kinh doanh. Họ đang có kế hoạch kinh doanh nấm, và họ đang định đến đó để khảo sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261008,
					"content": "Hahaha, các bạn cũng biết đó. Nói là đến Sumeru khảo sát, nhưng thật ra cũng chỉ là đi chơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261009,
					"content": "Nếu bạn nhỏ tên Meng kia có ý định đi du lịch, thì để tôi giúp cậu bé liên hệ, xem anh em của tôi có thể dẫn thêm một người không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261010,
					"content": "Các bạn đừng lo, chuyện này cứ để tôi sắp xếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261011,
					"content": "Lá thư này tôi chép lại một bản, còn có việc khác cần dùng. Còn về chiếc bình trôi...thì cứ mặc kệ nó đi. Chắc cũng sẽ không có ai nhặt được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261012,
					"content": "Cảm ơn anh đã giúp đỡ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "Người lớn giúp trẻ con thực hiện ước mơ chẳng phải là chuyện bình thường sao? Chuyện này cứ giao cho tôi, yên tâm đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261015,
					"content": "Đúng rồi, tôi phải kêu các anh em ăn mặc chỉnh tề một chút, để nó đỡ thấy sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261013,
					"content": "Tại sao anh lại đồng ý giúp Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
