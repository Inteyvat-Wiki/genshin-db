				"points": []
			},
			"dialogs": [
				{
					"id": 727340101,
					"content": "Không nghiêm túc, không tao nhã, không đặc sắc, không kỳ diệu, cái gì cũng không xứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "Phù Thủy Giàu Có"
				},
				{
					"id": 727340102,
					"content": "Ngươi lẩm bẩm cái gì vậy, đánh giá những đồng đội đã bị đánh bại của ngươi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "Phù Thủy Giàu Có"
				},
				{
					"id": 727340104,
					"content": "Nói đến phong cách đấu bọ của các ngươi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "Phù Thủy Giàu Có"
				},
				{
					"id": 727340105,
					"content": "Hả? Đầu của ngươi bị Bóng Ma đập phải sao? Nơi này không phải là để diễn xiếc! Ngươi có muốn lĩnh giáo một chút về nhiệt huyết và sức mạnh của bổn đại gia không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340106,
					"content": "Ngươi làm ta nhớ lại những ký ức không đẹp đấy... Ta không thể đấu với một người ồn ào như ngươi được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "Phù Thủy Giàu Có"
				},
				{
					"id": 727340107,
					"content": "#Ừm, {M#anh bạn}{F#cô gái} tóc vàng này có vẻ như dễ đối phó... Quyết định rồi! Ta muốn khiêu chiến với người này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "Phù Thủy Giàu Có"
				},
				{
					"id": 727340108,
					"content": "Phụt... Hahahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340109,
					"content": "Bạn thân của ta, nghe thấy chưa? Hắn nói ngươi dễ đối phó đấy! Ngươi mau tiếp đãi hắn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340110,
					"content": "Vậy thì tôi không khách sáo nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "Thực sự không thể hiểu nổi, đối thủ không tìm hiểu về chúng ta trước sao, cứ phái từng người đến đây ăn đòn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340113,
					"content": "Đội của Tướng Quân Hanakado là một mớ hỗn độn! Nhưng về mặt chiến lược thì còn thua xa ba người chúng ta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340111,
					"content": "Huhu, đừng bắt nạt tôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
