			"dialogs": [
				{
					"id": 200060101,
					"content": "Đơn Giao Hàng Món Ăn",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060102,
					"content": "Chào mừng tới quán Người Săn Hươu... Nhà Lữ Hành? Bạn đến thật đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "Xin lỗi, tuy biết là bạn đói, nhưng có thể giúp tôi một việc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "Tiểu thư Orlean ở Thanh Tuyền Trấn đặt 1 phần <color=#00E1FFFF>Thịt Nướng Mật Ong</color>, nhưng gần đây tôi nghe nói Thanh Tuyền Trấn thường xuyên bị Slime quấy rối...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "Tự tôi không dám đi qua... có thể nhờ bạn giúp tôi đem thức ăn giao cho <color=#00E1FFFF>Orlean ở Thanh Tuyền Trấn</color> không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "Được thôi, nhưng mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "Đợi khi bạn quay lại, sẽ có một bữa thịnh soạn để đền đáp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "Nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "Đói quá rồi, tôi chỉ đến để ăn cơm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "Sau khi bạn giúp xong, tôi...tôi sẽ mời bạn đặc sản của quán Người Săn Hươu, nhờ bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
