					"nextDialogs": [
						200060202
					],
					"speakerTitle": "Orlean Hoạt Bát"
				},
				{
					"id": 200060202,
					"content": "Nếu không phải kiệt sức vì đói, thì cái đám này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "Orlean Hoạt Bát"
				},
				{
					"id": 200060203,
					"content": "Đây là món bạn đặt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "Ồ, đây là mùi thơm của cà rốt và thịt... nếu có thể ăn nó, thì đám Slime đã bị tôi đánh bay rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "Orlean Hoạt Bát"
				},
				{
					"id": 200060205,
					"content": "Thôi kệ vậy, đây là tiền cơm, hãy mang về cho tiểu thư Sara đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
