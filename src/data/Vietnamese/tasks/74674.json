			"dialogs": [
				{
					"id": 746740101,
					"content": "Tiền Sắt Cổ... Tiền Sắt Cổ... Tuyệt lắm, thực sự rất tuyệt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740102,
					"content": "#Nhiều Tiền Sắt Cổ như thế, chắc là đủ để tôi kiếm một khoản nhỏ rồi. Cảm ơn nhé, {NICKNAME}, và cả Paimon nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740103
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740103,
					"content": "Tiếp theo anh định làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746740104
					]
				},
				{
					"id": 746740104,
					"content": "Đương nhiên là... Phải nghĩ cách xem làm sao để đổi số Tiền Sắt Cổ này thành một ít Mora, hoặc một số đồ vật tiện dụng khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740105
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740105,
					"content": "Nói thật thì tôi không muốn dây dưa với người trung gian trước đây nữa, lần nào anh ta cũng rút phần trăm với con số kinh người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740106
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740106,
					"content": "Hơn nữa, tiền đến tay tôi rất chậm, tôi không biết anh ta đang làm gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740107,
					"content": "Có điều... Bây giờ ngoài anh ta ra thì tôi không tìm thấy ai khác đáng tin cậy để hợp tác, haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740108,
					"content": "Thôi kệ đi! Đây, những thứ này cho hai vị, coi như là tiền thuê tôi trả thêm cho sự hợp tác lâu dài của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740109,
					"content": "Sau khi kết thúc thương vụ làm ăn ở Fontaine, tôi cũng phải nghĩ xem tiếp theo nên đi đâu. Không thể cứ lang thang mãi được, như vậy mệt mỏi lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				}
			]
		}
	]
