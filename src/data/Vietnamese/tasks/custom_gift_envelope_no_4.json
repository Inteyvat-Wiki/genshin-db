				{
					"id": 715360301,
					"content": "#Ra là thế... Tấm thiệp chúc mừng này đẹp quá, cảm ơn {NICKNAME} nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
