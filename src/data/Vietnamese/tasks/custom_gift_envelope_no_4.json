			"dialogs": [
				{
					"id": 715360101,
					"content": "#{NICKNAME}? Tết Hải Đăng vui vẻ, chuyện {F#cô}{M#cậu} giúp Dehya làm thiệp chúc mừng tôi đã nghe nói rồi. Đẹp lắm đó, cảm ơn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "Mọi việc ở làng đã sắp xếp ổn thỏa chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "May nhờ có Dehya và mọi người giúp đỡ, trong làng giờ đã có người canh giữ, tôi cũng có thể yên tâm hơn phần nào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Thời gian này hãy nghỉ ngơi cho tốt nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "Ừm, nhất định rồi. Dehya còn nói vài ngày nữa muốn tới Làng Kiều Anh xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "Cô ấy nói phong cảnh ở đó rất đẹp, còn có trà ngon, nên vừa hay có thể mua một ít mang về cho người dân trong làng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "Ban đầu tôi định làm theo truyền thống của Liyue là làm một vài tấm thiệp chúc mừng rồi gửi kèm quà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "Nhưng lịch trình của Dehya quá dày đặc, hai chúng tôi cứ chạy khắp nơi, không có thời gian để viết thiệp chúc mừng nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "#Nghe Dehya nói {F#cô}{M#cậu} rất giỏi làm thiệp, có thể dạy tôi cách làm không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "Được chứ, cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
