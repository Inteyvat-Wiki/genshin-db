					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "Í? Sao bạn lại đến đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730202,
					"content": "Tuy rằng lúc nãy tôi còn đang nghĩ, bạn có khi nào cũng đi theo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730203,
					"content": "Tôi muốn biết thêm chuyện về Phong Thần.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "Phong Thần Barbatos? Trong thành Mondstadt đã không còn cái tên đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730205,
					"content": "Nham Thần của Liyue, Lôi Thần của Inazuma đều còn, nhưng người dân Mondstadt đã rất lâu không gặp được Thần của họ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730206,
					"content": "Tại sao lại hỏi chuyện của Phong Thần? Là vì Dvalin sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730207,
					"content": "A, chuyện này... là vì \"Thần\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730208,
					"content": "Ừm, có người nói với tôi về quá khứ của rồng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "Ồ? Hiện nay mọi người nghĩ gì về \"Phong Ma Long\"? Tôi rất tò mò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730210,
					"content": "Chỉ là, không cần phải kể ngay lúc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730211,
					"content": "Đã lâu không quay lại đây, hình như có một vài thứ rất khó chịu khi tôi đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "Hừ... Sự thay đổi hướng gió, không chỉ ảnh hưởng đến rồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730402,
					"content": "Phải rồi, lúc nãy bạn nói, có người nói với bạn về quá khứ của rồng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730405,
					"content": "... Thật sao? Vị học giả tên là Lisa của Mondstadt, nghĩ việc này là như vậy à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730406,
					"content": "Đúng vậy, xung đột đến mức này, đương nhiên là do hai bên đã dùng đến vũ lực...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730407,
					"content": "Nhưng sự thù hận của nó, tuyệt đối không phải do mọi người không tế bái \"Tứ Phong Thủ Hộ\" nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730408,
					"content": "... Đó không phải sự thù hận tự nhiên sinh ra, mà là sản phẩm của sự ăn mòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730409,
					"content": "Ăn... ăn mòn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730410,
					"content": "Là máu đen chảy vào tim đã hành hạ nó, khiến nó không thể ngủ ngon nhiều năm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730412,
					"content": "Pháp Sư Vực Sâu? Chưa từng nghe qua cái tên này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "Tôi ở Mondstadt hình như từng nghe nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "Cho nên lần này tỉnh lại, tinh thần nó bị \"Pháp Sư Vực Sâu\" nguyền rủa ăn mòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730413,
					"content": "Giáo đoàn Vực Sâu được thành lập từ những thứ không phải là người, là tổ chức đối đầu với người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730415,
					"content": "Đúng vậy, Giáo đoàn Vực Sâu được thành lập từ những thứ không phải là người, là tổ chức đối đầu với người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730416,
					"content": "Tôi không biết lai lịch của bọn họ, chỉ biết họ có sự thù hận cực đoan với thế giới loài người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730417,
					"content": "Những Hilichurl ở nơi hoang dã, cũng nghe sự chỉ huy của họ, trở thành vũ khí của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730418,
					"content": "Trước khi đến đây, tôi cũng giống Dvalin, bị lời nguyền ăn mòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730419,
					"content": "Nhưng vị trí của chúng ta hiện nay, chính là \"Biểu tượng của anh hùng\", cội nguồn của Mondstadt ngày nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730420,
					"content": "Gió thổi qua rừng cây thật là tuyệt, mang theo hương vị mà tôi thích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730421,
					"content": "Đứng dưới bóng cây cùng với bạn, giống như lúc thanh tẩy nước mắt của rồng, giải trừ được độc tố trong cơ thể tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730423,
					"content": "A... cảm thấy tốt hơn nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730424,
					"content": "Cho nên, lúc đầu tại sao anh lại bị trúng độc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730425,
					"content": "Chuyện này, là do trước đây tôi thử nói chuyện với Dvalin, nhưng lại bị... Ừm... làm gián đoạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730427,
					"content": "Hở, cái đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "Cho nên là do tôi...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "Kết quả không những không giải được bùa chú cho Dvalin, bản thân ngược lại còn bị độc tính của \"Vực Sâu\" xâm nhập!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730429,
					"content": "Không sai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730431,
					"content": "#Cho nên để chuộc lỗi, {NICKNAME}, bạn hãy đi cùng tôi đến Đại Giáo Đường Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730432,
					"content": "Đại giáo đường Mondstadt? Đi đến nơi đó làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730433,
					"content": "Đi lấy... cây đàn Thiên Không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}