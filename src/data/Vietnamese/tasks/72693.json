			"dialogs": [
				{
					"id": 726930201,
					"content": "Chuyện chụp hình thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930202,
					"content": "Ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "Cảm ơn, cảm ơn, có số nguyên liệu này, chắc sẽ có thể viết ra được những câu thơ vừa ý. Ừm, để ta suy nghĩ một lát...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930204,
					"content": "Dựa theo những tấm ảnh của cháu, ta đã thử viết ra được một ít. Cụ thể phải dùng câu nào, mời cháu lựa chọn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
