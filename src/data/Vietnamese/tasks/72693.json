					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "Bài thơ này của Ootomo đã đột phá quy cách thơ ca của Inazuma, nhưng lại dùng thủ pháp cổ điển của Inazuma, liệt kê ra những hồi ức khó quên trong đời người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930602,
					"content": "Là muốn nói với tôi, Mondstadt và Inazuma, tuy trông có vẻ cách xa vời vợi, nhưng lại có cảm quan thẩm mỹ giống nhau. Cũng giống như chúng tôi, vứt bỏ đi thân phận người Mondstadt và người Inazuma, chỉ đơn thuần là giao lưu giữa những nhà thơ với nhau mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930603,
					"content": "Lenne tiên sinh trẻ tuổi như vậy, nhưng lại có thể nhanh chóng lĩnh hội được tình nghĩa trong câu thơ như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930604,
					"content": "Trước đây ta cứ nghĩ rằng tình bạn vong niên chỉ là những cách nói hồ đồ, đến hôm nay mới biết quả nhiên là có chuyện này, cũng xem như là một chuyện đáng mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930605,
					"content": "Và cả người bạn trẻ tuổi tao nhã này nữa, ba người chúng ta có thể gặp gỡ ở đây, cũng xem như hữu duyên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930606,
					"content": "Đúng vậy, những sóng gió trên đường đến Inazuma đã không còn quan trọng nữa, hơn nữa cho dù trở về Mondstadt, tôi cũng sẽ nhớ rõ như in từng cái cây ngọn cỏ ở Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930607,
					"content": "Cũng phải cám ơn những bức ảnh mà người bạn đây đem đến, xin cám ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930608,
					"content": "Hy vọng trong tương lai sẽ có một ngày ba chúng ta có cơ hội gặp lại nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930609,
					"content": "Nhất định rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
