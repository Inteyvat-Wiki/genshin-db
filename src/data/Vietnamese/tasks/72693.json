			"dialogs": [
				{
					"id": 726930501,
					"content": "Những hoa quả này chắc là để chỉ những sự việc đau lòng nhỉ, không giống như những kỷ niệm vui vẻ như lần đầu uống rượu hay lần đầu đọc thơ, nhưng lại giống như cuộc chia ly sắp đến, để lại ấn tượng sâu sắc trong lòng.",
					"roleType": "TALK_ROLE_NPC",
