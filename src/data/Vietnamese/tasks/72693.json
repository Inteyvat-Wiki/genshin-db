			"dialogs": [
				{
					"id": 726930101,
					"content": "Ah! Cháu đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930102,
					"content": "Bài thơ hôm qua Lenne tiên sinh đã viết về niềm hối tiếc vì sự gặp gỡ muộn màng, vậy thì ta cũng định viết một bài thơ để tặng cậu ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930103,
					"content": "Được Ootomo tiên sinh tặng thơ quả là niềm vinh hạnh lớn của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930104,
					"content": "Tuy ta cũng đã có tuổi rồi, nhưng gần đây sau khi quen biết được một số người bạn Mondstadt, ta cũng bắt đầu thấy hứng thú với Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930105,
					"content": "Bài thơ này ta đã phỏng theo cách viết của nhà thơ tự do Mondstadt, trong câu thơ cũng có nhắc đến một số cảnh vật ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930106,
					"content": "Tiếc là ta chưa từng đi qua Mondstadt, không biết có thể phiền cháu giúp ta chụp một số ảnh <color=#00E1FFFF>đặc sản Mondstadt</color> giúp ta không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930107,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "Haha, vậy phiền cháu rồi. Cũng như mấy hôm trước, chụp 4 tấm là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
