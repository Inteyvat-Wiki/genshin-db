				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "Thật là xui xẻo, không xuống nước được nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "Là bạn đấy à. Gặp được bạn thật là tốt. Phù... tôi suýt chút nữa thì mất mạng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200105,
					"content": "Lúc nãy tôi xuống nước làm việc như mọi lần. Sau khi lặn xuống, tránh rong, né rác, cũng không bị thứ gì cắt phải hay đâm trúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200106,
					"content": "Nhưng lúc tôi vớt đồ, đột nhiên có một đám quái vật lao ra từ bùn lầy dưới đáy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200107,
					"content": "Tôi không nhớ cụ thể là quái vật gì, chỉ nhớ chúng rất hung dữ. Tôi đành phải chạy trốn thật nhanh rồi bơi vội lên trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200108,
					"content": "Nhưng bơi chưa bao xa thì lại gặp phải một lũ máy móc hình dạng kỳ lạ, sau khi thấy tôi là chúng điên cuồng lao tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200109,
					"content": "Tôi không biết mình đã lên bờ kiểu gì nữa, cũng may là không bị thương, đồ lặn cũng không bị tổn hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200110,
					"content": "Nguy hiểm quá, vậy thì đừng vớt ở đây nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "Vậy không được đâu. Chỗ này là Goldman chỉ định... Trước đây cũng có nhiều người đã bị thương, thậm chí là mất mạng khi trục vớt ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200113,
					"content": "Dần dần, dù Goldman có dọa trừ lương thì cũng không có ai chịu tới chỗ này vớt đồ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200114,
					"content": "Sau một thời gian, Goldman đã đổi cách khác, hắn nói chỉ cần đồng ý tới đây vớt đồ là có thể nhận lương gấp ba lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200115,
					"content": "Thế là... tôi cùng vài người thợ lặn kẹt tiền đã nhận việc tệ hại này, đổi ca thay nhau trục vớt ở đây, còn mua vài cái lao móc làm vũ khí phòng thân nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200116,
					"content": "Nhưng chưa vớt được mấy hôm, đống vũ khí không gãy thì cũng mất... Những người khác đành phải vào thành mua thêm một ít, còn tôi thì canh chừng ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200117,
					"content": "Vậy mà anh vẫn dám xuống nước sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "Mấy người kia đi mãi chưa về, nếu việc cứ dang dở như vậy, hôm nay không biết tôi sẽ phải thức đến mấy giờ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200120,
					"content": "Để tôi giúp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "Không được! Chuyện này không được, dưới nước có quái vật đó. Nhà mạo hiểm thông thường không đối phó được với chúng, tôi không thể để bạn mạo hiểm được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200122,
					"content": "Tôi không phải là nhà mạo hiểm tầm thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "Bạn... quả thực trông không tầm thường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200125,
					"content": "Được rồi, bạn đã nói như vậy, thì tôi sẽ đánh dấu vị trí những món đồ đó. Bạn phải chú ý an toàn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200123,
					"content": "Anh thấy tôi giống nhà mạo hiểm bình thường không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "Không có vũ khí phòng thân vẫn xuống sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "Quá nguy hiểm, hay là đổi chỗ khác đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "Anh gặp chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
