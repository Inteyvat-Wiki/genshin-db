					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200401,
					"content": "Đây là... Ây da! Sao trong này toàn là trang sức thế? Lẽ nào Goldman thực sự muốn chúng ta vớt nó sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200402
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200402,
					"content": "Cảm ơn bạn giúp đỡ, số tiền này... Mong bạn hãy nhận, và tuyệt đối đừng nói ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200403
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200403,
					"content": "Nếu thực sự bán được chúng, tôi sẽ tự mua cho mình bộ đồ lặn, không cần phải trả tiền thuê cho Goldman nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200404,
						240200405
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200404,
					"content": "Tôi không thể nhận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				},
				{
					"id": 240200406,
					"content": "Không, không được! Đây là thù lao bạn đáng được nhận, số tiền ít ỏi này tuy không xứng với sự vất vả, nhưng cũng là chút tiền cuối cùng, vốn dĩ tôi để dành tối nay đi uống rượu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200407,
					"content": "Mong bạn nhận cho! Tôi dọn dẹp đã, chút nữa sẽ nghĩ cách để lén bán chỗ trang sức này đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200405,
					"content": "Tôi sẽ không nói.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				}
			]
		},
		{
