			"dialogs": [
				{
					"id": 240200501,
					"content": "Tên keo kiệt đó, hừ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200502,
						240200508,
						240200512
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200502,
					"content": "Có thể nói thêm về Goldman không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200503
					]
				},
				{
					"id": 240200503,
					"content": "Goldman là chủ của tôi, người đã thuê một đám bất tài vô dụng, lao động tay chân để mưu sinh giống như tôi về làm việc cho hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200504
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200504,
					"content": "Cái tên trong đầu chỉ có Fonta này vừa hà khắc vừa bủn xỉn! Hắn yêu cầu chúng tôi phải tuân theo một đống nguyên tắc công việc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200514
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200514,
					"content": "Hơn nữa, đồ lặn dùng để làm việc cũng là hắn cho chúng tôi \"thuê\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200505
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200505,
					"content": "Chỉ cần phạm phải bất kỳ quy định nào, hoặc làm hư hại đồ lặn, chúng tôi sẽ phải bồi thường một khoản cho hắn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200515
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200515,
					"content": "Nói cách khác, nếu tôi lỡ bất cẩn, không những phải đền một khoản cho tên keo kiệt đó, mà còn phải cầu xin hắn tiếp tục thuê mình! Hừ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200506
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200506,
					"content": "Mà bạn tìm hiểu để làm gì, định đi gặp hắn sao? Xin đấy, dù thế nào cũng phải tránh xa Goldman ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200516
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200516,
					"content": "Hắn là tên vô liêm sỉ, bên cạnh hắn cũng là một đám xấu xa thối tha như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200507
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200507,
					"content": "Tuyệt đối đừng qua lại với hắn, muốn dọn sạch một vũng bùn rồi đổ nước sạch vào đấy thì không phải là chuyện đơn giản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200517
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200517,
					"content": "Nhưng nếu dùng bùn bẩn để làm ô nhiễm một ao nước sạch thì hoàn toàn không tốn chút công sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200508,
					"content": "Công việc của anh thật vất vả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200509
					]
				},
				{
					"id": 240200509,
					"content": "Đúng đấy, nhưng đây là con đường mưu sinh duy nhất. Tôi không thông minh, không giỏi giang, nhưng cũng sẽ không cho phép mình làm chuyện xấu xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200518
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200518,
					"content": "Nếu tôi buộc phải làm chuyện xấu để đổi lấy đồ ăn, thì tôi thà đói bụng còn hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200510
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200510,
					"content": "Cuộc sống hiện tại tuy rất vất vả, nhưng mỗi đêm ít nhất cũng được ngủ ngon, không phải lo có người thù ghét, lựa lúc đang ngủ mà hãm hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200511
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200511,
					"content": "Riêng điểm này tôi đã hơn Goldman rất nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200512,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200513
					]
				},
				{
					"id": 240200513,
					"content": "#Được, việc vớt đồ đành giao cho {M#quý ngài}{F#quý cô} tốt bụng, tôi đi nghỉ ngơi một lát đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
