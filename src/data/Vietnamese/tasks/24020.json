			},
			"dialogs": [
				{
					"id": 240200601,
					"content": "Haiz... thật là đen đủi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200602
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200602,
					"content": "Anh bán được đồ chưa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200603
					]
				},
				{
					"id": 240200603,
					"content": "Là bạn à. Đừng nhắc nữa, tôi vốn lén tìm được người để bán rồi, nhưng Goldman đột nhiên xông vào nhà tôi lấy hộp trang sức đó đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200604
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200604,
					"content": "Nếu không phải hắn vẫn cần tôi làm việc, chắc tôi đã bị đánh một trận tơi bời rồi... nhưng tôi vẫn bị hắn trừ hai tháng tiền lương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200616
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200616,
					"content": "Phải đợi tôi làm xong hết việc của năm nay thì mới đưa tiền cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200605
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200605,
					"content": "Haiz... thôi vậy. May mắn sẽ không bao giờ để mắt đến những kẻ ngốc như tôi... Goldman có tìm bạn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200606,
						240200609
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200606,
					"content": "Không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200607
					]
				},
				{
					"id": 240200607,
					"content": "Vậy thì được, dù tôi bị đánh cũng không sao, chỉ không muốn hắn gây phiền phức cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200608
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200608,
					"content": "Tôi không nói ra chuyện bạn giúp tôi vớt đồ, nhưng tôi cảm thấy, hình như có người biết chuyện này và tiết lộ cho tên bủn xỉn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200611,
					"content": "Có điều, hôm nay tôi lại phải nhờ bạn giúp đỡ rồi. Bộ đồ lặn tôi chưa vá xong, nhưng Goldman đã giục tôi đi làm, còn thêm cả đống việc mấy hôm trước chưa xong nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200612
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200612,
					"content": "Tôi đành phải tìm mượn một bộ đồ lặn để mau chóng đi trục vớt... Nhưng vẫn không thể vớt hết được, đành phải nhờ bạn giúp tôi thêm một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200613,
						240200614
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200613,
					"content": "Không thành vấn đề!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200615,
					"content": "Cảm ơn bạn, tôi sẽ đánh dấu vị trí món đồ, chúng ta chia nhau xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200614,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200609,
					"content": "Nếu hắn tới, tôi sẽ dạy hắn một bài học.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200610
					]
				},
				{
					"id": 240200610,
					"content": "Bạn tuyệt đối đừng dây dưa với tên béo đó. Hắn là một tên bỉ ổi vô liêm sỉ! Người đáng kính như bạn vốn dĩ không nên biết hắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				}
			]
		}
	]
