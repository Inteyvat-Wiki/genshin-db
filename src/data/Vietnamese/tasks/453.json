			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "Đây là lông của sói. Nghe nói người Liyue dùng cái này làm bút lông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530502,
					"content": "Màu lông rất khác với màu lông sói Mondstadt trên sách nói. Không chừng là đến từ bên ngoài?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530503,
					"content": "Trên người sói có nhiều loại lông, màu sắc đậm nhạt cũng khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530504,
					"content": "Nhưng mà, bạn xem cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530505,
					"content": "Đây là một cọng lông khác, nhưng mà, trên đó dính cái gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530506,
					"content": "Là hạt giống.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "Hì hì, đây là hạt giống Quả Móc Câu. Nhìn thấy rồi chứ, cái móc trên hạt giống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530509,
					"content": "Trong vùng Mondstadt, nó chỉ sống ở trên Lang Lãnh và Hẻm Núi Minh Quán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530510,
					"content": "Vậy... Quả nhiên là bầy sói trên Lang Lãnh rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530511,
					"content": "Ừm... Cùng một nơi, cũng có tình huống nhiều bầy sói tranh đoạt lãnh địa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530512,
					"content": "Tuy rằng không biết chi tiết, nhưng đây cũng là manh mối quan trọng, có thể dùng điều tra tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530513,
					"content": "Trước khi xuất phát, tôi đi trấn an thôn dân một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530507,
					"content": "Có gì đặc biệt sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
