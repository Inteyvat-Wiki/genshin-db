			"dialogs": [
				{
					"id": 4530101,
					"content": "Haizz, thật là thê thảm. Đứng cũng đứng không vững.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530102,
					"content": "Cái gì?! Thật là đáng ghét!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530103,
					"content": "Nhưng mà... hắn không bị thương mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530104,
					"content": "Đúng vậy, thật thê thảm. Hắn bị dọa không đứng vững nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530105,
					"content": "Ồ... vậy, cũng thật thê thảm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530106,
					"content": "Lúc nãy có nhìn thấy được tình báo có ích nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530107,
					"content": "Cái này, lần đầu tiên tôi thấy sói, thật là đáng sợ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4530108,
					"content": "...Xem ra không có thông tin nào đáng giá cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530109,
					"content": "Vậy thì đi điều tra hiện trường vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45305",
							"2"
