			"dialogs": [
				{
					"id": 4530601,
					"content": "Các bạn có điều tra được gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4530602,
					"content": "Này, anh đứng lên rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530603,
					"content": "Tôi bình tĩnh lại rồi. Có thể nói, tôi trèo từ địa ngục lên lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4530604,
					"content": "Vậy là đội Kỵ Sĩ điều tra có kết quả chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4530605,
					"content": "Từ vết tích trên lông sói sót lại, có thể thấy sói sống trên Lang Lãnh. Ngoài việc này ra thì không có gì thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530606,
					"content": "Nhưng các anh yên tâm, tôi sẽ lập tức lên Lang Lãnh điều tra rõ chuyện này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530607,
					"content": "Đội Kỵ Sĩ tuyệt đối không cho phép chuyện nguy hiểm như vậy xảy ra lần nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530608,
					"content": "Được rồi. Giúp đỡ chậm một chút, còn đỡ hơn không làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4530609,
					"content": "A, người này thật không lịch sự chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530610,
					"content": "Chúng tôi cần đi làm chuyện cần làm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4530611,
					"content": "Này, đừng làm chuyện ngốc nghếch đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530612,
					"content": "Buồn cười, chúng tôi khác với đội Kỵ Sĩ. Thù này nhất định phải trả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4530613,
					"content": "Chúng ta đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "Hopkins Thần Kỳ"
				},
				{
					"id": 4530614,
					"content": "Thật là thê thảm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530615,
					"content": "Chú đang nói gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530616,
					"content": "Nói tương lai của họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530617,
					"content": "Tôi cũng đồng ý với ý kiến này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "Người trẻ tuổi thường dễ tức giận. Phiền các vị để ý giúp, đừng để họ làm việc ngốc nghếch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530619,
					"content": "Yên tâm đi, đây là trách nhiệm của tôi. Nhưng tên đó đúng là khiến người khác cảm thấy bực bội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530620,
					"content": "Cứ giao cho chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530621,
					"content": "Vậy chúng ta mau đi đến Lang Lãnh thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
