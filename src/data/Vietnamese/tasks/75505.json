					}
				]
			},
			"dialogs": [
				{
					"id": 755050101,
					"content": "Là Xilonen! Không ngờ cô lại ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050102,
					"content": "Ơ, là Paimon và Nhà Lữ Hành! Sao vậy? Gặp tôi trước cửa nhà mình thì lạ lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050103
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050103,
					"content": "Không phải, do vừa mới giải quyết xong vấn đề lớn như vậy, tôi tưởng cô sẽ đi tìm một cái cây xinh đẹp rồi nằm một lèo mấy ngày liền chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050104,
					"content": "Haha, quả thật tôi có nghĩ đến, nhưng hiện tại mọi người vẫn đang bận rộn xây dựng lại mọi thứ. Lười biếng vào lúc này thì không ổn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050105,
					"content": "Vậy nên... Cô đang bận làm việc gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050106
					]
				},
				{
					"id": 755050106,
					"content": "Để tôi cho hai vị xem thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050107,
					"content": "Woa! Viên đá quý đẹp quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050108,
						755050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050108,
					"content": "Nhìn có vẻ rất đắt tiền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050109
					]
				},
				{
					"id": 755050109,
					"content": "Đúng, nhưng không chỉ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050112,
					"content": "Đây là Ngọc Mật Phlogiston mang hoa văn kỳ lạ đang nổi trên thị trường dạo gần đây. Ngọc Mật Phlogiston vốn dĩ là món đồ nhỏ được Bọ Phlogiston tạo ra, những thứ đó thì rất bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050113,
					"content": "Nhưng Ngọc Mật Phlogiston mang hoa văn lạ thì quả thật rất mới, số lượng rất ít, nên giá cũng rất cao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050114
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050114,
					"content": "Chuyện này tôi hiểu... Những lúc chúng tôi tìm kiếm kho báu bên ngoài cũng rất thích những thứ mang hoa văn lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050115,
					"content": "Haha, vậy nên tôi cũng đã mua một ít về sưu tầm. Kết quả mới vài ngày sau thì chậu cây tôi trồng đặt ở bên cạnh đã trở nên héo úa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050116,
					"content": "Ban đầu tôi không để ý, vốn dĩ tôi không hiểu lắm về việc trồng cây. Nhưng sau đó tôi nghe Kachina nói có vài người trong tộc đã đổ bệnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050117,
					"content": "Hầu hết người đổ bệnh đều là khách từ tiệm đá quý của Cheven, bản thân cô chủ Cheven cũng không ngoại lệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050118,
					"content": "Hả? Vậy thì... lẽ nào có liên quan đến viên đá quý này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050119,
					"content": "Tôi cũng đoán vậy. Thế nên tôi đã nghiền vụn một viên và phát hiện nó có chứa năng lượng Vực Sâu bên trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050120,
					"content": "Nồng độ năng lượng Vực Sâu này khá thấp, lại bị ngăn cách bởi lớp vỏ mật bên ngoài, hầu như không cảm nhận được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050121,
					"content": "Những người đó hiện giờ sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050122
					]
				},
				{
					"id": 755050122,
					"content": "Yên tâm, do nồng độ thực tế không cao, nên bệnh tình của mọi người thường không nghiêm trọng, cùng lắm là triệu chứng mệt mỏi và thiếu ngủ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050123,
					"content": "Với những người có tố chất khỏe mạnh như tôi và Kachina thì không bị ảnh hưởng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050124
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050124,
					"content": "Phù... Cũng may chỉ là nguy cơ cấp độ Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050125,
					"content": "Cấp độ Slime? Là sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050126
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050126,
					"content": "Là mức độ nguy hiểm như Slime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050127
					]
				},
				{
					"id": 755050127,
					"content": "#Hihi, vẫn là {NICKNAME} hiểu tôi. Cũng giống như cách Slime chỉ có thể uy hiếp đến người bình thường thôi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050128,
					"content": "Haha, hai người thật là ăn ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050129
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050129,
					"content": "Quay lại vấn đề. Chúng tôi cũng từng bắt gặp không ít người bị Slime dọa đến run lẩy bẩy, nên nguy cơ này cũng không thể bỏ mặc được nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050130,
					"content": "Chính xác. Tôi đã nói rõ tình hình với thủ lĩnh, bảo anh ấy gom hết những viên mật mang hoa văn kỳ lạ trên thị trường lại để tiêu hủy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050131
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050131,
					"content": "Cũng cần xử lý sạch sẽ nguồn gốc của nó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050132
					]
				},
				{
					"id": 755050132,
					"content": "#{F#Cô}{M#Cậu} nghĩ giống tôi đấy. Như đã nói, Ngọc Mật Phlogiston là sản vật từ Bọ Phlogiston, nên tôi đoán nguồn gốc của vấn đề nằm ở đám bọ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050133
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050133,
					"content": "Tôi đã đi tìm Kinich để nhờ điều tra, và kết quả là quả thật đám bọ đã bị Vực Sâu ăn mòn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050134
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050134,
					"content": "Ngoài chỗ này ra thì xung quanh Dòng Dõi Vườn Treo và Cư Dân Suối Nước cũng đều có dấu vết của chúng. Ừm, Kinich cũng thông báo cho Mualani rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050135
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050135,
					"content": "Nhưng bộ tộc của họ có vẻ không hứng thú lắm với đá quý, vậy nên ảnh hưởng cũng không lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050136
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050136,
					"content": "Thì ra là vậy... Xem ra những hệ lụy do Vực Sâu đem lại vẫn chưa được giải quyết hoàn toàn, phải kiên nhẫn xử lý mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050137,
					"content": "Vậy cô định xử lý đám bọ thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050138
					]
				},
				{
					"id": 755050138,
					"content": "Trước mắt cứ bắt chúng lại đã. Ô nhiễm Vực Sâu ở mức độ này thì chúng tôi có cách để thanh tẩy, không đến mức ảnh hưởng đến tính mạng của đám bọ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050139
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050139,
					"content": "Kinich đã đánh dấu nơi lũ bọ xuất hiện rồi, giờ tôi định đến địa điểm gần bộ tộc đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050140
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050140,
					"content": "Kể ra thì, hai vị có muốn đi cùng không? Bắt bọ cũng thú vị lắm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050141
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050141,
					"content": "Tôi vốn định gọi Kachina đi cùng, nhưng tiếc là em ấy bận việc khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050142,
						755050146,
						755050148
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050142,
					"content": "Có chúng tôi thì cô được phép lười biếng đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050143
					]
				},
				{
					"id": 755050143,
					"content": "Gì chứ! Tôi không định nằm dài trên cây theo dõi đâu, tôi sẽ xử lý cùng mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050144
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050144,
					"content": "Đùa thôi, chúng ta lên đường nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050145
					]
				},
				{
					"id": 755050145,
					"content": "Tuyệt đấy, như vậy thì tôi sẽ không cảm thấy nhàm chán nữa. Chúng ta đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050146,
					"content": "Rất sẵn lòng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050147
					]
				},
				{
					"id": 755050147,
					"content": "Tuyệt đấy, như vậy thì tôi sẽ không cảm thấy nhàm chán nữa. Chúng ta đi nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050148,
					"content": "Cảm thấy không thú vị lắm, thôi vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050149
					]
				},
				{
					"id": 755050149,
					"content": "Vậy thì tôi sẽ chán chết mất... Thực sự không đi sao? Tôi còn định tặng cả hai món quà nhỏ xinh đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050150
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050150,
					"content": "Ồ! Thì ra là có thù lao! Đó là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050151,
					"content": "Món quà nhỏ lấp lánh, đẹp lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050152
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050152,
					"content": "#Ồ! Là Mora! {NICKNAME}, đừng bỏ lỡ cơ hội kiếm tiền như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050153,
						755050155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050153,
					"content": "Lúc nãy tôi đùa thôi, giờ xuất phát luôn nhé!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
