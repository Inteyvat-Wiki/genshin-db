						755050202
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050202,
					"content": "Nhìn thấy không? Lũ bọ bị Vực Sâu ăn mòn, cơ thể nó lớn hơn nhiều so với bình thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050203,
					"content": "Không ngờ con bọ lại to như vậy... Có nguy hiểm không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050204,
					"content": "Yên tâm, cho dù bị ô nhiễm bởi Vực Sâu thì tập tính của chúng cũng hầu như không thay đổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050205
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050205,
					"content": "Nhưng để thuận lợi cho việc bắt thì tôi đã chế tạo ra lưới bắt bọ cỡ lớn rồi. Đây, cầm lấy, lát nữa có thể dùng để bắt lũ bọ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050206
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050206,
					"content": "À, Kinich còn nhắc đến một tình huống đặc biệt nữa, là phạm vi hoạt động của lũ bọ luôn có một loại quả đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050207
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050207,
					"content": "Thành phần của loại quả này có độc tố khiến đám bọ tê liệt. Chúng ta có thể bôi thứ quả đó lên lưới, như vậy sẽ kiểm soát được sự vùng vẫy của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050208
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050208,
					"content": "Hả? Lũ bọ hoạt động quanh loại quả khiến chúng tê liệt sao? Nghe hơi kỳ quặc nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050209,
					"content": "Tôi cũng thấy vậy. Đây là lần đầu tiên tôi nghe về loài sinh vật hoạt động xung quanh thứ gây khó dễ với chính mình đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050210
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050210,
					"content": "Thật là không bình thường! Không lẽ đám bọ này bị ăn mòn là do âm mưu của ai đó sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050211,
					"content": "Paimon trở nên cảnh giác hơn rồi đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050212
					]
				},
				{
					"id": 755050212,
					"content": "Này, người dẫn đường có ngốc đến mấy thì cũng sẽ trưởng thành nhé! Huống hồ tôi vốn dĩ đã rất thông minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050213,
					"content": "Đáng tiếc, chúng tôi đã tìm hiểu nhiều lần, nhưng không phát hiện ra dấu vết con người nhúng tay vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050214,
					"content": "Vậy nên tạm thời coi đó là một tập tính chưa rõ của đám bọ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050215,
					"content": "Thôi được, dù thế nào thì chúng ta cũng phải bắt chúng lại trước đã, không thể để người khác đổ bệnh thêm được nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
