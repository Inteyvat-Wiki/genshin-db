			"dialogs": [
				{
					"id": 750320601,
					"content": "Saurian phải về tổ rồi, tôi có cần bước xuống khỏi bầu trời không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320602,
						750320604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320602,
					"content": "Cứ tiếp tục bay đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320603
					]
				},
				{
					"id": 750320603,
					"content": "#Tự lẩm bẩm bị {F#cô}{M#cậu} nghe thấy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320606,
					"content": "Tôi nghĩ mình sẽ rời khỏi chỗ này để về nhà một chuyến. Chuyện giải ngũ tôi chưa nói với người trong nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320607,
					"content": "Sau này tôi sẽ có rất nhiều thời gian rảnh rỗi, nên làm gì nhỉ? Mấy chuyện này tôi chưa suy nghĩ nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320608,
					"content": "Sau khi điều chỉnh xong tâm thái của mình thì phải đối diện với giai đoạn tiếp theo của cuộc đời rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320609,
					"content": "Nghe góp ý của người nhà trước sẽ tốt hơn. Cha tôi trước đây cũng là thành viên của đội bay, sau khi giải ngũ thì làm huấn luyện viên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320610,
					"content": "Đường tôi đi ông ấy cũng từng đi, chắc là ông ấy sẽ có nhiều suy nghĩ đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320611,
					"content": "#Vậy nên nhà bay này tôi sẽ tháo đi, nhưng đường đua sẽ để lại. Dù sao thì những dũng sĩ trẻ tuổi giống {F#cô}{M#cậu} luôn cần chỗ để luyện tập mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320612,
					"content": "Manyoya, sau này chúng ta còn gặp lại nhau không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320613,
					"content": "Tôi không biết. Nhưng tôi đoán dù bản thân có đưa ra lựa chọn gì đi nữa thì cuối cùng cũng sẽ không thể từ bỏ bầu trời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320614,
					"content": "Chỉ cần các vị còn bay, thì có lẽ chúng ta vẫn sẽ còn gặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320615,
					"content": "Hẹn gặp lại.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "Hẹn gặp lại, dũng sĩ trẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320604,
					"content": "...Manyoya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320605
					]
				},
				{
					"id": 750320605,
					"content": "#Ồ, {F#cô}{M#cậu} đến rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				}
			]
