				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "Hahaha! Tốt lắm, quả nhiên phải thừa nhận là sóng sau xô sóng trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320402,
					"content": "Dù có là tinh tú thì cũng có ngày rơi xuống, huống chi là người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320403,
					"content": "Bây giờ đã không còn là thời đại của tôi nữa rồi, vui vẻ giải ngũ mới là lựa chọn chính xác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320405,
					"content": "Nhưng vẫn không cam tâm. Tôi rõ ràng chưa già mà, nếp nhăn còn chưa có nữa, tại sao lại phải rời bỏ cuộc chơi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320406,
					"content": "Quá ngắn. Tại sao sự nghiệp của tôi lại ngắn đến vậy chứ? Còn chưa được nếm mùi đứng trên đỉnh cao thì đã bắt đầu rơi xuống rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320407,
					"content": "Nếu biết trước sẽ tiếc nuối đến vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320408,
					"content": "Thôi, cũng không thể nói vậy. Nếu có thể làm lại lần nữa thì tôi vẫn sẽ đưa ra lựa chọn tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320409,
					"content": "Tôi sẽ dốc hết sức vào đội bay, với năng lực của tôi thì điều này không hề khó. Sau đó, vẫn sẽ rút lui ở độ tuổi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320410,
					"content": "Đành chịu, tôi đã cố gắng hết sức rồi, không cam tâm cũng vô ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320411,
					"content": "...Có lẽ cuộc đời chính là vậy. Quá nhiều những chuyện lực bất tòng tâm, muốn trở thành anh hùng thì phải chấp nhận chuyện tỏa sáng chỉ xảy ra trong chớp mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320412,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320413,
					"content": "#Không sao, {F#cô}{M#cậu} ấy bay giỏi lắm. Lúc nãy vẻ mặt còn là đồng cảm mà, tại sao bây giờ lại là bất an rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320414,
					"content": "Haha, sống thì sẽ luôn gặp đủ thứ chuyện thôi. Dù chấp nhận hay không thì chúng vẫn sẽ xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320415,
					"content": "Cứ xem như kinh nghiệm của cựu kỵ sĩ Saurian truyền thụ đi. Vấn đề của tôi thì tôi sẽ tự giải quyết, đừng để bị tôi ảnh hưởng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320416,
					"content": "Làm tốt lắm. Nếu em trai của tôi cũng trầm tĩnh như vậy thì tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320417,
					"content": "Manyoya còn có em trai nữa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320418,
					"content": "Ừm, hai đứa em trai tính tình lập dị đó không dễ nói chuyện như hai vị đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320419,
					"content": "Hai đứa em tôi cũng đang rèn luyện kỹ thuật bay. À không đúng, Acomitl thì cứ chạy trốn, nói không chừng chỉ biết đi tìm chỗ để nấp thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320420,
					"content": "#Kệ hai đứa đó đi. Tôi nhìn ra {F#cô}{M#cậu} rất có năng khiếu đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320421,
					"content": "Nếu rảnh thì cứ thử bay thêm nhé, nói không chừng sẽ được mời vào đội bay đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320422,
					"content": "Tôi sẽ thử thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "#Vậy thì tốt, hy vọng sau này còn được thấy {F#cô}{M#cậu} bay. Cố lên nhé, dũng sĩ trẻ tuổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
