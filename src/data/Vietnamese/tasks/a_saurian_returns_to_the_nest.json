				},
				{
					"id": 750320804,
					"content": "#{F#Cô}{M#Cậu} bay cũng giỏi lắm, nhưng muốn đánh bại tôi thì vẫn còn hơi sớm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320805,
					"content": "Nếu không phục thì thử lại nhé? Còn trẻ thì cứ thử thoải mái đi, thua cũng không có gì to tát cả.",
