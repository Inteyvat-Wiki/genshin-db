				]
			},
			"dialogs": [
				{
					"id": 750320101,
					"content": "Phong cảnh ở đây đẹp đúng không? Hơn nữa còn rất thích hợp để bay... Xuôi theo gió bay lên trời kiểu này chắc là sảng khoái lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320102,
						750320103
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320102,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				},
				{
					"id": 750320104,
					"content": "Chào dũng sĩ! Nếu muốn thử bay ở đây thì cứ tự nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320105
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320105,
					"content": "Tuy căn nhà bay này là cha tôi xây giúp, nhưng tôi không để bụng cho người khác dùng chung đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320106,
						750320107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320106,
					"content": "Cảm ơn, vừa đang muốn thử đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320108,
					"content": "#Không cần khách sáo. Chỉ cần {F#cô}{M#cậu} cũng thích bay thì sẽ là bạn của Manyoya này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320109
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320109,
					"content": "#Trông {F#cô}{M#cậu} còn trẻ lắm, là Kỵ Sĩ Saurian dự bị của đội bay hay là đang tự luyện tập để trở thành dũng sĩ vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320110
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320110,
					"content": "Chỉ là nhà mạo hiểm qua đường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320111
					]
				},
				{
					"id": 750320111,
					"content": "#Ồ? Hiếm khi thấy có nhà mạo hiểm lại chăm chỉ luyện bay đến vậy. Lúc nãy tôi còn tưởng {F#cô}{M#cậu} đang tập luyện cho kỳ sát hạch của đội bay chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320112
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320112,
					"content": "Nhưng chỉ cần từng chạm vào bầu trời thì sẽ không thể quên cảm giác đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320113
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320113,
					"content": "Muốn giữ trạng thái tự do đó thì ý nghĩ này dù là ai cũng sẽ có. Tôi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320114
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320114,
					"content": "Cô có vẻ rất rành nhỉ, cô là thành viên của đội bay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320115,
					"content": "Haha, đã từng là thôi. Bây giờ tôi giải ngũ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320116
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320116,
					"content": "Tôi bay nhiều năm rồi. Tuy đối với người thường thì số tuổi của tôi không phải lớn, nhưng đối với đội bay thì đã là lớn tuổi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320117
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320117,
					"content": "Thể trạng cũng không như lúc còn nhỏ nữa. Đúng là đã đến lúc nói lời tạm biệt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320118
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320118,
					"content": "Đừng nhìn tôi với ánh mắt thương hại này. Haha! Tôi không hề buồn, chỉ hơi tiếc thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320119
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320119,
					"content": "Đối với Kỵ Sĩ Saurian trẻ tuổi, lúc họ mới bắt đầu chạm vào bầu trời thì tôi đã từng bắt được sao băng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320120,
					"content": "Sau này chắc tôi sẽ không còn gần như ngày nào cũng bay trên trời, nhưng tôi vẫn sẽ có cơ hội để bay tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320121
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320121,
					"content": "Do đó tôi mới đến chỗ này, nếm lại mùi vị cuộc sống đã từ biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320122
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320122,
					"content": "Tiếc là bay một mình thì không có đồng đội ở bên cạnh cổ vũ, hơi chán một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320123
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320123,
					"content": "#À, {F#cô}{M#cậu} có hứng thú bay chung không? Đội bay thỉnh thoảng sẽ tổ chức các cuộc thi đấu nhỏ, chỉ để vui thôi chứ không có mục đích khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320124
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320124,
					"content": "So điểm số với nhau, người điểm cao nhất sẽ được tung hô, người điểm thấp nhất phải mời ăn một bữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320125
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320125,
					"content": "Mối quan hệ giữa các Kỵ Sĩ Saurian với nhau tốt thật nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320126,
					"content": "Ừm, thành viên của đội bay đều rất mạnh. Mọi người vừa là đồng đội, vừa là đối thủ của nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320127
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320127,
					"content": "Sau này không thể nào cười sảng khoái trong bầu không khí đó rồi... Hơn nữa tôi cũng buộc phải thừa nhận trình độ của mình đang tuột dốc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320128
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320128,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320129
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320129,
					"content": "Nhưng dù thể lực suy giảm, khả năng phán đoán không còn nhạy bén, nhưng kinh nghiệm của tôi vẫn tích lũy theo thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320130
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320130,
					"content": "Tuy tôi đã giải ngũ, nhưng muốn rời khỏi bầu trời thì bây giờ vẫn chưa phải là lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320131,
					"content": "#Hay là thi đấu xem {F#cô}{M#cậu} có đuổi kịp một Kỵ Sĩ Saurian kinh nghiệm dày dặn ở trên trời không nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320132,
						750320133
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320132,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320134,
					"content": "Ban đầu tôi còn lo là nói những chuyện này với một người trẻ tuổi thì sẽ bị xem là quái nhân chứ. Cũng may là không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320135
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320135,
					"content": "Khi nào cảm thấy muốn thử thì nói với tôi, mục tiêu thi đấu của chúng ta là:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320136
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320136,
					"content": "#Cố gắng bay theo cung đường cố định trong thời gian quy định. Tôi sẽ giúp {F#cô}{M#cậu} tính điểm. Thành tích bay sẽ được chia thành bốn mức độ dựa trên điểm số cao thấp, chỉ cần vượt qua mức cao thứ nhì là coi như thắng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320137
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320137,
					"content": "Khi nào có tâm trạng thì cứ đến tìm tôi và so tài nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320133,
					"content": "Để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320107,
					"content": "Cảm ơn, khi nào rảnh sẽ cân nhắc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320103,
					"content": "Xin chào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				}
			]
		},
		{
			"id": 7503202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503203",
							"2"
						],
						"stepId": 7503203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "Thế nào, so tài chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320202,
					"content": "Trong thời gian quy định cố gắng cưỡi Saurian bay theo đường đua cố định và cố gắng đạt số điểm cao nhất có thể. <color=#00E1FFFF>Chỉ cần vượt qua mức cao thứ nhì là coi như thắng tôi rồi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320203,
					"content": "Tôi đã sẵn sàng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "Được, tốt lắm! Đến điểm xuất phát nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320205,
					"content": "Tôi cần chuẩn bị thêm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "Không sao, khi nào có tâm trạng rồi tính. Bay vốn dĩ nên là chuyện vui vẻ thoải mái mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503204,
