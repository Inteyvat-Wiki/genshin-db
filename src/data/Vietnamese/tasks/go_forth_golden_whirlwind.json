			"dialogs": [
				{
					"id": 726860101,
					"content": "Xin hỏi đại danh của các hạ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860102,
					"content": "#Tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "Tôi nhớ rồi, xin hỏi các hạ có sẵn sàng đặt cược danh dự của mình với tư cách là một võ sĩ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860104,
					"content": "Hả? Gì cơ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "Hửm? Lẽ nào các hạ không phải là một võ sĩ đến để tham gia cuộc quyết đấu này sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860107,
					"content": "Không hiểu chuyện gì đang xảy ra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "Lẽ nào các hạ chưa từng nghe nói tới Độc Kiếm Tranh Hùng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860109,
					"content": "Không thể nào, rõ ràng là tôi đã dán thông báo rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860110,
					"content": "Anh đã dán chúng ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860111,
					"content": "Ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860112,
					"content": "Dán ở đây thì làm gì có người tới để xem chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860113,
					"content": "Hừm, cũng tại Hiệp Hội Yashiro khăng khăng rằng \"Lễ Hội Irodori không thích hợp để cầm đao múa kiếm\", nên đã từ chối tôi tổ chức quyết đấu ở Đảo Ritou, còn cấm tôi dán tờ rơi quảng cáo nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860114,
					"content": "Bởi vậy, tôi chỉ có thể chọn nơi này làm đấu trường để dán thông báo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860115,
					"content": "Tuy nhiên, cũng đã có bốn võ sĩ đến tham gia thi đấu, nếu tính thêm cả các hạ nữa thì sẽ là năm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860116,
					"content": "#Như thế này mà cũng có người đến tham gia hả, thật kỳ lạ. Nhắc mới nhớ, sao {NICKNAME} lại đến đây nhỉ, tôi chẳng nhớ gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860117,
					"content": "Các hạ có thể dựa vào ý chí để đến hòn đảo này chứng tỏ các hạ cũng là một dũng sĩ có tinh thần thượng võ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860118,
					"content": "Những người bị mê hoặc bởi võ thuật sẽ hấp dẫn lẫn nhau, đây là lẽ thường, hai vị đừng nên ngạc nhiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860119,
					"content": "Đây là lẽ thường ở thế giới nào vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860120,
					"content": "Haha, thế nào? Các hạ đã sẵn sàng tham gia thi đấu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860121,
					"content": "Nếu các hạ có thể đánh bại tất cả bốn thí sinh, ắt sẽ nhận được phần thưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860122,
					"content": "Tôi suy nghĩ chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "Được, các hạ hãy suy nghĩ cho kỹ nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860105,
					"content": "Không không, làm phiền rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}