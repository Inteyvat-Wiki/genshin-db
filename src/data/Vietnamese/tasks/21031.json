				{
					"id": 210310401,
					"content": "Các bạn về rồi à, ây da...đám ma vật đó quả thật khó đối phó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310402
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310402,
					"content": "Anh đã đánh bại hết đám ma vật đó rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310403
					]
				},
				{
					"id": 210310403,
					"content": "Hahaha, đúng vậy, tốn biết bao nhiêu sức lực, lớn tuổi rồi đúng là có chút lực bất tòng tâm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310404
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310404,
					"content": "Bạn chắc đã xử hết đám ma vật rồi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310405
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310405,
					"content": "Về doanh trại ma vật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310406
					]
				},
				{
					"id": 210310406,
					"content": "Ma vật toàn bộ bị đánh bại hết...nhưng trong doanh trại lại không có bóng người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310407,
					"content": "Chuyện này lạ thật, chẳng lẽ là nhà mạo hiểm nào đó đi ngang qua, đã tiện tay tiêu diệt chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310408,
					"content": "Tóm lại, vẫn rất cám ơn bạn đã đi tuần tra xung quanh giúp tôi, thù lao này xin bạn hãy nhận lấy.",
