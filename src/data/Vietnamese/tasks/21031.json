			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "Ái chà...vẫn phải nghĩ cách thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310102,
					"content": "Sao thế?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "Là bạn sao, haiz...đừng nhắc nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310104,
					"content": "Gần đây việc kinh doanh của nhà trọ càng ngày càng tốt, khách đến ở cũng càng lúc càng đông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310105,
					"content": "Có người đến để tìm sự thanh tịnh, có người dắt cả nhà đến du lịch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310106,
					"content": "Haiz, tuy rằng nhà trọ kinh doanh tốt thì tôi rất vui, nhưng xung quanh lại có rất nhiều ma vật lượn lờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310107,
					"content": "Nếu như có bạn nhỏ nào chạy ra đó, hoặc như có người lớn tuổi ra ngoài tản bộ mà gặp đám ma vật đó thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310108,
					"content": "Để tránh xảy ra chuyện này, tôi phải đi đuổi đám ma vật xung quanh nhà trọ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310109,
					"content": "Nhưng một mình tôi, thì cũng không đuổi được bao nhiêu ma vật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310110,
					"content": "Nhà Lữ Hành, bạn có thể giúp một tay không? Thù lao nhất định không thiếu phần bạn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310111,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "Vậy xin phiền bạn rồi. Trước đây tôi đã để ý mấy chỗ doanh trại, trong đó có rất nhiều ma vật nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310116,
					"content": "Hơn nữa, còn có một bầy ma vật lén lút mò đến gần nhà trọ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310117,
					"content": "Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310118,
					"content": "Hay thế này đi, những ma vật nguy hiểm đó cứ giao cho tôi, bạn giúp tôi xử lý đám ma vật xung quanh nhà trọ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310119,
					"content": "Sau khi đuổi xong hết đám ma vật đó, chúng ta gặp nhau trong nhà trọ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310120,
					"content": "Đám ma vật này, thiệt phiền chết được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310112,
					"content": "Thân thủ của anh chắc rất khá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Tôi? Bạn...quá lời rồi, chỉ tàm tạm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310114,
					"content": "Nhưng chỉ dựa vào một mình tôi, thì cũng không thể đánh đuổi hết toàn bộ số ma vật đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
