			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#{NICKNAME}, ở đây, ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570202,
					"content": "Còn nhớ không? Đây chính là nơi chúng ta bắt đầu chuyến hành trình đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570203,
					"content": "Không ngờ là đã đi qua nhiều nơi như vậy rồi đó! Tôi xúc động quá, muốn làm một bài thơ luôn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570204,
					"content": "Xin mời, nhà thơ đại tài Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "Haha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "Đừng có ngắt lời tôi chứ! Để tôi nghĩ xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570207,
					"content": "A! Một Teyvat rộng lớn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570208,
					"content": "Đi xa như vậy mà vẫn chưa đi hết!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570209,
					"content": "(Giữ im lặng.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "Chẳng có vần điệu gì cả thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "Hả! A... Ừm, không nghĩ ra gì nữa rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570212,
					"content": "Hahahahaha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "Paimon đang cảm thán những khó khăn trên đường đi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "Hứ, cứ cười đi. Tôi đã quá quen rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570215,
					"content": "#Đúng thế, đó chính là suy nghĩ mà tôi muốn biểu đạt đó. Chà, vẫn là {NICKNAME} hiểu tôi nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570216,
					"content": "Nghiêm túc mà nói, đi lâu như vậy rồi, rất dễ quên mất những chuyện thuở ban đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570217,
					"content": "Chẳng hạn như bây giờ tôi chẳng còn nhớ rõ mùi vị của Gà Nấu Hoa Ngọt nữa, món mà rõ ràng trước kia thích ăn lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570218,
					"content": "Cho nên tôi mới nghĩ đến việc mua quyển sổ ảnh này, để chụp ảnh những nơi đã đi qua và những người đã gặp mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570219,
					"content": "Chẳng phải tình tiết này thường thấy trong tiểu thuyết và phim ảnh sao? Một khi quay lại điểm xuất phát ban đầu thì cũng coi như sắp đến điểm kết thúc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570220,
					"content": "Chọn nơi này để chụp ảnh, không phải là để thương cảm gì đâu, mà là hy vọng chúng ta đều có thể ghi nhớ con đường khi tới đây, để bước tiếp nhẹ nhàng hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570221,
					"content": "Paimon nghe lén tôi nói chuyện với Kazuha à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "Chà, Paimon tiến hóa rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "Ờm... Thì đúng là khi cả hai nói chuyện thì tôi có ở bên cạnh để nghe lén thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570224,
					"content": "Đúng thật là, khó khăn lắm tôi mới tạo ra bầu không khí như vậy đó! Giờ chẳng còn gì nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570225,
					"content": "Tôi hiểu ý của Paimon mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "Chúng ta vẫn phải cùng nhau đi tiếp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "#Hihi, {NICKNAME} hiểu ý tôi là được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570228,
					"content": "#Được rồi, tấm hình này cứ để cho người dẫn đường giỏi nhất Teyvat làm người mẫu cho. {NICKNAME} thấy tư thế nào thì đẹp đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570101,
					"content": "#Ấy, đợi đã, máy ảnh tôi cho {NICKNAME} mượn đâu rồi? Không phải là làm mất rồi đấy chứ! Mau tìm lại xem có đem theo không đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
