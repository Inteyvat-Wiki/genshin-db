						740310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740310103,
					"content": "#Tùy thôi. Này {F#cô}{M#cậu} tóc vàng kia, vừa nhìn là biết đối thủ đáng gờm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310104,
					"content": "#Dạo này không có ai so tài, chán thật. Nếu đồng ý thi đấu thì tôi sẽ cho {F#cô}{M#cậu} Phiếu Đặc Cách! Lúc trước tôi ở chỗ Roussimoff đã thắng được không ít đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310105,
					"content": "Thế nào, đấu một ván nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				}
			]
