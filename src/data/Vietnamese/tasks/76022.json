			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Peco"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "Ôi, cảm ơn hai vị đã cứu mạng. Tôi là thương nhân Peco, sau này nếu hai vị có cơ hội mua hàng của tôi thì tôi sẽ cho hai vị mức chiết khấu ưu đãi nhất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220302,
					"content": "Mà nói chứ, hôm nay thật xui xẻo, lại gặp phải nhân vật trong truyền thuyết này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220303,
					"content": "Nhân vật trong truyền thuyết? Kẻ đó nổi tiếng lắm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220304,
					"content": "Tiếng xấu thì có đấy. Tôi cũng nghe đồng nghiệp khác kể lại... Lúc đó họ cũng sợ đến mức hồn vía lên mây, bảo sẽ không bao giờ đi tuyến đường này nữa. Tôi thì không tin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220305,
					"content": "Vậy thì anh cũng gan dạ thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220306,
					"content": "Thương nhân lữ hành như chúng tôi có chuyện gì mà chưa gặp chứ? Hơn nữa, mỗi khi tụ họp kể chuyện cũng thường hay... thêm mắm dặm muối mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220307,
					"content": "Lạc đề rồi... Gã đó tên là \"Gonpachi\", nghe nói từng phạm tội gì đó ở Inazuma rồi bỏ trốn đến đây. À, còn dẫn theo người tình của hắn nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220308,
					"content": "Vậy \"Murasaki\" mà hắn nhắc đến lúc nãy chính là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#Đúng đó! Vừa rồi lúc hắn đánh nhau với {NICKNAME} còn lẩm bẩm cái tên đó nữa. Kỳ lạ thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220310,
					"content": "Kẻ đó giờ đi sai đường thì dù đến nơi mới cũng khó mà rửa tay gác kiếm. Không có nghề nghiệp chính đáng, cuối cùng cũng chỉ bước theo con đường cũ mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220311,
					"content": "Nếu chỉ một mình hắn thì sống kiểu gì cũng được. Nhưng sống nơi đầu dao mũi kiếm, ai mà biết được sẽ đắc tội với kẻ nào chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220312,
					"content": "Nghe nói người tình của hắn cũng vì thế mà bỏ mạng... Tóm lại, từ đó về sau hắn cứ như hóa điên vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220313,
					"content": "Haiz... Tên to xác cướp Mora đúng là đáng giận, nhưng nghĩ đến chuyện hắn thành ra thế này cũng thấy có chút... đáng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220314,
					"content": "Nên Paimon tuyệt đối đừng vì Mora mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "Này! Trọng tâm không phải cái này nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220318,
					"content": "Thôi được rồi, tôi không làm mất thêm thời gian của hai vị nữa, xin hãy nhận lấy món quà cảm ơn này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220316,
					"content": "Nếu một ngày nào đó Paimon bị cướp mất...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#Thì có {NICKNAME} ở bên cạnh bảo vệ mà! Mora của tôi cũng thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}