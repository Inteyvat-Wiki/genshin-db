					}
				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "Này! Đồ to xác kia! Ngươi đang làm gì vậy? Mau dừng lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora... không đúng! Kẻ đã hại chết Murasaki... Chịu chết đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Samurai Phẫn Nộ"
				},
				{
					"id": 760220203,
					"content": "#Ối! {NICKNAME}, cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
