			"dialogs": [
				{
					"id": 718210301,
					"content": "Sao, chỗ đó có Đèn Tiêu cần thu hồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210302,
					"content": "Đã thu hồi 3 ngọn Đèn Tiêu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "Cám ơn nha, thu hồi Đèn Tiêu ở những nơi đó tốn công quá, mỗi lần tôi qua đó mệt muốn chết luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210304,
					"content": "Có bạn giúp đỡ thì tôi nhẹ nhõm hơn rồi. Đây là tiền thưởng, cám ơn bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
