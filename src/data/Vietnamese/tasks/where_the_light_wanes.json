					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "Sao lại bị phái đi làm việc này chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "Có lẽ Nhà Lữ Hành không biết, Đèn Tiêu trong Tết Hải Đăng năm nào cũng phải thu hồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210104,
					"content": "Lúc Đèn Tiêu bay lên thì rất đẹp, nhưng sau khi bay đi rồi, thì có nhiều vấn đề lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210105,
					"content": "Có khi chụp đèn làm không kỹ, mới bay được nửa đường thì hỏng, chỉ còn lại Phù Sinh Thạch bay lung tung khắp nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210106,
					"content": "Có khi đèn bị gió thổi đi, mắc kẹt ở góc xó xỉnh nào đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210107,
					"content": "Như vậy một là tiềm ẩn nguy hiểm, hai là ảnh hưởng mỹ quan đô thị, cho nên tổng vụ sẽ cho người chuyên phụ trách đi thu hồi những chiếc Đèn Tiêu này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210108,
					"content": "Năm nay đến lượt tôi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210109,
					"content": "Nhưng số lượng Đèn Tiêu trong Tết Hải Đăng quá nhiều...nếu chờ đến ngày cuối, chắc chắn tôi không thể thu hồi kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210110,
					"content": "Cho nên trong lúc mọi người thả đèn, tôi phải tranh thủ thu hồi những chiếc đèn bị hỏng, rơi ở nơi hẻo lánh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210111,
					"content": "Nhưng như thế thì một mình tôi cũng không làm xuể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210112,
					"content": "Nhà Lữ Hành, nếu được, bạn hãy giúp tôi xem thử mấy nơi này có Đèn Tiêu cần thu hồi hay không nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210113,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "Tôi đã đánh dấu trên bản đồ cho bạn mấy địa điểm đó, vậy thì phiền bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182102,
