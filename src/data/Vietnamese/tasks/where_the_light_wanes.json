				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "Sao lại như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "Ling Đánh Nhanh"
				},
				{
					"id": 718210202,
					"content": "Sao bạn lại ở đây?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "Tôi...haiz, sư phụ nói ông ấy vừa lĩnh ngộ được một bộ quyền pháp mới, rất lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "Ling Đánh Nhanh"
				},
				{
					"id": 718210204,
					"content": "Ông ấy nói tôi chưa đủ thành tâm, võ công cũng chưa tới đâu, nên không chịu truyền dạy bộ quyền pháp này cho tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "Ling Đánh Nhanh"
				},
				{
					"id": 718210205,
					"content": "Nhưng tôi nghĩ nhân dịp Tết Hải Đăng này, tôi thành tâm tặng một ngọn Đèn Tiêu cho sư phụ, không chừng tâm trạng sư phụ tốt lên sẽ chịu truyền dạy quyền pháp cho tôi thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "Ling Đánh Nhanh"
				},
				{
					"id": 718210206,
					"content": "Nhưng tôi không tìm được Phù Sinh Thạch, chỉ thấy một chiếc đèn bị mắc kẹt bên đó, nên muốn lấy Phù Sinh Thạch của nó về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "Ling Đánh Nhanh"
				},
				{
					"id": 718210207,
					"content": "Cuối cùng lại thành ra như vậy...haiz, thôi thì tôi không lấy Đèn Tiêu nữa, cho bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "Ling Đánh Nhanh"
				},
				{
					"id": 718210208,
					"content": "Không ngờ lại bị ma vật làm cho te tua như thế, võ công của tôi đúng là chưa tới đâu thật mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ling Đánh Nhanh"
				}
			]
		},
