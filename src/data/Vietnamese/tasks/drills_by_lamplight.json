			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Minglan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715410101,
					"content": "Là giáo đầu đó phụ trách thật sao... Haiz, vậy thì chỉ có thể chúc họ may mắn thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410102
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410103
					]
				},
				{
					"id": 715410103,
					"content": "#Hả!? Là {NICKNAME} à... Phù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410104
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410104,
					"content": "Làm tôi hết hồn, còn tưởng là giáo đầu đến đây chứ. Nếu bị nghe thấy thì tôi lại bị xách đi luyện tập rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410105,
						715410106
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410105,
					"content": "Các anh... vẫn còn đang tập luyện sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				},
				{
					"id": 715410107,
					"content": "Ôi, ngày lễ càng lớn thì chúng tôi càng bận mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410108
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410108,
					"content": "Cảng Liyue lớn như vậy, du khách từ khắp nơi đến rất đông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410109
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410109,
					"content": "Để duy trì trật tự và bảo vệ an toàn cho mọi người, Thiên Nham Quân đã bố trí rất nhiều trạm gác di động ở trong và ngoài thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410110
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410110,
					"content": "#{F#Cô}{M#Cậu} biết trạm gác di động không? Có thể hiểu đơn giản là một đội Thiên Nham Quân đi đến đâu giúp đến đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410111
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410111,
					"content": "Chỉ cần có người cần giúp đỡ đến khẩn cầu thì họ đều sẽ giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410112
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410112,
					"content": "Dù gặp nguy hiểm, làm mất đồ đạc, thậm chí là lạc đường cũng đều có thể đến nhờ giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410113
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410113,
					"content": "Nhưng mà... vì khu vực cần bao phủ rất rộng, cho nên giáo đầu của chúng tôi đã kéo cả đội dự bị ra để huấn luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410114
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410114,
					"content": "Nhưng những đội dự bị đó đều là tân binh, chưa được huấn luyện nhiều. Nên giáo đầu nói hay là tổ chức một buổi diễn võ tạm thời để nâng cao năng lực cá nhân của họ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410115
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410115,
					"content": "Tôi nghe nói... Giáo đầu đó rất tàn nhẫn, chỉ cần là người bị huấn luyện qua cũng đều sẽ run rẩy khi nghe nhắc đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410116
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410116,
					"content": "Anh... cũng từng bị huấn luyện qua sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410117
					]
				},
				{
					"id": 715410117,
					"content": "Có thể coi là vậy. Vị giáo đầu đó huấn luyện quả thật rất hiệu quả, chỉ là sau đó nghĩ lại thì... chân có hơi run...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410118
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410118,
					"content": "#{F#Cô}{M#Cậu} có muốn thử không? Khi tôi huấn luyện thường nghe thấy giáo đầu nhắc tên {F#cô}{M#cậu}, nói {F#cô}{M#cậu} rất giỏi chiến đấu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410119
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410119,
					"content": "#Nếu là {F#cô}{M#cậu} ở trong khu diễn võ thì thành tích nhất định sẽ tốt hơn chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410120,
						715410122
					],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410120,
					"content": "Tôi cũng muốn thử!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410121
					]
				},
				{
					"id": 715410121,
					"content": "Được. Dũng khí này... không hổ danh là đại anh hùng của Liyue. Vậy mời đi theo tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410122,
					"content": "Để tôi nghĩ thêm đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410123
					]
				},
				{
					"id": 715410123,
					"content": "#Không sao, nếu muốn thử thì cứ nói với tôi. Yên tâm, nếu {F#cô}{M#cậu} tham gia huấn luyện thì giáo đầu chắc chắn sẽ rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minglan"
				},
				{
					"id": 715410106,
					"content": "Bây giờ không phải là Tết Hải Đăng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				}
			]
		}
	]
}