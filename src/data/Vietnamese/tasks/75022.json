			"dialogs": [
				{
					"id": 750220703,
					"content": "Con Yumkasaur trước mặt nuốt chửng hết đồ ăn.\\nBạn thậm chí còn không kịp nhìn xem nó ăn như thế nào...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "Nó, nó... ăn nhiều quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220305,
					"content": "Bây giờ Paimon đã có đối thủ rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Chỉ một món như thế thì hình như không đủ nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "Cái gì cơ? Tôi ăn kỹ lắm đấy, chẳng bao giờ tôi ăn ngấu nghiến thế này cả... Ăn thế này chắc không cảm nhận được mùi vị gì đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220308,
					"content": "#Đúng... đúng vậy! Thật không ngờ đây là con \"Saurian tham ăn\". Cũng may {REALNAME[ID(2)|SHOWHOST(true)]} không ăn nhiều như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220309,
					"content": "Nhưng chắc là nó đói lắm rồi! Thật tội nghiệp, hay là cho nó thêm một phần nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220310,
					"content": "Arawrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} cũng muốn ăn sao? Đợi chúng ta cho chú Saurian này ăn no rồi cho nhóc ăn đồ ngon nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220312,
					"content": "Saurian đói bụng nuốt chửng thức ăn trước mặt.\\nBạn chớp mắt nhớ rằng cảnh tượng trước mặt đã từng xuất hiện qua...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Hmm, giờ chắc là no rồi chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220314,
					"content": "Này! Đợi đã, sao ngươi lại ngồi xuống rồi? Chẳng lẽ hai phần ăn là chưa đủ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220315,
					"content": "Woa, nó ăn no rồi ngủ luôn. Có vẻ như nó chẳng muốn rời khỏi cái miệng hang này chút nào đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220316,
					"content": "#Làm sao đây {NICKNAME}? Tôi không thể hiểu nổi hành vi của nó nữa rồi... Cho dù muốn ngủ thì cũng đừng bịt kín miệng hang thế chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220317,
					"content": "Hình như nó cũng chưa đồng ý với chúng ta là sẽ tránh ra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "Có cảm giác như bị lừa rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "Tức quá! Ăn biết bao nhiêu món của chúng ta như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220320,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Ngay cả {REALNAME[ID(2)|SHOWHOST(true)]} cũng không thể nhìn nổi nữa rồi, {NICKNAME}, hay chúng ta thử gọi nó dậy xem sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
