			"dialogs": [
				{
					"id": 750220801,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "Hihi, tuyệt lắm! Để xem thử xem trong rương có thứ gì nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220803,
					"content": "Hả, chẳng có gì cả? Sao lại chỉ có mỗi tờ giấy thế này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220804,
					"content": "Thì ra người để lại tờ giấy này là chủ nhân thực sự của nó ư? Vậy không phải chúng ta bị con Saurian này lừa, mà là bị chủ nhân của nó lừa sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220805,
					"content": "Thật là vô trách nhiệm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "Phải đó! Cho dù hắn ta bị bệnh thì cũng không nên vứt bỏ Yumkasaur ở nơi như thế này chứ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220807,
					"content": "Lại dám lợi dụng lòng tham của người khác thế này... Không đúng, là lợi dụng lòng tốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220810,
					"content": "Haiz, tóm lại là không nên để tình trạng này tiếp diễn nữa. Hay là đi tìm thủ lĩnh của Dòng Dõi Vườn Treo để nói rõ chuyện này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220811,
					"content": "Kể rõ chuyện này với thủ lĩnh Wayna của Dòng Dõi Vườn Treo và dẫn anh ta đến.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "#Ôi trời, lúc {F#cô}{M#cậu} đến tìm tôi thì tôi đã có dự cảm rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220813,
					"content": "Không ngờ lại là Saurian của \"tên kia\" để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220814,
					"content": "\"Tên kia\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "Là kẻ đã làm chuyện sai trái, vì sợ bị trừng phạt nên đã chủ động rời khỏi bộ tộc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220817,
					"content": "Tuy nhiên, tôi sẽ không nhiều lời về người này. Có lẽ hắn ta cũng nghĩ đó không phải là chuyện gì tốt đẹp. Nhìn này, trên thư đến cả tên cũng không để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220818,
					"content": "Thì ra Saurian đã lựa chọn ở bên cạnh hắn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "Không thể nói là lựa chọn. Saurian là một sinh linh đơn thuần, không giỏi cân nhắc đúng sai. Hầu hết chúng sẽ tin tưởng vào đối tác của mình dựa theo cảm xúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220820,
					"content": "...Quả nhiên, bản tính của hắn ta vẫn khó thay đổi. Có chút thông minh cũng dùng để lừa gạt, dùng thủ đoạn này để lừa người khác, cũng lừa cả Saurian của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220821,
					"content": "Chúng tôi sẽ cử người đến cho con Yumkasaur này ăn định kỳ. Dù sao thì nó cũng là thành viên của bộ tộc mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220822,
					"content": "Còn về tên kia... Haiz, một cái kết bi thảm đấy. Nhưng tôi không đồng cảm, vì hắn phải chịu trách nhiệm cho những việc mình đã làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220808,
					"content": "Vậy là nếu ăn quá nhiều thì sẽ bị bỏ rơi sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "Này! Đừng đùa như thế chứ! Nó cũng có hơi vô tội mà. Nói không chừng là nó còn đang đợi chủ nhân quay về nên mới không chịu đi đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				}
			]
		},
