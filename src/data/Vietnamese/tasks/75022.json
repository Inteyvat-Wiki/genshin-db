					"id": 750220606,
					"content": "Vừa nãy hai người thủ thỉ gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220607,
					"content": "(Ục...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220608
					],
					"speakerTitle": "Yumkasaurus Kỳ Lạ"
				},
				{
					"id": 750220608,
					"content": "Chẳng lẽ là do đói bụng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220609,
					"content": "Saurian ở đây một mình, không thấy chủ nhân đâu... Có lẽ nó cũng không thể tự mình đi tìm thức ăn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220610,
					"content": "#{NICKNAME}, chúng ta mau cho nó ăn đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220611,
					"content": "Đợi nó ăn no rồi ngoan ngoãn đi ra, vậy thì kho báu sẽ là của chúng ta rồi! Hihi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "Nên cho nó ăn gì nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Để nghĩ xem nào. Saurian ở Natlan này hình như cái gì cũng ăn một chút, nhưng không biết Yumkasaur thích ăn gì. Nhìn màu của nó thì chắc là nó thích ăn cỏ hay lá cây gì đó nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220614,
					"content": "Thử cái gì đó đơn giản trước xem. Đói rồi thì chắc cũng không kén ăn đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
