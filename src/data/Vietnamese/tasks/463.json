					"content": "Hai vị đã giúp tôi việc lớn như vậy, quà cảm ơn cũng không thể thiếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630521
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630521,
					"content": "Thanh kiếm này tên là \"Thần Kiếm Mở Ra Bình Minh Hướng Về Thắng Lợi Bay Bổng\", tên cũng như vật, là thanh kiếm tượng trưng cho thắng lợi và bình minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630533
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630533,
					"content": "Nếu không chê, tôi sẽ dùng thanh Thần Kiếm Lê Minh cất giữ đã lâu này để làm quà cảm ơn hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630522
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630522,
					"content": "\"Thần Kiếm Lê Minh\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630523,
					"content": "Đúng vậy. Rất giống với Paimon thông tình đạt lý nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630524,
					"content": "Ừm... nếu quà cảm ơn là thanh Thần Kiếm Lê Minh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630525,
					"content": "Hai vị sẽ hiểu cho tôi, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630526,
					"content": "Có những người bạn hiểu chuyện dịu dàng như hai vị, là vinh hạnh của Kaeya tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630527,
					"content": "Ừm... Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630529,
					"content": "...Paimon đã hoàn toàn bị khống chế rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630530,
					"content": "...Hai chiêu khác nhau thì vẫn có thể dùng phải không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630528,
					"content": "Việc lần này thật xin lỗi, nhưng Paimon hãy yên tâm, một chiêu tôi sẽ không dùng hai lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630529,
						4630530
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630535,
					"content": "Nói chứ, hai vị hoàn toàn dựa vào năng lực của mình để giải câu đố, tìm được đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630536,
					"content": "Những manh mối ấy cũng là do anh đưa cho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630537,
					"content": "Đúng vậy. Sự mơ hồ của những manh mối đó, đến tôi cũng cảm thấy hơi hà khắc với hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630538,
					"content": "Vốn đã chuẩn bị xong, lúc nào cũng sẵn sàng trả lời cho hai vị...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630539,
					"content": "Haha, trong lần hành động này, đây là việc duy nhất nằm ngoài dự đoán của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630541,
					"content": "Chuyện nhỏ như con thỏ!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4630542,
					"content": "Kỳ thực tôi dùng một số cách khác...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4630540,
					"content": "Hì hì, trình độ này, đương nhiên không đáng để ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630543,
					"content": "Bất kể thế nào, tôi công nhận trí tuệ của hai vị, trí tuệ không thể lừa dối được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630544,
					"content": "Chỉ có những người thích dùng trí tuệ để lừa người khác thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630545,
					"content": "Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630531,
					"content": "Thật là một ngày vui vẻ. Vậy thì, tôi còn phải về thẩm vấn nghi phạm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630532,
					"content": "Hôm nay cáo từ ở đây vậy. Sau này hoan nghênh đến đội Kỵ Sĩ tìm tôi, chúng ta gặp lại sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		}
	]
}