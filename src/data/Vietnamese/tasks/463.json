			"dialogs": [
				{
					"id": 4630301,
					"content": "Hừ... Ở đây là đường cùng rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630302,
					"content": "Kho báu kho báu, cất giấu ở đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630303,
					"content": "#{NICKNAME}, cùng đi tìm xung quanh xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630304,
					"content": "Hahaha... Không cần phiền các ngươi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630305
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630305,
					"content": "Những việc còn lại, cứ giao cho ta là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630306,
						4630308
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630306,
					"content": "Người của Đạo Bảo Đoàn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630307
					]
				},
				{
					"id": 4630307,
					"content": "Thật thông minh, nhưng bây giờ mới phát hiện có hơi muộn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630311,
					"content": "Xin chào, ta là Izzard",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630312
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630312,
					"content": "Thay mặt Đạo Bảo Đoàn biểu lộ sự biết ơn, cảm ơn hai vị đã dẫn đường giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630313
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630313,
					"content": "Ahh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630314,
					"content": "Thật là kỳ lạ, chúng ta hành động bí mật, tin tức về kho báu sao lại bị tiết lộ rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630315,
					"content": "Tôi lại không thấy khó hiểu chút nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "Hừ! Ta sẽ không chịu thua. Này, Đạo Bảo Đoàn! Các người cho rằng bọn ta sẽ không phản kháng à!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630317,
					"content": "Nếu ngươi coi thường thực lực của bọn ta, thì lát nữa đừng hoảng sợ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630318,
					"content": "Chỉ cần ta ra lệnh, các huynh đệ đang mai phục bên ngoài sẽ đến chào hỏi các ngươi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630319,
					"content": "Tiếc là, họ không dễ nói chuyện như bọn ta đâu, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630320,
					"content": "(Kaeya và Đội Kỵ Sĩ Tây Phong xuất hiện)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630321,
					"content": "Đến làm phiền lúc các hạ đang vui như vậy, thật là ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630322,
					"content": "Bọn anh em của ngươi đã không thể trả lời ngươi được nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630323,
					"content": "E rằng ngươi...chỉ có thể đến nhà lao Mondstadt để thăm chúng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630324,
					"content": "Hoặc là, làm bạn trong tù với chúng cũng không tệ nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630325,
					"content": "Người của đội Kỵ Sĩ...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630326,
					"content": "Wow, là Kaeya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630327,
					"content": "Kaeya, hắn đang có ý đồ với kho báu của anh! Mau bắt hắn lại đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630328,
					"content": "Hừ, thật phiền phức, rõ ràng sắp đoạt được rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630329,
					"content": "À há, kho báu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630330,
					"content": "Thật ngại quá, ở đây vốn không có kho báu gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630331,
					"content": "Các ngươi đã phí công vô ích rồi. Bây giờ thì, chịu trói đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630332,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630333,
					"content": "Không có... kho báu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630334,
					"content": "Lúc nãy Kaeya nói... không có... kho báu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630335,
					"content": "Haha. Bị mắc bẫy rồi... thật không ngờ đội Kỵ Sĩ cũng dùng thủ đoạn đê tiện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630336,
					"content": "Là đạo tặc thì đừng tùy tiện phán xét trí tuệ của đội Kỵ Sĩ... này, đợi chút, ngươi muốn làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630337,
					"content": "Ai lại để bị các ngươi bắt chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630338
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630338,
					"content": "Đây... đây là gì? Tôi không cố ý!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630308,
					"content": "...Là người của sở giao dịch tình báo sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630309
					]
				},
				{
					"id": 4630309,
					"content": "Hahaha, sở giao dịch tình báo. Ta có quen biết bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630310
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630310,
					"content": "Đều là những thương nhân tuân thủ quy tắc, không phát tài được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 46305,
			"completionStepIds": [
				46305,
				46308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46305",
							"2"
						],
						"stepId": 46305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4630501,
					"content": "Hừ... không ngờ lại lâm vào bước đường phải nhờ Đội Kỵ Sĩ cứu mạng, thật là mất mặt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630502
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630502,
					"content": "Đừng quên ngươi đã hứa gì, không thì thứ vừa nãy không phải là thứ đáng sợ nhất ngươi nhìn thấy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630503
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630503,
					"content": "Cái này... này! Đội Kỵ Sĩ các ngươi đều đối xử với nghi phạm vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630504
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630504,
					"content": "Nói đùa thôi. Được rồi, đem hắn về thành Mondstadt đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630505,
					"content": "Dạ! Đội trưởng Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630506
					],
					"speakerTitle": "Kỵ Sĩ Tây Phong"
				},
				{
					"id": 4630506,
					"content": "Đội trưởng, đem theo cả hai người này chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630507
					],
					"speakerTitle": "Kỵ Sĩ Tây Phong"
				},
				{
					"id": 4630507,
					"content": "Sao cơ?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630508,
					"content": "Haha, không cần. Hai vị này là công thần trong lần hành động này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630510,
					"content": "Quả nhiên là tin tình báo giả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630511,
					"content": "Quả nhiên không có kho báu gì cả.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630512,
					"content": "Hóa ra ta bị lừa rồi! Tức quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630513
					]
				},
				{
					"id": 4630509,
					"content": "Không có họ loan truyền tin <color=#00E1FFFF>tình báo giả</color>, chúng ta cũng không dễ dàng xử lý bọn Đạo Bảo Đoàn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630510,
						4630511,
						4630512
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630513,
					"content": "Huhuhu... Tên lừa đảo! Kẻ xấu xa thích nói dối! Tên bại hoại của đội Kỵ Sĩ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630514,
					"content": "Dừng, dừng lại, được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630515
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630515,
					"content": "#Tuy kho báu là giả, nhưng {F#cô}{M#cậu} cũng từng nảy sinh ý định chiếm đoạt kho báu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630516,
					"content": "Nếu không, tại sao không báo cho tôi biết, mà tự mình đi đến đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630517
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630517,
					"content": "A!... Ừm... hừ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630518,
					"content": "#{NICKNAME}, chúng ta đi thôi! Không rảnh nói chuyện với tên này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630519,
					"content": "Haha, đợi một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630520
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630520,
					"content": "Hai vị đã giúp tôi việc lớn như vậy, quà cảm ơn cũng không thể thiếu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630521
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630521,
					"content": "Thanh kiếm này tên là \"Thần Kiếm Mở Ra Bình Minh Hướng Về Thắng Lợi Bay Bổng\", tên cũng như vật, là thanh kiếm tượng trưng cho thắng lợi và bình minh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630533
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630533,
					"content": "Nếu không chê, tôi sẽ dùng thanh Thần Kiếm Lê Minh cất giữ đã lâu này để làm quà cảm ơn hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630522
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630522,
					"content": "\"Thần Kiếm Lê Minh\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630523,
					"content": "Đúng vậy. Rất giống với Paimon thông tình đạt lý nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630524,
					"content": "Ừm... nếu quà cảm ơn là thanh Thần Kiếm Lê Minh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630525,
					"content": "Hai vị sẽ hiểu cho tôi, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630526,
					"content": "Có những người bạn hiểu chuyện dịu dàng như hai vị, là vinh hạnh của Kaeya tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630527,
					"content": "Ừm... Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630529,
					"content": "...Paimon đã hoàn toàn bị khống chế rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630530,
					"content": "...Hai chiêu khác nhau thì vẫn có thể dùng phải không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630531
					]
				},
				{
					"id": 4630528,
					"content": "Việc lần này thật xin lỗi, nhưng Paimon hãy yên tâm, một chiêu tôi sẽ không dùng hai lần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630529,
						4630530
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630531,
					"content": "Thật là một ngày vui vẻ. Vậy thì, tôi còn phải về thẩm vấn nghi phạm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630532,
					"content": "Hôm nay cáo từ ở đây vậy. Sau này hoan nghênh đến đội Kỵ Sĩ tìm tôi, chúng ta gặp lại sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
