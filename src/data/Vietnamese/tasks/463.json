			"dialogs": [
				{
					"id": 4630101,
					"content": "\"Di Tích Arcadia\" là ở đây nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630102,
					"content": "Nói sao nhỉ... Cảm giác có chút tầm thường?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630103,
					"content": "Tôi hiểu rồi, nơi càng tầm thường, càng dễ bị người khác lãng quên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630104,
					"content": "Thật là thâm thúy, ông nội Kaeya quả nhiên lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630105,
					"content": "Sột soạt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630106,
					"content": "Hở? Paimon, bạn nghe kìa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "Là chuột.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630108,
					"content": "Câu trả lời tùy tiện quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "Ồ... đừng nghi thần nghi quỷ nữa, sẽ không có vấn đề gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630110,
					"content": "Nhanh tay nhanh chân lên! Kho báu đã ở trong đó đợi chúng ta rất lâu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
