			"dialogs": [
				{
					"id": 4630001,
					"content": "Những câu đố này đã giải hết rồi, thật là tốn nhiều công sức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630014,
					"content": "Nhưng nói chứ, tấm bản đồ kho báu này vẽ cũng thật sơ sài... đúng là giống với hải tặc vẽ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630002,
					"content": "Vậy thì bây giờ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630003,
					"content": "Đến báo cáo với Kaeya trước đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "Hm...? Paimon cảm thấy, không, cần, thiết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630006,
					"content": "Không hổ là bạn của Paimon! Suy nghĩ giống y hệt Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630007,
					"content": "Nếu không đến thẳng, nhỡ bị người khác cướp mất thì phiền phức rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630008,
					"content": "Ví dụ như Kaeya... Ừm, Đạo Bảo Đoàn mà Kaeya từng nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630009,
					"content": "Tóm lại, tôi chỉ muốn mượn thanh kiếm ấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630010,
					"content": "Không, không, chỉ muốn nhìn một chút thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630011,
					"content": "Tuyệt đối không phải muốn những thứ như thiên hạ vô địch, ăn no mặc ấm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630012,
					"content": "Được rồi, để đợi tìm được kho báu rồi nói nhảm sau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630013,
					"content": "Con đường đi tìm Arcadia - Chính thức bắt đầu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630005,
					"content": "Đến thẳng địa điểm kho báu đi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630006
					]
				}
			]
		},
