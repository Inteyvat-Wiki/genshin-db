			"dialogs": [
				{
					"id": 726680101,
					"content": "Mọi người đã từng cùng theo đuổi \"Ánh Trăng Biển\" cũng xem như đã hoàn thành tâm nguyện của bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680102,
					"content": "Xong rồi chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "Nhìn xem, có phải Jiawei đã tìm được một người vợ rất giàu có không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680104,
					"content": "Nantuck cũng vì quyển sách tiết lộ \"Ánh Trăng Biển\" mà trở thành tác giả có chút danh tiếng, tuy nội dung là sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680105,
					"content": "Kujirai Momiji thì trở thành Ngư Vương giỏi nhất Inazuma, hơn nữa hôm nay còn bắt được \"Ánh Trăng Biển\" mà cha cô ấy chưa bắt được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680106,
					"content": "#Cho nên tôi cảm thấy nguyện vọng của {NICKNAME} nhất định cũng sẽ thành hiện thực! Ha ha ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680107,
					"content": "Paimon vừa cầu nguyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "Không nói được, nói ra sẽ mất linh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680109,
					"content": "\"Ánh Trăng Biển\" không nhỏ mọn vậy đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Ừm vậy được, nghe rõ đây, tôi chỉ nói một lần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680111,
					"content": "Nguyện vọng của tôi chính là thực hiện nguyện vọng của bạn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680112,
					"content": "Giọng nhỏ quá, nói gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "Hứ, đã nói chỉ một lần, không nghe được thì thôi vậy! Tôi đi mua kẹo đây~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
