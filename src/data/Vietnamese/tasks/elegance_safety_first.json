			"dialogs": [
				{
					"id": 747000101,
					"content": "Hihi, tôi thấy trang trí bể cá cũng khá thú vị mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000102,
					"content": "Nếu Sandrone không phiền, vậy sau này chúng ta cứ xuống vớt thêm đồ, để nơi này trở nên thật xinh đẹp nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000103,
					"content": "Này, hai người mau qua đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000104,
					"content": "Hả? Có chuyện gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000105,
					"content": "Đây, cái này cho hai người đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000106,
					"content": "Đây là...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000107,
					"content": "Đây là thiết bị hành động dưới nước tôi cải tiến cho hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000108,
					"content": "Ơ?! Thật sao? Cảm ơn nhé Sandrone! Cô tốt bụng thật đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000109,
					"content": "Chỉ là tiện tay làm chút thiết bị máy móc nhỏ thôi. Chủ yếu là lần trước hai người bắt cá, nói sao nhỉ... rất... thô sơ... thực sự không thể làm ngơ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000110,
					"content": "Tệ... Tệ đến vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000111,
					"content": "Hiệu suất kém, không có kỹ thuật gì cả, hơn nữa không thanh lịch chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000112,
					"content": "Để cô chê cười rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "Thôi được rồi, ai cũng có thói quen riêng, tôi cũng không nói nhiều nữa. Nhưng nếu muốn tiếp tục trang trí thủy cung này, tốt nhất là nên mang theo thứ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000114,
					"content": "Dưới nước Fontaine không chỉ có những loài cá nhỏ hiền lành xinh đẹp, mà còn có nhiều loài cá lớn nguy hiểm và hung dữ. Thứ này vừa để tăng tỷ lệ thành công, vừa để đảm bảo an toàn cho hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000115,
					"content": "Cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Hừm, được rồi, muốn xuống nước thì nhanh lên đi. Quay lại thì nhớ báo lại cảm nhận khi sử dụng nhé. Tôi có thể điều chỉnh theo phản hồi của hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 747000116,
					"content": "Tôi sẽ mang theo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}