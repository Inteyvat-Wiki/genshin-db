	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Hmm. Lấy tranh gợi thơ... Không đúng, không đúng, phải là lấy thơ nhập họa mới đúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320102,
					"content": "Khụ... Hình như cũng không đúng, hai câu này là cùng một ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320103,
					"content": "Anh đang nói gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Xin chào. Đúng vậy, tôi đang thử sáng tác thơ lấy cảm hứng từ cảnh đẹp của Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320106,
					"content": "Nhưng mà... Nói thật, phong cảnh nơi đây hoàn toàn khác với Liyue. Tôi cũng không hiểu rõ lịch sử Natlan, nên hoàn toàn bí ý tưởng viết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320107,
					"content": "Hơn nữa, tôi không phải nhà thơ chuyên nghiệp... Gieo vần không tốt, chia đoạn cũng không làm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320108,
					"content": "Haiz, nhưng đã lặn lội đến đây rồi, tôi không thể nào về tay trắng được. Chắc chắn các đồng nghiệp ở Tổng Vụ sẽ trêu tôi là \"đi tìm cảm hứng mà chẳng tìm được gì\" mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320109,
					"content": "Anh làm việc ở Tổng Vụ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Cứ coi là vậy đi. Dạo trước tôi được Tổng Vụ thuê đi khảo sát đất đai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320111,
					"content": "Haiz, thực ra là dẫn mọi người đi khắp Liyue, xem xét xem địa hình có thay đổi gì không, có cần chỉnh sửa bản đồ hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320112,
					"content": "Lòng vòng một chuyến mệt gần chết, không biết đã mòn bao nhiêu đôi giày rồi... Thế nên tôi đã xin nghỉ phép để đi giải khuây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320113,
					"content": "Chỉ là... Không biết lúc đó tôi nghĩ gì nữa. Tôi viết vào đơn xin nghỉ là \"chợt có hứng thơ, muốn đi tìm cảm hứng sáng tác\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320114,
					"content": "Ai ngờ người duyệt đơn của Tổng Vụ lại nghiêm túc trả lời tôi rằng \"chúc thi vận hanh thông\"... rồi duyệt cho tôi nghỉ hẳn nửa tháng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320115,
					"content": "Vậy chẳng phải quá tốt sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "Tốt ư? Tốt thì tốt đấy, nhưng đơn xin nghỉ của tôi... đã bị cả Tổng Vụ biết hết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320119,
					"content": "Haiz, mặc dù Natlan cũng rất thú vị. Phong cảnh đẹp, đồ ăn ngon, còn có đủ thứ sinh vật kỳ thú, đặc biệt là mấy bé Saurian cũng rất đáng yêu nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320120,
					"content": "Nhưng mà, đến giờ tôi vẫn chưa viết được một câu thơ nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320121,
					"content": "Uổng công tôi còn mượn máy ảnh đi chụp ảnh để lấy tư liệu sáng tác, ai ngờ còn chẳng biết cách dùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320122,
					"content": "Chụp ảnh phong cảnh tự nhiên thì tạm ổn, nhưng hễ chụp cửa hàng hay đám đông là ảnh in ra lại trông rất tệ hại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320123,
					"content": "Hmm, để tôi giúp anh nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "Thật hả?! Cảm ơn trời đất, cuối cùng cũng có người giúp tôi rồi... Dù sao thì tôi cũng cần thu thập tư liệu để làm thơ trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320126,
					"content": "Ừm... Để tôi nghĩ xem nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320124,
					"content": "Tôi giỏi chụp ảnh nhất đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "Vậy thi vận của anh có hanh thông không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "Không. Nhưng... đơn xin nghỉ của tôi thì \"hanh thông\" vô cùng. Cả Tổng Vụ đều biết tôi đi Natlan để làm thơ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320104,
					"content": "Anh đang làm thơ sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
