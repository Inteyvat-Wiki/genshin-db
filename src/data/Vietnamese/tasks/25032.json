			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "Về rồi à! Đã chụp ảnh xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320602,
					"content": "Chụp xong rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "#Ôi... {F#Cô}{M#Cậu} chụp đẹp quá, còn đẹp hơn cả trợ lý của tôi nữa. Anh ta lúc nào cũng phải chụp đi chụp lại mấy lần để lấy ảnh làm bằng chứng cho địa điểm khảo sát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320604,
					"content": "#Nếu {F#cô}{M#cậu} đi khảo sát cùng tôi thì chắc chắn sẽ tiết kiệm được kha khá máy ảnh đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320605,
					"content": "Những bức ảnh này có thể dùng để làm thơ được sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "Có lẽ... được chứ nhỉ? Ôi, nếu tôi không làm được thơ thì đành lấy những bức ảnh này ra để làm bưu thiếp vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320607,
					"content": "Viết vài lời chúc lên mặt sau rồi gửi về Tổng Vụ. Sau khi đám người đó nhận được quà thì chắc chắn sẽ không nói được gì nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320608,
