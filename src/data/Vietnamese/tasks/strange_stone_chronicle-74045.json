			"dialogs": [
				{
					"id": 740450401,
					"content": "Chào mừng quý khách, đây là cửa tiệm đá quý chủng loại đầy đủ nhất Đại Sảnh Fontaine. Còn có bán các loại hàng thủ công nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450402,
					"content": "Có món nào mà quý khách thấy vừa mắt không? Hoặc nếu có nhu cầu gì thì cũng có thể hỏi tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450403,
					"content": "Trong tay chúng tôi có vài khoáng thạch thần bí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450404
					]
				},
				{
					"id": 740450404,
					"content": "Nếu đây là cửa hàng đá quý đầy đủ nhất, vậy chắc anh hiểu rõ giá trị viên khoáng thạch trên tay tôi mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450405,
					"content": "Hóa ra quý khách đến đây bán khoáng thạch sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450406,
					"content": "Vậy là quý khách tìm đúng người rồi. Giá thu mua của chỗ tôi đây, có thể nói là mua bán đúng giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450407
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450407,
					"content": "Vậy, là loại khoáng thạch như thế nào vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450408
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450408,
					"content": "Bạn mang khoáng thạch tìm thấy lúc trước ra để Chesil kiểm tra.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450409
					]
				},
				{
					"id": 740450409,
					"content": "Đây... Không ngờ lại là loại khoáng thạch đến tôi cũng chưa từng thấy qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450410
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450410,
					"content": "Nhưng màu sắc này, chất đá nhẵn bóng... Chắc chắn là loại vô cùng quý hiếm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450411
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450411,
					"content": "Thứ lỗi cho tôi không hiểu biết nhiều, xin hỏi đây rốt cuộc là khoáng thạch gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450412,
						740450414,
						740450416
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450412,
					"content": "Tôi cũng không rõ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450413
					]
				},
				{
					"id": 740450413,
					"content": "Cho nên quý khách mới đến tìm tôi giám định phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450419,
					"content": "Nhưng khoáng thạch như vậy mà lại chỉ có một viên, quả là đáng tiếc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450420
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450420,
					"content": "Nếu có đủ nguồn hàng, nói không chừng có thể làm ra trang sức đủ để tạo trào lưu khắp Fontaine đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450421
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450421,
					"content": "(Tôi nhớ là Puca từng nói loại đá này có đầy ở chỗ đó đúng không? Nếu như hỏi em ấy thì...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450422,
						740450424,
						740450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450422,
					"content": "Khoáng thạch giống vậy chúng tôi có không ít.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450423
					]
				},
				{
					"id": 740450423,
					"content": "Thật sao, vậy thì quá tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450430,
					"content": "Vậy thì tôi đồng ý mua khoáng thạch này, với lại tôi còn muốn nhập vào nhiều hơn để chế tác một số mặt hàng thủ công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450431
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450431,
					"content": "Để thể hiện thành ý, tiền hàng tôi sẽ thanh toán trước cho các bạn. Chỉ cần lần sau các bạn mang thêm nhiều khoáng thạch hơn đến cho tôi là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450432
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450432,
					"content": "Giao dịch này rất công bằng. Không biết ý kiến của các bạn như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450433
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450433,
					"content": "Hihi, không tệ đó. Vậy thì thỏa thuận vậy nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450434,
					"content": "Quá tốt rồi, đây là tiền hàng của các bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450435
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450435,
					"content": "Đá quý như thế này có thể làm ra trang sức như thế nào đây. Haha, tôi bắt đầu mong chờ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450436
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450436,
					"content": "Vậy tôi ở đây chờ tin tốt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450424,
					"content": "Nguồn hàng là bí mật kinh doanh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450425
					]
				},
				{
					"id": 740450425,
					"content": "Chuyện này thì đương nhiên rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450426
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450426,
					"content": "Nhưng chỉ cần quý khách có kênh để nhập hàng thì quá tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450427,
					"content": "Thật ra ở \"Elynas\" có rất nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450428
					]
				},
				{
					"id": 740450428,
					"content": "Này, sao lại nói thẳng ra vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450429,
					"content": "Hóa ra là tìm thấy từ \"Elynas\" sao? Đúng là không có mấy ai đi sâu vào đó tìm khoáng thạch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450414,
					"content": "Gọi là \"Đá Paimon\" được không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450415
					]
				},
				{
					"id": 740450415,
					"content": "Cái gì thế? Đừng đặt cái tên kỳ lạ vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450416,
					"content": "Đương nhiên gọi là \"Đá Ánh Vàng Lung Linh Lấp Lánh\" rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450417
					]
				},
				{
					"id": 740450417,
					"content": "#{NICKNAME} vừa mới bịa ra à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450418,
					"content": "Cái tên ghê gớm thế này, chẳng trách sao trông đặc biệt như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				}
			]
		},
