			"dialogs": [
				{
					"id": 740450201,
					"content": "Về rồi đây! Đã tìm thấy tín vật của Puca rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "Đưa tín vật cho Puca.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Chính là cái này, cảm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450204,
					"content": "Nhưng trong lúc tìm tín vật còn phát hiện ra cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "Là khoáng thạch trước giờ chưa từng thấy. Không chừng đó là bảo thạch quý gì đó, cho nên cũng mang về luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "Nhớ là Puca nói bản thân trước kia thường nhặt những viên đá đẹp ở xung quanh đây về, nên chắc cũng từng thấy qua loại như vậy phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "Để em xem thử... quả thực rất đẹp! Nhưng không phải là đá quý gì cả, chỉ là đá bình thường thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450208,
					"content": "Có thể những nơi khác sẽ không có khoáng thạch như vậy, nhưng xung đây có nhiều lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450209,
					"content": "Sao? Chỉ là đá thông thường hả. Ban đầu còn tưởng là rất đáng giá chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "Xem ra cũng không có công dụng gì, chúng ta tìm chỗ vứt nó đi thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "Nhưng người bên ngoài chắc chưa từng thấy qua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Ồ, ý là nếu đem ra ngoài bán thì có thể bán được với giá tốt đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "#Đúng là người ở bên ngoài sẽ không nghĩ đến việc đến làng của Melusine để khai khoáng, nên họ chắc cũng chưa từng thấy qua loại khoáng này... {NICKNAME} giỏi quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "Vậy thì chúng ta mang nó đến Đại Sảnh Fontaine đưa cho thương nhân xem đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "Ừm, nếu muốn biết thêm chuyện về khoáng thạch thì có thể đến đây tìm em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450217,
					"content": "Tuy em không giống chị gái có công xưởng đá quý của riêng mình, những việc như giám định xử lý em cũng không hiểu nhiều...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450218,
					"content": "So với những viên đá quý này thì em thích thu thập các loại đá thú vị hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450219,
					"content": "Cho nên tình hình mạch khoáng ở gần đây em hiểu rất rõ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450220,
					"content": "Được thôi, Puca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "Nhưng nếu chỉ là ở đây có...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
