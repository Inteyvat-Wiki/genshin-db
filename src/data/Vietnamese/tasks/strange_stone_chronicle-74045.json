			"dialogs": [
				{
					"id": 740450101,
					"content": "Puca sao lại chạy đến nơi này vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450102,
					"content": "Tuy xung quanh chắc sẽ không xuất hiện ma vật gì, nhưng cũng không biết sẽ còn có nguy hiểm gì khác không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450103,
					"content": "Nên nếu một mình thì đừng chạy lung tung sẽ tốt hơn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450104,
					"content": "#Paimon và {M#anh}{F#chị} {NICKNAME}, em không có chạy lung tung đâu... Thật ra em đang tìm \"tín vật\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450105,
					"content": "Ấy? \"Tín vật\" của em bị mất rồi hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450106,
					"content": "Dạ... Chắc là ở chỗ lúc trước em nhặt đá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450107,
					"content": "Là chỗ lần trước bị trói, rồi không cẩn thận làm mất sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450108,
					"content": "Chắc là không sai đâu... Lúc đó do sợ quá nên em không để ý đến mấy cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450109,
					"content": "Tuy bây giờ cũng có chút sợ, nhưng \"tín vật\" rất quan trọng, bắt buộc phải tìm về mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450110,
					"content": "Ừm... Nhưng nếu một mình Puca đi tìm thì quá nguy hiểm đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, chúng ta đi đến chỗ lúc trước giúp Puca tìm lại tín vật nhé. Puca quay về trước đợi là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450112,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#Cảm ơn {M#anh}{F#chị} {NICKNAME} và Paimon! Em sẽ ngoan ngoãn ở nhà chờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450113,
					"content": "Nhân cơ hội này đi thám hiểm luôn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
