			"dialogs": [
				{
					"id": 740450601,
					"content": "Lại gặp nhau rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450602,
					"content": "Muốn biết chuyện về khoáng thạch sao? Bất kể là gì thì cũng có thể hỏi em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450603,
					"content": "Tuy là Puca cũng không chắc biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450604,
					"content": "Về những bảo thạch quý báu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "Tuy khoáng mạch xung quanh có rất nhiều viên đá lấp lánh, nhưng so với bảo thạch thật sự thì còn khác biệt rất lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450606,
					"content": "Nếu em có thể tìm thấy bảo thạch thật sự, nói không chừng có thể giống chị Sluasi sở hữu công xưởng đá quý của riêng mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450607,
					"content": "Về công dụng của khoáng thạch...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "Ấy? Puca trước giờ không nghĩ đến chuyện này... Em chỉ cảm thấy đẹp nên mới thu thập các loại đá khác nhau thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450609,
					"content": "Hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "Hihi, cảm ơn vì đã đến thăm em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
