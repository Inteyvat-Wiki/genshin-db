			"dialogs": [
				{
					"id": 740740101,
					"content": "...Đợi đã, không phải chúng ta nên chú ý là có một người đang nằm trước mắt hay sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740102,
					"content": "Ơ? Ối! Sao lại thế này...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740103,
					"content": "Xin lỗi, ban nãy tôi ưu tiên tìm tấm bia đá. Bây giờ tôi sẽ quét tầm nhìn thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740104,
					"content": "Vô cùng xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740105,
					"content": "Gì cơ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740106,
					"content": "Tuy người này còn sống, nhưng hơi thở sinh mệnh đã mất rồi. Tôi nhận ra phương pháp này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740107,
					"content": "Hic, tôi không dám nhìn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740108,
					"content": "Mau tìm người giúp đi! Không thể để đó mặc kệ được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740109,
					"content": "Cùng đưa người bị mất ý thức đến Cảng Lumidouce.\\nNgười dân ở đó mau chóng đưa đi cứu chữa.\\nSau đó mọi người mới yên lòng quay về vị trí ban đầu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "Được rồi, chúng ta cùng xem bia đá đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740111,
					"content": "\"Đây là nơi của Orthant Nguyện Vọng, Thần Điện Nguyện Vọng, Khoảng Không Nguyện Vọng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740112,
					"content": "\"Thường hay mâu thuẫn\"... \"Sinh ra trong khoảnh khắc, cùng nhau yên giấc, mãi không xa rời\"... \"Quả ô uế của tội lỗi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740113,
					"content": "Lại là câu đố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740114,
					"content": "Sao phải làm ra chuyện đáng sợ như thế ở đây chứ... Chẳng lẽ có liên quan đến đáp án ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740115,
					"content": "Vì người Fontaine là \"tội nhân\", là sinh mạng \"bị nhiễm nguyên tội\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740116,
					"content": "Bởi vậy, đáp án là \"sinh mạng\", tôi đã đoán ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740117,
					"content": "Có chắc là đáp án này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740118,
					"content": "Tôi đã quá quen với hệ thống ngôn ngữ của Hội Narzissenkreuz rồi. Nếu không có gì bất ngờ thì đáp án chính là nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740119,
					"content": "Được, vậy chúng ta tranh thủ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
