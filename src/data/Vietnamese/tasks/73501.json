			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "Haiz... Sao hôm nay vẫn là loại này chứ, rõ ràng mình chọn cái mũm mĩm nhất, tròn trịa nhất mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010102,
					"content": "Thôi vậy, để dành thêm chút tiền nữa, mình nhất định phải sưu tập đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010103,
					"content": "Hử... Mình nhớ dạo gần đây ngày nào bạn cũng đến đây mua mà? Vẫn chưa thu thập đủ sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010104,
					"content": "Tại sao bạn không mua nguyên bộ tượng gỗ Aranara đi, bên trong mỗi bộ có bảy cái không trùng nhau đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010105,
					"content": "Vậy thì còn gì là bất ngờ nữa chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010106,
					"content": "Mình không muốn bất ngờ, mình chỉ muốn có đủ loại thôi, đó mới là thể hiện của sự quan tâm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010107,
					"content": "Hôm nay mình đã để dành đủ tiền nên đến đây mua một bộ tượng gỗ rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010108,
					"content": "À, xin lỗi cháu nhé, bộ chú vừa bán cho Qasit là bộ cuối cùng, lượng hàng trong tiệm hôm nay đã bán hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010128,
					"content": "Chú đang tuyển thợ điêu khắc mới, ngày mai hẵng đến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010109,
					"content": "Dạ... Vậy ngày mai cháu lại đến. Khoan đã, sao chú có thể gọi tượng gỗ Aranara là hàng hóa chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010110,
					"content": "Đúng đó đúng đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010111,
					"content": "Được được được, là chú sai, là chú sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010112,
					"content": "Xin lỗi, tượng gỗ Aranara của tiệm hôm nay đã bán hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010113,
					"content": "Bán hết rồi sao? Vậy phải làm sao đây... cháu còn định mua mấy cái để tặng cho em họ ngày mai đến chơi nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010114,
					"content": "Thế này nhé, bạn nhỏ, chú nhớ nhà cháu ở gần nhà Razi đúng không? Sáng sớm ngày mai chú sẽ đem tượng mới khắc xong đến nhà cháu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010115,
					"content": "Cảm ơn chú Fayez! Chú không được quên đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010116,
					"content": "Không đâu, từ trước đến giờ Xưởng Acara đều không bao giờ phụ sự mong đợi của các bạn nhỏ cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010117,
					"content": "Ôi, lại có khách đến rồi. Xin lỗi, tượng gỗ Aranara của bổn tiệm hôm nay đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010118,
					"content": "Thì ra là các bạn, cảm ơn sự giúp đỡ của các bạn. Vốn dĩ chúng tôi muốn đến tận nơi để cảm ơn, nhưng như các bạn thấy đó, dạo này thật sự quá bận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010119,
					"content": "Nếu không có các bạn thì ngày kỷ niệm 20 năm thành lập Xưởng Acara có lẽ sẽ là bộ dạng khác rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010120,
					"content": "Có vẻ như công việc buôn bán đang rất tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "Aranara thật sự rất được yêu thích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "Tất cả đều nhờ vào Razi cả, không ngờ còn nhỏ mà lại có ý tưởng hay ho như vậy rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010123,
					"content": "Đúng rồi, để cảm ơn, bổn tiệm còn định tặng \"Aranara Nguyên Mẫu\" cho các bạn làm kỷ niệm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010124,
					"content": "Ối, đây là cái gì vậy... Trông rất... rất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010125,
					"content": "Sốc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "Đúng đúng đúng, sốc, trông rất sốc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010127,
					"content": "Hmm, để chúng tôi suy nghĩ lại xem rốt cuộc có nên nhận món quà này không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010129,
					"content": "Khó khăn của Xưởng Acara đã được giải quyết. Đối tượng thăm hỏi tiếp theo chính là Tanger và Razi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
