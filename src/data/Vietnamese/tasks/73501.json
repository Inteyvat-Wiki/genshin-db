			"dialogs": [
				{
					"id": 735010301,
					"content": "Aranara cha phạm sai lầm, chủ động nhận lỗi, và được Aranara con tha thứ sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010302
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010302,
					"content": "Ừm, con nghĩ các bạn nhỏ sẽ thích câu chuyện này, nhưng lý do Aranara cha chủ động nhận sai hình như đơn giản quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010303
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010303,
					"content": "Có nên thêm thắt tình tiết cha con Aranara cùng đối mặt với khó khăn nào đó không? Như vậy họ mới hiểu nhau, Aranara cha nhìn thấy sự cố gắng của con cũng sẽ cảm thấy có lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010304
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010304,
					"content": "Vậy thì, khi Aranara cha cảm thấy có lỗi thì nói chuyện nhanh hơn hay chậm hơn đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010305
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010305,
					"content": "Cái này phụ thuộc vào Aranara con rồi, tốc độ nói chuyện khác nhau sẽ thú vị hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010306
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010306,
					"content": "Anh Tanger, Razi, xin chào! Hai người đang làm gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010307,
					"content": "Ưm, em và bố đang thảo luận về nội dung câu chuyện mới, lần này, em sẽ là người kể chuyện cho mọi người nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010308
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010308,
					"content": "Nhưng hễ nghĩ đến việc phải kể chuyện trước mặt rất nhiều người thì em vẫn hơi hồi hộp, nên muốn biết xem cần chú ý những gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010309
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010309,
					"content": "Ồ! Sumeru lại sắp có thêm một tác giả truyện cổ tích nhỏ tuổi sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010310,
					"content": "Cảm ơn các bạn, nếu các bạn không xuất hiện kịp thời thì e là Razi sẽ bỏ tôi đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010311
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010311,
					"content": "Tuyệt vời, có vẻ như tất cả vấn đề đều đã được giải quyết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010312,
					"content": "Nhưng mà đột nhiên tôi nghĩ ra, có một chuyện vẫn rất khả nghi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010313,
					"content": "Hở? Là chuyện gì? Có cần tôi giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010314
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010314,
					"content": "Tại sao trong hốc cây ở Rừng Avidya lại có mảnh giấy của người Mondstadt để lại vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010315,
					"content": "Tại... Tại sao đến bây giờ mà vẫn còn suy nghĩ chuyện này chứ, tôi nghĩ chỉ là trùng hợp, trùng hợp thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010316
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010316,
					"content": "Viết bí mật ra giấy rồi dán vào hốc cây cũng là một thói quen thường thấy mà. Tôi thấy chuyện này không có gì phải để ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010317,
						735010318
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010317,
					"content": "Collei đột nhiên kích động quá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010319
					]
				},
				{
					"id": 735010319,
					"content": "Hic... Huhuhu... Được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010320
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010320,
					"content": "Thật ra, về thân phận của người Mondstadt, tôi đã có chút manh mối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010321
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010321,
					"content": "Sau này có cơ hội, tôi chắc chắn sẽ nói cho các bạn biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010322,
						735010323
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010322,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010323,
					"content": "Rất mong chờ ngày đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010318,
					"content": "Rất thường thấy thật sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010319
					]
				}
