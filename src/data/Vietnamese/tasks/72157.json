				},
				{
					"id": 721570102,
					"content": "Chà, quả nhiên không đơn giản như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570103,
					"content": "Thử tìm xung quanh xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721570104
					]
				},
				{
					"id": 721570104,
					"content": "Hết cách rồi, chúng ta tìm thử xung quanh xem có tìm ra manh mối gì liên quan không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570105,
					"content": "Ở đây rộng lớn như vậy, biết tìm tới khi nào đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570106,
					"content": "Ha ha, vậy thì phải xem vận may của chúng ta rồi, tóm lại hãy bắt đầu tìm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570107,
					"content": "Xem ra...\"làm thế nào tìm thấy Trấn Thạch\" cũng là một trong các vấn đề phải giải quyết khi chúng ta muốn phong ấn Trấn Thạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570108
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570108,
					"content": "Hy vọng manh mối giải quyết vấn đề này ở ngay xung quanh đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570109
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570109,
					"content": "Taisuke, đừng lãng phí thời gian nữa, mau hành động đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570110
					],
					"speakerTitle": "Etsuko"
				},
				{
