			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "Đã ghi lại rất nhiều bức tranh rồi. Nếu liên kết chúng lại có thể sẽ hiểu được thông tin trên đó.",
					"roleType": "TALK_ROLE_NPC",
