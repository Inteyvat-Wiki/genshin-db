			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "Ừm, nội dung của những bức tranh này cũng không khó hiểu lắm. Tuy là chúng ta không biết thứ tự chính xác, nhưng mà đọc hiểu từng bức tranh thì hẳn cũng không phải vấn đề lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040402,
					"content": "Đầu tiên là bức tranh này, trên đó có ghi lại thông tin về một nhóm người gặp nạn trên biển.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040403,
					"content": "Sau khi gặp nạn thì có lẽ họ đã lưu lạc đến hòn đảo mà bạn tìm được bức tranh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040404,
					"content": "Sau đó, họ đã sống trên hòn đảo này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040405,
					"content": "Chúng ta xem tiếp bức tranh này đi, trong đó có mô tả năm vật thể, và bên trong năm vật thể đó đều có ký hiệu khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040406,
					"content": "Giống như năm cái ly có đựng nước vậy, với lại lượng nước trong mỗi ly cũng khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040407,
					"content": "Thông thường mà nói, cách mô tả này thực ra là đang ám chỉ sự thay đổi trạng thái của điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040414,
					"content": "Sự vật thay đổi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "Nhưng cụ thể là gì thì tôi không thể phán đoán được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040409,
					"content": "Nhưng mà, nếu như đây là một hòn đảo trên biển, thì điều này không chừng là ám chỉ \"nước biển\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040410,
					"content": "Chúng ta xem tiếp nhé, đến bức này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040411,
					"content": "Sau một vụ tai nạn biển nữa thì hòn đảo này đã đón nhận thêm những \"vị khách\" mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040412,
					"content": "Bạn xem, đây hẳn là nhóm người đầu tiên đang muốn cứu nhóm người thứ hai, hơn nữa, bạn xem chiếc thuyền gãy được mô tả ở đây xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040413,
					"content": "Ở bức tranh đầu tiên, thuyền chỉ là một thứ dùng để ám chỉ hoàn cảnh của họ, nhưng ở bức này đã mô tả rất chi tiết về con thuyền gãy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040416,
					"content": "Có thể con thuyền gãy này đối với những người lưu lạc trên đảo hoang mà nói có ý nghĩa rất đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040417,
					"content": "Sau cùng chính là bức tranh này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040418,
					"content": "Ở bức tranh này, các bạn có lẽ đã phát hiện được, ngọn núi trong bức tranh có một ký hiệu đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040419,
					"content": "Tôi nghĩ, đối với nhóm người đó mà nói, vị trí này có lẽ có ý nghĩa quan trọng gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040422,
					"content": "Cuối cùng chính là bức tranh này, rất rõ ràng, họ đã tìm ra được cách để thoát khỏi hòn đảo này, rồi sau đó rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790040423,
					"content": "Đây chính là câu chuyện được mô tả trong những bức tranh này .",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
