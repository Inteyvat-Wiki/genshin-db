					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041213,
					"content": "Vậy chúng ta đừng chần chừ nữa, mau đưa những bức tranh đó cho tôi xem thử.",
