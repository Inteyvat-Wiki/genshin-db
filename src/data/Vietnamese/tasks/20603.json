			"dialogs": [
				{
					"id": 206030501,
					"content": "Các bạn nhanh như vậy đã trở lại rồi à, có vẻ như không có chuyện gì lớn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030502,
					"content": "Vẫn còn rất nhiều ma vật đang hoạt động...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "Cái gì? Vẫn còn ma vật xuất hiện, số lượng còn nhiều hơn lúc ban đầu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030504,
					"content": "Lạ thật, phần lớn lực lượng tấn công thành Mondstadt đều đã bị tiêu diệt, tại sao chúng vẫn còn xuất hiện gần thành Mondstadt nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030505,
					"content": "Lẽ nào chúng còn có kế hoạch gì khác... Không được, tôi phải triệu tập các Nhà Mạo Hiểm quay trở lại, phân bổ lại uỷ thác, không được xem nhẹ đám ma vật này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030506,
					"content": "Tiến hành điều tra bí mật đối với những ma vật xuất hiện ngoài thành, đây là lĩnh vực chuyên môn của Hiệp Hội Nhà Mạo Hiểm... đã đến lúc thể hiện sức mạnh của Hiệp Hội Nhà Mạo Hiểm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030507,
					"content": "Phải rồi, đây là quà cảm ơn, hãy nhận lấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
