			"dialogs": [
				{
					"id": 250360101,
					"content": "...Quả nhiên câu hỏi này vẫn quá đơn giản nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "#Ồ. Thật ngại quá, lúc nãy tôi đang suy nghĩ nên không để ý {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Xin chào. Tôi là Keita của \"Chủ Nhân Gió Đêm\", đang ở đây để học việc, phụ trách quản lý tài liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "Anh đang suy nghĩ chuyện gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "À... Chỉ là một số câu hỏi đơn giản về quá khứ, hiện tại và tương lai của Natlan thôi. Không đáng nhắc đến đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "#Xem ra {F#cô}{M#cậu} là một nhà lữ hành đến từ phương xa nhỉ. Tôi có thể cảm nhận được {F#cô}{M#cậu} đã quen biết rất nhiều người, kiến thức cũng rất rộng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "#Nếu {F#cô}{M#cậu} đồng ý, có thể thử trải nghiệm một số câu hỏi đã được ghi lại trong sổ tay của tôi không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "#Đáp án của những câu hỏi này nằm trong hành trình của {F#cô}{M#cậu}... Dù là quá khứ, hiện tại hay tương lai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
		},
