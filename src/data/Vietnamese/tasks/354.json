			"dialogs": [
				{
					"id": 3540401,
					"content": "Mong Phong Thần bảo vệ bạn, người lạ mặt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540402,
					"content": "Tôi là Kỵ Sĩ Trinh Thám Đội Kỵ Sĩ Tây Phong, Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540403,
					"content": "Bạn không phải người dân Mondstadt phải không? Vậy thì, vui lòng báo cáo thân phận của mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540404,
					"content": "Bình tĩnh chút, chúng tôi không phải người khả nghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540405,
					"content": "Những người khả nghi đều nói như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540406,
					"content": "#Xin chào, tôi là {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "...Nghe không giống người ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540408,
					"content": "Còn đây là... vật may mắn, lại là thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540409,
					"content": "Là bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "Ừ, tuy chỉ là bạn đồng hành mới quen hai tháng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540411,
					"content": "Nhưng đã là người bạn tốt nhất rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540414,
					"content": "Tóm lại, là Nhà Lữ Hành phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540415,
					"content": "Gần đây có con rồng lớn xuất hiện xung quanh Mondstadt, tốt nhất các bạn nên vào thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540416,
					"content": "Ở đây cách Mondstadt không xa, hãy để Kỵ Sĩ tôi hộ tống các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540417,
					"content": "Í? Cô ra ngoài thành không có nhiệm vụ nào khác à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540418,
					"content": "Tất nhiên là có, nhưng yên tâm, trên đường làm nhiệm vụ cũng sẽ đảm bảo sự an toàn của các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540419,
					"content": "Hơn nữa... Tôi cũng không thể mặc kệ người khả nghi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540420,
					"content": "Xem ra cô không tin tưởng chúng tôi cho lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "À... thất lễ rồi, đây không phải cách nói chuyện mà một Kỵ Sĩ ưu tú nên có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540423,
					"content": "Tôi xin lỗi các bạn, um... người lữ khách lạ mặt và đáng kính.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540424,
					"content": "Cách nói thật miễn cưỡng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540425,
					"content": "Bạn có gì bất mãn với cách sử dụng từ ngữ trong \"Sổ tay hướng dẫn Đội Kỵ Sĩ\" của chúng tôi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540421,
					"content": "Cách xưng hô này không được lịch sự với khách.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "Là thực phẩm dự trữ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "Hoàn toàn sai! Tại sao còn không bằng vật may mắn nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
