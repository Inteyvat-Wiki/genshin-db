			"trigger": {
				"objectNames": [
					"Sukhovykh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "Làm phiền một chút! Tôi có chuyện muốn hỏi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010102,
					"content": "Đưa cho hai Ratnik xem vật đã nhận được trước đó, và kể lại chuyện đã cùng chiến đấu với người lạ mặt mặc trang phục Người Giữ Đèn để đẩy lùi Cuộc Săn Hoang Dã...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "Lẽ nào là Sigurd sao? Anh ấy... đến bây giờ vẫn không thể yên nghỉ sao. Nếu tôi có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "Lushne"
				},
				{
					"id": 760010104,
					"content": "Đừng nói vậy, đây không phải là trách nhiệm của một mình anh. Chừng nào Cuộc Săn Hoang Dã vẫn còn tồn tại thì anh ấy sẽ không ngừng chiến đấu... Điều chúng ta có thể làm chỉ là cố gắng hết sức để hoàn thành sứ mệnh của mình thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010105,
					"content": "Vậy... Sigurd cũng từng là một Người Giữ Đèn, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010106,
					"content": "Đúng vậy, anh ấy là một Starshyna vĩ đại. Khi Cuộc Săn Hoang Dã càn quét Nod-Krai, anh ấy đã dũng cảm chiến đấu đến giây phút cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010107,
					"content": "Nghe nói khi chuông báo động vang lên, ma vật đã mất đi lý trí sẽ kinh hãi, không dám tùy tiện tiến lên... Không ngờ di vật của anh ấy lại được hai vị tìm thấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010108,
					"content": "Nếu có thể, hai vị hãy mang di vật đến trước mộ của anh ấy ở di tích chiến trường phía đông Đảo Lempo nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010109,
					"content": "Cứ yên tâm giao cho chúng tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "Cảm ơn. Mong rằng ngày linh hồn anh ấy được yên nghỉ sẽ sớm đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sukhovykh"
				}
			]
		},
