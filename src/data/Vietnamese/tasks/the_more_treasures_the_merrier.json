						2005910002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910002,
					"content": "Quý khách thật là có mắt nhìn, vừa nhìn một cái đã nhìn trúng món đồ tốt nhất trong tiệm của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910003,
					"content": "Đây là chiến lợi phẩm mà Nhà Lữ Hành đây vừa lấy được từ thủ lĩnh Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910004,
					"content": "Hilichurl đáng sợ, không biết đã gây hại cho Mondstadt bao lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910005,
					"content": "Cũng coi như Nhà Lữ Hành đã trải qua một trận khổ chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910006,
					"content": "Đúng, đúng là Hilichurl không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910007,
					"content": "...Nếu như tôi cầm thứ này đưa cho ngài Cyrus, hoặc là ngài Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910008,
					"content": "Họ có lẽ sẽ có cách nhìn khác về tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910009,
					"content": "Đúng vậy quý khách, đừng lo lắng, tiệm chúng tôi sẽ tuyệt đối bảo mật cho khách hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910010,
					"content": "Đừng do dự nữa quý khách, món đồ này rất hiếm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910011,
					"content": "Tôi đang nghĩ... Nhà Lữ Hành, cô nói thật ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
