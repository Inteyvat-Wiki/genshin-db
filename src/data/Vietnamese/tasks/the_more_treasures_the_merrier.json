				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "Không ổn rồi, phải làm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "Nhà Lữ Hành! Bạn đến thật đúng lúc! Bạn biết không, đây là cửa tiệm lưu niệm mà nhà tôi mở.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590104,
					"content": "Trước kia, bố tôi sẽ mua những chiến lợi phẩm mà các Nhà Mạo Hiểm đem đến, sau đó đem bán ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590105,
					"content": "Thế nhưng từ khi Hiệp Hội Nhà Mạo Hiểm... Không còn náo nhiệt như trước, những đồ vật mà tôi có thể thu mua được ngày càng ít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590106,
					"content": "Hơn nữa lại là những thứ không đáng tiền, chả có khách nào muốn mua nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590107,
					"content": "Nhà Lữ Hành, bạn đi mạo hiểm khắp nơi phải không? Có thể giúp tôi tìm một vài chiến lợi phẩm đáng giá được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590108,
					"content": "Tôi hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "Vậy phiền bạn rồi! Sau khi tìm thấy, tôi nhất định sẽ mua may bán đắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590110,
					"content": "Paimon thực ra thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "Xin lỗi, chắc chẳng ai mua đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590112,
					"content": "Bởi vì... Chắc chắn sẽ tự chạy mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
