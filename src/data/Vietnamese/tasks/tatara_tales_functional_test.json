				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "Ấy! Nhà Lữ Hành, tôi cảm thấy...mọi việc có vẻ không ổn lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190102,
					"content": "Fatui bên trong đột nhiên tụ hợp lại gần hạt nhân, hình như là đã phát hiện ra điều gì đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190103,
					"content": "Chúng sẽ không thật sự có thể phá hỏng phòng ngự của hạt nhân đâu nhỉ...Không được, chúng ta không thể kéo dài thêm nữa, phải nhanh chóng bắt đầu tiến hành thử nghiệm chức năng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190104,
					"content": "Thử nghiệm chức năng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "Chính là thử nghiệm một chút chức năng thanh tẩy của đồng đội mới này, tôi không muốn sau khi chuyển nó đến lại phát hiện nó không thể hoạt động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190106,
					"content": "Vì vậy, tôi muốn nhờ bạn giúp tôi tìm 3 con \"Onikabuto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190107,
					"content": "Tôi muốn đặt chúng xung quanh Lò Luyện Mikage để chúng nhiễm Họa Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190108,
					"content": "Sau đó lấy chúng ra, dùng thiết bị thanh tẩy thử thanh tẩy Họa Thần mà chúng nhiễm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190109,
					"content": "Đây là \"thử nghiệm chức năng\" do tôi nghĩ ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190110,
					"content": "Có thể tìm \"Onikabuto\" ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "Ừm...chúng thường sống ở những khu vực tập trung nhiều nguyên tố Lôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190112,
					"content": "Tôi còn nghe nói chúng cũng có thể sống gần Lò Luyện Mikage...đúng là lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190113,
					"content": "Vậy chi bằng tôi đến thẳng Lò Luyện Mikage bắt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "Mặc dù như vậy cũng được...nhưng nếu đến Lò Luyện Mikage bắt Onikabuto để thử nghiệm thì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190115,
					"content": "Nói thật, tôi thật sự có chút lo lắng về...độ tin cậy của đồng đội mới này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190116,
					"content": "Làm thử nghiệm, tốt nhất là nên \"từng bước một\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190117,
					"content": "Tóm lại, bạn hãy bắt 3 con Onikabuto về đây, tôi sẽ ở đây chờ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190118,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "Vậy thì phiền bạn rồi, chỉ cần 3 con Onikabuto là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190120,
					"content": "Chi bằng tôi vào thẳng bên trong dạo một vòng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "Ừm...theo như thí nghiệm, bạn vào đó dạo một vòng, nhiễm đầy Họa Thần rồi đi ra, thật ra cũng có thể dùng làm đối tượng thí nghiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190122,
					"content": "Nhưng tôi nói rồi...độ tin cậy của thiết bị này...không như mong đợi cho lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190123,
					"content": "Nếu trong quá trình thanh tẩy thực sự xảy ra sự cố ngoài dự kiến nào đó, bạn có thể cũng sẽ... ừm, phải đối mặt với các vấn đề nằm ngoài dự tính...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190124,
					"content": "Tóm lại, chúng ta vẫn cứ dùng Onikabuto để thử nghiệm vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190125,
					"content": "Chỉ cần 3 con Onikabuto là được, bạn bắt được rồi thì đem đến cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
