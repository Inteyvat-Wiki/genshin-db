			},
			"dialogs": [
				{
					"id": 721830101,
					"content": "Đây là...hạt giống?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830102,
					"content": "Đây là hạt giống \"Cỏ Naku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830103,
					"content": "Bạn biết loại thực vật này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "Ừm, xem như là hiểu biết một chút đi. Ngày trước tôi từng gặp loại thực vật này, cũng từng nghe người ta kể về điểm kỳ lạ của nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830105,
					"content": "Tôi nhớ...dù là trong điều kiện không có gió, loại thực vật này cũng có thể khẽ rung động theo tiếng sấm sét...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830106,
					"content": "Trồng lên có đẹp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "Nếu chỉ bàn về vẻ ngoài thì...chắc là cũng khá đẹp đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830108,
					"content": "Các hạ muốn thử trồng Cỏ Naku sao? Nhưng xung quanh đều không có loại đất thích hợp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830109,
					"content": "Tôi có đất của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "Vậy...vậy sao? Thật không hổ danh...ngay cả đất phong cũng có rồi ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830111,
					"content": "Vậy dám hỏi, đất phong của bạn là ở...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830112,
					"content": "Không ở Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "Ồ! Tôi cũng từng nghe nói về chiến công của các hạ ở Mondstadt và Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830114,
					"content": "Với chiến công như vậy, được ban đất phong cũng là chuyện dễ hiểu, thật không hổ danh mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830120,
					"content": "Này, bạn nói \"đất\", chắc không phải là \"Ấm Trần Ca\" mà trước kia bà bà cho chúng ta chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830121,
					"content": "Bên trong đó thật sự có thể trồng trọt ư? Ngày trước bà bà cũng chưa từng nhắc đến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830122,
					"content": "Về hỏi thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "Được thôi, chúng ta về hỏi bà bà xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830124,
					"content": "Tiên nhân mạnh lắm đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "Vậy...vậy sao? Nhưng bà bà quả thực rất mạnh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830126,
					"content": "Được thôi, chúng ta về hỏi bà bà xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830115,
					"content": "Trong một chiếc ấm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "Một...chiếc ấm? Các hạ đừng đùa tôi nữa mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830117,
					"content": "Tôi cũng từng nghe nói về chiến công của các hạ ở Mondstadt và Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830118,
					"content": "Đất phong của bạn không ở Liyue thì là ở Mondstadt nhỉ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830119,
					"content": "Ấy, thật không hổ danh là bạn mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				}
			]
		},
		{
			"id": 7218302,
			"completionStepIds": [
				7218302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
