			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bình Lão Lão"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "Ấy? Sao các cháu lại đến tìm ta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830202,
					"content": "Về hạt giống \"Cỏ Naku\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "Hạt giống...À, cháu muốn trồng nó trong Ấm Trần Ca à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830204,
					"content": "Việc này cũng không phải không thể, dù sao đó cũng là một vùng đất mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830205,
					"content": "Chỉ có điều, hôm nay các cháu chỉ cầm một túi hạt giống đến, lẽ nào các cháu chỉ định trồng một túi hạt giống này à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830206,
					"content": "Đúng...đúng vậy! Tụi cháu cũng không biết thu thập hạt giống như thế nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830207,
					"content": "Sau khi trồng xong túi hạt giống này, tụi cháu biết đi đâu tìm hạt giống khác đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830208,
					"content": "Được rồi, được rồi, đừng vội. Chỗ ta vừa khéo có một chiếc hộp nhỏ mà ta từng dùng từ rất nhiều năm trước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830209,
					"content": "Ngày trước khi trồng hoa cỏ, ta đều đựng vào chiếc hộp này, hoa đựng trong hộp có thể lưu giữ rất lâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830210,
					"content": "Hơn nữa, sau khi đựng hoa vào hộp, chiếc hộp này còn có thể biến ra vài hạt giống...Như vậy, muốn trồng trọt cũng rất tiện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830211,
					"content": "Mặc dù chiếc hộp này hiện giờ không còn hữu dụng lắm...Nhưng ít nhất nó vẫn giữ được tính năng \"chuyển hoá hạt giống\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830212,
					"content": "Ừm...Dù sao bà lão như ta bây giờ cũng chẳng dùng gì đến chiếc hộp này...Vậy thì tặng nó cho các cháu nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830213,
					"content": "Các cháu muốn trồng loại hoa cỏ nào, hay là muốn trồng một số loại cây, chiếc hộp này chắc sẽ có ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830214,
					"content": "Cảm ơn bà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "Cảm ơn bà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830216,
					"content": "Ha ha, không cần khách sáo như vậy, mau đi thử xem sao, nhưng chăm bón hoa cỏ không phải chuyện đơn giản, các cháu cần chuẩn bị tâm lý sẵn sàng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "Bình Lão Lão"
				},
				{
					"id": 721830217,
					"content": "Bà bà quả nhiên rất lợi hại...nhưng trước khi thử cái hộp đó, chúng cháu vẫn nên vào trong ấm trước, trồng thử hạt giống đó xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830218,
					"content": "Ừm, hy vọng hạt giống này sẽ lớn nhanh như thổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}