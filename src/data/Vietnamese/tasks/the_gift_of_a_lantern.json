			"trigger": {
				"objectNames": [
					"Xiaobai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "Xin chào Nhà Lữ Hành. Lần trước cám ơn bạn nhé, đã lâu rồi Khinh Sách Trang không náo nhiệt như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180102,
					"content": "Đừng khách sáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "Năm trước chỉ có tôi và Zhi, cùng lắm chỉ có thể làm vài cái Đèn Tiêu cho bọn trẻ, nói vài câu với ông bà cụ, rồi làm vài món ngon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180104,
					"content": "Lần này nhờ bạn mới được thấy một Tết Hải Đăng sôi động như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180105,
					"content": "Nhưng náo nhiệt thì náo nhiệt, tôi vẫn muốn đi thăm người già trong làng một chút. Hôm nay tôi chuẩn bị đi thăm Jiangcheng gia gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180106,
					"content": "Nếu bạn đồng ý thì cùng đến nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180107,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "Ừm, vậy chúng ta đến chỗ Jiangcheng gia gia trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
