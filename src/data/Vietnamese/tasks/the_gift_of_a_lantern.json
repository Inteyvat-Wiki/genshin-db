			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "Bà nó về rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180202,
					"content": "Xin lỗi, ông nhận nhầm người rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "Haiz, tôi chưa đến mức lẩm cẩm đâu, sao mà nhận nhầm bà được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180204,
					"content": "Vừa nãy tôi còn nhắc đến bà đó, bà xem, tết này có phải nên mua cho con gái chúng ta bộ quần áo mới không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180205,
					"content": "Ô...lần này bà còn đưa thêm ai về à...có phải là thợ may không? Chúng ta lại có cùng suy nghĩ rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180206,
					"content": "Jiangcheng gia gia, là cháu, Bé Bai đây. Hai ngày trước cháu còn tặng đậu hũ cho ông, mới đây mà đã không nhớ cháu rồi à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180207,
					"content": "A...Bé Bai...là Bé Bai hả! Nhớ chứ nhớ chứ! Mới đây thôi, cha của cháu còn khen cháu với ông nữa đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180208,
					"content": "Haiz...Đó là chuyện lúc nào rồi...Bà nó còn nhớ không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180209,
					"content": "...Còn nhớ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "Đấy! Trí nhớ của tôi sao mà kém đi được...còn có, còn có...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180212,
					"content": "Jiangcheng gia gia, ông nghỉ ngơi chút đi, đừng cố sức quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180213,
					"content": "Nhà Lữ Hành, hay là bạn giúp Jiangcheng gia gia dọn dẹp nhà cửa trước đi, tôi trò chuyện với ông một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180214,
					"content": "Cứ để tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "Vậy phiền bạn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180210,
					"content": "Đương nhiên nhớ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
