				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "Chà... bà nó, bà cũng tới chuyện phiếm vài câu với bé Bai đi... Tay nghề của bố con bé giỏi như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180302,
					"content": "Đậu hũ này bán cho Liyue đó, ngon số một đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180303,
					"content": "Ồ, Bé Bai à, cháu tới nấu món gì vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180304,
					"content": "Đến tặng Đèn Tiêu sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "Đèn Tiêu... A... Là Đèn Tiêu... Ái chà, năm nào cũng phiền cháu rồi, bé Bai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180306,
					"content": "Bà nó còn nhớ không, tay nghề làm Đèn Tiêu của tôi lúc trước cũng khá lắm, ai cũng nhờ tôi làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180307,
					"content": "Tết Hải Đăng mỗi năm, số Đèn Tiêu đó, cái nào cũng đẹp...bà chờ chút, tôi đi treo Đèn Tiêu cho bà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180308,
					"content": "Để cháu treo Đèn Tiêu cho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "Ừm cũng được, cẩn thận coi chừng vấp ngã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				}
			]
		},
