			"dialogs": [
				{
					"id": 718180401,
					"content": "Treo đèn xong rồi sao? Đẹp, đẹp lắm, năm sau chắc chắn lại là một năm tốt đẹp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180402,
					"content": "Nhất định rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "Jiangcheng gia gia, chúng cháu vẫn còn việc phải làm, sau này sẽ đến thăm ông nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180405,
					"content": "Được, được, còn trẻ mà, có rất nhiều chuyện phải làm, rất bận rộn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180406,
					"content": "Tạm biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "Này, bà nó...Đừng quên xem chừng đất nhà chúng ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180403,
					"content": "Chắc chắn là vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
