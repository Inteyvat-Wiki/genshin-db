			"dialogs": [
				{
					"id": 718180501,
					"content": "Ban nãy cám ơn nhiều nhé, nếu tôi đi một mình chắc sẽ bận đến luống cuống mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180502,
					"content": "Tôi cũng không muốn để Jiangcheng gia gia cứ một thân một mình ăn tết như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180503,
					"content": "Vậy còn bạn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "Ừm... lát nữa tôi cũng về sắp xếp việc ở xưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180505,
					"content": "Xưởng xay bột đó là bố tôi để lại, sau khi bố qua đời, tôi đã từ bỏ công việc ở Liyue, trở về kế thừa xưởng và kỹ thuật của bố.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180506,
					"content": "Nói sao nhỉ, làm việc giống như bố đã làm, trong khung cảnh giống như bố lúc xưa, khiến tôi nhớ lại rất nhiều chuyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180507,
					"content": "Đặc biệt là vào Tết Hải Đăng, tôi luôn nhớ đến cha tôi từng nói rất nhiều chuyện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180508,
					"content": "A đúng rồi, chỉ lo làm Đèn Tiêu cho Jiangcheng gia gia mà quên mất, tôi phải làm một chiếc cho tôi mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180509,
					"content": "Nhưng mà nguyên liệu đã dùng hết rồi, chẳng chừa lại chút nào cho mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180510
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180510,
					"content": "Bây giờ đi thu gom nguyên liệu chắc không kịp nữa...Nhà Lữ Hành có thể giúp tôi thu gom nguyên liệu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180511
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180511,
					"content": "Tôi biết rồi.",
