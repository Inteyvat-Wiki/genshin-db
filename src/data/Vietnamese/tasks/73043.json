			"dialogs": [
				{
					"id": 730430101,
					"content": "#A, xin chào! {NICKNAME} và Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730430102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730430102,
					"content": "Haha... Các cháu lại tới rồi. À phải rồi, cái này dành cho cháu, các cháu đừng quên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730430103
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730430103,
					"content": "Tuy ta đã không thể nào gặp lại những người bạn xưa được nữa, nhưng có thể nhìn thấy khu rừng này tràn trề sức sống thì ta cũng rất mãn nguyện rồi. Một lần nữa xin cảm ơn các cháu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730430104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730430104,
					"content": "À, đúng rồi, các cháu nhất định phải nhận lấy cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730430105
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730430105,
					"content": "Xin các cháu đừng quên ý nguyện ban đầu của \"Javan\".",
