			"dialogs": [
				{
					"id": 730670601,
					"content": "Chính là thứ này! Chính là thứ này!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "Đây là \"Bùa Hộ Mệnh Dũng Khí\" của Arashakun, rời khỏi Arashakun có mấy ngày thôi mà màu của hoa cũng nhạt đi một chút rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "Nhưng không sao, sau này Arashakun sẽ giữ gìn nó thật tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "\"Arashakun là một Aranara tốt và dũng cảm! Không phải là Aranara nhát gan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#Thật sự rất cảm ơn bạn, Nara {NICKNAME} và Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "Arashakun hiện giờ chính là Arashakun đã tìm được \"dũng khí\", không thứ gì có thể ngăn cản tôi. \"Ma Vương Mặt Nạ Lông Lá\" cũng chỉ là một kẻ bại trận dưới tay Arashakun thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(Woa, cảm giác giọng điệu khác hẳn lúc trước.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#\"Ma Vương Mặt Nạ Lông Lá\" làm nhiều chuyện ác, Nara {NICKNAME} và Paimon, xin hãy đi với tôi, có sự giúp đỡ của hai người thì chúng ta nhất định sẽ xử lý được chúng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
