				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "Bạn chính là Arashakun à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670402,
					"content": "Huhu... Arashakun đúng là tên của tôi. Ối, đừng bất thình lình tới gần như thế chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670403,
					"content": "Mặc dù rất biết ơn hai người đã cứu tôi thoát khỏi nguy hiểm, nhưng, nhưng Arashakun mong hai người có thể giữ khoảng cách nhất định... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670404,
					"content": "Làm vậy thì Arashakun mới thấy yên tâm hơn một chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670405,
					"content": "Gì vậy, rõ ràng vừa nãy chúng tôi đã cứu bạn ra ngoài đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670406,
					"content": "Á, xin lỗi xin lỗi, là yêu cầu của Arashakun rất quá đáng... mới khiến bạn tức giận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670407,
					"content": "Nhưng Arashakun bị vây ở đây, vẫn chưa bình tĩnh lại, huhu, nếu có chỗ nào không đúng thì mong hai người có thể tha thứ cho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670408,
					"content": "Không sao mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670409,
					"content": "Vậy thì tốt, vậy thì tốt, không biết Arashakun có thể biết tên hai người không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670410,
					"content": "Tôi tên là Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670411,
					"content": "#Tôi là {NICKNAME}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#Huhu, Nara {NICKNAME} Vàng và Paimon, ừm... sao lại biết tên của Arashakun thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670413,
					"content": "Chúng tôi đã đọc nhật ký trong phòng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#Nara {NICKNAME} Vàng đã đọc nhật ký, tiện thể tìm tung tích của Arashakun, lại giải vây giúp Arashakun, thật là một Nara vừa tốt bụng vừa lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670415,
					"content": "Huhu... Nếu như Arashakun không bị mất đi \"dũng khí\" thì sẽ không bị vây như vừa rồi đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670416,
					"content": "Đúng nhỉ, lúc trước tôi cũng đã đọc được trong nhật ký rồi, Arashakun, bạn bảo mình đã mất \"dũng khí\" là có ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670417,
					"content": "Đó là chuyện rất lâu về trước rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670418,
					"content": "Nhiều lần mặt trăng trước, Arashakun là một Arashakun không có \"dũng khí\" giống như bây giờ... Lúc đó, dù là tiếng cành cây nứt gãy cũng khiến Arashakun mất ngủ cả đêm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670419,
					"content": "Nhưng mà... mặc dù là Arashakun nhút nhát thì cũng có một Nara chịu làm bạn với Arashakun, tuy người bạn Nara không phải là Nara Varuna vĩ đại, nhưng cũng là một Nara rất tốt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670420,
					"content": "Anh ấy chưa từng vì chuyện Arashakun nhút nhát mà cố tình trêu chọc cả, lúc Arashakun sợ hãi sẽ chủ động nắm lấy tay Arashakun... Là người bạn mà Arashakun sẽ không bao giờ quên được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670421,
					"content": "Nhưng một ngày nọ, Nara đó đã bị \"Ma Vương Mặt Nạ Lông Lá\" bắt đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670422,
					"content": "Khoan đã, \"Ma Vương Mặt Nạ Lông Lá\" là gì thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670423,
					"content": "\"Ma Vương Mặt Nạ Lông Lá\" chính là ma vương, đeo mặt nạ, mặt đầy lông?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670424,
					"content": "...Đúng, đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670425,
					"content": "Paimon có biết nó là gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "Biết được mới lạ đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670429,
					"content": "Tóm lại, chính \"Ma Vương Mặt Nạ Lông Lá\" đó đã bắt bạn của Arashakun đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670430,
					"content": "...\"Ma Vương Mặt Nạ Lông Lá\" rất nham hiểm xảo quyệt, vừa nghĩ tới đây, toàn thân Arashakun lại bắt đầu run lên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670431,
					"content": "...Huhu, lúc người bạn Nara của Arashakun bị bắt đi, Arashakun rất sợ hãi, tuy rằng Arashakun sợ bị \"Ma Vương Mặt Nạ Lông Lá\" đánh, nhưng càng sợ không được nhìn thấy người bạn Nara hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670432,
					"content": "Cho nên Arashakun rất cố gắng, nhắm mắt lại! Cắn chặt răng! Đập tay! Thế là đã cứu được người bạn Nara của Arashakun ra ngoài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670433,
					"content": "Sau đó, người bạn Nara đã bện hoa thành \"bùa hộ mệnh dũng khí\", còn nói với Arashakun rằng, \"Arashakun là một Aranara tốt và dũng cảm! Không phải là Aranara nhát gan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670434,
					"content": "Arashakun nhờ đó mà nhận được \"dũng khí\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670435,
					"content": "Nè, nếu nói như thế thì hành động \"Nhắm mắt lại! Cắn chặt răng! Đập tay!\" chẳng phải là một hành động rất can đảm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670436,
					"content": "Không đâu, không đâu, Arashakun cũng phải sau đó mới có được \"dũng khí\" từ chỗ Nara kia mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670437,
					"content": "Nhưng bạn đã rất dũng cảm khi cứu bạn bè của mình mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670438,
					"content": "Không có không có, lúc cứu người bạn Nara, Arashakun sợ lắm, tay chân mềm nhũn ra, nhưng sau khi nhận được \"dũng khí\" thì Arashakun không còn như thế nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670439,
					"content": "Hầy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670440,
					"content": "Bùa hộ mệnh chỉ là biểu tượng thôi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#Huhu... Lời của Nara {NICKNAME} phức tạp thật, Arashakun chỉ biết rằng, \"Bùa Hộ Mệnh Dũng Khí\" còn thì Arashakun cũng sẽ có \"dũng khí\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670443,
					"content": "Lúc trước \"dũng khí\" của Arashakun bị cướp mất rồi, cho nên tôi mới muốn đến hang động của \"Ma Vương Mặt Nạ Lông Lá\" lén tìm thử xem sao, mong rằng có thể tìm được \"dũng khí\" của Arashakun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670444,
					"content": "Kết quả lại bị mấy con Slime bao vây ở trong hang động... May mà vẫn chưa bị \"Ma Vương Mặt Nạ Lông Lá\" gì đó phát hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670445,
					"content": "#Ah, nói đến việc này, {NICKNAME}, còn nhớ thứ chúng ta nhặt được từ chỗ Hilichurl không... Không lẽ đó là bùa hộ mệnh của Arashakun à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670446,
					"content": "Arashakun, có thể chúng tôi đã nhặt được \"dũng khí\" của bạn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670447,
					"content": "#Thật sao! Nara {NICKNAME} và Paimon, thật sự đã nhặt được \"dũng khí\" của Arashakun sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670441,
					"content": "Lòng dũng cảm vốn đã tồn tại sẵn trong trái tim của Arashakun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Là đáp án mang phong cách Aranara nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Phải đó, hoàn toàn không đoán ra được \"Ma Vương Mặt Nạ Lông Lá\" là gì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				}
			]
		},
