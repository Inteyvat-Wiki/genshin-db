				"points": []
			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "Ơ, hình như đám Hilichurl đã làm rơi ra một thứ kỳ lạ này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670102,
					"content": "Trông nó như được kết bằng hoa. Lạ thật, rõ ràng chỉ là một bông hoa bình thường đã bị hái xuống từ rất lâu rồi... nhưng nó vẫn chưa bị hư nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670103,
					"content": "Phía trên có thể cảm nhận được rất nhiều nguyên tố Thảo... Hơn nữa còn bị bỏ lại ở đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670104,
					"content": "Chắc chắn là của Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "Ừm, nhất định là thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670108,
					"content": "Ừm, phía trên món đồ này có nhiều nguyên tố Thảo ghê, đến cả ở trong tay Hilichurl cũng không bị khô héo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670109,
					"content": "Có lẽ vẫn luôn mang theo bên người...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "Ừm, hay là chúng ta mang thứ này về cho Aranara đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670112,
					"content": "#Chúng ta vào nhà xem thử đi, {NICKNAME}, có khi Aranara làm mất đồ đang than thở trong đó đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670110,
					"content": "Có lẽ là vật rất quý giá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "Là Hilichurl Nguyên Tố Thảo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "Gì vậy, nghĩ kiểu gì thì đó cũng là của Aranara đánh rơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306702,
			"completionStepIds": [
				7306705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
