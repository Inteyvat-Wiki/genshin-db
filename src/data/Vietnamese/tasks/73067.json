			"dialogs": [
				{
					"id": 730670301,
					"content": "Ừm... Arashakun chính là Aranara đã viết nhật ký này nhỉ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "Sao nét chữ trong sổ lúc cực to lúc cực nhỏ, chữ to thì không nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "Chữ nhỏ quá làm tôi nhìn nhức cả mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "Paimon cũng thấy khó chịu khi đọc chữ nhỏ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Bình thường toàn xem cỡ chữ bình thường, giờ xem chữ nhỏ thấy không quen lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Chà, chẳng lẽ Arashakun này để lại mấy trang mới nhất thì không quay lại nữa à...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Giờ chúng ta đến hang phía đông tìm thử đi, trong nhật ký viết mất đi \"dũng khí\"... \"Dũng khí\" cũng mất được sao, thật tò mò...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306704,
