			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(Vài trang trước viết bằng cỡ chữ rất nhỏ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670202,
					"content": "\"...Huhu, không ngờ lại có Nara chịu làm bạn với Arashakun, đúng là một Nara tốt, Nara tốt không chê Arashakun nhút nhát, lại dạy Arashakun viết chữ của Nara nữa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670203,
					"content": "\"...Lúc Arashakun sợ hãi vì bị lá rơi xuống đầu, Nara tốt đã an ủi Arashakun. Nara tốt mãi mãi là bạn tốt của Arashakun!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670204,
					"content": "(Trong mấy trang tiếp theo, nét chữ vừa nhỏ vừa rối mắt...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670205,
					"content": "\"...Huhu, Nara bị \"Ma Vương Mặt Nạ Lông Lá\" bắt đi rồi, \"Ma Vương Mặt Nạ Lông Lá\" tay rất dài, đáng sợ quá, đáng sợ quá...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670206,
					"content": "\"...Nhưng, nhưng phải cứu Nara mới được, huhu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670207,
					"content": "(Mấy trang sau, chữ viết rất to và dùng nhiều sức...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670208,
					"content": "\"Đã đánh bại \"Ma Vương Mặt Nạ Lông Lá\", cứu được Nara ra rồi, Nara đã tiếp thêm \"dũng khí\" cho Arashakun, Arashakun đã không còn là đứa nhát gan hồi xưa nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670209,
					"content": "\"...Sau khi Arashakun có được \"dũng khí\", đã dũng cảm chiến đấu chống lại đám \"Quái Vật Mặt Nạ Lông Lá\", Nara ở gần đó cũng không cần lo lắng bị \"Quái Vật Mặt Nạ Lông Lá\" quấy nhiễu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670210,
					"content": "(Trong những trang mới nhất lại quay về với nét chữ rất nhỏ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670211,
					"content": "\"...Huhu, sao lại thế này, \"dũng khí\" của Arashakun không còn nữa, \"dũng khí\" mà Nara tặng cho Arashakun... chắc là đã bị \"Ma Vương Mặt Nạ Lông Lá\" trộm mất rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				},
				{
					"id": 730670212,
					"content": "\"\"Ma Vương Mặt Nạ Lông Lá\" có tay dài, gian xảo đáng sợ. Nhưng Arashakun mất đi \"dũng khí\" nên không làm được gì... Hức, Arashakun phải đến <color=#00E1FFFF>hang động ở phía đông</color> tìm thử...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sổ Tay Nét Chữ Không Đều"
				}
			]
		},
