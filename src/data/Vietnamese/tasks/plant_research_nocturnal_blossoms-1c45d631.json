			"dialogs": [
				{
					"id": 762010201,
					"content": "...Chị Metta xấu tính quá, em chỉ muốn chị vui vẻ trong suốt chuyến phiêu lưu thôi mà, sao lại nói những lời gây mất hứng như vậy chứ, huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "Nếu còn không sửa cái tính nghĩ gì làm nấy đi thì người khác cũng chịu không nổi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "Đâu phải là nghĩ gì làm nấy chứ, em... em cũng có kế hoạch của riêng mình mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "Kế hoạch à... Ừm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "Lại lảng tránh nữa rồi... Em không nói chuyện với chị nữa, đến lúc đó chị có hối hận cũng không kịp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "...Á, chị Linnea! Để em kể chị nghe, chị Metta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "Nghe Vesa lắp bắp kể lại những gì trước đó, có vẻ chỉ là mâu thuẫn nhỏ thường thấy của những đứa trẻ thôi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "Dù sao cũng không phải lỗi của em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "Vậy, vậy cũng không phải lỗi của em! Chị Linnea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "Ừm... đôi khi đúng là sẽ xảy ra những chuyện như vậy đấy, rõ ràng mọi người đều không sai, nhưng kết quả lại chẳng như ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010211,
					"content": "Đúng rồi, giống như câu chuyện về hai chị em Dòng Dõi Sương Nguyệt mà Hoa Ảnh Đêm tượng trưng ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010212,
					"content": "Câu chuyện về hai chị em á?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "Ừm. Nghe nói ngày xưa có một cặp chị em sinh đôi thuộc Dòng Dõi Sương Nguyệt, tính cách hai người hoàn toàn trái ngược nhau, giống như Hoa Ảnh Đêm một đỏ một xanh vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010214,
					"content": "Hai chị em đều làm những gì mình cho là đúng, nhưng cũng chính vì thế mà họ đã đi theo hai con đường khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010215,
					"content": "Nghe nói em gái không bao giờ tha thứ cho chị gái đã bỏ rơi mình mà đi, dù sau đó người chị đã cứu sống rất nhiều người... Nhưng cuối cùng, hai người đến khi chết cũng không gặp lại nhau lần nào nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010216,
					"content": "Dòng Dõi Sương Nguyệt còn có câu chuyện như vậy sao... Em chưa nghe bao giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "Em cũng chưa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "Chị cũng chỉ nghe nhà thơ kể lại thôi, có lẽ có phần thêu dệt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010219,
					"content": "Ồ, ra là chuyện bịa đặt à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "Haiz. Dù câu chuyện có thể là hư cấu, nhưng đạo lý muốn truyền tải vẫn đúng mà phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010221,
					"content": "Không ai trong số họ nghĩ mình sai cả, đều tin tưởng tuyệt đối rằng lựa chọn của bản thân mới là đúng đắn. Nhưng chính những lựa chọn ấy đã khiến họ mất nhau mãi mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010222,
					"content": "Nếu để chứng minh mình đúng mà phải đánh mất bạn bè... thì hai đứa sẽ chọn thế nào đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "Haiz, thực ra thỉnh thoảng có vài chuyện lặt vặt nảy sinh trong lúc mạo hiểm cũng không phải quá tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "...Ừm! Nghĩ kỹ lại thì, khoảng thời gian chị Metta đồng hành cùng em đi mạo hiểm cũng rất quý giá, nếu cứ thay đổi ý kiến lung tung thì cuối cùng có khi chẳng làm được gì cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "Lần sau... lần sau em sẽ lên kế hoạch kỹ hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "Hì hì, hai đứa hòa giải với nhau là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010229,
					"content": "Sau này khi đi mạo hiểm với Vesa mà nhặt được viên đá nào lạ lạ, chúng em sẽ gửi về Speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "Được! Vậy thì cảm ơn hai đứa trước nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
