			"dialogs": [
				{
					"id": 710500801,
					"content": "Về vật kỳ lạ đặt gần nước...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "Ừm? Bạn đặt thứ đó ở gần nước rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500803,
					"content": "Thế nào, có xảy ra phản ứng gì đặc biệt không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500804,
					"content": "Xuất hiện Rồng Đất Nham...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "Rồng Đất Nham? Thứ đó đặt ở gần nước thì biến thành Rồng Đất Nham sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500806,
					"content": "À, không phải thứ đó biến thành, mà là Rồng Đất Nham nhìn thấy thứ đó thì xuất hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500807,
					"content": "Làm tôi hết hồn, nếu như thứ đó đặt vào nước mà biến thành Rồng Đất Nham, vậy thì kiến thức về thế giới của tôi xem như sụp đổ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500808,
					"content": "Thứ đó rốt cuộc là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "Nói ra cũng đơn giản, nên nói thế nào nhỉ, vậy đi, hãy để tôi đoán thử đã, con Rồng Đất Nham đó có điểm gì đặc biệt không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500810,
					"content": "Ví dụ như, thuộc tính nguyên tố đính kèm là Thủy chẳng hạn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500811,
					"content": "Hình như là vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "Vậy thì đúng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500816,
					"content": "Con Rồng Đất Nham đó chắc có thể sử dụng nguyên tố Thủy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500817,
					"content": "Nước ngầm của Vực Đá Sâu có hàm lượng nguyên tố Thủy rất cao, ở những điểm hội tụ đặc biệt còn có thể nuôi dưỡng ra vật thể dạng như thủy tảo giống như bạn câu được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500818,
					"content": "Rồng Đất Nham, đương nhiên, và cả những sinh vật thích nước sinh sống ở Vực Đá Sâu cũng vậy, sẽ dựa vào việc ăn loại tảo có hàm lượng nguyên tố Thủy phong phú này để nâng cao năng lượng của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500819,
					"content": "Cho nên thứ đó thật ra là... tảo có hàm lượng nguyên tố Thủy phong phú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500820,
					"content": "Chỉ là tảo thôi sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "Ừm, chính là tảo, nhưng mà tảo có lượng nguyên tố cao như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500822,
					"content": "Trong môi trường bình thường khó mà xuất hiện, trừ phi có năng lượng vô cùng thuần khiết và cực kỳ to lớn đã ảnh hưởng đến nguồn nước... Không nói cái này nữa, số tảo này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500823,
					"content": "Nói không chừng có một ngày sẽ sinh ra ý thức biến thành sinh vật nguyên tố, đúng là phải nghiên cứu kỹ lưỡng mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500813,
					"content": "Không nhìn thấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#Chẳng lẽ là do xử lý nhanh quá nên không để ý sao... Thật lợi hại, không hổ danh là {NICKNAME} trong truyền thuyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500815,
					"content": "Nhưng theo suy đoán của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				}
			]
		}
	]
