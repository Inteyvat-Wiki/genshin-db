			"dialogs": [
				{
					"id": 710500501,
					"content": "Về vật kỳ lạ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500502
					]
				},
				{
					"id": 710500502,
					"content": "Hửm? Đây là vật bạn câu được khi câu cá sao? Ừm... cái này nhìn có vẻ giống như mồi câu mà chúng tôi dùng để câu cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500503
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500503,
					"content": "Câu cá có thể câu được thứ này sao...? Chị Anisa hàng ngày đều câu cá ở Đảo Watatsumi, mà đâu thấy chị ấy câu được thành quả gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500504
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500504,
					"content": "Có nên nói rằng không hổ danh là bạn không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500505
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500505,
					"content": "Để tôi xem, món này... có thể cảm nhận được nó có sức mạnh nguyên tố Thủy rất đáng sợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500506
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500506,
					"content": "Nước ngầm của Vực Đá Sâu có hàm lượng nguyên tố rất nhiều, quả thật có hơi bất thường... Chẳng lẽ là vì thứ này sinh trưởng trong nước ngầm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500507
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500507,
					"content": "Nhưng thứ này sau khi lấy ra khỏi nước thì liên tục mất đi nguyên tố, nói không chừng phải để gần nước mới có hiệu quả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500508
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500508,
					"content": "Để gần nước?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500509
					]
				},
				{
					"id": 710500509,
					"content": "Để gần nước, dùng nguyên tố Thủy kích hoạt, chắc sẽ biết được thứ này có tác dụng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500510
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500510,
					"content": "Thế này đi, bạn hãy đi kích hoạt nó, dù sao cũng do bạn câu được mà, xảy ra chuyện gì thì nói với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500511
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500511,
					"content": "Nếu có giá trị nghiên cứu gì, thì tôi sẽ trả thù lao cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
