					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140615,
					"content": "Và cũng muốn thử cách điệu thêm cho những nguyên liệu như Liệt Hỏa Hoa và Mật Hoa Lừa Dối nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140611,
					"content": "Lại là dùng Dịch Slime sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "Không có không có, món này không thích hợp để cho Dịch Slime vào đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140616,
					"content": "Tôi cũng khá nghiêng về việc cho thêm chút phấn trên cánh của Cicin Lôi để tăng thêm vị giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140613,
					"content": "Nói miệng thì chắc bạn nhớ không nổi đâu, tôi sẽ ghi lại một bản cho bạn, bạn mang về cho Xudong nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140614,
					"content": "Haiz, tôi mà được đi Inazuma là tốt rồi, ở đó nhất định có rất nhiều nguyên liệu mà tôi chưa thử qua.",
