				},
				{
					"id": 220140604,
					"content": "Phản ứng y như Thầy Mao vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "Bạn cũng có ghé qua quán sao, nhưng mà trông bạn không giống như muốn đi ăn cơm cho lắm...",
