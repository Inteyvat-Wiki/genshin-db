			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "Nhà lữ hành, lại gặp nhau rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140102,
					"content": "Có việc gì cần giúp không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "Bạn còn nhớ hôm trước tôi có hứa mời bạn một bữa không? Tôi đang chuẩn bị cho bữa đó đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140106,
					"content": "Để chuẩn bị cho bữa ăn này, tôi đã đi khắp nơi để thu thập những nguyên liệu tươi nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140107,
					"content": "Giờ nguyên liệu cũng đã được kha khá rồi, tôi đang suy nghĩ cách chế biến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140108,
					"content": "Vậy Julie và Parvaneh đâu rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "Bọn họ sao, Parvaneh nói muốn tiếp tục đi tìm nguyên liệu, cô ấy muốn có một loại \"gia vị vạn năng\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140110,
					"content": "Sau đó cô ấy dẫn theo Julie đi luôn rồi...Họ nói sẽ đi không xa đâu nên không cần phải lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140111,
					"content": "Nhưng mà, tôi vẫn cần sự giúp đỡ của bạn. Tuy là đã thu thập được rất nhiều nguyên liệu của Inazuma rồi, nhưng tôi vẫn chưa có...ý tưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140112,
					"content": "Bạn xem, Rong Biển...Hải Linh Chi, còn có Tú Cầu Anh Đào nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140113,
					"content": "Tuy đều là nguyên liệu tươi mới, nhưng tôi lại chưa biết bắt đầu từ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140114,
					"content": "Tôi vốn muốn thỉnh giáo đầu bếp bản địa, nhưng như vậy thì món ăn sẽ trở thành món Inazuma mất, như vậy sẽ không có cảm giác mới mẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140115,
					"content": "Cho nên, tôi sẽ dựa vào tư duy của đầu bếp Liyue để chế biến những loại nguyên liệu Inazuma này. Như vậy mới có thể làm ra món ăn đặc sắc được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140116,
					"content": "Nhà lữ hành, bạn có thể về Liyue một chuyển để thỉnh giáo đầu bếp Vạn Dân Đường giúp tôi được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140117,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "Vậy nhờ bạn nhé, tôi sẽ đợi bạn ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140124,
					"content": "Hy vọng Thầy Mao sẽ có ý tưởng gì đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140119,
					"content": "Bạn là muốn có cái cảm giác \"rộp rộp\" đó đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "\"Rộp rộp\" là...là gì nhỉ? Ý bạn là đang nói loại thức ăn có thể chấn động lòng người sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140121,
					"content": "Nếu như có thể tìm được công thức của món ăn đó thì tốt biết mấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140122,
					"content": "Nhưng mà, người nghĩ ra công thức này, có thể tôi không có quen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140123,
					"content": "Nói chung, phiền bạn đi thỉnh giáo Thầy Mao giúp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140104,
					"content": "Bạn đang chuẩn bị mời tôi ăn cơm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "Ha ha, thì không phải tôi đang chuẩn bị đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thầy Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "Ấy? Nhà lữ hành, đến đây ăn cơm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140202,
					"content": "Tôi muốn thỉnh giáo một chuyện...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Xudong vì muốn chế biến thức ăn mà đến tận Inazuma sao, đúng là có nghị lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140204,
					"content": "Hai người có quen biết sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "Cũng coi như là quen biết, trước đây hai chúng tôi có so tài làm bếp qua, kết quả miễn cưỡng có thể nói là...hòa nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140206,
					"content": "Anh ta cứ luôn nói là cần tìm một cái gì đó đột phá hơn, muốn đi nhiều nơi trên lục địa này...Không ngờ anh ta lại làm thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140207,
					"content": "Nhưng mà, có vẻ bây giờ anh ta gặp phải chướng ngại gì đó rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140208,
					"content": "Anh biết được cách để giải quyết vấn đề không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "Tôi cũng không đảm bảo, nhưng tôi sẽ thử hết khả năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140214,
					"content": "Rong Biển...Hải Linh Chi, còn có gì nữa...Tú Cầu Anh Đào? Đây đều là những nguyên liệu kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140215,
					"content": "Nhưng mà, nếu chỉ đơn thuần là Rong Biển và Hải Linh Chi thì tôi có thể sẽ làm ra được một món...Nhưng vẫn cần có chút nguyên liệu phụ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140216,
					"content": "Nhà lữ hành, mang cho tôi một ít Ớt Tuyệt Vân và Thịt Gia Cầm nhé được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140217,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "Vậy thì làm phiền rồi, tìm đủ rồi thì đến đây giao cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140219,
					"content": "Quả nhiên là những nguyên liệu kinh điển...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Ha ha ha, đương nhiên rồi, những thứ này đều là nguyên liệu đáng tin cậy nhất. Sau khi tìm đủ thì giao cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140221,
					"content": "Nhưng mà, cái Tú Cầu Anh Đào này thì tôi đúng là không biết làm món gì thật...Không biết đầu bếp ở Inazuma sẽ xử lý nó như thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140210,
					"content": "Có thể Xiangling sẽ biết được cách để giải quyết vấn đề của anh ta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "Xiangling sao, ừm...con bé đó có rất nhiều sáng kiến trong việc làm bếp, nói không chừng sẽ có cách thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140212,
					"content": "Nhưng giờ nó đang ở Khinh Sách Trang để hái Măng Trúc rồi nên chưa về được, muốn tìm thì e rằng phải đợi một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Thầy Mao"
				},
				{
					"id": 220140213,
					"content": "Xudong chắc là đang nôn câu trả lời lắm rồi đúng không, vậy để tôi xem xem có thể giải quyết vấn đề này không vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Thầy Mao"
				}
			]
