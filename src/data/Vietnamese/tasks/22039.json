				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "Làm ăn như vậy chắc không duy trì nổi quá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "Sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "Xin lỗi xin lỗi, tôi mải lo nghĩ nên không chú ý. Bạn cần mua quần áo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "Tuy tơ lụa cao cấp của Liyue vẫn thường đứt hàng...nhưng kimono kiểu mới thì lúc nào cũng có nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "Trước kia bạn nhập hàng từ Liyue sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "Đúng thế, trước kia tiệm của tôi lúc nào cũng có thể nhập tơ lụa cao cấp của Liyue, ví dụ như tơ lụa được làm từ Hoa Nghê Thường ở Thương Hội Phi Vân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "Nhưng với tình hình của Inazuma bây giờ...đã có một khoảng thời gian tiệm không nhập được loại tơ lụa đó. Bây giờ chỉ đành dựa vào số hàng tồn trước kia để duy trì kinh doanh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "Số tơ lụa còn lại cứ vơi dần vơi dần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "Tôi định tự thiết kế một số hoa văn mới hoặc dùng màu nhuộm mới để làm ra loại vải và áo quần mới mẻ, hi vọng có thể thu hút được khách hàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "Nhưng tôi vẫn chưa tìm được màu nhuộm nào đáng để gọi là \"mới mẻ\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "Nhà Lữ Hành, bạn đi nhiều nơi, chắc chắn kiến thức sâu rộng...Bạn có từng nhìn thấy màu nhuộm nào đáng được gọi là \"mới mẻ\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "Tôi thấy nhiều rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "Thật, thật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "Nếu được có thể nhờ bạn giúp tôi mở mang tầm mắt, lấy một số nguyên liệu có thể điều chế thành màu nhuộm mới lạ cho tôi xem thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "Tôi sẽ chuẩn bị thù lao hậu hĩnh, nhờ bạn giúp nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "Chỉ cần màu nhuộm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "Với tình hình hiện nay thì tôi cũng chỉ có thể nghĩ cách cải thiện màu nhuộm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "Nếu bạn biết nguyên liệu nào có thể chế thành màu nhuộm \"mới mẻ\" thì hãy mang đến cho tôi nhé, tôi sẽ trả thù lao hậu hĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
