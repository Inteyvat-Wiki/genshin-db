			"dialogs": [
				{
					"id": 220460101,
					"content": "Đền thần lại có chút bừa bộn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "Meo, là các ngươi à, đến thật đúng lúc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460104,
					"content": "Đã một khoảng thời gian chưa dọn dẹp rồi, xung quanh đền thần có rất nhiều vết bẩn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460105,
					"content": "Như vậy không thể tiếp đón loài người đến đền thần được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460106,
					"content": "Các ngươi có thể giúp ta quét dọn đền thần giống lần trước được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460107,
					"content": "Không phải đã có Taisuke và Etsuko rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "Ta sẽ không chủ động đến nói chuyện với hai người xanh xanh đó đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460109,
					"content": "Cái tên cao cao đó, cứ nhìn ta với ánh mắt rất kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460110,
					"content": "Tên xanh xanh còn lại thì luôn làm bộ dạng không có tinh thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460111,
					"content": "Meo meo, hai tên đó đều không đáng tin cậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460115,
					"content": "Vậy phiền các ngươi rồi. Dùng gậy và nước quét dọn như lần trước nhé, hiểu chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460116,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "Vậy việc này nhờ hết vào ngươi đó, ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460119,
					"content": "Ta đợi các ngươi ở đây, meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460117,
					"content": "Đại khái đã hiểu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "Có thể nhờ Ooshima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "Tên người đá đó luôn bận rộn, không biết đang gõ đùng đùng gì nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460114,
					"content": "Tảng đá đã tạc xong rồi, tại sao lại cứ làm ồn như vậy chứ, thật phiền...",
					"roleType": "TALK_ROLE_NPC",
