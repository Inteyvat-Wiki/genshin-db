			},
			"dialogs": [
				{
					"id": 150310201,
					"content": "Đây là con đường bình thường tôi hay đi. Tôi nhớ bên đường có Hóa Thân Dung Nham nghỉ ngơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310202
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310202,
					"content": "Phần lõi của chúng rất nóng, chắc có thể đáp ứng được nhu cầu của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310203
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310203,
					"content": "Không ngờ mọi người lại phối hợp với chúng ta như vậy, xem ra họ cũng đã có chút nghi ngờ về cây nấm đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310204,
					"content": "Ừm, cũng may là nhờ các vị đến đây đó. Trước kia có rất nhiều người từng ăn loại nấm này, nhưng nói chuyện được với nấm thì đây quả là lần đầu tiên...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310205
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310205,
					"content": "Cũng phải. Dù muốn điều tra thì cũng không biết phải bắt đầu từ đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310206,
					"content": "Vì thế đây xem như là cơ hội hiếm có. Cộng thêm Chúa Tể Hiền Giả Nấm đó lúc nào cũng nói năng thô lỗ, nên đã thắp lên khát khao chiến thắng của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310207
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310207,
					"content": "Người của Cộng Đồng Trù Phú hình như đều thích so tài nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310208
					]
				},
				{
					"id": 150310208,
					"content": "Đúng vậy, nhưng trông Varesa có vẻ là một người rất dịu dàng. Có lẽ chỉ trừ những lúc luyện tập và chiến đấu ra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310209,
					"content": "Cái này... Đúng vậy, tôi không thích chiến đấu, cũng không thích sự hiếu thắng. Tôi chỉ cần có thể sống tốt mỗi ngày là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310210
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310210,
					"content": "Nhưng huấn luyện viên Iansan đã dạy tôi rất nhiều, ví dụ như \"sức mạnh\" là phương thức chứ không phải mục đích...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310211
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310211,
					"content": "Khi Vực Sâu tấn công, nếu như thường ngày tôi không luyện tập thì cũng sẽ không thể kiểm soát tốt sức mạnh nguyên tố, mà chỉ đành trơ mắt nhìn ma vật hoành hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310212
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310212,
					"content": "Dù có sợ thế nào đi nữa thì tôi cũng phải lấy hết can đảm ra để ngăn chuyện đó xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310213,
						150310214
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310213,
					"content": "Tôi có thể nhìn ra được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				},
				{
					"id": 150310215,
					"content": "Cảm ơn, tôi sẽ dần trở nên dũng cảm giống như Fietena vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310216
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310216,
					"content": "Đi thôi, chúng ta vừa đi vừa tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310214,
					"content": "Trong lòng cô có một mặt kiên cường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				}
			]
