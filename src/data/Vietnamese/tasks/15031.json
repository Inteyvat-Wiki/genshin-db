			"dialogs": [
				{
					"id": 150310401,
					"content": "Thu hoạch tốt lắm, có rất nhiều Con Mắt Rực Cháy. Còn có cái này, hình như là thứ mà nó dùng để phun lửa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310402,
					"content": "Ừm, đây là giáp lưng của nó, có thể phun Phlogiston, nên động tác của nó rất nhanh nhẹn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310403,
					"content": "Cha tôi từng nói nó là một loài sinh vật sống trong núi lửa. Chúng ta gặp được nó đúng là may mắn mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310404,
					"content": "Tôi cảm thấy nhiệt độ của lớp giáp lưng này còn cao hơn nhiệt độ do Con Mắt Rực Cháy tạo ra đấy. Hihi, lần này chắc là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310405,
					"content": "Biểu hiện chiến đấu vừa rồi của cô rất tốt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "Ừm... Dù không muốn chiến đấu đến mức nào đi nữa thì cũng có lúc phải chiến đấu. Để có thể nhanh chóng vào trạng thái này thì tôi cũng đã nghĩ ra rất nhiều cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310407,
					"content": "Ví dụ, tôi luôn xem những câu chuyện về anh hùng. Vị anh hùng mà tôi thích nhất chính là Fietena, chính là người mà tôi từng nhắc đến trước đó đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310408,
					"content": "Món đồ đặc trưng nhất của cô ấy chính là mặt nạ, nên tôi cũng dựa theo mô tả trong đó để làm ra một chiếc tương tự.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310409,
					"content": "Khi đeo mặt nạ, tôi cảm thấy mình như biến thành cô ấy vậy. Để không gây tổn hại đến danh tiếng của cô ấy, tôi nhất định phải dũng cảm lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310410,
					"content": "Mặt khác, cách làm này cũng giống như tôi đang trốn sau lưng cô ấy vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310411,
					"content": "Thì ra là vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310412,
					"content": "Nhưng rất có tác dụng mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "Thật sao? Nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310415,
					"content": "Rồi sẽ có một ngày, tôi cũng phải tháo mặt nạ xuống mà đối diện với chính mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310416,
					"content": "Nhưng nếu không đi được bước đó thì tôi càng sẽ dựa vào chiếc mặt nạ này. Tôi... rất lo lắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310417,
					"content": "Nhưng chính cô là người quyết định đi điều tra loài nấm kia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "Đúng vậy, đây là quyết định của cô! Ý nghĩa thực sự của thám hiểm nằm ở việc đưa ra quyết định dũng cảm, còn chiến đấu chỉ là một khâu nhỏ thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310420,
					"content": "Thì ra là vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310421,
					"content": "Cô đã tiến bộ rất nhiều rồi, không cần vội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310422,
					"content": "Cảm ơn các vị luôn cổ vũ tôi, đã dạy cho tôi rất nhiều thứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310423,
					"content": "Tôi sẽ mạnh mẽ hơn, cho đến khi có thể đối mặt với chính mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310424,
					"content": "Sau khi tâm trạng thoải mái hơn, hình như bụng tôi lại thấy đói rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310425,
					"content": "Ơ, lại đói rồi à? Tôi còn chưa tiêu hóa xong đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310426,
					"content": "Đi thôi, trở về Cộng Đồng Trù Phú nào. Lần này nhất định sẽ đáp ứng được yêu cầu của Chúa Tể Hiền Giả Nấm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310418,
					"content": "Chứ không phải mặt nạ của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "Đừng cảm thấy đây là chuyện mất mặt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
