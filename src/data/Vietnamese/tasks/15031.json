			"dialogs": [
				{
					"id": 150310101,
					"content": "Thủ lĩnh Acatl tập hợp mọi người trong Cộng Đồng Trù Phú lại, Varesa kể sơ lại về tiến triển trong việc điều tra về nấm.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150310102
					]
				},
				{
					"id": 150310102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310103
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310104
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310105,
					"content": "Lúc chúng ta điều tra thì cảm thấy cũng bình thường, nhưng bây giờ nghe lại từ góc độ người ngoài cuộc thì đúng là có chút hoang đường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310106,
					"content": "Sự im lặng khó tả này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310107
					]
				},
				{
					"id": 150310107,
					"content": "Thì ra là vậy, nấm trong vườn trái cây lại có ý thức riêng sao? Đây là phát hiện lớn đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310108
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310108,
					"content": "Phải đó, nếu không có các vị điều tra thì nói không chừng sẽ có một nguy cơ vô cùng lớn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310109,
					"content": "Cũng may mọi người đã phát hiện ra, lại còn thu thập được nhiều manh mối như vậy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310110
					],
					"speakerTitle": "Xoctli"
				},
				{
					"id": 150310110,
					"content": "Tốt quá rồi, may mà mọi người không cảm thấy câu chuyện vừa kể quá kỳ lạ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310111
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310111,
					"content": "Hahaha, lạ thì đúng là lạ thật, vì dù sao mọi người cũng chưa từng nói chuyện với nấm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310112
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310112,
					"content": "Nhưng Varesa luôn là đứa trẻ thật thà, chuyện này ai ai cũng biết cả. Hơn nữa chuyện nấm xanh vốn dĩ luôn là điều bí ẩn đối với chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310113
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310113,
					"content": "Hiện tại đã phát hiện ra dấu hiệu không được tốt, đương nhiên mọi người đều rất sẵn lòng hỗ trợ điều tra rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310114
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310114,
					"content": "Có gì cần giúp đỡ thì cứ nói nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310115
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310115,
					"content": "Mọi người chấp nhận chuyện này nhanh thật đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310116,
					"content": "Cảm ơn rất nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310117
					]
				},
				{
					"id": 150310117,
					"content": "Vừa nãy có nói là cần dùng nhiệt độ cao để chế biến loại nấm này đúng không? Đợi một chút, để tôi đi chuẩn bị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310118
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310118,
					"content": "Đến rồi đây! Tôi đã dùng chảo sắt để chiên, nhiệt độ này chắc là đủ rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310119
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310119,
					"content": "Woa, thơm quá đi! Vừa ngửi thôi là đã thấy thèm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310120,
					"content": "Vậy, vậy không khách sáo nữa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310121,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310122
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310122,
					"content": "Nghe thấy không, là tiếng của nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310123,
					"content": "Hahaha, xem ra các ngươi cũng đã nắm được chút bí quyết rồi đấy, nhưng loại nhiệt độ này hoàn toàn không thể hiện được chút thành ý nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310124
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310124,
					"content": "Các ngươi tưởng dùng lửa và công cụ thường thấy, tùy tiện chế biến là sẽ được Chúa Tể Hiền Giả Nấm công nhận sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310125
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310125,
					"content": "Con người thật sự khiến ta thất vọng. Khi có gợi ý thì các ngươi sẽ biết dùng trí tuệ để giải quyết câu đố...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310126
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310126,
					"content": "Nhưng khi không có gợi ý thì lại lộ nguyên hình mà dùng cách thức ngu xuẩn ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310127
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310127,
					"content": "Nghĩ thêm cách khác đi nào, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310128
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310128,
					"content": "Thế, thế nào? Có nghe thấy tiếng của nó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310129
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310129,
					"content": "Đáng ghét, tên này đúng là rất đáng ghét mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310130,
					"content": "Nó nói nhiệt độ không đủ cao, không đáp ứng được yêu cầu của nó. Đúng là kén chọn quá đi mất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310131,
						150310132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310131,
					"content": "Nhưng phải làm rõ xem nó muốn gì đã...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				},
				{
					"id": 150310133,
					"content": "Nhiệt độ không đủ cao, vậy xem ra phải dùng cách lợi hại hơn mới được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310134
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310134,
					"content": "Đã nghe rõ rồi chứ, phiền mọi người đi thu thập thêm một số thứ có nhiệt độ cao nhé. Thứ gì cũng được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310135
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310135,
					"content": "Để tôi nghĩ cách thử!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310136
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310136,
					"content": "Cứ giao cho tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310137
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310137,
					"content": "Chúng ta cũng đi tìm xem nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310138
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310138,
					"content": "Được! Nhưng chúng tôi vẫn chưa quen thuộc với khu vực này, cô có gợi ý gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310139,
					"content": "Hmm... Hiện tại thì vẫn chưa có manh mối, nhưng chúng ta có thể đến gần núi lửa xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310140
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310140,
					"content": "Núi lửa luôn phun ra các loại vật thể khác nhau, nói không chừng sẽ có nguyên liệu tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310141
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310141,
					"content": "Được, đi thôi! Nếu có cơ hội, tôi phải ném những thứ nóng hổi tìm được vào mặt cây nấm xấu xa đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
