			"dialogs": [
				{
					"id": 718020401,
					"content": "Các ngươi vẫn chưa lấy được bản vẽ ư? Ở trên Vân Trung Tiên Cư...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020402
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020402,
					"content": "Í, sao bà ấy biết chúng ta vẫn chưa lấy được bản vẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718020403,
					"content": "Bản vẽ đó do bổn tiên đích thân vẽ, ở gần mình hay không lẽ nào bổn tiên không biết? Mau đi lấy bản vẽ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				}
			]
		},
		{
			"id": 7180205,
