				"points": []
			},
			"dialogs": [
				{
					"id": 718020201,
					"content": "Không tồi, quả là bản vẽ mà ta đã làm khi xây Vân Trung Tiên Cư.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020202
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 718020202,
					"content": "Rốt cuộc ngài cầm bản vẽ này...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020203
					]
				},
				{
					"id": 718020203,
					"content": "Sao ngươi còn hỏi? Bỏ đi, nể mặt ngươi đã hiến tế cho ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020204
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 718020204,
					"content": "Ta nghe nói, người phàm trong cảng Liyue cũng xây một lầu các có thể bồng bềnh giữa không trung tên là Quần Ngọc Các.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020205
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 718020205,
					"content": "Ta còn nghe nói, người phàm chỉ dựa vào kích thước, đã cho rằng Quần Ngọc Các này tuyệt thế vô song.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020206
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 718020206,
					"content": "Hừ, đúng là người trần mắt thịt nhìn không thấu sự tinh diệu của Tiên gia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020207
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 718020207,
					"content": "Quần Ngọc Các bé nhỏ... bổn tiên thi triển vài chiêu là sẽ khiến nó lu mờ ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020208
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 718020208,
					"content": "Ngài... không phục?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020209
					]
				},
				{
					"id": 718020209,
					"content": "Không phục? Ngươi nói nghe lạ nhỉ, bổn tiên chỉ là thương xót người phàm không hiểu sự tinh diệu của Tiên gia, nên mới bị mấy kỹ thuật tầm thường nơi trần gian che mắt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020210
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 718020210,
					"content": "Cứ mãi như vậy, chỉ e kỹ thuật cơ quan nơi trần gian sẽ bị lạc lối, bổn tiên chuẩn bị đích thân chỉ điểm cho họ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020211
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				},
				{
					"id": 718020211,
					"content": "Được rồi, chuyện tới đây thôi, các ngươi mau đi đi, đừng làm phiền sự thanh tịnh của bổn tiên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân"
				}
			]
		},
		{
			"id": 7180203,
			"completionStepIds": [
				7180207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180207",
							"2"
						],
						"stepId": 7180207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020301,
					"content": "Có chuyện gì, mau nói, còn có nhiều việc chờ bổn tiên lo liệu, không thể kéo dài thời gian được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020302,
					"content": "Chỉ là chào hỏi ngài thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020304,
					"content": "Các ngươi đúng là kỳ lạ... Không cầu ước gì, chỉ là hỏi thăm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020305,
					"content": "Bỏ đi, theo ý các ngươi đó, tâm tư người phàm, xưa nay ta cũng lười suy đoán.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020306,
					"content": "Nếu các ngươi thật sự rảnh rỗi như vậy, chi bằng đến giúp bổn tiên một việc, thấy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020307,
					"content": "Ngày trước lúc ta nghiên cứu Thuật cơ quan có được chút thành tựu, từng chế tạo một toà Vân Trung Tiên Cư bềnh bồng giữa không trung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020308,
					"content": "Vân Trung Tiên Cư làm bằng Phù Sinh Thạch, thêm vào vô vàn sự tinh xảo, tuyệt nhất là trong đó... Mà thôi, có nói các ngươi cũng không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020309,
					"content": "Sau khi xây xong Vân trung Tiên Cư, ta đã để lại bản vẽ ở bên trên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020310,
					"content": "Bổn tiên đã lập phong ấn lên đó, vốn nghĩ người có duyên sẽ lấy được, nhưng lâu như vậy rồi mà phong ấn vẫn chưa từng bị chạm vào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020311,
					"content": "Bổn tiên cũng lười biếng, bèn cứ để bản vẽ ở đó mãi, các ngươi giúp ta đến Vân Trung Tiên Cư đem bản vẽ về đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020312,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "Ngươi hào sảng đấy, vậy mau đi đi. Lấy được rồi thì đem vào động phủ cho ta, bổn tiên đợi các ngươi trong động phủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020314,
					"content": "Ngài lấy bản vẽ này làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "Ta tự có dụng ý của mình, nói với ngươi thì ngươi cũng không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				},
				{
					"id": 718020316,
					"content": "Mau đi đi. Lấy được rồi thì đem vào động phủ, bổn tiên chờ các ngươi trong động phủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Đến Thăm Tiên Phủ"
				}
			]
		},
