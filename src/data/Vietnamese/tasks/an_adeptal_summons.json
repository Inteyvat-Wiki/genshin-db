			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718021001,
					"content": "Cưỡi mây thăm tiên, quả thật không phải chuyện dễ dàng. Nhưng ngươi vẫn đã đến được đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "Đến Thăm Tiên Phủ",
					"speakerSubtitle": "...Giọng Nói Hơi Sai Sai?"
				},
				{
					"id": 718021002,
					"content": "Ồ! Không phải cô ấy đã đến Cảng Liyue rồi sao? Chẳng lẽ lại lặng lẽ quay về à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021003,
					"content": "Cảm thấy... giọng nói có vẻ không đúng lắm thì phải?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "À ừm... Chúng tôi chỉ lo là sẽ có người đến trộm đồ trong phủ tiên thôi, không có ý làm phiền cô đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021005,
					"content": "...Ta có một nhiệm vụ cần giao, nếu thực hiện tốt thì sẽ có thể tiến vào tiên phủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "Đến Thăm Tiên Phủ",
					"speakerSubtitle": "...Giọng Nói Hơi Sai Sai?"
				},
				{
					"id": 718021006,
					"content": "Giọng nói này cứ lẩm bẩm một mình nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "Hả? Ý là người bây giờ đang nói chuyện với chúng ta không phải là Lưu Vân Chân Quân, mà là cơ quan do cô ấy để lại sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021009,
					"content": "Ngày xưa, khi ta nghiên cứu cơ quan thuật có chút thành tựu, ta đã từng xây một \"Vân Trung Tiên Cư\" lơ lửng trên không trung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "Đến Thăm Tiên Phủ",
					"speakerSubtitle": "...Giọng Nói Hơi Sai Sai?"
				},
				{
					"id": 718021010,
					"content": "Sau khi \"Vân Trung Tiên Cư\" hoàn thành, bổn tiên niệm rằng tiên duyên hiếm khi gặp được, nên đã để lại bản vẽ trên đó, người có duyên sẽ tự lấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "Đến Thăm Tiên Phủ",
					"speakerSubtitle": "...Giọng Nói Hơi Sai Sai?"
				},
				{
					"id": 718021011,
					"content": "Ngươi hãy đi lấy bản vẽ về, rồi chúng ta sẽ nói thêm chi tiết trong tiên phủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "Đến Thăm Tiên Phủ",
					"speakerSubtitle": "...Giọng Nói Hơi Sai Sai?"
				},
				{
					"id": 718021012,
					"content": "Chân quân?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "Lưu Vân Chân Quân? À ừm... Xianyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021014,
					"content": "Ngươi hãy đi lấy bản vẽ về, rồi chúng ta sẽ nói thêm chi tiết trong tiên phủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021015
					],
					"speakerTitle": "Đến Thăm Tiên Phủ",
					"speakerSubtitle": "...Giọng Nói Hơi Sai Sai?"
				},
				{
					"id": 718021015,
					"content": "Hoàn toàn phớt lờ chúng ta kìa, vẫn cứ lẩm bẩm một mình thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021016,
						718021017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021016,
					"content": "Chắc chắn là cơ quan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021018,
					"content": "Nhưng mà, thường thứ canh giữ động phủ không phải sẽ là loại... cơ quan biết đánh người gì đó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021019,
						718021020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021019,
					"content": "Có lẽ cô ấy có dự tính riêng của mình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021021,
					"content": "Hay là chúng ta đi lấy bản vẽ đó về, sau đó vào động phủ xem sao đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021022,
					"content": "Hihi, tôi cũng hơi tò mò là rốt cuộc cô ấy đã đặt cơ quan gì trong động phủ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021020,
					"content": "Tôi hơi quan tâm đến bản vẽ đó rồi đấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021017,
					"content": "Bắt đầu lặp lại câu cuối cùng rồi đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021007,
					"content": "Chẳng lẽ âm thanh này là do cơ quan gì đó sao...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				}
			]
		},
