			"dialogs": [
				{
					"id": 718021301,
					"content": "Đây là cái gì vậy? Một cái hộp đặt trên cái bàn... Xung quanh không có gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021302,
						718021303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021302,
					"content": "Là bàn của tiên nhân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				},
				{
					"id": 718021304,
					"content": "Có thể đến được nơi này, ta đã hiểu được tâm tính thực sự của ngươi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021305
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân...?"
				},
				{
					"id": 718021305,
					"content": "Lại nói chuyện nữa rồi kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021306,
					"content": "Hãy viết ra mong muốn rồi bỏ vào trong hộp. Bổn tiên sẽ tự có quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021307
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân...?"
				},
				{
					"id": 718021307,
					"content": "...Trải qua gian nan, ý chí kiên định, tâm trí kiên cường là điều hiếm có. Những báu vật này ngươi có thể tự lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021308
					],
					"speakerTitle": "Lưu Vân Tá Phong Chân Quân...?"
				},
				{
					"id": 718021308,
					"content": "Hay quá! Hihi, tôi biết ngay là chân quân sẽ không để chúng tôi làm không công mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021309,
					"content": "Âm thanh này nói \"viết ra mong muốn rồi bỏ vào trong hộp\"... Là bảo chúng ta viết ra mong muốn của mình rồi bỏ vào hộp phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021310,
						718021311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021310,
					"content": "Không nên tùy tiện cầu nguyện với tiên nhân thì hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021312,
					"content": "Cũng đúng... Nếu chúng ta có việc gì thì cứ trực tiếp đến gặp... Xianyun để bàn bạc là được rồi, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021313,
					"content": "Vậy chúng ta để bản vẽ vào trong hộp, rồi rời khỏi đây thôi nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021314,
					"content": "Nhưng xung quanh trống rỗng, không có đồ đạc gì cả. Chắc là chân quân đã lấy đi hết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021315,
					"content": "Mấy cơ quan này được thiết kế để ứng phó với tình huống nào vậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021316
					]
				},
				{
					"id": 718021316,
					"content": "Tôi cũng không rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021317,
					"content": "Tóm lại, chờ lần tới khi chúng ta gặp chân quân thì hỏi thử cô ấy chuyện của động phủ vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021311,
					"content": "Cầu nguyện với người quen, cứ cảm thấy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021303,
					"content": "Là hộp của tiên nhân.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				}
			]
