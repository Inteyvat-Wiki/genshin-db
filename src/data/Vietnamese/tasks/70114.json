			},
			"dialogs": [
				{
					"id": 701140101,
					"content": "Tiểu thư Sandrone lại có thể dành thời gian đến Mondstadt, thật không dễ dàng gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140102,
					"content": "Trước đây khi tôi nghiên cứu \"mảng ẩn số\", anh đã giúp tôi rất nhiều. Tôi muốn gặp trực tiếp để cảm ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140103,
					"content": "Cô khách sáo quá. Đề tài này vốn nằm ngoài chuyên môn của tôi, nó hoàn thành được phần lớn vẫn là nhờ công sức của Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140104,
					"content": "Đây là công lao của mọi người mà. Ơ? Mà kể ra thì sao không thấy Durin đâu nhỉ? Tôi cứ tưởng cậu ấy không thể cách anh quá xa, anh cũng được coi như là người giám hộ của cậu ấy mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140105,
					"content": "Nhận định của cô cũng không sai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140106,
					"content": "Nhưng gần đây cậu ấy đã hòa nhập vào cuộc trò chuyện của mọi người tốt hơn rồi, nên tôi đang thử để cậu ấy tự sắp xếp cuộc sống hàng ngày.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140107,
					"content": "Anh không thấy lo lắng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140108,
					"content": "Cũng có chút. Trước đây, khi cậu ấy hành động một mình, nếu tiếp xúc với người có cá tính mạnh, cậu ấy sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140109,
					"content": "Học được những thứ kỳ quặc? Bắt chước cách ăn nói kỳ quặc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140110,
					"content": "Ừm, đúng vậy. Cô cũng từng trải qua chuyện tương tự sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140111,
					"content": "Hmph, còn phải nói sao? Tôi hiểu quá mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140112,
					"content": "Sau khi gặp Đại Đội Trưởng Varka, thỉnh thoảng tôi sẽ đưa Durin đến chỗ Sucrose để hỗ trợ làm nghiên cứu, giúp cậu ấy tĩnh tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140113,
					"content": "Nhưng nếu ở lâu với đội trưởng Jean, tôi sẽ đưa cậu ấy đi gặp Klee để học lại cách thư giãn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140114,
					"content": "Anh cũng vất vả thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140115,
					"content": "Chỉ là chăm sóc người nhà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140116,
					"content": "Vậy cô xử lý những chuyện này như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140117,
					"content": "Hả? Tôi đâu có tâm trí đi lo những chuyện rắc rối này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140118,
					"content": "Nhưng theo tôi thấy, chỉ cần bản chất một người không xấu, dù có chịu nhiều ảnh hưởng đến đâu, cuối cùng cũng sẽ quay về với con người chân thật nhất của mình thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "Sandrone"
				},
				{
					"id": 701140119,
					"content": "Ừm... quan điểm này hay đấy. Có lẽ tôi cũng nên thử đón nhận cách nghĩ này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
