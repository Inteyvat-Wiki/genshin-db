					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "Thành công rồi! Xem ra đây không phải thử thách không thể hoàn thành, tôi có thể yên tâm gửi kế hoạch cho viện rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700402,
					"content": "Tiếc là tôi vẫn chưa kiểm tra hết tất cả tài sản ở đây, chắc vẫn phải quay lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700403,
					"content": "#Dù sao thì cũng cảm ơn {F#cô}{M#cậu} đã giúp đỡ, đúng rồi, còn thù lao nữa. Chúc {F#cô}{M#cậu} có một hành trình thuận lợi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
