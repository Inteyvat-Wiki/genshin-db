					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "Ồ! Quay lại rồi à. Tôi cũng trở lại rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701702,
					"content": "Sau khi nghe xong báo cáo, viện đã yêu cầu tôi khi thu hồi tài sản, tiện đánh giá xem nơi này liệu có thể cải tạo thành khu đào tạo phát triển năng lực hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701703,
					"content": "Haiz, cảm thấy công việc này khá quen thuộc. Trước đây cũng có một quãng thời gian chuyên viên hành chính có đam mê đặc biệt với việc đưa mọi người tham gia huấn luyện lặn nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701704,
					"content": "Tôi thấy cũng hơi vô dụng, nhưng công việc là công việc, nhiệm vụ là nhiệm vụ... Hơn nữa, kết cấu ở đây quả thực rất kỳ lạ... ý tôi là đặc biệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701705,
					"content": "Vì thế, tôi đã đặt thêm một số bản sao Bệ Thăm Dò trong khu vực, nói đơn giản là mô hình thôi, là đạo cụ an toàn, không nguy hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701706,
					"content": "Trước mắt, nội dung huấn luyện mà tôi nghĩ đến là <color=#00E1FFFF>thu hồi toàn bộ bản sao Bệ Thăm Dò tại công trình trong thời gian quy định.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701707,
					"content": "#{F#Cô}{M#Cậu} muốn thử không? Nếu thành công tôi cũng sẽ gửi chút thù lao, dù sao cũng là công việc hỗ trợ nghiên cứu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
