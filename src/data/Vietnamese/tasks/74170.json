			"dialogs": [
				{
					"id": 741700213,
					"content": "À mà, Kuisel là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "Tôi không biết. Trong ấn tượng của tôi, Viện Khoa Học Fontaine không có cái tên này... Còn với anh ta, có lẽ không có ai tên như vậy sẽ tốt hơn nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Giống như anh ta nói, Kuisel cũng chỉ là một nhân vật bịa ra, càng khác biệt với anh ta càng tốt, như vậy sẽ bớt khả năng bị nhận ra... Tôi đoán vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "Haiz, nhưng để mà nói, anh ta đã quá khác biệt so với ngày trước, ban đầu tôi còn không nhận ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
