				{
					"id": 741700210,
					"content": "Chuyện đó tạm giác lại đã, về chuyện của Coutrot...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Việc trước đây anh ta bị gạch tên khỏi Viện Khoa Học Fontaine có vẻ chưa được tỉnh ngộ cho lắm, đúng là tên cứng đầu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "Nhưng lần này không có ai chống lưng cho rồi, thế nên cứ yên tâm, anh ta không còn cơ hội để giở trò nữa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
