				},
				{
					"id": 741700218,
					"content": "Thật khó lý giải, đúng không? Rõ ràng anh ta đã tiến hành cải tạo nơi này trên nhiều phương diện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Tôi thấy như hiện tại cũng phù hợp cho việc chọn địa điểm du lịch phế tích đấy... Mà nói vậy đúng là... cũng hơi thiếu thận trọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "Khụ, những lời vừa nãy chỉ là quan điểm cá nhân của tôi, không đại diện cho ý kiến của Viện Khoa Học Fontaine nhé.",
