			"dialogs": [
				{
					"id": 4880101,
					"content": "Hóa ra hàng ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880102,
					"content": "#{F#Cô}{M#Cậu} đến giúp phải không? Cuối cùng cũng đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880103,
					"content": "Tôi làm ở tửu trang này đã lâu như vậy, lần đầu tiên bị Hilichurl cướp... ui da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "Nếu hai người đến muộn một chút nữa, tôi thật không biết phải làm sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#Yên tâm đi, chỉ là Hilichurl thôi mà, {NICKNAME} đánh giỏi lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880106,
					"content": "Đánh được là tốt, vậy thì <color=#00E1FFFF>Khí Cầu Vận Chuyển</color> này giao cho hai người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880107,
					"content": "Nhưng đừng chỉ lo giải quyết Hilichurl nhé, nhớ phải <color=#00E1FFFF>đảm bảo hàng hóa an toàn</color>, nếu không tôi đền không nổi đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880108,
					"content": "#Vậy nhé, tôi ra phía trước đợi {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "Ernest"
				}
			]
		},
