			"dialogs": [
				{
					"id": 4880001,
					"content": "Tiểu thư Lisa? Không lẽ đến để đưa báo cáo thuế à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880002,
					"content": "Ồ, đứa trẻ đáng yêu. Cưng nói đúng, chị đã nghe chuyện Jean bị bệnh, nên công việc văn thư chị phải giúp một tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880003,
					"content": "Thế à, xem ra ở đây không có việc của chúng tôi nữa, vậy chúng tôi đi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880004,
					"content": "A, đợi một chút, thật ra ngài Charles bên này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880005,
					"content": "Để tôi nói cho, tiểu thư Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880006,
					"content": "Lúc nãy, tôi nhận được một số đơn hàng. Hàng trong kho của tiệm không đủ, hàng đặt của tửu trang thì vẫn chưa đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880007,
					"content": "Nếu tiện, phiền hai vị <color=#00E1FFFF>đi xem tình hình xe hàng một chút</color> được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880008,
					"content": "Hở, đơn hàng gấp như vậy sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880009,
					"content": "Cũng hết cách, đơn hàng vừa mới nhận được thật làm khó người khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880010,
					"content": "Ừ, ừ, là như vậy, như ngài Charles nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880011,
					"content": "Được rồi, tôi đi xem thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "Được, lần sau nhớ mời tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "#Haha, lần sau khi ông chủ Diluc có ở nhà, nhất định sẽ đãi {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880014,
					"content": "Ừm, như vậy còn được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
