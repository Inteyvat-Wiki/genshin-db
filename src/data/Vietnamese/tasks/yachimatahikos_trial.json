			"dialogs": [
				{
					"id": 722680101,
					"content": "Ta là Jibashiri - Uda. Dũng sĩ Sangonomiya, ta thừa nhận ngươi xứng đáng để thực hiện khiêu chiến này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680102,
					"content": "Ta sẽ chủ trì thí luyện \"trí tuệ\". Hãy giải tất cả các câu đố, để \"Ngọn Lửa Cửa Cao\" trở về vị trí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680103,
					"content": "Nếu như không đủ thông minh và dũng cảm thì chẳng qua là lỗ mãng, không xứng với danh hiệu dũng sĩ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680104,
					"content": "Ta sẽ đứng ở Tháp Tam Giới đợi ngươi hoàn thành khiêu chiến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
		},
