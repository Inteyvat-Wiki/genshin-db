			"dialogs": [
				{
					"id": 760540101,
					"content": "Ấy? Columbina đâu nhỉ? Sao không thấy cô ấy vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Tôi ở bên này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540103,
					"content": "Woa! Cô ở trên cao như vậy làm gì thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Lên đây đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540105,
					"content": "Hửm? Lần này lại muốn làm gì nữa đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "Còn nhớ những viên đá lần trước chúng ta ra ngoài thu thập không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540107,
					"content": "Lần trước? À, là loại khoáng thạch hấp thụ Kuuvahki là sẽ phát sáng ấy hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Đúng vậy. Sau đó các Kuuhenki lại thu thập thêm một ít, tôi đã xử lý những viên đá đó, rồi chia làm hai loại là màu đậm và màu nhạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540109,
					"content": "Màu đậm và màu nhạt? Sao lại thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "Tất nhiên là để chơi \"Cờ Mặt Trăng\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540111,
					"content": "Hả? Cờ... Cờ Mặt Trăng là cái gì cơ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "Hai người chưa từng chơi à...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540113,
					"content": "Chưa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "Vậy sao... Trước đây khi thấy bọn trẻ ở Dòng Dõi Sương Nguyệt vẽ ô trên mặt đất là tôi đã muốn chơi thử rồi. Nhưng không ai chơi cùng cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540115,
					"content": "Vậy quy tắc cụ thể như thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Hmm... Nói thế này sẽ dễ hơn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540117,
					"content": "Woa! Đỉnh quá... Sao cô làm được vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Hmm? Chỉ đơn giản là dùng Kuuvahki thôi, hai người không làm được hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540119,
					"content": "Đừng có lấy tiêu chuẩn của thần linh ra để yêu cầu chúng tôi thế chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "Được rồi. Đây là bàn cờ, hoặc có thể nói là \"bầu trời đêm\" trong trò chơi. Sau đó quân cờ trong tay hai người đại diện cho \"mặt trăng\" đang sở hữu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540121,
					"content": "Hai người luân phiên đặt \"mặt trăng\" lên \"bầu trời đêm\". Ba mặt trăng của ai xếp thành một hàng trước thì người đó thắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540122,
					"content": "Ồ! Tóm lại là trò chơi ba quân cờ xếp thành một hàng đúng không!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "Hóa ra trò này ở Nod-Krai tên là Cờ Mặt Trăng... Đúng là có đặc sắc của địa phương...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "Nhưng mà, \"mặt trăng\" sẽ luân phiên thay thế, trên trời không thể có hơn ba mặt trăng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540125,
					"content": "Vì thế, khi \"mặt trăng\" trên \"bầu trời đêm\" đạt số lượng nhất định, mặt trăng đầu tiên nhô lên sẽ biến mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540126,
					"content": "Cũng có lý lắm... Coi như tăng thêm độ khó cho trò chơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "Ừm, có muốn chơi thử không? Tôi cũng lần đầu tiên chơi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540128,
					"content": "(Cô ấy dường như đang rất mong chờ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#Hihi, vậy để tôi làm trọng tài nhé. {NICKNAME} đầu óc không tồi đâu, cô phải cẩn thận đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
