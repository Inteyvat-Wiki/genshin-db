				},
				{
					"id": 760540302,
					"content": "Để tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540303,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540304,
					"content": "Mặt trăng... Mặt trăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540305,
					"content": "Ở đây thì thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540306,
					"content": "Lần này tôi thắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540307,
					"content": "Ba mặt trăng của tôi xếp thành một hàng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540308,
					"content": "Ừm, thế là thắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540309,
					"content": "Hmm... Trăng lên rồi trăng lặn, đúng là quãng thời gian dài.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540310,
					"content": "Mặt trăng của chúng ta chẳng nhường nhịn nhau chút nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540311,
					"content": "Có phải... hòa rồi không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540312,
					"content": "#Thì ra {F#cô}{M#cậu} thích suy nghĩ thấu đáo rồi mới đưa ra quyết định. Hmm, không sao, chúng ta có nhiều thời gian mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540313,
					"content": "Quên mất cách đặt \"mặt trăng\" lên \"bầu trời đêm\" sao? Có cần tôi giúp không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540314,
					"content": "Không thích trò chơi này sao? Tôi thấy cũng thú vị lắm mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540315,
					"content": "#Hửm? {F#Cô}{M#Cậu} đang nhìn tôi à? Tôi cảm nhận được đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540316,
					"content": "Trên mặt tôi... có đáp án về mặt trăng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540317,
					"content": "Bàn cờ ở bên kia kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540318,
					"content": "#Ừm, mặt trăng của {F#cô}{M#cậu} thắng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540319,
					"content": "#Bầu trời đêm này thuộc về {F#cô}{M#cậu}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540320,
					"content": "Ah... Sơ suất một chút thôi mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540321,
					"content": "Cùng Columbina trải qua thời gian chơi trò chơi vui vẻ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Cảm ơn nhé, tôi đã chơi rất vui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540323,
					"content": "Nếu có thể, lần sau lại tới chơi với tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760540324,
					"content": "Coi đây là minh chứng cho lời hứa nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		}
	]
