			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Melo Lombroso",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "Phu nhân Mero! Bà làm gì ở đây thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810102,
					"content": "Ấy? Là các vị à... Nghe nói ông chồng bất tài của tôi có một cái ổ ở đây, nên tôi muốn đến xem ông ta sống ra sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810103,
					"content": "Không ngờ là, tôi tìm thấy cái này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810104,
					"content": "Ông ta thế mà lại còn mang bức ảnh này theo bên người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810105,
					"content": "Hihi, chú Rocher vẫn còn rất quan tâm tới phu nhân đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810106,
					"content": "Khi trước lúc chúng tôi nghi ngờ phu nhân, chỉ có chú Rocher nói vô cùng chắc chắn rằng, phu nhân tuyệt đối không thể là phạm nhân!Tuy không biết lúc đó chú ấy lấy đâu ra tự tin như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810107,
					"content": "Có thể đó là toàn bộ chút khí phái đàn ông của chú ấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "Ồ? Có thật không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810109,
					"content": "Thật mà thật mà! Còn nữa nha, có phải hồi trước chú ấy đã nói là, bởi vì đánh bạc mà thua mất dây chuyền của phu nhân không? Thật ra là chú ấy lừa cô đó! Chú ấy ngại không dám nói ra sự thật mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810110,
					"content": "Cái đó hả, thực ra chuyện đó tôi biết lâu rồi, tôi chưa từng tin chuyện như thế xảy ra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810111,
					"content": "Hả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810112,
					"content": "Chồng tôi có rất nhiều khuyết điểm, có hơi nhát gan, có hơi nhu nhược, lại có chút kỳ cục, nhưng tôi biết ông ấy là con người thật thà, cũng có thể là bị người ta lừa gạt, nhưng ông ấy tuyệt đối không phải là một tay cờ bạc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810113,
					"content": "Tôi không vạch trần điều đó, tôi chỉ muốn đợi ông ấy chủ động nói thật với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810114,
					"content": "Ôi...Tốt quá...Tiếc là không biết bây giờ chú ấy đi đâu mất rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810115,
					"content": "(Suỵt... Mọi người nhìn bên kia kìa, tôi chắc chắn 100% là ông ấy đang trốn trong cái rương đằng kia.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810116,
					"content": "(Hả?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810117,
					"content": "(Ôi ôi...Giống y như trước đây, khi mà chúng tôi cãi nhau, ông ấy sẽ lặng lẽ trốn vào tủ áo, còn tưởng là tôi không biết nữa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810118,
					"content": "(Có cần tôi giúp gọi chú ấy ra không?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "(Không cần phải phiền thế, hôm nay tôi nhất định phải nhìn xem, ông ấy còn tính trốn đến lúc nào.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810120,
					"content": "À đúng rồi, còn có một chuyện nữa, quả thật phải làm phiền hai vị, nếu hai vị gặp được đặc vụ Curve và Talochard, hãy giúp tôi chuyển lời cho họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810121,
					"content": "Tôi đã dọn dẹp xong mấy gian phòng rồi, rất hoan nghênh họ đến ở vài hôm.Tất nhiên, gia đình Lombroso cũng luôn chào đón hai vị.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810122,
					"content": "#{NICKNAME}, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810123,
					"content": "Được thôi phu nhân, chúng tôi đã biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "Ừm... thôi được rồi, vậy chúng tôi không quấy rầy phu nhân nữa! Mong là chú Rocher có thể sớm bước ra đối diện với chính mình!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810125,
					"content": "Cảm ơn nhé, cũng chúc cho hai vị sau này dù có gặp phải vấn đề gì đi nữa, cũng đều thuận lợi tìm được câu trả lời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Melo Lombroso"
				}
			]
		},
