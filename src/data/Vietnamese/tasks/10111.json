			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "Nhà Lữ Hành, tôi có một phát hiện nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110602,
					"content": "Bạn có thể mở máy dò lên không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110603,
					"content": "Ơ? Stanley cũng có người bạn tưởng tượng?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110604,
					"content": "Xem ra bạn của ngài ấy là một chiến sĩ từng chinh chiến sa trường... Khắp người là sẹo, biểu cảm cũng rất cứng rắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110605,
					"content": "Giống như chính mình trong mô tả của Stanley.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "Lẽ nào người bạn tưởng tượng của ngài ấy là lý tưởng hóa chính mình?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110607,
					"content": "Thật thú vị. Nhưng thật vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110611,
					"content": "Vậy thì, tôi đi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110612,
					"content": "Tạm biệt ngài Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110613,
					"content": "Cho hỏi hai bạn có rảnh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110614,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110615,
					"content": "Thật ra mấy hôm trước ngài Stanley uống say, đã nói cho tôi nghe một vài bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110616,
					"content": "Vũ khí ngài ấy dùng khi mạo hiểm là di vật của anh hùng Vennessa, <color=#00E1FFFF>\"kiếm dũng khí huy hoàng\"</color> và <color=#00E1FFFF>\"khiên ý chí tỏa sáng\"</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110617,
					"content": "Nói sợ bạn không tin, hai vũ khí này vẫn còn ở Mondstadt, chính là trong <color=#00E1FFFF>Hẻm Núi Dadaupa</color> đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110618,
					"content": "Các bạn lợi hại như vậy, có thể cùng tôi đi tìm hai thần khí đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110619,
					"content": "Có vũ khí lợi hại như vậy sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "Đương nhiên là có rồi! Dù sao đó cũng là ngài Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110623,
					"content": "Nếu tìm được thứ đủ lợi hại để chứng minh bản thân, không chừng gia đình sẽ ủng hộ tôi trở thành nhà mạo hiểm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110624,
					"content": "Bây giờ tôi vẫn chỉ là người mới chưa đủ năng lực, mà bố mẹ tôi lại kiên quyết phản đối lý tưởng của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110625,
					"content": "Xin bạn đấy, giúp tôi đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110626,
					"content": "Tôi không dám nói ra suy nghĩ ích kỷ này với ngài Stanley... Nhưng tôi đảm bảo, dùng xong tôi sẽ trả lại ngay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110627,
					"content": "Thật đáng thương... Này, chúng ta giúp bạn ấy đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110628,
					"content": "Được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "Venti, bạn có muốn tham gia không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110631,
					"content": "Chuyện này... Ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110632,
					"content": "Năm trước tôi nhờ người tìm một bình rượu quý, chỉ cần giúp tôi tìm được thần khí, rượu sẽ là của bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110633,
					"content": "<color=#00E1FFFF>Hẻm Núi Dadaupa</color> đúng không?! Việc không thể chậm trễ, chúng ta đi thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110629,
					"content": "Không thể nhắm mắt làm ngơ được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "Anh ấy tùy tiện vứt thần khí ở ngoài đường sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "Người giỏi luôn có sở thích kì lạ mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
