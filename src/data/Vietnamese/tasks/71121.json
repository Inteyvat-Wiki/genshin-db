			"dialogs": [
				{
					"id": 711210201,
					"content": "Vô cùng cảm ơn! Nếu không có các vị cứu giúp thì hàng hóa của tôi coi như tiêu rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "Thương Nhân Kỳ Quái"
				},
				{
					"id": 711210202,
					"content": "Đừng khách sáo, trên người tôi không có nhiều tiền, xin hãy nhận những thứ này xem như thù lao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
