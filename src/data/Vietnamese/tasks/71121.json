						711210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711210204,
					"content": "Haha, các vị đừng nói vậy, hy vọng lần sau chúng ta còn có cơ hội gặp mặt!",
					"roleType": "TALK_ROLE_NPC",
