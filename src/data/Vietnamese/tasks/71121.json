			"dialogs": [
				{
					"id": 711210301,
					"content": "Xin, xin tha mạng... Ối, là các vị sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Thương Nhân Kỳ Quái"
				},
				{
					"id": 711210302,
					"content": "Là anh sao?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Haha, thật là trùng hợp... Các vị cứ bận việc của mình đi nhé, tôi đi trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Thương Nhân Kỳ Quái"
				},
				{
					"id": 711210304,
					"content": "Tôi đề nghị hai vị xem thử xem bọn chúng đã để lại bảo vật gì... Đừng lo cho tôi, tôi đã lập hồ sơ bọn chúng rồi... Đồ cần trả lại thì cứ để tôi đi trả là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Thương Nhân Kỳ Quái"
				},
				{
					"id": 711210305,
					"content": "Đợi đã...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "Không sao, dù sao thì sau này chúng ta vẫn còn cơ hội gặp lại mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thương Nhân Kỳ Quái"
				}
