			"dialogs": [
				{
					"id": 3532801,
					"content": "Này, có phải đã cảm nhận được \"Nguyên Tố\" của thế giới này phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532802,
					"content": "Xem ra, bạn chỉ cần chạm vào Thần Tượng, là có thể nhận được sức mạnh Nguyên Tố Phong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532803,
					"content": "Những người ở thế giới này muốn có được sức mạnh, sẽ không dễ dàng như bạn vậy đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532804,
					"content": "Nguồn gốc sức mạnh... quả nhiên là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "Ừ, vì bạn vốn dĩ không phải người của thế giới này mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532809,
					"content": "Từ đây đi về hướng tây, là có thể đến thành phố tự do Mondstadt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532817,
					"content": "Mondstadt là thành phố của gió, thờ phụng Phong Thần trong bảy vị thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532810,
					"content": "Bạn có thể nhận được sức mạnh từ Thần Tượng, có khi nào sẽ tìm được manh mối ở đó...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532811,
					"content": "#Hơn nữa, Mondstadt có rất nhiều nhà thơ lang thang, không biết chừng có manh mối về {M#em gái}{F#anh trai} của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532812,
					"content": "Được, vậy thì xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532813,
					"content": "Nguyên Tố của thế giới đã trả lời sự cầu nguyện, tôi thấy đây là một khởi đầu tốt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532807,
					"content": "Thật là quái dị.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "\"Quái dị\" từ này thật là bất kính với Thần!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
