					"nextDialogs": [
						207420504
					]
				},
				{
					"id": 207420504,
					"content": "... Tôi sẽ nhận số hạt giống này, lát nữa tôi sẽ đi trồng lại một chậu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
