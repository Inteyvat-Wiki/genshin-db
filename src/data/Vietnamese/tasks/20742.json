					"nextDialogs": [
						207420102
					]
				},
				{
					"id": 207420102,
					"content": "A! Bồ công anh! Bay hết rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420103
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420103,
					"content": "Bạn làm gì vậy! Chậu bồ công anh này khó khăn lắm mới",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420104,
					"content": "Tôi đang giúp nó bay đến nơi xa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420105
					]
				},
				{
					"id": 207420105,
					"content": "Đây là trong thành! Bay không được bao xa rồi cũng sẽ đụng phải tường thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420106,
					"content": "Như vậy sẽ mọc lên thêm nhiều bồ công anh hơn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420107
					]
				},
				{
					"id": 207420107,
					"content": "Vậy bạn lấy hạt giống bồ công anh đem đến ngoài thành thả bay không phải được rồi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420108
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420108,
					"content": "Huhu... Bồ công anh của tôi, khó khăn lắm mới trồng được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420109,
					"content": "Bạn... bạn, nếu cần bồ công anh thì ra ngoài thành hái là được rồi mà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420110,
					"content": "Hơn nữa... Hạt giống chậu bồ công anh này cũng là bạn nhặt giúp tôi, tôi chăm sóc bao lâu nó mới lớn được... bạn đối xử với nó như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
