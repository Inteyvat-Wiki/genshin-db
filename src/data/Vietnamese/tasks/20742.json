				{
					"id": 207420702,
					"content": "Ơ, sao... Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420703
					]
				},
				{
					"id": 207420703,
					"content": "Bạn! Donna nói cho tôi biết rồi, cô ấy thấy bạn thổi bay bồ công anh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420704
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420704,
					"content": "Xin lỗi, chuyện đó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420705
					]
				},
				{
					"id": 207420705,
					"content": "Donna nói cho tôi biết rồi, là bạn thổi bay bồ công anh đúng không?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420706
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420706,
					"content": "Nếu bạn cần hạt giống bồ công anh, đến dã ngoại hái chẳng phải được rồi sao, cây hoa này tôi chăm sóc bao lâu nay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420707
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420707,
					"content": "Hơn nữa... Hạt giống chậu hoa này cũng là bạn thu thập giúp tôi... bạn đối xử với nó như vậy sao?",
