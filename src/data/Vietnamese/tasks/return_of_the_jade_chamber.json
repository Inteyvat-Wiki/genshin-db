				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Xin chào, bạn muốn mua sách gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "Tôi muốn mua \"Quặng Châu Báu\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "Quặng Châu Báu? Quyển này chỗ tôi không có... Bạn cần gấp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "Về việc xây lại Quần Ngọc Các...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Ơ? Quần Ngọc Các sắp xây dựng lại sao? Vậy thì phải chuẩn bị cho tốt, tôi nghĩ xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Nếu không bạn có thể đi hỏi Qingzhou, Qingzhou từng đọc rất nhiều sách, nói không chừng Qingzhou biết ở đâu có quyển Quặng Châu Báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Tôi nhớ Qingzhou thường hay ở Nhà Trọ Vọng Thư, bạn có thể đến đó tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
