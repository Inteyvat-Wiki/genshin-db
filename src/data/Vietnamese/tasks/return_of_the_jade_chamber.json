			},
			"dialogs": [
				{
					"id": 718130701,
					"content": "Cháu đuổi hết lũ lợn rừng đó đi rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "Ông Lu"
				},
				{
					"id": 718130702,
					"content": "Đuổi đi hết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Vậy được rồi, lát nữa ông sẽ đi lấy trúc, sau khi làm xong ông sẽ trực tiếp đưa đến Nguyệt Hải Đình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "Ông Lu"
				},
				{
					"id": 718130704,
					"content": "Đơn hàng này cũng khá lớn, có lẽ sẽ kiếm được không ít tiền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ông Lu"
				}
			]
		},
