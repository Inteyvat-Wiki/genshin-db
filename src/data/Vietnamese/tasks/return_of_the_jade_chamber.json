			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "Khó viết, đúng là khó viết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130302,
					"content": "Về \"Quặng Châu Báu\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "Quặng Châu Báu? Ừm, tôi nhớ quyển sách đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130304,
					"content": "Tôi đã từng sưu tầm tài liệu để viết một bài thơ về những người buôn bán, và tình cờ đọc được quyển sách này ở một nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130305,
					"content": "Mặc dù tôi không hiểu những điều trong cuốn sách đó viết, nhưng một số ví dụ cũng đã truyền cảm hứng cho tôi làm thơ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130306,
					"content": "Để tôi nhớ xem là bài thơ nào, bạn chờ chút...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130307,
					"content": "Bạn có nhớ quyển sách đó ở đâu không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Các bạn muốn tìm quyển sách đó? Vậy thì tôi không nhớ nó nằm ở đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130309,
					"content": "Nhưng nếu các bạn cần gấp, tôi có thể viết ra cho các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130310,
					"content": "Viết tay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "Ừm, nội dung quyển sách đó cũng không dài, cũng không khó nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130313,
					"content": "Hơn nữa khi tôi xem quyển Quặng Châu Báu đó, người sưu tập sách cũng không cho tôi mượn về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130314,
					"content": "Nhưng làm thơ đâu phải chuyện một sớm một chiều... Thế là tôi đã chép lại một bản, vì nội dung cũng không quá dài, nên tôi cũng thuộc tương đối rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130315,
					"content": "Đây là thực lực của nhà thơ sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "Không dám, không dám. Nhưng mà... tôi viết sách cho bạn thì bạn cũng giúp tôi một việc nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130317,
					"content": "Nói ra cũng ngại, tôi mải thu thập tài liệu nên quên ăn cơm, bây giờ có hơi đói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130318,
					"content": "Giúp tôi lấy một phần Khấu Tam Tư đến đây nhé, tôi cũng sẽ ở đây để giúp các bạn viết lại Quặng Châu Báu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130319,
					"content": "Đến khi các bạn quay lại chắc tôi cũng viết xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130311,
					"content": "Bạn nhớ được hết sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
