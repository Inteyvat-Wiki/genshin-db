			"dialogs": [
				{
					"id": 718130601,
					"content": "Ơ? Có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Ông Lu"
				},
				{
					"id": 718130602,
					"content": "Cháu muốn đặt một số đồ trang trí bằng trúc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Đồ trang trí bằng trúc? Ông làm được, nhưng mà đơn hàng này từ đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Ông Lu"
				},
				{
					"id": 718130604,
					"content": "Đây là danh sách của Baiwen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Ồ... Là của Nguyệt Hải Đình, được rồi, ông sẽ cố gắng làm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Ông Lu"
				},
				{
					"id": 718130606,
					"content": "Nhưng ở rừng trúc ông hay lấy, không biết tại sao gần đây đột nhiên xuất hiện rất nhiều lợn rừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Ông Lu"
				},
				{
					"id": 718130607,
					"content": "Tuy cũng không ảnh hưởng gì nhiều, nhưng ông phải đi vòng qua bọn chúng để lấy trúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Ông Lu"
				},
				{
					"id": 718130608,
					"content": "Nếu các cháu có thể đuổi lũ lợn rừng đó đi, ông sẽ có thể đi lấy trúc về làm ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Ông Lu"
				},
				{
					"id": 718130609,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "Vậy ông sẽ chờ cháu ở đây, cháu đuổi được lũ lợn rừng đó đi rồi thì quay về báo cho ông biết nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ông Lu"
				}
			]
		},
