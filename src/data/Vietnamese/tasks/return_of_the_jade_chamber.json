					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "\"Sự bất tử của Liyue, sự gắn bó của nhân thế, được tiến hành từ từ theo kế hoạch này...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130502,
					"content": "Bạn về rồi à, chờ chút, tôi còn mấy câu cuối cùng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130503,
					"content": "Ừm... Được rồi, viết xong rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130504,
					"content": "Đây là Khấu Tam Tư...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "Không vội không vội, bạn xem quyển sách này trước đi, tôi tự thấy thư pháp mình cũng ổn, chữ viết có lẽ xem được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130506,
					"content": "Đây là thực lực của nhà thơ sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "Hahaha, quá khen quá khen. Bạn cầm lấy, đừng để mất đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
