				},
				{
					"id": 718130802,
					"content": "Về vật tư cần chuẩn bị",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "Đây là... Quặng Châu Báu, các bạn lấy được nó ở đâu vậy, tôi gần như tìm khắp Liyue rồi cũng không tìm được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130804,
					"content": "Là Qingzhou viết tay cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "Là nhà thơ đó? Xem ra đúng là danh bất hư truyền...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130806,
					"content": "Cảm ơn các bạn đã giúp tôi chuẩn bị những thứ này, đợi Ông Lu đưa đồ trang trí đến, tôi cũng sẽ trả số tiền tương ứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130807,
					"content": "Về việc xây lại Quần Ngọc Các...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "Việc xây dựng lại Quần Ngọc Các thật sự đã nằm trong kế hoạch, nhưng vẫn còn rất nhiều việc phải làm. Nên không thể xây dựng ngay được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130809,
					"content": "Và vấn đề lớn nhất là nguyên liệu, đến giờ tôi vẫn chưa tìm ra giải pháp. Tôi thật sự lo lắng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130810,
					"content": "Được rồi, không nói chuyện này nữa. Cảm ơn bạn một lần nữa vì đã giúp tôi chuẩn bị vật tư, hãy nhận số thù lao này, tôi phải đi làm việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
