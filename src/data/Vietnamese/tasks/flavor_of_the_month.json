			"dialogs": [
				{
					"id": 708001301,
					"content": "Sống, sống lại rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "Schuster Sợ Hãi"
				},
				{
					"id": 708001302,
					"content": "Là bạn nhóm lửa sao...thật là tốt bụng...cám ơn bạn, cám ơn bạn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "Schuster Sợ Hãi"
				},
				{
					"id": 708001303,
					"content": "Bạn vẫn ổn chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "Bây giờ đã ấm hơn rồi, may quá...may quá...Vốn dĩ tôi nhận lời ủy thác, vào Tuyết Sơn lấy \"Thịt Tươi Lạnh\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "Schuster Sợ Hãi"
				},
				{
					"id": 708001305,
					"content": "Ban đầu tôi tính tìm ở xung quanh Tuyết Sơn thôi, nhưng không ngờ bất cẩn làm rơi mất mồi lửa, lại bất cẩn lạc đường...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "Schuster Sợ Hãi"
				},
				{
					"id": 708001306,
					"content": "Nếu như không có bạn, tôi không biết phải làm sao, cám ơn bạn rất nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "Schuster Sợ Hãi"
				},
				{
					"id": 708001307,
					"content": "Còn về ủy thác của Brook...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "Là Brook nhờ bạn đến tìm tôi sao, ây...cô ấy nhất định là chờ đến sốt ruột rồi. Nhưng tôi quả thật không còn sức lực để vượt đường xa đem thịt trở về thị trấn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "Schuster Sợ Hãi"
				},
				{
					"id": 708001309,
					"content": "Tuy cũng rất ngại, nhưng có thể nhờ bạn giúp tôi đem \"Thịt Tươi Lạnh\" này về không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "Schuster Sợ Hãi"
				},
				{
					"id": 708001310,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "Xin cám ơn bạn. Tôi phải xuống núi quay về doanh địa, uống ngụm nước nóng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schuster Sợ Hãi"
				}
			]
