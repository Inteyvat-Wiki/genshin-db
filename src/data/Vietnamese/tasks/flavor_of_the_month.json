			"dialogs": [
				{
					"id": 708000201,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "Thực ra, tôi đang tính nghiên cứu một món ăn mới cho Lễ Hội Hoa Gió, theo chủ đề \"Hương vị của gió\", bây giờ đang chuẩn bị nguyên liệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000203,
					"content": "Nhưng mà, tôi rõ ràng đã nhờ Allan đến Hẻm Núi Minh Quán săn bắt thịt tươi sống, sao lâu như vậy mà anh ta vẫn chưa quay về...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000204,
					"content": "Nếu tiếp tục trì hoãn, không chừng những nguyên liệu đó không còn tươi nữa, Nhà Lữ Hành, có thể nhờ bạn đến Hẻm Núi Minh Quán xem thử không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000205,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "Vậy làm phiền bạn rồi, tôi sẽ mời bạn thưởng thức món mới của tôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
