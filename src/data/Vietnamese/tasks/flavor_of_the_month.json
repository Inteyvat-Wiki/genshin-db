			"dialogs": [
				{
					"id": 708000701,
					"content": "A, các bạn đến rồi à, thịt thú đã có chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000702,
					"content": "Đã đem đến rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "Ừm, để tôi xem...quả nhiên rất tươi, như vậy là được rồi. Nguyên liệu chính là số thịt này, giờ chỉ cần thêm một số phụ gia có \"hương vị của gió\" là được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000704,
					"content": "Ừm, nhắc đến phụ gia cho \"Hương Vị Của Gió\"...đương nhiên chính là \"Hạt Bồ Công Anh\" rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000705,
					"content": "Nhà Lữ Hành, bạn có thể giúp tôi thu thập một ít Hạt Bồ Công Anh không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000706,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "Vậy làm phiền bạn rồi, tôi đi xử lý thịt trước, sau khi thu thập Hạt Bồ Công Anh, hãy trực tiếp đem về cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
