			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "Được, được cứu rồi...thật lòng cám ơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000602,
					"content": "Không ngờ rằng, bắt con heo rừng mà cũng phiền như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000603,
					"content": "Về nguyên liệu mà Brook cần...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "Là Brook nhờ bạn đến sao? A...thật ra thịt tươi mà cô ấy cần, tôi đã lấy được rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000605,
					"content": "Nhưng lúc đuổi theo heo rừng tôi quá sơ suất, không cẩn thận làm kinh động ma vật xung quanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000606,
					"content": "Tuy rằng đã săn được heo rừng, nhưng bị đám ma vật đó bao vây rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000607,
					"content": "Nhà Lữ Hành, có thể nhờ bạn đem số thịt này cho Brook không, tôi phải vào thành trước, nhờ giáo hội chữa trị vết thương của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000608,
					"content": "Ây, sao lại ra nông nỗi này, ngài Draff sẽ lại mắng tôi cho xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
