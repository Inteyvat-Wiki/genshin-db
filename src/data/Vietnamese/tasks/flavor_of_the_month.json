					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001504,
					"content": "Anh ấy chắc đã không sao rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "Vậy thì tốt, may mà không xảy ra chuyện lớn...Đợi sau khi tôi làm xong món ăn, sẽ đem qua cho anh ấy nếm thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001506,
					"content": "Nhưng mà, \"Thịt Tươi Lạnh\" trông có vẻ rất khác với thịt bình thường, dùng nó làm nguyên liệu, không chừng sẽ chế biến ra được món ăn có cảm giác \"rộp rộp\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001507,
					"content": "Nhưng muốn món ăn có mang \"hương vị của gió\", thì cần có Hạt Bồ Công Anh làm phụ gia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001508,
					"content": "Nhưng nếu chỉ có như vậy, cảm giác không khác lắm với các món thịt bình thường, vẫn thiếu phụ gia mang tính quyết định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001509,
					"content": "Đúng rồi, đúng rồi! Sau trận quyết đấu đó, thực ra tôi có gặp Xiangling mấy lần, có từng nghe cô ấy nhắc đến món ăn có tên \"Slime Xào Nấm Rơm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001510,
					"content": "Nguyên liệu mới lạ này, tôi chưa từng dùng qua...Nhưng muốn làm ra món ăn mới lạ, thì phải thử nguyên liệu mới lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001511,
					"content": "Nhà Lữ Hành, vậy làm phiền bạn giúp tôi tìm Dịch Slime và Hạt Bồ Công Anh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001512,
					"content": "Tôi sẽ thử xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "Ừm, vậy xin làm phiền bạn rồi, tôi sẽ ở đây suy nghĩ công thức chế biến món ăn đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
