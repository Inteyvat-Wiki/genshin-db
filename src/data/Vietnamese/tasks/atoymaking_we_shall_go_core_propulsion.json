			"dialogs": [
				{
					"id": 726960201,
					"content": "Tiến độ thế nào rồi? Việc đánh bại sinh vật nguyên tố đối với một nhà mạo hiểm dày dặn kinh nghiệm như bạn chắc là không thành vấn đề đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
