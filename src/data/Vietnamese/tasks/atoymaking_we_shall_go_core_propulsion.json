				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960101,
					"content": "Hờ, nguy hiểm thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960102
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960102,
					"content": "Suýt chút nữa, chỉ một chút thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960103,
					"content": "Bertrand, sao lại mồ hôi đầy mặt vậy, cả người như đứng không vững nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960104,
					"content": "Không phải \"như đứng không vững\" mà là đã \"gục ngã\" luôn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960105,
						726960106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960105,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				},
				{
					"id": 726960107,
					"content": "Hihi, suýt nữa thì thất bại, may mà tôi nhanh tay nhanh mắt kịp thời điều chỉnh, cuối cùng cũng ổn định lại rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960108,
					"content": "Bây giờ những nguyên tố đó đang từng chút một kết hợp với nguyên liệu đã thu thập trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960109
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960109,
					"content": "Ôi, đúng là nguy hiểm thật, nếu không kiểm soát được sức mạnh nguyên tố thì tôi sẽ còn sáng hơn cả pháo hoa của nhà Naganohara mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960110,
					"content": "Lúc trước còn nói là sẽ không nổ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960111
					]
				},
				{
					"id": 726960111,
					"content": "Tôi nói là đồ chơi không nổ, chứ đâu có đảm bảo là máy chế tạo đồ chơi sẽ không nổ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960112
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960112,
					"content": "Nhưng cũng may lần này có các bạn giúp tôi thực nghiệm, nếu đưa vào sản xuất trực tiếp, chưa nói đến chuyện không sản xuất được món đồ chơi nào, mà ngay cả \"Cỗ Máy Khổng Lồ\" cũng không còn luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960113,
					"content": "Được rồi, bây giờ là công đoạn cuối cùng, đó là \"kích hoạt hạt nhân\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960114,
					"content": "Kích hoạt hạt nhân, theo những gì anh đã nói trước đây thì sẽ có liên quan đến các sinh vật nguyên tố phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960115,
					"content": "Đúng, trên người sinh vật nguyên tố có sức mạnh để giữ cho sức mạnh nguyên tố liên tục hoạt động. Truyền sức mạnh này vào máy, chính là công đoạn cuối cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960116
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960116,
					"content": "Nếu có thể sản xuất đồ chơi thành công, là có thể sản xuất liên tục, dùng đồ chơi để trả nợ, kiếm một khoản tiền lớn, và sống vui vẻ hạnh phúc ở Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960117,
					"content": "Hở? Anh không về Fontaine sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960118,
					"content": "Fontaine... Khụ, Fontaine à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960119
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960119,
					"content": "#{NICKNAME}, Paimon, các bạn chưa đến Fontaine bao giờ đúng không, nếu các bạn đã từng đến đó thì sẽ biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960120,
					"content": "Đối với một số người, đó là một đất nước dễ sống, nhưng đối với một số người khác thì đó chẳng qua chỉ là nơi của sự thất vọng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960121,
					"content": "Hệ năng lượng ở đó khá đặc biệt, không ai biết còn có thể duy trì được bao lâu. Trước khi sụp đổ thật sự thì việc tìm kiếm nguồn năng lượng thay thế là điều bắt buộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960122,
					"content": "Nhưng thay đổi luôn khó hơn tưởng tượng, và kết quả là... bây giờ tôi đành phải một mình nghiên cứu các nguồn năng lượng khác ngoài Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960123,
					"content": "Thật ra \"Cỗ Máy Khổng Lồ\" cũng là sản phẩm mà tôi nghiên cứu về năng lượng mới, nên cũng chưa ổn định cho lắm, nếu không để tâm thì sẽ có thể phát nổ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960124
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960124,
					"content": "Nhưng rồi sẽ có một ngày tôi nhất định sẽ tìm được một phương án tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960125,
					"content": "Đến lúc đó tôi sẽ khởi hành để quay về Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960126,
					"content": "Bertrand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960127,
					"content": "Không nói chuyện này nữa, bắt đầu công đoạn cuối cùng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960128,
					"content": "#Trước khi quay về Fontaine, tôi có thể sống thế nào ở Inazuma đều phụ thuộc vào bạn cả đó, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960106,
					"content": "Phản ứng nguyên tố thất bại rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				}
			]
		},
