					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960301,
					"content": "Bây giờ tất cả các công đoạn đã sẵn sàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960302
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960302,
					"content": "#Thế này đi, {NICKNAME}, bạn sẽ là người đặt \"Máy Thu Thập Nguyên Liệu\" lên máy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960303
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960303,
					"content": "Không biết đồ chơi làm ra sẽ thế nào, nôn nao quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960304
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960304,
					"content": "Anh cũng không biết đồ chơi làm ra sẽ như thế nào ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960305,
					"content": "Đây chính là điểm thú vị của \"Cỗ Máy Khổng Lồ\", hahaha, vì nó sẽ xử lý những nguyên liệu khác nhau để làm ra những món đồ chơi khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960306
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960306,
					"content": "Món đồ chơi làm ra sẽ phụ thuộc vào những gì bạn mang đến, nào, mau thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269604,
			"completionStepIds": [
				7269605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269605",
							"2"
						],
						"stepId": 7269605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960401,
					"content": "Đây thật sự là đồ chơi do máy móc Fontaine làm ra sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960402,
					"content": "...Tôi cứ thấy nó không phù hợp với ấn tượng về Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960403
					]
				},
				{
					"id": 726960403,
					"content": "Chiếc máy chỉ làm ra robot đồ chơi theo phong cách Fontaine, đương nhiên sẽ không thể thương mại hóa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960404
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960404,
					"content": "Thật không giấu gì, điều này giúp tôi hiểu thêm về văn hóa của nơi này, chỉ khi có được lòng dân thì mới có thể được chào đón.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960405
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960405,
					"content": "Được chào đón thật sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960406,
					"content": "E hèm... Lúc đầu chắc chắn sẽ bị hiểu lầm, nhưng chỉ cần kiên trì, cải tiến sản phẩm, chắc chắn sẽ có thể gây ấn tượng với họ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960407
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960407,
					"content": "Tóm lại, vậy là hoàn thành xong một lần chế tạo rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960408
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960408,
					"content": "Thế nào, có hứng thú không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960409
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960409,
					"content": "Cũng bình thường.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960410
					]
				},
				{
					"id": 726960410,
					"content": "Hừm, hiểu rồi, tỷ lệ nguyên liệu thế này sẽ làm ra được đồ chơi thế này, vậy thì tôi cho nó vào kho của tôi trước, còn phiếu này cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960417
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960417,
					"content": "Tấm phiếu này có thể đổi miễn phí lấy robot với tạo hình tương tự, nếu bạn thích tạo hình này thì sau khi ổn định sản xuất có thể mang tấm phiếu này đến đổi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960418
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960418,
					"content": "Ừm ừm... dù sao cũng là robot đầu tiên sản xuất được, tôi phải kiểm tra một chút, cứ mãi làm ra đồ chơi bị nổ thì không được đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960411
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960411,
					"content": "Vấn đề ghi chép thử vận hành sản xuất... Tôi xem xem, muốn tăng hiệu quả thì phải điều chỉnh một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960412
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960412,
					"content": "Không ngờ liên quan đến những việc này anh lại nghiêm túc như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726960413,
					"content": "Đương nhiên rồi, tôi chỉ có một mình, tất cả những gì tôi có thể dựa vào là máy móc và quy trình sản xuất thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960414
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960414,
					"content": "Mặc dù tất cả đều bị Lính Tuần Tra xem là \"thủ đoạn kỳ lạ\", hừm, đừng có mà xem thường \"thủ đoạn kỳ lạ\" nghiêm túc này nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960415
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960415,
					"content": "Trước tiên, tôi sẽ thực hiện một số điều chỉnh, để sau một thời gian nữa, tôi sẽ có thể chính thức bắt đầu công việc kinh doanh sản xuất của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960416
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726960416,
					"content": "#Lúc đó bạn nhất định phải đến giúp đó nha, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
