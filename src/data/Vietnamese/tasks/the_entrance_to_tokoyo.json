					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "Phế tích bên kia có vẻ khá gần, chúng ta bắt đầu thám hiểm từ đó trước đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "Có kiến trúc chứng tỏ có người, mà có người thì sẽ có mảnh giấy để lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
