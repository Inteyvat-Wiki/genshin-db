			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "Hình như có một linh hồn xuất hiện...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480302,
					"content": "Ta là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480303,
					"content": "Ta là người xây dựng Helios, tên là: Aberaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480304,
					"content": "Sao ta có thể bị đánh gục bởi những lời nói năng xằng bậy của các ngươi chứ, sao ta có thể bị giam cầm bởi những thủ đoạn trẻ con của các ngươi được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480305,
					"content": "Ta... không đúng, ta... ta đã trải qua những năm tháng bị giam cầm vô tận, lúc này đã là... cơ thể sau một kiếp người rồi chăng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480306,
					"content": "Sau một kiếp người? Ý nói bản thân đã chết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480307,
					"content": "Những linh hồn có thể ý thức được việc này rất hiếm gặp đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480308,
					"content": "Nói ra thật hổ thẹn, nhưng ta đã không còn nhớ vì sao mình lại chết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480309,
					"content": "Điều còn sót lại trong ký ức, chính là ta bị một đứa trẻ ra lệnh tống giam đến chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480310,
					"content": "Một đứa trẻ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480311,
					"content": "Đúng thế, nhưng đến hôm nay, khi nhắc về đứa trẻ đó, ta cũng không cảm thấy oán hận nữa, chỉ thấy thật đáng thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480312,
					"content": "Kẻ sai không phải là nó, kẻ sai chính là người đã xem nó như con rối trong lòng bàn tay... thôi bỏ đi, không nhắc nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480313,
					"content": "Sau đó, ta bị giam cầm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480314,
					"content": "Giam cầm ở một nơi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480315,
					"content": "Một nơi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480316,
					"content": "Một nơi rất cao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480317,
					"content": "Tuy rất cao, nhưng nơi này lại tối tăm u ám, lạnh như động băng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480318,
					"content": "...Ơ kỳ lạ, vì sao nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480319,
					"content": "Sao ta lại nghĩ rằng ở nơi cao thì phải khiến người ta ấm áp khoan khoái nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480320,
					"content": "Tại sao... tại sao ta không nhớ được gì cả?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480321,
					"content": "Chẳng lẽ vì đói bụng sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480322,
					"content": "Lúc tôi đói, đừng nói gì đến việc suy nghĩ, ngay cả nói chuyện thôi cũng không nói nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480323,
					"content": "Tôi nghĩ không phải nguyên nhân này đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "Chắc chắn luôn! Bạn xem đi, ông ta nói chuyện còn không rõ nữa kìa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480327,
					"content": "#{NICKNAME}, bạn tìm thử xem, nhỡ đâu trong số cống phẩm có gì đó ăn được thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480328,
					"content": "Đúng rồi! Cống phẩm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480329,
					"content": "Sao vậy, muốn ăn cống phẩm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480330,
					"content": "Không, ta nhớ ra rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480331,
					"content": "Sau khi ta bị giam cầm đến chết, vì có công xây dựng Helios, nên thân thể và trang phục được cất giữ ở nhiều nơi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480332,
					"content": "Cũng vì vậy mà hồn phách của ta bị phân ly, khiến cho linh hồn bất an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480333,
					"content": "Nơi này lẽ ra phải là nơi an nghỉ của chiếc vương miện thiêng liêng của ta, mặc dù giờ chắc là nó đã mục nát. Đây có lẽ là lý do tại sao suy nghĩ của ta đang bị tắc nghẽn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480334,
					"content": "Nếu việc này tiếp tục kéo dài thì e rằng đến cả trạng thái hiện giờ cũng khó mà bảo toàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480335,
					"content": "Nhưng may mà trong cống phẩm có vài thứ có thể thay thế cho hài cốt và trang phục của ta, để ta có thể suy nghĩ được một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480336,
					"content": "Phiền ngươi mang chúng theo nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480337,
					"content": "Nhưng mà trên đường có lẽ sẽ có rất nhiều trắc trở, tuy hơi mạo phạm, nhưng hy vọng ngươi có thể tiếp nhận một khảo nghiệm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480338,
					"content": "Khảo nghiệm? Khảo nghiệm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480339,
					"content": "Phiền các ngươi tiêu diệt ma vật canh giữ tàn hồn của ta ở xung quanh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480340,
					"content": "Việc này vô cùng nguy hiểm, nhà lữ hành, nếu ngươi đã chuẩn bị xong thì hãy nói với ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480325,
					"content": "Tôi có thức ăn dự trữ nè...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "Ê!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
