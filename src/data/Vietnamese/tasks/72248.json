					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480201,
					"content": "...Nếu lúc đó Vương Quốc Đêm Trắng có dũng sĩ như ngươi, có lẽ sẽ không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480202,
					"content": "Haiz, nếu việc này thành công, thì xem như tâm nguyện của ta cũng đã được hoàn thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480203,
					"content": "Nhất định, nhất định phải mang những vật hiến tế được gửi gắm tâm niệm của ta đến nơi giam giữ để hiến tế, thì mới có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480204,
					"content": "Thì mới có thể gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480205,
					"content": "Mới có thể... mới có thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480206
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480206,
					"content": "Ừm, ngài linh hồn này hình như bị hồn bay phách tán rồi, nói gì cũng không có phản ứng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480207,
					"content": "#{NICKNAME}, vậy cứ mang cống phẩm theo trước đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480208,
					"content": "Nhưng vùng cao mà ông linh hồn bị giam giữ đó nói rốt cuộc là nơi nào chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224803,
			"completionStepIds": [
				7224805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224805",
							"2"
