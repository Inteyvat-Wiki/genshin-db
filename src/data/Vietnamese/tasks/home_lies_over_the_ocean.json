			]
		},
		{
			"id": 7280205,
			"completionStepIds": [
				7280205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280205",
							"2"
						],
						"stepId": 7280205,
						"stateName": "QUEST_STATE_UNFINISHED"
