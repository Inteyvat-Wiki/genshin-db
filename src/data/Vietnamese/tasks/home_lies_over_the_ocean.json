				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "Gia đình Atsuko chắc đều ở trong nhà rồi, chúng ta gõ cửa đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020502,
					"content": "Hình như họ đang nói gì đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "Kể ra thì, không biết con Tanuki mà chúng ta cứu trước kia như thế nào rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020504,
					"content": "Bà đó, lương thiện quá rồi, con Tanuki đó chẳng qua chỉ bị vết thương nhỏ trên chân, thực ra để nó lại trong bụi cỏ để nó tự dưỡng thương cũng sẽ khỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020505,
					"content": "Tôi không nỡ mà, khi đó nó nhìn tôi như sắp khóc rồi, đáng thương lắm, làm sao tôi có thể mặc kệ nó không đưa về nhà chăm sóc chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020506,
					"content": "Thôi bỏ đi, hành thiện là việc tốt, dù nó ăn cũng hơi nhiều, sắp đuổi kịp tôi rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020507,
					"content": "Gõ cửa",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "Ai đó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020509,
					"content": "Là Nhà Lữ Hành lần trước từng ghé qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "À, là Nhà Lữ Hành đó, chờ một lát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020511,
					"content": "Xin chào! Tôi là Atsuko, lần đầu...không...lại gặp rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020512,
					"content": "Xin lỗi, vì tôi quả thực rất nhớ nhà, nên sau khi đưa thư cho bạn, tôi lại thay đổi ý định và lên thuyền về nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020513,
					"content": "Ha ha...trước kia đều là hiểu lầm, xin lỗi nhé, để bạn phải đi một chuyến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020514,
					"content": "Bạn có cách trở về Inazuma sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "...À, tôi có kế hoạch của mình, ha ha, việc này bạn không cần lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020516,
					"content": "Còn thù lao tôi đã chuẩn bị sẵn rồi, bạn nhận giúp nhé, cảm ơn bạn đã giúp đỡ. Mau...ưm, tạm biệt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020517,
					"content": "Sao lời của Atsuko trước sau khác nhau vậy? Nếu quay về Inazuma dễ dàng như vậy, thì hồi trước còn phiền chúng ta làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020518,
					"content": "Tài sản của bạn ở Liyue thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "Tài sản? Tài sản gì cơ, tôi còn có tài sản ở Liyue sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020522,
					"content": "...A, những thứ này đều là vật ngoài thân, hoàn toàn không quan trọng so với người nhà, tôi sớm đã tặng cho người khác rồi, a...ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020523,
					"content": "Hi hi, Atsuko thật đang vất vả tìm công việc ở Liyue, làm sao có thể thoắt cái đã biến thành người có tiền chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020524,
					"content": "Rốt cuộc bạn là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "Tôi...tôi đương nhiên là Atsuko rồi! Nhìn giống hệt Atsuko, giọng nói là của Atsuko, điều này có gì để nghi ngờ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020526,
					"content": "Cái người này! Lì lợm quá...thôi bỏ đi, tôi không nói với bạn nữa, ngày mai tôi còn phải làm việc, đi trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020527,
					"content": "Ấy, Atsuko! Đứa bé này...sao lại đột nhiên tức giận như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020528,
					"content": "Xin lỗi nhé, Nhà Lữ Hành, đứa bé này chắc chắn là do làm việc mệt mỏi quá rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020529,
					"content": "Nhưng bạn cũng nhìn thấy đó, đây chắc chắn là con gái của chúng tôi, bức thư mà bạn đem đến kia... chắc là do con bé quên mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020530,
					"content": "Nhưng dù thế nào cũng cám ơn bạn đã giúp đỡ, về thù lao...bạn hãy chờ một lát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020531,
					"content": "Đã xảy ra chuyện gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "Không đâu, thù lao chúng tôi vẫn sẽ trả được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020534,
					"content": "Đứa trẻ Atsuko này, ban ngày không phải đi làm sao? Nhưng tiền lương mà nó mang về hằng ngày có chút kỳ lạ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020535,
					"content": "Có lúc là một ít hạt giống kỳ lạ, có lúc là một ít quả dại, chỉ là không có Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020536,
					"content": "Mặc dù những thứ này cũng đáng chút tiền, nhưng chúng tôi vẫn phải đem đi bán mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020537,
					"content": "Đối với Nhà Lữ Hành như bạn mà nói, nhận Mora chắc sẽ tiện hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020538,
					"content": "Phiền bạn ngày mai lại tới nhé, lúc đó tôi sẽ đưa Mora cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020532,
					"content": "Nếu như gặp khó khăn thì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "Ngôi nhà giàu có của bạn ở Liyue thì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "Nhà giàu? Nhà giàu gì cơ, tôi còn có nhà cửa giàu sang ở Liyue sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				}
			]
		},
