			"dialogs": [
				{
					"id": 728020301,
					"content": "Ngày mà con bé về nhà...sao lại còn sớm hơn cả ngày ký tên trong bức thư vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020302,
					"content": "Đừng nghĩ ngợi lung tung nữa, chắc chỉ là hiểu lầm, mau giúp tôi nghĩ xem bữa trưa ngày mai nấu gì đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
