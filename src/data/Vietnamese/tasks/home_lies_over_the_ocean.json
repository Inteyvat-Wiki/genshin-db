			"dialogs": [
				{
					"id": 728020601,
					"content": "Con gái lại chạy đi đâu rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020602,
					"content": "Sao rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "Dù là đi làm việc, trước khi con bé đi cũng sẽ nói với tôi một tiếng, nhưng hôm nay tại sao nó không nói không rằng là đi mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020605,
					"content": "Tối hôm qua sau khi bạn rời khỏi, Atsuko nói là cảm thấy mệt rồi về phòng ngủ luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020606,
					"content": "Đến khi trời sáng, hai vợ chồng tôi thức dậy, thì nó đã không còn ở trên giường nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020607,
					"content": "Chúng tôi đi khắp nơi tìm cũng không tìm thấy con bé, chồng tôi đã đi đến nơi xa hơn để tìm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020608,
					"content": "Nhưng tôi tìm quanh nơi này cả nửa ngày cũng không thấy tung tích con bé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020609,
					"content": "Ôi, đứa trẻ này sẽ không lại đi chu du nữa chứ? Đúng là không biết làm thế nào mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020610,
					"content": "Mẹ bọn trẻ, đừng sốt ruột, một lát nữa tôi lại đi tìm, bà ở nhà dọn dẹp phòng của Atsuko đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020611,
					"content": "Khi đứa trẻ đó rời đi cũng không đóng chặt cửa sổ, làm một đống lá thổi vào trong phòng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020612,
					"content": "Phải rồi, Nhà Lữ Hành, đây là thù lao, bạn hãy nhận lấy nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020613,
					"content": "Haiz, Atsuko đứa bé này rốt cuộc lại đi làm gì rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020603,
					"content": "Atsuko lại đi làm rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
		},
