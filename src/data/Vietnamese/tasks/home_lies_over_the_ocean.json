				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "Mấy món ăn cho bữa trưa ngày mai đã xong chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020202,
					"content": "Lũ trẻ nhà ta càng ngày càng ăn khoẻ, làm nhiều một chút cũng tốt",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020203,
					"content": "Ấy? Xin hỏi đây là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020204,
					"content": "Xin hỏi đây có phải là nhà của Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "Đúng vậy, có việc gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020207,
					"content": "Đây là thư mà Atsuko nhờ tôi gửi gia đình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "Thư, tại sao nó đột nhiên lại viết thư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020209,
					"content": "Còn viết dài như vậy...rõ ràng là đã về nhà rồi, có việc gì thì nói thẳng với chúng ta là được rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020210,
					"content": "...Hả?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "Nhà Lữ Hành này...Bạn có vẻ rất ngạc nhiên? Mặc dù Atsuko nhà chúng tôi đúng là đã chu du bên ngoài một thời gian, nhưng bây giờ nó đã về nhà rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020213,
					"content": "Nếu đã về nhà rồi, sao còn phải nhờ người đưa thư chứ, các bạn tìm nhầm người rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020214,
					"content": "Chờ đã, mẹ bọn trẻ, tôi nhìn lướt qua bức thư này, bút tích này, giọng điệu này chắc chắn là con gái của chúng ta - Atsuko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020215,
					"content": "Trong thư quả thực có nói rằng nó không định về nhà trong thời gian sắp tới, bảo chúng ta hãy giữ gìn sức khoẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020216,
					"content": "Vậy rốt cuộc là chuyện gì? Lẽ nào đứa trẻ này vừa nhờ Nhà Lữ Hành đây mang thư về, lại vừa tự mình trở về?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020217,
					"content": "Tôi cảm thấy bên trong có uẩn khúc gì đó, chờ nó về nhà chúng ta hỏi thử xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020218,
					"content": "Nhà Lữ Hành, không may là Atsuko nhà tôi hôm nay có việc ra ngoài rồi, chờ con bé về hai vợ chồng chúng tôi sẽ đi hỏi rõ ràng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020219,
					"content": "Nếu bạn đồng ý thì tối mai lại tới đây tìm chúng tôi nhé, để con bé giải thích rõ ràng trước mặt bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020220,
					"content": "Bây giờ cô ấy ở đâu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "Con bé nói mình bận công chuyện, ăn cơm xong liền vội vàng rời đi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020224,
					"content": "Đúng vậy, ngày nào cũng đi sớm về muộn, chỉ có buổi tối chúng tôi mới có thể gặp con bé, thật không biết đứa trẻ này rốt cuộc đang bận chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020225,
					"content": "Tóm lại, phiền bạn tối mai qua đây nhé, nếu thật sự là do đứa trẻ đó nhầm lẫn, nhất định tôi sẽ bảo nó phải xin lỗi bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020226,
					"content": "Phiền bạn đi xa như vậy, thật ngại quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020227,
					"content": "Đứa trẻ Atsuko này, thật không thể khiến người ta yên tâm nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020222,
					"content": "Tại sao lại là buổi tối?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "Con bé nói mình bận công chuyện, ngày nào cũng ăn cơm buổi sáng xong xuôi là rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020211,
					"content": "Atsuko...về nhà rồi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "Xin hỏi có phải là cha mẹ của Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
		{
