			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "Nhà lữ hành, hội trưởng có chuyện cần nhờ vả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340102,
					"content": "Vụ án có tiến triển gì sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "Hội trưởng không có nói, chỉ nói là cần phải chuẩn bị thêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340104,
					"content": "Cô ấy nhờ tôi đợi bạn ở đây, sau đó nhờ chúng ta đến bên ngoài điều tra một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340105,
					"content": "Rốt cuộc cô ấy muốn gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "Bạn hỏi tôi...thì tôi cũng không biết. Tôi chỉ làm việc theo yêu cầu của hội trưởng thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340112,
					"content": "À ừm, chúng ta quay về chuyện chính đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340113,
					"content": "Hội trưởng nói là, từ khi Amano và Andou báo cáo chuyện trộm cướp cho cấp trên, cường độ tuần tra trong thành được tăng cường hẳn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340114,
					"content": "Nhưng điều kỳ lạ là, thương hội trong thành vẫn bị trộm. Vả lại mục đích của tên trộm kỳ này rất rõ ràng, chỉ trộm thứ hắn muốn, còn lại hắn không quan tâm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340115,
					"content": "Hội trưởng cho rằng cơ hội cho những kẻ trộm bên ngoài vào thành gây án là rất thấp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340116,
					"content": "Kẻ trộm hoặc nhóm kẻ trộm lần này gây án là có mục đích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340117,
					"content": "Hiện giờ khả năng lớn nhất chính là có \"nội ứng\" trong thành, không ngừng cung cấp thông tin cho bên ngoài thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340118,
					"content": "Vậy thì lính tuần tra đang làm việc vô ích sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "Không, chính vì bọn chúng ý thức được mục tiêu của lính tuần tra không phải là chúng, cho nên giờ chúng mới không ngừng hành động.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340120,
					"content": "Hắn gây án càng nhiều thì sẽ càng để lại nhiều manh mối, cơ hội để hội trưởng lần ra chân tướng sẽ cao hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340121,
					"content": "Cho nên chúng tôi vẫn sẽ tiếp tục giữ nguyên như vậy để hắn mất cảnh giác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340122,
					"content": "Nhà lữ hành, tôi có thể cùng bạn ra ngoài thành để tìm đám Đạo Bảo Đoàn không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340123,
					"content": "Đương nhiên thù lao sẽ trả đủ. Với lại...khi phá được án sẽ còn được thưởng thêm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340124,
					"content": "Những lời này là của Sango nói đúng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "...Bạn phát hiện ra rồi sao? Trực giác của bạn nhạy bén thật...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340126,
					"content": "Đúng là hội trưởng có gửi gắm những lời thuyết phục bạn cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340127,
					"content": "Nhưng mà hãy tin tôi, những lời này đều là thật. Chí ít thì...thù lao chúng tôi đều đã chuẩn bị đủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340128,
					"content": "Vì vậy, vụ này nhờ vào bạn nhé nhà lữ hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340129,
					"content": "Vậy tôi cần phải làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "Đơn giản thôi, chúng ta chỉ cần đi đánh đuổi đám Đạo Bảo Đoàn ở ngoài thành là được rồi, đánh đuổi được càng nhiều thì càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340131,
					"content": "Hội trưởng đã ký hiệu cho tôi một số doanh trại của đám Đạo Bảo Đoàn, chúng ta cứ việc dựa vào đó mà tìm thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340132,
					"content": "Được rồi, chúng ta xuất phát nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340107,
					"content": "Tại sao cô ấy không tự mình đi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "Đây là thói quen của hội trưởng. Cô ấy nói bản thân \"chỉ sở trường suy nghĩ, không sở trường hành động\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340109,
					"content": "Trước đó, có một người chuyên viết tiểu thuyết đến phỏng vấn hội trưởng, nói rằng muốn viết một quyển tiểu thuyết trinh thám về cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340110,
					"content": "Còn nói hội trưởng là \"thám tử ghế bố\", vì chỉ cần ngồi không gật gù một tí là phá được án ngay. Hội trưởng thích biệt danh này lắm, nên muốn mua cái ghế bố cho giống với danh hiệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340111,
					"content": "Nhưng mà do kinh phí hạn hẹp nên vẫn chưa mua được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
