						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Haha... Đừng lo, chị đã giúp cưng sắp xếp chu đáo thông tin thị trường gần đây rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "Sao nào, có ý tưởng gì về loại thuốc tiếp theo cần bán chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "Vậy thử nuôi trồng loại dược liệu mới xem. Những dược liệu này sau khi được xử lý với kỹ thuật giả kim sinh vật, sẽ có công hiệu và đặc tính khác nhau đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "Cho những dược liệu khác nhau vào, thì loại thuốc luyện chế ra cũng sẽ có sự thay đổi. Chúng ta có thể thử nhiều tổ hợp khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "Được rồi, thử nghiệm thực tế xem sao nhé.",
					"roleType": "TALK_ROLE_NPC",
