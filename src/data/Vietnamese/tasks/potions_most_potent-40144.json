				},
				{
					"id": 401440402,
					"content": "Còn về sau cần luyện chế loại thuốc nào, thì phải tham khảo thông tin của thị trường rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "Dựa theo những tin tức xảy ra gần đây để suy đoán xem người dân cần những loại thuốc nào, đó là kỹ năng kinh doanh không thể thiếu đấy.",
