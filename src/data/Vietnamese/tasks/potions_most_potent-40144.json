					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440202,
					"content": "Woa, nhiều trang thiết bị quá! Đều là do một mình Lisa làm hết sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440203,
					"content": "Đây là thành quả nỗ lực của mọi người trong Đội Kỵ Sĩ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440204,
					"content": "Tiền quỹ để mở tiệm là do Jean chuẩn bị. Nguyên liệu và trang thiết bị cần dùng trong việc luyện chế thuốc giả kim thì được Albedo và Sucrose hỗ trợ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440205,
					"content": "Còn những vật tư bổ sung sau đó là do đội hậu cần phụ trách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440206,
					"content": "Bây giờ có thêm sự gia nhập của hai cưng, vậy là gánh nặng trên người chị đã nhẹ đi nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440207,
					"content": "Mấy ngày nay, Đội Kỵ Sĩ đã tiến hành quảng cáo cho tiệm. Đợi khi chúng ta chuẩn bị xong xuôi là có thể chính thức khai trương rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440208,
					"content": "Không chậm trễ nữa, tiếp theo đây, cưng hãy dùng những loại dược liệu này để thử luyện chế thuốc nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
