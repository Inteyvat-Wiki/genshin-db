			"dialogs": [
				{
					"id": 401440101,
					"content": "Là cưng à! Hôm nay sao lại rảnh rỗi ghé qua đây thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440102,
					"content": "Là muốn đến đọc sách hay đến thăm chị đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440103,
					"content": "Đến để thăm Lisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "Haha, cưng vẫn chu đáo như ngày nào nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440107,
					"content": "Nhưng hôm nay thật không may, chị cũng đang bận xử lý một việc, không thể tiếp đón mấy đứa uống trà chiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440108,
					"content": "Woa, Lisa đang nghiêm túc làm việc à? Chuyện này hiếm gặp thật đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440109,
					"content": "Đúng thế. Lần gần đây nhất vùi đầu vào nghiên cứu giống như vậy, chắc là lúc vẫn còn ở trong Giáo Viện nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440110,
					"content": "Lâu rồi chị mới nghiêm túc suy nghĩ, thấy cũng mệt mỏi thật đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440111,
					"content": "Chẳng lẽ là đang viết luận văn sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "Haha, nhìn cưng có hứng thú như vậy, có muốn tham gia cùng chị không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440114,
					"content": "Cùng chị đây ôn lại khoảng thời gian còn là học sinh nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440115,
					"content": "Đừng có đột nhiên đẩy việc cho người khác như thế chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440116,
					"content": "#{NICKNAME} không muốn sao? Đây là cơ hội hiếm có để cùng chị chung tay vượt qua khó khăn đấy. Hơn nữa, thù lao cũng rất hậu hĩnh đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440117,
					"content": "Tôi đang nghe đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Chắc cưng cũng biết rồi đấy, Đội Kỵ Sĩ vẫn luôn tiến hành những nghiên cứu liên quan đến thuật giả kim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440120,
					"content": "Nhưng phần lớn nội dung đều được tiến hành trong phòng thí nghiệm, dân chúng không hiểu nhiều về hạng mục này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440121,
					"content": "Đây là kết quả của việc bỏ nhiều chi phí cho hạng mục nghiên cứu, nhưng lại không có được tác dụng rộng rãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440122,
					"content": "Vậy nên Jean định quảng bá thành quả của thuật giả kim cho dân chúng... Thành quả của giai đoạn hiện tại chính là thuốc giả kim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440123,
					"content": "Bình thường ngoài công việc trong thư viện ra, chị cũng sẽ giúp đỡ quản lý việc cung ứng thuốc giả kim của Đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440124,
					"content": "Hơn nữa, luyện chế thuốc cũng là một trong các hướng nghiên cứu trước đây của chị. Nên Jean cảm thấy, chị là người phù hợp nhất cho công việc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440125,
					"content": "Nhưng để đáp ứng nhu cầu hằng ngày của dân chúng thì nguyên liệu cần phải được điều chỉnh lại, cách luyện chế cũng phải được đơn giản hóa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440126,
					"content": "Cứ như vậy, đề tài ban đầu vốn đơn giản nay đã trở nên phức tạp hơn nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440127,
					"content": "Lẽ nào cô muốn chúng tôi hỗ trợ nghiên cứu sao? Nhưng chúng tôi cũng không hiểu biết nhiều về thuật giả kim mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440128,
					"content": "Haha, không phải đâu. Chị đã nghĩ ra công việc thích hợp hơn cho hai cưng rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440129,
					"content": "Tuy việc nghiên cứu kỹ thuật luyện chế vẫn đang tiến hành ổn định, nhưng nếu không thu thập được phản hồi sử dụng thực tế của dân chúng thì sẽ chẳng thể biết được liệu nó có đáp ứng được nhu cầu của mọi người hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440130,
					"content": "Nhưng nếu vừa nghiên cứu thuốc vừa thu thập phản hồi thì cần một phương pháp có hiệu suất cao hơn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440131,
					"content": "Cách chị nghĩ ra chính là mở một tiệm bán thuốc giả kim. Như vậy sẽ có thể vừa luyện chế thuốc, vừa tìm hiểu nhu cầu hàng ngày của mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440132,
					"content": "Ồ! Kết hợp hai việc làm một à... Quả đúng là cách giải quyết theo phong cách của Lisa mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440133,
					"content": "#Đúng vậy. Hơn nữa, người thích hợp với công việc này nhất dĩ nhiên là thành viên tinh anh của Đội Kỵ Sĩ... {NICKNAME} rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440134,
					"content": "Lúc còn ở Giáo Viện, những người bạn học trong đó cũng sẽ hỗ trợ đề tài của nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440135,
					"content": "Chẳng lẽ cưng không muốn trải nghiệm thử cuộc sống trẻ trung như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440136,
					"content": "Nói thì nghe hay vậy, nhưng thật ra vẫn là do cô muốn lười biếng chứ gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440137,
					"content": "Xem như là vì Lisa vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Haha, chị biết ngay cưng là người đáng tin cậy nhất mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440141,
					"content": "Đợi khi công việc xong xuôi rồi chị sẽ đích thân đi chuẩn bị thù lao cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440142,
					"content": "Việc chuẩn bị ban đầu của tiệm đã xong rồi. Còn việc tiếp theo đây, chúng ta cứ qua đó rồi bàn tiếp nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440139,
					"content": "Xem như là thử thách bản thân vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "Ừm, cưng quả nhiên rất hăng hái.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440118,
					"content": "Phải xem thử xem là việc gì đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "Chẳng lẽ là đang nghiên cứu đề tài gì đó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "Vừa hay đi ngang qua thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "Tiện thể đến tìm chị để trò chuyện sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				}
			]
		},
