					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040326,
					"content": "Hơn nữa... Đạo Bảo Đoàn ở Liyue gần đây nhận được một bức thư nặc danh.",
					"roleType": "TALK_ROLE_NPC",
