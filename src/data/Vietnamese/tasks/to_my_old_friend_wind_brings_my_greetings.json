						400040315
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040315,
					"content": "Quy trình này có nghĩa là gì!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040316,
					"content": "Có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040317
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040317,
					"content": "Sự tình là như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040318,
					"content": "Như vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040319
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040319,
					"content": "Có thông tin nội bộ nào không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040320,
					"content": "Tôi nghĩ rằng vụ việc lần này không phải do Đạo Bảo Đoàn đứng sau chỉ đạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040321
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040321,
					"content": "Đạo Bảo Đoàn có thể hoạt động ở nhiều quốc gia vì họ luôn tuân theo một nguyên tắc cơ bản.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040322
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040322,
					"content": "\"Dám mạo hiểm mới đánh đổi được sự giàu có\" lời lẽ như vậy đều là dối trá, phát triển ổn định mới thực sự là chính đạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040323
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040323,
					"content": "Cảng Liyue có tiên nhân bảo vệ, đặc biệt là vào dịp Tết Hải Đăng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
