						400040330
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040330,
					"content": "#Ừm, rất hữu ích! {NICKNAME}, chúng ta phải cố gắng nắm bắt manh mối duy nhất này!",
