					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110513,
					"content": "Sau đó cô ấy cũng làm cơm cho ngươi ăn. Rồi sau đó, ta có thể ăn hai loại cơm đều rất ngon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110514,
					"content": "Cho nên ta phải chăm sóc tốt đền thần. Đợi khi cô ấy trở về, thì sẽ cùng nhau ăn cơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110515,
					"content": "Cám ơn. Rất ngon. Meo meo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
