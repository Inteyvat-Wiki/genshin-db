			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "Hoan nghênh đến với \"Nhà Hàng Kiminami\", cho hỏi bạn cần gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110203,
					"content": "Về cơm của Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "Neko? Cái tên này, không lẽ là mèo sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110205,
					"content": "Bạn quen Neko sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110206,
					"content": "Ấy ấy không phải. Tôi chỉ cảm giác cái tên này rất hợp với một con mèo thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110207,
					"content": "Trực giác thật là đúng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "Khoan nói cái này đã, sự việc là thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110209,
					"content": "Trên Đảo Seirai... có một Đền Asase, trong đền thần có một con mèo biết nói?! Con mèo đó còn nhờ các bạn làm một món ăn cho nó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110210,
					"content": "Hả? Thật sao? Tôi chưa từng nghe qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110211,
					"content": "Là, là thật...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "Trên Đảo Seirai đúng không? Có cơ hội, tôi nhất định sẽ tự đi xem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110214,
					"content": "Vậy... cơm của Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "Đúng rồi, suýt chút nữa thì quên mất việc chính... để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110216,
					"content": "Ồ... mèo cũng thích cơm sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110217,
					"content": "Rất khó sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110219,
					"content": "Rất, rất khó sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "Đây là một thử thách đối với nhà Kiminami! Tôi nhất định phải khắc phục!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110221,
					"content": "Dùng thịt cá, thịt rừng, rong biển, gạo để làm nên một món ăn ngon cho mèo, hãy giao cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110222,
					"content": "Tôi, tôi cũng muốn ăn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110223,
					"content": "Tôi cũng muốn ăn...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "Không thành vấn đề!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110226,
					"content": "Tôi suy nghĩ về công thức trước, các bạn hãy chuẩn bị ba phần Rong Biển giúp tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110227,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "Vậy trông cậy vào các bạn đó, chỉ cần ba phần Rong Biển là được, tìm được hãy đem về cho tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110229,
					"content": "Bạn đã biết làm thế nào rồi ư?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "Có một chút ý tưởng rồi, những vẫn chưa hoàn toàn thông suốt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110231,
					"content": "Bạn hãy đi tìm ba phần Rong Biển giúp tôi, phiền các bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110224,
					"content": "Vậy thì giao cho cô đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110212,
					"content": "Bạn có thể tự đến đó xem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				}
			]
		},
