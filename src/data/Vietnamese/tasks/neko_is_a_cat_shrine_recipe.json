						722110412
					]
				},
				{
					"id": 722110412,
					"content": "Tuy là cơm các ngươi làm khác với Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110413,
					"content": "Nhưng ăn cơm với các ngươi, cảm giác cũng giống như trước đó cùng ăn với Hibiki vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110414,
					"content": "Tại sao lại như vậy? Loài người các ngươi chẳng lẽ biết yêu pháp gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110415,
					"content": "Đã lâu rồi chưa ai nấu cơm cho ngươi rồi phải không.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "...Dù sao đi nữa, cảm ơn mọi người. Đã lâu rồi chưa ăn được bữa cơm ngon như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110418,
					"content": "Mấy tên nhóc đó nhất định sẽ rất thích. Ngươi hãy đưa cơm này cho bọn chúng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110419,
					"content": "Ta đã thích, thì bọn chúng chắc chắn sẽ thích. Sau khi ăn cơm ngon như vậy, nhất định sẽ chịu nghe lời của ta thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110416,
					"content": "Tại vì người nấu rất nhiệt tình.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
