				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Tiểu thư Etsuko, tiếp theo chúng ta đến đâu thám hiểm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "Phù... nghỉ chút đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110103,
					"content": "Là các người sao, tìm chúng tôi có chuyện gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110104,
					"content": "Về đầu bếp đáng tin cậy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "Tìm đầu bếp ở Đảo Seirai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "Sự việc là thế này. Neko nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "Bạn nói... Neko đại nhân nhờ các bạn giúp đỡ chuẩn bị thực phẩm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "A... phải chi tôi có tài nấu nướng thì tốt rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "Cho nên các bạn muốn tìm một đầu bếp có thể giúp các bạn hiểu rõ... \"Làm sao dùng thực phẩm này để làm món cơm mà mèo thích ăn\" đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110110,
					"content": "Để tôi suy nghĩ... đầu bếp... đầu bếp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110111,
					"content": "À, hay là các người đến Thành Inazuma tìm tiểu thư Kiminami Anna của \"Nhà Hàng Kiminami\" đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110112,
					"content": "Tiểu thư Kiminami rất tốt, tài nấu nướng cũng không tệ, có lẽ sẽ giúp được các bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110113,
					"content": "Cảm ơn, chúng tôi sẽ đến đó xem thử.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "Không có chi, hãy mau đi, tôi và Taisuke tiếp tục làm kế hoạch thám hiểm đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110115,
					"content": "Ha ha, mong rằng đền thần này có thể náo nhiệt trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110116,
					"content": "Như vậy thì sẽ không uổng công bạn và Neko đã bận bịu thời gian dài vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				}
			]
		},
