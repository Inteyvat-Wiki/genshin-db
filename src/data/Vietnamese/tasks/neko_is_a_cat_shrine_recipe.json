						722110810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110810,
					"content": "Lúc đó á, chỉ cần vừa bưng mâm cơm ra, tất cả mèo sẽ từ trên cây, trên mái nhà leo xuống ngay. Cho dù cơm rất nóng, lưỡi cũng rất nóng, cũng không thể nhịn được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110811,
					"content": "Lần nào Hibiki cũng nấu một mâm cơm lớn, chia cho mèo và loài người cùng ăn, người đến đền thần cũng có phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110812,
					"content": "Nhưng sức ăn của Domeki rất lớn, lần nào cũng ăn rất nhiều. Không phong độ như ta gì cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110813,
					"content": "Cho nên...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "Không sai, ta muốn nhờ các ngươi nấu cơm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110816,
					"content": "Tôi không phải nghi ngờ Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "Nhưng Neko thật sự biết nấu như thế nào sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110818,
					"content": "Meo meo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110819,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "Giao cho các ngươi nghĩ cách đó! Chẳng lẽ thứ gì ta cũng phải tự mình làm sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110821,
					"content": "Ây da, nhưng món này, quả thật rất là ngon. Mùi vị này, dù đi xa thật xa, thời gian qua lâu thật lâu, vẫn có thể ngửi được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110822,
					"content": "#{NICKNAME}, tôi thấy chúng ta nên cố gắng hơn! Dù sao cũng vì đền thần mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110823,
					"content": "Bên trong cơm có gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "Đương nhiên ta nhớ. Có thịt cá, thịt động vật, rong biển, còn có gạo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110827,
					"content": "Ừm, là thịt cá, thịt rừng, rong biển và gạo đúng không... còn nhớ cách nấu không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110828,
					"content": "Không nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110829,
					"content": "Xem ra phải tìm đầu bếp để hỏi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "Nhưng đầu bếp nào sẽ nấu cơm mèo chứ...Hay là chúng ta đi hỏi thử Taisuke và Etsuko, không chừng bọn họ sẽ biết phải làm thế nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110831,
					"content": "Đi tìm hai Nhà Mạo Hiểm đó hỏi thử đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "Đúng rồi, Taisuke và Etsuko là Nhà Mạo Hiểm, không chừng sẽ có cách.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110824,
					"content": "Paimon lại đói rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "Gì chứ, tôi chỉ là nhiệt tình giúp đỡ! Neko, bên trong cơm có nguyên liệu gì, vẫn nhớ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110814,
					"content": "Chúng tôi phải nấu cơm giúp ngươi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
		},
