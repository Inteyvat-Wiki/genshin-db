			"dialogs": [
				{
					"id": 715370101,
					"content": "Kỵ Sĩ Danh Dự, không ngờ lại gặp tiền bối ở đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370102,
					"content": "Cô đang làm thiệp chúc mừng sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "Ừm, khó khăn lắm mới tranh thủ ngày nghỉ đến Cảng Liyue đó. Tôi đang mua quà đem về tặng cho mọi người ở Đội Kỵ Sĩ đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370104,
					"content": "Sau đó tôi nghe nói trong thời gian Tết Hải Đăng, khi người Liyue tặng quà sẽ viết một tấm thiệp chúc mừng đính kèm bên trong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370105,
					"content": "Vì vậy, tôi muốn bắt chước làm vài tấm thiệp đẹp. Nhưng làm thế nào cũng không thấy đẹp mắt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370106,
					"content": "#Kỵ Sĩ Danh Dự, {F#cô}{M#cậu} có biết làm thế nào để làm ra tấm thiệp chúc mừng đẹp nhất không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370107,
					"content": "Yên tâm đi, cứ để tôi lo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
