			"dialogs": [
				{
					"id": 750013201,
					"content": "Thành công thật này... Đây là khung cảnh mà lúc trước chỉ xuất hiện trong truyện thôi đấy. Thật là tuyệt vời.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013202,
					"content": "Âm thanh vốn ồn ào đã yên tĩnh... Mũi Kim Bóng Tối Nhỏ lại trở về dáng vẻ vốn có. Thứ to lớn này đã ập xuống ầm một cái...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013203,
					"content": "Phù... Thực sự có người đã làm được... Không phải một giấc mơ sao...? Hai vị thực sự tồn tại sao? Không phải ảo giác của tôi đấy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013204,
					"content": "Tỉnh mộng đi... Đến lúc anh phải tự đi giải quyết rồi đấy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "Đừng nói mấy lời tàn nhẫn vậy chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013206,
					"content": "#Sao nào? Tôi đã nói mà, {NICKNAME} mạnh lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013207,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#Hihi, {REALNAME[ID(2)|SHOWHOST(true)]} cũng cảm thấy vậy phải không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013209,
					"content": "#{NICKNAME}, vị dũng sĩ ngoại quốc lợi hại, {F#cô}{M#cậu} không bị Vực Sâu ảnh hưởng đấy chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013210,
					"content": "Không sao, chỉ là Vực Sâu thôi mà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#Ngay cả dũng sĩ mạnh nhất trong bộ tộc khi đối diện với Vực Sâu cũng phải vô cùng cẩn thận. {NICKNAME} đúng là không tầm thường mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013213,
					"content": "Haha, nói không chừng dùng chủ đề này để viết truyện sẽ còn thú vị hơn cả ghi chép của Sanhaj đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013214,
					"content": "Hmmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "Tuy không biết Sanhaj là ai, nhưng nghe có vẻ lợi hại đấy nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013216,
					"content": "Haha, đối với tất cả người kể chuyện của bộ tộc, thì Sanhaj của Chủ Nhân Gió Đêm luôn là một nhân vật đáng kính nể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013217,
					"content": "Nhưng hiện giờ tình hình cấp bách, đợi lúc nào rảnh tôi sẽ kể cho hai vị nghe câu chuyện về Sanhaj!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013218,
					"content": "Được rồi, chúng ta đến chỗ Mũi Kim Bóng Tối Nhỏ tiếp theo nào. Nhanh chóng giải quyết vấn đề, tối nay tôi có thể bắt đầu viết rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013219,
					"content": "Xuất phát, xuất phát nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013220,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "Tạm thời vẫn còn khá khỏe mạnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
