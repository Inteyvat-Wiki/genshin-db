			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "Chà, vừa nãy tôi nghe thấy một vài tiếng động đáng sợ, nên muốn qua đây xem thử...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010802,
					"content": "Khi qua đây còn an ủi bản thân rằng \"Đừng lo Titu, còn có thể xảy ra chuyện gì nữa chứ\"... Kết quả lại xảy ra chuyện lớn không ngờ đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010803,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "Còn có cả một con Tepetlisaur nhỏ nữa... Là nhóc đã dẫn hai người ngoại quốc này tới đây đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010805,
					"content": "Và Mũi Kim Bóng Tối này... là hai vị đã ghim xuống sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010806,
					"content": "...Chẳng lẽ không nên ghim xuống sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#Hả? Vậy chẳng phải là chúng ta đã làm chuyện xấu rồi sao, {NICKNAME}... Hay là tranh thủ lúc chỉ có một người chứng kiến...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010808,
					"content": "#Haha, đừng nói điều đáng sợ vậy chứ. Tình trạng không nghiêm trọng đến thế đâu. Phải nói rằng hai vị đã làm một chuyện tốt đấy. Vị này là {NICKNAME} à, vậy còn cô thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010813,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#Đây là {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "Ừm, còn tôi tên là Titu, là người phụ trách kể c{RUBY#[D]Người Kể Chuyện}huyện trong bộ tộc, đồng thời cũng chịu trách nhiệm \"trông coi\" những trụ đá trong hẻm núi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010816,
					"content": "Và đương nhiên, trụ đá mà hai vị ghim xuống là một trong ba Mũi Kim Bóng Tối Nhỏ, cũng nằm trong phạm vi trông coi của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010817,
					"content": "Trông, trông coi à... Quả nhiên, chúng tôi làm rơi trụ đá gì đó rồi, người của Natlan sẽ đòi bồi thường vì chuyện này mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010818,
					"content": "Hic, sớm biết như vậy thì ban nãy đã không nói tên thật ra rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010819,
					"content": "Bồi thường... \"Titu đột nhiên nảy ra ý tưởng, nói không chừng có thể dùng cách này uy hiếp người trước mặt để đạt được mục đích của mình...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010820,
					"content": "Nếu là tình tiết như vậy, thì nên thêm vào phần kể thế này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010821,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "A, xin lỗi, cứ mải nghĩ những thứ liên quan đến câu chuyện. Tôi là người phụ trách kể c{RUBY#[D]Người Kể Chuyện}huyện trong bộ tộc, đã kể chuyện được nhiều năm rồi, gần đây đã đến lúc tôi phải tự nghĩ ra câu chuyện rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010823,
					"content": "Mấy ngày nay tôi cứ lo lắng về chuyện này, và Mũi Kim Bóng Tối lại xảy ra chuyện... Cha ông nói không sai, khi người xui xẻo thì đến cả Saurian cũng xui xẻo theo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010824,
					"content": "Khụ, tôi sẽ không uy hiếp hai vị đâu. Vì nếu tôi thật sự muốn uy hiếp thì đã không nói ra những suy nghĩ trong đầu rồi, đúng không nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010825,
					"content": "Xem này, sau khi báo tên mà không có đánh nhau, vậy có nghĩa là chúng ta đã trở thành bạn bè rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010826,
					"content": "Không biết hai vị có thể nghe lời thỉnh cầu của người bạn này không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010827,
					"content": "Chỉ cần... không phải bồi thường là được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "Đương nhiên rồi. Nên nói sao nhỉ, khi hai vị đi dạo trong hẻm núi, có nhìn thấy khối Phlogiston Thể Rắn siêu lớn mà còn khắc hoa văn màu vàng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010829,
					"content": "Ở ngay trung tâm khu vực này ấy, chắc chắn rất nổi bật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010830,
					"content": "Hình như là có...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "Chuyện tôi muốn nói thật ra có liên quan đến trụ đá lớn đó... Trụ đá lớn đó được người trong bộ tộc gọi là Mũi Kim Bóng Tối. Gần đây nó xảy ra chút vấn đề.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010834,
					"content": "Trước khi gặp hai vị thì tôi đã định bỏ cuộc rồi. Tôi thậm chí còn tự nói rằng \"Viết một câu chuyện về việc không giải quyết được vấn đề Mũi Kim Bóng Tối, khiến cho tai họa ập tới hủy diệt bộ tộc...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010835,
					"content": "Đợi đã, chỉ là một trụ đá thôi thì có liên quan gì đến việc hủy diệt bộ tộc chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010836,
					"content": "Hơn nữa, Mũi Kim Bóng Tối và Mũi Kim Bóng Tối Nhỏ ban nãy rõ ràng đều là trụ đá to mà. Tại sao lại gọi bằng cái tên này vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010837,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#Ồ, {NICKNAME} và Paimon đều là người ngoại quốc, quả thật cần phải giải thích chi tiết hơn. Thực chất nó có liên quan đến một truyền thuyết trong bộ tộc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010839,
					"content": "Trong câu chuyện, Wayob treo Mũi Kim Bóng Tối ở đây là để khâu chiếc bóng của Chúa Tể Núi Lửa lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010840,
					"content": "Nhưng lịch sử thực tế là như vậy. Bên dưới cái trụ đó chính là Vực Sâu, thứ đang bị phong ấn ở nơi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010841,
					"content": "Ở Natlan thì hầu hết câu chuyện đều sẽ như thế. Vì để cảnh cáo, nên những câu từ được khoác lên lớp vỏ bọc câu chuyện, tất cả cách thức diễn tả đều chỉ là một dạng ví von.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010842,
					"content": "Đợi đã, vậy bên dưới là Vực Sâu đang bị phong ấn sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010843,
					"content": "Đúng vậy. Gần đây hai trong ba Mũi Kim Bóng Tối nhỏ đã nổi lên rồi. Nói không chừng đợi khi Mũi Kim Bóng Tối thứ ba nổi lên thì thứ xấu xa bên dưới sẽ tràn ra như cơn thủy triều đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010844,
					"content": "Nên khi thấy hai vị ghim một cây xuống thì tôi quả thực có chút vui mừng và bất ngờ, nên tôi sẽ không yêu cầu hai vị bồi thường đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010845,
					"content": "Hơn nữa, tôi muốn nhờ hai vị, có thể giúp tôi ghim Mũi Kim Bóng Tối Nhỏ còn lại xuống không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010846,
					"content": "#Hmm... Phải làm sao đây, {NICKNAME}...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010847,
					"content": "...Chuyện liên quan đến Vực Sâu thì khó mà khoanh tay đứng nhìn được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Cả {REALNAME[ID(2)|SHOWHOST(true)]} cũng đồng ý rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010851,
					"content": "À... Giống như khi bóng tối bao trùm sẽ luôn có ánh sáng xuất hiện vậy. Haha, trong lúc khó khăn ắt sẽ có anh hùng đứng ra. Con người sẽ luôn tỏa sáng bằng cách như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010852,
					"content": "#Nói không chừng đây sẽ là một câu chuyện tuyệt vời đấy. {NICKNAME} có khí chất mà ngay cả anh hùng trong một số câu chuyện cũng không có được. Thật đáng mong chờ đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010853,
					"content": "Đi nào, các anh hùng, chúng ta xuất phát ngay thôi. Đi xem thử Mũi Kim Bóng Tối còn lại nhé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010848,
					"content": "Có lẽ tôi sẽ giúp được gì đó nhỉ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "Không có ấn tượng gì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "Vậy à. Thứ đó rõ ràng rất nổi bật mà, nhưng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010809,
					"content": "Là do Paimon làm, tôi chỉ là đồng phạm thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "Ối! Đừng có đổ thừa chứ, tôi giận đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010811,
					"content": "Haha, đừng lo lắng, tình trạng không nghiêm trọng đến thế đâu. Vậy vị tiểu thư nhỏ này là Paimon, còn vị này tên là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010812,
					"content": "#Tôi tên {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}