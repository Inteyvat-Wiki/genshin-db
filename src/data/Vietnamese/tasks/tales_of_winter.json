			"dialogs": [
				{
					"id": 206000101,
					"content": "Nhà Lữ Hành, ta đã chú ý đến ngươi rất lâu rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000102,
					"content": "Tìm tôi có việc gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "Làm sao lại mang cái giọng điệu đề phòng như vậy, ta có tin tốt nói cho ngươi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000104,
					"content": "Thế nào, ngươi có hứng thú gia nhập Fatui bọn ta không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000105,
					"content": "Hừ, chúng tôi không thèm! Phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000106,
					"content": "Tôi suy nghĩ chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "Này, loại chuyện này bạn cũng phải suy nghĩ sao, phải từ chối thẳng mới đúng chứ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000108,
					"content": "Rất sáng suốt, muốn đạt được thành tựu trong sự nghiệp thì việc tham gia Fatui bọn ta tất nhiên là sự lựa chọn tốt nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000111,
					"content": "Í, nhìn biểu cảm của ngươi, có chuyện gì muốn hỏi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000109,
					"content": "Thế nhưng nơi đây là thành Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "Thành Mondstadt thì làm sao? Người Fatui bọn ta công khai chiêu mộ khắp lục địa, tuyệt đối công bằng chính trực, Kỵ Sỹ Tây Phong cũng không thể kiểm soát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
