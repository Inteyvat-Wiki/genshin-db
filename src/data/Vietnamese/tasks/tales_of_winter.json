			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "Về Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "Ái chà, vào thẳng vấn đề nhỉ, he he, kể ra thì dài dòng lắm đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000203,
					"content": "Nhưng mà, ngươi vẫn chưa phải là thành viên chính thức của Fatui, ta cũng không thể nói thẳng cho ngươi biết...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000204,
					"content": "Ta nghe nói, xung quanh hành Mondstadt có rất nhiều Hilichurl, thậm chí còn tụ tập thành nhiều nhóm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000205,
					"content": "Ngươi giúp ta đi một chuyến, lấy mấy thứ chiến lợi phẩm từ thủ lĩnh Bạo Đồ Hilichurl về đây, sau đó ta sẽ kể cho ngươi vài chuyện hấp dẫn, thế nào?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000206,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "Ồ, cũng khá thẳng thắn nhỉ, hiếm khi gặp được người như thế này ở thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000208,
					"content": "Vậy mau đi đi, ta đợi ở đây, nhớ đi nhanh về nhanh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000209,
					"content": "Chỉ có mỗi việc này?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "Làm sao, ngươi chê việc này không thú vị? Được rồi, quái vật mạnh hơn ngươi có xử lý được không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000211,
					"content": "Mau đi đi, ta đợi ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000212,
					"content": "Haha... nếu mà cứ lề mề thêm lúc nữa, ta sẽ bị cơn gió này ru ngủ mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
