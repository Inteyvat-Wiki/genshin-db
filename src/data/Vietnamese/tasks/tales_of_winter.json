				},
				{
					"id": 206000602,
					"content": "Lấy được rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Ta xem nào, ừm... tạm được, gom lại đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000604,
					"content": "Ta sẽ nói cho ngươi chuyện về Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000605,
					"content": "Fatui bọn ta đến từ Cung Điện Zapolyarny, nghe theo mệnh lệnh và thực hiện mong muốn của Nữ Hoàng điện hạ, bọn ta hoạt động khắp mọi nơi trên thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000606,
					"content": "Trong đó có mười một người mạnh nhất được Nữ Hoàng bệ hạ ban cho danh hiệu \"Quan Chấp Hành\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000607,
					"content": "So với những kẻ vô danh tiểu tốt như bọn ta, mười một Quan Chấp Hành mới là những nhân vật có uy danh lẫy lừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000608,
					"content": "Khi gia nhập Fatui, nếu thực lực ngươi đủ mạnh, nói không chừng sẽ được vị đại nhân nào đó chọn trúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000609,
					"content": "Nếu như vậy, ngươi sẽ lên như diều gặp gió...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000610,
					"content": "Ta? Ta không phải là người được chọn, ta ở đây để làm vài chuyện vặt giúp đại nhân Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000611,
					"content": "Ặc... Nếu cứ bắt tôi phải chọn, tôi thực sự muốn theo đại nhân Capitano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
