				{
					"id": 206000409,
					"content": "Anh muốn thứ này làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "Hả? Làm bộ sưu tập không được à? Làm sao, người Mondstadt đến cả Thủ Vệ Di Tích cũng không dám thử à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000411,
					"content": "Hừ, đối với người Fatui mà nói, chuyện này dễ như trở bàn tay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000412,
					"content": "Tuy nhiên, ha... gió thổi khiến ta chỉ muốn ngủ thôi, thực sự không có tinh thần, vì vậy chuyện nhỏ này giao cho ngươi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
