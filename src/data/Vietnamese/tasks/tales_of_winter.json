			"dialogs": [
				{
					"id": 206000501,
					"content": "Đừng quên nhé, là chiến lợi phẩm trên người Bạo Đồ Hilichurl, lấy được rồi thì mau trở lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000502,
					"content": "Cụ thể là gì? Chính là... một chiếc Sừng Nặng, sau khi lấy được thì mang về cho ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
