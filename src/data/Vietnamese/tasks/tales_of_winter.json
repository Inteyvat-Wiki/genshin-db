						206001003
					]
				},
				{
					"id": 206001003,
					"content": "Ồ! Thứ này không tệ, ngươi cũng khá nhanh nhẹn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001004
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001004,
					"content": "Ngươi muốn nghe chuyện về Nữ Hoàng bệ hạ phải không? Để ta nghĩ xem nên bắt đầu từ đâu nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001005
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001005,
					"content": "Ừm... Nếu để tóm tắt ngắn gọn mà nói thì \"Nữ Hoàng bệ hạ là Thần\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001006
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001006,
					"content": "Đây không phải là miêu ta trừu tượng gì cả, mà là thực tế. Nữ Hoàng bệ hạ chính là \"Băng Thần\" trong \"Bảy vị chấp chính trần thế\" ngày nay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001007
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001007,
					"content": "Có điều, đối với người Fatui bọn ta mà nói, Nữ Hoàng bệ hạ còn có ý nghĩa hơn cả Thần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001008
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001008,
					"content": "Còn lý do thì... có nói ngươi cũng chẳng biết được, hoặc là cũng không hiểu hết được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001009
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001009,
					"content": "Nếu ngươi muốn biết rõ thì hãy gia nhập với bọn ta. Sau khi gia nhập rồi sẽ tự khắc hiểu được Nữ Hoàng bệ hạ của bọn ta mà thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001010
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001010,
					"content": "Hừm... thôi được rồi, nói đến đây thôi, những nữ tu bên đó lại đang liếc ta rồi...",
					"roleType": "TALK_ROLE_NPC",
