						206000803
					]
				},
				{
					"id": 206000803,
					"content": "Ta xem nào, hừ, quả là không có bảo bối gì tốt, đúng là một nơi tồi tàn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000804,
					"content": "Được rồi được rồi, kể cho ngươi chuyện về Delusion. Ta nghĩ xem nào...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000805,
					"content": "Delusion là bảo vật mà Nữ Hoàng bệ hạ ban cho, mang theo sức mạnh to lớn, chỉ cần có nó, cho dù là tín ngưỡng hay là Vision cũng đều chỉ là thứ đồ chơi để dỗ con nít.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000806,
					"content": "Nhưng, Delusion không phải là thứ mà ai cũng có thể sở hữu, trong Fatui ngoài mười một Quan Chấp Hành, người có được Delusion cũng không nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000807
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000807,
					"content": "Nhưng mà ngay cả như vậy, đối với những người bình thường như ta mà nói, Delusion còn thực tế hơn so với Vision được Thần ban tặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000808
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000808,
					"content": "Haha, ta thấy ngươi cũng không có Vision, thế nào? Có suy nghĩ gia nhập Fatui bọn ta không, nếu may mắn không chừng còn có thể có được Delusion đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000809,
					"content": "Hừm... được rồi, chuyện về Delusion chỉ nói đến đây thôi, đội Kỵ Sĩ Tây Phong rất nhạy cảm với thứ này, đừng có dẫn họ đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
