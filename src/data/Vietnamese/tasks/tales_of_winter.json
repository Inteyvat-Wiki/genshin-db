				{
					"id": 206000301,
					"content": "Về Delusion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "Ha... Ta thấy ngươi cũng rất biết ăn nói mà, còn giả vờ hồ đồ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000303,
					"content": "Ngươi không phải thành viên chính thức của Fatui, lại hỏi thẳng toẹt một câu \"Delusion là gì\" như vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000304,
					"content": "Ngươi nghĩ rằng ta sẽ nói cho ngươi toàn bộ đầu đuôi ngọn ngành sao? Ta đâu có phải hai kẻ giữ cửa của Kỵ Sĩ Tây Phong kia đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000305,
					"content": "Có điều... Delusion chính là báu vật của Fatui bọn ta, cho ngươi biết một chút cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000306,
					"content": "Vậy đi, ngươi giúp ta làm một việc. Ngươi thấy mấy tên Đạo Bảo Đoàn gần thành Mondstadt chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000307,
					"content": "Mặc dù chỉ là một lũ trộm vặt lén lút, nhưng thi thoảng bọn chúng lại có thể tìm được bảo bối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000308,
					"content": "Ngươi giúp ta đi một chuyến, lấy chút đồ từ trên tay của đám Đạo Bảo Đoàn về đây, để đổi lại ta sẽ kể cho ngươi nghe về Delusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000309,
					"content": "Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "Ta thích những người thẳng thắn, ngươi mau đi đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000311,
					"content": "Anh thiếu tiền à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "Thiếu tiền? Hahaha, ngươi cho rằng bọn ta là đội Kỵ Sĩ Tây Phong sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000313,
					"content": "Ta muốn xem xem, Đạo Bảo Đoàn có thể lấy được thứ gì từ Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000314,
					"content": "Tuy nhiên... he he, có lẽ bọn chúng cũng chẳng lấy được bảo bối gì đáng giá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
