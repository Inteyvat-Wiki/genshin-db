					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810704,
					"content": "Tìm chỗ nào đó nghỉ ngơi vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "Chúng ta đi quanh đây xem thử, tìm chỗ nào để dùng bữa đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810709,
					"content": "Xung quanh đây có vẻ không có quán ăn nào thích hợp cả... Nếu tùy tiện chọn thì tệ với tiền bối quá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810710,
					"content": "Kể ra thì, tòa nhà xây dựng trên tảng đá lớn phía trước kia chính là <color=#00E1FFFF>Nhà Trọ Vọng Thư</color> nổi tiếng phải không nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810711,
					"content": "Trước đây tôi cũng từng nghe thương nhân từ Liyue đến Mondstadt làm ăn nói là đồ ăn ở đó ngon lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810712,
					"content": "Để tôi mời tiền bối một bữa thịnh soạn coi như lời cảm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810713,
					"content": "Được! Đi ăn món ngon nào!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810705,
					"content": "Paimon, nổi lửa nấu cơm nào!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "Này, sai tôi làm này làm kia cũng vừa thôi chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810707,
					"content": "#Với cả trình độ nấu nướng của tôi thì {NICKNAME} rõ quá rồi mà...",
