			"dialogs": [
				{
					"id": 706810701,
					"content": "Chụp ảnh chung với tiền bối quý giá thế này, tôi nhất định sẽ cất giữ cẩn thận!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
