					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "Mọi người cùng nhau thưởng thức món ngon...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Woa, món này cũng ngon, món kia cũng ngon luôn... Thật sự là ăn không nổi nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "Thỏa mãn quá!",
