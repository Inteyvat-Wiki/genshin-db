					"speakerTitle": "Gesine"
				},
				{
					"id": 706810702,
					"content": "Á, vừa mới thư giãn một chút mà đã thấy đói rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810703,
					"content": "Nói đến là bụng tôi cũng kêu ọc ọc luôn rồi nè...",
