			},
			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine tìm chưởng quỹ hỏi thăm thực đơn, sau đó gọi mấy món nổi tiếng có giá đắt đỏ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706811201,
					"content": "Nghe nói các món ăn Liyue đều rất chú trọng đến màu sắc và hương vị. Quả thật trông rất khác biệt đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811202
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811202,
					"content": "Mới chỉ nhìn thôi là đã thấy thèm rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811203,
					"content": "Mọi người cùng nhau thưởng thức món ngon...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811204
					]
				},
				{
					"id": 706811204,
					"content": "Woa, món này cũng ngon, món kia cũng ngon luôn... Thật sự là ăn không nổi nữa rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811205,
						706811206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811205,
					"content": "Thỏa mãn quá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811207
					]
				},
				{
					"id": 706811206,
					"content": "Mọi mệt mỏi khi đi đường đều tan biến rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811207
					]
				},
				{
					"id": 706811207,
					"content": "Tiền bối đã vất vả rồi. Nếu không có hai vị thì hẳn là tôi không thể nào đến được đây dễ dàng như vậy đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811208
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811208,
					"content": "Vừa rồi có nghe người của nhà trọ nói, tiếp tục đi về phía trước là tới <color=#00E1FFFF>Cảng Liyue</color> rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811209
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811209,
					"content": "Tôi định sẽ nghỉ ngơi ở đây vài ngày, hỏi thăm những du khách khác xem làm thế nào mới tìm được cao nhân ở bên ngoài. Sau đó mới quyết định xem sẽ đi tới đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811210
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811210,
					"content": "Tuy là đi cùng tiền bối rất vui, nhưng không thể cứ mãi làm lỡ thời gian của hai vị được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811211
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811211,
					"content": "Tiếp theo đây, tôi sẽ cố gắng để trở nên mạnh mẽ hơn, trở thành một nhà mạo hiểm đáng tin cậy như tiền bối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811212
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811212,
					"content": "Hihi, tuy là thời gian ở cùng nhau không dài, nhưng mà chúng tôi cũng rất vui đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811213,
					"content": "Hy vọng sau này có thể gặp lại ở nơi khác!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811214,
						706811215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811214,
					"content": "Vậy thì chúng ta có duyên lại gặp nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811215,
					"content": "Hy vọng cô sẽ đạt được ước nguyện!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811216,
					"content": "Ừm! Tiền bối cũng vậy nhé, chúc hai vị thuận buồm xuôi gió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811217
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811217,
					"content": "Gesine vẫy tay chào tạm biệt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811218
					]
				},
				{
					"id": 706811218,
					"content": "Nếu đã đến đây rồi, chúng ta cũng đi dạo xung quanh đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811219,
					"content": "Biết đâu gặp được điều gì thú vị thì sao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
