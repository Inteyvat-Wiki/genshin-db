			"dialogs": [
				{
					"id": 706810301,
					"content": "Phù... Coi như được cứu rồi... Cảm ơn nhiều nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810302,
					"content": "Tôi là Gesine, như hai vị thấy đó, tôi là một nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810303,
					"content": "Hai vị lợi hại như thế, nhất định không phải người thường! Chẳng lẽ là kỵ sĩ tốt bụng hả? Hay là hiệp sĩ ngao du khắp nơi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810304,
					"content": "Tôi chỉ là nhà lữ hành qua đường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#Tôi là Paimon, đây là {NICKNAME}. Thật ra chúng tôi cũng là thành viên của Hiệp Hội Nhà Mạo Hiểm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810310,
					"content": "Thì ra là tiền bối à! Đúng là núi cao còn có núi cao hơn, ma vật khó đối phó như vậy mà hai vị lại xử lý nhanh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810311,
					"content": "Chẳng giống tôi, rõ ràng lúc huấn luyện đều nhớ hết động tác rồi, thế mà khi thực chiến thì chân tay lại chẳng chịu nghe lời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810312,
					"content": "Giống như thầy giáo nói, tôi vẫn phải rèn luyện thêm ba năm nữa sao? Nhưng mà tay không trở về như vậy thì xấu hổ chết mất... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810313,
					"content": "Tôi thấy chỉ là chênh lệch về kinh nghiệm thôi mà. Chúng tôi cũng phải thực chiến rất nhiều mới được như bây giờ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810314,
					"content": "Đầu tiên là phải giữ được bình tĩnh đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "Đúng đó. Người mới thì hay bị hoảng loạn, nên khó mà phát huy được thực lực vốn có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810316,
					"content": "Dù kẻ địch trông có vẻ rất mạnh, nhưng cũng phải bình tĩnh quan sát để tìm ra nhược điểm của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810317,
					"content": "Như vậy sẽ có thể nhanh chóng chiến thắng hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810320,
					"content": "Ra là thế... Không hổ danh là tiền bối! Xem ra tôi phải vừa du ngoạn vừa rèn luyện thêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810321,
					"content": "Cô cũng đang đi du ngoạn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "Đúng thế... Tôi chuẩn bị tới <color=#00E1FFFF>Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810323,
					"content": "Hai vị có nghe về võ học của Liyue chưa? Nghe nói có thể khiến người ta bay nhảy trên không, đao thương bất nhập, chém sắt như bùn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810324,
					"content": "Nếu có thể thỉnh giáo cao nhân, học hỏi đôi điều thì việc thám hiểm sau này sẽ nhẹ nhàng hơn nhiều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810325,
					"content": "Nhưng mà nói thật, tuy đã gia nhập Hiệp Hội Nhà Mạo Hiểm một thời gian rồi, nhưng đây là lần đầu tiên tôi đi xa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810326,
					"content": "Haiz, vừa mới ra khỏi thành chưa được bao lâu là đã bị ma vật chặn lại. Liệu tôi có thể thuận lợi đi đến Liyue không đây...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810327,
					"content": "Chúng tôi cũng đang định tới Liyue đó.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "Thật sao? Chẳng lẽ tiền bối cũng định tìm kiếm cao nhân à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810330,
					"content": "Không đâu. Vì vài nguyên nhân nên chúng tôi đang đi du ngoạn khắp các quốc gia thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810331,
					"content": "Tuy là chưa biết quá nhiều về Liyue, nhưng mà sớm muộn gì chúng tôi cũng sẽ tới đó xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810332,
					"content": "Nếu vừa hay tiện đường thì cùng đi chung, có gì hỗ trợ nhau cũng được mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810333,
					"content": "Woa, có thể được hành động cùng tiền bối lợi hại thế này... Hành trình của tôi đầy hy vọng rồi đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810334,
					"content": "Vậy để tôi dẫn đường cho. Trước khi xuất phát tôi đã nghiên cứu kỹ bản đồ rồi, đảm bảo sẽ không lạc đường đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810328,
					"content": "Có muốn tham gia cùng không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "Việc phán đoán tình hình cũng quan trọng không kém.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "Đúng đó. Nếu nhận thấy kẻ địch mạnh hơn thì phải kịp thời rút lui. Cố tình chiến đấu sẽ nguy hiểm lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810305,
					"content": "Tôi không tiện tiết lộ thân phận...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "#Tôi hiểu mà! {F#Cô}{M#Cậu} nhất định là người mang sứ mệnh bí ẩn, chỉ có thể âm thầm hành động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810307,
					"content": "Cũng đại khái là như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "Được rồi đó, đừng vòng vo mãi thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
