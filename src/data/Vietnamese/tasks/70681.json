			},
			"dialogs": [
				{
					"id": 706813101,
					"content": "Phù... Coi như được cứu rồi... Cảm ơn nhiều nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813102
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813102,
					"content": "Tôi là Gesine, như hai vị thấy đó, tôi là một nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813103
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813103,
					"content": "Hai vị lợi hại như thế, nhất định không phải người thường! Chẳng lẽ là kỵ sĩ tốt bụng hả? Hay là hiệp sĩ ngao du khắp nơi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813104,
						706813105
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813104,
					"content": "Tôi chỉ là nhà lữ hành qua đường thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813109
					]
				},
				{
					"id": 706813109,
					"content": "#Tôi là Paimon, đây là {NICKNAME}. Thật ra chúng tôi cũng là thành viên của Hiệp Hội Nhà Mạo Hiểm đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813110,
					"content": "Thì ra là tiền bối à! Đúng là núi cao còn có núi cao hơn, ma vật khó đối phó như vậy mà hai vị lại xử lý nhanh thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813111
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813111,
					"content": "Chẳng giống tôi, rõ ràng lúc huấn luyện đều nhớ hết động tác rồi, thế mà khi thực chiến thì chân tay lại chẳng chịu nghe lời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813112
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813112,
					"content": "Giống như thầy giáo nói, tôi vẫn phải rèn luyện thêm ba năm nữa sao? Nhưng mà tay không trở về như vậy thì xấu hổ chết mất... Huhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813113
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813113,
					"content": "Tôi thấy chỉ là chênh lệch về kinh nghiệm thôi mà. Chúng tôi cũng phải thực chiến rất nhiều mới được như bây giờ đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813114,
						706813118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813114,
					"content": "Đầu tiên là phải giữ được bình tĩnh đã.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813115
					]
				},
				{
					"id": 706813115,
					"content": "Đúng đó. Người mới thì hay bị hoảng loạn, nên khó mà phát huy được thực lực vốn có.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813116,
					"content": "Dù kẻ địch trông có vẻ rất mạnh, nhưng cũng phải bình tĩnh quan sát để tìm ra nhược điểm của chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813117,
					"content": "Như vậy sẽ có thể nhanh chóng chiến thắng hơn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813120,
					"content": "Ra là thế... Không hổ danh là tiền bối! Xem ra tôi phải vừa du ngoạn vừa rèn luyện thêm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813121
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813121,
					"content": "Cô cũng đang đi du ngoạn à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813122
					]
				},
				{
					"id": 706813122,
					"content": "Đúng thế... Tôi chuẩn bị tới <color=#00E1FFFF>Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813123
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813123,
					"content": "Hai vị có nghe về võ học của Liyue chưa? Nghe nói có thể khiến người ta bay nhảy trên không, đao thương bất nhập, chém sắt như bùn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813124
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813124,
					"content": "Nếu có thể thỉnh giáo cao nhân, học hỏi đôi điều thì việc thám hiểm sau này sẽ nhẹ nhàng hơn nhiều đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813125
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813125,
					"content": "Nhưng mà nói thật, tuy đã gia nhập Hiệp Hội Nhà Mạo Hiểm một thời gian rồi, nhưng đây là lần đầu tiên tôi đi xa đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813126
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813126,
					"content": "Haiz, vừa mới ra khỏi thành chưa được bao lâu là đã bị ma vật chặn lại. Liệu tôi có thể thuận lợi đi đến Liyue không đây...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813127,
						706813128
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813127,
					"content": "Chúng tôi đã từng đến Liyue rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813129
					]
				},
				{
					"id": 706813129,
					"content": "Woa, được tiền bối lợi hại quan tâm, vậy là hành trình của tôi có hy vọng rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813130
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813130,
					"content": "Nhưng mà, chắc là tiền bối bận rộn lắm, lại phải tốn thời gian để ý tới tôi nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813131,
						706813132
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813131,
					"content": "Hành hiệp trượng nghĩa là chuyện thường ngày của tôi rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813133
					]
				},
				{
					"id": 706813133,
					"content": "Vậy tôi làm phiền hai vị một thời gian rồi! Trước khi xuất phát, tôi đã nghiên cứu bản đồ kỹ càng rồi, sẽ cố gắng không gây trở ngại đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813132,
					"content": "Giúp đỡ hậu bối cũng là chuyện nên làm mà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813133
					]
				},
				{
					"id": 706813128,
					"content": "Tôi có thể dẫn cô đi một chuyến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813129
					]
				},
				{
					"id": 706813118,
					"content": "Việc phán đoán tình hình cũng quan trọng không kém.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813119
					]
				},
				{
					"id": 706813119,
					"content": "Đúng đó. Nếu nhận thấy kẻ địch mạnh hơn thì phải kịp thời rút lui. Cố tình chiến đấu sẽ nguy hiểm lắm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706813105,
					"content": "Tôi không tiện tiết lộ thân phận.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813106
					]
				},
				{
					"id": 706813106,
					"content": "#Tôi hiểu mà! {F#Cô}{M#Cậu} nhất định là người mang sứ mệnh bí ẩn, chỉ có thể âm thầm hành động...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813107
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706813107,
					"content": "Cũng đại khái là như thế.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813108
					]
				},
				{
					"id": 706813108,
					"content": "Được rồi đó, đừng vòng vo mãi thế!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813109
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
