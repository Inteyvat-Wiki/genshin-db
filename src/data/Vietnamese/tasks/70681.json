			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "Tiền bối! Ngại quá, có thể đợi ở đây một lát không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810402,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "Quên đồ gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810404,
					"content": "Không phải. Tôi xem bản đồ thì đi tiếp về phía trước là ra khỏi Mondstadt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810405,
					"content": "Chẳng biết khi nào mới trở về... Thầy giáo thấy thư tôi để lại, nói không chừng sẽ nổi giận mất...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810406,
					"content": "Ban nãy có nghe cô nhắc đến thầy giáo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "Đúng vậy... Khi vừa trở thành nhà mạo hiểm, thầy ấy đã gặp phải Bạo Đồ Hilichurl ở nơi hoang dã. Kết quả là trong lúc chiến đấu không cẩn thận bị một cây rìu đánh ngất luôn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810409,
					"content": "May mà có một kỵ sĩ đi ngang qua đã cứu thầy ấy về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810410,
					"content": "Thầy ấy cảm thấy rất mất mặt, nên đã quyết định ở trong thành rèn luyện võ nghệ đến đỉnh cao rồi mới ra ngoài thám hiểm. Và thế là đã mười năm trôi qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810411,
					"content": "Thầy ấy luôn nói rằng nền tảng là quan trọng nhất, nhưng mà tôi thật sự không chịu nổi việc ngày nào cũng phải chặt cọc gỗ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810412,
					"content": "Cho nên tôi đã giấu thầy mà đi ra ngoài một mình...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810413,
					"content": "Khi nào mạnh lên thì trở về vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "Ừm! Tôi cũng nghĩ vậy đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810416,
					"content": "À, tôi nghĩ ra rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810417,
					"content": "Gesine lấy hạt bồ công anh từ trong túi ra, đặt lên tay và nói gì đó với chúng, rồi để hạt giống bay theo gió...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "Theo phong tục của chúng tôi, bồ công anh có thể mang theo nguyện vọng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810419,
					"content": "Tôi vừa cầu nguyện, hy vọng chuyến đi này có thể thuận lợi đạt được mục tiêu, cũng hy vọng thầy giáo có thể hiểu cho tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810420,
					"content": "Phong Thần nhất định sẽ nghe thấy nguyện vọng của cô.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "Ừm! Chúng ta tiếp tục lên đường thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810414,
					"content": "Hãy đạt được thành tựu có thể khiến thầy của cô công nhận đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "Người đó cũng là nhà mạo hiểm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
