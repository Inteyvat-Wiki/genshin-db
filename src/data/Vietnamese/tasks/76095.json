						],
						"pointId": 107
					},
					{
						"sceneId": 103,
						"position": [
							156.335,
							170.333,
							410.095
						],
						"pointId": 108
					},
					{
						"sceneId": 103,
						"position": [
							154.182,
							170.359,
							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Istoria, hiện tại ba khu vực đều đã cơ bản được giải phóng rồi. Mọi người cũng gần như đều được cứu ra hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950302,
					"content": "Những thứ Zeitlind bị mất cũng đã tìm lại được cả rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950303,
					"content": "Ồ ồ, cảm ơn hai người nhiều. Sau khi Nihilita mở mắt thì nhìn người cũng chuẩn thật đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950304,
					"content": "Giờ thì đến lượt anh nói xem, phương pháp và cái giá để đi lên trên mà anh đề cập trước đó là gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950305,
					"content": "Nếu chỉ là thêm vài cuộc mạo hiểm nhỏ hay tốn chút Mora gì đó, thì Paimon tôi đây không sợ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950306,
					"content": "À còn nữa, chúng ta phải làm sao để đưa Zeitlind xuống đây? Việc của cô ấy đã xong rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950307,
					"content": "Không thành vấn đề. Nhưng mà hai người nghỉ ngơi chút đi, ngày mai tôi sẽ giải thích chi tiết cho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950308,
					"content": "Vậy cũng được. Nhưng ở đây không có giường, cũng đâu có gì ăn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950309,
					"content": "Ở nơi đây, khát vọng sẽ ngừng lại. Paimon có nhận ra không? Ở đây lâu như vậy rồi mà cô vẫn không đói, cũng không buồn ngủ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950310,
					"content": "Woa, vậy thì tôi phải làm gì cho hết một ngày nghỉ ngơi đây?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950311,
					"content": "Ở đây có đủ loại kỳ nhân dị sĩ xuyên suốt lịch sử, trò chuyện với họ chắc hẳn sẽ rất thú vị đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950312,
					"content": "#Thôi được rồi. Nhưng ngủ là quyền cơ bản của tôi, dù không buồn ngủ thì tôi cũng phải nằm trên đầu {NICKNAME} mà ngủ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950313,
					"content": "Zeitlind, khi nào nghỉ ngơi xong thì tôi muốn nói chuyện với cô. Chính là chuyện mà trước đó tôi đã nói là cần thời gian để suy nghĩ ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950314,
					"content": "Lát nữa đến nói chuyện với tôi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950315,
					"content": "Được thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME} và Paimon, hai người nghỉ ngơi xong rồi thì qua gặp tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
