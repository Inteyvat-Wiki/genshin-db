					}
				]
			},
			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}, Paimon cảm ơn hai người. Thật may mắn khi được gặp hai người vào thời điểm sau cùng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950102,
					"content": "Hihi, không có gì đâu. Tôi cảm thấy cô bị cuốn vào mấy chuyện này cũng là vì ở cùng chúng tôi thôi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950103,
					"content": "Ơ khoan đã, sao lại là \"sau cùng\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950104,
					"content": "Tuy đều là những cuộc phiêu lưu nguy hiểm, nhưng đã được chứng kiến rất nhiều điều kỳ diệu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950105,
					"content": "Cũng không tệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950106,
					"content": "Zeitlind, đừng có lảng tránh vấn đề như vậy chứ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950107,
					"content": "Có sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zeitlind"
				}
			]
		},
