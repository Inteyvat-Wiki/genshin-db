				]
			},
			"dialogs": [
				{
					"id": 760950501,
					"content": "#Nghỉ ngơi đủ rồi chứ? Những người thấy hứng thú, những chủ đề quan tâm, {F#cô}{M#cậu} đã trò chuyện xong cả chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950502,
					"content": "Vẫn chưa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "Hãy nghỉ ngơi cho tốt nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950506,
					"content": "Zeitlind, bình tĩnh nghe tôi nói đã. Tôi không có ý bất kính hay ảo tưởng gì đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950507,
					"content": "Có lẽ chị gái của cô vẫn chưa chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950508,
					"content": "Tôi đã thấy cả bia mộ rồi mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950509,
					"content": "Trên bia mộ thậm chí còn có cả ảnh của chị ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950510,
					"content": "Nhưng mà, biết đâu phía dưới bia mộ lại trống không thì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950511,
					"content": "Mặc dù tôi cũng rất mong là chị của Zeitlind không sao. Nhưng suy đoán của anh có vẻ hơi quá lạc quan rồi đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950512,
					"content": "Trong bức thư cuối cùng chị ấy gửi cho tôi có viết, chị ấy quyết tâm sẽ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950513,
					"content": "Lời từ biệt đó, chắc chắn không phải viết về việc cô ấy chuẩn bị kết thúc cuộc đời mình đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950514,
					"content": "Chị ấy nói là mình sắp đến một nơi rất xa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950515,
					"content": "Cô ấy đã nói với tôi. Ước mơ của cô ấy là đi vòng quanh thế giới một lần trước khi già đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950516,
					"content": "Hilda chỉ nói theo nghĩa đen thôi. Cô ấy đã rời khỏi viện điều dưỡng để đi chu du thế giới rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950517,
					"content": "Chị ấy còn kể cho anh nghe những chuyện này à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950518,
					"content": "Cô ấy luôn rất vui vẻ và hòa đồng với mọi người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950519,
					"content": "Vậy chắc chắn chị ấy chưa nói với anh là chúng tôi không còn người thân nào khác rồi đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950520,
					"content": "Chuyện này...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950521,
					"content": "Để tôi suy xét chuyện này một cách máu lạnh nhất vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950522,
					"content": "Nếu sự ra đi của chị ấy khiến ba, bốn người đau lòng, thì gánh nặng đó có lẽ sẽ chiến thắng được nỗi buồn của chị ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950523,
					"content": "Nhưng giờ chỉ còn lại mình tôi, và chị ấy biết rằng tôi rất hiểu chị ấy. Tôi sẽ tha thứ cho chị ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950524,
					"content": "Không phải như vậy, không thể nghĩ như thế được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950525,
					"content": "Không cần xót thương cho tôi đâu. Trong tuổi thơ của chúng tôi, cha mẹ vẫn còn, cuộc sống rất hạnh phúc. Những hồi ức này đủ để nâng đỡ chúng tôi trưởng thành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950526,
					"content": "Nhưng mà, thế giới của người lớn thật quá khó khăn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950527,
					"content": "Từ nhỏ tôi đã là người hướng nội, việc giao tiếp với người khác trong công việc luôn khiến tôi kiệt sức. Tôi cứ nghĩ chị gái hướng ngoại của mình sẽ như cá gặp nước.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950528,
					"content": "Nhưng sau khi lớn lên, trên khuôn mặt chị cũng thường xuyên lộ vẻ mệt mỏi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950529,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950530,
					"content": "Mọi người vẫn còn tương lai mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950531,
					"content": "Ồ, có vẻ chị ấy cũng không nói với anh về chuyện vị hôn phu của mình.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950532,
					"content": "Một người tốt bình thường, một người tốt thú vị. Tại sao anh ấy không phải là một kẻ xấu chứ? Giá mà là kẻ xấu thì tốt biết mấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950533,
					"content": "Gia đình anh ấy bị đoản mệnh di truyền, hình như là một loại bệnh lạ nào đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950534,
					"content": "Anh ấy cũng hay tự cười nhạo chính mình: Tại Phong Thần quy hoạch Mondstadt tốt quá, nên dòng máu không đáng được tiếp nối như nhà anh ấy cũng vẫn được truyền lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950535,
					"content": "Sau đó anh ấy nói rằng mình phải đi giải cứu thế giới, và rồi rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950536,
					"content": "Giải cứu thế giới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950537,
					"content": "Thế giới của chúng ta vẫn đang vận hành, không chừng là vì ở một góc khuất không người biết đến nào đó, anh ấy đã cứu thế giới chăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950538,
					"content": "Chẳng phải mọi người hay nói, \"Trong cuộc sống vĩnh hằng nếu không được mọi người yêu thương, rồi từ đó yêu thương lại mọi người, thì thế giới sẽ bị nỗi buồn nhấn chìm mất\" sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950539,
					"content": "Nói rất có lý. Nếu là sinh mệnh ngắn ngủi thì không xứng đáng để yêu thương.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950540,
					"content": "Anh ấy muốn dùng sinh mệnh của mình để yêu thương. Kết quả chỉ khiến chị gái tôi tổn thương sâu sắc hơn mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950541,
					"content": "Thậm chí còn khiến chị ấy phải vào viện điều dưỡng trên núi. Chính là viện điều dưỡng dưới chân chúng ta đây, một nơi bao phủ bởi lời nguyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950542,
					"content": "Cô ấy chưa từng nói với tôi về những điều này. Xin lỗi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950543,
					"content": "Sau khi nghe những điều này, anh vẫn muốn khăng khăng rằng chị gái tôi còn sống sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950544,
					"content": "Đúng vậy. Bởi vì cô ấy... đã làm một việc ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950545,
					"content": "Vì sự nhút nhát của tôi, cô ấy đành phải sống tiếp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950546,
					"content": "Tôi rất kính trọng anh, Istoria. Nhưng tôi nghĩ, có lẽ anh đã chứng kiến quá nhiều đau thương trong dòng chảy lịch sử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950547,
					"content": "Những hạt cát đau buồn đủ để nhấn chìm thế giới nhiều lần, chỉ một nắm là đã đủ vùi lấp cuộc đời bình thường của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950548,
					"content": "Anh không thể hiểu được chị em tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950549,
					"content": "Vậy nên, làm sao tôi có thể quay lại mặt đất? Tôi chỉ là kẻ tầm thường sống nay chết mai, không xứng đáng với sự vĩnh hằng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950550,
					"content": "Haiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950551,
					"content": "Anh Istoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950552,
					"content": "Trước đây nơi này trời đất không thông với nhau, chúng tôi tuyệt đối không thể rời đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950553,
					"content": "Nhưng sau khi Nihilita rơi xuống, dường như Dex có khả năng đưa những người đến từ thế giới hiện tại như mọi người qua lại giữa điện trụ và mặt đất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950554,
					"content": "Nhưng nó không thể đưa những người đã được chọn rời đi, bởi vì bản thân nó chính là ấu thể của người canh gác. Đây là quy tắc đã ăn sâu vào cơ thể nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950555,
					"content": "Gì cơ? Dex hóa ra lại giống như Nihilita sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950556,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950557,
					"content": "Nếu chúng tôi muốn xuống dưới, chỉ có cách từ bỏ tất cả ký ức và kiến thức, rồi lên đến nơi cao nhất. Trước đây là để yết kiến nữ chủ nhân, còn bây giờ là yết kiến Melanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950558,
					"content": "Vậy nên tôi không thể đi cùng mọi người rồi. Hãy để tôi tiễn mọi người nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950504,
					"content": "Xong cả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "Vậy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				}
			]
		},
