			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "Nhà lữ hành, tôi có thể giúp được gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110102,
					"content": "Về chuyện đến Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "Ừm, tôi có nghe nói chị đại của đội thuyền Nam Thập Tự đã hứa dẫn các bạn đến Inazuma đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110105,
					"content": "Đúng là ở đây đã rất lâu rồi không có tình báo gì đáng chú ý...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110106,
					"content": "Tìm được bạn rồi! Bạn chính là nhà lữ hành mà chị đại xem trọng đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Hải Long"
				},
				{
					"id": 20110107,
					"content": "Để bạn đợi lâu rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Ha ha, đúng là vinh hạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Hải Long"
				},
				{
					"id": 20110110,
					"content": "Công tác chuẩn bị trên thuyền đã gần xong rồi, đã đến giờ điểm danh thành viên rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Hải Long"
				},
				{
					"id": 20110111,
					"content": "Chị đại nhờ tôi đi tìm bạn, nói rằng khi bạn đến thì xuất phát ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Hải Long"
				},
				{
					"id": 20110112,
					"content": "Beidou quả nhiên là người giữ chữ tín.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110113,
					"content": "Đương nhiên rồi, đó là ưu điểm lớn nhất của chị đại mà, đợi bạn ra khơi rồi từ từ cảm nhận nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Hải Long"
				},
				{
					"id": 20110114,
					"content": "Hai vị chuẩn bị đi rồi sao? Chúc mừng nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110115,
					"content": "Dù cho con đường phía trước có chông gai đến đâu, nhưng bước thêm một bước về trước sẽ luôn là chuyện đáng để chúc mừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110116,
					"content": "Vậy tạm biệt nhé, chúc mọi người thuận buồm xuôi gió!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110117,
					"content": "Tiểu thư Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Có chút không nỡ thật, dẫu sao thì mỗi ngày chúng ta đều gặp nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110120,
					"content": "Ha ha, vậy khi đến Inazuma rồi thì ráng tìm tôi nhanh nhanh nhé, tôi sẽ đợi mọi người ở Đảo Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "Quả nhiên ở Inazuma cũng có một tiểu thư Katheryne! Vậy thì đâu cần phải tạm biệt trịnh trọng như vậy chứ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110124,
					"content": "Ha ha, chào tạm biệt Liyue đi nào, thuyền sẽ còn dừng ở gần Cô Vân Các, nếu như bạn đã nhận được thông báo rồi thì tôi quay về trước đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Hải Long"
				},
				{
					"id": 20110125,
					"content": "Ừm, làm phiền bạn rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110126,
					"content": "Không sao, chúng ta gặp lại nhau trên thuyền nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hải Long"
				},
				{
					"id": 20110122,
					"content": "...Tôi biết rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Chúng tôi cũng sẽ nhớ bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "Đã có tình báo rồi sao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "Về chuyện đội thuyền Nam Thập Tự...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
