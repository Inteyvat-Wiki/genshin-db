			"dialogs": [
				{
					"id": 20110301,
					"content": "Yo, mọi người cuối cùng cũng đến rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110302,
					"content": "Dù cho giông tố thế nào cũng sẽ không cản được bước tiến của đội thuyền Nam Thập Tự. Chuyến này tôi đã chiều theo ý bạn hết rồi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110303,
					"content": "Để bạn đợi lâu rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "Ha ha, nói đùa thôi, các bạn đến đúng lúc lắm, công tác ra khơi cũng vừa mới chuẩn bị xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110306,
					"content": "Nếu mọi người đã đến đủ rồi thì chúng ta xuất phát thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110307,
					"content": "Hướng đến vương quốc \"vĩnh hằng\", khởi hành!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110308,
					"content": "Xuất phát!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110304,
					"content": "Thật vinh hạnh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
