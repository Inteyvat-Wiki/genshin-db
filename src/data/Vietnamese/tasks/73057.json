				{
					"id": 730570501,
					"content": "Cái đó gọi là gì nhỉ... của Nara ấy? Aranakin không cần cái này để ngủ, vì vậy không biết từ đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570502,
					"content": "Là \"giường\", xem ra vẫn còn mới tinh... Trước đây có ai từng ngủ ở đây không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570503,
					"content": "Haha, Aranakin vẫn luôn dọn dẹp... Các bạn muốn ngủ ở đây cũng được luôn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305706,
			"completionStepIds": [
				7305714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305714",
							"2"
						],
						"stepId": 7305714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570601,
					"content": "Trên lầu vẫn còn những chiếc lá do Nara để lại, nhưng mà... tôi không đọc được, đọc không hiểu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570602
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570602,
					"content": "Đó là... những chiếc lá Nara dùng để lưu giữ ký ức, viết chữ trên những chiếc lá đó, rồi gom lại một chỗ. Nhưng chữ của Nara, Aranakin không hiểu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570606,
					"content": "Có phải ý bạn là... \"cuốn sổ\" không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570603,
					"content": "\"Cuốn sổ\"...? Đó là thứ mà Nara dùng để lưu giữ ký ức sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570604,
					"content": "Ừm, đúng vậy... Aranakin có ngại nếu chúng ta cùng lên lầu xem trong đó viết gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570605,
					"content": "Tôi sao? Không ngại đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305706",
							"2"
						],
						"stepId": 7305706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "Bên trong có những ký ức gì thế? Các bạn đã đọc được gì chưa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570702,
					"content": "Chủ nhân của cuốn sổ hình như biết bạn đấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "Vậy sao... Tôi không nhớ nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570704,
					"content": "Ông ấy nói... ông ấy cũng không thể gặp bạn nữa, vì đã lớn rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570705,
					"content": "Ồ... Lớn lên thật sự sẽ gặp rất nhiều phiền não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570706,
					"content": "Đúng rồi, ông ấy còn nói trong cuốn sổ rằng... bông hoa này dành cho bạn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570707,
					"content": "Ở đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "Hả...? Này! Đây là một bông hoa rất quan trọng! Sao bạn lại... sao ông ấy lại có nó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570709,
					"content": "Cùng một loại hoa mà, thật ra bạn cũng đã từng tặng nó cho chúng tôi... Chỉ là bạn không nhớ thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570710,
					"content": "Vậy sao... Tôi có thể làm bạn với các bạn thêm lần nữa. Nhưng... còn ông ấy, đến cả hình dáng ông ấy thế nào tôi cũng không nhớ nổi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570711,
					"content": "Không, không sao đâu... Bạn đừng đau buồn, chúng tôi vẫn còn bông hoa này, nhất định có thể cho bạn thêm nhiều ký ức hơn, đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570712,
					"content": "Ừm, Bông Trắng Bay Bay nói đúng lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570713,
					"content": "Tôi phải mang bông hoa này trở về, \"Mawtiyima\" có lẽ sẽ biết cách làm thế nào để đánh thức cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570714,
					"content": "#Ah... Nara {NICKNAME} và Bông Trắng Bay Bay, tôi phải về chỗ Aranaga rồi, mang cô ấy đi trồng, nghe cô ấy hát. Nếu các bạn rảnh thì hãy đến nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570715,
					"content": "Ừm ừm, chắc chắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
