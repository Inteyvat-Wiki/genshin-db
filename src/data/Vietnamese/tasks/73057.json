			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "\"...Đàn Oud bị Bác Bakr làm hỏng đã sửa xong, đừng ngồi khóc một mình được không? Nếu buồn thì cứ nói với tôi và Khayyam...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Cuốn Sổ Tay Cũ Kỹ"
				},
				{
					"id": 730570902,
					"content": "\"...Tôi đã được Giáo Viện chọn rồi, mau chúc mừng tôi đi! Tôi không muốn trở thành \"Vợ Của Chiến Binh\" gì đó, việc tôi muốn làm sau này là trở thành Đại Hiền Giả Siman!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Cuốn Sổ Tay Cũ Kỹ"
				},
				{
					"id": 730570903,
					"content": "\"...Hì hì, \"Nhạc Sĩ\" Irfan và Khayyam thông minh! Sau khi chia tay thì đừng quên mất tôi đấy! Nhất là bạn đó, Khayyam, đừng quên tôi đó!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Cuốn Sổ Tay Cũ Kỹ"
				},
				{
					"id": 730570904,
					"content": "\"...Tạm biệt, Sổ Ghi Chép! Tạm biệt Irfan, Siman, người bạn thân nhất của tôi! Mong rằng rừng sâu sẽ mãi mãi nhớ tới câu chuyện của chúng ta, mong rằng chúng ta cũng sẽ nhớ được họ...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Cuốn Sổ Tay Cũ Kỹ"
				},
				{
					"id": 730570905,
					"content": "(...Nội dung tiếp theo rất lộn xộn lại sinh động, đầy ắp hồi ức vui vẻ và đau buồn của trẻ thơ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Cuốn Sổ Tay Cũ Kỹ"
				},
				{
					"id": 730570906,
					"content": "\"...Aranakin không thấy đâu nữa, không biết từ lúc nào đã không thấy nữa rồi. Đã đến lúc tôi phải tạm biệt Đàn Oud rồi. Tôi sẽ trở thành thợ thủ công như mong muốn của cha...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Cuốn Sổ Tay Cũ Kỹ"
				},
				{
					"id": 730570907,
					"content": "(Hình như bên dưới còn viết thêm cái gì đó, nhưng đều bị bôi đen cả rồi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Cuốn Sổ Tay Cũ Kỹ"
				},
				{
					"id": 730570908,
					"content": "\"...Người đang đọc quyển sổ ghi chép này, tôi của nhiều năm sau, nếu có thể gặp được nhóm Aranakin một cách thần kỳ, xin hãy trả lại bông hoa này cho cậu ấy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Cuốn Sổ Tay Cũ Kỹ"
				},
				{
					"id": 730570909,
					"content": "Ơ... Hình như có cái gì đó rơi từ trong sách ra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "Hình như là... một đóa hoa? Giống như cái mà... chúng ta lấy được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
