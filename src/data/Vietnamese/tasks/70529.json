				"points": []
			},
			"dialogs": [
				{
					"id": 705290201,
					"content": "Xin chào! Chào mừng đến với Lễ Hội Hoa Gió, bạn đến thật đúng lúc, chỗ tôi đang tổ chức một trò chơi nhỏ có tên là \"Bài Ca Của Gió\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290202
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290202,
					"content": "Trong trò chơi này, bạn có thể chơi những giai điệu hay như nhà thơ trong Thành Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290203,
						705290204
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290203,
					"content": "Có thể so được với nhà thơ lang thang không...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				},
				{
					"id": 705290205,
					"content": "Yên tâm đi! Trò chơi nhỏ này tôi đã... À... Đã tìm rất nhiều người chơi thử rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290206
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290206,
					"content": "Ngay cả người không biết gì về nhạc cụ thì ít nhất cũng có thể đàn một bài... Ừm... ít nhất là một bài không tệ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290207
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290207,
					"content": "Hãy tin tôi! Tin vào Đội Kỵ Sĩ Tây Phong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290208
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290208,
					"content": "Chỉ cần tập trung theo kịp nhịp điệu và tiết tấu, chắc chắn có thể chơi một giai điệu hay một cách dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290209
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290209,
					"content": "Tập trung chơi một giai điệu hay trong gió... Bằng cách này, bạn chắc chắn có thể quên đi mọi muộn phiền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290210
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290210,
					"content": "Vậy nhà thơ lang thang hẳn là người ít muộn phiền nhất nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290211
					]
				},
				{
					"id": 705290211,
					"content": "Hahaha, vậy thì chưa chắc, dù sao thì họ cũng sẽ lo lắng theo bản năng, lo lắng về việc liệu bản nhạc này có hay đến mức mọi người sẵn sàng trả tiền cho nó hay không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290212
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290212,
					"content": "Còn bạn... chỉ cần đàn làm sao để bản thân cảm thấy vui vẻ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290213
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290213,
					"content": "E hèm! Lúc... lúc nãy tôi chưa nói gì nhé! Bạn hiểu rõ trò chơi này mà, đúng không? Nếu có hứng thú thì hãy thử đi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290214
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290214,
					"content": "Bạn có thể dùng nhạc cụ của mình, nếu bạn không có nhạc cụ thì chúng tôi có thể cho bạn mượn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290215
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290215,
					"content": "Hihi... Chúng tôi có rất nhiều nhạc cụ đấy, và mỗi cái đều không giống nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290216
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290216,
					"content": "Bạn muốn dùng nhạc cụ nào trước đây?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290217,
						705290218,
						705290219
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290217,
					"content": "Cung Đàn Của Gió.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290220,
					"content": "Cái này à, được thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290221
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290221,
					"content": "Đúng rồi! Còn một chuyện, còn một chuyện! Bạn chờ chút nhé, để tôi xem ghi chép...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290222
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290222,
					"content": "Ừm... à... để đảm bảo mọi người đều có thể chơi các giai điệu hay một cách suôn sẻ, chúng tôi đã quyết định thiết lập một thứ gọi là \"chỉnh âm\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290223
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290223,
					"content": "Nói một cách đơn giản, là giúp bạn điều chỉnh nhạc cụ đến trạng thái tốt nhất... Rất đơn giản, để tôi xem, bước thứ nhất là...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290224
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290224,
					"content": "Xong! Như vậy là được rồi, nhạc cụ đã được điều chỉnh đến trạng thái tốt nhất... nhạc phổ cũng đã chuẩn bị xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290225
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290225,
					"content": "Chỉ cần bạn đồng ý là sẽ có thể bắt đầu bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizz"
				},
				{
					"id": 705290218,
					"content": "Đàn Vang Vọng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290219,
					"content": "Trống Yến Tiệc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290204,
					"content": "Tôi sẽ đàn hay thật sao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				}
			]
		}
	]
}