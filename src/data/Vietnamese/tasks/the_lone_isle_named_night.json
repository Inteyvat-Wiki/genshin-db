			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "Không ngờ lại xảy ra chuyện như vậy... Milchi và người để lại những ghi chép này... đều rất dũng cảm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260602,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260603,
					"content": "Đây là... quả trứng Saurian đang ngủ trong ghi chép nhắc đến!",
					"roleType": "TALK_ROLE_NPC",
