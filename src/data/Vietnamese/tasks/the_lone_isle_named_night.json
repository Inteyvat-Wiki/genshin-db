			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "Phù... Sợ quá đi mất! Đột nhiên có ma vật tấn công, cũng may chúng ta đủ lợi hại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940602,
					"content": "Vậy thì lần sau nhờ cả vào Paimon nhé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "Hả? Không được, tôi không được đâu! Tôi không muốn chiến đấu với con ma vật đáng sợ kia đâu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940606,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "#{NICKNAME}, trông cậu nhóc có vẻ sốt ruột rồi. Chúng ta tìm cách ấp trứng trước đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940608,
					"content": "Khởi động lồng ấp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "Máy ấp trứng đã hoạt động trở lại...\\nViệc cần làm tiếp theo, e là chỉ có thể chờ đợi thôi...\\nNhiều giờ trôi qua, quả trứng vẫn không hề thay đổi, chẳng có chút biến động gì cả...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "Err... Errh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "Lạ thật. Hình như không có phản ứng nào hết nhỉ? Chẳng lẽ chúng ta thao tác sai rồi sao? Hay là chúng ta thử lại lần nữa đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940612,
					"content": "Thử lại lần nữa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "Các bạn khởi động lại lồng ấp theo hướng dẫn...\\nNhưng vẫn giống như lần trước, quả trứng vẫn không hề có bất cứ thay đổi gì...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "Ôi... Rốt cuộc là phải đợi bao lâu nữa đây? Mắt tôi sắp mờ luôn rồi... Chóng mặt quá... Đói quá đi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940615,
					"content": "Aww... Gurr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "Úi?! Từ từ! Hình như nó chuyển động kìa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940617,
					"content": "Hay là chờ thêm một lát nữa đi...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "Lại một thời gian dài nữa trôi qua...\\nQuả trứng vẫn như cũ, không có bất cứ động tĩnh gì, càng không có dấu hiệu gì là sắp nứt vỏ.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "Vẫn không có phản ứng nào... Chẳng lẽ lồng ấp bị hỏng à... Nhưng rõ ràng đèn vẫn sáng mà! Hay vấn đề nằm ở bản thân quả trứng nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940620,
					"content": "Hmm, cứ chờ đợi như thế này không phải là cách... Hay là chúng ta đem quả trứng đi nhé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940621,
					"content": "Có đói thế nào thì cũng đừng nghĩ đến việc ăn quả trứng này chứ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "Wraah! Wraah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#Còn lâu tôi mới ăn! Đừng để {REALNAME[ID(2)|SHOWHOST(true)]} nảy sinh suy nghĩ kỳ cục đấy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940626,
					"content": "Này nhóc à, ý là nếu vấn đề thật sự nằm ở quả trứng này, thì nó có thể mãi mãi cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940634,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#Đừng buồn nhé, {REALNAME[ID(2)|SHOWHOST(true)]}, chuyện bất đắc dĩ thôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940636,
					"content": "Có lẽ chỉ là môi trường ở đây không phù hợp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "Nói đúng lắm! Không nở ra thì có thể là vì trứng cảm thấy Natlan bây giờ cũng giống như khi xưa, không thích hợp để làm nhà của nó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940639,
					"content": "Dù sao thì nó vẫn luôn trốn ở đây, cơ bản là không thể biết được rằng bên ngoài đã trở thành nơi tuyệt vời thế nào mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940640,
					"content": "Cho nên, chúng ta cứ đem nó về chăm sóc thật tốt! Ngày nào cũng kể chuyện cho nó nghe! Kể về những phong cảnh tuyệt đẹp, những cuộc thám hiểm hấp dẫn, cả những con người rất tốt bụng nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940641,
					"content": "Tóm lại là để nó biết rằng Natlan bây giờ tuyệt vời thế nào! Đợi đến khi nó động lòng thì sẽ tự mình phá vỏ mà chui ra thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940642,
					"content": "...Brwarh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "Hoặc là, nó cảm thấy chưa đến lúc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} nghĩ thế nào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "Err... Errh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "Làm gì có chứ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#Hả?! Nhưng... vừa rồi rõ ràng là... Chẳng lẽ tôi bị ảo giác à? Không đúng, vừa nãy {REALNAME[ID(2)|SHOWHOST(true)]} có nhìn thấy không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940629,
					"content": "Err... Errh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#...Nhóc cũng không thấy sao? Chẳng lẽ thật sự là ảo giác à? Thế thì làm sao đây? {NICKNAME}, chúng ta vẫn đợi tiếp sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940631,
					"content": "Hay là... Vấn đề nằm ở quả trứng? Nhưng mà, nếu là như vậy thì tức là mãi mãi cũng không nở được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940632,
					"content": "Vấn đề chắc là ở quả trứng rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "Hả? Vậy tức là quả trứng này có thể mãi mãi không nở ra à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940604,
					"content": "Hmm, cũng bình thường thôi mà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "Đúng đó! Tôi còn tưởng là lợi hại lắm cơ! Kết quả thì chẳng đau bằng Saurian của chúng ta húc nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
