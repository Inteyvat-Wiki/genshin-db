				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950101,
					"content": "Đây là bảng cáo thị do Vizier đại nhân lập ra, mọi chuyện quan trọng trong Thành Sumeru đều công bố ở đây, nếu có vấn đề liên quan có thể nhắn lại tại đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "\"Thông báo về việc mời chuyên gia đến xử lý Hổ Lông Dài...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950202,
					"content": "Nội dung chính của thông báo đã bị bút lông bôi lên, bên cạnh là dòng chữ viết tay non nớt, nghiêng ngã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950203,
					"content": "\"Hổ Lông Dài chỉ muốn chơi với mọi người thôi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "\"Nếu bạn nhìn thấy tinh linh nhỏ nhảy múa sau khi ăn nấm thì đây chỉ là hiện tượng bình thường thôi, không cần phải lo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950302,
					"content": "\"Nhưng nếu như bạn phát hiện thực vật xung quanh bắt đầu nói chuyện thì phải lập tức liên hệ với nhân viên kiểm lâm gần nhất để nhờ giúp đỡ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "\"Vì nguyên nhân chưa rõ, dạo gần đây dù là số lượng hay diện tích của Tử Vực trong rừng đều tăng mạnh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950402,
					"content": "\"Tử Vực chẳng những khiến thực vật khô héo, mà còn có thể cướp đi tính mạng của động vật và con người. Đội Trưởng Kiểm Lâm đã đánh dấu nơi này là \"Khu Vực Ô Nhiễm\", xin mọi người đừng đến gần.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950403,
					"content": "Nếu trong quá trình đi lại trong rừng phát hiện Tử Vực mới xuất hiện, hãy liên hệ nhân viên kiểm lâm gần nhất, giao cho người chuyên nghiệp xử lý.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "Dạo này, trong quá trình Matra tuần tra thường ngày khắp Bazaar, đã khám phá ra nhiều vụ án giao dịch Hũ Tri Thức phi pháp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950502,
					"content": "Việc giao dịch Hũ Tri Thức đã bị Giáo Viện nghiêm cấm, một khi phát hiện sẽ nghiêm trị không tha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950503,
					"content": "Nếu có hậu quả gì xảy ra do sử dụng Hũ Tri Thức, Giáo Viện sẽ không chịu trách nhiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "\"\"Lễ Hội Sabzeruz\" mỗi năm một lần sắp diễn ra, năm nay Đại Khu Bazaar cũng sẽ cử hành lễ hội long trọng.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950602,
					"content": "\"Để lễ hội náo nhiệt hơn, năm nay cô chủ nhà tôi đã tài trợ đặc biệt cho các thương gia đến tham dự lễ hội.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950603,
					"content": "\"Mong là các vị có thể cùng nhau chúc mừng sinh nhật của Tiểu Vương Kusanali!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "\"Gần đây cô chủ nhà tôi bỏ nhà ra đi, đến giờ vẫn chưa về. Nếu như bạn nhìn thấy một cô gái trẻ tóc nâu, mặc áo tím váy dài màu lam, hãy liên lạc với nhà Homayani, chắc chắn sẽ hậu tạ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950702,
					"content": "\"Nếu cô chủ thấy thông báo hãy nhanh chóng liên lạc với người nhà, ông chủ và bà chủ rất lo cho cô.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "\"Về rồi! Chủ nhân Al-Ahmar của tôi về rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950802,
					"content": "\"Vào ngày ngài ấy quay lại, những kẻ mọc lá cây trên đầu như các ngươi đều sẽ gặp báo ứng!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950803,
					"content": "Đây là tin giả, chúng tôi đang truy xét nguồn tung tin thất thiệt này. Mọi chuyện lớn trong và ngoài Sumeru đều được định kỳ thông báo trong Akasha, mọi người đừng tin lời đồn thất thiệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "\"Bạn đang gặp chuyện gì khó khăn sao? Đại Nhân Sangemah Bay người biết hết mọi thứ, sẽ chân thành đưa ra các phương án giải quyết cho bạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950902,
					"content": "\"Chỉ cần trả một ít Mora là có thể giải quyết bất kỳ vấn đề nào.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950903,
					"content": "\"Tâm động không bằng hành động, cách thức liên lạc như sau...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731950904,
					"content": "Đây là bảng cáo thị do Vizier đại nhân lập nên vì để quy định hành vi giao dịch trên thị trường, yêu cầu mọi người không dán quảng cáo ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319510,
			"completionStepIds": [
				7319510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319510",
							"2"
						],
						"stepId": 7319510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "\"Mọi người biết ở đây có người kể chuyện giỏi nào không? À, kiểu như mỗi câu chuyện đều có thể kể giống hệt nhau không chênh lệch chút nào.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951002,
					"content": "\"Tôi bị một Trấn Linh đáng sợ bám riết, uy hiếp nếu tôi không thể mỗi ngày kể một câu chuyện giống hệt nhau thì sẽ giết chết tôi. Đã qua một tháng rồi, giờ đầu tôi sắp vỡ tung rồi, thật sự quá giày vò...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951003,
					"content": "\"Trải nghiệm của anh thật ly kỳ, nhưng tôi nghe nói Tiệm Cà Phê Puspa có một người kể chuyện tên Maddah, biết đâu chừng có thể giúp được cho anh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "\"Tôi đi qua nhiều nước, xem qua vô số màn trình diễn, theo tôi thì không cần đắn đo, điệu múa của cô Nilou chắc chắn đứng đầu Teyvat. Ngờ đâu những học giả của Giáo Viện chẳng những không biết thưởng thức, còn ngày ngày khua tay múa chân, đúng là sỉ nhục nghệ thuật.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951102,
					"content": "\"Theo kinh nghiệm ở Mondstadt của tôi, cần phải tổ chức hội hâm mộ cho cô Nilou, có thế thì những kẻ không am hiểu nghệ thuật kia mới không dám nói này nói nọ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951103,
					"content": "\"Hội hâm mộ... là phong tục của người Mondstadt sao? Nhưng... vở kịch hoàn hảo là sự nỗ lực của mọi người trong đoàn, chỉ để mắt mỗi một người thì không được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951104,
					"content": "\"Hơn nữa, tôi tin rằng, bản thân nghệ thuật cũng đủ thành mối liên hệ của mọi người rồi. Tôi rất vui khi bạn thích điệu múa của cô Nilou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951105,
					"content": "\"Thấy chữ viết đẹp mắt như vậy, chắc bạn là một cô gái trẻ nhỉ. Có thể gặp được người cùng sở thích thưởng thức kịch thật tốt quá, xin hỏi bạn có rảnh để hẹn gặp không?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951106,
					"content": "\"Xin lỗi, tôi rất bận, có việc gì xin cứ nói với quản lý.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951107,
					"content": "\"Xem ra tên này bị từ chối rồi, trang cuối rõ ràng do một người đàn ông cơ bắp viết... có lẽ là vệ sĩ sa mạc của tiểu thư nhà giàu nào đó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319512",
							"2"
						],
						"stepId": 7319512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "\"Bán bình ma sai khiến Trấn Linh, hãy để tiền ở đây. Chỉ cần một Mora là có thể thực hiện bất kỳ nguyện vọng nào của bạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951202,
					"content": "\"Bán bình ma thực hiện nguyện vọng, bất kỳ nguyện vọng nào cũng được, chỉ cần một Mora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951203,
					"content": "\"Tôi là Trấn Linh, chỉ cần cho tôi một Mora, muốn gì tôi cũng có thể thực hiện giúp bạn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951204,
					"content": "\"Đối với những vụ án lừa gạt phát sinh gần đây, Đại Sảnh Regzar đã vào cuộc điều tra, mọi người đừng quá hoảng hốt.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951205,
					"content": "\"Nếu dân chúng bị hại có thắc mắc gì muốn được tư vấn, phí tư vấn chỉ một Mora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319513",
							"2"
						],
						"stepId": 7319513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "\"Từ khi làm đội trưởng kiểm lâm, mỗi ngày đều ở trong rừng, một thời gian sau còn muốn nói chuyện với cả Chim Hoàng Hôn cơ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951302,
					"content": "\"Nếu tôi nghe hiểu chúng nói gì thì tốt rồi, đâu đến mức ngày ngày nhàm chán như bây giờ đâu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
						],
						"stepId": 7319514,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "\"Nhắc đến thì lúc trước có một lính đánh thuê rất được, tôi nhớ gọi là \"Sư Tử Lửa\" gì đó...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951402,
					"content": "\"Lúc trước mỗi lần ra biển buôn bán đều thuê cô ấy làm hộ vệ, chẳng cần phải sợ dù là Đạo Bảo Đoàn hay Thiên Nham Quân gì cả. Nhờ có cô ấy mà tôi kiếm được nhiều lắm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951403,
					"content": "\"Nhưng gần đây dường như không thấy cô ấy nhận lời ủy thác, hơn nữa nghe nói trên đường đến Liyue nhiều ma vật hơn rồi... Cứ tiếp tục như vậy tôi chỉ có nước bỏ tiền vào Sở Giao Dịch Kalimi thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951404,
					"content": "\"Nghe có vẻ không giống một người làm ăn chân chính gì... Nhưng anh nhắc đến \"Sư Tử Lửa\", tôi nghe nói gần đây cô ấy đang nhận đơn hàng lớn của nhà Homayani, chắc anh phải chờ một thời gian dài đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951405,
					"content": "\"Thêm một lời khuyên, có tiền thì thà mua trăm cái thảm còn hơn bỏ vào Sở Giao Dịch Kalimi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951406,
					"content": "\"Ông chú này nói đúng lắm! Hãy đến tiệm của tôi mua trăm cái thảm, để tôi giới thiệu chi tiết về công dụng của từng cái cho quý khách!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319515,
			"completionStepIds": [
				7319515
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319515",
							"2"
						],
						"stepId": 7319515,
