			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951501,
					"content": "Nếu ở trong rừng gặp phải người có ánh mắt lờ đờ hoặc tự lẩm bẩm, họ là học giả đang trong \"Kỳ Satyavada\", đừng quấy rầy họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951502,
					"content": "Nếu có gây phiền hà đến cho bạn, hãy báo cho Mahamata và giao cho Giáo Viện giải quyết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319516,
			"completionStepIds": [
				7319516
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319516",
							"2"
						],
						"stepId": 7319516,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "\"Nghe nói trước kia, Diwan là cơ quan từng lên tiếng thay cho dân chúng khu thành dưới chúng ta, nhưng giờ chỉ biết nghe theo lời của Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951602,
					"content": "\"Vizier gì chứ, bình thường nói chuyện cũng chẳng giữ lời, chỉ khi Mahamata muốn đùn đẩy trách nhiệm thì mới xuất hiện mà thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "Bảng Cáo Thị"
				},
				{
					"id": 731951603,
					"content": "Hướng dẫn của Giáo Viện đối với các cơ quan hành chính là dựa trên giáo huấn của Đại Vương Rukkhadevata, người không phận sự không được vu khống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
		{
			"id": 7319517,
			"completionStepIds": [
				7319517
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319517",
							"2"
						],
						"stepId": 7319517,
