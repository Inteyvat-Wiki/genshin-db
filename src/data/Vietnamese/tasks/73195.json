					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951701,
					"content": "\"Tòa thành của trí tuệ thuộc về chúng ta, rừng cây không ánh sáng cũng thế. Trên tán cây chứa đầy tàn tích của vương quốc những giấc mơ đã mất.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Cáo Thị"
				}
			]
		},
