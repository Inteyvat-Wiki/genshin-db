						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "Hử? Tôi thấy anh cũng đang hỏi tiểu thư Margaret về việc của Tiểu Hoàng Tử mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "Ồ, hóa ra con mèo trộm mất <color=#00E1FFFF>Dây Đàn Tinh Tú</color> của tôi, tên là Tiểu Hoàng Tử à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Tuy rằng được thấy sinh linh của Mondstadt tự do tự tại như vậy, là việc tốt... nhưng cũng hơi tự do quá rồi nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870107,
					"content": "Haha, Tiểu Hoàng Tử chính là một bảo bối nghịch ngợm đáng yêu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870108,
					"content": "Đây chính là điển hình của kiểu phụ huynh thích nuông chiều con cái nhỉ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870109,
					"content": "Giống như Barbatos vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Hahaha... Thật là một sự so sánh kỳ cục. Đi tìm Tiểu Hoàng Tử trước nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "Tối nay tôi còn có suất diễn, nếu không lấy lại được dây đàn, thì phải khiến khán giả thất vọng rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "Nhưng mà tại sao mèo lại đi lấy trộm dây đàn của Venti chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "Mèo đều thích nghịch cuộn dây mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "Vậy sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "Dây đàn làm từ Tinh Thiết có chứa sức mạnh Nguyên Tố Phong, đàn hồi cực tốt, cho nên bình thường tôi đều cuộn thành một cuộn mang theo bên người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "Đây là bí mật nhỏ của nhà thơ lang thang, hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "Hở? Anh nói trên sợi dây có sức mạnh Nguyên Tố Phong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#Vậy được, chúng ta có manh mối rồi! {NICKNAME}, mau dùng <color=#00E1FFFF>Góc Nhìn Nguyên Tố</color> để xem thử đi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "Chắc sẽ tìm thấy dấu vết Nguyên Tố Phong nào đó nhỉ, ví dụ... dấu chân hay gì đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870122,
					"content": "Nhờ mọi người rồi, Tiểu Hoàng Tử chắc là ở gần khu thương mại hoặc khu dân cư trong thành thôi, chắc mọi người vẫn nhớ nhỉ, Tiểu Hoàng Tử là một con mèo có màu đen tuyền.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "A... phải rồi, miếng <color=#00E1FFFF>thịt cá</color> này là món Tiểu Hoàng Tử nhà tôi thích nhất, cứ mang theo có thể sẽ giúp ích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		}
