			"dialogs": [
				{
					"id": 4871001,
					"content": "Tiểu Hoàng Tử! Thật là một bảo bối biết nghe lời, đã tự trở về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871002,
					"content": "Phù... phù... đi một vòng lớn như vậy, cuối cùng lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871003,
					"content": "A, Tiểu Hoàng Tử, sao lại nhẫn tâm bỏ rơi ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871004,
					"content": "Đã vào \"thế giới hai người\" rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871005,
					"content": "Xem bộ dạng của hai người, chẳng lẽ là vô tình đuổi nó quay lại?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871006,
					"content": "Hahaha... không bắt được cũng đừng buồn, chí ít công lao cũng là của hai người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871007,
					"content": "Ồ, Dây Đàn Tinh Tú quả nhiên vẫn ở trên người đứa nhóc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871008,
					"content": "Để tỏ lòng biết ơn, dùng dây đàn này để biểu diễn cho hai vị, cũng không tồi nhỉ! ...Ah, ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871009,
					"content": "Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871010,
					"content": "Hắt xì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871011,
					"content": "Khịt... A ha ha... ở gần Tiểu Hoàng Tử như vậy, thể chất dị ứng với mèo của tôi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871012,
					"content": "Chả trách anh không tự đi bắt được nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871013,
					"content": "Hihi, cảm ơn đã giúp tôi nhé, tôi xin phép đi trước... a, aa... hắt xì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
