			"dialogs": [
				{
					"id": 4870501,
					"content": "Thật là biết cảnh giác, Tiểu Hoàng Tử chạy đi mất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870502,
					"content": "Nghĩ cách <color=#00E1FFFF>tiếp cận phía sau nó</color> vậy, tốt nhất là ngồi xuống, khiến cho bước chân nhẹ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870503,
					"content": "Không biết bay đúng là phiền phức, hì hì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870504,
					"content": "Nếu không yên tâm, hay là dùng <color=#00E1FFFF>thịt cá</color> để thu hút Tiểu Hoàng Tử trước, mèo đều thích ăn cá phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870505,
					"content": "Nếu hết <color=#00E1FFFF>thịt cá</color> thì đi đến hồ gần đây bắt, mau hành động thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
