			"dialogs": [
				{
					"id": 4870301,
					"content": "Tiểu Hoàng Tử! Chạy đi đâu vậy, cuối cùng cũng về rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870302,
					"content": "Làm chúng tôi tìm mãi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870303,
					"content": "A, Tiểu Hoàng Tử, sao lại nhẫn tâm bỏ rơi ta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870304,
					"content": "Đã vào \"thế giới hai người\" rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870305,
					"content": "Dây Đàn Tinh Tú của anh đây, Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870306,
					"content": "Hai người tìm thấy rồi à! Tôi vốn đã không còn hy vọng gì nữa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870307,
					"content": "Để tỏ lòng biết ơn, dùng dây đàn này để biểu diễn cho hai vị, cũng không tồi nhỉ! ...Ah, ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870308,
					"content": "Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870309,
					"content": "Hắt xì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870310,
					"content": "Khịt... A ha ha... ở gần Tiểu Hoàng Tử như vậy, thể chất dị ứng với mèo của tôi lại...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870311,
					"content": "Chả trách anh không tự đi bắt được nó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870312,
					"content": "Hihi, cảm ơn đã giúp tôi nhé, tôi xin phép đi trước... a, aa... hắt xì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
