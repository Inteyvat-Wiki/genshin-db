			"dialogs": [
				{
					"id": 200030501,
					"content": "Mona, cô có ở nhà không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030502,
					"content": "Mona, đến ngày trả tiền thuê nhà rồi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "Chậc... hình như Mona không có ở nhà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030504,
					"content": "Kỳ lạ, bình thường không phải cô ấy lúc nào cũng ở nhà sao? Lẽ nào hôm nay ra ngoài có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030505,
					"content": "Lẽ, lẽ nào! Mona đã bị ngất trong nhà, không còn sức ra mở cửa nữa sao!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030506,
					"content": "Không đến nỗi vậy đâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "Vậy sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030509,
					"content": "Nhưng mà, chúng ta phải đi đâu để tìm Mona đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030507,
					"content": "Trước đây cô ấy từng nói là đã tìm ra cách để kiếm tiền.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
