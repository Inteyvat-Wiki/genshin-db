			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "Cảm ơn cháu, số gỗ này đủ rồi, bây giờ ta sẽ đưa nó cho thợ mộc... đúng rồi, phải đi thu tiền nhà mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030302,
					"content": "Haiz, cũng không biết... mona... me...me... gì gì đó lần này có ở nhà không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030303,
					"content": "Là Mona Megistus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "Đúng! Chính là cái tên này, ôi... ta thật sự không nhớ nổi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030305,
					"content": "Ủa? Mona vẫn chưa trả tiền thuê nhà sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030306,
					"content": "Chứ sao nữa, những người khác đều trả hết rồi, chỉ còn lại cô ấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030307,
					"content": "Ta đã đến đó mấy lần, nhưng cô ấy đều không ở nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030308,
					"content": "Nhà Lữ Hành, hãy giúp ta thúc giục cô ấy trả tiền thuê nhà nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
