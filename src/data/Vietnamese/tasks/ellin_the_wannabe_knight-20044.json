				"points": []
			},
			"dialogs": [
				{
					"id": 200440101,
					"content": "Thật nhức đầu... ở đây phải giải quyết như thế nào chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440102,
					"content": "Đang làm gì vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "Vì đợt tuyển chọn kỵ sĩ sắp tới, tôi đang phải huấn luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440104,
					"content": "Ừm... nhưng mà, tôi không có sức mạnh như đại nhân Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440105,
					"content": "So với việc tập luyện \"sức mạnh\", tôi cảm thấy việc học \"kỹ năng\" thích hợp với tôi hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440106,
					"content": "Ví dụ, cách làm sao để phá hủy các cột gỗ này cùng lúc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440107,
					"content": "Nếu bạn rảnh, hãy cùng suy nghĩ với tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440108,
					"content": "Để tôi suy nghĩ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "Không sao, cứ từ từ nghĩ, cột gỗ không tự chạy đi mất được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440111,
					"content": "Thứ duy nhất chạy đi mất chỉ có thời gian và sinh mệnh bị tiêu phí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440114,
					"content": "Nếu có thể dùng vũ khí lớn hơn chút, hoặc giống như đại nhân Jean, dùng sức mạnh Nguyên Tố, có lẽ sẽ có thể nhẹ nhàng phá hủy toàn bộ cột gỗ nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440109,
					"content": "Hai người chúng ta cùng xông lên...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "Bạn có quen với việc tác chiến tập thể không? Thật là ngưỡng mộ... lúc nào cũng có thể gọi được người giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440113,
					"content": "Giống như tôi, chỉ có thể học cách chiến đấu một mình thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
