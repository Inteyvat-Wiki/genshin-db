			"dialogs": [
				{
					"id": 710830101,
					"content": "Thật không ngờ là các bạn đã phá hủy Thất Tinh Trận Pháp, xem ra tôi phải viết vào báo cáo tuần rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Viết ngầu xíu nha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "E hèm... các bạn hãy nghiêm túc một chút, việc này rất nghiêm trọng. Mức độ nghiêm trọng như thế nào phải do Thất Tinh đích thân định đoạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "Cũng có nghĩa là, chờ tôi báo cáo lên rồi, nói không chừng sẽ kinh động đến các đại nhân trong Thất Tinh, và họ sẽ đích thân đến đây ngăn cản bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "Hừm, đến lúc đó, tôi cũng không có cách nào bảo vệ bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "(Gợi ý này cũng lộ liễu quá...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "Hừm... sợ rồi phải không? Được rồi được rồi, còn có người đang chờ bạn đó, đi mau đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
