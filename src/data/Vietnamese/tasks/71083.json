			"dialogs": [
				{
					"id": 710830201,
					"content": "Tình hình bên dưới thế nào? Có gặp phải nguy hiểm gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830202,
					"content": "(Tường thuật lại cho Muning nghe)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "Thì ra là vậy, nghe có vẻ nguy hiểm nhỉ. Phải lo cho cả Jinwu và Zhiqiong nữa, vất vả cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830204,
					"content": "Anh không phải nên cản tôi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "Tôi dĩ nhiên là có nghĩa vụ ngăn cản, nhưng bạn chạy nhanh quá, tôi đuổi theo không kịp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830206,
					"content": "Tôi chạy có nhanh đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "Không, nhanh lắm, trong báo cáo tuần viết vậy đó, đây là sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830208,
					"content": "Được rồi, tôi chạy nhanh lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "Ừm, cho nên hãy cẩn thận chút nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830210,
					"content": "Mọi việc thuận lợi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "Vậy thì tốt, tốt rồi, chỉ cần không xảy ra chuyện gì, \"Thất Tinh\" sẽ không trách cứ gì nhiều đâu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		}
