			"dialogs": [
				{
					"id": 761490101,
					"content": "Là ai? Là ai!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}, người của thời đại này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "Mặc dù tôi không biết về thời đại của mọi người, nhưng tôi là Alara, vốn là hành giả của Thời Kỳ Tĩnh Lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490104,
					"content": "Đến đây rồi thì không còn nhớ nổi thời gian nữa. Thậm chí nơi này đã phá vỡ cả sự tu hành tĩnh lặng của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490105,
					"content": "Quả nhiên, tu hành vô niệm vô tưởng sẽ khiến người ta đầu thai vào Thiên Đường Tà Ác Vô Tưởng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490106,
					"content": "Chuyện nhỏ thôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "Không cần cảm ơn tôi đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "Cảm ơn nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490109,
					"content": "Tuy việc cứu anh chỉ là tiện tay thôi, nhưng chúng tôi đang chuẩn bị tìm cách khác ngoài thiền định để rời khỏi đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490110,
					"content": "Mọi người không giỏi thiền định sao? Hay thời đại của mọi người không dạy kỹ thuật này?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490111,
					"content": "Lần đầu tiên rời khỏi nơi này, tôi đã phải mất hàng trăm năm. Tôi từ bỏ việc theo đuổi chân lý, từ bỏ khao khát được gặp lại người thân bạn bè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490112,
					"content": "Lần này tôi không muốn từ bỏ những điều đó nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490113,
					"content": "Tôi cũng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490115,
					"content": "Dex lại nhặt được một Mảnh Vong Niệm nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490116,
					"content": "Vong Niệm? À, tôi cũng biết về kỹ thuật thiền Tử Niệm này. Nó sẽ rèn luyện cho người ta tâm trạng khi đối mặt với cái chết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490117,
					"content": "Tìm được Zeitlind rồi thì giờ chúng ta tìm cách ra ngoài thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490118,
					"content": "Ở đây thật sự có thể dựa vào thực lực để ra ngoài được sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490119,
					"content": "Nếu Melanta và Nihilita đã có thể tự do ra vào, và thường còn có thể dẫn theo người khác. Vậy thì chắc là Dex cũng có thể.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490120,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490121,
					"content": "Hiện đã thu thập được ba Mảnh Vong Niệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490122,
					"content": "Ồ, chỉ là tên tạm thôi. Vì tôi cũng không biết Dex thu thập thứ này để làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490123,
					"content": "Tiếp theo phải làm gì nữa, Dex?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490124,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490125,
					"content": "Cứ đi theo phương hướng nó chỉ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
