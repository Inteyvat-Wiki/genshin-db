			"dialogs": [
				{
					"id": 200280101,
					"content": "#Cảm... cảm ơn bạn, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280102,
					"content": "Tuy là thợ săn... nhưng tôi cũng không có cách nào với bọn Slime này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280103,
					"content": "Bị bọn chúng phá đám, lần đi săn này tôi lại không đem được gì về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280104,
					"content": "Chỉ hy vọng những người thợ săn khác không xui xẻo như tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280105,
					"content": "Phải rồi, nói đến đây, có thể phiền bạn đi xung quanh xem không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280106,
					"content": "Không biết có phải ảo giác của tôi không, nhưng xung quanh trấn.... Slime hình như càng lúc càng nhiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280107,
					"content": "Bạn hãy đến phía trước xem. Nếu phát hiện Slime, thì hãy tiêu diệt bọn chúng đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280108,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "Vậy thì phiền bạn rồi, tôi cũng sẽ về báo cáo với ngài Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280111,
					"content": "Hy vọng ngài ấy đừng uống quá nhiều, có thể nghe được tôi nói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow Nhát Gan"
				},
				{
					"id": 200280109,
					"content": "Còn có việc khác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "Nhưng người có năng lực có thể giải quyết được việc này, chỉ có bạn thôi. Vì Thanh Tuyền Trấn, phải phiền bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow Nhát Gan"
				}
			]
		}
