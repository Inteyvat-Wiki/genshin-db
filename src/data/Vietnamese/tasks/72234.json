			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "Thế nào, ngồi có thoải mái không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "Tự dưng xuất hiện, làm tôi hết hồn!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Xin lỗi xin lỗi, không cố ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "Tôi là Kabayama, chỗ bạn đang ngồi tôi cũng thường hay ngồi. Rất yên tĩnh, thích hợp để suy nghĩ về cuộc sống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "Vậy thì tôi nhường cho bạn nhé?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Ồ, cảm ơn, nhưng không cần đâu. À mà bạn từ nơi khác đến à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "Vậy chắc bạn hiểu biết rất rộng. Tôi chưa bao giờ đi đâu, mặc dù kinh nghiệm chuyển nhà rất phong phú.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "Haiz, nói đến kinh nghiệm chuyển nhà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "Vì thường xuyên chuyển nhà khi còn trẻ, nên dường như không có bạn bè thân thuộc. Khi lang thang một mình, phát hiện cảnh đẹp cũng không biết chia sẻ cùng ai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "Haiz, nếu bạn có thể nhìn thấy những khung cảnh đó thì tuyệt quá. Nếu bạn đi ngang qua những nơi này, thì hãy ngồi xuống và ngắm nhìn, nếu có thể quay lại và nói với tôi về cảm nhận của bạn thì càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "Một nơi ở dưới cánh cổng đá ở chỗ cao nhất của Lối Mòn Khe Núi, một nơi là một khu vực rộng lớn được bao quanh bởi san hô bên cạnh Đền Đêm Đen, và một nơi nằm bên cạnh tàn tích cao chót vót của Trái Tim Mãng Xà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "Tôi đã để lại dấu vết ở những nơi này, và treo đèn trên cao để soi sáng. Bạn sẽ có thể tìm thấy nó một cách dễ dàng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223402,
