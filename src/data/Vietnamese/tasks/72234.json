					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "Bạn về rồi à.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340302,
					"content": "Bạn đã đi tất cả những nơi đó chưa? Người hiểu sâu biết rộng như bạn có lẽ sẽ thấy phong cảnh ở những nơi đó không có gì đáng nói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340303,
					"content": "Tôi thấy không tệ, rất đặc biệt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "Haiz, nghĩ lại tôi chưa bao giờ chia sẻ với ai về những điều này. Có thể biết được cảm nhận của bạn là đủ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340306,
					"content": "Có thể có những nơi khác tốt hơn nơi này. Dù sao thì ở đây cũng tối đen như mực và không có sự lựa chọn về thức ăn, còn phải đề phòng tộc rồng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340307,
					"content": "Nhưng sống ở đây lâu rồi, dù sao cũng có chút cảm giác không nỡ. Phong cảnh từng thấy ở những nơi đó, bây giờ nghĩ lại vẫn cảm thấy nhớ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340308,
					"content": "Bạn có cảm thấy như vậy không? Mặc dù là một nơi như vậy, nhưng ở lâu rồi, cũng sẽ có cảm giác là nhà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340309,
					"content": "Có lẽ vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "Vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340312,
					"content": "...Dù sao cũng cảm ơn bạn đã lắng nghe câu chuyện nhàm chán của tôi. Tuy không phải thứ gì quý giá, nhưng tôi chỉ có những thứ này thôi, bạn hãy nhận lấy đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340310,
					"content": "Không đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "Cũng bình thường, tôi từng thấy những cảnh đẹp hơn như vậy nhiều.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
}