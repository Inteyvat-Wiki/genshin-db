			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "Mọi người về rồi sao, điều tra thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210702,
					"content": "Chúng tôi tìm được ba manh mối ở gần đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "Thứ nhất, thiếu mất bốn cây cuốc đào khoáng, không mang theo bất kỳ một vật dụng sinh hoạt nào cả, chứng tỏ những công nhân này rất có thể không phải tự mình rời khỏi, mà là bị người khác đưa đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "Bị người khác đưa đi?! Nhưng... là ai ép buộc họ chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210705,
					"content": "Thứ hai, trong khu mỏ vốn có năm công nhân. Một người trong đó lười biếng rời khỏi khu làm việc để ngủ. Cho đến khi anh ấy tỉnh dậy thì các đồng nghiệp đã biến mất không để lại dấu vết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Những người ở lại khu làm việc thì lần lượt mất tích, người trốn ở khu nghỉ ngơi lại bình yên vô sự. Vì vậy có thể suy ra, sự việc này xảy ra ở khu làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Nếu nói vậy, Bravo thực sự đã thừa nhận cậu ấy lười biếng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210708,
					"content": "Chẳng lẽ có người xông vào khu làm việc để đưa họ đi sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210709,
					"content": "Đây chính là điểm thứ ba mà tôi muốn nói. Kun Jun đã dùng cách đặc biệt của mình để suy đoán ra, những người đó bị một đứa trẻ đưa ra khỏi khu mỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "Đứa trẻ?! Gần đây rất ít có nhà dân, không thể nào có trẻ con chạy đến khu mỏ được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210711,
					"content": "Nhưng kết quả là bốn người công nhân lại theo một đứa trẻ đi mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "Họ đã đi đâu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210713,
					"content": "Theo suy đoán của chúng tôi, họ đã đi về phía bắc, có lẽ đã ra khỏi khu mỏ, đi về hướng di tích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "Phía bắc! Được, tôi sẽ dẫn người đi tìm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210715,
					"content": "Có cần giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Việc điều tra giao cho các vị, còn những chuyện chạy vặt cứ để mấy anh em chúng tôi làm. Tôi xin phép đi trước, không chừng cố gắng tăng tốc sẽ có thể đuổi kịp bọn họ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210717,
					"content": "Khoan đã. Sự việc xảy ra vào sáu ngày trước, ngay cả khi chỉ là đi bộ, thì họ cũng đã đi rất xa rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "Ơ... Nói cũng phải. Thế thì lát nữa tôi dẫn theo vài anh em đi đến mấy hộ gia đình gần đây nghe ngóng xem sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210719,
					"content": "Ra khỏi khu mỏ, muốn tìm nơi ngủ trọ thì cũng chỉ có mấy hộ gia đình đó thôi. Cứ giao việc điều tra này cho chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210720,
					"content": "Tôi muốn phiền các vị tiếp tục điều tra manh mối. Chúng ta chia làm hai nhánh, nếu trên đường không gặp nhau thì tối mai hẹn gặp ở Nhà Trọ Vọng Thư nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210721,
					"content": "Cũng được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "Vậy tôi và mấy anh em đi trước đây!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210723,
					"content": "Vậy bây giờ chúng ta tiếp tục điều tra, còn họ thì tìm mấy hộ gia đình xung quanh để nghe ngóng phải không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "Nhưng trong khu mỏ cũng không còn manh mối gì nữa... Chúng ta có nên đi về hướng bắc không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Chờ đã, thiếu một người rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "Hở?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Đúng rồi, thiếu mất Kun Jun rồi, chắc là vẫn đang điều tra. Đi gọi anh ấy đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
