				},
				{
					"id": 111210803,
					"content": "\"Trấn Long Thạch\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Chưa từng nghe qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "Trấn Long Thạch thường dùng trong nghề rèn, anh tìm thứ này để làm gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "Tôi... Tôi không biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "Xin lỗi, tôi không giải thích nguyên nhân được... Mấy hôm nay tôi cứ luôn mơ mơ hồ hồ, ngoại trừ tên và địa chỉ nhà ra, thì không nhớ được gì hết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "Nói thật, lúc nào tôi cũng thấy bồn chồn, hình như có chuyện gì đó chưa làm mà lại quên mất. Nhớ mãi không ra, khó chịu lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "A, tôi hiểu cảm giác này đó! Biết là bản thân quên một chuyện nhưng lại không nhớ rốt cuộc đó là chuyện gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "Haiz, tôi cũng không biết nên đi đâu, vì vậy đành phải đi lung tung khắp nơi. Hôm đó dạo một vòng vào chợ, lúc mua đồ thì nghe được có người nói chuyện, có loáng thoáng nhắc đến \"Trấn Long Thạch\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "Ba chữ này nghe quen vô cùng, hình như chuyện mà tôi muốn làm ít nhiều có dính líu đến loại đá đó... Cho nên, tôi muốn tìm một viên để xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Có lẽ có được viên đá đó thì tôi sẽ nhớ lại được mình muốn làm gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "Thì ra là vậy... Trên đường đi, nếu có cơ hội, tôi cũng sẽ giúp anh tìm loại đá này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "Thật sao? Cám ơn Zhongli, ngài thật tốt bụng!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "Chỉ là chuyện nhỏ, không đáng nhắc đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "Chúng ta xuất phát thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Từ Vực Đá Sâu đi về phía bắc sẽ đến Thần Luật Quan. Nếu họ đi theo con đường này, chắc chắn sẽ để lại dấu vết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "Được, mau đi xem thử đi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "Tôi không biết thứ này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
