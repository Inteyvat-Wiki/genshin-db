			"trigger": {
				"objectNames": [
					"Lão Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Woa, khu mỏ này lớn thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210102,
					"content": "Các vị, đây chính là nơi xảy ra sự việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210103,
					"content": "Sáu ngày trước tôi dẫn đồng đội đến đây làm việc, khi quay về thì nghe nói bốn anh em ở lại canh giữ mất tích rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210104,
					"content": "Tôi đã dẫn người tìm kiếm toàn bộ khu mỏ, nhưng không thể tìm thấy họ. Tôi thực sự không có manh mối, nên mới nhờ các vị đến giúp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210105,
					"content": "Tức là có bốn thợ mỏ mất tích đúng không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210106,
					"content": "Đúng vậy. Ban đầu chúng tôi có mười người, bốn người mất tích là Long, Bold Cen, Brave Cen, và Mao đều là thợ mỏ làm việc cùng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210107,
					"content": "Hầu hết công nhân trong nghề này đều là nam. Có khi nào bốn thợ mỏ đó đã đi đến một khu mỏ khác không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210108,
					"content": "Không giống. Quanh đây không có dấu chân, trên đường chúng ta đến đây cũng không thấy khu mỏ nào đang khai thác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210109,
					"content": "Ừm... Khu mỏ lớn như vậy, mọi người đều đã tìm hết rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210110,
					"content": "Không bỏ sót một tấc đất nào, dưới giếng cũng tìm rồi. Nhưng bốn người lớn còn sống như vậy không thể nào chui xuống lòng đất chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Lão Dai"
				},
				{
					"id": 111210111,
					"content": "Phải xem hiện trường mới có thể đưa ra kết luận.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210112,
					"content": "Haiz, được được. Tôi chờ ở đây, mọi người cứ tìm thoải mái, nếu có manh mối gì nhớ cho tôi biết nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lão Dai"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
