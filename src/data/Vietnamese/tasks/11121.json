			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Mọi người xem đây là gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "Quần áo vứt bừa bãi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "Những đồ dùng sinh hoạt để trong khu mỏ chắc là của Lão Dai và những người đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "Một, hai, ba, bốn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Ừm... Đúng thế đúng thế, tổng cộng có mười cái áo và mười cái quần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "Chắc là đồ để thay nhỉ? Bạn xem đi, trên người Lão Dai cũng mặc một bộ y hệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "Vậy bốn người ra ngoài đã sáu ngày, đến nay vẫn chưa trở về, nhưng cũng không mang theo quần áo để thay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "Xung quanh còn có khăn mặt và xà phòng... lại còn mấy cái túi đeo thắt lưng này nữa, đều là túi đựng dụng cụ nhỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "Dụng cụ vệ sinh răng miệng, trang bị đào khoáng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "Có thể nói những người này không mang theo hành lý?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "Đúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "Có lẽ vì không cần dùng đến?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Không giống.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "Cuốc đào khoáng thiếu hết bốn cây, chứng minh là bọn họ rất có thể đã mang theo công cụ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "Có thời gian mang dụng cụ nhưng lại không có thời gian sửa soạn đồ dùng sinh hoạt? Không hợp lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Ừm... Trong trường hợp nào thì người ta không mang theo hành lý mà chỉ mang công cụ đi ra ngoài nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "Một, họ chỉ làm việc ở khu vực lân cận, không cần hành lý, nhưng những người này đến nay vẫn chưa về, vì vậy, loại bỏ suy đoán này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "Hai, nếu họ không tình nguyện rời khỏi đây, thì chắc chắn là không có thời gian để nghĩ đến chuyện hành lý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "Ể...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Ý của anh là bị người ta đưa đi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "Khả năng này cũng khá cao. Muốn suy luận sâu hơn phải tìm thêm nhiều manh mối hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "Không phải tự rời khỏi mà là bị người khác đưa đi, phải ghi lại khả năng này để báo lại cho Lão Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "Có khi nào là quên mang hành lý không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
