						],
						"stepId": 1112102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "Kun Jun, anh đang xem gì vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210202,
					"content": "Là mọi người à, đến đúng lúc lắm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210203,
					"content": "Có phát hiện gì à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210204,
					"content": "Ở đây có một mẫu khoáng thạch, tôi nghĩ có thể tìm được chút manh mối từ nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210205,
					"content": "Khoáng thạch? Khoáng thạch này có liên quan tới những người mất tích sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210206,
					"content": "Chuyện này, thử là biết. Chờ chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210208,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210209,
					"content": "Trông anh ấy có vẻ chăm chú, đang làm gì nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210210,
					"content": "Nhìn thấy rồi. Bốn người lớn... Đi theo một cái bóng trông giống đứa bé ra khỏi khu mỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210211,
					"content": "Đứa bé? Trong khu mỏ sao lại có trẻ con?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210212,
					"content": "Tôi cũng không rõ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210213,
					"content": "Còn nữa, \"nhìn thấy\" là ý gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210214,
					"content": "À, chính là \"nhìn thấy\" thôi. Mọi người nghe xong đừng nói cho người khác nhé! Tôi cảm thấy việc này tương đối kỳ lạ, nên không dám nói cho ai biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210215,
					"content": "Thực ra, tôi có thể nhìn thấy ký ức của khoáng thạch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210216,
					"content": "Hử?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210217,
					"content": "Không phải đoán, không phải ước lượng, mà là \"nhìn thấy\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210218,
					"content": "Giống đặt tay lên đá như lúc nãy là được rồi sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210219,
					"content": "Ừ, theo tôi thì khoáng thạch cũng có \"ký ức\". Thỉnh thoảng chúng sẽ ghi lại những việc xảy ra xung quanh, tôi chỉ cần chạm vào và cảm nhận là có thể nhìn thấy những \"ký ức\" đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210220,
					"content": "Lợi hại thế sao! Vậy chẳng phải là chuyện gì anh cũng biết hết ư?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210221,
					"content": "Vẫn phải xem tảng đá cụ thể như thế nào. Khoáng thạch khác nhau sẽ có khả năng ghi nhớ khác nhau, những loại thường gặp như quặng sắt, mảnh sắt trắng hầu như không có tác dụng gì, ký ức rất mơ hồ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210222,
					"content": "Khả năng ghi nhớ của Thạch Phách, pha lê thì mạnh hơn, có thể ghi lại nhiều cảnh tượng hơn, và cũng sắc nét hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210223,
					"content": "Coi đá tảng như đôi mắt... thú vị thật. Năng lực này quả thực vô cùng hiếm có, Lão Dai nhờ Kun Jun ra tay đúng là một việc rất sáng suốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210224,
					"content": "Ha ha, có thể giúp được mọi người là tốt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210225,
					"content": "Theo tôi thấy, chắc bọn họ đã đi theo con đường này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210226,
					"content": "Con đường này dẫn đến phía bắc, cứ đi thẳng sẽ có thể rời khỏi khu mỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210227,
					"content": "Họ đi về phía bắc rồi, ghi lại manh mối này rồi nói cho Lão Dai thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112103",
							"2"
						],
						"stepId": 1112103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bravo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Anh là công nhân ở đây sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "À đúng, đúng! Các vị đến để điều tra vụ án mất tích phải không, cầu xin các vị hãy cứu mọi người về!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210303,
					"content": "Tôi không biết... không biết đã xảy ra chuyện gì, hôm đó bầu trời u ám, quản đốc đưa vài người anh em ra ngoài làm việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210304,
					"content": "Tôi và bốn người khác ở lại khu mỏ làm việc, giữa chừng thì chúng tôi có hơi lười biếng một chút... chỉ một chút thôi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210305,
					"content": "Tôi ngủ ở lều trong cùng, cho tới lúc tôi tỉnh dậy thì mọi người đã biến mất không thấy tăm hơi! Rõ ràng trước đó không lâu còn nói chuyện với họ, đột nhiên... chẳng còn ai cả...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210306,
					"content": "Chắc không phải, chắc không phải một lúc nào đó sẽ đến lượt tôi chứ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210307,
					"content": "Người trốn trong lều thì không sao, những người làm việc bên ngoài lại mất tích.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "Chẳng lẽ là do khu vực làm việc có vấn đề?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "Á! Đáng sợ quá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "Có lẽ khu vực làm việc có vấn đề, ghi manh mối này lại đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
