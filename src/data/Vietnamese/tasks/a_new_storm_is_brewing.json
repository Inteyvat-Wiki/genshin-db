			"dialogs": [
				{
					"id": 200400401,
					"content": "Ừ... hôm nay cũng là một ngày sóng yên gió lặng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400402,
					"content": "Gia tộc của tôi nhận được mệnh lệnh từ đại nhân Vennessa, giám sát những cơn bão cho thành Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400403,
					"content": "Tuy rằng từ khi có sự bảo hộ của đại nhân Barbatos, Mondstadt không còn bị bão tố xâm nhập, đài quan sát cũng dần bị bỏ hoang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400404,
					"content": "Nhưng cho dù là vậy, tôi vẫn cứ muốn đến tháp canh xem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400405,
					"content": "Vất vả rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "Cám ơn bạn, nhưng nói đến \"trách nhiệm\" của tôi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400407,
					"content": "Tôi lại hy vọng không bao giờ phải đi thực hiện nó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400410,
					"content": "Được rồi, cảm ơn bạn đã giúp, những bông cúc cánh quạt này tặng cho bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400411,
					"content": "Trước đây, gia tộc tôi thường dùng mức độ sinh trưởng của cúc cánh quạt, để phán đoán sức gió của một khu vực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400412,
					"content": "Nơi không có ngọn gió nào, hoặc là nơi có bão tố, đều không có cúc cánh quạt mọc lên.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400413,
					"content": "Chỉ có tại Mondstadt nơi mà gió hiền hòa, nó mới có thể thuận lợi sinh trưởng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400414,
					"content": "Thật mong chúng có thể luôn sinh trưởng như thế...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400408,
					"content": "Là một lịch sử rất vất vả...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "Đúng vậy, hy vọng lịch sử đó không bao giờ lặp lại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				}
			]
		},
