			"dialogs": [
				{
					"id": 200400101,
					"content": "Haizz, rốt cuộc phải làm sao để qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400102,
					"content": "Ồ... bạn tìm tôi có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400103,
					"content": "Bạn ở đây làm gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "Tôi đang chuẩn bị đến tháp canh trên Đỉnh Vọng Phong, đi xem có bão ngoài biển không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400105,
					"content": "Nhưng phía trước có một đám quái cản đường... tôi đang suy nghĩ làm sao để đi qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400106,
					"content": "Ồ, không phải lo lắng, tôi không có ý định kêu bạn đến đài quan sát thay tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400107,
					"content": "Đây là trách nhiệm của tôi, cũng là sự kiên trì cá nhân mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400108,
					"content": "Bạn cứ làm việc của bạn đi, tôi tự mình nghĩ cách xem sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
