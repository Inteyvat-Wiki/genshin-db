			"dialogs": [
				{
					"id": 200400501,
					"content": "Tuy rằng cô ấy nói như vậy, nhưng phía trước có rất nhiều quái vật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400502,
					"content": "Chúng ta đi giúp cô Vind dọn dẹp xung quanh đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400503,
					"content": "Xem dáng vẻ nghiêm túc của cô ấy, không chừng đang nghĩ xông thẳng qua đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400504,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "Ừ, người nghiêm túc thì nên nhận được sự giúp đỡ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400505,
					"content": "Thật sự có người sẽ nghiêm túc đến mức này chứ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "Đó là tình huống tồi tệ nhất rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400508,
					"content": "Vì không để tình huống đó xảy ra, chúng ta hãy mau đi dọn dẹp ma vật đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
