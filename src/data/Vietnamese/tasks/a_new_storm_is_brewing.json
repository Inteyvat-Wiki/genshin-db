			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "Bạn còn có việc gì sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400202,
					"content": "Phía trước đã an toàn rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "Í? Cám ơn Phong Thần...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400204,
					"content": "Không, không đúng, xin lỗi, tôi phải cảm ơn bạn mới phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400205,
					"content": "Tôi phải báo đáp bạn như thế nào... ồ, phải rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400206,
					"content": "Mời bạn đến tháp canh vậy, tôi đợi bạn ở đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
