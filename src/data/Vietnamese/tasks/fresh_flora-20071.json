			"dialogs": [
				{
					"id": 200710101,
					"content": "Hoa trữ trên núi tuyết sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710102,
					"content": "Chỉ lấy được một hộp thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "Những đóa hoa khác không lấy về được sao? Ừm...được rồi, dù sao thì tình hình trên núi tuyết cũng không thể nào lường trước được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710104,
					"content": "Nhưng nếu chỉ có một hộp này thì không thể so sánh được rồi, đành chờ sau này tìm cơ hội vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710105,
					"content": "Lần này bạn giúp tôi vất vả rồi, đây là thù lao, có lẽ lần tới lại phải nhờ vả bạn nữa đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
