			"dialogs": [
				{
					"id": 200710201,
					"content": "Hoa như thế nào rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710202,
					"content": "Xin lỗi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "Hử? Sao vậy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710204,
					"content": "Tôi lỡ làm hỏng bình và hoa rồi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "Làm, làm hỏng sao?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710206,
					"content": "Huhu...đó đều là những đóa hoa tôi chọn kỹ lưỡng, hoa đẹp như vậy khó tìm lắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710207,
					"content": "Núi tuyết nguy hiểm như vậy sao? Ngay cả Nhà Mạo Hiểm như bạn mà cũng lỡ tay, ngay cả một hộp hoa cũng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710208,
					"content": "Nhưng dù sao cũng cảm ơn bạn đã đi giúp tôi chuyến này, cho bạn nè, hãy nhận nhé, tôi phải đi chăm sóc hoa trong tiệm rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710209,
					"content": "Haiz, nếu không thì...tôi cứ dùng lại cách của Sara xem sao vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
