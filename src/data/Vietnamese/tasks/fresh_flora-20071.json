			"dialogs": [
				{
					"id": 200710301,
					"content": "Hoa trữ trên núi tuyết sao rồi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710302
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710302,
					"content": "Cộng cả lần này vào, thì đều ở đây hết này.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710303
					]
				},
				{
					"id": 200710303,
					"content": "Lấy được hết chưa? Tốt quá, mau đưa tôi xem thử.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710304
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710304,
					"content": "Hú hú, xem ra ổn lắm đó, ừm, cách này khả thi đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710305
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710305,
					"content": "Nhưng mà núi tuyết quá xa Thành Mondstadt, đâu thể lần nào cũng nhờ bạn, sau này phải nghĩ cách nào tiện hơn mới được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710306
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710306,
					"content": "Tóm lại, cảm ơn bạn đã giúp nhé, đây là quà cảm ơn, bạn nhận nha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
