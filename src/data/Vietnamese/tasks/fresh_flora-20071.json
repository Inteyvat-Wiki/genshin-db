			"dialogs": [
				{
					"id": 200710401,
					"content": "Bên này bên này, sang đây nè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710402,
					"content": "Bạn còn nhớ những đóa hoa mà lần trước tôi nhờ bạn đặt ở núi tuyết không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710403,
					"content": "Đã hơn một ngày rồi, tôi muốn xem hiệu quả của việc trữ đông.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710404,
					"content": "Bạn có thể lên núi, giúp tôi mang những đóa hoa đó về không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710405,
						200710407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710405,
					"content": "Được.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710406
					]
				},
				{
					"id": 200710406,
					"content": "Vậy thì trông cậy vào bạn nhé, tôi ở đây chờ bạn, nhớ đi nhanh về nhanh nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710407,
					"content": "Tôi để ở đâu rồi nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710408
					]
				},
				{
					"id": 200710408,
					"content": "Bạn không nhớ sao? <color=#00E1FFFF>Ở cạnh Thất Thiên Thần Tượng</color>, <color=#00E1FFFF>bờ hồ trên núi</color>, với lại <color=#00E1FFFF>cạnh hang động</color> nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710409,
					"content": "Tôi đánh dấu lên bản đồ lần nữa cho bạn vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
