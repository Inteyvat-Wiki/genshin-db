			"dialogs": [
				{
					"id": 715340101,
					"content": "Hmm, tham khảo những tấm thiệp chúc mừng khác trước đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340102,
					"content": "#Ồ, {NICKNAME}! Đã lâu không gặp... Sao trông có vẻ kinh ngạc thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340103,
					"content": "Không, chỉ là tôi không ngờ tới thôi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "Không ngờ là một võ sĩ như tôi đây cũng có nhã hứng tham gia Tết Hải Đăng à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340105,
					"content": "Bình thường cũng không thấy cô thư giãn như thế bao giờ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "Chức trách của Hiệp Hội Tenryou rất lớn. Thân là một trong số họ, tôi không thể lơ là được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340107,
					"content": "Trong mắt người khác, tôi quả thực có thể là một võ nhân chẳng hiểu gì về mấy chuyện tao nhã... Hoàn toàn không phù hợp với khu phố lễ hội như Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340108,
					"content": "Tuy nhiên, mất cảnh giác có nghĩa là để tội phạm lọt qua... Điều đó không chỉ gây bất lợi cho nhiệm vụ của tôi, mà còn cho bầu không khí của Hanamizaka nữa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340109,
					"content": "Điều tốt nhất tôi có thể làm là tận dụng mọi khoảnh khắc rảnh rỗi mà mình có được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340110,
					"content": "Xin lỗi nhé. Đang là ngày lễ, tôi không nên nói đến những chuyện nghiêm túc thế này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340111,
					"content": "#Tôi đang cố gắng làm một tấm thiệp chúc mừng, nhưng vẫn chưa làm được. Nếu {F#cô}{M#cậu} sẵn lòng, có thể cho tôi vài gợi ý không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340112,
					"content": "Được chứ, để tôi nghĩ xem nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
