			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "Dịch Trạm Lữ Khách là quan ải quan trọng ra vào Sumeru, bảng thông báo này được lập ra để thông báo cho các thương khách vãng lai về những vấn đề to nhỏ, xin hãy lưu ý.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "\"Người yêu của em, dù anh cách xa em thế nào thì trái tim em vẫn mãi thuộc về anh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180202,
					"content": "\"Em biết rằng anh có chuyện quan trọng hơn cần làm, chức vụ càng cao thì trách nhiệm càng lớn.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180203,
					"content": "\"Nhưng em không thể bày tỏ nỗi muộn phiền này với người khác, không thể nào nói ra tên họ của anh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180204,
					"content": "\"Thật mong rằng có một ngày, em sẽ có thể nói cho mọi người biết được anh tài giỏi và thông minh đến nhường nào.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
