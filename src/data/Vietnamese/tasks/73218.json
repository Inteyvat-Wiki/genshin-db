			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181701,
					"content": "\"Nhân danh Vua Bình Ma, tôi đã ân xá tội lỗi của các bạn, nhưng còn tội lỗi của chúng tôi thì do ai ân xá?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
