			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "\"Bán túi quà mạo hiểm sa mạc để cung cấp cho thương khách vãng lai phương án giải quyết mạo hiểm sa mạc tốt nhất.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181002,
					"content": "\"Hễ là khách hàng mua túi quà, tiệm đảm bảo con đường mạo hiểm của bạn suôn sẻ, nếu không một đền mười. Đặt mua bây giờ sẽ có giảm giá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321811",
							"2"
						],
						"stepId": 7321811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "\"Nghe nói phía sa mạc có một bệnh viện Eleazar, là bệnh viện được Giáo Viện thành lập để chuyên điều trị bệnh Eleazar, nhưng sau đó không biết vì sao lại bỏ hoang...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181102,
					"content": "\"Nghe người của Làng Aaru nói, từng có bệnh nhân Eleazar được chữa khỏi đã trốn thoát khỏi đó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181103,
					"content": "\"Nếu ở đó có để lại tài liệu gì đó, biết đâu có thể tìm được cách chữa trị loại bệnh này...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
