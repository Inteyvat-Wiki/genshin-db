					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "\"Nghe nói có người của Làng Aaru chúng tôi làm quan lớn ở Giáo Viện, chuyến này biết đâu chừng người sa mạc chúng tôi có thể đổi đời.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181202,
					"content": "\"Ngày ngày vận chuyển đống đá này đâu kiếm được tiền, nếu có thể để tôi vận chuyển mấy thứ như Hũ Tri Thức gì đó, một đơn hàng thành công thôi là có thể về quê kết hôn rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181203,
					"content": "\"Nhưng tôi nghe nói vị quan kia chuyên bắt buôn lậu, hơn nữa nhìn là thấy không thiên vị chúng ta rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181204,
					"content": "\"Xì, do người sa mạc chúng ta không đoàn kết nên mới thành ra bây giờ đó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Nhà mạo hiểm đến sa mạc hãy chú ý, dựa theo quy định của Giáo Viện, mọi hoạt động thám hiểm đến Biển Cát Đỏ đều cần phải lập hồ sơ ở Giáo Viện mới được tiến hành.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181302,
					"content": "Văn vật được phát hiện trong di tích sa mạc, trên nguyên tắc thì đều thuộc về Giáo Viện, không một ai được chiếm làm của riêng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181303,
					"content": "Vì vấn đề an toàn, Giáo Viện đã ban bố lệnh cấm đi đến những khu sa mạc khác ngoài Biển Cát Đỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181304,
					"content": "Nếu không nghe khuyến cáo, nếu xảy ra sự cố gì ở những khu vực này, Giáo Viện sẽ không chịu trách nhiệm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
