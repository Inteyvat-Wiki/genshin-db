			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "\"Nghe nói có người chỉ dựa vào buôn bán Mỡ Nhộng Cát trong thành mà phát tài, giờ chẳng những mua được biệt thự trong thành mà còn tự xưng là gia tộc gì đó, thậm chí còn xưng anh em với mấy người Giáo Viện.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181402,
					"content": "\"Tại sao tôi vận chuyển đá cả nửa đời rồi mà vẫn nghèo rớt mồng tơi chứ.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181403,
					"content": "\"Anh thì biết gì, phải có Giáo Viện đồng ý thì mới được phép buôn bán Mỡ Nhộng Cát, anh muốn đụng cũng chẳng đụng vào được.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181404,
					"content": "\"Nếu anh muốn phát tài thì hãy lén buôn sách với tôi, nếu thành công thì chúng ta sẽ không cần phải vận chuyển đá ở nơi đây nữa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
