			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "Tiến về Biển Cát Đỏ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180302,
					"content": "Những ai không tôn kính người đã khuất hãy dừng bước ở đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
