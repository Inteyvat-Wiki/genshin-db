					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Mặc dù \"Lữ Trình Vàng\" là nhà trọ duy nhất của Dịch Trạm Lữ Khách, dường như không cần thiết phải quảng cáo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180602,
					"content": "Nhưng thịt nướng của chúng tôi rất ngon, hương vị sa mạc chính thống, còn chính thống hơn trong thành nhiều.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180603,
					"content": "Cho dù đường dài xa xôi nhưng cũng nên đến thưởng thức nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "\"Mong là Mahamata có thể xem xét việc siết chặt giới hạn thông quan của Dịch Trạm Lữ Khách.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180702,
					"content": "\"Giờ chỉ cần là dân sa mạc là có thể thông quan dễ dàng, chẳng những dẫn đến nhiều trộm cướp nhân cơ hội trốn vào rừng sâu ẩn nấp, mà còn chiếm đoạt cơ hội việc làm của người dân Sumeru chúng tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180703,
					"content": "\"Tuy hiện giờ vẫn chưa giao quyền hạn Akasha cho dân sa mạc, nhưng những ủy thác do Đại Sảnh Regzar ban hành từ lâu đã không chỉ là công việc của lính đánh thuê rồi. Cứ như thế dù có thi vào Giáo Viện thì vẫn sẽ có người thất nghiệp.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180704,
					"content": "\"Nói gì thế, dân sa mạc vốn cũng là con dân của Đại Vương Rukkhadevata, họ cũng là người Sumeru, để họ vào thành là chuyện đương nhiên thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180705,
					"content": "\"Anh ăn nói như vậy ở đây coi chừng bị đánh đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
