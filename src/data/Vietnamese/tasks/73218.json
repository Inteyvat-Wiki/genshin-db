			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Thương khách vãng lai cần đăng ký ở chỗ Mahamata, thông qua phê duyệt mới được vào trong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180902,
					"content": "Cấm mang theo hàng hóa chưa được đăng ký hoặc vật phẩm nằm trong danh mục cấm xuất nhập cảng, một khi phát hiện sẽ tịch thu toàn bộ, thành viên đi cùng sẽ bị trục xuất vào sa mạc theo quy định.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732180903,
					"content": "Ngoài ra, người dân Làng Aaru có thể mang theo giấy tờ thông quan của Giáo Viện phát để trực tiếp thông quan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321810,
			"completionStepIds": [
				7321810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
