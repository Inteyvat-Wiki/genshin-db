				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181601,
					"content": "Tuyển dụng lâu dài công nhân phụ trách công việc bảo trì Bức Tường Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181602,
					"content": "Bao ăn bao ở, tiền lương hậu hĩnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181603,
					"content": "Người làm việc nghiêm túc còn có thể được đề cử tư cách vào học ở Giáo Viện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321817,
			"completionStepIds": [
				7321817
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321817",
