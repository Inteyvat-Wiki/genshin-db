			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181801,
					"content": "\"Mong là Mahamata có thể xem xét việc siết chặt giới hạn thông quan của Dịch Trạm Lữ Khách.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181802
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181802,
					"content": "\"Giờ chỉ cần là dân sa mạc là có thể thông quan dễ dàng, chẳng những dẫn đến nhiều trộm cướp nhân cơ hội trốn vào rừng sâu ẩn nấp, mà còn chiếm đoạt cơ hội việc làm của người dân Sumeru chúng tôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181803
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181803,
					"content": "\"Tuy hiện giờ vẫn chưa giao quyền hạn Akasha cho dân sa mạc, nhưng những ủy thác do Đại Sảnh Regzar ban hành từ lâu đã không chỉ là công việc của lính đánh thuê rồi. Cứ như thế dù có thi vào Giáo Viện thì vẫn sẽ có người thất nghiệp.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181804
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181804,
					"content": "\"Nói gì thế, dân sa mạc vốn cũng là con dân của Thảo Thần đại nhân, họ cũng là người Sumeru, để họ vào thành là chuyện đương nhiên thôi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181805
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181805,
					"content": "\"Anh ăn nói như vậy ở đây coi chừng bị đánh đấy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
