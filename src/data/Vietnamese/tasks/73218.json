			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Học giả ở lại Dịch Trạm Lữ Khách một thời gian dài cần đăng ký ở chỗ Mahamata trước khi nhận phòng ở nhà trọ, để tránh những sự cố không mong muốn như việc làm lộ kiến thức.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
