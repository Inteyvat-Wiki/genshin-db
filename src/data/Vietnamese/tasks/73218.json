			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "\"Người trẻ tuổi bây giờ đúng là thích nghĩ nhiều. Người của Làng Aaru nếu không có Đại Vương Rukkhadevata che chở thì đã sớm thành đống xương khô dưới phế tích thần điện rồi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181502,
					"content": "\"Nghe nói gần đây có người đồn tin Vua Deshret hồi sinh gì đó. Tôi ngẫm nghĩ ngần ấy năm qua Đại Vương Rukkhadevata còn chưa sống lại, huống hồ chi là Vua Deshret mù mịt hư vô đó.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "Bảng Thông Báo"
				},
				{
					"id": 732181503,
					"content": "\"Tôi thấy cứ làm việc đàng hoàng thì hơn, chỉ dựa vào số vật liệu chuyển về Làng Aaru mỗi tháng thì chẳng đủ cho chúng ta sống.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bảng Thông Báo"
				}
			]
		},
		{
			"id": 7321816,
			"completionStepIds": [
				7321816
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
