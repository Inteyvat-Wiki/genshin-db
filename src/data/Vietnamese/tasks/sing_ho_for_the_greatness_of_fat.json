				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "Hừm, thành tích rất khá, nhưng so với tôi thì vẫn còn kém một chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650702,
					"content": "Tôi vừa duy trì được hình thể hơi mập lâu dài, lại chưa bao giờ bỏ qua việc tập luyện, về sự linh hoạt và sức mạnh thì tuyệt đối đám cuồng thể hình ngu ngốc không thể so bì được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650703,
					"content": "Từ bỏ việc theo đuổi cơ bắp, cùng tôi ca ngợi vẻ đẹp của mỡ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516505",
