		},
		{
			"id": 7516502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516502",
							"2"
						],
						"stepId": 7516502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "#Dũng sĩ qua đường à, đã đến Teteocan như vậy, {F#cô}{M#cậu} cũng là người theo đuổi sức mạnh phải không.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650202,
					"content": "#Chắc {F#cô}{M#cậu} đã thấy những lực sĩ của Cộng Đồng Trù Phú rồi nhỉ. Ừm, hầu hết đều là những người đầy cơ bắp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650203,
					"content": "#Nhưng nhìn {F#cô}{M#cậu} cũng rất gầy gò, chắc vẫn chưa trở thành người cuồng tập thể hình ngày nào cũng đẩy tạ các kiểu đâu nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650204,
					"content": "Tôi nói này, đó đều là lừa đảo đấy, đừng để bị lừa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650205,
					"content": "Cô ghét việc luyện tập sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "Cũng không thể nói như vậy được. Nhưng khoe khoang cơ bắp, cho rằng sức mạnh của dũng sĩ đến từ cơ bắp, chắc chắn là nói nhăng nói cuội.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650208,
					"content": "Để tôi nói cho mà nghe, cơ thể của các anh hùng thời xưa không thể nào toàn là xương và cơ bắp đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650209,
					"content": "Môi trường sinh tồn của họ khắc nghiệt hơn nhiều so với ngày nay, trong thực chiến sẽ càng chú trọng tới việc sinh tồn và phòng ngự, cho nên chắc chắn sẽ giữ lại một lượng mỡ vừa phải.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650210,
					"content": "Dáng người của họ, chắc là giống như tôi đây này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650211,
					"content": "Dáng hơi đậm người như tôi đây mới là vóc dáng của các anh hùng thời xưa, có đủ sức mạnh và sự linh hoạt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650212,
					"content": "Nhưng người trong bộ tộc đều không nhận ra điều này, haiz, thật ngốc nghếch mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650213,
					"content": "#Nhìn vẻ mặt của {F#cô}{M#cậu}, dường như không tin cho lắm nhỉ... Ừm, thế này đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650214,
					"content": "#Hãy thử khiêu chiến đập bình mà tôi chuẩn bị xem! Ban đầu tôi tạo ra khu vực này là để tự tập luyện, cho {F#cô}{M#cậu} mượn thử cũng không sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650215,
					"content": "Cứ thử là biết ngay hình thể lớn sẽ có sức mạnh thế nào trong thực chiến!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650206,
					"content": "Cô ghét cơ bắp à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
