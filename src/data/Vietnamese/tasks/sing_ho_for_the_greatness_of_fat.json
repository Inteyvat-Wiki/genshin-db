			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650801,
					"content": "#Thành tích của {F#cô}{M#cậu} rất khá, nhưng mà, nói thật... Đây không phải khoe khoang, thành tích của tôi thực sự cao hơn đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650802
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650802,
					"content": "Con người mà, sẽ luôn có một vài việc mình làm rất tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650803
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650803,
					"content": "#Giờ {F#cô}{M#cậu} tin rồi chứ, chiến binh có vóc dáng như tôi chưa chắc đã không nhanh nhẹn, nên phải ăn thật ngon, đừng có tùy tiện giảm cân!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				}
			]
		},
		{
			"id": 7516509,
