			"dialogs": [
				{
					"id": 751650301,
					"content": "Cần chuẩn bị một chút.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "Không thành vấn đề, chuẩn bị xong thì có thể đến bất cứ lúc nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516504",
							"2"
						],
						"stepId": 7516504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "#Dũng sĩ qua đường, đúng rồi đó, chính là {F#cô}{M#cậu} đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "#Ôi, gầy quá... {F#Cô}{M#Cậu} có ăn uống đầy đủ không thế?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "Cơm bị người dẫn đường Paimon ăn hết mất rồi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Dù có lý do hay khổ ải gì đi nữa thì trước hết cứ phải ăn ngon trước đã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "#Nếu {F#cô}{M#cậu} đã vào Teteocan, có lẽ đã thấy lực sĩ của Cộng Đồng Trù Phú nhỉ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "#Xuất phát từ lương tâm, tôi muốn cho {F#cô}{M#cậu} một lời khuyên, tuyệt đối đừng tin những kẻ khoe khoang cơ bắp đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "Mỡ mà thần linh ban cho chúng ta là món quà quý giá, vì cơ bắp đẹp đẽ mà không ăn đồ ăn ngon, từ bỏ mỡ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "#Làm vậy là quá ngu ngốc, lợn rừng cũng sẽ phải thương hại {F#cô}{M#cậu} đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "Hơn nữa muốn nói đẹp là thế nào thì... khoe cơ bắp cũng chỉ mới có khoảng vài chục năm gần đây thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "Ông nội tôi nói, khi ông còn trẻ, mọi người thường thích người hơi mũm mĩm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "Vì vậy, tuyệt đối đừng nghe lời người khác, đi theo con đường giảm cân sai lầm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "#Nhưng nếu có một ngày, {F#cô}{M#cậu} cũng giống như những người thân của tôi ở Cộng Đồng Trù Phú, muốn theo đuổi sức mạnh mà chọn cách giảm cân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Vậy tôi còn một câu nữa: Về nhanh nhạy, một chiến binh thân hình hơi mập cũng có thể linh hoạt như cá. Về sức mạnh, những người gầy không thể là đối thủ của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "Nếu muốn hỏi bằng chứng, những chiếc bình trong sân huấn luyện này chính là bằng chứng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "Với dáng người của tôi, <color=#00E1FFFF>muốn chạy nhanh qua mà không làm vỡ bình</color> thì dễ thôi. Nhanh nhẹn như thế thì một người gầy cũng chưa chắc đã làm được như vậy đâu nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "#Nhìn vẻ mặt vừa muốn cười nhưng lại ngại của {F#cô}{M#cậu}... Không sao, không sao, tôi biết là {F#cô}{M#cậu} không tin mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "#Thử xem nào, hãy vượt qua sân huấn luyện này với tốc độ nhanh nhất của {F#cô}{M#cậu}, nhưng chú ý <color=#00E1FFFF>đừng làm vỡ bất cứ chiếc bình</color> nào nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "#Xem thử thành tích của {F#cô}{M#cậu} tốt đến đâu, có thể vượt qua tôi không nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Woa, muốn mời tôi ăn cơm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "#Không phải ý đó... Nếu {F#cô}{M#cậu} thật sự đói, trong túi tôi có một ít thịt nướng đây. Nhưng chuyện này để qua một bên đi đã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
