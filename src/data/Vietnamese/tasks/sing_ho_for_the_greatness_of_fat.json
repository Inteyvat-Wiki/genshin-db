			"dialogs": [
				{
					"id": 751650901,
					"content": "Illimani, hình như anh lại mập lên rồi đó, chúc mừng nhé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650902
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650902,
					"content": "Haha, cảm ơn nhé, Suriqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650903
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650903,
					"content": "Tin tốt đây, mấy hôm nay tôi lại khuyên được một người gầy đang muốn giảm cân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650904
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650904,
					"content": "Ồ, tuyệt đấy, chuyện tốt mà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650905
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650905,
					"content": "#Ồ, là {F#cô}{M#cậu} sao? Sao rồi, mấy ngày nay có ăn uống đầy đủ không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650906,
						751650908
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650906,
					"content": "Ăn ngon miệng lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650907
					]
				},
				{
					"id": 751650907,
					"content": "Tốt lắm, thế nên phải ăn nhiều mới đúng, mập mạp chút mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650910,
					"content": "Illimani, tôi nói này, người này đập bình rất giỏi, chỉ thiếu chút xíu nữa là đạt đến thành tích cao nhất của tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650911
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650911,
					"content": "#{F#Cô}{M#Cậu} ấy cũng từng khiêu chiến với tôi và thành tích cũng rất khá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650912
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650912,
					"content": "#Được đấy, không ngờ {F#cô}{M#cậu} lợi hại như vậy, suýt nữa đã vượt qua chúng tôi rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650913
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650913,
					"content": "#Tôi cảm thấy nếu {M#cậu}{F#cô} ấy mập hơn một chút, không chừng thực sự có thể nhỉnh hơn chúng ta luôn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650914
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650914,
					"content": "#Ừm, rất có khả năng. Tuy rằng nhìn từ góc độ của tôi thì {F#cô}{M#cậu} hơi gầy, vẫn còn có thể mập lên, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650915
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650915,
					"content": "#Tôi công nhận {F#cô}{M#cậu} rồi đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650916
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650916,
					"content": "#Tôi cũng công nhận {F#cô}{M#cậu}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650917
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650917,
					"content": "#Nhưng vẫn khuyên {F#cô}{M#cậu} mỗi bữa nên ăn nhiều hơn chút.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650918
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650918,
					"content": "Đừng ăn ít, đừng giảm cân, chúng tôi sẽ thất vọng đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650908,
					"content": "Không ăn được mấy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650909
					]
				},
				{
					"id": 751650909,
					"content": "Vậy không ổn rồi, chẳng gì quan trọng hơn ăn uống đàng hoàng cả.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650910
					],
					"speakerTitle": "Suriqui"
				}
			]
		},
