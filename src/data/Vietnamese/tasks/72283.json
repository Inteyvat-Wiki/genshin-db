			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "Bạn cũng không bắn trúng mục tiêu sao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830202,
					"content": "Xem ra hôm nay không được may mắn. chắc chắn là có thứ gì đó không tốt ảnh hưởng đến thể hiện của bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830203,
					"content": "Hay là thử thêm vài lần nhé? Dù sao mục tiêu cũng không biết bơi như cá con Unagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
							"2"
						],
						"stepId": 7228303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "Ồ! Bạn thành công rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830302,
					"content": "Haiz, nhưng tôi thấy bạn bắn cung cũng ra dáng lắm, chắc cũng là lão làng. Một người không được đào tạo bài bản như tôi có luyện thêm vài năm cũng chưa chắc được như bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830303,
					"content": "Và vì ngày ngày tập bắn cung ở nơi ma quỷ này mà lâu lắm rồi tôi không được nhìn thấy Unagi nhảy tung tăng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830304,
					"content": "Bạn cũng thích Unagi chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830305,
					"content": "Thích.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "Vậy sao. Bởi vì tôi quá thích Unagi nên mới muốn nuôi thử. Bạn không thấy chúng rất đáng yêu sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830308,
					"content": "Đương nhiên, Unagi trên đĩa còn đẹp hơn. Vừa đẹp vừa ngon, thật tuyệt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830309,
					"content": "Nói về điều này, vì thích Unagi nên muốn nuôi Unagi, vì nuôi Unagi nên tập bắn cung, chẳng phải bỏ gốc lấy ngọn sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830310,
					"content": "Suy cho cùng, tôi vẫn thích Unagi tự do tự tại, chuyện chăn nuôi gì đó thì bỏ đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830311,
					"content": "Đúng rồi, cảm ơn bạn đã giúp đỡ cho buổi tập luyện này, đây là quà của bạn. Chúc may mắn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830306,
					"content": "Không thích cho lắm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}