				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "Bỏ đi bỏ đi, chắc tại vì hôm nay không được may mắn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830102,
					"content": "Sao vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "Kết quả của việc tập bắn càng ngày càng tệ, cứ tiếp tục như vậy, một ngày nào đó tôi sẽ cắm mũi tên này vào đầu gối của mình mất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830104,
					"content": "Sao lại tập bắn cung ở một nơi như vậy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "Xùy, còn không phải là nghe theo đề nghị của Jibashiri sao, mặc dù bây giờ tôi nghi ngờ không biết có phải họ có sở thích nhìn người khác đau khổ không...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830106,
					"content": "Bạn có biết nuôi Unagi không? Tôi thấy tiếp tục tập bắn cung cũng không có tương lai, chi bằng tính đường khác đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830107,
					"content": "Nuôi Unagi và bắn cung thì có liên quan gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "Ôi, xin lỗi nha, có vẻ như bạn chẳng hiểu tí gì về nuôi Unagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830109,
					"content": "Muốn nuôi Unagi trước hết phải bắt cá con, nhưng cá con của Unagi rất nhỏ, và rất khó phân biệt bằng mắt thường.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830110,
					"content": "Tôi nghĩ vì cung thủ có thể bắn các mục tiêu ở rất xa nên thị lực của họ phải rất tốt. Vì vậy, tôi đã hỏi các Jibashiri quen biết về cách rèn luyện thị lực.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830111,
					"content": "\"Akashi, ngươi phải luyện tập từ từ. Ngươi chỉ có thể tiến bộ ổn định hơn khi ngươi đã thiết lập một nền móng vững chắc.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830112,
					"content": "\"Cá con vừa nhỏ vừa di chuyển linh hoạt, vì vậy ngươi cần bắt đầu với các mục tiêu đứng yên, mục tiêu quá gần cũng vô nghĩa, nếu muốn luyện tập thì phải thật nghiêm túc.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830113,
					"content": "Tôi nghe theo lời của anh ta và ở đây tập bắn cung, nhưng đến bây giờ vẫn chưa thành công lần nào. Thật sự có người có thể bắn trúng mục tiêu ở xa như vậy sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830114,
					"content": "Đúng rồi, bạn có muốn thử không? Chỉ cần đứng trên hòn đá phía trước là sẽ thấy được mục tiêu, bắn trúng hết xem như thành công.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830115,
					"content": "Được rồi, xem tôi đây.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "Hãy cho tôi xem kỹ năng của bạn! Thành công rồi nhớ đến tìm tôi nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
