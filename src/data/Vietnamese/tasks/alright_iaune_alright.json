			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "Nhà Lữ Hành, bạn... bạn thực sự pha cà phê cho tôi à? Như vậy sao được, phiền bạn quá rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130402,
					"content": "Đừng khách sáo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "Cà phê này...! Ngon hơn rất nhiều so với thứ được cung cấp trong Sảnh Phúc Luật! Phải nói là hoàn toàn ở đẳng cấp khác.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130405,
					"content": "Nếu ngày nào cũng được uống thứ cà phê này thì tôi đã không gật gà gật gù mỗi buổi chiều rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130406,
					"content": "Cảm ơn cà phê của bạn, uống xong ly này tôi lại phải làm việc rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130407,
					"content": "Cố lên.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "Tất nhiên rồi. Tôi phải nhanh chóng trưởng thành hơn, sớm muộn phải trở thành người có thể một thân gánh vác mọi việc như ngài Roialte mới được.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130410,
					"content": "Haiz, nhưng đến được lúc đó thì tôi còn phải gặp bao nhiêu cơn ác mộng nữa đây...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130408,
					"content": "Tập trung tinh thần nào.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "Mau uống đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
