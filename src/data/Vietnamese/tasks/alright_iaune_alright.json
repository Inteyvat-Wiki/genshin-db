			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "Haiz, thật không hiểu tại sao lại như vậy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130102,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "Nhà Lữ Hành, rất vui được gặp bạn. Bạn tới uống cà phê à? Để tôi mời bạn một ly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130105,
					"content": "Sao vậy? Sắc mặt anh thật khó coi, lại bị ai ép thức khuya à?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130106,
					"content": "Cảm ơn đã quan tâm. Lần này là vấn đề của riêng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130107,
					"content": "Gần đây tôi đang suy nghĩ... rốt cuộc công việc của mình có ý nghĩa gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130108,
					"content": "Tôi luôn cho rằng Sảnh Phúc Luật là một cơ quan lớn mạnh, ngay thẳng mà ai cũng sẵn sàng giúp đỡ lẫn nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130109,
					"content": "Dưới sự quản lý của Sảnh Phúc Luật, Đại Sảnh Fontaine sẽ phát triển theo hướng tốt đẹp hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130110,
					"content": "Nhưng hiện tại, nó như một căn phòng máy móc đổ nát. Bánh răng, dây cót lộn xộn ngổn ngang... Chỉ có vỏ ngoài vẫn duy trì vẻ hoa lệ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130111,
					"content": "Nó vận hành được là nhờ vào một loạt sự trùng hợp và kinh nghiệm, chứ không phải do tính toán và thiết kế tinh vi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130112,
					"content": "Tôi... Tôi muốn làm gì đó nhưng không thể. Tôi sợ chỉ cần làm sai một chuyện, là sẽ khiến cho cả căn phòng máy móc này sụp đổ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130113,
					"content": "Tuy ngài Roialte vẫn thường động viên dù tôi có phạm sai lầm gì, thì tình trạng cũng không thể tệ hơn được...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130114,
					"content": "Đây... đây mà là động viên sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130115,
					"content": "Haiz, xin lỗi, tôi không nên than phiền với bạn. Hôm nay tôi ra ngoài cho khuây khỏa, chủ yếu là muốn tạm trốn tránh những chuyện đó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130116,
					"content": "Để tôi pha cho anh một ly cà phê.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "Thật sao? Bạn biết pha cà phê à? Thật là lợi hại, ngày trước tôi muốn học nhưng chưa có thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130118,
					"content": "Vậy thì phiền bạn, tôi sẽ đợi ở đây... Hy vọng ở quán cà phê sẽ không bị công việc ập tới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130103,
					"content": "Hôm nay anh được nghỉ à?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
