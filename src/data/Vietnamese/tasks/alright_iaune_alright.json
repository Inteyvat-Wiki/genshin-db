			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arouet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "Nhà Lữ Hành, bạn đến giúp tôi à? Vô cùng chào đón!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130202,
					"content": "Không phải, chúng tôi chỉ đang muốn pha một ly cho người bạn, anh ấy có vẻ đang... ừm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130203,
					"content": "Anh ấy đang buồn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "Người bạn mà hai vị nói tới, có phải là Iaune ngồi bên đó không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130206,
					"content": "Hai người quen biết sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "Tôi là bạn lâu năm của Roialte. Anh ấy từng nhắc tới một cậu thanh niên vừa thông minh vừa chăm chỉ ở văn phòng, chính là Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130208,
					"content": "Đừng lo. Những người trẻ tuổi mới đi làm cho Sảnh Phúc Luật sẽ luôn ủ rũ một thời gian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130209,
					"content": "Đợi khi họ tìm được một vị trí thuộc về mình, thì tâm trạng sẽ nhẹ nhõm hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130210,
					"content": "Anh có vẻ giàu kinh nghiệm nhỉ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130211,
					"content": "Vì tôi cũng đã từng là cây củ cải chiếm một chiếc hố trong Sảnh Phúc Luật mà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130212,
					"content": "Nhưng bất mãn vì mình chỉ là một cây củ cải, nên đã rời khỏi hố. Sau đó... tới đây mở tiệm cà phê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130213,
					"content": "Có vẻ như đã xảy ra nhiều chuyện nhỉ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "Hahaha, có lẽ vậy. Nhưng hiện tại tôi chỉ là chủ tiệm cà phê thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130216,
					"content": "Đúng rồi, hai vị muốn pha cà phê cho Iaune sao? Tôi đi chỉnh thiết bị một chút, chuẩn bị xong hãy tới tìm tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130214,
					"content": "Cảm thấy có nhiều chuyện nội bộ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "Anh ấy đang rất áp lực.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
