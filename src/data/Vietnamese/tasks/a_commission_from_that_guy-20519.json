						],
						"stepId": 2051902,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051903",
							"2"
						],
						"stepId": 2051903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "Bạn vẫn đang chuẩn ư? Ừm chuẩn bị cẩn thận trước khi xuất phát.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190402,
					"content": "Vị tiên sinh ấy là ai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "Chớ hỏi nhiều, tôi sẽ không nói cho bạn đâu. Đây đều là quy tắc cơ bản trong nghề của chúng tôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190404,
					"content": "Cho dù là tiết lộ... Thì những tin tức đó cũng là do \"cần phải tiết lộ\" mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190405,
					"content": "À đúng rồi, bạn có thể nghĩ rằng trong những lời mà tôi nói đâu là những tình tiết \"cần phải tiết lộ\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190406,
					"content": "Mục đích của các bạn là gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "Mục đích... Của tiên sinh ấy thì tôi không biết. Nhưng tất cả chỉ là để bảo vệ thành Mondstadt mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190408,
					"content": "Ồ... có lẽ là chuyện như vậy ngài ấy sẽ không hành động theo \"sở thích\" đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190409
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190409,
					"content": "Ồ ồ, không được, chuyện này không được suy đoán...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
