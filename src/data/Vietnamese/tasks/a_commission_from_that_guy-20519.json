			},
			"dialogs": [
				{
					"id": 205190201,
					"content": "Bạn quay lại rồi sao, hiệu quả làm việc nhanh thật đó, tôi cũng đã hiểu được lý do tiên sinh ấy thích bạn như vậy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190202,
						205190204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190202,
					"content": "Thù lao đâu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190203
					]
				},
				{
					"id": 205190203,
					"content": "Những đồng tiền mát lạnh... Đây là thù lao của bạn. Bạn cũng hiểu cho tôi một chút, tôi chỉ là người chạy việc mà thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190204,
					"content": "Thực sự cảm ơn sự hào phóng của bạn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190205
					]
				},
				{
					"id": 205190205,
					"content": "Chớ khách khí, thù lao này cho bạn, còn nữa... Hợp tác vui vẻ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051902",
							"2"
						],
						"stepId": 2051902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "... Đạo Bảo Đoàn... Ồ! Xin lỗi, bạn có chuyện gì không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190302,
					"content": "Đạo Bảo Đoàn đang manh động gần thành Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "Đạo Bảo Đoàn? Chúng tôi đang chuẩn bị theo dõi một nhóm Đạo Bảo Đoàn. Không biết bọn chúng muốn gì mà dám đến gần Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190304,
					"content": "Vì lý do gì đi chăng nữa, bọn chúng chắc chắn có ý xấu. Lần này chúng tôi đã bố trí rất nhiều người để đối phó với bọn chúng... E rằng tạm thời không có cách nào giải quyết báo cáo của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190305,
					"content": "Nhưng báo cáo của bạn tôi đã ghi lại rồi, đợi đến khi giải quyết xong đám Đạo Bảo Đoàn tôi sẽ báo cáo lên trên. Rất cảm ơn sự đóng góp của bạn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
