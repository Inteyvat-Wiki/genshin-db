			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190101,
					"content": "Lại gặp mặt rồi, dạo này khỏe chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190102
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190102,
					"content": "Cuộc sống hiện giờ của tiểu thư Jilliana vẫn rất bình thường, nhưng cô ta tạm vẫn chưa rời khỏi Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190103
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190103,
					"content": "Còn một chuyện nữa là, cô ta đã nói chuyện của bản thân cho tu nữ Victoria rồi, và tu nữ Victoria đến giờ cũng không có động tĩnh gì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190104
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190104,
					"content": "Kết quả của chuyện này ra sao thì chúng ta chỉ có thể ngồi đợi thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190105
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190105,
					"content": "...Bạn lại muốn làm gì đó?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190106
					]
				},
				{
					"id": 205190106,
					"content": "Đừng nhìn tôi với ánh mắt đáng sợ như thế chứ, tôi đâu phải là người xấu, tôi chỉ có lòng tốt chỉ bạn cách để giúp tiểu thư Jilliana thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190107
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190107,
					"content": "Được rồi, nói chuyện chính đi. Lần này tôi tìm bạn là vì \"Vấn đề nhỏ\" trước đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190108
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190108,
					"content": "Nói đơn giản, bạn đánh bại Đạo Bảo Đoàn, nhưng cũng làm lộ chuyện Jilliana đang ở Mondstadt rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190109
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190109,
					"content": "Đạo Bảo Đoàn sẽ không nương tay với kẻ phản bội, theo tôi biết, xung quanh Mondstadt đã xuất hiện nhiều vết tích của Đạo Bảo Đoàn, lại còn là của nhiều kẻ chưa từng được biết đến.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190110
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190110,
					"content": "E rằng chúng đến để gây phiền phức cho tiểu thư Jilliana, đồng thời trả thù cho người của mình. Những tên nguy hiểm như vậy, chỉ có thể nhờ bạn đánh lui thôi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190111,
						205190113,
						205190115
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190111,
					"content": "Chuyện này đều do bạn mà ra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190112
					]
				},
				{
					"id": 205190112,
					"content": "Tôi cũng chỉ phụng lệnh hành sự thôi, nếu vị tiên sinh kia không kiên quyết nhờ bạn làm việc này thì tôi cũng không tìm đến đây.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190113,
					"content": "Tự mình đi xử lý đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190114
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190114,
					"content": "Đừng nói chuyện vô cảm vậy chứ, tôi đâu có năng lực như bạn đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190115,
					"content": "Đây là chuyện của Đội Kỵ Sĩ Tây Phong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190116
					]
				},
				{
					"id": 205190116,
					"content": "Thì đúng là vậy, nhưng theo phán đoán của tiên sinh đó thì trong hình trạng hiện nay, chuyện của tiểu thư Jilliana càng ít người biết càng tốt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190117
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190117,
					"content": "Ngoài ra, vị tiên sinh đó cũng không hy vọng Đội Kỵ Sĩ Tây Phong tham gia chuyện này. Dẫu sao thì họ cũng đã quen với cách làm việc phô trương rồi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190118
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190118,
					"content": "Ví dụ như ngài Huffman mà biết Đạo Bảo Đoàn đang ở gần thành Mondstadt nhất định sẽ thông báo ngay cho đội Kỵ Sĩ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190119
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190119,
					"content": "Đội Kỵ Sĩ mà hành động quá lộ liễu, đám Đạo Bảo Đoàn sẽ chạy hết, toàn bộ kế hoạch đánh bại bọn chúng coi như thất bại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190120
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190120,
					"content": "Vì vậy lần này chỉ có thể nhờ bạn \"đơn thương độc mã\" đi giải quyết bọn chúng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190121,
					"content": "Có điều việc Đạo Bảo Đoàn đến gần thành Mondstadt đã sớm bị Đội Kỵ Sĩ Tây Phong phát hiện và có sự chuẩn bị rồi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190122
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190122,
					"content": "Nhưng những thứ này không nằm trong phạm vi suy nghĩ của chúng ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190123
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190123,
					"content": "Ai da, yên tâm đi, tôi đã chuẩn bị tiền thù lao hậu hĩnh cho bạn rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190124
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190124,
					"content": "Xét cho cùng tiên sinh ấy đã rót ra không ít Mora, không giống trước kia phải tự tôi bỏ tiền... Đúng rồi, tôi đã đánh dấu vị trí của đám Đạo Bảo Đoàn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190125
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190125,
					"content": "Không nói nhiều nữa, vì Mora, vì nhiệm vụ bảo vệ tiểu thư Jilliana, ngài Rudolf, Lily và nhiệm vụ trong Mondstadt sẽ giao cho bạn xử lý, cố lên nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
