			"dialogs": [
				{
					"id": 722020101,
					"content": "Lôi Điểu đại nhân...bỏ rơi tôi rồi sao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020102,
					"content": "Xin chào?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "Lôi Điểu đại nhân...xin ngài đừng giận...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020105,
					"content": "Tôi sẽ cố hết sức để đọc di chúc của đại nhân, đọc những lời răn dạy của đại nhân...nhưng mà...nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020106,
					"content": "Nhưng mà...tại sao đại nhân lại từ chối tôi...tại sao...huhu...huhuhu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020107,
					"content": "Tại sao...tôi không thể đi sâu vào sương mù của đại nhân...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020108,
					"content": "Đọc...Bạn đang nói gì thế??",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "Đá Sấm Sét đại nhân để lại...tôi sẽ nghĩ cách...con thuyền lấp lánh bạc đến rồi, tôi không còn nhiều thời gian nữa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020110,
					"content": "Đá Sấm Sét...là cái gì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "Đá Sấm Sét của Lãnh Địa Autake...Chỉ những người tạo ra sấm sét mới có thể làm cho chúng sống lại...chỉ những người tìm được lối đi trong sương mù mới có thể tìm thấy chúng...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020112,
					"content": "Nếu Lôi Điểu đứng lên...Nếu Lôi Điểu sải cánh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020113,
					"content": "Không phải...sương mù đã tan biến rồi sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "Có cần tôi giúp gì không?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
