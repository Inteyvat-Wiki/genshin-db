				"points": []
			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "Bạn đến rồi à, nhà mạo hiểm. Chúng tôi đang tính lắp đặt đấy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "Nếu mọi thứ thuận lợi, hôm nay sẽ có thể ra một đòn đủ mạnh cho con quái vật đó rồi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "Trong quá trình nạp năng lượng chính thức, có lẽ sẽ có ma vật đến quấy nhiễu. Đến lúc đó phiền bạn chú ý việc nạp năng lượng của thiết bị và tình trạng hư tổn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Cứ giao cho tôi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "Cám ơn bạn nhé, nhà mạo hiểm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "A! Tôi nghĩ ra một ý hay! Bạn đã vất vả vì Pháo Diệt Wenut lâu như vậy, vinh dự được bắn thử lần đầu... giao cho bạn đó!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "Anh không định tự làm sao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Tôi chỉ cần nhìn thấy nó bắn ra là đã rất mãn nguyện rồi! Huống hồ có người khác đi đánh lửa, thì chúng tôi mới có thể ngắm nhìn toàn diện lúc nó khai hỏa chứ... Khụ! Tóm lại!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "Bạn chỉ cần bảo vệ thiết bị nạp năng lượng khỏi tay ma vật, đợi khi năng lượng được nạp đầy, thì nhắm đúng vào lúc Wenut lộ sơ hở, rồi gõ mạnh vào pháo đài là được!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "Chuyện còn lại, thiết bị đánh lửa và cơ quan tự động chỉnh sửa sẽ giúp bạn hoàn tất!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#Nghe có vẻ rất lợi hại... {NICKNAME}! Tôi cũng muốn xem nữa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Được thôi, để tôi thao tác.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Haha, vậy cứ thế nhé! Để tôi nói cho bạn nghe quy trình thao tác cụ thể...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "Tôi không biết thao tác thế nào...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Cứ yên tâm! Lúc tôi thiết kế đã tuân theo nguyên tắc thao tác đơn giản dễ dùng, cực kỳ hoàn hảo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "Không thành vấn đề.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
