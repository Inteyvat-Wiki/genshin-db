				{
					"id": 722750301,
					"content": "Hãy đến chỗ Linh Hồn Tokoyo của Jibashiri để chứng minh sự uy dũng của bản thân nào.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750302
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750302,
					"content": "Khi hoàn thành tất cả khiêu chiến, tôi sẽ nói ra tất cả bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750303
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750303,
					"content": "...Haiz, trông tôi giống như những cô nương lắm mồm không biết giữ kín bí mật thật.",
					"roleType": "TALK_ROLE_NPC",
