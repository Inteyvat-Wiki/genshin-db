			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Eboshi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750101,
					"content": "Thân này đã hiện thế, có nghĩa là San Hô Máu đã ở trong tay Watatsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750102
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750102,
					"content": "Tôi là Erebos, tên tiếng địa phương Inazuma thì là Eboshi. Tôi là một trong số các pháp sư Enkanomiya phò tá cho Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750103
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750103,
					"content": "Bạn chính là dũng sĩ đã lấy được San Hô Máu, đúng chứ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750104
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750104,
					"content": "Đúng vậy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750105
					]
				},
				{
					"id": 722750105,
					"content": "Thành thật xin lỗi, câu chuyện mà tôi kể có hơi phức tạp, không biết nên bắt đầu từ đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750106
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750106,
					"content": "Có thể kể từ đầu mà, chúng tôi sẽ lắng nghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722750107,
					"content": "Thật cảm ơn. Vậy thì câu chuyện có lẽ nên kể từ lúc Watatsumi Omikami khai thông Cánh Cổng Biển Sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750108
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750108,
					"content": "Sâu trong Enkanomiya có một hang động tự nhiên, nơi đó là con đường dẫn đến Đảo Watatsumi, cũng là miền đất hứa của Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750109
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750109,
					"content": "Dưới sự hướng dẫn của Omikami, chúng tôi đã học được văn hóa của Narukami, và chúng tôi cũng thiết lập được mối quan hệ đối ngoại với nhiều quốc gia khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750110
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750110,
					"content": "Đảo Narukami thậm chí còn gọi chúng tôi là \"Mỹ Nhân Watatsumi\", bởi vì chúng tôi có làn da mềm mại, có thể che đi bảy loại khuyết điểm trên da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750111
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750111,
					"content": "Nguyên nhân của việc này thì, có lẽ là do chúng tôi và tổ tiên sống ở Enkanomiya không có tiếp xúc với ánh nắng mặt trời...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750112,
						722750113
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750112,
					"content": "Nói trọng tâm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				},
				{
					"id": 722750114,
					"content": "À xin lỗi. Trong quá trình thiết lập quan hệ đối ngoại, tôi thường đóng vai trò hướng dẫn viên với phụ tá của Sangonomiya, nhưng mà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750115
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750115,
					"content": "Quay lại vấn đề. Tôi có bất đồng với đại nhân Sangonomiya, dưới sự hòa giải của Watatsumi Omikami, chúng tôi đã có đáp án như bây giờ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750116
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750116,
					"content": "Bởi vì Enkanomiya có hiện tượng \"Ảo Ảnh Tội Lỗi\", cho nên \"quá khứ\", \"lịch sử\", \"chân tướng\" cho dù để đó không quản cũng sẽ tồn tại vĩnh viễn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750117
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750117,
					"content": "Cho nên tôi dốc hết tâm huyết của mình, không phải là để ghi nhớ, mà là để \"quên đi\". Rất rõ ràng rằng đại nhân Sangonomiya cũng nghĩ như thế.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750118
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750118,
					"content": "(Sangonomiya mà cô ấy nói hình như là pháp sư Sangonomiya rất lâu về trước đúng không nhỉ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722750119,
					"content": "Cuộc thí luyện lấy san hô này, chính là thiết kế riêng để người đời sau không tiếp cận được với toàn bộ chân tướng sự việc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750120
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750120,
					"content": "Nhưng tôi lại ủng hộ việc để lại chân tướng. Vì vậy, Watatsumi Omikami đã cho phép tôi làm thêm một phần nữa của thí luyện. Nếu như có thể vượt qua, là sẽ có thể biết được bí mật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750121
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750121,
					"content": "Hãy đối mặt với khiêu chiến này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750122,
						722750123
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750122,
					"content": "Tôi chấp nhận khiêu chiến.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750124,
					"content": "Rất tốt, tôi sẽ khởi động thí luyện ngay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750123,
					"content": "Tôi rất có hứng thú với bí mật.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750113,
					"content": "Sao lại nói chuyện này, đi vào trọng tâm đi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				}
			]
		},
		{
			"id": 7227502,
			"completionStepIds": [
				7227506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227506",
							"2"
						],
						"stepId": 7227506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eboshi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750201,
					"content": "Giờ bạn đã nhận được tất cả sự công nhận từ Jibashiri. Họ đại diện cho ý chí của Watatsumi, vì thế bạn cũng có quyền được biết sự thật.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750202
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750202,
					"content": "Bạn là đấng cứu thế của người dân Watatsumi, và cũng là người được Watatsumi thừa nhận. Bạn có quyền biết được tất cả mọi thứ mà bạn muốn biết.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750203
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750203,
					"content": "Nhưng hy vọng bạn tôn trọng quy tắc, tuyệt đối không được mang sự thật rời khỏi biển sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750204,
					"content": "Bạn cần biết chuyện gì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750205,
						722750206,
						722750207,
						722750208,
						722750209
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750205,
					"content": "Về Rồng Biển Sâu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750210
					]
				},
				{
					"id": 722750210,
					"content": "Rồng Biển Sâu là một loài sinh vật nguyên tố nguyên thủy, bởi vì ở lâu dưới lòng biển cho nên không bị sức mạnh trên trời hàng phục.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750211
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750211,
					"content": "Chúng thực ra rất thông minh, lại rất giỏi tiến hóa. Trong thời kỳ chiến đấu với chúng tôi, chúng thậm chí còn tiến hóa thành các loại nguyên tố khác nhau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750212
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750212,
					"content": "Nếu chúng học được ngôn ngữ, chúng thậm chí sẽ còn tiến hóa thành người thú không chừng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750213
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750213,
					"content": "Trên thực tế, bản chất của \"Đất Thánh\" là sự mở rộng môi trường sống của chúng. Điều đó có nghĩa là sức mạnh nguyên tố sơ khai của ba cõi đang ngày càng mạnh mẽ hơn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750214
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750214,
					"content": "Chúng tôi chỉ có thể dùng sinh mệnh của Watatsumi Omikami để đánh thức gia quyến thứ hai của nó để chuyển hóa sức mạnh nguyên tố ác độc này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750206,
					"content": "Về Watatsumi Omikami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750215
					]
				},
				{
					"id": 722750215,
					"content": "Watatsumi Omikami chính bởi vì tai họa của bản thân nên đã lạc vào đây, bên ngoài sự cai quản của \"Trật Tự Bầu Trời\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750216
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750216,
					"content": "Sự việc này lại là một điều may mắn với con dân Vương Quốc Đêm Trắng chúng tôi. Nó thật sự đã làm rất nhiều thứ cho nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750217
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750217,
					"content": "Nhưng cũng bởi vì nó đã tiếp xúc với chúng tôi, mở ra chân tướng thâm chí còn trước cả khi nó được sinh ra. Thế nên nó bị bầu trời buộc phải hy sinh bản thân.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750218
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750218,
					"content": "Việc hy sinh này bắt buộc phải bí mật tuyệt đối. Chỉ có cách này mới khiến cho cư dân Đêm Trắng được phép sống trong \"Trật Tự Thất Thần\" mới.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750207,
					"content": "Về những chuyện trước đây của mặt trăng và mặt trời...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750219
					]
				},
				{
					"id": 722750219,
					"content": "Trước khi Vương Quốc Đêm Trắng chìm vào biển sâu, đúng thật là toàn bộ thế giới đều có một nền văn hóa thống nhất.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750220
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750220,
					"content": "Sau đó xảy ra một trận đại chiến, xé toang bầu trời, rung chuyển mặt đất. Nơi này cũng từ đó mà rơi vào biển sâu tăm tối.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750221
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750221,
					"content": "Sau đó, Trật Tự Bầu Trời có lẽ không muốn những người biết được sự thật này lưu lại trên mặt đất. Cho nên chúng tôi đã mãi mãi không tìm được đường về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750222
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750222,
					"content": "Cho đến rất lâu trước đây, sức mạnh từ lệnh cấm của bầu trời đã dần suy yếu, Watatsumi Omikami đã rơi xuống nơi này.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750208,
					"content": "Về Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750223
					]
				},
				{
					"id": 722750223,
					"content": "Dainichi Mikoshi chính là kiến trúc được xây dựng bởi hiền nhân Abrax, nó sở hữu sức mạnh mang đến ánh sáng cho biển sâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750224
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750224,
					"content": "Ngoài ra thì nó cũng còn có rất nhiều tính năng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750225
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750225,
					"content": "Nói chung là rất lợi hại.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750209,
					"content": "Không còn chuyện gì nữa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750226
					]
				},
				{
					"id": 722750226,
					"content": "Ừm, xin hãy nhớ lấy, mọi chuyện ở Enkanomiya, xin hãy để nó trở thành bí mật vĩnh viễn nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eboshi"
				}
			]
		},
