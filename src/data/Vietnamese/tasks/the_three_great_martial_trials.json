			"dialogs": [
				{
					"id": 722750401,
					"content": "Thí luyện ở ba khu vực đã chuẩn bị xong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750402
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750402,
					"content": "Vậy để tôi truyền đạt manh mối của ba thí luyện này nhé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750403
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750403,
					"content": "Bạn hãy ở trong Đêm Đen, nhìn về biên giới của Vương Quốc Đêm Trắng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750404
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750404,
					"content": "\"Trong đêm đen u tối, bên ngoài dòng chảy của con sông Styx, ở nơi ánh sáng vô tội tuôn chảy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750405
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750405,
					"content": "Xin hãy mở phong ấn nơi ánh sáng tuôn chảy, đi vào Cửa Thiên Đàng để đến với nơi thí luyện.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750406
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750406,
					"content": "Nơi ánh sáng tuôn chảy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750408
					]
				},
				{
					"id": 722750408,
					"content": "Trong bóng đêm sẽ nhìn thấy ba trụ sáng từ trên bầu trời đổ xuống, những trụ sáng này sẽ chỉ về nơi ánh sáng tuôn chảy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750410
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750410,
					"content": "Cô nói hơi mơ hồ quá đó.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722750411,
					"content": "Xin lỗi, đây là kịch bản được viết bởi Watatsumi Omikami. Ý tôi là, các loại thí luyện truyền thống khác cũng chỉ có những dòng gợi ý mơ hồ này thôi mà đúng không?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750412
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750412,
					"content": "Tóm lại các Jibashiri ở nơi thí luyện đều là các quái nhân. Không đến đó thông qua Cổng Dịch Chuyển thì họ sẽ không nói chuyện ôn hòa đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750413
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750413,
					"content": "Tôi chỉ có thể ở đây chờ bạn vượt hết mọi chướng ngại, giành được mọi sự công nhận và trở về.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eboshi"
				}
			]
		}
	]
