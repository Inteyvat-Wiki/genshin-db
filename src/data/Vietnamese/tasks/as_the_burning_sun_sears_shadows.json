				},
				{
					"id": 751660102,
					"content": "Hơn nữa, căn bản toàn là dấu vết của Vực Sâu mà... Nghĩ kỹ thì, nói không chừng Vực Sâu chặn lối vào bên trên đều là xuất phát từ dưới này đấy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751660103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751660103,
					"content": "Người được rồng chọn, sức mạnh của lửa đã được gửi gắm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751660104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751660104,
					"content": "Hãy đi tiêu diệt kẻ địch bóng tối!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751660105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751660105,
					"content": "Ôi, dù không biết tại sao, nhưng cả người tôi lại có luồng sức mạnh ấm áp nhỉ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
