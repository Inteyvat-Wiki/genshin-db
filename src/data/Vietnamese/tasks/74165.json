				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "Ta... cảm nhận được \"Lý Tính\". Ngươi là người nối nghiệp của Narzissenkreuz, hay là tay sai của đám bánh răng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650102,
					"content": "Rút kiếm hướng về phía ta sao? Xem ra đáp án không cần nói cũng rõ rồi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650103,
					"content": "Narzissenkreuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650104,
					"content": "Ơ? Thứ này chính là Narzissenkreuz sao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650105,
					"content": "Nếu đã từng nghe đến tên ta, vậy chắc các ngươi cũng hiểu được đạo lý cứu rỗi của ta, và trong ý thức cũng đã có hạt giống cứu rỗi của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650106,
					"content": "Các ngươi ra tay với quân tiên phong của ta như thế, ắt hẳn đã bị lời nói dối che mắt. Lúc này ta không muốn lãng phí quá nhiều sức mạnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650107,
					"content": "Vui sướng đi, reo hò đi. Sau khi tất cả kết thúc, ta sẽ giải đáp và chỉ đường. Nhưng giờ thì hãy trả lại Thánh Kiếm cho ta rồi đi đến nơi tị nạn đi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650108,
					"content": "Chúng tôi không trả Thánh Kiếm lại đâu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650109,
					"content": "Đám ngu xuẩn. Nhưng dù như thế thì ta vẫn sẽ tha thứ, vẫn sẽ cứu rỗi các người.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650110,
					"content": "Ta có thể cảm nhận được, bốn Orthant tuy đã nghịch chuyển, nhưng cây của sự tuôn chảy vẫn chưa hoàn chỉnh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650111,
					"content": "Nếu không thể cứu hết mọi người, thì ta sẽ kéo dài sự từ bi của mình hết mức, cho dù phải thiêu đốt sinh mạng của ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650112,
					"content": "Nếu chỉ cứu được năm phần, thì ta sẽ cố hết sức để cứu sáu phần.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650113,
					"content": "Bây giờ, ta phải lấy lại Thánh Kiếm đã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
